44881073644028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leASEhORWmAQ7kNvwFq5HbB&_nc_oc=Ado_S9Jf9uO0oek7eH3EqO2B8uiO3u20rWhaRjn3FZEqDQwLLxO9T7WC1wijeAtbYNo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQjB0aYPrW7eAftxfRvG68AynWoiu4CTJeAWC2NgIphQ&oe=6A6F3B3A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbAuVm1ACXQQ7kNvwH-XeG7&_nc_oc=AdoEY0GwZZFKA2NhdIfB-RtVPz5HOXsogxy2boXYaJJfPCaDywwgcXKN7fZuzYqxB28&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBJ1NQl7qu_RQsz2iJV2o8MaJtLjU_wazFJHXEeKBLYA&oe=6A6F50DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrif0famBXUQ7kNvwHoGcFb&_nc_oc=AdoTPjG3ghFsbIGZWDo3CX1c3YXlKE6jPHtqY5_N_JhylNbxKNdjjHuG49E1zTqAfKE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsMIphiCXAqqSXfyMFsZsQAvRpFjp7qOl0rss1Qab8fw&oe=6A6F2752"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsChLh7Zi-IQ7kNvwGqkx98&_nc_oc=AdpH8b1EnjWLrJ-WLcO_vgQfj8zHjVOzDuOz8DU8eI1kkcezmrVFof6uE0vsKzl3PrM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAujlqpZpH6BmQlCB28l9DP3O28_PJlj7V1LfKa48_IHQ&oe=6A6F3A69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYyXOvHj-7cQ7kNvwGc3huu&_nc_oc=AdqBC7Am8Fni0zXoT9TiCVBULulTY1hx0QBzUfg28Agkx-H6u3MV4ur2KShJtdvDBys&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm4ch4EbJAto-LWj6XdPLRY4uW8PziKCL4IuZV8goGAQ&oe=6A6F4A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnBkw-Vy6LAQ7kNvwHCkNkd&_nc_oc=Adq6ECZTr0xkGa9KaxEBDQaBu3ZF8wZrlGnIPsl675jHEiN4RSV1-8qzPsRSAPlmDaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE5dMuFHP7QkPRVJGhltG2HIMtaA6ol3nOo38EEqm5ug&oe=6A6F5056"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27968434209459138", "version": "0.34.5"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27968434209459138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.5\n\n**New drill: BAG CALLER**\n- The coach calls combos over the heavy bag and you throw them with no pads to aim at. The numbers sit in front of the bag and stay up until you finish the call.\n- Throw with the wrong hand and the call waits for you. Throw the wrong punch and it moves on, but that combo won't count as clean.\n- Hooks are read from how you swing, body shots from how low you land.\n- The calls keep coming for as long as you want to work. Finish from the pause menu, and the score screen shows how many combos came back exactly as called.\n\n**New drill: 1**\n- The jab on its own. Snap it out, snap it back.\n\n**Heavy bag**\n- The bag is heavier now. It gives less on each punch and settles instead of swinging away from you.\n\n**Fixes**\n- Southpaw: punches on the heavy bag now log as the right punch type. Your jab was being counted as a cross.", "created_date": 1785189081, "id": "27968434209459138", "version": "0.34.5", "version_code": 16779199, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27968434209459138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.4\n\n**Build your own workouts**\n- Make custom workout lists. Press Y on any drill to drop it into List A, B, or C, then play that list as a workout.\n- Built a random workout you liked? Save it to a list to run it again.\n- Manage your lists from the Workout tab: remove a drill you don't want, or clear a whole list at once.\n- RANDOMIZE reshuffles a list's drills and their order each time you press it.\n\n**Find drills faster**\n- Filter a category down to what you want with tags: slips, hooks, body shots, ducks, pivots, combo length, and whether a drill leans high-output or defensive.\n- Tags show on each drill card, and search matches them too.\n\n**Perfect combo callout**\n- Finish a whole combo with every shot clean and a coach calls it out.\n\n**Workout flow**\n- Workouts get their own rest-between-combos switch, on by default, so they flow without changing how single drills feel.\n\n**Fixes**\n- Dodging now follows the way you're facing. After a pivot or an angle step, slips and pull-backs work in the direction shown instead of the one the drill started in.", "created_date": 1784928351, "id": "27936345469334679", "version": "0.34.4", "version_code": 16779197, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27968434209459138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.3\n\n**New drill: SLIP & RIP**\n- Slip left and rip the body, slip right and rip the uppercut, cap it with the hook, then weave off the line. A longer defensive answer built around slipping both ways.\n\n**Rest between combos**\n- A short pause now falls between combos so each one lands as one burst instead of running together. There's a new Settings toggle, \"Rest Between Combos\", if you want the old continuous flow back.\n\n**Footwork**\n- Footwork steps are smaller now, short controlled slides like real footwork, and the same size at every league.\n\n**Fixes**\n- Slip drills: standing still now counts as getting tagged instead of scoring a hit as a success.\n- SLIP SCHOOL: your guard no longer blocks the slips, so you can keep your hands up and just slip.", "created_date": 1784794045, "id": "27916867304615829", "version": "0.34.3", "version_code": 16779182, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27968434209459138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.2\n\n**New drill: SLIP SCHOOL**\n- Nothing but slips, one after another, for the whole round. Each one comes straight at your face and you dodge it whichever way you like, then snap back to your stance for the next.\n- It sits under Defense, and the speed follows your league so it stays readable instead of becoming a blur.\n\n**Slip fixes**\n- Slips now stay on target until they reach you, so they stop disappearing early.\n- Fixed the odd phantom slip that cleared before you'd actually moved. Every drill with a slip in it feels tighter now.\n\n**Other**\n- A couple of new tips on the loading screen.", "created_date": 1784672294, "id": "27900017142967512", "version": "0.34.2", "version_code": 16779175, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27968434209459138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.1\n\n**Rear hook drills**\n- Four new drills built around the rear hook.\n- 1-4 (Combos): jab to blind them, loop the right hook around the guard.\n- 8-4 (Combos): right hook to the body, then the same hand upstairs. Sell the level change.\n- SLIP & HOOK (Defense): slip outside the jab, counter with the rear hook as your weight comes back.\n- ROLL & REAR HOOK (Defense): roll under the lead hook, come up with the right hand loaded. The mirror of ROLL & HOOK.\n- In southpaw stance all four mirror to the left hand, like every other drill.", "created_date": 1784499058, "id": "27876947028607857", "version": "0.34.1", "version_code": 16779170, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
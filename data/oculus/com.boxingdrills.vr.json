a&_nc_ohc=foxloS9DldwQ7kNvwHtyk_b&_nc_oc=AdlD4emlx8Ryp6r32YnBtzK8tcJtZrRCYY8DQn_YeuKokevrSsIzq8_ukj1mpalN-wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSDC4-b7f8K-f6oUYkF-ztZKAhhqfF9bNaFWb_1Na7ZQ&oe=69BFD8AB"}, {"file_name": "com.boxingdrills.vr-20260306-065440.png", "id": "983076857378860", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823395_983076860712193_8354097057286737736_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQMjsRWAcacQ7kNvwFRGylK&_nc_oc=AdlFtqDuFN0hEVZt4xSz1RHk0nl-hnIpIZJ177gDqVZrGLdfyINxBH4u_pjbXvz-CaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8sLOyIkJ2RbDh1punWriZQGXnP2nZk5at6nJ1b6ksLw&oe=69BFE8DF"}, {"file_name": "com.boxingdrills.vr-20260306-065405.png", "id": "2442422822886145", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618069_2442422826219478_5027518634157268285_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOODB5FOgscQ7kNvwGoqWRp&_nc_oc=AdkZr-6q8ypBiILKo79twtSXJc9sF64CqHNO4sRAmEKiE34sKQweemWG29y-YqKAdZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0r1KyhUHJuqxmAIQymASryQCS2wCPqDdegkg91ue1-A&oe=69BFE3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JccQUpR7nBQQ7kNvwGZNpWu&_nc_oc=AdnxSOmPj5_u60fcDSX3zSYuMkNifH_LYD1kxORJTijoXIAE8_ClN00PcyBZktuBbdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzo-xr7XIZ3T_ET944xoQpAkvwbe_8EYiKHhfryDDMpVw&oe=69BFF8D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Your coach calls the combination. You move, punch, slip. This is pad work \u2014 real pad work. Not a rhythm game. Not a cardio app. The training fighters actually do, in your living room.\n\nBoxing is a craft. Footwork, guard discipline, hip rotation on the cross \u2014 not learned by pressing buttons. Drilled into instinct.\n\nBoxing Drills puts you in front of virtual pads and holds you to real standards. Punch too soft? It doesn't count. Drop your guard? That's a point off. Stand flat-footed? The trainer steps out of range \u2014 move.\n\n**Train like it means something**\n- 30+ drills across punch combos, defense, and footwork\n- Pad trainer shifts laterally and forward/back \u2014 reposition or lose the angle\n- Minimum punch velocity threshold \u2014 weak shots don't register, so you learn to commit\n- Body engagement scoring \u2014 measures hip rotation, not just arm speed\n- Real-time hit feedback: punch speed (m/s), body effort, and power score on every impact\n- Southpaw mode \u2014 train in your natural stance\n\n**Track what matters**\n\nPower \u00b7 Speed \u00b7 Agility \u00b7 Form \u2014 scored every session and compared against your personal bests. Career mode builds your fighter profile and tests you across 8 opponents. Workout mode chains drills back-to-back for sessions up to 60 minutes.\n\n**Built for Quest. No subscriptions. Open source.**\n\nOne purchase. Everything included. Join the Discord at https://discord.gg/7vbXrqzg and help shape what comes next.\n\n*Clear some space. Put the headset on. Throw a real punch.*", "short_description": "Real pad work. In your living room.\n\nThrow combinations, slip punches, move your feet \u2014 the virtual trainer shifts position and your punches only count if they land hard. This isn't a rhythm game. It's how fighters actually train.\n\n30+ drills. Workout mode chains them back-to-back for up to 60 minutes of continuous training. Real-time power, speed, agility, and form scoring. Career mode. No subscription.\n\nPut the headset on. Throw a real punch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26410139718621936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omf6TEhKO4YQ7kNvwEDggaa&_nc_oc=AdmUofYaeFGf2ghemGwRY9b8im_yq5bbTDqsT1qlHRRyDFf_WTW7DPmIOA38ACCVspc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0599R4kAOwZnt04AOhRjmnX8U3LPApWnF56k1fDlWvw&oe=69BFEDA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Drills VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1772139060, "lastRevision": {"nodes": [{"id": "26010917281877517", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
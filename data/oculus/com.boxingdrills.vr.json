9_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE0r7Q-MSTEQ7kNvwEG3POd&_nc_oc=Ado0PVQJ9LXXABOuPFwAf6QMH8xDRwitHxl5TX_9j5xvu6KOFsvJK9YxTYCJUum7rDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g4HUodRpUOkrbV7P5joHN0ywppjDJhri8mrKFlkWwOA&oe=6A340F05"}]}, "id": "1660709818565169", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260612-160527.png", "id": "4361061587556460", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622325_4361061590889793_8443499001590631147_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dPt_TRaVsUQ7kNvwFxIjnp&_nc_oc=AdpPll1WlO2Out6mgdOP6WFaiWE8tSphklP2Vokf4qAzBjdn3bD6BO2prI286tx-tPI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cPQuEn3QIOboruqQn1hCFRgOZ2ldkKL4vTe7nPZLC4g&oe=6A33F8A6"}, {"file_name": "com.boxingdrills.vr-20260612-160524.png", "id": "1790742922336026", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619681_1790742929002692_2967370313329941720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi6kYA2i_qoQ7kNvwHocZ7L&_nc_oc=AdqnWgozilQDWOdi6xlwPl-4qpTkZL7TMIWmEftPpWwDQRoXQzY2Ef1hJWxHkL_PGww&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J99yS4xksMhyHspvvNOLf9lqIMGrK4M8NcMdSDNcjog&oe=6A340CB7"}, {"file_name": "com.boxingdrills.vr-20260612-160549.png", "id": "1642629256847878", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619681_1642629260181211_4239273547513896385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TjfiQgrRRoQ7kNvwHFRRrV&_nc_oc=Ado5gBtYUCiWFI53zWwtfBdPXRQ0eCrjXTHwuRMJVPXbKITHeqb4mjQv9OlHDql_Sf8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fnVlLVQ8l-CBIpgUYhnJEOpzwc4C-2HcGk2SteHrCrg&oe=6A34080E"}, {"file_name": "com.boxingdrills.vr-20260612-160540.png", "id": "1283005677155850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623443_1283005683822516_4340392285963543058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGZpaNfH-HoQ7kNvwHWh008&_nc_oc=AdryxRfzTgMrPshx6GVDTHv9hwQd2UzrpfG1Ctj-xMrzVekExBYsoq5olq8y94Zt3hg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bef7_zK0vJhIXhokXPP2UIjnuVTJzkG4eIbSyFcxUtQ&oe=6A34055F"}, {"file_name": "com.boxingdrills.vr-20260612-160507.png", "id": "998205189422993", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/507898773_998205192756326_7953914639717337464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIRRbj70CV0Q7kNvwHPKwNA&_nc_oc=AdrmcNSq9vl4tOBD0r-rWNjn1bnHxr2Rq_gmlDzcP2KWrblsx8M0yWSwHEe1BZbC26Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aTpbVLMk-vgPpwgagAwgp1uYdwP2X-CnUFZ2vRzY6-A&oe=6A340B2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEMIVGmzevEQ7kNvwHCsidN&_nc_oc=Adp31oFv7KPxtDryOQmVS6vCZm8Vgq94mE-DC7Kp4Jh5n3nGDM09jpUrUUG7UH9WdVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z1IwDfLkd7T0LjWLjlzg-kFxdtaNiw910MtseGbE4Gw&oe=6A33FCD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Your coach calls the combination. You move, punch, slip. This is pad work \u2014 real pad work. Not a rhythm game. Not a cardio app. The training fighters actually do, in your living room.\n\nBoxing is a craft. Footwork, guard discipline, hip rotation on the cross \u2014 not learned by pressing buttons. Drilled into instinct.\n\nBoxing Drills puts you in front of virtual pads and holds you to real standards. Punch too soft? It doesn't count. Drop your guard? That's a point off. Stand flat-footed? The trainer steps out of range \u2014 move.\n\n**Train like it means something**\n- Many drills across punch combos, defense, and footwork with more being added regularly\n- Pad trainer shifts laterally and forward/back \u2014 reposition or lose the angle\n- Minimum punch velocity threshold \u2014 weak shots don't register, so you learn to commit\n- Body engagement scoring \u2014 measures hip rotation, not just arm speed\n- Real-time hit feedback: punch speed (m/s), body effort, and power score on every impact\n- Southpaw mode \u2014 train in your natural stance\n\n**Track what matters**\n\nPower \u00b7 Speed \u00b7 Agility \u00b7 Form \u2014 scored every session and compared against your personal bests. Career mode builds your fighter profile and tests you across 8 opponents. Workout mode chains drills back-to-back for sessions up to 60 minutes.\n\n**Built for Quest. No subscriptions. Open source.**\n\nOne purchase. Everything included. Join the Discord at https://discord.gg/8FyagxceKs and help shape what comes next.\n\n*Clear some space. Put the headset on. Throw a real punch.*", "short_description": "Real pad work. In your living room.\n\nThrow combinations, slip punches, move your feet \u2014 the virtual trainer shifts position and your punches only count if they land hard. This isn't a rhythm game. It's how fighters actually train.\n\n30+ drills. Workout mode chains them back-to-back for up to 60 minutes of continuous training. Real-time power, speed, agility, and form scoring. Career mode. No subscription.\n\nPut the headset on. Throw a real punch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786
{"data": {"node": {"__typename": "Application", "id": "26010917241877521", "organization": {"id": "890971244110593", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "26010917241877521"}]}, "id": "921168477515230"}]}}, "firstRevision": {"nodes": [{"application": {"id": "26010917241877521", "release_date": 1772139060, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26308914735411102"}, "id": "790503750728261"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "id": "26308914735411102", "version": "0.6.0", "version_code": 16777750, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1772690218, "id": "26309028688733040", "is_initial_release": false, "name_with_fallback": "v6", "pdp_metadata_with_fallback": {"version": 4, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26288224117480164"}, "release_status": "RELEASED", "id": "26010917241877521"}, "id": "26288224117480164", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": null, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622334_1434317038416764_4990668168972632832_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnxgZz-TRdYQ7kNvwEOdcvW&_nc_oc=Adk-GD1mP7-SY_fiaZ71xX5l3CIVnZZ_3FLKimx5oM623L2y32qoF1lAHFuOP-r_iHE&_nc_zt=3&_nc
s://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YS6oHWY_zhIQ7kNvwGsRTzv&_nc_oc=AdoK53vg5lxCgMBdCG-WM6gTCoQDcradctLvv8YnY0hKE4IhLtB8-Iw-tRQJAtL5APM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J59JDYTrsAnjuYVvRmiaca58F9lkyJDOuTY1tiqA8Rg&oe=6A4116BA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKdf_63UadcQ7kNvwGUTRsT&_nc_oc=AdpSTagL_EAxmixSuA66OME4BCUBlo-KONqi8pdyG0Y5NaGv2NhCxgPBqU16HsHit50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kfYE30SvbWkli00dsmwyjHe9gVRJeCAtYHNaxvCqcOg&oe=6A412C5D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z55SOY_aClcQ7kNvwHvirlO&_nc_oc=AdqlSZfqlJ3LIBP23U1YqwjEurSvc4laIvAlk1aGnHWsw5r2U-Omx99BeETHseveeLk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JpymvtQ2in6Aj5Za8egaMSb1IQbhu5xjBWcq7HOuWcQ&oe=6A413B12"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIx85RotCggQ7kNvwGlqy1R&_nc_oc=AdqlRcJ-vamLnioc4sMSFUUxq9ZQIIoMjGtngQ9QuwRvV0q_1UIuQWKSA0NEmvRJBOQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fmcVxc-Z8X8eqYfgNHCTEL_YOJ-YKEadtNyEukn6uMw&oe=6A4115E9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SB9G0abxqIQ7kNvwEoy34X&_nc_oc=AdqQqPypyhzT8Z8i8Lh29rm2QoF2PttA7RQtNNELmnjNHpYsSAAnOEkTCAMYK0rbzNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gmGDrZuD7v-78n3FwdseX0GrOrsU-Z4pLYh2L8aEMnQ&oe=6A41261F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnEH8SU9ZAQ7kNvwFwC38w&_nc_oc=Adqb_LfkSBsJ6NQMINm0EFqKFegDJapMHGu8WHWNrPbXJ3Ic94m2FNvs14SJSsLSFD4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O6MJpJ--Z9c16v10FhZwBBLuSeVWKtTxlMbUcz158VA&oe=6A412BD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27582692601366636", "version": "0.23.2"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27582692601366636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "## Release Notes\n\n### v0.23.2\n\n**Reactive Flow \u2014 now everywhere**\n- Flow now applies to *every* drill where you dodge straight into a counter \u2014 all the slip and pull counter drills (Pull Counter, Shell Defense, 1-2 Slip-Slip 3, Survive & Punish, Survive the Storm), not just a handful.\n- Peek-a-Boo drills flow too: slip to load, then rip the hook or uppercut in one continuous motion.\n- It's all governed by the single **Flow** setting (on by default) \u2014 switch it off for a strict, one-cue-at-a-time rhythm on every drill.\n\n**Bug Fixes**\n- Peek-a-Boo and roll drills: the weave/duck bar no longer creeps lower as the round goes on \u2014 it holds your starting height for the whole drill.\n", "created_date": 1782187517, "id": "27582692601366636", "version": "0.23.2", "version_code": 16779112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27582692601366636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782184745, "id": "27582276071408289", "version": "0.23.1", "version_code": 16779110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27582692601366636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782180078, "id": "27581612754807954", "version": "0.23.1", "version_code": 16779108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27582692601366636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782171804, "id": "27580515928250970", "version": "0.23.1", "version_code": 16779106, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27582692601366636"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.23.1\n\n**New: Reactive Flow**\n- Counter drills now *flow* \u2014 dodge straight into your counter with no dead beat. Slip the shot and the counter pad is already there waiting.\n- New **REACTIVE COUNTER** drill: slip the incoming shot, fire the counter, repeat both sides.\n- New **Flow** setting (on by default) \u2014 switch it off if you prefer a strict, one-cue-at-a-time rhythm.\n\n**Bug Fixes**\n- Pads no longer shatter when your glove brushes the roll/duck bar \u2014 that was making mitts \"explode\" on ordinary hooks in roll drills. Those bars are now purely something you duck under.\n- Power smash retuned: the pad shatters on a genuine hard shot \u2014 a touch easier than before, the same bar at any range, and only then.\n- Inside range: incoming duck, roll and slip threats now approach from a readable distance instead of appearing right on top of you.\n- Hook counters in the new flow drills now present the pad facing the correct way.\n- Pivot drills: the on-pad numbers and feedback text stay upright and readable after you turn.\n", "created_date": 1782132381, "id": "27574666622169234", "version": "0.23.1", "version_code": 16779105, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
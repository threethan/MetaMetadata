n.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WIkxLgHc1YQ7kNvwHRM9xh&_nc_oc=AdnmPF3XuhHPMk3QaBlI7TIp0RW2tzYQewFMG5nsnfjmPbglLxsKGUkSxHhWOuEopM0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk5xr8WogMriT09Rx4jGpyOBogCAMqYlToOb6yJvCqqg&oe=69B1633A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFxGIHgG0SkQ7kNvwFMD0ih&_nc_oc=AdmEEL6xuTwR-4mQQppQgBjPCMxKxvfM98tedtVWKAKi_rSyv_fX8jqLxU_p0qbWYDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxl7pCJUnEtburdVFVVikmEn6UFNDECqdiZZZPKOIZRFg&oe=69B178DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86OF1LAnOkEQ7kNvwFuxVCn&_nc_oc=Adkufs134hM5YUc0jHwGDwXcoktdaFnThinOmk4U9UllQjhfvqUMol2FeTQLhMh2aME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytTU1kovwaLl7U_Qstr1dWNiPwIcX1ui3faGm9wt_lHQ&oe=69B14F52"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWrx5I_apNwQ7kNvwGFcptg&_nc_oc=AdmohhCWHUOK7FSoRUxQUEcYZ_4AJvzfNP2xv5M8tVXW1JG-j2RYiFRRNPkLjon0OBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1TOOy5y-ItM-og5gB6AUeYkJDMptir4uViC6BD0zhzg&oe=69B16269"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoZZGqLYD3oQ7kNvwFv57A7&_nc_oc=Adm3h2StIzFrl-LnfmmOjKwJtMTMNbS7POR4up_WOIUjokdo5XUM1MJco8gc-b-SUQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6dgO-IHzrVlj1SWZBYHdbIlnjuMA97eaZzYG8TRDnUw&oe=69B1729F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx1xz7ncJz8Q7kNvwFoSjpp&_nc_oc=AdmxJEGjVG79gGEX-X118stDsDWbWVXHmcx5sJPEH34VCr6Fw1rLVeug0TSgd118bPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmM0X3IuV2LLfGy1KmO9FGnAoZxwaeb8jmpFzjtmZHMQ&oe=69B17856"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "4443476652641359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772139060, "status": "PUBLISHED", "id": "4443476652641359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26308914735411102", "version": "0.6.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.7.0\n\n**Southpaw Mode**\n- New Southpaw toggle in settings \u2014 flips all punch-to-pad and hand assignments so right-foot-forward boxers train naturally\n- All existing and future drills work automatically with no per-drill changes\n- Pad colors swap to match stance (blue = lead hand, red = rear hand regardless of stance)\n- Orbit drills, combo validation, and slip rope offsets all respect the southpaw setting\n\n**New Drill**\n- Added 3-4-2 drill (Left Hook, Right Hook, Cross)\n\n**Visual Improvements**\n- Boxing pads now have a dark back face for better visual distinction when rotating\n\n**Training Rank**\n- Removed fight gating from career progression \u2014 all opponents are now accessible\n- Added Training Rank display based on lifetime training points\n- Enlarged UI panel for better readability\n\n**Store & Landing Page**\n- Fixed Meta Horizon Store button link to point to actual listing\n- Added source code link to landing page\n- Added anchor IDs to guide headings for deep linking\n", "created_date": 1772788657, "id": "26320205307615378", "version": "0.7.0", "version_code": 16777751, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.6.0\n\n**Scoring Overhaul**\n- Power and speed now use per-punch-type velocity thresholds instead of one generic range \u2014 jabs are judged as jabs, crosses as crosses\n- Speed based on punch velocity (m/s) instead of reaction time \u2014 footwork movement no longer penalizes your speed score\n- Separate weight class scaling for speed vs power: lighter boxers have faster hands (higher speed bar), bigger boxers generate more force (higher power bar)\n- Agility replaces depth bonus with reaction speed \u2014 how quickly you dodge after the threat appears (<=0.3s = full credit, >=1.0s = zero)\n- Body engagement excludes jabs \u2014 they're lead-hand snaps where body rotation isn't expected\n- Body engagement display on complete screen only counts non-jab punches\n\n**Form Scoring**\n- Form now measures two components equally: off-hand discipline (50%) and punching hand retraction speed (50%)\n- Off-hand check: is your non-punching hand in guard at moment of impact?\n- Retraction check: does your punching hand return to guard within 0.5s? Must reach chest level \u2014 letting it drop doesn't count\n- Guard zone is stance-agnostic \u2014 both face-guard and body-guard stances accepted\n- Removed height requirement from off-hand guard check so body-guard boxers aren't penalized\n\n**New Drill**\n- Added 3-7 (hook head to hook body) drill \u2014 the liver shot combo\n\n**Menu Redesign**\n- Tab-based layout with TRAIN / FIGHT / WORKOUT / SETTINGS tabs\n- Category sub-tabs within Train (Punch Combos, Defense, Footwork)\n- Three-level joystick navigation: tabs, sub-tabs, drills\n\n**UI Improvements**\n- PR indicators shown on workout transition screen between drill segments\n- Scoring guide added to the complete screen\n- Guide link promoted to prominent button on landing page\n- Fixed joystick navigation getting stuck on non-Train tabs\n", "created_date": 1772689011, "id": "26308914735411102", "version": "0.6.0", "version_code": 16777750, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772688125, "id": "26308828175419758", "version": "0.5.0", "version_code": 16777749, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772687557, "id": "26308772215425354", "version": "0.5.0", "version_code": 16777748, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26308914735411102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.5.0\n\n**Numbered Pads**\n- Punch numbers (1-8) now render directly on pad faces as dark embossed digits on red pads\n- Bitmap number textures generated at startup (64x64, scaled 5x7 font)\n- Replaced per-punch-type color-coding \u2014 all pads stay red for a cleaner, less distracting look\n- Numbers update dynamically: active pad shows current punch, inactive pad previews the next\n\n**Fight Mode**\n- New persistent career system where real training performance builds fighter stats\n- Per-punch-type stat tracking (jab, cross, hooks, uppercuts, body hooks, duck, slip) using rolling average of last 5 sessions\n- 8 sequential AI opponents with unique styles (Glass Joe to The Champ)\n- Round-by-round narrated battles testing specific punches, combos, and defensive actions\n- PR indicators on complete screen: \"NEW PR!\" (gold), near-miss (cyan), first time (green)\n- Fighter card UI with per-punch stat bars and opponent info\n- Career progress (wins/losses/KOs) persists across sessions\n\n**Punch Validation**\n- Punch type validation checks velocity direction against expected punch direction (jab=forward, hook=lateral, uppercut=upward)\n- Wrong punch type flashes pad magenta with \"WRONG PUNCH!\" HUD feedback\n- Weak punch feedback: intentional touches below hit threshold flash pad orange with \"TOO WEAK!\" HUD text", "created_date": 1772596562, "id": "26298731693096073", "version": "0.5.0", "version_code": 16777747, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
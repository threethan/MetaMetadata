m&_nc_ss=8&oh=00_AfwKk6214ew9_4m1QjvcnB0tE7QbMQkRZ-XjXNP3n8Mc2g&oe=69BFF95D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XJySDL_bLwQ7kNvwEKQjL6&_nc_oc=Adlu9Ujaz4pAxWLgQCOkcm7kAXmD4Qfu-C90aEceZnK7yFGvuUE0r2NgpBFTh4_Q1jk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxD8kTb6Ja5kjgiBrUxw8eCmaH0TcYnp8h7-4xoKFvK9w&oe=69BFCFD2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn1C5Ph5mRQQ7kNvwFZMYuX&_nc_oc=AdnSQwV7FfFGKz7Fi-Spi5jkpejH43Q5Pr5JrWUvhmr47r0LAvJWkYoXCcqlxhA51sI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyim-rzDVkA9o_M-RsVV_yCltXTbFiFWDXZe7VJuTdQkQ&oe=69BFE2E9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVqEMBsvPrkQ7kNvwFLU1YK&_nc_oc=Adkwj2va5jGmK7htwdWHabRHJRJUHHQRgKx--b4QV6PNMhqsCx28UkbszfEOPgbVlxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzocp8li0U5JjyAWElATqxO1P0Kltzuh7UjpMjPmgtg5Q&oe=69BFF31F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JccQUpR7nBQQ7kNvwGZNpWu&_nc_oc=AdnxSOmPj5_u60fcDSX3zSYuMkNifH_LYD1kxORJTijoXIAE8_ClN00PcyBZktuBbdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzo-xr7XIZ3T_ET944xoQpAkvwbe_8EYiKHhfryDDMpVw&oe=69BFF8D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "1657151418799256"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26417723011196940", "version": "0.10.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417723011196940"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1773801128, "id": "26439450649024176", "version": "0.10.1", "version_code": 16779018, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417723011196940"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.10.0\n\n**Leagues**\n- New League selector sits between the tab bar and drill list \u2014 always visible\n- Choose Custom, Beginner, Amateur, or Pro; tap the name or arrows to cycle\n- Custom is free play: all settings adjustable, Fight mode locked, no fighter stats recorded\n- Ranked leagues (Beginner / Amateur / Pro) lock settings to a fair common baseline so every player's stats are comparable\n- Each league has its own independent fight record, cooldown timer, and stat pool \u2014 you can progress through all three simultaneously\n- Fight tab locked with tooltip in Custom; unlocked in any ranked league\n- A league badge appears in the drill HUD top-right during ranked sessions confirming stats are counting\n- Locked settings show a padlock icon and league name in the Settings tab\n- Compact settings summary shown inline next to the league name (speed, power, pressure, footwork)\n- Beginner: Normal speed, 30s, 4.0 m/s speed threshold, 10% body gate, lateral footwork ON 20%\n- Amateur: Progressive speed, 45s, 6.0 m/s, 30% body gate, 1200ms speed pressure, lateral 20%, depth 10%\n- Pro: Fast speed, 60s, 8.0 m/s, 50% body gate, 800ms speed pressure, lateral 30%, depth 20%\n- Each league has its own opponent roster with themed names (rec-centre / amateur circuit / pro main event)\n\n**Speed Pressure**\n- New setting: pad retreats automatically after a configurable window (400\u20132000ms) if not hit\n- Missing the window counts as a missed action and affects your score\n- Pad shifts orange then pulses red as the timer closes \u2014 a physical urgency cue, no separate HUD element\n- OFF by default in Custom and Beginner; 1200ms in Amateur; 800ms in Pro\n\n**Power Threshold (Body Gate)**\n- New \"Power Threshold\" setting requires minimum body engagement for a punch to register\n- Measured from pure head movement or rotation only \u2014 completely independent of punch velocity\n- Jabs are exempt (arm snaps, no body rotation expected)\n- Rejected punches trigger \"USE YOUR BODY!\" feedback\n- In Beginner (10%) any slight body movement passes; in Amateur (30%) and Pro (50%) you must commit\n- In Custom the slider is free (OFF by default)\n\n**Footwork Improvements**\n- Pads now extend immediately when the trainer shifts position \u2014 no more waiting to arrive before the pad appears, making movement feel natural and fluid\n- Fixed a stuck/overshoot bug at low depth percentages caused by absolute minimum shift distances \u2014 shift magnitudes are now proportional to the configured range\n- Lowered default depth footwork from 80% to 30%\n\n**Fighter Stat Rework**\n- Power now uses 90th-percentile punch velocity (peak performance) instead of session average\n- Speed now uses median velocity (stable measure resistant to outliers)\n- Form now measures consistency \u2014 low variance across your punches scores higher (coefficient of variation)\n- Fixed slip and duck stats being conflated \u2014 each is now tracked and displayed independently\n- Overall fighter rating simplified to three orthogonal dimensions: punch average + defense + form (was double-counting velocity-derived stats)\n\n**? Help Button**\n- New corner button opens a controls reference and settings tips modal\n- Includes a link to the full online guide\n\n**What's New & Review Prompt**\n- Release notes button shows what changed since your last version\n- App store review prompt appears after 5 completed sessions", "created_date": 1773631623, "id": "26417723011196940", "version": "0.10.0", "version_code": 16779017, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417723011196940"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1773629547, "id": "26417474064555168", "version": "0.10.0", "version_code": 16779016, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417723011196940"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.9.0\n\n**Punch Feedback**\n- Floating hit labels appear above the pad on impact showing up to three metrics: velocity (m/s), body effort (%), and power score (0\u2013100)\n- Each metric is individually toggleable in Settings under \"Hit Feedback\"\n- Labels rise and fade over 1.5 seconds\n- Velocity and body effort are ON by default; power is OFF by default\n- Power label blends velocity score (70%) and body engagement (30%), matching the end-of-drill stat formula\n\n**Body Engagement**\n- New \"Head Rotation\" mode as an alternative to the existing \"Head Movement\" mode\n- Head Rotation measures headset yaw delta in a 200ms punch window as a proxy for torso rotation (~2\u00b0 noise floor, ~15\u00b0 = full engagement)\n- Selectable via \"Scoring Mode\" in Settings (visible when Body Scoring is ON)\n- Defaults to Head Movement \u2014 no change for existing users\n\n**Footwork**\n- Split footwork into two independent modes: Lateral Footwork and Depth Footwork (beta)\n- Each has a configurable amount slider (10\u2013100%)\n- Lateral footwork is now ON by default at 50% for fresh installs\n- Workout tab reflects both footwork toggles separately\n\n**Settings**\n- New \"Required Punch Velocity\" slider (1.0\u201312.0 m/s) \u2014 sets the minimum speed for a punch to register, encouraging powerful technique\n- Default punch velocity threshold: 3.0 m/s\n", "created_date": 1773390289, "id": "26389207540715154", "version": "0.9.0", "version_code": 16779014, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26417723011196940"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1773382047, "id": "26388349614134280", "version": "0.8.0", "version_code": 16779013, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&oe=6AE4BD58"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkHxt544kGsQ7kNvwFU2t9i&_nc_oc=AdpEtM7sts9UO8yRCbRXnoPzaUWp-BOxkaG6mC56gLf36u6SsdPB430SKK2BbJQkaMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGIMn4CL6laVnywnK6DjEtgJhKAPHRjTsnsKq19pcu0Q&oe=6AE490BA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rdayyr6-0MQ7kNvwGjMb2Q&_nc_oc=AdrkOI-MMFxJI5tn9ROy_OB-CPPAnfa2HIe-y_wwZc__HQWEjPbgsNoEE5o6D0Kkm00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnPyGhE3uxcffPDKyRZUBlSRo0GCJ2m9VwIS88UHtrmw&oe=6AE4A65D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccpPJ-CmF-cQ7kNvwHVcHyH&_nc_oc=AdpG997CfgjbL7u7eDNwvqOOoWWYu5_lhDAcX1rHVbDcWTdviu6iY9rBOcQTlyVaDtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP9eE4Yia5Sti6gxxREs-E3dB92TVNa-WdqORvstpYuQ&oe=6AE4B512"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2iJHGSiuzoQ7kNvwGiwPz7&_nc_oc=AdoD_WfFE2-b-RovqrWNv4NutHv3JR5s-VFKyY8wYrbDlRx8bZrSqcxtXVJV6t9ifPk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg91NL6ScAeAk9gu0WrAqYwqUlXe-WJcpi_HgmTBn4Mw&oe=6AE48FE9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2Etjm5iLEIQ7kNvwHrYV0y&_nc_oc=AdpU7H6h807hq_Fh92-rwAlCevojq3d8aJOYMDc7UN6agtS-8IJUj1B647zZ04ziIvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5HOvVTBsyKVIpYNnnU789O7wau0Dk9VYh4TJLZSUFQw&oe=6AE4A01F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtxH48wwIlAQ7kNvwG1gDyY&_nc_oc=Adp9WCwgBhblElKk7fFXttOb5XDNZ6O2Rj6uoogfWoJvEDlJQcKEUK-fr-Ro-BGNoLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTEY4Z5yvn852yDMxiXXoKCfhKbnu8ppzsf5Zsar50dg&oe=6AE4A5D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1744772810063418"}, {"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1744772810063418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28805541715748379", "version": "0.38.6"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28805541715748379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.6\n\n**New Defense drills: the pull counters**\n- PULL & UPPERCUT: pull straight back to make the punch miss by inches, then drive the rear uppercut into the chin as it leans in after the miss. The pull loads the shot.\n- BODY PULL: the first drill where the attack comes at your midsection. Pull your hips and weight back so the dig falls short, then answer with the uppercut and a lead hook before they stand back up. Body shots can't be caught on your gloves here, so the pull is the only way out.\n\n**LASER TAG**\n- The attack warning now glows around the whole orb instead of hiding inside the shell, so the colours are readable at a glance: red for the slip bolt, gold for the 1-2, orange for the duck beam. A clean tag pops the glow white.\n- New green attack: a laser dug at your body. Slipping won't save you. Drop an elbow and take it on the forearm. The orb goes to the body more when your hands sit tight at your chin.\n", "created_date": 1790835865, "id": "28805541715748379", "version": "0.38.6", "version_code": 16779248, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28805541715748379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.5\n\n**New drill: LASER TAG**\n- A duel with a live training orb. It darts around your space between waist and head height and flees every clean tag. Catch it with your feet, not by leaning.\n- The whole time, it shoots back. Its core flares a colour before every shot: red is a little bolt you slip, gold is a straight 1-2 you block or slip, orange is a wide beam you duck under. Tag it while the flare is running and you break the shot.\n- It fights like a boxer. Lazy hooks get ducked, creeping reaches get slipped, lunges get pulled away from, and the moment your hands drop it fires. If you throw the same punch over and over, it notices.\n- Chain quick tags for combo damage, with an arcade callout showing the combo you landed. Mixed punches hit its core harder than repeats.\n- Wear its core down all round. It only breaks in the final ten seconds, so when the FINISH IT call comes, empty it and watch it blow apart.\n- Tags need real punch power, scaled to your League, and the orb has a voice: it growls when you hit it, chirps when it dodges you, and groans when it dies.\n", "created_date": 1790762334, "id": "28794719280163956", "version": "0.38.5", "version_code": 16779246, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28805541715748379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.4\n\n**GHOST HUNT is now one drill**\n- The five GHOST HUNT drills merged into a single longer chase. One pass covers every escape: they pull away (step in), duck (dig the body), roll (send the uppercuts up the middle), fire back (pull out of range and counter), then break for the exits both ways (cut them off, and they walk onto your right hook).\n- It runs 90 seconds so you get several passes in.\n\n**Livelier pads**\n- Uppercut pads now sit at chin height, where the punch actually lands. They were too high and awkward to reach.\n- Pads no longer appear at exactly the same spot every rep. Each offer lands a few centimetres off, like a real trainer's mitts, so you aim at the pad you see instead of punching from memory. Too small to move your feet, big enough to keep your eyes honest. Drills with calibrated targets (SLIP SCHOOL, the rope drills) keep their fixed spots.\n\n**REACTIVE DEFENSE**\n- The attacks now come eight ways: slips left and right, duck, pull back, weaves left and right, and rolls left and right. Evade, then rip the counter.\n- The drill runs 90 seconds so you meet every attack, and the tips explain the new weave and roll cues.\n", "created_date": 1790743146, "id": "28792122547090296", "version": "0.38.4", "version_code": 16779243, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28805541715748379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.3\n\n**New drill family: GHOST HUNT**\n- The pads play an evasive opponent. They slide out of range as you punch, slip your shots, duck low and pivot away. Chase them down and answer each escape with the right punches: step in when they pull back, dig the body when they duck, cut them off when they angle out.\n- Five drills. GHOST HUNT teaches the full chase, UPPERCUTS, BODY SNATCHER and CUTTER each hammer one answer, and READER drops the script: every pass they pick a different escape, and you read the pads to know which.\n\n**New drill: WEAVE WALK**\n- Walk your opponent down, Tyson style: weave forward under punches and land the body-head hooks. The pads back away as you advance, then you walk back and go again.\n\n**Menu**\n- Everything that narrows the drill list now lives in one FILTERS menu: categories, technique tags, combo length and focus. The button sits front and centre on the Train tab and shows how many filters are active.\n- The filter menu works fully with the joystick: move through the chips, A toggles, B backs out.\n- The Help button moved from the corner up next to FILTERS, so the controls cheat sheet is right there when you forget a hotkey.\n\n**Controls**\n- Pausing is the menu button only now. Y no longer pauses, so clipping it mid-combo can't interrupt your drill.", "created_date": 1790417135, "id": "28747574814878403", "version": "0.38.3", "version_code": 16779241, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28805541715748379"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.2\n\n**Three new languages: \u65e5\u672c\u8a9e, \ud55c\uad6d\uc5b4, \u0420\u0443\u0441\u0441\u043a\u0438\u0439**\n- The whole app is now available in Japanese, Korean and Russian, joining English and Spanish. Menus, settings, drill names and descriptions, coaching tips, workout and fight screens, the tutorial, all of it.\n- On Auto, the app follows your headset language. You can also pick a language directly in Settings, and it switches on the spot.\n\n**Spanish is now complete**\n- Around 200 drill names, descriptions and coaching tips that still showed in English are translated. Every language now covers the same ground.\n", "created_date": 1790070045, "id": "28691669960468889", "version": "0.38.2", "version_code": 16779239, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
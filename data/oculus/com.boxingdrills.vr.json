9096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HSn3GUe5FsQ7kNvwHt7Vqs&_nc_oc=AdpBc-GeV4AO-l0ahuwGhfRiEueUTwRcGmU_JrQsiGhQo66Xaa57PTgj4ZaRbYkd2Qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqxtNS-n5AKTFEih4SKd5ouF66VnyjbcoxLPwG73B8xQ&oe=6B0C7A52"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeQlSHlfAeYQ7kNvwFESznX&_nc_oc=AdolrnyrfBaL9qdn5bV-FwnNlaJu9gWDlh0SXPeXHG3ES2QZRpuHU2MP6a4QoZXWcB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgfmaiH3ntHZJk9zUIb_oMmMSjgHtcS9C4DrxuK5qPvw&oe=6B0C5529"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj1Lrbr8PLMQ7kNvwFCOnV6&_nc_oc=AdowS-lmy08xzh9nMgnn-f-kjMC3K6w1TfYIiR_gY8DsU7fAzIvRf56ZmfuHo1vwSiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5wSu3L5WBK8fvTpjM7uSCo2M7apq-HJBO0gVO9fFB2Q&oe=6B0C655F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVylOTsUGg0Q7kNvwFRrC4v&_nc_oc=Adqt5oEQm5T-kScClVcEYtOcfjTm-Fhy_y6xnDEOCT0KXUy_GiWUdLCp0VKIf5VqWAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkTrWs5yX9rxhTN1pzRggffwGVhwKpMLeQtqKdZsEr2w&oe=6B0C6B16"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1808138950337735"}, {"status": "PUBLISHED", "id": "1744772810063418"}, {"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1808138950337735"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29516597647976112", "version": "0.40.3"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29516597647976112"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.3\n\n**Crash fix**\n- Since v0.40.0 the game crashed every time it closed, for example when you quit or the headset shut it down. That is fixed. This was the crash behind most of the reports from v0.40.2.\n\n**Graphics**\n- Graphics settings are now set per headset. Quest 2 gives up some sharpness, mostly at the edges of your view, to hold a steadier frame rate.\n- The game does less drawing work each frame and loads textures in the background, so there should be fewer hitches.", "created_date": 1795246237, "id": "29516597647976112", "version": "0.40.3", "version_code": 16779256, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29516597647976112"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.2\n\n**Freezes**\n- Since v0.40.0 the game could sometimes freeze until the Quest offered to close it. When the game hits an error now, it closes straight away instead of hanging.\n- Each of those errors now sends me a crash report saying where it happened, so I can find the causes and fix them in the next update.", "created_date": 1794715058, "id": "29431314569837754", "version": "0.40.2", "version_code": 16779254, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29516597647976112"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1794714123, "id": "29431180406517837", "version": "0.40.1", "version_code": 16779253, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29516597647976112"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.1\n\n**The Boxing Drills gym**\n- With mixed reality off, you now train in a boxing gym. There's a full ring with leather ropes, heavy bags, speed bags and a double-end bag, fight posters on the walls, a wall of fame, and windows looking out on the street.\n- A round clock on the wall counts down your drill. It shows green while you work, amber for the last ten seconds and red while you rest.\n- When a drill starts, the house lights go down and the ring stays lit. They come back up when you're in the menus.\n- A cat wanders around the gym. It stays out of the ring.\n- The gym is now the default virtual scene. Settings > Scene picks Gym, Lakeside or Off, and replaces the old Lakeside Scene switch.\n\n**Starting in the gym**\n- After this update everyone starts in the gym once, so you can see it. A card in the menu lets you switch straight back to mixed reality if you'd rather train in your own room.\n- New players start in the gym, and the last step of the tutorial asks where you want to train.\n\n**Defense cues**\n- Threat Wind-up is now off by default. If you want every threat to pause before it flies, turn it back on in Settings > Threat Wind-up.\n", "created_date": 1794384113, "id": "29375460808756464", "version": "0.40.1", "version_code": 16779252, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29516597647976112"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.40.0\n\n**A new renderer, built for Quest**\n- I rewrote the code that draws the game on Quest from scratch. The frame rate is noticeably smoother, the lighting is better, and edges are cleaner because every frame now gets anti-aliasing.\n- Each frame takes less work than it used to, so the headset runs cooler and the battery lasts longer.\n- It's also the groundwork for better 3D models and scenes in future updates.\n\n**Lakeside scene**\n- Turn mixed reality off and you now train on a wooden deck by a lake at dawn, with sky, distance fog and moving water, instead of a plain dark room.\n- It's on by default in virtual mode on every Quest. Mixed reality is still the default view, and you can switch the lake off in Settings > Lakeside Scene.\n\n**Defense cues**\n- Every incoming threat now holds still for a beat, with a double-tap sound, before it flies, so you have time to read it. If you'd rather only the first of each kind paused, turn off Settings > Threat Wind-up.\n- Slip and weave cues now move like a real punch: they cock back, tremble, then snap in. The slip glove is closer to real glove size too.\n- Back-to-back ducks now show one bar that swings across and comes back. Before, the second bar could appear while the first was still swinging.\n\n**Coach**\n- The coach steps in when the pads are held out at punching range, so its arms no longer stretch in the 4-AXIS drills.\n- It now turns its shoulder behind whichever pad it offers.\n\n**Drone Orbs**\n- New option for SPEED ORB and COMBO ORB: land a punch and the orb darts to a new spot, like a fighter drone. Off by default; turn it on in Settings > Drone Orbs.\n\n**Quit button**\n- The main menu has a close button (X) in the top-right corner. It asks before quitting.\n\n**Bug fixes**\n- Quitting from the Meta menu and launching again no longer gets stuck on the loading dots.", "created_date": 1794279651, "id": "29357895370513008", "version": "0.40.0", "version_code": 16779250, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
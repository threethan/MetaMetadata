&oe=6AAC0CD8"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBgnHnBa7ScQ7kNvwGYxANU&_nc_oc=AdpdVdu8WsfAB7s4YJthHpb5aXLLuubJ2NLVeKWd2dPiNoWWlaslRbonicv6OkP2E6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbRaTzW_eo4l6NTHpCL07RQb9lmmjvt5NfSq-WB7UVPA&oe=6AABE03A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoFCS1FNtw0Q7kNvwHRghef&_nc_oc=Adr53bsHaAb3O6zP_k5bOIgxaR3NCeK1Jwc7bCr0XWCNScjr7wc3B9MO_XCeV-t5xRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM27spgWPrtZfYCswH42xAbl7nSzT7eVkcykOt5rz1Ag&oe=6AABF5DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2Wk9xFXY5MQ7kNvwGlBJQ2&_nc_oc=AdrsocI8z5_rdsni7h1ghMExzqhsSGTuYZnGvVwMx0hVqVWwgYk1n7zYqvfwpbtXgls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP4D4OStHFSpeAVv9XGwXIPoLU4BPN02B-sv6EO1la0w&oe=6AAC0492"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQlnJIJ9inoQ7kNvwESpIQ0&_nc_oc=AdpC32y2XtnOqkAG-nyC8hOO-OKgHdyzcc4HfPMpcVQjznWzhoM2hz3DGFjd1mrkAF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc_CWfOGlALqMhSEdEi6FZBpzK_k8TQ494qHF_9p7bsQ&oe=6AABDF69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amy2wcHBjkcQ7kNvwE5tkC9&_nc_oc=AdrtKU8F2U4_qodhYdr71iWd0Pay-fQeh8ejdJhXlygJ8eDMmh9WaYewnWE1LiACsPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2YrNSad0HGCfceR0KE4RAlaSUizA0fC5BULzZP6sDzg&oe=6AABEF9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_vrFoF7SakQ7kNvwGm9EKd&_nc_oc=Adq78OpEzLrwMdlGYrAa4vgeIJdzjeIDY6gUwJoOYBYY5R-ufp1c5RK17gI_D4maw50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKlRxOGOi1Q5WLYlH9YGzojrvS4gY4UEuIN9jwberr2Q&oe=6AABF556"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1744772810063418"}, {"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1744772810063418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28471131649189389", "version": "0.37.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28471131649189389"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.37.0\n\n**The double-end bag and speed bag finally hit true**\n- Both bags used to fly off wherever your hand path wobbled, which made them nearly impossible to keep straight. Punches now work like a real flat glove: aim near straight and the bag comes straight back, so you can actually settle into a rhythm. This is the biggest change to how both bags feel since they were added.\n- Deliberate angle shots still work. Hit the bag from the side and it goes sideways, and the speed bag still rolls around its rim.\n- New Bag Straightening slider in Settings, default 50%. Turn it up for a stronger pull, or down to 0% for the old raw physics.\n\n**Floor marker**\n- The stance ring and arrow no longer appear in the double-end bag, speed bag and heavy bag drills. There is no fixed spot to stand at a bag, so the marker just got in the way.", "created_date": 1788660534, "id": "28471131649189389", "version": "0.37.0", "version_code": 16779233, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28471131649189389"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.36.0\n\n**New FIGHT IQ tab**\n- This is an alpha feature. It may see significant changes or be removed entirely in the future depending on feedback.\n- Every advanced combo now has a name you can actually remember. BREAD & BUTTER is 1-2-3, KNOCK KNOCK is 1-1-2, TRAPDOOR is 1-1-2-7-3. The names appear on the drill cards too.\n- The tab holds flashcards built from those combos. Each card shows the sequence, when to throw it, and which situations it answers. Rate yourself GOT IT or AGAIN and the card comes back on a spaced schedule, from daily up to every two weeks as you learn it.\n- Press THROW IT on a card and real pads appear in front of the menu, so you can throw the combo right there without starting a drill.\n- The FIGHT IQ drill lives in this tab as TEST YOURSELF. It calls a situation plus a combo name, like AT LONG RANGE - DOUBLE TROUBLE, and you throw the answer from memory. The numbers only appear if you hesitate, and the test calls your weakest cards more often.\n\n**Best Combo time**\n- Combo drills now time each combo from first impact to last. The results screen shows this run against your personal best on one bar per combo. Only clean reps with no weak punches can set a best.\n- COMBO CALLER shows the current call on a banner at the top of your view until you complete it, replacing the floating text.\n\n**Double-end bag**\n- The cords are much tighter by default, so the ball snaps back about twice as fast. A new Bag Tension slider in Settings lets you tune it to taste.\n\n**Menus**\n- The results screen is bigger and its content scrolls, so the buttons below can no longer get pushed out of reach.", "created_date": 1788651047, "id": "28470000702635817", "version": "0.36.0", "version_code": 16779231, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28471131649189389"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788650329, "id": "28469920929310461", "version": "0.36.0", "version_code": 16779229, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28471131649189389"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.35.1\n\n**Mirror Pads fixes**\n- The mirrored layout no longer snaps back to the normal side after a footwork step.\n- Hitting the offered pad with the wrong hand used to flash PERFECT! while the drill refused to move on, which read as a stuck pad. It now flashes red with a WRONG HAND callout and the pad waits for the correct hand.\n- Light brushes with your other hand stay silent. Only a committed punch gets the callout, so guard returns and follow-throughs are ignored.\n- The wrong-hand check follows your stance, including southpaw and auto switching.\n\n**Settings**\n- New Reset to Defaults button at the bottom of Settings. It returns every setting to its default and keeps your bests, stats, favorites and saved workouts.", "created_date": 1788508616, "id": "28447600488209172", "version": "0.35.1", "version_code": 16779227, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28471131649189389"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "## Release Notes\n\n### v0.35.0\n\nDo the tutorial again before you play, especially the new ADVANCED COMBO page. It teaches the escape step in a safe setting.\n\n**Escapes: punch, then get out**\n- 13 advanced combos now end with an escape. After your last punch the floor ring slides to one side and a big green glove flies at the spot you punched from. Step onto the ring before it arrives.\n- Green means move your feet. It is not a slip, so you can't block it or dodge it in place, and the glove is bigger than a slip threat so the two read differently.\n- Many of these combos mix a slip, duck, roll or weave into the exit. The mix is rolled fresh every rep, so one rep is a plain escape and the next makes you roll out under a hook.\n- Every dodge and escape in the exit appears at its spot a beat early, resting in place while the previous one is still flying, so you always know what comes next.\n- New drill: 1-2-3 ROLL OUT. Hook, roll under the counter, step out.\n- 1-1-2-7-3 now runs the classic L-step: step onto the ring, then pivot to face the pads from the new angle.\n- Escapes count toward your defense score. If you want plain pad work, turn them off in Settings.\n\n**Pads**\n- The overhand pad now angles up to catch the shot looping over the top. It used to sit flat like a cross pad.\n\n**Menus**\n- The stance selector (Orthodox / Southpaw / Auto) is now on the Workout page as well.\n- Long workout plans scroll inside the drill list instead of pushing START WORKOUT off the panel.\n- The guide link now also lives at the bottom of the Settings page.", "created_date": 1787380082, "id": "28279252828377273", "version": "0.35.0", "version_code": 16779222, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
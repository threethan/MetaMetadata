4361061587556460", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622325_4361061590889793_8443499001590631147_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ab5zTigZhEQ7kNvwFgUY7s&_nc_oc=Adoj9IMg6M3R_JlQKq754kvgSzneUYB-ibbMwP17msI4kYfLS0wHRf2ZKSd6Mrjml1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NOqG8Lc8P0i3T20Jq91Vl8PlOQLtF-h6RZJtkJfHmxg&oe=6A427926"}, {"file_name": "com.boxingdrills.vr-20260612-160524.png", "id": "1790742922336026", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1790742929002692_2967370313329941720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRsb3cl3VecQ7kNvwF9gcI4&_nc_oc=Adra5Sg9sVKwAXc2zUv_a-zdH2Tbff7ngsRWPk6wrsfIr3pMZviUmP8O6eOjmpW65Wk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NTdGwEycYBA1lz99hgquvpHKqOd5uBhXnEDRXhitLyw&oe=6A428D37"}, {"file_name": "com.boxingdrills.vr-20260612-160549.png", "id": "1642629256847878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619681_1642629260181211_4239273547513896385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXjRWbY-q1AQ7kNvwFoyYgE&_nc_oc=AdrFtIU2Y8COHJjG4gTGawRiYe0oA_sL-mDZV_h_hUg9PlQqiJoTX4Umw1C4Tug0oJU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H456UuhbO_ifkwsUnKHH5bopxJvRM_3LvYEP_xZOlKg&oe=6A42888E"}, {"file_name": "com.boxingdrills.vr-20260612-160540.png", "id": "1283005677155850", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623443_1283005683822516_4340392285963543058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3fQDCyvdSQQ7kNvwGMHtcc&_nc_oc=Adr5w7AT0IqGf4O4aoDEh10GHMWhNUX3SMTwrrn_PO8pgxs18VhujA12fs88EALLkDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y8OvDSUYbr8yd75Qd9paMv9BD9IwDymXXJimFDQZ13Q&oe=6A4285DF"}, {"file_name": "com.boxingdrills.vr-20260612-160507.png", "id": "998205189422993", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507898773_998205192756326_7953914639717337464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrbjr35dgSIQ7kNvwGlCYfZ&_nc_oc=AdqlqIMWZHvud6QcbtWNsnOAmUWr0d_56EGXgh4gkZbjPg6pcRqKW66Kp-kvKzlhkvI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z59a15U0LMQnIssXH8cqxyl_ozkqYdVI5wW9rLTCc2g&oe=6A428BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnEH8SU9ZAQ7kNvwGEMPnR&_nc_oc=Adp49D-znQjSOgQ6iq_7LYdMYcGoH93qb5GGa-Yo50Ad2PmK6SmzGQIbCvMpiJrVkic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tUp6k7C2Lk2DABgOK0nOm_t5uZMKjgED-jtG1nigR1w&oe=6A427D56"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Your coach calls the combination. You move, punch, slip. This is pad work \u2014 real pad work. Not a rhythm game. Not a cardio app. The training fighters actually do, in your living room.\n\nBoxing is a craft. Footwork, guard discipline, hip rotation on the cross \u2014 not learned by pressing buttons. Drilled into instinct.\n\nBoxing Drills puts you in front of virtual pads and holds you to real standards. Punch too soft? It doesn't count. Drop your guard? That's a point off. Stand flat-footed? The trainer steps out of range \u2014 move.\n\n**Train like it means something**\n- Many drills across punch combos, defense, and footwork with more being added regularly\n- Pad trainer shifts laterally and forward/back \u2014 reposition or lose the angle\n- Minimum punch velocity threshold \u2014 weak shots don't register, so you learn to commit\n- Body engagement scoring \u2014 measures hip rotation, not just arm speed\n- Real-time hit feedback: punch speed (m/s), body effort, and power score on every impact\n- Southpaw mode \u2014 train in your natural stance\n\n**Track what matters**\n\nPower \u00b7 Speed \u00b7 Agility \u00b7 Form \u2014 scored every session and compared against your personal bests. Career mode builds your fighter profile and tests you across 8 opponents. Workout mode chains drills back-to-back for sessions up to 60 minutes.\n\nJoin the Discord at https://discord.gg/8FyagxceKs and help shape what comes next.\n\n*Clear some space. Put the headset on. Throw a real punch.*", "short_description": "Real pad work. In your living room.\n\nThrow combinations, slip punches, move your feet \u2014 the virtual trainer shifts position and your punches only count if they land hard. This isn't a rhythm game. It's how fighters actually train.\n\n30+ drills. Workout mode chains them back-to-back for up to 60 minutes of continuous training. Real-time power, speed, agility, and form scoring. Career mode. No subscription.\n\nPut the headset on. Throw a real punch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27500387502930480"}
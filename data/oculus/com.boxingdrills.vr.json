": "2095210894392717", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZe1lA9y148Q7kNvwF86gaU&_nc_oc=AdqMKcXa9PmYaYPKluEdPyz2qd3SbTb8hm3lG9JjN4h9QoNYWAfK5mOzXRF0oOxMAY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG5E-OTq9m0bAhUVtTv8iYJvRCXRvs5Ur0pMPmCR0uLA&oe=6A8C443C"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcaLOesTFAgQ7kNvwGp41f2&_nc_oc=AdoXdOxS9Ks3APN398UvH33ye6aDetJkRkES8c-Dc42SxND7jzCIji2JY02lGSLc868&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5dsC8K5mCi-sLmlWvnEUUO6EY8tW9NPU-RwtTrcdLnA&oe=6A8C14E1"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv7VLuz_QE0Q7kNvwFI1vg-&_nc_oc=AdrPA6Ln_uUKUH16UP7dAKQ0HM5lClpNDKXJEkMiLtBTk7PQ_a4YXyf1iLmoafqYUys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfx89TBJ4ac39Nu8qk504cWvQSeThDEbLLHLFCGMCUqQ&oe=6A8C2020"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIG8CfIZj0EQ7kNvwGx4qQK&_nc_oc=Adqte8h_jViR3Hrp8KnORvBP8krwkDsmuJk76sK8fscZbA1p4RskW1TH5HgvbGtT7Ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7jsjq9cmOAle2CFgbo0swS3gGXevHdZznsasxDbRe6A&oe=6A8C3041"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35uXh1MYyRAQ7kNvwHqJCJT&_nc_oc=AdpeHCdp2GEs_9vojfxpe69MVmfwAkmAR5kkYlgjIyhyfhPMJDy18Ifkf8QUAe9Al0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxwzlNXlYfHy7hziGMP7xkJh0apm3HxXxVmJRm-MDvvA&oe=6A8C2B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1605866321257859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623443_1605866324591192_538714170404200545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6OHYE6BViAQ7kNvwF4cnRP&_nc_oc=AdoONZTL4hkdK1tIL90Cd9vnHTjBVgiQb9JCNFixbOdOINDVb_4kuWdK5wCm4G9eBQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfu1eVg08uvNG77b529uNt1d5gL8ev0f6qifXWPLJb6A&oe=6A8C45F7"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and drills. Your virtual coach handles the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n* Workout mode is exceptional for fitness and burning calories\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next, we are frequently adding new updates.\n\n**Clear some space, put the headset on, and try your first drill today.***", "short_description": "VR boxing and fitness focused on real mittwork and boxing drills. Throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required and only ever pay once.   Put the headset on and start training today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27968748599427699"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619681_1064827699329977_7045274292099501484_n.png?s
&oe=6A8C3098"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnztypgXnMoQ7kNvwEoTd8p&_nc_oc=Ado1W-kdIRxGmlhmoOixlSP180AJTdtgTQ0WT5_T9irOgfQ76WucekB_80FaNUdlpB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjotZEY5iaVZjzu6U1JyKQDa4pgq14gKRgPM514UBmNA&oe=6A8C3C3A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xJOd2xr95YQ7kNvwE98uR0&_nc_oc=AdoFFcS2WCWd-hcr_uxWI_kAOOXBT2aPMv3ngkbTESAwyHT0hyeEJ5SYQiwOjuwmLMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfQBoS2ZAtToMe7onB2ZICUMB2RQDXO984xcNgPXeDYA&oe=6A8C199D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8u9nPnRfnAQ7kNvwE0PuYf&_nc_oc=Adq6PBFVhRXUDjCc0UhdU9xgpT4awp4pSzGCJX8zKhY172GkxGZnm-cubq-Pscl4RnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMrN_Ff-vLQJgXa6c0ES8_rVPmATWNq35fU13gAaifyA&oe=6A8C2852"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmP464xXMwUQ7kNvwHDbMmd&_nc_oc=AdrTsNLjoMCctEM_WX5koW5s6knR9H71PY-yk3oVWDr3uDgm6UONy2EvlTVWCjz41GM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQdChdMX3BQ1yXjTiJD6e-DLLWS033ndLW93kXdPFSsQ&oe=6A8C3B69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNhrYP89qwMQ7kNvwG7oobT&_nc_oc=Adr4R2CYlDTkVQjX4HQcPCBva2_TEKbhXvEUgDN3xxwPKJE5Man2Ipp6YuMPkeGFa7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVpqBueBukS4u_4peuJDUyFYfo9VZMkFWyGXBgpszcRA&oe=6A8C135F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyFVw60JQscQ7kNvwHejR_G&_nc_oc=AdrILfhTUlNHzAQNNyUQMqNbAF_idoo_w62ea40AGmAtV0br-nIfY4A8iBZp__M-1YU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI8S32uDPdKKNtULq2onJRFEwBWRxbGlRktuG4bQeGLQ&oe=6A8C1916"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1013623321669324"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28240540595581830", "version": "0.34.13"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28240540595581830"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1787109136, "id": "28240540595581830", "version": "0.34.13", "version_code": 16779215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28240540595581830"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.12\n\n**Straight body shots**\n- Two new punches: the body jab (1B) and the body cross (2B). The pad drops to belly height and tilts the way a trainer holds it for straights downstairs. Bend your knees to get level with it, the level change is what scores.\n- Five new drills to train them: 1B-2B, 1-2B, 1B-2, LEVEL CHANGE (all four 1-2 height mixes in one sequence, so you have to read the pads instead of autopiloting) and SLIP & DIG (slip outside the jab, then dig the cross to the body from the angle).\n- Pad numbers and combo callouts show 1B and 2B so you always know which floor a punch goes to. Body straights count toward your body punch records in Career.\n\n**Combo Caller**\n- There is now a proper stop between calls. The pads pull back, the next combo appears, you get a couple of seconds to read it, then the pads come out. Before this the ten calls ran together as one continuous drill.\n- The new body straight combos are in the calling pool.", "created_date": 1787010112, "id": "28226799523622604", "version": "0.34.12", "version_code": 16779213, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28240540595581830"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.11\n\n**Workouts run their full length**\n- Drills that finish early, like COMBO CALLER completing its set, were quietly counting as their full scheduled length and cutting workouts short. A five minute workout now gives you five minutes of work.\n\n**Pause moved to Y**\n- Pause is now on the Y button. X sat right where a clenched fist could clip it mid-combo, so it does something harmless instead: it adds the highlighted drill to your workout list. The menu button still pauses too. ", "created_date": 1786503402, "id": "28152557444380146", "version": "0.34.11", "version_code": 16779211, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28240540595581830"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.10\n\n**Slip School 3: Body Rip**\n- The double now lands one shot at a time. The body pad is out while you slip; dig the body shot and the high pad snaps into place for the hook upstairs. One swing can no longer clip both pads at once.\n", "created_date": 1785917722, "id": "28067730969529461", "version": "0.34.10", "version_code": 16779209, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28240540595581830"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.9\n\n**Slip School is now a three drill series**\n- SLIP SCHOOL 1: KNEE TOUCH. Slip the way the arrow points, then reach across and touch a low target on the slip side. Reaching for it makes you slip with your legs and hips instead of just leaning your head.\n- SLIP SCHOOL 2: HANDS UP. The same slips with your hands glued to your chin. Drop a hand and you hear about it, and three warnings ends the drill early. Miss a slip and it lands on your guard for partial credit.\n- SLIP SCHOOL 3: BODY RIP. Slip left and rip a left hook to the body, then the same hook upstairs. Slip right for the mirror pair. Both counter pads appear while you are still slipping, stacked low and high on the slip side.\n- The next slip now waits until you are back upright and centred in your stance, so threats stop arriving while you are still down from a touch or a counter.\n\n**Slips**\n- A slipped arrow keeps flying past your head instead of vanishing in mid-air the moment your slip counts.\n\n**Pause menu**\n- New DRILL TIPS button lets you review the current drill's coaching tips without leaving the session.\n", "created_date": 1785833894, "id": "28055195464116345", "version": "0.34.9", "version_code": 16779207, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&oe=6A984658"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A36ip2kwdWAQ7kNvwEZxxDP&_nc_oc=AdqCI0kFyqKHGJb7dLajHQQThTW7KT5fWtwcJmmy3MTrha2hzYZYFkzXlrnNxdjlq1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqnpgylav2a_7vUtcLBF-syjrUd2DjvNgFk_oVwhciJA&oe=6A9851FA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBlqcqv6tvAQ7kNvwHUTYQW&_nc_oc=AdpY1TLNi1dCVmDlERsunYgqzoyWJ0tD5AOwvfNQ7RoUgaZxuXS5MJfCLULbrjadlGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWdByQONR9G37k_7O7olJeKCzjWrfvmRTnS3BUuYHrSw&oe=6A98679D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptNwm0ZxBgIQ7kNvwGRdXPP&_nc_oc=AdoVK1UAgniV6_Qwo7w5Mx3TSqYB_pjN5gAROz4RMEtKCTjOpVl3_3GdHgYTp2q_wxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-Rtw6YfWqKXkPoVh66zZxIw83QI4m05rRdbuugPd2pA&oe=6A983E12"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNewB9WY65AQ7kNvwHXGgLn&_nc_oc=AdpiXJz-xzdj_2BY29JhELsTQxMybr6hrlTSL3WYBm1aGJgCLkDaspKj8mC44IGyWqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY7kGX9rFnPh8boBAqmwUTPFyv1vq2qIqI7f3kMwT7pg&oe=6A985129"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpfuBdbhiN0Q7kNvwFp9-X2&_nc_oc=AdreYgGZjDdJFZzVJgmDcZd7z7hj3Jp6tQMN3YRcwP3NyrvqAykz4Q3I7TjcxGxUVwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIKbtPVQfqfMX-qtoCeuSqYmDf_IoKn6bGaIUOssG67A&oe=6A98615F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLe6NEGbJq8Q7kNvwGh5T0i&_nc_oc=AdpYCQAsDDxt7_JUd7XjK2VRi_p2F6l8QRTKZmpb9wIpweZRcIB0m6ZWqXZfYhjQl6I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLI5u8_UtVVOVYaHq0XN6ZifqIzz22tJJ9SEgiQX6ixQ&oe=6A986716"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1013623321669324"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28279252828377273", "version": "0.35.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28279252828377273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "## Release Notes\n\n### v0.35.0\n\nDo the tutorial again before you play, especially the new ADVANCED COMBO page. It teaches the escape step in a safe setting.\n\n**Escapes: punch, then get out**\n- 13 advanced combos now end with an escape. After your last punch the floor ring slides to one side and a big green glove flies at the spot you punched from. Step onto the ring before it arrives.\n- Green means move your feet. It is not a slip, so you can't block it or dodge it in place, and the glove is bigger than a slip threat so the two read differently.\n- Many of these combos mix a slip, duck, roll or weave into the exit. The mix is rolled fresh every rep, so one rep is a plain escape and the next makes you roll out under a hook.\n- Every dodge and escape in the exit appears at its spot a beat early, resting in place while the previous one is still flying, so you always know what comes next.\n- New drill: 1-2-3 ROLL OUT. Hook, roll under the counter, step out.\n- 1-1-2-7-3 now runs the classic L-step: step onto the ring, then pivot to face the pads from the new angle.\n- Escapes count toward your defense score. If you want plain pad work, turn them off in Settings.\n\n**Pads**\n- The overhand pad now angles up to catch the shot looping over the top. It used to sit flat like a cross pad.\n\n**Menus**\n- The stance selector (Orthodox / Southpaw / Auto) is now on the Workout page as well.\n- Long workout plans scroll inside the drill list instead of pushing START WORKOUT off the panel.\n- The guide link now also lives at the bottom of the Settings page.", "created_date": 1787380082, "id": "28279252828377273", "version": "0.35.0", "version_code": 16779222, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28279252828377273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.16\n\n**The floor ring tells you where to stand**\n- In footwork drills the ring no longer fades out. It stays for the whole drill and slides to the next spot just before the trainer moves, so you can step early instead of chasing the pads. A soft double tap marks each move; silence it with the new Footwork Ping toggle in Settings.\n- The ring's arrow is three times longer, so you can see it without looking straight down.\n- The ring survives pausing, and workout mode gets it too. It never appeared there before.\n\n**Pivot drills**\n- The green triangle is gone. The ring anchors your lead foot and its arrow swings to the new facing on each pivot: turn in place on the ball of your lead foot and let the rear leg swing round.\n\n**Rolls**\n- The mitt arrives at temple height now rather than straight at your eyes. The dip you need is exactly the same.\n- Your across movement counts right up to the end of the swing, so finishing a beat late still scores GOOD.\n- Once the mitt is past your head it can't catch you on the way up.\n- Each roll direction gets its own frozen half-second introduction, and rolls in the middle of a combo get one too. They used to arrive with no warning at all.\n- The partial-credit word is now HALF ROLL. It means you cleared the height but didn't travel across.\n\n**Stance**\n- The countdown and workout screens show your starting stance, which helps when STANCE: AUTO is choosing it.\n- After a mid-drill stance call the pads wait a touch longer, so the call finishes before the next pad comes.\n- Southpaw: roll cues now mirror with your stance, matching the counter pads.", "created_date": 1787288804, "id": "28265787306390492", "version": "0.34.16", "version_code": 16779220, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28279252828377273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.15\n\n**Tutorial: no more sucker punches**\n- Every step that sends a pad or a threat at you now waits behind a START button. Read the page, press START when you're ready. Thanks to the players who wrote in about this batch.\n- Recentering with the Meta button mid-tutorial used to lose the menu completely. It now comes back in front of you, wherever you're facing.\n- The difficulty picker's selected marker rendered as a square box on some headsets. It's a proper filled dot now.\n- The slip page was titled \"SLIP LEFT\" even though the punches alternate sides. It's just \"SLIP\" now, and the instructions say to dodge both ways.\n\n**Menus sit a little further back**\n- The main menu and tutorial panel moved back a touch. Several of you found them too close.\n\n**REACTIVE COUNTER flows the right way now**\n- The slips were backwards: you slipped one way, then had to throw with the hand you'd just moved away from. Now slip right loads the cross and slip left loads the jab, so the slip carries you straight into the punch.\n\n**Roll timing is fair**\n- Once the roll mitt has flown past your head, the rep is scored and you can stand up. It used to be able to catch you on its way out behind you, which made \"when can I come up?\" a guessing game.\n", "created_date": 1787276995, "id": "28264184919884064", "version": "0.34.15", "version_code": 16779219, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28279252828377273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.14\n\n**Switch stance mid-drill**\n- New STANCE control on the main menu, next to RANGE: Orthodox, Southpaw, or Auto.\n- On Auto, drills switch your lead at random between combos. The coach calls the new stance, a big banner shows it, and the pads wait a beat so you can move your feet. Set how often it happens in Settings.\n\n**Defense cues are easier to read**\n- The first time each type of threat appears in a drill (duck, roll, slip, weave, pull), it holds still for a moment with a double tap sound so you can read it before it flies. After that they come at full speed.\n- Fixed: on the faster speeds, a duck or roll that clipped you late in its flight sometimes went unscored. Every clip counts now.\n\n**Find your starting spot**\n- A ring and arrow on the floor show where to stand and which way to face while the countdown runs. It fades out after GO.\n- The tutorial's stance page uses the same ring: start with your lead foot in the circle.\n", "created_date": 1787269768, "id": "28263218403314049", "version": "0.34.14", "version_code": 16779217, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28279252828377273"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1787109136, "id": "28240540595581830", "version": "0.34.13", "version_code": 16779215, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
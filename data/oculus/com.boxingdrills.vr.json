4361061587556460", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622325_4361061590889793_8443499001590631147_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blUpD6-VydYQ7kNvwHcmvYL&_nc_oc=AdpDo0R-Nk_G79xZdppPcBch4Mc_Hu7L4WQaOVCv28nXXdpafstfUw2BbcsTQGLkBew&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7_m8zyzNWKYPzdUlIGPjHQDGU43TYOkEQoh8U6ElEyA&oe=6A5A3426"}, {"file_name": "com.boxingdrills.vr-20260612-160524.png", "id": "1790742922336026", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619681_1790742929002692_2967370313329941720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyvxs3Tb3r4Q7kNvwHQ9NXo&_nc_oc=Adrvp2CXyz4chKz4jxJjxts5FMObI6FU68gS7xvUk84ttQW58cHkrFoJ2dgaxXb4lHo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyAYUejNf5VMcwz1se5UCuCSTJilrKgtW5_arpQR8IpA&oe=6A5A4837"}, {"file_name": "com.boxingdrills.vr-20260612-160549.png", "id": "1642629256847878", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619681_1642629260181211_4239273547513896385_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUX7L-UMGs0Q7kNvwG6j8Mo&_nc_oc=AdpXN0KB3JWFOwA1ZTjdp0qRRIGDVDyxQLD7RLqqyr2f5JPdfAUeal38fUF97i-mrTE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdGTCvcwrlLWjYty315ftDcmCFq1BxZEqjSJD4KAo_0A&oe=6A5A438E"}, {"file_name": "com.boxingdrills.vr-20260612-160540.png", "id": "1283005677155850", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623443_1283005683822516_4340392285963543058_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3GKPGGzh9AQ7kNvwEeDRrp&_nc_oc=Adq2YXAVT5HYgtD5uLBUuArdZLkf2BKsqGSCdljAVgLHJTN1FitduTXdjah4O2Vy06c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9hwBhZYF2EyTSvAV2XEwoC0nJKSjCyGc2OKJd0mxCiQ&oe=6A5A40DF"}, {"file_name": "com.boxingdrills.vr-20260612-160507.png", "id": "998205189422993", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507898773_998205192756326_7953914639717337464_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DyEz0Cj8_EQ7kNvwF6OfTQ&_nc_oc=AdoxtYsVTu2MvcWP8hgQSOsYQ4VMKakT83on8n_GFzpaVQKxk_FpxeKxNgRXYAdmqpY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6k1Zx1OeZygzzHBEXSATVgAVAuDSoErI865S34BCDjw&oe=6A5A46AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHLFzh7zI7MQ7kNvwHAPVIv&_nc_oc=AdoUwqNbnf-CwxF5W5CnQ4_bKUejbHAdsEEKjIGkJ_WFh_XMxc-d4FsTn_m6cHjZu4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGkbNmpoul2tC4HKvXb7cv68O58Ff0sSV0KoTUxGVCmQ&oe=6A5A3856"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Your coach calls the combination. You move, punch, slip. This is pad work \u2014 real pad work. Not a rhythm game. Not a cardio app. The training fighters actually do, in your living room.\n\nBoxing is a craft. Footwork, guard discipline, hip rotation on the cross \u2014 not learned by pressing buttons. Drilled into instinct.\n\nBoxing Drills puts you in front of virtual pads and holds you to real standards. Punch too soft? It doesn't count. Drop your guard? That's a point off. Stand flat-footed? The trainer steps out of range \u2014 move.\n\n**Train like it means something**\n- Many drills across punch combos, defense, and footwork with more being added regularly\n- Pad trainer shifts laterally and forward/back \u2014 reposition or lose the angle\n- Minimum punch velocity threshold \u2014 weak shots don't register, so you learn to commit\n- Body engagement scoring \u2014 measures hip rotation, not just arm speed\n- Real-time hit feedback: punch speed (m/s), body effort, and power score on every impact\n- Southpaw mode \u2014 train in your natural stance\n\n**Track what matters**\n\nPower \u00b7 Speed \u00b7 Agility \u00b7 Form \u2014 scored every session and compared against your personal bests. Career mode builds your fighter profile and tests you across 8 opponents. Workout mode chains drills back-to-back for sessions up to 60 minutes.\n\nJoin the Discord at https://discord.gg/8FyagxceKs and help shape what comes next.\n\n*Clear some space. Put the headset on. Throw a real punch.*", "short_description": "Real pad work. In your living room.\n\nThrow combinations, slip punches, move your feet \u2014 the virtual trainer shifts position and your punches only count if they land hard. This isn't a rhythm game. It's how fighters actually train.\n\n30+ drills. Workout mode chains them back-to-back for up to 60 minutes of continuous training. Real-time power, speed, agility, and form scoring. Career mode. No subscription.\n\nPut the headset on. Throw a real punch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27603552885947274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5XtwghQCJkQ7kNvwEi0Nac&_nc_oc=Adov960uORkOeFcI9GaQVFTgLS1ez69JpsgNljS84m_8HLyoSXncLIhPV_kp1bRkOXE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_YietPyUKmKSqQmyeWCI7p7YO2dqiodRNTgB_Er_exA&oe=6A5A2D21"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing Drills VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1772139060, "lastRevision": {"nodes": [{"id": "26010917281877517", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "26010917241877521", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "872094698918875"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_landscape.png", "id": "4366468493565440", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617850_4366468496898773_7170537001558022658_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=885_G6d4pPQQ7kNvwH2v3ro&_nc_oc=AdqyVAv6CaAwPfhm61zfwmntV924cAplkxmPDAsRwH1_p6nu-p_7BJ8Uzi9VyjWSCuw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKNF-MUC7LFYYk9icxNMkymvI2VVZGaLcH67Jrl1cmLg&oe=6A5A4051"}, {"file_name": "logo.png", "id": "3091894031009348", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618274_3091894034342681_80323162725
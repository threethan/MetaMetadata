wJsmxY1YAAA0kA&oe=69AAB7D2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb0N_I5eVbYQ7kNvwHzFHSA&_nc_oc=AdkY8qZE5F4kYHGqcdn59phmTVEXd1Obw2QW2a-uHoHdPblWHRzVtfdf_vkUOx4tNFQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE9CQETucwswB3mND49ZPX3ZuYeHISQ1peWfmOaYbfYQ&oe=69AACAE9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVxyJoIR96oQ7kNvwGSIrit&_nc_oc=Adm4ypsCQfWXrvq-Fm-XxU_Ry8Z7V3Ud9dx3-3fNsBFiUv3csb9mfh3QYqKPvfzqfEw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfznhqqWXCIwtpS9zgbyPIS40riaKq8s0obEuYd2fpkyEw&oe=69AADB1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paUWyPaf_7IQ7kNvwFBPuoa&_nc_oc=Adk2l1NcRWknVkcfvl33DW8AIMCVgeEj5_iS9cT2T4RooFDlvjbqdBaQcykwRYWsX-c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9QrVj432Hr_2M9tEF2mUAvHDoBxMt0FvORPNPMf79Mw&oe=69AAE0D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "4443476652641359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772139060, "status": "PUBLISHED", "id": "4443476652641359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26270360509266525", "version": "0.2.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26270360509266525"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "Release Notes \u2014 v0.3.0\n                                                                                                                                           \n  Quest 2 Support                                                                                                                          \n  - Added Meta Quest 2 as a supported device\n  - Auto-detects headset model at startup \u2014 Quest 2 gets a virtual environment (dark background with visible floor), Quest 3/Pro get       \n  passthrough                                                     \n  - New \"Mixed Reality\" toggle in the settings menu to manually switch between passthrough and virtual environment on any device\n  - Fixed passthrough on Quest 3 not working reliably on startup\n\n  Scoring Improvements\n  - Added weight class setting (Featherweight / Lightweight / Middleweight / Heavyweight) \u2014 punch power thresholds now scale to your size\n  - Speed scoring adjusts based on estimated reach from your VR standing height\n  - Duck detection is now proportional to your height instead of a fixed threshold\n  - Improved guard scoring \u2014 checks hand position at moment of impact instead of time-window based return\n  - Simplified form score to focus on guard quality\n  - Agility score hidden on drills without defense actions\n  - Score Guide popup on the results screen explaining all statistics\n", "created_date": 1772405735, "id": "26277389005230342", "version": "0.3.0", "version_code": 16777488, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26270360509266525"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.2.0\n\n### New Features\n\n- **Slip Rope Drill** \u2014 Replaced the buggy Roll & Rip drill with a new slip rope drill inspired by real boxing gym training. A horizontal rope sits at shoulder height and the player alternates body hooks on each side, rolling under the rope between hits. The rope acts as a passive obstacle \u2014 hitting it with your head costs points, but never interrupts the flow of the drill.\n\n- **Intro Music** \u2014 Added background music that plays on the main menu. Includes a mute/unmute toggle button and a volume slider for adjusting music level.\n\n- **Homing Slip Threats** \u2014 Slip threats now track toward the player's actual head position rather than flying along a fixed path, making the defense drills more dynamic and harder to cheese.\n\n### Bug Fixes\n\n- **Scene Positioning** \u2014 Fixed issues with scene origin and object placement that could cause pads and threats to appear in wrong locations.\n\n- **XR Tracking** \u2014 Switched to `LOCAL_FLOOR` reference space for more reliable floor-relative tracking. Menu now defers spawning until XR tracking is fully ready, preventing objects from appearing at the wrong height on startup.\n\n- **Slip Lock** \u2014 Fixed homing slip lock-on behavior and switched to distance-based locking so slips register more reliably regardless of head movement direction.\n", "created_date": 1772341494, "id": "26270360509266525", "version": "0.2.0", "version_code": 16777487, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26270360509266525"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772341261, "id": "26270337322602177", "version": "0.1.0", "version_code": 16777485, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26270360509266525"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772056627, "id": "26238710852431491", "version": "0.1.0", "version_code": 16777484, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26270360509266525"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772055359, "id": "26238582102444366", "version": "0.1.0", "version_code": 16777483, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
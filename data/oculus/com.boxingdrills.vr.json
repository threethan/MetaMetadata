tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msYf5NvwIcUQ7kNvwEU4ixj&_nc_oc=Adq3dL_BWR-M1yzDT9plgjGjoTDH1lftNZ25WVSHaIeMbN5E2VkYQa6OUvxp8osxQm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RqLvCZGs5ZriqiOOXjgFFPg3BWc2pdYN3LkpbkixHlA&oe=6A35717A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn17yG7qlBMQ7kNvwEwHE9o&_nc_oc=AdrcU1sYygv2DMJwYRTlYfYjprwgdFvh1mzZoqPzdDInFIifhi2rKvF5jQYIAVwDWHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4R_NrBQJNLv0Iot7mPtSB9U6fKQ7FiubdHAw7DxMZ4w&oe=6A354EDD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKkNou_kxSIQ7kNvwFiAvBR&_nc_oc=AdowfhIZ-DpboWYYO4IOOC-wComMmgGdZ4z7Yfi7cwdSSI70gX0EHJUAs5aVhDe72vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sTxishWRW1m3snaIDh9uxnXFE4RgumfQCuNajjQKtEA&oe=6A355D92"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tdro2qHVhsQ7kNvwEih9sa&_nc_oc=Adq7TkeZGv3hpZXRrfOF43tBE61sn1vhPl4-cja0cyU2yojGy_MfIU6daf2nAZsVmvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LqsWRJIKnN-CkY63CiuC4ACcQ1Ps3eSsM5NgR9thp9Q&oe=6A3570A9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y75eyc6nIP8Q7kNvwHQC6FY&_nc_oc=AdqemtZWtt03NYxvcvNra-pwy4-ZaMFbwk84vq9LtzkJCQOe827MvRKz_aJbsHgBd0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_odwdQzSpVFv7ysy4F4WJRCzjxNafNxnnlroX9v9d5xg&oe=6A35489F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEMIVGmzevEQ7kNvwHHqDdH&_nc_oc=Adp01oe4HBlCLYK6GDTFwo4ufkbxtPhkwGIV3kValVXsm7qHlZ26Bk6ecTrQjMV52Mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S6qigNUXwyOHbXBpTjl6l1IwXH1Ss0_nf8cCsw47JEA&oe=6A354E56"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27475077812128116", "version": "0.20.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27475077812128116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.20.0\n\n**Head Movement (new)**\n- Optional coaching that stops you being a stationary target: if your head goes too still, a slip flies at you so you keep moving. On by default at Relaxed \u2014 tune or turn it off in Settings \u2192 Footwork.\n\n**Blocking**\n- Blocking now actually works \u2014 raise your guard and the incoming glove shatters on it (block sound + \"BLOCKED!\"). It's a last resort: dodging always scores better and a block still costs a little. Straight shots down the middle need both hands; duck and roll threats can be blocked too. Turn it off in Settings to play dodge-only.\n- New **WEATHER THE STORM** defense drill \u2014 a non-stop flurry: dodge what you can, block what you can't.\n\n**Equipment visuals**\n- The duck threat is now a long foam roller you get under wherever you stand; rolls keep the big mitt. Fixed missing polygons on the 3D gloves and pads.\n\n**Tutorial**\n- Rebuilt to use the real 3D gloves, pads and threats, with new pages for rolling, pulling back, and blocking \u2014 plus a tip on playing your own music.\n\n**Other**\n- SURVIVE THE STORM now rips a body hook after each duck.\n- Fixes: more time to react to ducks; numbers and slips now face you correctly after pivots.", "created_date": 1781429474, "id": "27475077812128116", "version": "0.20.0", "version_code": 16779050, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27475077812128116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.3\n\n**Blocking**\n- You can now **block** the threats you can't dodge in time. If a slip, duck/roll, or pull-back threat reaches you and your gloves are up in a guard, it counts as a block \u2014 you still lose a little, but far less than eating it clean. A \"BLOCK\" pops up and a block sound plays. Keeping a high guard finally pays off.\n\n**Pad Shatter**\n- Power-smashing a pad now bursts it into real 3D pad pieces that fly off and tumble, instead of plain shards \u2014 a much meatier reward for a committed knockout shot.\n\n**Bug Fixes**\n- Fixed the uppercut pads facing the sky \u2014 they now correctly face down so you punch up into them.\n", "created_date": 1781245999, "id": "27448518521450712", "version": "0.19.3", "version_code": 16779048, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27475077812128116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.2\n\n**3D Defense Pads**\n- The duck and roll threats are now proper face-down focus mitts instead of plain bars. Duck under the mitt, or roll under the bigger one on roll drills (ROLL & HOOK, 1-2 ROLL) \u2014 much clearer and more immersive.\n\n**Immersion**\n- The menu laser pointers now vanish the instant you start a drill, so you square up to the pads without them in view through the 3-2-1 countdown.\n", "created_date": 1781235848, "id": "27447029158266315", "version": "0.19.2", "version_code": 16779046, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27475077812128116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.1\n\n**More 3D Equipment**\n- **3D pads** \u2014 the focus mitts are now proper 3D pads instead of flat cuboids. The punch number floats above each pad, always facing you and easy to read.\n- **Slip threats are gloves** \u2014 the thing you slip is now an incoming red boxing glove on the matching side (left/right), instead of a red ball.\n- **Pull-back threat is a glove** \u2014 the shot you pull straight back from is now one big red glove coming at your chin, so it's obvious what's incoming. It's wide, so you can't side-step it \u2014 you have to pull back.\n\n**Glove Size Setting**\n- New **Glove Size** option to scale your gloves up or down (\u00b150%) to better match your real hands or just your preference.\n", "created_date": 1781227287, "id": "27445721601730404", "version": "0.19.1", "version_code": 16779044, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27475077812128116"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.0\n\n**3D Boxing Gloves**\n- Your gloves are now proper 3D boxing gloves instead of plain spheres \u2014 a first taste of real equipment in the game.\n- This is an early roll-out; 3D pads, bags, and more are on the way.\n\n", "created_date": 1781215680, "id": "27444107228558508", "version": "0.19.0", "version_code": 16779042, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
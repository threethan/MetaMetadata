4wE&_nc_oc=AdqLy8HXUlNp03ZdNnx2lgk3OHH5r4jdiYB1xy6isiYDs-cGO83JZ6K7X40wcV56JWM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XTwk51AM-bt_eZCBuHXgezRc_q-HoYGImKURZixm7Pw&oe=6A33EAF7"}, {"file_name": "cover_hero.png", "id": "925721709916061", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819324_925721713249394_2252932449268954893_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zEMz2frf4IQ7kNvwFI_xfJ&_nc_oc=AdrnvC4LfmBfIpcPJ2ois71i71Ab4QYVQvosRYHc1PcgzLpZR1i6NKtdyy3IkRnu-mw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ilqzyYHyoNx3rQ5rQDv1_MqVaOZVmbWpHKfxJ8YJIVA&oe=6A341458"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cya1T6tXasEQ7kNvwHVH50B&_nc_oc=AdqjDicAm9JojyMUONdvhf3ZU1cp3_A1IZoxyxsePTnLVZT3aiVu9KPgdbiFYvWcW4w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-abwasrFggHD3JNCulsh4NE0u-LGDsCr3l4eHV45LVaw&oe=6A341FFA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvC1r_GTDtoQ7kNvwF3KIm7&_nc_oc=Adp_mw3m7NJGZuGqBNzb2vmpApHUuEe73wifmRzWXFZGrEvC6LMj5ZmISo71z77DpTg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ESlk8YMW8j_TPwLRlnQPSutA95aXVqpgSOoMZX9D1ow&oe=6A33FD5D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKkNou_kxSIQ7kNvwGhw5pp&_nc_oc=AdpNDnpSmgLBGyBOhbUvuSAfzewt0n3CRfVIn5jQHfccAMqNo0Fi_KBQ-ATH0vXjwIY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81yQ-lzzQtB60SmYURp4ahTNKW2TWux_uw0CGkWiYyMg&oe=6A340C12"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tdro2qHVhsQ7kNvwHZ7iD0&_nc_oc=AdphWT4icPVeNKuXEeuXXkZSYwMuZUC4scfzSpOX3sZrVZ3SVLfsw2gPOvDqHKANCaM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UhYYHLg15XjbtJqdHalU3TOnuU9QQj5IqbGzDRoHVUg&oe=6A341F29"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y75eyc6nIP8Q7kNvwE5fENt&_nc_oc=AdoNEjrHkA8wfe8lAOLsxup27Egt6tbE2geRqblDimRLNvKQBR4uezhp7trGByMR6PU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zWACdBkhhc0NdnbOxxzQBKzYr_0AVPD4jdDjfgLvNqQ&oe=6A33F71F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEMIVGmzevEQ7kNvwHCsidN&_nc_oc=Adp31oFv7KPxtDryOQmVS6vCZm8Vgq94mE-DC7Kp4Jh5n3nGDM09jpUrUUG7UH9WdVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z1IwDfLkd7T0LjWLjlzg-kFxdtaNiw910MtseGbE4Gw&oe=6A33FCD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27448518521450712", "version": "0.19.3"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27448518521450712"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.3\n\n**Blocking**\n- You can now **block** the threats you can't dodge in time. If a slip, duck/roll, or pull-back threat reaches you and your gloves are up in a guard, it counts as a block \u2014 you still lose a little, but far less than eating it clean. A \"BLOCK\" pops up and a block sound plays. Keeping a high guard finally pays off.\n\n**Pad Shatter**\n- Power-smashing a pad now bursts it into real 3D pad pieces that fly off and tumble, instead of plain shards \u2014 a much meatier reward for a committed knockout shot.\n\n**Bug Fixes**\n- Fixed the uppercut pads facing the sky \u2014 they now correctly face down so you punch up into them.\n", "created_date": 1781245999, "id": "27448518521450712", "version": "0.19.3", "version_code": 16779048, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27448518521450712"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.2\n\n**3D Defense Pads**\n- The duck and roll threats are now proper face-down focus mitts instead of plain bars. Duck under the mitt, or roll under the bigger one on roll drills (ROLL & HOOK, 1-2 ROLL) \u2014 much clearer and more immersive.\n\n**Immersion**\n- The menu laser pointers now vanish the instant you start a drill, so you square up to the pads without them in view through the 3-2-1 countdown.\n", "created_date": 1781235848, "id": "27447029158266315", "version": "0.19.2", "version_code": 16779046, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27448518521450712"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.1\n\n**More 3D Equipment**\n- **3D pads** \u2014 the focus mitts are now proper 3D pads instead of flat cuboids. The punch number floats above each pad, always facing you and easy to read.\n- **Slip threats are gloves** \u2014 the thing you slip is now an incoming red boxing glove on the matching side (left/right), instead of a red ball.\n- **Pull-back threat is a glove** \u2014 the shot you pull straight back from is now one big red glove coming at your chin, so it's obvious what's incoming. It's wide, so you can't side-step it \u2014 you have to pull back.\n\n**Glove Size Setting**\n- New **Glove Size** option to scale your gloves up or down (\u00b150%) to better match your real hands or just your preference.\n", "created_date": 1781227287, "id": "27445721601730404", "version": "0.19.1", "version_code": 16779044, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27448518521450712"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.19.0\n\n**3D Boxing Gloves**\n- Your gloves are now proper 3D boxing gloves instead of plain spheres \u2014 a first taste of real equipment in the game.\n- This is an early roll-out; 3D pads, bags, and more are on the way.\n\n", "created_date": 1781215680, "id": "27444107228558508", "version": "0.19.0", "version_code": 16779042, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27448518521450712"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.18.0\n\n**Inside / Outside Range**\n- New **Range** toggle on the Train tab \u2014 fight from the outside, or pull in tight for inside work.\n- Inside brings the pads in close and squares them up for short hooks, uppercuts, and body shots. Works across Combo, Defense, and Footwork drills.\n\n**Fight Mode: Range Game**\n- Opponents now have a range style \u2014 swarmers want to fight inside, out-boxers want to stay at range, others are balanced. Their style is shown before each fight.\n- Your inside and outside proficiency now shows on your Fighter card and influences your fights \u2014 train the range that beats your next opponent.\n\n**New Drill & Punches**\n- **OVERHAND DIG**: loop an overhand right over the guard, then dig a left uppercut to the body.\n- Two new punches added to the game: the overhand right and the uppercut to the body.\n\n**Equipment**\n- The **Heavy Bag** tab is now **Equipment**, grouping the heavy bag, double-end bag, and skip rope together. (Speed ball and more coming in a future update.)\n\n**Other**\n- The experimental **Counters** tab (Arthur) is temporarily hidden while we continue work on it, it may or may not be back.\n", "created_date": 1781085450, "id": "27423652727270625", "version": "0.18.0", "version_code": 16779040, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
&oe=6A805318"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN32clvICT0Q7kNvwELv9fn&_nc_oc=AdoX51FOw-5KwDeebaVCbdE7YPZffdlfqipE9PrBkfkLacaSVHqFrYNnR9qvU2xBMP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9jCn3A-bOLvD0D_9EoT5PypUj2PzuOUmRj2QnAiU8ew&oe=6A805EBA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfzOBz1TppsQ7kNvwGnl6SU&_nc_oc=AdrD4k1OT4n8o9xkycAEuxke2jdx7dtPVBTt2P8aX7cj2T9xZUEacpeRCxPyfYV_L0g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIwl-3-WmzNYAYdrrS5Wl1TyaIhBcAsB3pH8UHgWkfCg&oe=6A80745D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4MdyBoQeHgQ7kNvwEUjpWB&_nc_oc=AdqAGlZpeEJj9B0kIM-rrWQ0xPFWwwKtRpatUFpcBMkoa97lItyfDX4F6Rv84bwuR8M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRRMd6B5-fHqJoOd4klzKU-7EqkFoxxPN_WEqWYtOQyA&oe=6A804AD2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mnjhK1yizwQ7kNvwH_ErZ9&_nc_oc=AdpeLcSOkJO2y2fIjkZ9cud_lCYzHQdIb5FuHK2LFGKqZalWfdScuKioklIfbY6ibcg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-7JaGxEvRNuiJI2a_id0k7jFsGeTxxJzeSEA20P3O9A&oe=6A805DE9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmxUNYDhLj4Q7kNvwEdqlvq&_nc_oc=AdpLMZHMxRORKydiyBsrBMWzVJU_Jg33cwVPjl3veH2fOvMA9lRP7J_1es2kVEbLb3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJi_pMjvb8n76Uf_MmKvGQ1fiyfHJHkLR4ypJnhtHbMQ&oe=6A806E1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o6t8khECwEQ7kNvwGGLnZL&_nc_oc=Adr7ykL7GktcMNvxT2pejCyCfNv-rguxatq6oJEv8ngvz3QuWZlXuXA5KHaanLzE-Jo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg4jxEr7oArmx7bcBoKGMh2yE6uAKKP1QDxVqzUSbR2Q&oe=6A8073D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28067730969529461", "version": "0.34.10"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28067730969529461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.10\n\n**Slip School 3: Body Rip**\n- The double now lands one shot at a time. The body pad is out while you slip; dig the body shot and the high pad snaps into place for the hook upstairs. One swing can no longer clip both pads at once.\n", "created_date": 1785917722, "id": "28067730969529461", "version": "0.34.10", "version_code": 16779209, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28067730969529461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.9\n\n**Slip School is now a three drill series**\n- SLIP SCHOOL 1: KNEE TOUCH. Slip the way the arrow points, then reach across and touch a low target on the slip side. Reaching for it makes you slip with your legs and hips instead of just leaning your head.\n- SLIP SCHOOL 2: HANDS UP. The same slips with your hands glued to your chin. Drop a hand and you hear about it, and three warnings ends the drill early. Miss a slip and it lands on your guard for partial credit.\n- SLIP SCHOOL 3: BODY RIP. Slip left and rip a left hook to the body, then the same hook upstairs. Slip right for the mirror pair. Both counter pads appear while you are still slipping, stacked low and high on the slip side.\n- The next slip now waits until you are back upright and centred in your stance, so threats stop arriving while you are still down from a touch or a counter.\n\n**Slips**\n- A slipped arrow keeps flying past your head instead of vanishing in mid-air the moment your slip counts.\n\n**Pause menu**\n- New DRILL TIPS button lets you review the current drill's coaching tips without leaving the session.\n", "created_date": 1785833894, "id": "28055195464116345", "version": "0.34.9", "version_code": 16779207, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28067730969529461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.8\n\n**Fixes**\n- Bringing your hand back after a punch no longer registers on the next mitt. That was the stray WRONG PUNCH some of you saw right after a jab when the pull-back brushed the next pad.\n- A missed duck was scoring twice, a TOO SLOW mid-swing and then a GOOD when the bar finished. One duck now gets one verdict, and your duck stats count it honestly.", "created_date": 1785491225, "id": "28009791155323443", "version": "0.34.8", "version_code": 16779205, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28067730969529461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.7\n\n**Bare Knuckle Mode (beta)**\n- Put both controllers down and box with your bare hands. Hand tracking takes over, and punches score exactly as they do with controllers.\n- Your gloves disappear while your hands are tracked, so in passthrough you see your own fists doing the work.\n- Pinch index finger and thumb to click menus, pinch with your palm facing you to pause. It's beta: expect some rough edges, and controllers are still the quicker way to browse long lists.\n\n**Footwork**\n- The footwork amount now means what it says: a higher percentage takes bigger repositioning steps, up to half-metre slides at 100%.\n- Every league now works you side to side and in and out between combos, with small controlled steps that sweep back toward your starting spot. You will never get walked out of your play space.\n\n**Fixes**\n- Custom league settings survive a visit to a ranked league. Before, playing a ranked drill could quietly overwrite your saved Custom values.\n", "created_date": 1785392118, "id": "27996094050026487", "version": "0.34.7", "version_code": 16779203, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28067730969529461"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.6\n\n**Controller haptics**\n- Your controller now vibrates when a punch lands clean, and kicks harder when you smash a pad to pieces. Weak hits stay silent, so your hands feel the difference.\n- New Hit Haptics toggle in Settings if you'd rather train without it.\n\n**Tutorial**\n- Tutorial pads now react the same way drill pads do: hit labels, flashes, sounds and the full-power shatter all match.\n- The 1-2 combo step offers one pad at a time, spaced like the real drill.\n\n**Fixes**\n- Punching hard through a pad no longer counts a phantom second hit while the pad recoils. That was the cause of stray TOO WEAK and WRONG PUNCH calls right after a clean shot, easiest to see in the tutorial.\n- The Release Notes screen could freeze the app when scrolled. Fixed, and it now shows the last two versions of changes instead of the full history.", "created_date": 1785294621, "id": "27983016301334262", "version": "0.34.6", "version_code": 16779201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
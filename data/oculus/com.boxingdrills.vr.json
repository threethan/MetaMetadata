&oe=6A771898"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAFD73bsCsoQ7kNvwHv3iwm&_nc_oc=AdqLsaACAZ5bvSJYnO-I-jhfGT1MC5O9gHKiidx-b8IdhLh1ZlhbuJTo6ij9GROE2Yk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZIXsN-mMfpBG0RoVOn73-fi6cgjjIGuu8q5nUFsr_HQ&oe=6A77243A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ED_WFkKlm7kQ7kNvwFZTrcJ&_nc_oc=AdrIff0ususBWX4xUD6pDDggaRguDAmllzIZhkBvisI1LPGJ_nb-3xUSmdk1cIKJTAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE44Xsu9FePVF3RNKPyu7XPOoJgchMcwxMI_7CzXDbmFw&oe=6A7739DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qwxda42jHnQQ7kNvwFEjzb1&_nc_oc=Adr_42hgGBxHrafL_K1z5nYsOyWF2AQjFtonuJTQDMFCj_HQu-3kjhd1l7JEkogo4fQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeyj8LI6gPb47_WYtflwgRB3gaDA_wih5cH1CcGGg3wg&oe=6A771052"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_TRTkRYdOcQ7kNvwEEstmH&_nc_oc=Adoc9iEWACSnQxsx19gOdPT6vze-FlVxY0S6CT19Tt9tidaM4AMYaCjbMUv4zm-_lm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ2c4JyrHV560huiUwfUnD1dGl9eV4ege0tMpMWljyag&oe=6A772369"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0NIb_LVNkkQ7kNvwHtMheO&_nc_oc=AdpCbc8WnG4wwO8aN9QPp52TZoNnKk8GE74HgyK73MJzx4pSXLVGobwwEgF5hZG-NaU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM2c4sFKkygMgn9bd8M7mbq48PfDpPDU2NlgGI8BD6wg&oe=6A77339F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMtdWn8BeUAQ7kNvwGk0g4X&_nc_oc=AdrsxeQn4tIr05Bgjo-3ELJKjDkXewmP54ZWTcCwnXjqG2TEGHYm3-aE5tNWDEkX0C8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUAbS9qB4uQEEZPZSYG2MynMCi7iNvlA0ZQYWyouN90A&oe=6A773956"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28009791155323443", "version": "0.34.8"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28009791155323443"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.8\n\n**Fixes**\n- Bringing your hand back after a punch no longer registers on the next mitt. That was the stray WRONG PUNCH some of you saw right after a jab when the pull-back brushed the next pad.\n- A missed duck was scoring twice, a TOO SLOW mid-swing and then a GOOD when the bar finished. One duck now gets one verdict, and your duck stats count it honestly.", "created_date": 1785491225, "id": "28009791155323443", "version": "0.34.8", "version_code": 16779205, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28009791155323443"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.7\n\n**Bare Knuckle Mode (beta)**\n- Put both controllers down and box with your bare hands. Hand tracking takes over, and punches score exactly as they do with controllers.\n- Your gloves disappear while your hands are tracked, so in passthrough you see your own fists doing the work.\n- Pinch index finger and thumb to click menus, pinch with your palm facing you to pause. It's beta: expect some rough edges, and controllers are still the quicker way to browse long lists.\n\n**Footwork**\n- The footwork amount now means what it says: a higher percentage takes bigger repositioning steps, up to half-metre slides at 100%.\n- Every league now works you side to side and in and out between combos, with small controlled steps that sweep back toward your starting spot. You will never get walked out of your play space.\n\n**Fixes**\n- Custom league settings survive a visit to a ranked league. Before, playing a ranked drill could quietly overwrite your saved Custom values.\n", "created_date": 1785392118, "id": "27996094050026487", "version": "0.34.7", "version_code": 16779203, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28009791155323443"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.6\n\n**Controller haptics**\n- Your controller now vibrates when a punch lands clean, and kicks harder when you smash a pad to pieces. Weak hits stay silent, so your hands feel the difference.\n- New Hit Haptics toggle in Settings if you'd rather train without it.\n\n**Tutorial**\n- Tutorial pads now react the same way drill pads do: hit labels, flashes, sounds and the full-power shatter all match.\n- The 1-2 combo step offers one pad at a time, spaced like the real drill.\n\n**Fixes**\n- Punching hard through a pad no longer counts a phantom second hit while the pad recoils. That was the cause of stray TOO WEAK and WRONG PUNCH calls right after a clean shot, easiest to see in the tutorial.\n- The Release Notes screen could freeze the app when scrolled. Fixed, and it now shows the last two versions of changes instead of the full history.", "created_date": 1785294621, "id": "27983016301334262", "version": "0.34.6", "version_code": 16779201, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28009791155323443"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.5\n\n**New drill: BAG CALLER**\n- The coach calls combos over the heavy bag and you throw them with no pads to aim at. The numbers sit in front of the bag and stay up until you finish the call.\n- Throw with the wrong hand and the call waits for you. Throw the wrong punch and it moves on, but that combo won't count as clean.\n- Hooks are read from how you swing, body shots from how low you land.\n- The calls keep coming for as long as you want to work. Finish from the pause menu, and the score screen shows how many combos came back exactly as called.\n\n**New drill: 1**\n- The jab on its own. Snap it out, snap it back.\n\n**Heavy bag**\n- The bag is heavier now. It gives less on each punch and settles instead of swinging away from you.\n\n**Fixes**\n- Southpaw: punches on the heavy bag now log as the right punch type. Your jab was being counted as a cross.", "created_date": 1785189081, "id": "27968434209459138", "version": "0.34.5", "version_code": 16779199, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28009791155323443"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.34.4\n\n**Build your own workouts**\n- Make custom workout lists. Press Y on any drill to drop it into List A, B, or C, then play that list as a workout.\n- Built a random workout you liked? Save it to a list to run it again.\n- Manage your lists from the Workout tab: remove a drill you don't want, or clear a whole list at once.\n- RANDOMIZE reshuffles a list's drills and their order each time you press it.\n\n**Find drills faster**\n- Filter a category down to what you want with tags: slips, hooks, body shots, ducks, pivots, combo length, and whether a drill leans high-output or defensive.\n- Tags show on each drill card, and search matches them too.\n\n**Perfect combo callout**\n- Finish a whole combo with every shot clean and a coach calls it out.\n\n**Workout flow**\n- Workouts get their own rest-between-combos switch, on by default, so they flow without changing how single drills feel.\n\n**Fixes**\n- Dodging now follows the way you're facing. After a pivot or an angle step, slips and pull-backs work in the direction shown instead of the one the drill started in.", "created_date": 1784928351, "id": "27936345469334679", "version": "0.34.4", "version_code": 16779197, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
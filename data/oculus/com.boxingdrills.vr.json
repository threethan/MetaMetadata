-vcUFxXlSxzwDjHtZZAgQ-qnBzU9k-XKblDPJnd_RSymRMyUReuc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pq_zyKwDZ2aYK83PMmr2YceYZ5balLJ9AadWDth96Ww&oe=6A3808D8"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msYf5NvwIcUQ7kNvwHOTUXV&_nc_oc=AdrcbArlO2ugP4tjDdvpafs-86O2hpwp_L6DajqIKRrI_QmUAfNrLlaP0chKS1vQHJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UTj6F2BO5x1qV-X0l6ed7zE4ede9-GS5YxLJLKPNI0w&oe=6A38147A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dn17yG7qlBMQ7kNvwGw6RGN&_nc_oc=AdpqjzvZxrBX9n1SuCJV-pLtnazyoB0rUt80YWYmmsR2VlMI4IuPzaIJgd1rT4t0V5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZYv3WFKNIi54yVKYpf52WipV9QepJjrHCoV1aRcYmnw&oe=6A37F1DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFn5WHtG2BAQ7kNvwHg9uNe&_nc_oc=Adrf8kL6XDTgABgH5rAm_pkod3EPFMkf-ReDCLRtswIWFcRgPVDHD-ZQ3iiYrEfkwlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v-NWwz-_xQYddJ7-5cRQdJG7NL2sf0QeCL9sgUEibJg&oe=6A380092"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kdHKhgMHXIQ7kNvwHjHClj&_nc_oc=Adrd52YCkuduFFX-OqOspgUTwEbGG7me_guNXYoX_QbKjgLKFba6TeYKSDTpCNpwpQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sSEb-fV5fIb7MRs6Hlx2Jazmq6pg7vhzyx1cyA1DucA&oe=6A3813A9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ceg8YyjslowQ7kNvwGioTxt&_nc_oc=AdqX-Z8AhXMzrhRp4k337t9CaxP9GIvVwViTSXXUjbgI7pjXVghGZzkdBz0KoV48ddA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g-U7AX_qe06wmzQ-TbCWLYdVgrENZlA5MD3zr76Uocw&oe=6A37EB9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jau9yOTKMuUQ7kNvwEVg1DN&_nc_oc=Adr40DJkaOOfyXG4tv7xjk_FZ2GMh-nvIX4zFFTuA6B7zbq-aiAiBhuYqfgPOcOcIpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oNLtWFVi_0L6QkjVOfMbSJyQE3M6KgZaDMvZJiP1zow&oe=6A37F156"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27501010476201516", "version": "0.22.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27501010476201516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.22.0\n\n**Brand-New Look**\n- The menus have been completely redesigned with a sleek \"glass\" style: a deep gradient backdrop, rounded panels with soft shadows, glowing cyan accents, and a crisp new athletic font.\n- Panels now have smoothly rounded corners framed by a thin cyan edge \u2014 much more polished and modern.\n\n**See-Through HUD**\n- The in-drill display is now transparent glass, so the pads and incoming threats stay visible through it instead of being blocked. Keeps your eyes on the action.\n\n**Smaller Download**\n- The app is now around 60% smaller to download (157MB \u2192 63MB), with zero change to speed, features, or quality.\n\n**Fixes**\n- Removed a stray green line that could flicker across the in-drill display during pad combos.\n- Fixed tutorial text being crowded against the edge of the panel.\n", "created_date": 1781612470, "id": "27501010476201516", "version": "0.22.0", "version_code": 16779060, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27501010476201516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.21.3\n\n**Stability**\n- Fixed a cause of the \"App isn't responding\" freeze that could appear when the headset went to sleep and woke back up, or when switching the app in and out. The app now keeps running smoothly through those transitions instead of getting stuck during the handover.", "created_date": 1781606511, "id": "27500097419626155", "version": "0.21.3", "version_code": 16779058, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27501010476201516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.21.2\n\n**Menus & Scrolling**\n- The Settings list now scrolls with the thumbstick, so you can reach every option as the list grows.\n- The drill list scrolls much faster \u2014 flick the thumbstick for one at a time, or hold it to zip to the bottom.\n- Scrollbars are chunkier and easier to grab and drag with the laser pointer.\n", "created_date": 1781599411, "id": "27499069876395576", "version": "0.21.2", "version_code": 16779055, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27501010476201516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.21.1\n\n**Stability**\n- Fixed a crash that could abruptly close the app, more likely during longer sessions. It came from the headset's graphics driver mishandling a system resource; the app now rides it out instead of being shut down.\n", "created_date": 1781596957, "id": "27498742693094961", "version": "0.21.1", "version_code": 16779053, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27501010476201516"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.21.0\n\n**Fixes**\n- The menu now opens right in front of you when you launch the app \u2014 no more reaching for the Meta button to recenter it.\n- The first pad of a drill glides forward from its resting spot instead of appearing already at striking distance.\n- Tutorial dodges are reliable now: duck, slip and roll register the same way the real drills do, including after you've turned or recentered.\n\n**Tutorial**\n- Rebuilt to run on the same mechanics as the live drills, so the pads face the right way and defense behaves exactly like it does in a real drill \u2014 no more tutorial-only quirks.\n\n**Performance**\n- Smoother all round \u2014 fixed the app re-reading your saved settings from storage on every single frame.\n\n", "created_date": 1781594520, "id": "27498417476460816", "version": "0.21.0", "version_code": 16779051, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
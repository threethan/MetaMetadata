2095210894392717", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sufx1UI-gUUQ7kNvwFhP1ac&_nc_oc=AdpJpaF_sTF7OVqM7RimENUZhZ15ewPfbNKmWHmoT1EIJFs7cSiXaOHHVMNwJXY4yhI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDP48zWTV6A-o_Us0ou6pC_T4h0XTZlG2YewShiF_U5Gg&oe=6A6F433C"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3Z0eXuE-2EQ7kNvwHdY94s&_nc_oc=Ado4kCEqK4LxMxdjqggOtj703AKcprL7VGrY5sz1oD7QqL41ctCWy2Xbngc5nEvPUwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUEUHxCTVif_E1F6hYsCcQdrf1GPKn0eg21d41_nQ5ow&oe=6A6F4C21"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqVk-HctUYIQ7kNvwEfmc5H&_nc_oc=Adr0Q__FElvVLqgPy1ij7m-ZxSdJDLWqgE1SmVuyz9eNvg7-dp3pt1-0S8MnvDxqGPs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1VasHCL96OV6Bd2G1gMCSnTrizlyjiF8BAUiHbxW-sw&oe=6A6F5760"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvGzAtv5wQEQ7kNvwHl4duy&_nc_oc=Adpbi3yBTRaVf0REghN4HJpORI73v62nqV2Xk4xGRav3XQx9s2-UXFE7tyB45s5GEz0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQWv23iJES9lSAQiODZFUlwAR-pFETQrQjUbTKpOcTdQ&oe=6A6F2F41"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxvkBECmkrQQ7kNvwFIxqiS&_nc_oc=AdoRwpS5AdK6wWYXCzaXnElXiDsvucE0dpGp4bZJgc2BWtU6EPvDwNNLDGGzUvqDKEM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFFnQBWTjAR6WA4v9GmDzZpzmCcnhwJt3631ly_Csa5Q&oe=6A6F2A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnBkw-Vy6LAQ7kNvwHCkNkd&_nc_oc=Adq6ECZTr0xkGa9KaxEBDQaBu3ZF8wZrlGnIPsl675jHEiN4RSV1-8qzPsRSAPlmDaI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE5dMuFHP7QkPRVJGhltG2HIMtaA6ol3nOo38EEqm5ug&oe=6A6F5056"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and mittwork. Your virtual coach calls the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next.\n\n**Clear some space, put the headset on, and try your first drill today.**", "short_description": "VR boxing fitness focused on real mittwork and padwork. You throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required. Put the headset on and start training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27774397232196171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_908382378478110_1679491847877253535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wCQ4BsdO0kQ7kNvwG8X1b_&_nc_oc=AdrEi-KypGEH_zJ4iJoMo9Qm0CKNXtJEUwns99q7E5wgYjbhMeW
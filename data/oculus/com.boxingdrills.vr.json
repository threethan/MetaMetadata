rd5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VPtPnLxPOP9wK2sC-MP3LNm6gdED5uiP9dCH6tL27dw&oe=6A47AD69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFJKBYZfZCgQ7kNvwGt58qX&_nc_oc=AdqgxP-UTAcyxFtkx5DtTg8BObIzvOvzfkHS7EX7Koes7nfo6n8UNBLIMLTweTl2LmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xPbU8EFLsQolpmtT3vLEYsSuWW8cvdF04Jdq8GpBhLw&oe=6A47BD9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLq7tV-UxLYQ7kNvwGPciaN&_nc_oc=AdpRo0Be7rggZo9vX6tiO47lPIUyKowz3ePt3O045doCBz9ac2Eg9b6213IhocUPA0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hO_Jx-awDSRniIF5tddziGUfWwi_hmOEA-uXXJgMU3A&oe=6A47C356"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27609283595374203", "version": "0.24.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27609283595374203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.24.0\n\n**Defense cues you can read in time \u2014 directional arrows**\n- Slips and weaves are now clear 3D arrows that point exactly where to move, so you can react sooner. **Red \"SLIP\"** arrows and **blue \"WEAVE\"** arrows, labelled so there's no guessing which is which.\n- When a slip can go either way, you'll see a double-headed arrow (slip whichever side you like).\n- Weave arrows now sit clear of your head instead of clipping your face, and the old hard-to-spot floating arrow hint is gone \u2014 the object itself is the cue.\n\n**New: Timed Rounds**\n- Train like the gym: turn on **Rounds** in Settings and set your **round length**, **rest length**, and **number of rounds** (e.g. 3 \u00d7 3 min with 1 min rest).\n- Works with anything \u2014 run a single drill or a full workout as timed rounds.\n- A boxing bell rings at every round and a rest screen counts down between them. During the rest you can skip ahead or end the session; the current round shows on your HUD while you work.\n- Off by default, so nothing changes unless you switch it on.\n", "created_date": 1782392896, "id": "27609283595374203", "version": "0.24.0", "version_code": 16779127, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27609283595374203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "## Release Notes\n\n### v0.23.2\n\n**Reactive Flow \u2014 now everywhere**\n- Flow now applies to *every* drill where you dodge straight into a counter \u2014 all the slip and pull counter drills (Pull Counter, Shell Defense, 1-2 Slip-Slip 3, Survive & Punish, Survive the Storm), not just a handful.\n- Peek-a-Boo drills flow too: slip to load, then rip the hook or uppercut in one continuous motion.\n- It's all governed by the single **Flow** setting (on by default) \u2014 switch it off for a strict, one-cue-at-a-time rhythm on every drill.\n\n**Bug Fixes**\n- Peek-a-Boo and roll drills: the weave/duck bar no longer creeps lower as the round goes on \u2014 it holds your starting height for the whole drill.\n", "created_date": 1782187517, "id": "27582692601366636", "version": "0.23.2", "version_code": 16779112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27609283595374203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782184745, "id": "27582276071408289", "version": "0.23.1", "version_code": 16779110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27609283595374203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782180078, "id": "27581612754807954", "version": "0.23.1", "version_code": 16779108, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27609283595374203"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782171804, "id": "27580515928250970", "version": "0.23.1", "version_code": 16779106, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
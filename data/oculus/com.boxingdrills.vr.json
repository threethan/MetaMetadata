44881073644028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrvLdYgKeTYQ7kNvwEDEYV6&_nc_oc=Adrlv6wNJDmyhccwm0CdITaljmhlxDEhw9Ga7qGYXHXWIJ-JPGHWG-qQTN5I6cvcSaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSEPm5h8biycFCTvn48v2FjVtV3C3wM5QBkf8dwXg7lA&oe=6A5E17BA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7JvF8cKrmYQ7kNvwHeVk-1&_nc_oc=AdpoHfr1OAxfoFMYlVOZES2bftPUGeU8CPbxUotQTbpjcq2wBhK2Sj9qDUiSasvSmcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbhLLWoQshXC_paLBsGJi4CwE5lDRSVMKzS9xGKGT9IA&oe=6A5E2D5D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQSNYLcvQLMQ7kNvwHz8FCo&_nc_oc=Adr4WwRhbaYqcTaKUIFmP2rxKjYW0Phd_mHoEVx59_h3_vhCNoKf2sTxI1Ym18TkAe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFyN3TyIYhuP2YgCrrhRyiZ2stfIsc94DOhOLvF3mcGw&oe=6A5E03D2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59eO2acCyREQ7kNvwE5msey&_nc_oc=AdrZ0403_5UD1StcmxbxN9Gc9qxEXl_4mRqi_Rmq2RZ1UPBywo96h3hRVeUAA0oG1l0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1-QmNCMX5_RC2Dhd0EL2M19AKpxb3kUv4GJV5VFSVog&oe=6A5E16E9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBiMiW38YqUQ7kNvwFh0Abd&_nc_oc=Adq9l82YlOcst_IxcdtMWOB_SsPJmNkr42hPaR9Cg-1dddzfTCwYZEjgHT3R4g4H7m0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJESGCKcGoCQaYgexGqea6gX9zRt8Uq24sHg156zw1Lg&oe=6A5E271F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZNtIn2LSfMQ7kNvwHUfTGS&_nc_oc=AdpbsBgjgHxruvWGJI3RLqD-U-YyQwnjeZm3bM03v6T_jWlKXR2Sw_Ppik2MmOdt-u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABOCTjOociQO5-v0cc80TDtse2h-y418jBL3p8GPjvdA&oe=6A5E2CD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27834237702878790", "version": "0.32.1"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27834237702878790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.32.1\n\n**Weak punches keep the drill moving**\n- If a punch lands too soft, the drill now moves on instead of leaving the mitt stuck waiting for a harder one. You hear a miss sound, TOO WEAK pops at the mitt, and the next move comes. The soft rep still drags your score, so there's no sneaking through.\n- Prefer the old strict pads? Turn on \"Weak Punches Block\" in Settings and the mitt waits for a clean hit again.\n\n**Pass or fail**\n- Drills now grade you at the end. Land 80% of what the drill asks for (clean punches, dodges, blocks) and you pass. Soft punches, dodges that catch you and pads you let time out all count against you.\n\n**A clearer results screen**\n- Session stats now sit in one aligned list: combos, mistakes, weak punches, blocks, punch power and body engagement. Blocked no longer floats alone above the rest.\n- \"Missed\" is now \"Mistakes\", since it counts everything that went wrong, from dodges that caught you to pads that timed out.\n\n**Bug fixes**\n- Body engagement showed 0% on drills with only straight punches. Straights don't expect body rotation, so the stat now stays hidden on those drills.", "created_date": 1784163375, "id": "27834237702878790", "version": "0.32.1", "version_code": 16779164, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27834237702878790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.32.0\n\n**Instant feedback on every punch and dodge**\n- Every punch now pops a quick verdict right at the mitt: PERFECT!, GREAT!, GOOD or OK, plus TOO WEAK and WRONG PUNCH when something's off. No more checking the scoreboard mid-combo.\n- Dodges get a verdict too: GOOD when you clear a duck, slip, weave or pull, TOO SLOW when it catches you, BLOCKED when your guard takes it.\n- Both can be turned off in Settings under Display & Scoring.\n\n**See what's coming**\n- The drill HUD now shows the next punch or dodge one step ahead, so a duck never ambushes you mid-combo. Toggle in Settings.\n\n**Smoother framerate**\n- Fixed heavy framerate dips when an incoming glove flew through your face.\n- The resting pad at the trainer no longer flashes or shatters when you clip it by accident.\n\n**FPS display**\n- New Settings option pins a small live framerate readout to the corner of your view. Off by default.\n\n**Tutorial**\n- Defense practice now reacts to every attempt, including the ones that catch you. Pull-back practice scores every rep instead of only the first.\n- The setup step's options are properly centered.", "created_date": 1784107867, "id": "27826681376967756", "version": "0.32.0", "version_code": 16779162, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27834237702878790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.2\n\n**Quest 2 framerate protection**\n- 90 Hz now only turns on for Quest 3, Quest 3S and Quest Pro. Quest 2 always runs at 72 Hz, where it holds a steady framerate. Previously a Quest 2 could end up at 90 Hz and drop to a choppy 45.\n- The Refresh Rate setting is now Auto or 72 Hz. Auto picks the right rate for your headset. Choosing 72 Hz on a Quest 3 or Pro saves battery on long sessions.", "created_date": 1784022333, "id": "27816364994666061", "version": "0.31.2", "version_code": 16779160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27834237702878790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.1\n\n**Bag heights**\n- The heavy bag hangs higher.\n- Settings has two new controls to raise or lower the heavy bag and the double-end bag, up to 50cm each way in 5cm steps.\n\n**Bug fixes**\n- Punches at the lower half of the double-end bag now connect. The hit zone sat higher than the ball itself.\n- The score bars on the drill complete screen were stuck in the top left corner since v0.30.0. They're centered again.", "created_date": 1783909160, "id": "27802769316025629", "version": "0.31.1", "version_code": 16779158, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27834237702878790"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.0\n\n**Real 3D bags**\n- The heavy bag is now a worn leather bag hanging from straps, and the double-end bag is a paneled leather ball on its cords. Every piece of equipment is now a real 3D model.\n- Quest 2 gets the same models with lighter textures to protect its framerate.\n\n**Double-end bag timing**\n- Hitting the ball as it rebounds toward you now snaps it back harder, like the real thing. It used to stop the ball dead.\n- The in-drill display on both bag drills sits further back, off the equipment.\n\n**What's New popup**\n- After an update, the changelog now opens once in-game. Turn it off in Settings if you prefer.\n\n", "created_date": 1783848075, "id": "27795558616746699", "version": "0.31.0", "version_code": 16779157, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
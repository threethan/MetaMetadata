xPVL0z2SDor6wtyIXDGjODvfMSxK-Uo_OrxwbheW16njhIImo3gAmgx2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymMh4Inr4pUSnBvPjaLBpuop66q-3qnKIKhdOozd8WEw&oe=69B7E6D2"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEzOBW99eawQ7kNvwFi--S1&_nc_oc=Adnrlr0tE7i1buIgjD_5XuuqGt06eAjqyd4cLwPwxLTREClf0BQLPItRk8e_Rzm6aKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDvZOxuC7jvZrUDcdx2MHXsDG0fI-0kQpzMT1R1yP2AA&oe=69B7F9E9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOc1aBBLK3kQ7kNvwHYa0hN&_nc_oc=Adnxxwu_S_ximRORG-mynFJAyo4ky5_ZR2widCZNhVr_gffzA9x72Fuh8N1KFDBN2pc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLVcudPrmoEyviSHfYdRa41ceup3-cDxr-144hxU9nSQ&oe=69B80A1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_v83aUZOiwQ7kNvwEtr6m_&_nc_oc=AdnKRgGwQjNLimCITtfPsNS99DKz3DnudM5eXzNAHUZKbNRvekGx0ICx825r9yuvzjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYOJ4mhVnkJcUdMpKNiJgHSEmkF5w3TUu_EyxtWAHoiQ&oe=69B80FD6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "4443476652641359"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772139060, "status": "PUBLISHED", "id": "4443476652641359"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26347613404874568", "version": "0.7.0"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26347613404874568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.7.0\n\n**16 New Drills (29 total)**\n- Punch combos: 2-3-2, 1-1-2, 5-6-3-2, 1-2-3-6-3-2, 8-3-2\n- Defense: Catch & Counter, Duck-Duck 3-2, Roll & Hook, Shell Defense, Slip-Cross Slip-Hook, Counter Fighter, Pressure Combo\n- Footwork: Pivot, In-and-Out, Circle Drill, Cut the Ring\n\n**Footwork Mechanics**\n- Pivot drills reposition pads 90\u00b0 around the player, requiring actual head rotation to advance with floor arrow indicator\n- In-and-Out adds Pull step after Jab-Cross, forcing player to step back out of range\n- Duck bar now supports left hook direction (right-to-left swing), fixing DUCK-DUCK 3-2 to alternate directions\n\n**Southpaw Mode**\n- New Southpaw toggle in settings \u2014 flips all punch-to-pad and hand assignments so right-foot-forward boxers train naturally\n- All existing and future drills work automatically with no per-drill changes\n- Pad colors swap to match stance (blue = lead hand, red = rear hand regardless of stance)\n- Orbit drills, combo validation, and slip rope offsets all respect the southpaw setting\n\n**New Drill**\n- Added 3-4-2 drill (Left Hook, Right Hook, Cross)\n\n**Visual Improvements**\n- Boxing pads now have a dark back face for better visual distinction when rotating\n\n**Training Rank**\n- Removed fight gating from career progression \u2014 all opponents are now accessible\n- Added Training Rank display based on lifetime training points\n- Enlarged UI panel for better readability\n\n**Bug Fixes**\n- Fixed Adreno 740 file descriptor leak that crashed the app after ~7.5 minutes on Quest 3 \u2014 patched bevy_render to skip unused Surface render pass\n- Added FD monitor system for diagnostics\n\n**Store & Landing Page**\n- Fixed Meta Horizon Store button link to point to actual listing\n- Added source code link to landing page\n- Added anchor IDs to guide headings for deep linking\n", "created_date": 1773032738, "id": "26347613404874568", "version": "0.7.0", "version_code": 16779011, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26347613404874568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.7.0\n\n**Southpaw Mode**\n- New Southpaw toggle in settings \u2014 flips all punch-to-pad and hand assignments so right-foot-forward boxers train naturally\n- All existing and future drills work automatically with no per-drill changes\n- Pad colors swap to match stance (blue = lead hand, red = rear hand regardless of stance)\n- Orbit drills, combo validation, and slip rope offsets all respect the southpaw setting\n\n**New Drill**\n- Added 3-4-2 drill (Left Hook, Right Hook, Cross)\n\n**Visual Improvements**\n- Boxing pads now have a dark back face for better visual distinction when rotating\n\n**Training Rank**\n- Removed fight gating from career progression \u2014 all opponents are now accessible\n- Added Training Rank display based on lifetime training points\n- Enlarged UI panel for better readability\n\n**Store & Landing Page**\n- Fixed Meta Horizon Store button link to point to actual listing\n- Added source code link to landing page\n- Added anchor IDs to guide headings for deep linking\n", "created_date": 1772788657, "id": "26320205307615378", "version": "0.7.0", "version_code": 16777751, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26347613404874568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.6.0\n\n**Scoring Overhaul**\n- Power and speed now use per-punch-type velocity thresholds instead of one generic range \u2014 jabs are judged as jabs, crosses as crosses\n- Speed based on punch velocity (m/s) instead of reaction time \u2014 footwork movement no longer penalizes your speed score\n- Separate weight class scaling for speed vs power: lighter boxers have faster hands (higher speed bar), bigger boxers generate more force (higher power bar)\n- Agility replaces depth bonus with reaction speed \u2014 how quickly you dodge after the threat appears (<=0.3s = full credit, >=1.0s = zero)\n- Body engagement excludes jabs \u2014 they're lead-hand snaps where body rotation isn't expected\n- Body engagement display on complete screen only counts non-jab punches\n\n**Form Scoring**\n- Form now measures two components equally: off-hand discipline (50%) and punching hand retraction speed (50%)\n- Off-hand check: is your non-punching hand in guard at moment of impact?\n- Retraction check: does your punching hand return to guard within 0.5s? Must reach chest level \u2014 letting it drop doesn't count\n- Guard zone is stance-agnostic \u2014 both face-guard and body-guard stances accepted\n- Removed height requirement from off-hand guard check so body-guard boxers aren't penalized\n\n**New Drill**\n- Added 3-7 (hook head to hook body) drill \u2014 the liver shot combo\n\n**Menu Redesign**\n- Tab-based layout with TRAIN / FIGHT / WORKOUT / SETTINGS tabs\n- Category sub-tabs within Train (Punch Combos, Defense, Footwork)\n- Three-level joystick navigation: tabs, sub-tabs, drills\n\n**UI Improvements**\n- PR indicators shown on workout transition screen between drill segments\n- Scoring guide added to the complete screen\n- Guide link promoted to prominent button on landing page\n- Fixed joystick navigation getting stuck on non-Train tabs\n", "created_date": 1772689011, "id": "26308914735411102", "version": "0.6.0", "version_code": 16777750, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26347613404874568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772688125, "id": "26308828175419758", "version": "0.5.0", "version_code": 16777749, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26347613404874568"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": null, "created_date": 1772687557, "id": "26308772215425354", "version": "0.5.0", "version_code": 16777748, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
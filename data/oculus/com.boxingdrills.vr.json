77ZD19WNk9SReYKoSN1NwQMEKGsiOxz9RudeHf1KgkJ7x2zOSDec&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsNQFWY1iKozTBMc6VHaTEBBz4kjLu1ZHxlCZD3SqHqQ&oe=6A5A1798"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpioKi1_NJ8Q7kNvwH7OeLw&_nc_oc=Adq1PfDSemGlc9tm33CyOA4h836oPp-m1xyQ6kpYmYLFZijhLf9CtdHy5KVX-fvCcXs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKGWF24oG6z2UIzTuicTFWDTmtU07W0F71QiN4Cw8o4A&oe=6A5A233A"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLX473Lii5oQ7kNvwGnN2Ea&_nc_oc=Adr1DGxE0v9T3iEBffHWMNRvS5leZTaLKF18EWkZLDSXxrHqa-EIxNsxmUq0obQRW38&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEkcXcbT8k_Q5R5XMdSqt5Ire4AOTiGhY3EK5o1S-cWQ&oe=6A5A38DD"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1EZ7xNjrGEQ7kNvwEIcaaE&_nc_oc=AdoU1qalDYgTOn3CdLdbVmv_vXaRy_9oDm70s4LNeXcoJHNVEN5DOZx9I5D5ZyGz9NI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFN3-B1l6R329365T97-SHOHrZ5VBHNQYiTIMGXNi75Q&oe=6A5A4792"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-cbimzsxoIQ7kNvwHLTwUb&_nc_oc=Adpb2YvnUEJ2KMlF1ZECRvNEQxe7eN-UGy-EhCLOzIoiuDr8MKASjHvwFFdEttv-t9w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUY_a68GbCAdFJCXcStmHkfqaXbu-UXSfLOfP0vWScyw&oe=6A5A2269"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u06RAXcoSPQQ7kNvwEcQKqg&_nc_oc=Adq_QlMzbC5ZkZiYpZjm1uvU0xmY-P1mGaJxkzVf171LmIQKK01E0YrhbxMcXWowwmE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP49S7HUYRwsOD0WoiA2hEDPqNpg1Sihra3YVNfERVmQ&oe=6A5A329F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHLFzh7zI7MQ7kNvwHAPVIv&_nc_oc=AdoUwqNbnf-CwxF5W5CnQ4_bKUejbHAdsEEKjIGkJ_WFh_XMxc-d4FsTn_m6cHjZu4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGkbNmpoul2tC4HKvXb7cv68O58Ff0sSV0KoTUxGVCmQ&oe=6A5A3856"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1005552205303411"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27802769316025629", "version": "0.31.1"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27802769316025629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.1\n\n**Bag heights**\n- The heavy bag hangs higher.\n- Settings has two new controls to raise or lower the heavy bag and the double-end bag, up to 50cm each way in 5cm steps.\n\n**Bug fixes**\n- Punches at the lower half of the double-end bag now connect. The hit zone sat higher than the ball itself.\n- The score bars on the drill complete screen were stuck in the top left corner since v0.30.0. They're centered again.", "created_date": 1783909160, "id": "27802769316025629", "version": "0.31.1", "version_code": 16779158, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27802769316025629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.31.0\n\n**Real 3D bags**\n- The heavy bag is now a worn leather bag hanging from straps, and the double-end bag is a paneled leather ball on its cords. Every piece of equipment is now a real 3D model.\n- Quest 2 gets the same models with lighter textures to protect its framerate.\n\n**Double-end bag timing**\n- Hitting the ball as it rebounds toward you now snaps it back harder, like the real thing. It used to stop the ball dead.\n- The in-drill display on both bag drills sits further back, off the equipment.\n\n**What's New popup**\n- After an update, the changelog now opens once in-game. Turn it off in Settings if you prefer.\n\n", "created_date": 1783848075, "id": "27795558616746699", "version": "0.31.0", "version_code": 16779157, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27802769316025629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.30.0\n\n**90 Hz on Quest 3 and Quest Pro**\n- The game now asks the headset for 90 Hz instead of 72. Everything looks smoother and the game reads your hands more often, which sharpens punch speed measurement.\n- Quest 2 stays at 72 Hz on purpose: it can display 90, but this app would rather spend that headroom on keeping the framerate steady. If you want to override either way, there's a new Refresh Rate option in Settings under Display & Scoring.\n\n**Punches register faster**\n- The physics now runs more often than the display, so a hit registers on the very frame your glove reaches the pad instead of a frame or two later. Combined with 90 Hz this makes fast combos feel noticeably more immediate.\n\n**Sharper menus**\n- Menu and HUD text renders at higher resolution on Quest 3 and Pro. Same layout, crisper letters through the lenses. Quest 2 keeps its current rendering, which was already tuned for it.\n\n**Sleep and resume**\n- Taking the headset off mid-session and putting it back on later now resumes properly. This one had been broken for a long time and turned out to come from a windowing library update, which we've rolled back.\n- After resuming, the laser pointers could hide behind the menu panel. They now always draw in front of whatever they point at.\n\n**Other**\n- The pause menu shows your current framerate, handy for checking how your headset is coping.", "created_date": 1783752119, "id": "27784414064527821", "version": "0.30.0", "version_code": 16779156, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27802769316025629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.29.0\n\n**Range: Random**\n- The Range control on the Train tab has a third option. Random rolls inside or outside fresh for every drill, and for every drill in a workout, so you have to read the range instead of settling into one.\n- You won't know the roll in advance, so the countdown flashes \"Range: Inside\" or \"Range: Outside\" before the drill starts. Workouts show it between drills too.\n\n**Tutorial, reworked from player feedback**\n- Duck, slip and roll practice no longer ends after one dodge. Threats keep coming until you hit Continue, and slips now come from both sides.\n- Every page has a BACK button. If you've finished the tutorial before, SKIP appears too, so you can jump straight to the one movement you want to practice.\n- The tutorial got its own button on the main menu, just above Help.\n- The Warmup league is now offered in the setup step, and the panel sits at normal menu height instead of making you crane upward.\n\n**4-AXIS fixes**\n- In workouts the pad could end up stranded in a corner instead of working around the ropes. That was the workout's footwork fighting the drill for control of the pads. Fixed.\n- 4-AXIS drills no longer show up in random workout rotations. They're technique work, not cardio. To put them back in a workout, favorite them and build a favorites workout, or run one as timed rounds.\n\n**Under the hood**\n- The game runs on a major new version of its engine now. After weeks of testing everything should look and feel the same, just a bit better behaved. If something seems off, I want to hear about it.\n- Adaptive difficulty is genuinely off by default now. It was meant to be off since v0.23, but upgrading from an older version could quietly switch it back on.\n", "created_date": 1783747375, "id": "27783906544578573", "version": "0.29.0", "version_code": 16779155, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27802769316025629"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.28.0\n\n**New: the 4-AXIS series**\n- Four technique drills worked from under a rope cross that hangs directly over your head: 4-AXIS JAB, CROSS, LEAD HOOK and REAR HOOK. One pad, one punch. The pad moves around the cross between reps, so you slip or duck under a rope to reach each new spot. Touch a rope and it buzzes, and the miss goes on your score.\n- Hook pads turn sideways, the way a real holder invites the shot. All pads sit at chest height so the ropes pass over them cleanly.\n- This series started as a player request on Discord and went through alpha testing before landing here. Thanks rbast!\n\n**New drill: DOUBLE TROUBLE**\n- Double jab, cross, double hook, cross. On a doubled punch the pad now behaves like a real holder: it takes your first shot, kicks back, and snaps into place for the repeat. A fast second punch counts even while the pad is still moving.\n- It also joins the pool COMBO CALLER draws from, so expect doubles in your called combos.\n\n**Fixes**\n- The drill search now keeps your text when you come back from a drill. Type \"4-axis\" once and work through the whole series without retyping it.", "created_date": 1783635992, "id": "27771040272531867", "version": "0.28.0", "version_code": 16779152, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
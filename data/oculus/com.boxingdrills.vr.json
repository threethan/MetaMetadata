": "2095210894392717", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619751_2095210897726050_8750518535702010235_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebQ0dKte0kEQ7kNvwElckPK&_nc_oc=Adrjanfplnc_4ytkRzmTGUTqpqW0sjTBg1ZihrFGK1o9mGnNMegyUwhP0jRIQtUXYYo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERNtwbGRwMgK96Am5GCuhm_e7kuYxUgDb1cH2s45DJCQ&oe=6A8066BC"}, {"file_name": "com.boxingdrills.vr-20260713-162406.png", "id": "2478518782658063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_2478518785991396_3146099330790565842_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzzQaAXgoF8Q7kNvwF3uD03&_nc_oc=AdrPOZdB8kwXn7NjizMTV_Gvb2sJpXTQzOL3sscLZL19kF6KTTcglcAK4PSEq2fUegE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLlZR0E_NGu0SIPZDqdZkamQHRi1R16Gjs1Gixrwjk2A&oe=6A806FA1"}, {"file_name": "com.boxingdrills.vr-20260713-162231.png", "id": "1343092313992102", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619685_1343092317325435_1884872166106631142_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4r9zUDSLtAQ7kNvwEk0fxx&_nc_oc=Adr-9UeNWjlqdtDGSBD-HjKxHTClCdy5tdhJbmmLRksyfrEEL9docf0u93sRnHaF6_0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3dI9BXDRKvcyiteRB-3Ck6aPVhFNGdrf5KM1QiQgzDA&oe=6A8042A0"}, {"file_name": "com.boxingdrills.vr-20260713-162514.png", "id": "2158397548419140", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622276_2158397551752473_2495375832712571267_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltPirDSaplwQ7kNvwE0DkYF&_nc_oc=AdogY9Q0Ab_BDEXIzOQbxkj0q3Nqfb9pU9DHq_fERtMsuTJzWiOFNBGdUF4J4IMG7-I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn7liEsyNeNRE-XQSahiaLuckF68kPsxca3q5obmuHqg&oe=6A8052C1"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2017595326295931", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623400_2017595332962597_1218088256288490559_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA6Ps75T7OYQ7kNvwHZ4II7&_nc_oc=Adp9shWbeNcT2iuvhSLZuhYJuz5ad8u5CmVkE52NCqhzi8ro151l31WCnAEnylsfEB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoQ7kfiMPGSbTleTHPob2rDrNje41x50lvXpdfvOOK4A&oe=6A804DF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1605866321257859", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623443_1605866324591192_538714170404200545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siA56ynVOIQQ7kNvwE0zRC8&_nc_oc=AdoZkbN-SzugI9DZk9OeeI8pDseCQWvagHo95ORVYJSn1nZ4oJeaZm3fCMPZ7ARIl1E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJG7uPoJwMRDJUsCFMCRCw-AsckMYSgAb4VKiert3LWA&oe=6A806877"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Real boxing fitness requires proper mechanics. Boxing Drills VR focuses entirely on practical padwork and drills. Your virtual coach handles the combinations. You move, punch, and slip just like in a real gym. \n\nWe built this to help you practice footwork, guard discipline, and hip rotation. If you punch too softly, it does not register. If you drop your guard, you lose points. Stand flat-footed, and the trainer steps out of range.\n\n**Train with real standards**\n* Practice combos, defense, and footwork drills. \n* The pad trainer moves, forcing you to reposition.\n* A velocity threshold makes you commit to your shots.\n* Scoring tracks your core rotation, not just quick hands.\n* Real-time feedback on punch speed, power, and form.\n* Play in orthodox or southpaw stance.\n* Workout mode is exceptional for fitness and burning calories\n\n\n**Track your progress**\n\nThe app scores your power, speed, agility, and form to show how your mechanics improve. \n\nWhether you use this to warm up for a sparring simulator or as your main cardio routine, the pads are ready when you are. \n\nJoin the Discord at https://discord.gg/8FyagxceKs to help shape what comes next, we are frequently adding new updates.\n\n**Clear some space, put the headset on, and try your first drill today.***", "short_description": "VR boxing and fitness focused on real mittwork and boxing drills. Throw combinations, slip punches, and use actual footwork while a virtual trainer holds the pads. Your punches only count if you use proper form and power. With an ever-growing number of drills, you can also chain them together for an intensive workout or build your skills in career mode. There is boxing equipment too, like at the gym.  No subscription required and only ever pay once.   Put the headset on and start training today."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27968748599427699"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619681_1064827699329977_7045274292099501484_n.png?s
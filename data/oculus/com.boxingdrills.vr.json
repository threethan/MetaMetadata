a0a&_nc_ohc=86OF1LAnOkEQ7kNvwHH4UF4&_nc_oc=Adk8PKLiVEN-zK51Hac29axQMsky70lOBQhhTK-1fVCsT5tV5kZeC4-EPJaYDPEn7B8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsUWTNbQk5-6f4-w4XPlJydgX92_n8sPVb_NqyiZpb9A&oe=69AEAC52"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1XkePso-S0Q7kNvwHraLDT&_nc_oc=Admh12bIUwrJcdiTvd1Gi6rBS1L2hvp_QjXRZNUpiPiZgQWFGPTwK9hbcTNaVu0zWoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIwknnv8JhbtY9o4jKgd6IKSmAJ46684k3SIB948R8Vw&oe=69AEBF69"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFeh5ZqIhQYQ7kNvwGnVtTX&_nc_oc=AdlfdU_Y_zJIJikgtiMvYOoNtqMrDo7nZ2_aoKPvJCyX7HY9WLgklRjN-PKXbF7TQyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygtfyBLrHCDb6gKbtgUvTU7RuIAdecd27ISOVF_aGT5w&oe=69AECF9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rx1xz7ncJz8Q7kNvwGXvE6C&_nc_oc=AdkQYH0CsfsVrAqLinjFi1yRrt1wRb1lB2bRPvbWuApidsmoIxMoJBM2qDUhlviW4vk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGNGepm-92eUXV5ZHauzIhf-LyngtxtT1QUkuJ-9TRow&oe=69AED556"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Help Shape the Future (Open Source)**\n\nJoin Discord at https://discord.gg/ATGvjfDJ", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drills/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/ATGvjfDJ", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", 
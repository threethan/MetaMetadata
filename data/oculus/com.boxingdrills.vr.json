&oe=6ABA8D58"}]}, "id": "2713860495679965", "locale": "en_US", "screenshots": [{"file_name": "com.boxingdrills.vr-20260222-171729.png", "id": "1244881073644028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619704_1244881076977361_5615678092938328795_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjI_ocJDDiwQ7kNvwH9B2E_&_nc_oc=Adq971xAiMrzURegz4iIFJLR4_JWrKM5pwUDNI5WopetUHI-dubWVOGiDR-bOEZNFhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe4zI65PvHMjhCqs3046IgzYzfjqsiCJGf1nTzBZC9eQ&oe=6ABA60BA"}, {"file_name": "com.boxingdrills.vr-20260222-171803.png", "id": "878545175052858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618102_878545181719524_1967766508375899942_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJlbCwsXAPMQ7kNvwEcmATN&_nc_oc=AdpDwan1c6iW4jKL6Ve9CMKBRBmARPqTPRWB0Bx7ufmwZC9lO1eGDMHp66G0bxof6tw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsU-XjlPafnS7sC9m4IbKmAyQuwue8_KWhy1_MBlfG9A&oe=6ABA765D"}, {"file_name": "com.boxingdrills.vr-20260222-171753.png", "id": "2355644911606270", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619096_2355644914939603_7881252502421777745_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a12hj1RJe0YQ7kNvwFHjx6X&_nc_oc=AdoqJjf7L-tCbiQFZa7KutPellay1XGQWJQIvvhLoCoYUL5wLurkNhin1xUeWg9kFNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtwBC3LHam7TjHsip5R2_DwHSj10tLW0MIsrMqfoz5aA&oe=6ABA8512"}, {"file_name": "com.boxingdrills.vr-20260222-171744.png", "id": "1574678113766454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308961_1574678117099787_7551936325078272668_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqWeqA4oyycQ7kNvwHuQGRg&_nc_oc=Ado7zMK7fpelO_cEGd-FWLctc4xn8e2u6Acv1Sa1-0cNU6oHouw5uQg1nch9Rq3P97c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoremTzysSItN2XbWM9TjHO3e_uH-VxyNfVQdrFjnuvQ&oe=6ABA5FE9"}, {"file_name": "com.boxingdrills.vr-20260222-171747.png", "id": "936482305505709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_936482308839042_2870889141134525125_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON_AvKqNuF4Q7kNvwGrcbMe&_nc_oc=AdpI23kYtqL-YSk3IRcWeWBssJG-1xULOyKey26DXA9frQApyWSLMfAE-Ft3r2iuN1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGCXOm8QH9NWVLiXvts6-DvtYrVbJf1tBUrNXrQ7gJow&oe=6ABA701F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1595686508155082", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618472_1595686511488415_510087455054191114_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6VxPiRXMcwQ7kNvwEOhoDc&_nc_oc=AdoNMjJA68y7WWYnvugiW8K1FhFnx7aVCirlkWtUeFvDVFRj6eu_U5iuo9-9xp7Ki9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxET4TtVSomuJIb2HHvx-niPfSvniHn9BHLPaOp9dSfQ&oe=6ABA75D6"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "padwork", "trainer", "drills", "speed"], "long_description": "# Train Like a Real Boxer\n\nBoxing Drills VR brings authentic pad training to your Quest. No gym required.\n\n**Realistic Drills**\n\nFollow a virtual trainer through classic boxing combinations:\n- **1-2 (Jab-Cross)** - The fundamental combo\n- **1-2-Duck** - Add defensive movement\n- **1-2-3** - Jab, Cross, Hook\n- **1-2-3-2** - Extended combinations\n- **Uppercut combos** - Work those body shots\n- **Growing Library** - A vast selection of drills with new content added regularly!\n\n**Built for Performance**\n\nWe know every millisecond counts when you're in the pocket.\n- Low-Latency Precision: Built from the ground up for high-performance tracking.\n- Native Feel: Optimized to ensure smooth, responsive feedback that feels like hitting real pads.\n\n**Get Scored**\n\nEvery session tracks your performance:\n- **Power** - Hit those pads hard\n- **Speed** - Quick reactions matter\n- **Agility** - Duck and weave like a pro\n- **Form** - Return to guard after every punch\n\n**Train Your Way**\n- Multiple drill durations (30s to 3 min)\n- Choose the speed that suits you (slow, medium, fast, progressive, variable)\n- Passthrough mode - train safely in your own space\n\n**Perfect For**\n- Beginners learning boxing basics\n- Fitness enthusiasts wanting a fun workout\n- Experienced boxers staying sharp\n\nNo experience needed. Just clear some space, put on your Quest, and start throwing punches.\n\n**Shape the Future (Open Source)**\n\nWe believe the best training tools are built by the community. We are moving toward an open-source model so the community can help us shape the roadmap of the product.", "short_description": "Train like a boxer in VR. Follow realistic pad drills with jabs, crosses, hooks, and uppercuts. Practice defense with duck-and-weave combos. Track your power, speed, and form after every session."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxing-drills-ec8acc.gitlab.io/privacy.html", "developer_terms_of_service_url": "https://boxing-drills-ec8acc.gitlab.io/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": null, "website_url": "https://boxing-drills-ec8acc.gitlab.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26010917265210852"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1744772810063418"}, {"status": "PUBLISHED", "id": "1013623321669324"}, {"status": "PUBLISHED", "id": "1005552205303411"}, {"status": "PUBLISHED", "id": "1657151418799256"}, {"status": "PUBLISHED", "id": "899033179613105"}, {"status": "PUBLISHED", "id": "4443476652641359"}]}, "baseline_offer": {"id": "899033179613105"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1744772810063418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28691669960468889", "version": "0.38.2"}, "id": "790503750728261", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691669960468889"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.2\n\n**Three new languages: \u65e5\u672c\u8a9e, \ud55c\uad6d\uc5b4, \u0420\u0443\u0441\u0441\u043a\u0438\u0439**\n- The whole app is now available in Japanese, Korean and Russian, joining English and Spanish. Menus, settings, drill names and descriptions, coaching tips, workout and fight screens, the tutorial, all of it.\n- On Auto, the app follows your headset language. You can also pick a language directly in Settings, and it switches on the spot.\n\n**Spanish is now complete**\n- Around 200 drill names, descriptions and coaching tips that still showed in English are translated. Every language now covers the same ground.\n", "created_date": 1790070045, "id": "28691669960468889", "version": "0.38.2", "version_code": 16779239, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691669960468889"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.1\n\n**The pull counter punches like a punch**\n- The pull-back threat is a normal-sized amber glove now, not a giant red block. It cocks back, shakes as it loads, then fires at your face and snaps back after missing you. Ignore it and it follows through instead.\n- You're judged on the deepest pull you made at any point before the punch lands. Pull early and return to guard, still yours. Finish the pull right as it lands, also yours.\n- The counter pad now waits until the punch is actually flying before it appears. It used to pop out while the glove was still parked, which baited you into punching straight into the counter.\n\n**Know your opponent: six new flashcards**\n- The web trainer has a new card type. Opponent cards cover taller, shorter, evasive, aggressive, a puncher and a speedster, each with a game plan and the combos that serve it.\n- Situation card answers now always show the numbers, including for word-named combos like DOUBLE TROUBLE.\n\n**Honest scores**\n- Results only show what a drill actually measured. A defense drill scores your agility and nothing else, instead of padding the screen with placeholder power and form numbers. Personal bests and the fighter card follow the same rule.\n\n**Workouts**\n- New 3 minute duration, enough to groove your timing before a real match without spending your legs.\n\n**Tutorial**\n- The pull-back page teaches the new punch.\n- Replaying the tutorial from the menu now shows an EXIT button on every page, so you can leave whenever you want.", "created_date": 1790051573, "id": "28688769407425611", "version": "0.38.1", "version_code": 16779237, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691669960468889"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.38.0\n\n**FIGHT IQ now speaks in numbers**\n- Calls, flashcards and the combo book lead with the numbers. 1-2-3 is the combo, BREAD & BUTTER is just its nickname. Your card progress carries over automatically.\n- In TEST YOURSELF, the word-named combos (DOUBLE TROUBLE and LEVEL CHANGE) show their full number sequence under every call, so no call leaves you guessing.\n\n**Study anywhere: flashcards on the website**\n- The flashcard deck moved to the web. Open wobble-bot-games.gitlab.io/boxing-drills/fight-iq-cards.html on your phone or computer for the same cards with the same spaced repetition, no headset needed. The FIGHT IQ tab has a button that opens it in the Quest browser.\n- The tab itself is simpler now: the combo book table for a quick look between rounds, and TEST YOURSELF to prove it in the ring. In-headset card review and THROW IT practice are gone.\n- New situation: THEY'RE STUNNED. Every combo of six punches or more files under it, because a long string is what you throw when they're hurt and can't answer back. That covers AVALANCHE, DOUBLE TROUBLE and LEVEL CHANGE.\n- The LEVEL CHANGE card now explains the body shots: bend your knees and drop your level rather than punching down, and the dip doubles as head movement.\n\n**Website**\n- New landing page, and the guide is split into sections with search.\n- A public roadmap page shows what's in progress, what's planned, what shipped, and the experiments that didn't make the cut.", "created_date": 1789608208, "id": "28620283217607564", "version": "0.38.0", "version_code": 16779236, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691669960468889"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.37.0\n\n**The double-end bag and speed bag finally hit true**\n- Both bags used to fly off wherever your hand path wobbled, which made them nearly impossible to keep straight. Punches now work like a real flat glove: aim near straight and the bag comes straight back, so you can actually settle into a rhythm. This is the biggest change to how both bags feel since they were added.\n- Deliberate angle shots still work. Hit the bag from the side and it goes sideways, and the speed bag still rolls around its rim.\n- New Bag Straightening slider in Settings, default 50%. Turn it up for a stronger pull, or down to 0% for the old raw physics.\n\n**Floor marker**\n- The stance ring and arrow no longer appear in the double-end bag, speed bag and heavy bag drills. There is no fixed spot to stand at a bag, so the marker just got in the way.", "created_date": 1788660534, "id": "28471131649189389", "version": "0.37.0", "version_code": 16779233, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26010917241877521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28691669960468889"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "790503750728261"}]}, "change_log": "### v0.36.0\n\n**New FIGHT IQ tab**\n- This is an alpha feature. It may see significant changes or be removed entirely in the future depending on feedback.\n- Every advanced combo now has a name you can actually remember. BREAD & BUTTER is 1-2-3, KNOCK KNOCK is 1-1-2, TRAPDOOR is 1-1-2-7-3. The names appear on the drill cards too.\n- The tab holds flashcards built from those combos. Each card shows the sequence, when to throw it, and which situations it answers. Rate yourself GOT IT or AGAIN and the card comes back on a spaced schedule, from daily up to every two weeks as you learn it.\n- Press THROW IT on a card and real pads appear in front of the menu, so you can throw the combo right there without starting a drill.\n- The FIGHT IQ drill lives in this tab as TEST YOURSELF. It calls a situation plus a combo name, like AT LONG RANGE - DOUBLE TROUBLE, and you throw the answer from memory. The numbers only appear if you hesitate, and the test calls your weakest cards more often.\n\n**Best Combo time**\n- Combo drills now time each combo from first impact to last. The results screen shows this run against your personal best on one bar per combo. Only clean reps with no weak punches can set a best.\n- COMBO CALLER shows the current call on a banner at the top of your view until you complete it, replacing the floating text.\n\n**Double-end bag**\n- The cords are much tighter by default, so the ball snaps back about twice as fast. A new Bag Tension slider in Settings lets you tune it to taste.\n\n**Menus**\n- The results screen is bigger and its content scrolls, so the buttons below can no longer get pushed out of reach.", "created_date": 1788651047, "id": "28470000702635817", "version": "0.36.0", "version_code": 16779231, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
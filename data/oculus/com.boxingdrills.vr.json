HUlYNlp0zphjqc9jwUTjaNa7DNczo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSY4gGm0d78DZHcdMXgGqYvfUVcv_nRb9lnIeVdzYDSLA&oe=6B0C5E23"}, {"file_name": "gym_laser_tag.png", "id": "2544868389354215", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839680_2544868392687548_7700008673299830839_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxgJg6LvDfwQ7kNvwGPZJQP&_nc_oc=Ado1I_iLAzlfCL6v4e-5j0aGM1U8d8B9A0ny1AXmdkqkYR-qnf01wqGo8GMdRp6ObVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuAiNfZ_N7ZjK7ekJ1RC6rBPIyKK4TcjXXLHhEIz4dgQ&oe=6B0C60BD"}, {"file_name": "gym_score.png", "id": "2497190501085247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839654_2497190504418580_9220071482130032270_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdiL4W6mAnAQ7kNvwFyRNi-&_nc_oc=AdrYUzIXzt2CERYkzvoe8HFzHELCJbE0ZYF1_s-Kc-JLVYL77XJkjG0M-H2wj4uplgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROsRPNRxePdl8BAwNOaU_e_FQeSpUCehubwB3sHdb87A&oe=6B0C58A1"}, {"file_name": "com.boxingdrills.vr-20260713-162349.png", "id": "2274766600047216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908839666_2274766603380549_981932274155189057_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAk7EPDvBk0Q7kNvwH7CD9q&_nc_oc=AdrB96vZxM82BnZW_Oo5AIAYSuIPtSuS3UbY6rPstPYesOvA-8fUkQKwjUUHu_CfW_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrn2Og2g5Mr4AIgvRZXohKmcedpbvOQPoXIafEFXQGHQ&oe=6B0C573D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1685360073181699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839676_1685360076515032_9152204918650953494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OdmjPVca2oQ7kNvwEM0orD&_nc_oc=AdowWnRviTay1z-MN1_E6M__mJLIP4Rx02kLxojuWlsT9y7aXcAGiVfoaT1HcsHuRGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgCGqHuCsPoezLX_M8r9HjpKSx46TBWbSp2mY_8rXYWA&oe=6B0C60AB"}, "display_name": "Boxing Drills VR", "keywords": ["boxing", "training", "fitness", "cardio", "workout"], "long_description": "Boxing Drills VR gives you a pad holder who calls combos, throws punches back at you, and moves so you have to use your feet.\n\nI built it to train what is hard to practice alone: slipping, rolling and countering, footwork, and keeping your hands up. Soft punches don't count, and every punch is scored on power, speed and form.\n\n**What's in it**\n\n- Over 90 drills: combos, defense, reactive defense, footwork, peek-a-boo, and equipment (heavy bag, double-end bag, speed bag).\n- Defense that comes back at you: slips, ducks, rolls, weaves and pull-backs, each followed by the counter.\n- A see-through coach holds the pads, so you can see where the trainer stands.\n- Mixed reality on Quest 3 and Pro: train in your own room. Or switch to the gym, with a full ring and bags.\n- Workouts chain drills for 3 to 60 minutes, or play your own saved lists. Timed rounds add a bell and rest periods.\n- Fight mode: your training stats go up against AI opponents in narrated fights. Lose, and it tells you what to train next.\n- Personal bests for every drill and a fighter card that tracks each punch.\n- Orthodox or southpaw.\n\nUse it as a warm-up before a sparring game or as your main cardio. I'm a solo developer and update it often; recent updates added the gym, the coach and new pull-counter drills.\n\nJoin the Discord at https://discord.gg/8FyagxceKs and tell me what to build next.", "short_description": "Real boxing pad work in VR. A pad holder calls combos, throws punches back at you and moves, so you have to use your feet. Over 90 drills for combos, defense and footwork, each punch scored on power, speed and form. Train in your own room in mixed reality or in a full boxing gym. Heavy bag, double-end bag, workouts from 3 to 60 minutes, and a Fight mode that tells you what to train next. Pay once, no subscription."}, {"images": {"nodes": []}, "id": "1606606284127790", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing Drills VR", "keywords": [], "long_description": "Boxing Drills VR\uc5d0\uc11c\ub294 \ud328\ub4dc\ub97c \ub4e0 \ud2b8\ub808\uc774\ub108\uac00 \ucf64\ubcf4\ub97c \ubd88\ub7ec \uc8fc\uace0, \ud380\uce58\ub97c \ub418\ubc1b\uc544\uce58\uace0, \uacc4\uc18d \uc6c0\uc9c1\uc774\uae30 \ub54c\ubb38\uc5d0 \ubc1c\uc744 \uc368\uc57c \ud569\ub2c8\ub2e4.\n\n\ud63c\uc790\uc11c\ub294 \uc5f0\uc2b5\ud558\uae30 \uc5b4\ub824\uc6b4 \uac83\ub4e4\uc744 \ud6c8\ub828\ud558\ub824\uace0 \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \uc2ac\ub9bd, \ub864\ub9c1, \uce74\uc6b4\ud130, \ud48b\uc6cc\ud06c, \uadf8\ub9ac\uace0 \uac00\ub4dc\ub97c \uc62c\ub9b0 \ucc44 \uc720\uc9c0\ud558\uae30. \uc57d\ud55c \ud380\uce58\ub294 \uc778\uc815\ub418\uc9c0 \uc54a\uace0, \ubaa8\ub4e0 \ud380\uce58\ub294 \ud30c\uc6cc, \uc2a4\ud53c\ub4dc, \ud3fc\uc73c\ub85c \ucc44\uc810\ub429\ub2c8\ub2e4.\n\n**\ud3ec\ud568\ub41c \ub0b4\uc6a9**\n\n- 90\uac1c \uc774\uc0c1\uc758 \ub4dc\ub9b4: \ucf64\ubcf4, \ub514\ud39c\uc2a4, \ub9ac\uc561\ud2f0\ube0c, \ud48b\uc6cc\ud06c, \ud53c\uce74\ubd80, \uc7a5\ube44(\uc0cc\ub4dc\ubc31, \ub354\ube14\uc5d4\ub4dc\ubc31, \uc2a4\ud53c\ub4dc\ubc31).\n- \uc2e4\uc81c\ub85c \uacf5\uaca9\ud574 \uc624\ub294 \ub514\ud39c\uc2a4: \uc2ac\ub9bd, \ub354\ud0b9, \ub864\ub9c1, \uc704\ube59, \ud480\ubc31, \uadf8\ub9ac\uace0 \uac01\uac01 \uc774\uc5b4\uc9c0\ub294 \uce74\uc6b4\ud130.\n- \ubc18\ud22c\uba85 \ucf54\uce58\uac00 \ud328\ub4dc\ub97c \ub4e4\uace0 \uc788\uc5b4 \ud2b8\ub808\uc774\ub108\uc758 \uc704\uce58\uc640 \ubc29\ud5a5\uc744 \ubc14\ub85c \uc54c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- Quest 3\uc640 Pro\uc5d0\uc11c\ub294 \ud63c\ud569 \ud604\uc2e4 \uc9c0\uc6d0: \ub0b4 \ubc29\uc5d0\uc11c \ud6c8\ub828\ud558\uc138\uc694. \ub9c1, \uc0cc\ub4dc\ubc31, \ubcbd\uc758 \ub77c\uc6b4\ub4dc \uc2dc\uacc4\uac00 \uc788\ub294 Boxing Drills \uccb4\uc721\uad00\uc73c\ub85c \ubc14\uafc0 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc6cc\ud06c\uc544\uc6c3\uc740 \ub4dc\ub9b4\uc744 3~60\ubd84 \ub3d9\uc548 \uc774\uc5b4\uc11c \uc9c4\ud589\ud558\uba70, \uc9c1\uc811 \uc800\uc7a5\ud55c \ub9ac\uc2a4\ud2b8\ub3c4 \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub77c\uc6b4\ub4dc\uc81c\ub97c \ucf1c\uba74 \uc885\uc18c\ub9ac\uc640 \ud734\uc2dd \uc2dc\uac04\uc774 \ucd94\uac00\ub429\ub2c8\ub2e4.\n- \ub300\uc804 \ubaa8\ub4dc: \ud6c8\ub828\uc73c\ub85c \uc313\uc740 \ub2a5\ub825\uce58\ub85c AI \uc0c1\ub300\uc640 \uc911\uacc4\uc2dd \ub300\uc804\uc744 \ud3bc\uce69\ub2c8\ub2e4. \uc9c0\uba74 \ub2e4\uc74c\uc5d0 \ubb34\uc5c7\uc744 \ud6c8\ub828\ud560\uc9c0 \uc54c\ub824 \uc90d\ub2c8\ub2e4.\n- \ub4dc\ub9b4\ubcc4 \uac1c\uc778 \ucd5c\uace0 \uae30\ub85d\uacfc \ud380\uce58\ubcc4\ub85c \uae30\ub85d\ud558\ub294 \ud30c\uc774\ud130 \uce74\ub4dc.\n- \uc624\uc18c\ub3c5\uc2a4\uc640 \uc0ac\uc6b0\uc2a4\ud3ec \uc9c0\uc6d0.\n\n\uc2a4\ud30c\ub9c1 \uac8c\uc784 \uc804 \uc6cc\ubc0d\uc5c5\uc73c\ub85c\ub3c4, \uba54\uc778 \uc720\uc0b0\uc18c \uc6b4\ub3d9\uc73c\ub85c\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4. 1\uc778 \uac1c\ubc1c\uc790\ub85c\uc11c \uc790\uc8fc \uc5c5\ub370\uc774\ud2b8\ud558\uace0 \uc788\uc73c\uba70, \ucd5c\uadfc \uc5c5\ub370\uc774\ud2b8\uc5d0\uc11c \uccb4\uc721\uad00, \ucf54\uce58, \ud480\ubc31 \uce74\uc6b4\ud130 \ub4dc\ub9b4\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.\n\nDiscord\uc5d0 \ucc38\uc5ec\ud574 \ub2e4\uc74c\uc5d0 \ub9cc\ub4e4 \uac83\uc744 \uc54c\ub824 \uc8fc\uc138\uc694: https://discord.gg/8FyagxceKs", "short_description": "VR\uc5d0\uc11c \ud558\ub294 \uc9c4\uc9dc \ubcf5\uc2f1 \ud328\ub4dc \ud6c8\ub828. \ucf64\ubcf4, \ub514\ud39c\uc2a4, \ud48b\uc6cc\ud06c \ub4dc\ub9b4 90\uac1c \uc774\uc0c1\uc744 \ub0b4 \ubc29\uc774\ub098 \uc81c\ub300\ub85c \uac16\ucd98 \uccb4\uc721\uad00\uc5d0\uc11c."}, {"images": {"nodes": []}, "id": "1430463825665836", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing Drills VR", "keywords": [], "long_description": "Boxing Drills VR te da un entrenador con manoplas que canta combos, te devuelve golpes y se mueve para que tengas que usar los pies.\n\nLo hice para entrenar lo que cuesta practicar solo: esquivar, rodar y contraatacar, el juego de pies y mantener las manos arriba. Los golpes flojos no cuentan, y cada golpe se punt\u00faa por potencia, velocidad y t\u00e9cnica.\n\n**Qu\u00e9 incluye**\n\n- M\u00e1s de 90 ejercicios: combos, defensa, defensa reactiva, juego de pies, peek-a-boo y equipamiento (saco pesado, saco de doble extremo, pera r\u00e1pida).\n- Defensa que te ataca de verdad: esquivas, agachadas, rodadas, balanceos y echarse atr\u00e1s, cada uno seguido del contragolpe.\n- Un entrenador transl\u00facido sostiene las manoplas, as\u00ed ves d\u00f3nde est\u00e1.\n- Realidad mixta en Quest 3 y Pro: entrena en tu propia habitaci\u00f3n. O cambia al gimnasio, con ring completo y sacos.\n- Las rutinas encadenan ejercicios de 3 a 60 minutos, o usa tus propias listas.\n- Modo combate: tus estad\u00edsticas de entrenamiento se enfrentan a rivales de IA en combates narrados. Si pierdes, te dice qu\u00e9 entrenar.\n- R\u00e9cords personales en cada ejercicio.\n- Postura diestra o zurda.\n\n\u00dasalo como calentamiento antes de un juego de sparring o como tu cardio principal. Soy un desarrollador independiente y actualizo a menudo; las \u00faltimas versiones a\u00f1adieron el gimnasio y el entrenador.\n\n\u00danete al Discord en https://discord.gg/8FyagxceKs y cu\u00e9ntame qu\u00e9 hacer despu\u00e9s.", "short_description": "Trabajo de manoplas de boxeo real en VR: m\u00e1s de 90 ejercicios de combos, defensa y juego de pies, en tu habitaci\u00f3n o en un gimnasio completo."}, {"images": {"nodes": []}, "id": "1125510043689958", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing Drills VR", "keywords": [], "long_description": "\u0412 Boxing Drills VR \u0442\u0440\u0435\u043d\u0435\u0440 \u0441 \u043b\u0430\u043f\u0430\u043c\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438, \u0431\u044c\u0451\u0442 \u0432 \u043e\u0442\u0432\u0435\u0442 \u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044f, \u0442\u0430\u043a \u0447\u0442\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043d\u043e\u0433\u0430\u043c\u0438.\n\n\u042f \u0441\u0434\u0435\u043b\u0430\u043b \u0438\u0433\u0440\u0443, \u0447\u0442\u043e\u0431\u044b \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u0441\u043b\u043e\u0436\u043d\u043e \u043e\u0442\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u0432 \u043e\u0434\u0438\u043d\u043e\u0447\u043a\u0443: \u0443\u043a\u043b\u043e\u043d\u044b, \u0440\u043e\u043b\u043b\u044b \u0438 \u043a\u043e\u043d\u0442\u0440\u0430\u0442\u0430\u043a\u0438, \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u043e\u0433 \u0438 \u0440\u0443\u043a\u0438 \u0443 \u043f\u043e\u0434\u0431\u043e\u0440\u043e\u0434\u043a\u0430. \u0421\u043b\u0430\u0431\u044b\u0435 \u0443\u0434\u0430\u0440\u044b \u043d\u0435 \u0437\u0430\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f, \u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0443\u0434\u0430\u0440 \u043e\u0446\u0435\u043d\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u0441\u0438\u043b\u0435, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0438 \u0442\u0435\u0445\u043d\u0438\u043a\u0435.\n\n**\u0427\u0442\u043e \u0432\u043d\u0443\u0442\u0440\u0438**\n\n- \u0411\u043e\u043b\u0435\u0435 90 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439: \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438, \u0437\u0430\u0449\u0438\u0442\u0430, \u0440\u0435\u0430\u043a\u0446\u0438\u044f, \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u043e\u0433, \u043f\u0438\u043a\u0430\u0431\u0443 \u0438 \u0441\u043d\u0430\u0440\u044f\u0434\u044b (\u043c\u0435\u0448\u043e\u043a, \u043f\u043d\u0435\u0432\u043c\u043e\u0433\u0440\u0443\u0448\u0430 \u043d\u0430 \u0440\u0430\u0441\u0442\u044f\u0436\u043a\u0430\u0445, \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u043d\u0430\u044f \u0433\u0440\u0443\u0448\u0430).\n- \u0417\u0430\u0449\u0438\u0442\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u043e \u0432\u0430\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0431\u044c\u044e\u0442: \u0443\u043a\u043b\u043e\u043d\u044b, \u043d\u044b\u0440\u043a\u0438, \u0440\u043e\u043b\u043b\u044b, \u0441\u043b\u0438\u043f-\u0440\u043e\u043b\u043b\u044b \u0438 \u043e\u0442\u043a\u043b\u043e\u043d\u044b \u043d\u0430\u0437\u0430\u0434, \u0438 \u043f\u043e\u0441\u043b\u0435 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u2014 \u043a\u043e\u043d\u0442\u0440\u0443\u0434\u0430\u0440.\n- \u041f\u043e\u043b\u0443\u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u0439 \u0442\u0440\u0435\u043d\u0435\u0440 \u0434\u0435\u0440\u0436\u0438\u0442 \u043b\u0430\u043f\u044b, \u0442\u0430\u043a \u0447\u0442\u043e \u0432\u0438\u0434\u043d\u043e, \u0433\u0434\u0435 \u043e\u043d \u0441\u0442\u043e\u0438\u0442.\n- \u0421\u043c\u0435\u0448\u0430\u043d\u043d\u0430\u044f \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043d\u0430 Quest 3 \u0438 Pro: \u0442\u0440\u0435\u043d\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044c \u0432 \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435. \u0418\u043b\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u0432 \u0437\u0430\u043b \u0441 \u0440\u0438\u043d\u0433\u043e\u043c \u0438 \u043c\u0435\u0448\u043a\u0430\u043c\u0438.\n- \u0412\u043e\u0440\u043a\u0430\u0443\u0442\u044b \u0441\u0432\u044f\u0437\u044b\u0432\u0430\u044e\u0442 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u044f \u043d\u0430 3\u201360 \u043c\u0438\u043d\u0443\u0442, \u043c\u043e\u0436\u043d\u043e \u0438\u0433\u0440\u0430\u0442\u044c \u0438 \u0441\u0432\u043e\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0441\u043f\u0438\u0441\u043a\u0438.\n- \u0420\u0435\u0436\u0438\u043c \u0431\u043e\u044f: \u0432\u0430\u0448\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0438\u0437 \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043e\u043a \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u043f\u0440\u043e\u0442\u0438\u0432 \u0418\u0418-\u0441\u043e\u043f\u0435\u0440\u043d\u0438\u043a\u043e\u0432 \u0432 \u0431\u043e\u044f\u0445 \u0441 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u043c. \u041f\u0440\u043e\u0438\u0433\u0440\u0430\u043b\u0438 \u2014 \u0438\u0433\u0440\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0436\u0435\u0442, \u0447\u0442\u043e \u043f\u043e\u0434\u0442\u044f\u043d\u0443\u0442\u044c.\n- \u041b\u0438\u0447\u043d\u044b\u0435 \u0440\u0435\u043a\u043e\u0440\u0434\u044b \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0438 \u0438 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0431\u043e\u0439\u0446\u0430 \u0441\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u043e\u0439 \u043f\u043e \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0443\u0434\u0430\u0440\u0443.\n- \u0421\u0442\u043e\u0439\u043a\u0430 \u043f\u0440\u0430\u0432\u0448\u0438 \u0438\u043b\u0438 \u043b\u0435\u0432\u0448\u0438.\n\n\u041f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u043a\u0430\u043a \u0440\u0430\u0437\u043c\u0438\u043d\u043a\u0430 \u043f\u0435\u0440\u0435\u0434 \u0438\u0433\u0440\u043e\u0439 \u0441\u043e \u0441\u043f\u0430\u0440\u0440\u0438\u043d\u0433\u043e\u043c \u0438\u043b\u0438 \u043a\u0430\u043a \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0435 \u043a\u0430\u0440\u0434\u0438\u043e. \u042f \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e \u0438\u0433\u0440\u0443 \u043e\u0434\u0438\u043d \u0438 \u0447\u0430\u0441\u0442\u043e \u0435\u0451 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u044e; \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f\u0445 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0437\u0430\u043b \u0438 \u0442\u0440\u0435\u043d\u0435\u0440.\n\n\u0417\u0430\u0445\u043e\u0434\u0438\u0442\u0435 \u0432 Discord: https://discord.gg/8FyagxceKs \u2014 \u0440\u0430\u0441\u0441\u043a\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435.", "short_description": "\u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u043d\u0430 \u043b\u0430\u043f\u0430\u0445 \u0432 VR: \u0431\u043e\u043b\u0435\u0435 90 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0439 \u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u0438, \u0437\u0430\u0449\u0438\u0442\u0443 \u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u043e\u0433 \u2014 \u0432 \u0441\u0432\u043e\u0435\u0439 \u043a\u043e\u043c\u043d\u0430\u0442\u0435 \u0438\u043b\u0438 \u0432 \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u043e\u043c \u0437\u0430\u043b\u0435."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wobble-bot-games.gitlab.io/boxing-drills/privacy.html", "developer_terms_of_service_url": "https://wobble-bot-games.gitlab.io/boxing-drill/terms.html", "publisher_name": "Wobble Bot Games", "support_website_url": "https://discord.gg/7vbXrqzg", "website_url": "https://wobble-bot-games.gitlab.io/boxing-drills/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
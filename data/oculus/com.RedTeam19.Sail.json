5_609131555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPyPVXKU-rcQ7kNvwHAEGES&_nc_oc=AdqNayuhu7V_8Dnd2RSbRvxbCNXC44asS7cc8uBNywjIwOY3_SYo84eK_VQX1wQJHIk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-R6-eUI05l1Y8x2Hy-LpltGkGAyEre3sL6VG0kajKog&oe=6A22C9A3"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcVZu-DH9QUQ7kNvwGEG57e&_nc_oc=AdqvkxERmvDGJ1e8ksjzzEqq8S-GS-2oFPi1jOyuywbbFOD-iTHwRJ1Gy72d8huVFBc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BDxF26WH_kupo27DgOtUUR-YslmfSwTF1sq-dq7_8HQ&oe=6A22DDAB"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLzBLQq2rqUQ7kNvwE5CNnV&_nc_oc=AdqEsVs5THtnA96WbHFrlCM_stxA8XMBy5YH7NtVBaR8y39k39brFjZvsFhzmxaMD3Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9f-4rREKnGDYTeMI9Ptc64lltt-uRJMlQjzgllNNrLwg&oe=6A22EFF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "826526230500945", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618937_826526233834278_4877506229914171446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3kNjstC54QQ7kNvwHPgAcK&_nc_oc=AdoxBbVrfY1F1VXTpti-xaa1MfKsMEWe1jh2D7YBZpktmcV-mg5r_LZr1uKojYg-ofM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PFqeF6z-xX0bZg0BfA6knaJXZnq4uSXNQXIZOjfSnyA&oe=6A22EA0B"}, "display_name": "Sail", "keywords": ["Pirate", "Multiplayer", "Naval", "Adventure", "Sailing"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set sail on the open seas \u2014 FREE to play \ud83c\udff4\u200d\u2620\ufe0f**\n\nSAIL is an open-world multiplayer VR pirate adventure inspired by **Sea of Thieves** and **Assassin's Creed: Black Flag**. Build your crew, claim your ship, and carve your name into the ocean.\n\n---\n\n## \u2693 Patron Port is NOW LIVE\n\n{1332042141635457}\n\n---\n\n# \ud83c\udff4\u200d\u2620\ufe0f What Awaits You on the Seas...\n\n# \u2694\ufe0f Combat:\n- **Ship-to-ship PvP battles** \u2014 board, blast, and plunder\n- **Skeleton Raids** to repel from your vessel (PvE)\n- **Epic Boss Battles** on the open water\n\n# \ud83d\udcb0 Adventure:\n- **Treasure Hunting** across uncharted islands\n- **Deep Lore** to uncover as you explore\n- **Extraction Gameplay** \u2014 get in, get loot, get out alive\n\n{1170618048462420}\n\n# \ud83c\udfad Your Crew, Your Legend:\n- **Full Player & Ship Customization**\n- **XP & Leveling** system\n- **Instruments** to Play Sea Shanties\n- **Social Lobbies** to meet and recruit fellow pirates\n\n{1283715443028532}\n\nMore content is on the way. The seas keep growing.\n\n{773360738895747}\n\n---\n\n## Arrrr You Ready to Set SAIL? \u2693\n\n{1456646078947213}\n\n---\n\n> \u26a0\ufe0f Early Access Notice: \u26a0\ufe0f \n> SAIL is currently in Early Access. You may encounter bugs as we build.\n> Your feedback directly shapes the game \u2014 join our community and let us know what you want to see next.", "short_description": "Sail the seas with friends in this FREE multiplayer VR Pirate Game! \ud83c\udff4\u200d\u2620\ufe0f\n\nBattle enemy ships, board vessels, loot cargo, and claim the ocean as your own. VR ship physics let you man the sails, fire cannons, and feel the waves all with your hands. \n\nGather your crew, set a course, and become the most feared pirates in VR \u2693\ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfor
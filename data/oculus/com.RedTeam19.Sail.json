hc=JmLdXqZ8Xn0Q7kNvwGcEuOo&_nc_oc=AdrLq7CUCvh6Zpkerjt8OnEJyMNAGOwFPELiICQNRTAZBlVChfwfnVOkoCCNj_yJP8A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-0ezDupvXr-BrW9KT65Fc08PAEk-HelZf0zW_ltdMLg&oe=6A355972"}, "display_name": "Sail - Early Access", "keywords": [], "long_description": "UNLEASH your Inner Pirate in SAIL the Open World VR Pirate game!!!\n\nEarn your Pirate reputation through EPIC voyages where you'll test yourself by collecting as much treasure as possible and bringing it back safely to your Pirate hideout.\n\nBUT BE WARNED . . .\n\nYou're not the only Pirate seeking fortune on the seas.\n\nFight off Pirate enemies on land with your Pirate weapon of choice\n\n- OR -\n\nBattle them on the seas using your ship's cannons and VOICE COMMANDS!\n\nPut your plunder to good use and use your riches to equip yourself with the best weapons and ships a Pirate could ask for.\n\nWith an Open World filled with Treasure, Mysterious Islands and limitless possibilities there's only one question to ask . . .\n\nArrrrgh you ready to set SAIL ???\n\nPLEASE NOTE: This is game is Early Access so it is not perfect and still a work in progress. We appreciate any and all feedback so leave it in a review or JOIN THE DISCORD and let us know there!\n\nTHANK YOU FOR SUPPORTING SAIL!!!", "short_description": "Unleash your Inner Pirate!!!! - Open World VR Pirate Game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://garett-cook.com/index.php/sail-early-access-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Red Team Nineteen", "support_website_url": null, "website_url": "https://www.garett-cook.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "
25_609131555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6oewnm1N3cQ7kNvwFwExMw&_nc_oc=Adpw2LS_RhuEy0yWNwnea9hO9tMGcNOGGlcx7ub5Gh9QaEpJrgjsI94u96qO6EXVfBg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QdZ8Ts18RozZOIHmubJ56dr6H8H7G-dSvD9Af92-Ugg&oe=6A11A623"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBQwbe_SsiYQ7kNvwH6Jw0_&_nc_oc=AdqJiSqNhb1UfUFKwNOFl3CijIO93fMOoHq5jJbAPHxVaungOBbPbIVGHmTV2Yl4eS4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tjSKUYXwcVHoROG6gfgHMk2p_4xHJ_iMINuMDItJCgw&oe=6A11BA2B"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXusHWmVGbYQ7kNvwGI2t5a&_nc_oc=AdoI9u9rUZjV5mXFmCXut9n0SBhWckJKidZTOpefcD6ZU2i3Q4kwdAN6W1yfXDc6L5g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79v4cwEzMx96Lg9Fo3N-iHmLQRF3rQl4td7ZWYtm_cvA&oe=6A11CC72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "826526230500945", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618937_826526233834278_4877506229914171446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGADtTb_b3gQ7kNvwE7bc2Q&_nc_oc=AdpPYtuNC1mLMEasHy9cGDrBRbW0MqnoUqpC2_-DztHc1iG4C8RXW-GdbxCxG_bGHLQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H7LW6DbZsjAvzVya9o75g681HOAUWtwPI04ZAPlMcug&oe=6A11C68B"}, "display_name": "Sail", "keywords": ["Pirate", "Pirates", "Sailing", "Ship", "Ships"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set Sail**\ud83c\udff4\u200d\u2620\ufe0f \n\nSail is an open world, multiplayer, VR pirate adventure game inspired by games like Sea of Thieves & Assassin's Creed Black Flag. \n\n# Christmas Update \ud83c\udf84\n\n{1332042141635457}\n\n**\u2b50Current Features Include\u2b50**\n\n- Treasure Hunting\n{1170618048462420}\n- Pirate & Ship Combat (PvP)\n- Skeleton Raids (PvE)\n- Boss Battles \n- Sea Shanties\n{1283715443028532}\n- Social Lobbies\n- Player Customization\n- Ship Customization\n- XP & Leveling\n-  LORE \n- Exploration\n- Extraction Gameplay\n\n{773360738895747}\n\nWith all these features and more on the way there's only one question left to ask. . .\n\n# Arghhhh you ready to Set SAIL???? \n\n{1456646078947213}\n\n**\u26a0\ufe0fWARNING\u26a0\ufe0f**  \n**Sail is in Early Access / Beta, and may contain bugs** \n", "short_description": "Be a Pirate in VR!!! \ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26681885211418756"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303788_4478997905668055_15334635135
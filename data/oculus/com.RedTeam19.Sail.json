125_609131555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJbAAwceK-8Q7kNvwFlzuK8&_nc_oc=AdoMokC-3Aj2_OcQHoZn5UN9Ftfw1CwGJYA8cQMPNUBwGVqUNsJLtBQuLYNJWWoPuUk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sA8Cs3cd8OparDB1h1jxMkzuWrYsACRWPZGOo-A1wtw&oe=6A393323"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64qYnXqqvQ8Q7kNvwFRu6eG&_nc_oc=AdriCAn3DJRQqFRExnrnhdRtbo7kgcaPX0yyVxziyhRlTbbmviIA1h5EisCB2YsHJGw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B6vQ8Ox4ZRGegTxngMkRHJJD0Oabl0y87ckh4RN5k_A&oe=6A39472B"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQonW-aRuJcQ7kNvwG143VE&_nc_oc=Adr2hUzFcKn9WLd_b70uWCT1LOEkCQsHzrCpHm7svdhilQPn_8J2wXrQb2gUPo36_Rg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RCai8ml74ZvTACDa1G06m5hkfZliYzBmL9r-aYX_I1w&oe=6A395972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "826526230500945", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618937_826526233834278_4877506229914171446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aceWryjOHbAQ7kNvwECybec&_nc_oc=AdpVG1aLNmY9Gk-wVzhgQ9D0tTcQ61JGL0UobsD9UMnKvRjdarYhhrbpehBkGwxnbuk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GGOrd_Xov-kYjwRfMxGiAgCwkwo5YZJc7sR0oGi5sXA&oe=6A39538B"}, "display_name": "Sail", "keywords": ["Pirate", "Multiplayer", "Naval", "Adventure", "Sailing"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set sail on the open seas \u2014 FREE to play \ud83c\udff4\u200d\u2620\ufe0f**\n\nSAIL is an open-world multiplayer VR pirate adventure inspired by **Sea of Thieves** and **Assassin's Creed: Black Flag**. Build your crew, claim your ship, and carve your name into the ocean.\n\n---\n\n## \u2693 Patron Port is NOW LIVE\n\n{1332042141635457}\n\n---\n\n# \ud83c\udff4\u200d\u2620\ufe0f What Awaits You on the Seas...\n\n# \u2694\ufe0f Combat:\n- **Ship-to-ship PvP battles** \u2014 board, blast, and plunder\n- **Skeleton Raids** to repel from your vessel (PvE)\n- **Epic Boss Battles** on the open water\n\n# \ud83d\udcb0 Adventure:\n- **Treasure Hunting** across uncharted islands\n- **Deep Lore** to uncover as you explore\n- **Extraction Gameplay** \u2014 get in, get loot, get out alive\n\n{1170618048462420}\n\n# \ud83c\udfad Your Crew, Your Legend:\n- **Full Player & Ship Customization**\n- **XP & Leveling** system\n- **Instruments** to Play Sea Shanties\n- **Social Lobbies** to meet and recruit fellow pirates\n\n{1283715443028532}\n\nMore content is on the way. The seas keep growing.\n\n{773360738895747}\n\n---\n\n## Arrrr You Ready to Set SAIL? \u2693\n\n{1456646078947213}\n\n---\n\n> \u26a0\ufe0f Early Access Notice: \u26a0\ufe0f \n> SAIL is currently in Early Access. You may encounter bugs as we build.\n> Your feedback directly shapes the game \u2014 join our community and let us know what you want to see next.", "short_description": "Sail the seas with friends in this FREE multiplayer VR Pirate Game! \ud83c\udff4\u200d\u2620\ufe0f\n\nBattle enemy ships, board vessels, loot cargo, and claim the ocean as your own. VR ship physics let you man the sails, fire cannons, and feel the waves all with your hands. \n\nGather your crew, set a course, and become the most feared pirates in VR \u2693\ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comf
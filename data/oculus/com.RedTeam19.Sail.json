": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308125_609131555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOHrUvYHAw0Q7kNvwHhsbzi&_nc_oc=AdoQrZWTeo5tbv6VReQT1BvAK4tQjMBOG0a_bs6TCoKGdakRWESkzV5SHwd1UggTN3w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFB7vN2v8rW2WEMU8lcSLkQsq5CSKmsr1p1HEbgskh2AA&oe=6A8EE4A3"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qqJxIPZYpsQ7kNvwG7qtRv&_nc_oc=AdpDes2b-HDf0nwifgumyoYRhAnjx3TIPdK_XO1FQL9-2ia9-DP-9zIrHAvhCOUpgO4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFswzr3Lhhdq7-HtEaGuWkQX_zel1sb9VljCIZYqx0bng&oe=6A8EC06B"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-2wsE-0ZwQQ7kNvwHvFu_y&_nc_oc=Adr38l-EBh864ROb86394MqTgdMVktkWJawjTer8rxapB5SyzWIYcIgmXdfRZ9MX9CQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyNQe9X8yDS92SXdhh3j2R6zPL01NPX1FNbf0knuBDVg&oe=6A8ED2B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SAilIslandLogo.png", "id": "1307391944441905", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619187_1307391947775238_5153960406717874774_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL5hRBGlyr8Q7kNvwE_cIjg&_nc_oc=AdpkmeMMe8VuyAIfBXYXWXUqtF_6_K8ouRTEtCsYaYfv1igMC3JHbMCgYZ4MRgzR2yU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLO50n-5PhsFkVaNXcq9u_DksWcSWTgE2MPFse_uXT4Q&oe=6A8EC29E"}, "display_name": "Sail", "keywords": ["Pirate", "Multiplayer", "Naval", "Adventure", "Sailing"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR                                                                                                                                                                  \n                                                                  \n## \u2694\ufe0f Battle & Plunder\n{1560969675610503}\n\n## \u2693 Explore the Open Sea\n{858020146960437}\n\n## \ud83e\udd91 Face Deadly Bosses\n{1035522782766350}\n## \ud83d\udcb0 Hunt for Treasure\nSearch uncharted islands, uncover lore, and extract with your riches before it\u2019s too late.\n{1170618048462420}\n## \ud83c\udfb5 Live the Pirate Life\nCustomize your pirate and ship, level up, play sea shanties, and meet your next crew in social lobbies.\n{1740473164035436}\n## Arrr You Ready to SAIL? \ud83c\udff4\u200d\u2620\ufe0f\n{1421221693174209}\n\n> \u26a0\ufe0f Early Access Notice  \n> SAIL is still in Early Access. Bugs may happen while we build.  \n> Your feedback helps shape the game \u2014 join the community and tell us what you want to see next.\n", "short_description": "Sail the seas with friends in this FREE multiplayer VR Pirate Game! \ud83c\udff4\u200d\u2620\ufe0f\n\nBattle enemy ships, board vessels, loot cargo, and claim the ocean as your own. VR ship physics let you man the sails, fire cannons, and feel the waves all with your hands. \n\nGather your crew, set a course, and become the most feared pirates in VR \u2693\ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads
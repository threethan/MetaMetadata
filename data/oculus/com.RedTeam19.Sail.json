1555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdHxPM_nbaUQ7kNvwHrH0cl&_nc_oc=Adrj82yhYa5f36UkGIEPrO5HRNVsfpspVmrv4dxdNqggWdVWhOVm0-7RZFqz5Tt6gfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lbr0wsVEQJdy4BvuWkaS6N_vysUdTC2Sj6HDxcjQ_KA&oe=69DE3BA3"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxb_qxT66H8Q7kNvwGR8QVH&_nc_oc=AdpzT3oSne9ICuADD2O0GXyZWaUMbrEFqOBBpZerAp11-Q65F9RSh46qI3kj9ACroVw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pkxdLnxyhHlUGEFz4Xx83hVL64oO1_VsTMJx7ihoTGA&oe=69DE4FAB"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM1b6RH8m9sQ7kNvwG_sXoU&_nc_oc=Adpyp_1mlQTLYJotowz8hN5tmxyZ2zJTvvqHtpeuyhBaGRzM2D4vnfOZqYa5wa8x4Bg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xznADvJj8J3PaeE438uaF8GOhf-DkfxTJjGAUz4NSxw&oe=69DE29B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "826526230500945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618937_826526233834278_4877506229914171446_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSW6iWWWxvAQ7kNvwH3eeKk&_nc_oc=AdrP5vs9B0valDvKStj55mwPk-AxtI7wP3pq_B-ZnXXO-kxG2N__78AbU5x1MIZQ-Bs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zV0BrzHkUAL95_u_6qQhIgJ889ceP6kILPXhUYjgOdg&oe=69DE23CB"}, "display_name": "Sail", "keywords": ["Pirate", "Pirates", "Sailing", "Ship", "Ships"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set Sail**\ud83c\udff4\u200d\u2620\ufe0f \n\nSail is an open world, multiplayer, VR pirate adventure game inspired by games like Sea of Thieves & Assassin's Creed Black Flag. \n\n# Christmas Update \ud83c\udf84\n\n{1332042141635457}\n\n**\u2b50Current Features Include\u2b50**\n\n- Treasure Hunting\n{1170618048462420}\n- Pirate & Ship Combat (PvP)\n- Skeleton Raids (PvE)\n- Boss Battles \n- Sea Shanties\n{1283715443028532}\n- Social Lobbies\n- Player Customization\n- Ship Customization\n- XP & Leveling\n-  LORE \n- Exploration\n- Extraction Gameplay\n\n{773360738895747}\n\nWith all these features and more on the way there's only one question left to ask. . .\n\n# Arghhhh you ready to Set SAIL???? \n\n{1456646078947213}\n\n**\u26a0\ufe0fWARNING\u26a0\ufe0f**  \n**Sail is in Early Access / Beta, and may contain bugs** \n", "short_description": "Be a Pirate in VR!!! \ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26681885211418756"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303788_4478997905668055_1533463513511275150_n.
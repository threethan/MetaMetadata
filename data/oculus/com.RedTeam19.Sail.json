5/499308125_609131555465984_1460247819698086669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLUUyMWWP1EQ7kNvwEWySAM&_nc_oc=AdqnZKVG_AU8fZ1xphV4vxQp4gev4dpauyTbSxn3Y5wZ8RI96mQ7E1vzzRi9tM-2GjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxefz_t1vH7tl03Ag7ud7TSJBIjd3NiQ7R9fZhpABdQLQ&oe=69CD1823"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_e4MhfxljUQ7kNvwGRwhlp&_nc_oc=AdpS7ByMctg8pzPZPCRyLNDGY0rK0CJ1oMUWc-MqLbqmz-rYMkVvMsOx5sA06yMmhXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJPZQgGJnQAh2k3vXuYLp1jjWS8xaTmklx3LiNl_M0kQ&oe=69CD2C2B"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGxt6B8lwgAQ7kNvwFDzyIV&_nc_oc=AdqqMDBi6VMGPnGZL2QdpLCWGBxOQviYyk86aWY3CX373hm7JWgOIdGZ6WcymPR3IMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5zTTukn7hXNhVRnVEIFvMuhcBNDzQmpa0CxQXQbtLnA&oe=69CD0632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "1390320635934409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823893_1390320639267742_6177024045408619745_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jGDS0G_R74Q7kNvwEzoBvL&_nc_oc=AdqiWpjm6oQ40uk6G2HZ4OfJzw5x63D9wtk3ew_Y3IPMPdph4km0bveCYkUhX4vld-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV1boYLH6xP25wlf2OcH3506zy_0IVijdpCM8BDUgvQA&oe=69CD2234"}, "display_name": "Sail", "keywords": ["Pirate", "Pirates", "Sailing", "Ship", "Ships"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set Sail**\ud83c\udff4\u200d\u2620\ufe0f \n\nSail is an open world, multiplayer, VR pirate adventure game inspired by games like Sea of Thieves & Assassin's Creed Black Flag. \n\n# Christmas Update \ud83c\udf84\n\n{1332042141635457}\n\n**\u2b50Current Features Include\u2b50**\n\n- Treasure Hunting\n{1170618048462420}\n- Pirate & Ship Combat (PvP)\n- Skeleton Raids (PvE)\n- Boss Battles \n- Sea Shanties\n{1283715443028532}\n- Social Lobbies\n- Player Customization\n- Ship Customization\n- XP & Leveling\n-  LORE \n- Exploration\n- Extraction Gameplay\n\n{773360738895747}\n\nWith all these features and more on the way there's only one question left to ask. . .\n\n# Arghhhh you ready to Set SAIL???? \n\n{1456646078947213}\n\n**\u26a0\ufe0fWARNING\u26a0\ufe0f**  \n**Sail is in Early Access / Beta, and may contain bugs** \n", "short_description": "Be a Pirate in VR!!! \ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25886334944307124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619715_1553898942500276_966
 & Leveling\n-  LORE \n- Exploration\n- Extraction Gameplay\n\n{773360738895747}\n\nWith all these features and more on the way there's only one question left to ask. . .\n\n# Arghhhh you ready to Set SAIL???? \n\n{1456646078947213}\n\n**\u26a0\ufe0fWARNING\u26a0\ufe0f**  \n**Sail is in Early Access / Beta, and may contain bugs** \n", "short_description": "Be a Pirate in VR!!! \ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25886334944307124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619715_1553898942500276_966139878429673319_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb-XXCDXhzsQ7kNvwGYZ_Iw&_nc_oc=AdkyFB12ubn9YRdH7c6VUoT_QvNrqntWpt-2aOSl8AeZhWhojYpx9DS6z37-8m5XC6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFPw1SNEF_1yd5kgdERz3VEAB42gGt7iqp7XD5TX_Cfw&oe=6999B4AD"}, "is_concept": false, "is_test": false, 
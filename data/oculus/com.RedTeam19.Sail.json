6-cIA-pMjF0vlEo4yEPC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyk8-pJW8DNs1JpA4UVS8ytIut3iXS1D1k25OyUxHWzkw&oe=69B80023"}, {"file_name": "1.png", "id": "1293878032177449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618065_1293878035510782_7781895256023375641_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyYJtiAneUkQ7kNvwHdW8-i&_nc_oc=Adl0_25HOyeAb2Vad4gAWD9BjXqrO7gzsUxyCGwWSIKGOnboK7x1mHe_yRfMinED3dY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIXu7NqL1oABnD_QU3Gai1LbB017A7es7RmWj24NUIUA&oe=69B8142B"}, {"file_name": "3.png", "id": "1117273586497197", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305396_1117273589830530_3023839716642366378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4x53F25emIQ7kNvwGJp2nd&_nc_oc=AdnOpefGN5EoDONBkHczAP2RhEP3KVMW0bQivBCTqRwSDaYVXij9vkMxZJFxca-vxNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxcD7juO2eoegekOax9Oq4ClFVZEpRvMS0y1HNPKMmjWw&oe=69B7EE32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "3.png", "id": "1390320635934409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_1390320639267742_6177024045408619745_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNirGW10BqMQ7kNvwEQSlWl&_nc_oc=Adn1-5kBELwSUnw1acM9HoEESRozytYfJTavJGP-gdKwaSYYza-aCuKY8iDOCVuPkyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBqakbLySaMTxTapDXHZ9cHgnXKZUceOHUBvvXZAzaYg&oe=69B80A34"}, "display_name": "Sail", "keywords": ["Pirate", "Pirates", "Sailing", "Ship", "Ships"], "long_description": "# \ud83c\udff4\u200d\u2620\ufe0f SAIL VR\n\n**Rally your crew and set Sail**\ud83c\udff4\u200d\u2620\ufe0f \n\nSail is an open world, multiplayer, VR pirate adventure game inspired by games like Sea of Thieves & Assassin's Creed Black Flag. \n\n# Christmas Update \ud83c\udf84\n\n{1332042141635457}\n\n**\u2b50Current Features Include\u2b50**\n\n- Treasure Hunting\n{1170618048462420}\n- Pirate & Ship Combat (PvP)\n- Skeleton Raids (PvE)\n- Boss Battles \n- Sea Shanties\n{1283715443028532}\n- Social Lobbies\n- Player Customization\n- Ship Customization\n- XP & Leveling\n-  LORE \n- Exploration\n- Extraction Gameplay\n\n{773360738895747}\n\nWith all these features and more on the way there's only one question left to ask. . .\n\n# Arghhhh you ready to Set SAIL???? \n\n{1456646078947213}\n\n**\u26a0\ufe0fWARNING\u26a0\ufe0f**  \n**Sail is in Early Access / Beta, and may contain bugs** \n", "short_description": "Be a Pirate in VR!!! \ud83c\udff4\u200d\u2620\ufe0f"}]}, "developer_name": "Red Team Interactive Inc. ", "developer_privacy_policy_url": "https://www.sail-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Red Team Interactive Inc. ", "support_website_url": null, "website_url": "https://www.sail-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25886334944307124"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619715_1553898942500276_966139878429673319_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TSLpqfvnQsQ7kNvwFYBfYq&_nc_oc=Adm_R4fhJEjW0WBFxQeBYlWjXUH-GpXP9EaiwEAHk50sxECV4c8DGmboigXdea4VaB8&_nc_z
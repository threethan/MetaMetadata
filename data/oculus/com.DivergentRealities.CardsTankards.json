204203_1.png", "id": "420374842590991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974514_420374845924324_2837600827253964282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mNmx4oirmEQ7kNvwEtDgys&_nc_oc=AdqDBYRikawCHWPQaVus7uUeuCuFgKWhpA8kf2rzw9BBZ_ZmcsvsudIiDr-CXLSCr_A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eqDv-osFrgYoNfXAX723wfqDwQGHhW-cDnc3RUQKOHw&oe=6A242EAC"}, {"file_name": "1506850_20210222204107_2.png", "id": "269433197917317", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75196228_269433201250650_6450224956633597002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgDLwDbTmx0Q7kNvwElLZd5&_nc_oc=AdpgQPh5yUmEYmSq-SZzDInWMtk1bAofmw5KEcyicuWp4ZOIrh8AhTMcdLjWXzBj7gE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mo3JfuUJ6qV-LZz47d6RthnenFQ3Xp5GlqHu_pQa0cQ&oe=6A24315C"}, {"file_name": "1506850_20210222204051_1.png", "id": "238318264595321", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031446_238318267928654_1000690690028987762_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWZK608KGLoQ7kNvwFNORqa&_nc_oc=AdpF7eCb9BgXUxZAxrE9xQA_UItvmEbN4p75jBEZlqlpTqEr_z_b6CQE18xzKy9j4LE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j2bs69z1lJf9VBqiW3CTgIz7NpkiooWcZRnTesccjlA&oe=6A241EC0"}, {"file_name": "1506850_20210221130453_1.png", "id": "176508490656749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035334_176508493990082_562674030797870547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXGfpk3WoW0Q7kNvwHR1z_0&_nc_oc=Adoazemq3DRG7F1SWDwjzmNI7p_Xc5ZcBLXcUepmnvv_mMdBt3SvPY3HS5YqYWV5OgQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PAvchb4HjMJwGlypBICEha3H9FffdDkbvvR8OwfZLDA&oe=6A242AFE"}, {"file_name": "1506850_20210222203645_1.png", "id": "738412340403036", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57566687_738412343736369_7295909685652399611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiLEVQrMeoMQ7kNvwFGq8En&_nc_oc=AdoM9Jv_DIdivLxcNo68pqVDuWcWDEZyZa6mcac888GMNx0SXfwWZ1jzizvvwoYmRJ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jOyF_SjsMvojNebC4GWfLqtIroKrWQ-4WsZ17mAJ7Hg&oe=6A244A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OC_CoverLandscape.png", "id": "740112973305075", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974469_740112976638408_8491630443241959094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBSzkFYonykQ7kNvwHiNdvW&_nc_oc=AdpSkRqUY8mOLayvcFS-gsfT5HmvmuK1HeV30ibIPhDIjN3h-BvuIEUd932tQaBUxls&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K5ZSA8bJ0ShW2c9OTWEaq41T3O53FyHYBsVvl92vK8A&oe=6A2447D5"}, "display_name": "Cards & Tankards", "keywords": [], "long_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nAre you tired of trying to find a strategy card game that\u2019s complex enough to make every match exhilarating, yet easy enough that anyone can learn to play?\n\nWould you love the opportunity to join a supportive community of players, where you might just make some new friends along the way?\n\nYou\u2019re in luck, because Cards & Tankards is the perfect combination of VR and tabletop gaming; blended together in one incredibly immersive package.\n\nPlay with other players and chat. Play alone against AI. Or you can just enjoy the tavern, have some laughs and observe. The choice is up to you.\n\n* 2 factions, each with their own unique combat mechanics\n* More than 60 cards currently available\n* Completely customizable decks\n* Cross-platform multiplayer, making it easy to connect with friends", "short_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nGrab a drink, pick your deck and prepare for Cards & Tankards \u2013 VR\u2019s most exciting, immersive and relaxing new strategy card game. Come join our wonderful, welcoming community of players!"}]}, "developer_name": "Divergent Realities", "developer_privacy_policy_url": "https://divergent-realities.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Divergent Realities", "support_website_url": null, "website_url": "https://www.divergent-realities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1094800827981692"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "185900993738689"}, {"status": "PUBLISHED", "id": "660153722618646"}, {"status": "PUBLISHED", "id": "490921902015647"}]}, "baseline_offer": {"id": "660153722618646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1636399500, "status": "PUBLISHED", "id": "185900993738689"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26039857605689996", "version": "4.5"}, "id": "171958747712250", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3073319699
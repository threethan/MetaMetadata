204203_1.png", "id": "420374842590991", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974514_420374845924324_2837600827253964282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlcHqR0SkFAQ7kNvwG3Muq0&_nc_oc=AdrJSBYi-2mrW1pRWRfKm6xnIRdFQqKn9mHAggsvvNsrLv_bsg7TOV6Dduuyr32qbqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o-kKsy6g_cRDiBn3qEovoWoF2PxM8B32c3X-oBxAj1Q&oe=6A19A2AC"}, {"file_name": "1506850_20210222204107_2.png", "id": "269433197917317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75196228_269433201250650_6450224956633597002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYT8AkJ1ofIQ7kNvwHiyrH1&_nc_oc=AdqhKvf02ynkUCVYeEglFdRmj23hajvtWJhPVSdldlGFjJG_z62mnhswO5RRc6cfiEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xWe_sPZLLS8fMRqISl134saQg4pWxGrHTooimgPtyYQ&oe=6A19A55C"}, {"file_name": "1506850_20210222204051_1.png", "id": "238318264595321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031446_238318267928654_1000690690028987762_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNW6q4SMUGwQ7kNvwHfsclE&_nc_oc=AdqjolArnuyOKftRU-ii6W1JyxYR4adw33str03hZiQekY5ESUEp40etJvfxQRDBJPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gM5EFiv7vhqH_HVu5ylfEE6qoAF2jP8fUAOCU94ZARQ&oe=6A1992C0"}, {"file_name": "1506850_20210221130453_1.png", "id": "176508490656749", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035334_176508493990082_562674030797870547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysvYIi9V5QwQ7kNvwEQLVjL&_nc_oc=Adpd9qb4zxVLZTc22Yl-mv_i6DThTGLu_GpiiYw3lGo7NAKjRlB7fyQLZIDgb45e3ls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q7WczFZhMRqERW0ck243JmNQJUNT_LtgE3uOPue9NBA&oe=6A199EFE"}, {"file_name": "1506850_20210222203645_1.png", "id": "738412340403036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566687_738412343736369_7295909685652399611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLDqNiGsAaoQ7kNvwFB7XC6&_nc_oc=AdpR0sIN8vgKP2Ga8B6NikhWqtuvF0hNdFS9Y2ewFPLeyp56qla4blRxNunoBoU9lo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B1DxxsYLkRIXPhS_bZvVu8wSp3qT_dwPAzDLp19fSCQ&oe=6A19BE8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OC_CoverLandscape.png", "id": "740112973305075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_740112976638408_8491630443241959094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXocrmBKEAYQ7kNvwFY_S2P&_nc_oc=Adq5kygp9PxLcU0pQPxYqvqZrZURtdsha13LHI1VkexV331021pOUSZPhe3AKKEHWtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wivpOvZAF3a-Iwj7qAgJ7XAwgkGc4QvhhE4ctz8N4Vw&oe=6A19BBD5"}, "display_name": "Cards & Tankards", "keywords": [], "long_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nAre you tired of trying to find a strategy card game that\u2019s complex enough to make every match exhilarating, yet easy enough that anyone can learn to play?\n\nWould you love the opportunity to join a supportive community of players, where you might just make some new friends along the way?\n\nYou\u2019re in luck, because Cards & Tankards is the perfect combination of VR and tabletop gaming; blended together in one incredibly immersive package.\n\nPlay with other players and chat. Play alone against AI. Or you can just enjoy the tavern, have some laughs and observe. The choice is up to you.\n\n* 2 factions, each with their own unique combat mechanics\n* More than 60 cards currently available\n* Completely customizable decks\n* Cross-platform multiplayer, making it easy to connect with friends", "short_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nGrab a drink, pick your deck and prepare for Cards & Tankards \u2013 VR\u2019s most exciting, immersive and relaxing new strategy card game. Come join our wonderful, welcoming community of players!"}]}, "developer_name": "Divergent Realities", "developer_privacy_policy_url": "https://divergent-realities.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Divergent Realities", "support_website_url": null, "website_url": "https://www.divergent-realities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1094800827981692"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "185900993738689"}, {"status": "PUBLISHED", "id": "660153722618646"}, {"status": "PUBLISHED", "id": "490921902015647"}]}, "baseline_offer": {"id": "660153722618646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1636399500, "status": "PUBLISHED", "id": "185900993738689"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25846537598355332", "version": "4.4"}, "id": "171958747712250", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3073319699
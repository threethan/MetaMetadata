byiyF38gQ7kNvwFMkYiR&_nc_oc=AdpUKFY6e_xcuszpWRzHVjcZHRpbArwQHX49K9Guq4VxpqDIYyuh2jkXHKvZVplBy1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nl8wwcSf_Ow32di6paYug-gzBVHz-L9f_n3CZ9R6tBQ&oe=6A16E34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OC_CoverLandscape.png", "id": "740112973305075", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974469_740112976638408_8491630443241959094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuB-yujvNa4Q7kNvwFqnqhd&_nc_oc=Ado0kPzUroJNTXOc2qRn9j4_uID5MRG8rGErn2Y-T2SX99TNJZoQvAbcr4E6nucK9J8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6InBXzZodW611x9hF9rhgecGh3mc-dcfSfPeoIwOslqA&oe=6A16E095"}, "display_name": "Cards & Tankards", "keywords": [], "long_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nAre you tired of trying to find a strategy card game that\u2019s complex enough to make every match exhilarating, yet easy enough that anyone can learn to play?\n\nWould you love the opportunity to join a supportive community of players, where you might just make some new friends along the way?\n\nYou\u2019re in luck, because Cards & Tankards is the perfect combination of VR and tabletop gaming; blended together in one incredibly immersive package.\n\nPlay with other players and chat. Play alone against AI. Or you can just enjoy the tavern, have some laughs and observe. The choice is up to you.\n\n* 2 factions, each with their own unique combat mechanics\n* More than 60 cards currently available\n* Completely customizable decks\n* Cross-platform multiplayer, making it easy to connect with friends", "short_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nGrab a drink, pick your deck and prepare for Cards & Tankards \u2013 VR\u2019s most exciting, immersive and relaxing new strategy card game. Come join our wonderful, welcoming community of players!"}]}, "developer_name": "Divergent Realities", "developer_privacy_policy_url": "https://divergent-realities.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Divergent Realities", "support_website_url": null, "website_url": "https://www.divergent-realities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1094800827981692"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "185900993738689"}, {"status": "PUBLISHED", "id": "660153722618646"}, {"status": "PUBLISHED", "id": "490921902015647"}]}, "baseline_offer": {"id": "660153722618646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1636399500, "status": "PUBLISHED", "id": "185900993738689"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25846537598355332", "version": "4.4"}, "id": "171958747712250", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3073319699
204203_1.png", "id": "420374842590991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974514_420374845924324_2837600827253964282_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwdJYugvBEAQ7kNvwFsrAlY&_nc_oc=Ado5fqm2va436ma-tNiX_ZqO5AESI_DQ2f7AnDi94NNkeOqSHjUCFzMURpzHYAKRDas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87Sijk5QyuGEWBfdJGwYpW-6YvRP_T31nFOwfxtEq6Kw&oe=6A2974AC"}, {"file_name": "1506850_20210222204107_2.png", "id": "269433197917317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196228_269433201250650_6450224956633597002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQYSJWQi794Q7kNvwFOQIYH&_nc_oc=AdosMmcmTk2hyGp9NJPwK6onv2LQ8o3xy6PPxNutdOZJsLFHSc5WLzK_y0kOwwuIHb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MwK0Q0L-fIwX3DWudoMuWe6eMgl6H_Qvz0aSR3pXa4g&oe=6A29775C"}, {"file_name": "1506850_20210222204051_1.png", "id": "238318264595321", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031446_238318267928654_1000690690028987762_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-ieg1NxklEQ7kNvwGAzIHj&_nc_oc=AdrydtQuNCjImZoPBvfGtYrHU21xXIQheb0439t7fRh6fIBQGjMi6nnUUiKlfycWoP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m0AUL8wVsMFM1ufoz1UmfIyKkuEP7LvbJ2z3jXeJbKA&oe=6A2964C0"}, {"file_name": "1506850_20210221130453_1.png", "id": "176508490656749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035334_176508493990082_562674030797870547_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTf9g2WTrZ4Q7kNvwHEi3HY&_nc_oc=AdqKGrvIQat83Hdi49e8Mr36EOnMG-hqOpqcv2qdtCK3GpIZHSI57xBjj_KuNbnq9q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ouJ4KzrS1u70eyQG3_TSOzZUMWocO29s8gNZN2CcTcg&oe=6A2970FE"}, {"file_name": "1506850_20210222203645_1.png", "id": "738412340403036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566687_738412343736369_7295909685652399611_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruQXwYBEm3YQ7kNvwGGJJaT&_nc_oc=AdpoZrW2uHAuOWI89Bjsm_gSLr_MXioEj4RKcVntEjQv-EBwhX5EWPUeRXAEi7DiPRg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QaHkU3vASG6xmZ6YZmyvf7cGeCRIeLX7h1qF40tWhzg&oe=6A29584C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OC_CoverLandscape.png", "id": "740112973305075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_740112976638408_8491630443241959094_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plIS2zQo4CkQ7kNvwFH9iew&_nc_oc=AdpFT7jBnFnB-tCtgX01a7ihNQM63Lrwj8nT3o7cb3dT_5g14U28B3BpIR2hay8aF8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89yDv0EUj0H5HI07Uwl7Ngiw5rQXdaT4YlY98KTVj63g&oe=6A295595"}, "display_name": "Cards & Tankards", "keywords": [], "long_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nAre you tired of trying to find a strategy card game that\u2019s complex enough to make every match exhilarating, yet easy enough that anyone can learn to play?\n\nWould you love the opportunity to join a supportive community of players, where you might just make some new friends along the way?\n\nYou\u2019re in luck, because Cards & Tankards is the perfect combination of VR and tabletop gaming; blended together in one incredibly immersive package.\n\nPlay with other players and chat. Play alone against AI. Or you can just enjoy the tavern, have some laughs and observe. The choice is up to you.\n\n* 2 factions, each with their own unique combat mechanics\n* More than 60 cards currently available\n* Completely customizable decks\n* Cross-platform multiplayer, making it easy to connect with friends", "short_description": "This is an open beta build that is not ready for release. It lacks polish and will have bugs. Please only install it if you're interested in providing feedback and helping test for bugs.\n\nGrab a drink, pick your deck and prepare for Cards & Tankards \u2013 VR\u2019s most exciting, immersive and relaxing new strategy card game. Come join our wonderful, welcoming community of players!"}]}, "developer_name": "Divergent Realities", "developer_privacy_policy_url": "https://divergent-realities.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Divergent Realities", "support_website_url": null, "website_url": "https://www.divergent-realities.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1094800827981692"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "185900993738689"}, {"status": "PUBLISHED", "id": "660153722618646"}, {"status": "PUBLISHED", "id": "490921902015647"}]}, "baseline_offer": {"id": "660153722618646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1636399500, "status": "PUBLISHED", "id": "185900993738689"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26039857605689996", "version": "4.5"}, "id": "171958747712250", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3073319699
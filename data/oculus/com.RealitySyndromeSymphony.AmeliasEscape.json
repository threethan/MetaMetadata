 To ultimately find your way back home!\n\nDelve into the story of the time travel scientist Ron, who kidnapped you and discover how you ended up travelling through time!\n", "short_description": "Amelia\u2019s Escape is a VR escape room with an interwoven narrative! Take on the character of Amelia to solve puzzles to escape the room of a time travel obsessed scientist!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://realitysyndromesymphony.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Reality Syndrome Symphony", "support_website_url": null, "website_url": "https://realitysyndromesymphony.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8742068489207103"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4073372562970295"}, {"status": "PUBLISHED", "id": "1050446874432944"}, {"status": "PUBLISHED", "id": "4552766605046959"}]}, "baseline_offer": {"id": "4552766605046959"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "4073372562970295"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27664674786519855", "version": "1.0"}, "id": "488478044067964", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only"
ent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geo_IbQvAw4Q7kNvwGjQiUm&_nc_oc=AdlaINNE1josyocyQ6BycooWtsR_cWSClRTA0OFs9f-KX1zpsfuSQXs10urAAyRkvhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv46140KRf_nnpb-Ghaf7NB_Sj-NkfM1NRWSsyXSOFi7A&oe=69984F65"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KXKei1lMYsQ7kNvwFa5Qkv&_nc_oc=Adnm5G8NgACLLGFHxXQUjxhV95KvHloAUwyUZN83FnRB8pDByWGSbKc7gJcCKbIJCxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu0ogC8xxOyE0CSae51HURZxIsHjU1waQLBBGbTFsOKxw&oe=69986D5E"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87WFysGruxMQ7kNvwHXSWIW&_nc_oc=AdnLKm7cMWX0ilXNZV-INlA7oOtkM3Lz5_dQM8UisZcULvsVH_kILZw9ZfA30mGneo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsm-OPTGRGlfDK_NbgHxb2K_zwxakV_JhXbgnlcCsvfiA&oe=69987109"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moVAskzMMaMQ7kNvwGchWyc&_nc_oc=AdmQr9177KV6CYWVULOQ5pEFIqJGv4M3sikFlFV1X3NwIOAOiJ3zr3rPC_MXIerY-UI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuFb7DETihQP6TjM4uj7FMYpGCZnfj0NDc7lZ81qTl6cg&oe=69983ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9GQAQPSdFkQ7kNvwGkQhQN&_nc_oc=Adm84SIw_t3jynFxbQ9am6K413NtNiJUJhvzK6-hA3VcqjUP8lcs-PbNtpB6Lcmqc_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsuwS0EGiM_bUwL1Q1C5K--11l8-8pdI8czZNoOqH-rZg&oe=69985225"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "d
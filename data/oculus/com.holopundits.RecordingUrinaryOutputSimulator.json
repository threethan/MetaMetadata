rP-a01j47aKaY7M0xMFp54BvGziWNgy5Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBun8XB01JNdBe1Epsn1AZNQB4sm7UlrT9ohGV68hmLg&oe=6A8AEF97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "458101067138615", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974686_458101070471948_3126529237587478707_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vk42Vnxa1gQ7kNvwGMeh45&_nc_oc=AdrGNhxUeUJgWrm4hRh68E8V9PvZ35aYC4EeKtBXjf8WG2QI8fc8h76LLuTh6H2zqaY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwie3NpAp3fPciA2CH0UqqVUFbZtlLbZRfV8bu7EyQeQ&oe=6A8AC40B"}, "display_name": "Recording Urinary Output Simulator", "keywords": [], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation. By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/
inary_output_SS_02.png", "id": "2064775120637563", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7QOoN38TgYQ7kNvwHh6bzG&_nc_oc=AdkfjQt5d8Q7vKfUA783ZuToW7UjCFojulG_7jQfybu7BUVFWHyiV3kuu9DG6a-Wo60&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6b55JkBAWlUlisBUN53rUTZoOe_l1T9EBA4WL55ZtuQ&oe=69B3FEE5"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcv5F1A7ubAQ7kNvwFnzzjN&_nc_oc=AdnDGP-tLfzTSphoiggGRQ5IBAqDGS0X5Z0z1nYm30FWDD5VneelKYfMh7Tg3t3MV9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4GuRkRtEGof9yNm6VqsyKG_YYSWt6eMObLFbFbmAxdA&oe=69B41CDE"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPvUL7AooLEQ7kNvwEdZiRH&_nc_oc=AdlNc8Qh5yIWib9l_I1zVfgv2Qpr0_-xLeDvcb7z6tAsiIxwUWauZoqX-O_k4OCMgH0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWDDwhIYz6Mcb8RQMH44tGkvxS-RuWy2ctQROqD4y3_A&oe=69B42089"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ARtNfxgwf4Q7kNvwEpVmyq&_nc_oc=AdkhmQ58tbsWDVwhj9ds7XgKeacejpapKVTk2gEtYgK8CNexpEWhSo654sCw78ln_nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNbXb5GWdTEDS8XZoPXC8TMo1kqemwvO2rQ-9QBw0XNA&oe=69B3EE4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLnSNtSKmBkQ7kNvwEpOT3e&_nc_oc=AdlzjwuKVEKyEZRoh8sazJ8jM60fEkAILtBSLxtgqbsqayLLRDb_Rz9vuZaasHOYoYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSBZcR4lwIKzxMQCBvjB8rKPyfG5H03rbLFZvwr6ZfBQ&oe=69B401A5"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensur
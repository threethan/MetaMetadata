inary_output_SS_02.png", "id": "2064775120637563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8twXOzcp4FQQ7kNvwFn4I6O&_nc_oc=Adl4me1_byz70tZOv1oOilMHVUxZSwrxBC11rh2c332T897kTgywyLFnRXi1BnME4so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBDNeHvSuSYid3zi1eLweP3jt0vvqwerT6ubEwFTyBhQ&oe=69BE8AE5"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnX-qNfYCY0Q7kNvwEmBzH6&_nc_oc=AdnYD4Gm8T_AqsGh-UPOCQLCoJJnqmFbMypCeVPcMmbyG9Ptk1ZPCTCB0tnLag_K_2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzN565pLUszeM6YKVASePbCE9xaLAcZjfhimsZsgTIf8g&oe=69BEA8DE"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEM6S8WYTyIQ7kNvwGAuZJt&_nc_oc=Adnou-f_lf-f6KIcYYcI812Ktqp4ppxSlkDHqpH3ldj2f1ifhcYtmP-4lu5I1BH_i3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwujtYippLHaHQ2-MJRZ5vSOdK31wIQOHlyDMY3Y4Iv1A&oe=69BEAC89"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RbnU9gL0kUQ7kNvwFH0zy9&_nc_oc=Adll_VhV2TsdoD0a8gokaIoZoLhZLDONY7fEOyf34apElWEtVlYM184BOcyhs0zwMhU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylsT_Ty82t8H_GVBBEHTlGfKLAOly71CqWDjCTFm42jA&oe=69BE7A4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0UmqUrdUr8Q7kNvwEIVbW5&_nc_oc=AdlKokgbBG4eJF08WvNRJR4q33906EspX8gO_arR_SDZc04t5ed2zrtA_C7ELGMMXXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvuZHusMh8ajs-KN8ojgwdtrwddvAjwEZUKnF8tDTgiw&oe=69BE8DA5"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensur
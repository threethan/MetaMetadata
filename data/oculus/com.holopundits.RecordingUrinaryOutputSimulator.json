ent-atl3-3.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz3CSqoXN6IQ7kNvwGt-JF5&_nc_oc=AdlA54Oqeljav7leytLlczKzi6N9Z_nnWEvd6UvZzP955u3rfFwMJ1ROjc3K1rlpsM0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvGdnVCxqBHjRnHO399VWjYez-r9_NfGszk-UYSBf2R3g&oe=69A57E65"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJbDjFsr4DsQ7kNvwFJc6O5&_nc_oc=Adm4r5haHeviHG814CEYVCQDsjfqxOeiqAOJBWCZM_Zrce7nfC7jKgdSFwGtn2t5mnY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftDOJpYACn0aTd_BkVPB11huhLILXRY0yiHJPzuY_OfCA&oe=69A59C5E"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EegtvY8eNv0Q7kNvwFzmSEd&_nc_oc=Adkfw0syfFWMlMZyPrlicGsYixWOSpmouQVgodHtRdrRA_fhltKhKNKIoFCF9fvUwWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvJH3l7OkIRPFLYu6bhn7ZJ5v73z44Dc56rByA2LJo-5A&oe=69A5A009"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERObx_JLbsUQ7kNvwHxJ_Wb&_nc_oc=Adk3fhq8dSpGn28XZy9A9OdIt-vrnZEYsAsZddJoMXjFVm8enSgmGZkOnRqf-dww7bA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfubM0X2WABFHzwrkjZmHXYEjcBECfbQOO2SJAYm-h2gmg&oe=69A56DCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAZxwIn-H28Q7kNvwFDqQSR&_nc_oc=AdmAv_4M4Vqo-aLcSLFWTEo0Tbxty77KKfmpCBBJiLHEppQx7pRBq_cB0nuU4OWHo74&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft_Cn0qejM3Sd0z044BOev82P0VvwKd0ri5c6USvT6_rA&oe=69A58125"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "d
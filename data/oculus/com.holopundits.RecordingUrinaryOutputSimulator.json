ent-iad3-1.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fz3CSqoXN6IQ7kNvwF4IALz&_nc_oc=AdnuPtCHeqn_D0TyDOhwlrhy_bvd4cKLa4Xl5GAa6BsHJfQMH5sXDhcgtNgRlF1b7vA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsr5jCGofq4W09kmlcqL5RsQYJpbS7R9k5w47seKHrrMw&oe=69A6CFE5"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l2QCp0weBAQ7kNvwEGKmIg&_nc_oc=Adkq0nmGM-UOpe_5ZZMILGxnb0APbFneCNdSwjLYHbLS9ECslETvCzaZ8NaxLg3RaWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5PQkkXR1ZtohNkjVwWUroHGB2NULqEWSY0fAJ_9DoVQ&oe=69A6EDDE"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EegtvY8eNv0Q7kNvwG_CkRV&_nc_oc=AdmG1NlDg5vNp_w_HmD3pkTEvBaaqRio0nl2ZLAICM4J0NlqF9ot9B4CvXk43q2big4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftGDFmJj3htXgfSbKsi38xdaB9hx20iJFbXF4QP6L5mfw&oe=69A6F189"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp-cmq6eXakQ7kNvwFGJ2fK&_nc_oc=AdnkxWUf9Ma4BcDmsJ6L3_ptzSZoEYgBzFHXyN_A-GNRU-FghuhhIl9E8U98A8BNrks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxG9FX4KnRi8fkTB-5399qcGZbGNKs5p3WVlO7OScpdw&oe=69A6BF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENzX7A9tmMsQ7kNvwHYe44D&_nc_oc=AdlTQdRMMEjX9YcdMw_EHm7ny_n429ipIB8e_fiT6ikPvesF-I68FT3suGNYJbGeIdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWT9uAM8NuW5igQSgCxSQxU4Nnae2KxW_R6bYQlDnGcw&oe=69A6D2A5"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care with AI guidance and multilingual support for better learning."}]}, "develop
inary_output_SS_02.png", "id": "2064775120637563", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni5hmR-RQ9IQ7kNvwFjh16S&_nc_oc=AdmcIMpx7STGFAhHCDvTAs5Gvt5KLDRxyu4T0ip0ebjbOyUE9vgJ8YqlI0-SLvUA3Iw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyID8nlyNZ3xKgnpSpw3BuJn0pljKYQNNl4A6lXszCHPw&oe=69AC15E5"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dci364-pH5UQ7kNvwHLWzD-&_nc_oc=AdkhatCpUk7dEUdaHabm0-w9u0x1Ov4WvGl0Qyae-LwErTe0zxjrIw6F1f8sp1IO1Dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwj51NeUi7cgtAZJ_dEXEAPgXhxnMaIfKJts2AS-sO82g&oe=69AC33DE"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjp4S1GioywQ7kNvwG85i7C&_nc_oc=AdkADE_0N8VHI557uY3pBd38WRwwpxvQmLFOY51jRzjxTQ7FvZRsaclKny3RPJLjHAo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMP9shlRa0q8fLkaQieg3wIuzbDvXWLtBVChUnb6SRCQ&oe=69AC3789"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pTg2BfrXvKcQ7kNvwFZOlzk&_nc_oc=Adl0waiP95HcUwMFU2EaxkwdO2gzunlGfknOFTiyUUoP7qFdgOy9x-9y96OD_0b6vz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfybaqzMF32wmNtMcL9fMjm6KAMXwWQjKGAUAjn0KW3VKA&oe=69AC054F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jVdEnbQg3UQ7kNvwFOZIXl&_nc_oc=AdlIdlapVsrVaiOMjFpksuO35XekAZQlHkVjWwMma27vjbFRSKd60vyNS1E5PPakoTE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxtbvA7_lMvsK3NEC6wY82W8fPLevST2feX2MgAII0dhA&oe=69AC18A5"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensur
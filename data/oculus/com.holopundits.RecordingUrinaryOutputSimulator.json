5771-25/38974792_459450586856762_3358244016603382828_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv_zXfv4qfEQ7kNvwEhP192&_nc_oc=Adon77Zt61Xj72ZZesOM8yWwKC6Jujp3Dj5kNi-J97x-T6TcSG14O0tzRImX4qHWlrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTn8KE8HwssLcpQPdGbDMR6ZLVvNzm3GVaHpjG0fkQYOg&oe=6AFDB279"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "480460224578456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_480460227911789_6803552178662113930_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54FV8dEyrZ4Q7kNvwEhy5hb&_nc_oc=AdpfLcb9U43yHwnN1ZeAoem3O6pdlJ2cDSO7JCEjcdc7C0rLBIvlbn0GopaaguA4UeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDkDauSbHJ-3o5Gf2Olb9xEXU5rNiSGgaOqTSBObUkbg&oe=6AFDDA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "458101067138615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_458101070471948_3126529237587478707_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNpy2CLTCFMQ7kNvwEw6iHh&_nc_oc=AdpuXH6Tneq3UK_jzizE6GODJ-_1odPZ4nVWZOSb_U2t4YVCEwIg2To-PInc_oTihl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1sUZvCf6p88M_wuUUVwFb7k9B7ydXMMenS9xV8H7L5w&oe=6AFDAECB"}, "display_name": "Recording Urinary Output Simulator", "keywords": [], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation. By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27067585719506879"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1247486390427081"}, {"status": "PUBLISHED", "id": "3663466830580629"}]}, "baseline_offer": {"id": "3663466830580629"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1247486390427081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31545336238398449", "version": "2.0"}, "id": "364569443148686", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
inary_output_SS_02.png", "id": "2064775120637563", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nec66dX4u14Q7kNvwHQKuNl&_nc_oc=AdligSvwQKt5TV2CKw0-tFtejv9otto5LbUjdWBla2_Rt6ctfr5RMP1HZ2KdKM9XQro&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfykTkbnE6jdXk4EWkszIeQhsDYPz9sWUT0-vweiTsRt0w&oe=69BA9665"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBuJqQRyteQQ7kNvwHRTKZl&_nc_oc=Adkc73q7jTrWidSZSA-aNWndku9J8H5HzGR5WSKup8ChW0eYSTL36mfDQnWDr8NkQjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZ-_tNjy9cge_dwyZrP3cxZgHaXXBew8KGspjq1kKcDQ&oe=69BAB45E"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPQYufRYT8UQ7kNvwHyDcEn&_nc_oc=AdmyTohYJqDMhJ6-W12doAJkO-K_ckrS256lCQ98UBFHA4Tz64nDZy4i-UhC_1hwuqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytXSXFhybSHoc197BLQavXh-emmjOSu6fzgr6ITnGggA&oe=69BAB809"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmUbJBW_opIQ7kNvwFJWg2d&_nc_oc=Adl1ucNbENUUR650AzyKzvTmcWVKq7ycRPZ7DVxBeyIrcKINQaVY690iuwkkDm_hJP8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYoiRDNhgwYNOJcPmcz0QF87TJquqcOtJlgsX4tTKDJg&oe=69BA85CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vARNFy7iz5MQ7kNvwFWP0-r&_nc_oc=AdnZfOep4sRgDq6fnhivH7snbJXzfahtFROw3uK17opMYLczptCQCWPpLg7GaD_ygqQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfydGlMeGp4Oepb7LKK03Md7JCWWglvT80sfE2JMhxGGRA&oe=69BA9925"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensur
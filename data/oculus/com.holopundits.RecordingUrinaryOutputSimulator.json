inary_output_SS_02.png", "id": "2064775120637563", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7QOoN38TgYQ7kNvwE8zb9p&_nc_oc=AdlyaumEpNCQUkGz_HIWMxiASMl3DPi_CwfEAf3XDFTnMJm95ncU2fTGB3qFGv2Ybyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyK0pogwm1mcwfoA6SByvV1vNJUgWjMSWrR9ZMvah0k9w&oe=69B2AD65"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcv5F1A7ubAQ7kNvwGFHGdG&_nc_oc=Admwvxf4Cge6vv1K8nHqPkFH9DcXqOgoSaN-L2_K-Xpi7bHHa2C_AWuPbM02txrqZ-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKCQ1tmQgCTGwrBTuzMI2aYuKJVFpbtPv-vMQjCSZSzg&oe=69B2CB5E"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPvUL7AooLEQ7kNvwFk2b_7&_nc_oc=Adl81KNOiSy0qsxTIhBtE62oUXfouiNTOm03_7zRdHMOjxJP0zU6FaWAWJMYfAZS3bE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZVmrcqw-HFAulr17m4sqKyDEJGXXcLW6Df8Aa8vaeyw&oe=69B2CF09"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ARtNfxgwf4Q7kNvwEmqGbZ&_nc_oc=AdnXZx8ClrKdNnKtwDBiQ-Niw7eLh3hd1ZXEmYfYFzPt8FumI-82ax_C6yxZ3RUFEts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkZW8HBYoBOS8t5p_XjSSDgCNDC_OatwmU-gBEKHvoQQ&oe=69B29CCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLnSNtSKmBkQ7kNvwEqBJwR&_nc_oc=Admwnh_TUOxbSrP6GNCvDKG2XSUpjozcNbK-U0Is9jgRbieUTOQglfL7RWV1vIFpr4U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiF52IF9NvMTK1YnlozEeZn94iEnbB9zRW0TaYjZQNBA&oe=69B2B025"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensur
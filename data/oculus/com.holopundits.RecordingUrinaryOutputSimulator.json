ent-iad3-1.oculuscdn.com/v/t64.5771-25/39036688_2064775123970896_2823803603300518747_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ky4nsSOBkPAQ7kNvwEV3R_C&_nc_oc=AdmO2kqyHxUxS2oiwJ3s849BMKcywHEEyxNg4cF2IlBSv5Nr-nCTaEFS5dqTqAblYFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEweShUwBLyGrOgCPMUvrxTnhrrwdFkYiGnYkADXVI2w&oe=69A03865"}, {"file_name": "Recording_urinary_output_SS_03.png", "id": "10003901396292503", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036706_10003901399625836_7481725541577107264_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgBe-FhhYMwQ7kNvwF0OHly&_nc_oc=AdneJAGonri2hHvkeuDigjG1aL4IeCaT7oL-Cl3jzTG-A9iG9dGO_pysUs1Swl7DEn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsTkO9fEm0Ku53Luegs647-nQaTQV6trySpWgr1-HY7yg&oe=69A0565E"}, {"file_name": "Recording_urinary_output_SS_04.png", "id": "1118747276306028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974567_1118747279639361_2630598639698941212_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMR1zlaKVtQQ7kNvwGpvcel&_nc_oc=AdlDRBWDkMi-X-AcKHNvOWQ0deCr7V4sRKaO10lHGDD9zjYWbPFCgkGHF8QsfPPJNA0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afslpm1T66IYha6RJAeq5vtkR-mEP8QDKP-7DQe0Bum1fA&oe=69A05A09"}, {"file_name": "Recording_urinary_output_SS_05.png", "id": "1112731786543003", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75462205_1112731789876336_7874361370153734845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urYqdZO4pnsQ7kNvwFbrz4e&_nc_oc=AdnKdwGUuu5Aifv4dcVEzPii6JDaQHtbpMqWV9XyTvFVhEanI4R6wphTziRCX4SI-YE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvqQHd2ro18qXPkqONmkhKH5gzbkKc28SL7gaqtChUOKQ&oe=69A027CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Recording_urinary_output_SS_02.png", "id": "595629112986504", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974582_595629116319837_3672331500502065539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yWsDp2o7u8Q7kNvwHgmDaF&_nc_oc=AdlqR3xSnpOOjJ1p3fiIPomzlERcjFkjehoK_matN87Kj-8Q8BK99CSjgCtKIOGdOfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgyyiTwoEOIDELOi_pG1VAhYXLZ27rFUb4oSBnisFimw&oe=69A03B25"}, "display_name": "Recording Urinary Output Simulator", "keywords": ["CNA", "nurse", "nursing", "urinary", "Healthcare"], "long_description": "In this tutorial, learners will engage in a VR simulation to measure and record urinary output. The process includes preparation, patient communication, measurement, and documentation.\n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n By the end of this tutorial, participants will be able to: \n- Remember the steps for measuring and recording urinary output. \n- Understand the importance of accurate measurements in patient care. \n- Apply the procedures in a clinical setting to ensure patient safety and data accuracy. \n- Analyze and identify potential issues or abnormalities in urinary output. \n- Evaluate their techniques and make necessary adjustments for improvement. \n- Create accurate and comprehensive records of urinary output for further clinical evaluation. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with feeding efficiently and compassionately in real-world clinical settings. ", "short_description": "Learn how to accurately measure and record urinary output to ensure precise patient care with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "d
 and weapons or tools to succeed the mysterious horror hospital."}]}, "developer_name": "Tom F\u00f6rster", "developer_privacy_policy_url": "http://www.forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom F\u00f6rster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1588797824826883"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "630634210792808"}, {"status": "PUBLISHED", "id": "634371364088516"}, {"status": "PUBLISHED", "id": "379430182978643"}, {"status": "PUBLISHED", "id": "1264638567051587"}, {"status": "PUBLISHED", "id": "1688394834627984"}, {"status": "PUBLISHED", "id": "2666765230023628"}, {"status": "PUBLISHED", "id": "218358462638316"}, {"status": "PUBLISHED", "id": "444268869638748"}]}, "baseline_offer": {"id": "444268869638748"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1565888400, "status": "PUBLISHED", "id": "630634210792808"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3215505401811417", "version": "3.3"}, "id": "352626948757251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "289373483398847
/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485579_982179136484381_1791080803916466675_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF36kHwzejwQ7kNvwGjC7S3&_nc_oc=AdqfA6bbzEg9pckwwrN-XJlCZn-ggL5vX9o6uEaqY-0YDjl45MNMAwhqBOFMYZHOA_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbkaAdTxAiB6KTdFevdytKb9ArVUrWvbjIyAaJAl8x5g&oe=6B0F009A"}, {"file_name": "EverslaughtInvasion_Screenshots_5.png", "id": "608427237516246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_608427240849579_8213688493835280346_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceewbB7vboMQ7kNvwFtbEVQ&_nc_oc=Adr4tNzlWE836C5Q1guaJkGDeTQpN_9H-3gdb0GnC3R-lxG7t0VbLJ6z39CFBszyHJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUlGVQXxVclw7eL-6HdG9yZwV6CSVXHhqsGRYiKEUoUnA&oe=6B0F20D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EverslaughtInvasion_RevealTrailer_Thumbnail_2560x1440_V2.png", "id": "2503167119841835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_2503167123175168_5740206422479645960_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5TEKg-T_jsQ7kNvwFOXfRU&_nc_oc=AdpHZawEyT-Bm2ctpcV2nqHnrfa8TYDhgNqZ9q2Byg3TV7GqKerp2q7AwoogdPOzoMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5xKBfp30XdQB-0Bc9oyk8ijZ8_yMt1Hzjgi39A-u8Aw&oe=6B0F12B2"}, "display_name": "EVERSLAUGHT Invasion", "keywords": ["horde", "coop", "survival", "doom", "multiplayer"], "long_description": "Get ready for the ultimate VR action game with EVERSLAUGHT Invasion! Choose from three unique classes, then team up with a friend online to take on hordes of enemies and defeat the Great Corruption. Run, dash, jump, and grapple your way through large dark fantasy environments. Upgrade your skills and gear to become even more powerful. A wide variety of melee and ranged weapons, unique character abilities, and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill!\n\nHIGH MOBILITY ACTION\nExperience complete freedom of movement and awe-inspiring hand-crafted environments in EVERSLAUGHT Invasion, where you can run, dash, jump and grapple without any restrictions in VR.\n\nARMY OF TWO\nTake on the invading hordes alone if you dare, or jump in with a friend to complement each other's skills and weapons for endless fun and replayability.\n\n3 DISTINCT CLASSES\nChoose from the game's three unique classes - Warrior, Rogue, or Vanguard - and unleash your character's unique skills and gauntlet weapons to face any threat.\n\nDEEP PROGRESSION SYSTEM\nUnlock new weapons, maps, and lore items in a deep progression system. Upgrade your gauntlet, melee weapons, and character skills during combat to become even more powerful!", "short_description": "Get ready for the ultimate VR action game with EVERSLAUGHT Invasion! Choose from three unique classes, then team up with a friend online to take on hordes of enemies and defeat the evil Great Corruption. Run, dash, jump, and grapple your way through large dark fantasy environments. Upgrade your skills and gear to become even more powerful. A wide variety of melee and ranged weapons, unique character abilities, and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill ride!"}]}, "developer_name": "MobX", "developer_privacy_policy_url": "https://fasttravelgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://www.fasttravelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": n
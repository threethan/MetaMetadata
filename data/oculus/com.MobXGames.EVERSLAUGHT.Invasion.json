IU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdJnVw9ClrEiJNd3XVw6--urFM5j6iWgXioTmcvwPVTA&oe=6B0C7DD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EverslaughtInvasion_Meta_CoverLandscape_2560x1440.png", "id": "695861012471694", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/65402154_695861019138360_156018423703384964_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTO2mGi45PgQ7kNvwFEsiIo&_nc_oc=Adq_gMOMYXkTwLOV3AgJrGS0U7tQ0wxurIkd76_H2t9WtRM28Qh5dce6EaEX1UCepPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQL5tgd0nSU75QLchK0s4nLBEbIGDjIFutTbB0KyO5axA&oe=6B0C6406"}, "display_name": "EVERSLAUGHT Invasion", "keywords": ["horde", "coop", "survival", "doom", "multiplayer"], "long_description": "Now revamped and retooled with the Resurgence update!\n\nEVERSLAUGHT Invasion is the ultimate VR action game! Choose from three unique classes, team up with a friend online and take on a never-ending onslaught of enemies. Run, dash, jump, and grapple your way through sprawling levels. Upgrade your skills and gear on the fly and wield a wide variety of melee and ranged weapons. Unique character abilities and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill!\n\nFEND OFF THE HORDES\nThe Great Corruption is at your door. Fight back against a constant flood of enemies for as long as possible. The longer you survive, the stronger you become!\n\nHIGH MOBILITY ACTION\nExperience complete freedom of movement and awe-inspiring hand-crafted environments. Run, dash, jump and grapple without any restrictions in VR.\n\nARMY OF TWO\nTake on the invading hordes alone if you dare, or jump in with a friend to complement each other's skills and weapons for endless fun and replayability.\n\n3 DISTINCT CLASSES\nChoose from the game's three unique classes - Warrior, Rogue, or Vanguard - and unleash your character's unique skills and gauntlet weapons to face any threat.", "short_description": "Now revamped and retooled with the Resurgence update!\n\nEVERSLAUGHT Invasion is the ultimate VR action game! Choose from three unique classes, team up with a friend online and take on a never-ending onslaught of enemies. Run, dash, jump, and grapple your way through sprawling levels. Upgrade your skills and gear on the fly and wield a wide variety of melee and ranged weapons. Unique character abilities and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill!"}]}, "developer_name": "MobX", "developer_privacy_policy_url": "https://fasttravelgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://www.fasttravelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "ru", "it", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24572620235710642"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031631_812060501029895_7521376326260603315_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wpx70l98XEQ7kNvwEsqtvY&_nc_oc=Adq7Oe_lVr4lJBkeA9C3SqtTMkWfgaKQkPFkpjZTJG8o71jbmKX2t6B6rE5R7aS73t8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRldDWJbeppPYf9eaiB3QyuWX
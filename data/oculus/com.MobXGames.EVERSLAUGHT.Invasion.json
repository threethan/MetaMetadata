/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485579_982179136484381_1791080803916466675_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktKhPf4OX3QQ7kNvwELOkjs&_nc_oc=Ado699fPrlSFa2XpB9FdjcoPuVuS3eWbkE6TffcprNiB-Gf-fV4oZj5SxVo6hOGqcGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVtUNCFOIVxWixcYqkEkJFumqoxiyw_vUuzV_h8Jk7Mw&oe=6B04749A"}, {"file_name": "EverslaughtInvasion_Screenshots_5.png", "id": "608427237516246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974515_608427240849579_8213688493835280346_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf4q4p-ovTkQ7kNvwEGDg4t&_nc_oc=AdrPGd2M1z0iMs10tZbfcPnxOeTXDbwQZvS0NCgulQfqq0n8QRCj7bRcWN0QOzS_oTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuGnxB20rrrRSCe-peMVewbXydAmjMZQXkPn9KerjzXA&oe=6B045C98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EverslaughtInvasion_RevealTrailer_Thumbnail_2560x1440_V2.png", "id": "2503167119841835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_2503167123175168_5740206422479645960_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7lC6jTOZyUQ7kNvwEU6miN&_nc_oc=Adqhvv03gjZwFrnDF9nD4eMKx9ix7Vbwum2GnOsLg_tK4Ts17-2ORIlQisx3JTn8aY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzlUDQGbUPmD9D6JEagRS5MjiF1U5pq_zEZZ60NFtH7w&oe=6B0486B2"}, "display_name": "EVERSLAUGHT Invasion", "keywords": ["horde", "coop", "survival", "doom", "multiplayer"], "long_description": "Get ready for the ultimate VR action game with EVERSLAUGHT Invasion! Choose from three unique classes, then team up with a friend online to take on hordes of enemies and defeat the Great Corruption. Run, dash, jump, and grapple your way through large dark fantasy environments. Upgrade your skills and gear to become even more powerful. A wide variety of melee and ranged weapons, unique character abilities, and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill!\n\nHIGH MOBILITY ACTION\nExperience complete freedom of movement and awe-inspiring hand-crafted environments in EVERSLAUGHT Invasion, where you can run, dash, jump and grapple without any restrictions in VR.\n\nARMY OF TWO\nTake on the invading hordes alone if you dare, or jump in with a friend to complement each other's skills and weapons for endless fun and replayability.\n\n3 DISTINCT CLASSES\nChoose from the game's three unique classes - Warrior, Rogue, or Vanguard - and unleash your character's unique skills and gauntlet weapons to face any threat.\n\nDEEP PROGRESSION SYSTEM\nUnlock new weapons, maps, and lore items in a deep progression system. Upgrade your gauntlet, melee weapons, and character skills during combat to become even more powerful!", "short_description": "Get ready for the ultimate VR action game with EVERSLAUGHT Invasion! Choose from three unique classes, then team up with a friend online to take on hordes of enemies and defeat the evil Great Corruption. Run, dash, jump, and grapple your way through large dark fantasy environments. Upgrade your skills and gear to become even more powerful. A wide variety of melee and ranged weapons, unique character abilities, and physics-based combat means every battle in EVERSLAUGHT Invasion is a thrill ride!"}]}, "developer_name": "MobX", "developer_privacy_policy_url": "https://fasttravelgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://www.fasttravelgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": n
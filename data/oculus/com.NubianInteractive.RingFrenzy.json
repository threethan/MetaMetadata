Rq6xA1KNyuz124PBOrj3saTpH34VsZ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZloYPHG-OcCJ3gKO-MB6SEJXGIZSuy_vub159jZcveA&oe=69A57C31"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_kHFxY198YQ7kNvwFzA898&_nc_oc=Adnm2aS_xN8l-QBtLE0aMxyU62vG-A28K3WCqA207SKRnHGfMOVqOzKroHAI8PB5XIs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afs3DzN8GdJvRw700o64Cod--XnDVv2lK8k1Q-oCX2_K0A&oe=69A56F1C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_Trzu6QgAUQ7kNvwEGS_dc&_nc_oc=AdmoBwTXA1S0TG6gXpwDxNZNymk06oqUM42Ye9MgeKH0q1FPJuIEjee_YPNGobviV8g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvbPj8eg_FiCOsTG3AuKr9RGB9IuqfU4W7uVNvrmW_MOg&oe=69A5721E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMs7ohD0-g8Q7kNvwEyd0ko&_nc_oc=AdlRx7l3fx3YP6QbabQGKJvf0XuUloMIFJDcp5YmJf9hLiL_Gfpy54Ul0ewrbKUVY6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftpAjZIN1IVlukSQuNHJr6JzPMjnoiqIIIMu2xyRBN6qQ&oe=69A59040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuXJMEHflZAQ7kNvwG5c4Wm&_nc_oc=AdkSo7W3eLqMKlWqktwcks2M_t0ePaZpGVJ4h3Tu_Hn9vBwLdPt-CK9O255Xa4LKD78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuLDrgP886mRBYhxwAijJ9MtduLBfNvdvBclJXrCbZtDQ&oe=69A57BB5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
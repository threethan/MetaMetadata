.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNjzrWtOox0Q7kNvwEpAQTs&_nc_oc=AdrvRfY2-VW1TLNJhB014WTCR3PRYzJNWFzzVR2s4je-llKYVDKkIPuKFG-uAlFfAog&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8ul0U_09mP7wK1SuchybM_4jx4oGuQHBUeozOZXCLQg&oe=6A8ED5B1"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COlavHLLeUgQ7kNvwHtHGBi&_nc_oc=AdpvY3H6hRWPGXbSF1PoYoxJmaAErwLkIYsaUV_JAPSEpk_4POL1Y0NszAxzgHey0xI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBBPEZ1m9eQXceflGPSnayrfEIMXJ36o9mo_Nx1N6-Dw&oe=6A8EC89C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNJEmt-hNQQQ7kNvwEpAZ0Z&_nc_oc=Adpglmzv5aYo0m7FPWi62oL1IH7lrWGLWUWtpOSTmsNQwtbmd0cBTkoIcUjdKH7-X-Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMRsRRocZEfQbSzQy1oCLpRfdFFYCZnU9wTeH6RSE53A&oe=6A8ECB9E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFxRBle_FkQ7kNvwGtrD3E&_nc_oc=Adpe7iNa1SL1hiQC6gKcg7hNp2idW7_hYVQ0djVyjI2UTjAry2ZCQ8Ww3pg_lNUIA94&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8tuJ-Qb_WlPW_hfGGrZwNzuqNyXjhbtJ1TB6blsJKVg&oe=6A8EE9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lqgvtbTZRUQ7kNvwFSkvNM&_nc_oc=AdpQo6KKVMsZw8QaQOnOIquIoOL7s5k6Xi7AuVSpoXiTPeQkvjPZ2xgWDl_6PF3MU6s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfqXQbuCQwpdURUkyOkMPVWzhXrvOk6NHyJe5p_g4qJg&oe=6A8ED535"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
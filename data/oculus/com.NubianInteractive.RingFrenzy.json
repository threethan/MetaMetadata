0j9HqVWg5Be5td0ck9FEzrh5lhqIHT2QGpRhHRGavLsOfYg53qlnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsMYcv9Vs8MtQcXBWl9171h6llJJB_uYE-bMzUD_h7Mg&oe=6AF5D5DC"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yON5aHlLAIsQ7kNvwEywNx1&_nc_oc=AdqR5VWQQxLizYMk-CVLi_pWKU34sVs3ISDvADMTfCPJ_oZ0tjDdlFGQkdlzM8TqMaI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUvxjmjj7j9VsjVeH3QFQzf5W2zNwU8bjcPLMNS4ppYw&oe=6AF5D8DE"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2SpvswG-8IQ7kNvwGRwhah&_nc_oc=Ado7Tr3_Y8Iwetec4TNaXHbcvoKb1KyEtFk3l2eHQujLEb047buHgmIeBoziLBVwroc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJmAIBAhTvNGGNE6_GkQoTCVD_kRJmCXv_dVrZOC4PsA&oe=6AF5BEC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EL_m1q2bnOwQ7kNvwGkCw3t&_nc_oc=AdqAfPchHAgAHmtn7CPWVJhGADNzlebeXmiZnz2ZUUvQ35xLM09clt3ZbGa00qChzY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPaWqrjxp3YJpkp8X6bGhCQHQ1QszUS2SFYW0RxWewgg&oe=6AF5E275"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8955337994516873"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1269781367537488"}]}, "baseline_offer": {"id": "1269781367537488"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730419200, "status": "PUBLISHED", "id": "1269781367537488"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": 
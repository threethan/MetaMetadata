t=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydHE2SJ_dtAQ7kNvwFmJUs-&_nc_oc=AdqPv1Wl2Znc0v1vt8-wzL9wtVlucqHBJavscclHWkSzBWSa1Q52Ol7-ZoVbVgw0bpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DnEli674JvLwqpmKGlZX7U7eD3EwaCrXPV5azRgHJVQ&oe=6A01C531"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Flvi9cedQcQ7kNvwEiwHYt&_nc_oc=Adq-b0XPu-dWVG5JetGw53pVvJN5EaH3qNYyopnBw_lj4L2TlUMbMlNSTCZGmmfXvRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qr6_KWiAK8TD0nuE9mfdzEJYJd_HO1rPVzcn3xtfdzQ&oe=6A01F05C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNxcdvt02y4Q7kNvwFVRWof&_nc_oc=AdrWPf780vWnVqKChUci3jgm9Yb_SFN6ltC6AtiRwihJ6PhT0NJpDuOo9tSIAXOS4lM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rMGr_a29ZTh2KeRx23ZA0L8q3CRj70CMZxXaX3SWb4w&oe=6A01F35E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVP-emD-qP8Q7kNvwGIUO8C&_nc_oc=Adq1QcvdKljRddk2vkrgi84FLZLXCN1-RGqc5WUAAH8UTl4prjBDDlsmU4ei4evR0fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C2yMGPpikHozMYW3k1tpT8IuvIU-YHSlHnPG0sIzMkg&oe=6A01D940"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngNtnwcNvBcQ7kNvwFwibeu&_nc_oc=AdposCgLKQDAZw-R5j_Q7-_xbBsNScbsxP7tSWUMTb1HkvknGrKMwLGa6U-nvSWvWvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67jxnvrK-CMNhaQuMssk_OUUrgwQe8R_i13o7qCYVpJQ&oe=6A01C4B5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"
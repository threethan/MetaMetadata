rGpkwPfwimB_Iq88lK_mGYJR6Rfmjbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsjrMdqB9zox3WLNFQPZUDdC_QwUlhWH0J2fsDofBqJMQ&oe=699C41B1"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN-qDxm_4UkQ7kNvwGCwwCK&_nc_oc=AdlRmfdoarleVunS7Dvmma1WDeBDmC5PEc2TCAeGjKbkIdeBq8qnXSG8GiEIMwJm1t0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuK8ayXCW1J0lhNyB4bBQeci8MSe37LUgZjqVY63OLILQ&oe=699C349C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wJajVsSSvsQ7kNvwGLsoME&_nc_oc=Adnvd9mXTgiosG4gQZ8g4kxzsMYxeP96rzET9vzx0YnWXZ7KNzl9LQM1_Dp2ay7haC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRlUj_U1tPLIKgcPh0UFzv6oRq_85RDJmQIhyPToM2XQ&oe=699C379E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZOkgDevEvQQ7kNvwFY6EBJ&_nc_oc=AdkoxiHgtIKaBv1fb5aIYdyQ88sNyAFg7A-2v9ADfitcjL32PBd4HpikU4uv62S_EMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfswjAXHrrDZECRcO_pb0Fgg8EdgYbgKUtDSljadUt6hbw&oe=699C55C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkSq-wYpSLYQ7kNvwFUt95x&_nc_oc=AdlpeFdXIfT52USYZOfa3TV-PG_eDLutz2PjnIlXCm6G8PvGf2Kf8oyGka6w9mnoX8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1zGwwtDGwxNJQkxBZ_KcaYNbA7MFdbsR5hwsKbwt6Jg&oe=699C4135"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
_ohc=EyezMDV00qcQ7kNvwEGyIFc&_nc_oc=AdmLN2o5IiAm0lRtiB9DDikJIvtcfIvFzGGCMs214qdilVHgJcsFul9xa-21GjWMxHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsY0evrJHd2y5QxnccnzuSNKXy2vu6OvTgmMR8PETFug&oe=69BBE5B1"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4P89wAxPx0Q7kNvwH3UUTb&_nc_oc=Adl2IIge8LoVMb2m-KHF2Wa1MuyvVlLiUn93fXpbUOugDt-5U-Kh3aaWREdtcJdEqEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFqaQvBQ-f1UhvRlIb1dJ4-0D1pRTBXOhOs4aTiewK8g&oe=69BBD89C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ruX83JX9uEQ7kNvwEuSY29&_nc_oc=Adnif5GGXUMGFlui6HnGVqKk5RUzc4QCRB5wjNHnhdyz3ecNEayWbF59JmUvTg9gfsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMBmuKIbtv8DzoM2W7sv9I25_saKiNGSi1ypJOohUKgw&oe=69BBDB9E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNsb4botUUkQ7kNvwETg02s&_nc_oc=AdnGDZtjHNzd20kbMlXso-Pi38RpQq_ZsLqbwrq67l33GTJeMPBNMNvWWx6dC76UIq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ9J8v9A0obrKXp52Odd6hl3inZyGKgJ5dilukGVsHpg&oe=69BBF9C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezABcsqILLgQ7kNvwG69Kus&_nc_oc=AdmlhQhQUHu13uPwPLAsDL_G8AJ4QLmRjUD09_TH3Ax2U-ysTUI1s4zN5rI2ILhS8rI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfySjIWaSJD3jADcWVD3TZVp_RpGQ4_ZaZge3M_P3B_2dw&oe=69BBE535"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
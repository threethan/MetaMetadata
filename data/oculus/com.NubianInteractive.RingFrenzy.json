cdn.com&_nc_ss=8&oh=00_AfwrbG-R0ygMhrgKiJuMJYj4eSdptZsko3glnBJKujTe6g&oe=69B3EF9C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk3dFCG84soQ7kNvwH6XnOc&_nc_oc=AdkaI8fS7v4W2CMU-Er0Ub4pnwiskH2mvpdJfmNhQqk9O6wpBoUJSdtzFEHTWC8GjRE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoDwkcFd-5rLtFVyDKg4marn5ow8gHCCY-NZICh5sEiA&oe=69B3F29E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQ1UdrUsr08Q7kNvwHhsp8e&_nc_oc=AdkIu6UYcMGpf1RuonqmBWv485-yFUSTYa2f5ljPBu4XonLVIsqASbMW3PjlfiU8h7k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuWpGr9SgS5Tm4kaqENcGzJgBGEnj6bzd6hH7Zurf9wg&oe=69B410C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6SH1aSviD4Q7kNvwE9SLoV&_nc_oc=Adn12CHSR1gZTQdhhubLk-uJJuvH5lBawERyg3aM3k_roHX74PSnzRe878Ozr7uKfaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzVYyu_9Ycdf-f8JWTQHGgPhbJWiPQOIp_kkUSG78VTlQ&oe=69B3FC35"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8955337994516873"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1269781367537488"}]}, "baseline_offer": {"id": "1269781367537488"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730419200, "status": "PUBLISHED", "id": "1269781367537488"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8908428422541164", "version": "0.8"}, "id": "8
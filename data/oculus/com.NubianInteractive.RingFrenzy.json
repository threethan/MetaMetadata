_ohc=Q4NQ69LDKM4Q7kNvwEsTmXx&_nc_oc=AdnHbztGJHX8HJ8bzZ2s3daa9nMOIBrz3_X2k4UyVTHyKjjP4xO2vwAhh9BVCiZo2lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJTGYRDHaajBKrklNeyldlsqEyQRUm8qilNnJY1vuwpg&oe=69A81F31"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qr0tkefHSVAQ7kNvwEyGCTp&_nc_oc=AdlMd6kDoQhmE1vSEypbujpPocaW9rivpoAvIsIvBGYoYUp7w0ruz7HfJesCom_Gm6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs4MNR235aciQ8Jmhx4oFivNyvWP6m3SBpa7z6M22M_IQ&oe=69A8121C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjOSFJRehWMQ7kNvwGQ7szi&_nc_oc=Adle5kpT2r2Eu2I4GV7CzxhTQaxDPhX4Aswfn9iDaC8JP8INStP4GtQ4z1uKK_qAVM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftShsMVfOQKNdKAROB6HdZoEoWOtfD6ksI5L4AcPjjAJA&oe=69A8151E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCpibspcMkgQ7kNvwGE7Rf9&_nc_oc=AdmDZXOTFHM5a_6eSW6nlaG_Le4SHnNwG7FX9bbuuyLc9rbAnGSug7Nehuj1rDtMLw0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvLdhmckXrWpN1NcPwXjmDXX5YC70ocRqgOJMKHFZOumA&oe=69A83340"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSibFybJRyQQ7kNvwFnsIRk&_nc_oc=AdmYAqI6kgIY6rDJpSbd2mOI9rpVh9uWYYTkw1UsNV2tYaqL4saDIeSDoW5mb3pjV9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5HBdFIiNxGU-3twn1oLSnZfuHJamifvlPMd2DA-QvZw&oe=69A81EB5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
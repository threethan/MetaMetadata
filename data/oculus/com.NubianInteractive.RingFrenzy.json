.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNjzrWtOox0Q7kNvwHnXQ7P&_nc_oc=Adpv93O1b9zFPQC2YpTupuQbbaq7BqziXD-PTLZJAVPJoeWYgLI2ZUfPJzfL2RzGbkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdg983VedG5gCnkI-UQ0QpUbikTot2ne8Xb4WWRq5lVw&oe=6A8D8431"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COlavHLLeUgQ7kNvwEo3hQM&_nc_oc=AdoObhkGHUo1OIwQeFuXDSJPs1MMHTvSJn-wwYNJQ3OtI1i3u4U4a5kzFAjG7tvYmRI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAxfhBXlq5lIjwgPbzordWRZQ5k5iBDl2Mv8ny1bvyAw&oe=6A8D771C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNJEmt-hNQQQ7kNvwEBItob&_nc_oc=AdrnsVAqfFZuT_3goUcTF9Q-B8yUS02JlsispBnbjJeBKlc1tyo1cwd8phmPTdFMeP4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeQyfTyPx8Q2y2bDf0qhdYChQm0zMf0c3182zsf4639g&oe=6A8D7A1E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFxRBle_FkQ7kNvwEqD7Nq&_nc_oc=AdpIsFgsenSlN0zbw8w33S0d_9-NELHekk6c7zEdW1jx3Ex3REN5R-R9IYmvYbMobJg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqemps12TNILzws7DixSRl857P0uxpNMcxDfY7JJSExg&oe=6A8D9840"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lqgvtbTZRUQ7kNvwE_39yW&_nc_oc=AdoFdwIOoVMoc09zGqJqdz9nP5JIAav0EWLpLny2pNqK0u3G78Z_butI0iO3ale_C0A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXqAEoeMYq_oggeJWv9mAT1kBSE4qPWCnA-4LvuibVoA&oe=6A8D83B5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
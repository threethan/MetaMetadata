_ohc=EyezMDV00qcQ7kNvwFoTiVN&_nc_oc=Adnd8bfRdoxDUUx2dd0jRmqjH8rKZ4J_XLcw8XoXVudr9B48yP55n0lfze5VB50u0Uw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwnz8Yp8jR3raTcaK5dXEBh5mTQ8s7O4q3YlpPvUmOuJw&oe=69BE88B1"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4P89wAxPx0Q7kNvwFcllh8&_nc_oc=AdmMRtx0WHpnOUUPBPF8Fdpw-nrh6hw6mSCJz2FIiB25-FZ_-SaFsmgazZ6hUbz9uWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyo6XeVRXDN5KYFk-eBCKNlKzm6NEFAYHyOyAVCKjvvLA&oe=69BE7B9C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ruX83JX9uEQ7kNvwFOqb3h&_nc_oc=AdneY_afB3BrEo25Ye7liN17y7yMapaEgUX4ouQ3IRMwmnOrj3piEiIjeQ2gJVpzstc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMilK3LHwvHrHc8BcoZqH63ISR1Bk-PjFgMbR_5-h24A&oe=69BE7E9E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7-Tx-95Z7EQ7kNvwGVSqjR&_nc_oc=AdndWBlOzJrZSea5qqKh3bYrwf-FpFdM4ePMPTPIueGl6LH5Q2Eni9b3fOLuKGW0VZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyetbpss2PkdvKQ2tSDPZn5-td7j-Ikj7JBPErFj2rzfw&oe=69BE9CC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezABcsqILLgQ7kNvwETjIqz&_nc_oc=Adldo14La3H3B4--eHC2tRP_vxlS-AVFjak0DVMor5RV1S3_LNy8OL_JXAkPIOhLebw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDNxiV5ZEz9ZiR4gz__B9qjETGSKAUJaYkgO_8uHGNAg&oe=69BE8835"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
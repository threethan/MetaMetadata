Jf9jiA4Fh1u4gkMsKW0Pn05nBM9J8sY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZcj9lxxt2ZdkFL0X-YIiEe56JmFsx0StxRotCurVX7g&oe=69A03631"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQO5WMLgX0UQ7kNvwEv7E6c&_nc_oc=Adn9fe82oqlrqSdNGek746-_EChPtFftH_2OCCXEqmVeyJIwOt8dFODZuAkqJn80kJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvMIkQ4zuw2N8hvrcoJDyoayrr4yPHYaUZHloWGBIYLw&oe=69A0291C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL_cJXWIHlgQ7kNvwFtN1fG&_nc_oc=AdnTtjgcJFrYBzgu0UGGFT4x82MQSd3TIHb113qFBq8kMxgngOJgWwwmUBQ7Moh7LOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu58_AD7959k8OkkYGv9mF9hqHbwDwzTAwuuUcxfN6TUg&oe=69A02C1E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2j2QoQJlgIQ7kNvwHyYpjK&_nc_oc=Admc8yrhJJ3PZWJHl9vsyILk8kPhN9peviOUw7554Mc4DqRn5tmOti3iGi9c3xRCDgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsyef4ELTFY3PL-Fzz90UNYaLUTjarKmYOPz7WPKbY4rw&oe=69A04A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CqFAVYXbLoQ7kNvwG8a7lx&_nc_oc=AdmspdzPM-D6lxJW6jrM0p-2k_lIqDkUqhy8ns_E7UAkIvi6PpZJDu6WBfAgfqmCsrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9qUcDbLD03Qcy1DNSzn0G5CfJSkrKegBgVgzCf29_pA&oe=69A035B5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
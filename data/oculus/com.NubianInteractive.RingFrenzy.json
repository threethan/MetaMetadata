.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0S-VVqosMzQQ7kNvwEW8Hbs&_nc_oc=AdpX-j1ZbxhmZ5PhZKchHZT1wkHUWOdp-QnNUyciiQHSRW9Zjf8iP5jpuJdu07YBKtU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbb3bqr7fLapLMun1d9LZc9kq1ewi6EigD-H1tzx5ThQ&oe=6A859B31"}, {"file_name": "vlcsnap-2024-10-23-15h21m05s645.png", "id": "522577800702173", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974634_522577807368839_7325523441633825390_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RllsA9jN5fMQ7kNvwGgW5Yb&_nc_oc=Adri6P81U8j3v5mw_ZaJY5PfDcCbZXciHmrpJUUznyVtnntvXK8BylyoZJqJrJka3cg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqtOaZ7ZAy0yN2P-drFLNV_2XxcIl__s05U1sJrx4C6Q&oe=6A858E1C"}, {"file_name": "vlcsnap-2024-10-23-15h22m13s001.png", "id": "966561935486353", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982672_966561938819686_8931337439144776055_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXgAma0lAHoQ7kNvwF52RzO&_nc_oc=AdpkIq7pv_fEFTou3BJJjYVcyyl2QQNFw1kKEtAZh4Sp8fA7c4VqIhUf9TErrvagJB0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiIWdJJcppDTvO7noHTmWmFo93SjvlXrBny8tJ_ikb9A&oe=6A85911E"}, {"file_name": "vlcsnap-2024-10-23-15h22m20s428.png", "id": "2209043082799029", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974468_2209043086132362_6260216604599672581_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gSzWrg_1LwQ7kNvwHWkmLp&_nc_oc=AdqOjx6_0DWxhZg4GF3Dsmowk5_7VN6A-tjPhUXFmJwWw9cTvLq9vqqUF1u8UGNkG0A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnkSkNN6HDlzFYVy9ISEgkPjGdYiWFsRtamz3WxyR-dw&oe=6A85AF40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1078427330265828", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036693_1078427333599161_2916351536957098552_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7k3Kq_rKlC0Q7kNvwEJ7txU&_nc_oc=Adr1GhHss6Siz-Ge0y895dFQQHyDu1xDd7-YYpnvW_S8y68dtTtI2EnTOuv81tgExfo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELuTMXulsV85aQcAvGJ6Qmdq3M8Z8lo5YnGWBg4icTIA&oe=6A859AB5"}, "display_name": "Ring Frenzy VR", "keywords": ["arcade", "vr", "fun", "rings", "timed"], "long_description": "Welcome to Ring Frenzy, the ultimate VR game of skill, speed, and fun! Immerse yourself in an exciting arena where you must grab and throw rings onto sticks scattered across the playfield. Each ring you land on a stick boosts your score, but with the clock ticking down, you'll need quick reflexes and precision to win.\n\nWhether aiming for a high score or competing with friends for leaderboard domination, Ring Frenzy offers endless fun for all players. The intuitive gameplay is easy to pick up, yet challenging to master, making every session a blast. So gear up, step into the frenzy, and see if you can handle the ring-tossing action before time runs out!", "short_description": "Step into the fast-paced fun of Ring Frenzy, a thrilling VR game where you pick up and toss rings onto sticks to rack up points before the clock runs out. Challenge your skills and aim for the top of the leaderboard in this addictive, action-packed experience. Can you handle the frenzy?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/232cb537-bed2-4054-8663-ae1344f15d80", "developer_terms_of_service_url": null, "publisher_name": "Nubian Interactive", "support_website_url": null, "website_url": "https://nubianvr-website.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
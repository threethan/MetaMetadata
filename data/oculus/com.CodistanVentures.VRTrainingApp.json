3&_nc_oc=AdqWUh0Nqz2wGGjMsRpiIBr_Kub0SCy45GAaF8k2AvqEcHKhxI2NFabgBZ9h6eZ0bN8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uYGrYM6KXbDcP8j7NrRiNFSXbTTIqwpypfQLvD6LiWA&oe=69E8B064"}, {"file_name": "Drawing Room.png", "id": "2039548653251546", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_2039548659918212_3710088163694994800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoMdiU4RBRoQ7kNvwEVbIHD&_nc_oc=AdozkQGQGBQAKK172DG4_cNZP2ThUvOsRd0Ja3D-APDy4ZIGpk1b0CVrUnAb7DNsZSg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2j15ETJ4TIr0mGjC1SP6dyXVYrIkee4WAsCxpmFxsTXA&oe=69E8DEAF"}, {"file_name": "Bedroom.png", "id": "814325174824667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818852_814325178158000_2628964375145731238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpmZ1VeAq-sQ7kNvwF9OtRl&_nc_oc=AdqpRzmRuoUoO2w-6otSZT68324Fahrp3oRXdabCekSDlBMKPiC_LHV4eE4UTuup1gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14r8Le3b9J_EcTgJ-Y1JfPHbAdckGcSS-aTJLDO44pEQ&oe=69E8BBE5"}, {"file_name": "Bathroom.png", "id": "2625387161154572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_2625387164487905_9122555891326015309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HHWSToSkLUQ7kNvwHi3LQI&_nc_oc=AdqSa0lSZzqovaMvT7smfCnSuxXxCppTIt3C69kRmd3RZ97nfGYoZnV5jVk_fvJPVXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gsRTg5NsQqp44c441K-r9P4SLKw-LVWISWL1clreaxw&oe=69E8B189"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Homecare VR", "keywords": [], "long_description": "HomecareVR is an immersive educational VR experience designed to help older adults and caregivers learn practical home safety skills in a supportive and interactive environment. Through guided simulations, users explore everyday home scenarios and practice identifying potential hazards, improving mobility awareness, and building confidence in navigating familiar spaces.\n\nFeaturing an AI-powered voice-interactive guide, HomecareVR offers clear spoken instructions, situational guidance, and personalized feedback to keep training sessions engaging and accessible for all experience levels.\n\n\ud83d\udde3\ufe0f Natural Voice Interaction\n\nSpeak directly with the virtual guide to receive tips, instructions, and step-by-step assistance as you move through each activity.\n\n\ud83c\udfe0 Realistic Home Simulations\n\nWalk through lifelike virtual rooms that mirror common household environments. Learn how to spot obstacles, avoid slips or trips, and safely interact with everyday objects.\n\n\ud83c\udfaf Personalized Training Experience\n\nThe AI guide adjusts its prompts and feedback based on how the user moves and responds, helping create a supportive learning experience tailored to individual comfort and pace.", "short_description": "Interactive VR simulations that teach practical home safety awareness and hazard recognition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-1wY0atWgVmgkAbyUqtOYwSVTfNZeRYvHHdkjwAVDEw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HomeCare VR", "support_website_url": null, "website_url": "http://www.homecarevr.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24874819775534068"}}]}, "scheduled_offers": {"co
y&_nc_oc=AdqtdnR_-wh1JUK0KhTQKypPPHqN6IDyjHuLlmNPGqX_58Bd3XugoWByPWt53tIzIGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28PzlC57ouLKoIOCgAaot8m6WlGzt3vYS31g6ndpEwhw&oe=69DF75E4"}, {"file_name": "Drawing Room.png", "id": "2039548653251546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_2039548659918212_3710088163694994800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pehPqAImtnMQ7kNvwGkL_Oj&_nc_oc=AdrOTsBjqTADL5fLGi146YWZQnYfyxVHtbJsa-sz6I2oUc8sBgWcVDZqdJAY9Pb-R3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W0z9OSp0_f_jG2TSmXXTO5gfZAN7vTn6-Zf7a6H3uwA&oe=69DFA42F"}, {"file_name": "Bedroom.png", "id": "814325174824667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818852_814325178158000_2628964375145731238_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joWjJ787OJ4Q7kNvwH3GWHc&_nc_oc=AdrlEzOeP7L1hetj_7qHRmhbNC1wLjq_bx2dnBwrwO0lqZPAAkRm7LC-W_v36yzOzfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15vChUfm2--YvSkmuZ56XBMkkl2-PNN_ZxcuqfDgTO7w&oe=69DF8165"}, {"file_name": "Bathroom.png", "id": "2625387161154572", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_2625387164487905_9122555891326015309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ9__LaeSFAQ7kNvwGtRWpF&_nc_oc=AdrfKRDOGXVIB3J6BcBrYa0Yhb8OV4-q5UvWmJVhHstsziOJE9tK3RHm313oRl1MkJY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qzytuLPCXOh70xnYzbtIgTXjTAr6dgLrl4yR1sy9CuQ&oe=69DF7709"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Homecare VR", "keywords": [], "long_description": "HomecareVR is an immersive educational VR experience designed to help older adults and caregivers learn practical home safety skills in a supportive and interactive environment. Through guided simulations, users explore everyday home scenarios and practice identifying potential hazards, improving mobility awareness, and building confidence in navigating familiar spaces.\n\nFeaturing an AI-powered voice-interactive guide, HomecareVR offers clear spoken instructions, situational guidance, and personalized feedback to keep training sessions engaging and accessible for all experience levels.\n\n\ud83d\udde3\ufe0f Natural Voice Interaction\n\nSpeak directly with the virtual guide to receive tips, instructions, and step-by-step assistance as you move through each activity.\n\n\ud83c\udfe0 Realistic Home Simulations\n\nWalk through lifelike virtual rooms that mirror common household environments. Learn how to spot obstacles, avoid slips or trips, and safely interact with everyday objects.\n\n\ud83c\udfaf Personalized Training Experience\n\nThe AI guide adjusts its prompts and feedback based on how the user moves and responds, helping create a supportive learning experience tailored to individual comfort and pace.", "short_description": "Interactive VR simulations that teach practical home safety awareness and hazard recognition."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-1wY0atWgVmgkAbyUqtOYwSVTfNZeRYvHHdkjwAVDEw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "HomeCare VR", "support_website_url": null, "website_url": "http://www.homecarevr.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24874819775534068"}}]}, "scheduled_offers": {"co
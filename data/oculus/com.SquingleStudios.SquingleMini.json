m&_nc_ss=8&oh=00_AfwqfPsE2708H-2ofsviOHRsBCKhDv4MFIdvhKyb_fLPPA&oe=69BFC933"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFCyljSlwqoQ7kNvwGs3HQJ&_nc_oc=AdmWnYPgw0ACWWCj9nFForCTXyaRYSmWNpYHBCj4DSReDoG276lp2w169ubxzSC4QPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE3wcSGhJ6tyBGqDJlOzRuAG6-QeeKGqqfEhLnRxR35g&oe=69BFD0CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVZjine-x8IQ7kNvwElEkwk&_nc_oc=AdmIalPq-Uc-f-zFaoJ8n-w86jt8yBhcwD-tpfRv3_evq0klfklIkr7hD6gcxZhLR9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyfy50IMAF67R_xazow8HIhGNsA1YsuNXRUfzsPcqr76A&oe=69BFE104"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6olFTUgfzHEQ7kNvwHs3HJp&_nc_oc=AdnnnqPNWP995dn947n53dDoQDRreS61jhHWIICwNb_fX4vWiUNVrWZp5NY8mUjtItM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGFkmj0IgpYiCJdIym7IP-oYT9-Je-77zcjroA8ZWTog&oe=69BFE6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8OAzvZZ1yQQ7kNvwFJz4rU&_nc_oc=Adm_vuKz83OUhOqEyKfH2PSkMWS5jvTkuCNetIdnyYxyiWiMLg6_pFIlv28N2NO5hPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyewV_IwpzF2Ipr8uNHHm48NaIo_vF5HgZujzMO5oNqww&oe=69BFD18C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "\ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/p
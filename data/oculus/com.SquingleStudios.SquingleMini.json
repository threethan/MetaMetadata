6A676FF3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoEvPGEoZ60Q7kNvwHO1wNx&_nc_oc=AdobxEwOA0LUI9x-MMKmcwNHv2Z9_K6kOBwz-ZPPGLjmktazM1tSuqdhHwLJ3ovgaA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQV4Ib5GtPuy9CXXpkEuPDQIFb5Q3MXaeVXrYGsEFB4Q&oe=6A67778A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imc3xUB_BnoQ7kNvwFbHDiY&_nc_oc=Adp2zkGTIvxHRfZj4uq9B8hASuwHYsr4Z24lnygtc7JhPFhRmjONOASF5m8lzmUCg1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHR9FDUIXlVBBFq3YVbjpYdMLSeY9VAUPiw_zD9aS1uw&oe=6A674F84"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1w82DIx-_gQ7kNvwFuPi3x&_nc_oc=AdqNuGzPdewWtamWVql1DVEMkHc4paCYp4OD98eUDe6do1-24rVh9YF_LvrEJcOGzDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNeR3DQkduxwx0xv94W5vx9suq_gPyzqo6XUZn7rRcsA&oe=6A67555E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TE00f1C5KoQ7kNvwHAiItg&_nc_oc=Adqp2RDrbOEgIjQK71Vyoru3bjDZ3WTZXuFBLiNnOffh4yjEacqxckT45-gKWPRPP84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfO5ynUGTep-hqIMykdebuqFr-DAok453CwiZ-iRGGwQ&oe=6A67784C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
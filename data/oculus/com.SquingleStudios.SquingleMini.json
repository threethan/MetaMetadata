p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f0QqWbj-SoQ7kNvwF6TruL&_nc_oc=AdqOSbwPfawXgMfqDubovC0wMoSGuHWplellBOGuhAZnJ49KcfP8KYDsrBY3moi-xw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCg5_4t-78mNg18E8luGdkSmzFkISqJKTJOFI75Qf3Uw&oe=6B0846F3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhlWesez0zgQ7kNvwEO-N9z&_nc_oc=AdqUgCMSf2pMB7E5Lu-oC8ZFstOtFuTc07BZT4oBCHZPbndHGrMwtnAeM6OwXWppU4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQwN1giRiwkbv-l6LQVbHR7DoP-FMEM9_T9dw4rvRiog&oe=6B084E8A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DaDDR0-qqoQ7kNvwFBBxxN&_nc_oc=Adr5_URPqhfVMh9LDQ7haVZ4xLjsak6lB_IrMHkpYEFUf5pRe946dE_6oXzrefdT4HE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaFhD2KldzVHmUG1Vi6Xb87JL2epL8xVHED9C4u2xxSQ&oe=6B085EC4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hvw8jET_94Q7kNvwH3WrWn&_nc_oc=AdpRZPpGhWCW-u5iRAr84-mC-v5sYZdeJyOSvMJtzz-ZtIO65PrLjx6cVXeBB-zKAGM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4lsXhSuB_XxgKn_2hupGDbX97QnDN7Bgcbz_3Far_lg&oe=6B08649E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASxbJp-68IAQ7kNvwEh3LnT&_nc_oc=AdoHOrS0VENylGca6SLATDctFGiLzR-MFkHEmEBwE17OE7E9Xf2woXAbAP-Iews3df0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvxuVbrZhbnY47XzjzSNs_Oph8afRmIuBotkVdhWN_Qg&oe=6B086167"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
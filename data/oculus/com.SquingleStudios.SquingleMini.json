p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omw_Ynl7vuoQ7kNvwFIvx3z&_nc_oc=Adr9mxUQZ3G7q9vqPkw9h6f0NWPjF-hVTL6vKHFy_0ZdxluWmOq7y_uDtcxYolmZLy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLknXp2MLRe3lFKqYS9QA6C3hQE_zV3JMmQBV_HoMzNQ&oe=6B0DC533"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCHYXKnmEaYQ7kNvwHbV9lF&_nc_oc=AdocputD15ajDFTYlrFkvflNtldEsb9yxfGgVQV8qQlhLR0AnvR4KLweocjkTnVJeTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9wNQKUYxb9Llc0VKnEwYxCw2qOECMAnLVUYLKwDdkPQ&oe=6B0DCCCA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPW4LUj0DaUQ7kNvwGPpNlH&_nc_oc=Adp-XJV2RR-3oYHKhFfjmsVEvwyIlw7eK4mpYS1BiMc-rrWm2wQ5EWi-Bt1h4LBSUsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrhfK8j85JKDuj8Nte8NmEHXBD2Kafo6Hsz6u9P69cUw&oe=6B0DA4C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87wsc0Uv1xQQ7kNvwFQi0Tk&_nc_oc=Adq3ZPqVWDKJaSZO5Kj9jMfli_3uEcAEEEXvioIwyxkE1VmlHfcaygteA11zR7ZolHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZ-CUQB7zh4hk0NyPYsP1UvghmOeRhr1Cp3paiQOsQqw&oe=6B0DAA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZfwmucWngsQ7kNvwGsl83s&_nc_oc=AdpQd2eVW6vgRwF-DamhO772Vmy3OU6VY7fd5J9wW756d8pm3Tt7RE9XNWB2i_KJRYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8696mqBUjgxnr4b373IvHShxOCPleWrBjg4J1Krz2CA&oe=6B0DA767"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
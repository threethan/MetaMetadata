p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtOYtceZWtcQ7kNvwFlmZPB&_nc_oc=Adqj2_HgMaSArODmHQkjGAMa-MOi0KqrNdOS2-bVsPAWNMd9biNdHayU8d0u3eiOntQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl-0-B3eUIf2AEW9D4Q3MfYrzL3857W8RxUbyE8Y4Tug&oe=6AFB17F3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV6YojOiaeAQ7kNvwGlOZF0&_nc_oc=AdpAxFp_IPhTA_sTDiNjpRqivHTCjJ24db5-Ad1Z3ZTEl6dznVNunlzQESK6NK8pmp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ4obi77z3RI38QzblLG6Y7XjKyG-CJPq0jfag4-GMKA&oe=6AFB1F8A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mp517VvV7cQ7kNvwGYHRvn&_nc_oc=AdpcLZwSGIKQgeDWN1ZKgDj__14tw4a1u8IzfBWLK8zgVw4PNVFsb85961xIGu58HyU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdYsBeN2I1jUWb8wVoQSwCNCzFC3GuBD7Q2XbrGgK1aw&oe=6AFB2FC4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG2FsB_IBvYQ7kNvwF--wCY&_nc_oc=AdrKn8LmxEDWk9U1YF5lVUDHcFcBidRrruDID2zN9nY1Fw6Il5Vhsu-FagRB5yNCdAE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtgcsW5mia0m73-LWE2SSPbeXstyQ2J6srwCqBuHn_5w&oe=6AFB359E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9VrMYEj42AQ7kNvwEBwGzs&_nc_oc=AdovSO6TfijxH0q_ZnwD5_jUKgek72vRPNxWuV5cLWY4VKxyGLbt-KEtWsI2-g3Db7Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOs6a7yrSUpjuc47pGLxDL_dTH7X0vhgEzelt8kBSwog&oe=6AFB3267"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
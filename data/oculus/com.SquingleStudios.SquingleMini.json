o7HFpLiM7eYtaYaouOxQ&oe=6A394B73"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XCKupWIv6AQ7kNvwGkX-ZT&_nc_oc=AdrOKWCr33tBCO1hGZ9FT5yHkxHa1z6k1IxPheqVsB_XwB1f8D8P40FCdAsAzzMiyX8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ss6q2SAGr-mJvbKkfT3DW9f59QHDEKVDY4q3Ia0rf-Q&oe=6A39530A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KKBwc202kwQ7kNvwEXI446&_nc_oc=AdptzdPg7krLj1BNXt-_Hj68ifDV228O_WS8HMVNZLGJ9ROur2NplArEQdNe3LOAevE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pYkqR7WqybatqiItjEdck8P21Hf_pTrxg9bvyhGX7MA&oe=6A392B04"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFvROGiQ4AMQ7kNvwEr4WWb&_nc_oc=Adpc1QP5ZmJNqdfCxBk3VjWJKu7jJqNFCXrjPN2Sn1EhriktQEiAot4buQV99Y0eXPc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9foEMKgjAbd5wIxO-HAj4wpKfdWgz_Q-HlQgbRtLy13Q&oe=6A3930DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgQY5dY_vpoQ7kNvwGALd9Z&_nc_oc=AdosqZcdMtLArJizxKLG-9WeesPEzR4amOcQQmg9dpNkP-CYIbZ78NnT2r51iAQOvgk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__zlFDKQpr0EmXTo5gFOfKS_YdWkmhTNlhkPc6HmpNrA&oe=6A3953CC"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url"
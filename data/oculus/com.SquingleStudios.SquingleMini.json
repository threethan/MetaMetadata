08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjQJXGJ3ZDIQ7kNvwEXecoA&_nc_oc=AdrT2f15AqOuW6f1S3oM2MZYw3eiwdjvioR2Nk7a0wjlg-s9lA1PvjCVvvZWyPMeRQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf3QBW7KQOs-Bk4Xd9w_HbqG2zUXbESes2828EdNtDsg&oe=6AC11D8A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eC0hVqQ0Y1YQ7kNvwGdKCov&_nc_oc=AdqPsz8Tg6ZyR2qzU8f8IWzvpHbm4T88FM5BhXiG91Mj53OgcdsrDSdfEwokLhn-Lao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk2ZBLnrdsxitfy6ubPBOpOlOlfCY47nRyqBq2rb0b0Q&oe=6AC12DC4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGIXzZYmLwgQ7kNvwGe5-mH&_nc_oc=Adrc-qS0zBkE9fabQ8_ckhTawHh_-c8wJUtMjg_quw3IwUaX899YHa4ayrCIOZCitMo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO45Xn45yb3wAhGdOAkW12_MW9tKgBwEQEceHsUdRuItA&oe=6AC1339E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCgSack9oXMQ7kNvwGZwEdZ&_nc_oc=AdrgOBEAqxN0-niecwFWr-wdnCgj6dAdzrB6yceFOFElRO8I5_6WOpBF2TEZc6eUGfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3wnqpLpI60VwdfZO3SRqB7rDzFGBy-01jFbdyy_nClA&oe=6AC13067"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
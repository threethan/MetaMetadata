ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036664_2220938324931542_576396274273849158_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okVf3Lq8EW8Q7kNvwGKQKuM&_nc_oc=AdkQYFrMUTqGdhVmP3dFF4AMn_s2W1D21LT-KsBrdTT2rPRN9sd3K2ARMvVP4-rQbiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwNav3Qoq_5z1A0g_XZGc4irGiuGe1IKK7OVwgeo0Beg&oe=69A80E33"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOVOrwvQy28Q7kNvwFYB1av&_nc_oc=AdmNqbcoAF9cuoevcWkApvtM6SkR3cV9U-qkbhcDy2NwgAX23tOfRLwuVYtCuZVM_7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftz-yhrDzK2wZiCHlxnjPzrAkj7h2pKEPb_ZeldCk2nrw&oe=69A815CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=786GvXxgfAIQ7kNvwFJu9r2&_nc_oc=Adm7KHcKsdufrkjcRxAT3kWdi508m6TjufXRibj3JIvCELXb9xMx6K2oWqoIh4Mc0KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuANZFnm155bmAl2SPCEI7bfBamMin8hIDqszjrpukXXA&oe=69A82604"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNYvAbk3kRIQ7kNvwFh7u2O&_nc_oc=AdmhjUWhZFwVg8Q5f6iqNp7u6VJCLOv6TWBxXKLYTrE-outc4MRVsr6ijjsP7vAHE1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvucNnr2LKjJN0T4D0UZovOXwZW8nx_nz_BJiS_hAAgKA&oe=69A82BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGtyTwHuMHEQ7kNvwG5wETe&_nc_oc=AdkM0zUySbAB4lmm1ZclTfmBZr5NnX4Wt0pcpQYlmdgLSOLaH9sV_T74qphpqWwwlq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftZwCgKe8doQyvqR9Du9XAcQpXot8LkniS-FABv5P2f-A&oe=69A8168C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "it", "ja", "zh_CN", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8945234092165227"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "420305554447473"}]}, "baseline_offer": {"id": "420305554447473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730826000, "status": "PUBLISHED", "id": "420305554447473"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9089326624422639", "version": "5.0.41_mini"}, "id": "1051990319968982", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8807718789250092", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9089326624422639"}, "release_status": "RELEASED"}, "
6A7741F3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gDygJ9iEJQQ7kNvwHFiN0e&_nc_oc=AdrMpZ3wXlLQlQ8_232i1hqwJXtNqNFWodT5MTZ49y1YcfLjQ4742Y-0c8pjvPErV0U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS50-UTy69s0WM0eNLc4im1J9Uej-xLBWoHptFqxn9hg&oe=6A77114A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTRuF47NatIQ7kNvwGxYNC0&_nc_oc=AdrVOnb6-ehzcAbSjLDKWtVGDtsZKOAv4QlswNS7q45O6zQMpk5cqkv_3uVgQqcuufk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPk7RchoqA7hYUQUPLEMwmabDeHGW293F_i13Ug80_3g&oe=6A772184"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyOKJuLe3WIQ7kNvwGdbiU-&_nc_oc=AdpbUxWJKkQroDeadCLJZehGnFwOGfath_Z0sBFpwveEqEpbkD1WUFdbnyv9PN9VbS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ2W4h8wef8O7-y1nPJXxY1ewiW_QRvxZm3HqmwiN96Q&oe=6A77275E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDztO3EgDHQQ7kNvwFJEGbZ&_nc_oc=AdpT_Vb30vdUnprj2ghVagy8itGiUPVCP_R8mlX_lxUaFms_G2X92SEIP5cQEIM4KCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGad95JMexIewsEDCa20EJWETNBJmNFPeqxjcR65SKYQ&oe=6A77120C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
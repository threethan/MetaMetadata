6A243373"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TDrwjAAoFAQ7kNvwEoNSpi&_nc_oc=AdrIZjXj0TQjSssrBrZ6EqMabrNViHRErb7ken6Y9_x76CCXyGSHDCdiO-s68LztoBk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xsqk0G-T2ya0Gx5jqLxUe7SccsuAxeKlIPKkpDKfAEQ&oe=6A243B0A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V8D9YYurB0Q7kNvwGrPtjK&_nc_oc=AdpCKNQyRYVmP5HQqyb9yvxMuodIMhmlVeshb5pFJKIm4u5MwHngH11QZeo8muxYDYY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OEkUTq3Xt8SjmT76ED8mkAeyrurinRXXuJ4jt3rZRHA&oe=6A244B44"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beCl6cG82CYQ7kNvwHAlbJX&_nc_oc=AdqSwOUWKFXu1gUaghnUfo1yb6C0Yz5ts2TKX9mu0ITOEeIsGJVw8bNZIJgouyk8NnI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VFt4fayUoOxLOjQbHu6ShjMPdMF21LIwAy9VT4w0r7A&oe=6A2418DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYQP_N6rAugQ7kNvwEunjYt&_nc_oc=AdoX4qteaDPzNCfOfKJYRRIG_ySAdyj3vOdhb3_eNuhs39AlgVBvoBdHy1AAhW1RMmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QaU4VHkFS3qfc3zVneRxpE0Uj3JoHXsrALRtqqrEhPw&oe=6A243BCC"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quiy0nUudwMQ7kNvwFDHdFS&_nc_oc=AdqQtaXfYNzrVcDJSrmSJxja0GbFtcr9rV7pT0DbGWCZ43BZaTH3KUSCxK0YIncFBKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCDHOujCSZhncZnZC_OZbUlBXw4Brw4Fk5IuyS4Zx7Qw&oe=6ABD290A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pImdMwQykcIQ7kNvwEeoy2_&_nc_oc=Adpbn1VGXKqVFMvtfD2b24AWu7q1PXW3inDYvV082HkHICNNyWWSn_QkCEVta1AY3Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiBxF6mrw9JA_PDVROLjaBK38pci4xwXnxXXO6PDHa6w&oe=6ABD0104"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loeTPS1IZGcQ7kNvwGIqfBu&_nc_oc=AdpYjfg9rEfmMx1AWuOPH9uDugj17twY9QyduqFVsatOWbyMx-zk7VexPciU_HxbFnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICHQ98tN9B3cqBxqMGEkJ9bEy7mPye2BoHUVdtVUJi8Q&oe=6ABD06DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlP_Jgg2CQ4Q7kNvwHYpXrw&_nc_oc=Adp0T1J8Cq7s-nEJvsSNqwOv5mghMokA7O6KsPTwLSHtzZcp3fPlTl2_-CrOKK3bjUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe3ZPHDCOKdWAU04Ypfp4yAhoyLLq960-2bYPZ9frsJw&oe=6ABD03A7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
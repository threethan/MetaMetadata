m&_nc_ss=8&oh=00_Afxn64WCiJpLqrapXSWOi0WgL7Ob9fp91pGIjkaQlVCGZw&oe=69B53D33"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1M_jZW3MUcQ7kNvwEwXyKA&_nc_oc=AdlOaIaHUClmM7McPYxPC-SVOJTgDd7eekHwwccr04qO9ruYj_xwWlvcP7c2IcKMcTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzJibt6KlPnhLxd29bFfw5A18GYN-g6lk-kOHE34QcvDw&oe=69B544CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siEQg-ObfOkQ7kNvwFvyXir&_nc_oc=AdlWJHbLjH2iVpGbwL-ceL-bgnd7vKTq2LHZ6Jr-yBoMboso5esckTDju24Ew9wdRBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpAksjYsq3hq7haJpJvygEDs6jdYXnH3UG1H-y11mX1w&oe=69B55504"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DG5DRG4DDsQ7kNvwGDqJiZ&_nc_oc=Admj-8Hy6r1iy49EvB3LN8v6Oly2hKDFur4z4tA2ql88udPDgTUuJsWekD0B3LQLI_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzz_QAKbN_cJuTd_V5psuv1sVTZMqWCF0biESYpcIW0WA&oe=69B55ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQKbWZ9O8E4Q7kNvwGuSYUX&_nc_oc=AdknzlIu8pyD-uUMbTtMlueyBisaaHzX2Q3kXKllfd1ApTv1qUCQ6HP6SJMS13MMhc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe_TNIfVTAnUs9Zn1FGE4vp0BOmkWFm_SIzJPOADzCHA&oe=69B5458C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "\ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/p
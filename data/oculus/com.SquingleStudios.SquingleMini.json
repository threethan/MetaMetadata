p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omw_Ynl7vuoQ7kNvwFKAtTj&_nc_oc=AdozMHPY_FPMLXHqCxa_wRtm2pP27G6gOPUkvF_ov0nt1DERiJUD0WplHvQ-qwSD-0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTs-WfLJKVnwtZkmvtn0j7_IwqS5-u5FEiEvGg2OalK6w&oe=6B0C73B3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewhax9AfrrMQ7kNvwGp5e_4&_nc_oc=AdouaJJ3qa1-T8U1wf_rMYDahuFJNzmZMjTR9Yu1giCqqD8codH38wGQ8WtNb_ZsWjU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROHdDj5HzMvcj_aiAvuUcuoSrMWHNxGA_OpCRUWhk8fw&oe=6B0C7B4A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg0gkL1nP4AQ7kNvwEEgiPo&_nc_oc=AdqzRE8WmG86pmUgqiU5yoNKwCeAgjO5MipNsDFRnbFqD-SuA4Ctw3JbDygI055as34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlx5F4R5P60ffqZXNxuF4Z0IIKvVAeQs4Hm9eJWTEPaA&oe=6B0C5344"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87wsc0Uv1xQQ7kNvwG62cvB&_nc_oc=AdoBvJlmBOsO-xVA-2LuSB3K6EKwtlxoq05HYpbz-X2k5AsBgz7oqG1MpIhw0V-NTI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0TcrOrM7T8CKn4g4SXMwpRiisiRBVXvNl6x6tprGiNg&oe=6B0C591E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZfwmucWngsQ7kNvwFXxZEZ&_nc_oc=AdrpMicUmvZcHGi4gi21Ho9WuDm16tNnTAg5BXVGZYicRvb2beaJv0wGYtXcRNVMGQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEDS3NY2NRavS97h4_Z7QsS6_wUrAcukbfcFgnq0dp8g&oe=6B0C55E7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_AipHnXfYUQ7kNvwFGrvrs&_nc_oc=AdrZHeNMu1w6RBXxO6I0vHUolc0Yr1brHPK8qemPXVXebsrjIOtCACIR38DveUoXkiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ViJqEBl3c0zzwU37fPCiavWYtbsV2sD7Vur1ueRxT2g&oe=6A2AD28A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML6ZWnygIDYQ7kNvwEjQ9Fl&_nc_oc=AdpGp5i9K5n6MQX6nzszrZtAG7Ecvz-me8PohdiktWA5aUwc33URhS2l9YCU7e_iZn8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W3qRCdiTLkXZHXqMfOBRJ0IKH9Pq_OuTB_pqu9QjJlw&oe=6A2AE2C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=png7EA9KNP0Q7kNvwGLUEb4&_nc_oc=AdoGIKyIkE5-rJhd5F_dDzmCAo2SIx2EmJKiW2-atIrS1xyl7RVvINfACBGS4B8rTrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93YFA7QY_2f6fGq8pdo6svZNxEcPj0Kca3-KgVcOcOJg&oe=6A2AB05E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RYXV4o9mrcQ7kNvwEMjaoX&_nc_oc=AdqcS6RvTvogMFd4tpoTku7098YlKC91dwHnxlEQWQ9fLwonfggAMtKOTcNfiwOgl94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mSEykLu3ypmDJU9MSj2Xohzm1u9Ud3b6nfve2SROk1Q&oe=6A2AAD27"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
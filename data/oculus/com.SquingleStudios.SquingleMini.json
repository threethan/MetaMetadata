486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac87ZhGytRcQ7kNvwFGTuZr&_nc_oc=Adoy0RMNaNX8vL_-BUUaE1WBpKF_gAYqRJ1PA83nSFOhQzzGnU0yxF9R5OW8c01hhy8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_Z8U0q9cJXY2v0w1s2iDrlJSj8sH1W_JR9VwHL0GXKQ&oe=6A8ECC4A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR6-2ZUllm4Q7kNvwH5S1ZF&_nc_oc=AdpKoy4qrOPGaV8z3zQODySV0VRIYB66RrUWpm_wSFpT6QoCx1sctHdV6xCLy87ZdLg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE88IdHN9vq_0RlJIPk7Ciubc_0Jb6Yskbk2RWY2gRN5w&oe=6A8EDC84"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgAGkMjHSRwQ7kNvwHjRAGh&_nc_oc=Adp7XQbinXBKVDfYtIVOKrOVSptVmqvAU-QKj4CQGRBixyLg6xD5mLSYBUDwIJRPG38&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYQHuJzlqywQ-0uz0I0YnhEV8w0FPR1SR_V1VitTVmrQ&oe=6A8EE25E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VDjciSiS5gQ7kNvwHi1fKs&_nc_oc=AdrNXq4T97BWfduc1jEpfRaUqbR1tMdwshaH_tToEIm2azj6yYDt9LQQZiEnv40mW9Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESBMAhA8sAq58uK8BgiPoRFJtSEKJr3Gam_7DVgZ0wXg&oe=6A8EDF27"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "
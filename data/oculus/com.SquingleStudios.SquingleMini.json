p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dBpCa_jqVgQ7kNvwENKmny&_nc_oc=Adp2MtlP16oLxo8IxVfCbPYxNVr5k6ySc0pQoTu-N4iBE2UfZ8Zu1hN186XVusVhVm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB0EEnOPko9Pu_0aGgkgQ4xHbZ3ZyaJBt_kglQV4eu6w&oe=6B045273"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l6ZBDZOtiwQ7kNvwEq7nHT&_nc_oc=Ado6P7p1o-ge2dO3klcscFLU0FA6TNamZU358pvRuNHPSvEV72fpDAGummevI4NYMW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDbWpSJ-oB62bvRo-WbiGVvX-_Whf3uaKn7CnHCcriFQ&oe=6B045A0A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BObwGu-GroMQ7kNvwGN1y7n&_nc_oc=AdrFZeOvsdVtsdgcssoXbDJXHxh17kpsP8e-eZb75g1OW-Z6tRcwz45h_V9BDt8XzPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStgw3DbvbNEB7DnFS7JdtT_k7FvgXK6xXQ3Yr72mpiQQ&oe=6B046A44"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qKPec-cbycQ7kNvwGc8qub&_nc_oc=Adq2NTESn_oJ8FN5VsYyTYfuiibrsVAZbB1lutjrqzdPE_NOAA46CKveGSYhq9IbyX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8VYMp1Ws-Fd2C4WzWYlAjqMkSXspuH_KubupTtkNAmw&oe=6B04701E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ-dOoRAlmkQ7kNvwF2NjqG&_nc_oc=AdrU4V7ATT87ESHbFT78OMCjmtJN_geIussm-44fnLGhc7103pnQidvvAmdgWQ5xZnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5uNwvWRNIyJkQJmDmjustohqL-kahEIR-X_jZ4NITxw&oe=6B046CE7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
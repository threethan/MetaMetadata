m&_nc_ss=8&oh=00_Afwys-vhC34x1KHXOkQlReua8keV6TVdgcVfeGP3jr2hbw&oe=69AFF733"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5ldzjhRG6UQ7kNvwEdDSqR&_nc_oc=Adl6gJL4s_QZnfIvCGt8J3_1aPdVOVbmHIqFJ4Px3-Xu0h8rZkKRKuwhH98d_VnPYv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOqBhbNGXTNy7gHmucRwRNt_VX5-QX8a9Ij8tbkFBIng&oe=69AFFECA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88X3PXOljs0Q7kNvwGolroV&_nc_oc=AdnHBkTBy5BMLmYzyIhoG5j7c-PDYbQQ2Ezu7alaI9c_ePnE3zwaj2Yabns1RyXK75A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxESWC4LyXCNlKXCHv945eDTu9NDBW8QRAifrCNGDErSQ&oe=69B00F04"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y28T1V9Dk2MQ7kNvwEB4D8T&_nc_oc=Adn6d8UFPU65y7ZQK__CgylTnbYXoehI3kfXCsD0UwNChOClhFb0yHYv80gDpUWwOo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx87IoIxDT0-DVpqvMaQweF8R07vfj1YOeH-RSStiAPhg&oe=69B014DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuXB9ZBBQHEQ7kNvwHtiaFN&_nc_oc=AdkEOsR0dhU4Ylm8PW_bhyJ6xJedUlnW3wWjQBxTp6Yl769YgzxHUWmZzB7Y8_LyIqI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl0qp86pvzU3_ThENcBA3G2l5G1OqRbRKU1pbmffZQJA&oe=69AFFF8C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "\ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/p
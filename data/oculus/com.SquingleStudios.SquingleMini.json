6A92B933"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsDs1RfoYH8Q7kNvwE3lX70&_nc_oc=Adrtfdvz4J_oOTRKJRP_L4AkTJoJ6cpBE9ZeljwmfA6JZULfrQ9n2xggbAJphnJltoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP8ZDWecpmdcchkom4BL9WIBjxKh5tsZSNNkpHEoXQjA&oe=6A92C0CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVdvdDK49GEQ7kNvwFHeh2T&_nc_oc=AdoWuQ074JL31tb8K7JaoHlgrsc0ycnTo-2KQEnHIo2U4dIWxcvLDNSjFIYCq-_55Uk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSEvV_dgBU1j4EFULWT3qmtnAM0xwQHIf27OriTqLKMw&oe=6A92D104"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDS5yjhDnkkQ7kNvwHGgiIM&_nc_oc=AdrxH9wO_QkZv10gLexwUdC6vbctsO7u_LyoJUHeEDWlFuz-m4boVVWjbJLMilj9A3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1ceC74FElYaC73Go7teBhlEoY6TedSjljQWUjb9b-4g&oe=6A92D6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79wkoLeCKzMQ7kNvwErcpFr&_nc_oc=Adr4UJjccMM5-3nwU-eCseUKgN7eFGLi4neSdOBqfrxhiQzFHfvQTuLxp-rUSnhZF-Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSsIGakoyqV_1TEjtpj65EO_r14B9ibsn8zOZaXFO1nQ&oe=6A92C18C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
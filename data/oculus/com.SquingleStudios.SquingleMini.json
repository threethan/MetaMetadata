p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=echQRSw1hwEQ7kNvwHC15zB&_nc_oc=Adpn347A-MQBowRkjlLUwxseEmnNHikmqtxA2m8-k_SVGczyPROuOhSk3JoIvjkF5FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTrL9kYfNyqwC4u6pzLs88DIQdjnjJbsNdZoqnAsKQnQ&oe=6B106833"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCHYXKnmEaYQ7kNvwEAAl-W&_nc_oc=Ado1i5mFsw4vZO7lEUA98QiFiNk9r3wXpIBQYvfO83bQ2mt2i7byAHeMa6CCpNhhK3Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrCvPF-Xm_X3kgAWTXf4l4PzkWY3VW_GFEBo_1kI7IWw&oe=6B10378A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPW4LUj0DaUQ7kNvwEzDSSE&_nc_oc=AdrExbevnj0wvA1ZIXuSixltU-Nam4grp2876-V15tagxl1AZq67vQEyOGB_0VrUxP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrcvks6G9GU0wZzFwy1N0FYgORlesDWfh5gVJxPaOuFA&oe=6B1047C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rR4Hknjf1kkQ7kNvwGpoNYH&_nc_oc=Adr7wrgslKIvzOeADPGNdBj5pUt3izZMc05yNsLmY89qZ_N9ImN60i5x2U3WS88l8VM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvChA0nivbA8BGsE2duXVilPvaCVx1piY7piJes661Gw&oe=6B104D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6grPWyBkv8Q7kNvwEgyKBm&_nc_oc=Adoc61GHTCi7IEuY-NuFLcbFOOsISIjA9-mLw_Qh48tz0Wh83FMx7B7CHNeF_TYoAjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFBOj2nD1ReTGyYOMDa1Lo6WHDHHJEngWrX7leVkVbSg&oe=6B104A67"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
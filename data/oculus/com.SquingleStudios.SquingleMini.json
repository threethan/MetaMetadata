6A789373"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-d397WwuMu8Q7kNvwEzpSj-&_nc_oc=AdoWT3PCENQ7sLjWLyyvBurCY9q-H2PGqpAgGte2GsGKeSfOrNgrI3XNYsr-iqt789A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_MSbusIbldMpiOxjXsYIBOn-9VXQIPKtLv--jcvTraw&oe=6A7862CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTRuF47NatIQ7kNvwGgI83K&_nc_oc=Adqr0MJrfiBhofCcHFbnH-pXmrb2RxfGW5psMN3276fmogASEaXXns_yS8rRqyzbwes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESKa1fV6UpHCnetQ5UbZzl72D6GBDgxPBsD09Xdw6JqQ&oe=6A787304"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyOKJuLe3WIQ7kNvwGfxynq&_nc_oc=AdonHVd3o5k6su6T0eRJwxvwSAaVOHazbyLKGhwEhHAOWA1bQaV0PVPK2C3cYvW3Rls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUooveU8lyYS_VUpUlvYE2hYMNGYb4_nIfMFei3n6sbA&oe=6A7878DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDztO3EgDHQQ7kNvwHnxtX3&_nc_oc=Adrl1-mQxfFXPipEaS0POTVkqPNQvtieUvyud3Q0lzSsolZ9FAqzGCqlM7fmjAAT6hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHUegu027yYNAVBPJbZuJAtQ7APXDtEwqklFxOlWJY7w&oe=6A78638C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
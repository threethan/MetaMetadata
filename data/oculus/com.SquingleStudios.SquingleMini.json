08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bWhG8YhvTUQ7kNvwH9CTsN&_nc_oc=AdrThvDYYMpob0gez6NEjvifn3sBJj80KYGyfPJVkbMYUToM09o4sGS8y_7x8aLqfuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnS4bWtdIAKhIaqT29myukU8k190do_ad3ZX-pYy9MJg&oe=6A99908A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLobHuh-4YoQ7kNvwFz4Evm&_nc_oc=AdqQo1aQTm7wgvItDVat1gt-8gYoCsL4Li66dU-DWAD9WzgQZNorQzcWvx6AuevuOmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkKcrZBaSFhQc7L9KbK5x-Rj9Ku-MiAYT5YJo5-6wnSA&oe=6A99A0C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH0fHKTLJGEQ7kNvwErKdJK&_nc_oc=AdoIGdTIeSe4rvHBUyCG3HarSNGapFwjGi3IJkaSU1vhuhQk8S37yx-g0tYl-wKOzow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-0r-cPyrXudJJ7uGgxST6fZ47CG9bftIz_xkiXrg2hQ&oe=6A996E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaVpGwO98pwQ7kNvwFC92gt&_nc_oc=Adpax3zTGIn8SJxUmr9hB7Ox9Y8ZxpNKCgrTqQ_X2Z-Xk9l1LwRJtBCCXOtOVODnrus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLznYnQvE_eO8gQaOq4aCU6noVZhwFIkV9leEPZ0c41qQ&oe=6A99A367"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
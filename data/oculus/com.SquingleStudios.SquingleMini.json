5627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-PcbIk7jRQQ7kNvwHAE01C&_nc_oc=Adrm9ircr2h3yscXEBUDkDM9ctO0x6a08LR_iYnOGiy1IRlGqpBw9sSIbGqeBp_ZiUA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAl8u6rGqaT7F_MwOX7Gf-o1h9xCOjcG_JGd-1NAK8Pw&oe=6AAEA88A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyn82R3Gq88Q7kNvwERK8cN&_nc_oc=AdrIb6uMkKB5sEW1Oh8u_4A7vpJLld44lyVCw8T4HnywsUCQATvpdgMi4O-9Shqgc_I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_5mebzElol046sBV5dpdvv1ftokRcatM3OU76SCkCuA&oe=6AAE8084"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAMdxqqs_dMQ7kNvwGawgqK&_nc_oc=Adrlyd0BbKpa7b9SNg47vRMCk4C7q1SkAkNqw6mWNQ_Ips1Q4xhEeWTyGz9Coif0Pgs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8_Wg5XA_duBCHpvnfUx0dY-RlZL6eL5mOU9m1bINmWQ&oe=6AAE865E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sop4WO8qHiwQ7kNvwH-KNkd&_nc_oc=AdpmOSvn0FsNdgpb33GFUIm5Qk3mm2R40LYnk8-6tZQBJkRo8u9KEDRrsq1Fw5r0IB4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7VC8EAXiZX8A8Mgi0qtpoIg_ra_-Ktkz8syreEfRpOg&oe=6AAE8327"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQU
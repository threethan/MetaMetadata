p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dBpCa_jqVgQ7kNvwGQ0yNw&_nc_oc=Adrzv3Osp6xJLcw1B7W7Wg25aGWQ4m9NhdxrhEWtrBdOwImocrUGWX3wRsduQNi7vrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwmugk5SZxMPqnbAscCrm-EfCmJuLrl9FOfGQoSBjSMg&oe=6B033933"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l6ZBDZOtiwQ7kNvwHwXEuJ&_nc_oc=Adrguep752lHIzHZSRZNXmbSqlP-EAsIG4RZ6a2AaUEplaJhFgXs1XDCo0jVpKytaYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThU1PN1fPN6QiSsL1v_rJUtRKaIg3xL0LY0NXG47ztDA&oe=6B03088A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BObwGu-GroMQ7kNvwE9pluv&_nc_oc=AdrYXY3AgooUyK3Z31996tgBrVEp-fSW0VgTOTK0i0pEZGIceHRRdgwNwWrEMNVaa5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHUUIcspKKnVObkouHBDVNtLrAqF56vfWUGrKRitpB1w&oe=6B0318C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo03TxTK7dwQ7kNvwEZHhld&_nc_oc=AdpD8RLNd8oJe0TNeGdyew7KMcmqIRIToRTADWepUUwIB9I59ImOYByM6mepURg-fGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDMAsFy9QBtU3OG1KVgui9Q_gaVeruSZ7YePod05tCPQ&oe=6B031E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7qgnps8JHQQ7kNvwH69WZP&_nc_oc=AdqfRAqOdk04lFcGDFS3-rGyewZYKqmt-eFDP9Ef2ScerTOk8MZyzhlmHIqVAj9tygE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW8zs7WHsR7H3OVNW8ewQzDxFEYXcCNnXs8rONarkYPg&oe=6B031B67"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
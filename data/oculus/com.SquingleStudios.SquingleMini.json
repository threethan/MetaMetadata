08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S10lOqqJ3vUQ7kNvwGwEn2F&_nc_oc=AdpZtGul5ubO_hGEJHGlb97lRKEGZVEbAWpcKts5IVV_gjthc5n9hqGuB5QBUsUhdgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqyRnG24-dUPfRGzxjQW_9mXMHaxM_xEDjjtIfMi5LdQ&oe=6A69E24A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imc3xUB_BnoQ7kNvwGgOnG1&_nc_oc=AdoSBroMpBIct9LlTPvhFqos5m3YDmUQprHnYm3o9bXBurKi5vdK74aE4gUCtJGmsZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWGmLAMiuY6j3D21kRcONQuS_MIgDU1NdH3cCT4W1-fA&oe=6A69F284"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1w82DIx-_gQ7kNvwE2_rTm&_nc_oc=Adp3ltU8HBGqHeZC_4lLt-Wyf7b9-OSmcatYQb521AjL2KotcUdMi7tOaVPBf0O_0W0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDicuFef8AheCp8z3lmlJ2PaVVWkLwKUeBC4OfL3ZQ3AQ&oe=6A69F85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5P7lQco-S4Q7kNvwErGN-z&_nc_oc=Adpy7tJy-jTSeWjLvYuZ8lE_N0c5NqEfQQjlqlvVQaRZsxxJUlr7T8uXu-y41cVba5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjw6h3KVG3RoH0OL2NKQYqG2TqBGkPcxx6DMS7LluH-w&oe=6A69F527"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
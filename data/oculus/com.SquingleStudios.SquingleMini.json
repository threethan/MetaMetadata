08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOhdG7A4gqcQ7kNvwGnHqXR&_nc_oc=AdrJxvuHDa5fjnA9r215fZEfYltqscK3uTG6uEzxIX9EaScHAvVJlUSdzqlxvdytzJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqrkAh3hZvwmjgwGme2OA53s67jF49X71aTftVK4jkRw&oe=6A5F564A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5w7M9ivzCocQ7kNvwHDGCp5&_nc_oc=AdpOr_kkG0o3K_2IDWeej23Hxj57rcK37wQEIWoZ-ZDKeA15rcywPaeob8qlTG0QbZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7G7o6r4VwGxl7zahdlkvqS5X_6jYRvJz7aHqHD7R1NA&oe=6A5F6684"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHAIqFObOwYQ7kNvwGRwpHd&_nc_oc=AdrstZ4VtEVHkFOqi-yWBppcJ652dO4MfwRGH3yVBAstEhXNYyLFfyss4BQLxu2dwdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgQGS117roFA7hUbujnG39uPPu7S3DaeHjMA2KK9F4FA&oe=6A5F6C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_Po-ct2uL4Q7kNvwEd3B8J&_nc_oc=Adq564YJeQSQV84vmIIlbTRyIVnJ7zdmfYwr1-IMQTLJ5Q3gC_CKQNDcdMMZ6H74PDE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYcZ7UPpNWOnIgISPyBQz_8QCI-J9qNR0IU23ULXBXKQ&oe=6A5F6927"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
uluscdn.com&_nc_ss=8&oh=00_AfzE0fAPPa1FccFCPY2LZn7GaBdHYljJ7yRL9JUsG4HRNA&oe=69AAB133"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yzkfTiyLNEQ7kNvwGU1KUq&_nc_oc=AdlI9gUgx7Tc8JeRUOTIeASxHBHsNl-VoycIozB2ryF947a4VRhsKQ2g8AYB0wYcUyA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaY1RnqLzjKt_XlL_vmTCACTEju20ia0FM51IU4oX5RA&oe=69AAB8CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8l5_sl2sMYQ7kNvwHey3av&_nc_oc=AdmZL-SwE1Hxs5GYwutT2d9iCZUAEQfccRhnATHb2wTH2tMCULLTGFqCP0nTTPpMwIw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-N-DLuzUXpGrnOqI-TSfyMTyrGMrKSWH9pjgJ5i4F9Q&oe=69AAC904"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEbWdbkhx3IQ7kNvwFHz1a8&_nc_oc=AdkP9ZK466XpiYjAnhu1I2B2XBU-CtI_4bXG9mjhY94RF9Mlz8ia7b3R4D891coXHHs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfywhXI-ZSNLkZoXDEsC9hu7OFJGe4go6FlDp_thw_ykHQ&oe=69AACEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSu9YJVG1qUQ7kNvwEoFVrj&_nc_oc=AdnNn9ouDDKGzV4_OVt_uuv_ri_qjKC1f-UqDoIb9YlbUlwhqADK6mQ0ESf-AQDBr1U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0XIcYWZGQLm7mR8nJgx8JfLmPkRnDAxU5CNIBcv8ssQ&oe=69AAB98C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "\ud83c\udf00 Buy Squingle Mini for only $0.99 and save $2 on the full game when you upgrade!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://
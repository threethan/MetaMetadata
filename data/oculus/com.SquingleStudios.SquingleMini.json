p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f0QqWbj-SoQ7kNvwGbwQ30&_nc_oc=AdruwAvr63MHoUV-ikzLc4CIUsE_TAcbXGQKOie09op83gwi1zKGg6ZdjfV4P3zHCkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-96p-Ds3i4iySVFstNn7Lmizksnnoq4FiU4yjd_tuMg&oe=6B09D0B3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewhax9AfrrMQ7kNvwGkYv9l&_nc_oc=Adp3FAxNhmN0BQ7eQisOhSyh0d2M8SA35SXsJ__4gWcd3uwkdTathnIoptA-hfJsvG4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRusK5zJPCvPMLWGLOioaQtc0YPsgO7mST3wx97jV9bBQ&oe=6B09A00A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg0gkL1nP4AQ7kNvwHDV-j2&_nc_oc=AdpPDNsNOXM0iLn8ZLE7NtnOSDpRD-g-PXGg5hgjbuw1ysi3j_mbajUalhxFmslfsO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVq4UuCnj83SMOiXYrj1eh7AeMFUnosqlFaaL8D1vYnw&oe=6B09B044"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hvw8jET_94Q7kNvwGoh24f&_nc_oc=AdoW6CpzRpF-fONsa_YXw94D1AXyoHYzr3PHsM89-_qXvLDkrXA_ory7_4Cd-FZFJWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9H_lf04JbMvNuW-Me_NplBdf2Z4AxjtCqqWWdKlH5NA&oe=6B09B61E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASxbJp-68IAQ7kNvwEM55w7&_nc_oc=AdpJPbWhdadhDLkVzybshXFWwrOLj4uvU7McOJePzEhT8fi3ksYYbw3YC4I9myfvFHg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVD8mBBxoZezVEQX0lUNj2ydyrt7lXZ2bf1icnzAqRXA&oe=6B09B2E7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
08848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiRoHmLLFRoQ7kNvwHxsE_C&_nc_oc=AdqUlRa-vyDpZmY92pb8BUBlhlpkD53SCA1AF3Uu_GYOInBmohNlZzcVeGKWZ94ekf8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH81e5PFzxs81BC2hlaSKOBspWsXi85yYb_h_hlm90xg&oe=6A819D4A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5KH3M72OhsQ7kNvwE1PaUI&_nc_oc=AdpzfFIvJa0eQRztpSGrVAFXjP8_Kw59_nCIbHEjJqfv8u8q4TXPZZTELcB2vlcyc6s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMsJIJouUmJaCKqT4O7-u01hQXKxll94v3zt14uHIk5g&oe=6A81AD84"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cCjYxEEuX8Q7kNvwG4DI6J&_nc_oc=Adp9EOthl7vGEaEwj1M29siBppXxXe-rcFA4r539Olm-Kj0NEWgPXhn9C-4g_vi6s2U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWfpDe-Of_9WyMS7BftsBPrcoBazApvyuQYaPFl2fYHA&oe=6A81B35E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqJY-Qr8Hk0Q7kNvwFC2i0u&_nc_oc=Adqy_2IQUCc82pnm6gW_F_lbDSIbsVR2wJnYBzOjvZ7c3akeK6ZFJ1bBQygMvLa_qho&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMRo6KwykDxuFdDfrMAJl3l4jfoDx18F_jAMJb-bNXpA&oe=6A81B027"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genr
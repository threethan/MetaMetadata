p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omw_Ynl7vuoQ7kNvwFGPDXQ&_nc_oc=AdodUWJGeSVoYV16ROEFFiKRDN2VceZjXUKRk770Ds2BI44vuEmdVAr_8UYH7ksYUd4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSG5QDZQnGGDiMFn47ewLGKarieeD5MvBrlDipV-M5Bag&oe=6B0B2233"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewhax9AfrrMQ7kNvwETMkhv&_nc_oc=AdppH8RnpU10nBGpSQ19PAMgpKciOONNi0FH8cz6cbE1d2aphwEqgJ2KmhMNsYTa1-Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVfhP5kN7kOZgZltGveZd11PIF5Lnz-DIQOFJhZs8ROA&oe=6B0B29CA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dg0gkL1nP4AQ7kNvwErv9jD&_nc_oc=Adrvx0iLmhGjHHu0f_K_Yw9NsU_VwYU_MnOt6cRvLGznHLnaHE-72XNfo5fFmXGdHpg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbU57S38gXk5hlm1LzRl65EQ5b6shyWsHeZh3f5F6uIw&oe=6B0B3A04"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hvw8jET_94Q7kNvwHf_d3q&_nc_oc=AdoOdzBFAZOWiFsxBAMoLmsHsbnBr4r7_erdcv3RBIXid8e_U8hhMSIUflLJwUve0os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqcGWOuLxG3LFgS69A1Npbgjd9xwkzmFPsXai2PYTXIg&oe=6B0B3FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASxbJp-68IAQ7kNvwGwAgeX&_nc_oc=AdoXLWI1FB2s6LnydP04k9eSJoAIr7KCueVltUpSx2obn9mbwei1GUEv_LFbS265UFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYo9RyCk7gX3uzGU7UXTm46SJilZr6j6v0Prydqhwf3Q&oe=6B0B3CA7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac87ZhGytRcQ7kNvwHmx2Yy&_nc_oc=Adpmh_tl2UTNPH7-DCoz6YfhbN6A72HpxYoGHJUWATQKRX9LdDo6TyNB3xvy2yBSug8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuVzTGmI7nk0kpbDIAO-5RHwHKeGm6sUqThvNhhVmBjQ&oe=6A8D7ACA"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHrbNHSmMXAQ7kNvwE3AZB7&_nc_oc=AdqXfF85ZTcqm6jnBNK5o-WJ2J6HJpkjvV_2DGlrKMQKlcg1Etuw2IBbUU09NudZbiw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl_NG5-_1f8MSstiQK7DCjeNiFLO1tynUOZ9Za39ov8w&oe=6A8D8B04"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhSew-2MVr8Q7kNvwFX1rZW&_nc_oc=AdrMfk3da595YMA1qec0Yq-3ab75XKl4AYdQcjuw9vxa-jNSP1j31TW36mgAAeCtBHs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCdOOwYoVKK_rLRQZbo-KvAlHxBEDB1B4fGU_yeuNaCg&oe=6A8D90DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VDjciSiS5gQ7kNvwFa6rph&_nc_oc=AdqBwV4eVwpYHPTjpw0BSQNmGCQ0G_NYB-BXYNbI3BAfOABYjiQJGErkNuKuykeqZJ0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJpLwCMZgnJiX7tIKRIzldXy9KXECzBFe0njwE9Ib9Xg&oe=6A8D8DA7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://squingle.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "
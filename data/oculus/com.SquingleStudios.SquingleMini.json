p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtOYtceZWtcQ7kNvwG5SF4y&_nc_oc=AdogYIRXclx-lpYfJE8ynBIuNqQ1TA54bFOK6qpcdxkEaadFWJjIZ6EIpOujsdKJKic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9EtILPHA_ekDD9B9bEKzCf9J-guc83wp3cR_f9kha5w&oe=6AFC6973"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV6YojOiaeAQ7kNvwFMVcxl&_nc_oc=AdqVUryoSOgDEfPHeV9aiBP8UJmPk4hp2vQ4uHd6W-6tDE8BNiLuaIB219__QEYR3gY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdImJd5r8BMbhmW9xZ3MVIxC5NzSDM3p6mxnT59F6uiw&oe=6AFC710A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mp517VvV7cQ7kNvwFitZih&_nc_oc=AdpITeI87GFIIpEliX3lw4pCTnlmm5UqY2k6dDqMdvGWnnjOw58VxhLDdTe-JCh0xGU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzN8i4J9FRhZgg9OvWuEY4JCcFD06ZrRiXAC-R2Y0KiQ&oe=6AFC8144"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55SRuaSFBcMQ7kNvwEnKMtf&_nc_oc=AdpaSeI-td4uVfYTuOp9KI8hkwMQga6D4KQjwPYmejryI6pQSi8Dx9T-_eVGnj3_pmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgfipR_18XtTiuLLP-kwQn7a1ESsGS_Iqm5DIUah_FPA&oe=6AFC871E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQkSeSS9gkYQ7kNvwHiK2FN&_nc_oc=AdoEM9yHq_kftr32TVp-8xQR6NwBlNswQgm-nSrmgvZhXnqRw-Q5_0jj8UkbxcJQYpQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRefifffSZdWo-3-4QaNQiwS8aECE8EuNIzTORI-b0G2w&oe=6AFC83E7"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
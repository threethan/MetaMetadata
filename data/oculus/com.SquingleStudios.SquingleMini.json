p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtOYtceZWtcQ7kNvwGaKjxv&_nc_oc=AdoHUprxCpsaqAGTA7vYw_avFPFhBPnHP1XVRTfifQgZLlZp8kVy55-8hxkTUddBZvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3qQ9BOMCHmqkwsTa3qpCR1XabCCAUqMq9Z9K7uh5O5A&oe=6AFDBAF3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMwPQ4OP5WsQ7kNvwF_Qvis&_nc_oc=Adrrm9PdOb_PKwyITrWakVVtVdEgQtAjXj7BY7Abpdjs4szC54VBBQbmksPMt-aR5n0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR32S-5igYKRaCggWHp_zN7JN3RTY0jfexkvVaHug9oNQ&oe=6AFDC28A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3dL9EzaA40Q7kNvwHlHbwb&_nc_oc=Adq5HG8d3aO765q5RQ1qCpPgu2mYcrW21iMUbapmZdkB0GAqichhZbv6gyV0Z9DVIoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpkyvX9PMSAF3pj2a46kAzH7j4Mv8oB0xmTe9Cicxj0A&oe=6AFDD2C4"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55SRuaSFBcMQ7kNvwEs92Nr&_nc_oc=AdowooVrZuusK7xBJJZSqglHywio-NuM8icA6VdbDmBLJrgfSHmWcNIpMX2Pq_GOHRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMcbjbwIPZ09soTX-X5bYJqS7SgMe36g0WIP8zkVQSkw&oe=6AFDD89E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Squingle_Demo_v2_Cover_Landscape.png", "id": "964144373025532", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499292232_964144376358865_8987889214839571925_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQkSeSS9gkYQ7kNvwEbBf0K&_nc_oc=AdoueLXyMsa2ax3MECu0T9dYIfy_yfBaSfYG8vqwVzQL_RYVdQUuxEpOrUeTQlZvh9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAqDSo-xWTCh4WQMP17vj3-mdCK-YiWA2Fgwk3M-v-kQ&oe=6AFDD567"}, "display_name": "Squingle Demo", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "Squingle Demo, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Demo Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "Squingle Demo offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018S
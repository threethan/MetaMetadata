69FB54F3"}, {"file_name": "screenshot-04.png", "id": "1830449300822153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982610_1830449304155486_9105627070072408848_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34XmpiWLi30Q7kNvwFvfSqS&_nc_oc=AdqE707CrdOMbcMeY9c4hVuBDbFbmJYscbRLJWCXHyTLZ8YCS5iALv7BXm6wmHZ1uC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66_-oLlQE0WD3L9gu8wf-RWd3BsiE_0y0a3pQ5EzuYQg&oe=69FB5C8A"}, {"file_name": "screenshot-13.png", "id": "9449026898446045", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974691_9449026905112711_4579666727095828995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so0CxT7wcr8Q7kNvwE0T2gu&_nc_oc=AdrqFBcl7w_9EVrVlKGwig-OW4Yzodgrx1LE747HddaP1UxVv2fWQ9V1lQVFBVy_PZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HLTAjoOM_1BJPAmNuTGiyxJK4es3c1sVKDX7A-jZ8AQ&oe=69FB3484"}, {"file_name": "screenshot-11.png", "id": "1969264830167481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974803_1969264833500814_717700601129842921_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzkNYREvqH0Q7kNvwHzzIJj&_nc_oc=AdrLLRFE9FS5Em0BTRam0_39tcLnfQz39DUzvZTstkixoMYhMv2ItsEv-Lk52JYK6UE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R1KptYshSSKXOwJaw0dXq4Tyilal6JA3kgTaWGLwl1w&oe=69FB3A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-Image-MINI.png", "id": "1128857345307826", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/43997708_1128857348641159_7151441411599407678_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RznXXW_wlukQ7kNvwEIdG9O&_nc_oc=AdrEu7SRlJAQ1kGrl7TMJMMpAlkpeV848SfUvsMBh9uOUGTyl1Nhch-GFPAUpDegYO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MxZDyl5EdOEDSMwOvJ9D1nWASHOPiw9orEbjWgDyO_w&oe=69FB5D4C"}, "display_name": "Squingle Mini", "keywords": ["puzzle", "MR", "puzzling", "demo", "squingle"], "long_description": "# \ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20\n\n\n# \ud83c\udf08 A VISUAL MASTERPIECE\nEach maze is a stunning, morphing, glass-like sculpture that comes to life in either Mixed Reality or a fully immersive environment, offering an unmatched visual experience in the puzzle genre.\n\n\n# \ud83e\udde9 ACCESSIBILITY\nDesigned to be accessible for a wide range of players and skill levels, with intuitive controls and hand-tracking support for seamless play, whether standing or seated.\n\n\n# \ud83d\ude0c GLOBAL LEADERBOARD\nCompete on the Squingle Mini Leaderboard! See the sum of your best times across all levels and compare them with others around the globe.\n\n \n# \ud83d\udc7b RACE YOUR GHOST\nChallenge your best times on each level to improve your leaderboard rank for endless fun!\n\n\n# \ud83c\udf00 Immerse yourself in the world of Squingle, where every twist presents a new challenge! \ud83c\udf20", "short_description": "#\ud83c\udf00 Pre-order the full game to grab exclusive bonus content at launch!\n\nSquingle Mini, offers an incredible bite-sized experience of the unique Mixed Reality 3D puzzle game, Squingle. \n\nEmbark on a journey where the lines between the virtual and real worlds blur, offering endless fun and mind-bending challenges.\n\nGuide the orbs from start to finish, avoid the edges, and collect points as you navigate through glass-like mazes called \u2018Squingles.\u2019\ud83c\udf20"}]}, "developer_name": "Dr. Benjamin Outram ", "developer_privacy_policy_url": "https://squingle.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "V
-sQ7kNvwHRkdeO&_nc_oc=Adokn86zLLTIf64ZFb8tGsU0UyGN29njVsqsSBNWWMxQxF8FjEkhibaXkhp1rPGHmTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRixw44NWv7DuHLJN54jwWzYgTPDvFF03AYeYZPxJSeRg&oe=6B01D1CA"}, {"file_name": "Screenshot_2.png", "id": "1299882261915031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1299882265248364_7161631198790884287_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuXkxbJtpZgQ7kNvwFvx_GC&_nc_oc=AdrLKDP0ZS8y6ODX-RSO2cXir5o03oWEvskhrlo2njXN13tNrKmzClh7yrRaBNTOYUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWepzg6LlqeT1V6O_owvxuWMSO81FlDM3QNPcISbRsQQ&oe=6B01C74C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Egyptian Pyramids Explorer", "keywords": ["EgyptianPyramids", "AncientEgypt", "PyramidTour", "HistoricalVR", "Assos"], "long_description": "Egyptian Pyramids Explorer is a VR exploration experience that lets you step into detailed 3D historical environments and observe ancient landmarks from a new perspective.\n\nWalk through an immersive Egyptian pyramid environment, explore the atmosphere of ancient architecture, and experience the scale of these iconic structures in virtual reality. The experience also includes the ancient city of Assos, offering another historical 3D environment to discover and observe.\n\nThis is not a fast-paced action game. It is designed as a calm exploration and sightseeing simulation where players can move around, look closely at the environment, and enjoy the atmosphere of historical locations.\n\nFeatures:\n- Explore Egyptian pyramid environments in VR\n- Visit a 3D recreation inspired by ancient Assos\n- Calm and slow-paced historical exploration\n- Immersive 3D environments designed for observation\n- Suitable for users who enjoy history, architecture, ancient places, and virtual tours\n\nStep into the past and discover ancient environments in virtual reality.", "short_description": "Explore the Egyptian pyramids and the ancient city of Assos in an immersive VR 3D environment experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/10_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaanbashan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1215588751636894"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1572877387570370"}]}, "baseline_offer": {"id": "1572877387570370"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783782540, "status": "PUBLISHED", "id": "1572877387570370"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1220574971138272", "version": "0.7.0"}, "id": "896531519508301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1215588744970228", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1220574971138272"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "896531519508301"}]}, "change_log": nul
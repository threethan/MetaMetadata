 the Egyptian pyramids and the ancient city of Assos in an immersive VR 3D environment experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/10_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaanbashan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1215588751636894"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1572877387570370"}]}, "baseline_offer": {"id": "1572877387570370"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783782540, "status": "PUBLISHED", "id": "1572877387570370"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1220574971138272", "version": "0.7.0"}, "id": "896531519508301", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1215588744970228", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1220574971138272"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "896531519508301"}]}, "change_log": nul
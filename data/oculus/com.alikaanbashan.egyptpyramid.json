620_1329291656705668215_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GPq2bVoeuoQ7kNvwEhGLlT&_nc_oc=AdoxynLxFuVyMeXZ-LJ7Adyl0jyriUlR80CD7Qg1HnhVaYtnVG2Ewf0fMngItc87ESc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcEwQnCiGMFW9WFIQXgra8LNGSUll55F_6Wz8WcP4h8g&oe=6B0323F3"}, {"file_name": "Screenshot_3.png", "id": "1042626615116719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1042626618450052_1691340064706309906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKjEztCK59MQ7kNvwEiymDr&_nc_oc=AdosDC-P43y6uh7KYZ5Wd01DFEkzHXsoh9TSnsGl_ChicgZeRnFxns9p9gwJVya6rqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB-9d4RZwAj4GnK8y97UcnHDX9d8S3SbkO5DwuU7zZDg&oe=6B0303E2"}, {"file_name": "Screenshot_4.png", "id": "865497536635394", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_865497539968727_7619569391012678267_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrXlTV3kSqsQ7kNvwERVQyp&_nc_oc=AdrgkdOGO0siLok-l2ENs-NBWUPaxAyUOt45xwvyQQV47gYRgmKhW9k0pqX3ZAo1c_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyuqlMXPIWmSNsw92KcdwE2HkpHqxX5TDdsMMcrDdn8w&oe=6B032119"}, {"file_name": "Screenshot_1.png", "id": "1679804879911705", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_1679804886578371_7721620893196076708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRmoGrlYg-sQ7kNvwEGsCGk&_nc_oc=AdpHuH1iHwPdU493C0jjolbkgezK5Hz8J60rSQCOiqfPvDK4gd6_Ld-PYDE1tSN4V0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQOWkeFtXdlowvHa3_x0Bl7aotXxShwoodeBzbolRuVw&oe=6B03234A"}, {"file_name": "Screenshot_2.png", "id": "1299882261915031", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1299882265248364_7161631198790884287_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qnYpl6XteAQ7kNvwFF9uGq&_nc_oc=AdqfSp2tM4Zy1XhRLgn6L7IR22lTlskGx7r5aKcqgj7vcNz_R_qo30cJZt3QIElUBeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmyk8y1F74Sf6zQgVrpifdYu7n1ABhsk8_7AOV46rEGg&oe=6B0318CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Egyptian Pyramids Explorer", "keywords": ["EgyptianPyramids", "AncientEgypt", "PyramidTour", "HistoricalVR", "Assos"], "long_description": "Egyptian Pyramids Explorer is a VR exploration experience that lets you step into detailed 3D historical environments and observe ancient landmarks from a new perspective.\n\nWalk through an immersive Egyptian pyramid environment, explore the atmosphere of ancient architecture, and experience the scale of these iconic structures in virtual reality. The experience also includes the ancient city of Assos, offering another historical 3D environment to discover and observe.\n\nThis is not a fast-paced action game. It is designed as a calm exploration and sightseeing simulation where players can move around, look closely at the environment, and enjoy the atmosphere of historical locations.\n\nFeatures:\n- Explore Egyptian pyramid environments in VR\n- Visit a 3D recreation inspired by ancient Assos\n- Calm and slow-paced historical exploration\n- Immersive 3D environments designed for observation\n- Suitable for users who enjoy history, architecture, ancient places, and virtual tours\n\nStep into the past and discover ancient environments in virtual reality.", "short_description": "Explore the Egyptian pyramids and the ancient city of Assos in an immersive VR 3D environment experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/10_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaanbashan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
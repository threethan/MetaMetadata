620_1329291656705668215_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GPq2bVoeuoQ7kNvwEGPWC6&_nc_oc=AdrizkGeeC7y5KyOSDtStImETaNDndRJIwKaQS5ErG0Wen0fXuu4v_36CUrRG8_a5lI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX_Oo1siFFc7_fThJ0qBq-z5hvIt5c6hgjL1_8jeAOxA&oe=6B01D273"}, {"file_name": "Screenshot_3.png", "id": "1042626615116719", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1042626618450052_1691340064706309906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sm6lkZPHEgQ7kNvwH3Z1x4&_nc_oc=Ado0Fufe9BIBESnUIu2DwURKUnxOnxXzxLMhrFO7y-QHIaETOJUuuYZfXWMOxpLX2kI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ-JsjuYdjnGee4GVPZjTflC-KTIjZwaqFqLxFM-g3rg&oe=6B01EAA2"}, {"file_name": "Screenshot_4.png", "id": "865497536635394", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_865497539968727_7619569391012678267_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbGzWLFkyssQ7kNvwGoxMqU&_nc_oc=Adq6BB6ACVpGM28VKbEWLDTFN3wPuPzddPEixJfiQ-xUMje3s8PnKdGDQDvnu-jxNz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpetPuvCQtnaCcFEfUsBzUMqj2KMRxL4WnRAJQI4Ixvg&oe=6B01CF99"}, {"file_name": "Screenshot_1.png", "id": "1679804879911705", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1679804886578371_7721620893196076708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRmoGrlYg-sQ7kNvwHRkdeO&_nc_oc=Adokn86zLLTIf64ZFb8tGsU0UyGN29njVsqsSBNWWMxQxF8FjEkhibaXkhp1rPGHmTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRixw44NWv7DuHLJN54jwWzYgTPDvFF03AYeYZPxJSeRg&oe=6B01D1CA"}, {"file_name": "Screenshot_2.png", "id": "1299882261915031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1299882265248364_7161631198790884287_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuXkxbJtpZgQ7kNvwFvx_GC&_nc_oc=AdrLKDP0ZS8y6ODX-RSO2cXir5o03oWEvskhrlo2njXN13tNrKmzClh7yrRaBNTOYUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWepzg6LlqeT1V6O_owvxuWMSO81FlDM3QNPcISbRsQQ&oe=6B01C74C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Egyptian Pyramids Explorer", "keywords": ["EgyptianPyramids", "AncientEgypt", "PyramidTour", "HistoricalVR", "Assos"], "long_description": "Egyptian Pyramids Explorer is a VR exploration experience that lets you step into detailed 3D historical environments and observe ancient landmarks from a new perspective.\n\nWalk through an immersive Egyptian pyramid environment, explore the atmosphere of ancient architecture, and experience the scale of these iconic structures in virtual reality. The experience also includes the ancient city of Assos, offering another historical 3D environment to discover and observe.\n\nThis is not a fast-paced action game. It is designed as a calm exploration and sightseeing simulation where players can move around, look closely at the environment, and enjoy the atmosphere of historical locations.\n\nFeatures:\n- Explore Egyptian pyramid environments in VR\n- Visit a 3D recreation inspired by ancient Assos\n- Calm and slow-paced historical exploration\n- Immersive 3D environments designed for observation\n- Suitable for users who enjoy history, architecture, ancient places, and virtual tours\n\nStep into the past and discover ancient environments in virtual reality.", "short_description": "Explore the Egyptian pyramids and the ancient city of Assos in an immersive VR 3D environment experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/10_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaanbashan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
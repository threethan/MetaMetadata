620_1329291656705668215_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxa6VOoY9IgQ7kNvwFa8R9n&_nc_oc=Adoi0phok_vxmmVTIuk8O22m7XAfJnxsxMh-1z6EnIO_F_PpfUj3BDd4ENtU6J9jPWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ43580L0JpLjzSsh1asDNhGtRBQchyQcw3KUzYymmMcA&oe=6AFF2F73"}, {"file_name": "Screenshot_3.png", "id": "1042626615116719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1042626618450052_1691340064706309906_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sm6lkZPHEgQ7kNvwFbZfYz&_nc_oc=AdqoO5GTu8JYi0uqKwpvA6AOuNApahPFGgF-gamk5iz3m_4PsiQrgZDwHEyMOXCzJcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3DZr4JvzjTFNZI8ztU6AqGhyHIKJE7s3vjXO2XmnadA&oe=6AFF0F62"}, {"file_name": "Screenshot_4.png", "id": "865497536635394", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823259_865497539968727_7619569391012678267_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbGzWLFkyssQ7kNvwHhxN2e&_nc_oc=AdpzAmue51rugNM6U5gdbMYZrCUGlr7V90RZWY-GsIdSwLGzs7wIkfLvXhAMLI4taOo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw9p7zMpnRK1h3f3Fe-Twme9_m7OYFQfhLBryrJUGAfQ&oe=6AFF2C99"}, {"file_name": "Screenshot_1.png", "id": "1679804879911705", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1679804886578371_7721620893196076708_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtph0HxqBPAQ7kNvwHDx7QS&_nc_oc=Adpqt8-VWW9tAXCMGCpotXHvsgWS7QcmaXQ26NBYt-1DAY44uhZGdMD6huzbrf81agQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLNu6w-GO3ScLismPIh7VzRIEJKo_qpHvPadWFa9DwSQ&oe=6AFF2ECA"}, {"file_name": "Screenshot_2.png", "id": "1299882261915031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1299882265248364_7161631198790884287_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuXkxbJtpZgQ7kNvwE4SL-b&_nc_oc=AdpLAeRO8rAv3IjtZEg0s1kkqUdNglK-ce_uKAaHanZlweiRnSUm3bHNt2_ZfSHuL1g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBV5z3C7nyKPCBxsNFNJP6bM_b4Zj8o3v7E6o2b6Dg3w&oe=6AFF244C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Egyptian Pyramids Explorer", "keywords": ["EgyptianPyramids", "AncientEgypt", "PyramidTour", "HistoricalVR", "Assos"], "long_description": "Egyptian Pyramids Explorer is a VR exploration experience that lets you step into detailed 3D historical environments and observe ancient landmarks from a new perspective.\n\nWalk through an immersive Egyptian pyramid environment, explore the atmosphere of ancient architecture, and experience the scale of these iconic structures in virtual reality. The experience also includes the ancient city of Assos, offering another historical 3D environment to discover and observe.\n\nThis is not a fast-paced action game. It is designed as a calm exploration and sightseeing simulation where players can move around, look closely at the environment, and enjoy the atmosphere of historical locations.\n\nFeatures:\n- Explore Egyptian pyramid environments in VR\n- Visit a 3D recreation inspired by ancient Assos\n- Calm and slow-paced historical exploration\n- Immersive 3D environments designed for observation\n- Suitable for users who enjoy history, architecture, ancient places, and virtual tours\n\nStep into the past and discover ancient environments in virtual reality.", "short_description": "Explore the Egyptian pyramids and the ancient city of Assos in an immersive VR 3D environment experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://alikaanbashan.org/10_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BASHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaanbashan/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
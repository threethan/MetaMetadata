png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlJ_aU4hhNkQ7kNvwHRrSAo&_nc_oc=Adoz6-rs4BowRYIO43hq_cdDpbM90cwO1kC7f8zhx0-Oo__Q3raZ3bKUwqDBBgPrH1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcnqIQHfCaR-Rk4N4aBB5sbOj_22Ye-88WXW6IcV4C3g&oe=6ABE88C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75294238_2808876395864861_965309340183429120_n.png", "id": "347273437379508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031486_347273440712841_7597399443701201064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt_PiNAbdawQ7kNvwGOgjJ3&_nc_oc=AdoyZ7eeVCOr4ADqZse8ZEqV-QXPRdcY_NjuNrDl9iLVylAzUfyo_55H0k9jAC5hU_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYXIJIpIwp46YLsjWEPace4w6UnUEA5eUsXz6ZOIhPwQ&oe=6ABE8ACE"}, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "keywords": [], "long_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!\n\nFuture plans:\n- more towers in every patch\n- multiplayer climbing(climb in same tower in same time with your friend)", "short_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "d
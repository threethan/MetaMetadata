es, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/bandnclimbgame/posts/263625351840411", "developer_terms_of_service_url": null, "publisher_name": "B&N", "support_website_url": null, "website_url": "https://www.facebook.com/bandnclimbgame/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "SPORTS", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "747842682982680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451778_895145221235517_4324801935935577433_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5AaJ7vryU4Q7kNvwHmdDVS&_nc_oc=AdoLjdJpnIeamI8f_C2GmnVhjEncmlD1LCCmf-2pPV-1nq_9_MUf78vwvMfJMm8oKe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRv9TYHHAiKa5NCPhYBEWViR5JU4x92-eA3EG0wQFTwQ&oe=6B0069C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics
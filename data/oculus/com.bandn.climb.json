png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqvEWfzusFMQ7kNvwFS5iDc&_nc_oc=AdpatyTAUicPUzqCHBMPXVYefGx-ZYldyKLf16KNi3sdS3RNdD3sw2iKcVHz6wRNISY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoNKiEbSWM3rVZDugOj4DNbHSJE7aOB2phGVZJoZD5_w&oe=6ACA6643"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75294238_2808876395864861_965309340183429120_n.png", "id": "347273437379508", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031486_347273440712841_7597399443701201064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXAk7g_Cw6IQ7kNvwHWn06S&_nc_oc=AdpBtWYhQmu0L8HccQ1ii3qM9ljqjWgyxRstUBdXYk56yLXi7NDISQy98qTu0iUNAhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeCkYfKvjb8nucKUTart6Tfp_LcBvlXN1_77SKJCBNLQ&oe=6ACA684E"}, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "keywords": [], "long_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!\n\nFuture plans:\n- more towers in every patch\n- multiplayer climbing(climb in same tower in same time with your friend)", "short_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "d
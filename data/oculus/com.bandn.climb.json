Hdd4DNHXAk89_CA&oe=6A396143"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75294238_2808876395864861_965309340183429120_n.png", "id": "347273437379508", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031486_347273440712841_7597399443701201064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPXH4jvQPzIQ7kNvwF9CZdF&_nc_oc=Adr8ucW-bLYPMPFz9VShGmaseWDXpwCcHrQVZwNsWrMCKzoQPyypb6V9Z8GcNJPjKbA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zj4ZpHUP24Y-5152xro4gy-VJpyHiiw1KyxqbHy45hQ&oe=6A392B0E"}, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "keywords": [], "long_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!\n\nFuture plans:\n- more towers in every patch\n- multiplayer climbing(climb in same tower in same time with your friend)", "short_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/bandnclimbgame/posts/263625351840411", "developer_terms_of_service_url": null, "publisher_name": "B&N", "support_website_url": null, "website_url": "https://www.facebook.com/bandnclimbga
db9-4uA&oe=6A1AD683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75294238_2808876395864861_965309340183429120_n.png", "id": "347273437379508", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031486_347273440712841_7597399443701201064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9cSkQtHhLwQ7kNvwHygBUj&_nc_oc=AdrlxHnhIRz7sV7eX9BNfo87KzH0ZzFPjyzpRNykMATTiy8cyTwhZCmzyXgcVE542Uk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MvJ31x33fUBWhnUYTGVLSd-a4D9O1lu_uFQw-DAycjQ&oe=6A1AD88E"}, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "keywords": [], "long_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!\n\nFuture plans:\n- more towers in every patch\n- multiplayer climbing(climb in same tower in same time with your friend)", "short_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.facebook.com/bandnclimbgame/posts/263625351840411", "developer_terms_of_service_url": null, "publisher_name": "B&N", "support_website_url": null, "website_url": "https://www.facebook.com/bandnclimbgame/", "c
png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqvEWfzusFMQ7kNvwEAM_ct&_nc_oc=AdpMGvZRqDC3x9FvTpmL2eAEjeCMcsLobopoDoXsmk5vmouGbhfyiY5zO-64xDtZLjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4eYD8ZMvkQ5z3wAjBVifF6M1VN65te2VlrfQCxVeftQ&oe=6ACD0943"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75294238_2808876395864861_965309340183429120_n.png", "id": "347273437379508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031486_347273440712841_7597399443701201064_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCWQNxdTv4IQ7kNvwGmY8pJ&_nc_oc=AdpdVetV0NHi71iyIrbrUIBA6kHsMI88_r3YLLWR6VZBFRX1BbFcMDuP-ySZlibwthc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHsZbZKcejCXeuZV3Hn2wuozvRIfK13YeuH9YeczKAog&oe=6ACD0B4E"}, "display_name": "CLIMB FOR YOUR LIFE!!!44!", "keywords": [], "long_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!\n\nFuture plans:\n- more towers in every patch\n- multiplayer climbing(climb in same tower in same time with your friend)", "short_description": "CLIMB FOR YOUR LIFE!!!44! is a climbing game, where you have to earn the top of the towers. If you want to get to the top of the towers, you have to overcome obstacles, and have to be fast, because something is coming from the bottom what kills you.\n\nIf you want to beat your friends' or other oculus users' time, you can do that if you are fast enough, because all of the towers have Leaderboard. So conquer all the towers! Show that you are the fastest tower climber!"}]}, "developer_name": null, "d
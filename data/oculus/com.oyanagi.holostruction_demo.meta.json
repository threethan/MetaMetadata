nc_sid=6e7a0a&_nc_ohc=NLoDt3RN1nIQ7kNvwFR_1Wv&_nc_oc=AdlwSt6yYf6aeDKUqkZuU1Z-2gxMXrNu0IeDvIISJtpzNIGafmoWKJvVx0cUJp4LVrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs-ip_dyu4b0TzQUds2RwUwcYs2ViqUNBA91Ow1DQHeKQ&oe=69A9715B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "783827451077538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_783827454410871_904006941728922217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vY5TrLR4r0Q7kNvwE_GP8h&_nc_oc=AdlVrPh_nVUYyJY5PmJSSBY7Php5BUp4OJMhYfNQY-bxSG2_YdbbPvxP7ZonbCcuJoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvqAuJFLupxKSvWL5EgbyKH_L2ug22rsjwehcKT9mUvWw&oe=69A99519"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "789118044039170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618069_789118047372503_8328155944376812538_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYPvDpqhDH8Q7kNvwFUCKFJ&_nc_oc=Adk1TFdU4UnTIkBZPBLzhKJuqeUfdjo1dcVgA5gpnUtNoU4HpFeWTBMZR39HCsM5BYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftz9stRI6XE6syBuviYblsyG_Dyqx0Qi_N-4ZId1giLcw&oe=69A975CB"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "4093779494206791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_4093779497540124_9143468540594253725_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM1tVuLmTV0Q7kNvwEUu74d&_nc_oc=AdkyZRSwgzxcL1qdoDYwvv-AkmtzaAw5jHknnL7-wsoSfnhgzpZvmhH1xh2P4Ts8uRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvnYg9clvOGmoZ8ybN4sb_X5Um68TdAQ-ljg2tL_gfGfw&oe=69A99490"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction Trial", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "1491930795474032", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction \u4f53\u9a13\u7248", "keywords": [], "long_description": "Holostruction\u306e\u6d3b\u7528\u306f\u30013D\u30db\u30ed\u30b0\u30e9\u30e0\u3092\u6d3b\u7528\u3059\u308b\u5168\u3066\u306e\u5efa\u8a2d\u5de5\u4e8b\u306b\u304a\u3044\u3066\u3001\u9069\u7528\u304c\u53ef\u80fd\u3067\u3059\u3002\u7279\u306b\u4ee5\u4e0b\u306e\u5834\u5408\u306e\u6d3b\u7528\u306b\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002\u200b\n\n\u25c6 \u8a2d\u8a08\u6642\u306b\u30013D\u30db\u30ed\u30b0\u30e9\u30e0\u3092\u6d3b\u7528\u3059\u308b\u4e8b\u3067\u3001\u5de5\u4e8b\u306e\u624b\u623b\u308a\u304c\u524a\u6e1b\u3067\u304d\u308b\u3068\u8003
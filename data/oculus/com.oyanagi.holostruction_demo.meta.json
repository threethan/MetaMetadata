a\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff12.png", "id": "2635770460139334", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619668_2635770463472667_5861685899192502356_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-shcQahbmAQ7kNvwFPAKT8&_nc_oc=AdrOQoGe5arxCgwZK4-RfqRv9bCKQFGg6Ir9-JIqtDV00OqgrZxsFMdq05axroHT7vQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRPYjTPOQxYUpB80SqO9ziZ7WkqN2c1C_GSYaTTmpUXQ&oe=6B0B33DB"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff11.png", "id": "783827451077538", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618499_783827454410871_904006941728922217_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ycNrrN92rAQ7kNvwE8BXAW&_nc_oc=AdqWuAErqTbExZ7WRq_UsKJLjnI8UOpgjmflP8WCxh0PCgbRSlSET2-z6Ow9dl34FtQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ784bkKXZ0KIKu6GxvPdlmvPYZW4ZN40kDDeXR0BpixQ&oe=6B0B1F59"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff15.png", "id": "789118044039170", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618069_789118047372503_8328155944376812538_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QXNwz0YG7oQ7kNvwHTQaXq&_nc_oc=AdoItO7qfftCt491cST9j7AzueO4MWobmNdfg9ZkqQ2icSvl1MQ3_8MHjU0sjFCBJXY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJHqKyA3enIgdHMDcf77c_JxQwRlfqaV7Hbu2xzfURVA&oe=6B0B384B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\uff14.png", "id": "4093779494206791", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618515_4093779497540124_9143468540594253725_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l04XYXVejHwQ7kNvwE_7cCu&_nc_oc=AdpOlZ1LOga34kHFKtGLMQ6vJmqk-g9YZaiX_A8LPnFOAb-MV0AWD73mTH5iBNam6oo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVXd8OiL_ZBfrwrDDh8NEE44HGc164dYQC5grmtXsAzg&oe=6B0B1ED0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction Trial", "keywords": [], "long_description": "The use of Holostruction is applicable to all construction and civil engineering projects that utilize 3D holograms. It is particularly effective in the following cases. \n\nBy being able to visualize the actual size of the completed structure from the design stage, it is possible to notice things that could only be noticed during or after construction, such as checking the size and height of the space. \n\nFor example, in construction work, by being able to visualize the actual size of the building, the parties involved will be able to share a more concrete image of its use and layout. What could only be confirmed at the time of construction or after completion can be confirmed at the time of design, thus avoiding conflicts with various parties involved. \nDesign changes during construction require discussions with many parties concerned, both inside and outside the company. In such work, obtaining agreement on the proposed changes more quickly will lead to a shorter construction period. \n\nIn some construction projects, it may be difficult for all parties involved to meet together, but by using a remote environment, the time required to hold meetings can be shortened and the construction period shortened.", "short_description": "Holostruction is a solution that uses MR (Mixed Reality) technology to project 3D models of buildings and CAD data in real space."}, {"images": {"nodes": []}, "id": "1491930795474032", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holostruction \u4f53\u9a13\u7248", "keywords": [], "long_description": "Holostruction\u306e\u6d3b\u7528\u306f\u30013D\u30db\u30ed\u30b0\u30e9\u30e0\u3092\u6d3b\u7528\u3059\u308b\u5168\u3066\u306e\u5efa\u8a2d\u5de5\u4e8b\u306b\u304a\u3044\u3066\u3001\u9069\u7528\u304c\u53ef\u80fd\u3067\u3059\
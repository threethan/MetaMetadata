-ord5-2.oculuscdn.com/v/t64.5771-25/473393516_1374404097024567_2520937002788965360_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL-3SQrvdRUQ7kNvwGCSRQI&_nc_oc=Adq8lF8QbBPeYwMc-DMCiRUVzR0ELky7WU-7esUCUnPIiOV0uElT9LP7mahZol7XpDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h-4EyMqJ9a2C1NzWvxECDU5C9_AdBELq7ri5qzJHpaQ&oe=6A3FBF16"}, "display_name": "Gizmo Range VR", "keywords": ["gizmo", "target", "shooting", "range", "training"], "long_description": "Stranded on Earth, Gizmo is training for an intergalactic showdown against arch enemy Mega Gizmo. \nStep into a hidden loft in Devon and enter a solo VR range where you can help Gizmo train.\n\nThe galaxy\u2019s fate rests in your trigger finger tips. Good luck!\n\n", "short_description": "Welcome to Gizmo Range VR. A target shooting training aid.\n\nGizmo escaped its planet and is now training its speed of calculation, in a loft, somewhere in Devon..\n\nA forward party, solo training gizmo, designated for stopping, Mega Gizmo.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ciderpressgamesdevon.co.uk/PrivacyPolicy.php", "developer_terms_of_service_url": null, "publisher_name": "CiderPressGamesDevon", "support_website_url": null, "website_url": "http://ciderpressgamesdevon.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
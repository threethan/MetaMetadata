vgEK1UPZqTMQ7kNvwEEExVi&_nc_oc=AdqXnTq-JK4uO5m4HhD6bNr2tAirgmJFdr9bK2jYaiy90kvE6lc4RniEvJKA9tWAOHY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkM-Apaz5tRKAhIyqK_8q55RLQlIS-58F7qgWtixG2fw&oe=69CFC0C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adiona-G: Driver Safety Simulator", "keywords": ["driving", "simulator", "safety", "impaired", "education"], "long_description": "**Adiona-G: Driver Safety Simulator** is a professional driving simulator designed for supervised public-safety demonstrations by police departments, schools, nonprofits, and safety organizations.\n\nThe simulator demonstrates how impaired driving affects reaction time, perception, and situational awareness, helping participants understand why driving under the influence or while distracted is dangerous. Each experience is short and guided, making it suitable for public outreach, safety education, and awareness programs where participants rotate quickly.\n\nAdiona-G is **not a training tool** and does not teach users how to drive while impaired. Repeated exposure is intentionally limited to prevent misuse and to reinforce responsible driving behavior.\n\nThe application requires an active license to operate. A **FREE limited personal awareness license** is available for individual users on first use. Organization licenses enable deployment on shared headsets for supervised public demonstrations.\n\n### Key features\n- Professional driving simulator for driver safety awareness  \n- Demonstrates effects of impaired driving on perception and reaction time  \n- Designed for shared headset use in supervised public settings  \n- Short, repeatable sessions suitable for outreach and education  \n- License-based operation for professional organizations  \n\nFuture updates may include additional driver safety modules such as distracted driving and general driver safety scenarios.\n\n{1395514075705333}", "short_description": "A professional driving simulator for impaired- and distracted-driving awareness in supervised public settings"}]}, "developer_name": null, "developer_privacy_policy_url": "https://license.drivingsimulator.com/doc/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Drive Square, Inc.", "support_website_url": null, "website_url": "https://drivingsimulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34264862166492053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1540929947002211"}]}, "baseline_offer": {"id": "1540929947002211"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770209760, "status": "PUBLISHED", "id": "1540929947002211"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35130528036592124", "version": "1.3.0"}, "id": "1558222415297864", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34083280981316840", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35130528036592124"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1558222415297864"}]}, "change_log": null, "crea
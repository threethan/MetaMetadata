082715_8494949141820874220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laR6FFjc0tsQ7kNvwGnPjVQ&_nc_oc=AdpWYY3VGNnXiwYFbgPmoXtSXoPoR_yf5ZE4kN6QRJnSsldFJ7ksc8eb-vx1juIV6vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1-6U4wNRnxlCsori3iTR66a3FFG4Lb_V_NJ352tL-Ow&oe=69C29612"}, {"file_name": "Screen_LaneDeviation.png", "id": "1559139858466924", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300619_1559139861800257_4410172401403098200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-1UeYmzEbkQ7kNvwFKKa8d&_nc_oc=AdorCy-cZvlr5k5kWyfP9HV_-omWYNOfI96rKtG3FcJy7_dS6EfwAjbcqqx92t203gM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8TVH-ofx0_ES5kWa77vovxNAJMVqffqxrxWVQMwCLLg&oe=69C281FF"}, {"file_name": "ScreenCrash.png", "id": "2049472555872971", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300619_2049472559206304_2912588799819759301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYT8xeEmLE8Q7kNvwFJmXWr&_nc_oc=AdrD03sX07ad3zh-JCJea9LFcv9e3rY8SB9oao9b1MWs9ZeAsUYfDBPb035NS0l85Dg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ2q_JhjjBBEZcIqA37qqkqSKkUGDIkiQFpaQ-_xswdA&oe=69C28274"}, {"file_name": "Adiona-G_Distracted1.png", "id": "929496909565921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_929496912899254_7246641211531513160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mxds2nA06OQQ7kNvwFKhd4m&_nc_oc=AdqbVPF8C_m-Mznv5AzoEb_nOFFoUxbes4J2CXmp8lFIob6Ls_simdd1zqUuGUr4NwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyla-yotrgVuQ1_Y5EfDOopcVQJa48onCyVpc1DXCS4Hg&oe=69C291E0"}, {"file_name": "Screen_EU.png", "id": "1982246732696429", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295661_1982246736029762_3269864799395397615_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55X1Bf0jRqUQ7kNvwH4KvZB&_nc_oc=AdogMTj_FTcVI8W7Q-n9cEegMedNoW421sGhCvmA2fRBfBOxjtbDPg4MCxGx4caVUUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAqMp7HnpaT0rout1rtIz1cmaAUZ4y-OaCBjbZfT-ftw&oe=69C291C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adiona-G Driving Simulator", "keywords": ["driving", "simulator", "safety", "impaired", "distracted"], "long_description": "**Adiona-G Driving Simulator** is an immersive virtual reality and augmented reality driver safety training experience designed to demonstrate the real-world consequences of unsafe driving behaviors.\n\nThe simulator places users behind the wheel in realistic scenarios that demonstrate the dangers of **intoxicated driving (DUI/DWI)** and **distracted driving**, including **texting while driving** and mobile phone interaction. Participants experience how alcohol impairment affects reaction time, steering control, peripheral vision, hazard detection, and decision-making. The program also illustrates how texting and driving, even for just a few seconds, can lead to lane drift, delayed braking, missed hazards, and serious collisions.\n\nAdiona-G supports both **left- and right-hand traffic**, with the driver's seating position independently adjustable to either side of the vehicle. All simulations are included with every license.\n\nAdiona-G is designed strictly for education and prevention \u2014 it clearly demonstrates how quickly control deteriorates under the influence of alcohol or while engaged in phone distraction.\n\nDeveloped by a company with over **25 years of experience** delivering full-scale in-vehicle simulators to schools, law enforcement agencies, military installations, and public safety organizations, Adiona-G brings professional-grade prevention training to standalone **VR/AR**.", "short_description": "An immersive VR driving simulator demonstrating the real-world dangers of impaired and distracted driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://license.drivingsimulator.com/doc/privacy.html", "developer_terms_of_service_url": null, "publisher_name
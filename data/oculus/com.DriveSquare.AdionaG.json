82715_8494949141820874220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mll5dfzuLgAQ7kNvwETK-1a&_nc_oc=Adpj2dnhxvXhWiTjw_LwWfp-tqXKvcDGFlTOZrGPuHlYR_iOLhX41gwqL9q6libD2V8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxbynb_q0z1BRCIJRrz8lIch3H792FkrRTbbfzZ51JzHQ&oe=69CFC512"}, {"file_name": "Screen_LaneDeviation.png", "id": "1559139858466924", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300619_1559139861800257_4410172401403098200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PodPWN0ZXrkQ7kNvwFehSMc&_nc_oc=Adp48--78gKXoRIoXNTmOTxwIfTXU_MN1niVU-F4LxnDkRGJjS4sg0GesgrXPbX5uc4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPQjM2o1vYQYkSABaoGJRbpxPC4l_0wCNuW2_DmIVCzA&oe=69CFB0FF"}, {"file_name": "ScreenCrash.png", "id": "2049472555872971", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300619_2049472559206304_2912588799819759301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Du4ojlDiMYQ7kNvwGRgZ_E&_nc_oc=Adq607zDkW0zAEnFchuJmZhPuSBdWKmdvNtDtHwGRr2fnR4p2RHfTqGYDDin0ygeXu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWWVlJjtOvEd__3bTCeNne8DV_aRnohnhUfoqiso1NuQ&oe=69CFB174"}, {"file_name": "Adiona-G_Distracted1.png", "id": "929496909565921", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823351_929496912899254_7246641211531513160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1mycoca9GUQ7kNvwE_SMgF&_nc_oc=Ado1ApceAx9lx8smIKWfZiya45cqjPBPVdCvpWiNt_G6Thz79NTrATarN2rXJA3OBDE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxemoclIdWLpM6XlG4WOvhSgLxZ2yo6tQ30xWMGSspyjg&oe=69CFC0E0"}, {"file_name": "Screen_EU.png", "id": "1982246732696429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499295661_1982246736029762_3269864799395397615_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgEK1UPZqTMQ7kNvwEEExVi&_nc_oc=AdqXnTq-JK4uO5m4HhD6bNr2tAirgmJFdr9bK2jYaiy90kvE6lc4RniEvJKA9tWAOHY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkM-Apaz5tRKAhIyqK_8q55RLQlIS-58F7qgWtixG2fw&oe=69CFC0C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adiona-G Driving Simulator", "keywords": ["driving", "simulator", "safety", "impaired", "distracted"], "long_description": "**Adiona-G Driving Simulator** is an immersive virtual reality and augmented reality driver safety training experience designed to demonstrate the real-world consequences of unsafe driving behaviors.\n\nThe simulator places users behind the wheel in realistic scenarios that demonstrate the dangers of intoxicated driving **(DUI/DWI), marijuana (THC) impairment**, and distracted driving, including **texting while driving** and mobile phone interaction. Participants experience how alcohol and THC impairment affect reaction time, steering control, peripheral vision, hazard detection, decision-making, and visual attention, including attention drift away from the roadway toward distractions. The program also illustrates how texting and driving, even for just a few seconds, can lead to lane drift, delayed braking, missed hazards, and serious collisions.\n\nAdiona-G supports both left- and right-hand traffic, with the driver's seating position independently adjustable to either side of the vehicle. All simulations are included with every license.\n\nAdiona-G is designed strictly for **education and prevention** \u2014 it clearly demonstrates how quickly control deteriorates under the influence of alcohol or THC or while engaged in phone distraction.\n\nDeveloped by a company with over 25 years of experience delivering full-scale in-vehicle simulators to schools, law enforcement agencies, military installations, and public safety organizations, Adiona-G brings professional-grade prevention training to standalone VR/AR.", "short_description": "An immersive VR driving simulator demonstrating the real-world dangers of impaired and distracted driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://license.drivingsimulator.com/doc/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Drive Square, Inc.", "support_website_url": null, "website_url": "https://drivingsimulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35130782716566656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821193_857909077071713_4142260069108978999_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GntRR6i-LLQQ7kNvwHIHHrq&_nc_oc=Adqs-dGezk2UXNJDOVBndrZrp8Va91sDXW1go_Jo0i1opb6rBLksyMNeLHQS7R_meZE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzja4hGs0XtzfnrnBONccnm_Ukx0lELdDYNUIQfjzuzSg&oe=69CFB8F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Adiona-G Driving Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1770209760, "lastRevision": {"nodes": [{"id": "34083281157983489", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "34083280981316840", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": 
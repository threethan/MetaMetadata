d5-2.oculuscdn.com/v/t64.5771-25/499300619_1559139861800257_4410172401403098200_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LwSGHzDaI30Q7kNvwGtI6JW&_nc_oc=AdoF87wpWcYUYEn9oidJfJudq8xDtshZd414NOGNSlkmEAnFNWvedGvX_joZlzcTpuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe5LwT2qRgBI22rO1fBTVk1-nNs3h7XgK54KQASUlKgA&oe=6ABBAD7F"}, {"file_name": "ScreenCrash.png", "id": "2049472555872971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_2049472559206304_2912588799819759301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6cOt4HOg0UQ7kNvwFEl6WU&_nc_oc=AdqIIdlEI1kOSfMcrzhZ7clDQBXN-I9-0geQyvN3mBJwnj8g1_KWgO_c_qUN_nLSV58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0gffPNSBByLBsAkaYExtKeVPUjfEGf6YNGdP4MpPp_g&oe=6ABBADF4"}, {"file_name": "Adiona-G_Distracted1.png", "id": "929496909565921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_929496912899254_7246641211531513160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QNY8nXHxewQ7kNvwHT4Bnq&_nc_oc=AdpJjmSlD4InafxZfNUCO2QIu00SD-A-o9l-R708J3Fl0Qur5VkzM_I06oibkKXWoYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWz3z4wLcGfkNMiUg5_0RSoE6gmG-in4f5d9OWQ0Al_w&oe=6ABBBD60"}, {"file_name": "Screen_EU.png", "id": "1982246732696429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295661_1982246736029762_3269864799395397615_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzS5W6eJ5QYQ7kNvwFKzfAu&_nc_oc=AdqSuOie_FGDyasuR3kt2GAUa0KVD_jZn4QOmTdlDDmgi2ujIe_QUwwIo9Z7DEaV74k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2tS5848sCGJP-yleTjcf5c76tlccBwW5CDRLVdZGMag&oe=6ABBBD42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adiona-G Driving Simulator", "keywords": ["driving", "simulator", "safety", "impaired", "distracted"], "long_description": "**Adiona-G Driving Simulator** is an immersive virtual reality and augmented reality driver safety training experience designed to demonstrate the real-world consequences of unsafe driving behaviors.\n\nThe simulator places users behind the wheel in realistic scenarios that demonstrate the dangers of intoxicated driving **(DUI/DWI), marijuana (THC) impairment**, and **distracted driving**, including **texting while driving** and mobile phone interaction. Participants experience how alcohol and THC impairment affect reaction time, steering control, peripheral vision, hazard detection, decision-making, and visual attention, including attention drift away from the roadway toward distractions. The program also illustrates how texting and driving, even for a few seconds, can lead to lane drift, delayed braking, missed hazards, and collisions.\n\nAdiona-G supports both left- and right-hand traffic, with adjustable driver position. All impaired driving simulations are included with every license. Organizations can display sponsor or safety messaging before a session.\n\nAdiona-G is designed strictly for education and prevention \u2014 it demonstrates how quickly control deteriorates under alcohol or THC or while engaged in phone distraction.\n\nDeveloped by a company with over 25 years of experience delivering simulators to schools, law enforcement, military, and public safety organizations, Adiona-G brings professional-grade prevention training to standalone VR/AR.", "short_description": "An immersive VR driving simulator demonstrating the real-world dangers of impaired and distracted driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://license.drivingsimulator.com/doc/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Drive Square, Inc.", "support_website_url": null, "website_url": "https://drivingsimulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_typ
QKGPs0fEKGRLllt2IuSIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwHkpxQVzByba6sw1ytsvPpdT9FwU4IMwoAXrXWUfiUdg&oe=69AC187F"}, {"file_name": "ScreenCrash.png", "id": "2049472555872971", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_2049472559206304_2912588799819759301_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgVvzsKr0dsQ7kNvwFwO0xS&_nc_oc=AdleedBeIpe3hj168VI4g5EpyExOQ6dGPf99T99WNgU5iN7jj0wPQ1mNU2OKN3qRLMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1u5hbqqWsG7aLFjS1nKu2Ahn3vnBofPSn6NSlNSFF5g&oe=69AC18F4"}, {"file_name": "Screen_EU.png", "id": "1982246732696429", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295661_1982246736029762_3269864799395397615_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OU2NK8P8ISYQ7kNvwEilmEI&_nc_oc=Adm0_m0Rqlx3MyRfv_AZXUfgduzQ3WreyGf_dYv4zASLByfkAJ95XXZ7MCz-UYt7U-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLyQmafxVQXnk9KWYxjQ0AIulv-m5gmwZMZtifiacHvA&oe=69AC2842"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Adiona-G: Driver Safety Simulator", "keywords": ["driving", "simulator", "safety", "impaired", "education"], "long_description": "**Adiona-G: Driver Safety Simulator** is a professional driving simulator designed for supervised public-safety demonstrations by police departments, schools, nonprofits, and safety organizations.\n\nThe simulator demonstrates how impaired driving affects reaction time, perception, and situational awareness, helping participants understand why driving under the influence or while distracted is dangerous. Each experience is short and guided, making it suitable for public outreach, safety education, and awareness programs where participants rotate quickly.\n\nAdiona-G is **not a training tool** and does not teach users how to drive while impaired. Repeated exposure is intentionally limited to prevent misuse and to reinforce responsible driving behavior.\n\nThe application requires an active license to operate. A **FREE limited personal awareness license** is available for individual users on first use. Organization licenses enable deployment on shared headsets for supervised public demonstrations.\n\n### Key features\n- Professional driving simulator for driver safety awareness  \n- Demonstrates effects of impaired driving on perception and reaction time  \n- Designed for shared headset use in supervised public settings  \n- Short, repeatable sessions suitable for outreach and education  \n- License-based operation for professional organizations  \n\nFuture updates may include additional driver safety modules such as distracted driving and general driver safety scenarios.\n\n{1395514075705333}", "short_description": "A professional driving simulator for impaired- and distracted-driving awareness in supervised public settings"}]}, "developer_name": null, "developer_privacy_policy_url": "https://license.drivingsimulator.com/doc/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Drive Square, Inc.", "support_website_url": null, "website_url": "https://drivingsimulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34264862166492053"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1540929947002211"}]}, "baseline_offer": {"id": "1540929947002211"}, "is_approved": true, "fi
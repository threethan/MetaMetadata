amrYezhVgL09e5AylHCS0bvMXVkC4g&oe=69A82136"}, {"file_name": "SCREENSHOT 3.png", "id": "1694247307956989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300574_1694247311290322_3089259316170905261_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FeReb0FiRwQ7kNvwE1no8g&_nc_oc=AdmZjfGQl0zA8PobQoiLPi_PooHxHrdLCiMIYOMzN8rZbwb38wTISOVQ3FmcRePj4OI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvO-wUMjtHSmGhlQUnpQgVkIcsQTvpDg1hRLIkquyCCzw&oe=69A80F47"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crafting Crimes", "keywords": ["Podcast", "Puzzle", "Investigation", "Documentary"], "long_description": "# **A true crime podcast, reimagined for mixed reality.** \nWith mixed reality, podcasting reaches its ultimate form. Guided by host and miniaturist Carol K. Ras, you don\u2019t just listen to the story \u2014 you build it. Legendary cases unfold in miniature before your eyes, transforming investigations into an experience you can see, touch, and explore.\n\n\n# **Craft miniature crime scenes. Reveal the mystery.**\nIn each 20-minute episode, you place walls,  objects, and evidence with intuitive hand-tracking gestures. The crime scene materializes in your hands, drawing you deeper with every detail and letting you explore the investigation at your own pace.\n\n# **Three episodes. Three iconic crimes.**\nFrom the Lizzie Borden murders in Victorian America, to the violent descent of 1980s Hollywood in the Wonderland House, to the audacious Mona Lisa theft in Belle \u00c9poque Paris \u2014 each episode pulls you into a world where history\u2019s most infamous investigations unfold at your fingertips.", "short_description": "Bring the world\u2019s most iconic crime cases into your living room with this mixed-reality podcast series.\n\nFrom Lizzie Borden to the theft of the Mona Lisa, reconstruct infamous crime scenes in miniature with host and miniaturist Carol K. Ras.\n\nBlending true crime with model-making, each episode transforms history\u2019s most haunting investigations into a truly hands-on experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.targostories.com/privacy-policy-crafting-crimes", "developer_terms_of_service_url": null, "publisher_name": "TARGO", "support_website_url": null, "website_url": "https://www.targostories.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25216896681231328"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "740647805635744"}]}, "baseline_offer": {"id": "740647805635744"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1759330800, "status": "PUBLISHED", "id": "740647805635744"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26570692159185100", "version": "0.0.89"}, "id": "23952399834394844", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24507080275546309", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26570692159185100"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "cre
me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1GFrAYcVlQQ7kNvwHVDDHa&_nc_oc=AdrtTB5z3Om5_uiRRdqMOclzMsYUQSIJ6FThGQHHcp7my5wjMJ7vagpPKDf0jHR5A4s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IOzZH1kTTQkgS2lQ-u4iqfx_2eTbMYR0tlvbA-L3GjQ&oe=6A15C652"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uRZQWxGxcIQ7kNvwH5MvHq&_nc_oc=AdouCI4v6Uq-yc3A9YXus39g_Hq_vbhs5Zalr9qsT3_co28OxonOQ84qBtOzUBekg4M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-_BOmKoxJ1QK42CClddQIcUcvpCkNv4RV7YnuMkgeuQ&oe=6A15A7C6"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tqI__mcOXcQ7kNvwFUxbNd&_nc_oc=AdqU5woPXYX4aJyxuoPgnSbCUk5J11ZJo3Ca41P0ivkAsTu7AePlTQGB4Z6LvMVIafY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lhb-Ih6coD9KfI3Bz07qOz8C6YwH6A4cjE-9UBKxPvw&oe=6A15A6FA"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF4NcxZ7BFwQ7kNvwH_5wHY&_nc_oc=Adpx21L6E2_92W_45fLuUyqmrPASLHngMs-GErQA1fhzteWU_QRq346vBBBpI6VjwTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R_tH3jX3wDGSw4cVrWc_6_1suzNmQ6b14jsImWcLSoQ&oe=6A15ADA8"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvPkoHqjyUEQ7kNvwEjKqu3&_nc_oc=Adq85mv5wc1E19iEXyvKjk01IPrWHLHXNB-V_K1-TwBsT_ya7pWs5SVnfBNx7EPZFak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DIiAxwq_WdRlEKiDOigI2lPBplrlC6r9IuOoIXsi1HQ&oe=6A15C638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnPAbYlXmcYQ7kNvwGWckV-&_nc_oc=AdrzSPhYTzAmesdY5qnFoc7OmmIQ10Sto7gk8UiBlZFuQe4EYj456R_meakbhggDIhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cKB9UFztGRYLEVWVkKWkBJSegiJKNUC2HgbsetfjOIg&oe=6A15C570"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526642818853271"}, {"status": "PUBLISHED", "id": "937731905779077"}, {"status": "PUBLISHED", "id": "1005826688862987"}, {"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782928800, "status": "PUBLISHED", "id": "1526642818853271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
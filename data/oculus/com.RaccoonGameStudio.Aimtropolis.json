me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8_72H3XbWQQ7kNvwFZAf0a&_nc_oc=AdrggE5cegNc8KwChXyNLFItwn1VaUZr1IyODOHd63R47kRqst57mcWsk3mfLoJNoMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K9voW3LheDwcpgWZP4rUuiYKFtWGcoxIWEQvOfpMvUQ&oe=6A295492"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg06VsqEX1EQ7kNvwEiYCd-&_nc_oc=AdqgPIO-DfqvAJvrU8RC06IfeY3Bh2Ix9p9KaBMcjULrDUab2ujHJo7_LWagxc6LcnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OS6xAt4Ly4fsIVivuGb8pzcbR-1rgpR3VaxUaxw-wFw&oe=6A296E46"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAUkQJ-DLYgQ7kNvwHDSYf3&_nc_oc=AdqETM8ebbeIbe2XLWsS8QPzdEWT0JbnVgtfH5nn4hEIiLoPMHdjxcWsmjmIqsddTYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R_hJZMrdKXQP9BqIyXEnA_F1Utdj7C3MkmuSFR4xw7Q&oe=6A296D7A"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CRwiVAvmv0Q7kNvwGIL1Tg&_nc_oc=AdpTeWOGGcAVGGIsumiYCRiUABXmgycNOblj1_84FAzm0SYgQIBTTfER_QQDaTpfCng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lvMjRmJt6Noc39FeUcvPJRjIIv5-pQbXFw1Z45PRTVA&oe=6A297428"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feL4ie-vUYgQ7kNvwHz8yAV&_nc_oc=AdqmBSkDi1NBQvrgXjYxLBH7NRDyxZeLf8SAGCLfmrOaCm8yr9ik8YrO6RvjtRNnpV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Fsk-4k1WK6cA2LUsxgKs1XClHnrQbNS7byvZ_IWmQA&oe=6A295478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRcWOx0djxYQ7kNvwGAb91u&_nc_oc=AdqPlGyGjbZQVVl_v68IsIVG6tq-PXsotb-DVeavcLltNQTKTUWP-7CxjOoz7ffQZhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95a-Y-8ljYgzoGtUZmpb1mw7RzT9Woj_73TdbfJUl1mA&oe=6A2953B0"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526642818853271"}, {"status": "PUBLISHED", "id": "937731905779077"}, {"status": "PUBLISHED", "id": "1005826688862987"}, {"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782928800, "status": "PUBLISHED", "id": "1526642818853271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
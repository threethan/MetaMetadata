me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOdHSu80U0cQ7kNvwEveWSg&_nc_oc=Adr1jnvriwcyDGzoWcDn7JsbhYl8h7aBU93hFVS3LBTKGNyBaPPO2-Wecq3NjQdItZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g7wvrpdCPnGMRMYC0EeBWQT1R3J1qLLXoj9AfZkW8pw&oe=6A0B0212"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MntAiYLM44QQ7kNvwFR6oUO&_nc_oc=Adp840We0rVhFBjHg31gMrVsM-6ZV6EmcK6NlSJqyU3QTIIvyMM8064Mf5ytpB3eTNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P2oD5ikwrLfNQ0elX-s15X-G1s2cGDdH2Brcm3nXcNQ&oe=6A0B1BC6"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYATubfqxDQQ7kNvwFV8pJn&_nc_oc=AdqaY0hC7LPjI8ZOrSCLCs6S43Q3x0a1w4d7NAKIRP7YRfunyem7jqF-9AKexNRBRj8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yc2m_W9manuyacAPAlUJ-5eItXlu6Aoa-eMnj2MAkLQ&oe=6A0B1AFA"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGHtthsFXJkQ7kNvwEp4A-m&_nc_oc=Adri7w_14JNObr2Th0R_hXSeAdrc8JEl527xHUl3u6gEzKPNHWbB4h4ep6MCeIGUhjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BZ8qjUUmKuwPp5_7-7-vgJbJhyTctgdJi2ORwEsHq5A&oe=6A0B21A8"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kal77g9BYgQ7kNvwFcH5yz&_nc_oc=AdqwsZ2h3qcaAG-xxwOlWnHrh39dWJu2yu2RV2pKd7Y-TcOJmaRk6l0tsZm7D5GeoXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yDivKuYbkNEwDKRhkhtARwIdRaMKn7Z8Lr2u10DTgTQ&oe=6A0B01F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj7emxDR_8kQ7kNvwH4tt_S&_nc_oc=AdoCCL6ftaL5r1N3GySFXKz7DxGvT61YrHBPJFmumPZ-8CtlgXfA2PEhLinlB7pH8Ho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bzJcXlk0WEIgzXJGk8mfKM1_D5aVnEGRpaYXoRXqO9A&oe=6A0B0130"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526642818853271"}, {"status": "PUBLISHED", "id": "937731905779077"}, {"status": "PUBLISHED", "id": "1005826688862987"}, {"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782928800, "status": "PUBLISHED", "id": "1526642818853271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
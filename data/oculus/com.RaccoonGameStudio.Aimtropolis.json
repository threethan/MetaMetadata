me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VXDy861opoQ7kNvwFrTqdc&_nc_oc=AdrLOgsLZ1ueRY0xqbrtdVIyQuSH0-PwbwLY1qlIFGE10wxwd4ozh_Po7EL-OkSMh7Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3SkDszQyG_iBCLlhwKio_6ij8flZfnam8kccCMPSzHsA&oe=69F34712"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySTFtx8ITncQ7kNvwEjIo54&_nc_oc=AdooNOrvJZ3x-sQ1Bgu53CrTR-OXpof8kNNmO3lBEKR9BvfsBLjkXHQTw5AT_7e1JQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eO3lrOD-WBB1x8XS0Cm5BN7xbWhdHYew7mG9yuz4yzw&oe=69F360C6"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyWM19RxD7oQ7kNvwEb_NZ2&_nc_oc=AdrIGH_RimumzJFhwSDftoKrVh3L9pNJWhLc3Yw_qgJMS-nJa8IR9-U3SB49Iqq8de4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2xUN55vBhBd923Pnaj8VirD4Gfol94HzizSmZJTyn4Tg&oe=69F35FFA"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev00j3DddkcQ7kNvwHTyA2D&_nc_oc=AdrwHRP4-rRhev2mXOQ5n41KA3k3Iy-cOshRURfzWESxe5cxKKC-wNrOE6lwF-o4lxM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11TIAYPAHIg2w50Ds7DRwAEoGJacg2cWfCerBDGhbdow&oe=69F366A8"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffwfLX8-jgMQ7kNvwHPFPB-&_nc_oc=AdoX9JJ-K9TRv0iVhCet1jZNpkvzZI9Rm6L0WjGpwYoU5Jw2iGOkyWOPeTWepOQH5Z4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02j4YCyqAE1wKAIfM3qfcAvNId6qEyRSLzEH1ST6ANWA&oe=69F346F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWT_u2OictcQ7kNvwFnqLR-&_nc_oc=Adpa9hTBNc1jUArnhVL6GCjGRmj-98Q8ZCOeQVgnncxSLcIHa4SXa7QDvzRkLtFu670&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Jw_w3KpJlKMj9T_n5veGGS822-1I7u-YFOvcD6-A_lg&oe=69F34630"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526642818853271"}, {"status": "PUBLISHED", "id": "937731905779077"}, {"status": "PUBLISHED", "id": "1005826688862987"}, {"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782928800, "status": "PUBLISHED", "id": "1526642818853271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
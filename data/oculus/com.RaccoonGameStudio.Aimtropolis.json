me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvK7vjFdpVIQ7kNvwHobQSE&_nc_oc=Adoh0gmxTRGkOd0uTzxS0O_HicCNHrumJoFNbAz3M9It-NhGGmS58wYuimY80kZgaEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGB08xkhOIuPhk7ozv7sB92rC6ORxrXeCOhAl-sI7E1Q&oe=6A732892"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbHlnF2JANwQ7kNvwGSoJmg&_nc_oc=Adow7uJp-6uZOisRT5SN4FQvjE6tAhpuIu2I-XyoRK6JV83938-GRXWdKaSVZj_eJaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbpDHR8BczLNqwiKGSpx2duZP1LDXIRFdGOFZ7qssXrg&oe=6A734246"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptYBGA0Zlw0Q7kNvwFNxXI1&_nc_oc=AdqG5Bnp6nPGWxXC1m4vpSAwBsFcyyOWGnggAMayomhI5Ocl7aRGFIqlUkS-tnYpw-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYILXt_KF9K9XWDzD7w1UEKT2Izds1Ka0eF1E2-xd-uw&oe=6A73417A"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D28spnPWzIEQ7kNvwG27GuQ&_nc_oc=AdpqrSDxIPpBdn0H6BBPunpjRrITwlUmUan63gMihwRMM_CuEsUvESlSeMfSOrx0W6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNWLM4eVPbzL6N87dLElhw0aAEXF9_ngi-r73TOhJ4KA&oe=6A734828"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-Qz7jrpxWUQ7kNvwEf2CHP&_nc_oc=Ado74YDJrV7LkK4R627l_pIoLieiX4YzafuZkvGbPVIU1z-JnXiDw38Dw9kWMDK_JA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO5L-Ef9mRWMU1LaA4vKhezoQq8FBLvhYU6bVqpS1lLg&oe=6A732878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgecRARxHUsQ7kNvwFJZ9vP&_nc_oc=Adqrhtbc9GD468gqSTDRqbHV1Dive8HYNO5rdujpoBfZE8XOR9wT9vnmT7ihq0rH_ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZzs7o-gn3Ft8Ow_CNvfV8laK8dgQqx0BJmj_ZzdvjKg&oe=6A7327B0"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1526642818853271"}, {"status": "PUBLISHED", "id": "937731905779077"}, {"status": "PUBLISHED", "id": "1005826688862987"}, {"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782928800, "status": "PUBLISHED", "id": "1526642818853271"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
me": "Meta.png", "id": "170376972538115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031321_170376975871448_2683187131496928797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IPjzvuwE2oQ7kNvwGtvan4&_nc_oc=AdoGtjgB0PJVVV_9cnN60G8j5-Q2Rh0g1RVVffuCQ-57mtmbynVEx0BqgWTsobk4fS0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFBQe8zj8hlTHanfox5pdGd_hwP8PS7UqVwHu8FDV7XQ&oe=69CBBA12"}, {"file_name": "Meta3.png", "id": "156515616895531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031467_156515620228864_2911537357404589914_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYcFGNPqEP0Q7kNvwGGJ89e&_nc_oc=AdrP7gXC9kDd7eXDJKOaeuxrgIfFYqPNxaFmHltsCHOtybRF_knGRtBgjcg251YZ2uo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyd28uy2ynCQ65eZs6oW3AsNWti5VoX5RhLWcuMBaY9Fw&oe=69CBD3C6"}, {"file_name": "Meta5.png", "id": "151693177800948", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982627_151693181134281_68791893497778142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWEBmIjwytIQ7kNvwF1ATXa&_nc_oc=AdpcTHzjA8D5PhBeocOZor2NvKOhoS_iETomZQ6p632JtboAdawMMaW8aw4OL5Dqau4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw145mSC7DDnHs8vCVLzfG4SONEWbuz_o8XulMNnm3WuQ&oe=69CBD2FA"}, {"file_name": "Meta4.png", "id": "764251458657732", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222937_764251465324398_2649811843919354404_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sx2OEVByxIYQ7kNvwHNWeHc&_nc_oc=Adom_Fxmq7MaVt0TKO5Fo2JLPgXV3uE1X60HJggjkb3xGA2pnqvyTcdUnzWS_N2pdmE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwR2ONuZlzIobWAfTlXESWQ4qzDMt-0bqYj-vZdJ6JFdQ&oe=69CBD9A8"}, {"file_name": "Meta2.png", "id": "597031222025232", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974642_597031225358565_7348896156065516616_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyREC61C51QQ7kNvwFhHUUe&_nc_oc=AdrwNtfMklvk0hmosmw5bWskxQyMtDWCqVadDFiINJ63ktBek0REACl2psxpcw1YNx0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhzAmIp6lUxrADnygQo6kPDigzvxhmiuFaZMZpuy0NJA&oe=69CBB9F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada-Trailer.png", "id": "740220340815673", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003285_740220344149006_2397634622304036355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL2qI-H0JVAQ7kNvwEYCcTX&_nc_oc=AdqV-7_C39eOxcnzf3Jt8dtD4TIp52YWkWZAbKr7hNlgHFqw7gl-Pz0AdtSvy7eO7hI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsSaXxBoQdpF9repxd1v2QqmcqRGN-zk-MArB9eAenFw&oe=69CBB930"}, "display_name": "Aimtropolis", "keywords": [], "long_description": "AIMTROPOLIS is a VR shooter/arcade focused on overcoming a certain number of mini games per run. Your goal will be to get the highest score in each minigame so you can get the best score in your country, region or the world and be crown as a Champion. \nAimtropolis will have 25 levels on release, and it will be monthly updated with a new levels package until 50 are reach*. \nIn each run in AIMTROPOLIS you will have to overcome 12 random challenges from the levels available where the player will have the chance to prove that it has the best aim amongst other players and crown itself as World Champion.\nYou will have different difficulties to choose from depending on your ability and aim which makes Aimtropolis a perfect game to practice your aim. \nThe worlds are unique and in each one you will see a completely different setting. From the Western to the Caribbean, going back in time to the medieval times or going forward to the future to our Sci-fi world. The amount of minigames, the worlds and the different difficulties will make a different experience for the player every time plays Aimtropolis.\n\n*The new updates will be announce on our social media and through  the Meta Posts. ", "short_description": "Do you think you have a good aim? Prove it. AIMTROPOLIS is a VR arcade/shooter where you will have to prove yourself and the rest of the world in 7 random minigames from the 20 available. Get the highest score, and position yourself as a world champion.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raccoongamestudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "9Interactive", "support_website_url": null, "website_url": "https://www.aimtropolis.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "967356804710197"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "770566417870656"}, {"status": "PUBLISHED", "id": "1066510854489578"}]}, "baseline_offer": {"id": "1066510854489578"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1684512000, "status": "PUBLISHED", "id": "770566417870656"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7685379044894910", "version": "1.2.2"}, "id": "1186804698623091", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5305975889501916", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "768537
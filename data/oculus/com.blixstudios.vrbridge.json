-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRv5NKQ--RAjAtZILrHChPcPMeOu4vZSMzknoRJJSehA&oe=6B0C5B7F"}]}, "id": "2151825432112666", "locale": "en_US", "screenshots": [{"file_name": "05_captura_02_puesta_en_marcha.png", "id": "1713828900155295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835815_1713828903488628_1234349961879474250_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zby7bKG9SNYQ7kNvwGML-9x&_nc_oc=AdoA62F9elcpZiCr6lLTjKAWJUpGCX64DBbd5uf9Go5JbZfgURONoowy_OJ4IvOupqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCFCecirU--h1YkbzWBqxepHvQsBJWpB14ccIkp7fnlQ&oe=6B0C7939"}, {"file_name": "05_captura_01_epis.png", "id": "1108144948929851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835807_1108144952263184_8635146957066581316_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79jrFgx4FMgQ7kNvwGP3Sbi&_nc_oc=AdoqEZxwXQBgOXZYCXr6FlYKaZ6o8FAt7ZqRIwZ95KeKOYzqg2qkwJM8Hn_BtsJGGwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTueZMx7hTmZv7jsQyzgOTxLXslCKdYfZ_1QbY7O9ewmw&oe=6B0C6026"}, {"file_name": "05_captura_03_puesto_de_trabajo.png", "id": "2667829736988281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835849_2667829740321614_3350888075349216235_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMu9ivcQPwgQ7kNvwGqDgxM&_nc_oc=Adp8MOnbU8gd5j6afVY_sWnybd72OjNUSSyMo3SyQwmlAieWx2Z9qmE8pQ-W48yas80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpZu8LgNVk16ZAAp71dKhQXDoBpXp51SQV-ATUaGYlew&oe=6B0C5E5B"}, {"file_name": "05_captura_04_izado_con_pulpo.png", "id": "1144512134942959", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908835836_1144512138276292_82223140460128939_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xU-OICnCXAQ7kNvwEzy1OM&_nc_oc=AdpFW8VV9qnnT4AYsGGZg34FsrjJEnZ1w2fAN3gK2Ytq4ov-4sG-9_ns_4k5yxkBH8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5mB8c-AqrH6AMu9MmQ3-uozRpDLk_qFeWd4akQGHOXA&oe=6B0C6524"}, {"file_name": "05_captura_05_entorno.png", "id": "1885808782423309", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835840_1885808785756642_6343766995505070532_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuGhiEc-ndgQ7kNvwHTqM90&_nc_oc=AdriRlbJbZmQU7az7ayAaZwm2_5XgUCgDb4kkxWKkuFlKaCokmVgWF1GSXeej6bbsH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVNa5BN0tSm4S77re-M4E8PVOQeD8nq4cyjtlDlABoOQ&oe=6B0C61D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhead Crane VR Instructor", "keywords": ["crane", "overhead", "rigging", "training", "simulator"], "long_description": "# Overhead Crane VR Instructor: Train for the Real Thing Without the Risk\n\n**Overhead Crane VR Instructor** is a professional safety training simulator for overhead (bridge) crane operators in industrial plants and warehouses. A virtual instructor guides you step by step through standard operating procedures using a wireless pendant remote.\n\n### What You'll Learn\n- **PPE:** Helmet and safety boots.\n- **Know the Crane:** Main girder, end carriages, trolley and hoist, hook and block.\n- **Pre-Use Checks:** Remote battery and arming, emergency stop, brakes, upper limit switch, warning horn and light.\n- **Rigging:** Inspecting 4-leg chain slings and textile slings, reading the WLL tag, sling angles.\n- **Load Handling:** Test lift at 10 cm, controlling load swing, moving long loads and precise placement.\n- **Real Risks:** Experience sling failure, side pulling, people in the travel zone and brake failure.\n\n### Modules & Free Practice\nFollow the full course or jump to any module, then practise load transport, precision stacking and a slalom circuit\u2014ideal for onboarding and refresher training.\n\n### Built for Training Centres & Companies\n- **Language:** training content in Spanish.\n- **Controls:** Touch controllers.\n- Custom organizational branding available.\n\nTry the free 15-minute demo. Team licenses for companies at vrinstructors.com. Supports training; does not replace formal certification.", "short_description": "Learn to inspect, rig and operate an overhead crane safely in VR. Guided modules, real risks and free practice. Training content in Spanish."}, {"images": {"nodes": []}, "id": "2060102894673322", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Overhead Crane VR Instructor", "keywords": ["puente", "gr\u00faa", "eslingado", "formaci\u00f3n", "simulador"], "long_description": "# Overhead Crane VR Instructor: entrena para la realidad sin riesgos\n\n**Overhead Crane VR Instructor** es un simulador profesional de formaci\u00f3n en seguridad para operadores de puente gr\u00faa en plantas industriales y naves. Un instructor virtual te gu\u00eda paso a paso con la botonera inal\u00e1mbrica.\n\n### Qu\u00e9 aprender\u00e1s\n- **EPI:** casco y calzado de seguridad.\n- **Conociendo la m\u00e1quina:** viga principal, testeros, carro y polipasto, gancho y aparejo.\n- **Revisi\u00f3n de seguridad:** bater\u00eda y armado del mando, seta de emergencia, frenos, final de carrera y avisador.\n- **Eslingado:** revisi\u00f3n del pulpo de 4 ramales y de las eslingas textiles, placa WLL y \u00e1ngulos de eslingado.\n- **Manipulaci\u00f3n de cargas:** despegue a 10 cm, control del balanceo, traslado de cargas largas y colocaci\u00f3n precisa.\n- **Riesgos reales:** vive la rotura de una eslinga, el tiro oblicuo, personas en la zona de tr\u00e1nsito y el fallo de freno.\n\n### M\u00f3dulos y pr\u00e1ctica libre\nSigue el curso completo o entra en cualquier m\u00f3dulo y practica transporte de cargas, apilado de precisi\u00f3n y un eslalon: ideal para incorporaciones y reciclaje.\n\n### Pensado para centros de formaci\u00f3n y empresas\n- **Idioma:** contenido formativo en espa\u00f1ol.\n- **Controles:** mandos Touch.\n- Personalizaci\u00f3n con tu marca disponible.\n\nPrueba gratis la demo de 15 minutos. Licencias para empresas en vrinstructors.com. Apoya la formaci\u00f3n; no sustituye la certificaci\u00f3n oficial.", "short_description": "Aprende a revisar, eslingar y manejar un puente gr\u00faa con seguridad en VR. M\u00f3dulos guiados, riesgos reales y pr\u00e1ctica libre."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrinstructors.com/privacy-policy", "developer_terms_of_service_url": "https://vrinstructors.com/terms-of-service", "publisher_name": "VR INSTRUCTOR", "support_website_url": "https://vrinstructors.com/help", "website_url": "https://www.vrinstructors.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1494637080394140"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1124792637077061"}]}, "baseline_offer": {"id": "1124792637077061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795117140, "status": "PUBLISHED", "id": "1124792637077061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1490527987471716", "version": "1.0"}, "id": "3417966951725471", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBin
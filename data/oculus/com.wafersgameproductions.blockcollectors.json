2rXsX-KsfokFqYRUX6AuvSw&oe=6AFDD680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Block Collectors (4).png", "id": "2211971042717081", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303174_2211971046050414_1417737489164499208_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUz9_rJhp4kQ7kNvwH4MLvY&_nc_oc=Adq5pNQoLUFe4R7bb314TsEem78iLnUP9cE1g7_4fva6xq5raY54OcFAqmDwBnmSXVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC4qwo2ER_1Y7lr3gXxKDwhvz_s0Wvyv3eCp6G4ehnPg&oe=6AFDC362"}, "display_name": "Block Collectors", "keywords": ["block", "sell", "upgrade", "factory", "build"], "long_description": "Blocks are falling from the sky onto a floating island, and they're all yours.\n\nBlock Collectors is a VR collecting game where you move with your arms and grab blocks with your hands. Pull them in from across the island, stack them up and hurl them into the stormy sea below. Every splash pays, and your coins fly straight into the watch on your wrist.\n\nCOLLECT\n\u2022 28 rarities, from everyday blocks to ultra-rare glowing, rainbow and galaxy ones\n\u2022 Rare finds shoot a beam of light into the sky\n\u2022 Fill your Block Index for bonus luck\n\nUPGRADE\n\u2022 Spend cash on luck, money, reach and bigger stacks\n\u2022 Grow huge upgrade trees with gems from rare blocks\n\u2022 Luck events like Meteor Showers, Golden Rushes and Galaxy Storms rain down better blocks\n\nFIGHT\n\u2022 Giant boss blocks crash onto your island\n\u2022 Hit their glowing weak spots, brace for their shockwaves and win a shower of loot\n\u2022 Mega and Titan bosses for the brave\n\nBUILD\n\u2022 Draw conveyor belts and add machines that upgrade, launch, copy and sell blocks\n\u2022 Your factory keeps earning while you're away\n\nHATCH\n\u2022 Smash boss eggs on the ground to hatch 20 pets across 7 rarities\n\u2022 Pets roll up blocks like a snowball and go BOOM to sell them\n\nREBIRTH\n\u2022 Start over stronger and earn Stars for 95 permanent upgrades\n\u2022 Unlock new machines and tougher bosses\n\nPlus 60 trophies, 4 save files and plenty of comfort options.\n\nHow big can your block empire grow?", "short_description": "Blocks are raining onto your floating island, and they're all yours. Move with your arms, pull in blocks of 28 rarities with your hands and hurl them into a stormy sea for cash. Grow huge upgrade trees, battle giant boss blocks for loot, build a factory that earns while you're away, hatch pets that roll up blocks and go BOOM, and rebirth to grow even stronger."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blockcollectors/home", "developer_terms_of_service_url": null, "publisher_name": "Wafer", "support_website_url": null, "website_url": "https://sites.google.com/view/blockcollectors/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1279694225236502"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "851326641339468"}]}, "baseline_offer": {"id": "851326641339468"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790697060, "status": "PUBLISHED", "id": "851326641339468"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1
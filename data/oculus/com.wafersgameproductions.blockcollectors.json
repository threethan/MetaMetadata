c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-2zVo4tJ-MQ7kNvwG1cQKm&_nc_oc=AdqETby2VjC4RbpnVfP6A9nXmiphWwEy6t_vlk6L8ATGZn1-lF1iNMNAHL0o0nYKWJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJJzsHJAslazQGtLNeHd1QoxO84pUue93-kBJEDzznjQ&oe=6AFDD64D"}, {"file_name": "17 The factory at night.png", "id": "1963223677703313", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312231_1963223681036646_3733969939665151533_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tm96eaUiNcsQ7kNvwFLtYS6&_nc_oc=Adojt7poksYnF12IBV5YWQaG3jkknqNbkDcSOSYN-ItQ9bAy04o0xKdPlUOM0VDFpBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSo0KoNHoz-YKMsIVETGo9fcapCmRQO71Q8C3uBfIe4g&oe=6AFDDFD9"}, {"file_name": "37 Over the pyramid.png", "id": "1646929633710782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314643_1646929637044115_6601821085893719055_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPBCWCF64RgQ7kNvwEPBAz7&_nc_oc=AdrUY5JAzcM12qJpj6M5cCv55H8CLCnUdTdpZySOQdnpoI8lMA2gE3rVi6uvbYZzwb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSD0jbdijkddP4XRt8fCFldVdQqI17prd3iLJtL1ZV8A&oe=6AFDB32F"}, {"file_name": "16 Across the factory.png", "id": "1790884786380758", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313072_1790884793047424_9091579184655570215_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfXhY64umJ0Q7kNvwGUJZMw&_nc_oc=Adqfy-09K1TTtTDdRIOLCEo7d8_YnaH3PsrnxFLirz5eMmaXN421ietPuAvVLDPBWyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh3Bq9YG-a39_QwX7osq-HC4bIiaLM81UjOaFO7ibjvQ&oe=6AFDE390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Block Collectors (4).png", "id": "2211971042717081", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303174_2211971046050414_1417737489164499208_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUz9_rJhp4kQ7kNvwH4MLvY&_nc_oc=Adq5pNQoLUFe4R7bb314TsEem78iLnUP9cE1g7_4fva6xq5raY54OcFAqmDwBnmSXVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC4qwo2ER_1Y7lr3gXxKDwhvz_s0Wvyv3eCp6G4ehnPg&oe=6AFDC362"}, "display_name": "Block Collectors", "keywords": ["block", "sell", "upgrade", "factory", "build"], "long_description": "Blocks are falling from the sky onto a floating island, and they're all yours.\n\nBlock Collectors is a VR collecting game where you move with your arms and grab blocks with your hands. Pull them in from across the island, stack them up and hurl them into the stormy sea below. Every splash pays, and your coins fly straight into the watch on your wrist.\n\nCOLLECT\n\u2022 28 rarities, from everyday blocks to ultra-rare glowing, rainbow and galaxy ones\n\u2022 Rare finds shoot a beam of light into the sky\n\u2022 Fill your Block Index for bonus luck\n\nUPGRADE\n\u2022 Spend cash on luck, money, reach and bigger stacks\n\u2022 Grow huge upgrade trees with gems from rare blocks\n\u2022 Luck events like Meteor Showers, Golden Rushes and Galaxy Storms rain down better blocks\n\nFIGHT\n\u2022 Giant boss blocks crash onto your island\n\u2022 Hit their glowing weak spots, brace for their shockwaves and win a shower of loot\n\u2022 Mega and Titan bosses for the brave\n\nBUILD\n\u2022 Draw conveyor belts and add machines that upgrade, launch, copy and sell blocks\n\u2022 Your factory keeps earning while you're away\n\nHATCH\n\u2022 Smash boss eggs on the ground to hatch 20 pets across 7 rarities\n\u2022 Pets roll up blocks like a snowball and go BOOM to sell them\n\nREBIRTH\n\u2022 Start over stronger and earn Stars for 95 permanent upgrades\n\u2022 Unlock new machines and tougher bosses\n\nPlus 60 trophies, 4 save files and plenty of comfort options.\n\nHow big can your block empire grow?", "short_description": "Blocks are raining onto your floating island, and they're all yours. Move with your arms, pull in blocks of 28 rarities with your hands and hurl them into a stormy sea for cash. Grow huge upgrade trees, battle giant boss blocks for loot, build a factory that earns while you're away, hatch pets that roll up blocks and go BOOM, and rebirth to grow even stronger."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/blockcollectors/home", "developer_terms_of_service_url": null, "publisher_name": "Wafer", "support_website_url": null, "website_url": "https://sites.google.com/view/blockcollectors/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1296472843558640"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654854429_1641773033977781_5902135754532708566_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0fE-pi3WaUQ7kNvwGQUkQS&_nc_oc=AdqzXgQFAcrUxSP1eeIcslRy8clQpNwLkE7q8Sne6boiQULm_55lzqO6MhkteOR62qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOe4tMQ9fepAjhdrmpUGH2EKNiWnmwAMdiiS0TX8kzhA&oe=6AFDDE51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Block Collectors", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sa
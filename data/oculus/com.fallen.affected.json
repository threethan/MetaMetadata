e.png", "id": "645763429487797", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12410355_338007723403851_3468865697080147968_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjg9MUHeZI0Q7kNvwHxUGTv&_nc_oc=Adp6YgTUFgImpUpmJA1psHwFp1G-ETY1_yhVRDHxjvU_nxltcxWwrWvdURVOvfdnxkU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSP9JlHe61WMmbEkpMh7kZxm06Rqw08liECd7Gd_6ApA&oe=6AA93CD4"}, {"file_name": "migrated_image.png", "id": "252500312433807", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12504575_1847360678904338_5628108699248623616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6V3DzIoYSEQ7kNvwG7c_7n&_nc_oc=AdrnKM_zo8bvKxlqdZLTA-l8zGMpMVLI_fDfwwNC9I5cRsIdX0A0zXqLJUzyWPDFU7Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_i92ZuepSD7XvF_en3goiMlbPv6uvb2pPSWNDfapMWw&oe=6AA94B59"}, {"file_name": "migrated_image.png", "id": "698101960930448", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12449084_2239621642937222_2063519107537436672_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iW2N7ifxF8Q7kNvwGacPdK&_nc_oc=AdoVkfYepJPlAlVFAW06p91A1ylm4fz6nDHfDFQoz54CMekKmFSDXz0HBEvlsBG4Fnc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkqMRKhDFdEV056ZUCMVnA2NHvc_Ef9ySGAkFUfWCs1w&oe=6AA9474C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AFFECTED - The Manor", "keywords": ["Horror", "Affected", "Manor", "Scary", "Haunted"], "long_description": "Venture deep into the darkness but beware of what lurks within!\nAFFECTED: The Manor offers a new level of immersion with this terrifying psychological horror walk-through.  \n\nWith over 250 million Youtube hits and countless features worldwide, the most Popular Horror Experience in VR is now available for the Oculus Go and Samsung Gear. \n\nWith alternate endings to keep you on your toes and terror at every turn, it can be as entertaining to watch your friends take on The Manor as it is to tackle it yourself! The Manor offers a VR experience like no other that has be experienced to be believed...but can you make it all the way to the end! \n\nUpdated for 2018 with new visuals tailored for the new wave of headsets!\n\nWARNING: This experience uses Jump Scares! You have been warned!", "short_description": "Venture deep into the darkness but beware what lurks within. \u2018AFFECTED: The Manor\u2019 offers a new level of immersion with this terrifying psychological horror walk-through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fallenplanetstudios.com/privicy-policy/", "developer_terms_of_service_url": "http://www.fallenplanetstudios.com/terms-privacy-policy/", "publisher_name": "Fallen Planet Studios", "support_website_url": null, "website_url": "http://www.fallenplanetstudios.com/affected-mobile/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "557347289715577"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162738_1917265375223677_3790731942106759168_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1Y3ZTZh-iYQ7kNvwHd2H6i&_nc_oc=AdpzXjNIbFNpMXTzuoKJRBkIJ9IK68__sC1TXypIVOq8csEgyeam3GL7FRfbJinX7ZM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKBjPebYDqgxs_bS315D9hj3oCJX2OinVbI56QYnTTOg&oe=6AA93FE4"}, "is_concept": false, "is_test": false, "is_
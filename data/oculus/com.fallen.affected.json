ls tailored for the new wave of headsets!\n\nWARNING: This experience uses Jump Scares! You have been warned!", "short_description": "Venture deep into the darkness but beware what lurks within. \u2018AFFECTED: The Manor\u2019 offers a new level of immersion with this terrifying psychological horror walk-through."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fallenplanetstudios.com/privicy-policy/", "developer_terms_of_service_url": "http://www.fallenplanetstudios.com/terms-privacy-policy/", "publisher_name": "Fallen Planet Studios", "support_website_url": null, "website_url": "http://www.fallenplanetstudios.com/affected-mobile/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "557347289715577"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162738_1917265375223677_3790731942106759168_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdXa_A_0bGMQ7kNvwHxE8OG&_nc_oc=AdlzPu3bjx04_7waKXa0FRq6JRhoPm-evIWsJ31zF4G7EorUaP9UCcq0AW8h5e_t3xA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv7E9snFitR0kF7kfvXUC-vyJy-RRWVhR1qMIf9mAtXzw&oe=6999AAE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AFFECTED - The Manor", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1465369200, "lastRevision
: null, "video_trailer_thumbnail": null, "display_name": "Eleven Eleven", "keywords": ["Eleven", "Narrative", "SYFY", "Cinematic", "Storytelling"], "long_description": "Their fates have been decided, but how you watch is up to you... \n\nEleven Eleven is a ground-breaking entertainment experience that places you in the center of the story.\n\nFollow six main characters as they count down the final 11 minutes and 11 seconds before all life is extinguished on the island planet of Kairos Linea. Their only guarantee for survival is a transport ship that will launch just before the clock hits zero, taking whoever can get aboard to safety on a floating ark in the sky.", "short_description": "Their fates have been decided, but how you watch is up to you... \n\nEleven Eleven is a ground-breaking entertainment experience that places you in the center of the story.\n\nFollow six main characters as they count down the final 11 minutes and 11 seconds before all life is extinguished on the island planet of Kairos Linea. Their only guarantee for survival is a transport ship that will launch just before the clock hits zero, taking whoever can get aboard to safety on a floating ark in the sky."}]}, "developer_name": "Iconic Engine", "developer_privacy_policy_url": "https://www.nbcuniversal.com/privacy", "developer_terms_of_service_url": "https://www.nbc.com/general/pages/terms", "publisher_name": "Universal Studios Interactive Entertainment", "support_website_url": null, "website_url": "https://elevenelevenvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported
 is extinguished on the island planet of Kairos Linea. Their only guarantee for survival is a transport ship that will launch just before the clock hits zero, taking whoever can get aboard to safety on a floating ark in the sky."}]}, "developer_name": "Iconic Engine", "developer_privacy_policy_url": "https://www.nbcuniversal.com/privacy", "developer_terms_of_service_url": "https://www.nbc.com/general/pages/terms", "publisher_name": "Universal Studios Interactive Entertainment", "support_website_url": null, "website_url": "https://elevenelevenvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275205579623969"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "921001318234124"}, {"status": "PUBLISHED", "id": "838583643175319"}, {"status": "PUBLISHED", "id": "1742089999257699"}]}, "baseline_offer": {"id": "921001318234124"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1558565700, "status": "PUBLISHED", "id": "921001318234124"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2089208427854186", "version": "1"}, "id": "1596207907180953", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2057813437660352"
t-atl3-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtyVMSkmIUgQ7kNvwF6O1ZB&_nc_oc=Adncb929hap2X_S_Emqf3jIRrK-RpESDVy2FYYUfhnBsvOoAUPh2tIdE8jLFZGY1e7Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu_mTf2YKMFti1fdPcL7AukWtIltLd8NN-MCNu090tDWA&oe=69A58965"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jahL4BOmEAQ7kNvwFzLcuc&_nc_oc=Adl6T_g09BOJeqSCDHd_tYLsDfJ11P4OtyNN5vHlvndtHlRVqGxlljs57elvtxICiLc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afv-sMZWMiGrEWvE81GMgWYhdRo5lhD5kh9qfoW2fC3lGA&oe=69A56F45"}, {"file_name": "Captain ToonHead Screenshot.png", "id": "426672885500768", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982658_426672888834101_6085981131912280130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwKxeUfJvpwQ7kNvwHpqUzk&_nc_oc=AdkflVLCpAMidFLmP_kvUNGmHn8__v-XlO6ygCAmPmQhjd7y-8JX6-Lj2HPc_lnx34s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsq3exy4-xEsMBHK7P4p-V5VGwkbsr2RBESsyiEeL0eMQ&oe=69A581A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Oculus-Thumbnail.png", "id": "760441625080166", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974883_760441628413499_3472724892994893008_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzGVM3kYM7oQ7kNvwF-i9rW&_nc_oc=AdmfkrXsxvhFaS-6V4DzczuiHQFL2Ev4J0IApjm3NqKr3-0f9m719ZhijWhb_K-Rv5A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvsDD00q2RfyuZLfY_F_jUp7VPOer_yIuujOZqHVkG9XQ&oe=69A572F3"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts", "narrative", "cartoon", "humor"], "long_description": "\"\u2018Captain Toonhead Might Be The Most Over-The-Top VR Game Ever\"\n- VRScout\n\n\"One of the best tower defense games I have played in VR.\"\n- VRGameFaqs\n\n*An ACTION TOWER DEFENSE*\nYou'll move all over the map, hammering away to upgrade towers, throwing over-powered chanclas recklessly and taking control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\n*The hero we got stuck with*\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed space janitor and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! \n\n*Balance action and strategy*\nShooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the ACTION TOWER DEFENSE of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
lFjVSZKWx9M7rZzhc56sgAUpEPajSfZu-lnEj2eR-t88QX3T0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2-k7Oe4RC9pryFPgycs4S62U-HSiWxycyAQaoUgGP1cA&oe=69F0AEE5"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k05ay74WhoEQ7kNvwGEYarM&_nc_oc=AdoePilK3MwjJTcYoetqWBZUdb3CwcqxR_GC-7gwDJvKHiTFgwpJwlHv5o0CwDKgsZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08AJo_XMpHluxpRC0dl3kliY-ZfPsYsZEhGxz27IDM1Q&oe=69F0CE1D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XPnJZMAyjsQ7kNvwG-2alO&_nc_oc=AdrERV3lMkulyq2A3TyC8fcdrPLtfhe8BFxWEzVPDnwujeBeMerrPvTQyaAEy_wJETg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2knF2VVTb2WhRpc6HIf_mYGYVVyIFpJdavoSBOJfS5pQ&oe=69F0CD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ30i7TgdeMQ7kNvwEyHJXN&_nc_oc=AdqhsoBv-ATnPfmRM-3B8nYtHYteSb7FXSkKv7yBzG2monHwgfJwdGT5P44HeNLGHWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1vnaExnzg70V2NjFrEYYmvEVjhu1nAbgwogeUepzPwTw&oe=69F0B5CA"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "454522316314008"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "
11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81Bg_YbqSSOJVdJ5aGR_CGYhhLxTMmWdnPxQKVk_TmPQ&oe=6A22DE06"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es_xJQdcLCwQ7kNvwEx-f_T&_nc_oc=AdpF0fHEJCZFpZcranqbVhI_E4mggPwVtURx3ef2dJVnJe7TN-PMAyaG5s5BVRwIPhM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jVUMNXQ4HVFd-JAvxe6-HG2lLf2iAa2TWMJMtx5A1HQ&oe=6A230025"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-6honQvujMQ7kNvwE8DTEJ&_nc_oc=AdoZmOsFFVwLPUj74fXa1CQ_pioLidWaev7tlb8YKOX43GeQ6-2y9u4PTSfOpUi_KHg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pC5-QFdG5r-xckh8YKf88qvuo7bRXC6ZEOoHLZTVLtA&oe=6A22E71D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5KAx8lAy6cQ7kNvwHTz33g&_nc_oc=AdogtxXddEbeoTmKJLa8egARB2BrHJmY6TPQHBauhd_9PZjYLVidwBm6zkdU-cPl4bE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TnCfvrqMAHOWgf0S4Q28P9rQ8DTUqi8sbI-GOCaIv0g&oe=6A22E605"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUv1hlTrTm0Q7kNvwH-S4zw&_nc_oc=AdrDSEQLbrCDY5fiJA-Ytt0pQfM2AALp2ZyXApygpAqwK1rskJlhGsTQt-pIO3Nywbg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KvH9nNoLzx2N8WNwTO-2KLGQ86Z75V0rbDYkXeBCd2Q&oe=6A22CECA"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", 
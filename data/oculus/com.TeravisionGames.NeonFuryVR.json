luscdn.com&_nc_ss=7f20f&oh=00_AQHyjVwQ8VFSMlBT9UW_p2wpPbxqO9nIF90MMFraWCbfmQ&oe=6A92B546"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLsRmohakgUQ7kNvwEP3Yk1&_nc_oc=AdqBBWarswi1rlST5CftMR_BFuPMrMH_9SyRNQ_HLepApwbuzVbMJTATyUEJlYjN5j8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9uZTSyzBH0qC-yxGFX5QP18mcGkwmA-dniMNySLULTg&oe=6A92D765"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvN05-IRyOsQ7kNvwG4OY1k&_nc_oc=Adrx5BORjEX9Pu5m_tVYNYbIZocISKpicpDInt37saoCWS7mYFaq7wuyqoF6qCqKcbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAPbQxmlO6QJ3e_bBzpq47Z1wzBpIFHnCQLkaCf6WmkQ&oe=6A92BE5D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU4lwxFMx-oQ7kNvwHuKr96&_nc_oc=AdqMsOY_Lx98DrVgU99W4Z_n53l2bdIPTyigEzXYAJiIfT_ctu2zLZ97I56FL0ofZVc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBKTvGZAjjIpR2inUQAPz_-t2naL960SuT3tKPlqr0qw&oe=6A92BD45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02VCOYJ4z_sQ7kNvwF7rnnC&_nc_oc=AdriU_MJ9Its4A1iqxfNDFk89tQF2Lk6BGvLK6BHmMpJRdnC-BZLLFRUdG0uuPf18iU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3hbzG_7GdUZt1Lam9AVRHN_A9pWKZZPbrY3-tdbFgxg&oe=6A92DE4A"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommend
11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UBmeQHltVFuiMfSzvxIjAqthPW8LCku42lRBRsIV54A&oe=6A11BA86"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLeGec6NpIgQ7kNvwGuo619&_nc_oc=Ado974T3tatDDd8MhHGb4VQibFsyCq2Hz-I3BuO0i78w0KY49GqySEejBRG6md5W0uA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zjKTlVa1TYIS_-hO8hIgwDmEb2vWHGUE3RH3z3iCrZA&oe=6A11A465"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZfo3-eAg-4Q7kNvwH0j0pP&_nc_oc=AdocZb5TeN1lxFnQ5Xdo38p3D_f1q8FT79xmGzQHTKGk5p6Mi_OT6qL92b6QacR8G1Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TE9qLw1CuPIs7qm9Nz8VidcAEiK9YXuY9gNFQUbutkA&oe=6A11C39D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhjIYxmr22oQ7kNvwHiQUbq&_nc_oc=AdoV2ynJ-q1A6--0sA6MDpelHNq4O_y7vRk5WhQRO457uN5AgNJUEoWiTBbn4dTyxIE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4569fJC4lQ_gH3CIjZ2nDlAav1v5Z6o2tvHSXudP9ujQ&oe=6A11C285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7fRk816pagQ7kNvwHY9DpA&_nc_oc=Adr6XYPrFyTfsP-MZY76vXDwHCojcxjP1RLIwNut5ErBKG76ywBEoop9cYs_UE34T3Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l4G4f-9FtaJB4Yh1ImSr6r8d7m4Ue0QR-ka4EubcgJA&oe=6A11AB4A"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", 
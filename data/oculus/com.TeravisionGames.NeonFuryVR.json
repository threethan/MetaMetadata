luscdn.com&_nc_ss=7f20f&oh=00_Af6FfQ30dMrbZGOnVTUcdF0kRjWGqCPcASy-Rt4uO5bPiQ&oe=6A15AF06"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMzVxtt0G-MQ7kNvwGmdZsA&_nc_oc=AdqzRjlzaRx6uGEf5eheMZUe20ZXLuyZHos6t_EvGVHpyaqInsPE0G3_xvyBdQyVYV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af419Tu050cmF5cV41Pj-9c3WX2QYFBRe50it7lD9GD_fw&oe=6A1598E5"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Orak2sYVv8Q7kNvwHXRVVn&_nc_oc=Adpw5loDnOHEHCMk1VhEu-SLNO3KmoSL7KItRXyj_WQ5ifrqp0BuXSRQQNdevFnOv5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fhv9T_6OJ8Tfxhlu9ECSNGT-VrU7McKHDGmKz_uadyw&oe=6A15B81D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mweN-i5M6ZoQ7kNvwGwqt0f&_nc_oc=AdquHZd7qhuYjKPVjxl3nXEKyLgJCUYFkYn9Iq4Z0QsuQq_t1Q6btVmOD5fZvGH1DpI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jJSzCy-K_jujM-GtWPnfwq3MZnU9J5Pv_3h5NkfOK8w&oe=6A15B705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Hw66XDMAG8Q7kNvwGNIzPY&_nc_oc=AdpioUVyv_ho3APF3lVmUdNZHIPNabxKLo-EXssM2y8JiJ84JGJ2FjHnUU7O1hS0oLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M8CalT1RvLOZfmSgCLw7--59bb7Q3KIAVXEvJMXGKrw&oe=6A159FCA"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommend
luscdn.com&_nc_ss=7f20f&oh=00_Af-oLYmcztuanuANleNig-Ncwpoe8fOqInvFPGUNFAYEow&oe=6A3D3C06"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFBB3hzA-0IQ7kNvwHAmc_4&_nc_oc=Adpgib_Ak3v83BkgJFSmrGiPSLLcTpEmi27fMCgAJq4scqQdh3z9VhkQtzQ1ooYd1tM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ltd_Q3fM0h3QoOrVfeZqKGwZiHp31Mo_WexWEeAP9DQ&oe=6A3D5E25"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIQj4nPLS9cQ7kNvwFmlYwU&_nc_oc=Ado7Mh3Jq4Te25gZXxouQDi5oms7j2cXQd5KL73tmu60J06K3vsxQLQwQW-CxhcbB1E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TbNbYOI6pe91wNm6bBMvu6m_UqbNw40yvoSmSdRn7fw&oe=6A3D451D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCSKuFaK6_IQ7kNvwFqfIo4&_nc_oc=Ado3nMRY3jws1_4iQDF7AgTJgvCgl0OCgAfrNtCqKhV2S4bmEK7V1tYimSS1cWQ0MaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BVrxl2_9R7Ptdf_k8pYpSJtO0BU16iJu2blqz4YzpJQ&oe=6A3D4405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y_IW_DPQmYQ7kNvwFB-hyu&_nc_oc=Adr8fNdDsBoQp5cMVIpPClJtLXLgRaR-pQotqXvfVIj_cRzETkzep1GYo-fNUmwPqf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92EnXZXIRnWMqh2P6l_Pv0xhGrnntoepB5U5IaYrAuMw&oe=6A3D2CCA"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommend
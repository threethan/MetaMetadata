cdn.com&_nc_ss=7f20f&oh=00_Af3BS7OWAnXmMI4_OEWOlJDXTiQBFeoFqU707Ah8Cwg_DA&oe=69EF7386"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JD2fRuoZRcQ7kNvwEqkVbv&_nc_oc=AdpNQ7DzRxr3B5zCInGJ903JFDM75viZtgxe4OKSCbAwY2cCP1w6PY3-cm-GGe3eoHA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1et10FnpueosuVyk-0Iz5LyBbgKWowaojrg0RAe5CHjQ&oe=69EF5D65"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XPnJZMAyjsQ7kNvwH9l4Lf&_nc_oc=AdqrBuJ-4WT9awDx_iXtQshVwn_nwYrEM_Z2xtFRdWadxwXIWU4D4TfBVTCmiIdQL4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_nGzXcTLRQUcXuqG8-9_s3bdrIlQ8fByDc_liIsMe3g&oe=69EF7B85"}, {"file_name": "Captain ToonHead Screenshot.png", "id": "426672885500768", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982658_426672888834101_6085981131912280130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTZeJ6Rs-_sQ7kNvwFw4ocQ&_nc_oc=Adqthf7ByhMv8eul1F_h01A6FBIqmt_xCPS8PVbnpGsSGk6Nk79H2zdm9g2cr1n_igs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yF2tH2FZC13olMQWhv1PpAspIdYOaRAktaZf_-KNvqQ&oe=69EF55A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Oculus-Thumbnail.png", "id": "760441625080166", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974883_760441628413499_3472724892994893008_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXNsn6xhR_IQ7kNvwHpYOpX&_nc_oc=AdoXO6TIVGABwScj3DRpOG_bVXOmpwyCRy_BywchIUUMkhTkvKnKCXZ3ejNkMYkotoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2C7ezyeFQMaMXSrwgXrEklu6kO-lR99XMI-8WOqAcUvA&oe=69EF7F33"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts", "narrative", "cartoon", "humor"], "long_description": "\"\u2018Captain Toonhead Might Be The Most Over-The-Top VR Game Ever\"\n- VRScout\n\n\"One of the best tower defense games I have played in VR.\"\n- VRGameFaqs\n\n*An ACTION TOWER DEFENSE*\nYou'll move all over the map, hammering away to upgrade towers, throwing over-powered chanclas recklessly and taking control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\n*The hero we got stuck with*\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed space janitor and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! \n\n*Balance action and strategy*\nShooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the ACTION TOWER DEFENSE of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connec
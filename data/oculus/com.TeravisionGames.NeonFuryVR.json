luscdn.com&_nc_ss=7a30f&oh=00_Af2h1c_3hQvFieECS-SOa7paLCIG5uM6hr055IE1Z3hKtw&oe=69D27286"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q93xYkr46cMQ7kNvwE8LDjE&_nc_oc=AdpY22ohoBTAoEUyZ1KbB3bls1IaxDA1Vo344AVzCW7U7tB2tb51WfgRdN2OnzewSo8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QzwNNeAtm9NBGaV_uUbFwlaEZOfndUgeHTLtSOEh7yw&oe=69D25C65"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYseDQMz58cQ7kNvwE8JF4p&_nc_oc=AdrXPHHo8aE_CxalWZ-SzFFpj4yMtbUwB8GJpr4we7WuQ18_QxktBQKONEtyWQ4mPfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MxVT2zd4X6Ynq5Wuqcaaj6T7N2l1Wyr0fQdVlQywExQ&oe=69D27B9D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c-_UiJRLwwQ7kNvwHgWOfd&_nc_oc=AdpDT6C32Sq8VNvT1a1OM4Rlc8a0sxs3A1KXnTTOXpCpl8Kvx_B9sFeXf8h9yzsjQWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bWd9VukBOIMqL4fBXzVBMjbLM4oJwgUJhG7azt0Cajw&oe=69D27A85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_1CfiGKIsYQ7kNvwHrjdVa&_nc_oc=Adraaitf2_weCFedhAx0lSpO8QLCERmT-JJnj5LmQweyGAAoNoG5qH5EJIiH3xl_zvs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00tscir8SZTc-cukCiuD8VoJ68ALiF3qo4ZsEBdSdEzQ&oe=69D2634A"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommend
cdn.com&_nc_ss=7f20f&oh=00_AQCV0YAks6_M7T50cnBNXwpnSc4s3z1pSd03zIwG95nR5w&oe=6A6E0386"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2REXXxpf5SMQ7kNvwGDnACq&_nc_oc=AdoWGfU2WPDrSiYz0tu0UlrbHW7sg3vU2Ua1O2IcfgeYgxs6JPHR1c71hM3yFvrw5bc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaKz_W1Z3y08_EeRcMWg5iXUg2Ubo-vwwVxy23qDm2Cg&oe=6A6DED65"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_9jpNKAAFwQ7kNvwE3evJU&_nc_oc=Adra8o9eLxP5B-jyUQN1vaBfGM7gMDSG0QQHZ5avvJwnRhOG2nvTu6P1UG6_Xm7VSHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUMuBZzsD9-X6vjrUscE8U3-cLpK7-J98Df5cQ4xfzwA&oe=6A6DD345"}, {"file_name": "Captain ToonHead Screenshot.png", "id": "426672885500768", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982658_426672888834101_6085981131912280130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWSWJhXP3VEQ7kNvwFIW2oZ&_nc_oc=AdqbBACSikeoXScRbnC0nOG2uAKRAlB1ZQ7WfX2hFTu9X8r0OjPVZ69GeNqQBvm6g50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9orzA3JQ56fFK9eDexz64WVAEv7JvIVwhtWGYqf8Rww&oe=6A6DE5A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Oculus-Thumbnail.png", "id": "760441625080166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_760441628413499_3472724892994893008_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XjlIrMIDIsQ7kNvwEplV0N&_nc_oc=AdpjT4zN87nIvAJKFtxBIMkpVSLdKDaeU0EYCMB5YjDqeKkQcuINVNrYg0W597RjHGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQnQw0vnSR_LdABNR50s9K28ZiP_Xdbill2p7mLJDbqw&oe=6A6DD6F3"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts", "narrative", "cartoon", "humor"], "long_description": "\"\u2018Captain Toonhead Might Be The Most Over-The-Top VR Game Ever\"\n- VRScout\n\n\"One of the best tower defense games I have played in VR.\"\n- VRGameFaqs\n\n*An ACTION TOWER DEFENSE*\nYou'll move all over the map, hammering away to upgrade towers, throwing over-powered chanclas recklessly and taking control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\n*The hero we got stuck with*\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed space janitor and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! \n\n*Balance action and strategy*\nShooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the ACTION TOWER DEFENSE of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ADVENTURE"], "has_in_app_ads": null, "internet_connec
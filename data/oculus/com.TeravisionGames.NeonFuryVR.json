luscdn.com&_nc_ss=7a30f&oh=00_AfyeM6NzOAfVYTQVkuBUMR0uI6IiUjClml0uazdUvHtQ3A&oe=69C69506"}, {"file_name": "Untitled-4.png", "id": "540251453759930", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974568_540251457093263_596185216737678114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKUnfS3AyJsQ7kNvwFxb6xs&_nc_oc=AdrMEQG8cJd6NxIKj0pd9eCLoxHWWIi8AU_wLpFfxZk7NCAmzWufT2A_-FE87OKWB2I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxoN43Bt0M8lwgL4deRgAwujioVgKzl8D6wen46bsyMw&oe=69C67EE5"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-mm5kd_YUYQ7kNvwGo6HVb&_nc_oc=Adq0KbC8haBgCXpPBe-gWE9UaTGEzZf0GeGko6iQkXK2nQgmd3FZLzHWx97AlxlVrIQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkIfZOmjahzAg2Dzx9q5zHVcZlzdrZRa6To42f-fx98g&oe=69C665DD"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2mTnRXoKP8Q7kNvwEcncDh&_nc_oc=AdoN-874tSJZyQyNhvJEVAJ89sv6hAGu_jnCjyH0t5Efjemi76V75KrvvpvkltorzPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx72BGTZda5I0AhVYdvRvbqxbD1hnoi-cbAERkpbvojLQ&oe=69C664C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBpoU66exMgQ7kNvwE-6542&_nc_oc=AdpOWcTciEQmsXV3Srrf1-u-0wk2vzZLjZjGdA5Kz6TsagZHTtL0gAz6O0PWnWPCVAY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_2lD9HF_UN3kw_1O4fmRf_FMl_FQsvD2fZw1GmmbQuQ&oe=69C685CA"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommend
GwLmzznQ-rtfQbNynjV4yp3FjbZL1lNeVOTstxtI_GybUnKSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbUZBbpC0WJcq1i0YeDUIIiHKP4mX6juu3DKya-EpPCg&oe=699AFD65"}, {"file_name": "Untitled-4.png", "id": "345017844023739", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974589_345017847357072_5205306834273048416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1xW3GuUqlYQ7kNvwGPF2SD&_nc_oc=Adm4bmCFhnTNAv7C79lhd7ss0KwejGWsV-CaCYtLz1M6taH4sq9ZKtr0Eu1ZZ4KnTOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsFjXtaxcmjbVoid2md3_ZytQudREi4iMjyB_pOLW3faw&oe=699AE45D"}, {"file_name": "CTH-Screenshot-10.png", "id": "210466391035364", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031450_210466394368697_3171406121056240819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbuXvgoVhZsQ7kNvwFCcTec&_nc_oc=Admok1tX01wfgbZ1cexhffkkrciovv5oJ_LOp_1j9OdRnTxasm448oXEMZND2i6VCKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftymQM2CdDiJvjY02cPHvLJiDxG9t4O_4MChTXDhE338Q&oe=699AE345"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCTH.png", "id": "363675381967905", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_363675385301238_5052437303050576733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zA1H_OvrbaAQ7kNvwE4JwzG&_nc_oc=Adlae0eGlWEIumiG-magI5xZkEOojXq_sL8X8FqIllzEKko2y9hZTGHvia6bTkcMlm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuZkYNI6nwEcHHT-rz4xPe54dPzVI4m4sh-M-zootN8Xg&oe=699B044A"}, "display_name": "Captain ToonHead vs The Punks from Outer Space", "keywords": ["towerdefense", "rts"], "long_description": "A true first-person tower defense, designed for VR. \nThis is not your diorama-style VR tower defense. In Captain ToonHead you'll move all over the map, hammering away to upgrade your towers, while throwing over-powered chanclas recklessly. You'll take manual control of your towers to unleash streams of heavy-metal powered hot sauce and shoot electric beams from weaponized pizza at your enemies. \n\nAfter the squad sent by the World Treaty for Freedom (WTF) got fried in the \"burrito incident\", it falls to Elliott Salazar, the cartoon-obsessed facility technician and only survivor, to save Earth. There\u2019s a new captain onboard: Captain ToonHead! The hero we got stuck with.\n\nBalance action and strategy:\nYou're going to do a lot of shooting, but shooting alone will not defeat the waves of Cyber-C.H.I.C.K.E.N.s and Terra-S.H.A.R.K.s. Combine those PIG\u00f1ata tower bombs with your chancla throws in a very strategic way if you want to save the EnerCubes and defeat Nicholas Voorhees' P.U.N.K. army!", "short_description": "Ever wanted to beat a T-Rex up with a chancla, while building powerful towers that shoot pi\u00f1atas, hot sauce and heat-seeking fireworks? Captain ToonHead is the VR tower defense game of your cartooniest dreams."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "http://captaintoonhead.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "454522316314008"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "
null, "video_trailer_thumbnail": null, "display_name": "Practice Public Speaking", "keywords": ["speech", "presentation", "audience", "speaking", "conference"], "long_description": "Practice Public Speaking allows you to practice your presentations and speeches in front of a virtual audience.  You can also add friendly text prompts to help you.  Practice Public Speaking takes advantage of an intuitive way to arrange text and images provided by the free Notice Board app, available separately.  Simply load your files saved in the Notice Board app to use screenshots of your presentations along with any text prompts you want to use.  Remember: practice makes perfect!", "short_description": "Practice Public Speaking allows you to practice your presentations and speeches in front of a virtual audience.  You can also add friendly text prompts to help you.  Practice Public Speaking takes advantage of an intuitive way to arrange text and images provided by the free Notice Board app, available separately.  Simply load your files saved in the Notice Board app to use screenshots of your presentations along with any text prompts you want to use.  Remember: practice makes perfect!"}]}, "developer_name": "Thomas Laurie", "developer_privacy_policy_url": "https://vrnoticeboard.com/privacy.html", "developer_terms_of_service_url": "https://vrnoticeboard.com/terms.html", "publisher_name": "VR Notice Board", "support_website_url": null, "website_url": "https://vrnoticeboard.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes
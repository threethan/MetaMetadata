pXg&oe=69DA2B93"}, {"file_name": "COGNYVA_ARTS-05.png", "id": "1478539600043747", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1478539603377080_1392540761574090900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbbSE9OLdbkQ7kNvwHSNSqI&_nc_oc=AdrnY9yF4_3tBgVc0NJikUFPYJck2xX2dmo1xd4zvWy08ngv-LwYlKHZ4xEvq35-1Dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aYmPVb6TCfkE4uXrmTD_XKpVB8XU49hcNQI-HRZ00AA&oe=69DA47F9"}, {"file_name": "COGNYVA_ARTS-06.png", "id": "1341472763579834", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619680_1341472766913167_3102251139415969929_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR9fQ17E71IQ7kNvwFWSNw1&_nc_oc=AdrcFdQH7m-mo_Pr4ggvVE2PlaeWKPYC2vsPIJxnstZidU6Dp6s1xU-FHUoEBcqUwik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3deAIEtK4JlfEF_M0NcXnoP2GGE4Jeb2aO2tzGN4VJag&oe=69DA3EF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cognyva VR", "keywords": [], "long_description": "Cognyva is an immersive relaxation app developed by Quantum Med Tech, created to help users disconnect, recharge, and enjoy moments of peace. Through atmospheric visuals, calming audio, and color-driven experiences, Cognyva offers a comfortable digital space for mindfulness and personal reflection.\n\nIt includes three main activities:\n\n\u2022 Immersive Environments\n\nExplore beautiful 3D worlds with soothing landscapes, gentle music, and natural ambient sounds designed to help you relax, meditate, or regain mental clarity.\n\n\u2022 Video Library\n\nWatch curated videos focused on calmness, mindfulness, and emotional comfort. Sessions are crafted to support relaxation and offer uplifting or motivational guidance for moments of stress or low mood.\n\n\u2022 Color Experiences\n\nEnjoy visual journeys inspired by color psychology. Select or let Cognyva suggest color-based videos that match your current mood, offering harmony, balance, or an energizing 
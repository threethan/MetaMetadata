090900_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJStkzh_1_EQ7kNvwHrbmWv&_nc_oc=AdpWOiNUmiXGVST1Em5u_pEQf49GuFV3sBEzrXP3DNGhDtdqtHYoRs90qAtdbe-XHMM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0YpO0RbVRo5hISrEABZ99ykvKrYjTNj8WqmCg6q-m3dw&oe=69F202F9"}, {"file_name": "COGNYVA_ARTS-06.png", "id": "1341472763579834", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_1341472766913167_3102251139415969929_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDHDovLnb7cQ7kNvwG23vrW&_nc_oc=Adov3g4DO2v5LhUcOTce2ZA1Tpdsg5C4r2PRcQgnys2HuDA9xuhtuhgKM-caxWfzjoo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af036dJhXpqQn2GsPn-gW67mL1oodHHUmnjlhC4b3GC3xw&oe=69F1F9F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cognyva VR", "keywords": [], "long_description": "Cognyva is an immersive relaxation app developed by Quantum Med Tech, created to help users disconnect, recharge, and enjoy moments of peace. Through atmospheric visuals, calming audio, and color-driven experiences, Cognyva offers a comfortable digital space for mindfulness and personal reflection.\n\nIt includes three main activities:\n\n\u2022 Immersive Environments\n\nExplore beautiful 3D worlds with soothing landscapes, gentle music, and natural ambient sounds designed to help you relax, meditate, or regain mental clarity.\n\n\u2022 Video Library\n\nWatch curated videos focused on calmness, mindfulness, and emotional comfort. Sessions are crafted to support relaxation and offer uplifting or motivational guidance for moments of stress or low mood.\n\n\u2022 Color Experiences\n\nEnjoy visual journeys inspired by color psychology. Select or let Cognyva suggest color-based videos that match your current mood, offering harmony, balance, or an energizing boost.", "short_description": "Cognyva helps you unwind and elevate your sense of calm through immersive 3D environments, relaxing videos, and color-inspired visual experiences. Enjoy peaceful landscapes, ambient sounds, and mood-based sessions designed to promote relaxation, clarity, and focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raiseyourvoltage.us/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Quantum Med Tech", "support_website_url": null, "website_url": "https://raiseyourvoltage.us/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25737064469231809"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "778083391923566"}]}, "baseline_offer": {"id": "778083391923566"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764085860, "status": "PUBLISHED", "id": "778083391923566"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27169020696036172", "version": "0.18.2"}, "id": "870944825607927", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25611023801835877", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27169020696036172"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "870944825607927"}
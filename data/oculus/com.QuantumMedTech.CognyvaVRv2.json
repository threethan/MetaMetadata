5/499304115_1199487452353855_7980720119825195946_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcAUuaPcsw4Q7kNvwGj6a9k&_nc_oc=AdpZb-OaqrvKx46U_H6lMYSpAOeygOYhUXKwIsqJwI7kFieCMb3v8K1wSN1SL8BOSt8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs9Ozxe9neBoxSqab3GYUsJp3LrP6VohIJ5tImNcpDsw&oe=6ACBAE9E"}, {"file_name": "Cognyva_app_thumbnails-07.png", "id": "1260717369260731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1260717372594064_1796590179523730940_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1qeROnOEhUQ7kNvwHMLG0M&_nc_oc=AdoiSE76iBjdHvNhFFmFJKfj9vJQ4XmaK5K0wdMUUeAVOixf3C0no4sSHVMBwVOFxT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7hrLCRO0fIczpsavVvpZlsAJFALd0WsU5amHuzjtg-Q&oe=6ACBA76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cognyva", "keywords": ["color", "therapy", "wellness", "chromotherapy", "cognyva"], "long_description": "Cognyva is an immersive relaxation app developed by Quantum Med Tech, created to help users disconnect, recharge, and enjoy moments of peace. Through atmospheric visuals, calming audio, and color-driven experiences.", "short_description": "Cognyva includes a dedicated VR experience designed specifically for the therapy sessions. You'll explore guided scenarios, therapeutic environments, and color-based wellness experiences built to support relaxation, focus, and cognitive balance \u2014 all seamlessly integrated into the system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raiseyourvoltage.us/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Quantum Med Tech", "support_website_url": null, "website_url": "https://raiseyourvoltage.us/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscr
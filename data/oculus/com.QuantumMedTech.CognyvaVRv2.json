6hw1&_nc_oc=Adn8pnh1tyfSpTUyOv8dq290hEStpPKh0jWt-kbki9ixs3cXhmVjCVRyBie0ILwh5WI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuCNRcslADVwSAyzV8I18_ysQvOGKXRDH_MQvixj82c-Q&oe=69A4265E"}, {"file_name": "Cognyva_app_thumbnails-07.png", "id": "1260717369260731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_1260717372594064_1796590179523730940_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1hqutBovhoQ7kNvwFQemAX&_nc_oc=AdljE78gE4j-M2_U8p9vQFA2eMrK60-oLP6Ik7SWc1wiiMZT_png0L3vUneZCBqCzLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfskyAVvVeRZqf_FTNk_yN1VEcYz2DloiqA5H6p5l1kfOA&oe=69A41F2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cognyva", "keywords": ["color", "therapy", "wellness", "chromotherapy", "cognyva"], "long_description": "Cognyva is an immersive relaxation app developed by Quantum Med Tech, created to help users disconnect, recharge, and enjoy moments of peace. Through atmospheric visuals, calming audio, and color-driven experiences.", "short_description": "Cognyva includes a dedicated VR experience designed specifically for the therapy sessions. You'll explore guided scenarios, therapeutic environments, and color-based wellness experiences built to support relaxation, focus, and cognitive balance \u2014 all seamlessly integrated into the system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raiseyourvoltage.us/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Quantum Med Tech", "support_website_url": null, "website_url": "https://raiseyourvoltage.us/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended
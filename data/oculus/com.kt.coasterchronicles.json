1455763140113_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lOd0nF_o_sQ7kNvwGi_Uvn&_nc_oc=AdpwM7q0EyThHHE-_Ae3Z_SNt62PEraAmJPkcTHTnixFJCOqHy2qiYZRahSvlQpNwlE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJrxdUQWoeae-tqq5f22iRJof1-SRBRpPyIAOR8NS5tw&oe=6AFB418C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "905008498057070", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031634_905008504723736_4944181879361208187_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li7jeVtezuoQ7kNvwGhSxIl&_nc_oc=Adqok4GOg2ioBDGqoqHPc2gwJrBVWGgwGyMUacaxGC928IuBEYWq80XbbCCJIoKbbCs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsEh4XuVRwFVGbpnw8Kq6TO9tMORGZo-NSDC4dPk-PNw&oe=6AFB278D"}, "display_name": "Coaster Chronicles", "keywords": [], "long_description": "Overview\n\nStep into the thrilling world of \"Coaster Chronicles,\" an exhilarating VR game that takes you on a breathtaking journey through a series of mysterious and awe-inspiring roller coasters. Designed to push the boundaries of your imagination and test your courage, \"Coaster Chronicles\" delivers an unmatched virtual reality experience where each ride is an adventure filled with twists, turns, and enigmatic surprises.\nGameplay\n\nIn \"Coaster Chronicles,\" players don a VR headset and are transported to a fantastical amusement park featuring an array of intricately designed roller coasters. Each coaster offers a unique theme and set of challenges, combining high-speed thrills with puzzle-solving elements. As you navigate the tracks, you'll encounter mysterious symbols and hidden clues that unlock the secrets of each ride.", "short_description": "Overview\n\nStep into the thrilling world of \"Coaster Chronicles,\" an exhilarating VR game that takes you on a breathtaking journey through a series of mysterious and awe-inspiring roller coasters. Designed to push the boundaries of your imagination and test your courage, \"Coaster Chronicles\" delivers an unmatched virtual reality experience where each ride is an adventure filled with twists, turns, and enigmatic surprises."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/coaster-chronicles/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KT Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/coaster-chronicles", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7588439547949311"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7591886700937929", "version": "1.0"}, "id": "843124740558062", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7588439541282645", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7591886700937929"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "843124740558062"}]}, "change_log": null, "created_date": 1720170332, "id": 
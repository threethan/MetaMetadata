_nc_sid=6e7a0a&_nc_ohc=TzdX1cv2MbYQ7kNvwEt64tb&_nc_oc=Ado61FvKVQkY-6N__YdMsxbSvMk-YrejSqiebLEynNSbdwYOEeeLpv2K4p1DYiNWNmU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgG0o0ati0g53SnrdP-uRMZX_9uU_-YN8g1oPUzByAYg&oe=6B0B3AFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440kongchangjing.png", "id": "390658766103031", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_390658769436364_2302287055393307583_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uixvpS23nqoQ7kNvwEjOaj3&_nc_oc=AdpbUyoXoACID0OpeE5jC86esgmOUdGyz_7pv89z0pgG5bCZXZaRr2Zj0qGirAursb8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSjTCWSO_swdgp6F1HILL6zHtabyvuCMIhbLS10LnHqA&oe=6B0B4554"}, "display_name": "Burning Shoes VR", "keywords": [], "long_description": "1.  Burning Shoes VR is an dance VR app on Oculus Quest. We can see clearly virtual characters dance by your side.  We enjoy life, we love music,so we love dance!\n2.  Song list is here:\nhttps://www.cqplanb.com/ccc/burningshoes-songlist.html\n3. We use microphone to react with rhythm, So If you refuse to open microphone permissions when first open app,there won't be reaction with rhythm. App still can work.\n3. Make sure to review your surroundings and clear any obstacles in your play area before starting this game.\n4. You 'd better have sweat proof sleeve on your Quest headset, you will sweat a lot happily when playing this.\n5. Some actions are more suitable for people with basic dance foundation.\n6. Any cooperation is welcome,please contact us.     \n7. Will update new dance every month,  If there are songs you wonder which are not in list, Please don't hesitate to contact us immediately via E-Mail: \n408077086@qq.com", "short_description": "Burning Shoes VR is an dance VR app on Oculus Quest. We can see clearly virtual characters dancer teacher by your side.  This is more suitable for middle-level with basic dance foundation\uff01Maybe difficult for beginners.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cqplanb.com/ccc/Burning_Shoes_VR.txt", "developer_terms_of_service_url": null, "publisher_name": "jijia", "support_website_url": null, "website_url": "http://www.023d.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6962236353818610"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4736796536399082", "version": "5"}, "id": "256242133025265", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4312427502169323", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4736796536399082"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "256242133025265"}]}, "change_log": null, "created_date": 1640940373, "id": "4736796536399082", "version": "5", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"co
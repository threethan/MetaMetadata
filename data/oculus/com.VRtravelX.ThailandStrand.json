_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974856_507918185602074_627321852488598438_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjxZPYlNuJwQ7kNvwFprzIB&_nc_oc=Adr0D7V4hbL9xtX4j9hAeTvadLmIN5f_dtthAjj85cZ7lj3XGVD75JcNvGg7MekMsT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAggAe4nEemgHzaY7g3bPIxvHRIU8kjiXEt2Gy40E69uQ&oe=6A638142"}]}, "id": "608674481683517", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "1148638230117403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974861_1148638233450736_7560596039930023210_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooBYX-Y9qi4Q7kNvwHQmZfz&_nc_oc=AdrDBv-hKGYIwL-GCvS1IL45aRbQzCJWCLI0GvsLVPU-WPiHf53Ov1POIMacIgLz3H8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYErq7L36-f659-EBHZpRI6GsuEFStMcymyy2a3A0lYg&oe=6A637826"}, {"file_name": "Screen2.png", "id": "1240493490546261", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572921_1240493493879594_2142472821237336808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJedRv4MOOcQ7kNvwEx64-m&_nc_oc=AdqHiMO0tCh0b8AUhpNf6YoloK6xUetfMV9C-kdM766t5yfdthXdRPwgrug6Z5swsL4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWX5EOYYaEGGSEtGP3RRo0FlYo-xIsn3rhmGc3o3Lrow&oe=6A63758B"}, {"file_name": "Screen3.png", "id": "2336153783388043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295893_2336153786721376_2636663998538492771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5rF3FkLS2MQ7kNvwF75te9&_nc_oc=AdomDbRZCpzuNjuwHqYCSInWNty5e3bf_MqChiyNRQm5r53wgAW4M-l1RXXm6Imw1lE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO0ztHL8MBvwQC0RZXAe0qBbjKikkO8i0T3bk-Q9PWoQ&oe=6A636C3C"}, {"file_name": "Screen4.png", "id": "849661923788558", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75411993_849661927121891_2398300823307672643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYY72206HQgQ7kNvwG2XmiI&_nc_oc=AdrhO19e5FGU0Thl4KMnZl-5usPDHEJ9utcNZ-UjgG7I6rvG7ks_kGDzpZk-NV-jjEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoUTTvjUSfDWKc5TmF4p3cX75mCbHXK_srcx1XKSQJ2Q&oe=6A638542"}, {"file_name": "Screen5.png", "id": "2385707838431717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/427363701_2385707841765050_1947275733587568755_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bh6wLa0IWkcQ7kNvwF3UyEV&_nc_oc=AdpTKhRg_rLnn8wRm5PNTd4UZ7cCvxA-IT4JUY_4dlffOqnje09_G2WRBzEjahYt4H4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC91ra_q-Zq6M5wjC3-sDnT_Y7qSPdZaNtiqtpXksTHLw&oe=6A636CB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Travel VR Thailand: Tropical Relaxing", "keywords": ["travel", "tourist", "travelvr", "Thailand", "relaxing"], "long_description": "Discover the untouched beauty of Haad Khlong Hin Beach on Koh Kood, Thailand, with this immersive VR app. Stand on soft, white sands and gaze into crystal-clear waters stretching endlessly before you. The soothing sound of waves and the gentle rustling of palm leaves create a peaceful, meditative escape that feels entirely real. It\u2019s not just a simulation\u2014it\u2019s like stepping into paradise.\n\nDesigned to deliver a tourist\u2019s perspective, this VR experience brings the raw, vibrant charm of Thailand to life. Explore the serene lagoon, immerse yourself in the tranquil surroundings, and take in every authentic detail without distractions. Unlike a documentary or guide, this app mirrors the joy of being there, offering an emotional connection to the location.\n\nWith no need for flights, high temperatures, or crowded beaches, you can enjoy the full experience from your home. Whether you seek relaxation, exploration, or a short mental getaway, this app provides it all. Pause, resume, and revisit anytime. Escape to a world of natural wonder and make every moment count.\n\nPlease note: This app features streamed experiences that require a stable internet connection. The streamed content is provided by the developer and may not be permanently available.\n\n\n#travel #tourist #sightseeing #vrtravel #KohKood #Thailand #beachlife #tropicalescape #travelvr #relax #relaxing", "short_description": "Immerse yourself in Haad Khlong Hin Beach, Koh Kood, Thailand, with this stunning VR experience. Step into soft sands, feel the warm, clear waters, and hear the calming waves\u2014all as if you were there. This app captures every detail from a tourist\u2019s perspective without stress, heat, or crowds. Pause or resume anytime and enjoy the serene beauty of this tropical paradise from home. Discover, relax, and escape whenever you need."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Travel-VR-Thailand-Tropical-Relaxing", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8524074734369829"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1741302630195163"}, {"status": "PUBLISHED", "id": "904793945940622"}, {"status": "PUBLISHED", "id": "2320954135067320"}, {"status": "PUBLISHED", "id": "3155568887959746"}, {"status": "PUBLISHED", "id": "2014251069138192"}, {"status": "PUBLI
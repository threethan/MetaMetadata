": "1148638230117403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_1148638233450736_7560596039930023210_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm1WvbNSEUgQ7kNvwGQbYhV&_nc_oc=AdlEmI81D-3mae7mREmyQl98c1j41o2QM8uJa_3YRzzFlEaHmgIx6zVwvtS4M_J3dGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftMSyp5yFTwXYjRCzdb5TYBIlnEoLRMJDEuKjhj_FcYKQ&oe=699DB726"}, {"file_name": "Screen2.png", "id": "1240493490546261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572921_1240493493879594_2142472821237336808_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5cW3FCXJOIQ7kNvwF5sUXU&_nc_oc=AdkgtWjLV1Y0Ani1PbDPEI4ZTViHwR2HeuOMtt3e5cuhLBN4d5zb34dSJIeDbRHNWJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3WslvMC1HKmfIzDAQMYksLdZ5hohOrp4bGLcxZpMvbg&oe=699DB48B"}, {"file_name": "Screen3.png", "id": "2336153783388043", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75295893_2336153786721376_2636663998538492771_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0ocvA9zwYEQ7kNvwFnTOJf&_nc_oc=AdkTqAwGgwpwRqyUchm1S3GRLTXMf-zZC-7cUPmIRcWH9YovsvxDiZXeosy0H8PKBDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHjAx8YOxN3CIAdZS1uEU0eefzVGq0WlyoG3B5WFttJg&oe=699DAB3C"}, {"file_name": "Screen4.png", "id": "849661923788558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75411993_849661927121891_2398300823307672643_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsdqBdAjRbkQ7kNvwGckh01&_nc_oc=Adl61BbckDbuWGaz5_xN-jdlGxKopZUYQdCTHSJC35ZgW4nk0Scjvu83f_PEUedOaOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhBg7yoRlQj24Kp5nWW4OZIoN4QCE8gu91apDUWt99NQ&oe=699D8C02"}, {"file_name": "Screen5.png", "id": "2385707838431717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/427363701_2385707841765050_1947275733587568755_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot2p8fnUZYYQ7kNvwEJ3Q-Q&_nc_oc=AdnbVqUzS-Pka80WnaAedgv9Kg4WWP_zsjaoNpwUToyTLtmqS6dZ1syrBNZbLGsBzwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs3d4Cc1ajuoXYyeC7OKjr5dmA0-25Gxgc1wnLWlqSvvA&oe=699DABB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Travel VR Thailand: Tropical Relaxing", "keywords": ["travel", "tourist", "travelvr", "Thailand", "relaxing"], "long_description": "Discover the untouched beauty of Haad Khlong Hin Beach on Koh Kood, Thailand, with this immersive VR app. Stand on soft, white sands and gaze into crystal-clear waters stretching endlessly before you. The soothing sound of waves and the gentle rustling of palm leaves create a peaceful, meditative escape that feels entirely real. It\u2019s not just a simulation\u2014it\u2019s like stepping into paradise.\n\nDesigned to deliver a tourist\u2019s perspective, this VR experience brings the raw, vibrant charm of Thailand to life. Explore the serene lagoon, immerse yourself in the tranquil surroundings, and take in every authentic detail without distractions. Unlike a documentary or guide, this app mirrors the joy of being there, offering an emotional connection to the location.\n\nWith no need for flights, high temperatures, or crowded beaches, you can enjoy the full experience from your home. Whether you seek relaxation, exploration, or a short mental getaway, this app provides it all. Pause, resume, and revisit anytime. Escape to a world of natural wonder and make every moment count.\n\nPlease note: This app features streamed experiences that require a stable internet connection. The streamed content is provided by the developer and may not be permanently available.\n\n\n#travel #tourist #sightseeing #vrtravel #KohKood #Thailand #beachlife #tropicalescape #travelvr #relax #relaxing", "short_description": "Immerse yourself in Haad Khlong Hin Beach, Koh Kood, Thailand, with this stunning VR experience. Step into soft sands, feel the warm, clear waters, and hear the calming waves\u2014all as if you were there. This app captures every detail from a tourist\u2019s perspective without stress, heat, or crowds. Pause or resume anytime and enjoy the serene beauty of this tropical paradise from home. Discover, relax, and escape whenever you need."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/Travel-VR-Thailand-Tropical-Relaxing", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "https://www.vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8524074734369829"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "3155568887959746"}, {"status": "PUBLISHED", "id": "2014251069138192"}, {"status": "PUBLISHED", "id": "2082695079232903"}, {"status": "PUBLISHED", "id": "792931610314570"}, {"status": "PUBLISHED", "id": "24784739741187750"}, {"status": "PUBLISHED", "id": "685414210775317"}, {"status": "PUBLISHED", "id": "4058392904429082"}, {"status": "PUBLISHED", "id": "959518829469742"}, {"status": "PUBLISHED", "id": "1759466064899111"}]}, "baseline_offer": {"id": "1759466064899111"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "3155568887959746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8817507721693194", "version": "1.2"}, "id": "11349947015790
uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc774 \uc571\uc740 \uacf5\uc815 \uc774\ud574\ubfd0 \uc544\ub2c8\ub77c \uc2e4\uc2b5 \uae30\ubc18\uc758 \ud559\uc2b5 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uc5ec, \uad50\uc721\uc0dd\uc774 \uc2e4\uc81c \uc791\uc5c5\uc5d0 \ud544\uc694\ud55c \uae30\ucd08 \uc5ed\ub7c9\uacfc \ud310\ub2e8 \ub2a5\ub825\uc744 \ud6a8\uacfc\uc801\uc73c\ub85c \uc2b5\ub4dd\ud560 \uc218 \uc788\ub3c4\ub85d \ub3d5\uc2b5\ub2c8\ub2e4.", "short_description": "\uce74\ubcf8\ube14\ub799 \uc81c\uc870 \uacf5\uc815\uc744 VR \ud658\uacbd\uc5d0\uc11c \uccb4\ud5d8\ud558\uba70 \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \uad50\uc721\uc6a9 \uc2dc\ubbac\ub808\uc774\uc158 \uc571\uc785\ub2c8\ub2e4.\n\ud37c\ub2c8\uc2a4\ube14\ub799 \uacf5\uc815\uc758 \ud750\ub984\uacfc \uc8fc\uc694 \uc124\ube44\ub97c \uc774\ud574\ud558\uace0, \uc791\uc5c5 \uc21c\uc11c\ub97c \uc2e4\uc2b5 \uc911\uc2ec\uc73c\ub85c \uc775\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/koreatech-vt-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KOREATECH", "support_website_url": null, "website_url": "https://www.step.or.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27083974994533360"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "885718791165028"}]}, "baseline_offer": {"id": "885718791165028"}, "is_approve
0864760352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKrGTZ7_UI0Q7kNvwEqPNJw&_nc_oc=AdoA16-ECEshTKo46LHhKIRnVFeT1Sr3kTF8NL4YAKGLXQXL-pv4bu71s0ClVa0UgQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2t3_UPblaA8B2UgB1_icVcU7KiCwT8gcT-MPAHIaTy9A&oe=69F0B969"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "intro_1.png", "id": "1462151378651012", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620504_1462151381984345_6683349854456088405_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfnSVy8V2ZQQ7kNvwFIfyq7&_nc_oc=Adq0lI2DacPl_zRvDmEFroOE-ztHT7lDpaqg3H0xhLXwmFeAs88DUBoByOF5dH0g-Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3zMNcSEfVDheXfQf1hZ1sncGuK4S-0zLWeOiMDyi6X_Q&oe=69F0A638"}, "display_name": "\uce74\ubcf8\ube14\ub799 \uc81c\uc870 VR \uac00\uc0c1\ud6c8\ub828", "keywords": [], "long_description": "\uce74\ubcf8\ube14\ub799 \uc81c\uc870 VR \uac00\uc0c1\ud6c8\ub828\uc740 \ud37c\ub2c8\uc2a4\ube14\ub799 \uacf5\uc815\uc744 \uae30\ubc18\uc73c\ub85c \ud55c \uc0b0\uc5c5 \uacf5\uc815\uc744 \uac00\uc0c1 \ud658\uacbd\uc5d0\uc11c \uccb4\ud5d8\ud558\uace0 \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \uad50\uc721\uc6a9 \uc2dc\ubbac\ub808\uc774\uc158\uc785\ub2c8\ub2e4.\n\n\uc0ac\uc6a9\uc790\ub294 \ubc18\uc751, \ud3ec\uc9d1, \uac74\uc870\uc5d0 \uc774\ub974\ub294 \uc804\uccb4 \uacf5\uc815 \ud750\ub984\uc744 \ub530\ub77c\uac00\uba70 \uc8fc\uc694 \uc124\ube44\uc758 \uc791\ub3d9 \uc6d0\ub9ac\uc640 \uc6b4\uc804 \uc808\ucc28\ub97c \uc774\ud574\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uc2e4\uc81c \uc791\uc5c5 \ud658\uacbd\uc744 \ubc18\uc601\ud55c \uc778\ud130\ud398\uc774\uc2a4\ub97c \ud1b5\ud574 \uc7a5\ube44 \uc870\uc791, \uacf5\uc815 \ubcc0\uc218 \uc774\ud574 \ub4f1\uc744 \ub2e8\uacc4\uc801\uc73c\ub85c \ud559\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc774 \uc571\uc740 \uacf5\uc815 \uc774\ud574\ubfd0 \uc544\ub2c8\ub77c \uc2e4\uc2b5 \uae30\ubc18\uc758 \ud559\uc2b5 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud558\uc5ec, \uad50\u
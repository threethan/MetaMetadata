name": "\u6d77\u62a51080x360\u5907\u90097+\u624b.png", "id": "824648603043255", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75195902_824648606376588_6298033056542748118_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UC6dpjiIegIQ7kNvwE5XdHS&_nc_oc=AdkJdoJ0GobmF_lcuyNpKp-SEN_5UjbrNKkHiX8sKvz-nfuDcmeelZuNS1XBJazlYwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtUlyo8fwVRNeOzMmKE1JYFuGGSbasNJR7QEskmNk4VQ&oe=69B7E78F"}]}, "id": "1382466938967099", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qt8F_tXw6nwQ7kNvwHoEZZh&_nc_oc=Adl8e79LA9drrz05L_SGgocLrwj_Wj-USWzFy38L5tPd14I4mPUOV9jnJUg1A1XnxyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1lEP3QfTt91ByS3L62txrLF0vsZ2phRzLBINzmgrKOQ&oe=69B81131"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG2u75pYuUcQ7kNvwFplB_u&_nc_oc=AdlLEWX7rzzPX9E-cl7IxrB9lshAEVsEamsyWkbJnje8gMRZuog_BcV64AflV6f1Y_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyg--4pyiKF9fAKiHzsoYQhLX299pUOmw8BcrTUjVLEvQ&oe=69B7EE7A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Vkxv_obTcUQ7kNvwGQNdiV&_nc_oc=AdmNHr09h-CY6QZkOoXqnpsljx92n7TIhflEdvs5p73OS6NKQwvL-xAG-9ccVUhrXeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHAXW7V1oGeJaLso44BlJeWZGnZ0M0Turu4ICA7HZ2XQ&oe=69B7E962"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXjesGpGHqYQ7kNvwES_udq&_nc_oc=Adn60zhPamfXh4I37qSA1EojhuV-hKJTpGD_K_2HcGN0UUaq3EW1b5AqOMm0RZjX-v8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyndu5A5hAyrp7jxZa08PseqKf-K9QiuU48eaPB7R-pug&oe=69B8083A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoqkWbWPCh8Q7kNvwEwrtzJ&_nc_oc=Adkhw9A46OFf9baw9P4FeH2Dl8LW3M26WsxCQ8evlm2w2maqPWXdtYOXrdFTWVoNmxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwwqsr_5lZvxyHQ_0tk2HzYFkfw5ys4_AZsEBmhKlVNlQ&oe=69B8126B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWoQqPELGzEQ7kNvwEcWdeE&_nc_oc=Adl8rgUDST_ENBCkALfuTnX2UU_8RIstk4J_stEYBYFllDkU3IqvSIvbrzIRBr-4l9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh9lwn1-icte_8Jt_0t0bFCi41Wf1qdcv0979YUYI5aA&oe=69B80E0F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvfpCGk8uXkQ7kNvwGV_XKl&_nc_oc=AdmmwNpnu4B2Klux0jyKF7eE6l5oz8SeQ5QTMGfl7uWpDMBd8XNmfO-vL-5Q6_l-mMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUXA7PEYaTDL2zpe8MWLmnUliikjPSCHxTtF3Yozs9gQ&oe=69B80A59"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-CQcKed6tYQ7kNvwEVdoOp&_nc_oc=AdlPjCFbaroQ-22LlWtI9Rwxq54OUmZEXnf-lJtokrFO
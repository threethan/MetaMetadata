d=6e7a0a&_nc_ohc=xlc13HdxLcsQ7kNvwEgveSz&_nc_oc=AdplGyI9X3rM9VcCG_A9Y-cUXXtHocY67phtXEYOG51yAt6r_6IVlmhOT9fszQ50FW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkNQnVWTLW4Gi-DwUr0p_ldBxErC5YSQbw-DazptOHcg&oe=69CE6F0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIdLsVVSWIgQ7kNvwFH3G4l&_nc_oc=AdrprdKFcNfAf0c_kSoF1Z2iSPIC69ISNdA5hby_te9C6ZgWPxO2CxwEdcOeE44acYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwS_xa9o-NrEwfhpnPuYJ-IRHhYkpgQ_YYjPOapv4Cnww&oe=69CE7AB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ccUn-82ZcIQ7kNvwGn986E&_nc_oc=AdoH_Xrj_aPM06fbtkIyLcEJnriFWjQQFDtmN8OH1zGJb3mHKtSXOPkGqyMBrRLLPvs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA20oWngpesajui2Aa-kiVwL0eJnZz1-INZcUadGjYNQ&oe=69CE57FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gTPuSAspUgQ7kNvwFYfE0q&_nc_oc=Adp_7soqXw03nuQoa87YNPaHn5pjDqhS23DSGc53fPkDYJmhN6HJDcWBoAz-FdhPNzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMO3Wdn1AidcxsyFI6K7ZQNNtm8wEZ_UvJqQgZscF_qQ&oe=69CE52E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ntDmnqj1NkQ7kNvwEmvUn3&_nc_oc=AdrD0SbcRB-2R93LxDwU0jg3vDnYF6G2f9BIxLSgAs2JjDsF1AJRuEl59C__gQ-iA38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgHDJ4ccPywM-xNNMzlh9A9hB1DkTcH4snkvVgVBjBCQ&oe=69CE71BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQdoqpbm05AQ7kNvwHP7VdO&_nc_oc=AdpVjtqZJ_GZGEOEkcCPC9C4hfCr2GMdQzSEmZxMDFxvl2DgfGYmJDQOI1fsTudabPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwnm2zWHveyDVMsKoDXU5icp2772UJH177ApoVYqLtmfg&oe=69CE7BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgAhbimLm44Q7kNvwH7uWqv&_nc_oc=AdrQbSsHnFJgkl86ydrIzNiOyNE2FuMs6A7SsX9V_x-kTtsQbSKI-YtfuLkFLjTARIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXKPUmrTlLC7hh-dfCdE8S_JolFmZZLMSVA-pNWzqoDQ&oe=69CE82D3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
24648603043255", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75195902_824648606376588_6298033056542748118_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51LC1YdGWKcQ7kNvwGDmfbD&_nc_oc=AdpMyjIq2HlqT38PyVZIhEzselSkU08FTT-Qr5mTLKjEb8IeT9GheI2slyxQku2OzQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mhb8zubJ7IBBBSctvnyUTT6Q7tf4ZIOi6B_5ULxFJwg&oe=69F1E98F"}]}, "id": "1382466938967099", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBiafu2R70YQ7kNvwFhyPow&_nc_oc=AdquSPdEFIk8tNnoiDRqKxH-uX5oOQoO7DPoIRginuajQ72NcLjfcW5kT_1TnCH_pQU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3qPUtMR1S7enO5DCEaEEHTsg2h-Zlnjys_9rJiUM-1lQ&oe=69F21331"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMDhy2cBz9gQ7kNvwE_LK41&_nc_oc=Adrh3Th85BLb8wn8ES_E7W8h6YEtcZA2AIhquWQISJ4Df7hxqY-lV8IU7vdCFR_wrwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SuZxXnMQBAh4PzyC2WWu70iW6lSndyGzCJ6nIWHE9nQ&oe=69F1F07A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlRoTSwwYrYQ7kNvwH_gf29&_nc_oc=Adq3Q3oUe6kG2WnIv_D9JS7vz4d-9HjvqJFo1cbZZ4NkSvKn8wMuBqa5Ov5PqpPH0N4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c2RZfl5lqbsEsfkgmpTlCZ57jc6D5dWlbQ5-aKzCJYA&oe=69F1EB62"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXp5Dl6Vs_8Q7kNvwEDPcCa&_nc_oc=Adpuyus_h2QtMehoo3HDnoxQzzP07b_8Hd9uvBQXYUXQbuCOV7U_-gSrBQ59uNJ3_G4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_1O9LbMnCSIj67znBIkrIjpaEn3TfI-ff45eya59f1Q&oe=69F20A3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch-_k8x-53EQ7kNvwHswnjq&_nc_oc=Adp5wzgiiGgB7LfW4Qno229Q_bBMYVjHgDOzhES6OGrtYnGJCu1FTAHXamsg1oiDNl0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2KD_r0FDG13t3IxICf-LynvSx2Wlmu323C0wHA3yx6lA&oe=69F2146B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npaAZpcUcSoQ7kNvwGumtge&_nc_oc=AdpwQzGRQhGESzZOoVz6AolwwaYrzmNdIFm9D1NZHjFcDbsOODmat2UUrEYEGcsdrN4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_Fx_y7D4V0HMwebLX79rCGJMriaWPU1Eho4cyEKcA3A&oe=69F2100F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_yr8BzkcV0Q7kNvwGU9cIt&_nc_oc=AdqRMMY4RR4ecvE6sa5cgtIvt1pM4VCKHLOiHnSq9ybuUjL6DjHyJwF5SusicxEiE9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ugg9kjq2WL2WDO0d6WvcGyaJ8Cn0xVOv4PfDPKJBgVw&oe=69F20C59"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6u1uQQcnWgQ7kNvwEcaFh-&_nc_oc=Adq6A0UaxO3YeELP__ap3i9dCpEInU7YiMExV__hTKjFvyciAg05ZLA6gsTlOZ_N7fg&_nc_zt=3&_nc_ht=scon
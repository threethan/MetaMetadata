d=6e7a0a&_nc_ohc=6x7cyq9xhpoQ7kNvwFE8Fy0&_nc_oc=Adq8ar4cM3lEs62l7oQPJ5N6_qicMsVMlLyPoQBLG9fJgFN5usqeQeZNSKf5f_x6ebQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb9m2Cwt_5eV9Akiseh6ePsOyf9fkFfW9JBIqAojw7DQ&oe=6A87010F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiRDSOQFNJMQ7kNvwGR2fRP&_nc_oc=AdqdfYbY0awcitdqAXZjLxgNsEpywLui1RJ6csulJ6MG-Ire5beXp23X982uL9xjMQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3nmyPSekexOk4Fcj5zNWu4rztmcGaPFrKOk0NZH0y-w&oe=6A86D471"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd0sN0kcjRMQ7kNvwFo7bqA&_nc_oc=AdqZurUi4vfs7pvtIgdPuxWX83D-p8JNKyG6YSLZbMUY_5DgRyNrwDLIOsfc9O8joeI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHosrYKrQYfbbnnpoH3SYopCDljErQLcrjrAY2UYk6mcw&oe=6A86E9FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9xNPb3Wkn0Q7kNvwH8nA3E&_nc_oc=Adr4PaYnVQiVDXLq5n3VKZJ900vy2rslCCIrW3aWaOxscfwPwNZ1BX1EIc0FVXSuaHY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHhve3hEkwKnEAmGpBbHiBiROqF2NX_bqDEqD-9xF2jA&oe=6A86E4E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJy2mp5p39EQ7kNvwFqE1ba&_nc_oc=AdpeINKDibSykAzD8Mm51CMnpLK5lVj6o8vGS5t2S3GoFNg6PtJF64BtqdtdQX0tGdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2tWZK-mfz_XmsYIie_BwE4sGcwyraWbDuZuetJsE3Dw&oe=6A8703BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3o7axPSxyYQ7kNvwE80nZd&_nc_oc=AdrNkMBzOKFl0JYEQeZeoHbi-kNPUbHNN2FLynw7oA-f_GUldpXRccY9tECgf5Mo2VQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIh3_yL8rD_G5LV6JgeKN9-IEPKXzpYPVGAXCdxoX6Ew&oe=6A86D5AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp8886FiRiwQ7kNvwHQvYrt&_nc_oc=AdrfaaV0POm4-BObOZ8XCgHkQhsLSFNwDS_AMm_uHEnF0B2LjlAUyU1ZgB5EQSUGvI8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtrBWBhc4vRGE_J9Ezw1OjPAaRj9fFqxxUX1hFlmTQeQ&oe=6A86DC93"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
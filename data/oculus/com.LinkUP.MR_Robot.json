d=6e7a0a&_nc_ohc=YzV9wXGrejMQ7kNvwFSGbqc&_nc_oc=Adr03gyze6kQPKDs5wdYgVAb_Zas2AvkkSLWBSaWvsCe9ur3luRtdhI-nLSy_uSxm4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-38rCAhMeyOspN1Ko2LdhYBVeq4pzkNRlO0nyQqBfPQ&oe=6A9C190F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCjnGRmS2cgQ7kNvwHLvvsq&_nc_oc=AdqnR1DZ63fpD3kTAaoh11CBH8j4ODaP9qwgB2K19l31rz5xlIbzEDeSMhwDbuqnesg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ80KqXee9-TAawlAGGM4OGZF-X_LLzQY9MFHWGMKjw3Q&oe=6A9C24B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUo01nA1PK0Q7kNvwG7-Cb7&_nc_oc=AdrUbu1yS840xoLtq2TqM9kvTyvvpSMJYf0Y92LZTvFAW6A16T_Llsq9wAdvQO_Yv1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8e-3y1GOE3-c92O72KdnufekZB60sO6UbcRQmCY4sow&oe=6A9C3A3A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7PHlTXP9a8Q7kNvwHShyGm&_nc_oc=Adqp0HN0ALkvzzCUygBqmIVCdw3_TiYOc6jAh51zsY-hR5wmhWM6IlK37_XhxuWiZDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhdT0xhOhO262pe-SsHkPKf07MGjgFVtlGNdfBQBMi9Q&oe=6A9C3522"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vhgjVS1Gy0Q7kNvwHMb0tm&_nc_oc=AdosuVgHqIiXZgvvej3VPZ84jMoJ4hnDpFbgppFrQzP_KHWmCzysO_mS89-ZS4a4bc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkoTxTl6pgZ_e-J5ESyRplMIqrA7vXdK_9k6pwQjRLYA&oe=6A9C1BBA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WngcyPT1EsYQ7kNvwHaD62i&_nc_oc=AdoTjIsJM4J2Znp1Z1uMPynqdGk7uF3lKOx68gEtUBOPNoO7X9I8g0wB_EUU0JSh8Vo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOMpKQUSbiNwvFbyObPEMULlvcavtB1cG3blHhxsGyBg&oe=6A9C25EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmY2EmjKfdsQ7kNvwFMzhLE&_nc_oc=AdpnBxKd5B1CevMTuUkLNziIZ0D1TR0PVg6H6GAltcrlw7xH7gl_QxCNeamg3oqTC_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyrPNQhqfRFpxUsbg2gJxqGORx82QfBYf3j5gegR7PNQ&oe=6A9C2CD3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
d=6e7a0a&_nc_ohc=xKiOEVXmHvYQ7kNvwEU-eX1&_nc_oc=AdpCkgP4D7eoXnOMD6nFQLQ6CU7QOvvAY-fdpVQMC7UTDNE7F1blKEUq36TbN1VPn4w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tVntxVq-5isJV_AnZ-LLrFPg1M9DyWGuBjMiD091d1Q&oe=6A105A0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQpkwxJGxuwQ7kNvwEHO0X8&_nc_oc=AdpJA_F0MGgCb8AtO_HWerLHEir48UpWyiWnq3HKD-rSRdlutmjuEwmpU6wmUcvX2TA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M78nZWndnMKIkbg-Hl2tzDYz8l5a4_Yd3nigRGui9Mw&oe=6A1065B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtIE2OJDkE0Q7kNvwFTnyxc&_nc_oc=Adon3EKv59IXi9UUXjkCOIaXz2SYFHt38zyRAHw3-Rwt1SYxYAUi4u3116jemiueBuI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42BcZ_1fiwo9x4XUeYK4s1Z_64xKY9W2x1xqXqD7_SJQ&oe=6A107B3A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATSI0j7C_5IQ7kNvwEEaSYB&_nc_oc=AdpTL3ooel648FBOnk3msYKGFbYdNaHNI726fJ0IjLOhNI0wt60JjBWv2idSf2Ic0IA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LKSRYEpfUOZiRcEixBJomkeQtjtCBhRI9vCwXk2pvOA&oe=6A107622"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yPZQRkrSjYQ7kNvwFGa5yj&_nc_oc=Adrcc_BSURC99-I3vcrluE-7XUEkaYQgF_rKdGcV7-uN6VBoSDhWn6zgM43S3qlJ6A0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QoZg3oqVVL56onErmERH0rAzNBD2NzFRzX5LUgJaO2g&oe=6A105CBA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdG-odwukIgQ7kNvwGnUJ2n&_nc_oc=Adr-6-5kphLaii1g_mgOMUG0s2F908_crUcEhsqtSwhqm9YSV9H8P_CE5MnD01IZV-Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BgSJDDCdvj9scwv1tbsqLZviZB6zhaNCvS4USBaa00g&oe=6A1066EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gbqi3K3tpoQ7kNvwHW6GCV&_nc_oc=AdroTIEAwWpFmkpDS1HgFLyiHZd6Toyj5_xu1ZXl70Hg1ek0JfZSQCrp9Tq4xGU0t7Y&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PMKH2Cv4mE_CKvbqQIJnub6RIxX0zWClqJ75vRM5qbQ&oe=6A106DD3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
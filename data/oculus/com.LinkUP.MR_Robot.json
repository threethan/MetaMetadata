P3AkPAUEZrggrHpmzRfQ&oe=6AFF0531"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgG4c8s5lekQ7kNvwEtaPpr&_nc_oc=Adp47ghywnbiq3hfxy1ZQC7AkdUPRmfKpLNxml19nOoK0HXAWMS5PyFpxW4byrPJDwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLtcxCu538sSPaxCDxhPqiFzU0pyO1I2ph4rqmpzJA6g&oe=6AFF1ABA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIqsf-0yADsQ7kNvwEMNEYF&_nc_oc=AdqdirOQ57tvB87IunoihFobrUFJ_EEl-ZdjwivGq9mR-yFy4xWqeopnSYngPCukisI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKe5TaXhXUcdTSqMHQMAL5JFeVpCQDG40aKsSOimTeIA&oe=6AFF15A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCM7PpAckfQQ7kNvwFKDrnp&_nc_oc=AdrmFKKfuNl3Cn4ROPTfX_cOBLyMmqqZLfWDQ6EFVtYgWFCPkg6WRGW1KDa6MVBzabM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRON6pHqzzEAjqQIWXgRyPPVYOH0125FOIaM10ps8albw&oe=6AFF347A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLtUJzL41yYQ7kNvwHQtrcL&_nc_oc=AdrbXaWsg0zu7FpKG-HQZaNjjoEa50-r85jkbPYXntAQua-tkzTaVgcvx9FV4dlf4rk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvzSHmewUNoSK6J1TMnqZk7-Hrk-4pMMvexqk7p7QvQQ&oe=6AFF066B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pElSmNRl1TEQ7kNvwEMHoGP&_nc_oc=AdracuOd8OTUA0wjHpYWkQ6Umv9akkAsasL-7U7khRSvwvHNo1Mw1hrlrA_7xnqg6mM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtPUWcmiUNlpw6J7mjHc5vWj9EjDx6fG9nOXg0CieyqA&oe=6AFF020F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ygDXwKxwuYQ7kNvwF1APMw&_nc_oc=AdruYloX_dn96v_2Fa_aXJkz1c-HWS5x95l4ybhxFVVY1U6qpoNMUe2dVTDiueSaioo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-i0oNRCA0SPToxfNo2MiSegJj_m9_-Qp7tHFs5IB2wQ&oe=6AFF3699"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUTqA_wTOgQQ7kNvwFcaqMp&_nc_oc=AdqhkRD80sC3KUbgIYGbaRVYHQgHivlZB3S1cWNDwNCp8Q-TpwrZeDzw8Z9TcOcC_-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdxBdxzkGcgMllDT8P2l_uJEm3ou9geqsFdzbq_8cEow&oe=6AFF1F0D"}, {"file_name": "hamster inc._logo_ch.png", "id": "857711756373822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75476756_857711759707155_7542117578876813577_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLYqFyDTXHUQ7kNvwEkpxNW&_nc_oc=Adp0L8vSOFtFLsyKUbgyHPN-ifvaeqIKXfN7dTQluvxvNl_ra-7Q7N3myyAgzC5mbzo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw60serA_p7mOAvaU6520MVYqOiUpr59KS1toG_BWQ2g&oe=6AFF2195"}, {"file_name": "\u6d77\u62a53000x900\u5907\u90094-2+logo-\u4e2d\u6587.png", "id
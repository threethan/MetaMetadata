d=6e7a0a&_nc_ohc=wKAUj-e2AV4Q7kNvwGVg7NA&_nc_oc=AdqqFOyXN8zQuEcoNOXJPELVxUhrL0ZTc-RS148SQkz7XmtW7ogdHlxmPO_uTtNIe-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6tBi9oJwyDt-F-sv34_G_WlPWqqmVHwIv2WPb1aq2_Q&oe=6ACB8F0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oknRRp9SZ2IQ7kNvwGyA6sS&_nc_oc=AdrgAIT766fk2h19tMcLFXRwZeFsyZheOCucnByoNJHy4SVydFNkzsss9vj-ZWQFKpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhjfyieBsMFMitxtZjhtJpuaCpupFDZ17MMaYGg0RXZg&oe=6ACB9AB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwvnYl7MQn4Q7kNvwGDUFN5&_nc_oc=AdqG2Rr_PS32b9Ha5D4MFgOCOU6R8IZJB1x7O2vc0uwt0SQT0ElTamqGys8TA8GQ308&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMZaa6ya1AsyNChU-H_prddRUdgHanstjN0dud7uR8JA&oe=6ACBB03A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_n9PtdF1nAQ7kNvwGAUFJ3&_nc_oc=AdpCTKbDq1pT_yY7ysJPNFkISfaCPWEfWUzBVrxKQSPXq573vqkIrHFry7Zn9TpqCFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-5EWWJA3DIut8mKq9CtPU5_iD2RG2xFcmATktFUR2gg&oe=6ACBAB22"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jeBAlOp6pecQ7kNvwEbe3oN&_nc_oc=Adqmolg0ASPbGvqkmwui5jzUPCtD5V9yrSW8sfIkArbrb0EDJM9jyvPLZVV0ShwMXk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfEoM2wH4wOzmx740qfZYE6d1faPrBL1hxPexe3ppMPw&oe=6ACB91BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTxiMuH0KfUQ7kNvwGajZZs&_nc_oc=AdraWcEiJvHNbynaLtELSKNPbe2dsVQod9cZFpSO1L5Dx4l1tMozm11rMVqSeQ2QGsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUj5eZK_R8FyMH6PQ-LIEcJEYEOLDpAUU0i2ZTbggTIQ&oe=6ACB9BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3oHwns2THcQ7kNvwEYxD2X&_nc_oc=AdoZx1HGQzyO9TL0q0NhfL6oxy6HDBvDwFuVPVQxJrizqOhcFUJznQjXQatChDRm60Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXz1gT6WHMSb5BrXBQi4Hx2cJj6K2s4KXXHHFMjKC4VA&oe=6ACBA2D3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
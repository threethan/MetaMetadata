d=6e7a0a&_nc_ohc=rhiH8iiGw7YQ7kNvwEWdf6P&_nc_oc=Adr_TvTaQ-FHY6a-ZjLvVNS3-E4hZKwKWt3NJ2CQLPdX5GhTronsUTnYG5p6TZcNzso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEWHz4BPFtjwYssNbFu1n9iU2gACHSUPwLxEhiIhk-PA&oe=6AAA998F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oVBsKKrKSoQ7kNvwGb0vRA&_nc_oc=AdoeoHyl7cA1ZYy8JN8TStEvsacAbTNuBmHUwUEmKyERpShSKlH34AeAyN_f0TxE9nU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLez-UAO701uyz-SUkSkI-pVd59-0u_JMeRjy9_YpmH-g&oe=6AAAA531"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfcO611ZX84Q7kNvwEcdHIB&_nc_oc=Adq6NSyGDY7hX5VheQpcJAzYt1a09MXe_vS--U_43Rlmxr0L-_dCTY8BKu4Z5WgAOqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzOciN3BYo-AUiWZeurx8Em-SYwLcvPUV7539HQzFFfA&oe=6AAABABA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2jvqAmoW0Q7kNvwEtyG4l&_nc_oc=Adq-iP2di4WTFvjeDPzxWPHpM0YWStNaUTUyn6lb7RftZgSGlFfRzJw2weSTl0th4bE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR0fBh9SOKRwgSxQP9mVstCLq5GRCqrC2HWasz1R4KHA&oe=6AAAB5A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tjx6XZE0-tAQ7kNvwEnA-AP&_nc_oc=AdqWPkLLt0b2Jwotosu6WxNSBfuwfVy-ShTg23FZ0fCoGJKgTYGFy-yvq4uRP5vUg7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk4Y5YYUixYu7Z6__mZcoDWRht506wpEnn5quF5AEOxQ&oe=6AAA9C3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=977LQ3i0rTwQ7kNvwEadfEo&_nc_oc=AdoK-BhHsQQjblKby4JdAwy9jTZSFN3GKWB2D0g8w5wj3RNmmysQ4SBDrUusGHXHkgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgk_y1APGD9c-jg-J4zXuJ28TS_aiqMcJyIvPKqXBIiQ&oe=6AAAA66B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLxIEJm-aM8Q7kNvwGYrV1F&_nc_oc=AdpNOgWsAKRTtu0d2McoisQNsUJ9n0qJ1L2mfznKwlz1R3fiYMIIe8sjteYS07lSPis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6dQc7am86rqvcg-yXaFNI9V0aXM_tVxLWp5S-DY2_CA&oe=6AAAAD53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
d=6e7a0a&_nc_ohc=78OMGhIDuc4Q7kNvwGLU2CW&_nc_oc=Ado5wii93xf5UAjFCCa30xQerYOKJFg3RaVd3D9L25_MoG_Ht_EMxifYnBEKHVz9lIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ezhLTUmwsgACsqqnw6PdWmm9zagv8OfYpK3lo4VT8g&oe=6AB1310F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLsGX9z_ma8Q7kNvwESno1z&_nc_oc=AdoM4qouRuA7xj_rurzypQbVE4kA9u-MfRNUVtRFqISbooXM6vtSoLaY6sGOaOzEm0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgqYyitwT3TU3bPoxKFQYOg2BCAe8a66p8NHLEiIK8YQ&oe=6AB13CB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoYLQ6ORIooQ7kNvwFK47UJ&_nc_oc=Adrnsym6ED5oPgrEeyIwiD8jesI56kWfzjPrcuOZRmlbWejn1MVCIqdukNzCMCs5trI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi1Tlp2hNc0ixxoxT0I5YxrWNf4TltSavylJfAA6ncrA&oe=6AB1523A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rft-DIL-regQ7kNvwFN9kJB&_nc_oc=AdoDzM3e7cxoQDWTYLzAi-Ffu0U0rgFmHlBcclgKAumPdiV_GJewKhqMAyaDTNEXd9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiaVtiL7uTSffCMHQUzkZBCTpAwTq-RDmDTQ0jHVAw3A&oe=6AB14D22"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fTY9SY-QCMQ7kNvwGE3o-F&_nc_oc=AdrRqxHnObx25ZUYmx7gYrn9HXl0licynA-DCvPXq5ztgSBG2kdIciZisBU6qEgGzcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKvkaZwWtkaD8T6GnCDUwYyDZ5c2rrTSfD-nWiE_XNKQ&oe=6AB133BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKLYWbobLGYQ7kNvwHIViq6&_nc_oc=AdpU11INZv8GEXr3NT6WdUQgBDyV92QyFhKFJlN51_K5HaQf3JyLsq_sPbVtdkJuMcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9bPcChaPxqV207HBZnRDyBrKWJyT4YLRpIXVilnRnzg&oe=6AB13DEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2ecoHL1OYwQ7kNvwEguW5b&_nc_oc=AdrEIFcbqkElh3qzL0u9xlv_Bxrypgq3OQac_FF_EnxX5zrVH8QeJ1v00sNzIQGJNac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI46EZcKoemR6ahNxVSpFPsPEd9E0fJjqRqf9V_m8bUtQ&oe=6AB144D3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abDNRvISKWoQ7kNvwFaSQz1&_nc_oc=AdpmEbocSgZqOdFgsaO57K0kBobFn1M6nO4eQ8bXDw4Nn8Nsysw_luDnYZi2toHc9vY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zlk5jIF0uh9t_ol_qWs9P-RVtQ1ibqYWdtOHJAm3jlw&oe=6A46678F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPks6lgxjWEQ7kNvwHGEary&_nc_oc=AdpSML-H0U71-KA-hoP_hzyfTNSW-9zkOr2AQJSRCRF0vBRrefiHwdiZ3yFRwb7dvf8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99eYEljMnpu8oU2RcvNYoaHX3mbTxFhlpj_qecEPpfXg&oe=6A467331"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6DiABEeb9MQ7kNvwHj6Tv4&_nc_oc=AdrN6aTC0TTWz8UyL4TxOAgb23WxGC0TLR0_MSdDpq_XTAYZCO6pWdvw-eAsDcfWN24&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97K59d2XpcIAzZUgCet2LSkXVBdLZrJwBUvMzTlOfpWA&oe=6A4688BA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Zo51aLugwQ7kNvwEbMCUU&_nc_oc=AdpZM0njD5MqJ80zyEFY1PUOX-P_FTrTSDhkY8NXuP11R2C9D-n_J0ihVL8frpYJwnY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mJhQgAVMYkZ3fN45UU_M2bARzrGlv0eHvKQtbfusp-Q&oe=6A4683A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmTrkm36dDEQ7kNvwGcxRjK&_nc_oc=AdqK7FkjS4RNNWEYVBTocHTN3DJgRTSbitRscIXe2PNFDjI-7nruiCTvKxL-zc3v-Zg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JMm0zPZpWBPQTeLrPKCfV7K9CLmBs5xPj6IX2L3qtxg&oe=6A466A3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQYSAguZMhEQ7kNvwG3mHFV&_nc_oc=Adpu30PPorCfse4o2hQln5qcRDMoIGr_D964lgMuIYVYZvdrLB9a55iv27Eb7KOoeVM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WP2Ecavmy_a4ZtH4wj05MTN0URqoaR9jdlqU0pUm58w&oe=6A46746B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo3NZf1a0m4Q7kNvwGiUfFG&_nc_oc=AdqHw8hhyWLY1lqjANcpF9VAy7gg10_-SG-Nl7w0EyB2-im9NVQeYdUvHWS_a5uxMXM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DZ8LHXRAx0BGS8gErsp0dWvPqKC2TsHcVoEIdcuG8aw&oe=6A467B53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_m
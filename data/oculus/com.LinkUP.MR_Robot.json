d=6e7a0a&_nc_ohc=dHxsOSKFHlgQ7kNvwG6qN-h&_nc_oc=AdpYm-22TKXbdjVgt58s1OFSUuiUbWb3ybd5d4tR1yiEHtM6zQnCA36SFBrOMn_PNTE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeHUwiv-ai4e6w_bagn8WK6fQ371qsAmOMpNKJqHTOtQ&oe=6AA5538F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3Zs11YUCjgQ7kNvwHngAxa&_nc_oc=AdpoEU1ep8yMZ1L-9W93YAG_cGBoNVvU_MxEJ699_APIURXw50rKYdlkhtkLzs_ugrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJonpeJ5cVkmx9cbWkTi63bs7aceK0JCIXo_nWo6x8mSw&oe=6AA55F31"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cir73nR3WI0Q7kNvwFojfY1&_nc_oc=AdqLg1ik33m60_e-wTzUSKMKzCNubguyxBF6bFOXQiIWMf7p48GkRU0NaDHzO_Gd2zY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwPN3I7DBo_diLUNWyd2BQ_vAVmhZSnSAHFikOp8IW1g&oe=6AA574BA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E6WHJwLLdgQ7kNvwFl7J3g&_nc_oc=AdobNhfoDIT9KrfBmMVzrR-oDa4ipHBTCSlgExQPCY8CFRgbPa0Fy2DL0OKmS1lss18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1sY00ZgVJG5afUCqPqv87ATxEZZZC4UGvDRYz9sUpGg&oe=6AA56FA2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMe_HwLiHRAQ7kNvwHoeeNX&_nc_oc=AdoVf17qhmJdhu7AlcbVQJZA7iLi1DcTBqfbyjZCClkJDmgtoyoPRayYlYoVYl1f1EY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLExylSA82gOubMXvwFKh14Zzf0SIMvJsndT4n3oY3Vwg&oe=6AA5563A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHHuiq_jx1EQ7kNvwEFehxM&_nc_oc=Adq1RQIJUj0L7iC7GlWRX-zSc0rX0NTtNP1hJ4ZaY6A27VqW4JtUxaqNqtoPRAZB__0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNfqIZoZJjJP5aREPjksfDKokAwus4mWzIKpf571Tk7Q&oe=6AA5606B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZIOcTw78vQQ7kNvwE01dHE&_nc_oc=Adqkp8mxzBnEQNgQWV0JwtXmGrBvN20znhfpjGqy1Ns0oOeta1lSUXzes1KhyTqslls&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGDCIPebb4IWerscdPpFLEPvaxsW7DwRgiXVWHC68KnQ&oe=6AA56753"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
d=6e7a0a&_nc_ohc=1CCkgRpk63kQ7kNvwHQS6Mq&_nc_oc=Adp62EZv-7WLNihSv7lBd2XrR73Mr6V3sDv394pbqIhdiOCg9DrwbWBumIVZana4bSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3naQBEf3X3folq3GMgBGijVFQuWAjvfjtf2vjv_JyHtQ&oe=69DB9E0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0XTjLqfHDMQ7kNvwHnGexw&_nc_oc=Adpc1SUC0GSr9GbpZnVoPHXgScTgCR4cYw3YBalhhcOlMiACblACJZe6hY-UwSfpDU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13c8AbRmwtG817UjZXBYYyLe2YcK9JLui-5H8n1vPcbw&oe=69DBA9B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OAmi2ECbvoQ7kNvwGOHOyN&_nc_oc=AdqQjDE9ulN5zXiZCUvXnTM-8Dy02XNYcr9iEwPCN9WyLZxQ5VkqBKOzG8tiwgk8cQo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Lib9f2-bcWkc48cljHt8XYblOwBhmL-shx73Ajxc0iw&oe=69DB86FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ0DdMX3iqgQ7kNvwHEcxM0&_nc_oc=AdrdnzQ9yhgq8SrU7IJONtf4WRzNP2FIU-wbqEmNpibMFCPkz46lw-mvMsQkau8yohU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZOD5WqvyaPsRSNDVuxF6CdXBAJ6DggJXwFIm3OeuAmQ&oe=69DB81E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkkcim4wyycQ7kNvwEzUZgV&_nc_oc=Adpag_Il28OC5OtBC43k4NczwA0s5dx0kl31jN62kL0un_4q_phNXnsyardSb2-Z2e4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bXyTwnq2uuRnwgXM9NABc_IOnOfsJYTqb5jCc8KUccQ&oe=69DBA0BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRt1dqk1CiQQ7kNvwHVlvlI&_nc_oc=AdoYZNZI1tjPjY-9_J9ZppAKblOpNsYSdkoI-T8n9nmSL2NKQy4hN0T2EyAZWVe7pTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i5E5KbzofZonDTWVULp09TEr_soTHzD8H36D2MO8VeA&oe=69DBAAEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BNVLnIvm7AQ7kNvwGsMMHG&_nc_oc=AdpqPRRVjV_dnrT9v09D37R65kX8XW4_4n7_OUUN-a3Wm9xy8ta2fBo_VfXJ99XowEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UgppUJpmo7l7j3WWytIczkk0UeVJUc2L6rQT5-nCEiw&oe=69DBB1D3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
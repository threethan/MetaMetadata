d=6e7a0a&_nc_ohc=nNFFAhec2dkQ7kNvwF3E7C2&_nc_oc=AdoLJvPlogd-MPUG6bOvJiT8DlrUH_ybOq8jI8Uzx8cVI7CHMMBXqoBEi5Ac6HIfX04&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCukISp9CfrC5aKqO6aUotIozNiYVkAu8KK-QxmYsAN3Q&oe=6A56398F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa3dCuDlIDsQ7kNvwFTdjv6&_nc_oc=AdrffX0dm12GdbU-qduIQSC59I2bpJ3uQnfKysKMg1LnFzQ85LJ3XUaKrvcpyn3FwvI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnTX_iPh6cqDu_a11ChqY20TJM-qISiBgdSwGnlj4Y9Q&oe=6A564531"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb6BbcKv0CAQ7kNvwGSsIfG&_nc_oc=AdrKxxQ4ih2lY6FYolu4RBHw3UHfoXpGnJKvqeX-papMGpSfzYd1fpLksIdPqsKiiaY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdXxptWbXo8z7B7oNUaI2uFexVAEbP4UwMdln4e1crvg&oe=6A565ABA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DgW0zJu5L4Q7kNvwFRdzT-&_nc_oc=Adp21rw216ED58PoRxS9J1msD8uD-hZE-s75pIoUkD8BZ3vnI3qvtvp_rmCralXyf2Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmWE-j66Eu54r--7Wd-PYk4miyfZUL-pARCxFozZExzQ&oe=6A5655A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzRBVeGJO3AQ7kNvwHxNSTM&_nc_oc=AdqPsQi4p68JSZP0Dt_5tfs8_duoQu46dH-2lDsiyICxyvsPL-QIlBPMpiGm3ejL65A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3WJzRGoYWQHSZzbThTGce209tU8CzSIqm_2jgpKp2qA&oe=6A563C3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIJlgIXIk5UQ7kNvwHhqR8n&_nc_oc=AdqPYkrz_ejYGEElxwCfCsVme3X8uY7ySk2hNmhmdash7iy5Tbw_EswOyK2EDTEZm_I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF0CCTBtHv4ltppOs7FhO5hHO-PTg8X9oPcCxFUM8Tpw&oe=6A56466B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMNdnqPxpAcQ7kNvwGTgblg&_nc_oc=Ado7DqXW0oc0DD4EqAXII62kCLvWt-uQBMsYtOUH54dJGlLUuNwMZ1-tKQdy_bemQ3w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr3nYbycs9xOPbgM2fytXA1wPILZlX3SWDwZYjHPGopA&oe=6A564D53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
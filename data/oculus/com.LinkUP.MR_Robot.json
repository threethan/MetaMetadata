d=6e7a0a&_nc_ohc=rDeyfCUGhmIQ7kNvwGyy1Ng&_nc_oc=AdqUzRBj5_sxaptmU6Qcy-D6SeSEt-DqBXcUOPQSVbAoVr1RvP0KYSQ6sWVeKW13ayo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bjjwGx201u2CmWBdkAYa9oJvFKNXk1HPrbj1bAlmqsQ&oe=6A3A8A0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUPvKJELuKMQ7kNvwFl6Lbd&_nc_oc=Adps32i6JFL4MkWrKtE-J99H-FEmDO776daxFjeXoL8qjURaxC_9saSqX_aJqHYHgTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SMu9bqhkKQugCWP_PehuOsbOf5b0I-zczpaLZGThkrw&oe=6A3A95B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKGOWN7DX-cQ7kNvwFvhCSi&_nc_oc=Adr5IrGkhbUEXsf10B_Zl98D6Sv2vF7K26v0gewBofN1EzCZ79Qo9gIK5r59jt4Pf0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FnzvA4y_v3-dcBkATmgMUdoBW1Hck6Eh7O3TmVZ1pZQ&oe=6A3AAB3A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNLYy0tltfYQ7kNvwEnVd14&_nc_oc=AdoWeZ_2eRhhsebDoCaQJjwoMjPeIc_A87bP0e2HTStdwtAyKc2TNFJCp-0QqW314Fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iR7Fqx8Hx0Z5OmmKm6RrKAC2Nv9P813lGl3foBOY5jQ&oe=6A3AA622"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi35hOwGVJ0Q7kNvwFewb1I&_nc_oc=AdocEAp4rTwY2FfP7f9boEbcPeSSlNN82k4vpDJlG7ASssdOrNPRE-txbjzLnYVXYgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KeWRu9oJvTVHbAVgu9mty4sGI34svWkJSlCtcN8oqMQ&oe=6A3A8CBA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwQXz2wqdGYQ7kNvwFhh2ui&_nc_oc=AdoxArzhYhH8O75MnI-MG2KyoTQ_5L3QfHWd3dtY-xx1teR76xaTbTN0S9yEuLPvzt4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I4OMCheTEHGSUAZbvGEydRXQsVoFeTZqxDeOaJT7Czw&oe=6A3A96EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03aXoM4LJyAQ7kNvwGk6g6k&_nc_oc=AdrHJRey2tnnnK08_iwwEFWsQrlVBYumaODc6U5eK2t5FQC19kcxIfStlNYm3tgHAYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZcoYOaeu4lFPdklOtRPJC28A_vGJeWARu-oNK9sde1Q&oe=6A3A9DD3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
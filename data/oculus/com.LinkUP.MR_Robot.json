5572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7eiEEvwuboQ7kNvwE3aIVz&_nc_oc=AdlaJqXEZE3tfYFu8zDbPL9zN70Y01lrBCp5TNOP2z_mZrtB81kXcSv7gFsz9EO8CGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuRqu0K2UXkEuG4g1a8ZigeyJ15Ua17zhUrJt8rif2DhQ&oe=69A44AB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJpEOLXVR_4Q7kNvwEgss5N&_nc_oc=AdmzrD-0Ke7WubNnlRPYsOTDxNbCl0Zs8jhresq0-YDMIMCbiM7oXqRb_Asr9ohbb8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftekC0LH_4ARTgqKRJFPlCCuxaZUaDS3Nw3npey6DyVNA&oe=69A427FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqgmfr8ZY7kQ7kNvwGnu6gb&_nc_oc=AdnDfkVOZwp7hSmZcFpgwlN_Kzd-p87GeFtaSbObV-gjpMlRgeGrrXzGRkxpMh3QYEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftdvrUbJZRQeR4ZmLOyHkxQ_Brsl5l5Ae3mZqZGALzFzg&oe=69A422E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDxRaLlkxDAQ7kNvwGYVEGC&_nc_oc=AdnG5yD6ghdXvxniC6Wr3rnWMO6RIx8Hp8vvXxgs9Cr17TtN6q5pWl38IzBsAzwHU1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftqxXKU0SUfOKvoixrlG96CrcTAW2xARj5TASPqC9kUsg&oe=69A441BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5rtPlmi_0oQ7kNvwGjVtOD&_nc_oc=AdkHHDaWrSoQ5RJDiFzV0894zT6qvSyST-MjpKIpNYXRTKl0oGIlNY7rPRLclPfNGkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvHfQNs_nc1xyfAekT16NhM01uGef7gavlHuhtvlQSC1g&oe=69A44BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TamQzr3kp5EQ7kNvwHJdHDA&_nc_oc=Adk-bwDb43kqm5Hea0ylYi_34YA4GqVAcE-lMBvZpvOW4RCecRL9ZhzBSElfUw5plb4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuY-i9oZh2DcmI57W7_ksHX_o41OJG85byL2Qgq4aE8tA&oe=69A41A93"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974804_858150846172189_3684137377628731728_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8uUkynnb8AQ7kNvwErDbPM&_nc_oc=AdlfMWnsZoTMXpknyGuZlcD-dXRLIrghosav2X5AnLuGQ-vSvovfcTn-Hn-odSH4Z_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&
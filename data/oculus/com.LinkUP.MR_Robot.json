d=6e7a0a&_nc_ohc=b_TS7_g8rM0Q7kNvwGvNJyH&_nc_oc=AdrCzAvXZlgGe6FtZPptVNRXe3plkdMuA1USGbwBOyBt164MQJf1WvkhFlaC9TRyBbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Swm7o2ZYvc3EWSl8VrCcaAziwpi6q7hJPXdxxW_uPA&oe=69C2918F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y97kkMW23KcQ7kNvwFsuyqi&_nc_oc=AdpMQRxco1EsSYz49vxTdq3AEX9jKR8QkJVDER3NItDAbses3samVXZfAmk4pwQZl5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt_QJgCf_h8QEYqiqklzFWjrIFR3WkzD7Uw3bCidQisA&oe=69C29D31"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzvcAe9bExQQ7kNvwGNkXLh&_nc_oc=Adp50lqKVJ57PrWP8b4CWXiLvmatdoC0A80ykuSaBnM6v92oVe0dTRkq-82--WwRTOs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwsajk5ezaqrWhzcBNgbjtaRn8Fap2lP76TJ9QAW0Q3Mg&oe=69C27A7A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyNaJxPjIxMQ7kNvwHG92gY&_nc_oc=AdpJ1tc9-2tRJdhqMkFdQUuXIEq1k5eXLl2K6tvxHSTQJOYYlmCA0Vsc_ZkkDb5A9fw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAIZ-fFYm4E455_fh2SORPvP6cIap-bdEZEe1AzGoEdA&oe=69C27562"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADdPbgdJk9AQ7kNvwEQSFWJ&_nc_oc=AdqH_JNcPi9acW_SV6v1MDymwEzUKWkecAmx8oCyACvQn0l_VM0XpKw0qTJQ5xvC7mo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxjc_XnkUW0Gc3HL4EKc0HiQas-BP086sJjJV4tkNbvZA&oe=69C2943A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOcekmuwqb0Q7kNvwEck88c&_nc_oc=Adp0H5EiTFbVauFzHYVYq7R5MVzM3JHksiyBCKgBpLfaNnpq0vE1GhiSWWNwM0wtRUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afze6Yp148s4YG2mmtHxQx_KTzxXdRzxcBYYbNoybe1QwQ&oe=69C29E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifOWZjN45c4Q7kNvwHTwm5q&_nc_oc=Ado6AUMKZQYtTKHBbBtEI4C_wnpRYqiJKNmrmIui9U-7vdkjUmVo2YtvfkWnPtzsS8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSf3ldbsG6gnqrGHv5u4gV9t7pLrew6HgVdXvdhVGoww&oe=69C26D13"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
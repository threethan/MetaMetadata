1"}, {"file_name": "7-2560x1440.png", "id": "716822943752950", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_716822947086283_1869577383315148904_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpg5lXFrqycQ7kNvwHy1ddl&_nc_oc=Adn_b1QzZQunNYNWWFjMldf4aG_RhSy3AuQ9jQ45OHfU9vcWJ2Zika0-fRToGEiwMwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa0i16I1ZN-F-Hk5xGpMUiQ2aB1I7o0d6y6Lft3S719A&oe=69B80E7F"}, {"file_name": "1-2560x1440.png", "id": "1104252097450091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86621346_1104252100783424_7805917123927614755_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bJfGM5mW2gQ7kNvwG1D39c&_nc_oc=AdkbkRUmm7KlYM2Dew5MohOh0GQ0IfPygZFhSLKK83HS_niKOt_5uLf8HKBHa4OcNio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUsRSKDdlqAINRCMnn0fgZlKRrsdHZAWmZxA66a0oOtg&oe=69B7E957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2-ch.png", "id": "452173130738280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75451775_452173134071613_7808722370978480706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-MLCHMBoq4Q7kNvwHnvu1A&_nc_oc=Adnqf9VsdW5fshvbP-j1CS-dt7CQhB1McPNT4C4i9rqqOEnXI_HXYAGk1rpMouzW7Y8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnId461nDuyLNoMsgBMPyGPPWNzO9Os9LSLhktrKobAw&oe=69B8092D"}, "display_name": "\u4ed3\u9f20\u8fd0\u8f93\u516c\u53f8", "keywords": [], "long_description": "\u6b22\u8fce\u6765\u5230\u300a\u4ed3\u9f20\u8fd0\u8f93\u516c\u53f8\u300b\uff01\u8fd9\u662f\u4e00\u6b3e\u652f\u6301\u201c\u6df7\u5408\u73b0\u5b9e\u201d\u7684\u7269\u7406\u5efa\u9020\u6e38\u620f\u3002\n\u5728\u8fd9\u91cc\uff0c\u4f60\u9700\u8981\u8fd0\u7528\u521b\u610f\u548c\u903b\u8f91\uff0c\u8bbe\u8ba1\u3001\u5efa\u9020\u5404\u79cd\u88c5\u7f6e\uff0c\u5e76\u4e3a\u5b83\u4eec\u8fdb\u884c\u81ea\u52a8\u5316\u7f16\u7a0b\uff01\n\n# \u521b\u610f\u548c\u903b\u8f91\uff01\n- \u57fa\u4e8e\u7269\u7406\u539f\u5219\u548c\u903b\u8f91\u6027\uff0c\u601d\u8003\u5982\u4f55\u514b\u670d\u969c\u788d\u548c\u6311\u6218\uff0c\u4ee5\u5e2e\u52a9\u4ed3\u9f20\u4eec\u66f4\u6709\u6548\u7387\u5730\u8fd0\u8f93\u8d27\u7269\uff01\n{832086222101730}\n\n# \u79ef\u6728\u62fc\u88c5\n- \u4f7f\u752860\u591a\u79cd\u53ef\u62fc\u88c5\u79ef\u6728\uff0c\u8bbe\u8ba1\u548c\u6784\u5efa\u5404\u79cd\u8bbe\u5907\u4ee5\u5e2e\u52a9\u4ed3\u9f20\u8fd0\u8f93\u3002\u5176\u4e2d\u5305\u62ec20\u591a\u79cd\u5177\u6709\u7279\u6b8a\u529f\u80fd\u7684\u79ef\u6728\uff0c\u4f8b\u5982\u8d85\u58f0\u6ce2\u4f20\u611f\u5668\u3001\u76f4\u6d41\u7535\u673a\u548c\u96f7\u8fbe\u7b49\u3002\n{1110611966838683}\n\n# \u56fe\u5f62\u5316\u7f16\u7a0b\n- \u8d85\u7ea7\u7b80\u5355\u7684\u56fe\u5f62\u5316\u7f16\u7a0b\uff0c\u8ba9\u4f60\u7684\u521b\u9020\u7269\u201c\u52a8\u201d\u8d77\u6765\u3002\n{7727642343959558}\n\n# \u63a2\u7d226\u5927\u4e3b\u9898\n- \u5728\u5173\u5361\u6a21\u5f0f\u4e2d\u4f60\u5c06\u63a2\u7d22\uff1a\u4e1c\u90e8\u68ee\u6797\u3001\u81ea\u52a8\u5316\u5de5\u5382\u3001\u897f\u90e8\u6208\u58c1\u3001\u9633\u5149\u6d77\u5cb8\u3001\u706b\u5c71\u96a7\u9053\u548c\u5317\u90e8\u96ea\u539f\u3002\n- \u800c\u968f\u7740\u8fdb\u5ea6\u7684\u63a8\u8fdb\uff0c\u4f60\u7684\u4ed3\u9f20\u516c\u53f8\u5c06\u4e0d\u65ad\u53d1\u5c55\u58ee\u5927\uff0c\u4ece\u800c\u89e3\u9501\u66f4\u591a\u65b0\u7684\u8d44\u6e90\u548c\u6311\u6218\u3002\n\n# \u4eab\u53d7\u6c99\u76d2\u6a21\u5f0f\uff01\n- \u4f7f\u7528\u5df2\u89e3\u9501\u7684\u8d44\u6e90\uff0c\u81ea\u7531\u62fc\u88c5\u548c\u7f16\u7a0b\uff0c\u4e0d\u9650\u79ef\u6728\u6570\u91cf\uff01\n{1158778315136178}\n\n# \u6df7\u5408\u73b0\u5b9e\uff1a\u548c\u771f\u5b9e\u4e16\u754c\u4e92\u52a8\uff01\n\n\u8ba9\u4f60\u7684\u521b\u9020\u7269\u8fdb\u5165\u73b0\u5b9e\u4e16\u754c\uff0c\u5c06\u6574\u4e2a\u623f\u95f4\u6253\u9020\u6210\u4e00\u4e2a\u5c5e\u4e8e\u4f60\u81ea\u5df1\u7684\u68a6\u60f3\u4e50\u56ed\uff01\n\u6bd4\u5982\u4f60\u53ef\u4ee5\uff1a\n- \u62fc\u88c5\uff1a\u5728\u771f\u5b9e\u7684\u684c\u5b50\u4e0a\u62fc\u88c5\u79ef\u6728\u3002\n- \u81ea\u5b9a\u4e49\u5730\u5f62\uff1a\u4f7f\u7528
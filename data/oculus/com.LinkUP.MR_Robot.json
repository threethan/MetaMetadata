d=6e7a0a&_nc_ohc=k0k0OoZNdo0Q7kNvwGHnpse&_nc_oc=AdoP76lt88j-fnpPye_7yRfmAKawGvGoyvHPma_xk0oAIp0VBTLqxsml2clhOJEFpjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtdD_25AgMPTYrnWhrLMbVBGFf94SSUnpUsqzDDRpyGg&oe=6A5CD10F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cipzUogy3dIQ7kNvwFm0BMm&_nc_oc=AdpuMKatHPAVmekA-qUUxn89D-0-6I3APPFdtmGlB2MWNL0ybH4hcyGwpqnSm4BwX0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuAG-tRP-79N1iTDWEgwc5_-9CLG8Gc-hSidhsg0hFeA&oe=6A5CDCB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82lzwk7dwYYQ7kNvwGToqXn&_nc_oc=Adox79jxnAJsP3ELJS4y7COa45p5cna8I55ZVBqYes38POP3eTDa2tsi1wWYAni5j0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8jJHiVflSlu1Im_XWexVMKaCukGkIhtx_VAE-ppwUvA&oe=6A5CB9FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDTki5n1ZScQ7kNvwEtUHAa&_nc_oc=Adrx9Ghylp3vRCzgLR6nLfDkG-qKw10W-RxA3miv01wadWsiiETdWwRA1jAwIGkkaY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDGd4xXuYETDuPSfKMe24lBLSMyY4IbCtFxcCnt06_MQ&oe=6A5CB4E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYXJW0BrMbQQ7kNvwEZ4w3X&_nc_oc=AdoNnIZrvb0FDqyNpW5qVxVha8VkchZ7DFWx5LqjDwhz5PPHolNe5uBpGPzSJem9fxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFvIt5FAatPVNFEVJrU2067f7Slxq8eQBAgDiWMnU1AA&oe=6A5CD3BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfiaLPea9AYQ7kNvwFKr-bX&_nc_oc=Adpo1SmBJPlAto7FBHcFFQx9DrVAGx3BNhNSe1p-dEZBiljx7sx5QK5ZYVtYY6VMpPI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW0AY-Cs4Ilr0ErsrwIJBjbSSXsyvLKGZRwDbb08pzIQ&oe=6A5CDDEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP2NFMGsmC8Q7kNvwG0Ugxk&_nc_oc=AdqXzJauGnuwGrCS2C7efxZXjccXTcFGzORIQZ1SCsYLFTKCc4YiI8Dhfo4p2XApwR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACchC0GFNB3TiBFf4Is0etZvoIE__LX3dstpREevcklw&oe=6A5CE4D3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
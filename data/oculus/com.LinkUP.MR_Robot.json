d=6e7a0a&_nc_ohc=1CCkgRpk63kQ7kNvwFOQsJa&_nc_oc=Adot_qCOpekaf_MFqFpscTaESoSm7VlpWZ8Fd41FWb7IIiafVjrWwtdzDnEx-DhLvI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TrivZEASrA1ptMBq4aIm3XX-kwETiQkB9PX3ve6kJeQ&oe=69DA4C8F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0XTjLqfHDMQ7kNvwHJhQqR&_nc_oc=AdpMhW6lugqiNhp7uFFqf8PqxOuIM4X5_NV6qN1dX2pStlhmY15Y776OhME2fcXOc54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qN4O6SghJ3g0FLSLOVTAaUisA8BEKbOg03T0sTMjznQ&oe=69DA5831"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96cZpB7c3ZYQ7kNvwEiNB6J&_nc_oc=AdpmTpR-u_E004YdRrLIdw1wKvbFlDuqmW-v3ilHmEfS5rxfOQtkCwFwSivVltwiUy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30pWf17-7zwD0XARfJTjlXaibUrTh3ScHQt2xu0VgDWQ&oe=69DA357A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ0DdMX3iqgQ7kNvwHly_ZV&_nc_oc=Adoy3htmoRgLRghEcQisSDBzEt7t-gmwvfYeVWHOI2P_pg9O0srox0aq_1I0FNGI9PI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lCr26hYVDTMzsEVxxHKJ7oJp4gTdu8j-MLT0MJZyXTw&oe=69DA3062"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kkkcim4wyycQ7kNvwFm7OeY&_nc_oc=Adovciln0Frg7mubS_rNUE5T1A1vZrMenjg_UuGxz3DHFgrHXVApcxRwAXEhAhEIf1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2C1G39hw9v9WUuDMlDUQF2RC-QSyAbbV-5NmBevyruTQ&oe=69DA4F3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jBLXzOiNkkQ7kNvwFOa2l6&_nc_oc=AdpvrLgE5jvfdu4alKcbgd9RmhqLvscX6eU0mqjCQ4j3h6Z1jSyQkDm3ezxGKBXXW7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1izChcSijpLgiU4Jo5yQ-IfQ9ooeE0BP6WgIZS9Kt7sQ&oe=69DA596B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi8FtcDvJYgQ7kNvwE65Cu5&_nc_oc=Adq9Sh5wUgW3bpfdzY58afqdi6nBDKXFplLdOUCA9aoNbtwdRkGpLGP3R--gUu6L73U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1M14H9h5iheawK3SPxN_1IyvAAbQX2YhlYU66H4ZA0xg&oe=69DA6053"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
d=6e7a0a&_nc_ohc=C4LSM_dW4RkQ7kNvwFwfJMn&_nc_oc=Adprza8qYZNtth0EfUeP1PtgMVML_ZW5X8ATFh6ptbcdc_T5GDAhTPHflr5uL1EnsuE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JjrpPV56tSmGGGq_0Z0YMjRmYW9tvcrug15E2mHtEvg&oe=6A26C38F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs8tqhxVRi4Q7kNvwEVPMpl&_nc_oc=AdrDQ663uXORJ2Sp9-h1JZ-Lwi_LM7s1Uk0YIK9Cl8ac7Kq6lgYaQ8_XaAPLHg2Uaws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nfogNrKE5941dQ1p00QMVvdqAWy9OwUVIgmqgutv3Sg&oe=6A26CF31"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5gqSZoJTwIQ7kNvwFFmW_N&_nc_oc=Adouo8zg_8tvYUm5jjlCt9zi988iOMPuNJ6CYSFWj_5CabiXe6C3TX1LrWTCf-C2kYg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SsyZA8nap1E38LqlZyhySMCeRH_18FOMFrH97sx0BGQ&oe=6A26E4BA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGPmXdz-JuUQ7kNvwEHaI2s&_nc_oc=AdoEFf_8LafhHrMporqBwdlA5Wh1ZWkUcC6frAbHvZBeeocunsy6dy1XN0WEhgGIgEg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xliAz_vck_nArxKNoc_WRzjP8gaqY28Jo-M91hUcqNQ&oe=6A26DFA2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZAGQHODviMQ7kNvwGQZnCa&_nc_oc=AdoCH8FxvNsIR00SOAkXiHZhQq0bCy-utatSD5PUsvYJoLijsNNmXunv5qzZmok0BWU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VIRT0q9xjfxNg1ykcoB78s4bJmR-3MW009RJCgLiJ1A&oe=6A26C63A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEjgmrHPW4oQ7kNvwGoPQJ4&_nc_oc=AdpJl0LhWPLee0z3v2GX8DFDKaOIQUxNVFZjJ-Cxhfkwa_vr6JzyIoComK6wRBstcA4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gHRou6E2yXZUlU0m47HbUrt5iU135c0uAQhBnbH0Xsg&oe=6A26D06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3GqK4QfNNUQ7kNvwFVlOJK&_nc_oc=AdoMbfWDDJAft2IIDX85X7gKLEZBBSWYm8bEuthrqsXGao26MsmDKgTvTCIYavdKf1o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HPwySnPuY0-A-5GJaKXdSxX4_xLx93uaY8tTXNVBI7Q&oe=6A26D753"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
d=6e7a0a&_nc_ohc=t-caWFA50Y8Q7kNvwETWVpX&_nc_oc=AdqU6lzaSMJIXGQyGscIi7rnXE6j8kOUdEB9pa9PyOYlUljR6C2vmmuw37yIZipxUBo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoEvCommjNnx-75lHwVsP28fXyk5hX-STGBMrco3sxDA&oe=69C6860F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmvflxVgDT4Q7kNvwFJFz5y&_nc_oc=Adqt_FgrjAxI0swBO0aGE4r6t-kgYou414EQt3eAkePYA5rkoRzg15OiZ78snR1Qo9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9YXGYx8Kx0KTHWMSHvijYw_PBTczsZkUjolUsEROl0g&oe=69C691B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTR8g_eJof8Q7kNvwFGWuX6&_nc_oc=AdoDyhak_y1TctCSI22bmJCz8JRwpj6uEl4mBmSsnR_xODiuvBjAZiEnTfMx7Uw_Xyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwywu023rzsZzx6FGFSvZwB3ZPxrCc3gKXyz54warlYSQ&oe=69C66EFA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KWOmQGCFRQQ7kNvwF9je4X&_nc_oc=AdqI9J1MU7ymsymTQHPM-0OWGej3XCTQIOckWWLqsq7QGlLm8ietwhIFOLUGWhsK7VQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzkdaux-X5usnQsDze0-08pOEVool7vMLcp9PdHwhs-JQ&oe=69C669E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMeIHGCCuaEQ7kNvwFmVl5s&_nc_oc=AdqvhQzj2a-hgAj1ERGp7DIJkgfq07OKu4e3jlIORbBMTabw_WM2tRnctCJJXWDvCog&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytWeTjK6i8XxcECLpABEwsm5Or3E5YjO-cokISYohWhw&oe=69C688BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Bcmjwesu6MQ7kNvwG1mGAC&_nc_oc=AdqCCpsR7-aKc38M2M3yeI4qJ6b-EbxGbrDPYDE8chBqm5RYpYTI1UCyJ7eXPfacBFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwt_aKK-cNMPuL3ApQKnePFq20qv12SJqE3g4blHV5QNQ&oe=69C692EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7lpAJcLKsAQ7kNvwHllwir&_nc_oc=AdqiNAdwrx27bJ-vl1i5KHr9CGaEtO3isO2aYCHFb8YINocQIqIugtJjc3RdzV9W5gg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwp_soh9DIDqZrpqsXa-soBwOdVlP7qtewQ--s_cWreHg&oe=69C66193"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
MOaDUVj-nWezy9zA&oe=6A3954A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi35hOwGVJ0Q7kNvwGfIFj4&_nc_oc=AdqV_aluaRPs2XNfav3eSkjQqtgK-p37h-tN1mdfLahHzBUH1E8vPF7ENxL4dhP7XLs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nUmRjU-5P7bele0tYMO3_o4ARy3S-TdNkFBVbAh5TTg&oe=6A393B3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRDdZaiCTMkQ7kNvwF7zUqo&_nc_oc=AdqkcwwMzdZXrgOVRZG_OSfu-xqcuMl-V96DsSqN90_2HXYZ8MKAJcsskdFtRHeAv3g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83W2j0Kz8pCw7QQFQy85Z-NHp3ZztdU2_mIPTKUFNylQ&oe=6A39456B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4YQZ_fXe_UQ7kNvwFlHAYt&_nc_oc=AdruA0MP-LninoVyJutTXEPseZ6zAoFNfG4L5Kxn9gr-_CKkMx5TynbevdLy8N5ehzU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ls30mWKq75sBgDVkjrhnjl9EEsliMubJnwP1NXwgRhA&oe=6A39410F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=if1Gj5dkiUcQ7kNvwHeqoB9&_nc_oc=Adr2-BN66Jtr5_WklRXtlJTmadotn-5GfgochPz_6u2nFW3m9keRWZAQgFU-9arb5js&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XdRJHZAOXLyI3zsfGtXnpxrcABesQ2cgbpIBMsf1VrA&oe=6A393D59"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.
d=6e7a0a&_nc_ohc=xlc13HdxLcsQ7kNvwHOPqhR&_nc_oc=AdpWhzzt-b8PDehdE1OIOTggolgBw0H1Ont9h1SsZwiAVs9fGMJRgS6tyBM82zaxFcg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEBmWYDlYflB3DYlrEbaVAmB9CHiAqImIZ7YuBPQlkQg&oe=69D1120F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIdLsVVSWIgQ7kNvwFrlNe0&_nc_oc=AdplKl45EouqzLYozTBUKcRRuRw4vdKdP4f9kFt-_Cx7pzhh5E_hAl4sC5-g1OW1xLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvE60UNBUuvkXTPaAKklsKadrcMr-l0ImqMMMAQ_pOFQ&oe=69D11DB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvc_Po4WPEIQ7kNvwHlE8kC&_nc_oc=AdqLaliGreCet3Ohel2WuShD5IQBnvgZu3G1SMi_u1WZm002M2X0_h1g9l-1Omf4PTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztQE66NbruktTB83OnVnyHQdPO2OvRVA2yJ-MHw1jwcw&oe=69D0FAFA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gTPuSAspUgQ7kNvwEnln9j&_nc_oc=Adqh403sYOrxABjfjy0ZykBd4z3YN2wAB4YK64AhFk_YjAW6lIYL3gorsbE0DdviZps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS1Hw0P2w45jOvZ3N4ELjdhRr5V04F4o5z3zZvYRgWRw&oe=69D0F5E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ntDmnqj1NkQ7kNvwGmQDnp&_nc_oc=AdoBZX3CEgSYDgKiAbnlszFAuPc4t4mUVAQ-ISAlDih0W31RIBh4fAp_Sv1o0PNT0jg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxbSTrc0PfOfcFgHnlw6to4tHiOpmeDo3hHV6Z49pNTtg&oe=69D114BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INUshP9nKqwQ7kNvwE-E7Rb&_nc_oc=AdrA2u6eX7yJnnrSVcCkIBa0T9i-uU2Y6nOqwAYknPBt0Otyzm1Fl6fUpdEtus0S7QU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxaKR7Z5a7AibCD9z0XW6DGFnPRJCHllEcuqrJLNxkeXQ&oe=69D11EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XhRRgwd8zIQ7kNvwF57YJx&_nc_oc=AdqqziblihOl9CX2_WFYEO0n7HIzzsBL910JBTGZVPAZKkWw6eNcBes10-UR5iUMiz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCAGD6uS3fxC9cxKlR0k3ApKufhwbG20IOPW0oA9Utww&oe=69D0ED93"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
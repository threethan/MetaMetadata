5572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5jhjXSpE1cQ7kNvwER-Gw1&_nc_oc=AdlUkp7IrvVSqsh0NQml5SHOuNFVaqHTo9L5zKregVTCZPgDSPRBfG2sZKHcaW9W4JE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0vkejwnziBqRD0oheqXjVWkaY0sV3Z4XqeVVd9bshVQ&oe=69A05631"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WmGkobCd5gQ7kNvwEbBiu1&_nc_oc=AdnwyWbR3MbvLHFa3skziY8MQWPGjz3Xg6sUBK0V9y1JVVeY8p_8QhkgQ2zoOL2I9lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMqfmtO8QvXwm0lpMgN3u7TigxurlPZlWSM69-ZVNuKw&oe=69A0337A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WB-lB3Tb9YgQ7kNvwFLqu5n&_nc_oc=AdmoPZw9e_P8dFxPFvFmBpsIay_RJ18wdMG2I7BozK5NjT3sjqV5WF6iG4SjeaWE3Wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuuajy8IStRlKcZf7u9J_uX7zG6mKWngsnyZlTYJOJf6g&oe=69A02E62"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87xs_GRC3eAQ7kNvwEprO1I&_nc_oc=AdnQoolrjSBGdHBDhg9GoBmbH-nbq_yjTbXlxguNDfy46YDFoObus5Nu1gcxREv2EtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvI4eC1dVUxYGhbS5_lvDXpek7QQboLmcw8v7Cn4LbXgQ&oe=69A04D3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzJKpxtY2xsQ7kNvwGu7cQe&_nc_oc=AdnfLZ-7jne92QPHImo_ZmtDAj4mN9fclD449GSgyhZLuW_tZnxAR7wFQiCTidwGNfo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu-1TOoRdTQWFLBJQsdiPqkrtlzUq9G60MdZyyCRCNzRQ&oe=69A0576B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWBEfDx9Uo4Q7kNvwE01CHA&_nc_oc=AdnB9l-lwWYPyLnX45CqNeAqckFFr1TvIGhS-4ckFIgIp95pksPL0UTc17DrQO6WKXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYiwtAQVC18j4JAvDhpCEnCX5UlobPKXSFgJlCLBOv6A&oe=69A02613"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974804_858150846172189_3684137377628731728_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9a46mi8UFUQ7kNvwEAvt66&_nc_oc=AdnKGDcDbDK5L2QgJHUIREZCPFpL5tVwvKdwHDT7K_R7W7MPzSxFUpYO_iW0xRsKhaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&
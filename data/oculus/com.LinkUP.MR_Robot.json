name": "\u6d77\u62a51080x360\u5907\u90097+\u624b.png", "id": "824648603043255", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75195902_824648606376588_6298033056542748118_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVdDIsVoE8sQ7kNvwFW23HU&_nc_oc=Adnw9v4kaCYGVBupae-woDcvGRmaEii82RPueUPb2NFY-MXSvFJcZ9dlieIMg6VybfQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuyq93qWoX1KhraMLLkUz2PmeLBu6-AfyvgNJbUtm9XGQ&oe=69A8158F"}]}, "id": "1382466938967099", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpshDHkHyTcQ7kNvwGIYCIL&_nc_oc=Adk_-vH244hy9PdAZnoyonKRm_X73jHi9t8BAs0mWBETG-UvUOZwbGaCjdVs750NX-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv8GrO2aYrATArLL9n9nFSwB7HQvV_AuZ95lstHBlJUlA&oe=69A83F31"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-DJ3ih0JOIQ7kNvwFZ7VnJ&_nc_oc=AdlbvqtDm_FepIKqhVEV5_3kWw_eZ7Zkaav5L2-fl6dadIRvYcD1s1ZQ87--S-NQWIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvxRSFJ6vkUMA_5mypLviostTEFQFtSt41RLv-3XWBsrA&oe=69A81C7A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cygr_qL5ZE0Q7kNvwGbI013&_nc_oc=AdmegKZwfoy_hWEPvabszIlyCgW0LXHZBpUdLVv5lKRP3F00Sl9xME8yncVrZC7hfCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftL7T8JbfN6RVIOYlu8sTe7XBUche3E1FwUmXfAmyetng&oe=69A81762"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtqOMQMkElYQ7kNvwE7qiRi&_nc_oc=AdlVCD2XUAEVj6xUSUVblWy8aBMqwr_8Gv0pirW4KQEu1lqG5jScs9taP5FhR3Y2ofs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuxHV7UilMWEVU5AxJgdeBdZ64fs7t7LR3P5YCcnCfijg&oe=69A8363A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhE70-bCEM8Q7kNvwFGXDbR&_nc_oc=AdkNRVxFvAWnyHUOzqlFqgluM39Y9MaZvZA3gROfFMMh7vuHmMyQ9ahtfWclskA6alw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftr_4K2ZU4W-bMdOQlx04CBI_hEnG1sG2D-02ihKKcxmw&oe=69A8406B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1-svvkGPfoQ7kNvwENWvjn&_nc_oc=Adl9uhAPM2fJaHVPbkueEgmQdTw6zE7BjXtw22woZyfsuff2Ds0Rd0MoMhc-Pf8A8T0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftnowJ18AOH0R4N9FZFk7JnLcqp_M5nQSdyF03J8EE4Hg&oe=69A83C0F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1D0jovcB_EQ7kNvwHXCCV-&_nc_oc=AdnwcGZhYE3kG7ypJgFnr3anIOfN1Qc-IA4JqxyvynEnKBy4m0Ax4LKPs9WxxotEGNA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvjQ27xSeFXV_2AeZTpe9OVo4CuqvQVj5PGV5e9EWhT3w&oe=69A83859"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_4c8QJj2j8Q7kNvwGfiDro&_nc_oc=Adkxv7z9s0E1OJotBVh7I-x3b8xixDJGjlXLTYdiPOjQ
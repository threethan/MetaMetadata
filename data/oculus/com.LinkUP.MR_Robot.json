d=6e7a0a&_nc_ohc=NbQmnkfzzS0Q7kNvwFYCGcg&_nc_oc=Adr-0Ge5ienRmjJpbFf-70uQrT94MbcNbzFsmB_BkyhiR-23XdZ5_ubLSpg_6KLO9sc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWyW5UhGZCQ_-AscJsAuV8E0EzopMF4l5uVfIuPOo0lQ&oe=6AC4F78F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0TFTgSlVDwQ7kNvwFuIPnO&_nc_oc=AdrA_1A2c4pnJ5AzguFsy7V5bYs116mkIL5-de7rQZNUzpSg0IpvTVOcAHWkLlg3PFI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn0y1MNwCAFpbUoUNROk90Lt_5dtO7oTCf1UgCvxcg3A&oe=6AC50331"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6yjWXq5cJcQ7kNvwF2qeA9&_nc_oc=AdrYfhgG5_MFbGPbGM7kXdx-pe3E0KuC0PP7r2GV6UYDz2hBR4niD2znzLZcyeEwdxQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFLmSI171VqiNAdKg5AefYuF1WY429v-hBelNY_bGwA&oe=6AC518BA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHvKCes60KQQ7kNvwG4Dv0H&_nc_oc=AdoEtFesrHCN2oyrkFvr4ZJFbYlfAM4GfcI_zZe_tTPeVp6IKQ3wumrWUcRZCr2q5VM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeufew_kE0268EhPLd0BhvCTsvgqMIkL1JROL7HIdTJA&oe=6AC513A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xd4TeMKttlsQ7kNvwGU_NJi&_nc_oc=AdoCU8DiLnv71blr84Bwr6FmPTcuOfl222icWynDaZZlJV5DLpT-hhIGgGLM2gnVSvg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaWbg605jDcJ19IGdWphqPvxuZPjTri0AZ0WIi3kwbOA&oe=6AC4FA3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVwshGh5j7wQ7kNvwGtosls&_nc_oc=AdpxNrwS9jD3tuxzt4F_EV95s8Bq_9DH-UzW6uSMu0XL-KkxUkJFz5whIzIUeETZ2aA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGbcbiQirUwEH0kwwym1WVnDi58B3nbLPtGLK5HRemVA&oe=6AC5046B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DneVbr71e_MQ7kNvwENlSVi&_nc_oc=Adp0WelmSp_UKy2MfPB9FsScCNJDjAc5sP9dz_f7SuX6DJ3qFmWdNIFUzFyuFaFSpn4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIK8E5TOJmdNLZSa2lFVs5tzAcb7eSk9W63lz4Bm9Log&oe=6AC50B53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
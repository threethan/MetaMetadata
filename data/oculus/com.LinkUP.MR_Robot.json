8xZB2Bx_6bAuWVWNRTDg&oe=6B0DBDF1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrJJW9viVm8Q7kNvwGIbo0y&_nc_oc=AdoS2NepK0Xs81tZkHNsipS8G-JMvI0z8oPRZ-AFc39tnwfnlZm89tyIxAAIO_n5AsY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBvyEGj4_d7mY6OF6SB2pRD3aly5RKw00H0aKVrusTPQ&oe=6B0D9B3A"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7ZrwfRLUQcQ7kNvwG3JY8x&_nc_oc=AdrDTCfb_pxoYUtTl8aWJcGbsUVDX1iTlDRVNuJS68a3BBazOqmIy8_reQbmgmezrCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSy_Z8_UAzmnK0GHOQ31f6q2am6iNojwmNyZOPk4Kd9Gw&oe=6B0DCE62"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zcr1YoZb38Q7kNvwGo3HBh&_nc_oc=AdrcIPX6aYS48NlZAJiM0fg-IgW8QiNcPxHXhrhtvARvfP8g6k8SHPXd8aTiwsNrDRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSivSn9Z4TdVsJVEWPtRhPNiSPl1MorVOBpAWf6PtNwRg&oe=6B0DB4FA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP4TgThcjqEQ7kNvwEiHoT3&_nc_oc=AdqORtZEPG5fbwJHIyC7X2o4qaRZUpA6Xlgv0oXNre1FvppYPFefefUKGeUG8SQTcjs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSLSv5Qn3MXXV8mx4YfD4NvtU2kFSxLrfHvObQtg8NUg&oe=6B0DBF2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IaMlTejjGMQ7kNvwHlr-Ba&_nc_oc=Ado0-TrSO8tBq5JXSfrdpnCJRUQYTeKo2LkXVcJjm5lOnB0OfMj0DnGw0caVG2PncsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMdY0s8TM1yDGezKQyy831ed4UjjnrOxgVXH16xO-_Wg&oe=6B0DBACF"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmn-bSfd4MkQ7kNvwH4sx6v&_nc_oc=AdqRd3cO0jzeAH-fNS7uH1druV3gC1xhezeIB15imP5QJJrPZYbeze-68KyoxqCJ6no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqqG7yDPX4jVC99H0Te5_4Jxe5frZly_9N3PuzREekhQ&oe=6B0DB719"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8WKDNi003sQ7kNvwEPmY8v&_nc_oc=AdrOl_PyIjsd1LpKRHvTZ57A8fc92eh19miAJW7fn117TKGEs8SUmR3dlHU9qUmEdLc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROss_AvJhc-po11mzpjnZfN-mwodqClXZNZRDZ38YAVw&oe=6B0D9F8D"}, {"file_name": "hamster inc._logo_ch.png", "id": "857711756373822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476756_857711759707155_7542117578876813577_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SreKBorBt0Q7kNvwErIFrT&_nc_oc=AdqlMH4PeomtlDRJ5f-vUqg_g_VHanno-UdADkiTlwwue15snM6UjTRSmcYLybB5P8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlTuGO23yHOoQU_iwmJXTGJsSZnYzXt5i7_Z4zVEGq7A&oe=6B0DA215"}, {"file_name": "\u6d77\u62a53000x900\u5907\u90094-2+logo-\u4e2d\u6587.png", "id
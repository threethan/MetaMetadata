d=6e7a0a&_nc_ohc=sXAisT_C3MQQ7kNvwEvDCyw&_nc_oc=AdqA735hrHXoSoRO1SST9TVjYviQ_3_APMAxAgPWvovexPYtCVl0epugZeoLVoFHbTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9tZFHOxjMrLv_uajiZ8IyTcoTxUgheij5QkEJwtpYTA&oe=6AE49B8F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCP5F0B5oR4Q7kNvwE_sx_N&_nc_oc=AdriKDkHR4iZsEdFbGzO2yf4EjBK-eOu_CUICudP4QjETyyKiz9BKfbVk1A7H24CZII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZt2uORP7yzwcrIhzfr_G8hCAJ0rwzOjMZT13aukERnQ&oe=6AE4A731"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BZTGGFo40cQ7kNvwEY4F_p&_nc_oc=AdpWwOdjQhBW7KS6u44OwUblShLg-6EoODv5jXW6ZQS-LaThxrIBmunHU6xtiiKrLqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQLYYWbqoLur24ODHRX-YnLA_iHT3a9s6LBHXhFNsd-Q&oe=6AE4BCBA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXZ21YXflKYQ7kNvwHB4xy6&_nc_oc=AdoBx_a4Ww8b2TN-4G8f4xluj09KuaZg7j8LdTqRqrSoErjaw8O8UySsJkRiDWmaa1s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhTCMGB66fMOZBeLf9mOiwOLiqVpU7mvrHI4mgqzPyMA&oe=6AE4B7A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u49IkND7j0AQ7kNvwH-1Bpl&_nc_oc=AdrkA_TGpR_yldXrL3t3QcLZksmQPpAeJDJw_6LOtbWW88qn-kiKvtIRuO8IfNSlmq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0FyHlmBPH7cUEHPyE-0YrobTdFw2uroEf_Rzr0Fu96A&oe=6AE49E3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T90YN19kbB0Q7kNvwF2lLb0&_nc_oc=AdocMLCdYEVq073cVK_R6nwhF96prACLS5HUvlhA_QqUg0JBgBV9gfch-aP7e5WNV78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdLCMcxndmL1wpV8Yip_32G4xiWKWEMXGNE3ePqw2h2g&oe=6AE4A86B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goG-dbpzKvoQ7kNvwFjqIOJ&_nc_oc=Adr_9Enyaf1Xkxsc3mOIKOdt6gPBUSK_Oy954oh9eGh8BpcMmHl8woamyha1lNh-8MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Az2uV5RoSDh9hnFOWAfDIY1VoZerTPNI4l2TOZq3VA&oe=6AE4AF53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
9&_nc_oc=Adkd97o1cOtVZmy4jPbe0AG0rYui6yVh9N2obAHHkqnvMm5JUUv-C8TSP6ki8X_E-NQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu3gmAWIekyCtnx9pZ7lGnEQbHhUjrHviTzMowjsCbw_g&oe=69A4210F"}]}, "id": "1382466938967099", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7eiEEvwuboQ7kNvwE3aIVz&_nc_oc=AdlaJqXEZE3tfYFu8zDbPL9zN70Y01lrBCp5TNOP2z_mZrtB81kXcSv7gFsz9EO8CGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuRqu0K2UXkEuG4g1a8ZigeyJ15Ua17zhUrJt8rif2DhQ&oe=69A44AB1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJpEOLXVR_4Q7kNvwEgss5N&_nc_oc=AdmzrD-0Ke7WubNnlRPYsOTDxNbCl0Zs8jhresq0-YDMIMCbiM7oXqRb_Asr9ohbb8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftekC0LH_4ARTgqKRJFPlCCuxaZUaDS3Nw3npey6DyVNA&oe=69A427FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqgmfr8ZY7kQ7kNvwGnu6gb&_nc_oc=AdnDfkVOZwp7hSmZcFpgwlN_Kzd-p87GeFtaSbObV-gjpMlRgeGrrXzGRkxpMh3QYEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftdvrUbJZRQeR4ZmLOyHkxQ_Brsl5l5Ae3mZqZGALzFzg&oe=69A422E2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDxRaLlkxDAQ7kNvwGYVEGC&_nc_oc=AdnG5yD6ghdXvxniC6Wr3rnWMO6RIx8Hp8vvXxgs9Cr17TtN6q5pWl38IzBsAzwHU1w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftqxXKU0SUfOKvoixrlG96CrcTAW2xARj5TASPqC9kUsg&oe=69A441BA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5rtPlmi_0oQ7kNvwGjVtOD&_nc_oc=AdkHHDaWrSoQ5RJDiFzV0894zT6qvSyST-MjpKIpNYXRTKl0oGIlNY7rPRLclPfNGkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvHfQNs_nc1xyfAekT16NhM01uGef7gavlHuhtvlQSC1g&oe=69A44BEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "427799910014327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254872_427799913347660_1009234490175775686_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aE7OsgBmiYwQ7kNvwHOV28r&_nc_oc=AdmD9JgSvIHjKphadYVDm9s5J70hnLNfSzAKQ7mpK-iO04ZR05W_uOFYtfbgF6PZa5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu4lmzLwrsxzgw_TSmGO-3nf2rMCA25cl-xo1wMY5dcqQ&oe=69A4478F"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}, {"images": {"nodes": [{"file_name": "\u6d77\u62a52560x1440\u5907\u90097-2+logo-\u4e2d\u6587.png", "id": "3772762123041281", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65229464_3772762126374614_5116127187365598796_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnVy5dtlzAkQ7kNvwEy98rk&_nc_oc=AdkaunyV6VOvznwGfiEQIZgFQ-YU4EmdQR5i11yLwpLe4KMBiLSHf4RhZ3PPDrv8ZoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvte8C90C_86LCz4LKMjY0wawqyBbMFHyGeIqTxSH0Aig&oe=69A443D9"}, {"file_name": "icon2.png", "id": "1090290192036087", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575357_1090290195369420_677972531973123807_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehYQIXUztlYQ7kNvwEI2R-T&_nc_oc=AdnOUPziO2GRHwNAECDJAdU2kvEMu26sFhsvzZidDiHfLgOgtjA-z_ZRYIHrMwU7S5Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsjmUH1TW7N7fWJqQXkc4fksJ4ltYoNXK37Drba7rMyoA&oe=69A42C4D"}, {"file_name": "hamster inc._logo_ch.png", "id": "857711756373822", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476756_857711759707155_7542117578876813577_n.png?_nc_cat=104
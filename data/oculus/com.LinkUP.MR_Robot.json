0&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDeyfCUGhmIQ7kNvwHj79Yc&_nc_oc=Adpp8iW3cMyL8Q3Gk-227eqrDA5LW3SrIqxA8cTDGFrG1BCO97HAkiR42m5u4Azu11I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-49icR4KomUW1w6Cn7-g3ptmjnYzOagJ70kWhvJYK-9A&oe=6A39388F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUPvKJELuKMQ7kNvwFyDqa0&_nc_oc=AdrQOW0S-1K2Vyo7qEelb7u9NREFGzHHL-zrDQ12LC7JaaULfQwsuWLChxSOZYSeJb4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZbFTvGjP5KJ1Pm8OR9t7Ty5pjhQ7-lqiBjz7efcdbLg&oe=6A394431"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9KhJiXYClUQ7kNvwH-1WZ9&_nc_oc=Adr_kHV04We9bdzppgpn6N1UX7wNyzyeoQxYhgUdm7qgxaDOu2R4AYCJUK8JhNuNav0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ftkrm7BHofxca2t9z2T3rTEKhSE4PFgk7LS7tdoB-sw&oe=6A3959BA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNLYy0tltfYQ7kNvwGW7zV3&_nc_oc=AdokuGFs7g-UCvx2T9XlrKXE9JkLsDDXIKEbNLXY0qx8oQziVpc6_VLEeAlEmTFoqL8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RChdjMkp5vXAv1CSuLYF9CnUpXiMOaDUVj-nWezy9zA&oe=6A3954A2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi35hOwGVJ0Q7kNvwGfIFj4&_nc_oc=AdqV_aluaRPs2XNfav3eSkjQqtgK-p37h-tN1mdfLahHzBUH1E8vPF7ENxL4dhP7XLs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nUmRjU-5P7bele0tYMO3_o4ARy3S-TdNkFBVbAh5TTg&oe=6A393B3A"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRDdZaiCTMkQ7kNvwF7zUqo&_nc_oc=AdqkcwwMzdZXrgOVRZG_OSfu-xqcuMl-V96DsSqN90_2HXYZ8MKAJcsskdFtRHeAv3g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83W2j0Kz8pCw7QQFQy85Z-NHp3ZztdU2_mIPTKUFNylQ&oe=6A39456B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V61NcPZEWF8Q7kNvwHTmJc-&_nc_oc=AdpqbMVseKuaC_0E4oNf-cDnn5iOT6yPbt1Xia__97yjw7DI2GjXHDRQrfn_rA38Qs0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IA-Pyfn5YrFfYDCE7l7N3vocGjixo1pdmcEPvAcLljg&oe=6A394C53"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_m
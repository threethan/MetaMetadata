d=6e7a0a&_nc_ohc=lUwpp4qCIgAQ7kNvwFCCXi-&_nc_oc=AdojRedIRoi0TzOu4qNlYuiOmNgFIPdiSQ6gfP6zFIq5Tzc862qB7jxj8y0QBvVjm20&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxpWEACiQ1MAjdNwjbJ-sxcYkSS5gelrknoXyKzA93BvA&oe=69CBCC0F"}]}, "id": "899318455572484", "locale": "en_US", "screenshots": [{"file_name": "11.png", "id": "1097797137999292", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570288_1097797141332625_692184632505995617_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjXX6TqbF_oQ7kNvwFL8NaF&_nc_oc=AdoCqU6AeL0f0yKYMUuDpcme9xDW-OyMZywYIwO7VbVzRWo_SAFuf1RKchLRx6mBohg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFzpvKAHKDszhIbxNGaZWCRgaEJ3zcc8FS8_Qg9gHKgA&oe=69CBD7B1"}, {"file_name": "2-2560x1440.png", "id": "1631350467404912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035433_1631350470738245_8852123318308072529_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ccUn-82ZcIQ7kNvwFnzGG0&_nc_oc=AdpmHh3-JJ7EzeNpTwFrC9yRfELhh_CWWQaGGogKoB_Y4040J4djxV_UN0OxC7rdWUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxkNlNoROI4ITAGk70Ue-dPBy1_7m5r9n2u-0ehEYZxg&oe=69CBB4FA"}, {"file_name": "5-2560x1440.png", "id": "471726615347621", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57569432_471726618680954_3135093783903181704_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v2rkhZRaHEQ7kNvwG_eWVs&_nc_oc=AdqMNmwz5EYA2-EWl72AarI8a7oY0d58g7A4SCHQdl0OoiCy4hntwjIYziondBOuZgM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3M4EK98AdJ9kZYu8knkTa7A01qjUWZ_2zp_Y3x2yi2w&oe=69CBAFE2"}, {"file_name": "7-2560x1440.png", "id": "1146548799869781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035337_1146548803203114_4232071023953588234_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-BjZJ3DygkQ7kNvwHT5T20&_nc_oc=AdoWymeAgeCl5jhVhUKQfsqnuyK_558q-EN3oD85_UU8rIc7CCRC25hoywsPO0m4DSw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuTZsD97sDJlvJsNTT5eiBpC3FSIQlLC6fMeuBDt_Bcw&oe=69CBCEBA"}, {"file_name": "1-2560x1440.png", "id": "999610461677141", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031311_999610465010474_1087177970663193150_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQdoqpbm05AQ7kNvwF1_hAJ&_nc_oc=Adot_HXXOoDdvRxoNPhJUEa7TIyxWEt5k0AklJwIfAhxruDC8cs4MzEO0AczvVqqNcc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgDToO1b_aQWHXG8iYScaKtzBmyhfxLNL9wtp2xP7LpQ&oe=69CBD8EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "503788578775406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974504_503788582108739_3834053529888765989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgAhbimLm44Q7kNvwHpRnng&_nc_oc=Adq7LMehdKAW36rv7yPUdm4xK0j6b29DPBueJ9Lw5DTShdRW4SFUFtLTpNwKsxqvviU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjGnW4f8_xjPj6HJtram5NKwrExFzcUDAnNAgPGHND_w&oe=69CBDFD3"}, "display_name": "Hamster Inc.", "keywords": [], "long_description": "Welcome to \"Hamster Inc.\"! It's a physics building game that supports \"mixed reality\". In this delightful puzzle game, you'll design, build, and then program machines to overcome challenges!\n\n# Creativity and Logic\n- Based on physical principles and logic, think about how to overcome obstacles and help hamsters improve transportation efficiency.\n{1557136708179895}\n\n# Assembling\n- Design and build a variety of machines with over 60 types of blocks.\n- Over 20 special-function blocks that can be programmed, such as ultrasonic sensors, DC motors, radars and more.\n{327773876776917}\n\n# Graphical programming\n- Super easy! Graphical programming makes your creations \"alive\"!\n{406792278927140}\n\n# Explore 6 unique themes\n- Explore Eastern Forests, Automated factories, Sunshine Coast, Western Gobi, Volcanic Tunnels, and Northern snowfields.\n- As you progress, develop your hamster company and unlock new resources and challenges.\n\n# Enjoy the sandbox mode\n- where you can build and program freely without any limitations on the block amount!\n{971212150879070}\n\n# Mixed Reality\nBring your creations into real world and transform the entire room into a dream paradise: \n- Create custom levels by using real furniture and virtual terrain models, \n- Have your car/drone automatically avoid furniture as it moves around the room,\n- Watch virtual creatures interact with real world: like bison running on tables, floors, or beds!\n{897586709048914}\n\nDiscord: https://discord.gg/NkC8bwQEmK\n", "short_description": "\"Hamster Inc.\" is a physics-based building game that supports \"mixed reality.\"\nIn the game, you can build a variety of interesting inventions such as trebuchets, unmanned trucks, robotic arms, and drones to help the hamsters overcome challenges one after another and continuously develop and expand the logistics territory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/PrivacyPolicyofLinkupLLC.pdf", "developer_terms_of_service_url": null, "publisher_name": "LINK-UP IMMERSIVE", "support_website_url": null, "website_url": "https://linkupxr.oss-cn-shenzhen.aliyuncs.com/Common/Hamster%20Inc.%2020240513.pdf", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7629327370501355"}, "review_messages": []}]}, "cove
Learn micro-credential program as part of their interactive skills training and assessment experience.", "short_description": "Diagnosing and Replacing Fuses is a VR training application developed as part of the Immerse Learn Diagnosing and Replacing Fuses Micro-Credential Program. This immersive simulation provides hands-on practice in identifying fuse-related issues, diagnosing faults, and safely replacing fuses in real-world scenarios. Access to this application is exclusively available to learners enrolled in the micro-credential program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1610932187700253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "936147959449604"}]}, "baseline_offer": {"id": "936147959449604"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782891780, "status": "PUBLISHED", "id": "936147959449604"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1622681289858676", "version": "2.0"}, "id": "2192712244916336", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fal
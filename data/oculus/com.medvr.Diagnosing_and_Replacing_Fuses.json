-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Z4qvGPTtXR0-G-rJsOJqU1STmVcQYQj1sfGMlNItCQ&oe=6AF9ED6F"}, {"file_name": "HighresScreenshot00001.png", "id": "1414503400503987", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314641_1414503403837320_677223929602414224_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvCF4-28yPUQ7kNvwFDFBXE&_nc_oc=AdpR3GRQO1J6y5xZ4ZyAbgSqDaSKtjbl2E_dgchSf4xj2xxh-hYpWbr6ZzdlEUWbArk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToJXak9qsDsQYAaSLqU3E0DV8kMx0S9HoXTT61u2y6cA&oe=6AF9E27C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Diagnosing and Replacing Fuses", "keywords": [], "long_description": "Diagnosing and Replacing Fuses is an immersive VR training application designed exclusively for learners enrolled in the Immerse Learn Diagnosing and Replacing Fuses Micro-Credential Program.\n\nThis hands-on simulation enables learners to develop practical skills in identifying electrical fuse failures, diagnosing circuit-related issues, following proper safety procedures, and performing fuse replacement in a realistic virtual environment. The training experience is built to replicate real-world troubleshooting scenarios, allowing users to practice critical technical procedures in a safe and controlled setting.\n\nThis application is not intended for general public use. Access is restricted only to individuals officially enrolled in the Immerse Learn micro-credential program as part of their interactive skills training and assessment experience.", "short_description": "Diagnosing and Replacing Fuses is a VR training application developed as part of the Immerse Learn Diagnosing and Replacing Fuses Micro-Credential Program. This immersive simulation provides hands-on practice in identifying fuse-related issues, diagnosing faults, and safely replacing fuses in real-world scenarios. Access to this application is exclusively available to learners enrolled in the micro-credential program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1610932187700253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "936147959449604"}]}, "baseline_offer": {"id": "936147959449604"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782891780, "status": "PUBLISHED", "id": "936147959449604"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1622681289858676", "version": "2.0"}, "id": "2192712244916336", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1610932184366920", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1622681289858676"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2192712244916336"}]}, "change_log": null, "created_date": 1782728989, "id": "1622681289858676", "version": "2.0", "version_code": 100, "release_status": "RELEAS
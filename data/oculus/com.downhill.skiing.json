dn.com/v/t64.5771-25/499620630_1123760130039898_5208068839865606161_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQmc2YDXzeUQ7kNvwFdfYDx&_nc_oc=AdqKUsnLkuwbk_0-vwFRf2TOPhNyTwfTRH8sUTrhQnzjOAgV7JAs2sHA_dYU_eg0X1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlzpXYqtPGeHMqGwivn0oNlry-SVJ0hwR9d_uIkgY01g&oe=6B0C6EE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Downhill Skiing", "keywords": ["Skiing", "Ski", "Snow", "Downhill", "Mountain"], "long_description": "Hit the slopes and experience the excitement of downhill skiing in VR!\n\nTake on snow-covered mountain descents, carve through every turn, and control your line as you make your way downhill. Build speed, adjust your direction, and stay in control as the mountain opens up ahead.\n\nFeel the rush of skiing across snowy slopes and discover the excitement of every descent. Whether you're perfecting your turns or simply enjoying the thrill of speeding down the mountain, Downhill Skiing puts you right in the action.\n\nPut on your headset, find your line, and experience the thrill of downhill skiing in virtual reality!", "short_description": "Carve down snow-covered slopes in VR! Control your turns, manage your speed, and experience the thrill of downhill skiing as you take on the mountain."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recom
qpG0bC0iwdPoPOh-3cmLkRpjsh_hR8JJLlNg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhK0I0MFq8RT-b50_9Og_dz8tLbk8JGXlMQcIDBEMAig&oe=6A972142"}, {"file_name": "InfiniteWorldScene_Custom..._28.05.2025_11-30-06_2560x1440.png", "id": "978189207727133", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499318017_978189211060466_9003891911391105638_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNBek9UatuEQ7kNvwEsO-kc&_nc_oc=AdqsPBWLNytqMLCxk4wneO1mmCflI10pQuygOWtmb9UlAjVXMdv2J-tXBfI3fC_3_LI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbBYSdBM0jVK5LizvsUaWoEkJThxyoL0HFDB1vd-TP5Q&oe=6A973E31"}, {"file_name": "InfiniteWorldScene_Custom..._28.05.2025_11-30-28_2560x1440.png", "id": "1695555517987214", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499307449_1695555521320547_4177041498501330479_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=213yNe6_6C0Q7kNvwGhRiLj&_nc_oc=AdqzvSMx-TQkNHkjno-mO9pBms33Htjjhc70jpJqV5JlCX6NEzROE7dw8liGznvZRxI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbxcLGOD9gESrbhEMNJXGmOORgo8wAtVaGq9AqEPMWyw&oe=6A974583"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crefty Vr", "keywords": ["Crefty", "Crafty"], "long_description": "Crefty VR is a fully immersive, endlessly generating voxel game designed for virtual reality. Dive into a limitless world where creativity knows no bounds\u2014mine, build, and shape the environment however you like. With over 20 diverse biomes ranging from snowy peaks to lush jungles, every journey feels fresh and unpredictable.\n\nWhether you're constructing towering castles or just exploring the wild terrain, Crefty VR puts total freedom at your fingertips. The game is currently in early access, so expect ongoing updates, new features, and continual improvements as development progresses. Join now to be part of shaping the world of Crefty VR.", "short_description": "Crefty VR is an infinitely generating voxel sandbox game built for VR. Explore over 20 unique biomes, build freely without limits, and shape your own world your imagination is the only boundary. Currently in early access."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NqCBRUg8M92liNpbLfrMG4uaqhH2khKnJ64HbohyF5o/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge inc", "support_website_url": null, "website_url": "https://unknownknowledge.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "23976087788649547"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1111716177663648"}]}, "baseline_offer": {"id": "1111716177663648"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748873760, "status": "PUBLISHED", "id": "1111716177663648"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24898907886367528", "version": "12"}, "id": "2134393106973931", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23976087778649548", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
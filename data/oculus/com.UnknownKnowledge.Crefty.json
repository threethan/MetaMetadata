jc3-1.oculuscdn.com/v/t64.5771-25/499318017_978189211060466_9003891911391105638_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82YZiatfK9MQ7kNvwG1gjij&_nc_oc=Admpp7abZDTe3l6JjV7A6G5pTJvyinHN7fAAZb9oIsXIjEABRVhrv6FMOD3PWQ9kiqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFep0VQvUBRdWc0IBhsXPVImoynOhN5L-WZmdScJnyaw&oe=69B6AEB1"}, {"file_name": "InfiniteWorldScene_Custom..._28.05.2025_11-30-28_2560x1440.png", "id": "1695555517987214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307449_1695555521320547_4177041498501330479_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oYqAEsKJD8Q7kNvwHGaG3n&_nc_oc=Admm-SggatHbtStAz75Tyri3n5m27iYc1yzqHfkTwfdmdN_MLdNi1YTk3Q0CFg71gj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwr0q8Zx6S8b8Ly4-NEh7sOUn0TkT4RLanTrGafNSvgfQ&oe=69B6B603"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Crefty Vr", "keywords": ["Crefty", "Crafty"], "long_description": "Crefty VR is a fully immersive, endlessly generating voxel game designed for virtual reality. Dive into a limitless world where creativity knows no bounds\u2014mine, build, and shape the environment however you like. With over 20 diverse biomes ranging from snowy peaks to lush jungles, every journey feels fresh and unpredictable.\n\nWhether you're constructing towering castles or just exploring the wild terrain, Crefty VR puts total freedom at your fingertips. The game is currently in early access, so expect ongoing updates, new features, and continual improvements as development progresses. Join now to be part of shaping the world of Crefty VR.", "short_description": "Crefty VR is an infinitely generating voxel sandbox game built for VR. Explore over 20 unique biomes, build freely without limits, and shape your own world your imagination is the only boundary. Currently in early access."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://docs.google.com/document/d/1NqCBRUg8M92
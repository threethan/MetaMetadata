5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9-cover.png", "id": "2393807281133268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292329_2393807284466601_1477651020779088301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RENTnTGh8vcQ7kNvwGAmBAH&_nc_oc=Adq2i2bs3u2TrAMhfdkvV-rk1Q9xnjySYL3cirHgwQXvBc-_R2YZPgDcHGxvk4AXESU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4845wdmte82ffU7YNsQymh9Qj4x1Ijs-7xXLWKxiFfQ&oe=6A5F59AC"}, "display_name": "Starpath", "keywords": ["Space", "scifi", "spaceship", "pilot", "combat"], "long_description": "Take the controls of your own spacecraft and answer a distress call from ARIA - a stranded AI with a sharp tongue and a ship full of problems.\n\nFight through enemy fighters, navigate treacherous comet fields, and reach her before hostile forces do.\n\nA story-driven VR space combat experience for Meta Quest - with endless modes to keep you flying long after the credits roll.\n\nARIA will guide you through it all. Whether you want her to or not.", "short_description": "Take the controls of your own spacecraft and answer a distress call from ARIA - a stranded AI with a sharp tongue and a ship full of problems.\n\nFight through enemy fighters, navigate treacherous comet fields, and reach her before hostile forces do.\n\nA story-driven VR space combat experience for Meta Quest - with endless modes to keep you flying long after the credits roll.\n\nARIA will guide you through it all. Whether you want her to or not."}]}, "developer_name": null, "developer_privacy_policy_url": "http://starpath.studio/#legal", "developer_terms_of_service_url": null, "publisher_name": "Starpath Studio", "support_website_url": null, "website_url": "http://starpath.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460
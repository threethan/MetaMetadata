Fu0rVT&_nc_oc=AdrPOqVz_L83eNZMyxSofC5xPUQltc0k8UtaFNcq2nEYyyI9iAv3jQHk6_vnn9Wa5wY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyT76eYSB5F1_qW2qp5VYpL4lKPoSKLAL8I9Op3L9k0w&oe=6AAFE411"}, {"file_name": "Still 2026-05-11 180858_1.1.1 (1).png", "id": "2458204084653858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604302364_2458204087987191_2254902731328286046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjOB4_B6jDoQ7kNvwGy04r4&_nc_oc=Adp7piuTJIzB4Nb3eHK-rfMxaeW6UvWUE3urKCAV_I0qIGD--N0aooIvD4z1BL6ESWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9ew3fmZtW4uXn7aCgisi2sGWQMYj4fN4j1RVs48BDVw&oe=6AB001D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16-9-cover.png", "id": "2393807281133268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292329_2393807284466601_1477651020779088301_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YphZhUmnmyMQ7kNvwGQ7M4k&_nc_oc=AdqMRZGFitbf4JNKeJZCDFq4QSwJa0IIiO4mweu7Q7zyRCdRWuYA7ZTqYSJB6qgghyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMvt4rAFcYdRCsMMtbyyZIYCvDyk1o3eFqhjHxfLqJWQ&oe=6AAFFD6C"}, "display_name": "Starpath", "keywords": ["Space", "scifi", "spaceship", "pilot", "combat"], "long_description": "Take the controls of your own spacecraft and answer a distress call from ARIA - a stranded AI with a sharp tongue and a ship full of problems.\n\nFight through enemy fighters, navigate treacherous comet fields, and reach her before hostile forces do.\n\nA story-driven VR space combat experience for Meta Quest - with endless modes to keep you flying long after the credits roll.\n\nARIA will guide you through it all. Whether you want her to or not.", "short_description": "Take the controls of your own spacecraft and answer a distress call from ARIA - a stranded AI with a sharp tongue and a ship full of problems.\n\nFight through enemy fighters, navigate treacherous comet fields, and reach her before hostile forces do.\n\nA story-driven VR space combat experience for Meta Quest - with endless modes to keep you flying long after the credits roll.\n\nARIA will guide you through it all. Whether you want her to or not."}]}, "developer_name": null, "developer_privacy_policy_url": "http://starpath.studio/#legal", "developer_terms_of_service_url": null, "publisher_name": "Starpath Studio", "support_website_url": null, "website_url": "http://starpath.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26513116551648041"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1747913673093405"}, {"status": "PUBLISHED", "id": "1852496886129753"}, {"status": "PUBLISHED", "id": "1052301440991300"}, {"status": "PUBLISHED", "id": "2399000653920327"}, {"status": "PUBLISHED", "id": "1020361573828020"}, {"status": "PUBLISHED", "id": "2340416759778154"}]}, "baseline_offer": {"id": "1747913673093405"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788255000, "status": "PUBLISHED", "id": "1747913673093405"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27872608435698839", "version": "1.0.0"}, "id": "2062130201323795", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": "New levels 9\u201313 with expanded story campaign.\nPilot a Frigate \u2014 a powerful new ship class with heavy combat capabilities.\nNew Mining missions: extract resources under fire in asteroid fields.\nExplore the Fleet Control room aboard your ship and command your forces.", "created_date": 1787311348, "id": "27872608435698839", "version": "1.0.0", "version_code": 64, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": "The Co-Pilot Update introduces online co-op to Starpath Frontier, letting you team up with a friend and take on space battles together.\n\n\ud83d\ude80 New Co-op Gameplay\nPlay online with a friend in the new Enemy Patrol sector.\nFight through increasingly challenging enemy waves together.\nPrefer flying solo? The mode is fully playable alone as well.\n\ud83d\udc7e New Enemy Types\nPulsar Frigate \u2013 A dangerous close-range warship that unleashes relentless laser attacks.\nSwarm \u2013 Tiny, agile enemies that move and attack as a coordinated group.\nCruiser \u2013 A heavily shielded capital ship that deploys Swarms while engaging you directly.\n\ud83d\udef8 Lumenweil Improvements\nAdded a dedicated Multiplayer Room.\nAdded a new Starting Room where you can choose your preferred locomotion:\nTeleport\nSmooth Movement\n\nSmooth Movement has also been improved to provide a more comfortable VR experience with reduced motion discomfort.\n\n\u2699\ufe0f More Improvements\nRefined flight physics.\nGameplay balance adjustments.\nVarious fixes and polish.\n\nBring a friend, launch your ships, and defend the frontier together! \ud83c\udf0c", "created_date": 1783280084, "id": "27332014573091564", "version": "0.11.0", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": "Version 0.10.0 \u2014 Board the Lumenweil\nYour mothership is now more than a home base - it's alive. Land, step out of your cockpit, and explore Lumenweil on foot for the first time. Find the upgrade bay, enhance your ship, and listen closely: ARIA has plenty to say about your wandering around her domain.", "created_date": 1780411017, "id": "26930041436622215", "version": "0.10.0", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": null, "created_date": 1778520702, "id": "26651941541098874", "version": "0.9.9", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": null, "created_date": 1778518055, "id": "26651482294478132", "version": "0.9.9", "version_code": 60, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
se_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": "The Co-Pilot Update introduces online co-op to Starpath Frontier, letting you team up with a friend and take on space battles together.\n\n\ud83d\ude80 New Co-op Gameplay\nPlay online with a friend in the new Enemy Patrol sector.\nFight through increasingly challenging enemy waves together.\nPrefer flying solo? The mode is fully playable alone as well.\n\ud83d\udc7e New Enemy Types\nPulsar Frigate \u2013 A dangerous close-range warship that unleashes relentless laser attacks.\nSwarm \u2013 Tiny, agile enemies that move and attack as a coordinated group.\nCruiser \u2013 A heavily shielded capital ship that deploys Swarms while engaging you directly.\n\ud83d\udef8 Lumenweil Improvements\nAdded a dedicated Multiplayer Room.\nAdded a new Starting Room where you can choose your preferred locomotion:\nTeleport\nSmooth Movement\n\nSmooth Movement has also been improved to provide a more comfortable VR experience with reduced motion discomfort.\n\n\u2699\ufe0f More Improvements\nRefined flight physics.\nGameplay balance adjustments.\nVarious fixes and polish.\n\nBring a friend, launch your ships, and defend the frontier together! \ud83c\udf0c", "created_date": 1783280084, "id": "27332014573091564", "version": "0.11.0", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": "Version 0.10.0 \u2014 Board the Lumenweil\nYour mothership is now more than a home base - it's alive. Land, step out of your cockpit, and explore Lumenweil on foot for the first time. Find the upgrade bay, enhance your ship, and listen closely: ARIA has plenty to say about your wandering around her domain.", "created_date": 1780411017, "id": "26930041436622215", "version": "0.10.0", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27872608435698839"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2062130201323795"}]}, "change_log": null, "created_date": 1778520702, "id": "26651941541098874", "version": "0.9.9", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26513116488314714", "is_concept": false, "latest_released_binary": {"__typename": 
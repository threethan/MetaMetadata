scdn.com&_nc_ss=7f20f&oh=00_AQLa4nEAuK-Mw97Br_qNSy7Ty4itGfS2-v21ZDFmxsNTqg&oe=6AB673A8"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjq0Ue-IpMYQ7kNvwFlLEUv&_nc_oc=AdoWWxds7JxtIOme6aGPbzbEyT9vP_Fz4BWdtAODl4lfvlplR67hvaqadiY_MZvGMso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQVltytNN11IUyIpUxocCfFbwgy5zgOs1YgQ5V6wfHQg&oe=6AB677EF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAtxySJMbQkQ7kNvwGG_oLa&_nc_oc=AdrYgEpXBDO9WHFLh4xhSHzyVKWjppmDUel7fueWoPNI0r3NEQQGCTClU3vYv2d0hWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSbsZZuZomCFO_GpoqPGjC6PhTJNXDw2yilTTse_le_w&oe=6AB6691A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQkV_iZRRugQ7kNvwHnX1yi&_nc_oc=AdoSsbeKhMRK0Sogd0dy3PGY8bWuq0ZoMvsfpwnanWLxiKsSygw84ktvSmlLKZYY6rU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrsUin9C_A2ENsCM6QPZxHO4xaa51hz5XZpb_lD7PU3A&oe=6AB686C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCKQddOfApQQ7kNvwHi0UMd&_nc_oc=AdqULehpwpAsDWxm_mXSaHM53Vx39jo2-0Tdx3mRte56yXIS6WSPK-iVZT-Qa3KabPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImb9wnZ5-q8hx4-qIZiTTPwG9O8UnnycoNkby-SmSscg&oe=6AB67676"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available, and being actively added, as DLC.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
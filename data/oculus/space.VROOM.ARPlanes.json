tent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSpETEkLXUPNBXzGasv6bWgK_c18q1BQMj7ggF6cfslg&oe=6ADF728B"}, {"file_name": "CoverHero.png", "id": "1443813033493379", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507840144_1443813036826712_8491446272411592201_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0nVYMns3uIQ7kNvwFbOJWJ&_nc_oc=Adr0RSo6OzIEsaVZh5RBh1eAqoHX4wvanLSBxxwG3l7rILT7zg0Wy_rB39EdtfuTnj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSok42REtsAmWTpH4U7K9f_RPpKRU4z-kW4_CohZheGw&oe=6ADF792F"}]}, "id": "3148172068694614", "locale": "en_US", "screenshots": [{"file_name": "B-21.png", "id": "1490141272128294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_1490141275461627_1582846305667155381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDH3iroq1mEQ7kNvwFcJLzk&_nc_oc=AdqtSrARiPvy5QA0jba1AAApudDQyRmAufuVThoTBSyCG8kmpR_S_T7Sq50PNvpMH-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh0dNc1ubi25ipJ5VTzJxWW5ZhfLgHmhp4KE_2hb-Siw&oe=6ADF53DC"}, {"file_name": "YF-23.png", "id": "1520376132481449", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_1520376135814782_4268259268317293479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtEnK43825kQ7kNvwHguycD&_nc_oc=AdoYKJomXetHytk0dXfhaOLaBvuJOyweKIhM6h0i9bMNNxW3cqX7HAAKptWZJFO4qRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfe7ZGBYkSa1YdQSs0YZX1PFA7pG55Zq-436kC2zs69g&oe=6ADF5228"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BikCWElVRT0Q7kNvwFfd8nY&_nc_oc=AdoievJ_OV-f-Vhyb9Uw4k7VNfmfB8iFcbvTkT_2mNGGhqfFMn_Pfjm6TM56iLJvyWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi1gPlMnXhTnLunhevZQ72p44KChBVIKl8no2yzwoXTg&oe=6ADF566F"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7lNY5mUiugQ7kNvwGl5hjo&_nc_oc=AdrY3yyWyWUQyv0alCiivTPzXcLWqcCGenfDD-7Jb7S6bdO0a0zOKSGwgQ6GFFztTy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPffoF_xz9ux1RStjFimpsbHReWYDr7SajAF44N3WQ6gw&oe=6ADF479A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Vc4ohKsZxkQ7kNvwHZTgO3&_nc_oc=AdqY4sWA0jY_8LTCZtQ-qeSvqCKcAuwP407oL7hF8CpTxv5pnbiTy6zcEpGeLXR5PDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0AoGQZv5xTKxPoIm6kSdkYQKOu15FQaC4ctPopDAH-A&oe=6ADF6540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrLj7HQeqq4Q7kNvwEGs3tA&_nc_oc=AdqqPVvtTDz2V1kE7JhkAGi90mAw7yR5Ct7NeQwZ2tRFrgJet2cF8Y0NK0Re352RRZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzhYg1BZoitz5GY-HQ9X_6dhwFS6J_hH_EsGo1IDlRJg&oe=6ADF54F6"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "870836702557482"}, {"status": "PUBLISHED", "id": "2429440244206100"}, {"status": "PUBLISHED", "id": "2456674221492530"}, {"status": "PUBLISHED", "id": "1341909520714530"}, {"status": "PUBLISHED", "id": "896826746777670"}, {"status": "PUBLISHED", "id": "2422178681639385"}, {"status": "PUBLISHED", "id": "1870504550327974"}, {"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED", "id": "4108894889361227"}, {"status": "PUBLISHED", "id": "2310162386136030"}, {"status": "PUBLISHED", "id": "1606504597178602"}, {"status": "PUBLISHED", "id": "2063528141151748"}, {"status": "PUBLISHED", "id": "2550252985342833"}, {"status": "PUBLISHED", "id": "1114445443577615"}]}, "baseline_offer": {"id": "870836702557482"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789404420, "status": "PUBLISHED", "id": "870836702557482"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28638272485837174", "version": "1.42"}, "id": "1741407059854648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28638272485837174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Environment surfaces are now scanned automatically in the background, eliminating the need to pre-scan via Meta's environment setup.  :)\n\u2022 Scanned rooms are reloaded at startup for faster readiness.\n\u2022 Scanning never stops, but progressively slower as geometry completes to save battery life.\n\u2022 Ground-plane accuracy now relies on the scanned environment rather than Meta's flaky \"set ground level\".\n\u2022 Fixed planes spawning too far from camera at startup.", "created_date": 1792601035, "id": "28638272485837174", "version": "1.42", "version_code": 1011, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28638272485837174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "v1.41\n\u2022 Set a 10m maximum for occlusion, so anything beyond that is not occluded.  (Quest3's sensor is unreliable at larger distances.)\n\u2022 Large planes start further from the player at start.\n\u2022 Improved some 787 textures.", "created_date": 1792432969, "id": "28611932225137867", "version": "1.41", "version_code": 982, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28638272485837174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Renamed \"Walk Around\" to \"Inspect\".\n\u2022 Added a \"Runway\" operation mode, where you can place a runway and practice take-offs/landings.  Landings are graded, your best per-plane score is saved, and autopilot landings are available to show you how it's done.\n\u2022 Added an \"Airshow\" operation mode, where planes perform flight maneuvers for your amusement!\n\u2022 Improved advanced flight-model to enable certain maneuvers like \"falling leaf\" an \"cobra\".\n\u2022 Simplified radial menu by adding a \"Flight Ops\" menu that contains Inspect, Gunnery, Runway, Airshow and Options.\n\u2022 Changed the combat toggle button to \"Next Operation\", so you can easily cycle between operations.  (Long press still toggles \"Inspect\" operation.)\n\u2022 Controller triggers no longer cause prop strain/relief audio changes in full-scale mode.\n\u2022 Discovered a way to separate thumbstick left/right from up/down, so rudder is now back on left thumbstick by default, and triggers are fire guns/missiles.  (Your settings remain until you \"Reset Defaults\".)\n\u2022 Bound buttons X and Y to toggle gear and flaps, respectively.\n\u2022 Optimized bullet-firing to reduce CPU usage.\n\u2022 Thrown larger planes now receive more oomph.\n\u2022 Fixed an issue where default engine pitch wasn't being honored.\n\u2022 Consolidated nav light materials to reduce draw calls.\n\u2022 Recategorized F-14A, A-10C and Mirage F1C-200 as \"Early Jets\".\n\u2022 The ground shadow sharpening I added in a recent update was drawing shadows when room-collision was disabled; that has been fixed, and those shadows are now darker.\n\u2022 Afterburners are now louder.\n\u2022 Fixed Bf 109 E's cockpit rotation so you don't end-up sitting backward.\n\u2022 Fixed nav lights on F4U-1C and F-4C.\n\u2022 Inverted afterburner normals so they look better from behind.\n\u2022 Planes in advanced flight mode do not fly at startup until input is provided.\n\u2022 Adjusted roll-rates of all planes in both flight modes for realism.\n\u2022 Displays best-time for Gunnery Ops d best-score for Runway Ops at mode start.\n\u2022 Grabbing the plane in inspection mode now moves it and/or rotates its vertical axis around the controller.\n\u2022 Added a \"Space Setup\" button in the Options menu to make it easier to setup your Quest environment.", "created_date": 1791303693, "id": "28430820413249050", "version": "1.40", "version_code": 979, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28638272485837174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791231828, "id": "28419722144358877", "version": "1.40", "version_code": 978, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28638272485837174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791134742, "id": "28405060569158368", "version": "1.40", "version_code": 972, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
scdn.com&_nc_ss=7f20f&oh=00_AQTxDmg3Biei2M2fS4lAwSjz3A-bJJf2alSWWQ95GTsV_A&oe=6AF74568"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXBCJb2m-c0Q7kNvwH1p-BS&_nc_oc=AdqUwO4iN_oFh5V85IW-41aZpuHfZvPnXK6vwGmtTF0ttgoecJIj181PICf-7FdvCog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyUgnA6eds_0UuTtia51P8KV-GjDJPHrL27tVIG4Uf_Q&oe=6AF749AF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmmLiSrslmYQ7kNvwFdVfpL&_nc_oc=AdqTOthzmGOlnDSAyNDd48wkvRFzK8jqNorn1qfu-BinbmKofAqfK_yoobU0T95HrJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb-pUx2pcSitbULE5Ih1SQdVENcxq_LryxCEGcF-TXRA&oe=6AF73ADA"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTAkE93aKOkQ7kNvwGuu_iE&_nc_oc=Adra5PU1jYjZjVYPLyY_W7VcMncvYVZAeKb_QFiThZmoO7tZ1rNvmRMvex3vU36Dj0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyu9Mg9gTsB10gzxgZKkfPm-HPKlMwlVO04jxEV0hW7Q&oe=6AF72040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEe6LbNyWQMQ7kNvwGtHgHm&_nc_oc=AdqnPC26vOuIJ-x2GTIFIM5mBFrovWy2VkSsvtxCDH-n9hqZoSNgDoucKzMITozlnnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW3oNDIS0LGoWN5uca0KozwwdwVj1xMyM_2ToiLr7yTw&oe=6AF74836"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86F Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35C Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available and being actively added as DLC.\n\nYour room becomes part of the game.  Planes fly behind your furniture and around your walls, and with real-time environment scanning they can even collide with them. Destroyable targets spawn within your space.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQ
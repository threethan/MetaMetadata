scdn.com&_nc_ss=7f20f&oh=00_AQJt8PZy7-SL-h5c0kjpzbWv8wsVOx9ZzA_ADi0DP6DsSA&oe=6ABD0B28"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40xOXGyncnkQ7kNvwEJz79w&_nc_oc=AdpzZ2l_dVGDs3qPAJbb1U0U_P8kvlwtxhvRSVeYYa_Pkl21shHFyfokbZ0zY9Z5gig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKqfrTMffwjTopUfudGXfXtbREu8Loa3rO1oeBLKWKQQ&oe=6ABD0F6F"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCxKfJicUOYQ7kNvwH-LFbA&_nc_oc=AdqfpuVoobMmkVxbKlFf6zbhQA6WfNpM99q6GL4dhky8S_zi56tY0DeDTPn1VTaUPQc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQbj88q4xjqgSUWmPO12T_6o54PGdx1Z1Ewp_XZEpvNg&oe=6ABD009A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42YdSb-s-tcQ7kNvwFlUaF5&_nc_oc=AdrHE_U_vaQ1Jns1cozRvNoBv8yytn_cr5IatPl3HK-lWL0I8jdq3xPxRdyspDCRkkU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqlX2GMxtDi74dK8vf_ztzSwaTNogRu4JAQIHD7pTGmg&oe=6ABD1E40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVxThQ_sEMoQ7kNvwGpVafv&_nc_oc=AdpDxw-bhZeW5-0ejjLnyArRu3pq5GK5MmnLdK3HshM1wSkUNSj1alkmhcFLU13ay0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOqz0u4YhFwfs6wsSsXMdiaD3aPSLV5n9wF5XTzL1GwA&oe=6ABD0DF6"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available, and being actively added, as DLC.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
ng?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKlI0QkmPpcQ7kNvwFnxVE2&_nc_oc=AdpXRnMmyxai8usVtdyE77OcYpQZvRgo7sJgD8sm8dY1MyhT6p06_9ADFfemVpuDnkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGnPsITO5ESrx5b3PgfHsGPp-oFK2Yn6Y-nM1v3fEjbQ&oe=6B0F0068"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJdb90TW00AQ7kNvwGfO5B1&_nc_oc=Adp7jlMH5Ff5t1tnRho8zG8_VIcqwQDYFGOgKM7j9bAzcimABwNq0AUKU0uo7cAt_nE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6fIwrU3oo2wnLBXosSZ8XZq6J4ZqiU7RVf260s1ERhg&oe=6B0F04AF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrWMJ5fZW7kQ7kNvwE5ZxxK&_nc_oc=AdqLUCF8UkzvKZkIOukYVsSIXrLRnhlPez9FbBfKMy7CUGXjvKrUgfe9I1dYYgU6A_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoKR7tAFTODNOQunnOtlH-bUpKPOoygo_ioYJN6JMHLA&oe=6B0EF5DA"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcYt4jKzWjsQ7kNvwGphOvl&_nc_oc=Adri04zRHYOBnrsRghSphImEfNH5ySSjJKg0a8ZUr2YKWoI7QMIxoQrUBJD3HqVoRZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIXix2JRWNotIn40miRxYAGn6LShPqKmvLJlRyduH-qw&oe=6B0F1380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g24WMj-mVV8Q7kNvwFxAab8&_nc_oc=Adr3V-MC_5-KvDZPk_C1VhNO8CTCdkKKOEFGLGRMH8vXolejccM3RRoFR5egUWlc5H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViJeLWvomujsfzD4_pSCC0hXQgiGI7j9CJIap1mX1RrQ&oe=6B0F0336"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86F Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35C Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available and being actively added as DLC.\n\nYour room becomes part of the game.  Planes fly behind your furniture and around your walls, and with real-time environment scanning they can even collide with them. Destroyable targets spawn within your space.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": n
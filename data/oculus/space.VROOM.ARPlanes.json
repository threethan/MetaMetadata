scdn.com&_nc_ss=7f20f&oh=00_AQLWZPcksUVxtJi_x4HmDyNKTLpour_4dr4mXyHn9T19wA&oe=6AB52228"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjq0Ue-IpMYQ7kNvwHHzr3g&_nc_oc=Ado4rEctRs7ailH6hfU-9S5HRPH9Hn1sJHySoOOSfXRhbKirUkwIphCTM8Yeb11WGl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg28e7gzqt0F9i3Fo4t7F-dPnbJEuvN0m89Oom4mdbYg&oe=6AB5266F"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAtxySJMbQkQ7kNvwF81zTZ&_nc_oc=AdroIpsb5_wNutwKytd7kHr0BV3k7RKlaOFhUz6rOOLYpY5rL2-jVasRk0tzZM0tS44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhtphhPfzyQOOOd76IH4pLZmnNbmMPh3ZYh2eftHQ9SQ&oe=6AB5179A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQkV_iZRRugQ7kNvwFbhoPW&_nc_oc=AdoMEuIaLTCSNw3h0x1xLfpykxyjP0UDe7KbRwETONNz2S6ZUZnIl5sRZj-6rt4yDaY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPr2BKRdO6vMXMynNxqtWkWzW09ljjiC1BqYNiNZzs-A&oe=6AB53540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nq61i0_HasEQ7kNvwEHbyM1&_nc_oc=AdpdD5rQxQu08MvUSHr4ChAqNvhpDdZy4KCJzD1qFVAiqejR3mcr4h5lDNx2RbQ9bdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImbfzRnoN29oGWmDAfu9-iAMHWoz-gVbf7RxSx-P2Hvw&oe=6AB524F6"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available, and being actively added, as DLC.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
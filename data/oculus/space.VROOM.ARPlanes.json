scdn.com&_nc_ss=7f20f&oh=00_AQOzNB4SRzHfLebZ4El6yO-GGmF7WarsonA012YkYrGz1Q&oe=6AC8E8A8"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb5s9R1GQNEQ7kNvwGaNZzQ&_nc_oc=Ado75npoyVMic1cGTVutu8qbBGtsFj_SfwtcavBLpOodvzkiTK0djjabbexrNlbNlFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONAzMOhDjb654hUagk9ubjbn9tGvqX82q2hvnWbplMBQ&oe=6AC8ECEF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_eh1Nz9H1wQ7kNvwGOBOen&_nc_oc=AdrUfkpm6Ccubuk5wg9TO_FVUSpYPRSvZMXoiwkZmoG9yhnQKWktElVn3dkeV8hgx0w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf57Nn-Y21jZugG4mP7C_ixH1xNAI6oeNAmc4n1GFJQw&oe=6AC9165A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_H20X_Y8DAAQ7kNvwGkcoIw&_nc_oc=AdoPKVGp9u79v9M3FR-OvJb5a9xQoZLqxuHfmZjdG_hC6-79un9nAS4Boxg7QODKRCE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_CnjF8n0rSLqElfmSQcFaepDz9_n9ohsIiut3aTHRyQ&oe=6AC8FBC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szC9axgVixgQ7kNvwET_AEk&_nc_oc=AdoLpSHNnGA3XD1XcTsEkiapl2PDjXbgXnXwowcwQWqvCmihzQPRIT2aWxI27EDRmbY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMylJPuUEm97Ivxyr4H6XzY_bhbgx-rDIx9TzQ8EWmOAA&oe=6AC8EB76"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and flyable at scales from 1/1 to 1/128.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay, with two available flight models: \"simple\", with disabled gravity and reduced max-speeds, and \"advanced\", a high-fidelity simulation capable of realistic speeds and maneuvers.\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nAdditional planes are available, and being actively added, as DLC.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
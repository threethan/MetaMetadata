3.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJn_SpS1b0AQ7kNvwGW_ur7&_nc_oc=AdrB-M3TsT-lu5g27JDUc2INtgb8C35IodaK9xYDaSl-peb8L5GxLLE8Z1txL8YeYl0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zYRIjJ3z5t1kKowFbUkATkDAnzG5hWPhwlZDPqmf6nQ&oe=69F1F99A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7AvZQgx88cQ7kNvwFQqT7i&_nc_oc=AdqsNNMkB7BOYNlJqD-varvjPyx8AKlwuNkuEX6kkpUxLBehzG7yAQ4H4_bI09e9jPs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tU54984GFnwvipdr8PZsxux-ETh522hNMmQuPDSKevQ&oe=69F21740"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DUUK1waRTwQ7kNvwGxV5hR&_nc_oc=Adr7otG9K-VY-ovEyUDxaXGOEmx2W34DjcOnXTPCsd-2ZcdjSvfP8vV6Az_sUsHR_fI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nbOKqH92NVu8sbeMKfbSPWnPp-JURgL2udnwRjuPkkQ&oe=69F206F6"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1870504550327974"}, {"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED", "id": "4108894889361227"}, {"status": "PUBLISHED", "id": "2310162386136030"}, {"status": "PUBLISHED", "id": "1606504597178602"}, {"status": "PUBLISHED", "id": "2063528141151748"}, {"status": "PUBLISHED", "id": "2550252985342833"}, {"status": "PUBLISHED", "id": "1114445443577615"}]}, "baseline_offer": {"id": "2310162386136030"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1870504550327974"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26406223152375463", "version": "1.12"}, "id": "1741407059854648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26406223152375463"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Reverted texture aniso levels that were reduced in last update.\nIncreased dynamic resolution in full-scale view.\nReduced gear-down distance to 0.5 meters above ground.\nFixed issue where thrown planes may fly strangely when controls applied.\nFixed shadow flickering at certain distances.\nFull-scale planes now always default to ground-level when switched/selected.\nFull-scale view thumbstick now rotates/moves the plane as if it were driving.\nRemoved full-scale grip rotation.\nDarkened full-scale shadows.\nParticles are now pre-cached to eliminate stutter on first use.\nYou can now grab planes while targets are visible, but guns will not fire.\nFixed some UVs and edges on F-22, F-35, and YF-23.\nMk-82 bombs are no long too shiny.", "created_date": 1776981882, "id": "26406223152375463", "version": "1.12", "version_code": 266, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26406223152375463"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": null, "created_date": 1776468855, "id": "26342983522032760", "version": "1.11", "version_code": 250, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26406223152375463"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Fixed a bug whereby A2A missiles would explode when fired below a target.\nF/A-18E afterburners now match nozzle width better.\nGlide-bombs now correctly rotate toward ground when they have no target.\nDisabled Graphics Jobs and moved GPU Skinning to CPU to hopefully fix a difficult to reproduce crash bug.", "created_date": 1776361269, "id": "26329395850058194", "version": "1.10", "version_code": 231, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26406223152375463"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Disabled multithreaded rendering; may fix crash bug.", "created_date": 1775773169, "id": "26258190257178754", "version": "1.09s", "version_code": 225, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26406223152375463"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Compressed suspension on A-10C, F-14A, F-15E, F-16C, F/A-18F, YF-23, and F-35A to match armed aircraft.\nThe X and Y buttons now respectively fire guns and ordnance, if available.", "created_date": 1775508186, "id": "26226611967003250", "version": "1.09", "version_code": 222, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
alse, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28253702704294156"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1791028681, "id": "28389366404061118", "version": "1.37", "version_code": 955, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28253702704294156"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790856775, "id": "28364804396517319", "version": "1.37", "version_code": 936, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28253702704294156"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Improved render speed of Mirage F1C-200.\n\u2022 Improved menu icons for original planes.\n\u2022 Engines now have realistic spin-up/down times.\n\u2022 Tail-draggers now lift their tails during take-off.\n\u2022 Planes accelerate slower now when landed, making taxiing easier.\n\u2022 Wheels no longer spin when in the air.\n\u2022 Fixed roll still being applied while landed.\n\u2022 Fixed an F-117A wheel \"wobble\".\n\u2022 Sonic booms no longer occur when switching planes.\n\u2022 Audited all take-off speeds in Outdoor flight space; adjusted wheel drag accordingly.\n\u2022 Increased input smoothing rate, applied it to simple flight, and cubed roll input.\n\u2022 Reduced amount of turn while banking in simple flight mode.\n\u2022 Made optional nav-lights flash on F-15E.\n\u2022 Tweaked weapon-firing a little to be more realistic.\n\u2022 Added support for \"Battle of Britain\" DLC.", "created_date": 1790093162, "id": "28253702704294156", "version": "1.36", "version_code": 854, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28253702704294156"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790050721, "id": "28246113915053035", "version": "1.36", "version_code": 852, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 12}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
: "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXhQbuS6Yd0Q7kNvwFKfnOe&_nc_oc=Adqdmkve3sNDMyOPyLhVRmJpajnNqNB1TBCqyAVcGjG34lFM7pogGvY54VbQgxxl7dY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1YB71lyHKOxlrV2YtLqAG3atuJm7ooK-Zgu21fjtN6g&oe=6AB1231A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pXOZ43Xpa4Q7kNvwEnNWmA&_nc_oc=AdqyinvmvW3PtVJCypQHX7K5bfatmOoAwhu-r7qF7fgJHM-vY4ozZm-LO5X2pB28BlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb4qyt4wia-pAra3VvgR4hIhEuJOXaNvNecqWc5oSV9g&oe=6AB140C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OC7DyMee83QQ7kNvwFdVA25&_nc_oc=AdrU5PaJHdc9yoOWhKfYUJpt2XOIhJwuCOhk35n7SvfdWbhAh56yw9TJDWuEMzgTZ88&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2sMg_dYSE-Xf8jD1YdsulhHqhNjJtfF17Yx1EUYOIZA&oe=6AB13076"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "870836702557482"}, {"status": "PUBLISHED", "id": "2429440244206100"}, {"status": "PUBLISHED", "id": "2456674221492530"}, {"status": "PUBLISHED", "id": "1341909520714530"}, {"status": "PUBLISHED", "id": "896826746777670"}, {"status": "PUBLISHED", "id": "2422178681639385"}, {"status": "PUBLISHED", "id": "1870504550327974"}, {"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED", "id": "4108894889361227"}, {"status": "PUBLISHED", "id": "2310162386136030"}, {"status": "PUBLISHED", "id": "1606504597178602"}, {"status": "PUBLISHED", "id": "2063528141151748"}, {"status": "PUBLISHED", "id": "2550252985342833"}, {"status": "PUBLISHED", "id": "1114445443577615"}]}, "baseline_offer": {"id": "870836702557482"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789404420, "status": "PUBLISHED", "id": "870836702557482"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28168230306174730", "version": "1.32"}, "id": "1741407059854648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28168230306174730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Improved laser-designated targeting in advanced flight mode.  (You can also target your head, making fly-bys easier.)\n\u2022 Improved F4U-1C rockets vs ground targets.\n\u2022 Improved max gun firing rates, allowing for more bullets down range.\n\u2022 Fixed issue with YawL and YawR inputs working in full-screen mode when only Yaw should be.  (Triggers were causing rotation as well as forward-movement.)\n\u2022 Reduced effect of flaps to 25%, making landings easier and take-offs less likely to stall, but take-offs will now use longer distances.", "created_date": 1789544799, "id": "28168230306174730", "version": "1.32", "version_code": 758, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28168230306174730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Added \"Flight Space\" to the Options menu, enabling planes fly to faster/slower depending on play area size.  (Realistic scaled speeds outdoors!)\n\u2022 Slats now deploy on 15 planes (including DLC) to provide additional lift at high AoAs.\n\u2022 Improved F-86E and Mirage 2000C speeds; they were a little low.\n\u2022 B-21 now has more thrust giving ~50% more acceleration, likely closer to the real bird.\n\u2022 Adjusted F-14A wing sweep speeds.\n\u2022 Added \"stall shake\" haptic feedback.\n\u2022 Numerous tweaks to advanced flight model, like airframe G-force limit being per-plane, roll-authority damping adjusted, etc.\n\u2022 Fixed too-dark AO beneath F-15E's airbrake and F-4C's belly.\n\u2022 Su-57's thrust-vectoring now matches Su-35S's.  (Sorry about that; propaganda claimed it was true \"2D vectoring\".)\n\u2022 Vectored thrust apply to roll correctly now on Su-35S and Su-57.\n\u2022 F-22A no longer has roll-assisting vectored-thrust.  (A website that told me otherwise was wrong.)\n\u2022 Fixed weapon sounds playing near the player for a millisecond.", "created_date": 1789199486, "id": "28112343638430064", "version": "1.31", "version_code": 704, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28168230306174730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Added \"Flight Space\" to the Options menu, enabling planes fly to faster/slower depending on play area size.  (Realistic scaled speeds outdoors!)\n\u2022 Slats now deploy on 15 planes (including DLC) to provide additional lift at high AoAs.\n\u2022 Improved F-86E and Mirage 2000C speeds; they were a little low.\n\u2022 B-21 now has more thrust giving ~50% more acceleration, likely closer to the real bird.\n\u2022 Adjusted F-14A wing sweep speeds.\n\u2022 Added \"stall shake\" haptic feedback.\n\u2022 Numerous tweaks to advanced flight model, like airframe G-force limit being per-plane, roll-authority damping adjusted, etc.\n\u2022 Fixed too-dark AO beneath F-15E's airbrake and F-4C's belly.\n\u2022 Su-57's thrust-vectoring now matches Su-35S's.  (Sorry about that; propaganda claimed it was true \"2D vectoring\".)\n\u2022 Vectored thrust apply to roll correctly now on Su-35S and Su-57.\n\u2022 F-22A no longer has roll-assisting vectored-thrust.  (A website that told me otherwise was wrong.)\n\u2022 Fixed weapon sounds playing near the player for a millisecond.", "created_date": 1789193172, "id": "28111386385192456", "version": "1.31", "version_code": 703, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28168230306174730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Added \"Flight Space\" to the Options menu, enabling planes fly to faster/slower depending on play area size.  (Realistic scaled speeds outdoors!)\n\u2022 Slats now deploy on 15 planes (including DLC) to provide additional lift at high AoAs.\n\u2022 Improved F-86E and Mirage 2000C speeds; they were a little low.\n\u2022 B-21 now has more thrust giving ~50% more acceleration, likely closer to the real bird.\n\u2022 Adjusted F-14A wing sweep speeds.\n\u2022 Added \"stall shake\" haptic feedback.\n\u2022 Numerous tweaks to advanced flight model, like airframe G-force limit being per-plane, roll-authority damping adjusted, etc.\n\u2022 Fixed too-dark AO beneath F-15E's airbrake and F-4C's belly.\n\u2022 Su-57's thrust-vectoring now matches Su-35S's.  (Sorry about that; propaganda claimed it was true \"2D vectoring\".)\n\u2022 Vectored thrust apply to roll correctly now on Su-35S and Su-57.\n\u2022 F-22A no longer has roll-assisting vectored-thrust.  (A website that told me otherwise was wrong.)\n\u2022 Fixed weapon sounds playing near the player for a millisecond.", "created_date": 1789191668, "id": "28111171148547313", "version": "1.31", "version_code": 702, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28168230306174730"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Added an airbrake button. Made left thumbstick press the default.\n\u2022 All jets now have animated airbrakes or flight control surface re-configurations, all prop-planes now windmill their props.\n\u2022 Added an option to disable landing-gear deployment near ground.", "created_date": 1789020176, "id": "28083433657987729", "version": "1.30", "version_code": 670, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
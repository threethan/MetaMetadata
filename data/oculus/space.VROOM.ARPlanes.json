569748753781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqVeWgSrH70Q7kNvwHMRNxy&_nc_oc=AdrFfpxWm5LTlmpwEhx7KjznxB7W-AnynBqSHIIg7FaCx8JscFNC3JTn9hMYx00P9hQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziAAhXNlDlv6Fd_TkKAByU2iA5TUqvSWdDkDWsgK50yg&oe=69CBCCEF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30EfxBOmHCAQ7kNvwEHW900&_nc_oc=AdonI2IOlqafvCxrjeDggPL-9fsHCwgXBf7VUfvmHaleFGqIPW1wbeqGarzGmrjhtMc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpyHkiyXNXEaadbcR_TesNSpMrBuDrKT8nE4a6ssye7A&oe=69CBBE1A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OX7ow_oDPWQQ7kNvwGQWl8G&_nc_oc=AdoAFV75CJDreD0uwbWU8wBz3sM_hkPSQaJUjKoGh-x-EQFiXsSNUHg8JsnlKOYJYAk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKjJXI60y9JmbxyosRAx5M3zD-pqU_zdF1VOuiNNmJag&oe=69CBDBC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjLAqD0XCGUQ7kNvwFrpL3U&_nc_oc=AdpBnJM7UEf24pQ3FiaDr1R12MJTFfq7zjmCzio2TPbbp3iXxUNmHbxaQpnSYb5uvKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwaPTY-u8ReCkMKQCQbjaYw207MGCR-CWIzDOZPF7mvUg&oe=69CBCB76"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and scaled to 1/48.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay (air-density is thick, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane, (long-press) menu\n\u2022 Button B/Y: toggle weapons-mode,  (long-press) toggle scale\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: (model-scale) grab plane, (full-scale) rotate plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connect
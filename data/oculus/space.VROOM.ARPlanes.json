-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2K6YuERrTeo9Ys4A2tWmqDl1Y4GHMUpHQxk-2Ya2h5w&oe=6AA944A8"}, {"file_name": "B-17.png", "id": "1490569748753781", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt-FTL1DZ6QQ7kNvwFBetIO&_nc_oc=AdoxWkQYSSNQnYiM5LBLXMk5fnWrnjjVNXX1Xjtl-qeHWxuoOdk8vS989G5EuDtJ4Ig&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLq86f4W3ZsfJGLlAFA8i81P1XVWzTiCw6qg6sYR3VrEw&oe=6AA948EF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RoitZ6QvuQQ7kNvwHFRyY7&_nc_oc=AdpnXdCfD1ZAHVXS-7vmO5En9PCgm79miee_piVde96ZuUW9qnQcT8PVnojpdySaC7s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDqTCR8HEv6wp1AzkXNQNNY-Ga7_wsAGjiEP3z0xWdwg&oe=6AA93A1A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTyxHBp8IQoQ7kNvwFD_4s_&_nc_oc=AdrDr0dMZt7SqMUG5XxRdTClxlBPYRX2qMnWoKfvrYy5L6ATCha1BGsI9flCTSvsEhU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNp3CQUvW8sRGx_JosUAln1xT43wV__J09dCvqEYBBlA&oe=6AA957C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_3Kfur7wp0Q7kNvwHBI3h5&_nc_oc=AdocLeQUmQdX3zvBpBuvBJ-QodhukLMnI7GQPtSdkyRaq50lWKrulxe8laVt-R9XBMI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7vvmzvmYKvxnLTrqNAEa-Yo1bu435Ka8A-XvRCrcLow&oe=6AA94776"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and scaled to 1/48.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay (air-density is thick, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nControls:\n\u2022 Button A: radial menu\n\u2022 Button B: toggle weapons-mode\n\u2022 Button X: fire guns\n\u2022 Button Y: fire missile/bomb\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Right Thumbstick: (model-scale) plane pitch/roll, (full-scale) move/rotate plane\n\u2022 Left Thumbstick: (model-scale) plane rudder and throttle, (full-scale) move/rotate plane\n\u2022 Grip: (model-scale) grab plane\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more MR scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26986685324329240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499299808_1481056809889054_384679788287468377_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PV8y6616gCIQ7kNvwHHtB4A&_nc_oc=AdrcxBx36lGiaQe3IjpIYDSUlYSWJG9FQb81JYq0VGorsOTVfzXz8XBZrBTt18XzWCQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe6mooyRiptywJlS8Mr6s9sWR8zSBQbLNDrHTkDsH6iA&oe=6AA9650B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AR Planes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1758021480, "lastRevision": {"nodes": [{"id": "24347870678210731", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24347870634877402", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1467466371067556"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverLandscape.p
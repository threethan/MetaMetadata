": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29118858861111865"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Fixed a hard-to-find intermittent stutter introduced a couple patches ago.\n\u2022 Removed unpurchased planes from the radial menu.  Added a single \"store\" wedge to each category indicating how many were not purchased.\n\u2022 Modified the Store UI to display all available DLC packs and planes; added support for 5th DLC.\n\u2022 Shadows no longer create transparency on the runway at times.\n\u2022 Toggling between landed planes now has each plane firmly planted on the ground.", "created_date": 1795636946, "id": "29118858861111865", "version": "1.47", "version_code": 1112, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29118858861111865"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795295164, "id": "29071677942496624", "version": "1.47", "version_code": 1095, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29118858861111865"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795291040, "id": "29071142655883486", "version": "1.47", "version_code": 1094, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 20}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29118858861111865"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Passthrough Reflections now resample the camera if you change rooms, to keep lighting and colors consistent.\n\u2022 Added tooltips to the Options menu.\n\u2022 Occlusion temporarily disabled in Inspection mode.", "created_date": 1793735106, "id": "28818869984444089", "version": "1.46", "version_code": 1068, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29118858861111865"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Fix for multi-story playing where if you start the game upstairs and walk downstairs missiles instantly exploded and air targets moved erratically.\n\u2022 Fixed side-slipping on uneven surfaces like tabletops.\n\u2022 Tweaked dynamic occlusion to keep wheels visible when landed.", "created_date": 1793563852, "id": "28791517890512632", "version": "1.45", "version_code": 1067, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
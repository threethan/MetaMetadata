content-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58hglbsEefsQ7kNvwHdrWh1&_nc_oc=AdnZEmnwblwsufH9Kr1caB9LMDUig7yJlSNYWlpjZrR5bmdEAhxJjdtPWnGRpZ7bvfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAeOpOZW2n802ZtNv0eQ7dSQ4wQyRwVSX09d5aDcwVsg&oe=69AC28EF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19NWY2DgDo0Q7kNvwGhWoPG&_nc_oc=AdmA7XQvaaEGAvSxEgDy2A5JT5W7HX4-jUsMn-9DjVnCqKnrrpwJdX6al8WNKnRxhzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVFKlSAX_MkiffVeX7yv-RoMRWtNHVmTIuGHqxMhG0RA&oe=69AC1A1A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKSh82atJAoQ7kNvwHwEI4k&_nc_oc=AdnercjhiBPwU6j62tdW4Q_4Rjp-7gp2my1OjTc5UDqK3GHu-XqRTLJf2ADPtA0NSUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPtR7ySOrQquXGQpsU8Y0c-1aoLsbLalHXea1j7wUKTA&oe=69AC37C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PU4qCRIni0IQ7kNvwHCdRI1&_nc_oc=Adma-x9At77b0nSSy0o_RcxDWHJx0iEsXP82vLu44NjY4t9Itwjyy1Rl6TPsYS78p80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiuzaynSDqUOXr_TCF7HWuhJSMrcYQaldYKzQgUaFBcA&oe=69AC2776"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and scaled to 1/48.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay (air-density is thick, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane, (long-press) menu\n\u2022 Button B/Y: toggle weapons-mode,  (long-press) toggle scale\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: (model-scale) grab plane, (full-scale) rotate plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "
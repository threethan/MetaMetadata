latest_released_binary": {"__typename": "AndroidBinary", "id": "26627705583560551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Added dynamic occlusion. (Enable in menu; off by default.)\nSwitched to Vulkan graphics API.\nIncreased length of SR-71 afterburner flame.\nFixed gun fire sound continuing after you grab a plane.", "created_date": 1778273773, "id": "26582193541445089", "version": "1.14", "version_code": 332, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26627705583560551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": null, "created_date": 1777400436, "id": "26465771023087342", "version": "1.13a", "version_code": 294, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26627705583560551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Added an options menu on the left controller's \"start\" button.\nAdded a control map diagram on the options menu.\nAdded an option to swap controllers for \"lefties\".\nAdded gun recoil forces; they're relatively small but fun.\nFixed controllers becoming visible due to faster startup time.\nFixed overly-dark F/A-18F ambient occlusion.\nFixed cockpit-tractoring activation outside of F4U.", "created_date": 1777398349, "id": "26465443083120136", "version": "1.13", "version_code": 291, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26627705583560551"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "Reverted texture aniso levels that were reduced in last update.\nIncreased dynamic resolution in full-scale view.\nReduced gear-down distance to 0.5 meters above ground.\nFixed issue where thrown planes may fly strangely when controls applied.\nFixed shadow flickering at certain distances.\nFull-scale planes now always default to ground-level when switched/selected.\nFull-scale view thumbstick now rotates/moves the plane as if it were driving.\nRemoved full-scale grip rotation.\nDarkened full-scale shadows.\nParticles are now pre-cached to eliminate stutter on first use.\nYou can now grab planes while targets are visible, but guns will not fire.\nFixed some UVs and edges on F-22, F-35, and YF-23.\nMk-82 bombs are no long too shiny.", "created_date": 1776981882, "id": "26406223152375463", "version": "1.12", "version_code": 266, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": 
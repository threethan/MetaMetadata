996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19NWY2DgDo0Q7kNvwH3dTQ5&_nc_oc=AdkBMab0mURw71ei37LHoofNecK7ohz4qnsytSwuMRZEFvZiTlwpW_p3s7pzjN1M21w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkABG520Rs3slyI9_SQJDbg2RTJivlXsGYHyuiHMOyNw&oe=69AEBD1A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHixf32WYbkQ7kNvwGeS4za&_nc_oc=Adnu4VHkDoE52VwY7wW9XtzFpa7pIi-Mn9E0vVGa8ElbTghgKScZLLW3AZ5muBjutfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfydI2wQjqb3dqZzUpYO7iRSzPMLrHhdDR7wFoUhpjLaBA&oe=69AEDAC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joEZrRgbc5IQ7kNvwFNSHMN&_nc_oc=AdlfGtlezmknsFYq4f7Qp5C3HoHJqWrFNNvqGVSvLgLOHLpuhAZG-Ed0gcT-f8hqn_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWa1NLX9HVPdQm8uv8wIpFdSBi61hbqIud33Wvw5cAmg&oe=69AECA76"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED"
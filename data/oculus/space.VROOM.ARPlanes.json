=6AF749AF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmmLiSrslmYQ7kNvwFdVfpL&_nc_oc=AdqTOthzmGOlnDSAyNDd48wkvRFzK8jqNorn1qfu-BinbmKofAqfK_yoobU0T95HrJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb-pUx2pcSitbULE5Ih1SQdVENcxq_LryxCEGcF-TXRA&oe=6AF73ADA"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTAkE93aKOkQ7kNvwGuu_iE&_nc_oc=Adra5PU1jYjZjVYPLyY_W7VcMncvYVZAeKb_QFiThZmoO7tZ1rNvmRMvex3vU36Dj0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyu9Mg9gTsB10gzxgZKkfPm-HPKlMwlVO04jxEV0hW7Q&oe=6AF72040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEe6LbNyWQMQ7kNvwGtHgHm&_nc_oc=AdqnPC26vOuIJ-x2GTIFIM5mBFrovWy2VkSsvtxCDH-n9hqZoSNgDoucKzMITozlnnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW3oNDIS0LGoWN5uca0KozwwdwVj1xMyM_2ToiLr7yTw&oe=6AF74836"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1446210657623502"}, {"status": "PUBLISHED", "id": "870836702557482"}, {"status": "PUBLISHED", "id": "2429440244206100"}, {"status": "PUBLISHED", "id": "2456674221492530"}, {"status": "PUBLISHED", "id": "1341909520714530"}, {"status": "PUBLISHED", "id": "896826746777670"}, {"status": "PUBLISHED", "id": "2422178681639385"}, {"status": "PUBLISHED", "id": "1870504550327974"}, {"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED", "id": "4108894889361227"}, {"status": "PUBLISHED", "id": "2310162386136030"}, {"status": "PUBLISHED", "id": "1606504597178602"}, {"status": "PUBLISHED", "id": "2063528141151748"}, {"status": "PUBLISHED", "id": "2550252985342833"}, {"status": "PUBLISHED", "id": "1114445443577615"}]}, "baseline_offer": {"id": "870836702557482"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1446210657623502"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28818869984444089", "version": "1.46"}, "id": "1741407059854648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28818869984444089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Passthrough Reflections now resample the camera if you change rooms, to keep lighting and colors consistent.\n\u2022 Added tooltips to the Options menu.\n\u2022 Occlusion temporarily disabled in Inspection mode.", "created_date": 1793735106, "id": "28818869984444089", "version": "1.46", "version_code": 1068, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28818869984444089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Fix for multi-story playing where if you start the game upstairs and walk downstairs missiles instantly exploded and air targets moved erratically.\n\u2022 Fixed side-slipping on uneven surfaces like tabletops.\n\u2022 Tweaked dynamic occlusion to keep wheels visible when landed.", "created_date": 1793563852, "id": "28791517890512632", "version": "1.45", "version_code": 1067, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28818869984444089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "v1.44\n\u2022 Airshow mode flies closer to the ground, with fewer aborts and crashes. Many figures hold altitude better, and Outside Loops no longer nearly stall.\n\u2022 F-35A variant is now an F-35C, which means no more gun.\n\u2022 The E variant of F-86 has been updated to the F-86F, with 13.6% more thrust thanks to improved engines.  Sidewinders removed because neither variant carried them.\n\u2022 F-14A now carries AIM-7 Sparrow and AIM-54 Phoenix missiles.\n\u2022 MiG-29 is now the Fulcrum-E, with an updated loadout and performance.\n\u2022 Added correct tracer colors for each plane's guns.\n\u2022 Missiles now fall away from the rail before their motors build to full thrust, and launch correctly while inverted.\n\u2022 Fixed air targets flying outside the room.\n\u2022 Airshow: the highlighted \"Figure\" now stays on the one being flown. Turnaround figures count as performed. Changing air density mid-show restarts it cleanly.\n\u2022 Fixed the ground sometimes appearing near eye level or being too high at large scales.\n\u2022 Scale was adjusted on P-38J, F-4C, Bf 109 E, B-21, and 787-10.\n\u2022 Navigation lights no longer blink; only strobes do, to match reality.\n\u2022 The Bf 109-E did not carry a bomb, so it has been removed.\n\u2022 Clipboard specs updated across the roster.\n\u2022 Fixed the airshow card scrambling when the laser crossed other menus.\n\u2022 Improved aircraft rendering performance.", "created_date": 1793140333, "id": "28722482350749520", "version": "1.44", "version_code": 1065, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28818869984444089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793133379, "id": "28721441970853558", "version": "1.44", "version_code": 1061, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28818869984444089"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793020655, "id": "28703332132664542", "version": "1.43", "version_code": 1049, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 16}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
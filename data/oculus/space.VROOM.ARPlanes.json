S3KPFbdkTrus_FqbAPwnRVYw4KffuQp15wJocZdQJ9naPsv0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaW6KZ2LB1bk64G2V8qtMwAC1z6eY6kqlYolCN_yEs4Q&oe=6AA15FEF"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cy0XcJ766owQ7kNvwGT_Kwm&_nc_oc=Adr2k6dkuamZJZAezPTuoPA5mnkI-t1qDcKk6_m7awNxsI6E5pPdDdvMn8UW8NC1ml8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCsoE8gMKga_AvMpYeqjnGfMhFypS28HBL87iw1vB6tA&oe=6AA1511A"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0tLDHbzMr4Q7kNvwFNxjaO&_nc_oc=Adq43wQgQizvl7ceO2ZgwN4nplpyqe_RyamBWHF1L0f_rOqKHX_5MsyJOANszKzp9s8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI3Q-IUwi-oRXm1ftASQFn4cDkMBvBCx2ugK0Y54DmLg&oe=6AA16EC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOJxV6GcrTkQ7kNvwETfC55&_nc_oc=AdowQeHa24duhIp57YjCT8dKiuToc4AhlDmh7EHlC8YJKN16Aca0a2XXXIWBuU7vGtI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGx8JmCNlcjNhTNlFd_j0ZKUk_ioUoOap6M1qa65mOyw&oe=6AA15E76"}, "display_name": "AR Planes", "keywords": [], "long_description": "Fly 17 legendary U.S. warplanes around your room in mixed-reality or experience them at actual size!  Fire guns, missiles, and bombs to destroy targets.\n\nAll models are finely-detailed and scaled to 1:48.  They have proportionally-accurate flight characteristics that are carefully tuned for living-room sized gameplay (air-density is thick like water, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nDesigned for a single controller:\n\u2022 Button A/X: next plane (long-press for menu)\n\u2022 Button B/Y: toggle weapons-mode (long-press to toggle scale)\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Thumbstick: (model-scale) plane pitch/yaw, (full-scale) move player & snap-turn\n\u2022 Grip: grab plane\n\u2022 You can move/rotate up to twice as fast with a second controller.\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.", "short_description": "Fly 17 famous U.S. warplanes around your room in mixed-reality or explore them at actual size!  Fire guns, missiles, and bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24393325243665274"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "2429440244206100"}, {"status": "PUBLISHED", "id": "2456674221492530"}, {"status": "PENDING", "id": "870836702557482"}, {"status": "PUBLISHED", "id": "1341909520714530"}, {"status": "PUBLISHED", "id": "896826746777670"}, {"status": "PUBLISHED", "id": "2422178681639385"}, {"status": "PUBLISHED", "id": "1870504550327974"}, {"status": "PUBLISHED", "id": "2771265693210931"}, {"status": "PUBLISHED", "id": "2380356632426524"}, {"status": "PUBLISHED", "id": "4108894889361227"}, {"status": "PUBLISHED", "id": "2310162386136030"}, {"status": "PUBLISHED", "id": "1606504597178602"}, {"status": "PUBLISHED", "id": "2063528141151748"}, {"status": "PUBLISHED", "id": "2550252985342833"}, {"status": "PUBLISHED", "id": "1114445443577615"}]}, "baseline_offer": {"id": "2310162386136030"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2429440244206100"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27906256832372080", "version": "1.25"}, "id": "1741407059854648", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906256832372080"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788556550, "id": "28014904428173986", "version": "1.26", "version_code": 625, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906256832372080"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788495219, "id": "28004659705865125", "version": "1.26", "version_code": 609, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906256832372080"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Fixed the \"sticking to ground rather than falling on wheels\" bug.\n\u2022 Removed the \"full gravity when on wheels\" workaround for previous bug.\n\u2022 Reduced planes bunny-hopping on take-off.\n\u2022 Fixed F-16C afterburner modeling error.\n\u2022 Fixed F-4C landing gear ambient occlusion.", "created_date": 1787840946, "id": "27906256832372080", "version": "1.25", "version_code": 556, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906256832372080"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "\u2022 Fixed DLC ground shadows being too faint.\n\u2022 Fixed Su-57 not sitting on the ground right when taxiing.\n\u2022 If a plane is landed when you switch planes, its throttle is set to zero instead of half.\n\u2022 Fixed planes occasionally not being able to fire missiles/guns in non-combat mode.\n\u2022 Adjusted passthrough-reflection lighting to be less bright outdoors and darker indoors.\n\u2022 In advanced flight mode, tires now translate side velocity forward, and produce a little drag.", "created_date": 1787791269, "id": "27898746086456488", "version": "1.24", "version_code": 546, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24347870634877402", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27906256832372080"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1741407059854648"}]}, "change_log": "New Features & Content\n\u2022 Added DLC support for \"Red Star Rising\" (MiG-29, Su-35S, Su-57).\n\u2022 Flight now defaults to the \"simple model\" and the options menu toggle has been renamed \"Advanced Flight Model\".\n\u2022 Added a held clipboard with plane specifications in full-scale mode.\n\u2022 Added wingtip vapor trails for jets during high-speed maneuvers.\n\u2022 Laser-assisted flight now puts nose-on-target faster in the new flight model.\n\u2022 Landings and take-offs in the new flight model are now more realistic.\n\u2022 Inverted planes landed on the floor now automatically flip upright.\n\u2022 Glass reflections now use passthrough reflections if enabled.\n\u2022 Engine nozzles now heat and cool more slowly when using afterburner.\n\u2022 Added detail maps to most aircraft models.\n\u2022 Adjusted aircraft years to match variant first-flight dates (updates hangar sorting).\n\u2022 Enhanced ambient occlusion and nozzle animations on F-4C and F-16C.\n\u2022 Adjusted navigation lights across multiple aircraft.\n\u2022 Reduced gravity a little.\n\u2022 Fixed overly-reflective A-10C cockpit.\n\u2022 Landing gear should now deploy above furniture when Room Collision is enabled.\n\u2022 Adjusted afterburner colors to better match reality on all planes.\n\nBug Fixes\n\u2022 Fixed texturing issues on F-14A, F/A-18E, and F-22A.\n\u2022 Corrected overly-reflective cockpit glass on A-10C.\n\u2022 Smoothed transition from stall to flight.", "created_date": 1787696063, "id": "27884606071203823", "version": "1.23", "version_code": 537, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 8}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
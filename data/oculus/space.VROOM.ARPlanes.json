0569748753781", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830027_1490569752087114_1831031766242235099_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2Sgp1QKpJQQ7kNvwHrUUEa&_nc_oc=AdokY28zxxq5oKNk4dee8JPB6eb4fWSyY973LlGeGgeaFesiogHxlaehFSLmaI8HDlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85jFvPvRA7whItoq3vmbfyR8b0DELm1qI6Je6TrKv6BA&oe=6A33F36F"}, {"file_name": "F-16C.png", "id": "1553996282252799", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499315359_1553996285586132_7325089630480731356_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6g5LBYuvFsQ7kNvwG79Ik6&_nc_oc=AdpzygPjEx8Kvh_a2JxIYoKqy85YGrDqBindNgsV9D1iHz5pzzP53Wqi-1gTac1Uwx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98EGZ_hz1ZmQfIOSLCmrZv5LsCGM1M8-IyVEpIzHRfWw&oe=6A341CDA"}, {"file_name": "F-4.png", "id": "659355376764087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825052_659355380097420_8972992984445569972_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NoNZcTh8nQ4Q7kNvwG39AWG&_nc_oc=AdrzOGqJ7dOdzvQMv71yrfihMnkMsEwZD7GwurQYr8v4AD5Ji8kqVKNTU9iSzrfrO-0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_GXzerA-qVdyoZDLYA3XeICxXJfAJ-YqzgnI7OL4o5w&oe=6A340240"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview.png", "id": "1558640238437455", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617850_1558640241770788_373292387739959835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkRf_Q4x42sQ7kNvwEsAd3w&_nc_oc=AdoUUmArI6nRyDT1bp0Ruy9LnsSZ8umKJAhPzGZiWsMuw19nCwFP6U9WCsbAt2xARpY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WuAgJf0R1k3lQjHxPeIzzfel-8IMzwngCOhLXtd75qg&oe=6A33F1F6"}, "display_name": "AR Planes", "keywords": ["planes", "jets", "flight", "airplane", "flightsim"], "long_description": "Fly 17 legendary U.S. warplanes in mixed-reality or experience them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!\n\nAll models are finely-detailed and scaled to 1/48.  They have proportionally-accurate flight characteristics carefully tuned for indoor gameplay (air-density is thick, gravity adjusted, etc.)\n\nPlanes  included:\n\u2022 B-17G Flying Fortress\n\u2022 P-38J Lightning\n\u2022 P-51D Mustang\n\u2022 F4U-1C Corsair\n\u2022 F-86E Sabre\n\u2022 F-4C Phantom II\n\u2022 SR-71A Blackbird\n\u2022 F-14A Tomcat\n\u2022 F-15E Strike Eagle\n\u2022 A-10C Thunderbolt II\n\u2022 F-16C Fighting Falcon\n\u2022 F/A-18F Super Hornet\n\u2022 F-117A Nighthawk\n\u2022 YF-23\n\u2022 F-22 Raptor\n\u2022 F-35A Lightning II\n\u2022 B-21 Raider\n\nControls:\n\u2022 Button A: radial menu\n\u2022 Button B: toggle weapons-mode\n\u2022 Button X: fire guns\n\u2022 Button Y: fire missile/bomb\n\u2022 Trigger: forward thrust\n\u2022 Thumbstick button: afterburner (if available)\n\u2022 Right Thumbstick: (model-scale) plane pitch/roll, (full-scale) move/rotate plane\n\u2022 Left Thumbstick: (model-scale) plane rudder and throttle, (full-scale) move/rotate plane\n\u2022 Grip: (model-scale) grab plane\n\nDestroyable targets are contained within your physical room if you scan it in Quest Environment setup, otherwise a generic space is used.\n\nCheck out \"AR Choppers\" for more MR scale-model flight!", "short_description": "Fly 17 famous U.S. warplanes in mixed-reality or explore them at actual size!  Fire guns, launch missiles, and drop bombs to destroy targets!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroom.space/arplanes/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "VROOM", "support_website_url": null, "website_url": "https://vroom.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "
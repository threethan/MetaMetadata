k@breakingfourth.com if there\u2019s anything we can do to improve the app.", "short_description": "Immerse yourself in unforgettable VR stories.\n\nFeaturing the acclaimed drama \u201cCtrl\u201d, WARP showcases the best of original VR films from London studio Breaking Fourth and others, with new content added regularly.\n\nWe would love to create the best viewing experience for you so please drop us a note at feedback@breakingfourth.com if there\u2019s anything we can do to improve the app."}]}, "developer_name": "Breaking Fourth", "developer_privacy_policy_url": "https://www.breakingfourth.com/privacy-policy", "developer_terms_of_service_url": "http://www.breakingfourth.com/terms-of-service", "publisher_name": "Breaking Fourth", "support_website_url": null, "website_url": "http://www.breakingfourth.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE", "MOVIE", "MUSIC_VIDEO", "CASUAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "658396885510447"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1676909852345813", "version": "1.3.4.1"}, "id": "1955558374769504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application"
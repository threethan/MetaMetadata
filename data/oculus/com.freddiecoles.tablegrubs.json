a5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkkjbgABlUwo8zOCiNQPfDcEM3F22mj3DhibkkRSr1rw&oe=6AFC5F6E"}, {"file_name": "shot_05.png", "id": "1107635441985415", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1107635445318748_3367310240178456543_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezyuciFFoQsQ7kNvwG7HHJp&_nc_oc=Adr5XxmpbKTbRP7V_R3aEVTGpNQzBidj54emCxjzn4o4zMV4yZNWzCwAOKqwPCm6irA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4peqBED6nqnxJ_QPW7_h0HOejjOl4RlcshHVqe1Uq4g&oe=6AFC8232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2527057531111843", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673819499_2527057537778509_8985584218214257215_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXB0ul3544wQ7kNvwFh-oNT&_nc_oc=Adrg4Bkwt0WnMRdatnTtELpdn6pgVC_NKazgtjVknYlr9ZKTHBKsgoZaRnCmR_XANyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0PczXKb3VaVa8aCO-NVuD6Z2iAMxpoJqkVYodiCA6ag&oe=6AFC6832"}, "display_name": "Table Grubs", "keywords": ["autobattler", "cute", "caterpillar", "fighting", "training"], "long_description": "Name\u2019s Grandpa Grub. Flat cap, fine beard, more scars than a garden gate. And I\u2019ve been asked to tell you about Table Grubs. Gather round.\n\nThere\u2019s a whole world on your kitchen table now. Grass, logs, a babbling stream, and grubs. Hundreds of \u2019em, wriggling about like they own the place. They don\u2019t. You do. Or you will, once you catch \u2019em.\n\nCatching. Tweezers, jars, box traps, nets: take your pick. Give a log a good shake and see who tumbles out. Mind your grip, though. A wriggly one will slip right through your fingers. Ask me how I know.\n\nFeeding. Pop your catch in a pen and let your Grubs gobble up the little \u2018uns. Whatever they eat decides what they grow into. Spikes, horns, wings, the works. Some of \u2019em come out looking like a hedge that\u2019s had a fright. Lovely.\n\nGardening. Water the grass and keep it green. Green grass grows big grubs; brown grass grows sulking. And keep an eye out for spiders. Nasty business, spiders.\n\nFighting. Come sunset, an arena drops right onto your table. You lead your three champions out on their little ropes, give the gong a whack, and off they go: charging, slamming, flinging rivals clean over the wall. Bang the drums and the crowd\u2019ll throw coins at you. Win five fights and you\u2019ve won the run. Lose, and you can hear all about how I\u2019d have done it.\n\nAnd when you\u2019ve had your fill of fighting:\n\nThe Beauty Contest: brush \u2019em up, dress \u2019em up and get \u2019em on a film poster. In my day we didn\u2019t have posters. We had mud.\nMy War Stories: I\u2019ll tell you ", "short_description": "Pinch \u2019em, feed \u2019em, send \u2019em into the arena. Back in my day we did it on a table too!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/FreddieColes/PrivacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "MacsonSoundscapes.com", "support_website_url": null, "website_url": "https://github.com/FreddieColes/PrivacyPolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1454088914445128"}}]}, "sc
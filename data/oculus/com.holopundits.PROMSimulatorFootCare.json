ontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974877_1103171838107192_6425505852817823795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hufA7qeuk0YQ7kNvwFY54-T&_nc_oc=AdlYbBnYB9rqmtoNFaP2FYEiL3eh_LKrEi3StLYHB3skJfyiGzzxlvP0J31BHTXA4Ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwa2vQi4ryZUY4NhkShbo1DqMBQ62LMHgw3GPwnMfwW5A&oe=69BD583A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_PROM_03.png", "id": "1096731555516898", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982596_1096731558850231_1005439430629053087_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6NdbBnb7AwQ7kNvwG6IaSR&_nc_oc=Adn3F4AyeBh6fp6nB33Px7dYpoEnKrWEQ-a9dCQDj0ZK5hr6Wgg8yvg93-OPSRPZg9E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxj6hfEuEXQu_TqLGfuep2CPfWkO-zxGFfjfpQ1XAysCw&oe=69BD3439"}, "display_name": "PROM Simulator (Foot Care)", "keywords": ["CNA", "nurse", "nursing", "foot", "training"], "long_description": "In this VR simulation, learners will master the essential skill of performing passive range of motion (PROM) exercises for a patient's foot and ankle, focusing on maintaining flexibility and preventing stiffness. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\n# Learning Objectives: \n- Remember the steps and protocols for performing PROM exercises. \n- Understand the importance of maintaining joint flexibility and preventing stiffness. \n- Apply the correct techniques to perform PROM exercises safely. \n- Analyze the patient's response to the exercises to ensure comfort. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. ", "short_description": "Learn to perform passive range of motion exercises for a patient's foot and ankle, ensuring flexibility and joint health with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8790370767710553"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23979908684996847", "version": "2.0"}, "id": "1104927987858090", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8553212258093073", "is_concept": false, "latest_r
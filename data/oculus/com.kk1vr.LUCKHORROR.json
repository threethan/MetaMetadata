content-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_640314959056606_105426934921712351_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYNPy4IHpt4Q7kNvwHTbxfb&_nc_oc=AdoayJloMY0jG1_TAJHHbvFp8pD36wrJnI-KYkpm8Na0nGnNewIWtZI7NY6D-qE_MSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hnmOHQKpNvZWQtHtQ5hFCl9vTz7OX_g8ISKYL-KLgIQ&oe=69E784CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LUCK HORROR", "keywords": [], "long_description": "Luck Horror is a gripping survival horror game that puts your fate in the hands of chance. Trapped in a nightmarish world filled with terrifying creatures and unsettling mysteries, you must rely on your instincts, quick thinking, and a little bit of luck to survive.\n\nEvery choice you make can change the outcome \u2014 from which paths to take, to which objects to pick up, and how you confront the horrors lurking in the shadows. With randomized events and unpredictable dangers around every corner, no two playthroughs are ever the same.\n\nSolve eerie puzzles, uncover hidden secrets, and face your fears as you struggle to escape the clutches of the unknown. Will your luck hold out, or will you become another victim of the darkness?\n\nPrepare yourself for a suspenseful, heart-pounding journey where luck is your most powerful weapon \u2014 and sometimes, your only hope.", "short_description": "\u201cLuck Horror is a thrilling survival game where your fate depends on chance and quick decisions. Face terrifying horrors, solve eerie puzzles, and rely on your luck to escape the darkness alive.\u201d\n\n"}]}, "developer_name": "KK1VR", "developer_privacy_policy_url": "https://sites.google.com/view/luckhorror/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/luckhorrorthesite/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
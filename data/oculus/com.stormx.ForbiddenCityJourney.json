GeN9dnczY6BGZIvZh_0CX9_yotSa57j_MmceyMbw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGuTnaKV-r2ah-XktMnqa4E34NhmeP2JzRhOwUpYW_Q&oe=6B09C315"}, "display_name": "Forbidden City Journey", "keywords": [], "long_description": "This is a VR tour game based on the real picture. The game has a kitten NPC, which will act as a guide to introduce players to various scenes in the Forbidden City. The Forbidden City is full of fun to visit through the real picture, so that players can feel the solemnity and majesty of the Forbidden City without leaving home. There are also some mini games designed based on cultural and historical events, through which players can have a better understanding of the cultural knowledge of the Forbidden City. This will increase players' interest in the Forbidden City and even Chinese culture.", "short_description": "This is a VR tour game based on the real picture. The Forbidden City is full of fun to visit through the real picture, so that players can feel the solemnity and majesty of the Forbidden City without leaving home. There are also some mini games designed based on cultural and historical events, through which players can have a better understanding of the cultural knowledge of the Forbidden City. This will increase players' interest in the Forbidden City and even Chinese culture."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/83c5217d-e74a-45f7-b7b0-4f8f049537c3", "developer_terms_of_service_url": null, "publisher_name": "BJstorm studio", "support_website_url": null, "website_url": "http://www.tourvr.com.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": 
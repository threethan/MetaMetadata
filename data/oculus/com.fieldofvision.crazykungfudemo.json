QQ&oe=69B2C7A7"}, {"file_name": "75355156_527921577874663_4158103636217430016_n.png", "id": "1123514208108650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031340_1123514211441983_1452257121111977339_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dLQAJqJKPoQ7kNvwE2mrNa&_nc_oc=AdmHWhDsgcvKIqtP1Er1zyfeJdDkmuHO04g2-myrc-IkAgj6hX0hIwc-vFZWNEYOsLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzfm8sxBTRZDLFi3apCoiCbLFfIJuFQvrPaClgE_3UkhQ&oe=69B2B6BF"}, {"file_name": "57569447_1079674609058859_1454685777974788096_n.png", "id": "3255945644682889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_3255945648016222_1653614644280165328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tG2eD9XE_TIQ7kNvwHwVObf&_nc_oc=Adn8l0UrEDka5Z64XYP9LCkceRPO31XO9mSXf4TFsGT_7WdsHMh170MDtWNJCjRK59I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyN5Y7IJV6khqfr311LNYv8nQsczP1wQXx1GWdeQ9X8bQ&oe=69B2A4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OCU_2560x1440.png", "id": "173039931265625", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75617315_173039934598958_8848850547719558253_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCNxHtRW1T0Q7kNvwHUt6YI&_nc_oc=Adn0aA8p2avVUwLP2McxsdduzOrbx6Eo8AJegAvyV1TBDtqukkEP9JPYExfJhJ0E6LQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbRBlK3Rdbf_Uizbu2o7Isn6fN8A7X4d1Ep9FMKWp_WA&oe=69B2AA6F"}, "display_name": "Crazy Kung Fu Demo", "keywords": [], "long_description": "Train to become the greatest Kung Fu Master the world has ever seen. You will begin as a tourist to Martial Arts, with no experience and slow reflexes. You will progressively move onto harder tiers of training, faster and more complex, until you no longer need to think but simply react.\n\nIn Crazy Kung Fu you will fight against a wooden training dummy, using your hands as well as your body to punch, block and dodge the various spinning arms. Throughout your journey you will learn how to be a master at all of these, building muscle memory at first, to then rely on instinct and quick thinking.\n\nAll your moves are tracked, you will have statistics on speed, accuracy, strength, all of which will help you assess your progress, target your weaknesses and push towards becoming a Kung Fu Master.", "short_description": "Train to become the greatest Kung Fu Master the world has ever seen. You will begin as a tourist to Martial Arts, with no experience and slow reflexes. You will progressively move onto harder tiers of training, faster and more complex, until you no longer need to think but simply react."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/CrazyKungFu-PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/CKF.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "419286416617110"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "227901342462695"}]}, "baseline_offer": {"id": "227901342462695"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1618551120, "status": "PUBLISHED", "id": "227901342462695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6230550590371654", "version": "1.0.0"}, "id": "183433330241369", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3747482658678472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6230550590371654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183433330241369"}]}, "change_log": null, "created_date": 1684160476, "id": "6230550590371654", "version": "1.0.0", "version_code": 110, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3747482658678472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6230550590371654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1683790070, "id": "6216669351759778", "version": "1.0.0", "version_code": 109, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3747482658678472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6230550590371654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183433330241369"}]}, "change_log": "- New BRACERS available in the demo! Leave a review on the demo store page and they'll be unlocked in game within 24h. :)\n\nThis is a thank you for all the support in the past year, the game has come so far and wouldn't have been possible without everyone training so hard.", "created_date": 1662448391, "id": "5470140649745989", "version": "0.93.15", "version_code": 91, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3747482658678472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6230550590371654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183433330241369"}]}, "change_log": "- [ FULL GAME ] Complete redesign of Torii Dojo environment. Much brighter, more interesting and highly optimised!\n- [ FULL GAME ] New lighting / textures of Cave Dojo and Hall Dojo.\n- Improved fidelity of reflective surfaces on bracers, so they feel even better in the various Dojos.\n- [ FULL GAME ] New level end for when failing from too many mistakes, so that it's clearer now when this has happened.\n- The lower blades on the dummy now have a shorter range, this is to allow for cleaner fluidity between movements.\n- Further deep optimisation for both Q1 and Q2 to allow for a much more stable framerate when playing in the highest levels at speed.\n- [ FULL GAME ] Added volume control for music (saves between sessions).\n- Added reminder during tutorial that it's possible to skip it.\n- Fixed tutorial board remaining when starting a level after finishing tutorial in some instances.\n- [ FULL GAME ] Fixed multiplier icons not showing when starting the game.\n- [ FULL GAME ] Fixed \"Retry\" panel showing level numbers in Focus mode (there are no levels in Focus).\n- [ FULL GAME ] Fixed total score not displayed in some instances in Focus mode.\n- Fixed issue where red screen fade would remain on screen if got hit exactly when level ends. \n- Fixed issue where if your score was too big a number it would be displayed in scientific notation (Yes, some of you are THAT good).", "created_date": 1659097977, "id": "5362935227133199", "version": "0.93.10", "version_code": 87, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3747482658678472", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6230550590371654"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "183433330241369"}]}, "change_log": "- Matching gloves for unlockable bracers!\n- Fixed issue with dialogue text not displaying properly in some instances.\n- Fixed issue with local scoreboard overflowing!\n- Fixed issue with NEXT plank not responding correctly in some instances.\n- General quality of life improvements, including performance, storage and textures.", "created_date": 1655967220, "id": "5263426533750736", "version": "0.92.20", "version_code": 85, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
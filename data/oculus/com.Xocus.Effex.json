dn.com&_nc_ss=7f20f&oh=00_AQEmBtZoAKOV1XKCFmffs47Z1j37wJd_uWuVDWolwHB-3A&oe=6A95BED2"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdvNMG5evGIQ7kNvwHpy7PP&_nc_oc=AdpE485lhwlt17JiQkww2qIJVKtIhRSpDMo3vtkwtv0Spb1YAK4jkAe5IuIG3iRgGUE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGSusWHjr08u7qlfNU0-WbfNsFdIEfztWOHxxoYuADsg&oe=6A95C1F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hUo6Sg5JEwQ7kNvwFB2K3S&_nc_oc=Adp2-gHvvJoSq-wtvBy5wDpKwKYNTrfwhOBOUr717EX1vmXd4rMy6_WfqGuKgnwqLco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh3zr_RFGKcL0fn3cbk3bbDXAY137oO6GHXZpEyZ3y-g&oe=6A95C08C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
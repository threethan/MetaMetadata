dn.com&_nc_ss=7f20f&oh=00_AQSbog3PET4BE8OvE5U3N8DKBlnseVetEY81XHgjDu-VNQ&oe=6AF35952"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6xLHj5oGYAQ7kNvwHEq91-&_nc_oc=Adpg3CnRbm_6UxM0xIWBxizVj1N85_99-ueagwDYvpcu01LKqOzkunt77wCFDgkpeHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs4ufXecRYR-AaG-iszM2xAWdM1dbJZhfMQLYSEBKgog&oe=6AF35C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhTFegmpMm4Q7kNvwGTd025&_nc_oc=AdrI6msLVJZoJz0z5ganYVJ885B2N3cpR1kZ6UwMZ7x9uJqOJSzsO6svcQmi6Oq4tHw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-fL6wgZd1eUY6JcXHbgVC7bAyd5klmM7xPW520Ytjvg&oe=6AF35B0C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
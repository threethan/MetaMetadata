dn.com&_nc_ss=7f20f&oh=00_AQJmA0dlMx2IbRJSI-C2W6PuXCPqbBM8rrpmZ_UlF1AGbw&oe=6AB67C12"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLislgJdEsYQ7kNvwEk1P23&_nc_oc=Adpi3IKy7ZEQ_dNHzbXZfiCPxHn3vYBbs2F_CdRnpvsa_nqdGCM1bjZ9W912ixTL28E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdkaIIZ-bYeER6aBIIjNrAuBWMCa1eTQQ31jncmlsmKg&oe=6AB67F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYbfLTIIAgUQ7kNvwEO8ZrF&_nc_oc=AdoC5C0bptsey96OgVPuO-OzYbPG_XXLTL2UMpbb4EZfU4wyyCXedcLAE-oJrgzwU9s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVNDiMP77NbrI_REbvRyQvkF7gjwiCy35GqEym1ElqWg&oe=6AB67DCC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
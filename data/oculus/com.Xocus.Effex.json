dn.com&_nc_ss=7f20f&oh=00_AQOkvrCqW0nnCFkKCbYl99kYaa77CU-JOjDkZwa1HyDyaw&oe=6ADE0912"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFT1QunHtm8Q7kNvwGjw2p7&_nc_oc=AdoyanDP84yGuXeL-kS3M71UOvNjaZvT5AFJR2aR1Q6Kg-KK6nGUVA5tmDOtI9KnNB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkBsetwKdHrz1Pppr7lpOSpqQrEl2FZ0-IiOECik_RUg&oe=6ADE0C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0phU_RaSSwQ7kNvwHtD6sX&_nc_oc=AdoXtEL2pfl3fOwC2ZqAIMcgnvfwoXu-JX3N8nigsNdNH2L2JAOfdqIAhYqNLVcOXKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfEkIhoLVxF_7gUK5FQmdd7dnB_AQ6u4N1pu3m_6Wdgg&oe=6ADE0ACC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
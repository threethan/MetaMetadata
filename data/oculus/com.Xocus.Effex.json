&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhPYWGEe4C0Q7kNvwEAwM9N&_nc_oc=AdnvVfpnwe5eJXI0Rl3B6waq2DB72vdDGgXeUgy786rTZ0fgXizv3WGXwKCFUYh4HI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsl5LynhLQpHtup3VPbM94eqQhTlUNX0ZHgbgZbM_8dYw&oe=69A2F5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA00hO7N75kQ7kNvwGaVvlv&_nc_oc=Adl_TAwo4vCM4TllzkTU4GdPEb8A4tbX4n3gguIPuywYmzj2Eyr5SfGjEnCdR1rjixo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPF0x9ZipJ5ROaMimgykr4-tHaS0rpIGflQfRIV0CuEw&oe=69A2F44C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to a world where music and imagination collide. \nDive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "dev
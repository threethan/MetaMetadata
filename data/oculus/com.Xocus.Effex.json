dn.com&_nc_ss=7f20f&oh=00_AQJcSVxriJLYMuFQtUep7BNkFpJvjGPM_dijH_2yJPS-tg&oe=6AB28792"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hC7t94W10JYQ7kNvwFzzYWt&_nc_oc=AdrRXBDtL70o0JgZZHUhUKBS5V9CScLlC6H3nopfVFBG4CjA57xohCDnbZ7c1F2tuFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAGPstP-mRXsULhN0XSyIxARJVpby9VUCwUgpYKQWomw&oe=6AB28AB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2e7zyq_z5wQ7kNvwE-CiFX&_nc_oc=AdpZRkGX8fjajenBEOhtC4hu4cRo7eK1YTN0eUAtBB5YL5O0ffvnX5VySeZh6kY0hVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2-A36YWmbfGbuhLM1SuWybFr2zedWTyriUHCfd0pplw&oe=6AB2894C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQPke-530NV8th_EcqV7vSxk8q4YA8nXqqd0p8uCfG4pkg&oe=6AD22B92"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnrpmhF_S5wQ7kNvwEVsN7R&_nc_oc=AdpGl3Ye2M9XapBnyOv9bsox0UBox6Bw59TmIYTkOP_ZULJ0ejfIa5SXXkWjg5Io4gY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO47TN7fegEuDd9771PYbgaOw5iYX8jI4M1pUokkqeMmQ&oe=6AD22EB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUhs0dxfsQAQ7kNvwGNoGIi&_nc_oc=Adqf108cRPi1YFtQz9nGsxsr0K2hBxjAwksn-1HKMOPjX7jM2B4GiTsXmEhxt6FklcQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV2F-jrDUng0-bZytb3qeimWO2HUsYdWv9gUdcf0IhzA&oe=6AD22D4C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
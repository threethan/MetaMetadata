dn.com&_nc_ss=7f20f&oh=00_AQLcgOocGZbNl5ChANv6Nzz2eRJk3i-U8ivxjlHnHGS3Hg&oe=6A997B12"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdvNMG5evGIQ7kNvwHYrN38&_nc_oc=Ado3inqmNNEFKJngtjlRR5ggtg-hadXKwcJkMfq4R_wGbpQZ7_FlmK1E0kzmvkOCQek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpmo2080Up3JBy7Gdxk-ybk748WSQwY0UETEr1gf7keg&oe=6A997E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1eRuydgv3oQ7kNvwFDq09Z&_nc_oc=Adpq_GPPwUr8QQD0CFM1S6rS-dsg9F5B810_mf6jWc_N_rqDDp1EUWwTVXoHsm2nbXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQALYMlNfmf5YbnEjBV8UJt4AqHaWILBIlR1zdAuB_XA&oe=6A997CCC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
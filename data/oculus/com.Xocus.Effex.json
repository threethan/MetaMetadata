dn.com&_nc_ss=7f20f&oh=00_AQLIgJhNDE9CkP-EsYIlqFyrN9aLE0hUvDh8JD3i8plKrw&oe=6AAA9E92"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf5pX39lAUUQ7kNvwFUtd3W&_nc_oc=AdrDMbOIjMd8t-dRqcdNvxfBaf6XqZbJgfADRvBEmY6QatFM0SZuVFIWyP89gN8hGu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9wv16OniwtcPTje1R_epw7QxJgfryGFK4G6QW0Fecag&oe=6AAAA1B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FmzRemWnUsQ7kNvwFdHolF&_nc_oc=AdqlVW3Jnmjb8uMUUv526zdyHdZP7dnj82YtwJRGHmc5iqG-ZTFO0NsAKLVTxClfvds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyYjA91TfEMJhkQPcVR3DegpL6a5oNjsTUGKJWberGZQ&oe=6AAAA04C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQOzz-41r_r-LLHNUzSaN9bzg_XtZ2L3_azt9sXgesQZZA&oe=6AC64E12"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie3fqMQ6wB0Q7kNvwEipIOb&_nc_oc=Adpej8dcgBteXaaLxAYNEwvUgVHhUBjZpT3jV0ftSKZM5wiD5Z6uV9rWo3TRB_A-N6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1en_bdypHIVYFE-LaD_mY4RT49Qz9Pg8OHZfG6sprsg&oe=6AC65133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkCjZw8ZVNUQ7kNvwF_9sX3&_nc_oc=AdrDPLuzFlV0rhmR7af3qA4OY8ixf9tP8r0Wlxzy8V0fqA9njjLJ4LdKZaXqh-XWFTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlLCNid58lSnPxpcXArG4FmzH3M8ShlgqM6Of8BCTi6w&oe=6AC64FCC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
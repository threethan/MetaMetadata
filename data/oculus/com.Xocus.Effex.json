dn.com&_nc_ss=7f20f&oh=00_AQO_7ZO8RZjK3Ut2UI-g8sHU3k1cLeoPhUiFsYiiQJ1bfg&oe=6ADF5A92"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFT1QunHtm8Q7kNvwGpYnDI&_nc_oc=AdoAX-DF3hSds4afHDQuCgx3UeVyPxjyWtoBlUWEy1-aXn0WpvptGZYI4sy_wsBfp8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi-jj77guxz05aAIYFYzvAm_GFUMBBooKCK6kLG53vNQ&oe=6ADF5DB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0phU_RaSSwQ7kNvwGm--K-&_nc_oc=AdoMT57GCpn7BfXFcS1XonEf51peM8srReXxdx5ytFHC-nj76bC_4lHfA046xW6D60g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYpl_bxtWkXW4slscRL0Fei1hTez1DpegyNHNuGJRDcw&oe=6ADF5C4C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQMBq7qu55cTKHQrrjYjFp2ty73Eh2kTu7urweFPBsIMYA&oe=6ADCB792"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHNUy6H2YEIQ7kNvwF9ZByA&_nc_oc=AdpZuHaAmDvkhvxjmgvpwZVmWj4ZHEne5ZQkI9SMejbpGs4tcEztLnB_ZK1IPErNa9Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXrqFRPvCAKpDAh13SiuVx0WnFp0TQiJM9y_ZujaUXZQ&oe=6ADCBAB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0phU_RaSSwQ7kNvwG1Vqnn&_nc_oc=AdoPQ0AVmVmfeK5Xn-V0EwSFsPso_eqD7n4Y3ieWYKBGrSYcFLEn-DR2OSjNysfT6lk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSuzlG3BkopnCtx-BWqBc28l2g0vmPSUS9SXDR9A96iQ&oe=6ADCB94C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
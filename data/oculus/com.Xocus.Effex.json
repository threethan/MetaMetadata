dn.com&_nc_ss=7f20f&oh=00_AQQtidbYMLAPovNi7si4CDmuuMcDI5ncszOkXJ_mGbwp4w&oe=6AE74392"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG3UzkW1Jv4Q7kNvwF5NJQy&_nc_oc=AdplSkfZpIBVHj9-lC6MMMs15GSDKge1UYihBUSy2Tk7RRB7jQwaOrFOF6TtbiYG-7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkEF2fj-pCmx8ftgmdkBFeEwrQONULbueSO3S_9S_hkQ&oe=6AE746B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a119J-yte4Q7kNvwEhbdmq&_nc_oc=Adrf5wZPf3kAtLNhDPhisH0p3jGi-SorplT0s2EqD2hTBh3nQJGNM4EWhVuR8CD6cGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOqIAVGZwFiu1iRYgN2WdZiFfBcAV5vAO69WyWKMRvaw&oe=6AE7454C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
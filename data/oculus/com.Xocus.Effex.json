dn.com&_nc_ss=7f20f&oh=00_AQKbJdiqCZ-RIv7XgVfyOL-eWAUmAK72D9W-FJf5lH2JoQ&oe=6AA16412"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSI7Bbnj60QQ7kNvwH6MD2R&_nc_oc=AdpS2fateBWZLjhEEJK0Y2TY8-eFmvUPNp4uiCLMLGXcur3l4jr20KaauklYGo1LyAw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsRuXYVBMelemIuJmAoP5SMh5z7KRz_VS0K91t10ouAg&oe=6AA16733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwSFeHF8W4Q7kNvwGseEHG&_nc_oc=Adrx90QrJunq5x2qktTTZb5wkTocX9toXJ_78foQ6TVAqvubmXxB64jnW89My-Ohz3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4W_0bdTdVklJKF2cp423_SJxjHChmxctV4-Sulb0vTg&oe=6AA165CC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
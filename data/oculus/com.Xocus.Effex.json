dn.com&_nc_ss=7f20f&oh=00_AQIBwkVrq6nV3M__fVRc79a8vKMS2OFf8SI4Ckl-8yqv_Q&oe=6AA2B592"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIUIt2a3adIQ7kNvwEgpx0o&_nc_oc=AdqQA8dvPWZZKo5PTm5_i-MiZfwA4DvXdYv2TSy00uZNA3Lyv6WdQ0IHoE6IBzNuioI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP3dTE0hAWmJ4k-ec2TD3KRqo-44s5qRdYG0WM1HLr2g&oe=6AA2B8B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwSFeHF8W4Q7kNvwGcnPwT&_nc_oc=Adpvb17paM71cabGBFkt9AQ02bPFqqO1AL7Pgk0fSbM7qZFeZdFmHbcD_IUEQcFEacE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEtoHDafKXNvM8pw6ot8NLv5WLoVWaXt9ilAXfj_IG-w&oe=6AA2B74C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQKUDBmG7MxG39kM5ZOmOuTvmeKUJeGv9Dw0L8Ri1xGJmQ&oe=6AABF012"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf5pX39lAUUQ7kNvwEMhk9x&_nc_oc=AdrDGWxo3zCYqYFX0HdRxrvY3_t_g9pvuM7mXkyXZdFWOV9kvTWKddYF3veYM6rhQzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILj3Gw6eMxIB_jd4Xv5j8O7IzaNU4rWCaqJHcLZ7tWsA&oe=6AABF333"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FmzRemWnUsQ7kNvwFeMhGc&_nc_oc=AdrEjsE3wfRe7b7iLWbbgbnP7DbMp4YsFz9EZTRFZJ2Khx2Ib3wD-3ccEKgT9hKIu20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8yDmhq8Fv5mFMoR0fqhE9Lxu05QZnJVoHGUSnf3gb4g&oe=6AABF1CC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQOxvCLHObkZXm4RUb1a27YLaBnsvrsVdOnCeW9Rgog4ig&oe=6AD3B552"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnrpmhF_S5wQ7kNvwHRZZ95&_nc_oc=AdorBlySWkx9w7oVrQqnaBS5ZL0tHnbEmp_Wd4S2bb_jq-h4nzTJFcMOBBnLpkqXR2E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSuTTO7HbnDcPFrpbpg0tTwqheRHDiSnVF679pfoQVIg&oe=6AD3B873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUhs0dxfsQAQ7kNvwGEWjgn&_nc_oc=AdqNowPl5Ieo5TGFUcGiRXaR1_jbvYGoCdMHwgkvVvhWBJsQgpmY4vVE8C10YFitmJc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQp8B4QGDpulRLi5ocGCnfmyJ-TU43S_7ar0bWJgXA9w&oe=6AD3B70C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
dn.com&_nc_ss=7f20f&oh=00_AQIOqNkTgsB7k6gd0o0ik3tp6nhBm0Ey0pKaowDy_NDcHg&oe=6AA6AA12"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3U-rKFPQ1UQ7kNvwGEg5vN&_nc_oc=AdqSKLegvfBPBx_QWUA9Kl9G1TuSHjwQA97JeJZPbPT0VG5I0qQvha4LzBjw0LusUcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGZoc9XGEFnKx7M1U3vzBSYn3St-fj3V9FN82UMRgmjA&oe=6AA6AD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1L9wQ8nxuQQ7kNvwGDFHlk&_nc_oc=AdodWilN_aYhioFB0B8MtItQe1yLaZbw7QhWjbki_W4NW8KmeTsw9Cv2VuEizp3An3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS7CfhRt5GbL3mpF66BznsOiDShYJBLcN0MulaDFH17w&oe=6AA6ABCC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
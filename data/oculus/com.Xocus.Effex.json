dn.com&_nc_ss=7f20f&oh=00_AQLlps-L-l1bN4IyghZN-DRPklTqCVI2HNZIO-fbAgEp7g&oe=6AAD4192"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf5pX39lAUUQ7kNvwEFtoEE&_nc_oc=AdopoKJxshblQLyJdjEZDfX_rTYhBiOkYG-5WaAd5UeNGQR4iDGU7NjvAPhG795YYYo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzNb6eUbJ_SMVnlSotC2lnCGSMsXWxQ_vRmXtUBt8_1A&oe=6AAD44B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUxc_3fR46sQ7kNvwHVgOUK&_nc_oc=AdqGEL82WtkZWfPQCpcEUXaKDC17VLa9rXac--7VHkxtyv-wDeelMLtz9s9Kf2eMP8o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp1odtBOYnpP7KW6S7AvSFBWpScYj22telzri8Ar65qQ&oe=6AAD434C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
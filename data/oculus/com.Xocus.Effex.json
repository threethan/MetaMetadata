dn.com&_nc_ss=7f20f&oh=00_AQM4g6VcpYAKSWMvGdNrvJEIiX9qGNgtjpZWjKP8mnDMpw&oe=6AC8F112"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie3fqMQ6wB0Q7kNvwGEEO1b&_nc_oc=Adp4U3lZGJwItGT5UoTG8Xw86gKbZQWf8vi9CkFJxuWVf2TRGyiD5nkinUJ1TlYQP_0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMIxmwclOANZ-bpZTsrJuFCQJ6Kpi4sk4TblaH1maKWg&oe=6AC8F433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEkpBSkV6GoQ7kNvwEE6_wX&_nc_oc=AdqV0s0G4vFtDMQCpBsctJ8KPCN_4uvY9ThBwWka4qC713L7_DBdbnpD0573GTiBC1U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI_CnkBFWjtp_LjTwugytzuLC2_FIKWMIpTIwWFETvlA&oe=6AC8F2CC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
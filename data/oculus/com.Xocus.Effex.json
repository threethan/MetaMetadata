dn.com&_nc_ss=7f20f&oh=00_AQOn9Vv1XbU16gOllel2fgoOi5VgBnmT-4BXn2f9Hl-N8A&oe=6ACA4292"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HuVmjyyXMkQ7kNvwHjpWvb&_nc_oc=Adpr-1tn36AaBvhut0BHrQNUYbDlpOjYrubAcjqXEPtXd2D72F5dVRoeGTHHb4UOOLc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLicfNaMvqUW8n16DzeFO8I0oNE-FX3cJUDZdSE6XLsw&oe=6ACA45B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEkpBSkV6GoQ7kNvwGASxYn&_nc_oc=AdpMSJ_TpUgi2d_sZV_jav04-j-sTkcOiaatlM5BeT9p_1aPdUPD3nk8rnNYUKkZ3RA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZtwrd7SqPiqmMFQWw6OPSckgQup5a2Vnq0hoFNW8EZw&oe=6ACA444C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
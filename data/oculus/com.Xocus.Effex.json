oculuscdn.com/v/t64.5771-25/39031434_907355620797252_4851650263364873562_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZIVBr0w9nEQ7kNvwHFYz-w&_nc_oc=Ado1Cs_1lrzuJycs4aZtF45pq1T1Z1KT4232iVCUd-m023XxzEKcfpZCoRHfV1JiFp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5jWbP9CMewXaa1geBV6sizQjN3AEl2ma1lzBdW4lupw&oe=6B105A52"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh4Vf3cv7ckQ7kNvwHeE7q2&_nc_oc=AdqejPeGv2yVFe4ZzqGUsP5iq6sGdA3TLH-GP2GdaYKWMmZvWh-hVka78l_oc-yFI8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUsDoU5BeCLR70-6mm9MvZ9dNJ9tQHDRSxLjs22K-R8g&oe=6B105D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88th4-1Z290Q7kNvwEwhJ-O&_nc_oc=AdrYNvx0wvIpQRE9KiHKIJYDoYhaiwi7PEGVmlw1CGoyUAPgvqDkYdiKMFE5fiKPauk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUan_bX8qAPhTb4-uF2EaE0fkYXqfiT0_zEpjbOLWB6IA&oe=6B105C0C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to a world where music and imagination collide. \nDive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7249190285145235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307249_1541031456726965_1648229228308135725_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCvHhYfbvPcQ7kNvwHNvh1H&_nc_oc=AdolIboAqlf0g80HDxeP2h-48THng2dGvI7mWRLIuRLXVELvtUSj-PogCyY2l0e2DiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIh8ffn8ZXW2sH0e3RSypp49X9695g1f8FqvlNpYf3IA&oe=6B10473F"}, "is_concept": false, "is_test": false, "is_trial_offe
: "749786666549963", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfi4wFnoYS8Q7kNvwGHvuJJ&_nc_oc=AdryA1TcpJBQSMojESjIds_6oSfLoUyj46p3cMhRktU8mO5vm3RfNlhZvHVbmuDKihM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELfOXhAlTrjGS-Q3ipD8QvQnwIWpfBZpAK2dntsKKLPg&oe=6A846633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIK5yh-eGHgQ7kNvwEuhoXt&_nc_oc=Adr27lH3ZbfORaLKPhKDImNJ_hrWF4wAeNms6nGlxqJkocLzUeyKOc4AZNki3_HDs0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaR1N0nnVTSDvK4oyLiMDTCuThVpfanGi9rrR0pFVdTA&oe=6A8464CC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to a world where music and imagination collide. \nDive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7249190285145235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307249_1541031456726965_1648229228308135725_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV_90DALwvgQ7kNvwEs3Ael&_nc_oc=AdqHL3JxGeBh5GAx17Q4HdWO3bIk1MScVSJqWcFbSk74wK1tteaKh3ioobZfAMjGgco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_fmjsprFCy3f0z8v3OPj6Fca1gQxddS8pQyY1_Zx6Sg&oe=6A844FFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Effex", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1703086200, "lastRevision": {"nodes": [{"id": "7061007907296808", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US"
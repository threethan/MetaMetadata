oculuscdn.com/v/t64.5771-25/39031434_907355620797252_4851650263364873562_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZIVBr0w9nEQ7kNvwGl6LaY&_nc_oc=Adob9fgU9yg94kuH0NyvxHKKTFbUz24AdmTM-xMiiNyUAXJ5iluvVZiRjg0BYfqP1P8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWj12BV55aNMqTYk6efqqccrJ4xkBsMEuMewmGYyvAWkQ&oe=6B0F08D2"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORE4_59JyZ4Q7kNvwHRqVa8&_nc_oc=AdrOEdb2hMggQqTRb66CW9LNjBEYAFcSsTVOlN6MPdTsWp-2o_q8mjsscPNW5V0VjxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6PrnmOx9QmPfUAAI_YoPGU5nkqdEaenJVuc9sBLQVaA&oe=6B0F0BF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfC9Gu_YS1gQ7kNvwFUjwa2&_nc_oc=AdpHTBHibLQPz8al1qjo1zzc9j_B03Qm2b2RPvXk5DNIZZbHfrIktihZPEAehArRwns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_e8jG8uW9CSMFlG8ishY8OSLCywQ5-ETOdCDMLQzD5A&oe=6B0F0A8C"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to a world where music and imagination collide. \nDive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7249190285145235"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75307249_1541031456726965_1648229228308135725_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCvHhYfbvPcQ7kNvwG3RJJM&_nc_oc=AdoTSWo8YsHIVCQhmKJ3lJV39xw7dWPi0qKvsVkiAMiNkICcbEQtomi9oM7wkW5nASw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0KX67ylTq8njVvt_2isjSvZx_WYZ3MCLSvWDws3g_fw&oe=6B0EF5BF"}, "is_concept": false, "is_test": false, "is_trial_offe
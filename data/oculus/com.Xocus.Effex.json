dn.com&_nc_ss=7f20f&oh=00_AQO5Jh19r2A2c0DoEp_CUyrQ5yNQ8J3a31EmBVhPX1pEKw&oe=6AC10812"}, {"file_name": "Screenshot 6.png", "id": "749786666549963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982522_749786669883296_6911877328512519871_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHAj1AGwxOMQ7kNvwFM4caC&_nc_oc=AdqJYcW2p0ARu77yES1CIWw_5EiR7ImF0NNffg6NGvG6j6jObls8s_BINWCkMhbouOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSwS-FUkC29nxlPW0Ljs3ny05mfjcC6b6UxwIVKc5Zog&oe=6AC10B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer img.png", "id": "729686358634004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984449_729686361967337_343675797950022151_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USIvGk2wDAoQ7kNvwF-0dPa&_nc_oc=AdohsKw1auBcIbQVhT347vWMDgYxLqJhX8WEr9v9HqpRygl_d98UoW8tH3dLYkAjfdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRQcL-UzvOa3n6YfLxpf3fHDwoZ-9sEUKB_tMlYUmuOw&oe=6AC109CC"}, "display_name": "Effex", "keywords": [], "long_description": "Introducing an unparalleled fusion of music and immersive experiences, our application is a revolutionary music visualizer that transcends the ordinary. Dive into a mesmerizing realm where frequencies and rhythms dynamically shape mixed reality effects, captivating your senses like never before.\nExperience the music in an entirely new dimension. Embrace the melodies in ways that evoke meditation, dreams, and pure musical euphoria. Immerse yourself in a symphony of visuals that transform your musical journey into an unforgettable odyssey.\nOur app is more than a mere music visualizer; it\u2019s a portal to a world where music and imagination collide. Unleash the power of sound as it orchestrates a unique blend of visuals, meditation, and boundless creativity. Elevate your musical experience to new heights and savor every note in an immersive, multi-sensory journey.", "short_description": "Effex is a portal to 
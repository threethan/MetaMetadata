360799_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2c6bCzjovEQ7kNvwHyaYcc&_nc_oc=AdoNhHD1bwQSwdim-1FyGeNi7CbJPGronG9E-81hQ_PG9V_rqCONRQ1fZkbBqf8XNJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5xm23EZnZYyrVUz5CYU5cnCpGPf0jIhwAGQGX6ELyOQ&oe=6B0F1B22"}, {"file_name": "08_shot3.png", "id": "4104114959725129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_4104114969725128_5712268900840869622_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDZY4OMpP_AQ7kNvwFpuZPn&_nc_oc=AdpSl1i4aUjdgOYIe1w0YelHvSXdnOVysoGkMTTqrcieLxu_GyI2TGEj5f8n5kYKrDA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdC_NN87T8Yc98ep0fduVrMHOAX2tglMK2tYIpSWnKdA&oe=6B0EFC09"}, {"file_name": "09_shot4.png", "id": "1120892117465934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1120892120799267_2280290209762058715_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efPYbZ1bvycQ7kNvwFd7tUp&_nc_oc=AdoTatTpXJaumsDWeyZQShXhIhPMfPG1rVx-J04tWzB_4De9ZHhf6E6Sdpz2NEHua1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6Pt62NEmyESbZXbxpfA6-oaVS4qQcXfLIeMFFnIHpmA&oe=6B0EEE26"}, {"file_name": "10_shot5.png", "id": "1824348242029597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1824348245362930_6867050907058964011_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxP0k58FZL0Q7kNvwEWsSdo&_nc_oc=Ado6WU_rdjObe2DKQZm2B54rH0NexRCgn9JX_FdT8j_WHIzZ7mS78QHcdCBPC7n-i54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUtISyL2v30djAy-EQrGVtQWJXyXS6GdLebj0_e6vL3Og&oe=6B0F2279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_cover.png", "id": "27011640455199958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_27011640468533290_6219711255101958253_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAA1dLAI9j8Q7kNvwHNE4No&_nc_oc=AdoozdX9FN-AbAQQ-NSsOJd8vP38ljQKI2paIJSJDdUiVeyhNK59tSvFP6VSjZV9kXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXy2xACOmCnzODhey6px-m06nQLLn_O8iysQ_MUcGkow&oe=6B0F0793"}, "display_name": "Modern Snakes & Ladders: Jungle Journey", "keywords": ["family", "boardgame", "party", "multiplayer", "jungle"], "long_description": "Snakes and ladders, with you on the board: up to four explorers on a trail that climbs a jungle mountain to a temple.\n\n**STRIKE THE DIE.** On your turn a wooden die lowers on vines into reach. Hit it with your hand, or point and pinch, and it ticks to a stop.\n\n**RIDE THE TRAIL.** The stone under your feet carries you forward, past waterfalls, ruins and a long bridge.\n\n**HOLD YOUR BREATH.** Every landing waits three seconds. The birds go quiet. Then the stone holds, or it breaks.\n\n**CHOOSE WHAT TAKES YOU DOWN.** Nine ways down, chosen on your own headset: the giant snake (Wild or Storybook), a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel, or a collapsing hole. Each carries you through a tunnel under the mountain: root halls, a mushroom grotto, an underground river, a buried temple.\n\n**CLIMB BY HAND.** Land at a ladder's foot and climb it hand over hand: rope ladders, a root stair, a long vine ladder, a waterwheel basket lift, a cliff ladder.\n\n**PLAY TOGETHER.** Computer explorers fill the empty seats. Play on the same Wi-Fi with no internet, or online with a six-letter room code or Quick match. Voice chat is on in private rooms; with strangers, only if you both turn it on. Mute, hide or block anyone.\n\n**COMFORTABLE BY DESIGN.** A level horizon, a view the game never turns, a comfort vignette and a Gentle preset. Standing or seated.\n\nThree trail lengths, shuffled or classic maps, house rules and a journal of every ride.", "short_description": "You are the playing piece. Strike the hanging die with your hand, ride your stone up a jungle mountain, and hold your breath for three seconds on every landing: safe, or the ground gives way. Climb ladders hand over hand. Choose what takes you down: the giant snake, a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel who says \"Sorry, dear\", or a hole with no creature at all. Play solo with computer explorers, on the same Wi-Fi, or online, up to four."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/modern-snakes-ladders/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1430563799252655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1102409952396654_3050805399925152101_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Lu2X8q7ChQQ7kNvwF2ZCGW&_nc_oc=AdqY4pfMox_rNAz2KTqDS7O8Pyw_oj5jszFQZoPXcVOMD21_bz4U4GeybsJPcvI1u7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBILrBj3sqbSvZxlFqXigMpaTYi88FiuqSPCvV94eqUw&oe=6B0EF9E8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modern Sn
360799_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24OasTds33cQ7kNvwGogLPi&_nc_oc=AdrdP_SRpYzAWqFdj5lk4CrEYSasDRdjwbf6hSUFB4nMuLK3rITdhHZEp3jJiNyInf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmcVuaV3WxsKQVQlJwH-QMpmP-KwT6iexPjuGA3r6m9w&oe=6B0DC9A2"}, {"file_name": "08_shot3.png", "id": "4104114959725129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_4104114969725128_5712268900840869622_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDZY4OMpP_AQ7kNvwHH7s-w&_nc_oc=Adpu6cQr_rllE3RWLKlTFj7lng_IVrq3zaiHxApYUL5m4DktnSd-GucedMVZseSVy-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTe_2oo1BbPUxPSTmRSbpUlMgkwOF5GGIkiK48pyrGYxg&oe=6B0DAA89"}, {"file_name": "09_shot4.png", "id": "1120892117465934", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1120892120799267_2280290209762058715_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zALuIM6kfuoQ7kNvwFdvsmn&_nc_oc=Adpu3-ZGKHkJ2N0Uaq-zBExYsDCSxmgqESlSsHeOPS3jax6-pPLDQXoUJ8tJCWnZdSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3uUuPcZOHyky9RV3-LEJeHV48PDbXgBK_WK9iLuKVhA&oe=6B0D9CA6"}, {"file_name": "10_shot5.png", "id": "1824348242029597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_1824348245362930_6867050907058964011_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTXHvc9DLZwQ7kNvwHkQn_h&_nc_oc=Adr7YpAhMm5dfKAlVTbqofFjCOOXhpJSy5N4de_Qg2aKRKm7kHD4QIukhbSDF8ORWHo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT81YEZ8l9tnPGLjVFJPLnc8Qq1XEyBIFCjTmWgd7dG7w&oe=6B0DD0F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_cover.png", "id": "27011640455199958", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823837_27011640468533290_6219711255101958253_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAA1dLAI9j8Q7kNvwHsZ2qg&_nc_oc=Adq5omgLxOaDolQAKCeEOfwq1VMiRyeKp-bAOuTFJblNGjsmXmYDq2jAvp5z-ckW4co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRv4dKe0pECoQX-2-T4TcPHeXAjYix02qEOUpyGg7rBcw&oe=6B0DB613"}, "display_name": "Modern Snakes & Ladders: Jungle Journey", "keywords": ["family", "boardgame", "party", "multiplayer", "jungle"], "long_description": "Snakes and ladders, with you on the board: up to four explorers on a trail that climbs a jungle mountain to a temple.\n\n**STRIKE THE DIE.** On your turn a wooden die lowers on vines into reach. Hit it with your hand, or point and pinch, and it ticks to a stop.\n\n**RIDE THE TRAIL.** The stone under your feet carries you forward, past waterfalls, ruins and a long bridge.\n\n**HOLD YOUR BREATH.** Every landing waits three seconds. The birds go quiet. Then the stone holds, or it breaks.\n\n**CHOOSE WHAT TAKES YOU DOWN.** Nine ways down, chosen on your own headset: the giant snake (Wild or Storybook), a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel, or a collapsing hole. Each carries you through a tunnel under the mountain: root halls, a mushroom grotto, an underground river, a buried temple.\n\n**CLIMB BY HAND.** Land at a ladder's foot and climb it hand over hand: rope ladders, a root stair, a long vine ladder, a waterwheel basket lift, a cliff ladder.\n\n**PLAY TOGETHER.** Computer explorers fill the empty seats. Play on the same Wi-Fi with no internet, or online with a six-letter room code or Quick match. Voice chat is on in private rooms; with strangers, only if you both turn it on. Mute, hide or block anyone.\n\n**COMFORTABLE BY DESIGN.** A level horizon, a view the game never turns, a comfort vignette and a Gentle preset. Standing or seated.\n\nThree trail lengths, shuffled or classic maps, house rules and a journal of every ride.", "short_description": "You are the playing piece. Strike the hanging die with your hand, ride your stone up a jungle mountain, and hold your breath for three seconds on every landing: safe, or the ground gives way. Climb ladders hand over hand. Choose what takes you down: the giant snake, a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel who says \"Sorry, dear\", or a hole with no creature at all. Play solo with computer explorers, on the same Wi-Fi, or online, up to four."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/modern-snakes-ladders/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1430563799252655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1102409952396654_3050805399925152101_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R_W9jznPEsQ7kNvwF4uyYw&_nc_oc=AdqrbBdmoKDRMXOFnWOkdUrFuZm0s06TCaGlyGKZs7zVn0hNdc2ZZ-ryi8jdKJKhyEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROE9qHa-ZUfoRu585bmd-LUsPygfYaIj0svN6ULALqYw&oe=6B0DA868"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Modern Sn
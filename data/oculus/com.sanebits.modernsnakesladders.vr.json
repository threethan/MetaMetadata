=24OasTds33cQ7kNvwEFTPvI&_nc_oc=AdqHxrLxy8kn2lLHsA2LvhHgA2ef83HXjT3K2_OCKgNkIlau61mQIWDxnfHjWN8qAEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMQhwEsmJkw7vLYuLa5ptL3eBkmqltADe_O30oZSqbHA&oe=6B0C7822"}, {"file_name": "08_shot3.png", "id": "4104114959725129", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_4104114969725128_5712268900840869622_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDZY4OMpP_AQ7kNvwFdLSn5&_nc_oc=AdpSYEqgtk_pScYt6o-VuxuuS-JAL4LieN7VEsi5CBeRiO2TW-hz1W9F4mO5AopSi-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRORRJXmlzickALxt9of5bck9gm7kC523QkR5Hh35nt2Q&oe=6B0C5909"}, {"file_name": "09_shot4.png", "id": "1120892117465934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821704_1120892120799267_2280290209762058715_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zALuIM6kfuoQ7kNvwHtd6YZ&_nc_oc=AdpQtdH27e6gtsM6h3UeWpJVMSWaQXnMy4mcw-14b8dpqY5Mptl-GdRfvtz5e-vq634&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaBHXQ98DcNLK9z6LUFSknpGxvyxbq1OuK_yk5YAKXmw&oe=6B0C8366"}, {"file_name": "10_shot5.png", "id": "1824348242029597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1824348245362930_6867050907058964011_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTXHvc9DLZwQ7kNvwGDxSAQ&_nc_oc=AdpaLEla3XRhuR7SNmDe4GABJlGC9EJExFCBsNIoiR9AsFODtqYhwfiEV9ckXFXltpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqJL19PzgmIQoVuHH0QKYpFIUhypS7mEOQCdCy1YyAOw&oe=6B0C7F79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "11_trailer_cover.png", "id": "27011640455199958", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_27011640468533290_6219711255101958253_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAA1dLAI9j8Q7kNvwF1p10K&_nc_oc=AdpeOH-ursB6tDguwvXrwN02gpeFJZmnog9PJpt313deBu-ddT42NzlktstuDm9tTmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ67B-cwOw1bpflNeEofWy6q_cwvteT8XAWyXiyynAzDg&oe=6B0C6493"}, "display_name": "Modern Snakes & Ladders: Jungle Journey", "keywords": ["family", "boardgame", "party", "multiplayer", "jungle"], "long_description": "Snakes and ladders, with you on the board: up to four explorers on a trail that climbs a jungle mountain to a temple.\n\n**STRIKE THE DIE.** On your turn a wooden die lowers on vines into reach. Hit it with your hand, or point and pinch, and it ticks to a stop.\n\n**RIDE THE TRAIL.** The stone under your feet carries you forward, past waterfalls, ruins and a long bridge.\n\n**HOLD YOUR BREATH.** Every landing waits three seconds. The birds go quiet. Then the stone holds, or it breaks.\n\n**CHOOSE WHAT TAKES YOU DOWN.** Nine ways down, chosen on your own headset: the giant snake (Wild or Storybook), a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel, or a collapsing hole. Each carries you through a tunnel under the mountain: root halls, a mushroom grotto, an underground river, a buried temple.\n\n**CLIMB BY HAND.** Land at a ladder's foot and climb it hand over hand: rope ladders, a root stair, a long vine ladder, a waterwheel basket lift, a cliff ladder.\n\n**PLAY TOGETHER.** Computer explorers fill the empty seats. Play on the same Wi-Fi with no internet, or online with a six-letter room code or Quick match. Voice chat is on in private rooms; with strangers, only if you both turn it on. Mute, hide or block anyone.\n\n**COMFORTABLE BY DESIGN.** A level horizon, a view the game never turns, a comfort vignette and a Gentle preset. Standing or seated.\n\nThree trail lengths, shuffled or classic maps, house rules and a journal of every ride.", "short_description": "You are the playing piece. Strike the hanging die with your hand, ride your stone up a jungle mountain, and hold your breath for three seconds on every landing: safe, or the ground gives way. Climb ladders hand over hand. Choose what takes you down: the giant snake, a lion, a gorilla, an eagle, a crocodile, an elephant, a friendly long-neck, an angel who says \"Sorry, dear\", or a hole with no creature at all. Play solo with computer explorers, on the same Wi-Fi, or online, up to four."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/modern-snakes-ladders/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "SINGLE_USER"], "id": "1430563799252655"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1634651608111179"}]}, "baseline_offer": {"id": "1634651608111179"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794315300, "status": "PUBLISHED", "id": "1634651608111179"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1430829035892798", "version": "1.0.0"}, "id": "1596074468400184", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__type
tent-atl3-2.oculuscdn.com/v/t64.5771-25/491821796_1721261342233338_6468729975874486593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWdCT_yQIKIQ7kNvwGSD1YM&_nc_oc=AdpLl4o8xVXae8jKcyKvgsUV-ChLk0hLf7IrN-Qc_CeJ5T1u7drqk61FdATzRXXoNxw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjOesf4A_QyYAXK2xFrXRdR4YLPyEKgN6lyuwfCCnGvg&oe=6ADCD57E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eeyz_gnPJNcQ7kNvwGLqtzP&_nc_oc=AdpWuOGkx2c5XCMGMsXRaoBKABJjgc6yTRTJ0eRag0rU2vWn9NKQLGlbMpsNEFdBdN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxYFhaAfJu4MZHnkDCIE-itojFjhxmuI5o7UQI53BJCg&oe=6ADCC8F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UsmpxlGFscQ7kNvwGOw76F&_nc_oc=Adq-MLrsDWhvv8DHpGfh1e6nfMkX0NyzQMGj3zddZICKS_bAbFy0ve0mXEGPMSX0bvg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGPqQdWLv1FYiGH3uHanHn-s2Ei7b57KlXMjxC2faK5A&oe=6ADCB01B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7buobfWD268Q7kNvwHOsuBi&_nc_oc=Adqk4jPbmYtHlH6DEiHMlA-0zg591H2929f-NsxIroJr1h8NORtXigKDBsDQ_zcRDpQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHxSgQ3F4v4zRR7nxlirL38QzYmR0fUe2qX5V9tqeYHA&oe=6ADCD85C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5BU6XdxOYgQ7kNvwE2ULsT&_nc_oc=AdoKYCpvxgeaQn4BXnZMpvbvrTvrezAq3ZtovDNDE1OfR6q8Iw2z0jKPLo_8jV4_HM8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYT4Hv577UazAcqimN8yRm6Tcc3UO5AdZlCRCuhByLEw&oe=6ADCADD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27669335322722109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821115_2068180610411624_4781100417723082299_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOYczMO4dxMQ7kNvwGkc1gX&_nc_oc=Adq8tGSn-rAWxT3EsgMyjPdPb-pcE-Zo1dTP8pcZXvo-pufemg8hjYVBTaxw8UAeOrU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpqnkqT0fSDmC7LsWfjj17a7_yNPSUIA78IehviTGKjg&oe=6ADCBAAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Skies FPV VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1782328140, "lastRevision": {"nodes": [{"id": "25773897985599195", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default
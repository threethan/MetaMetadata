tent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1721261342233338_6468729975874486593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozoJj9ZJCFEQ7kNvwFJXiHh&_nc_oc=AdpDRPBggW3CIQ62eKJyd0Z7_Nlhtv3CCv8EEpilqFxyLIVaBdbHKJFuPnbz0x-01g0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB2wbrAd9Gs2o_soxgP1fq7wsec6XxRW83YJpqOF7OWQ&oe=6AEB55FE"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDnpjtaHRpkQ7kNvwFGamX1&_nc_oc=Adoa2Wstse5RAfVz_3gLwuWPQ54K_HB-hqgm0bFrEr7U_11MwVKBiCMPY2Gv6apQ55Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_E5D6szzdeJq00HxOjdsE1YDtM-u8iACG4gaxEjxLOg&oe=6AEB4979"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGrN4dEWSroQ7kNvwGbqNVQ&_nc_oc=Adpu6VRG6-CSmP6pHm0F0BExa6MuL_B82IAGtohMfpmlXT1H21IcMMqnprG6RlLqVtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnl5RLL8ErRbjKaHf1MJB1CFuZhS_s9fSHTHSYyNBTqg&oe=6AEB309B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbOqJKWoXyMQ7kNvwFKu1LQ&_nc_oc=AdqwRg-E-L19UGSM41n9L-ApgqKxMHhqfujy3EUHrHkHJSXSKDCwiC5Ob94ER28OKAg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrBCWX6TgtaGWiX35ryx2AZ1sFN_yfcIHOQMGD5qQ_9g&oe=6AEB58DC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1Fpjie8dbQQ7kNvwF6oD2d&_nc_oc=Ado_iyl0Zk9wvDDGGnOToyzeGDrokyog5QXEcXhVi25XAeaRA0g-_O4JUPfOeRaykGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSZ56F3GssedrPa1iXLIBcUAwJUUe1WzHcwNOMLbgEiA&oe=6AEB2E57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27669335322722109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_2068180610411624_4781100417723082299_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fKpvANdUQkQ7kNvwFkTG-b&_nc_oc=AdoDmpIG5eZPjtgekJGCtQhSOYY2KX2JqGKqbEEz9pTj3nX3ygcGXdS5ofwMZDsR608&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8pgUo4anFEcHJFGGBz4fm7tZIFmtSDi9jJOtMEiRl7A&oe=6AEB3B2E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Skies FPV VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1782328140, "lastRevision": {"nodes": [{"id": "25773897985599195", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default
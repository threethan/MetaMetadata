0a&_nc_ohc=WjZyAOCdNSIQ7kNvwFR1Qff&_nc_oc=AdpqSh71FvtrWKwf05_o5sW5NXD1j7dTKelP3IlYovc9AMCct49jIz7f7kCO1zCdJdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgkPGp7hbX4zU-l3ad1KJPy9Uh9W0TPVhhtXA9HsyYuQ&oe=6AC66BFE"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YUI5DBOLPwQ7kNvwEbNCJj&_nc_oc=AdpYc6iKu1fNXx3_LkfDN4I4BdXDggiWo2yNGxGecYJaZpac1Jj7C5xr2X7ECzTcKy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMH9ei98ufTuAvWfTPyb9YWqhrehbPCVE-fOkXZNPeP4w&oe=6AC65F79"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klAuAXJLOtwQ7kNvwESmBpf&_nc_oc=AdpPFFOalikSKjZD3wOabRY7Zpq3Z0uoaPAT7lj7iWJ-tJpi56c8omCf1vT5h7EWYkE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgrKfOIMV4HFl59lr7_XlXjzqVBS47Um87TLPP8KgX4Q&oe=6AC6469B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy0BxD-d9RUQ7kNvwGGTUc1&_nc_oc=AdoEJi0gzW04Pjk0QqMASXFYwXqwb8gdNt3mzHjqepxrPXIkYN09awUSBX5Ir7GS7GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAPI_7RwsqkFFxvMPDTjyLrMQGH6b_8KO7edH7_iECDg&oe=6AC66EDC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pChuHfDpJQsQ7kNvwH1A1iD&_nc_oc=AdojozecaV_qxQhR2lSgGR0PytOdV5DNrN2mAb3vea9PIuk-ybl9BPHIH8nz5vaY-CY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFQvlbdn3iHtSV1tcPPD6-T9jS9ccXNw6wv9qMuiemIw&oe=6AC64457"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
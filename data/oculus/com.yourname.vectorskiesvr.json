0a&_nc_ohc=WjZyAOCdNSIQ7kNvwEAdk3Z&_nc_oc=AdolxpwwktNhhIrwT7egnJrASKOdoIClvjjAqr15FaywN0oNNCqbCxxcAMKU3FKyKow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8CHBl6P1p-mJGiO7XC2C0t3dxAK4xX70rbFVZJ9Dzgg&oe=6AC7BD7E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YUI5DBOLPwQ7kNvwGWgyzC&_nc_oc=Adp2ZhBUWmGexNZDZDV4k1yiQ1fHVpr7qCw0ibTW3Sa5NwY7umXYIc4ctAfHlDkvJLM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3kBrim9woTy31Nm8r1yuU6Y2xFtiSwTpd8aJKc0fP5Q&oe=6AC7B0F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klAuAXJLOtwQ7kNvwGQZ-LR&_nc_oc=AdpTVEOHIEeXUqtOGkvJi6vFpx9mVc1BZ70I28v-mR8M8HbNgBzv49KsC98K1_heZXE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwsLg3ew50458N14XAvzDv31qiQIixMys9rXkdKt1hLQ&oe=6AC7981B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iy0BxD-d9RUQ7kNvwE2XWv7&_nc_oc=Adolh_Bkpfq2Iwx31YfzRHv7Zic7NxiFNbsnKt4y2rtgdtLcps5IuB0fyqXtf0msX7Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORiJOjpzIxF1KqTWiXSo6mvZcWke6GDQYKFjrtDeda7A&oe=6AC7C05C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0zsiCGzkskQ7kNvwGi15ej&_nc_oc=AdoserIl1NpnzrKBaaHDyFbq2pZOEOErppnlrfZ6Y2R9a2TLw6CTP6GqP0f8OLACj44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsZRLlT-d9wdKgZRhnUPh8EYi_Tha7S-iuyzm0ANQApg&oe=6AC7CE17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
rname.vectorskiesvr-20260216-205602_2560x1440.png", "id": "26020642577554915", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820578_26020642584221581_9213595297666661728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQMGR8j9UU8Q7kNvwFyn9hd&_nc_oc=AdpQx1D2o_-9aZo7D_wg8vteKPaZE173bQpnUk6C3pkF-uT7t30H31oatBAUcDYCJro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMLmcSyYilp9UZVQ3QjavNGmJrXqzcMXyFXRIXhi-RJQ&oe=6AA6970C"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205612_2560x1440.png", "id": "1218367597051133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_1218367600384466_1117934431436662153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHhYfKf-MgcQ7kNvwF3It7f&_nc_oc=AdrNd3msNnsGuBV6ZbUqIWMzs3XtV1BuyfQfvpda6oX9uB94urYpr52JaPywWTAv85Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8mbk3T3n-lNIrdtl3keBKYD2dgR_HY4nRuPXTeZJRaQ&oe=6AA6C565"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205642_2560x1440.png", "id": "2035896726953586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_2035896730286919_3142292759866806155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ_D2fGuBXkQ7kNvwHsFsbe&_nc_oc=AdrQFSzMtw_AaXg1oUq0PQzis55S4ymbni-S1_A3q7VrNp8ci12Wu5H1mNgWF7rc5P4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVLKdhH4qVi7ZzCGwhv9kRE44wuQLlJMUa8yPTBooVMA&oe=6AA6C16E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25773897952265865"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1589265536181436"}, {"status": "PUBLISHED", "id": "1428281625785189"}, {"status": "PUBLISHED", "id": "2397029197488547"}, {"status": "PUBLISHED", "id": "1633715728056555"}]}, "baseline_offer": {"id": "2397029197488547"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1589265536181436"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28097943013194669", "version": "1.21.2"}, "id": "911297424825721", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28097943013194669"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911297424825721"}]}, "change_log": "## 1.21.2 \u2014 Live Cross-Platform PlayFab Progress \u2014 2026-09-08\n\nShared progress update for live PlayFab scoring and achievement reporting across the supported product builds.\n\n### Added\n\n- Added live PlayFab `BatteryHighScore` submission whenever the active score increases, while retaining the finalized battery result as a safety submission and compacting offline retries to the highest pending score.\n- Added PlayFab `AchievementCount` updates after every confirmed achievement unlock, with login backfill and offline retry shared across supported build profiles.\n- Added a `-steam` suffix to the sanitized Steam persona name synchronized to PlayFab in both Flat Screen and Steam VR modes. The suffix is retained within PlayFab's 25-character limit and does not accumulate across launches.\n- Added `Fly full 'pack' to see score.` at the top of the shared start-menu instructions for every build profile.\n\n### Changed\n\n- Steam Development and Release players use the Steam ticket provider instead of falling back to an installation Custom ID. Authentication requests use the service-specific `AzurePlayFab` identity and the same Steam-backed PlayFab player in both presentation modes.\n- PC local unlock counts and Steam-confirmed achievement counts now publish to the same global Top Achievers statistic used by the Meta and Xbox paths.", "created_date": 1788897718, "id": "28097943013194669", "version": "1.21.2", "version_code": 2006, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28097943013194669"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911297424825721"}]}, "change_log": null, "created_date": 1788638390, "id": "28061322590190045", "version": "1.21.0", "version_code": 2005, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28097943013194669"}, "release_status": "RELEAS
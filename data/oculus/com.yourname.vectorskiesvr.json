tent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1721261342233338_6468729975874486593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRQVgJzOBCgQ7kNvwHcG98N&_nc_oc=AdoJ3CltNAK1zAxwVxGYtOCsSJqYMWoNNZOF0o_UJRm-IHvp8202zrqAv53QEAjjkHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpV7DmHGjNPb1oOhvfcnUWDvpy9zZtkSdk9WCT5_74xg&oe=6AE7617E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aejWF33Qv08Q7kNvwFoR7zC&_nc_oc=AdoXNIx0NELZnKFjHgbIyb9Y6H5K470brGAfsMBnx11Pc_kbeuMLyqMqlLXKr_Vd3Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXtLs15jyzdxSGQPo1PifxA-XfuO-Qd7Y1TYwUwcTzCA&oe=6AE754F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV-q9B8O4qgQ7kNvwGvs6YD&_nc_oc=AdrMfOGV8zHlUDdHEhYnPQPHxa1c8u23lfC-7Jd7-AlSssCzg99p3vw4AA59qZPB2EY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmYN6G9M-JeNkaJUepu-LcgLCK3iw9Ytyu7P0Gmg6sLA&oe=6AE73C1B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wE7ZqL3C8sQ7kNvwHJ-_Av&_nc_oc=AdqB9_h8k-X4oHf3ZyDtyrsZLHcBGNKHGW4Oe7zrekEZqrkSHMxcKsDrU2sGV1fukt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm5lh2zBQS13SxLuTABzOUJEKOVCkBs5JNRv4iDeFtOw&oe=6AE7645C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOReYYFRFfAQ7kNvwGldE0w&_nc_oc=AdpxBpQfccqnIsw98-JYtBTufm48X9JjsItwicGsOfLScI8xGue082sTn7vrqP1me9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKCabEb2_znu-HycFzlZiC57PifxEhD1kWPonofwFvEg&oe=6AE739D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27669335322722109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_2068180610411624_4781100417723082299_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VcU7w6FLWmwQ7kNvwG31R3E&_nc_oc=Adq2lKb5rXXMr3q5BKHp_jQnAQ7zakm33dBTqREmtIpZlCuqDnYx9EdD1tksxVLPVlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZLyI-v8ynpVHK-lV3sySuTmK3xOEwFnuAPmfApIKtzg&oe=6AE746AE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Skies FPV VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1782328140, "lastRevision": {"nodes": [{"id": "25773897985599195", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default
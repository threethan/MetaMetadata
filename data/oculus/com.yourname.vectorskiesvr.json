0a&_nc_ohc=1wojK_OUFLIQ7kNvwGeizaQ&_nc_oc=Adr5DYwksuYQKK2O40GpDA4yDAEuFotcCU62fmahcQf0rSYqrOyYSU2tt-cvvZ4w4d4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjNFNeI3l5WKeLXlcKpFobCsb1UBNlEVmSZcDGnCO96w&oe=6ACBB1FE"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGtaoWI4Iv8Q7kNvwGv49n_&_nc_oc=Ado7oBYKCd2Yw2kLEC4XGx5_vWtAdvxs_5awbT-8HCR5tO1zKJJhOfZLGmbZcOMAq1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN36e_etyEVUHUtcTlB9mlb2g2I7ySEsDYRN_ilXMPK7A&oe=6ACBA579"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coST0ydnXLQQ7kNvwGcLgz3&_nc_oc=AdquLboAvtAcQyBz3FNcGiGJpITRovgrKtQ2g_ptQdMt_vzYwF19c-eD4dzoE5vAbDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo0b4NHhjRQwlHZEzsNeVlqyeTuoiun6dHESpxnIrbUg&oe=6ACBC4DB"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIVCJmQ_oosQ7kNvwF7AGet&_nc_oc=AdqQlYs0YiZykMprpgCuOi9EzUBaPNvWP1SC-djX0m_rnrj6sj4_YhH4snmuvW0dGdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIX5hepGLd5FdQz-9Abl7aJAtpUxiOQOQb7E7z5kT8fQ&oe=6ACBB4DC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-r43suE-RQQ7kNvwEA3oD_&_nc_oc=AdregQntFCAl865tDIuHnSWcR1hyk1QjbceTxdc-yglCh0Hmol2B1sr9exyQ6KVXoRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3lUtuDHGWpOnnvfnLgnV3OvwXVOx5YpWS1p0XdExPdg&oe=6ACBC297"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
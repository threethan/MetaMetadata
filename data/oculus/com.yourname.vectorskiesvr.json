0a&_nc_ohc=EBAZqxSi0TYQ7kNvwEm-fw3&_nc_oc=AdoI46y0O8p82GAPWMjFY1wzc46q7f9pp3ERvBNhbjObkuqr8NZk8wGJik5YxrGaVK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME9Afj5SJuQ_V9QQ3-gS9SSWkk0qI28OiYqiXa2cPtyg&oe=6ABFD47E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ52DJ9-xXUQ7kNvwEx9Rxi&_nc_oc=AdrZj5j7Uh7VUFW_qn7y-P87gOP-nKlwrFuMZIjIf0lTkY3IiMXZ36UKtoBonTsb92c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMevbkF8oXabwTH_nS3KdDLDDs5O_04b9MxR1cP6JbEA&oe=6ABFC7F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5RVZv_6jMoQ7kNvwH5IQtU&_nc_oc=AdpM1HxnF_9jlPcn62USafLF2pGkY5SKf-QfwkbmQaSIpT9VQahg-NJagD52dvc1_k0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Psxz9EfJl3FFOVJJEa7P3kOmGp9S9nuNA24VlRx2QA&oe=6ABFAF1B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-txfqm1qcoQ7kNvwFtReka&_nc_oc=AdqCCJUShdD88rY-KKoGVcjFAjDe1YIVWf1ky-Q9ayfmygjyu1yI4hw1Vtyp1DDwzgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdfTupPeybALMnE2dFtPioBsnco2gTxO0DntZTM6zUWQ&oe=6ABFD75C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoR_evJNymQQ7kNvwH-lMmp&_nc_oc=AdofjvFAgA4v96nqUpR4OtFMpoJSQm35ZwBaYR1ioN7VPHtlABwA-Isp8LM9DUdvkyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgaDWS6kykRWQ5Z4Jyl-sBJQACyWSFRpk0YQxYxg_0gw&oe=6ABFACD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
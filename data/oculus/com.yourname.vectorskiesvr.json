rname.vectorskiesvr-20260216-205602_2560x1440.png", "id": "26020642577554915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820578_26020642584221581_9213595297666661728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4B8aBxrGCgQ7kNvwHbxDTN&_nc_oc=AdoKp_Z-8ZhzZT8pq0YyfvWLAAmy2qRWOCUoMyYJxyookvwvHcVODjeR4kgYbHRY8E4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWMFJyatxzlj46k0hC2zHb8eS-jrCSzCfH048A3u1SCg&oe=6AA2A28C"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205612_2560x1440.png", "id": "1218367597051133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_1218367600384466_1117934431436662153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjnLddirAjEQ7kNvwHPWIwb&_nc_oc=Adqw_rBMYUrl0Hw8i44dJM4wpQK4nC-UP8AqGcSJPh0IikiNKRWWkJw-o2hyXTo_Ip8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKae_EAJEFHRJoaiG1HgBMFsxAwLlnepoxAy4J7zgVrQg&oe=6AA2D0E5"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205642_2560x1440.png", "id": "2035896726953586", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_2035896730286919_3142292759866806155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCDF0IGDDTwQ7kNvwFQFCJC&_nc_oc=AdqqJcRS-F1-2nlx4k6Qg9xepmMim-8EGmbqGGvctXLwEWwV4WMAcOVXnbuNYhkXt5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh_WothEjM1mR0eODFIJQtBx_XBQnFqz0v1IXZMFADHw&oe=6AA2CCEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
0a&_nc_ohc=WjZyAOCdNSIQ7kNvwHReflp&_nc_oc=AdozgAnZSO6wMz5L0_0RF6fLbknPtEVDfXucVqMS6-SzdNjedO75bDZ5Y-CLDPJ6Mw8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM528n9m6p8fRA5rbYfrH3x7Y270eXlTKYsYY0LmK-Gww&oe=6AC90EFE"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YUI5DBOLPwQ7kNvwEihXoA&_nc_oc=AdpCWGuR0T4arP-99-PsLWCk8-QxaebFceN3y2lbpZkyPN9emsql635KkrWY8nPpcgw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEQObJw6Qiu2pfjvwCUwASV0buMBLkd9r4uclsHUjbHQ&oe=6AC90279"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klAuAXJLOtwQ7kNvwFrB7DZ&_nc_oc=AdqxrVN1nNZGfo8KdKjOnf3QBBfaViO25KmfA3hDcWwi7ep8YBmFHVZUJ35pjx9nFUY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAdiyEtHwj8m_FJWr20IXPmnOiQfFZ7jb-BEzuPXzvUw&oe=6AC8E99B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIVCJmQ_oosQ7kNvwHIDc1Y&_nc_oc=Adqj2Jsv3__-jiSGvurg_0vUNGGwQ6ULY7_V_Ize9Pk_wqiJ_iVMZed1F4HwIVDMeRc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW6tP2j_4HqQQCyeXCVLy_a6yp0Dr10sCt-ELUWeQf9w&oe=6AC911DC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0zsiCGzkskQ7kNvwEsWu2E&_nc_oc=AdpoR8MyS7woEtoQQoWyl7c4nNkQ_AX3bIBbdB0KrUbqTIUTdpUMTgYHcJc-hPkD9hg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiV-3A2EdGlkO52O33cDeug1mAnxeqkuvCT4sI0mIeZA&oe=6AC8E757"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
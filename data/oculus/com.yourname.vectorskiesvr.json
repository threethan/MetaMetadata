0a&_nc_ohc=roZrvFr_jDgQ7kNvwGwWISt&_nc_oc=Adruj-YmD4yNs6TtPXNH7kNskoCWrjVayOL4fs_D4HILCJoitJZcFTnRI5RB4Gb2Ogw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLN_IFgVRTHKJ-_LN3oSZ4Ha6IjqXlvk-SvLta6QIVwaw&oe=6ABBDFFE"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTHphDwpcwAQ7kNvwEbfUio&_nc_oc=AdqsMvvFJoU9JJ4B2P2PQb2aWbJW9GqICg2ev_xxtp0arfiukg6gJmi_AVGWRcu-k-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7kuXRvOUUj03U4QmO8pZYS1wtFFX8cp3PRSbpLR4c-Q&oe=6ABBD379"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqKgagf58F8Q7kNvwFnO47n&_nc_oc=Adraf2O8KAfvVVivFg52e1rZPtLwTzBPVKv77J_hKIZq9BnefEbaOA9UYK6-vYhM1sA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTAT_gY1tItyG__arDOq18gx2fr8oB9DArXQSonzqiNA&oe=6ABBBA9B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Dlo4s_nKwQ7kNvwFTZVmw&_nc_oc=AdrBK9KqhZvSNpvOZ7X3n2nygq3duMPDpmPW26uVfLM18HqRD0A9sfWdk8PtsBlFq_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpk4xXE7vLsb_xyGp-G43zzA6l2wNHbE2OYh-X34OSgA&oe=6ABBE2DC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOT0IhfC_8kQ7kNvwGq8gQs&_nc_oc=AdpwftBqqaQO4vXWvaa7pRSkKIjm9Iw_hac1kvoUnjBZNo-0CYER5Xxl1d3JJ5tCpSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXhYvE97VV6MnpdEyzKRZvbpX2VoHS2xKlUrR5ZqIFjA&oe=6ABBB857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
0a&_nc_ohc=roZrvFr_jDgQ7kNvwFtDxvT&_nc_oc=AdqSwLDWhQ1Rlyf2sGSeMOkyziYwc6ztkLBjtAkw6Si6sy1gNWhJ0btt9xfMxC7VeEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbG6VFv1nWifEBYfGI1T3slcI5otkzICfoQhNOe_oVQA&oe=6ABA8E7E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTHphDwpcwAQ7kNvwE66ozr&_nc_oc=AdpAZrtUITE0UmOrSNuLD49_CxCGlnCNdKDriFWTetUnmK8r7R17RatfSrtdvFnlb_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILN9lSw9yjmf6hVbEbSIo92sF2ZyrKsMMccQpNdkM2kA&oe=6ABA81F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqKgagf58F8Q7kNvwEw6Hja&_nc_oc=AdpHiKxtCJWI_rmLcMc6T8Xkt7vSrkvvzNvYyIVw16NTKSU61h6RxZlFdlVKp0Ql4LU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTv8TZDNxSSXEZDdBS5R_XC2vD3m40o4vwk2Ztm_6amQ&oe=6ABA691B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11Dlo4s_nKwQ7kNvwFzhBzj&_nc_oc=Adrin8yGRbi8T5rhmwPEB07KuMSeGxOLkgQYpt4YYMXtuzoPSmd3ZWb4gpXL_M8p-yI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWUgulmu5YeCobWtNgqnVw3Ox3prrTe93PU4vkpZB1sQ&oe=6ABA591C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FVi9Tul9GUQ7kNvwEv3Ecv&_nc_oc=AdqpCSpfSjQkpDKe0YJVm5yyaArhCigR7WY6wRKQA4O8XR40bjm5U_1RbNTUgdXbnQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmsWdwqrsVUj01kV62OnAh6ZoebugqaDE-vIOW420_mQ&oe=6ABA66D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax 
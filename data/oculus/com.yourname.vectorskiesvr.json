name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1OTG59BRMMQ7kNvwFfquxs&_nc_oc=AdqDNNWJj-teLGZeBWiWexdbdHo7BI1LnfwWGrlFMlUldP3JC9hzSUDTnl12GCi-FKA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDkhd18vVO6BMC0oXW70pRHtoWslbYoalsgZYJ2iAq7Q&oe=6AAEA479"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16Gwr4-4s08Q7kNvwFwp0tG&_nc_oc=AdqE9aziC7hsLeJB5LaN1jv5hBbGWghK2M0JZygr3yCCaYK_W4EJ8GjD3c43OyCgvW8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfb4CHq0WxuZI5rYf2MMCUT6vcwxMcjJ2XrYemsRfcig&oe=6AAE8B9B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Niz07jpQbEQ7kNvwEyYir9&_nc_oc=AdpBLzykW3XVuLtg6NXdLfHYa2GTuu1PEcKwH-H-gL7em7IuPUyD-4NCd2E8AuZppsA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi-tGTTWk2DTbi9AnpOAUxyJT1I6Xs5QLij1xETiHYUQ&oe=6AAEB3DC"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLtyhIz7yOUQ7kNvwG7U7Im&_nc_oc=Adre8gHIIw-XJidGK0wHjFPOXS2Q5pFZaxc2hijzWcu8g4MznF9uccFgSr_9Yjh8KbU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyqr8Pfww2fwyx5kPoCaDitk5A3htL6h2XiZBcc-r3wQ&oe=6AAE8957"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "con
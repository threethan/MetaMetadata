rname.vectorskiesvr-20260216-205602_2560x1440.png", "id": "26020642577554915", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820578_26020642584221581_9213595297666661728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQMGR8j9UU8Q7kNvwHRf24U&_nc_oc=AdpVIpvJ_5hbUGAkLmEreq4JY528-dnUM05wg2tLz7F0S2vTBzPzinHn2YOoF1jIizU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpE5XW4dVl2E7frlNqr7rnrHTYNyum40tZrW6krxPNrQ&oe=6AA5458C"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205612_2560x1440.png", "id": "1218367597051133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_1218367600384466_1117934431436662153_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHhYfKf-MgcQ7kNvwG_FA6N&_nc_oc=Adoq3g1foy9YHak_9hAi-IPQULPQJtQWe-7Aozh3avpmOluZ-Wpqx8xTHm88CvRYTLY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4QnswfF24w3anMlzjpLgaQJIU21XOd9VvbeTdg2621g&oe=6AA573E5"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205642_2560x1440.png", "id": "2035896726953586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820887_2035896730286919_3142292759866806155_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCDF0IGDDTwQ7kNvwErcQn5&_nc_oc=AdrgMD3DZt5hxlJvM46LIrQS3HDY752Au3LjQfv0lGUYRgTlXFUyGfIl_XuwnDAn-4k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJ6EBzkk4u20QE7ZVqr-5ijz2OzE4OpV-2yjUS_KSRA&oe=6AA56FEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
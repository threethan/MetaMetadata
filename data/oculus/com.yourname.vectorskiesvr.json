dn.com/v/t64.5771-25/491822823_876955005182129_6739021559828660747_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXVMZfaf2GYQ7kNvwEi28d8&_nc_oc=Ado0BXgW6GhtoqQzEOorWhodzLC-7TxF5XsBKehkvIkAwah36fcpl5cHpFsse9qPnto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4bxnukXkRuZM9VR3lIIz4q1rHN0HfGeUA_62jSEt7Cw&oe=6B031B1C"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205654_2560x1440.png", "id": "771854265510568", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824082_771854268843901_877267203298505984_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FXQ5PK8QAkQ7kNvwEbUG83&_nc_oc=Adopi3g1__7g-WOGlbgo6BlvqwRD54VoLGKFfBLvVU5IA2P-uGL9xHAQfnLufWI7MAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh9rXdvO2AL_GdXF5KFqZSwuxoAOWXX7jVq1DCm3uMWQ&oe=6B03077A"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205602_2560x1440.png", "id": "26020642577554915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820578_26020642584221581_9213595297666661728_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx-NuBxMxSAQ7kNvwFbpdTw&_nc_oc=Adrl2DnMKHYa8u4xLkdeR01PFNIm2h3v09VXGRbFASEwOq3EHlV_mRIc2a21XOGn-Ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKhWCpitnlfz_rhZneAj704MH2JD9NByVKW9DpYwG5vQ&oe=6B03184C"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205612_2560x1440.png", "id": "1218367597051133", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_1218367600384466_1117934431436662153_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Le67YfiyLrEQ7kNvwE7UihI&_nc_oc=Adry62R5vsYIOnX5AYPPIdLPtry3pzH-Z7mH_0BYLjRRGkDKqpkj34QzNfJqPNHEhqo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWCyoSdTbMB7Py87qw197WdoDCiBvmeLofM-pno4-YtA&oe=6B030E65"}, {"file_name": "com.yourname.vectorskiesvr-20260216-205642_2560x1440.png", "id": "2035896726953586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820887_2035896730286919_3142292759866806155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPfJh1UDI0IQ7kNvwFrv0KJ&_nc_oc=AdrVZ39laC_zMG8-wLfBXZdrg17FfhrZGufiN5gCHhxNnaMUEt4yTKU03esbQ_Ry0A8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKxfduP--SZofzHP-o_4fKZ-OF7PwzU8k5FdPmT7ORBQ&oe=6B030A6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25773897952265865"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1851207695997884"}, {"status": "PUBLISHED", "id": "1589265536181436"}, {"status": "PUBLISHED", "id": "1428281625785189"}, {"status": "PUBLISHED", "id": "2397029197488547"}, {"status": "PUBLISHED", "id": "1633715728056555"}]}, "baseline_offer": {"id": "2397029197488547"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1851207695997884"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28434297706225863", "version": "1.21.3"}, "id": "911297424825721", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28434297706225863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911297424825721"}]}, "change_log": "# Vector Skies VR \u2014 Release History\n\nThis file is the permanent release record for Vector Skies VR. Update it only when preparing a versioned release\u2014not for routine edits or every commit. Add releases at the top, newest first. Use the version from **Unity Project Settings \u2192 Player \u2192 Version**, summarize the relevant commits into one entry, and group notes under Added, Changed, Fixed, and Known Issues where applicable.\n\n## 1.21.3 \u2014 Quest Age Gate and Steam VR Launch \u2014 2026-10-04\n\nQuest standalone now keeps optional online features local-only until Meta confirms an eligible account, and the Steam build selects VR or Flat Screen more reliably, including from Steam Link.\n\n### Added\n\n- Added a conservative Quest standalone age gate (`VSVRAgeGate`) using Meta's Get Age Category API. The age category is requested once per session, is never persisted, and is retried every 30 seconds while unresolved.\n- Added Steam VR launch detection: when no mode argument is supplied, the player checks `SteamUtils.IsSteamRunningInVR()` and starts VR if Steam is in VR mode. `--vsvr-vr`, `--vsvr-flat` and `-openxr` override detection (the last recognized argument wins).\n- Added automatic SteamVR OpenXR runtime selection for Steam VR launches through a process-only `XR_RUNTIME_JSON` override. The system-wide OpenXR default is unchanged, and an existing explicit override is respected.\n- Added a Steam launch-selection regression test (`Tools/Validation/SteamLaunchTests`) and a Steam manifest validation script (`Tools/Validation/Test-SteamManifest.ps1`).\n\n### Changed\n\n- On Quest standalone, PlayFab login (and the leaderboard, score/achievement-count uploads and username sync that depend on it) and direct Meta achievement unlocks stay local-only while the account is unresolved or restricted. Local gameplay and local achievements are never blocked.\n- A confirmed child account clears any PlayFab submissions queued before the age check resolved, so they can never upload later.\n- Quest Link, Steam, Microsoft Store and other builds keep their existing online behavior; the age gate is Quest Android only.\n- The Steam builder now disables Meta-only OpenXR feature subassets before Unity's build callbacks and verifies they stay disabled before player serialization, restoring the original feature state afterwards. The MRUK `OVRPlugin.dll` dependency is staged separately.\n- Updated the Quest and Steam Build Profiles to version 1.21.3; the Quest Android version code is now 2502.\n- Updated `Tools/Steam/README.md` with the Steam VR launch option setup (**Launch OpenXR App** with `--vsvr-vr`) and a Quest 3 / Steam Link review checklist.\n\n### Release Status\n\n- Fresh players from all four named Build Profiles are required before release.\n- Steam VR launch through Steam Link needs verification with a newly built and uploaded Steam payload on the review branch.", "created_date": 1791104541, "id": "28434297706225863", "version": "1.21.3", "version_code": 2502, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28434297706225863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911297424825721"}]}, "change_log": "## 1.21.2 \u2014 Live Cross-Platform PlayFab Progress \u2014 2026-09-08\n\nShared progress update for live PlayFab scoring and achievement reporting across the supported product builds.\n\n### Added\n\n- Added live PlayFab `BatteryHighScore` submission whenever the active score increases, while retaining the finalized battery result as a safety submission and compacting offline retries to the highest pending score.\n- Added PlayFab `AchievementCount` updates after every confirmed achievement unlock, with login backfill and offline retry shared across supported build profiles.\n- Added a `-steam` suffix to the sanitized Steam persona name synchronized to PlayFab in both Flat Screen and Steam VR modes. The suffix is retained within PlayFab's 25-character limit and does not accumulate across launches.\n- Added `Fly full 'pack' to see score.` at the top of the shared start-menu instructions for every build profile.\n\n### Changed\n\n- Steam Development and Release players use the Steam ticket provider instead of falling back to an installation Custom ID. Authentication requests use the service-specific `AzurePlayFab` identity and the same Steam-backed PlayFab player in both presentation modes.\n- PC local unlock counts and Steam-confirmed achievement counts now publish to the same global Top Achievers statistic used by the Meta and Xbox paths.", "created_date": 1788897718, "id": "28097943013194669", "version": "1.21.2", "version_code": 2006, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28434297706225863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "911297424825721"}]}, "change_log": null, "created_date": 1788638390, "id": "28061322590190045", "version": "1.21.0", "version_code": 2005, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28434297706225863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788589032, "id": "28053411197647851", "version": "1.20.0", "version_code": 2004, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25773897915599202", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28434297706225863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788585613, "id": "28052899101032394", "version": "1.20.0", "version_code": 2003, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
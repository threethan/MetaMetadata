tent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1721261342233338_6468729975874486593_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHyJokXgcJUQ7kNvwHy_MJ2&_nc_oc=AdqGJZeUKKJklIkkCWpne--KGjMyVtqOvuzCGPiYsQ2URsQrTMjZeGWyKtazRQ5haLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM55vREJ1HuTW13DkaWGUDuuKemOP5HEwoCYUCL2lUByw&oe=6ACFA67E"}, {"file_name": "Store3.png", "id": "2454694218342773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_2454694225009439_9041527541760377232_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHhm3EPjHf8Q7kNvwGw9z32&_nc_oc=AdrTXMSrkUzoOHDav5Mxu-zwtnLcWnrHyBiVpmOhzXyB0Vv7Tv19ri9pzavqHhwRDJY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOniOrkiWH3gL9IXx6lLbB4np1umWKz_Hjwm2_NH0vYg&oe=6ACF99F9"}, {"file_name": "Store2.png", "id": "1938706326790442", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_1938706333457108_7607758215619569800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3xA2RBZp4IQ7kNvwHTc4EE&_nc_oc=Adp_rTfLBqOCG_B_ZVgJBXEYzddMWnKXyhjqbaDAEyHbYR7HXjOk1pH_b8LovjqNtcA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFt-JE9vpF8vJyo3KjRFlHmEDEFR1PJmCmv7zBVje3LA&oe=6ACFB95B"}, {"file_name": "Store1.png", "id": "1290259276308236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828583_1290259279641569_639375098466720791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWD9d0cxxlgQ7kNvwEW_Vph&_nc_oc=AdrLjE6fwy58qQBN297922-U7mPYQmWxrr6e-lkWRD4Pdo33YHaYd4EJXl7Eo-r0y6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5XqOIj2nGe-B6qtFw09oYaPSv8lvoBvZ695P-bIbOZg&oe=6ACFA95C"}, {"file_name": "store4.png", "id": "1739396070414311", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1739396073747644_2268856352560128017_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYB7vwQhgPYQ7kNvwFl9RLo&_nc_oc=AdqvnJZLUaQ3kisPx6PdOtWqdUeHKkHduJ1qMNiYya-os9W2AzPzXsCnbAVMHghpWF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsaUA-K-v5PNJhu_pdpRQhrL4q-Uyw1DaBnLsT7315yA&oe=6ACFB717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Skies FPV VR", "keywords": ["Drone", "Flight", "FPV", "Simulator"], "long_description": "Virtual Skies FPV VR is an arcade-style flight experience built for comfort and clarity. Fly a neon wireframe craft through a procedurally generated city suspended in a black void. Weave between towers, hit gates, and push for a higher score as speed ramps up.\n\nDesigned from the ground up for Quest 3:\n\nSeated gameplay only (no room-scale required)\n\nMandatory thumbstick controls (no hand tracking, no gesture steering)\n\nStable horizon / no forced camera roll for comfort\n\nMinimal HUD: speed, distance, score\n\nFast restarts and score-chasing loops\n\nWhether you play for quick runs or long endurance sessions, Virtual Skies FPV VR delivers retro vector vibes with modern VR smoothness.\n\nKey Features (bullets)\n\nNeon wireframe visuals in a pure black void\n\nProcedural city chunks for endless replay\n\nSeated-only comfort design (stable horizon)\n\nStick controls: steer + throttle + optional boost\n\nScore, distance, speed tracking and leaderboards-ready structure\n\nComfort & locomotion\n\nPlayer Position / Experience Type\nSeated only (mandatory)\n\nLocomotion\nVehicle / forward motion (player is controlling a craft)\n\nComfort features (tick whatever matches your build)\n\nStable horizon\n\nNo camera roll\n\nOptional snap yaw (if you add it)\n\nSpeed ramp smoothing (acceleration easing)\n\nControls\n\nInput\nMeta Quest Touch controllers\n\nMapping (pasteable)\n\nLeft stick: Y = pitch, X = yaw\n\nRight stick: Y = throttle, X = light roll (cosmetic banking only)\n\nTrigger: boost (optional)\n\nA: pause / menu", "short_description": "A seated, stick-controlled VR flight runner in a neon wireframe cityscapes, gates, and score-chasing speed runs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.saxcompute.ltd/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sax Compute Ltd", "support_website_url": "https://www.saxcompute.ltd/", "website_url": "https://www.saxcompute.ltd/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27669335322722109"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_2068180610411624_4781100417723082299_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZjMR4ZtkZUQ7kNvwEER7UV&_nc_oc=AdqR40zKALiLR24DexNknKN_AHSVc6BuaAU3RrLeaRlSA7kpfsrqNQZjzHjCOaBf64w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNSIdSZ-s03O2KcUWSAHLwvg_2oEryCXENuR9St-BNNg&oe=6ACF8BAE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Skies FPV VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1782328140, "lastRevision": {"nodes": [{"id": "25773897985599195", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default
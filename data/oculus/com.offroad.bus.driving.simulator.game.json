1274619909", "locale": "en_US", "screenshots": [{"file_name": "OffroadBus_Lite_sCREENSHOTS_5.png", "id": "1041753082047329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310667_1041753085380662_1971612842388213082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI4KWoZ1-UwQ7kNvwFgD6M3&_nc_oc=Adpz3pGitP_3VWpZIkUiyWHTfRZRXP2LVz3Is3gfE2qtw6ZFS0fzSzSjaOvrKKvyHlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQjwPeQT6LgbIbWMUvoI4RLT7WaQIPL3LQILshg4gHFQ&oe=6AE60970"}, {"file_name": "OffroadBus_Lite_sCREENSHOTS_4.png", "id": "891232080707718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310667_891232084041051_6248299557321269865_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoyVZue38iEQ7kNvwF9jRym&_nc_oc=AdqUDVGU3HILWsNaJCSiA0jwk9LEtzf4lr5vp3L43kmaJmZ2gYrrysDZ-ZaPKIVG_Kc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfTLM5x8RzARLt5t4G2FlePLCr0jzm9X4dOJGZ1uILgg&oe=6AE5E513"}, {"file_name": "OffroadBus_Lite_sCREENSHOTS_2.png", "id": "1737086817572404", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1737086820905737_8177129996287136720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWND8kCvnvsQ7kNvwHV4hFR&_nc_oc=AdoYY1_z07PHj8T80ZYYlALndv6mA5ieiICD7cCMArEUjR9kReHaqRYEMPAnf5gK0Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQP6yQtkConU2HLzJi1r2K_l8LgvTv3X3IhM7noDah7A&oe=6AE5FDA3"}, {"file_name": "OffroadBus_Lite_sCREENSHOTS_3.png", "id": "989938107412790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311585_989938110746123_242912131778570439_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rl6-qmIGAkQ7kNvwHQkFNO&_nc_oc=AdqaUn2AEHf6HM3dB8tsesxJMl27KIQluLMjT1-BJOx6IQAoDbLxSqUA5NNZU4jDErc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV8MMncIP_pRgEEezO8ZTkEOqZMr52Q_AFiEPY1O_9ww&oe=6AE600FE"}, {"file_name": "OffroadBus_Lite_sCREENSHOTS_1.png", "id": "1043750488039735", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_1043750491373068_7861108633685900734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9UhZ25JxB0Q7kNvwHKpX3t&_nc_oc=Ado0TTUZZIn0Kzu-mz1HheafOOkX24O0ydgR6Ce5ALtXbF4XJ8GMQBph_l01Hxh8Xgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz0mRwr1UugNh7kj90FQBBaETFkbM63XyvnHIymcBr4w&oe=6AE6067D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Bus VR: Driving Simulator", "keywords": ["Simulator", "Adventure", "Driving", "Offroad", "Bus"], "long_description": "Take control of passenger buses and conquer demanding routes in Offroad Bus VR: Driving Simulator. Drive across mountain roads, muddy trails, rocky paths, narrow bridges, river crossings, and steep hills in VR.\n\nEach mission tests your precision and control. Pick up passengers, follow checkpoints, manage sharp turns, climb difficult slopes, and reach every destination safely. Heavy buses react differently across rough terrain, so careful steering, smooth braking, and balanced speed are essential.\n\nExperience cockpit driving with responsive controls, realistic handling, mirrors, obstacles, and changing conditions. Rain, fog, snow, and different times of day make familiar roads more difficult and unpredictable. Navigate slippery surfaces, low-visibility sections, unstable bridges, tight mountain passes, and dangerous drops where one mistake can end the trip.\n\nUnlock additional buses as you progress, each with its own size, speed, suspension, and handling style. Improve performance, complete tougher missions, and master routes built to test your skill.\n\nEnjoy first-person VR bus driving, challenging passenger transport missions, realistic steering and braking, heavy-vehicle physics, dynamic weather, day-to-night conditions, multiple unlockable buses, and progressive single-player gameplay across mountains, forests, mud, rocks, bridges, and rivers.\n\nStart the engine, grip the wheel, and prove you can master the toughest off-road bus routes in immersive virtual reality.", "short_description": "Drive powerful passenger buses across rugged mountain roads, muddy forest trails, narrow bridges, steep climbs, and dangerous offroad routes in Offroad Bus VR. Pick up passengers, follow checkpoints, manage sharp turns, and reach each destination safely. Experience immersive cockpit driving, realistic bus handling, changing weather, challenging terrain, and scenic environments built for exciting single-player VR bus adventures. Master every route and prove your offroad driving skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27617823714539679"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312470_896281593061366_5737153869308766954_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEhNs8f7d0Q7kNvwH8v9mU&_nc_oc=AdpYh-HTLg6E86_kO12mlGiNNZ3UALH9EVA2SgZmwal3PChXmASKhbYQx8NbENf5FQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPft2vwMMV9X51QBkt-osUTX6S6N_3agjRkyTueD_Kfuw&oe=6AE5FB
62152366_8310527565999424823_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olH5QKTP7pAQ7kNvwEZVxbZ&_nc_oc=AdpDqzyd--6IjFKnBIVIPm9bxD5kX7TzuzTsMWgSmE-o9ByYtVEYxOVlREjTkGVFqyQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQY3615OPGsrLt69CCAsxaZr3sng37OEzoFuzT9tWAEw&oe=6AFC913D"}, "display_name": "Mission Underground", "keywords": [], "long_description": "        In the game, players play as fully armed agents to complete a secret mission. The player, carrying a limited weapons and equipment, finds the project leader in an unknown laboratory and rescues him.\nThroughout the entire rescue process, you will encounter many unprecedented challenges, Players can pick up 25 different weapons and equipment in the game to deal with different types of enemies. At the same time, The game also offers more options to provide players with game customization services.\n    This game is running on quest2, 3and above, you can download this game from meta horizon store. thanks and enjoy.\n", "short_description": "A terrible accident occurred in a biological laboratory.  The virus will spread to every corner of world, This time, Only you can save the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuximmedia.com/quda-games/index.html", "developer_terms_of_service_url": null, "publisher_name": "Quda Games", "support_website_url": null, "website_url": "https://yuximmedia.com/quda-games/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"]
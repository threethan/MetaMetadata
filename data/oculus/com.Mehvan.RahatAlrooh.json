&oe=6A301694"}, {"file_name": "4.png", "id": "785324180789846", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821696_785324187456512_4482152325738475690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ysi4baAESsQ7kNvwGM3DUp&_nc_oc=AdoCRZasfTug1dsBNfAgbMeyRgJ2Tm3XFiPH0r70RvTfAmDi3w7i-4VmnntXE3ErQYc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sO9LnlHxSvM1DKJaZyTy54u7txRI2IlUC2F7quCIvbQ&oe=6A30051E"}, {"file_name": "3.png", "id": "635582829649003", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818860_635582832982336_2589187071545213713_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_nLUK7BHSUQ7kNvwEbUbfj&_nc_oc=AdqUcXRl7dmJ_ud3psJ6LQDNk2IjNB79ew7UB5K7DL6-2nVXw-kTiazh7OAU4YE9WCs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PiJ_n7nCDTA0UaSXgL8Bb6mX6nb9NcNTOP7FQJcpG2Q&oe=6A2FF37F"}, {"file_name": "1.png", "id": "1240016931607691", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825345_1240016934941024_8737980213346121289_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dy0EQubBHHMQ7kNvwGw7T4L&_nc_oc=AdoolEqm3jdG9xWxpcDPjT2jIayoUNoWYVhXc-5c1JetinMrio-idhQV4D4UY3B-YrU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hFYJKiIGR-SFx-3gZYi5By_DIF79g7mpPzm3yqvwBDw&oe=6A30248E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u0626\u0627\u0631\u0627\u0645\u06cc\u0627 \u0631\u0648\u062d\u06ce", "keywords": [], "long_description": " \u0626\u06d5\u0645 \u064a\u06ce\u0646 \u0631\u0627\u0628\u0648\u064a\u0646 \u0628 \u062f\u0631\u0648\u0633\u062a\u0643\u0631\u0646\u0627 \u0628\u06d5\u0631\u0646\u0627\u0645\u06d5\u0643\u0649 \u0626\u0627\u0646\u0643\u0648 (\u0626\u06d5\u067e\u0644\u064a\u0643\u06d5\u064a\u0646\u0634\u06d5\u0643\u06ce) \u0628\u0648 \u0633\u064a\u0633\u062a\u06d5\u0645\u06ce\u0646\n (\u0626\u06d5\u0646\u062f\u0631\u0648\u064a\u062f - ios) \n\u0643\u0648 \u064a\u0627 \u0643\u0648\u0645\u06a4\u06d5\u0643\u06d5\u0631 \u0628\u064a\u062a \u0628\u0648 \u0647\u06d5\u0645\u0649 \u0648\u0627\u0646 \u062a\u0634\u062a\u06ce\u0646 \u06af\u0631\u0646\u06af \u064a\u06ce\u0646 \u0643\u0648 \u0645\u0648\u0633\u0644\u0645\u0627\u0646 \u0631\u0648\u0698\u0627\u0646\u06d5 \u067e\u06ce\u062f\u06a4\u0649 \u062f\u0628\u0646\u06ce\u060c \u0626\u06d5\u06a4 \u0628\u06d5\u0631\u0646\u0627\u0645\u06d5 \u0698 \u0686\u06d5\u0646\u062f\u064a\u0646 \u0628\u06d5\u0634\u06ce\u0646 \u0633\u06d5\u0631\u06d5\u0643\u0649 \u067e\u06ce\u0643 \u062f\u0647\u06ce\u062a.\n\n\u0626\u06ce\u0643: \u0628\u06d5\u0634\u06ce \u0642\u0648\u0631\u0626\u0627\u0646\u0627 \u067e\u064a\u0631\u0648\u0632 \u0648 \u062a\u06d5\u0641\u0633\u064a\u0631\u06ce\u060c \u0643\u0648 \u062a\u0648 \u062f\u0634\u06ce\u06cc \u0644 \u06a4\u0649 \u0628\u06d5\u0634\u0649 \u0642\u0648\u0631\u0626\u0627\u0646\u0627 \u067e\u064a\u0631\u0648\u0632 \u0648 \u062a\u06d5\u0641\u0633\u064a\u0631\u06ce \u0628 \u062e\u064a\u0646\u0649\u060c \u0648 \u0644 \u062f\u064a\u06a4 \u0626\u0627\u0631\u06d5\u0632\u0648\u064a\u0627 \u062e\u0648 \u0642\u06d5\u0628\u0627\u0631\u06ce \u0641\u0648\u0646\u062a\u06ce \u0642\u0648\u0631\u0626\u0627\u0646\u06ce \u0648 \u062a\u06d5\u0641\u0633\u064a\u0631\u06ce \u0628 \u06af\u0648\u0647\u0631\u0649. \u0647\u06d5\u0631\u0648\u06d5\u0633\u0627 \u062a\u0648 \u062f\u0634\u06ce\u06cc \u06af\u0648\u0647\u062f\u0627\u0631\u064a\u0627 \u0642\u0648\u0631\u0626\u0627\u0646\u06ce \u0628\u0643\u06d5\u0649 \u0626\u06d5\u06a4\u06d5 \u0698\u0649 \u0698 \u0628\u0648 \u0648\u0627\u0646 \u0643\u06d5\u0633\u06ce\u0646 \u062e\u0627\u0646\u062f\u0646\u0627 \u0648\u0627\u0646 \u0644\u0627\u0648\u0627\u0632 \u062f\u06ce \u0645\u0641\u0627\u0649 \u0698\u06ce \u0628\u064a\u0646\u0646.\n\u062f\u0648\u0648: \u067e\u06d5\u0631\u062a\u0648\u0643\u062e\u0627\u0646\u06d5\u060c \u0644 \u06a4\u0649 \u0628\u06d5\u0634\u0649 \u0645\u06d5 \u067e\u062a\u0631 \u0698 200 \u067e\u06d5\u0631\u062a\u0648\u0643\u06ce\u0646 \u0626\u0627\u064a\u0646\u0649 \u064a\u06ce\u0646 \u0647\u06d5\u0645\u06d5 \u062c\u0648\u0631 \u0628 \u0628\u0627\u062f\u064a\u0646\u0649 \u064a\u06ce\u0646 \u0643\u0631\u064a\u0646\u06d5 \u062a\u06ce\u062f\u0627 \u062f\u06af\u06d5\u0644 \u0628\u06d5\u0631\u06af\u06ce\u0646 \u0648\u0627\u0646 \u0628 \u0634\u06ce\u0648\u06ce \n(3D)\n \u0648 \u0628 \u0631\u06ce\u0643\u062e\u0633\u062a\u0646\u06d5\u0643\u0627 \u062c\u0648\u0627\u0646\u060c \u0648 \u06af\u06d5\u0644\u06d5\u0643 \u0698 \u0648\u0627\u0646 \u067e\u06d5\u0631\u062a\u0648\u0643\u0627 \u0626\u06d5\u0648\u0646 \u064a\u06ce\u0646 \u0643\u0648 \u0628\u0648 \u062c\u0627\u0631\u0627 \u0626\u06ce\u0643\u06ce \u0628 \u0634\u06ce\u0648\u06ce \u0626\u06d5\u0644\u0643\u062a\u0631\u0648\u0646\u0649 \u062f\u0647\u06ce\u0646\u06d5 \u0628\u06d5\u0644\u0627\u06a4\u0643\u0631\u0646\u060c \u0647\u06d5\u0631 \u0648\u06d5\u0633\u0627 \u0645\u06d5 \u0631\u0648\u0643\u0627\u0631 \u0648 \u0631\u06d5\u0646\u06af\u06ce\u0646 \u062c\u0648\u062f\u0627 \u0628\u0648 \u067e\u06d5\u0631\u062a\u0648\u0643\u062e\u0627\u0646\u06ce \u064a\u06ce\u0646 \u062f\u0627\u0646\u0627\u064a\u0646 \u062a\u0648 \u062f\u0634\u06ce\u06cc \u0644 \u062f\u0648\u064a\u06a4 \u062d\u06d5\u0632\u0627 \u062e\u0648 \u0628\u06af\u0648\u0647\u0631\u0649.\n\u0633\u06ce: \u0628\u06d5\u0634\u06ce \u06af\u0648\u0647\u062f\u0627\u0631\u064a\u0627 \u067e\u06d5\u0631\u062a\u0648\u0643\u06ce\u0646 \u0634\u06d5\u0631\u0639\u0649 \u060c \u0643\u0648 \u0644 \u06a4\u0649 \u0628\u06d5\u0634\u0649 \u062a\u0648 \u062f\u0634\u06ce\u06cc \u06af\u0648\u0647\u062f\u0627\u0631\u064a\u0627 \u067e\u062a\u0631 \u0698 100 \u067e\u06d5\u0631\u062a\u0648\u0643\u06ce\u0646 \u062f\u0649 \u064a\u06ce\u0646 \u0634\u06d5\u0631\u0639\u0649 \u0628\u0643\u06d5\u0649 \u0648\u06d5\u0643\u0649 \u0639\u06d5\u0642\u064a\u062f\u06d5 \u0648 \u062a\u06d5\u0641\u0633\u064a\u0631 \u0648 \u0641\u0642\u0647\u06ce \u0626\u064a\u0633\u0644\u0627\u0645\u06ce \u0648 \u0641\u06d5\u0631\u0645\u0648\u0648\u062f\u06d5 \u0648 \u0686\u06d5\u0646\u062f\u064a\u0646 \u0628\u0627\u0628\u06d5\u062a \u0648 \u0632\u0627\u0646\u0633\u062a\u06ce\u0646 \u062f\u0649 \u064a\u06ce\u0646 \u0634\u06d5\u0631\u0639\u0649.\n\u0686\u0627\u0631 : \u0628\u06d5\u0634\u06ce \u0641\u06d5\u0631\u0645\u0648\u0648\u062f\u06ce\u0646 \u067e\u06ce\u063a\u06d5\u0645\u0628\u06d5\u0631\u0649 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u06d5 \u0648\u0633\u0644\u0645\u060c \u062f\u06a4\u0649 \u0628\u06d5\u0634\u0649 \u062f\u0627 \u062a\u0648 \u062f\u0634\u06ce\u06cc \u0628 \u0633\u06d5\u062f\u06d5\u0647\u0627 \u0641\u06d5\u0631\u0645\u0648\u0648\u062f\u06ce\u0646 \u067e\u06ce\u063a\u06d5\u0645\u0628\u06d5\u0631\u0649 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u06d5 \u0648\u0633\u0644\u0645 \u064a\u06ce\u0646 \u0635\u06d5\u062d\u064a\u062d \u0628 \u062e\u064a\u0646\u0649 \u0628 \u0632\u0645\u0627\u0646\u06ce \u0643\u0648\u0631\u062f\u0649 \u0648 \u0639\u06d5\u0631\u06d5\u0628\u0649 \u0648 \u0647\u06d5\u0631\u0648\u06d5\u0633\u0627 \u0628 \u0698\u06ce\u062f\u06d5\u0631\u06a4\u06d5.\n\u067e\u06ce\u0646\u0686: \u0628\u06d5\u0634\u06ce \u0646\u0627\u06a4\u06ce\u0646 \u062e\u0648\u062f\u06ce : \u062f\u06a4\u0649 \u0628\u06d5\u0634\u0649 \u062f\u0627 \u0695\u0627\u0645\u0627\u0646\u0627 99 \u062c\u0648\u0627\u0646\u0646\u0627\u06a4\u06ce\u0646 \u062e\u0648\u062f\u0627\u064a\u06ce \u0645\u06d5\u0632\u0646 \u064a\u06ce\u0646 \u062a\u06ce\u062f\u0627 \u0628 \u0633\u06ce \u0632\u0645\u0627\u0646\u0627\u0646 \u0643\u0648\u0631\u062f\u0649 \u0648 \u0639\u06d5\u0631\u06d5\u0628\u0649 \u0648 \u0626\u064a\u0646\u06af\u0644\u064a\u0632\u0649.\n\u0634\u06d5\u0634: \u0641\u06d5\u062a\u0648\u0627\u064a\u06ce\u0646 \u0634\u06d5\u0631\u0639\u0649 : \u0644 \u06a4\u0649 \u0628\u06d5\u0634\u0649 \u0646\u064a\u0632\u064a\u0643\u06ce 500 \u0641\u06d5\u062a\u0648\u0627 \u0648 \u067e\u0631\u0633\u064a\u0627\u0631\u06ce\u0646 \u0634\u06d5\u0631\u0639\u0649 \u064a\u06ce\u0646 \u062a\u06ce\u062f\u0627 \u0647\u06d5\u064a\u0646 \u062f\u06d5\u0631\u0628\u0627\u0631\u06d5\u0649  \u0628\u0627\u0628\u06d5\u062a\u06ce\u0646 \u062c\u0648\u0631\u0627\u0648\u062c\u0648\u0631\u060c \u0643\u0648 \u064a\u06ce\u0646 \u0647\u0627\u062a\u064a\u0646\u06d5 \u0628\u06d5\u0631\u0633\u06a4 \u062f\u0627\u0646 \u0698\u0644\u0627\u064a\u06ce\u0646 \u0632\u0627\u0646\u0627\u064a\u06ce\u0646 \u0645\u06d5\u0632\u0646 \u06a4\u06d5 \u0648 \u064a\u06ce\u0646 \u0647\u0627\u062a\u064a\u0646\u06d5 \u0648\u06d5\u0631\u06af\u06ce\u0631\u0627\u0646 \u0628\u0648 \u0632\u0645\u0627\u0646\u06ce \u0643\u0648\u0631\u062f\u0649.\n\u062d\u06d5\u0641\u062a: \u062f\u0648\u0639\u0627 :  \u0628 \u0633\u06d5\u062f\u06d5\u0647\u0627 \u062f\u0648\u0639\u0627\u064a\u06ce\u0646 \u062f\u06a4\u0649 \u0628\u06d5\u0634\u0649 \u062f\u0627 \u0628 \u0632\u0645\u0627\u0646\u06ce \u0643\u0648\u0631\u062f\u0649 ", "short_description": "\u0628\u06d5\u0631\u062f\u06d5\u0633\u062a\u06a9\u0631\u0646\u0627 \u0686\u06d5\u0646\u062f\u06cc\u0646 \u067e\u06ce\u062a\u06a4\u06cc \u06cc\u06ce\u0646 \u0645\u0648\u0633\u0644\u0645\u0627\u0646\u0627\u0646 \u0698 \u0628\u0648\u06cc \u0641\u06ce\u0631\u0628\u0648\u0648\u0646\u0627 \u0648\u0627\u0646 \u062f \u062f\u06cc\u0646\u06ce \u0648\u0627\u0646\u062f\u0627"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1V39D3shrRz2lgHrG9ThOrDvaSaXMExJduUY_duWtl3A/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mehvan", "support_website_url": null, "website_url": "https://www.instagram.com/mehvanjemal", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "ckb"], "sup
ec9CC3V0Cspsnow&oe=69BE8C0F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (2).png", "id": "256731524176586", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001726_256731527509919_7294951773526102142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yrhqv2FSxMsQ7kNvwGkxo1I&_nc_oc=AdmVagiO9SQRcN4YaHkCd9buxTp76GB8uP2wnOJZC0XaZk5CduDvE1T1nDGP-AAtNVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxR6l7eNMzqjYYV_4nxVf8TLbI-YxZroouwvN22uUY1Q&oe=69BEA849"}, "display_name": "Coconut Cruisers", "keywords": [], "long_description": "Coconut Cruisers is a VR game on the Oculus Quest that uses Gorilla Tag locomotion. The game includes a horror mode and swimming mechanics. It takes place on a peaceful beach island where Coconuts live and thrive. The Coconuts must learn to defend themselves from the monstrosity that is a demon spawned from the Coco gods. They also must create new and fun games to entertain themselves. More updates will be added frequently to keep the game completely fresh. Be sure to download Coconut Cruisers from the app lab today for free.", "short_description": "Coconut Cruisers is a free to play game with gorilla tag like movement, explore the beach with your friends or try to escape the \"horrifying\" monster!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/coconut-cruisers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "A-SHWARTS and Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/coconut-cruisers/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
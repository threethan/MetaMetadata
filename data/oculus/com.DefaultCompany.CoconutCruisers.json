n themselves. More updates will be added frequently to keep the game completely fresh. Be sure to download Coconut Cruisers from the app lab today for free.", "short_description": "Coconut Cruisers is a free to play game with gorilla tag like movement, explore the beach with your friends or try to escape the \"horrifying\" monster!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/coconut-cruisers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "A-SHWARTS and Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/coconut-cruisers/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7370612669719616"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7535025436611671", "version": "3.6"}, "id": "1266834290942022", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7362157780565105", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7535025436611671"}, "release_status": "RELEASED"}, 
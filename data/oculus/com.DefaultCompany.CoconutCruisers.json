m/v/t64.5771-25/39001726_256731527509919_7294951773526102142_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFR0jFpFsZkQ7kNvwFGOTYT&_nc_oc=AdpgjHqhR5KAORsgwplhihgtgbbFULLOVq4AdoPzeMw00Op41KrBpd5sKAVP_0KlpnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhOnJrP0UKtUih8XN7LnCVMAsuRXzC9kYLYUwWevq_mA&oe=6B106089"}, "display_name": "Coconut Cruisers", "keywords": [], "long_description": "Coconut Cruisers is a VR game on the Oculus Quest that uses Gorilla Tag locomotion. The game includes a horror mode and swimming mechanics. It takes place on a peaceful beach island where Coconuts live and thrive. The Coconuts must learn to defend themselves from the monstrosity that is a demon spawned from the Coco gods. They also must create new and fun games to entertain themselves. More updates will be added frequently to keep the game completely fresh. Be sure to download Coconut Cruisers from the app lab today for free.", "short_description": "Coconut Cruisers is a free to play game with gorilla tag like movement, explore the beach with your friends or try to escape the \"horrifying\" monster!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/coconut-cruisers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "A-SHWARTS and Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/coconut-cruisers/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
/scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974802_675234484640197_2903570652671522528_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ux7vkELUg_8Q7kNvwGexZ2k&_nc_oc=AdoIq5UJr2uPVU5wwdU4oPGQX_C9WYQ8pd3p2tNuBLZzxaFK1tioTLlQYndLB30VnHk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzQRY_nsI1IaAb1WnI-iWIa7buI-to0UI4lHsFAPIkjA&oe=6B085B4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (2).png", "id": "256731524176586", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001726_256731527509919_7294951773526102142_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn2KTPCm5VoQ7kNvwG-9Ucd&_nc_oc=AdoT9DuKKxXIykijgawPGHsaWf7IfCM8Semcg3EPR1AgYPekwRKfMtmJ0tQDaDJOgi0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiHTqZWKEwB3HE3jp0WfN3Vf5ZrwYlHrwFfCxOIAGTPA&oe=6B083F49"}, "display_name": "Coconut Cruisers", "keywords": [], "long_description": "Coconut Cruisers is a VR game on the Oculus Quest that uses Gorilla Tag locomotion. The game includes a horror mode and swimming mechanics. It takes place on a peaceful beach island where Coconuts live and thrive. The Coconuts must learn to defend themselves from the monstrosity that is a demon spawned from the Coco gods. They also must create new and fun games to entertain themselves. More updates will be added frequently to keep the game completely fresh. Be sure to download Coconut Cruisers from the app lab today for free.", "short_description": "Coconut Cruisers is a free to play game with gorilla tag like movement, explore the beach with your friends or try to escape the \"horrifying\" monster!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/coconut-cruisers/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "A-SHWARTS and Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/coconut-cru
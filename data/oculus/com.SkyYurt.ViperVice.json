ent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv29Od2QWU8ntzvGNhqJAmG3J3CY47nZpFtVqImSZcuw&oe=6ABA85D6"}, {"file_name": "icon.png", "id": "614749664776810", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392196_614749668110143_2937561274493681450_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vTjWm-giC4Q7kNvwH7937h&_nc_oc=AdoXYHq-vzBFDSO7KZ1KQ1DhOECnm9UcjoHt7NYLWO5cyVwRWGAyOtgfkaqh9gulYT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzj9waYp6WtCiV35oR7SkOWy7zEwZrK4n_bbc1pTRiqw&oe=6ABA6ED4"}]}, "id": "633973329569917", "locale": "en_US", "screenshots": [{"file_name": "s2.png", "id": "1831729037627065", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393566_1831729040960398_5178453402927614913_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtcF-9v6nOQQ7kNvwGGT1NZ&_nc_oc=AdrY_yKWJqRrLUx3fVFb7JhHxcgJ315z30rC962mUG6vWwPzwdvWUsisuow65bqk-Z4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPlBYtgezSgiUDDozRl-LB_iVxq7t8dCljt9CQwWVTCQ&oe=6ABA70D8"}, {"file_name": "s7.png", "id": "684748640636325", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391773_684748643969658_1560186414753030090_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBBT1BfK9fAQ7kNvwGRNtDE&_nc_oc=Adq4dia-zcFE5fmE4V0ZYA4CzEIrZIou7hVY7wCEbQL2uScSCarakHkUWQaU2OI5uu4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJak7L4Vls1SB3HerT1be1JcJBF16KfXvq90-fGzkMCyA&oe=6ABA65EC"}, {"file_name": "s1.png", "id": "661194453229433", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393223_661194456562766_3246748398818919173_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTVyqOWBCGwQ7kNvwFSEExg&_nc_oc=AdoKKLDDtk8AQzDRPORWOyhTueEVy6U3738Gloj-v2sOQmPp7vLNSduZNYRNgTaXEIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr3MEXk5bkTD5Bee1M-r1TlFjkDf8maQjBsLEWpZlWkQ&oe=6ABA71BB"}, {"file_name": "s6.png", "id": "497630213415198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391785_497630216748531_21387461678965996_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwXmrHPjjXUQ7kNvwGSJsTZ&_nc_oc=AdqjrVYR6vY0FO8N7S8mpmVgf-oJXbAfa1oV64zxhhxXjgxtwjg5kwQhG-XCaq1OmP4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNjpZrM136TnXcdcms8jE8OqEnFBW3ZOxP04dN0CozpA&oe=6ABA5F1F"}, {"file_name": "s5.png", "id": "505149439094759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393182_505149442428092_6384044399360828219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9kyRB7oS9MQ7kNvwGT963h&_nc_oc=Adr2rFEv_UIArtvSDsSDu6GyvITkrd_bNFmyj2UkcvJQy0Jezt4R7rJ7EI-EauAP5js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqMUM4BEjcDwsHGh1R6ClNlVF58gerxR3TpkHCf7QUPQ&oe=6ABA7CA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_cover.png", "id": "1015406793818134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393587_1015406797151467_1511580222805645081_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hvqf5GxhL5kQ7kNvwGqVh1I&_nc_oc=Adrue_OCHcVs9ubWXVoxwxgpMOG8LGmHUzv83BJVL-LJP_22A-KunmWW_EfRQpzS-N4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQO7ysozDDt2ec1IjhFPZJdD-yLo5xT3G65oKkySy4zQ&oe=6ABA8035"}, "display_name": "Viper Vice", "keywords": [], "long_description": "**Viper Vice** throws you into the heart of a city ruled by power struggles and shifting alliances. As a skilled mercenary, you\u2019ll navigate high-stakes missions, forge relationships with influential figures, and carve out your own path in a world where every decision matters. Will you outmaneuver your rivals, build your reputation, and rise to the top? The city is yours to explore\u2014just be ready for the consequences of your actions.\n\n# Main Features:\n- **Dynamic Missions:** Take on high-risk jobs, from securing valuable assets to outsmarting rival factions. Strategy and reputation will determine your opportunities.\n\n- **Allies & Rivals:** Build trust with powerful figures or face opposition from those who seek to control the city. Your choices will shape your standing in this unpredictable world.\n\n- **Unlock Vehicles & Gear:** Earn and customize a variety of high-performance vehicles and cutting-edge equipment to stay ahead of the competition.\n\n- **Reputation Matters:** Prove your skills and gain influence. The more respect you earn, the more challenging\u2014and rewarding\u2014your opportunities become.\n\n- **Urban Takeover:** Expand your influence across the city through strategic alliances and calculated decisions. Every move you make affects the balance of power.\n\nStep into the immersive world of Viper Vice, where ambition, strategy, and survival define your journey. Will you thrive in this high-stakes urban battleground, or will the city consume you? The choice is yours.", "short_description": "Viper Vice throws you into a gritty, crime-ridden city where you\u2019re a mercenary for hire. Work for powerful gangs, complete high-stakes missions, steal cars, and rise through the underworld ranks. Build alliances or make enemies, as each decision changes the city\u2019s dynamic. Unlock weapons, vehicles, and properties as you earn money and respect. In this fast-paced, open-world VR experience, you\u2019ll need to outsmart and outgun rivals to claim the streets as your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/ViperVice/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/ViperVice", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23935694072684156"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1639352007620672"}, {"status": "PUBLISHED", "id": "1022289287155748"}, {"status": "PUBLISHED", "id": "1452526849917995"}]}, "baseline_offer": {"id": "1452526849917995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1639352007620672"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29067230926197086", "version": "0.7.1"}, "id": "1292100245124531", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067230926197086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "Patch 13 of Viper Vice is now Live\n\nThis update adds new weapons and the attachment system.\n\n\nNew Weapons:\n- Tec9\n- Mac-10\n- Micro Draco\n- Switchblade (click trigger to extend and retract blade)\n- [SECRET] - Unlocked by completing easter egg #2\n\n\nAttachment System:\n- You can now buy attachments and upgrades for your weapons at S Guns. You can only buy attachments if you have unlocked the weapon.\n- Attachments & Upgrades: Reddot, Navtech, Supressor, Switch (semi auto to auto converter), extended mag, drum mag, laser sight, hollow point ammo, armor piecing ammo.\n- Random weapons spawned around the world will now sometimes spawn with attachments.\n\nGeneral:\n- Adjusted and rebalanced all prices on all weapons and ammo\n- Adjusted Firing rate on all automatic weapons and weapons that become automatic after adding converter attachment.\n- Updated the sound FX on all weapons\n- Magazines now slide in and out on weapons that make sense to have it.\n- Easter Egg #2\n- Fixed missing collider on dumpster ramp\n- Fixed missing collider in safehouse\n- Fixed issue with muzzle effect not showing sometimes when shooting automatic weapons\n- Fixed issue with safes not being detected as unlocked in the \"Dollar Cocktail\" Mission.", "created_date": 1787859263, "id": "29067230926197086", "version": "0.7.1", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29067227436197435"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067230926197086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "* FIX: Police doesn't try to arrest you anymore when you are not wanted\n* FIX: NPCs should driver better now and stay on road, unless they panic\n* NEW: NPC Driver Panic feature. NPCs will now drive away fast if shooting happens near them.\n* NEW: you can now find parked vehicles around the city you can hijack. Quest 3 has a higher chance and higher number of parked vehicles", "created_date": 1786049398, "id": "28797763026477212", "version": "0.6.5", "version_code": 70, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28797758403144341"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067230926197086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "* FIX: Police doesn't try to arrest you anymore when you are not wanted\n* FIX: NPCs should driver better now and stay on road, unless they panic\n* NEW: NPC Driver Panic feature. NPCs will now drive away fast if shooting happens near them.\n* NEW: you can now find parked vehicles around the city you can hijack. Quest 3 has a higher chance and higher number of parked vehicles", "created_date": 1786046896, "id": "28797421989844649", "version": "0.6.4", "version_code": 69, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28797418163178365"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067230926197086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "FIXES:\n* Fixed issue with the player getting ejected when the bike hit curbs.\n* Fixed issue of cars dashboard indicators not being visible anymore.\n* Fixed issue with the police spawning in front of you\n* Fixed the issue where you would get 2 heat levels if you provoked the police.\n* Fixed issue with vehicles spawning without drivers.\n* Fixed issue with pedestrians spawning as if they were sitting.\n* Fixed issue with player not being able to grab shoulder weapons while in vehicles.\n* Fixed issue with bicycle not being able to turn even though the handle was fully turned.\n\nADJUSTMENTS\n* Made it easier to exit bikes by increasing the max speed limit before exiting is blocked.\n* Made it so you can still exit bikes even while the bike is rolling backwards.\n* extended the suspension of the chopper's front wheel.\n* Adjusted how traffic works. you should see more dense streets now\n* Even more pedestrians and vehicles on the streets on Quest 3\n* Improved NPCs driving\n* OPTIMIZATIONS. The game should run smoother now on all devices.\n\nNEW\n* Added speedometer and RPM Dashboard to Classic Motorcycle\n* Added speedometer and RPM Dashboard to Scooter\n* Added speedometer and RPM Dashboard to Sport Motorcycle", "created_date": 1785693631, "id": "28746206184966230", "version": "0.6.3", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28746203488299833"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067230926197086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "Bikes & Motorcycles are now roaming the streets of Venrova Bay.\n\nGet the new update (v0.6.1) now and ride a bike throughout the city.\n\nIt's a big update, so let me know if you encounter any issues :)\n\nHere is the full list of stuff the update adds:\n\nNEW RIDES:\n\n* Added Motorcycles to the game: Sport, Dirtbike, Chopper, Classic, Scooter. Each control differently and sound differently.\n* Added Bicycle to the game. Pedal through the city. \n* Setting for choosing how bike braking works: assisted/Individual.\n* Setting for enabling bike leaning when turning hard (Experimental)\n* Added 10 Ramps around the city. Do stunts to earn cash, complete all ramps.\n\nCIVILIANS:\n\n* Civilians now also ride motorcycles throughout the city.\n* Made improvements to the traffic, so the NPCs are better drivers\n* Fixed issue with NPC drivers ragdolling and then getting teleported back into the seat of vehicles.\n\nGANG MEMBERS: \n\n* If gang members have cars or bikes, they will also drive around the city.\n\nPOLICE: \n\n* Police will drive around the city or patrol on foot, even if you are not wanted.\n* If the police spots you doing crime, they will come after you.\n* If you hit the police car or open their door, they will come after you.\n\nNEW SOUNDS:\n* new vehicle sound system. Modified each vehicle sounds to sound more unique and better.\n\n\nLet me know what you think!\nIf you like the update, make sure to review it! It helps a lot!", "created_date": 1782244565, "id": "28285160231070830", "version": "0.6.1", "version_code": 66, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28285157781071075"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
": []}, "obb_binary": {"id": "27678929448360581"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27164771933109671"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777920297, "id": "27640849638835229", "version": "0.5.1", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27640843092169217"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27164771933109671"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "* Changed the probability of Turf Defense event happening from 50% to 75% and reduced the roll check cooldown from 600s-1200s to 300s-600s\n* Fixed issue with some cars remaining in their low poly state\n* Shuffle the list of cars and pedestrians, so they don't spawn in order each time you start the game\n* Improved the vehicle tutorials a bit to make it more plain", "created_date": 1774288919, "id": "27164771933109671", "version": "0.4.32", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27164768106443387"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27164771933109671"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "Holster and weapons\n* adjusted how holstered weapons are holstered doing the load of the game. the weapons should still be holstered now when you start the game\n* removed fake sound that made people think weapon was holstered\n* controllers now only vibrate if you can actually drop the weapon inside the holster\n* Made it easier to actually holster shoulder weapons/items while moving very fast\n* Adjusted MT9 and MK18 Barrel Colliders, making it easier to grab\n\nVehicle\n* Made sure no one changes the active radio station on your vehicle when you enter a building \n* NEW: Vehicles now have different colors\n* Made fixes so the car and player doesn't fly to space when hitting the curbs (let me know if it worked)\n* Made fixes so the steering wheel doesn't go physics frenzy when hitting something\n\nGeneral:\n* Made some optimizations, so the game should run a bit smoother now\n* ADJUST: made it easier to grab money", "created_date": 1773506451, "id": "27069699455950253", "version": "0.4.31", "version_code": 56, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27069694702617395"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
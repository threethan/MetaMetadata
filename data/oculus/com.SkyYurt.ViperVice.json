mFC_2mNzXWvfeG9gLEjoDXB2UYwPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPqsFl_o7Ezp-AD-oyn1wscC9tw8LKXXOqcjyQURO-mw&oe=69B6A79F"}, {"file_name": "s5.png", "id": "505149439094759", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393182_505149442428092_6384044399360828219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48YGDkm7Y3MQ7kNvwHjlrYe&_nc_oc=AdmtRjznQUpV4Gz7UKvdKqqrUXZNI38nXJV9_5KQpqCTZLNilCoTC0UK1lL062uEWFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4tEu5WY59BoLAur8d1R9bPa2IYG5wa69jcos7r1jP3A&oe=69B68CE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_cover.png", "id": "1015406793818134", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393587_1015406797151467_1511580222805645081_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkKkF9jJji8Q7kNvwE258FA&_nc_oc=AdkvJ1K9K5rOJCoBVLuPAhRAeOUtSXBU3TjktqpTQeG8aiW5LOR4viYPkg8HJ8xbH7k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYFMsXWjKrHITPhOa0JngfQIOTiUU_2fXidQqCBDkY_g&oe=69B69075"}, "display_name": "Viper Vice", "keywords": [], "long_description": "**Viper Vice** throws you into the heart of a city ruled by power struggles and shifting alliances. As a skilled mercenary, you\u2019ll navigate high-stakes missions, forge relationships with influential figures, and carve out your own path in a world where every decision matters. Will you outmaneuver your rivals, build your reputation, and rise to the top? The city is yours to explore\u2014just be ready for the consequences of your actions.\n\n# Main Features:\n- **Dynamic Missions:** Take on high-risk jobs, from securing valuable assets to outsmarting rival factions. Strategy and reputation will determine your opportunities.\n\n- **Allies & Rivals:** Build trust with powerful figures or face opposition from those who seek to control the city. Your choices will shape your standing in this unpredictable world.\n\n- **Unlock Vehicles & Gear:** Earn and customize a variety of high-performance vehicles and cutting-edge equipment to stay ahead of the competition.\n\n- **Reputation Matters:** Prove your skills and gain influence. The more respect you earn, the more challenging\u2014and rewarding\u2014your opportunities become.\n\n- **Urban Takeover:** Expand your influence across the city through strategic alliances and calculated decisions. Every move you make affects the balance of power.\n\nStep into the immersive world of Viper Vice, where ambition, strategy, and survival define your journey. Will you thrive in this high-stakes urban battleground, or will the city consume you? The choice is yours.", "short_description": "Viper Vice throws you into a gritty, crime-ridden city where you\u2019re a mercenary for hire. Work for powerful gangs, complete high-stakes missions, steal cars, and rise through the underworld ranks. Build alliances or make enemies, as each decision changes the city\u2019s dynamic. Unlock weapons, vehicles, and properties as you earn money and respect. In this fast-paced, open-world VR experience, you\u2019ll need to outsmart and outgun rivals to claim the streets as your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/ViperVice/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/ViperVice", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23935694072684156"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452526849917995"}]}, "baseline_offer": {"id": "1452526849917995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1452526849917995"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27001641156089417", "version": "0.4.30"}, "id": "1292100245124531", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27001641156089417"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "* NEW: Interior locations now have a chance at spawning weapons you can pick up\n* NEW: sometimes safes also has weapons or frag grenades in them. So crack them open!\n* NEW: gangs now drop loaded guns instead of empty guns\n* NEW: Banks now have bigger packs of dollar bills you can pick up\n* NEW: Health Packs now spawn around the city you can pick up and heal yourself\n* NEW: You can now toggle the siren lights on the police car\n* FIX: Fixed render issues on rocks at the beach\n* FIX: Fixed some animation transitions on gangs and law enforcement\n* ADJUST: Cars hitting npc now does more damage", "created_date": 1772895193, "id": "27001641156089417", "version": "0.4.30", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27001635782756621"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9012068918806583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27001641156089417"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1292100245124531"}]}, "change_log": "* NEW: After popular demand: the Iron in the safehouse is now interactable and can be used as a melee weapon\n* NEW: In the in-game cheat menu, you can now reset the wanted level\n* NEW: You can now move the holsters forwards and backwards in the settings\n* NEW: Frag Grenade now also spawns in the safehouse, if unlocked\n* NEW: Player health now also resets when you get arrested\n* FIX: Mission: \"Tag It Up!\". Fixed Spray can not spawning when starting the mission from an interior location\n* FIX: Mission: \"Delivery Service\" and other missions involving target. Fixed the issue with targets not spawning after retrying the mission.\n* FIX: added a fix so police doesn't stand up inside vehicles (let me know if it worked)\n* FIX: fixed issue with player spawning with broken pelvis in the hospital\n* FIX: gang members shouldn't attack you, when they get hit by a car not driven by you.\n* FIX: made fix on fetch item objectives, making items be there for you to grab\n* FIX: Made the collider for the pin on the frag grenade bigger, so its easier to pull\n* FIX: made sure grenade respawn in holster after being used, if you still have ammo left\n* FIX: Fixed typo on mission briefing\n* ADJUST: changed how holsters work. should prevent accidently grabs now (let me know how it works)\n* FIX: fixed issue with steering wheel locking itself after regrabbing it\n* ADJUST: adjusted the seat positions of NPCs, they should pop less out of the ceiling now\n* ADJUST: Adjusted the steering wheels of vehicles. it should be easier
f&oh=00_AQLPpZxysVATFTJCJkEAso198PCE8WkhDEaQofUDTr0T1A&oe=6ABA7150"}, {"file_name": "Screenshot 2026-09-03 202524.png", "id": "2330166081135659", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825546_2330166084468992_2839532163916200796_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knd2w2mACfgQ7kNvwEZuwOz&_nc_oc=AdqljUef_SbMqvsE4CP-Q2fscXFq5P_56wBYEaLE1mv17zrPhHDRL84LK3lPitjnouo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFhuPX-l6vcKwN2weKJTULy1IcszxKFLNgKOrirJdLvw&oe=6ABA6DEE"}, {"file_name": "Screenshot 2026-09-03 202434.png", "id": "1401479012114127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1401479015447460_1306395591292680850_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K33s5gl9tcQ7kNvwH4SNCj&_nc_oc=AdreyXHHhRoinG7zJ8TZf4WKUgHPckqRpVgD74vM-mI29HBW8E--9Bc_iuGVfwRumSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJibFQBCo7ExcQ97e_GHoQ-ludJN0Desh_dVYXCqXF_Jg&oe=6ABA818B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_cover_weapons_and_attachments.png", "id": "1085872494397849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1085872497731182_1070989837813644281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EklndTaowhcQ7kNvwESOGx1&_nc_oc=Ado_vSXfbmJGlnseNpQOqUYIpp2QixFqOtvH6obQHljFqqDe2BLcl0og6ZIuKa47l18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkKfRe4CMULeNIiAKmDnu0Fna75PLOooM-Z8P-NhsgNg&oe=6ABA6453"}, "display_name": "Viper Vice", "keywords": ["openworld", "singleplayer", "crime", "sandbox", "gangster"], "long_description": "# OWN THE STREETS OF VENROVA BAY\n\nViper Vice is a single-player open-world crime sandbox built for VR. Explore a neon-soaked 1980s city where you can physically hijack vehicles, rob stores and banks, fight rival gangs and escape a reactive police wanted system.\n\n{1062232166397259}\n\n\n# 3 GANGS. 70 STORY MISSIONS.\n\nChoose who you work for, build your reputation and take on 70 story missions across the city\u2014or ignore the story and make your own trouble in the open world.\n\n{2982410995425010}\n\n\n# BUILD YOUR ARSENAL\n\nEarn cash, find weapons and supplies, and customize your guns with suppressors, sights, scopes, lasers, flashlights, extended magazines and more.\n\n{1091901126592931}\n\n# MORE THAN MISSIONS\n\nDrive cars, bikes and motorcycles. Take side jobs, explore interiors, rob businesses, fight for territory or simply cruise around Venrova Bay at your own pace.\n\n\n**Offline single-player. Built for Meta Quest 2, Quest 3 and Quest 3S.**\n\n", "short_description": "Viper Vice is a single-player open-world crime sandbox built for VR and set in the 1980s. Hijack cars and motorcycles, rob stores and banks, fight rival gangs, evade the police, customize weapons, take on side jobs, and play through 70 story missions across Venrova Bay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vipervice.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": "https://discord.com/invite/uCm6d3HDxq", "website_url": "https://vipervice.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29175150655405112"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-
nc_oc=AdrFRm6hbhaRPMWsUed1F7fZ-k-7LxBbA00FO9EAwYKFJuVSCLO8wMFfbotynvHMCf4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AyrJjuJ10ASrHX9rQtkdRWuACEZMkmGfY5mjRIBkdwg&oe=6A09B61F"}, {"file_name": "s5.png", "id": "505149439094759", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473393182_505149442428092_6384044399360828219_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygDx59tAiIYQ7kNvwH6-xzF&_nc_oc=AdrurtpKVvmRymZ427WnYaNDnfaDvxH4F8s2X9Nld6mCXX7DpuA2xtRRw3lyOBvpjpo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4angWV6Ut2R6C6GBWgicE_Y9XUtCkwwWLzeGpfqqT-Yw&oe=6A09D3A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_cover.png", "id": "1015406793818134", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393587_1015406797151467_1511580222805645081_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osvh3xKrxW0Q7kNvwHtQTUZ&_nc_oc=Adq49Wfvz6YOC-0bdI5zRHrwF_wZrB8V8o-N86LFhmXHFgwD495kmEW_-HVS-EDoUU8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7--VWpCr-wgjqDlCevD1uwD-9jFPLMEsZHVZOWeO-clw&oe=6A09D735"}, "display_name": "Viper Vice", "keywords": [], "long_description": "**Viper Vice** throws you into the heart of a city ruled by power struggles and shifting alliances. As a skilled mercenary, you\u2019ll navigate high-stakes missions, forge relationships with influential figures, and carve out your own path in a world where every decision matters. Will you outmaneuver your rivals, build your reputation, and rise to the top? The city is yours to explore\u2014just be ready for the consequences of your actions.\n\n# Main Features:\n- **Dynamic Missions:** Take on high-risk jobs, from securing valuable assets to outsmarting rival factions. Strategy and reputation will determine your opportunities.\n\n- **Allies & Rivals:** Build trust with powerful figures or face opposition from those who seek to control the city. Your choices will shape your standing in this unpredictable world.\n\n- **Unlock Vehicles & Gear:** Earn and customize a variety of high-performance vehicles and cutting-edge equipment to stay ahead of the competition.\n\n- **Reputation Matters:** Prove your skills and gain influence. The more respect you earn, the more challenging\u2014and rewarding\u2014your opportunities become.\n\n- **Urban Takeover:** Expand your influence across the city through strategic alliances and calculated decisions. Every move you make affects the balance of power.\n\nStep into the immersive world of Viper Vice, where ambition, strategy, and survival define your journey. Will you thrive in this high-stakes urban battleground, or will the city consume you? The choice is yours.", "short_description": "Viper Vice throws you into a gritty, crime-ridden city where you\u2019re a mercenary for hire. Work for powerful gangs, complete high-stakes missions, steal cars, and rise through the underworld ranks. Build alliances or make enemies, as each decision changes the city\u2019s dynamic. Unlock weapons, vehicles, and properties as you earn money and respect. In this fast-paced, open-world VR experience, you\u2019ll need to outsmart and outgun rivals to claim the streets as your own."}]}, "developer_name": null, "developer_privacy_policy_url": "https://visceract.com/vr/ViperVice/privacy", "developer_terms_of_service_url": null, "publisher_name": "Visceract", "support_website_url": null, "website_url": "https://visceract.com/vr/ViperVice", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in
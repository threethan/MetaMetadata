dn.com&_nc_ss=7f20f&oh=00_AQTyuA7vstLVfpWslMc3tENKn7xtBTFNKC1K00s9QEewDQ&oe=6AF33256"}, {"file_name": "screenshot_2.png", "id": "2371367173673619", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624990_2371367180340285_5106393035672135360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix0dhhPHFaEQ7kNvwF1n-lz&_nc_oc=AdoCv7SoW1ycnC9n7egFxQ6PM3zvQipHxdryjC_TUguiOaJY9S4rjONjaCQqY-pK-po&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvUu_EkEFSWG3GFI3l5LE29AsC3S8le70OGVmEMh78oQ&oe=6AF32A06"}, {"file_name": "screenshot_1.png", "id": "2026632961373466", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620630_2026632964706799_5595664647594615575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxWKGBqKcsMQ7kNvwGgHAl6&_nc_oc=AdqJsArhWcOxIf2GrjQ4LgO-ATI9kMXEOD0Sg5G_fsOb27GthSCafZ2cHtbekPgx7v4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcw8GPRDCRTH4Z-be2dhNpdOg3WY_MS-mZuf7C-ls32Q&oe=6AF35101"}, {"file_name": "screenshot_4.png", "id": "1813981516407871", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_1813981519741204_1132822114601823148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eNCW7YeIk0Q7kNvwF__eZl&_nc_oc=Adp1nR4_EzlXZqWdyQUvKHJD2FoNWfUdzrkCmr9q2IErriR_R6peoCicxDhbrq6vD20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTakH49-2RjGpkGMK08OlBIrYnK-XjMkHX_ZkDRHfotUg&oe=6AF329A3"}, {"file_name": "screenshot_5.png", "id": "1404023928005449", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593727470_1404023931338782_3520293575106326112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EqgJv_M0CsQ7kNvwHGWCeL&_nc_oc=AdquFS1QD_NcXDVtSOQYLJ_LtvQdzUcJp7Uhi5D5PcAEmAzMy7_AnOyO6souIVb4ii0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT28uJk2U3QApwe0zA7fG2z1z0Q3KfbgSpAiTbSkJfEEw&oe=6AF3574C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1746378653255515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1746378656588848_6440766933078258859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQa45s3gSM4Q7kNvwFTadcZ&_nc_oc=AdoGPlaXZ9y2tWA3zrRwUIVK8gOd18mS-IH_sFMx47rsq4E_BBDZmqCMxYC9EFcuENU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNrsl6O1HXh7iQuYn-aANtaex2Qhux_MM9-13RoY9oEg&oe=6AF33E2E"}, "display_name": "God Mode", "keywords": ["god", "sandbox", "civilization", "island", "simulation"], "long_description": "God Mode puts a whole world on the table in front of you, and your hands are the hands of its god.\n\nYOUR HANDS ARE EVERYTHING\nPinch the ground and lift it into hills or push it down into lakes. Take a cloud in your fist and squeeze: it rains where you hold it; dip it in the sea to fill it again. Press two clouds together for a thundercloud and squeeze hard for lightning. Grab the sun and drag it across the sky. Grab the air itself and the whole world turns, slides and zooms in your hands.\n\nA PEOPLE WHO BELIEVE IN YOU\nFive souls and one fire. They gather food, cut timber, quarry stone, build homes and farms, keep sheep and sleep at night. When they need something they pray: wish bubbles rise over the village and the stone tablet tells you what they ask for. Rain, land, timber, stone, food, a fire put out, wolves, a storm, stones from the sky. Every answered prayer is belief, and belief raises their monuments.\n\nFOUR AGES\nThe Stone Circle makes the camp a Kingdom with towers and a keep. The Keep makes a Town with streets and a great tower. The Tower starts the Space Age, a rocket and a countdown to the launch.\n\nKEEP THEM SAFE\nWolves come at night and raiders land from the sea: pick them up and throw them in the ocean. Catch meteors and set them down as star stone. Nobody dies and you cannot lose. A whale, gulls, canoes and bleating sheep live on the island, the world saves itself, and a narrator keeps you company. Controllers or hand tracking.", "short_description": "A living island floats in front of you. Sculpt the land with a pinch, wring rain from the clouds, drag the sun across the sky and pick up the little people who pray to you. Answer their wishes and watch a camp grow into a kingdom, a town and a space age that reaches for the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/godmode/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/godmode/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372334245959438"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1999865974011787"}]}, "baseline_offer": {"id": "1999865974011787"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791980700, "status": "PUBLISHED", "id": "1999865974011787"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1372342329291963", "version": "1.0.0"}, "id": "1736580230905247", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1372334239292772", "is_con
.5771-25/499620630_2026632964706799_5595664647594615575_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgE3xud5CXUQ7kNvwHVlaQp&_nc_oc=Adqrkh2Ek6gzkGVrYqYfflbZq1q77vEyHIGr_FRhORvsnuHmptKHghqVnFS8ozJE98I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiIPNIlBBBNwuLHukYT3lvXwe-taiqWpED-FOqjIbx6A&oe=6AF9E881"}, {"file_name": "screenshot_4.png", "id": "1813981516407871", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620384_1813981519741204_1132822114601823148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrGRRiORF58Q7kNvwGPoED2&_nc_oc=Adox_MOmvjy0hZvRexUyKJnS-XddkSbMMoNtYJw1p9gbInip2db8TslKNzkc9PtxL5o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnPlKzbJL98510nonC8tZxxhSoxPUh9VqZuZNOWQXotg&oe=6AF9C123"}, {"file_name": "screenshot_5.png", "id": "1404023928005449", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593727470_1404023931338782_3520293575106326112_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRiyagWgnE4Q7kNvwFs04L5&_nc_oc=AdrrRI5TK_sFGNaXv8qXA0WMWAo3JhJarw6vyztf5ggmkeRsQzDJIwlrmjL_iW5yxqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8eiIvlrhS14IgsOEcEnyMMpgIYA0xvn403Zm2op9VXQ&oe=6AF9B68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1746378653255515", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623131_1746378656588848_6440766933078258859_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kr0GmRKH5oQ7kNvwFc5hsM&_nc_oc=Ado7g0n6vxqISU5u_S-qjDSos-odgFd_BYkUpSaFOSJsNtAuqqHFD_QtMkvw-C3rDbI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7oi_-5xXkD1sHJuwQ9kH7fxywrzJh9ZS_I7yoF9gj4w&oe=6AF9D5AE"}, "display_name": "God Mode", "keywords": ["god", "sandbox", "civilization", "island", "simulation"], "long_description": "God Mode puts a whole world on the table in front of you, and your hands are the hands of its god.\n\nYOUR HANDS ARE EVERYTHING\nPinch the ground and lift it into hills or push it down into lakes. Take a cloud in your fist and squeeze: it rains where you hold it; dip it in the sea to fill it again. Press two clouds together for a thundercloud and squeeze hard for lightning. Grab the sun and drag it across the sky. Grab the air itself and the whole world turns, slides and zooms in your hands.\n\nA PEOPLE WHO BELIEVE IN YOU\nFive souls and one fire. They gather food, cut timber, quarry stone, build homes and farms, keep sheep and sleep at night. When they need something they pray: wish bubbles rise over the village and the stone tablet tells you what they ask for. Rain, land, timber, stone, food, a fire put out, wolves, a storm, stones from the sky. Every answered prayer is belief, and belief raises their monuments.\n\nFOUR AGES\nThe Stone Circle makes the camp a Kingdom with towers and a keep. The Keep makes a Town with streets and a great tower. The Tower starts the Space Age, a rocket and a countdown to the launch.\n\nKEEP THEM SAFE\nWolves come at night and raiders land from the sea: pick them up and throw them in the ocean. Catch meteors and set them down as star stone. Nobody dies and you cannot lose. A whale, gulls, canoes and bleating sheep live on the island, the world saves itself, and a narrator keeps you company. Controllers or hand tracking.", "short_description": "A living island floats in front of you. Sculpt the land with a pinch, wring rain from the clouds, drag the sun across the sky and pick up the little people who pray to you. Answer their wishes and watch a camp grow into a kingdom, a town and a space age that reaches for the stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/godmode/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/godmode/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": 
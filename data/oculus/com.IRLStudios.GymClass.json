325909295_4201070678705971730_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjU_IGmTiD0Q7kNvwGmI_5p&_nc_oc=AdpZDemOyFYr5NV96TSyMM5DTIhm_jVtR9VJWXLoFuBK_ly0U30ExZvhHCqSkta8Sms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjRXLItVQe0AUJjBeIYl0OOow7d_3knlp0Bop3_2lNZg&oe=6AE1EB77"}, "display_name": "Gym Class", "keywords": [], "long_description": "Jump into an NBA regulation-sized gym from the comfort of your home. Play hoops online with up to 8 others - or practice your shooting, passing, and dunking.\n\nWith the help of cutting edge physics, full-body kinematics, and state-of-the-art networking, Gym Class makes VR basketball feel like the real thing, even if your teammates are thousands of miles away.", "short_description": "Jump into an NBA regulation-sized gym from the comfort of your home. Play hoops online with up to 8 others - or practice your shooting, passing, and dunking.\n\nWith the help of cutting edge physics, full-body kinematics, and state-of-the-art networking, Gym Class makes VR basketball feel like the real thing, even if your teammates are thousands of miles away."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gymclassvr.com/privacy", "developer_terms_of_service_url": "https://gymclassvr.com/tos", "publisher_name": "IRL Studios Inc.", "support_website_url": null, "website_url": "https://gymclassvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING
t=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiGMJFPt058Q7kNvwHSidkP&_nc_oc=Adq1epwXt2YX4VKX3QieUhT8giTNnTBaF-APbDidQUBLj8t76bFGZ6rAKU8D0lITI9s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IxCQ4wuKt0tETx_z_D_VEE_bpJ9jLmoJxQRlfK8bVCg&oe=69DCF66E"}, {"file_name": "2024 Product Page Screenshots - 8.png", "id": "937941248048494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982608_937941251381827_4208153383432172814_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vru8I0pnXyIQ7kNvwHMCr46&_nc_oc=AdrOHPu0FbxJ6VF5WyNSyBDgWegP1c6xMDvl9jZ3MCeD8O1BJw6lQ-t7keNY0WVM_rI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-z_WML4_EHSRF3XGu7muadOaRG5pCiW3QmaAP2meuAA&oe=69DD0372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 188.png", "id": "929288873071612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818890_929288876404945_3595777646564750941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfL7kc_6DgAQ7kNvwGrgGfH&_nc_oc=AdqwB2mU0CNCI2P8QjXGJLgVX85cColFoM-P2K0n5x233SzF_FI7YfwEz_8B57WAmxY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BRX4vVHagf7xyA9M9DCs9CvXOc_Wzk8SWIFn15okHPQ&oe=69DCE505"}, "display_name": "Gym Class", "keywords": ["basketball", "nba", "boxing", "football", "baseball"], "long_description": "**GYM CLASS is the #1 best rated sports game on Meta Quest** - play basketball, boxing, football, baseball, & paintball with realistic physics & massive multiplayer worlds.  \ud83c\udfc0\ud83c\udfc8\u26be\ud83e\udd4a\n\nExperience NBA-licensed team courts and player jerseys, MLB-licensed ballparks and uniforms. Hang with friends, compete, & unlock gear. With weekly updates, there\u2019s always something new in Gym Class VR.\n\n{845878341488272}\n\n**Download FREE today:** \n- \u2705  **Realistic VR Physics**: bring real-life moves to shooting, boxing, dribbling, dunking, pitching, & batting.\n- \ud83c\udfae  **Multiplayer + AI**: compete with friends, meet new players, or practice with AI\n- \ud83c\udf0d  **Massive Worlds**: socialize, explore, & play in large environments built for VR\n- \ud83c\udfc0\u26be\ud83c\udfc8  **Instant Gear**: spawn balls, gloves, & gadgets anywhere\n- \ud83c\udfaf **Challenges + Unlocks**: earn hoodies, jerseys, suits, hats, glasses, mascots, \u201cgreen\u201d effects, gadgets, & more\n\n{1193253625573297}\n\n**NBA Bundle unlocks:**\n- \ud83d\ude2e **30 NBA team Courts**: Virtual replicas of all 30 NBA team courts in arenas & training facilities.\n- \ud83c\udfc6 **NBA team gear**: team apparel sets, ball, and hat - unlock more by playing\n\n{969686844967912}\n\n**MLB Bundle unlocks:**\n- \u26be **30 MLB Ballparks**: 30 MLB branded ballparks with roaring crowds.\n- \ud83d\udc55 **Official Uniforms**: Home & away jerseys, cap & helmet for your favorite MLB club.\n\n{1174479781362169}\n\n**GC PRO unlocks:**\n- \ud83c\udfe0 **Private Servers**: Custom lobbies to play w/ friends\n- \ud83d\udc55 **Full-body Avatars**: customize face details, hair, body shape, height, tattoos, & facial hair..\n- \ud83e\udd16 **PRO Challenges**: premium cosmetic challenges.\n\n{557813239965509}", "short_description": "GYM CLASS is the top VR sports (\ud83c\udfc0 basketball, \ud83e\udd4a boxing, \ud83c\udfc8 football, \u26be baseball, \ud83c\udfa8 paintball) game. Experience NBA licensed team courts & jerseys, MLB licensed ballparks & uniforms, multiplayer games, simulation physics, and massive worlds. Rated best on Quest - make friends or level-up to be the best among millions in the top VR sports community."}]}, "developer_name": "IRL Studios", "developer_privacy_policy_url": "https://gymclass.com/privacy", "developer_terms_of_service_url": "https://gymclass.com/tos", "publisher_name": "IRL Studios", "support_website_url": "https://gymclass.com/support", "website_url": "https://gymclass.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592553
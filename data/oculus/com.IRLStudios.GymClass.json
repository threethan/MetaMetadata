content-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_1173198741432946_5471565925352056225_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lvwkdk0uA-UQ7kNvwEWar5j&_nc_oc=AdoBPbR1DneOnNFNDC9zQwaCdDfbzGBV4nZt6IVSC7eVLvlzejW4791GX8GFTwg5tNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXboVhR_38M_WyR5z1W64ZGHvWW_5aRDBJv_8F1SCx2w&oe=6B1047FB"}, {"file_name": "New Screenshot.png", "id": "1383205436302268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619809_1383205442968934_4795206938435697675_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zuntici-1KQQ7kNvwHszSNm&_nc_oc=AdoX5sincyMlmVF0GC-HVUvugAhse5XtQR6jQEqTutMgJNjU2lm-64CnnwSzM6f8bU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUrwcDI6Z6c9hShYrZ70-PqMLOmgu8n-10yTO_-D0VMEg&oe=6B105C2E"}, {"file_name": "2024 Product Page Screenshots - 8.png", "id": "937941248048494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_937941251381827_4208153383432172814_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1A9ZRk-YaIQ7kNvwGIISXL&_nc_oc=AdoPIIdgMpyN2zX1TTtbM5HxJKiGHhmnhFgMM172r6WDbdsf1dpRxKh9xSVBCQbcni4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX55y4QHUvcG-U4XQOAxsGzJAg6pdwXGLGfsvH9Xh-oUw&oe=6B106932"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "032a03ec-0768-4768-b713-4d608a55c8e6.png", "id": "1158823630231946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842239_1158823633565279_12179569242347879_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJSAwdUAV3sQ7kNvwE16yPo&_nc_oc=AdrkzsGGSvjvBbpiy-YeszTJz_6ByWN2WuOO0P8XkhyBfHLfI6GSyTU6hVHAt0e3Tlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmRPylcQwQDMEND7BQY9ktGc6sQ5FMgi5SQ1ONgFrfnA&oe=6B103F9F"}, "display_name": "Gym Class", "keywords": ["basketball", "nba", "boxing", "football", "baseball"], "long_description": "**GYM CLASS is the #1 best rated sports game on Meta Quest** - play basketball, boxing, football, soccer, baseball, & paintball with realistic physics & massive multiplayer worlds.  \ud83c\udfc0\ud83e\udd4a\ud83c\udfc8\u26bd\u26be\ud83c\udfa8\n\nExperience NBA-licensed team courts and player jerseys, MLB-licensed ballparks and uniforms. Hang with friends, compete, & unlock gear. With weekly updates, there\u2019s always something new in Gym Class VR.\n\n{845878341488272}\n\n**Download FREE today:** \n- \u2705  **Realistic VR Physics**: bring real-life moves to shooting, boxing, dribbling, dunking, pitching, & batting.\n- \ud83c\udfae  **Multiplayer + AI**: compete with friends, meet new players, or practice with AI\n- \ud83c\udf0d  **Massive Worlds**: socialize, explore, & play in large environments built for VR\n- \ud83c\udfc0\u26be\ud83c\udfc8  **Instant Gear**: spawn balls, gloves, & gadgets anywhere\n- \ud83c\udfaf **Challenges + Unlocks**: earn hoodies, jerseys, suits, hats, glasses, mascots, \u201cgreen\u201d effects, gadgets, & more\n\n{1193253625573297}\n\n**NBA Season Pass**\n- \ud83c\udfc6 **Chase Championships**: Play seasons, reach the playoffs, and compete for a ring.\n- \ud83d\ude2e **NBA team courts**: Virtual replicas of all 30 NBA team courts in arenas & training facilities.\n- \ud83d\udc55 **NBA team gear**: team apparel sets, ball, and hat - unlock more by playing\n\n{1815854623044001}\n\n**MLB Bundle**\n- \u26be **30 MLB Ballparks**: 30 MLB branded ballparks with roaring crowds.\n- \ud83d\udc55 **Official Uniforms**: Home & away jerseys, cap & helmet for your favorite MLB club.\n\n{1174479781362169}\n\n**GC PRO**\n- \ud83c\udfe0 **Private Servers**: Custom lobbies to play w/ friends\n- \ud83d\udc55 **Full-body Avatars**: customize face details, hair, body shape, height, tattoos...\n- \ud83e\udd16 **PRO Challenges**: premium cosmetic challenges.\n\n{557813239965509}", "short_description": "GYM CLASS is the top VR sports (\ud83c\udfc0 basketball, \ud83e\udd4a boxing, \ud83c\udfc8 football, \u26bdsoccer, \u26be baseball, \ud83c\udfa8 paintball) game. Experience NBA licensed team courts & jerseys, MLB licensed ballparks & uniforms, multiplayer games, simulation physics, and massive worlds. Rated best on Quest - make friends or level-up to be the best among millions in the top VR sports community."}]}, "developer_name": "IRL Studios", "developer_privacy_policy_url": "https://gymclass.com/privacy", "developer_terms_of_service_url": "https://gymclass.com/tos", "publisher_name": "IRL Studios", "support_website_url": "https://gymclass.com/support", "website_url": "https://gymclass.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29287575957566257"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842225_1693016549066288_3173564965204547495_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl_v2sRxjysQ7kNvwEA23_U&_nc_oc=AdoiAsWofDnnpW6R7C-t93tuJHKUw3FgpyHkxO7dz22w_aLdVbTsEtDSrDL3iKO5DHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPqxPCMuZsduU-1OiCUmVeXkFer-uvO6x4mYPLVAmxaw&oe=6B105F01"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gym Class", "platform": "ANDROID_6DOF", "
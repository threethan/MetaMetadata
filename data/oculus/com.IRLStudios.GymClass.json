t-ord5-2.oculuscdn.com/v/t64.5771-25/499619809_1383205442968934_4795206938435697675_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMd99pWmifwQ7kNvwHJZmKv&_nc_oc=AdpbUxRobgR_7SgKisx1Rz1JGdKrR-ue9WidDF-E4NGPWiC5pS4bKL1vqziHW0_ghzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9mY1PLw5-8zAqb_RnB9HCrmf7QGVUvSll2x6VKxRifw&oe=6A60CC6E"}, {"file_name": "2024 Product Page Screenshots - 8.png", "id": "937941248048494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982608_937941251381827_4208153383432172814_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHsQH15huSsQ7kNvwHE9f5R&_nc_oc=AdqJ32UgPBz5S3FVHglMssX2nXTZq5g2MWneOGMz58JHVFmCeBlJFom_f2d75w1myLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh8HLiHAoW-BKmqrbpjfRLtzZenHk6FWFsEDF58gjUvA&oe=6A60D972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ChatGPT Image Jul 8, 2026, 12_58_47 PM.png", "id": "1076409701733707", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622186_1076409705067040_1177010372589850400_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vf8v0j0iJ-8Q7kNvwHU6VLs&_nc_oc=Adq6-Z5njPXX4d3exfGbSDKaqHPL75LSygIyNipOLNss7lg8FVGQyngJQHPpieK5w-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA05iO7jhPQeudwNWUrbYktqwcGKqqMPFAAuHRLpNvLkA&oe=6A60A5F9"}, "display_name": "Gym Class", "keywords": ["basketball", "nba", "boxing", "football", "baseball"], "long_description": "**GYM CLASS is the #1 best rated sports game on Meta Quest** - play basketball, boxing, football, soccer, baseball, & paintball with realistic physics & massive multiplayer worlds.  \ud83c\udfc0\ud83e\udd4a\ud83c\udfc8\u26bd\u26be\ud83c\udfa8\n\nExperience NBA-licensed team courts and player jerseys, MLB-licensed ballparks and uniforms. Hang with friends, compete, & unlock gear. With weekly updates, there\u2019s always something new in Gym Class VR.\n\n{845878341488272}\n\n**Download FREE today:** \n- \u2705  **Realistic VR Physics**: bring real-life moves to shooting, boxing, dribbling, dunking, pitching, & batting.\n- \ud83c\udfae  **Multiplayer + AI**: compete with friends, meet new players, or practice with AI\n- \ud83c\udf0d  **Massive Worlds**: socialize, explore, & play in large environments built for VR\n- \ud83c\udfc0\u26be\ud83c\udfc8  **Instant Gear**: spawn balls, gloves, & gadgets anywhere\n- \ud83c\udfaf **Challenges + Unlocks**: earn hoodies, jerseys, suits, hats, glasses, mascots, \u201cgreen\u201d effects, gadgets, & more\n\n{1193253625573297}\n\n**NBA Bundle unlocks:**\n- \ud83d\ude2e **30 NBA team Courts**: Virtual replicas of all 30 NBA team courts in arenas & training facilities.\n- \ud83c\udfc6 **NBA team gear**: team apparel sets, ball, and hat - unlock more by playing\n\n{969686844967912}\n\n**MLB Bundle unlocks:**\n- \u26be **30 MLB Ballparks**: 30 MLB branded ballparks with roaring crowds.\n- \ud83d\udc55 **Official Uniforms**: Home & away jerseys, cap & helmet for your favorite MLB club.\n\n{1174479781362169}\n\n**GC PRO unlocks:**\n- \ud83c\udfe0 **Private Servers**: Custom lobbies to play w/ friends\n- \ud83d\udc55 **Full-body Avatars**: customize face details, hair, body shape, height, tattoos, & facial hair..\n- \ud83e\udd16 **PRO Challenges**: premium cosmetic challenges.\n\n{557813239965509}", "short_description": "GYM CLASS is the top VR sports (\ud83c\udfc0 basketball, \ud83e\udd4a boxing, \ud83c\udfc8 football, \u26bdsoccer, \u26be baseball, \ud83c\udfa8 paintball) game. Experience NBA licensed team courts & jerseys, MLB licensed ballparks & uniforms, multiplayer games, simulation physics, and massive worlds. Rated best on Quest - make friends or level-up to be the best among millions in the top VR sports community."}]}, "developer_name": "IRL Studios", "developer_privacy_policy_url": "https://gymclass.com/privacy", "developer_terms_of_service_url": "https://gymclass.com/tos", "publisher_name": "IRL Studios", "support_website_url": "https://gymclass.com/support",
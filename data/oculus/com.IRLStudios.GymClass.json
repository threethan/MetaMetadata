t-hkg1-2.oculuscdn.com&oh=00_AftQRxF-VcchO_MwdJWVFJTr0YuDO7l4O7t6ajx5mHI2dw&oe=69A1A023"}, {"file_name": "2024 Product Page Screenshots - 8.png", "id": "937941248048494", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982608_937941251381827_4208153383432172814_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfXXGXVZPSwQ7kNvwFazXGO&_nc_oc=Adk9gIe86QeQB8uEtCwTTvE4r6dPAXao6Uw3fRYc2tDhjDxvrcF3GTzwxRO7PSsTuNk&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsdR7dY1v_aZRxDdjYFhwYXgwCKKiib18LyMS2BCYmqcg&oe=69A177B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 188.png", "id": "897286809426027", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499303471_897286812759360_6826516211081184817_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hc8t_G5hwzgQ7kNvwHuprpw&_nc_oc=Adl-6otMRmYfdsznH8zuhAsyOBJ8_kPzZUEcmPo4VKXN_FVP5Q9byXrr94Rgqtci_vw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afuo2ryqFPvOu81EeCOic7NerqbPTakP7Ez9zRdfVc7jRw&oe=69A1A710"}, "display_name": "Gym Class", "keywords": ["basketball", "nba", "sports", "social", "boxing"], "long_description": "**GYM CLASS is the #1 best rated sports game on Meta Quest** - play basketball, boxing, baseball, football, & paintball with realistic physics & massive multiplayer worlds.  \ud83c\udfc0\ud83c\udfc8\u26be\ud83e\udd4a\n\nStep onto NBA-licensed team courts & explore MLB-licensed ballparks. Hang with friends, compete, & unlock gear. With weekly updates, there\u2019s always something new in Gym Class VR.\n\n{845878341488272}\n\n**Download FREE today:** \n- \u2705  **Realistic VR Physics**: bring real-life moves to shooting, boxing, dribbling, dunking, pitching, & batting.\n- \ud83c\udfae  **Multiplayer + AI**: compete with friends, meet new players, or practice with AI\n- \ud83c\udf0d  **Massive Worlds**: socialize, explore, & play in large environments built for VR\n- \ud83c\udfc0\u26be\ud83c\udfc8  **Instant Gear**: spawn balls, gloves, & gadgets anywhere\n- \ud83c\udfaf **Challenges + Unlocks**: earn hoodies, jerseys, suits, hats, glasses, mascots, \u201cgreen\u201d effects, gadgets, & more\n\n{1193253625573297}\n\n**NBA Bundle unlocks:**\n- \ud83d\ude2e **30 NBA team Courts**: Virtual replicas of all 30 NBA team courts in arenas & training facilities.\n- \ud83c\udfc6 **NBA team gear**: team apparel sets, ball, and hat - unlock more by playing\n\n{969686844967912}\n\n**MLB Bundle unlocks:**\n- \u26be **30 MLB Ballparks**: 30 MLB branded ballparks with roaring crowds.\n- \ud83d\udc55 **Official Uniforms**: Home & away jerseys, cap & helmet for your favorite MLB club.\n\n{1174479781362169}\n\n**GC PRO unlocks:**\n- \ud83c\udfe0 **Private Servers**: Custom lobbies to play w/ friends\n- \ud83d\udc55 **Fullbody Avatars**: customize face details, hair, body shape, height, tattoos, & facial hair..\n- \ud83e\udd16 **PRO Challenges**: premium cosmetic challenges.\n\n{557813239965509}", "short_description": "\ud83c\udfc0\u26be\ud83c\udfc8\ud83e\udd4a\ud83c\udfa8 GYM CLASS is the top VR sports (basketball, boxing, baseball, football, paintball) game. Experience NBA licensed team courts, MLB licensed ballparks & uniforms, multiplayer games, simulation physics, and massive worlds. Rated best on Quest - make friends or level-up to be the best among millions in the top VR sports community."}]}, "developer_name": "IRL Studios", "developer_privacy_policy_url": "https://gymclass.com/privacy", "developer_terms_of_service_url": "https://gymclass.com/tos", "publisher_name": "IRL Studios", "support_website_url": "https://gymclass.com/support", "website_url": "https://gymclass.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_
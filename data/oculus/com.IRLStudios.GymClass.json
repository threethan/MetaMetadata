a&_nc_ohc=_JT65hZfhkQQ7kNvwG3NzrJ&_nc_oc=AdqCXCF7-_MM4_r4Gl5Y8pz37RpT4Gc35hXCf0mPaJ6tYEtCegZkNwrLS346pE3QOMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6FCMxdfsoRVO4KH1AjKeuUghr6fnMgADyL9C2dex5PQ&oe=6B046A7B"}, {"file_name": "New Screenshot.png", "id": "1383205436302268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619809_1383205442968934_4795206938435697675_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=956oZmvPLFwQ7kNvwGQ_UC9&_nc_oc=Adqk53w753qW5g11NoSXwBerflR8lAw2h_qj2S9dF_PQUzvt0Qhm7ES1l9228BEKZqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_L6C8ldiEl_gNhG6KbEOvF8DDWLdKPSYDgqi6TW07FQ&oe=6B047EAE"}, {"file_name": "2024 Product Page Screenshots - 8.png", "id": "937941248048494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982608_937941251381827_4208153383432172814_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh37IZSazuIQ7kNvwGvD8Mq&_nc_oc=AdpyOEkiqxG5by9fOmeGnGQpoCcnWW2MVzURDdhh0ytw7ma1q94XR8kKsPtgwd7kwI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS__G0iGbQNp5cIIBpgzuB6dXbIg15mpaZ8j9_cPF9mNg&oe=6B045372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9457519e-a0f8-451a-b298-74e358048826.png", "id": "1555609446584430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312310_1555609449917763_9098035245106982098_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-HM6EckAcYQ7kNvwE75pk5&_nc_oc=AdryEA4b6vBQYEfGLBs13vVajyAb5i5Bm2B3FJjGgmyFyAp9ZfCLonppgR21-IB7fhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ40-U_nv-IZkaxuSB23FEuYA3_idkuffmxXEd0OptzZg&oe=6B048952"}, "display_name": "Gym Class", "keywords": ["basketball", "nba", "boxing", "football", "baseball"], "long_description": "**GYM CLASS is the #1 best rated sports game on Meta Quest** - play basketball, boxing, football, soccer, baseball, & paintball with realistic physics & massive multiplayer worlds.  \ud83c\udfc0\ud83e\udd4a\ud83c\udfc8\u26bd\u26be\ud83c\udfa8\n\nExperience NBA-licensed team courts and player jerseys, MLB-licensed ballparks and uniforms. Hang with friends, compete, & unlock gear. With weekly updates, there\u2019s always something new in Gym Class VR.\n\n{845878341488272}\n\n**Download FREE today:** \n- \u2705  **Realistic VR Physics**: bring real-life moves to shooting, boxing, dribbling, dunking, pitching, & batting.\n- \ud83c\udfae  **Multiplayer + AI**: compete with friends, meet new players, or practice with AI\n- \ud83c\udf0d  **Massive Worlds**: socialize, explore, & play in large environments built for VR\n- \ud83c\udfc0\u26be\ud83c\udfc8  **Instant Gear**: spawn balls, gloves, & gadgets anywhere\n- \ud83c\udfaf **Challenges + Unlocks**: earn hoodies, jerseys, suits, hats, glasses, mascots, \u201cgreen\u201d effects, gadgets, & more\n\n{1193253625573297}\n\n**NBA Bundle unlocks:**\n- \ud83d\ude2e **30 NBA team Courts**: Virtual replicas of all 30 NBA team courts in arenas & training facilities.\n- \ud83c\udfc6 **NBA team gear**: team apparel sets, ball, and hat - unlock more by playing\n\n{969686844967912}\n\n**MLB Bundle unlocks:**\n- \u26be **30 MLB Ballparks**: 30 MLB branded ballparks with roaring crowds.\n- \ud83d\udc55 **Official Uniforms**: Home & away jerseys, cap & helmet for your favorite MLB club.\n\n{1174479781362169}\n\n**GC PRO unlocks:**\n- \ud83c\udfe0 **Private Servers**: Custom lobbies to play w/ friends\n- \ud83d\udc55 **Full-body Avatars**: customize face details, hair, body shape, height, tattoos, & facial hair..\n- \ud83e\udd16 **PRO Challenges**: premium cosmetic challenges.\n\n{557813239965509}", "short_description": "GYM CLASS is the top VR sports (\ud83c\udfc0 basketball, \ud83e\udd4a boxing, \ud83c\udfc8 football, \u26bdsoccer, \u26be baseball, \ud83c\udfa8 paintball) game. Experience NBA licensed team courts & jerseys, MLB licensed ballparks & uniforms, multiplayer games, simulation physics, and massive worlds. Rated best on Quest - make friends or level-up to be the best among millions in the top VR sports community."}]}, "developer_name": "IRL Studios", "developer_privacy_policy_url": "https://gymclass.com/privacy", "developer_terms_of_service_url": "https://gymclass.com/tos", "publisher_name": "IRL Studios", "support_website_url": "https://gymclass.com/support", "website_url": "https://gymclass.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1023770785722696"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SOCIAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "29187259110931276"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835844_1623850378971791_2416890448580790890_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aTp98y47cMQ7kNvwG-mk9r&_nc_oc=AdowFOQ6iuQx7WWST1nW-17VcQelR0O7nX1KOkYUqFU9RQAynRtNMjmYWgZ07zlBURg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfC8m-KKs2GINv-xsdp60-u6fzbFWFTbJ3ekroL5ZKPA&oe=6B045798"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gym Class", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name":
-7NxB7VcoYusXhWf6XfFgrjwlk1uutj3B9o3PaiRa0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iEMRZ7ac4lsHj36lSXgZAV3Kj_xQKJIM1BNWa2FRn6w&oe=6A009E57"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLa7m3f06coQ7kNvwGh8Wxv&_nc_oc=Adodhwb7INftGj1DrpCw-TyoLKfVFMKhLM4xggaAU4qDO18oLoVUmcZdbS6mQ0UGsAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R1ezfASBJ7q66o78-uzcaFrzQYVrVFO2IqcHOp7iUjw&oe=6A008FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X1Jc92wuFoQ7kNvwEY3TA9&_nc_oc=AdoHalfXHYbKc3eIQr7wHFNNVrCqGV0O8IjFE7QuYrrb0OEPbOeLDoO-dtBUgnppWos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43jNeDalZA7ZccAkTngmxJbArs2iC0oEskpc7UEnp5Yw&oe=6A008A55"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.com/pr
578895109_8431858354574679996_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD4BGFnvrewQ7kNvwH8Kvcv&_nc_oc=AdreF6khVs_3Taxc0iCfWFdJF1AbYOPx6ueoYoHncefyTvCgZmMMkNL9sNZRR13DmPU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57d86phwuzO_mNd_Ww0Hro1DSycnx3BZOkoLjvmaTujg&oe=6A11A5EF"}, {"file_name": "3.png", "id": "396568751923810", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003227_396568755257143_4288879441088232205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Xs9apvvOCsQ7kNvwED-vn_&_nc_oc=AdqexsVKKMyh5ZSxllkT7igoZ6ZISW5mn254eB-6XfwA1AkfMjkjuzf5M05u6kJSUWs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mx_5qSXLQN8NCOaCom8BgZikESeiqUf-R4p28gL6_TA&oe=6A11BA48"}, {"file_name": "2.png", "id": "1377939119298691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003227_1377939122632024_3982681734352816117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTjStgPBl1AQ7kNvwEZbByC&_nc_oc=AdoiFyEzEg2lYf-tHGYeCA6iRk1MD1KQM1mzU6WLKNpfUlodaR53FNWf_vy6ICuXfUE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G_QItsiaG-3e8KFVKLs0jFGH6nVFlM1APEbdM1MrZsQ&oe=6A11C1D7"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--Wkw5t2X-4Q7kNvwEzGMgv&_nc_oc=AdrzbxmY-fBkam_9ywISBcHZD0-AURqjSDM-9w2K2ueDtu81sovo1PEd8D1Lj8tzTPY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59kR4Rx8kq5RwR2lM1vZIeZAQ4KQi3K0NzvfpiJ6jA7g&oe=6A11B351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnqXCnM6878Q7kNvwHTC15g&_nc_oc=AdpsjUO8ZqnMZI0onpe3qA2TtQtsOQ1gpxu27hkwJV_hzwsySei3gspQYkhxtR4OVlk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dPf5w6sWnphZNYeyrJxN53QkJIWpfN9F6JLwGEMrHqA&oe=6A11ADD5"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforks.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sharp Forks Labs", "support_website_url": null, "website_url": "https://sharpforks.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7918103034942829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031593_506833757518240_5003337051558930827_n.png?stp=dst-png_s360
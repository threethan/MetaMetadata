8&oh=00_AfzzSvwst6ZCMpX23TKwt05sozmgRqQ6vcAviWYSdBjNOA&oe=69AC0617"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-K7wlndyFAQ7kNvwHNBpK4&_nc_oc=AdmtlgAPKMKXhL4B-UXcy2SAQfoR4Ex9q_xpCDMTHKCWaplhzCWFR2DdafwLER4njI4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPmtp4JpFbHdElRvUUWacxI4MzDzsHD40F-sEPmGYs1g&oe=69AC2FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIL8wXUz9a4Q7kNvwGikux-&_nc_oc=AdliHLFY-QvR9NaB_H5uBk8eIqGQn61_DS3tyvhmyEU7jg6WFHHGkHOfkhu7oT300PY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfaL7gBcgNG0v1DtYfnEXxsjBHJ9YR_d9VwvAcWzVOQw&oe=69AC2A55"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.com/privacy-policy-drum-set-vr/", "developer_terms_of_service_url": null, "publisher_name": "Sharp Forks Labs", "s
578895109_8431858354574679996_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q30KBBsXGgQQ7kNvwHor7nH&_nc_oc=Ado3hXmeTYS_G-CfyTQmXvCR0gt2ud4g_XrH2V6ugn9mleCJqFPVfv32xVMb0Lk4Ods&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyZY3cUsoNEi99GZQeKaKY8k6bNzC3bCjen7fbukHG5w&oe=6AA9426F"}, {"file_name": "3.png", "id": "396568751923810", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003227_396568755257143_4288879441088232205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NJc9p7Q3ZH8Q7kNvwEsvvsA&_nc_oc=AdqiftaxyaofcaeQE91TkBFxUx6fHe3VlnEVTmsQ0Vbydyv4mdnFyll7U1ON7W-uVAo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKudWX8wkF5o4OMnURrn31TyKdJuQNoWHiv_JMwjJcSKA&oe=6AA956C8"}, {"file_name": "2.png", "id": "1377939119298691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003227_1377939122632024_3982681734352816117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg2YZz2oMCcQ7kNvwH-BZjY&_nc_oc=AdqvxOLSV48uzFU8bt2l05--rjTWB7epnE2wnmvaGxCPejlZb2GeWY96LOo_Frj09WQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Yoh9w87gVUbwPjFhc7UrVieK7pEPu4ALsftAwCBfzQ&oe=6AA95E57"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ye2sgF_CZ8Q7kNvwFxQeKM&_nc_oc=Adph04ug06mq96hPSKpMjLR7dYThoe4Zjo7Qv1Z0gmla20pDmTF_Yz9wG4CNnkozsn0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLJrMnCKlPL8UYNz0yhrSia3WT4_H_iInl4d0Bt_vEaA&oe=6AA94FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zfgq5RPBlr4Q7kNvwH6hWvj&_nc_oc=Adoh7TvKBmUrtJoREiYKr3JdCHoB221rXi_vLQjMkFTysTHBkeQY0ILURooAHjUhdNc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0qxzJj1V-tkI0BkKEONL19v9Ly_7GN5gw6DPBykLkvg&oe=6AA94A55"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforks.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sharp Forks Labs", "support_website_url": null, "website_url": "https://sharpforks.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7918103034942829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031593_506833757518240_5003337051558930827_n.png?stp=dst-png_s360
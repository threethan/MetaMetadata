vf0wac_PPEIQMxmJHJ50TKixgcoy9n5NZ0Wf74ToW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KUg_cc3QXPEB6PrhBT_Q713mCqgRvpt59E0_aLHtfYg&oe=69DB7C17"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_taDMWzAJ40Q7kNvwGe36Pj&_nc_oc=AdrI2r2o0XvlAZyLNYSeFn5ifAMUczL9ho6izPZnw2tmaY4arR82dGe5uxvzAXdxCQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02A4a8FTFUhrFait5T8nzdcJLMt7Hok6b3ttU06tlziA&oe=69DBA5D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Co1hD5zVQA0Q7kNvwH8nCJy&_nc_oc=AdrvHif-cyesgJSiSjeGsDE2-kM22ftd0FzvM8Gfs81MtsEfC1bGu0BcGh6qTy_EGq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pRXqPhpARifqMmhyalN-jVShOHzEKqTKhMLwcc75apg&oe=69DBA055"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.com/pr
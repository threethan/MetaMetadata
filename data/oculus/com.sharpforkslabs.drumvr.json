578895109_8431858354574679996_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2u5HWZgA08Q7kNvwG_ZBeu&_nc_oc=Adq1ig__Ysxj9RtMD1WhsGz-_XD39kzMDOprowfXrrCiIjkeMxph_1ZBpfvPkzEu4f8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYD10ArwxbvpYZ_aBe5Cf1r0qYYAgs4zlKqImX4xuOeg&oe=6AA3FC6F"}, {"file_name": "3.png", "id": "396568751923810", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003227_396568755257143_4288879441088232205_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYmdm_HR0wwQ7kNvwFjYK_8&_nc_oc=Adpp0qSygscuKE0yKsaC0gkR4bfEc2-NkAG0JTKkSuzuHqzp-I-uRlwS81k0ad-dey0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJpIKkoNOV8tU0VCV6IaYdsfRSYpBAk0-pYtcnSZeygQ&oe=6AA410C8"}, {"file_name": "2.png", "id": "1377939119298691", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003227_1377939122632024_3982681734352816117_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53e1QCDDkSgQ7kNvwGCws7i&_nc_oc=AdqxF0IAg6HdUUG9XtRSynxPP_tKMSIVQPL0JFXdS2auNrD0akiEnqfUfadCHJSn2gw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq3B5grUPlArtPGhGPTlk0iEKxBx_P2e76dv3LRSkQcA&oe=6AA41857"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGfw2eOD7WEQ7kNvwFEGVBY&_nc_oc=AdpnHeCvKEEcXOMKxYb7sWTG9bn9mDgvMavNcifIEZTYcNvogLQlyaenGfgdVVL3F6s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLJmjCMUtbjwHE3uwREqPI2nepul6U7bAPZF35cZ1Fzg&oe=6AA409D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAqd5qCOFGkQ7kNvwHaisW-&_nc_oc=AdrxjR6BKAKOAP6oRA4z6KYM41rsdRA2M_ym8DqIbsZ6Dcc2911m1bAwItEIaOH_dwY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3HTaIFQn5F3Z4mO7Kw6WnQz-bi6ne4zUwGiGWPYjEKQ&oe=6AA40455"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforks.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Sharp Forks Labs", "support_website_url": null, "website_url": "https://sharpforks.com/", "category": "ENTERTAINMENT", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7918103034942829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031593_506833757518240_5003337051558930827_n.png?stp=dst-png_s360
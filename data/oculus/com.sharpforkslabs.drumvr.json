_6QfnayQF9EK0K-BlAbnga7x3c0asN8yZPR4sBFpg2Nmdk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImK-yUkR8-WMY5l-DVF1rr_ACu2QHK83ArOdUOCvrVcQ&oe=6AAEA457"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isw3LbsBNW0Q7kNvwFl6NdV&_nc_oc=AdogjpmMK1PZ3aylgc1xNHAWMvH4N57bS4vdEDee_EJHqE5hJTA2mW7Rg9Z_MGoEKGo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr28SrHIanZtSYTzASAMJVSe0VqJx8oVwaghaNLh9ShQ&oe=6AAE95D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmaIf2rY2lEQ7kNvwGReimU&_nc_oc=Adr_nRQwCtOpsGCmAcBzNw3WH1PILbxTQBi7TvAytrZf0zH_lwGxtNHtrY3fe8ZA4hw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDnxp8inEWCI_s2Hlyon7RnPCVdtF3QEP3-WflYiPgtQ&oe=6AAE9055"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.co
Y9mqqNxWbpnDkNjHX9RAcLDKFD1L-09ZDnS0DXl31o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HgaualNVSgsTaR6chhOKma_k_oUhvjkhkW-uVXvu_1g&oe=6A1D9F57"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AipbKE87nQQ7kNvwH_zPyB&_nc_oc=Ado7o_FUsljRzAF46YCNqUMHzzkcAa_IRMEtkn_UH0DZ1tYGcQ7ZkNH6j7n7Cj3v9OU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ffLos23PylyuolQNUHsJKNlsglrwmK-jccwilPCGKgQ&oe=6A1D90D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKof85Pt6vMQ7kNvwHQvcec&_nc_oc=AdpECF0xczD6uGCSDXm6UJZEz6lohQba27qM6ergEOh13AepoTDv_Y1mZhBONczVj7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jcL-lZA4eY-SEFuEiBewLomXULXMK1gaRWfEw_0TFLQ&oe=6A1D8B55"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.com/pr
YJUfx9G0HXX2urN4BorUDYabIaV3R2RyeKgLg7PiGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYpBPUz71LXFoHrzhpnxvaqwppmoyQp1cokRR6fzHorw&oe=6A622D57"}, {"file_name": "4.png", "id": "340927541386482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984466_340927544719815_1227204284899317137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7WAHSndpgAQ7kNvwHwdBY-&_nc_oc=AdqXPruSAdcJ8HytItEDxZaTLagaONieQyRgMfE0SZFRfiDX1sK9Acc9rjxLdnL91is&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeACZFQxe0E0v9BZWD7sk38gfmhgTcid0_UOTNFQhOFQ&oe=6A621ED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1106939706764181", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031375_1106939710097514_5510039485553906540_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfJm3nKiUR0Q7kNvwHkA6wf&_nc_oc=AdqEBASTSHTt4RNS7cUEmOaMR0xRrsYggxMkZ3kRA-8Z5RuinVmIq2pGK7HSy9UAte8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmlP3jbCrJZq-rT-fQLad_zto3iiGrY3l7xaTO5ZgJeQ&oe=6A621955"}, "display_name": "Drum Set VR: Learn & Play Drums Beat Games", "keywords": [], "long_description": "Drum Set VR: Learn & Play Drums Beat Games is a classic drum kit with a bass drum, snare drum, 2 Tom tom, and 3 cymbals. Drum Set VR: Learn & Play Drums Beat Games uses high quality professionally recorded sounds fully designed by the help of our drummers to recreate a realistic playing experience. Simply use your joysticks like you would drumsticks and tap, click, and bang on the drums as you would in real life.\nLearn your favorite songs, create your own beats, or simply have fun!\n", "short_description": "The 1st immersive drum expirence on VR. Easily create your own beats with no previous experience needed! Become a professional drummer without actually owning a drum kit in the comfort of your own home!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sharpforksapps.com/pr
20nQqNcD9F3RbZtg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjnOlmlEj1BVwDax5Cs7AvOQDoC8aayB5CYcykeUitrQ&oe=6AB6759B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87f4cFbqSx4Q7kNvwEkQlzL&_nc_oc=AdqNnKvskmPCIsB56t-BvaEHbdn30BL3RojQWZRmVIvWjeStI1yXwBWO6_Kxk1dvzQw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnjgEH5cyDjqgc5YduPodF_tdk2eGyZXkZjY5l_47TRw&oe=6AB6713B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bb9R-ckL0QYQ7kNvwE0BFvv&_nc_oc=AdpOw1Xd9wEPOSWiK_x29APRQJbGaMy3VR6TpXSc6j-uqWnZOVXqe5rWNRYrYJMqT2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg_CE9MipGB10KqheR9WK6cnkQuG4QS399GjKiezGZ9Q&oe=6AB67236"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-lL3l4FRo4Q7kNvwE1Jm1X&_nc_oc=AdrG8Fn1mzPOo4sngpsNT_XTXhUikMyKpU-8dUki8UdI9II7RxVaDVpxbXYT2O88HpE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJD4DWppACgqlOF6il8wDQUNyxFyei6VpdhHTivryqHA&oe=6AB675A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g1s1KVFpN8Q7kNvwHFfBiv&_nc_oc=Ado_6GcV-_sIarmnsoQd8z0GD8_wPsNpgRw6V9hr0OF1BAU8XL6bqNrR2CdjjntN0EY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_QE1r2FOf_qGj_SlRsic-kE0scZ-kKHnCryWuXgP9KA&oe=6AB66ADD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
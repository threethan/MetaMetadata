JCxNSDO3IlBO3Xok&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rA1SYafLgxa7cZHBgY6rik5qczTUxV-aXYg9d98YR8A&oe=6A329F9B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSkkZ0iJ-zMQ7kNvwGhY9VW&_nc_oc=AdrlRo96QtqevXur_nWk5VZufdicJGgv8PPIeP6jXb5H7eI2iv7wI1pkn7PjjiTm0RY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NJDQuwvKhUzg_gBfeKd1KJFevByUb-T6zOMhhYH4s_g&oe=6A329B3B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Min1yHMfZjgQ7kNvwEgzqKr&_nc_oc=AdqUWgiDYBkgpby7Mte05-t-ZIzzUuZQJicBRXDBDsEBL8LyYhZTZ5qXUuNBJV_8U34&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fjm9LXx2uqn4Xy0E0b7z81v6apLWF4p-afPc2fOUPUQ&oe=6A329C36"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMqSMxigXH4Q7kNvwH00ABp&_nc_oc=Adq1MkA6G8VEFoTTqfZWZIp-cWE7fdmGHuASmMhpPnxq9DpW75OWWzALeVF5n9cTTYg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AiOKhW8y8DsUtIq9Th1N230N1H5Ax6mGBrjGXT6Lb0A&oe=6A329FA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo8c56dJMBAQ7kNvwEgrXsS&_nc_oc=Adq045pmiMvW2bOk4-F8L5EOUEJgT82jEskLzbLgdYsBqqsMCy3_VyRgtERId025Cuk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3TN0x4tOIeV8TzFuc3URdDReUA01aWw_HVzubDytivA&oe=6A3294DD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
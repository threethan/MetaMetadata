wjPuu5K3-QHliqZM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5pFx_CP5ZJGoHq4Vh-JxA4cq7XNCPAfqBhaNugT0eug&oe=6A97421B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7leRQZAi_2QQ7kNvwFDKl_Y&_nc_oc=AdqIZKCA6GPPJIjIbKWLVD1xRmjy_1RmfZOfD4hjF7IzJ-xSRWt-eq1Ob8Q6wyBYWjM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP_qv4d6eomAEkbI5TFUdAkKJHk5m6E4pJDfWFbwpdtw&oe=6A973DBB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDCels-YuxkQ7kNvwHJQnbU&_nc_oc=AdowuhHzfy272_JuQDtVHYtb7RwaBgtMs_45nQqEZ_7toyDT8GWaQvfWbN7czn7J3r4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6buZXtkg8BxeDV5luHw1-s8Xm6fCYU23l4oTJ6tJ2sA&oe=6A973EB6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_1GvEZ9xr0Q7kNvwGNbyb5&_nc_oc=AdpQiiASbc9b5tacbghp07hGXYWx34e5EmmXCMxvD_AAHmBZvFYbNzDVdFoYeHmkQtU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRSbz8yGM-uRHXIVkljbmFqCXoTDY65-s8Pa1yujz5qg&oe=6A974225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2d7TC5WZjwgQ7kNvwHroDTn&_nc_oc=Adrb-D81FdfKfSJd0ipIRMq4Stb3qlnaZuJHsg5zqKYtUQnNJv9n2i8_gVTt4YYXLl8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjQoXAI6NBSk0rtj3iwqwSAxHeTCkvlqdl2D3Apv6DlQ&oe=6A97375D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
5CDtSXdgUOj1cnNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInrsd8GS_aBkJQQ5YIknahjq0zwnsi8Nj2QP8-3x1Yyw&oe=6A9C179B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns1kQ5qayjcQ7kNvwE-1VBd&_nc_oc=Ado6kd27oHkQ8qDHzKwFHMi3VrGzv5BskfkQ5zsUIjJFyggW3SYkCqqVcLj2Vdc0GLI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXHHUnHSm_q0cEWay0ZAUyvZKtCDv-HSN25f4yFRJt7g&oe=6A9C133B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E__cV-MT1F8Q7kNvwFBWoBa&_nc_oc=Adrji6kQUm2NF5SUhKtYK5uDwXbVhs8EWoIzfRfG8bLrjHsftLWJr0Kz5IisHLLwxq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpwR029oXY_05fmGn6z4-9Vj0xBAcGXO5UgEpql97Xnw&oe=6A9C1436"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CadM2JqG4NUQ7kNvwGG_tTv&_nc_oc=Adr5fwom9al44Avjq_IWxmGaa4GhdF9fYq0qNgO9MNG4D_zjxn4Pugr4WiH6l0rzC5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2-f8xDbpW3ckl07NhkftHBu06drLrEd-BeCr6YEjMJQ&oe=6A9C17A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olVrk1OnoXQQ7kNvwEu3Ur0&_nc_oc=AdrK4wVKiJ3enfz6n4-ZYMjbPLFEIsjurZQP6u4g_h3VteyzqmiubCQTkXsWAupWTmk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdnvFKzgKEMJ95j8WvAF03ulrWQ4sK2g2-x14FWR7v1Q&oe=6A9C0CDD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
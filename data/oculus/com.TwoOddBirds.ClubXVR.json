ibFmAbF_jEohTyKzotxQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4T79ld7EjOoVqo7dy7T_aIdnXZCdC5CC6OaA0MCcj5w&oe=6A7DC51B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGWjh8FIz0UQ7kNvwH1PNcO&_nc_oc=Adp7qqTwVwGpuu5p4H9dqnn8E3btU2vEYJ3BEH8u5tSkKPUDissK_EN4737q2NHeyMo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHklNvcJXN5WRJ2_8f7tMM9CaAUwrILIzLkH3-ZNkRVZg&oe=6A7DC0BB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbBCsCpq63EQ7kNvwGB-oR7&_nc_oc=AdqFsbykl7R4NAxUP8vMgc0TUBDbo13RspI_gS4NUpfQtau-pfE05oECv9yOGWOoo9k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQr-ndV3dUkhBOOCbBDhJ9m3_iY5NSgwlUf9csSHzntw&oe=6A7DC1B6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yawYI6k3rp8Q7kNvwHhsSdx&_nc_oc=Ado31gnBTNafYOS-rZLNWyffcclAhO2Nj2ko3PnBeIF4fFevrdXqIboyVm7UdgPKfFs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRpivekwt4-Wexwlbrjc_zg0xNy-Nf26ZSwcPmwKhc7g&oe=6A7DC525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFgWZB3bMxAQ7kNvwG8rjEv&_nc_oc=Adoa4v_hOVssyK19xfNUnxYRu1kF0N7YQa8c8lmxHX0vLeGrAKz_qLOy9OqYDDKng0k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgdfPGpLR9zj3I-DG580ktzgnXmSOtzRArWQsyHloWmA&oe=6A7DBA5D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
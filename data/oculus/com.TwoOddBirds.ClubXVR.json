eTaRfkE38IsfwzmY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLcyqH_cyJCioToKPNbB2ANJOveCNoMLIke8koMwMWqA&oe=6AA00C1B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MwizAvVPvIQ7kNvwFN0EgV&_nc_oc=Adr4kItgE4QbQewpg_5RCgzoH02Jf_Al1n4y8Fa9_JIQ7AhlBykUavluUtt8fVO0V8k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC8LIeL04ei3I8KVvqwYE7CRY4votUod3NtzTWn_1VMQ&oe=6AA007BB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efzaRQiPOV8Q7kNvwErtRQF&_nc_oc=AdrJ2uzI8vQXvX3ma8Q9GEml4Sb7cwZtJyHbkjt01vCozUC-XscOJdqOkJQSWh51QFA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB_T_qJ2v6qcFHz9Vip4_ZKkOoarsiMgcDP4G92I9ADA&oe=6AA008B6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhYhZ1Mr_XIQ7kNvwHc0fBx&_nc_oc=AdqxG8ujbDwrW94ZxnEunvsg9nb2scjemY34jdR-t6nVOgT1qUiH52jW-_jkbaKxgHE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4mwZ9w9WZl6IJTaQLNs_CkzRaMnicuzP9KT2uyifseQ&oe=6AA00C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArJg27L3qL0Q7kNvwExu3vQ&_nc_oc=AdrMNu5XzW6-3xPzfwaHfqZG8LmwsyulSfThG8qR7ZA3MfZFAXGXHAQtbMT84D_o_hY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNj3HQm1SBth3Isk9-W7BbqZEYLCIY6CR2rkVEyRC2rg&oe=6AA0015D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
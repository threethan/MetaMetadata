_YxSn3qPeEt06ACI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lJJ6EDpCLxqFdLrw8sejykYGNP73NLJYYOVVyA_D48A&oe=69EF631B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAM19sW5EL0Q7kNvwFq4-ae&_nc_oc=AdoUqIuXeHNg1N-ayzl9yyZC9894RC_KXMRXNRsIrfStrm3QoHHijKPTrLat1t_5Cv0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wUD4rEGLxJmeFErH2LTB7oPGxP6-LtI0_OueYzLvFew&oe=69EF5EBB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-YPrpV3vSwQ7kNvwGIVK2K&_nc_oc=Ado6Zn2mQPufmVwfjlcfleeIu6QQ1cK_j1t7Lo92Ut7r5Hhoy1qRz6DA57q5nd4xAYE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1shHlSlVlvyPleDv04L1nXQjy6QNkkaYQGSVISMDdkXQ&oe=69EF5FB6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2lv9ISQiWUQ7kNvwEFzdMf&_nc_oc=AdrDHcV-jleYmT1vRI4sGTkyzC8eZp7h0WstlMYgp1inufDBu5_fU5-TvE9ASuMdV0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ty_RBI0_hg-zpG78Oogte7DuciU_2cM4ge7pv_HXlkg&oe=69EF6325"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pcqr4nQQX8gQ7kNvwEy5FnM&_nc_oc=AdolXQvSerWlrY2IpIS8NtaUO0-ggAAu3PMU-ejPzntTyNRCOk5Fu5etbtoDifrq5sw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DRTLFaPewV00RZgVFlRkAQfMwYRUC8gd62OSIT-z97w&oe=69EF585D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
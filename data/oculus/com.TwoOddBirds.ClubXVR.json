9Xngp5EsnJQTPnQc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPJ-ZzQ7CILmYYr3qqRG6oxaiY47sjJGmi-rH3ntA3Q&oe=6A81B99B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv6f_BtJ7VkQ7kNvwF6Yvdv&_nc_oc=AdqkXJ5GJG2gLrLKdhTP6pEY1db8w3gxwx_SSlVM11fWgnkT3EoFnwPSQb4zsic4TrE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgrfThO588fu2v7Ip01gTy3-RA2BsPI_2o0QrTPTJWAQ&oe=6A81B53B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqwvX52GJJcQ7kNvwHfLTC7&_nc_oc=AdorO7TAxDnMZuWUNiB1YLFK2rF0eW_uuOruJ9JVr3TVufWiD1IgTM5NHLwACUd4sBc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9MQvrBqq94OeCi7UFJQtpBcLTxv0AXLHAde-sF4i0BQ&oe=6A81B636"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWJ1YrshfyoQ7kNvwFIeqBQ&_nc_oc=Adqsh1NauA20eC4IUdJgHXx1jOH12Lh43wWovs9wzt-9HjnYr1Qu_J4RcRXkJeToPYE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_bDUH9IOF3bJTK1qPpORrV4KN4v39A1q2K7BZA0g6MA&oe=6A81B9A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vESewIbt6J4Q7kNvwG-DZ-Y&_nc_oc=AdqIWeZwU7aPPejXvbDIbr6Fykl_ZHtO5Ho9o4d1lmjk_NRnt33D1FDl4RZUkAIyGck&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrkxJEI2e4rqWAkKu-slRrKcDEvc6MtThMozhh4OhJ4A&oe=6A81AEDD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
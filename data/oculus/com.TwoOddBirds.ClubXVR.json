3UHSBK644dVTf0TE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa955BQrWCKVWalMj85xRpAyNieDpttn6XRisQjv71aA&oe=6A54E69B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXilZF4OWAYQ7kNvwE7l7Md&_nc_oc=AdoaAk3Wy6q3DsiYZhe1MiaB4Dw_eYvWlbvMyZZoRH2mjOPMzbNEmQdE0KKk_0dYJpU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1oU9JbghnP91lOZ7ZXRLdNo2Fwxot61WzxLH7LGhWYg&oe=6A54E23B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ4C1XqtFEAQ7kNvwH-4Rtu&_nc_oc=AdpjXxb5Ms0ne1IICCFrfvuxjUTKWTJbAj0ppvrwzoy57iRKSVIOb_7Er8-OpQ8YnJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvYnl48OwOmv65NsztC2OT7gtaPNw1rhWfmPykshuxTA&oe=6A54E336"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkPDmo15eUkQ7kNvwHjbAut&_nc_oc=AdpkOkknRo29oM4C2V1SxW5pVmYYvdPHEaZnrZRoevhiFW2O8HQH5RT_veLggJG6Xug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCieW30069qABcYO9AmL47_wD_LQwt3vr67CL_y0Lx0FQ&oe=6A54E6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXegBXwLT9EQ7kNvwEQPUmG&_nc_oc=Adq8SZCpYu6Mz3OHIL7BJcD99oWNTx6jRwjsHeHe5nrk8d1ANrNwXS4_BY3lxF6LDKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-RbS4XYIwaUWE1W13AQvww9zXmmyLW0tz2yIiMaDNg&oe=6A54DBDD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
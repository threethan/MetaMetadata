yD0GwVHkbpFT54N_Katg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HorQMej7Xa05dZ4xTI-Xq_x6ngozECRF9uy_1xkV6Uw&oe=6A22CD9B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH-4UjgLr_8Q7kNvwF2xhoV&_nc_oc=Ado7v5JPHxKKKi1pR6jZLt5kwZtACCpJSoPV6S1G6x5ZyqNxK0aGT-zXi4J4MQhA9qM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qj19y6Ppno-mXxGkGBGiajAH3o08MCzY6wt7gGLE4uw&oe=6A22C93B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueS-uLQNToQQ7kNvwH547qk&_nc_oc=AdqxScnhwDDE2-Yw5RtxA3_fsUTKmt4oCRwe16DNWwBJrLJQeKOSSP1piC3oc75UxLc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uCDS5APnpnoBqkNZdY1Hz8DjXn5wwhCBnps0EGtcvrA&oe=6A22CA36"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-hT8y_r6AsQ7kNvwEGr7_q&_nc_oc=Adrr77OCE96P-b3_-Ip5o0-KWrdadz7L4pmvY-M5QHikD91QPba1iSxdWgwgVnMjyus&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8SsoM96m0uCougy5zV1ZG5VpNqrbvr5xRWW6xg6D7Ww&oe=6A22CDA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGQoDGIpk5cQ7kNvwFF7DZ7&_nc_oc=Adply_sxmAOM1yNXGcaKqOPKjmqOal8P296DCjTzQjQOMUCd3c4OUBJMu8wP4ZmsbM8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_brBLA6-SfNeGA3_BWZfknnm7B878hcDs5ViwoN_Lnxw&oe=6A22FB1D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
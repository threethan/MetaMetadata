QQQkFrMj-N97q8oc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DtmQi_8Ox7Cb0O_CLHZhh4LB67ykjS3uk6Z570hcT1w&oe=69D8F99B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPyDCBr5UN4Q7kNvwEyY1A6&_nc_oc=Adqwxa9AlXw6n4vtA7KrRL6BjJ0iLLZ8oyoiXTj4_VuZ7AIeO5UbpNtKzKx9o41wK8Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ysS_nnsbYFxnfja0RfGOuDu7DZzFlWR-ztmvIcQFu5w&oe=69D8F53B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wochNiK4VsIQ7kNvwH4MDYk&_nc_oc=AdrwPSXE6hwXqmwZOM0c5W9JyRpPxNQBgA86KZVEbYRO6bpioyEQnvVlg7y3FxzlbC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KoQfAwy5uYAyB2vbs8S9svB06iF_RJJHoSrseQSau_Q&oe=69D8F636"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocvAgETCxaoQ7kNvwEzdmEQ&_nc_oc=AdoGs9jBJC7opRLyNuCeu-SlpKQUEEmcXO4cbvgRbW7odjhdqBLS8f8jg58liaGw_xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MjmkDxKbqo0K1BPNYOKUmjEjDNdEdQzXf8KyxfKAyHQ&oe=69D8F9A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZdce95FBSsQ7kNvwFwOd4n&_nc_oc=AdouO5Luqs5j36lxt6HOvNDpfZ5mvc9xoruUWdbg4zCvYU9CXWNhv_qCyc0V_jCMxLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af093nOpBT9fipEnux8pMsZB8BdXMBro4g8TVItb16KK5g&oe=69D8EEDD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
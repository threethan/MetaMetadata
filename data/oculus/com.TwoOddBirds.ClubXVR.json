_0OZxps65GrtBRox3Mno&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp1DOt5oFnGKdidB7KDjdRHVHsTEW3dArhET44ZkvnlQ&oe=6AA4009B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6czggcvbIpQQ7kNvwEOjvFG&_nc_oc=AdoZqngGhD-aJAx71xe3XW45A6s8s1QSWvqN1cDI2md7lNyZnNzHKV-uI5mRha4svJs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKobnLhke1S7gyHGoJMm86iE6W_5ksNolrd0j7K3YbqZg&oe=6AA3FC3B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjRRL19XuSoQ7kNvwHPHWu7&_nc_oc=AdoiP1T7L91ZfnhmA5eH5d74Fqd9UZD6PjBARzOy0qXJK2KjgtELL0Oa6SyXlcyOR1M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX89aHT93SFkvDyO-kyrkEqOdxakHVhPLA5J368PQhwg&oe=6AA3FD36"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2xFWOqN0rQQ7kNvwE3DbxJ&_nc_oc=AdpJU2klibU8ozq7DxWatjIp6ERCWydaqEwb4MAkKuyMgposBV0U_YQK_noBehleqhE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ig2xR3usKNsUE6UC90u4kVuLNPynhYt9i1FN5EBy3Q&oe=6AA400A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy9ByYPN8zcQ7kNvwGzwjZx&_nc_oc=Ado_GmV4pqjOZ-x428ppLxkAY9b2Fb3hy4eD28ZfUNau4_s-_cpcplb7X9jW762IcmA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOQttYN7gvRxpY43AM6oDtrpMJ-3CuZjOH20WtRIjFiQ&oe=6AA3F5DD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
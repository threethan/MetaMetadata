291sxTzSvTw&oe=69A0491B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gc6u_O407uAQ7kNvwF76g0Y&_nc_oc=Adn4lHjFnAooOdk5R3Ixb9FG-2ZiLC-4F7kge7vEYYjAGj2JVz0vOX8JPYupgJufRhA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfsZ_sia50t6WfdxeOlLA8X0V_GgSfjvFlbc7lULg6-Q&oe=69A044BB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUqPES3RYhkQ7kNvwHHiB_q&_nc_oc=AdnoReb7ONYKv-FGnqP4Y13U5fNcWBQndGu7o992mm1rH-41IXS2Rq-4buedtFbuZJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft9EpTEy3ImuMToO-eP5oxKBUt6FrH804yFPtsEk9jTAA&oe=69A045B6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufoq8upHZHYQ7kNvwFaAVGV&_nc_oc=AdmTNTdq2ECT-V5AH6wv2vADerP_fbOGf7f1B7x1deVCXd_f6y7scHR-WGbRGLsARGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuiV7yotAT3XjCOKrMmODN5AaC8Yfk0QcEFyHRxfAXqA&oe=69A04925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-uh278wV74Q7kNvwFx_bcv&_nc_oc=AdmWY50Mu08lJO5fMF8LvAvx9MuJtgwjigrEKf4xgpK3JGfSrID8b7KpPLMF1yXq8Lc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5O8q_aFCvXMXQlm8O2D3IoDicewLsfeCQba9ssLF-AA&oe=69A03E5D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "8743158769117912"}, "review_messages": []}]
DgxthLCDirYBCGh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3JC643xhX2a3IbSq03tCo1mTRM_MIK8mio6bzU38ybA&oe=6A4A5A9B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY75h9-InhoQ7kNvwHdKmVP&_nc_oc=AdqI3gZ-E7OqTFned5KK6sOLzMXj6aXlrVG-PYscO2iEhmkfWuVWMMnq00ohYTRuoQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrXSNLklUSKpU7H9_0XkV1E5042tgmeSrjvvBBZ5kU-g&oe=6A4A563B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7zWx370vB4Q7kNvwEFrEFk&_nc_oc=Adpg2tp7mI0yqwPptzjid2UKrfJRw77WJM9az7mmN_D39pCtC7cm6GgCnL8zHNKbJaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkcpo4WaqAhNNjD7Pi3Ab9NXmpQhb9nNasMGtOrSJDKA&oe=6A4A5736"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1tvZ2n43rIQ7kNvwHfc-3E&_nc_oc=AdoMqSZarmmdf-2-sEcwUTcuuLh72IFuc65bOOQm4Deag9qkX8fjDtx4ieJF7ticRT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVqR9mgZIQ1T2gdXPE1AXPleBKWpoyXbj8fYsd-wbbkQ&oe=6A4A5AA5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe2jEaKg-c8Q7kNvwHUU_hP&_nc_oc=AdroXbKwJrs9Myvba3eYzmsY6G3WqML-eNsUcgssIotUZ0-NF-zQdSpa22lz9jdavtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS5slIIDri2Gz1QkYzvU0fHbVrJow4ADGYB3tiUdkpMw&oe=6A4A4FDD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
nHDg0ycAGsKvQ3GY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2H8ouM8vGzdSZcQ8RADTMI0muNoCcrEqPfxgVd0l0-Q&oe=6A58DB1B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-QqcmKRmfEQ7kNvwGrdJTO&_nc_oc=Adq4Gs3-LqHDyLFTUFIQGueyPabtdTossz8R5TLah2zqWZwvJrZGptLzBgDXyV9mQ10&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPMGP0Pq4nt9CEeISzfeDhmLgUpLoDqLti-a9vUhSO7w&oe=6A58D6BB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa8KZe7QCycQ7kNvwE-850e&_nc_oc=Adq8zrV5hhEuvBvYMtnoCg0f4686QMEjRnCeXt3Wpc4VhRKNaRk98dJKZd8Cp_XUSII&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQfBfU6GzU93ksQzSBqu_D1SzHUQnNNLYuYAXQ1IoWvQ&oe=6A58D7B6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQpb6dWt8jYQ7kNvwFgXG1L&_nc_oc=Adov6LR0XI2HX1YPjpxLI_ijJqJOhx5CQlQQ_yBripuQSFM5hUgad6U-TIjPm9PNXVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPEELMMEU5LPpCAAMtr8BPAphRUtoukIPQg38mAh3wSQ&oe=6A58DB25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLb7eOFH_jgQ7kNvwGdBska&_nc_oc=Adr1LXoTMs7AcHs4SYLFNgsYfNpFKbyZu1p9jZ8IpJdZuke-FrSB2aK51z5PWxFXHSw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkXV5J2Z0740PzTBJGuCwUA7YARVyG1h85VrQFdPx0XA&oe=6A58D05D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
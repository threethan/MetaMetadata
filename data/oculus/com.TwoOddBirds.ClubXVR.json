XNJ1Cp4FiplgU5QY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xGdu18R-PgfxMHuXrYNUdIabtKT6vEtxP0TghfOmWAQ&oe=69DF911B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKx6dW3X-wIQ7kNvwG9mP--&_nc_oc=AdrQ269w_zJFZLPGkxJhq_mi7dKf_7c55Oc6oXOHDLYeThNiNTU7ZuJ3hDM_b6uzLXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FN28KD0rFDC9ankgIIDgxtFM4P05UUwL_C8nxca-a0A&oe=69DF8CBB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO1qK6I6KPkQ7kNvwG_tB_h&_nc_oc=AdoL7226pzdkvIgffORMXoGtYZWpG_owZvosJ7CPRmpEWJ750BPL08MhBsRucsOpJlM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BpYFD78da62tWUTZjG_9ToVGegsvG-j0vHSa5nDydPg&oe=69DF8DB6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QBlNIH-2DsQ7kNvwHvadp_&_nc_oc=AdqJaGJR0xX7YsFBBElvgClGSAjZC3Jxr4bX7tTJW32TnenaBaroA59Mr2hQKBPPNgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TeW9oMZLJVM5YeagsZi-EhRuQY54LJML1WOAo7MIVIQ&oe=69DF9125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geBadHzJ3WUQ7kNvwHUpxi1&_nc_oc=Adpc8ZMPb-mYBwHkyxB0_Ij1cfnL0eYfDPDhG8gevQjlV8wknWIu1rCzcB9pN5Ga-cc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DzMEBPU9dPPOKgBxfebgsjssUAJnt5q3V7NNrUUQ4ug&oe=69DF865D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
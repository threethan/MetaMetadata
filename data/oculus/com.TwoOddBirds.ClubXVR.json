SiFV1DglP4LA_KfA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOte5h2iNUZTRG-d58ZHcnzKI6NUGFs2PrN-1TWvEA_dg&oe=6ADE029B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmiq6P_BFKMQ7kNvwHJE4vE&_nc_oc=AdrtQBrgUe5I7MnWtr0DoTDxwnZ8PXz8PkeEf3i3vtzIgf5WQrGg7ArTSZSuslfoBdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKDTqA_JQEInZ7LRcKSqRUXqWWYIwkzOBH0AgfuJQ4rA&oe=6ADDFE3B"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TU-m_u7QM4Q7kNvwFBTWxT&_nc_oc=Adrs-RyXRNCB3GUjOHiOJ7QiDKl1IL1XlmEguCedXP3Rigmc6OUYkcxVEZEEmsOLgsY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIE3Ij0mCiwH0rdSEma5jTJCw1gIkutuJndBmDC0Mzkw&oe=6ADDFF36"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hk1yj_TSP7QQ7kNvwGTVKvm&_nc_oc=AdpiZ0OzszQ2CKWhZf1xCmb-AbLAxeLiPYRUt5m34TdY4w6FSpwpfmq6b35HinzdRiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4U2AozaYmofd0ig88wXUemAtmXFmZsa2irpTZnMFQVw&oe=6ADE02A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRBJmMh_4EgQ7kNvwGsXWtu&_nc_oc=AdodFSw5HJ_55VpuPwrxD1zIq9crMNBwjoFqd5iPlY1mc0ga-WSfRyuWS-6t3Cw-l-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoMfiiGb_Hj3lI_DQYyJpwZzJL30ddgOC6DX4L9Daw4w&oe=6ADDF7DD"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
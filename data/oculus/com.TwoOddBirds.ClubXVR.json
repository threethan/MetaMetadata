=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuK73kIzcd8v-z8dw9yTKw6of9_eKYRxBD37d05zweULg&oe=69A8321B"}, {"file_name": "25606.png", "id": "579159074715876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974521_579159078049209_2857835417779097114_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jN8Me7zPT8Q7kNvwHGRJLa&_nc_oc=AdlvgYzVGpMLpygxXTEh4dQ3b9yH8AITm-N6Ew9EJdUMg_9fNABdo2HAz0N3CdJqMoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftPnhxgqsiowMSuJiNO1Zy-FIzVh86Mf-uNhmms-vTg3A&oe=69A82DBB"}, {"file_name": "25601.png", "id": "1341444773511902", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974915_1341444776845235_7182824535808503699_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KANumtDXhk8Q7kNvwE6BMP3&_nc_oc=AdnzB8YLlA898mB2whEZDYEpAP1X8nxvg3mOI4ML1OUsUetjG2UUufnul9RAp8BIvRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftvVCQX12ZgmWqyhJV6nk8eM3LBfWJJ-DoFb-6UD67uqw&oe=69A82EB6"}, {"file_name": "2560.png", "id": "1632805540985931", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375771_1632805544319264_3920356593054675382_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tufxbh6EMjsQ7kNvwEEFu5u&_nc_oc=Adk2FK271jk0EGD2pgOuifBv8Euu7vTpVog3rr7J2Nvs3W5IP9SAUHxmlYBmF1BpGsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftrx5d6hG8kBRCYjH9v_eR4yPEafDgFU9OI4qLv05alcQ&oe=69A83225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "XVR updated image.png", "id": "1291088222405300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391906_1291088225738633_6219213340296431520_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZxuqYO670Q7kNvwFIB3Hu&_nc_oc=Adm-2no_tBOAJ3nATl1p4ylKqzasBb7lnpeVHMDxx_q9aLDZbYjpLbVNHgLbplLmS1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvY61rHY_bSbnrorw5KkxKSUfr6bSWyORhPpDRl8DxgQg&oe=69A8275D"}, "display_name": "ClubXVR", "keywords": [], "long_description": "Imagine a virtual reality space designed purely for connection and relaxation. \nWelcome to Club XVR, a unique social lounge built especially for VR, where socializing feels natural and effortless and most of all FUN. \nClub XVR is more than just an app; it's a place to unwind, meet new people, and share experiences in a comfortable, immersive setting.\n\nWith Cool clubs, Private hangouts and even personal apartments, you can\nconnect with people all across the world from all walks of life who share your interest in VR. Share your thoughts and ideas, build genuine connections, even share your favorite YouTube videos.\n\n    Be part of a growing community thats brand new to VR.\n ClubXVR is made to be a dynamic space that evolves with its users. As the community grows, you'll discover new connections and opportunities for shared experiences.", "short_description": "Explore a one-of-a-kind VR social lounge where members can connect in a relaxed, immersive environment. Designed to be a dynamic space, the app offers public areas where users can socialize and enjoy personalized content, like a private YouTube player and interactive social settings."}]}, "developer_name": "2 Odd Birds", "developer_privacy_policy_url": "https://clubxvr.wixsite.com/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "2 Odd Birds", "support_website_url": null, "website_url": "https://clubxvr.wixsite.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_mo
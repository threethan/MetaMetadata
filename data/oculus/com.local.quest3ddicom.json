9kHDUHDKgrkEUNr6-jIvNu3uyOZCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs9VQtKnFD6uu8Ypi4UqLCfwllS9OEX0KhNb04-PrSWw&oe=6B0473E6"}, {"file_name": "05-transparency.png", "id": "1798041008136169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312263_1798041011469502_8541819685703371264_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppQ29m9dIOoQ7kNvwFFiSn9&_nc_oc=Ado11n4jObBqobhpjzaRNeAjcgzHmqsFBn6xVyfjKMTUyuBIkukZi8r46CXxQh6-sPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZHA1rLl05R4jTCDUUN2x7Pk9KRO2iGQbY-Kn9mk7E1g&oe=6B048A40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "756589809_2111729529449349_6073227194733712856_n.png", "id": "1001377325687430", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646413489_1001377329020763_951399679347651591_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm14gY_uCB4Q7kNvwFvdiO_&_nc_oc=AdoYLxM7I7dDhjIBQPL8TtFRxGC_BbGjDeqDC-qoeU3wFPvxfpcOa3PpzHyaxZ1pKnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVovzttj4YvLl6ny0G4GI26W8EjrxHiZmAmxQ1FzKXfg&oe=6B046588"}, "display_name": "Quest 3D Dicom", "keywords": ["DICOM", "Education", "Research", "3D", "XR"], "long_description": "Explore compatible local DICOM series and OBJ/FBX models in mixed reality on Meta Quest 3 and Quest 3S. For educational and scientific visualization only.\n\nView DICOM-derived 3D surfaces and source-grid slices. Adjust position, rotation, scale, transparency, surface appearance, slice brightness and contrast with spatial controls. Arrange imported models using virtual placement and local transforms.\n\nOptional camera and spatial-data workflows support marker recognition, native QR and scanned-room placement. Marker estimates depend on lighting, print dimensions, motion and headset tracking. Virtual placement and local-model viewing remain available when camera or scene access is declined.\n\nChoose a compatible file or series folder through the system picker. DICOM import is limited to supported uncompressed grayscale data; multi-slice series require consistent spatial metadata. Unsupported encodings require conversion outside the app. Imports are copied locally. Use only files you are authorized to access and process.\n\nRendering and tracking are visualization tools. Displayed surfaces and alignment may contain artifacts or drift. Use synthetic or de-identified datasets for demonstrations and learning.", "short_description": "Explore compatible local DICOM series and OBJ/FBX models in mixed reality on Meta Quest 3 and Quest 3S. View 3D surfaces and slices, adjust their appearance, and arrange content in your space for educational and scientific visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quest3ddicom-meta-policies.papadig.chatgpt.site/privacy/", "developer_terms_of_service_url": "https://quest3ddicom-meta-policies.papadig.chatgpt.site/terms/", "publisher_name": "ORTHOPRACTISCOM SINGLE MEMBER PC", "support_website_url": "https://quest3ddicom-meta-policies.papadig.chatgpt.site/", "website_url": "https://quest3ddicom-meta-policies.papadig.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1637234212796041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"
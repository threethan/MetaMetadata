scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619685_1234697133062963_4163631971855647360_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOaIm4Y4a_wQ7kNvwG_vjmp&_nc_oc=AdptaZ1VYhQXPGje-Y9rEvyJt4DNwlKxlFTbnSZicTp2YeWVktnjODswrFzOqGThX2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp0usxdJivOgL4n1gr-Yf6ZGLjDKCPqjGj4zrWy_-Imw&oe=6AC255A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverH2560.png", "id": "1640667154157052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620965_1640667157490385_741013297192489725_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JazuefZMq7QQ7kNvwHM9JNc&_nc_oc=AdoFECfsiUsC_QbAhgQbV_FXGcE47elSFq-n939qkcC9S-5woipS3tB4VmpWiBuWauM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZjQ6DaSVyIQSNyZ6JTLuXvipP0GT6tL2IH1guNkewzw&oe=6AC26998"}, "display_name": "ThrowVR", "keywords": ["throw", "ball", "zombie"], "long_description": "This is a VR game focused entirely on the act of throwing.  \nInstead of shooting or slashing, you fight zombies by throwing.\n\n# Throwing styles\nYou will be fighting alone in a world overrun by zombies.  \nSince your weapon\u2019s damage changes based on how hard you throw, learning how to throw is essential if you want to stay alive.  \nHere are some basic throwing styles. Try them out and find the way of fighting that works best for you.  \n\n- Powerful throws: Wind up and throw with all your strength to focus on high single-hit damage.\n\n- Rapid throws: Keep throwing quickly to overwhelm enemies with sheer number of attacks.\n\n- Aimed throws: Carefully aim at distant enemies or weak points to deal damage efficiently.\n\n{4541412582763140}\n# Weapons\nWith your bullets long gone, the only way to fight is to pick things up and throw them at zombies.  \nHere are some of the weapons you can use.\n\n### Baseball\nYour basic weapon that can be thrown infinitely.  \nYou can keep attacking by throwing it one after another, and even bounce it off walls for indirect hits.\n\n### Kitchen timer\nA luring item that rings when thrown and draws enemies toward the sound.\n\n### Javelin\nA high-powered trump card that can break shields. You don\u2019t have many, but they shine in critical moments.\n\n### Grenade\nA weapon for breaking up clusters of enemies at once.  \nIf you throw it into a tightly packed group, you can change the situation in an instant\u2014but you\u2019ll need to control the strength of your throw so it lands right in the middle instead of flying past them.", "short_description": "This is a VR game focused entirely on the act of throwing.\nInstead of shooting or slashing, you fight the zombies overrunning the town by throwing.\n\nThe harder you throw, the more damage you deal, so your fighting style depends on whether you prioritize heavy single hits, number of attacks, or accuracy. \n\nYour main weapons include a baseball that can be thrown infinitely , a kitchen timer that lures enemies with sound, and a high\u2011powered javelin that can break shields but is limited in number."}, {"images": {"nodes": [{"file_name": "weapons.png", "id": "2841875526179408", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/585799753_2841875529512741_8449823300738018585_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KlSXL0i_CIQ7kNvwE_W6ew&_nc_oc=AdpfQLO0uKB7U0rFouftE9yAAa3PcLaANkcjP3ivQvuAyjcp6SzF7IDavF82bmHJAow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe264nxcWGWVrS4RKiSij0fts-VCHVSWWbN2Ayihz60g&oe=6AC2815E"}, {"file_name": "weapons.png", "id": "1953008848744714", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1953008852078047_5900565083711318349_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m_TrMlFX_cQ7kNvwFtb9Ok&_nc_oc=AdrOhPpS71I5eTTWb-rCR00jioZUAziWzXqDsPzg9TK_4w5q0SGdh-s0jv8_f8CskAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcl0mJ51unsRqK0cg1MQVKl1AAlkEEG1WX1WGIaHFftA&oe=6AC26E64"}, {"file_name": "enemys.png", "id": "1532395874815207", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619805_1532395878148540_3333816168779973858_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23Y0mtpUliIQ7kNvwGkb-5D&_nc_oc=AdrmpqFO7P8BMJdedjp6WuCvGZ8aovA7B5ZlmnX3auipoSkOqggcLoO62IQ906jegMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvKV726KU_55b7rkWPrH0k1jk69NOqbTV-NtL1l4KYWg&oe=6AC26634"}]}, "id": "1060288909698574", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u6295\u3052\u308bVR", "keywords": ["throw", "zombie", "ball"], "long_description": "\"\u6295\u3052\u308b\"\u3068\u3044\u3046\u52d5\u304d\u306b\u7279\u5316\u3057\u305fVR\u30b2\u30fc\u30e0\u3067\u3059\u3002  \n\u6483\u3064\u3001\u65ac\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u6295\u3052\u308b\u3053\u3068\u3067\u30be\u30f3\u30d3\u3068\u6226\u3044\u307e\u3059\u3002\n  \n\n# \u6295\u3052\u65b9\n\u3042\u306a\u305f\u306f\u3001\u30be\u30f3\u30d3\u306e\u306f\u3073\u3053\u308b\u4e16\u754c\u3067\u5b64\u72ec\u306b\u6226\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002\n\u6b66\u5668\u306f**\u6295\u3052\u308b\u5f37\u3055\u3067\u5a01\u529b\u304c\u5909\u308f\u308b**\u306e\u3067\u3001\u9577\u751f\u304d\u3057\u305f\u3044\u306a\u3089\u6295\u3052\u65b9\u3092\u899a\u3048\u308b\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002  \n\u305d\u3053\u3067\u3001\u304a\u3059\u3059\u3081\u306e\u6295\u3052\u65b9\u3092\u7d39\u4ecb\u3057\u3066\u307f\u307e\u3059\u3002\u6226\u3044\u3084\u3059\u3044\u3084\u308a\u65b9\u3092\u6a21\u7d22\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002\n\n- \u5f37\u304f\u6295\u3052\u308b : \u601d\u3044\u304d\u308a\u632f\u308a\u304b\u3076\u3063\u3066\u3001\u4e00\u6483\u306e\u5a01\u529b\u3092\u91cd\u8996\u3059\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n- \u9023\u7d9a\u3067\u6295\u3052\u308b : \u7d20\u65e9\u304f\u6295\u3052\u7d9a\u3051\u3066\u3001\u624b\u6570\u3067\u62bc\u3057\u5207\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n- \u72d9\u3063\u3066\u6295\u3052\u308b : \u9060\u304f\u306e\u6575\u3084\u5f31\u70b9\u3092\u6b63\u78ba\u306b\u72d9\u3044\u3001\u52b9\u7387\u3088\u304f\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n\n{1953008848744714}\n# \u6b66\u5668\n\u9283\u5f3e\u3092\u6483\u3061\u5c3d\u304f\u3057\u305f\u3042\u306a\u305f\u306f\u3001\u7269\u3092\u6295\u3052\u3066\u30be\u30f3\u30d3\u3068\u6226\u3063\u3066\u3044\u304b\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002  \n\u305d\u3053\u3067\u3001\u3069\u3093\u306a\u6b66\u5668\u304c\u4f7f\u3048\u308b\u304b\u3001\u7d39\u4ecb\u3057\u307e\u3059\u3002\n\n### \u91ce\u7403\u30dc\u30fc\u30eb\n\u7121\u9650\u306b\u6295\u3052\u3089\u308c\u308b\u57fa\u672c\u6b66\u5668\u3067\u3059\u3002  \n\u9023\u7d9a\u3067\u6295\u3052\u3066\u653b\u3081\u7d9a\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u58c1\u306b\u30d0\u30a6\u30f3\u30c9\u3055\u305b\u305f\u653b\u6483\u3082\u3067\u304d\u307e\u3059\u3002\n\n### \u30ad\u30c3\u30c1\u30f3\u30bf\u30a4\u30de\u30fc\n\u6295\u3052\u308b\u3068\u97f3\u304c\u9cf4\u308a\u3001\u6575\u3092\u304a\u3073\u304d\u5bc4\u305b\u3089\u308c\u308b\u8a98\u5c0e\u7528\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\n\n### \u30b8\u30e3\u30d9\u30ea\u30f3\n\u9ad8\u5a01\u529b\u3067\u76fe\u3082\u58ca\u305b\u308b\u5207\u308a\u672d\u3067\u3059\u3002\u6570\u306f\u5c11\u306a\u3044\u3067\u3059\u304c\u3001\u3053\u3053\u305e\u3068\u3044\u3046\u5834\u9762\u3067\u6d3b\u8e8d\u3057\u307e\u3059\u3002\n\n### \u30b0\u30ec\u30cd\u30fc\u30c9\n\u6575\u306e\u96c6\u56e3\u3092\u4e00\u6c17\u306b\u5d29\u3059\u305f\u3081\u306e\u6b66\u5668\u3067\u3059\u3002  \n\u5bc6\u96c6\u3057\u3066\u3044\u308b\u6575\u306b\u4f7f\u3048\u3070\u72b6\u6cc1\u3092\u4e00\u6c17\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u304c\u3001\u3046\u307e\u304f\u6575\u306e\u96c6\u56e3\u306e\u771f\u3093\u4e2d\u306b\u6295\u3052\u8fbc\u3080\u305f\u3081\u306b\u306f\u3001\u5f37\u304f\u6295\u3052\u3059\u304e\u306a\u3044\u3088\u3046\u306b\u3057\u306a\u3044\u3068\u3044\u3051\u307e\u305b\u3093\u3002\n\n### \u30ed\u30b8\u30f3\u30b0\u30ec\u30cd\u30fc\u30c9\n\u30ed\u30b8\u30f3\u3092\u30d4\u30f3\u30dd\u30f3\u7389\u306b\u8a70\u3081\u305f\u56de\u5fa9\u30a2\u30a4\u30c6\u30e0\u3067\u3001\u5730\u9762\u306b\u6295\u3052\u3064\u3051\u3066\u4f7f\u3044\u307e\u3059\u3002  \n\u3088\u308a\u5f37\u304f\u5730\u9762\u306b\u6295\u3052\u3064\u3051\u308b\u3053\u3068\u3067\u3088\u308a\u591a\u304f\u4f53\u529b\u304c\u56de\u5fa9\u3059\u308b\u306e\u3067\u3001\u601d\u3044\u3063\u304d\u308a\u6295\u3052\u3064\u3051\u307e\u3057\u3087\u3046\u3002\n\n{1532395874815207}\n# \u30be\u30f3\u30d3\n\u51fa\u4f1a\u3063\u305f\u30be\u30f3\u30d3\u304c\u3069\u306e\u3088\u3046\u306a\u7279\u5fb4\u3092\u6301\u3063\u3066\u3044\u308b\u306e\u304b\u3092\u77e5\u3063\u3066\u3044\u308c\u3070\u3001\u751f\u304d\u5ef6\u3073\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u304f\u306a\u308a\u307e\u3059\u3002  \n\u3053\u3053\u3067\u306f\u3001\u3053\u306e\u4e16\u754c\u3067\u6226\u3046\u3053\u3068\u306b\u306a\u308b\u6575\u306e\u4e00\u90e8\u3092\u7d39\u4ecb\u3057\u307e\u3059\u3002\n\n### \u6b69\u304d\u30be\u30f3\u30d3\n\u6700\u3082\u57fa\u672c\u7684\u306a\u30be\u30f3\u30d3\u3067\u3059\u3002\n\u3086\u3063\u304f\u308a\u3068\u63a5\u8fd1\u3057\u3066\u304d\u3066\u3001\u3086\u3063\u304f\u308a\u3068\u653b\u6483\u3057\u3066\u304d\u307e\u3059\u3002\u843d\u3061\u7740\u3044\u3066\u5bfe\u51e6\u3059\u308c\u3070\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u4ed6\u306e\u6575\u3068\u4e00\u7dd2\u306b\u51fa\u3066\u304f\u308b\u3068\u3001\u5730\u5473\u306a\u304c\u3089\u3082\u5384\u4ecb\u306a\u5b58\u5728\u306b\u306a\u308a\u307e\u3059\u3002\n\n### \u76fe\u30be\u30f3\u30d3\n\u76fe\u3092\u6301\u3063\u3066\u3044\u308b\u30be\u30f3\u30d3\u3067\u3059\u3002  \n\u6b63\u9762\u304b\u3089\u306e\u653b\u6483\u304c\u7121\u52b9\u5316\u3055\u308c\u308b\u305f\u3081\u3001\u6426\u3081\u624b\u3092\u8003\u3048\u307e\u3057\u3087\u3046\u3002\n\n### \u30c0\u30c3\u30b7\u30e5\u30be\u30f3\u30d3\n\u8d70\u3063\u3066\u304f\u308b\u30be\u30f3\u30d3\u3067\u3059\u3002  \n\u6025\u306b\u63a5\u8fd1\u3055\u308c\u308b\u305f\u3081\u5371\u967a\u3067\u3059\u304c\u3001\u52d5\u304d\u306f\u76f4\u7dda\u7684\u306a\u306e\u3067\u3001\u6a2a\u306b\u907f\u3051\u3066\u56de\u907f\u3057\u307e\u3057\u3087\u3046\u3002\n\u3082\u3057\u8155\u306b\u899a\u3048\u304c\u3042\u308c\u3070\u3001\u8d70\u3063\u3066\u304f\u308b\u3068\u304d\u306b\u5f53\u3066\u3066\u306e\u3051\u305e\u3089\u305b\u308b\u306e\u3082\u6709\u52b9\u3067\u3059\u3002\n\n### \u30ec\u30ae\u30aa\u30f3\u30be\u30f3\u30d3\n\u53e4\u4ee3\u30ed\u30fc\u30de\u306e\u5175\u58eb\u306e\u3088\u3046\u306b\u5927\u696f\u3092\u6301\u3061\u3001\u69cd\u3092\u6295\u3052\u3066\u304d\u307e\u3059\u3002  \n\u975e\u5e38\u306b\u5f37\u529b\u306a\u6575\u3067\u3059\u304c\u3001\u6295\u3052\u3066\u304f\u308b\u69cd\u306f\u3001\u30ad\u30e3\u30c3\u30c1\u3057\u6295\u3052\u8fd4\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u69cd\u306f\u6575\u306e\u76fe\u3092\u7834\u58ca\u3067\u304d\u308b\u305f\u3081\u3001\u6575\u306e\u5f37\u3055\u3053\u305d\u304c\u4ed8\u3051\u5165\u308b\u9699\u306b\u306a\u308a\u307e\u3059\u3002", "short_description": "\"\u6295\u3052\u308b\"\u3068\u3044\u3046\u52d5\u304d\u306b\u7279\u5316\u3057\u305fVR\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u6483\u3064\u3001\u65ac\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u6295\u3052\u308b\u3053\u3068\u3067\u3001\u753a\u306b\u306f\u3073\u3053\u308b\u30be\u30f3\u30d3\u3068\u6226\u3044\u307e\u3059\u3002\n\n\u6295\u3052\u65b9\n\u6295\u3052\u308b\u5f37\u3055\u3067\u5a01\u529b\u304c\u5909\u308f\u308b\u305f\u3081\u3001\u4e00\u6483\u306e\u91cd\u3055\u3001\u624b\u6570\u3001\u6b63\u78ba\u3055\u306e\u3069\u308c\u3092\u91cd\u8996\u3059\u308b\u304b\u3067\u6226\u3044\u65b9\u304c\u5909\u308f\u308a\u307e\u3059\u3002\n\u30fb\u5f37\u304f\u6295\u3052\u308b : \u601d\u3044\u304d\u308a\u632f\u308a\u304b\u3076\u3063\u3066\u3001\u4e00\u6483\u306e\u5a01\u529b\u3092\u91cd\u8996\u3059\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n\u30fb\u9023\u7d9a\u3067\u6295\u3052\u308b : \u7d20\u65e9\u304f\u6295\u3052\u7d9a\u3051\u3066\u3001\u624b\u6570\u3067\u62bc\u3057\u5207\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n\u30fb\u72d9\u3063\u3066\u6295\u3052\u308b : \u9060\u304f\u306e\u6575\u3084\u5f31\u70b9\u3092\u6b63\u78ba\u306b\u72d9\u3044\u3001\u52b9\u7387\u3088\u304f\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u308b\u6295\u3052\u65b9\u3067\u3059\u3002\n\n\u6b66\u5668\n\u30fb\u91ce\u7403\u30dc\u30fc\u30eb : \u7121\u9650\u306b\u6295\u3052\u3089\u308c\u308b\u57fa\u672c\u6b66\u5668\u3067\u3059\u3002\u9023\u7d9a\u653b\u6483\u306b\u5411\u304f\u307b\u304b\u3001\u58c1\u306b\u30d0\u30a6\u30f3\u30c9\u3055\u305b\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\n\u30fb\u30ad\u30c3\u30c1\u30f3\u30bf\u30a4\u30de\u30fc : \u97f3\u3067\u6575\u3092\u304a\u3073\u304d\u5bc4\u305b\u308b\u8a98\u5c0e\u7528\u30a2\u30a4\u30c6\u30e0\u3067\u3059\u3002\n\u30fb\u30b8\u30e3\u30d9\u30ea\u30f3 : \u9ad8\u5a01\u529b\u3067\u76fe\u3082\u58ca\u305b\u308b\u5207\u308a\u672d\u3002\u5c11\u6570\u7cbe\u92ed\u306e\u5f37\u529b\u306a\u6b66\u5668\u3067\u3059\u3002\n\n\u81ea\u5206\u306b\u5408\u3063\u305f\u6295\u3052\u65b9\u3068\u6b66\u5668\u3092\u7d44\u307f\u5408\u308f\u305b\u3066\u6226\u3046\u3001\u5c11\u3057\u5909\u308f\u3063\u305fVR\u30a2\u30af\u30b7\u30e7\u30f3\u3067\u3059\u3002"}]}, "developer_name": "SuzuranTechStudio", "developer_privacy_policy_url": "https://suzurantechstudio.com/throwvr/privacypolicyv2", "developer_terms_of_service_url": null, "publisher_name": "SuzuranTechStudio", "support_website_url": null, "website_url": "https://suzurantechstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED
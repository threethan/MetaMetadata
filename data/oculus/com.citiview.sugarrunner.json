t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYj5F1bnCbWZnTT8HzAIcE0hsBiqmFJLxdBURmr4pkQw&oe=6AF1D565"}, {"file_name": "screenshot_5_2560x1440.png", "id": "907582652184820", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_907582655518153_71447541547863848_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmBLDdoRrMIQ7kNvwGva_i7&_nc_oc=AdoCKOgbnnlM_gXYpV-dVPL9XKsfGB5eddx6cTWy48ZkHNWvOXONNPIpGgrNiwdTz9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8WfTiBJt_Ms8a3V-bdrFpXgXl-uhP2O-LJfixVLqOCg&oe=6AF1DD4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2171702123410354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_2171702126743687_5562189900712467340_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot5OWOjISSQQ7kNvwFmgSC1&_nc_oc=AdqvTGAztZ3oONFq_LcqPVB6LQKQML7vwdyZRjbbiox5EhSy6S7WRvaYlEROomVayBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToFz1x8LvS1T9vjAu_XNTlpbd4kTJ27gA_NVJIplKuMg&oe=6AF20486"}, "display_name": "Sugar Runner", "keywords": ["platformer", "food", "candy", "jumping", "jump"], "long_description": "SUGAR RUNNER is a first-person platformer built for comfortable VR.\n\nYou are the size of a crumb, standing on a pancake at one end of an enormous laid table. The feast stretches away in front of you, floating high above a checked tablecloth, and the only way across is to run and jump.\n\nTEN LEVELS, FIVE FEASTS\nBreakfast, a sushi counter, a candy shop, the grill and a birthday party. Every two levels brings a new spread of food, a new tablecloth far below and a new sky.\n\nA JUMP THAT FEELS GOOD IN VR\nOne long, soft arc every time, with no snap and no stomach drop. Walk with the left stick, snap turn with the right, jump with A. Nothing can hurt you: miss a landing and you simply hop back to the last checkpoint.\n\nA KITCHEN FULL OF TRICKS\nFrying pans and flying plates carry you across the long gaps. A coffee mug's steam lifts you up to a cheese wheel. Rolling pins sweep across the chopping boards, biscuits crack under your feet, and mushrooms waddle along the path.\n\nCHERRIES AND GOLDEN DONUTS\nCollect cherries, head-butt the milk cartons for more, and hunt down the golden donut in every level.\n\nLONGER AND HARDER AS YOU GO\nLevel one is a gentle run across breakfast. By level ten you are running over half a kilometre, faster, over narrower platforms and longer gaps.\n\nTHE FINISH\nEvery level ends on a birthday cake. Hop up onto it, stand among the candles and the level is yours. The final level ends on a three-tier cake you have to climb.", "short_description": "You are the size of a crumb on a giant laid table. Run and jump across pancakes, sushi, candy and pizza, collect the cherries, dodge the rolling pins, and climb the birthday cake at the end of every level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-sugarrunner.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-sugarrunner.pages.dev/", "website_url": "https://citiview-sugarrunner.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328405660352297"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t6
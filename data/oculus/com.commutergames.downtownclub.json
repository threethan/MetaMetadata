v/t64.5771-25/86621364_1106014090619258_8005591221310053306_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLSZS4XlTLsQ7kNvwExqFyb&_nc_oc=Adpmr31KX-SuAQpbQpyaCFSfl7dqKvDxexxHsgDQKW_qCvT1zCD9MJhF7ihEMVBB6eA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iXDnzsInoPhyQ343XIEYdSq2sZSQ-V6TeVfWy13iOWg&oe=6A26D581"}, {"file_name": "Screen-05.png", "id": "390469220458002", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39036615_390469223791335_8156658728034584081_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JaHTu1WASgQ7kNvwEI2F5s&_nc_oc=AdqgBiRGggiJKY-iCIp5VFJqo3fevlJiR4deiF5HpT1-c4V-fBqK5m_iu81e-944BDE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oBp1Nq9FX1Qv3M6i6WyoNc_4T4vflNVnTee06jkZUnA&oe=6A26C259"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Downtown Club", "keywords": [], "long_description": "\ud83d\udd30 NOW IN EARLY ACCESS \ud83d\udd30\n\nDowntown Club is a racing game with full physical controls and exciting driving feedback, built from the ground up for standalone VR. Grab wheel, shifter and handbrake, take full control of your car and become a motorsport champion!\n\nGet behind the wheel of nimble city cars and race against a full grid of fierce opponents, or race against the clock and put your record on top of the worldwide leaderabords. And when it's time to cool down, drive freely around the map at your own pace.\n\nDowntown Club will launch in early access: new cars, new maps, online multiplayer and other features will soon be added with free updates!", "short_description": "Grab wheel, shifter and handbrake, take full control of your car and become a motorsport champion in this racing game built from the ground up for standalone VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://commuter.games/privacy", "developer_terms_of_service_url": "https://commuter.games/terms", "publisher_name": "Commuter Games", "support_website_url": "https://commuter.games/#contact", "website_url": "https://commuter.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "3215393952039753"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1000114375849106"}, {"status": "PUBLISHED", "id": "1259025823049876"}, {"status": "PUBLISHED", "id": "1214271300849083"}, {"status": "PUBLISHED", "id": "527515823790010"}, {"status": "PUBLISHED", "id": "1034139118681277"}, {"status": "PUBLISHED", "id": "1908681992988278"}, {"status": "PUBLISHED", "id": "1380299162853830"}]}, "baseline_offer": {"id": "1380299162853830"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781197200, "status": "PUBLISHED", "id": "1000114375849106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25765451419783380", "version": "1.3.3"}, "id": "1669020356820924", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4051061284982373", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25765451419783380"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1669020356820924"}]}, "change_log": "- Added rain condition\n- Added slipstream dynamics\n- Added multiplayer voice chat\n- Added visible player body\n- Added mirror in Profile menu\n- Added two new racetrack layouts\n- Added ghost settings in Time Attack mode\n- Added Quick Settings in Pause menu\n- Added Player Hub menu pages\n- Added Community view with Multiplayer Bulletin\n- Added player type icon in multiplayer games\n- Added a new Event group\n- Added option to delete Events results only\n- Added six new music tracks\n- Improved opponents AI with all new logic\n- Improved multiplayer prediction and interpolation\n- Improved Ghosting System reactivity\n- Updated the structure of most Events\n- Updated certain parts of the game UI\n- Updated experience gain and leveling formula\n- Fixed several netcode bugs and reliability problems\n- Fixed certain profile stats not updating in Free Ride\n- Fixed physics mismatch between Free Ride and other modes\n- Fixed low grip on certain parts of the map\n- Fixed wrong count of items in the player collection\n- Lots of other minor fixes and updates", "created_date": 1780347238, "id": "27036927665969076", "version": "1.4.0", "version_code": 3286, "release_status": "SCHEDULED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4051061284982373", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25765451419783380"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779918571, "id": "26967750056220171", "version": "1.4.0", "version_code": 3262, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debu
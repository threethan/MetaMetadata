tps://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036615_390469223791335_8156658728034584081_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH-x_CqGpOoQ7kNvwGBgovX&_nc_oc=Adrx36-Rv9hkaSvTCe-FByjAbq8EUxYbzbiVSWB7p4PiardddrFOUhRtCvHypwhxP_w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af672plHMNTIvzFgHkZXFjrXV7nGoKn12UED91BYk8zEJg&oe=6A1C3659"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Downtown Club", "keywords": [], "long_description": "\ud83d\udd30 NOW IN EARLY ACCESS \ud83d\udd30\n\nDowntown Club is a racing game with full physical controls and exciting driving feedback, built from the ground up for standalone VR. Grab wheel, shifter and handbrake, take full control of your car and become a motorsport champion!\n\nGet behind the wheel of nimble city cars and race against a full grid of fierce opponents, or race against the clock and put your record on top of the worldwide leaderabords. And when it's time to cool down, drive freely around the map at your own pace.\n\nDowntown Club will launch in early access: new cars, new maps, online multiplayer and other features will soon be added with free updates!", "short_description": "Grab wheel, shifter and handbrake, take full control of your car and become a motorsport champion in this racing game built from the ground up for standalone VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://commuter.games/privacy", "developer_terms_of_service_url": "https://commuter.games/terms", "publisher_name": "Commuter Games", "support_website_url": "https://commuter.games/#contact", "website_url": "https://commuter.games/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIR
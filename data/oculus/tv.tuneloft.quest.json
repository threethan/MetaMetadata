": "1378542661090174", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_1378542664423507_217808886782454993_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2JQUuJqYbgQ7kNvwFJV_K7&_nc_oc=AdoWlP3HicJd9rpdyGZ_0eYYW8U4GLK4r7RTxe63ntr204D2FDli3TwQljWSmiiXxSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGFtn-U1jQWiXxveRgFK80pOy5U7WbCB-FPqNdJdvPNA&oe=6ACF841A"}, {"file_name": "02-demo-playlist.png", "id": "1564649765246481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507838217_1564649768579814_3036141502421228395_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrIVsFm0pNAQ7kNvwHTNErL&_nc_oc=Adp0sfkimaHFbcLtOP7Jt1vkcitqKP1iO7y77vC1oLXA438h-NIFKZ6E2NpIJj8lDjc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXhqcEljNxOOXVH_x1yo6L3ehqXncizsX6mJlxllczCQ&oe=6ACF85E1"}, {"file_name": "07-home.png", "id": "3975094572621396", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_3975094579288062_4537233318019727192_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyBKfDLW-KwQ7kNvwEV_3wM&_nc_oc=Adral-j1VSaBFwlhS7yuxcMNKyo3UhLzQn01G_NmbsuP1sDIrJ99QlluTuEETcpvHrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbidwXRduXedcNgHsaMySppI6qNsWRjFK91u6w1AoSqg&oe=6ACF966B"}, {"file_name": "01-hero.png", "id": "1292927849425215", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618448_1292927852758548_8370216678369223304_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bsjMsmLRcYQ7kNvwEoKufc&_nc_oc=AdofNuxPzrUYfdhqjYiV1ld5_DN7uKjWemBAPvk2t1a-96whxPGy7-OdHyc2TQZ21Ss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsWZdDWP5-wiXnVXwWQttxivYX3VonLtTtKZgP9pIpYw&oe=6ACF9B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1968806683797426", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499314659_1968806687130759_4465689369412364899_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnYZz7V4ZWgQ7kNvwGTJzYD&_nc_oc=AdojOnM3G-iqxq9vgKur1Y2RfDh6PrRKiBr8gPNCQNcJ3ZLftdwDr7tJH5OrJNBvnkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3Hk91VpIm_G5_pwEuLsQKpKrGWr6T4Uvv6JbMRUhYcw&oe=6ACFACA6"}, "display_name": "TuneLoft", "keywords": ["streaming", "multiscreen", "passthrough", "player", "video"], "long_description": "TuneLoft turns your headset into a universal media hub. One player for everything you already own \u2014 no walled garden, no content of ours to buy.\n\nMANY SOURCES, YOUR WAY\n\u2022 Plex \u2014 browse and play your Plex libraries in full quality.\n\u2022 DLNA / UPnP \u2014 stream from your NAS, PC or home media server.\n\u2022 Local files \u2014 play what's on your device or local network.\n\u2022 Live streams \u2014 point TuneLoft at your own M3U / Xtream sources and it plays them too, with EPG.\n\nTHE VIDEO WALL, IN YOUR ROOM\nWatch up to four sources at once, floating side by side in passthrough \u2014 four camera feeds, four channels, four films, or a live sports mosaic around you. The one thing a headset does better than any TV.\n\nTRY IT IN 30 SECONDS\nA small free demo playlist of public streams ships with the app \u2014 no credentials, no account, nothing to set up. Then point it at your own sources.\n\nBUILT AROUND YOUR PRIVACY\nTuneLoft is a bring-your-own-source player. Your sources and credentials stay on your device \u2014 the app doesn't resell, relay or host any content. It plays what you point it at.\n\nNO TYPING IN VR\nAn optional companion phone app pushes your sources to the headset, so you never type a server URL on a virtual keyboard.\n\nFREE TO START\nUse TuneLoft for free. TuneLoft Plus unlocks the full experience; you manage your subscription from our website \u2014 there's nothing to buy inside the app.", "short_description": "Universal media player for your headset: Plex, DLNA, local files and live streams \u2014 floating side by side in passthrough. Bring your own sources, or try the free demo playlist in 30 seconds, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuneloft.tv/privacy/", "developer_terms_of_service_url": null, "publisher_name": "BrentSys O\u00dc", "support_website_url": null, "website_url": "https://tuneloft.tv/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1325831353941939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_2147056636237447_7136749484665747368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rG3dzZzYBMQ7kNvwEJtpJO&_nc_oc=Adr_1s-dAZyT3HGPPW45SSufbpZ3hotediK0vT7bdZX6FxImQ12o3z-N5t4wMt5DlFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXAuun011U-YfHi3KGJePqmmvSOy2xBLuzKiQbLM9low&oe=6ACF8352"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TuneLoft", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1785508140, "lastRevision": {"nodes": [{"id": "1265636969961378", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1265636943294714", "is_first_party": false, "enables_in_app_ads": false, "is_con
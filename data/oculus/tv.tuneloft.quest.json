id=6e7a0a&_nc_ohc=dv6XQogu0_AQ7kNvwFXHCrs&_nc_oc=AdqCboU7N869-EL9SdYqChPh0-81EcX4G8JMYo0k_6HgYni26On_GrLwZ54LwaZJN4E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNlPJv7nlqrrRoRrOnvToE_6Ud7zJ4tbn9JxD9NIjgJA&oe=6A85A066"}, "display_name": "TuneLoft", "keywords": ["streaming", "multiscreen", "passthrough", "player", "video"], "long_description": "TuneLoft turns your headset into a universal media hub. One player for everything you already own \u2014 no walled garden, no content of ours to buy.\n\nMANY SOURCES, YOUR WAY\n\u2022 Plex \u2014 browse and play your Plex libraries in full quality.\n\u2022 DLNA / UPnP \u2014 stream from your NAS, PC or home media server.\n\u2022 Local files \u2014 play what's on your device or local network.\n\u2022 Live streams \u2014 point TuneLoft at your own M3U / Xtream sources and it plays them too, with EPG.\n\nTHE VIDEO WALL, IN YOUR ROOM\nWatch up to four sources at once, floating side by side in passthrough \u2014 four camera feeds, four channels, four films, or a live sports mosaic around you. The one thing a headset does better than any TV.\n\nTRY IT IN 30 SECONDS\nA small free demo playlist of public streams ships with the app \u2014 no credentials, no account, nothing to set up. Then point it at your own sources.\n\nBUILT AROUND YOUR PRIVACY\nTuneLoft is a bring-your-own-source player. Your sources and credentials stay on your device \u2014 the app doesn't resell, relay or host any content. It plays what you point it at.\n\nNO TYPING IN VR\nAn optional companion phone app pushes your sources to the headset, so you never type a server URL on a virtual keyboard.\n\nFREE TO START\nUse TuneLoft for free. TuneLoft Plus unlocks the full experience; you manage your subscription from our website \u2014 there's nothing to buy inside the app.", "short_description": "Universal media player for your headset: Plex, DLNA, local files and live streams \u2014 floating side by side in passthrough. Bring your own sources, or try the free demo playlist in 30 seconds, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuneloft.tv/privacy/", "developer_terms_of_service_url": null, "publisher_name": "BrentSys O\u00dc", "support_website_url": null, "website_url": "https://brentsys.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272251375966604"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312236_2147056636237447_7136749484665747368_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uadQ_sFMYVgQ7kNvwEx2Fru&_nc_oc=AdoVSk3nflqXb6CiiSth7UlL2wBRNMarKEH32gufJZKr9aNvdEZzuPYXQQTLnyKBf7c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXfzZsxGlnSZL8PAYNKJC9iH7O4z3LKYtEMEFz7vsmrQ&oe=6A85AF52"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TuneLoft", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1785508140, "lastRevision": {"nodes": [{"id": "1265636969961378", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1265636943294714", "is_first_party": false, "enables_in_app_ads":
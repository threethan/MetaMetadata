uscdn.com/v/t64.5771-25/499310734_1391079949549720_5361749080416681395_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKrwTKuR40MQ7kNvwGg3LNu&_nc_oc=AdqpWh4BFE3ZKei9lc2orEgRfp8p-1mi2inJEUm6zg8W1DShxp-Dh-w3NQk2uJ3u9gY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX4dyb-8-423jepKwTAem6k2ScCLVA1Uj6bMeTYZ2Q9Q&oe=6A7C481B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TuneLoft", "keywords": ["streaming", "multiscreen", "passthrough", "player", "video"], "long_description": "TuneLoft turns your headset into a universal media hub. One player for everything you already own \u2014 no walled garden, no content of ours to buy.\n\nMANY SOURCES, YOUR WAY\n\u2022 Plex \u2014 browse and play your Plex libraries in full quality.\n\u2022 DLNA / UPnP \u2014 stream from your NAS, PC or home media server.\n\u2022 Local files \u2014 play what's on your device or local network.\n\u2022 Live streams \u2014 point TuneLoft at your own M3U / Xtream sources and it plays them too, with EPG.\n\nTHE VIDEO WALL, IN YOUR ROOM\nWatch up to four sources at once, floating side by side in passthrough \u2014 four camera feeds, four channels, four films, or a live sports mosaic around you. The one thing a headset does better than any TV.\n\nTRY IT IN 30 SECONDS\nA small free demo playlist of public streams ships with the app \u2014 no credentials, no account, nothing to set up. Then point it at your own sources.\n\nBUILT AROUND YOUR PRIVACY\nTuneLoft is a bring-your-own-source player. Your sources and credentials stay on your device \u2014 the app doesn't resell, relay or host any content. It plays what you point it at.\n\nNO TYPING IN VR\nAn optional companion phone app pushes your sources to the headset, so you never type a server URL on a virtual keyboard.\n\nFREE TO START\nUse TuneLoft for free. TuneLoft Plus unlocks the full experience; you manage your subscription from our website \u2014 there's nothing to buy inside the app.", "short_description": "Universal media player for your headset: Plex, DLNA, local files and live streams \u2014 floating side by side in passthrough. Bring your own sources, or try the free demo playlist in 30 seconds, no account."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuneloft.tv/privacy/", "developer_terms_of_service_url": null, "publisher_name": "BrentSys O\u00dc", "support_website_url": null, "website_url": "https://brentsys.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1265636956628046"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2273439826734797"}]}, "baseline_offer": {"id": "2273439826734797"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785508140, "status": "PUBLISHED", "id": "2273439826734797"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1272155215976220", "version": "5.180.0"}, "id": "2484630778725251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1265636943294714", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1272155215976220"}, "release_status": "RELEASED"}, "bin
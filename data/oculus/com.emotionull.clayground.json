 "en_US", "screenshots": [{"file_name": "session-poster.png", "id": "1239108028399462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/786297305_1239108031732795_1839910425764143539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d4E-En7iLoQ7kNvwEpULZC&_nc_oc=AdpmmJNFlt27YTYNVHF9cYcFVh8F39G1UoDoi2ySPC1K22xAycTCHp-jcOsIUzAo03k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaCXbB_sPnmqEQkq1KwWHnnW6QCyfFGabC4ACYfUlx3g&oe=6AC66D04"}, {"file_name": "still_2_head_closeup_grid.png", "id": "1873012490776861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1873012494110194_4414643459021531130_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0k6VR-3JS38Q7kNvwFnQWo3&_nc_oc=AdrwiZG2Z2m7u03r2rQhRv1l6FEwQGW_61Cynhwzb3MztygcbVISb6EJOnmyljrenWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjr5lLmTA9HeAt1LtS-fxmkOViAORO-hmTXYxxASzvIQ&oe=6AC64EB7"}, {"file_name": "still_4_stamp_browser_capture.png", "id": "1087063077409430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593868733_1087063080742763_4512914092735117743_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE9MZOWuUeYQ7kNvwHzifOE&_nc_oc=AdqEqAX_VX0UtIjcuqAk8L6aLE4fibrVU0TXAxrUEvTITcm06PvIK78L7v2alxwfVnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq4eQ-pXOpA0KyzEpjw0rIZ_IV4ORidXEYb1M3hILKIg&oe=6AC668CE"}, {"file_name": "still_5_scene_panel_sculpt.png", "id": "1758480368677599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_1758480372010932_4882321350514222605_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ww2rs2P62kQ7kNvwF4xAXk&_nc_oc=AdqReX26TXg3sxVVhKJBA6ILHnWewaejA7MRXaNFsF3dsuRuhtqaeTEp-gg4UcN2F4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuHONXqMD26UUcFLVLmKDc0hBwoeT4DAKLJznMPDI2wg&oe=6AC66450"}, {"file_name": "still_3_head_layers_panel.png", "id": "1602478378287402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_1602478381620735_5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBZdQf44nb0Q7kNvwEQMrQL&_nc_oc=Ado2eSfsepvBXNWO2QK_yWswuiqA6Ft3LpnuwezbLVTOWdqUMN-jq3B3AhFHDrQPJBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPx5ke6M8pEVHpLS_wwuA0mN8h1OpBqQTvDfpS16eTO0Q&oe=6AC642AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "session-poster.png", "id": "1151383823987709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_1151383827321042_3392731402489915607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXIoLLYFzjkQ7kNvwG_DfR_&_nc_oc=AdraJ5ojIxON0F-ATicjR6Dhj4iEUUHAvZBYjUvfpGFkbwTprH-UjPSgXIUAzVk7PVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHXniX2uclASopsMKmMykIHDPqfygoifc6BB7y7CzcAA&oe=6AC65A3A"}, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay", "create"], "long_description": "tart with a lump of clay. Pull out a face, carve a shape, add some colour, and see where it goes.\n\nClayground is a sculpting studio for Meta Quest. Work in VR or bring your clay into your room with mixed reality. Use your controllers to shape and paint, build on separate layers, and turn parts of your sculpt into reusable stamps.\n\nMAKE IT YOURS\n\u2022 Add, carve, move, smooth and paint volumetric clay.\n\u2022 Keep parts of a sculpt on separate layers.\n\u2022 Work with built-in shapes or capture your own stamps.\n\u2022 Use symmetry for faces, creatures and repeating forms.\n\u2022 Experiment with frame-by-frame animation.\n\nTAKE YOUR WORK WITH YOU\nExport GLB or OBJ models, then open the headset's Share address on a phone or computer connected to the same Wi-Fi. Download your files without plugging in the headset. Open compatible exports in tools such as Blender for the next part of your project.\n\nClayground is independently developed and in Early Access. Project size and detail depend on your headset's memory and the complexity of your sculpt. No wallet or website account is needed to sculpt, save or use local exports.\n\nUpdates and help: clayvr.com\nSupport: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay in VR. Make a character, build a little world, and export your work from Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399697885561785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1375198261407769_6815019680991804292_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tu_-vPSN0bsQ7kNvwEDhyVr&_nc_oc=AdrdOZaaQwTm1LktDoOO5mqfQuEv-HM95IVbEdfLMBPEQS0TEuf4vjP4w_NhU8NB434&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8jeyiL3onJjYlCkHhUO1-l6XXx638qpPLblICgurS9g&oe=6AC64CF1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": 
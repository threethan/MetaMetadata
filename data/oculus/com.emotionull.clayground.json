 "en_US", "screenshots": [{"file_name": "01_creature_drama.png", "id": "2203618640593514", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303790_2203618643926847_2533142125294719062_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW9vBHoioYMQ7kNvwFcrDUa&_nc_oc=Ado7zN0Qa8vn9s1JQsrKeNypyu4SHRinX_-xMQ2lEoRlW6XUNVPIUptbz2E6e1uCx2U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxRfcjo_XujeHnHZdxrORCZ3w5CZ9Z6lN6_E1MQCOHZw&oe=6ADE0F07"}, {"file_name": "02_inapp_tool_wheel.png", "id": "1659215762281370", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312310_1659215765614703_2273291234157479107_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HLYtb0paYQQ7kNvwE4709c&_nc_oc=Adp2edEa1IjutKUHs-qM_wD2YvRvDMVgYC9TfREv-7JjNLYzFXfFFXqCzCau0rgIDzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB8E8r1cGXPgK-hsbb89zfAzweIcZ9-UyeAq72w0o3ug&oe=6ADDF2FE"}, {"file_name": "03_cat_golden.png", "id": "1444433477839932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313107_1444433481173265_918361448762118196_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzFo6fI35ZsQ7kNvwF2ZQTM&_nc_oc=Ado78j5CuJzUJjz27islwnvzoAC0_sJuphfBf0bnP1E0EBkzlnw8AyLWRigUnU25vFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSZicFjpLYCZDnewUO2rxlWPKZFmRlMSE_69xgvl-ZSg&oe=6ADE0CA4"}, {"file_name": "04_inapp_colour_palette.png", "id": "4080204185452533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312470_4080204188785866_3994591886946607191_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fg4qnaB1HDEQ7kNvwFZIp5-&_nc_oc=Adq7hZ71FScqVqJMGfE8NtxukQR-4Hdv-W07ONPRABPnGvFMLINwUJIw65dXua9yhz0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9yJrCH2mOcAZaUn3dFB1Ed4tf_8xs1wsv69nLz9KliA&oe=6ADE0CEF"}, {"file_name": "05_robot_mint.png", "id": "3048904532108236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312439_3048904535441569_6813222590223948974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV9aIFyMTm8Q7kNvwHDUj-X&_nc_oc=AdowMbBOgqgr1Rw1aL0rEUuDbQm-u9GpNTCAxjZ2ijJVs3Qos_nah0WzcFhe0xUXK9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGdsINL7vG23168qT_VGqw82h5rq8-9VBBFJMpiNiJ3g&oe=6ADDFD43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1081869521506909", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311606_1081869524840242_7301271838359266092_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jkUdYCOeQEQ7kNvwH4hCLn&_nc_oc=Adrxwp-LLOvm_Lt71F890SNrrYoh11O3SJi7yuo_EgB1jm7JGoSJaghG6Ud3lo1Kb18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSK9OxbzJaGEjrpF9Q6jfeGDaxyXyvB96RVD--PU78ig&oe=6ADE18AC"}, "display_name": "Clayground: VR Clay Sculpting", "keywords": ["art", "clay", "sculpting", "3D", "modeling"], "long_description": "**Sculpt clay out of thin air.** Clayground is a VR clay sculpting and 3D modeling studio for Meta Quest, made by one independent artist. Push, pull, carve, smooth and paint volumetric clay with your hands. No PC needed.\n\n**Sculpt like it's real clay**\n- Add, carve, pull, smooth, inflate, flatten, crease and paint\n- Mirror and radial symmetry for faces, creatures and patterns\n- Layers you can hide, freeze, merge and change the resolution of\n- Lattice: bend any part with a cage of handles\n- Spline: tubes, hollow pipes, rows of stamps or cookie-cutter trims\n- Starter stamps, or capture your own from your sculpts\n\n**Bring it to life**\n- Frame-by-frame animation and live-recorded motion; one-press Breathe, Sway and Boil\n- Export animated GLBs\n\n**Show it off**\n- A camera in your hand: aim, zoom and snap your sculpt\n- Mixed reality keeps your room in view, or sculpt in a calm studio\n\n**Take it anywhere**\n- GLB with colour and per-layer materials, OBJ, or print-ready STL for Blender, game engines, AR and 3D printing\n- Pair with clayvr.com and grab your files over Wi-Fi\n\n**Great for** character design, creatures, figurines, 3D art, game assets, 3D printing and learning to sculpt.\n\n**Coming from Adobe Medium?** Clayground is made for you: volumetric clay, layers, stamps and a tool wheel, standalone on Quest.\n\nFree in Early Access and updated often. Updates: clayvr.com \u00b7 Support: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay with your hands on Meta Quest, no PC needed. 3D modeling that feels like real clay: layers, symmetry, lattice, splines and stamps, in VR or mixed reality. Snap photos with the camera in your hand, then export GLB, OBJ or STL for Blender, game engines and 3D printing. Free, made by an independent artist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421948723336701"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305071_1857005545469664_6576662419401779692_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOtMN30KdyUQ7kNvwGUbHB7&_nc_oc=AdootM89GAXWVTqtVempp1vxwmdkJNOBuu1i2LlbRCTqdkrgvvDQ1kf4FDkdwNQKoJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.ocu
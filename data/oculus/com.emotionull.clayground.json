 "en_US", "screenshots": [{"file_name": "session-poster.png", "id": "1239108028399462", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/786297305_1239108031732795_1839910425764143539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUdmspks7jIQ7kNvwGomzZ_&_nc_oc=AdqxiA38L1JRX7_EbNmeVlefwjtGuatKfBUdV9aQ9QpdAHIyzf38g9PrvZ5N-581yEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSVux809p1RbljzPvnwKDzAfCh3WN1P_AM8Y24SYF9Kg&oe=6AC12704"}, {"file_name": "still_2_head_closeup_grid.png", "id": "1873012490776861", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312310_1873012494110194_4414643459021531130_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hahIALP4-9EQ7kNvwHZe8w2&_nc_oc=AdpiV3018yHSs_Yjhwh10feFWK7a_IASxbWnXo4VQXRa74ca8UA1u6ik7BCBO_TjLmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrxKxGA8YVzu4vtE41k_2WzdZomZMoKGnZ01ytmcMnFA&oe=6AC108B7"}, {"file_name": "still_4_stamp_browser_capture.png", "id": "1087063077409430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593868733_1087063080742763_4512914092735117743_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1buh5yTPux0Q7kNvwEvrB4l&_nc_oc=AdpPm_jIZPMMK9NpZUugxbhDaDypckdJ0XhBzqU81OY9_vPKs3fNRSDUWyHcDxu5hM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCJLpf5C8VzljIv_RaB9Glq8lA6gbw09EgGo4lAUm9Aw&oe=6AC122CE"}, {"file_name": "still_5_scene_panel_sculpt.png", "id": "1758480368677599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/613094043_1758480372010932_4882321350514222605_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrKSiPUVPgwQ7kNvwGZNe2G&_nc_oc=AdogCMe7lqPLI0jiOGpPd-4Z0p9_lKZmsjWOPDn1uMq8KQxunu386_TZFPjDtiebhHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSrnZykK8vNWIPwOJOFelsK7Nq53K3gX_wc8xM-JyPPw&oe=6AC11E50"}, {"file_name": "still_3_head_layers_panel.png", "id": "1602478378287402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_1602478381620735_5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvayqnbU-KsQ7kNvwH7XYo7&_nc_oc=Adq3yeag0hTecrnZi_HsyaiWTr1NIQ1ud-DPL001TrQo9HHUuYPg8N7SoxX46TOzBpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRLyqvG6kynx7qIWBPH6m5JyUDT61E9Qc5SVLAdidhEw&oe=6AC134EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "session-poster.png", "id": "1151383823987709", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673558985_1151383827321042_3392731402489915607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9InXJ79ixZQQ7kNvwFEgFiZ&_nc_oc=AdoskDGFnDjgJp9kpyGvGgqLBu8rLIhfVzf8PpLc9kbKxMD0LUaHwki29bLB-G_pBl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHHCRcI4DIVGp0dG2pHTsDHrmhAhZSLE2hzvcmCueUiQ&oe=6AC1143A"}, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay", "create"], "long_description": "tart with a lump of clay. Pull out a face, carve a shape, add some colour, and see where it goes.\n\nClayground is a sculpting studio for Meta Quest. Work in VR or bring your clay into your room with mixed reality. Use your controllers to shape and paint, build on separate layers, and turn parts of your sculpt into reusable stamps.\n\nMAKE IT YOURS\n\u2022 Add, carve, move, smooth and paint volumetric clay.\n\u2022 Keep parts of a sculpt on separate layers.\n\u2022 Work with built-in shapes or capture your own stamps.\n\u2022 Use symmetry for faces, creatures and repeating forms.\n\u2022 Experiment with frame-by-frame animation.\n\nTAKE YOUR WORK WITH YOU\nExport GLB or OBJ models, then open the headset's Share address on a phone or computer connected to the same Wi-Fi. Download your files without plugging in the headset. Open compatible exports in tools such as Blender for the next part of your project.\n\nClayground is independently developed and in Early Access. Project size and detail depend on your headset's memory and the complexity of your sculpt. No wallet or website account is needed to sculpt, save or use local exports.\n\nUpdates and help: clayvr.com\nSupport: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay in VR. Make a character, build a little world, and export your work from Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399697885561785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823279_1375198261407769_6815019680991804292_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw1QO-VLjEwQ7kNvwHTjO5X&_nc_oc=Adr9SP7yHOm-SiPpvjWYeWSfxLNSNItTJpvTTUmmhom_o-8RvPTx-JfDth8XCIOUX_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeuoESqC29ssH_o1dcIICvEhBNlrTAsjQvloTN0SQQ8A&oe=6AC106F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": 
_oc=AdroM4HnWF7xeR2T1jJqsnWhRfwfl7aYq5jOKkLFX8NR8KZEvSYLKhCoeH1qNMmrIbo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJYXr5stT8pxRuN3GZukkme6ZByngYNZLEq5sl0g6lEg&oe=6AD39EA9"}, {"file_name": "screenshot_2_face.png", "id": "1583230676518140", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507925214_1583230679851473_280048716167009569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqbP5G1OllgQ7kNvwFxWwoJ&_nc_oc=AdpnEbZOdNqt1rVgyTYyQSKI9NqNYqlt0jSDMLuG1K8cYczYfidItuRXECmuJp03q8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_dtBjxcLJm7xlBsn5JYPDDnuxemYGkCPRTlm_KO2vYg&oe=6AD38AF0"}, {"file_name": "screenshot_4_detail.png", "id": "1685064282777971", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507830485_1685064286111304_8182135067342972203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeKxFLN_ZgYQ7kNvwGCD5yv&_nc_oc=AdrgRgMeZWss-MrrmreVdjru-V0xUrflsOmBTbMK3AvlzJ_M2Od1yhu-X8W4KibbXV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmL4OycRCHsS3jdx8F0fZg46ZZSAqsZW5jbnc-ov9quQ&oe=6AD39A51"}, {"file_name": "screenshot_5_creature.png", "id": "1559818478978287", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/613094043_1559818482311620_1858277794794842808_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23z8TkeRkpUQ7kNvwGy3Bpk&_nc_oc=AdqZYj0dpVWfy6G8n6tQJGdN0WZV81tHACUgxvLHxGwzu1_6NvZe0JJ7bznwLPs3nNg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnPIVYTQzcSeWq5AkaHjgXSe81qkUKKQi2hnu9FAuBRA&oe=6AD3AA4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.", "short_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345650630966511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1420455506819356", "version": "0.2.287"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1420455506819356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Animation undo: new frame, hold, duplicate, delete frame, adding or removing keys, changing ease, and a whole recording take can all be undone.\r\nSmoother hand recordings: shake is filtered out when you let go. In the test, 4 mm of frame-to-frame tremor dropped to 0.16 mm, and the movement itself is kept.\r\nMirror plane shown: with Mirror on, the centre plane is drawn exactly where strokes reflect (measured 0.00 mm off). Preferences > Mirror plane hides it. It never appears in photos or exports.\r\nLighting looks: Preferences > Light cycles Studio, Soft, Drama, Golden and Night. Studio is the old lighting exactly, so nobody\u2019s clay looks different until they pick another look.\r\nTidier System card: the Export menu has Quality and Extras headings above its actions, and the \u201chow to share\u201d footer only shows on the Capture page instead of every page.\r\nAlso in this build from earlier today: Haptics setting, layer Lock and Isolate, see-through only over the card it hides, and keys on the timeline you can scrub.", "created_date": 1791870357, "id": "1420455506819356", "version": "0.2.287", "version_code": 287, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1420455506819356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Welcome-back card, at most once a day or after an update. It has your day streak, today\u2019s sculpt prompt (61 built-in, everyone gets the same one each day), what\u2019s new, Keep sculpting, Join the Discord, and a one-time Rate link after 3 days of use.\r\nReview ask after a player\u2019s first photo, still asked only once ever.\r\nPhotos now also save to the Quest Gallery, so they can reach the phone app.\r\nThe card fits even with the longest prompt, and the streak check fails as it should when I deliberately break it.", "created_date": 1791859782, "id": "1420352203496353", "version": "0.2.285", "version_code": 285, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1420455506819356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Fixed:\r\n\r\nUnsaved work: brush strokes now count as unsaved changes, so New, Load, resolution changes and Cut keep a backup of what you sculpted. Before, they skipped it after normal brush work.\r\nExport: \u201cExport done\u201d is no longer followed by \u201cNothing to export\u201d. The cause was a settings read on a background thread, which also meant the review prompt never showed. A real failure now says \u201ccheck free space\u201d instead of claiming the scene was empty.\r\nSave messages: they now say what actually happened: nothing to save, interrupted, or out of space. Guest mode no longer blames free space when an autosave is still finishing.\r\nSave As: \u201cMy_Moon\u201d can no longer overwrite \u201cMy Moon\u201d, and characters like / and : get cleaned out of the name instead of failing.\r\nInstant resolution change on an empty layer now clears undo, so an undo can\u2019t put the old scale back.\r\nPalette \u201cAlways\u201d mode no longer commits the last colour your pointer swept over when you turn your hand away.\r\nPhoto camera:\r\nletting go of the colour button while the camera is up now closes the palette;\r\nthe camera ignores input while the Quest system menu is open;\r\na failed photo can\u2019t leave it stuck on \u201cstill saving\u201d;\r\nthe preview does less work per frame.\r\nMemory leak: switching tools leaked about 105 materials each time. The test went from 2,132 to 4,652 materials over 24 switches with the old code, and stays at 1,812 now. The Files and Layers panels had the same leak and are fixed too.\r\nNo more freezes: Files > Load and animation GLB export now do their heavy work off the main thread.\r\nSmaller fixes:\r\na failed copy no longer leaves an empty file in Downloads;\r\nif the system won\u2019t replace a save file in one step, the old copy is now kept until the new one is in place;\r\n\u201cDelete my data\u201d needs a second press and remembers which file you\u2019re working on;\r\nthe Size slider reaches the full 300 mm and says so when the keypad clamps your number;\r\nthe website pairing code survives taking the head", "created_date": 1791806340, "id": "1419742940223946", "version": "0.2.284", "version_code": 284, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1420455506819356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "All ten items from the Discord follow-ups and Yang\u2019s report are fixed in 0.2.283. The Quest APK is built but not installed; nothing has been tried on the headset yet.\r\n\r\nReport\tFix\r\n\u201cSaved my mushroom\u2026 overwrote my moon\u201d\tSave now asks first on a file you opened (\u201cSave over \u2018Moon\u2019? Press Save again to replace it\u201d). Save As opens the headset keyboard, makes a new file with a name that can\u2019t clash, and leaves the original untouched. It replaces \u201cSave New\u201d.\r\nCan\u2019t start drawing on a low-res layer\tOn an empty layer, Res+ and Res\u2212 now apply instantly. The layer\u2019s grid is rescaled around its centre, and a label shows the new detail size in mm.\r\nPalette on the back of the off hand\tComfort > Palette now has three settings: Button, Flip, Always. Always shows the palette the moment the back of your off hand faces you, and every trigger pick sets the colour.\r\n\u201cNo way to aim the camera!\u201d\tPhoto is now a camera in your hand. A live preview screen floats above the tool controller and shows exactly what will be saved. Trigger shoots, stick zooms, B (or Photo again) puts it away. While it\u2019s up the trigger never sculpts, and grips still turn the scene for framing.\r\n\u201cA tool called Move should move an object\u201d\tThe dough tool is now called Pull. Layers > Move layer is how you move a whole piece, and the Pull tooltip points there.\r\nPaint spills past the sphere\tPaint used to reach about 35% beyond the brush sphere. It now stops at the sphere\u2019s edge.\r\nFreeze needs a tooltip; what are ^ / v?\tResting the pointer on Freeze, the ^ / v arrows or Move layer now explains what they do.\r\nZoom resolution label\tHolding both grips to zoom shows the clay detail size, e.g. \u201c6.3 mm voxels zoom 140%\u201d.\r\nYang: GLB transparency lost, one shared material\tEach layer now exports its own material, named after the layer. Glass stays see-through in Blender, glow exports as glow, and metal and roughness come from the layer. All the poses of one animated layer share one material.", "created_date": 1791735172, "id": "1419010043630569", "version": "0.2.283", "version_code": 283, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1420455506819356"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Lattice no longer traps A and keeps your bend when you switch away.\r\nOnly your own saves appear in Files, and guests can't overwrite your sculpt.\r\nThe see-through holes (#3) came from the memory cleanup freeing parts of the clay that draw a neighbouring surface. They no longer open.\r\nThe colour change after lowering resolution (#5) came from that step halving the clay's depth information. Colours now hold when you keep sculpting.\r\nLowering resolution on an empty layer just says there's nothing to lower.\r\nMenus no longer auto-close.\r\nPointing Select at empty space deselects.\r\nStrokes fade out instead of cutting off.\r\nLabels can stay on all the time.", "created_date": 1791444289, "id": "1415998963931677", "version": "0.2.282", "version_code": 282, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
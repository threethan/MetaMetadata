1-25/499312439_3048904535441569_6813222590223948974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhc7yOMjtQMQ7kNvwEn1E0a&_nc_oc=AdrB2-570jyH3QH8J8_cS3UOyp8p3l-1M-5qOTkkbn4QrYqMKKDR9y0wRuReGfYAcSs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbkp7kxILpZJas8hID0G_KOSj-bcdVmGoCyvMOiHZJGA&oe=6AECB603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clayground-cover-landscape-2560x1440.png", "id": "1163782489561573", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604379488_1163782492894906_2199309010881884016_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGNc6Lqbo2sQ7kNvwHuvrgd&_nc_oc=AdrWwVc9_7SdfYz-0MUlU0UxnB6uhDWa-gYdVL2YgG6jIfKRcSzwGffIQAf0IT1B44M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA3nXx-l2e-phQ5DSYviREhH3NmcA_l0kMKNyiqhXzoQ&oe=6AECA6CB"}, "display_name": "Clayground: VR Clay Sculpting", "keywords": ["art", "clay", "sculpting", "3D", "modeling"], "long_description": "**Sculpt clay out of thin air.** Clayground is a VR clay sculpting and 3D modeling studio for Meta Quest, made by one independent artist. Push, pull, carve, smooth and paint volumetric clay with your hands. No PC needed.\n\n**Sculpt like it's real clay**\n- Add, carve, pull, smooth, inflate, flatten, crease and paint\n- Mirror and radial symmetry for faces, creatures and patterns\n- Layers you can hide, freeze, merge and change the resolution of\n- Lattice: bend any part with a cage of handles\n- Spline: tubes, hollow pipes, rows of stamps or cookie-cutter trims\n- Starter stamps, or capture your own from your sculpts\n\n**Bring it to life**\n- Frame-by-frame animation and live-recorded motion; one-press Breathe, Sway and Boil\n- Export animated GLBs\n\n**Show it off**\n- A camera in your hand: aim, zoom and snap your sculpt\n- Mixed reality keeps your room in view, or sculpt in a calm studio\n\n**Take it anywhere**\n- GLB with colour and per-layer materials, OBJ, or print-ready STL for Blender, game engines, AR and 3D printing\n- Pair with clayvr.com and grab your files over Wi-Fi\n\n**Great for** character design, creatures, figurines, 3D art, game assets, 3D printing and learning to sculpt.\n\n**Coming from Adobe Medium?** Clayground is made for you: volumetric clay, layers, stamps and a tool wheel, standalone on Quest.\n\nFree in Early Access and updated often. Updates: clayvr.com \u00b7 Support: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay with your hands on Meta Quest, no PC needed. 3D modeling that feels like real clay: layers, symmetry, lattice, splines and stamps, in VR or mixed reality. Snap photos with the camera in your hand, then export GLB, OBJ or STL for Blender, game engines and 3D printing. Free, made by an independent artist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1432936425571264"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673819499_1109339258473484_1599606295924474698_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heRCCoGy9UoQ7kNvwGHv5n0&_nc_oc=AdppxW1n9F0Z2TZGzRw3iqP
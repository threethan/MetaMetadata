_oc=AdoVQMADtxBcQ0R0BH8yP9vOMAIl1JenRo8kX94X25wDRnmBtYH-JKclrjymjqARujk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWX7ptUDHLvV2kBgMfCUoHuO3Bdv7eran4th1Q1_ybsw&oe=6ACD0729"}, {"file_name": "screenshot_2_face.png", "id": "1583230676518140", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507925214_1583230679851473_280048716167009569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AMaXXv1Z64Q7kNvwHkNUkE&_nc_oc=Adpqdy7QFNBZx6mr0wm24yjSiXuR_QeMgr3t7Sim928TiY1EnDCQ78w24n3F7uaXD2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX2os69kmaJ2VRgoDlBTsxz9I_8L_WZGKDjg0PIV9Org&oe=6ACCF370"}, {"file_name": "screenshot_4_detail.png", "id": "1685064282777971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507830485_1685064286111304_8182135067342972203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7kZdPPf2o0Q7kNvwHlrq3w&_nc_oc=Adrqa1CA2oYFPXMxm-vCVuZEAQawS0B67m3VGVKDyN9BmhvFT08XuKJTUbxK1pBK6y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuGux-h8m6uCsfMCbJFs7ITJR2ChPfzVAXIInTG375PQ&oe=6ACD02D1"}, {"file_name": "screenshot_5_creature.png", "id": "1559818478978287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/613094043_1559818482311620_1858277794794842808_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5cSuxsdBy8Q7kNvwG0vjOH&_nc_oc=AdrHl4Z73Q5hdny99miHPGJh7CUmzGdaCJggWqJBYHGBBt4kFV2st3fChAu_s5BGjkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODEcV95vJNzkds-NYqIPakBSQ0KWnQB5HZGUAxn4-jtQ&oe=6ACD12CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.", "short_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345650630966511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1415703617294545", "version": "0.2.279"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415703617294545"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Fixed in this batch, each with a test that fails when its fix is switched off:\r\n\r\nUndo now fully reverses layer operations. Merge down, Subtract, Intersect and Merge selected (including with 3+ layers) are each one undo press. The clay comes back exactly, voxel for voxel, instead of being doubled.\r\nSplit: one undo removes the piece and puts the clay back. The temporary scratch ball no longer bumps one of your deleted layers out of the 2-slot deleted-layer store.\r\nDeleted layers stay undoable after you keep sculpting. Undo steps back through your strokes, then brings the layer back.\r\nToo-old undos are refused. If a layer it needs has already been permanently cleared, Undo says so instead of doing half the job.\r\nMoving a layer, reordering, then undoing reselects the layer that actually moved.\r\nDelete with several layers ticked removes all of them (\"Delete 3\"), and one Undo brings them all back.\r\nFiles asks before destroying anything:\r\nSave over and Del need a second press within 4 seconds; the button reads \"Sure?\" while waiting.\r\nA failed save now says so, and no longer leaves the sculpt marked as saved.\r\nExport leaves hidden layers out, including phone shares. An error partway through no longer jams exporting until restart.\r\nBoot hitch: shader warm-up was saving an empty recording over the good one on every pause. It now keeps them separate, never saves a smaller recording, and logs whether recording works on the headset.\r\nDevice-log noise: the Lattice tool no longer logs every second, and the log's repeat filter now catches lines whose only difference is the numbers. The bounds warning that appeared whenever a layer was set aside to save memory is fixed, as is the new-layer behaviour that set the previous layer aside straight away.\r\nPassthrough: shadows, see-through clay, panels and text were blending at a fraction of their intended strength (a 40% shadow showed at 16%). This is the one fix that still needs a look on the headset.", "created_date": 1791411916, "id": "1415703617294545", "version": "0.2.279", "version_code": 279, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415703617294545"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791399503, "id": "1415594953972078", "version": "0.2.278", "version_code": 278, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415703617294545"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791382857, "id": "1415404367324470", "version": "0.2.276", "version_code": 276, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415703617294545"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791362780, "id": "1415178247347082", "version": "0.2.275", "version_code": 275, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415703617294545"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Labelled tabs: the menu rail shows each tab's name under its icon (Tools, Color, Stamps, Layers, Anim, Files, System), not just on hover.\r\nOne look: the Undo / Redo / Mirror / Grid card under the tool wheel, and the hint and toast banners, now use the same flat panels as the menus. On/off is the selection outline instead of switch knobs, and Undo/Redo have arrow icons.\r\nHints stop covering menus: hints were landing on the open menu. It's a perspective problem: the banner sits farther away than the menu, so \"below the menu\" by height still drew it on top. I measured the old placement at 4.6\u00b0 inside the card; it's now placed by viewing angle and sits below.\r\nEvery press shows: a small ring appears where each menu click lands, on top of the existing sound and buzz.\r\nTimeline tabs are now named for what they hold, Keys / Wobble / Poses / Settings, under an \"Animate\" header.\r\n3D printing: the 3D print export preset writes an STL your slicer opens as-is. It's 80 mm tall and standing on the build plate. On the test sculpt I checked that it has no holes: all 50,904 edges are each shared by exactly two triangles, and a separate check confirmed that count. My first watertight check reported false holes; that was a bug in the check, not in the file, and it's fixed.", "created_date": 1791358906, "id": "1415142707350636", "version": "0.2.274", "version_code": 274, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
 "en_US", "screenshots": [{"file_name": "session-poster.png", "id": "1239108028399462", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/786297305_1239108031732795_1839910425764143539_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilLR0TOznRoQ7kNvwHpn1Mq&_nc_oc=AdoJ1f2gRupmsMCMLEn-cJrCL0ptJl6vhks30rstHm2U7v29Pojoh7XXMLJwypsE-Mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb2WtVQzigWCk1fo_5ZXXKleW_awJuEv2pTj9nZ3nCvA&oe=6ABD3284"}, {"file_name": "still_2_head_closeup_grid.png", "id": "1873012490776861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312310_1873012494110194_4414643459021531130_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hac8fC-PMjEQ7kNvwHK8XdO&_nc_oc=AdreaXzMXt4belRh5DCNzEe1EQkgg4lSaUnwkOsIbb5W3tVpaYQZG2_jrs-R7ItHLFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHOnhq479q18RjUI5c_6bKtYRoym16todkijPxC__oSw&oe=6ABD1437"}, {"file_name": "still_4_stamp_browser_capture.png", "id": "1087063077409430", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593868733_1087063080742763_4512914092735117743_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IQn3e1FzCcQ7kNvwGrx7UZ&_nc_oc=AdrrMvdUD8Cl9kybd07OZkd0PBWdQNokos9ILaW-xYbsIfVogi6Q6oQGJhzHVzFfPD0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWy7v4Lwn0xF-0LyHhzb7B6FZeKXY5P4EaEN2F3ldnXw&oe=6ABD2E4E"}, {"file_name": "still_5_scene_panel_sculpt.png", "id": "1758480368677599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/613094043_1758480372010932_4882321350514222605_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVRU-To6hTMQ7kNvwHK3hmy&_nc_oc=Adr9o9B_ZjcdEp7M2LrxKwpu-GYNFKb0U4CsIGF7pszfGPglCPN36BInNfX6doRFzoA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ_QsGyZaYHr48a6aLqsmd4-hXLcz4haJEnX20tjNdVA&oe=6ABD29D0"}, {"file_name": "still_3_head_layers_panel.png", "id": "1602478378287402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593902063_1602478381620735_5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF3ILec4kGMQ7kNvwFkhMKv&_nc_oc=AdrQwEk5c5FS7GLbSRl5aCR1BY5xvIHktc5eAHLphL3GTOha7A1fTy31jrRIl6BjT6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsDYbRTm2YIJWJweyOXgi3C8qxkyG2pdMGw2LTcs8Rzg&oe=6ABD082E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "session-poster.png", "id": "1151383823987709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673558985_1151383827321042_3392731402489915607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7p_dIsVXIgQ7kNvwHXlm-L&_nc_oc=AdrFYxCvTojR5jEUz9qCql_cS1mKvX2RQpSdfqSKizTL0wR87a663PfY2vNVKt_uRiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1dXxkkZnToji5AZxKKXf3sdE-VVFe1LRyhAfb4JLJcg&oe=6ABD1FBA"}, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay", "create"], "long_description": "tart with a lump of clay. Pull out a face, carve a shape, add some colour, and see where it goes.\n\nClayground is a sculpting studio for Meta Quest. Work in VR or bring your clay into your room with mixed reality. Use your controllers to shape and paint, build on separate layers, and turn parts of your sculpt into reusable stamps.\n\nMAKE IT YOURS\n\u2022 Add, carve, move, smooth and paint volumetric clay.\n\u2022 Keep parts of a sculpt on separate layers.\n\u2022 Work with built-in shapes or capture your own stamps.\n\u2022 Use symmetry for faces, creatures and repeating forms.\n\u2022 Experiment with frame-by-frame animation.\n\nTAKE YOUR WORK WITH YOU\nExport GLB or OBJ models, then open the headset's Share address on a phone or computer connected to the same Wi-Fi. Download your files without plugging in the headset. Open compatible exports in tools such as Blender for the next part of your project.\n\nClayground is independently developed and in Early Access. Project size and detail depend on your headset's memory and the complexity of your sculpt. No wallet or website account is needed to sculpt, save or use local exports.\n\nUpdates and help: clayvr.com\nSupport: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay in VR. Make a character, build a little world, and export your work from Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399697885561785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1375198261407769_6815019680991804292_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctm4Fwq7w28Q7kNvwF4tEKc&_nc_oc=Adok50heV4l3iE_hI7GHJI82PbKeWMFloq_UFzF9EAoGUgABScGJL0Cl0ujWNvDQMFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw7NCFS7btz02atOyY1Apmf1R0OB01t730acHU9wcgdg&oe=6ABD1271"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": 
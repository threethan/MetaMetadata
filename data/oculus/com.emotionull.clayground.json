5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvayqnbU-KsQ7kNvwF4QIjc&_nc_oc=AdorZF0VOJWihu5Ne3b1UmK_b8NyyAddGurBPabuezwdLeoH-AXzwJ4EP2lNPF2b8X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Hyonu6U9Ylne0nx2kgOEz_xUgm0SvpRFQmhWaCT1GA&oe=6AC3D7EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "session-poster.png", "id": "1151383823987709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673558985_1151383827321042_3392731402489915607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXIoLLYFzjkQ7kNvwGaj2ap&_nc_oc=AdpkLtWsSudJIhf2mFPnT_PwAy72D_2vKr8DcQUnnYFZZCJX2BqbPUX9578mdQ1QB4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpfcyG05Wz3a7I3T3WgF771UMy5OpwtY7IunlwfrvvaQ&oe=6AC3B73A"}, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay", "create"], "long_description": "tart with a lump of clay. Pull out a face, carve a shape, add some colour, and see where it goes.\n\nClayground is a sculpting studio for Meta Quest. Work in VR or bring your clay into your room with mixed reality. Use your controllers to shape and paint, build on separate layers, and turn parts of your sculpt into reusable stamps.\n\nMAKE IT YOURS\n\u2022 Add, carve, move, smooth and paint volumetric clay.\n\u2022 Keep parts of a sculpt on separate layers.\n\u2022 Work with built-in shapes or capture your own stamps.\n\u2022 Use symmetry for faces, creatures and repeating forms.\n\u2022 Experiment with frame-by-frame animation.\n\nTAKE YOUR WORK WITH YOU\nExport GLB or OBJ models, then open the headset's Share address on a phone or computer connected to the same Wi-Fi. Download your files without plugging in the headset. Open compatible exports in tools such as Blender for the next part of your project.\n\nClayground is independently developed and in Early Access. Project size and detail depend on your headset's memory and the complexity of your sculpt. No wallet or website account is needed to sculpt, save or use local exports.\n\nUpdates and help: clayvr.com\nSupport: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay in VR. Make a character, build a little world, and export your work from Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1399697885561785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1375198261407769_6815019680991804292_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xw1QO-VLjEwQ7kNvwF6M8PN&_nc_oc=AdreD2S1Bz1FQSMyR0huWnUvpgOHLT5fZ23_UVAtddtUjVafv-FIEAjt5ld3JElx_CE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAU-FDfD5QgErplJ2cubSbI-PsChAWGYqtXhvpCoUCWA&oe=6AC3A9F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": 
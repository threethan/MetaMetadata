_oc=AdoH85vi3anuWiMhaguSlQydUtA5xw_af4ugKb-9frZSGJje5CLAUg46Ka3nsAqAhmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfZUA8IjMM-ThNGWce3fx15VOcS6mVgfzGAfx8HhziXQ&oe=6ACFAA29"}, {"file_name": "screenshot_2_face.png", "id": "1583230676518140", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507925214_1583230679851473_280048716167009569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AMaXXv1Z64Q7kNvwGa4pIR&_nc_oc=AdrPGQKk9S6RF-L6WrgoBGTMuZiAuO391kh652-e_IDpDG9BV8fZvwP69Ui4reokqng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbRI8xM3FQ09VGfsb5iZ8f4mPHopSHXzMU4MWvNdH5Xw&oe=6ACF9670"}, {"file_name": "screenshot_4_detail.png", "id": "1685064282777971", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507830485_1685064286111304_8182135067342972203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r9QeL5e6sq0Q7kNvwEFFJgm&_nc_oc=Adrq3aQ_saDe30nEwaBvAPxEYuyRIGxjQdL71X_NBUkWEw7-T55Tu5F9WxqoWL1wD4A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMk8gfaI6O2QjK8NY7rz3Iem2lM6Jty7vF8RHedWoHvzA&oe=6ACFA5D1"}, {"file_name": "screenshot_5_creature.png", "id": "1559818478978287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/613094043_1559818482311620_1858277794794842808_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtcx_vN9iBgQ7kNvwHR4Jwb&_nc_oc=AdpJHO1xBlozlDLtQXTWUYAwA2lfMaSDSHOdKz9Z_OyLG4RY6Ain-Qre-nzkfkKWAs4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfemfvsw45UuToJkK0TmeVykkyxYJtEpRJL8XYDxybFg&oe=6ACFB5CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.", "short_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345650630966511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1415998963931677", "version": "0.2.282"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415998963931677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Lattice no longer traps A and keeps your bend when you switch away.\r\nOnly your own saves appear in Files, and guests can't overwrite your sculpt.\r\nThe see-through holes (#3) came from the memory cleanup freeing parts of the clay that draw a neighbouring surface. They no longer open.\r\nThe colour change after lowering resolution (#5) came from that step halving the clay's depth information. Colours now hold when you keep sculpting.\r\nLowering resolution on an empty layer just says there's nothing to lower.\r\nMenus no longer auto-close.\r\nPointing Select at empty space deselects.\r\nStrokes fade out instead of cutting off.\r\nLabels can stay on all the time.", "created_date": 1791444289, "id": "1415998963931677", "version": "0.2.282", "version_code": 282, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415998963931677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Fixed and proven:\r\nLattice no longer traps the A button, and switching away keeps your bend.\r\nA flips between your last two tools.\r\nOnly your own saves appear in Files; anything automatic goes to Files > Backups.\r\nLowering resolution on an empty layer just says there's nothing to lower.\r\nMenus stay open unless you turn on auto-close.\r\nPicking empty space with Select deselects.\r\nFlipping your off hand over shows the palette.\r\nStrokes fade out instead of cutting off.\r\nLabels can stay on all the time.\r\nThe Tools page says which tools aren't on the wheel.\r\nBuilt, only partly testable on desktop:\r\nBigger hint text that stays up longer.\r\nPanels that are no longer see-through and don't interrupt a stroke you've started.\r\nA colour per tool.\r\nRename and a colour chip for each layer.\r\nPhoto and backdrop colour.\r\nThe volume setting and softer sounds.\r\nNot solved:\r\nThe see-through holes on the moon (#3). My first theory was disproved by a direct check of every triangle against the clay surface. The one improvement I kept takes a heavily pulled test blob from 12 to 10 bad triangles out of about 54,000; it isn't the player's case. Could you ask them for the moon .clay file? If we can't reproduce it, drawing both sides of the clay would hide these holes for certain, but it costs GPU time, so it needs your OK and a headset performance check first.\r\nColour shift after lowering resolution (#5). I couldn't reproduce it either, so I kept a safer colour pick but haven't claimed a fix.\r\nController models (#8). These need Meta's Core SDK.\r\n\r\nThe release notes say all this plainly, including asking the player for th", "created_date": 1791440849, "id": "1415967783934795", "version": "0.2.280", "version_code": 280, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415998963931677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Fixed in this batch, each with a test that fails when its fix is switched off:\r\n\r\nUndo now fully reverses layer operations. Merge down, Subtract, Intersect and Merge selected (including with 3+ layers) are each one undo press. The clay comes back exactly, voxel for voxel, instead of being doubled.\r\nSplit: one undo removes the piece and puts the clay back. The temporary scratch ball no longer bumps one of your deleted layers out of the 2-slot deleted-layer store.\r\nDeleted layers stay undoable after you keep sculpting. Undo steps back through your strokes, then brings the layer back.\r\nToo-old undos are refused. If a layer it needs has already been permanently cleared, Undo says so instead of doing half the job.\r\nMoving a layer, reordering, then undoing reselects the layer that actually moved.\r\nDelete with several layers ticked removes all of them (\"Delete 3\"), and one Undo brings them all back.\r\nFiles asks before destroying anything:\r\nSave over and Del need a second press within 4 seconds; the button reads \"Sure?\" while waiting.\r\nA failed save now says so, and no longer leaves the sculpt marked as saved.\r\nExport leaves hidden layers out, including phone shares. An error partway through no longer jams exporting until restart.\r\nBoot hitch: shader warm-up was saving an empty recording over the good one on every pause. It now keeps them separate, never saves a smaller recording, and logs whether recording works on the headset.\r\nDevice-log noise: the Lattice tool no longer logs every second, and the log's repeat filter now catches lines whose only difference is the numbers. The bounds warning that appeared whenever a layer was set aside to save memory is fixed, as is the new-layer behaviour that set the previous layer aside straight away.\r\nPassthrough: shadows, see-through clay, panels and text were blending at a fraction of their intended strength (a 40% shadow showed at 16%). This is the one fix that still needs a look on the headset.", "created_date": 1791411916, "id": "1415703617294545", "version": "0.2.279", "version_code": 279, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415998963931677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791399503, "id": "1415594953972078", "version": "0.2.278", "version_code": 278, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415998963931677"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791382857, "id": "1415404367324470", "version": "0.2.276", "version_code": 276, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1458696012995305", "version": "0.2.360"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458696012995305"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Found it. A feature called Spin was keeping the view turning if you let go while your hand was still moving. In today's update (0.2.360) it's off unless you turn it on. If you're still on the old build, switch it off now at Preferences > Comfort > Spin. Tell me if it still happens after the update.", "created_date": 1795289583, "id": "1458696012995305", "version": "0.2.360", "version_code": 360, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458696012995305"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Comfort > Tip now cycles Handle, Between, Pointer, Pencil. Pencil is the Pointer direction swung 40\u00b0 to the inside of the hand, so the tip sits about 6 cm to the left for a right hand and mirrors for Lefty.", "created_date": 1795213414, "id": "1457791856419054", "version": "0.2.359", "version_code": 359, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1458696012995305"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "A new look: rounded dark menus, solid highlights on what is selected, and every tool listed first on the Tools page. Everything is where it was. Prefer the old one? Preferences > Look: Classic, then reopen Clayground.\r\nFixed: when you opened Clayground, the welcome card and your clay could appear behind you or facing the wrong way. They now come to where you are looking.\r\nCel shading: Preferences > Cel shading draws your sculpt like a cartoon, in flat bands of light with a dark edge.\r\nChoose where the tool tip sits: Comfort > Tip. Handle (as before), Between, or Pointer, for holding the controller like a pen or a microphone.\r\nPhotos with a transparent background: Preferences > Photo: Cutout saves your sculpt as a PNG with nothing behind it. And photos no longer show up twice in your Quest gallery.\r\nChanging tools by accident? Try Comfort > Wheel: Click. The tool wheel then only changes tool when you point at one and pull the trigger. Also fixed a cut-off message on an empty Files page.", "created_date": 1795149138, "id": "1457001849831388", "version": "0.2.358", "version_code": 358, "release_status": "RELEASED", "status": "APPROVED", "b
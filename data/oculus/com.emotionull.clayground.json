rt_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345650630966511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1415062044025369", "version": "0.2.272"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415062044025369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Selecting several layers\r\n\r\nEach row in the Layers list now starts with a checkbox, like Medium's. The green layer is always selected and leads the group; tick other layers to add them.\r\nTapping a layer's name selects just that one again, as in Medium. Pointing at clay in the scene also selects a single layer.\r\nThe bar above the actions reads like \"Layer 1 + 2 more \u00b7 3 selected \u00b7 grip moves all\", and every selected row gets the outline (screenshot above).\r\n\r\nWhat you can do with the selection\r\n\r\nMove: the grip moves all selected layers as one piece and keeps their arrangement. Two-handed scale and rotate work the same way. One undo puts them all back. If a layer has animation keys, moving it updates its key the same way a single-layer move does.\r\nCombine: \"Merge selected\" is under \"Combine and grab\" and merges every ticked layer into the green one. Like Merge down, it deletes the merged layers and can't be undone.\r\nAnimate: Breathe, Sway, Twist and Boil (and Less/More/Reset) apply to every selected layer in one press, and layers you didn't select aren't affected.\r\n\r\nMirror lock", "created_date": 1791350107, "id": "1415062044025369", "version": "0.2.272", "version_code": 272, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1415062044025369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1791251207, "id": "1414082790789961", "version": "0.2.270", "version_code": 270, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {
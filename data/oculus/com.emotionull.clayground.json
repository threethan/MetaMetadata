09569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJsMIN-sllIQ7kNvwFBkmjV&_nc_oc=AdoI5VkdYSQO2_JtZ5aJjXnJOcaS3XyaQ4VfxOgmSqnsNYdNARk6Aat7wzsohnnB0Vc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOY8H6v4nv0NvP5UriRKVYudnV0SsqXEx64KCYwHShGA&oe=6AB7DB70"}, {"file_name": "screenshot_4_detail.png", "id": "1685064282777971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507830485_1685064286111304_8182135067342972203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6FamF1y6gUQ7kNvwH-e_V3&_nc_oc=Adqeh6w9tJGN_4iV4RiiXhxmc1v0nrX_WX1FfOO_e7jhsNAbGYAzxisHZpcsmcGAfkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCarwHHP3sRT9I5Udd9ZSKy1r6yh4VN4MoxuXg6EVJnA&oe=6AB7EAD1"}, {"file_name": "screenshot_5_creature.png", "id": "1559818478978287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/613094043_1559818482311620_1858277794794842808_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrC2UC0LmIYQ7kNvwEhDhek&_nc_oc=AdrY150baZFiEnbpodbxOe_OPCaPUQmNBq0UWsijP0aIbt_6DlT-piCTlwpBzwb58wI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoFu77iWRaXzNG6ynXDv9a3982K1kVcl6VoN-v664Onw&oe=6AB7C28A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.", "short_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfo
cale": "en_US", "screenshots": [{"file_name": "still_1_phetta_head_hero.png", "id": "1695665554879862", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312338_1695665561546528_2926346802298282002_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZvVak3m-2sQ7kNvwGZRZPv&_nc_oc=Adrtnn4vnskVM8RwoVet8NwA-6fizlP3ZTDBjyyGC3wMwHmfNSwAa87gOaaemZQWX_8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQBT_zEj-xW7iZRZLzZ67Lxihy6HC5Hkyqb-0fK9NOzg&oe=6AA422E2"}, {"file_name": "still_2_head_closeup_grid.png", "id": "1873012490776861", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312310_1873012494110194_4414643459021531130_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG8n7EtfR5wQ7kNvwGi6eJJ&_nc_oc=AdqC8pIHT4kh9JcsTloJicINeG_eWlsx8dvfa5riAVld0rYJNrSW6e0lWXfOxUSUKQQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtI8GzDUuXkCdH3EtyKQqNRvH3K_vJnNeOXNv3MXZlEw&oe=6AA407B7"}, {"file_name": "still_4_stamp_browser_capture.png", "id": "1087063077409430", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/593868733_1087063080742763_4512914092735117743_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_6aqmhKnjYQ7kNvwF779Jd&_nc_oc=Adr9vOAGhzNRkyOgsj7OxzXnPhAg3OFCUyTUazK2P-EWUx9tqo9Ce7HXJUvgBY0lvoM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ51blXO-1D46jKeiU2s4WsbWt--JV4fy_XkStZSKVRfg&oe=6AA421CE"}, {"file_name": "still_5_scene_panel_sculpt.png", "id": "1758480368677599", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/613094043_1758480372010932_4882321350514222605_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKWak4arQeYQ7kNvwE5PbGv&_nc_oc=Adq-loQq35zCkz4hdbrK5uktFXnf6ijtLH8Nz1ZPCuIyGuJPrMFIcGycmCEExWhncDk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDezvb99-ccbqjxgfUhDxPTy45eUyAXrekni83YcMwSg&oe=6AA41D50"}, {"file_name": "still_3_head_layers_panel.png", "id": "1602478378287402", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593902063_1602478381620735_5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw6pLlQflWQQ7kNvwHgqz2H&_nc_oc=Adq9EqswKQehHFJGmHTmtgiG79KY6DxuTQjVD0YLSCfbrsypHczdasAQ6cs30d1utbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnUuY7n9NTxyCIX3nDEy3qgoD2RpNOi70ifTLq43rBxA&oe=6AA3FBAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "**Clay you can actually push around.**\n\nClayground is a volumetric sculpting app \u2014 real clay, not a mesh you nudge. Add, carve, smooth, pinch and stretch anywhere, at any scale. There are no vertices to manage and no topology to fight; if it looks like clay, you can treat it like clay.\n\n**Start in seconds.**\n\nA ball of clay is waiting when you put the headset on. Squeeze the trigger and you're sculpting. A guided walkthrough teaches the rest \u2014 tools, colour, layers, a step at a time, and you can replay it whenever you like.\n\n**14 sculpting tools**\n\nClay, Smooth, Crease, Move, Inflate, Flatten, Squash, Swirl, Hook, Cut, Stamp, Paint, Select and Shape (place a primitive, then squeeze and stretch it before committing). Eight sit on a spring-loaded wheel on your off hand, flick and release, no menus. Brush size and tool strength are on the stick, so you can adjust while you work.\n\n**Guides that keep things honest**\nMirror symmetry, a lathe turntable, grid and angle snapping, and line, plane and surface constraints for when a shape needs to be straight.\n\n**Up to 16 layers**\n\nKeep the head, the eyes, the pupils and the hat apart. Layers hide, freeze, duplicate, merge, subtract and intersect, carry their own material (default, metal or emissive) and can be moved, rotated and scaled independently. A layer only costs what it holds, so a pair of pupils is nearly free.\n\n**Stamps, including your own**\n\n14 built-in shapes, plus the important part: capture anything you've sculpted as a stamp", "short_description": "Sculpt real volumetric clay in VR. Pull a shape out of nothing with your hands, then take it to Blender, or just enjoy making a mess. Free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/09/clayground_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1385406583657582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823279_1375198261407769_6815019680991804292_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy4Q3CoeGcwQ7kNvwHjDe8k&_nc_oc=Ado02JTKlKL_Qo9JSgeLYQojlticgjztusEsqPC5wiI9c4XimW0TmdkkwOXG3gKDQ0o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaRdJn2brBXRX9KelQYTBAPq_c-7QEPK2T3IOV3lraZg&oe=6AA405F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": "SCHEDULED", "admin
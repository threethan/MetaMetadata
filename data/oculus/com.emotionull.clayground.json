y", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1399690868895820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "**Line constraint actually draws a line.** It used to lock to the direction the\r\n  controller pointed, so sweeping your hand across the clay made the cursor sit still.\r\n  It now locks to the direction you start drawing in.\r\n- **Achievements you already earned are being awarded.** A server hiccup meant some\r\n  unlocks were recorded on your headset but never sent. This build re-sends them on\r\n  first launch \u2014 expect a few to pop.\r\n- **Rate** added to the System menu, and a nudge after your first export.\r\n- Freezing (Ice) a layer now frees up mesh memory as well as clay memory, so big\r\n  multi-layer scenes go further.", "created_date": 1789019183, "id": "1391567186374855", "version": "0.2.224", "version_code": 224, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1399690868895820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "**Line constraint actually draws a line.** It used to lock to the direction the\r\n  controller pointed, so sweeping your hand across the clay made the cursor sit still.\r\n  It now locks to the direction you start drawing in.\r\n- **Achievements you already earned are being awarded.** A server hiccup meant some\r\n  unlocks were recorded on your headset but never sent. This build re-sends them on\r\n  first launch \u2014 expect a few to pop.\r\n- **Rate** added to the System menu, and a nudge after your first export.\r\n- Freezing (Ice) a layer now frees up mesh memory as well as clay memory, so big\r\n  multi-layer scenes go further.", "created_date": 1788973479, "id": "1391165799748327", "version": "0.2.221", "version_code": 221, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1399690868895820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1788904697, "id": "1390506696480904", "version": "0.2.219", "version_code": 219, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1399690868895820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": null, "created_date": 1788638333, "id": "1387977483400492", "version": "0.2.208", "version_code": 208, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 
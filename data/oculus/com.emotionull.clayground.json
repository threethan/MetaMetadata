381620735_5986968043310005399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yfi2Da5TNoQ7kNvwHJnZNQ&_nc_oc=AdrheWY2oThhouI6WMfXy6HvRAnBHSoXlpW4seYPxjWAxI7PeiV991Fm0xICTt5k5sI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeZzSDUQD7GPPbOg5V18Pv6uucnhmVl-8CftM3DXyhWw&oe=6A9429AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.\n\nvirtual clay that feels like clay \u00b7 24 tools incl. Move, Smooth, Stamp & Snake Hook \u00b7 40+ stamp shape library \u00b7 flipbook animation timeline \u00b7 import your own 3D models \u00b7 one-press turntable GIFs \u00b7 export GLB/OBJ straight to your phone over Wi-Fi \u00b7 mixed reality passthrough", "short_description": " Sculpt real clay with your hands. Paint it, animate it frame by frame, and send it to your phone \u2014 the only sculpt-and-animate studio on Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
67792927_8880004696481758097_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWc02Ob-l8EQ7kNvwHWqN_F&_nc_oc=Adqcz8ac52KQweNs85YackLSfA-OSdZugnDtYt_HWBrsvEx4gAPy9NTchFvRl--DcTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6NhmpJD8eYO0AbaWtKldPbrDHgJ1vluywAshotjZLGA&oe=6AE613A9"}, {"file_name": "screenshot_2_face.png", "id": "1583230676518140", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507925214_1583230679851473_280048716167009569_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIDiSudlrsUQ7kNvwEpCsYZ&_nc_oc=AdqvQhoVDmqMXZWCoJVUEgF9DcwCsbhwosANtZLZqox0TzgYVO9IA0sQF_iHiwnlbwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjg6kAapezH4jAne6YveoINSup8hG_xyTJB5cLDK552Q&oe=6AE5FFF0"}, {"file_name": "screenshot_4_detail.png", "id": "1685064282777971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507830485_1685064286111304_8182135067342972203_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RycpDPI53kQ7kNvwGwf_HS&_nc_oc=AdqkJ9YZbfVXGbiqD17CfNxOq2WjyB_dqEPO1BiTopAL7rYNp4jiB8f0SQon-ZVi3xo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuvSH2YI63wu8l7EUOqfS3FpADhpZpgVH5gF_67slsCg&oe=6AE60F51"}, {"file_name": "screenshot_5_creature.png", "id": "1559818478978287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613094043_1559818482311620_1858277794794842808_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_ltNhg9S-cQ7kNvwEnnwHv&_nc_oc=Adpf2K9wnC3Rw-9XjC_0dxOcwe9dmFf5YF7wBkEyPnXXkDjvHmUwPNqMxq1jJqrkvks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYT9sAqHKcoH3xUDrcwLNisAeeuceAIYyE22shqqhxoA&oe=6AE5E70A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clayground", "keywords": ["art", "sculpt", "3d", "clay"], "long_description": "Clayground is true volumetric clay sculpting on Meta Quest.\nPaint infinite clay with zero polygon anxiety, on an unbounded canvas that grows wherever you sculpt. Capture any part of your sculpt as a stamp. Sculpt in mixed-reality passthrough at your real desk. Export to Blender with one press.", "short_description": "Real clay. Your room. Sculpt without limits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emotionull.art/wp-content/uploads/2026/07/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://emotionull.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1345650630966511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888881050951536"}]}, "baseline_offer": {"id": "888881050951536"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785211200, "status": "PUBLISHED", "id": "888881050951536"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1433202875544619", "version": "0.2.315"}, "id": "1278478724173176", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433202875544619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "Sculpting with your hands is steadier and keeps up better: the clay follows your hand, not your fingertips\u2019 wobble, so lines come out smoother and slow strokes no longer trail behind.\r\nLetting go of a pinch no longer leaves a little hook of clay at the end of the stroke.\r\nA stroke no longer breaks into beads when hand tracking drops the pinch for a moment while your fingers are still together.", "created_date": 1793074420, "id": "1433202875544619", "version": "0.2.315", "version_code": 315, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433202875544619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "New: sculpt together. Open SYSTEM > Together, host a room, and friends join with its code or a Meta invite, from anywhere. Up to four people, each with their own clay. The host can hide or remove anyone, and Meta\u2019s Report button works as usual.\r\nNew: your references from clayvr.com. Sign in at clayvr.com, add images under My stuff > Online > References (from your computer, or Google Drive), then press My account in References once to link this headset. From then on your images arrive whenever References opens.\r\nNew: send reference images from a PC or phone on the same Wi-Fi. In References, press Add yours, open the address it shows in any browser, and drop images. They appear straight away, newest first.\r\nA pinch with your palm turned toward you no longer sculpts. That is Quest\u2019s own menu gesture, and a tip now explains it.\r\nBig strokes are smoother: a wide Smooth or Move through open space no longer freezes the headset for a moment when it ends, and Undo holds far more of your history.", "created_date": 1793038599, "id": "1432865958911644", "version": "0.2.314", "version_code": 314, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433202875544619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "- Hand tracking, rebuilt: your real hands now show in front of the clay instead of vanishing into it. A relaxed pinch lays full-size clay, and tracking glitches no longer fling strokes across the room or freeze your cursor. Hands also use Meta's standard tracking rate again, which is steadier for close work and in dim rooms.\r\n- New Sculpt Panel for hand tracking: your main tools, Add / Remove (one tap to carve out eyes), brush size with S / M / L, strength, colours, Undo / Redo and Center (brings your sculpt back in front of you), all within reach. Tap its buttons with a fingertip or point and pinch; pinch its top bar to move it, and fold it to its bar with \"-\". It hides while you hold controllers, and you can turn it off in Preferences.\r\n- New hand gestures: pinch your other hand's middle finger and thumb to hold the sculpt and turn it; pinch your ring finger and thumb to open the tool ring.\r\n- With controllers, the thumbstick now shows your brush size at the tip while you change it, and resizes a little faster.\r\n- Paint's Stomp mode now says what it does: each pull fills the whole layer with your colour (the same as Fill layer).", "created_date": 1792615422, "id": "1428415126023394", "version": "0.2.310", "version_code": 310, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433202875544619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "some visual fixes to ease flow of sculpting.", "created_date": 1792273394, "id": "1424817093049864", "version": "0.2.304", "version_code": 304, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345650624299845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1433202875544619"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1278478724173176"}]}, "change_log": "fixes", "created_date": 1792263664, "id": "1424722696392637", "version": "0.2.303", "version_code": 303, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
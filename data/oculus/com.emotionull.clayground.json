e": "en_US", "screenshots": [{"file_name": "01_Sculpt_65_close.png", "id": "1444870340895811", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/753032404_1444870344229144_896054430153082543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY2jM0Tvp2kQ7kNvwFE5av-&_nc_oc=AdoahjcdFo-hvSM7chvoNXUXl9m_QY9Dr68tjiAHs2cRMWrA99184hvWOD665SsOtr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmd3lt0Ihvl2GIdmUlXaAlHn9ZkK5F3WEsa5ihFlwGlQ&oe=6ACF9F11"}, {"file_name": "02_Recovered_26_close.png", "id": "1885487409103644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596168449_1885487412436977_5610991382400266068_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmifHtVAI4EQ7kNvwEw8hvo&_nc_oc=Adptf1M9uBTFwPpAZ6LTbKXc2Sp1nD9bc39TXigDs7ec3jENzxWD5LC4Voi3NeyJpvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpst2jPhCvvRUUtBm624_PhDKwUwRiQq4P_HoShd3JKg&oe=6ACF8CFA"}, {"file_name": "03_Sculpt_52_threequarter.png", "id": "1471296794919693", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604317775_1471296798253026_7674336084604590675_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul1kYSG3POUQ7kNvwEXCoTM&_nc_oc=AdrPfd0vDZl-LrhTHe3IRxcDUc16ZOSTClWKNzbpSlHJq5p-BuW5cg43S4BAt9d0ms8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQn4M1x3NwA0wbX4j92bNsdbsoqm8beJirS-OACZJuUA&oe=6ACF9851"}, {"file_name": "05_Sculpt_49_threequarter.png", "id": "1584548512779624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/825629712_1584548516112957_7510180071289625948_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z2ALL44FU0Q7kNvwEHhAtE&_nc_oc=AdrFaUgJLtBIRx6C7tL1u2l4GCY-7por7YC-pITISu1d6uO9X32LdWYHdkfgziWDRso&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXtv_kWNjJNXBWh_8nf-6Axj_GesSGt7y4mMuqV4J76g&oe=6ACFB676"}, {"file_name": "04_Recovered_18_threequarter.png", "id": "2575920092856608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830822_2575920096189941_7716118497146851655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7tCXNvo_IgQ7kNvwEiR6-C&_nc_oc=Adr8Jg4MRhsblo529bBFN-Rn4U25Mqq8EY1wGVq__mL2h4NmfqD976N9OtnBXiB7TBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2w2oh_3hBnfbTXDR8Gv1_JdoRc_0mAj66-S8OX1PSGg&oe=6ACFA216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2242594613187836", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596168449_2242594616521169_2433898641251186090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5E5Vj5wdGoQ7kNvwGZ8zXZ&_nc_oc=AdqqDds3rJBPlZVsvvfjU0aRjVbcFFtJOJSY14nj659jWutkmVF-1DraYaQ2S_dDx5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9A-Tuo6alg2k_hYzcPuUaHrYIl4SKz0htlOWSmB7acA&oe=6ACFB43B"}, "display_name": "Clayground: VR Clay Sculpting", "keywords": ["art", "sculpt", "clay", "sculpting", "modeling"], "long_description": "**Sculpt clay out of thin air.** Clayground is a VR clay sculpting studio for Meta Quest, made by one independent artist. Push, pull, carve, smooth and paint volumetric clay with your hands, then take your work anywhere as a GLB or OBJ.\n\n**Sculpt like it's real clay**\n- Add, carve, pull, smooth, inflate, flatten, crease and paint, with strength control\n- Mirror and radial symmetry for faces, creatures and patterns\n- Layers you can hide, freeze, merge and change the resolution of: rough it in, then go fine\n- Lattice: bend any part with a cage of handles\n- Spline: draw a curve and get a tube, a hollow pipe, a row of stamps, or a cookie-cutter trim\n- A starter stamp library, or capture your own stamps from your sculpts\n\n**Bring it to life**\n- Frame-by-frame animation and live-recorded motion; one-press Breathe, Sway and Boil\n- Export animated GLBs\n\n**In your room or in the studio**\n- Mixed reality keeps your room in view, or sculpt in a calm virtual studio\n- Up to 90 Hz on Quest 3 and 3S when your sculpt leaves room\n\n**Take it anywhere**\n- Export GLB with colour, or OBJ, for Blender, game engines, AR and 3D printing\n- Pair with clayvr.com using a short code and grab your files over Wi-Fi, no cable\n\n**Coming from Adobe Medium?** Clayground is made for you: volumetric clay, layers, stamps and a tool wheel, standalone on Quest.\n\nFree in Early Access and updated often. Updates: clayvr.com \u00b7 Support: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay with your hands on Meta Quest, no PC needed. Layers, symmetry, lattice, splines and stamps, in VR or mixed reality. Then export GLB or OBJ for Blender, game engines and 3D printing. Free, made by an independent artist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1414996380698602"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831279_1830498371459693_7820535041324903422_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWB9HERk17YQ7kNvwFW7our&_nc_oc=AdrZMXejmqHu0Pe1CSrorF3ViFYafCXpEmjMuyjTqMZgj5ooXs6vlxRec2g8aUrP-Ms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoy8lJtAvi5
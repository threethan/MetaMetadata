&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHY5NXE_XzFal5m1oCMAVzoLFOgvCUDa-UJtXEbvU8Ow&oe=6B09C6AF"}, {"file_name": "05_robot_mint.png", "id": "3048904532108236", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312439_3048904535441569_6813222590223948974_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B44JHqLdMdIQ7kNvwGRODri&_nc_oc=Adp2w7wYfe-TTlJ0j182UGDNN80KfDYciEYowhfi_M7MSAIHSpaKiVuMofmZ7G_pJGk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuSm8P6bxwTej2twO8fC11AQph7PO90OMYqp1PGF8KvQ&oe=6B09B703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Clayground-cover-landscape-2560x1440.png", "id": "1163782489561573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604379488_1163782492894906_2199309010881884016_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REOyKV_tu2oQ7kNvwGN7R19&_nc_oc=AdoP44AqgOZY0Ie2z-KdeUoLA9md-ejolcz25HyyR2C4jlaQ0sIlTf1Kk_qVdzXtlVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyl9_DR1genHcbeUeFUHmgdtsIo10lLv_9YYPGdG2-wQ&oe=6B09A7CB"}, "display_name": "Clayground: VR 3D Sculpting & Modeling", "keywords": ["art", "sculpting", "3D", "modeling", "printing"], "long_description": "**VR 3D sculpting, standalone on Quest.** Clayground is a 3D sculpting and modeling studio for Meta Quest, made by one independent artist. Push, pull, carve, smooth and paint with your hands or controllers. No PC needed.\n\n**Sculpt with just your hands**\n- Full hand tracking: pinch to sculpt, no controllers required\n- Tap tools, size and colour on a panel within reach\n- Cast your real hands into your sculpt, flick it to spin, turn it with a wrist\n- Your real hands show in front of your work in mixed reality\n\n**A real 3D sculpting toolset**\n- Add, carve, pull, smooth, inflate, flatten, crease and paint\n- Mirror and radial symmetry for faces, creatures and patterns\n- Layers you can hide, freeze and merge\n- Lattice: bend any part with a cage of handles\n- Spline: tubes, hollow pipes, rows of stamps or cookie-cutter trims\n\n**Bring it to life**\n- Frame-by-frame animation and live-recorded motion; export animated GLBs\n\n**Show it off**\n- A camera in your hand: aim, zoom and snap your sculpt\n\n**Take it anywhere**\n- GLB with colour and per-layer materials, OBJ, or print-ready STL for Blender, game engines, AR and 3D printing\n- Pair with clayvr.com and grab your files over Wi-Fi\n\nGreat for 3D sculpting, 3D modeling, character design, creatures, figurines, 3D art, game assets, 3D printing and learning to sculpt.\n\n**Coming from Adobe Medium?** Clayground is made for you: volumetric sculpting, layers, stamps and a tool wheel, standalone on Quest.\n\nFree in Early Access and updated often. Updates: clayvr.com \u00b7 Support: Hey@emotionull.art", "short_description": "VR 3D sculpting and modeling on Meta Quest, no PC needed. Sculpt characters, creatures and 3D art with hand tracking or controllers, in VR or mixed reality. Layers, symmetry, lattice, splines and stamps: the sculpting tools you know from the desktop, standalone. Paint, pose and animate, then export GLB, OBJ or STL for Blender, game engines and 3D printing. Free in Early Access, made by an independent artist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453795970151976"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303790_1798143871473423_2235690189950295300_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6Ol4SpkPvwQ7kNvwFj8yab&_nc_oc=AdrdRFvtFKLbeZs465KkYV5O5CE-irPOQ-ttHRsxrI9HY9tMm0mtaaxE6ZFMBrOaJqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpmdPU1LxuwSMjVsNM5H3O_J07LmUqpojOgNel4mvv8w&oe=6B09C28B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clayground: VR 3D Sculpting & Modeling", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1785211200, "lastRevision": {"nodes": [{"id": "1345650644299843", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1345650624299845", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2277112393042657"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "cover_portrait_1008x1440.png", "id": "27690809490531395", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824700_27690809510531393_1331117672940615419_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcXEW0JnnvMQ7kNvwGjTlrI&_nc_oc=Adq3uO2SoceUmvQIWY99G2ct12uFIvxUBIstweRuEpgkEl7MggnxZlcQ3OgQL9ni670&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSpg34mp1okUaenrD9uBSRG8lsRQ5JFz2gQ6kCw0QlVw&oe=6B09A4CE"
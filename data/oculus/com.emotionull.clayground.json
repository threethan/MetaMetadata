e": "en_US", "screenshots": [{"file_name": "01_Sculpt_65_close.png", "id": "1444870340895811", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/753032404_1444870344229144_896054430153082543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dsn9DZTBRAQ7kNvwE4kpd1&_nc_oc=Adr_GXUvDVFBtJpMkpeou2I3OMwy5zbwt9Z61tZHyzK6smh_qNIb7cZ97yAV6j3T3rA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN10XxX0g5J0Wm9WmIMM3l-mb9T7p-sHIc1cro9JsF8Cw&oe=6AD39391"}, {"file_name": "02_Recovered_26_close.png", "id": "1885487409103644", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596168449_1885487412436977_5610991382400266068_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAKRpvj4p14Q7kNvwELXoAG&_nc_oc=Ado_aRU7Q3SG8_XblAOZPiKg8fbkBf25mUoniLRHDbness0DK5l73TCP0cOSSJ-4dXU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq-x-QGEyZXFMyu35hkZ28MFAnQNwgysvYU4iZGI9brw&oe=6AD3B9BA"}, {"file_name": "03_Sculpt_52_threequarter.png", "id": "1471296794919693", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604317775_1471296798253026_7674336084604590675_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Le7v7WTppkQ7kNvwEZ6tJY&_nc_oc=AdpJaUzQ7Wcy0bAtR97CnP8321fyoQauKxIxCM59kZI-7HigebJTNrtIa_MZb772uIM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuXWwAJ1V8bIbG5vLqO6MmEw-__Df3urX_YViwV1L1Jw&oe=6AD38CD1"}, {"file_name": "05_Sculpt_49_threequarter.png", "id": "1584548512779624", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/825629712_1584548516112957_7510180071289625948_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJhp6TMmQN8Q7kNvwGRCybF&_nc_oc=AdrqD0LjSQjyRu8Q-cOYqXr5YB0ZmeqhII5vtwvTW1riQRCpw49iy1SBQzPQA2cwfpE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZs41RTVpxvh6g-uVGR2VeRzUDOHoHtwHT42ISlo4mMg&oe=6AD3AAF6"}, {"file_name": "04_Recovered_18_threequarter.png", "id": "2575920092856608", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491830822_2575920096189941_7716118497146851655_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsEMzHgy9N8Q7kNvwFSacEd&_nc_oc=AdoiDQIIXZRnREFN-ZvqjoYLRpao3BR60XmxhFhosaj_r9iaBG7N6x8Y4o15AQURx0Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdJVK9fW0bxWWCZB4R4enrnprTWEhGOeiLObF1XC7GDg&oe=6AD39696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "2242594613187836", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/596168449_2242594616521169_2433898641251186090_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Jffz8w27v4Q7kNvwF7ZaAc&_nc_oc=Ado4u_0K9PgqrzIxBG8VXDuZQDKfv6yRmpgnOF01yzNREIha9gqPT0SwbVTipgS5N2E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwVgVXTwOLcQ9ufK8dwnfFW6sLFOvAZLk2h6T09OF6Tg&oe=6AD3A8BB"}, "display_name": "Clayground: VR Clay Sculpting", "keywords": ["art", "sculpt", "clay", "sculpting", "modeling"], "long_description": "**Sculpt clay out of thin air.** Clayground is a VR clay sculpting studio for Meta Quest, made by one independent artist. Push, pull, carve, smooth and paint volumetric clay with your hands, then take your work anywhere as a GLB or OBJ.\n\n**Sculpt like it's real clay**\n- Add, carve, pull, smooth, inflate, flatten, crease and paint, with strength control\n- Mirror and radial symmetry for faces, creatures and patterns\n- Layers you can hide, freeze, merge and change the resolution of: rough it in, then go fine\n- Lattice: bend any part with a cage of handles\n- Spline: draw a curve and get a tube, a hollow pipe, a row of stamps, or a cookie-cutter trim\n- A starter stamp library, or capture your own stamps from your sculpts\n\n**Bring it to life**\n- Frame-by-frame animation and live-recorded motion; one-press Breathe, Sway and Boil\n- Export animated GLBs\n\n**In your room or in the studio**\n- Mixed reality keeps your room in view, or sculpt in a calm virtual studio\n- Up to 90 Hz on Quest 3 and 3S when your sculpt leaves room\n\n**Take it anywhere**\n- Export GLB with colour, or OBJ, for Blender, game engines, AR and 3D printing\n- Pair with clayvr.com using a short code and grab your files over Wi-Fi, no cable\n\n**Coming from Adobe Medium?** Clayground is made for you: volumetric clay, layers, stamps and a tool wheel, standalone on Quest.\n\nFree in Early Access and updated often. Updates: clayvr.com \u00b7 Support: Hey@emotionull.art", "short_description": "Sculpt, paint and animate clay with your hands on Meta Quest, no PC needed. Layers, symmetry, lattice, splines and stamps, in VR or mixed reality. Then export GLB or OBJ for Blender, game engines and 3D printing. Free, made by an independent artist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://clayvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Emotionull", "support_website_url": null, "website_url": "https://clayvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1414996380698602"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831279_1830498371459693_7820535041324903422_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iaHcsmdGa8Q7kNvwHTyZIs&_nc_oc=AdoHGU9rXFmeiME9MoZJj_S2Ye2bc0QSgK7v17KBVWXBzyz58rR95ynB-bIOjiD7Uec&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgteSRFQrfS
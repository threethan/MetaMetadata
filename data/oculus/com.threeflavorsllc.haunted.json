-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHqlgtx7Z5fNMI4913Jgnz2688wWAQqHyDV45SmfKEDw&oe=6AFDC88F"}, {"file_name": "09_blood_room.png", "id": "1442871101382043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_1442871104715376_491390462557555573_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9Cw6_pV5RkQ7kNvwFh04Hs&_nc_oc=Adojn67_goh_43nB9PIXo9a9dLMnMhXmbf5sROjkM-VIbPZG4Cbg7hB-7gWz-PXQvX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiQDNX1kPh_-gVhbpkq8LPVEhFLZHOT8zYaBip8uG8gg&oe=6AFDAD76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "haunted_are_you_alone_cover_image.png", "id": "1143054548053390", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1143054554720056_523297141158019707_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eraXfkTwjhkQ7kNvwGjt1nK&_nc_oc=AdrqnE1bqt0Sn4LQjA8KzubMMSVDokN_xnWyLoOJmgH3XCb1rRKHEVNLcSBqSHCfR-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMnEf2RqmntRDmAWg5gAsdVf9E87z-LoEUk0aKR8FQDQ&oe=6AFDE06F"}, "display_name": "HAUNTED: Are You Alone?", "keywords": [], "long_description": "# YOUR ROOM IS THE NIGHTMARE.\n\nHaunted: Are You Alone? is a **mixed reality horror game for Meta Quest** where the nightmare doesn't happen in a haunted house. It happens inside yours.\n\nSurvive **8 terrifying chapters**, each turning your real room into a different nightmare.\n{2537211650037818}\nWatch enormous arms smash through your walls and slice them apart with an axe or sword. Explosive skulls crawl from the floor. Shoot them or freeze them with your flashlight. If it breaks, shake it back to life.\n\nEnter a graveyard and fight the dead with pistols, shotguns and an AK-47.\n\nAnd that's only the beginning.\n\nYour room slowly fills with blood. Deadly drills follow your eyes and strike if you're too slow. Follow an innocent puppy into a claustrophobic cave. Dance with a cursed doll... until it decides the dance is over.\n\nFace the **Cursed Nun**, survive the **Teleporting Witch** and discover what else is hiding inside your home.\n{4468766313439193}\n\n## UPGRADE. EXPLORE. DISCOVER.\n\nUpgrade your weapons in the shop and search for hidden secrets.\n\nTry drawing a **circle with a dot in the middle** on the shop floor. Something might happen.\n{2906818666341478}\n\nOther strange symbols can unlock **2 secret chapters**.\n\n- 8 chapters + 2 secret chapters\n- 3 additional game modes\n- Upgradable weapons\n- Hand tracking & controllers\n- Spatial audio & intense jump scares\n- Mixed reality horror in your real room\n\n**Put on your headset. Look around. Are you alone?**\n\n{1894272395280348}\n\n{2571094210020846}", "short_description": "Your home has been haunted. Haunted: Are You Alone? is a terrifying mixed reality horror experience that brings the nightmare into your real room. Walls break open, blood rises around you and cursed creatures appear where you feel safest. Survive 8 horrifying story chapters, uncover 2 secret chapters, upgrade your weapons and keep the nightmare going across 3 extra game modes. Every chapter brings a new fear. Are you sure you're alone?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://three-flavors.com/haunted/privacy", "developer_terms_of_service_url": "https://three-flavors.com/haunted/terms", "publisher_name": "ThreeFlavors LLC", "support_website_url": "https://three-flavors.com/haunted/support", "website_url": "https://three-flavors.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "rec
 null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_Anatomy_icon_2560x1440.png", "id": "816247259438010", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001702_816247262771343_7938637194561121858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-qf4hzKWt4Q7kNvwEVrI3s&_nc_oc=AdmiimU4WI4t_8hcgRiZjE-4srxhfqeqowBWiz8WSUq1s12wlTl1KsuagfFihvau7EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu7l--D7p0zZddyW6T6Z1abiu4yjKEtV6wUej-HJpMMrQ&oe=6999AC93"}, "display_name": "Animal Anatomy Explorer", "keywords": [], "long_description": "Animal Anatomy is a standalone experience that allows players to learn about animal anatomy through open exploration of an anatomically accurate, multi-layered digital replica of animals. In this initial release, two mammals will be included, a dog and a bison/buffalo.\n\nThe experience also features an interactive quiz, which assesses the player\u2019s knowledge of the anatomy of said animal. Players are given feedback on the quiz in real-time and can learn through repetition as the questions in the quiz randomize each time it is taken. ", "short_description": "Animal Anatomy is a standalone experience that allows players to learn about animal anatomy through open exploration of an anatomically accurate, multi-layered digital replica of animals. In this initial release, two mammals will be included, a dog and a bison/buffalo."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area"
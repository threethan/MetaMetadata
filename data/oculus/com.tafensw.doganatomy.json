2h6V8p_-qVdnx8C95yvQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6AGP-gi1KqancJNzCzflL0DVS5mwn_BFhqLSThNE2Rg&oe=6A8EDEE5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta&TAFE_Anatomy_icon_2560x1440.png", "id": "816247259438010", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001702_816247262771343_7938637194561121858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31hHEqTbjnEQ7kNvwE5OOco&_nc_oc=AdqiZmUo3YJYQoCMzXCeSMYekR4MNVmDQ6q1M_HxkEdqckps-61nzG8xGWzWZL02_Gc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKOAVgb2OyYlzrMsei7ArfDQXeu1x4l_Jx46naJGqqJg&oe=6A8EE393"}, "display_name": "Animal Anatomy Explorer", "keywords": [], "long_description": "Animal Anatomy is a standalone experience that allows players to learn about animal anatomy through open exploration of an anatomically accurate, multi-layered digital replica of animals. In this initial release, two mammals will be included, a dog and a bison/buffalo.\n\nThe experience also features an interactive quiz, which assesses the player\u2019s knowledge of the anatomy of said animal. Players are given feedback on the quiz in real-time and can learn through repetition as the questions in the quiz randomize each time it is taken. ", "short_description": "Animal Anatomy is a standalone experience that allows players to learn about animal anatomy through open exploration of an anatomically accurate, multi-layered digital replica of animals. In this initial release, two mammals will be included, a dog and a bison/buffalo."}]}, "developer_name": "TAFE NSW", "developer_privacy_policy_url": "https://www.tafensw.edu.au/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAFE NSW", "support_website_url": null, "website_url": "https://www.tafensw.edu.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topic
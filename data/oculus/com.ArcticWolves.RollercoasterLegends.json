ttps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75443247_1344010373442970_643687665859939817_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3b4xkdPn6MQ7kNvwFjnx2F&_nc_oc=AdrtcuuOBs02n_-b28_F3cWu4fXnhcgyfk2w-acOjfbeAr_j4PZKQ0OGo0U2VEldqSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hRnM2bKYjqUHXU7t-TGSRaSzXUmYZT1q9tmR8Pl2bZg&oe=6A2FF40D"}, "display_name": "ROLLERCOASTERS", "keywords": ["rollercoaster", "fantasy", "bestselling", "roller", "coaster"], "long_description": "The BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on a rollercoaster journey like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n\nRollerCoasters Hades Wrath is a mythology based rollercoaster featuring icons from Greek mythology, including the Minotaur, Kronos, Charon, and Hades. Enjoy the thrills of a gigantic rollercoaster.\n\nA non-stop adventure, ROLLERCOASTERS Hades' Wrath delivers an unbelievable experience you will never forget. \n\n", "short_description": "Rollercoasters Hades' Wrath. \nThe BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on multiple rollercoaster journeys like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Arctic Wolves Games", "support_website_url": null, "website_url": "https://www.arcticwolvesgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "26918
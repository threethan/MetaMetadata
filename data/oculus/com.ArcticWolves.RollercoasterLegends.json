56O8IL3wkC459F39gPYxBoLud5Bds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMBRXO-53mjKDYu4dNYyZULyVTNVM8LGm7BKbMmTX35w&oe=6AFC7A06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rollercoaster_HadesWrath_Cover_Landscape_01 (1).png", "id": "1344010370109637", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75443247_1344010373442970_643687665859939817_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRNICVtsUg0Q7kNvwE9ZWn-&_nc_oc=AdpzgysgcQEm3i5dQtBbl-wQItaDg_1BZHbgADh07usVzmyL9fcTcRZXULa0Ojpi7hA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgCCq1N3Xfw3_7Qgr4nsh9PgZLiNJEw0Vmx0tA0oyB9Q&oe=6AFC84CD"}, "display_name": "ROLLERCOASTERS", "keywords": ["rollercoaster", "fantasy", "bestselling", "roller", "coaster"], "long_description": "The BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on a rollercoaster journey like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n\nRollerCoasters Hades Wrath is a mythology based rollercoaster featuring icons from Greek mythology, including the Minotaur, Kronos, Charon, and Hades. Enjoy the thrills of a gigantic rollercoaster.\n\nA non-stop adventure, ROLLERCOASTERS Hades' Wrath delivers an unbelievable experience you will never forget. \n\n", "short_description": "Rollercoasters Hades' Wrath. \nThe BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on multiple rollercoaster journeys like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_ter
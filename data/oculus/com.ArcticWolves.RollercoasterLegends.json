JFgLAsrUvMJJ6b4fjHF_h06BLN0e2Gp4JoyAMTZV0XVUHuXo5F0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_jVckpikVqR4KiXh-6_-BRKfd35r0v0rqP491tAXRqg&oe=69B94D0D"}, "display_name": "ROLLERCOASTER, Hades' Wrath", "keywords": ["rollercoaster", "fantasy", "greekmythology", "kidfriendly", "bestselling"], "long_description": "The BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on a rollercoaster journey like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n\nRollerCoaster Legends is a mythology based rollercoaster featuring icons from Greek mythology, including the Minotaur, Kronos, Charon, and Hades. Enjoy the thrills of a gigantic rollercoaster.\n\nA non-stop adventure, ROLLERCOASTER Hades' Wrath delivers an unbelievable experience you will never forget. \n\n", "short_description": "The BEST SELLING rollercoaster is here! Transport yourself to the land of Greek mythology on a rollercoaster ride you\u2019ll never forget.\n\nSpeed off on a rollercoaster journey like no other. Visit the Temple of Poseidon, the River Styx, Tartarus, and the Palace of Hades, by zipping up and down daring drops and twists.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arcticwolvesgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Arctic Wolves Games", "support_website_url": null, "website_url": "https://www.arcticwolvesgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEM
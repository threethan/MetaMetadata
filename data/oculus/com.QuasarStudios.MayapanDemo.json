=6A43C83C"}, {"file_name": "2021-11-01-22-55-52.png", "id": "235890266148896", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003251_235890276148895_1273546853283943322_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHunKIK49HMQ7kNvwG5U0bb&_nc_oc=AdoS8pweBnvzqAEQL8YBXcfhADe4X8hzk4mk_HebL_Z1qhuNRTruegIKPJULeiJewf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JOrIU-Ckx2IlVGwhMDLla0AX-JQxfKz306RpTWW1mYg&oe=6A43CCDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "1481300932666968", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615256_1481300939333634_3221219124994484117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=schtjPaMW-4Q7kNvwHSJThT&_nc_oc=AdpOKj2Ys5LFrMJrjWtSBrMAE1t78B-1Lpt20JFFT0dx1GBVr499a7z0V3yXJq5lI4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NjngYLANROT7qSPmPIUKqtW7VR9g9rD5NA_Lv2xFpPQ&oe=6A43E042"}, "display_name": "Mayapan Demo", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonuses are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your family. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nThis is a Demo version with 3 Campaign levels and unlimited Survival play!\n\nMayapan awaits you!", "short_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Match colors and make use of special bonuses. Feeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! Compete with other Oculus players in the general leade
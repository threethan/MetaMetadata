173_4759937995037333809_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXTsBgfnZSQQ7kNvwF4RuDg&_nc_oc=AdrceXp1JSpOWiYfaVZeIB1CKtOnOnaw_nfUP2uATdSLwlcFIszwz1x1SylAcAbh1VU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ09pHuG-dWOLaQ6WGmcH3yXZ7G05r3i30mo4KxqfJwA&oe=6AFB40FC"}, {"file_name": "2021-11-01-22-55-52.png", "id": "235890266148896", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003251_235890276148895_1273546853283943322_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkkvnna_h3QQ7kNvwGsqUNE&_nc_oc=Adoutc_ZR9G5OHCliRD2tWIOP4L2vcfnVlix3zK2sTwohgKXLI2zqWbhRCaABoX4SQc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2FX-zIu59GhbZYn9a51BH1BKoACzQNHqsQBsBHS2sLg&oe=6AFB459E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "1481300932666968", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86615256_1481300939333634_3221219124994484117_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z8jlhsXlx4Q7kNvwFhUZdQ&_nc_oc=Adpviz5wsXj9PsjjognAQbz_OLEpYFpekhzhKz4F6Qi3VCsuV6UpdGN2kuccjRi2fuo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1n3cEweCg1KId9qZcrf-JP15N3JHD07j5TcqtiOpspw&oe=6AFB20C2"}, "display_name": "Mayapan Demo", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonuses are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your family. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nThis is a Demo version with 3 Campaign levels and unlimited Survival play!\n\nMayapan awaits you!", "short_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Match colors and make use of special bonuses. Feeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! Compete with other Oculus players in the general leaderboard! Be the best! This is a Demo version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://quasarstudios.net/privacypolicy/vr-privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Quasar", "support_website_url": null, "website_url": "http://www.quasarstudios.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6558395304209692"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "547195151638845"}, {"status": "PUBLISHED", "id": "308142098508179"}]}, "baseline_offer": {"id": "547195151638845"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734297600, "status": "PUBLISHED", "id": "547195151638845"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6581707401878482", "version": "1.25"}, "id": "344185098280628", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
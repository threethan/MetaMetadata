=6AF5C2BC"}, {"file_name": "2021-11-01-22-55-52.png", "id": "235890266148896", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003251_235890276148895_1273546853283943322_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnUw17V1510Q7kNvwGELrph&_nc_oc=AdrjURtFzH1hHwpobGbUx_0DIq8hPrPHyarPxuRR9hTxSbB-Bf93LzyMDPYPf0UDsmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQySuGmvinZs_D59sNMnuPSLe1yhKFcLBwKFnAorEvOpw&oe=6AF5C75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_demo.png", "id": "1481300932666968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86615256_1481300939333634_3221219124994484117_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxgAEqEbLNkQ7kNvwGeNLLa&_nc_oc=AdoUBZM77k36s4vvjj5BbAWJO678UiQ1dwf-SNY90g_xV398S9cHoF5NC7ehWmEHqOs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToR2cqawAK--CoUSEmFCAjtJBjQ7Kiba5WMhKiPhWqOw&oe=6AF5DAC2"}, "display_name": "Mayapan Demo", "keywords": [], "long_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Use two crossbows and clear your way all over to the top. Match colors and make use of special bonuses. Beware, some bonuses are good, others are not! Also, keep track of flying bonuses, those are the special ones.\n\nFeeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! \n\nHave local scores for you and your family. Also compete with other Oculus players in the general leaderboard! Be the best!\n\nThis is a Demo version with 3 Campaign levels and unlimited Survival play!\n\nMayapan awaits you!", "short_description": "Conquer the great pyramid of Mayapan by showing your point and shoot skills. Match colors and make use of special bonuses. Feeling good? Try the Survival chamber, at the pyramid's lower level. Resist as long as you can.. or taste the heated lava! Compete with other Oculus players in the general leade
98304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4DhqIlxOMMQ7kNvwFefYfI&_nc_oc=AdoPzGQyUCIdskVzy0_wT8BzSIGPdlTAZX5J6BvvUjBIglRi0pNZrcmnkoKeZ0I_7Xo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqpELtcNP8JU0-LB4ChG06Itqy7b6-rWT34yrq5A7VOw&oe=6AA95BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8vYY8E", "id": "431285334159222", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031601_431285337492555_9085623772723019776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYXhirpF-GUQ7kNvwEg2yD4&_nc_oc=Adpvxo0ben0QUG9zpiCqKL20YyYPTCPas7IJWhD35aoqOjWyDa77XwI_RLYYANaK6WI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbHMtYd9VA8BHoCyHrcI8leXFkvlK7-rF-O3kVQCqebg&oe=6AA93EF5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfand
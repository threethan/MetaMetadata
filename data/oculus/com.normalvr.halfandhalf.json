gXa3kKEgAhAKWiakSFwToX6LVS8t4mFwd_IWN83urCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoE0PgaKlLqanpJwTSarxHW8Japk5-h3mN1Vguw_yx6w&oe=69BC0DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8vYY8E", "id": "431285334159222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031601_431285337492555_9085623772723019776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QQTFRO-UMAQ7kNvwHWrB4D&_nc_oc=AdnJQAoJffIOstRRCzxYEARcsV_bCdtYUohn6O8EXtmgLF8xKdzQUOs3Izljui-qoAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJMh6wZU6PBFIV7iinGDSzh0MLJoU6qE3N-cCoBkFOEA&oe=69BBF0F5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"i
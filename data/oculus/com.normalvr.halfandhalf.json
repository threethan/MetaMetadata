grated_image.png", "id": "343812909896029", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5kAkq54LGsQ7kNvwH_hc8s&_nc_oc=AdrwlXNd5jcjXWC-opaJbfM67YdkybUrZEdQulL5W1Sqajebq26dAm8jSMiwUsgmKNg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVvY4v7ForvOdnzobUdMVmgVGv09HxKUJIM4gumP05tw&oe=6AFC7557"}, {"file_name": "migrated_image.png", "id": "236949450792672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMmjDN3bsE8Q7kNvwGIHZAA&_nc_oc=AdrAf_rs1ZdD5q4IJeiCk2D2kWl7xAHJ3QWjbbPd_s0fp4dTZgENE7DlP9vnlryi_dM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbk730C7MIOwGYNTJboDpNDsjnwXHDx2lFfNFtw1g5Ug&oe=6AFC6A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8vYY8E", "id": "431285334159222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031601_431285337492555_9085623772723019776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWL1Eb6-ddAQ7kNvwFXJAF8&_nc_oc=AdqeugIWLbkEvZiWg2Xsj5j1BJwG1Y5vrfLueLu3M5xuHUwv9dDP4X8dobL2ZM0sWE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfas5BckbnmgB88LpzeSXCBHDBKv9GUtsMxjn258fc5A&oe=6AFC85B5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1244333839428685"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "CANCELLED", "id": "837319606685929"}, {"status": "PUBLISHED", "id": "2536730849718970"}, {"status": "CANCELLED", "id": "973979182985992"}, {"status": "CANCELLED", "id": "441209683264249"}, {"status": "PUBLISHED", "id": "2431637650486904"}, {"status": "PUBLISHED", "id": "449697965687031"}]}, "baseline_offer": {"id": "2431637650486904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "CANCELLED", "id": "837319606685929"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
dn.com&_nc_ss=8&oh=00_AfziKs4bXbmD-NrQYVweDmkO1l16hc_jtP2G-coSoltwCw&oe=69B93689"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgoCMQQNnkUQ7kNvwHh2Qf3&_nc_oc=AdmOo-y8x3KklwhqXg6Zy_hMe6Dict9oHKLXEf-j1CQyPhE096V4WsWjKkBm7o8O2uE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEg3aiXD8bVCE7nSHW9WV2xW4YRpGmDNcE2wzPhtyzQw&oe=69B9612B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whz-ah9VrgMQ7kNvwFl32DB&_nc_oc=AdnOZ3N0nMogvEW9j4CSX2kqpojl3sSqiV-Ab9QXbs7QzQne6O0jqJewqhsZ5uzYmXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzfH0VJEqCeiaqPX9KGAv1za5TkmxPS4IGPcWR-vAX4w&oe=69B93D97"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SLvHLysiecQ7kNvwEfsQmO&_nc_oc=AdkMrmL8pece7jMfzQFj8DUdhSDEhF1fPBKUjANGk92JhPsHzaSfrBbpArzX3BT9anI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw69t2QxWSh6RnmJBlX-nuCqtAfYQHofcxIJ69MYyx7Ag&oe=69B93262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdBdXZrTU7EQ7kNvwE4rF7q&_nc_oc=Adn8tldFeCYBZQ7vIimJkvE8CJQsT0VKN_ZI9XguubkqoM8EABrcFps5suOQbCIIB3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1i-_PT8_u5gSOjOh3RQuGoPzShsDMOZo6PzlNU5xZYw&oe=69B95891"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
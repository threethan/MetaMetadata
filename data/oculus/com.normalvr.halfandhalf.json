984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61tiG73G_qUQ7kNvwEczhnQ&_nc_oc=Adkw5atpy3HI-KSBkha6sRl8uCEg6nGGI6LB0fKcGxwvdppt-Awcc1kQ-qnLF26JjZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvB9orNdyM5isty0oTqg3HMUvGc9Eal1XduLgxCoC-xow&oe=6999BD2B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEgMEHp32GQQ7kNvwF9s3Ng&_nc_oc=AdmK2ccC_gd_Pc0pdB35jKI7Ju2TYLTOVBK3kqCbTP9UMAmVXxTlfk8Vu34cKAN7rl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfshnHwhbSEG5mIvCBZtRxVb7w3epX6bfGupVBVzv_m_eg&oe=69999997"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG0YhkqNBVMQ7kNvwFMR_da&_nc_oc=AdmkWISZxitRJJO1bst_smlJvtYPRRTzKxkBdm6GdOijXG6RsWgxc4P30ZgPhgFws-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZXjyRbVwBzWni5jqraSX3Z4_61N9FoZzzMlNQwDur_g&oe=69998E62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multipla
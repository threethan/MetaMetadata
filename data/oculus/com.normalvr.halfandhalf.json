dn.com&_nc_ss=8&oh=00_AfxDg6iLvJFoNDOYFEt9NlDvaaIHIp6SacswxrR_y3L0JQ&oe=69C11F89"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw_8cXgo__UQ7kNvwEImiiL&_nc_oc=Ado0fppVsGq9nQNWl2mXgOeemD2I3S33b76AfoIVq5x7P4qbB3gdfYp0P1uhWtAWf2g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6HZUgRcREIUcEp2OGvp7teClqiuzWG8BawW9_rgwHnQ&oe=69C14A2B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_wDl2pUL3cQ7kNvwEy6aZ4&_nc_oc=Adp0qFsg74RmiOSCvmrxYYAHOogVfQ0iU9pqcWrtR1IS22drwoA2Xcbnuh0SPNFYf3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzU_6_9FasCd6u0zbHj5p2fPfZMoQjoMCO0eO1UsWRx6A&oe=69C12697"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3roIdkksWMQ7kNvwHUINWV&_nc_oc=AdqNLXw1hDSzq4tuswbjKmtRlaGjoIYHW27coaqdgVWa1POmLCNN2tuDXEpCm3n_EBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCPwJycjDgWK_37brA7vywM7q9Rlt1KIOM8f3Y9j4lsg&oe=69C11B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8I7bx8QUPzQQ7kNvwE7hcwB&_nc_oc=AdrWkQygSgsTxzUe6UDhA2o9nwZdU-j__CvY2t_61yxerKVSwXuE-tpjh7uit97fdkc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaAJCtLhr7-2-ShwfsFfK9cIefVp1HCToySH0fbgZeLQ&oe=69C14191"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
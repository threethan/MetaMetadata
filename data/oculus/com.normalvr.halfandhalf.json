984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNVO9tbe9zUQ7kNvwFzoYZn&_nc_oc=Adm6_xovARZtjsaTgyeiAlXI5Av6oyfSp61rhi5TfvOzMmcQvGfnJCNb4WI-FiOCMfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9YMCs3y9S0fYPbwLNOY-0L531cEY1b93HDaPjuj3NOw&oe=69A054AB"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttl04D4qdWUQ7kNvwFobEVx&_nc_oc=AdlotPA69CE8UuXMHqg6ndBAYEZGI5AZowMzyJbsvaxvRnpJPDELjzCFeDOoizE-Okc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumikpIFT6yWA9JZZa6v75CvcMgZpn0A4FDiOGCfqFgcA&oe=69A03117"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXnSxGj-KukQ7kNvwFyP7Mv&_nc_oc=AdlaaPaz-UlNysDChdJmEEmvLud0bWnO1aQSIJJzHttUJvDZMXs7UJe_siCiMLjhA6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3pt-7QacEgD0rZJGbJ6hcjZjYvLyRUy28MaSW4ylRPQ&oe=69A025E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multipla
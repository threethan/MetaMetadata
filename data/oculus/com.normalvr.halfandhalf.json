dn.com&_nc_ss=8&oh=00_Afw0UjawjYoyRj-QGYf6gzJobOiWTPQmaFvrvo6_4HUN3A&oe=69B7E509"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zszy40ZepX0Q7kNvwHBXzUB&_nc_oc=Adk8Fh22wzNFgKFI77ajOyjY3shJ45xJONO711VrtjLarXQFxk8E8P3Jv7Rjs2-t_cs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHIP9yqWadfItVTluISyt7QpmcSNQ0rsHk0Y4l0Z_T0Q&oe=69B80FAB"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Whz-ah9VrgMQ7kNvwGiT5Ke&_nc_oc=Adk1Xnvpoor7t_aqFw_JMoF916xb84z6Nq94J-NCoW8HylyEmx0jnNcW4eR-auYgTl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRrwD84LU9utjOup2UWD_lacM40xZ1hpsnGXoiymnf3Q&oe=69B7EC17"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SLvHLysiecQ7kNvwEMwUWq&_nc_oc=Adk8t6tUFPqNQd-Me7LAtN6v3Zj_bvJ9aE2aSMgQiKyeN3jmnXnTxjTSedZIcqbdf54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydMn_DFpviz-M0wXASMWPX2ogDbG8AJm91UZoDpq0Vqg&oe=69B7E0E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdBdXZrTU7EQ7kNvwEHa5Xy&_nc_oc=AdnaRxEo_GSryAWkMVoSwYe-xUL3kUe8QfRqYZ-BghTXiW47VRmrlXG8cRbu4ykftYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBbqHUppUJwf437ME6iD-Nx0lOU39rx-NezmWrLONQ6w&oe=69B80711"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
dn.com&_nc_ss=8&oh=00_AfwVxMUmqKqezZlnpldriuWO24fbpv36yCa9gMaa7U0UBQ&oe=69BD2B09"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN4UPBg0jDEQ7kNvwHJdduM&_nc_oc=Adm8DIq03hj9OLWolm-i42zoAft55agSOEsFQmya2MH2uQ-bNnvQ_aM9dmCXUjWNVNc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYtOqh1AAEGGZnSHeoh4scILN-sYbqvSGtmWEkilaTig&oe=69BD55AB"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsJgQ-dCIxQQ7kNvwEyv9gi&_nc_oc=AdluRy_EIHFBmKXxMJl2wa-jX8EsEL2Fumoxy_8YUHCikhjGViAG_PIc1pcRURH4tpA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7maOFETWUTu3rl5shL4ASpXfLr9YOH5M_yKQnqmKF-A&oe=69BD3217"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DLJ_kEbDYcQ7kNvwEThDSK&_nc_oc=AdkOldmylUFM3CMxulzXj4G3lagovS1ElDFzzKL8bMtE6_Zlt9Vo-z_g9emo41ZKQPw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQC8Yk_D_7BARUrjNhUY0jBEwFtnEM-7ro8ES9CSutRw&oe=69BD26E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uW_KACTIl00Q7kNvwFW7xLR&_nc_oc=AdmO2ytOGcOLSuaBWg8VL05VEbcfuX49j8R3kxuD8xrJ52as7PzUC6NAaF2C7PoHwJc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhMZhb2Ijfwob5gW2RV4mjlLylC2WAGq6-06pfADpDpw&oe=69BD4D11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
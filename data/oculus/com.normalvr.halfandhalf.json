92555_9085623772723019776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf2qqNu90xUQ7kNvwG3ZtfD&_nc_oc=Adl6-wogBLg287Km3hX_hLiHtyrmvV5VowcyDlCkgoRj1_pEGGtC2Q9nOr_Ef7abo-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs8LC5MI76I_d8ObO2UbZ-XFn_PqDMuH6DZ_RExR5Yb9Q&oe=699AFB75"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61tiG73G_qUQ7kNvwG2N6ea&_nc_oc=Adnh18diBfTdh9m0rfNFiezOCa9eL6nXOmH8OarD36TICE1F2UR8vL5ayT_gLbHP184&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsM6v7nq3q6L1-PG9JKCem9d7b1iQ7d9rBc6hoMYnrVvg&oe=699C602B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHupsUXH6UEQ7kNvwFyxtSn&_nc_oc=Adlik9lqWNVuBoasDliv-c_hzfVyIc7WBtyIINhM4u00SLO-2Fhy_L1K_qdIGz1Ai_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfugaHMgQsEFD22YkuWGehGWlSYM00p625fRPVEcfppPaw&oe=699C3C97"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6STnBy6UkgQ7kNvwHgmxZ2&_nc_oc=AdleBZxMiF1tcgrLdDNBtzswuympwiuIdLEqgyiV3KnEsnE87b8kuGOK1asKKwRfutA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftNoJ4VVH390oFlslE3v4lpCsLsgA_OJI3AHv71BO0GLQ&oe=699C3162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbnI2Bi-8IUQ7kNvwF0Gid-&_nc_oc=AdlZPgLg4WzlBnlGc6HvUFSTrLBULVHLECD3sd6LEYWl9axo9_KEMlpZ583hVxExsTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuYZkS2ikh_HnOuD8WOGVwN4WKwBVVGEimIlsnJ3lIYMw&oe=699C5791"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1568307600, "lastRevision": {"nodes": [{"id": "716891282004439", "release_type": "MANAGE
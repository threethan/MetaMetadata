dn.com&_nc_ss=8&oh=00_AfyL5fTjap78wKwi4Vc18Y1e9wkoaML2Z_0b0ZbL-T1K-Q&oe=69B69389"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zszy40ZepX0Q7kNvwG4i60l&_nc_oc=AdkTZPJTA74uxzue09aW4XAtM0SqoZ4IlSzwtBlB4y-PzKh1n3Ay3KCndrjGadsvezI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7QXEIEIyCUcSGG_JsdSB7y3rIQRORfFJceb8sF2PVYQ&oe=69B6BE2B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruJukHeFqxUQ7kNvwE4LTTH&_nc_oc=Adklb7PgPd9s30Sy9bSOSOIObnP__KbfvEb9YHevhRS8PstYbM4qDOJlrKTYExF6xeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIDLNkeNgVvZkO6JooaXgD1X_3UdAwMau13CvaaDP3wg&oe=69B69A97"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePWZ3XZBI3gQ7kNvwGo2q41&_nc_oc=AdnMBKInclyCZIRgaCqFAMib4k5X95sK9fHJMJHhtq1BBr4qYX5Ek4FqpkgluUoGv9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH1QEaytMEyow1NgsFZLNEQAJuiPbKnxz6u-aQbiSeGQ&oe=69B68F62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J48C_AoUazwQ7kNvwEk-eDx&_nc_oc=AdnJrjraig-TmS75AUBwqrQBwMrTXYZl8tDGTiMzs3nTL5FS8E9q3_QK64Y5vZ-foWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzrctG1h3qmfCQOVAK3x9xPYZstvjfreF9sD_37XeSCDQ&oe=69B6B591"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
92555_9085623772723019776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLWK2KUm1Q4Q7kNvwEyhmzq&_nc_oc=AdlAZuJmgrql8vtG5PrHd0JN-0SJ21RiV8a3DztNqMStAVnMyXsEHKBEmZjpKnmIeg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu5xMYNQTTBwjk_Zqwv0CZiArNney0f0p3J4t2Nm8JQEA&oe=699C4CF5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
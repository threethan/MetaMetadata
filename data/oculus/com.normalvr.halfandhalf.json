c_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1ucYNdq418Q7kNvwGjQ4yj&_nc_oc=Adrtee2EPVH0X1sYxnnt5wUy5UivjJWfz1LAPusv5iNow9_MJrjipPW9_twr4JvAlSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-H1Qe9_Ww9-mzFjEQ0tC_JOtJqmQ9m7YmWXwQ5sEhtA&oe=69EB83A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8vYY8E", "id": "431285334159222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031601_431285337492555_9085623772723019776_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhM8MKpr3tIQ7kNvwHT8oKK&_nc_oc=AdrcgOWXNAZFhkBP0Luk6uztQ2W4Bd_zLxME_ScdPlLbiuP9bCubbmYdRkO-hDuhG-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D2waN0xnixQBOI2ZkWjnL-HwG3nVzl5bCkhgyunMUTQ&oe=69EB66F5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "c
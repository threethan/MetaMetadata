dn.com&_nc_ss=8&oh=00_AfxYE1BFJB9KDM1b9TDWMO0TUkrBvmlDcVLSrx-xrA2vQw&oe=69B3F089"}, {"file_name": "migrated_image.png", "id": "674201459993114", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9568LaU6LvgQ7kNvwHUulcz&_nc_oc=AdlmtW64w9pzMCqjV3xJx6d_POez125-rC8q2RMAq7HD_3D0hjynfV-Gkq2C81fMuns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwLLbcXHjuGq-p_9dS7ef6AMJJihKXz-8w8O4jog3Drnw&oe=69B41B2B"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruJukHeFqxUQ7kNvwGp5tiB&_nc_oc=AdksDwNcC2Xmwe6T-ixmRbzTRfeJliXOTj7q2HyHnmOu-jy59z564sNU2ehXmbe2RCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEDGI3zvVw3ajmKBTRTRI13AB1QJ2rm0shLz0mvT7HBw&oe=69B3F797"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePWZ3XZBI3gQ7kNvwEAorwM&_nc_oc=AdmE5HmjPsDqG3qSdVdX6Ad0BFsvobaLX8XzwIx9qSZ_wPL4-yum6k6BR7-2D3ucHaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWqqns2w9LovSs7gMXQK-J1nh3OxopgwB61GEIGAs39A&oe=69B3EC62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J48C_AoUazwQ7kNvwGJ5kcm&_nc_oc=Adke7kAOSy6u5hCgHZvr0LBrzT4G15RelEkAAKNMpbb_YsEPmiu7XkZxrWKnSuT9_9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP--MBJTpztcVE1lfHf_HiWhm3PCS20xCgG5HJpIyF5Q&oe=69B41291"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_ca
984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_AG6sNsgGGgQ7kNvwHycrGH&_nc_oc=AdlaCwRIec7siMxOrlIyKl2M1GspHgWIVipJFnTpPmypMNkzUX-WgJF0CyK5tlPYrGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvXZjUkydIR0pAIMs9d4N9SXQDJXiw-AZuGXAQjGYNgdg&oe=69986BAB"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEgMEHp32GQQ7kNvwH7ZgIu&_nc_oc=Adlmv9Dbn2gR3nCSg1V7O0qsqPmK1OB7T13SPE97ffRInMnIxI8n_Px7gbB-VxpNh4s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsmOVSGWY5v8_K8Tku587dYvmfgJKCqvN-N027ntlCFog&oe=69984817"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG0YhkqNBVMQ7kNvwEGTKiG&_nc_oc=AdmZNC-ZYmxzJwQ_5MUoTPdGebkrdYA-8i26EgFdHjz3nYz4-3QfkUioHIjryt6Hhug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsnXWjMBNasccxKb5CEhjr-YlgLE4FWi8Amv_Pov2oT3w&oe=69983CE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I41Q1EzY1UcQ7kNvwF1R2TB&_nc_oc=AdkrZn0IVEbF1aLLHhUnSAcJDwpNtR5GYP312XVreX_b7BHlWZrbJN_xsL_7LaRDcr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfthDLoI4jCVXzc2P9NeMiKHlucEOcRI5PDfvCUAdUC16A&oe=69986311"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1568307600, "lastRevision": {"nodes": [{"id": "716891282004439", "release_type": "MANAGE
984465_922436058102935_3341417799611318272_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61tiG73G_qUQ7kNvwF4g5NS&_nc_oc=AdlKdZHYUmAmaQZpwTxp6C0DvBNpshSpRW-Th_gwOZ5i5YrviykrNFXL2Vjz6sOoiYc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6JdB4ZTyTAjFxH0-x2sVDH2pOL-EUQARTs9EHT0nyZA&oe=699B0EAB"}, {"file_name": "migrated_image.png", "id": "292267735074768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEgMEHp32GQQ7kNvwGZ-tbw&_nc_oc=AdnkFaGuA6XHspEnmA6zvPuxIvG2ke6wKCd7OLzpHwqXe3qUm-BnCkVnLQd_t65LGtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aful9ZUMxq1Yc0QnNb360OqwvG-AOe8wdzOH6H7ci_UfcA&oe=699AEB17"}, {"file_name": "migrated_image.png", "id": "797510141076518", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG0YhkqNBVMQ7kNvwF_6H5r&_nc_oc=Adk9YtWQuEN6rfNTbcvW4Wjkl1Dck9WUCq_kJ0YiTAvaPSe7ecJw6w2l4eGApkhhdi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTeyEMYOlW0pEQqcd33vVbNWHy_ky3CBl4q8W9YQrHpA&oe=699ADFE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1182036885870464"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982618_584224712380014_4012429186034565120_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I41Q1EzY1UcQ7kNvwHiKV1q&_nc_oc=AdkJDK8kzpklGM8JiIWjxTIinXttriARJiBj4L-qow3F7S1MWAYdhj9adFC4wMOJ2hM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvmvpYxo_Lm-5AttJucnhCOy6IPBUZnne1AyaSy_sgqTg&oe=699B0611"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Half + Half", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 1568307600, "lastRevision": {"nodes": [{"id": "716891282004439", "release_type": "MANAGE
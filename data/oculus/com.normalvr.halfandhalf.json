grated_image.png", "id": "343812909896029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974807_417303695555060_4524306369079148544_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIGUQcZMTi4Q7kNvwGcP7kr&_nc_oc=AdoWNLuS3KJ8wbT0_aB_zwMHZNKL_1VSz_HHfTD6JudnITfzDsKDrB4U4NiTyTh3luQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBT7QeIRq5DDAdBXCC2_6PCIE3sR-LBPDkcmbKDMgErA&oe=6B045E57"}, {"file_name": "migrated_image.png", "id": "236949450792672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982567_947921238877623_7393278208512098304_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2kAIiVGoMQ7kNvwH8iI6h&_nc_oc=AdozYU7Q1JFsxuPzhoc0I_EE9ryM5EiwqEN-IShx7UFrhuD3_Kt84u5mhcQywXUiHiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsUj36zUr3yNT9To351NdMTLWFS4yu3b09_XPWfLaq_g&oe=6B045322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/8vYY8E", "id": "431285334159222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031601_431285337492555_9085623772723019776_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcdUtGIlRrkQ7kNvwFx1a9M&_nc_oc=Adr9jy625rHRbjEUbn6Xq1Uo2fdoQc_zCq6EGO8wrVE-nQrOheJGBfGDNfegz3YE_p0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNiQKvj17u9bvAndbComYdFEdtRlsBBWKwseO0vLkgqw&oe=6B046EB5"}, "display_name": "Half + Half", "keywords": ["multiplayer", "locomotion", "voice", "chat", "chill"], "long_description": "Half + Half is a multiplayer game about fun & connection. The game includes five unique multiplayer spaces that are designed to help you connect with people you know, and also to connect with people you don\u2019t, even if only for a short while.\n\nSwim in the ocean. Glide through clouds. Play human tetris with friends, or Hide & Seek where hiders are two inches tall, and seekers are as tall as buildings.\n\nEvery space in Half + Half is designed to be fun, but also to make you look as ridiculous as possible in real life. Half + Half is made to be fun for you, but also fun for everyone in the same room.", "short_description": "Half + Half is a multiplayer game about fun & connection. Glide or Swim through open-ended spaces. Play human tetris with friends, or Hide & Seek where you\u2019re two inches tall."}]}, "developer_name": "Normal", "developer_privacy_policy_url": "https://normcore.io/legal/privacypolicy", "developer_terms_of_service_url": "https://normcore.io/legal/termsofservice", "publisher_name": "Normal", "support_website_url": "https://halfandhalf.fun/", "website_url": "https://halfandhalf.fun/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1244333839428685"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "CANCELLED", "id": "837319606685929"}, {"status": "PUBLISHED", "id": "2536730849718970"}, {"status": "CANCELLED", "id": "973979182985992"}, {"status": "CANCELLED", "id": "441209683264249"}, {"status": "PUBLISHED", "id": "2431637650486904"}, {"status": "PUBLISHED", "id": "449697965687031"}]}, "baseline_offer": {"id": "2431637650486904"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "CANCELLED", "id": "837319606685929"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
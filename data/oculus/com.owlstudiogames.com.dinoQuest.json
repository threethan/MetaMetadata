dH2diR4Q8kZWYDdcKFDsTttkvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQebVDCk-1CfLi2dtvNBwW7KveeXwT27W84Cqv4MhvNMA&oe=6AF09616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1278610884479846", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1278610887813179_2740641975393060495_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtTfLUkodZkQ7kNvwGxjT2b&_nc_oc=AdpyDL3omViwbiCykQFVV2HMQsz9U8wQqrqPJBxzqLN5CrP1qbFc6_R6OMbhE_vyH6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPVXU4GBqTJdZDoPtDHWzQpaQLjJa7TnwyvoNLMy1KNg&oe=6AF0ADA8"}, "display_name": "Dino Quest VR", "keywords": ["Puzzle", "Dinosaur", "Jurassic", "Action", "Adventure"], "long_description": "Step into the world of Dino Quest VR, an adventure where exploration, survival, fossil hunting, and dinosaurs come to life around you.\n\nTravel across mysterious islands filled with ancient ruins,\n hidden caves, dangerous jungles, and realistic dinosaur encounters. {1001241415891048}\n{1674961223645803}\nUse interactive VR tools to excavate fossils, solve environmental puzzles, unlock secrets, and survive terrifying predators in an immersive world built for virtual reality.\n{1540242817898615}\n{1427607036052085}\nWhether you are carefully uncovering dinosaur bones, escaping a giant carnivore, or exploring forgotten research facilities, every moment is designed to make you feel inside a real dinosaur adventure.\n\n\n", "short_description": "Explore a dangerous dinosaur island in VR. Hunt fossils, solve puzzles, survive massive predators, and uncover the secrets of Dino Quest VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dino-quest-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/dino-quest-vr/home", "category": null, "comfort_rating": "COMFORT
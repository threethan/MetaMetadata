86744_5612041601681421664_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q5N6Wb1GLQQ7kNvwGLf__6&_nc_oc=AdpUBkw5YcCHiG9BjppMNP5xpd8KVoSfuqjgLqVMynHW4JMF4qGfFJAIiOaR_1UmhFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB038m10MNgZur34XJn3vscS-5enkwvuGBABxgcrqw0Q&oe=6AFDBDED"}, "display_name": "Dino Quest VR", "keywords": ["Puzzle", "Dinosaur", "Jurassic", "Action", "Adventure"], "long_description": "Step into the world of Dino Quest VR, an adventure where exploration, survival, fossil hunting, and dinosaurs come to life around you.\n\nTravel across mysterious islands filled with ancient ruins, hidden caves, dangerous jungles, and realistic dinosaur encounters. Use interactive VR tools to excavate fossils, solve environmental puzzles, unlock secrets, and survive terrifying predators in an immersive world built for virtual reality.\n\nWhether you are carefully uncovering dinosaur bones, escaping a giant carnivore, or exploring forgotten research facilities, every moment is designed to make you feel inside a real dinosaur adventure.", "short_description": "Explore a dangerous dinosaur island in VR. Hunt fossils, solve puzzles, survive massive predators, and uncover the secrets of Dino Quest VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dino-quest-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/dino-quest-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
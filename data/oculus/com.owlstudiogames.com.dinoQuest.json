 to make you feel inside a real dinosaur adventure.\n\n\n", "short_description": "Explore a dangerous dinosaur island in VR. Hunt fossils, solve puzzles, survive massive predators, and uncover the secrets of Dino Quest VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dino-quest-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/dino-quest-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "37556136440667161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823790_970893542511183_8983214873505399903_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnLLVIg6DHkQ7kNvwH50X8p&_nc_oc=AdolgbXUQBINjruVdK7MqY9yQrzcTFtQIs45Nwv6Y5aw3E3918QHoLiJ_amMpg2mbaM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeDCPC1AOe1SbW2T8PFTdCA9DmNoIXGX8GSJFVrug-DQ&oe=6B0B1D32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Quest VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1782493200, "lastRevision": {"nodes":
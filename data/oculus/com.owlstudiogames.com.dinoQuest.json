_ohc=k3eAMIbsOlkQ7kNvwFf89j_&_nc_oc=Adr_7SeKN590GO6KcyScde8YcrlXcXwro7-M_xKoCIfXajgql3wI7wa8X-HS_EgTVxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrr6RwCIUX5NRr_yTPwTLUIUsUghjHZHTGTNzPfJ022A&oe=6B0C8084"}, {"file_name": "sssss.png", "id": "1582871917176692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1582871920510025_5579580011549566292_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouqnwlJeYbEQ7kNvwEiJxTq&_nc_oc=AdqFVeLE9O33fNadkPXR0jLGJQMNisYHBP1LVO-1CQIJW133yRGl1HeramofqOt4Ed8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKrgXSVq6KO9QpgGfm-PrpfK7YdBDbXj3M1vaqw5czlQ&oe=6B0C7DD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1278610884479846", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1278610887813179_2740641975393060495_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq5m61XoSGcQ7kNvwHKj9WO&_nc_oc=AdoUlVbI4T4yBK2Tgh77KQq9nVICKFIpCuwG1naWnQ0DiDOvyrE0iMFliNnwMoy_-kg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9Y8qlX-eCJHV_-1_WbssZdN8OA3y84P7TiXhZtKI21g&oe=6B0C5D28"}, "display_name": "Dino Quest VR", "keywords": ["Puzzle", "Dinosaur", "Jurassic", "Action", "Adventure"], "long_description": "Step into the world of Dino Quest VR, an adventure where exploration, survival, fossil hunting, and dinosaurs come to life around you.\n\nTravel across mysterious islands filled with ancient ruins,\n hidden caves, dangerous jungles, and realistic dinosaur encounters. {1001241415891048}\n{1674961223645803}\nUse interactive VR tools to excavate fossils, solve environmental puzzles, unlock secrets, and survive terrifying predators in an immersive world built for virtual reality.\n{1540242817898615}\n{1427607036052085}\nWhether you are carefully uncovering dinosaur bones, escaping a giant carnivore, or exploring forgotten research facilities, every moment is designed to make you feel inside a real dinosaur adventure.\n\n\n", "short_description": "Explore a dangerous dinosaur island in VR. Hunt fossils, solve puzzles, survive massive predators, and uncover the secrets of Dino Quest VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dino-quest-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/dino-quest-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "37556136440667161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_970893542511183_8983214873505399903_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk8IlhqzZDEQ7kNvwGkddC2&_nc_oc=AdpERzAKjVW1djrYGchnh65vT65gj_4NM2aBlVrEOZ1j8y1x8XWZPYlN5aFb9DvRS_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHuaSXfXANlkD27nsHxy0tMIPTmzfDgT1CsVnQZcKoVg&oe=6B0C6EB2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Quest VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1782493200, "lastRevision": {"nodes":
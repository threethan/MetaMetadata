38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mA32dZN5p4Q7kNvwEaBQSw&_nc_oc=Adoj6FBEIp5_8iACNVRIRNYWIEcPSnwrslnR_uCG5gFpInYS0ZhYx3ddKs9CW1EN4uk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8dY9IqwfY5WW2gqdsHnPrlxHVVTvZvoVl9fxiqOJWDw&oe=6AA6C803"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwEam8j6tQYQ7kNvwEfXSqi&_nc_oc=AdpgKTEq6TKj_7pheVfjmttjvwqYvgG3OKPzCS01Kk9suAgO1lsTcL0_OsPDdYeMtqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUvx7FsSuTjCr3rfVcK6_oDIfW1YNqB9kANHg4PVUqCA&oe=6AA6C3D4"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=En38R9-9H88Q7kNvwFYPKuq&_nc_oc=AdpgRyezw6xy3cnP_pqUXOHMmd09BmN8MSzN1AQ5AVOj1Ri7CyKz6RAcQMZ8SQoTKyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKri3lUZlinKtuQHIRiIUEG2nxf1D3WwBLzx9_ohHywpQ&oe=6AA6A174"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastr
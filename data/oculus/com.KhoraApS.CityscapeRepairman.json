38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FlPomKYBVoQ7kNvwEUl_rz&_nc_oc=AdoKmggAqfaMLJ8lnf-dDc3g8V0YtZdx07GQK4lVqI7gk2dYAn4ZzE-Bn6j8KJvEZIc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91FUk1Bz9VMa720IpsHHa4MQDmiesHIIOueevDhkSPNg&oe=6A453903"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNUIxLmrFlQQ7kNvwGQJtzE&_nc_oc=AdopGJqou2rfJD6qrR5yPcbPvvVIHPERunIiiUA12mwbh0idJ3f3Jglawn8zs_K6NAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sD5lpz5lzabBU5Yz4EkVybFD11TwXEOPpeG-92G6txQ&oe=6A4534D4"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qiNxfcIQMYQ7kNvwEyY7l0&_nc_oc=Adpja5NVlAxUnpS4YBkAR8EdSvCcgHEhPv6F47dHKgz1t1LNcvl7B5le464DEV_btg8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KHkI2oNXIFaeJhQNFjq8Uusgv-az6JncoUbZ9BAHmFw&oe=6A451274"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastr
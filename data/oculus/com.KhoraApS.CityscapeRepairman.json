38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWJdkQWSNj8Q7kNvwEMbmJw&_nc_oc=Ado9yAxU7Yq7SQy8FI60OaYl7pqR4orIWp_o3szGzBt1HmRF8IqyCkthrUfanqlHVg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z1kpfgeLH1WBLKq97vQBhChqAXjpy4MMhnYIvJ7bSSw&oe=6A1EFD83"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jv9kp7ouOTwQ7kNvwEaS-D6&_nc_oc=AdpO8TfyEkUU7Aqaq8KecChjPtqo7MYwNfi4wB1MgjmoPWqCNfG0BES0jxw5ytgB_OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YrtqO9UP8qFjHzbfUQNe8QTmkZQfHibwAY9h8hLeAIg&oe=6A1EF954"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTkMcaLkkOgQ7kNvwEJ92xq&_nc_oc=AdpX3F1HzIWuvp-RaSTiU8PZZBF3LfGdhMfyreig_X4VziHbjYhp4kfbfu6jJSxMk4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40iTKEMd3e6QtvqvxSddH1EJ3OqvQ2ap8u7d9pFve4wA&oe=6A1ED6F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.khora-vr.com/", "developer_terms_of_service_url": "http://www.khora-vr.com/", "publisher_name": "Khora ApS", "support_website_url": null, "website_url": "http://www.khoravr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473528324488842"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504572_1030717573685347_482790831_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHc0zBau7PoQ7kNvwFRfTyy&_nc_oc=AdrriysMfu0W_N6P9u93TSm-x2455dCefpxqFjIelKdjnNlqG6p7AUQ6lmbNb3Mm-fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OUBRNkzNpW_TSFGMf0n6geaEzulteYMgfoDi2Nq_kmg&oe=6A1EE678"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cityscape Repairman", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1450339200, "lastRevision": {"nodes": [{"id": "1085532428138361", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "924173877658832", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_emai
38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0kKRa7sZGcQ7kNvwGV57sX&_nc_oc=Adp5-t-5JxjSR-FIEvEq-ipzVlIkXVzYezNQkqEFh1s4hgJJi950R8VOM5CRWgZKYfE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LoJq0l-WeH6JyYoB_zW8-ZsQWYdCm4Ig2q7UTb6IVIg&oe=6A074283"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xn03mLGa14sQ7kNvwFkqrTd&_nc_oc=AdpfGM0MjrmXLT_lzNQOGcCdvkVo04_nu_RGz5rQYXbcxTlIq0D4PyHaHhd5K-Ljo0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KvzO5kV8raclnWMwTmwFoZOf7WItXD2L0gd2DqsiuDw&oe=6A073E54"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQUGhDwQcbsQ7kNvwGIPk-c&_nc_oc=Adq6wa5ULrhJbmGof_6EKMcBlFfC7v2EvGhxgwr6fZ2yMudWgAlOFXYprBzX5KQAEFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dnRqCC6xjLq2ghcDNE-fiKaXhVhvhkQ_0Gzskq74pwQ&oe=6A071BF4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastr
38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5k9vfaEX5UQ7kNvwE7ORM6&_nc_oc=AdpIkL2VQdgFdG5Fu0IalHc4WIn-QgTi-Iit6K5Wl0VvAedItzGUeNoh-8goepaJwEw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtAfAS4rcVGJUQXJgkdbldv7L2Ly1DwXAYveC83oIZHg&oe=6AD0F803"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ot_4DXy_NsQ7kNvwE9op1C&_nc_oc=AdpMmu5NmHgV9RFB_z8wdEFuUdGM_sHLuCtq8kA419Kdy8nabDOHAWTmmtCRlKZFg7Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU9DpUeg2FrV6KoAbBcF1wmCKPuE7gj0If_igngLf7UQ&oe=6AD0F3D4"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z3yMZfJB7cQ7kNvwGmd2Ur&_nc_oc=AdrHsIAoTN1wCVZbVHCbSLuUkmBGH52SlTIx5-XJyxFejf4a6TrBQ0OdnYp_hygofsI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOP7H_NfpurFohEk9HFxUAbD_bm2XmOhitULYAYjnvqw&oe=6AD0D174"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastr
38839_177852409232827_1774151095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlvY4UdrBfYQ7kNvwGdbqTq&_nc_oc=Adq6t1sALeZSWHgDqktQnreyOxBlRqBR2PMjlV98TO8GIKmZ49IjlrVU5XgcAWUVuzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-49Uwhr8EGhktvD4aNmW5VomyYI358jen-uIQ_RcJH6w&oe=6A3BFE83"}, {"file_name": "migrated_image.png", "id": "1057766571264954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138771_912191628871530_1583574729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSzWg_zuAT4Q7kNvwGndbrm&_nc_oc=Adq64leaHP0JYwJOZRns4tlJzw5K6nSWJcwSzySp8SaozK2m-gLZKOMwsTzmV0KpBzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nSo6-enslpL7y5ArRKiSHkqjWjmZ3gpKvfKluzaEbkw&oe=6A3BFA54"}, {"file_name": "migrated_image.png", "id": "699262697483603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138814_1665693657046609_1095988368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f36xrNTPawIQ7kNvwE_x6bW&_nc_oc=AdqgEzZU1AhLWqOSJISQZHp750fsNNg1CZOlEG2alQ33GMQIDM2bxGa9UKMaQJMTKJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Wq8Vn1vjgttHv7ciA6QAoT4oUgBXy3krDVw7fN39dgA&oe=6A3BD7F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cityscape Repairman", "keywords": [], "long_description": "Now with 13 levels! \n\nCityscape is a massive infrastructure that requires constant maintenance in order to function properly. As the Repairman, it is your duty to ensure that all maintenance tasks are completed in a timely and efficient manner. \n\nUsing a gamepad, you will navigate your Repairman through small industrial scenes and complete tasks such as repairing broken machines, replacing fuses, solving puzzles and fighting off enemy robots. \n\nRemember, without your efforts Cityscape would simply stop functioning. Your services are appreciated!\n\nNote 4 users: We recommend Android 5.1.1 or greater for the best experience.", "short_description": "Cityscape is a massive infrastr
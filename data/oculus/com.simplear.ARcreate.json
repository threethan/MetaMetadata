es, Video, Text, 3D Models, Audio Guidance & more\n\u2022\tProcedures persist and anchor to the real-world environment  \n\u2022\tShare and collaborate on procedures with team members within your organization  \n\u2022\tCloud-saved Procedures can be accessed by any user on any device \n\u2022\tInstructional step playback includes Text-To-Speech AI Guidance", "short_description": "Extended Reality Made by Your Team \n\nXRcreate is an Extended Reality (XR) creation tool that empowers business users and subject matter experts to create powerful custom XR learning solutions as they do their job. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://simplear.io/arcreate-privacy/", "developer_terms_of_service_url": null, "publisher_name": "SimpleAR Inc", "support_website_url": "https://simplear.io/contactus/", "website_url": "https://simplear.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9434701949945415"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393780_1647260475905833_1030434548387548255_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sA0XYwRDe5wQ7kNvwG3E6wr&_nc_oc=AdoV_GAXadLtzIF6F1B_y5qxb5YDKYUpeqAIYwclWerGHgltxUPGoXjSPbxdoqzUWus&_nc_zt=3&_nc_ht=sco
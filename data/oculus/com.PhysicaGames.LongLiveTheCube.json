wWaWJuX7HmgGx6OCX4iZmsJ7TjtVzjUM10GtM_qgjjh4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMpNOCyMvX5c19Ow3kO-TJKr7L_RXUDYQHTHF0HHIAOw&oe=6AFF05AA"}, "display_name": "Long Live The Cube", "keywords": [], "long_description": "The way is blocked, can you clear the path? \n\nPut your thinking skills to the test in this challenging puzzle game. Seated or standing, guide your Cube by clearing obstacles. \n\nSuitable for all ages.\n\nDesigned for maximum comfort. \n\nPlay alone or with a friend.\n\nGood luck, and long live the Cube! \n\n", "short_description": "A light hearted, deceptively challenging puzzle game. \n\nSupports single player and multiplayer.\n\nCan you lead your Cube to victory?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.physicagames.com/privacy-policy", "developer_terms_of_service_url": "https://www.physicagames.com/terms-of-use", "publisher_name": "Physica Games", "support_website_url": null, "website_url": "https://www.physicagames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1208369136553274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035406_259589186213253_7691158086317235657_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e
 **One Million Dollars** \ud83d\ude01 ", "short_description": "Ride around on your skateboard, Make schedule I substances in your house,sell and make profits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1153985457802604"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PENDING", "id": "1042825702127068"}, {"status": "PUBLISHED", "id": "2360278494722274"}, {"status": "PUBLISHED", "id": "1390496419080516"}, {"status": "PUBLISHED", "id": "1083601634065927"}, {"status": "PUBLISHED", "id": "1367497002116542"}]}, "baseline_offer": {"id": "1367497002116542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1042825702127068"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362203226980825", "version": "0.0.4.8"}, "id": "27475952558711605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "11539854511359
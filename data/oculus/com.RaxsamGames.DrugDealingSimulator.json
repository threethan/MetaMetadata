: "1066255965785441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312338_1066255969118774_5061235754950637975_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DO97MCA8FAQ7kNvwHvTB7V&_nc_oc=Adr-7Y9a_8eMGbvsJ1Wsr5APjkW5MuRaeyFfJhIxB4qrjMkbGdQyF_Me4hKYhgM2BKk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc1zVRSGKl8-v8CWHDHRnkIild7QJ3TWOHA-nRddb7jA&oe=6ABE744A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb_1.png", "id": "2197161320857639", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620504_2197161324190972_6772736704629114966_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExrT_bIA-jUQ7kNvwEwcC-o&_nc_oc=AdrI1FowdQGLfgKIlG0605-Z5kYgR1MHY25ti5HA6ToLi-L9xsXl_F4h4ToYSOdjG8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2oO0ZfbKjUOykMLiHOsyxhLoiZury-Wzga6X39eZKKQ&oe=6ABE704C"}, "display_name": "Drug Dealing Simulator VR", "keywords": ["Drug", "Dealing", "Simulator", "Skateboard", "Schedule"], "long_description": "Travel around the town on your skateboard, **Rob people for money**, offer them **Free drugs**, hustle around the city, **Fight or escape cops**, **Grow weed/coca plants**, **Cook meth and Cocaine**, do chemical **Mixing**, **Invest** in properties, play in **Casino** or just do **Trash picking jobs**. The world is limitless\ud83c\udf3f\n{1610729873749072}\n# Ride around on your skateboard and organize your house and warehouse \ud83c\udfed\n{1410693714288820}\n# Plant seeds and water and harvest cannabis and coca trees. Run the lab to cook meth and process cocaine. Also, upgrade the lab to a warehouse with superior seeds and mixing for higher profits \ud83e\uddd1\u200d\ud83d\udd2c\n{2128372754728929}\n# Increase your profit margins by extending your product with a variety of chemical additives and watch your customers react to your custom batches\ud83e\uddea\n{2141976119716074}\n\n\n{2478301776004449}\n\n\n- Find your Customers by **offering Free Drugs**\n\n- Grab your board and skate seamlessly through the city to meet clients, escape trouble and you can **ride the skateboard in third person view as well as in regular view**\n\n- Dodge cops, Take care of the cartel and protect your stash.\n\n- Manage your finances, upgrade your equipment and scale your underground business into a massive operation and make **One Million Dollars** \ud83d\ude01\n\n\nTo learn more about the game's manual and mixing and to join Discord: https://www.raxsam.info/wiki/ddsvr\n{1830694658363618}", "short_description": "Ride around on your skateboard, Make schedule I substances in your house,sell and make profits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1332680819933066"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1597076652015274_1005890964130877650_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M107QAlwpiAQ7kNvwF5ox6q&_nc_oc=Adrnwj1DLwoEYqVtmXq0UApyo7Nv-GjMQlrBwwlZ9OjBKSinKDvJwyFcsjQYtR9mPuc&_nc_zt=3&_nc_ht=scontent
5771-25/507823984_988462317552911_8279029690866107870_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KchyFux0lmcQ7kNvwF0Rpi_&_nc_oc=AdpVVFt4nqapNu26ZL7eUEy-zXEPPFN6bLG8Ls6XqMboYKP5KdpTys81q0Ubbyd3mCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2eV7M3bJ9G3aY1Cw0sdNf4SiI9l0XZH8wiZJc44-3Ng&oe=6B01BA78"}, {"file_name": "scrnsht_3.png", "id": "1066255965785441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1066255969118774_5061235754950637975_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1-maPKDlKsQ7kNvwH6GWqT&_nc_oc=AdpEc3btoqVQkTko5K4RDlZMuJgvGCepHXD1rzZ9tP3Fjsn5vXbzuoIpRZfu6-WtHe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYQR4S0FUplxV6rcTMbc5EwXciPhcsUgs72DZxy9JbsA&oe=6B01E90A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb_1.png", "id": "2197161320857639", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620504_2197161324190972_6772736704629114966_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_ZjbfN9v1QQ7kNvwHjgq9D&_nc_oc=AdqsFyIwHppC8JwUjtMY-sjf8Xyj9ia2fBX6P4llKsr4QvaFXjwtZyARljzngy9pKv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt07HmNaEVP8nAcmX_4ipOy7jei4efDbUzAcfJllU_CQ&oe=6B01E50C"}, "display_name": "Drug Dealing Simulator VR", "keywords": ["Drug", "Dealing", "Simulator", "Skateboard", "Schedule"], "long_description": "Travel around the town on your skateboard, **Rob people for money**, offer them **Free drugs**, hustle around the city, **Fight or escape cops**, **Grow weed/coca plants**, **Cook meth and Cocaine**, do chemical **Mixing**, **Invest** in properties, play in **Casino** or just do **Trash picking jobs**. The world is limitless\ud83c\udf3f\n{1610729873749072}\n# Ride around on your skateboard and organize your house and warehouse \ud83c\udfed\n{1410693714288820}\n# Plant seeds and water and harvest cannabis and coca trees. Run the lab to cook meth and process cocaine. Also, upgrade the lab to a warehouse with superior seeds and mixing for higher profits \ud83e\uddd1\u200d\ud83d\udd2c\n{2128372754728929}\n# Increase your profit margins by extending your product with a variety of chemical additives and watch your customers react to your custom batches\ud83e\uddea\n{2141976119716074}\n\n\n{2478301776004449}\n\n\n- Find your Customers by **offering Free Drugs**\n\n- Grab your board and skate seamlessly through the city to meet clients, escape trouble and you can **ride the skateboard in third person view as well as in regular view**\n\n- Dodge cops, Take care of the cartel and protect your stash.\n\n- Manage your finances, upgrade your equipment and scale your underground business into a massive operation and make **One Million Dollars** \ud83d\ude01\n\n\nTo learn more about the game's manual and mixing: https://www.raxsam.info/wiki/ddsvr\n\n{1830694658363618}", "short_description": "\ud83d\udef9 Ride around on your skateboard in an open world, make Schedule I substances, sell stuff , make profits , enjoy night club and casino , rob civilians and fight cops and cartel to survive \ud83e\uddea"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
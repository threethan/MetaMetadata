637975_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCZwS5qPhhMQ7kNvwHh8juE&_nc_oc=Adoq_vmkBp5qOopePteYDBJQ4S_O4CH3HhL3-aax0kpt_ZkiVGqw2kOM4s-0AA-gwZ8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlCzE66ZgwcRFI0WSYTjUyI_BsEG7sGOAlUCP1x5f7w&oe=6AD38C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumb_1.png", "id": "2197161320857639", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620504_2197161324190972_6772736704629114966_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8809yH4kMmkQ7kNvwFQx-h1&_nc_oc=AdojFlRZM7GT0ipm6WLMa1FJ4d8hrb5fR-F4itHWBJXGJE9qmVXEPSvIV0xPkxyCTu8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrVlC_xMQP7QPie8O-tCTe_GCk-CDgKDC9RVKHsaQXIw&oe=6AD3884C"}, "display_name": "Drug Dealing Simulator VR", "keywords": ["Drug", "Dealing", "Simulator", "Skateboard", "Schedule"], "long_description": "# Grow your own cannabis and coca plants, cook meth and cocaine and Sell \ud83c\udf3f\n Hop on your skateboard to navigate the city, dodge the cops and Cartel and sell your product. Adding Mixers to your base batches you can maximize your profits and watch your customers react to your custom batches.\n{1610729873749072}\n# Ride around on your skateboard and organize your house and warehouse \ud83c\udfed\n{1410693714288820}\n# Plant seeds and water and harvest cannabis and coca trees. Run the lab to cook meth and process cocaine. Also, upgrade the lab to a warehouse with superior seeds and mixing for higher profits \ud83e\uddd1\u200d\ud83d\udd2c\n{2128372754728929}\n# Increase your profit margins by extending your product with a variety of chemical additives \ud83e\uddea\n{2141976119716074}\n\n\n{2478301776004449}\n\n\n- Find your Customers by **offering Free Drugs**\n\n- Grab your board and skate seamlessly through the city to meet clients, escape trouble and you can **ride the skateboard in third person view as well as in regular view**\n\n- Dodge cops, Take care of the cartel and protect your stash.\n\n- Manage your finances, upgrade your equipment and scale your underground business into a massive operation and make **One Million Dollars** \ud83d\ude01 ", "short_description": "Ride around on your skateboard, Make schedule I substances in your house,sell and make profits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.raxsam.info/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Raxsam Games", "support_website_url": null, "website_url": "https://raxsam.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1153985457802604"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1042825702127068"}, {"status": "PUBLISHED", "id": "2360278494722274"}, {"status": "PUBLISHED", "id": "1390496419080516"}, {"status": "PUBLISHED", "id": "1083601634065927"}, {"status": "PUBLISHED", "id": "1367497002116542"}]}, "baseline_offer": {"id": "1042825702127068"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791568080, "status": "PUBLISHED", "id": "1042825702127068"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1371204082747406", "version": "0.0.5.0"}, "id": "27475952558711605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
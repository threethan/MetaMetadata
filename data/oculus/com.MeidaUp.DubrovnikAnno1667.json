-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEpRHlcej5B3BKg2MPeZ2ARKNIH8s0WbjoKeJurdTZBg&oe=6A7DC16E"}, {"file_name": "DUBROVNIK 5.png", "id": "138705081088614", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974504_138705087755280_8374796861991571741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMDrJyPKCMUQ7kNvwEcXu6e&_nc_oc=AdpjDXSBe_fVSXw5w0Q5ef5te6Xr7BA6qu0JmbnlcVySnlx7Zqd3go6aw1ov14Cu4Y0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3SFdUqV1T3ClJqhtQiHT6FcsTLY5Jj5CoPLzUMYao-Q&oe=6A7DADB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "199891091620241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035414_199891094953574_8894474500073188240_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0oA9SuuZN8Q7kNvwEXd1Wp&_nc_oc=AdosKNdPAPMyf8V71DBE0_HHJezyw-CyOvr7AwIDB1ax7UiV-zRCk559ldXDkvAz2nc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzOuIYpdDAl1erQ1yCMx8EO-1F8jmRBqhOy7LIxdhe_Q&oe=6A7DC1BB"}, "display_name": "Dubrovnik Anno 1667", "keywords": ["dubrovnik", "croatia", "history", "gamesofthrone"], "long_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. \n\n- TIME TRAVEL TO 1667 -\n\nGAME FEATURES\n\u2022    14 historically accurate 360 scenes\n\u2022    Voice-over narration\n\u2022    Video documentaries", "short_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today D
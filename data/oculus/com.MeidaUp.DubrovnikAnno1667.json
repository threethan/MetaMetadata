-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CDBKcyJcvaPblAxwZW_0el-dzm7UHxpclRCajFeYu_Q&oe=6A39336E"}, {"file_name": "DUBROVNIK 5.png", "id": "138705081088614", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974504_138705087755280_8374796861991571741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVzf8yTj31oQ7kNvwEiQAOe&_nc_oc=AdqyZO5-PVrybHZZzRYx3vePPVp_PkUM733NHBOh4GtDxR7fndMP2MPfO6sT778nA08&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96ARQngZLZuKlOWyZcWG9U-IURuPkfD6zWXGbhSfgzpg&oe=6A3957F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "199891091620241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035414_199891094953574_8894474500073188240_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTb0X7DmzkQ7kNvwGR_gWz&_nc_oc=Adr0MCf4jVmVeKodX_CB8Arsox2m99IaqZ1ZcaAK7pDcJA65g0IpNrae1xZwFY5FzOM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_drH925_NyKsoEM8TDPt_zD62L4jI8PHmCtoANADk5zA&oe=6A3933BB"}, "display_name": "Dubrovnik Anno 1667", "keywords": ["dubrovnik", "croatia", "history", "gamesofthrone"], "long_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. \n\n- TIME TRAVEL TO 1667 -\n\nGAME FEATURES\n\u2022    14 historically accurate 360 scenes\n\u2022    Voice-over narration\n\u2022    Video documentaries", "short_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today D
scdn.com&_nc_ss=7f20f&oh=00_AQKbwnlzzz7mt3Z7fFSxryiFCY1DeNE1M2kwq6YAE_6VMQ&oe=6AB671EE"}, {"file_name": "DUBROVNIK 5.png", "id": "138705081088614", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974504_138705087755280_8374796861991571741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgNUR9fpAJ0Q7kNvwFILDO4&_nc_oc=AdoRWXKbjVCsED_4YtdV7dCawy68FHA7JV55xShjpaZwIxyCdObHP0s0S0xUwP91VnE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAQf788LU-ZBcv4uUBleG9sNd5XOD4a1K6skGs1Ux-kA&oe=6AB69674"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dubrovnik Anno 1667", "keywords": ["dubrovnik", "croatia", "history", "gamesofthrone"], "long_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. \n\n- TIME TRAVEL TO 1667 -\n\nGAME FEATURES\n\u2022    14 historically accurate 360 scenes\n\u2022    Voice-over narration\n\u2022    Video documentaries", "short_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediaupprodukcija.wixsite.com/mediaup/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MediaUp", "support_website_url": null, "website_url": "https://mediaupprodukcija.wixsite.com/mediaup/dubrov
scdn.com&_nc_ss=7f20f&oh=00_AQQy24qFKjrJq8oDdRBJtlq3whr1k52795J8qo4KOwVXOg&oe=6AEF5AAE"}, {"file_name": "DUBROVNIK 5.png", "id": "138705081088614", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974504_138705087755280_8374796861991571741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6ZoqdcQy1oQ7kNvwHw5eVh&_nc_oc=Adowq0Ifw08O4gLXFedBzQD2N__vRgcc5CaLo2mJbqWqIkt7sApQaM7ApprAZe2J6xQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb37l1ghLsdVKDiZD9uDsIMSBt8yBaWFSoZgFXGVjfQQ&oe=6AEF46F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dubrovnik Anno 1667", "keywords": ["dubrovnik", "croatia", "history", "gamesofthrone"], "long_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. \n\n- TIME TRAVEL TO 1667 -\n\nGAME FEATURES\n\u2022    14 historically accurate 360 scenes\n\u2022    Voice-over narration\n\u2022    Video documentaries", "short_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediaupprodukcija.wixsite.com/mediaup/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MediaUp", "support_website_url": null, "website_url": "https://mediaupprodukcija.wixsite.com/mediaup/dubrov
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FeghR6-1RSG7mUeyplZ5myGPyZ5lbCTCOpBeYApnWRg&oe=6A36C8AE"}, {"file_name": "DUBROVNIK 5.png", "id": "138705081088614", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974504_138705087755280_8374796861991571741_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjQb560JDBMQ7kNvwETTjOb&_nc_oc=AdrL6BVuOp8jnJikDH9vhhbMluuaNgyjyq_1kCy4xdg5Q28le3iOH61U9Nh0g-QX2xY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9reG4VEmAQRiwqRBGPM_hVtIIs8fqyXCtgVPSHUzt7YA&oe=6A36B4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-1.png", "id": "199891091620241", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035414_199891094953574_8894474500073188240_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTb0X7DmzkQ7kNvwFXI-mP&_nc_oc=Adrjoo_e7EBVwQ_ueeN8_ZiudQxXEMirFCmCah3q10aZ_HxctxYyYRSKgq1nWWRIAB0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ahj9PWGEPEraVNTulhbhg9-VRwADQAOnNBR6lIYck9A&oe=6A3690BB"}, "display_name": "Dubrovnik Anno 1667", "keywords": ["dubrovnik", "croatia", "history", "gamesofthrone"], "long_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today Dubrovnik is known worldwide for its history and beauty - serving for big Hollywood productions such as Star Wars and Games Of Throne as Kings Landing. \n\n- TIME TRAVEL TO 1667 -\n\nGAME FEATURES\n\u2022    14 historically accurate 360 scenes\n\u2022    Voice-over narration\n\u2022    Video documentaries", "short_description": "Dubrovnik Anno 1667 is a historical overview of an old Croatian city Dubrovnik. Once an independent state Dubrovnik was a maritime powerhouse standing up to Venice. Experience Dubrovnik as it was before a devastating earthquake that happened in 1667. Today D
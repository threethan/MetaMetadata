4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0_gVs1PIFMQ7kNvwF5htFW&_nc_oc=AdqK0zahRRoe232WEGyCD6rlH2bkoIjgNx3zY1AcM_8GMMA5piikJRYtu8czWW50eHc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_t19BB-3vJItubC9ac1zAnT9yy0EfEaZbWSLkUPNpLg&oe=6AC51112"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzAiK0gL10YQ7kNvwHOfrHn&_nc_oc=Adq_cveprbB64Slxu9oZWnrFx-iQFKpEO_HhY0Pt-dhsuotH88LTnZ58gmdDKEhj3KA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWSFkXAxXtQQeOWDbuA5atZEUY1OnD0eogQjxchgNNoQ&oe=6AC4F80D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl1oRC6dL7UQ7kNvwGBrIvO&_nc_oc=AdpFBbna3Dgh4D8e6wbchXXUOeM4QUTw3DWFfMhnSTx4cNKXxI6xs0jEVkn6tE-fm8s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUwqtWX7H-47_I5qyTaW0nAt2CEBwZYSFyz0Y9HvynPQ&oe=6AC4FC0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTy0TmHlQj8Q7kNvwEZYcMI&_nc_oc=AdoAGw7N5MObLrQPp1o33AmH55IcxiXxg6k85dzlzsjqZEd4V7TY7RlxBiMVdEOS2Dw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyB7MqMKq1BXiND5mfxJ4clDG8GiaovLv88SJJBLHesQ&oe=6AC50C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HzsnIJY9PcQ7kNvwHZ7ZK4&_nc_oc=Ado03utVAEURCvo3diqkxIqg3ZnCLtKqtsZ1QST4GMVYeoPbEhYaOgjZtEL4Rv1N0l8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaAL_N7bw8TWF-YwUsMTEen_NaJdwYIl3aEiGHCeQU8g&oe=6AC51FC2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
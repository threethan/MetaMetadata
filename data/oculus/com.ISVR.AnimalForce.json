4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcmwyFf6Qg0Q7kNvwEeq_bC&_nc_oc=AdrPqWoeoxHTeMkQAY8860B_PjMq5xK-F_SWNGNYKyJyd6EntVLVvR7DAl4SXaHvUws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40fb9cxMZ0oZgpO4cQWTk0uZlqCUF0P7IJK6kq4_FtiA&oe=6A185C92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvUAu5dbgWAQ7kNvwFOY9Mx&_nc_oc=AdpKo3rUlhwU0bGKf4XFDRg_oix3_U0DA7XFSS4Aqi3wNQgCNmkfkUDdPSotLQY-nlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FDvD5_Ch1Tl7Nl5PjPZWuZ4TDxh-iFECDacu5gbi_9g&oe=6A18438D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMOeVEJ_vWoQ7kNvwGKRIjP&_nc_oc=AdqXStEWuqvVDLKBHIX3piKMzxlXhxXi6KHi84aJkuEliBASVMzVtKJyZwYn4t4Jwws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fUhnhxniPS1y-e4we-Wtj2Ph7_vApjm_KUmNkdae8-g&oe=6A18478B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWAtpGmPODQQ7kNvwEiwPE5&_nc_oc=Adr8VTG6_4T9VMDZk-ubEpuHOr42u69qctiXGsqLz0HswvRvBjEY8vejHsS5sde0sfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JSzBhg9Mf26hJm7dI9BJIxPI6ZTjtp3x3VVBDz9g_Dg&oe=6A18578C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QjIPqholeYQ7kNvwGGEGB6&_nc_oc=AdqFZnpXJDtRrf7VoNNQgaGHHIeY4ErOOj18c7VFBH8wk_NOJpoBR8SYFkSXi1G2-zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WzqT2-R4e2JVSh3YBDGPLYjIz7h3eAHkabhZCxYtfDw&oe=6A183302"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
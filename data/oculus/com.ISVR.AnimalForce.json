4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOMkDZ-SihwQ7kNvwHWzoY7&_nc_oc=AdoC2H-ELuCr76MIgAnaOZ4HUO8wWnAPLuGuDmu7PaAkC7OldJQTYQ6fDE1zL4Vbr84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r1IlJkij8g1k2R_FUSw56SfjNHVt0gNImWTjfE4sS6g&oe=6A049612"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kc1HpyGaW2sQ7kNvwGQZUxv&_nc_oc=AdpetGY-CHBZ92P1aXmF9U1Zt9dLugScvW4KOltOFd2DMUZKbza5MW_fZ5J7QVAE-j4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y0RkmsRnhoLK5dPpmzYgCQDMNpm7M6TkNVnPgJ_5Rbw&oe=6A047D0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k48ARHWLOlQQ7kNvwHUIwbt&_nc_oc=Adq4276FZttdbX6ImEoltYgeCQUaAo64YmeswBf8h2nw-rS8h-a0PiK6eXSQHBREHU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q0arDQ9-Gbl_tm6zIC2T1BXZ7ElaVGtLyJCVvQaa3Fw&oe=6A04810B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quKMx3QaefYQ7kNvwHhhm_b&_nc_oc=Ado52ruuz8ynAwhr00FsmxrUEh7Ux3mQul-yYxZIlHrMuBqztZm0aQztWAHpS9H8zBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MN9Ps73ADfMwnbSC0fxQjpdzc0-lc6XJCa_Xu_JKPoQ&oe=6A04910C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxEcJbIg3ZgQ7kNvwGm8aD6&_nc_oc=AdoRAgt-9cZ4Jo_ZD2SnfP_CoAHUi56sANSFa9_cJV8paek5r_k84zd5WRPOpt1vSU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YuYexokB2hdpSgxbciR1_DfUsBF2rL3LbKy7dqhStnQ&oe=6A046C82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcmwyFf6Qg0Q7kNvwH62cPm&_nc_oc=AdpZ0qP2xOhsmB5o81ex0kafxOCNfIbuUrfjm0sprv52-8PmruOqulOcSddBLCyDvCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5swIQWroO5xLTberyufOg5djn3XXoKwKVYAuyoMJnJ7Q&oe=6A15B992"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvUAu5dbgWAQ7kNvwEjw0z4&_nc_oc=AdrzfPyngVtGfW9VDvbH8x0FZFMfNqZjkv9ou9Lbf06XpI1vcy-b9SjyK74JK9kOY_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47f6DfmCG1lCPjFGRxMFSqwj8qSK-k-ms8n8xysa4Law&oe=6A15A08D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEkb20WRaAkQ7kNvwGvPnAq&_nc_oc=Adpy4U0mmGWvIdTiE_b1_aEojRSPp6OGZevSN1lHn9I-w75tQB6X24LkUfOfiFhC6IM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hzzIl8c1zsuW78Z8Tt9NipsXDdjG2wEL9GZ0RCxG8zw&oe=6A15A48B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnBHIQP6XMEQ7kNvwE_l9qZ&_nc_oc=Ado894ZXpzIWR99X67eV510g2_4rc4SAlchJ-4wd7SDHmvDAHrRWCbYkePO3eIxfjio&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-N_aAkq1ubJb1a2B6y-8U9mYTyPQ6-5SdiSPg9mv68w&oe=6A15B48C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QjIPqholeYQ7kNvwFnNZsY&_nc_oc=AdqnKUZEyCb6Vq8AVRUqtzqLopRHyOiPuNJPSO15c4dF6JeCNP9vEATFg-VkwQfZhfg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f638-XhSnjoUdInRGsMHyIYnx3SsTvUeoQZgNvjnYvg&oe=6A159002"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
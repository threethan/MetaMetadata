4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsr5BcsHzmUQ7kNvwGF6dwb&_nc_oc=Adpnh8sXZhJoDzh0862UB_xdYp9b-l4hyMhrvfQp4_k4Ow2mmIRoZi70_KDiDDiU3bw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnRTFgW3kOzaT4T8nG52sAAng0IHe5AAOElnCgfjxzZQ&oe=6A4E6A12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASZEwc5Ml3QQ7kNvwGC9HXG&_nc_oc=AdqACIuWlh8qBMnraCanP4SxnNRUe7mqu_xoKP3WeA3Odt-Pdt7LsH0cWNbnzJHHKDM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeS8VLFeguiVjtQeDPbdFcRFcz6PcrL0IKVBhOrvVDug&oe=6A4E510D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7phJcSTpt0QQ7kNvwFzS0ZM&_nc_oc=AdrfEsXk1gCuBf4BJZbipST7megV6AiIrToaopI_utQ6etvJ1_gfim6jPy86vDC-R9Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLlMsIR75NYL3zUXxxlUn3VotjpWrm7SIBrA_z3A_Mag&oe=6A4E550B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2EHB0Oe_E4Q7kNvwFiu6JR&_nc_oc=Adrrt4A_ZVP4Qglld-tZjv1XCKb6EDw1lajJfKCh0fWdFnrp7gT5HYfxgFLYDLkzT-s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHds0VdU8UHHqoJmCpJLPEXpCYvfj_XCTPeSH_PlesJw&oe=6A4E650C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDJIx129Y6sQ7kNvwH-SlD9&_nc_oc=AdpgWhhWZcS8dsd1EPy4-UsTtCfsg7Z9S_vObMrrcixtJvRGw_uN9_f-r8Pgq9nGsZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQP1Ub3g9R88J86YaTM0kcjii1vDN3GUe-eDfXSXA6eQ&oe=6A4E4082"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
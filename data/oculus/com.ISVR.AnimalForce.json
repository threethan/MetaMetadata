4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7QseZUnZ7kQ7kNvwEuXYWg&_nc_oc=Adp2v2ReY0KOVHkj40e1zB0vZFwYGmylTPcss1CUfGbkIyiD_qNxv2pcagyRv3zNEA8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyxdqheBQFxhnCXPF08GTpa-9ZL7MDRa3vEot_zpYifA&oe=6AA02712"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr0RFJaCbD4Q7kNvwHLlTVt&_nc_oc=AdpQww_16F7gj79E3vvwPHooPHZIko68axEa_OV00mD1FvJ1BP93PV4uni9OuQWmjGg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaqUZhdLCSA4kzK68JDmTfZd8PxydCI4Eodt7GnKtfCQ&oe=6AA00E0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6086_iKaxLUQ7kNvwFNQr14&_nc_oc=Adp6fwSOKfXF9X6WiSwbcYQl78e7VbywmYfwb85IWut8PjDGcTC-OVYCJ3P7QFJQSRc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp1Zz-ne2TNcaYFjHNj3pgmFbsDBGNv49jiwe8p9WZOQ&oe=6AA0120B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uyhErG-obEQ7kNvwGwpJ2K&_nc_oc=AdrTAR-kc3-nv0xEHAtqgxjD7VBuQ7Desb9MI-JMYe6CJNoL1eSEM2bJ4aMfWA9yQYI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSDiZKYMGvkaM97pkwFptFrdS0lrGwlvumbQEN-efmcQ&oe=6AA0220C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mnF-LI7MAAQ7kNvwGKQX7f&_nc_oc=AdpWIHHVM2fHih45KzdLr8zTVbaG-1r83iQaZrayRuqNOU83vOebF_QEl-_TiI-Ezb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0rHQUh4crO04BP5HWsg-RIQB3SAcF93czRygQG4mV-A&oe=6A9FFD82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Q3ayjWNL4Q7kNvwFfCfOn&_nc_oc=AdrylIAQCtY3whHWwbFDTywE3bpJDdCxEB_u2L5VhGpoZc6YRBJmsQUbyMSfrCBfscs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1H9199iq1BMOP6RoKhCONKsBZJdanEaUFPI1AoTDyaXA&oe=69F37292"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEmcWo_psdMQ7kNvwHH5VhR&_nc_oc=Adr-Opkn73DO0QI3LHRodxenY8qtM2_peE6x0300CDL6wJ_JkxBJd-QDoopbTEDB9jE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21QydorJnKuPM8hyyze9X7NweOKDC5BVpnBefSfRyCbw&oe=69F3598D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60fl7_ks5e4Q7kNvwGvkC0o&_nc_oc=Adqf7IOY0VAWxL5NtS1iQjcy9T8qtZpf0sg9OLKDvWp_CIf9ldWKKkXGL25VczbjUlA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0U-lSFumHLgOHwEYQ-Xt62lxFHP-b_JMjp753bzgh1ag&oe=69F35D8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dweCGD3idHsQ7kNvwGbZW4P&_nc_oc=Adpm4gA5GlGMK0VcfC2ARUxbRlXPZEZaJrTpNhJewAALOoD_zu61yW9wxlJ-6AmjbJE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0t9MupEmYbuHUGCE7qC-ghzN9gp_sKk3z7icP6OQpiIw&oe=69F36D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBnhxhRfOrsQ7kNvwG804lW&_nc_oc=Adp5zaTU9DBP1rTkv27uKiQNgPwdkDovzA7xPuRBfKMmO-5dyY0_dMRttaVk8NmXBXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35LlZtqQDfbnYOG7oWAup6u98wM8tbzr4yx0Pv0k3X4w&oe=69F34902"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmg8M037VnsQ7kNvwFq481A&_nc_oc=AdrRFxS6obvCoCnaoT7bs4mEV5j_RN6jeCmVMQW9Db81jltqDxfE1q_Ue8NW3qt2A1s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83_W81PscCDvcn8pA-LXUCNVw38vCDHzcXRoovnCszmQ&oe=6A3D4692"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_mtGDAJOAIQ7kNvwEq3ZXa&_nc_oc=Adqq1ai-Dr7EbN1Mpbb5PrPvd1Qi4Cex7EzLZacd0b2egoyChRROclldVLt1whVWmNY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9akuiY8pT7Z5WesU7kBhiBtdrywEngHTRx0Jdro7RxwA&oe=6A3D2D8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqvwW3uGtJ8Q7kNvwE7L1ae&_nc_oc=AdpCm0mgNYdxD21CY8FPzSeDpG6b0IZzQmgIdsnABRxWD8cGbZ1dswkRIIxqUVA5I2U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GTGqNjQCAlc2qzWhUPha18tF3j3bKy5uegrczdgEBfw&oe=6A3D318B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7a_csjn0WsQ7kNvwFpZmWw&_nc_oc=AdoDDa9PWkVC5RPaI7WQjjXtMqSh20REX7kw_SPhwVKfq6Cw5ODIw87NuiCv1kg4efo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mBSwh91iWIvBY0_ofm2Em-wDWvlF15o8B493i9jzpGg&oe=6A3D418C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjxPlssl-aUQ7kNvwHCUiXX&_nc_oc=AdqdpadJpuILmbVmpqPnAbi0-CNaa72MToyRulb87i2oQNoalVypgnTehOrMFYmvEq8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-h9j8qfROrzwhYHsRj66WJD8tdEXQPUVix6X-XOwfddQ&oe=6A3D5542"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
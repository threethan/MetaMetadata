4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7QseZUnZ7kQ7kNvwHtAsob&_nc_oc=Adp_m4Ggn42Vk3SiT2PBSSEzSXz-Ad4ilZt_NKVIb3Ay3FzWqwyFXcnExZDF0SA_elE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk_pPh70z0i47oV9KLRWl5DQU4cgKKat6JVaUf1b25GA&oe=6AA2CA12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr0RFJaCbD4Q7kNvwGsyAzU&_nc_oc=AdoIIEQP98q6CUYPoZtWwP7SfZqadUTAjVG67DRB_of9fSxggDMTsBL3V3RSeX4RcOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLALbwYZN1ixFpTtVrlXR32LxN-LumRzYHBqgsA1stp1A&oe=6AA2B10D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlG2y1aDa68Q7kNvwHzmL0e&_nc_oc=AdozEqKZUTr3M7vNLNXPfu8MnXrlmeJgW2mjScxDv9CIH7W3xKsSBjZHC_bSEMnjCEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn7jZBxAWSUhl5jQY40bcM32kc9e0lR3uyfTuwzlYw2g&oe=6AA2B50B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhaKzk2zPNwQ7kNvwE5LEsm&_nc_oc=AdpdUMWeqQ03nxqIaZFBErnt7trx9kWmwVscvkd83oKs1d6u4s7iwqqyUczwFmDpGcs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpurxRaUN5JbmR5LB71bPdfEg30RBAbxK3ZCQCJ2k0BA&oe=6AA2C50C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mnF-LI7MAAQ7kNvwHL4lOO&_nc_oc=AdoSWMAyqBk98A9E20JFbq4jWLCSdtWngxdQmpHCnC5r0_bwStyUCt0MjizClUNa7o4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOMTvEppIIqfP2IXuT9vd2EzwSilj1xo1cEf3cifk3cA&oe=6AA2A082"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
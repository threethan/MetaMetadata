4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ij5EJ3f8Q3UQ7kNvwG5bHc-&_nc_oc=AdpIi2ouj5TNYPxdtDQA7fjI8BLIwPLrozHD_J2yP27pkvhAtoBRaGqZvE5J6PUxgek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQHdpw0dYiB3tz9ZTpC8I1js5Wigzd6dWjPe3B4cQk_w&oe=6A735412"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1yqApce7_YQ7kNvwG9ZrZU&_nc_oc=AdpNEdfM5x0MQR4oYBz8ym4HrEsXUogZmNECF8eCjgIHv8snh9kUbv-0rYrFczNsZFc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzMHhOk3i-9CWjXaG8mmH_NtsdxFEHKklHvfEMPNMYcw&oe=6A733B0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nitY2aaMUIIQ7kNvwFDrlyh&_nc_oc=AdpwQZPOZi29VVLM8cMRxuG9qLkur9iPbCZBObWiPvrzv3cEbzfidYFgxTz_JKN6wp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElfmeMB9OS7Zg3xfkU2IvmAhxRynOLtAcHmI0N8qIy8w&oe=6A733F0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McRyIXMYvJ0Q7kNvwGK6fwd&_nc_oc=AdqO2l1-fTUsECxzVhOfXPZvjCNNOwXkWG9dcu86xWxT-UccaXMce0ss27OsN0Oci00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKoDOcn3473QWgRVSUC5w4wEOrjrbl_HJOUA_TmpCInQ&oe=6A734F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6Y3JewZmDcQ7kNvwFV93hX&_nc_oc=AdpX1tiqI5e54SrG_wxuvPgnKsv1hBiahUZO5vVDooQGRYKa9SsIZ6ANYwKwV71lRKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpZYK7CKVgZ6gkLJlVZmAYj9jNzKuGUvaK7M9Pt_Mx2g&oe=6A732A82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-wpHOx_6UQQ7kNvwGPrLbY&_nc_oc=AdqM1sldOdaaDat2VgaOppIR_ThXnZ6dPTNJp63b4IGnLpwboaL_vNYVFVOHPGibpW0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1hINKQUzzuoN9lIiubi-S3VqLjf3cVCe4Ka_oqKg6XA&oe=6A662512"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJUKXp6ur58Q7kNvwEPmT83&_nc_oc=AdoW8YC3vwsvHHY2bOH3CyLhWfMOL91aMcNX19I7sKdg7x1B0f-1hVsmuFbvTpeKQiE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFMIyZmYO_xONQYZMdl3OxaXK-uSFn--bV2PR8ON-UUA&oe=6A660C0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcqREho9hFUQ7kNvwE6BYng&_nc_oc=AdrLUiHg0fMtV7cbtFQqTPMUuzuZnR7Ja6c-Qlwm3br1jV7gzhjsej0uMvnuPvKw6vQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5o5UozBUB3eLrXylD3IimY7RN6qQ4ew9EUckhAAaaLw&oe=6A66100B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXmcy6MghakQ7kNvwE2aRel&_nc_oc=AdpCf54c1RUZmXWGaHT4jssB290jkNdj-CCy-_41aNTakfGKcfJ9HB9Z6-W6vSCbu0c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmV1yUQo9VSzjJmwMYZKRAndei-jNeKQvVFQlrGTp8PQ&oe=6A66200C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6rjb-xfza4Q7kNvwEitrfp&_nc_oc=AdrdLAcZyr1IoR6MpaoMCWMayeTPh3N7fzMnLua1xz5v850TlaWbJww41XezehYCJq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMnuqCL0yKYe6thTvvUvlPk7yAi1LyWcCRUuH5j-iQHA&oe=6A65FB82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsr5BcsHzmUQ7kNvwGXe0Wx&_nc_oc=AdrpnIxtmM8siUwsaV1LrsQS3GhX_ZlbLEqNhcLmUsmZYoRRyZ7ePmk-11NHWEdYSZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJqAnUzWEizOfZK4T9EpAEsEGbJvWkyb3_ESDNaQezDQ&oe=6A4D1892"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASZEwc5Ml3QQ7kNvwFB-85o&_nc_oc=Adol5vtgRJFFZEMwn52MbG0b86WlH5E1sZfS9q8KPdC4LBo1JILOyXZYm80YPgdc6hY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy_md-xVYpf37ggXIoMWkFkYksPj7jrs0LlQflNdVAtA&oe=6A4CFF8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26z9QxFE5jgQ7kNvwHAu9D1&_nc_oc=AdpZYkrmO675LSdXo4HRcSOIrLbqrvFqp1o51M6w7H6pXaqD_KZX_cyF7Og3ce2RkRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsirZi_03hWYgnTsuXHYmsOfFsW1_FGZo2c4zMs_pRNA&oe=6A4D038B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loHqmPDcYbwQ7kNvwFF-dbD&_nc_oc=AdqF23-FqELVc2RM7uT4O3FG-srPd-IJJdHOnxC2h1NDltJg9Ze8yyQ7jxhgYXhvi2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkEHRuB5XO0UU_H2NUd0c3KnV-AOp8I9MW17p1ad3ZEA&oe=6A4D138C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDJIx129Y6sQ7kNvwHF3PYr&_nc_oc=AdruL2BzRdqskL4mXfCsC5q_w03-kyzGy54-2CYFPZqlU_EECpbG_YlEPGYp6nJvw4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJy1EeWTcCsglJUjO3lx5GaS7xOB3-re5jlDYMU4sVhA&oe=6A4CEF02"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duC2cNhk-O0Q7kNvwHU5img&_nc_oc=AdqWu2JNL9-iH9Bp50Dw3meR3cjHGQ-e9JoRvk0ANNTk8-RDU4C5Ax_lUPU6q7Hcamw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZdigCP14K4yzk2vNWNIQCET-Ch3tPATy0VpBgdpdOdg&oe=69D8DC52"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afO-okzJqIsQ7kNvwECD7_P&_nc_oc=AdpgGDo_-AsSS_Fznsw2eWc5c9qMqHkiVnjjxv4KzYinEcf9zirc113gPis8tkAdt00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FlpSPiD0VR-lCN5rVM7gHtCKLDOGyrupZ6nIcmClZcw&oe=69D8FB8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krZuj7mrsSYQ7kNvwGFsJxN&_nc_oc=AdoGMx-ATpqZnbUMAuJbuth25-FilNr3ULMIyuLxnszX4BEahKCGLQ2Y5ps69I6Iyng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G5SUDU4X1O8NtIkk52Ryx9GzTmUn8dinm4IjrZW3e8w&oe=69D8FF8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uue18niCWGQQ7kNvwFliexJ&_nc_oc=Adrmdy9eexv9CawnPEKDHmIUdloHND818hgqBQDFHI9sW6EN-c-WLWrIhCE2PX0IkQY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gr-Ojx-FAq7n2FED88dL4UFnWQsZcUBGoxqy5yeHk0w&oe=69D90F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oB2EnQSugXcQ7kNvwE0lKTT&_nc_oc=AdoVhS9pVBsKMZYt-ytyqvx_vvc76GH2EsgZTdtMltN6ttGWcyG0605B7sGi4RRM_-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j0qMKG1xR_dS320wDhM5KSocmtl1OtZ3HpN1QfIc40Q&oe=69D8EB02"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
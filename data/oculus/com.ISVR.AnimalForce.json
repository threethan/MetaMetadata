4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHXLajzQGWcQ7kNvwGHwFOY&_nc_oc=AdobwYwQrxiY8NQ1Hncn8fm2cz6lhnpkAIVYSQ-2A8Dgt_h6oloHkDGSBIhW99woeS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi9Ub85NqTJqonLBDbBckPQhmGvbdEGVnep7DMSBR33Q&oe=69C66752"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y44FySKGYxwQ7kNvwGiuZTf&_nc_oc=AdqMisvhFZnTqpXOwRUZQdBuW4GOiAh7a-fZu3Ftsw2mDPhsfe_g_fBSK3L-cVeLw_U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTZhhn_ZpNA_FdE2qFQHt7bEpKktUuTkQ7IzGpDM1zow&oe=69C6868D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaN9G7HPgSwQ7kNvwGpVsYI&_nc_oc=Adqf09i1k5qmgEtM7dw_xKSTSzjOstw32hZUAV3ZMc_FZ-P0UodoybFtlRLjx1xbruA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyByii3MLYvlhG4uOcWyd39P7FVPWU6Z3B2jyShOfPrQw&oe=69C68A8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaqAtVoQI34Q7kNvwFpl2xc&_nc_oc=AdqHPZebiYwPzr9z0hT3bonLtqFxGb_WXmxwsOmx6ZyGYcWmEUKNkWgAg13ZIx4boQ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwgv4G8U4IcidaFXs7yB0sJ9pUBFfybRo0GozUKwpEoNA&oe=69C6624C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiUXSKx-HkwQ7kNvwGwJeFW&_nc_oc=AdpLotYt6Hb2eQeumhVGIfYdcK72lxaNj2GKjYtloUV9Fs2lM-Kj73Qm_VVJASxiK7M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfsCxGb1o1pCNflX6cjYQHJEEObk8AYQo42it49eVtYA&oe=69C67602"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
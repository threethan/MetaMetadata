017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr41oAVZ6bgQ7kNvwFiVXre&_nc_oc=AdnHZhgPeIpcPpMdkSgvSO9CMivFqRmfocih0FKC_bx9rzgZtTRgyf_bBrbid-8N0J0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_cCBRXamWdz8yQP_g5rpcPaGKRfCWpyuOsxBagd-N-A&oe=69BFCFD2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04Qi4lpUrZQQ7kNvwHmAiDc&_nc_oc=AdnEnCBvM2Rxm2VvWQ82OeaWuxkBJjs2lIPEIfVGs1TU0GT3hE5bI99EiDOMXhvRX6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZuXXpWUyKQU9eYo_3smhid8RO0Sc5V4lNje28Jb8N8A&oe=69BFEF0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amRxsrJvJYoQ7kNvwEes5Je&_nc_oc=Admm90D7Szdh8D9MKr8oUs1kwXprdkI477chutVkA_hzarMzFgFgiHnzTDPcd1ywN7A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmkwymzSockXNbPu7oHnT-I0glWGySV9mUXIFcFIgT3A&oe=69BFF30B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2sxQOMCTqYQ7kNvwH__YLK&_nc_oc=Adk9v5Q_N8tLiazU95kaY36YyfNozkbr1BDgeaSiHWvCY8e-MbWCUP3MUk-Bcg7Bopo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxEB4Uq7dE0UE650agci9v9Y0VOR4HWNUPHpXtFG0llJQ&oe=69BFCACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4AnTnMHmqUQ7kNvwEQFKyc&_nc_oc=Adm-pgaK4gmVEICY5AyU9EdI8flUO1U4kgvVzmaY1fTs8Un-q_bCBK6zPDKFBXBImNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxyMkQ-OeDbWZCUNNKTF0X6venzaiWE0D_XJ6uBAuYyVg&oe=69BFDE82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E8QuoUTd3oQ7kNvwE6V8dW&_nc_oc=AdrJE8L6tFZVgWsZB3Zt8QHnV2QhbdFzdAUvQgwgmo9rzqXyvWg5RY40Ij0C5ywuT6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ccgDkSgy8gwe3pW4E3eD_4LfCKVv0ZvrmH4I0y0lsNw&oe=6A26DD12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zcCQIWc2S0Q7kNvwFYPm13&_nc_oc=AdrSULBSIrmohYQBQlDK0H-jgdwhdmxym9-QCw6ueW6EQeSxNNRvxkXZeNZ58Gj91Mc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8I7CnBu5ri_UiZ7humky4RxLku3tpijIkkQ10JX8sSA&oe=6A26C40D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67bCkEA0mmoQ7kNvwFKwRjF&_nc_oc=AdrpAWLsZ9_-CnTWZdMV7obuBn2uGAKOpiUijPJOryqzpVKujU1CdJyVmtGcVHKkLKM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t8O9_rZXpJAtk3uZHZvXgkjQ8DxXch4Aijh2H-B0DNA&oe=6A26C80B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0I4KfBHGrwQ7kNvwEgq9ii&_nc_oc=AdoDvoEc4Yhaq4riinM6JpGgwkIZrXWg1UuNqLQ5Jzcl7jp59gF_SIIyZE2n3pwO-YA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87PQf9fOYhZTqza0jcuSeKONtBSzXPgnJ10tJO4zeYnw&oe=6A26D80C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44NXmHfOLe8Q7kNvwG_6ack&_nc_oc=AdoI7bLspcNMhUud9ZjP960651cZPsj9n1opUQr9Ij3cbjaey0ueaVScIzjMX1VUpUQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hAqqYPP7paqKGtrVoK9Wn_xdI1dvZq3qlkWV8e3wG8A&oe=6A26EBC2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
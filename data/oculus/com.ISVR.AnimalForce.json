4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Gq2C0Pjt4oQ7kNvwH5qqls&_nc_oc=AdrkJikqJ41-408twAZuDSWeOg_-7U91A37qga1QRFxcCU5JA4L9EDwkbHEQnfIf7Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOUFdZXGVnfCxpBZycQ0PKsQHP-WASvk47lX2IIi4ORw&oe=6AC26E12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo3Nry6kPgsQ7kNvwH_azEf&_nc_oc=Adqw-6V7VigsZwQxj5Z5MYLAqALCA0I6_cJCmOV-M9bVYsoi6Q94h67jl0v9t95IvE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnWXd0PsInqlPz8Vjast4rSMFtisVV94Psvry_7ls4uA&oe=6AC2550D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42I8Px_owhYQ7kNvwHlH-Ke&_nc_oc=Adq6ULN20iriBfuCNzprfL358v_wUe-C_VOdDgPXhkGsr54LvGDSQRsbYx8wr62PlPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBN8OrURNq2FHS0kANQ49iBr_-Ppg0A3zHR52_B-MRoQ&oe=6AC2590B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9V2hmc8rj_QQ7kNvwETFlNq&_nc_oc=Adp8plSOkpG1qpLlQKuu0IxUx1lTwIctX_8772KRHz1tUJv9vaRfcz1H7i0YNOi0-Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuzhAm8fnmjgE_N6qTQiJow73mYXb35JJdrrCUJmxZFA&oe=6AC2690C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bd46uYQ7UwQ7kNvwErd2AW&_nc_oc=AdqHyjKYqSC2MkQYa7dL_j0CaQHvtiUqVPFacGSJzykT6ZG05-Z3hqG-M3nOuvHhcuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf5aKX4hNP8Zr6fVDPrIUer-UGd_n6Qq4J4Th1bpaLZg&oe=6AC27CC2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
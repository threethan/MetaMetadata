4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcIPue7GiLQQ7kNvwHDKd2P&_nc_oc=AdrZOYtg4dsW6gz3Unebmg60vr3xsxS9t9O6_qIwVxitJsLfmq9M9qbQgEw6qEdKc9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtunoMD1nHR_FtaEJ940zDomadtJ1N9nrcIf4GAp_Ywg&oe=6AF09292"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiD7KyxCj8sQ7kNvwF0t8w8&_nc_oc=AdqzKee08eeIvsu502vBxTNhr8-95tGKKJWFIEebEOneHnaxuvHItEcPCRIKoLrokKo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbbCiGrZcZnNaHN1n3FOaEvG7uTPGm4qrBIDxw2v_XtQ&oe=6AF0B1CD"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5EoC_UxahxkQ7kNvwGI2IjF&_nc_oc=Ado6Ko9HIh7DFv4Ac1DWHYtO1W9EyQbTtr-b1T54z-8wZGCZhhqWPDKrVipD7tIadzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW6nXw5LIjEIY3v8ls0zfkDtXMAovb0e0P8q748dSJ6A&oe=6AF07D8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So6kpJUALg4Q7kNvwHSNKcC&_nc_oc=AdrrqZ2panACRfl_ayK6c1P4yNTH8GSbLVfe1oNTJWqqQ7T1ElIZ4SXaTY5Fjd_pqCU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0CnRKPbDlatEBFgpZ41sCjI_aXBVm0UC_REEu-2aEnw&oe=6AF08D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVUO8S_g4W8Q7kNvwHO_KMi&_nc_oc=Adq3_c8o0dUGc7NfuE2l4kF9qsVQXpHXg0YjexMUTps_afd4jgL7a9Cqx4WkYQwBWSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR0JCm0gAKuwoV9tBSf1_OKhqOwKOTzFMMKstWXfKVeA&oe=6AF0A142"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
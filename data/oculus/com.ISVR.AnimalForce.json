ent-atl3-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrtI2-yTH7UQ7kNvwH6y1Ou&_nc_oc=AdkkwBTxTbsz0bb4fk6Ndbo0d7O4tE-NEyQOxIkheVL6bM32_YSOsbIGLv7SDuu1SJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsTMmJi5avH8iWFFlHJJixge4tcpOHxlpZ2jxLeUbKhdA&oe=69A571D2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lf_unzRMx4Q7kNvwHFW2ty&_nc_oc=AdltAkfowDjd1-WuZLOSZ_s8xwjpSjkphncQyE-Zxq48-TL7pHq6AqxW0xWyWzetclQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfszqGtnUg2bsm9AFWr4P7MW9FOOpnYWkognAi7qV4m6cA&oe=69A5910D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maWcjUbd-q8Q7kNvwEKDAsg&_nc_oc=AdkC22mvS-LypgaQyBZj_1Dfr-eJHp1w35ECiNxe1SW960qIItRW-9WrAGCXAZZ9DLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvZQBa1V6OVIPJEWPaWr51KuW5rQAq7RijE_k6xrCe57A&oe=69A5950B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1oNAO1a8DgQ7kNvwH_-q8E&_nc_oc=AdnTMWctyIo3zt8HOfCBJCRUWwJtSpWluMZmR6eQ7bC1E4DHG8E3RrWyR5lyYQV9ioc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftrQYqCqJJurjue_oBu5SzHVIsTZa5-eIoPTfhf4CadEg&oe=69A56CCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCn5kCHTTKsQ7kNvwEdv6N5&_nc_oc=AdlczhhiLLP8Xr4jmpHTqt8FBxnfCTfouP-8GGMKsciejOm2HuPVzEkXEnCsWge27EQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft2Q7BIVdBECC-9pNM_9jWrH8WFJk0viB3EYWk5Fd6vnA&oe=69A58082"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
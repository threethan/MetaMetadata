4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPnP7iYwXRYQ7kNvwHNjqhy&_nc_oc=Adr7x847wGeENUbI8Qnn-gvQ0ED03r5XbvuMJBW63jpcBZpjND910f-OFCSzkiNecbw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiYn6QGJ09QHOGUJ688zetNSiGhOvnlENjZ6cTnVRNvw&oe=6A58F612"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bb3DR-Q_mgQ7kNvwHlqPwY&_nc_oc=AdoV7w7C1DkBhGJpIJyu2WmlB5jVWAyoR3SDs-gXRcqgmxplnum003yisxNDy9QRhn4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgA_R5IOyQWYl9X1l534-qz_I4b3H40ila5m6caqmKQw&oe=6A58DD0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nctme0BU47EQ7kNvwG3pcMg&_nc_oc=Adq9C5sNoeQNsKDJNjjiVe0JKooRTcI7y2hJsM8tACcxipF0u8eBKqVT1Ps_pFysqO8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvj1LB2y11zL2VDPHfPag3nLGu1Httw-0jg0bZW5OTbg&oe=6A58E10B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPs0UW5M-ocQ7kNvwH5y5t7&_nc_oc=AdrzZnYtmPmgdpEgM75nOPzglFqHj5C8gvZLBQkdt94rOpKlUF7CnacPhGQo5VkAwzY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvGcANCylHPaGSHTkeBpr97TVBt5K-W1eK979m6SMmSQ&oe=6A58F10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hp-_d1t6ci4Q7kNvwGPvM7i&_nc_oc=AdqoXfEl4emYNmsFL7h07rW-y8gTIswetJ7_6PNA7VQ4CHloj93uShemjqVkk60Mw1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOudR_qoojpqSthYEfY-VFpO5y0bVk-m5hqwgnZYo5BQ&oe=6A58CC82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
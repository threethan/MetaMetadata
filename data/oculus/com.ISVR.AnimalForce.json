4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxGdE6cjcOIQ7kNvwGuwh8x&_nc_oc=Adpw0tzEZjmDM90k3YpW7AdBIcZaqOErSF4GLAsKG36IjqkHTlvavgUW3e5QXpBWd6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3HmmhvB_hJW9AdCEZNF6EC0p8CUmPj6zECbAoFlPXDw&oe=69CA5BD2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_VvRDqBYx8Q7kNvwGwEoD0&_nc_oc=AdrW6AownUIvH0Kss2kj5u8Gwk5E4zEgnQWuaXbpU-8WT6j3ijSvI66NPFkwqmPpRVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSxtG2Lt297TCHHaK1hOBf6FxxQW94ExLJptiinIgulA&oe=69CA7B0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq2MTGeGPD8Q7kNvwHsdnIH&_nc_oc=AdqR06qWadR6NLreVIHl2RNqkIHMG9LTIWaBHqx0uiSCLDvkMwva8Xt_V3X1qKbI7xw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCKK7DqtBlHlKuqlJk-Cr7OU93BNBLjS-Ou8AIXBpP2A&oe=69CA7F0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkJkrP0KnyAQ7kNvwGNf1Ky&_nc_oc=AdorNoUMGHJ6LaRXQ8OgRnkXsC1Hr9taUpRmZO2z6xvC3YkdAD4mIYWXawNtTabKPAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPO65YKQ4fMvgqT5eExnyD1pnDrlAXsIwnqW7H0jjTdQ&oe=69CA8F0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEyOrAKuL_gQ7kNvwGYPkp6&_nc_oc=AdruMcFj4_40wzWq1Q01mYzzP9lhaM6dB0elV_NwwCqSMFbO8PlB47iuTap1tBIy8pI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAxlZ6hQzA-EcQcxqj2zcMBrMpDiTVfWodkiHEC10yBQ&oe=69CA6A82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAKtCNs73hAQ7kNvwHQQmv7&_nc_oc=AdroXJEyWmD7qpKd-m5Ms6SLlH1hHZ27s3xjQbXe89X-qDQ7jcqiUwX0QP6DCYkbDh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H5JB2C3FWqwY4aGVwtztfIiRX0aVYZ5AoFqBj4IYJ9A&oe=6A452F92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPSpM0q9uyIQ7kNvwFOx_lT&_nc_oc=AdrhPJQGQmA37X3KOXaC-XsM2qOYe-IizjmxAZaWg916N1gLNPjGJOpUpUFpwItUReI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DtLEPpbP8A2QPWIIVZbNXTOzLI70NGa_hzhPVnuQOXg&oe=6A45168D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwepCxtAK0kQ7kNvwEispIi&_nc_oc=AdqhCJsKXKQjeYax5XxQ0su-QjBXnJ7eyDNitJ23bWoSPxkv8YAVmPJdn7g4WYicPg4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9_Pnn5XnwlfyRDa8RRHfEqU6lc-GiDLFvECEAfrPI0g&oe=6A451A8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd8hJpiwndoQ7kNvwE87hCp&_nc_oc=Adp63KrmESuiyj1BpOHJePaIDn0LNqw3nhom4Fyfyz5LQqyTBy3myw0DDvKNO-53K8w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xtuvhR3vmAxejgKKAST2LcS15iUlLWXGQXHeRuMT3EQ&oe=6A452A8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gblqZtnMDugQ7kNvwFQRO3D&_nc_oc=Adqa5hecf3IXZF9MBxC4O1UWnjD7WK_ZlZgR14nNAhZoSJM_Qiwpdfkf54MGoKH7EZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6L1gDnlTddsKGeJM6-uJPadnKCgP_A2LyoReHwcH8sQ&oe=6A450602"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
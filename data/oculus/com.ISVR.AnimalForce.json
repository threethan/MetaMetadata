4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDlmKeEd3HkQ7kNvwF4tyGI&_nc_oc=AdqSqqa_98V4Hcwyz1vzik1UQ6cIQxkvRf2mKxdFJEPheESNrnUa7wNJIKjetPeD54E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LKtKVoXtRTXwl_WymJ6ovU196RIe09CDb6FudV5CH0g&oe=69E0FD92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWwjnMJLNnAQ7kNvwEDnG3A&_nc_oc=AdrVmFN5G7X_O4XFhOyM5R1t0yX3x5vqpnvMJEZYjnTQnK-n_IQ0-FBlDbGQtnBS8OI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0guyJl2qXMT6pfVIuumUbjq_AFxzjxIfLBiwvdXvGtVA&oe=69E0E48D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK3OyixKcegQ7kNvwGCrwo0&_nc_oc=Adq_5BolO9j9bHmJoxg4ttnnIaFg9ZBZ9G2HdXdBfQs0Momkbq17zQt9q2D-ruJGVQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_dovF9JfD9PGbQv8OQv3p8uJz-o6uM_zTvkGnlcEZkg&oe=69E0E88B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHEzBtw31p0Q7kNvwHkFHbs&_nc_oc=AdrYvUTBRhdcQLeGV1zAA-RM3DieB8qWLvqpi6AE6Iiz5r04109GvsWSlYojwnVzLC8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FHsUyaREeThwNOefC73Q_xpqTBvWisnxlBBoRuwaHXQ&oe=69E0F88C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fV7iISKWVC8Q7kNvwHsIift&_nc_oc=AdrzbAllW8L679qpBNHNkkdSHieylcbxhFyWqs88f9zPER3G5mC3FkpzTizCbH3cYLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fOuxxh1OkisnZk4akF3gn043wyeoH1X_Xzg44vLAdcw&oe=69E0D402"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
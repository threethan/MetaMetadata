4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC2uozB4oiIQ7kNvwGeJ9ft&_nc_oc=Adr8DUTf2vQV1PEWGC21iUEMLLvGSBBUpTM6UvoaXGRbuGEh0yldQI0Npw4T3pDSeZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrT9msX-YlKgXPol1GWnzvH72eXYCclJGlU6CVxxDmkA&oe=6A5E03D2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4JkTLtI3_QQ7kNvwEnqNlk&_nc_oc=AdpnQk-J7--ABo5yeJWKDLxb6DJGmhbFptbtNN4ZrmnbbVUK88dXsktKQ_WwfyqaDwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBkKifTmzDHK5ZD7AzgT3PwtjjsR5e3WtxaU2mwDPM0w&oe=6A5E230D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20JOzQK6izkQ7kNvwHKWwSo&_nc_oc=AdoYGKczuLX2G3wvzEUq4F5i2mLS8RZAsDsE_x9EuSx3X9oVjKFeWGPjMT05wI0Rz0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-TcDgB3mA8s0aWC_fUqtSk1jG64KxfiBsQExOXQuUxA&oe=6A5E270B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9iFrLMVauMQ7kNvwFYZ7wG&_nc_oc=AdqZxTRoTha-TCGJVR3zMUWMQ7rIaVGg1b1Xb3MvoybLbUQPIGcgJkGcx8VYoSrFz7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcdBHzlAZBcf-QVyNcA9BAfFxDFSOfUI_P9RwOg79MxA&oe=6A5E370C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hll6TcV-TWkQ7kNvwH9V4Cb&_nc_oc=AdpYDzBplknfgbxA3NAe7MLIJ2ViO_IoEt_DYyMd9PoSSsZlia3WwpirX9umoQzY2U0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnoKIBFAk9QYS96na85j8_WpOoEaa9saRGJqXaTuctIw&oe=6A5E1282"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
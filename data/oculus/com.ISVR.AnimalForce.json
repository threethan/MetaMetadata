4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVdl9yE2hsAQ7kNvwHHHTV5&_nc_oc=Adrsw3no5w5Tuzutc55pZ8nwNyGlMRmFkaUgNzEkIhuOugH3-Tw8wgXiUPWJR2izKn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BZj0TIusINSN4KsSodNu-3KmFvlVNgBeLiEOaJFkspg&oe=69D27D12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXskIAES1yYQ7kNvwHHjyXG&_nc_oc=Adrx5n0C_mi2NoB7JkQ3Ewgr9EF8BqoCAJbU1cv3dBzc6hV-HhN27ZB7Fs4SlBkUiy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1B9B2JjzvsHMBKX0AbxB_TjOi32bMrzkYfkD9BfgLD2w&oe=69D2640D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJJc27-2Kj4Q7kNvwHJdnop&_nc_oc=Adr49DlLFzXPGaL5xZziFTRl8BsVKYVjsmHMH5U2D9ZEse4ptct_Z15-m_u-q9wEsO8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pjMlg2PruiHg7SCkkHF54_Es1m0IzuAJimcw81gOAvg&oe=69D2680B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1xExTVcAlUQ7kNvwGr5oBq&_nc_oc=AdoaVj_TjRWufggtxyiENxJiehb5XDv-BjoOWosxeaDqniVxnU5STJe9YHphefxoef4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vxLYbVqNWuhW7l2gnBxSEXCftn_dlYTv32m732xjEOA&oe=69D2780C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkV1in-EsdkQ7kNvwGCyApv&_nc_oc=AdrAxA68XvkoDf3DbnlXdA3nZwFLtYICKh5i2zsAWzlIt2TtjemnksJbJbRybVTQ52k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UreiMI7QVhvrB_eFa3bG1QUENozJQD-zpoaol1bDB8g&oe=69D25382"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
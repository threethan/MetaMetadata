4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PalxyVd5k14Q7kNvwFCyuiN&_nc_oc=Adr00GhKr4ql-f8X1i8QuzCz1_PEfAgly3UMOEsHzxwsCfcUEeMJB5YP-3zajgmujwI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VDml1VlMJSCWLZee413a0E6ODPxZhHgyQiGyLbgaF0A&oe=6A05E792"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvVp2-vGelIQ7kNvwGwUVBX&_nc_oc=AdoAlB3NeqZnY7FpYaA3XbXcAXP0UyC_zFQP1UJ-vgsrNFFFsJvlyzvpYIq2U3BVTpI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WotDSUgwO7t4JOsbIB-Kr-C3fXzpzMvo9j4feex0aHA&oe=6A05CE8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k48ARHWLOlQQ7kNvwEebvEn&_nc_oc=Adp2_aXHIDjxi4RO4zgKimQL3xoVXhmu8DO-F83foO0jQgJcezJ0mXm2ln-UqH9Vbf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d22PUw80rmkAXDFWzpLfc18AcFbdM2nWLo-bjfv6eaA&oe=6A05D28B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quKMx3QaefYQ7kNvwHgn9Fe&_nc_oc=AdrhV8xcGTLq9BsWzBoZvSwrvU2SSPoGeX8SufZXw7vtu060KNW2s1ziZCWk1ghfNZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C8mIVr-ND62inspU5fxOc7TYO7SRtOs-pL_sFLEIlAQ&oe=6A05E28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRI5BQEpc9oQ7kNvwEopGT-&_nc_oc=AdqSHSQzw1xg1wB55AUXmCqASKEFkNmA9yO4RtDLBhVYNVJKA4rgK7nTZzILjbjK95A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45mtqv6RWPSuEGxWQT3KDqwSoMOnSuY1aKRJE9DG7ThA&oe=6A05BE02"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
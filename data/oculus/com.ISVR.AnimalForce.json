4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ0n0_FEhwcQ7kNvwF_vNJL&_nc_oc=Adp5BY0C60feBRRp0yzv_4Sa4Ljq3vEnXNbKxIvu20VY77FYCg64ehjEtEUnTtryKmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHzTOJzvSUoIshV-tsfv5-4Fkp6i97DyCz0yEDoQxUhw&oe=6AAFF912"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n92r2xO4iNEQ7kNvwGACi1o&_nc_oc=AdqVaAgksavSP7ZzC22_SS21JJxIysvMLcOgh1ZGhI3AIFBRKAzkozyGy_pVaAMa-q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnPTRZgCK3ztPyUvwrSvyrPs4Or6GL3j1xzVm0gVA9Kg&oe=6AAFE00D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SNQHeF-HrIQ7kNvwHLeDa8&_nc_oc=AdoJcOET57T4KgMmXOuTCW4XuqJLE2IzbECB4N0P6o_hjW43EOeqt4UoXpU_Xr9aKq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxjVlRXu3jOt6w8xCvZJDKpOl0LwZ6rIb9ZsVnh3Mf0w&oe=6AAFE40B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf4qXwaOWVEQ7kNvwFWjDRJ&_nc_oc=AdrXXTlPTwUPnE7LgGKE7DFS0BoEnc4iSSfk8KY_SJswx6xjn8smHkleifjydvCaA5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7HTha2ZzXV_AzP1Sde-itlcPYReJkY1ukfWCVQg9ylw&oe=6AAFF40C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCUAVI94oSQQ7kNvwEvlqvK&_nc_oc=AdoKJGxYDMe-Cv-_8_GvwObukRBx0a8vY155V_XJg5xiXl4TLJLIS-uLJNQld576HWA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLhajfGH1RFJoKk-0THceTLJnC02Qtr0kAng-G_7laXA&oe=6AAFCF82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
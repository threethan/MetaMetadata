ent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrtI2-yTH7UQ7kNvwFQHJaX&_nc_oc=AdmkmpZvjB5twnRb0i3vi1HcMtcB33HsZKctDb0AlkiMkX47dE_tdWSRV6PhLIpgLTI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvN2iK7n9KjSB774mqxA3BVwJ2BQEEtQvEvCcoEVsq1Hw&oe=69A42052"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lf_unzRMx4Q7kNvwHLoNv0&_nc_oc=AdngFfMFT9c08WViC3haVtkzFiEbRWrVjkae9ANVed_LPWeZJ2AUw3xxGMVLNb98BPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs38_QvxmEnG5L5ls2Ez37MWlKOrbZp20thtpS8yeF-eA&oe=69A43F8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maWcjUbd-q8Q7kNvwEvbPc2&_nc_oc=AdkRhbyBdPoeM81AfS_Jr1YQQkEW2kqmM30cSesOqV7szrxL5xwhXTRe48kwMqOD098&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs5TmKSL6CXVOTmeN6duyQhWNUTy6RNW3TqaQbW5v4jvg&oe=69A4438B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1oNAO1a8DgQ7kNvwGbE8OY&_nc_oc=AdlrrghhUZkY3Y-SQgRiTY0A5HqIgsCNoRX_2fKdcBbQZxSTjtovojrBKmeEolmMJSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftz6Q_m5haoSCD-fpKho9qeLM09pWotZGhIZSMxnM4Hzw&oe=69A41B4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCn5kCHTTKsQ7kNvwHtJash&_nc_oc=Adk_Ln_wLNYQ3nwl_3tMrQkJNZ8QASgF3cezlXJkiYGeXQyJvZrRmMzYvTHOikfoNPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv1re2q7XzHtAO54p_eCDvbyfssLT5cnkaCOE8OnBHmYA&oe=69A42F02"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
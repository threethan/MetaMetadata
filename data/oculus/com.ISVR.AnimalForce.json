4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuBzgMUYgKEQ7kNvwHGD66U&_nc_oc=AdpJNUAy5nJi4NIEpQQVMDy9_dE0FSuFCEt6Dhw45uzftTiaN2nQB6rTbnJFsR_jzGg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88WlMqgxgkf8wu3iNFxDkLQ3Vf0vEDGMaozbM3afdRQQ&oe=6A243A12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFR9HqQJGeIQ7kNvwG_joxi&_nc_oc=AdqeS-wZ_W-SSpEAg-vQ1SHlUoEFq1U0LGR870LBDd-O57vWRndsrrtyXoAR4DykcLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D-nqMTb5bY0QJM0rxyMqXg8Y7xWj7sIyvc77e1QeQNg&oe=6A24210D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xcbl3DDb8x8Q7kNvwFO6bGl&_nc_oc=Adpgy9-9AA12sCwye3HAcnttOOe4LvwcN1m0u-RanMVuWFhuuAzwOIr2Pd7mBdtNicc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T5JQbixoxWhrQMy5tClkWM0R-rzkyBvK5SOZ0aW813g&oe=6A24250B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkwEqJmQvu8Q7kNvwENPE8C&_nc_oc=AdpBapyXC--BQkZlBBAzJ5vE3_AT6mQVQPYPRbgv0HffmwcfVhvvmQHSNnAFcJ6WHQI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IzFboI9Qa_5FwC8S6yKQ_Zn3KHwiR8ZJ9we1sIm_bdA&oe=6A24350C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZgSI55oxCEQ7kNvwHXf6Q7&_nc_oc=AdomKBn2eMyUfJVe_SuqEhBn160biZ95AgRmb3gU2OrL700Suxu7YCQPuMQlk2ZpkBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dvk2sDxT36iDJMGLsPsbLL4WzoMZXx239EhFC4gWAJw&oe=6A2448C2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
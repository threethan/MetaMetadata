4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j_syjOJqLQQ7kNvwHWCx3s&_nc_oc=Adr-UdPWD-PuLacsnAAHfuJGq8iDHiZ-krK1jxBsc3uslj7kry92JDBvlBSvFT47VIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rkVsrd3YGxP0Cgs81YsiXhtU-0-iRs7RJtq64_Z8BEw&oe=6A19AE12"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRht0eCljFUQ7kNvwG_hS0m&_nc_oc=AdpMc6Awu73tyrfIyyt_v2hHKv6ZCGlPU0NQ30xBJ0Hfz-c7ykaBI-FpmoR8llWFSwE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62d0ddlwTekhOpK3SXihO73Tgj2H1cS-P1cv7-P_Y6pw&oe=6A19950D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMOeVEJ_vWoQ7kNvwGaz6b5&_nc_oc=Adq01F01CPurZAC2ZD0-F_at0hZSyLpFkdUTKG1E0kUfA9AIbHHwW-WFAFSH3rxoEGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x9pdUgRctlCqx2dI8hCKDt4EDo5JWDwxVqO_TO6od2A&oe=6A19990B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWAtpGmPODQQ7kNvwF0ggDs&_nc_oc=Adq2mTQnDXAgOQYk8SAJh6uoPF6AYvwUYnFMEaG2MpY7vfRSyxhxbsgquiGjID4grso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f2onqhmEDfM2f9ECeO27aMpgtn7m0samRHGXj_0YOdQ&oe=6A19A90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaSY19do4NIQ7kNvwFr-pVj&_nc_oc=AdqJgUUrscI5eAF-xjShCP3sg8fHkftuUqPgCcLz9OJ1Yb19cFOJuFXT33BscnnDO4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gm850UaL4TphJNjTGoWLdje-NohsTbhxNnvzog9DQXQ&oe=6A19BCC2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
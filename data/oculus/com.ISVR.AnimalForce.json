4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFPhgD4XJbMQ7kNvwG3C_-Y&_nc_oc=AdpBUIujePBp_Eu8TT2tNGZvl9psB1Be1YKmi_oR61MePCixqUMB-lAWKuDQcv8wwgI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AFhQ_YDScn4q1LvUKt40bbFqeONNdUC1PMm7GRsvkXQ&oe=6A107392"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B5V6LL1_toQ7kNvwGaE_Rb&_nc_oc=AdqVJ2JDyraEEEIOHpJRlZTvWZmEy-Vyd92uT2Xgato3NYdvZubLfcOMVtrpKD04JNc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vntLDZnkgIfV-NGSvT0hUfhQPBPhFN3BsmAJG5IjVag&oe=6A105A8D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjmAw93BnAYQ7kNvwF_L5ku&_nc_oc=Adqn1mqWmYR3jE-iLnLoqxWAUnofmMocTsBwPDt_r_NHhZ7F32Yoa8WQovyPANlqe0o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zDMTdAV5UGHRCVgQowCmiNl3_xRBfCjAdCUdmHuyA4w&oe=6A105E8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8RIdni6aacQ7kNvwHeOE-y&_nc_oc=AdoxOfmuOtO_cngv6LZIN8PmxIgRpC0pJm6El18chRYHN7WWl9R9Cv_ofyYNkHbKHKA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iIlnKffhhZWIxv0igug_32jhwzMxuER45WTfrgrFVfQ&oe=6A106E8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBI9Si2cWboQ7kNvwGFJVms&_nc_oc=AdplX_l-KIlGnfpq52Yeh8NV2Coyz-wlMJ41l5_g8vUZ66LyVNJSmnlhWY-O8eT0TpE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TGsQM15qTqnyKkQYnNf95Q__C8ZVp3Cmorwbqc34bUw&oe=6A104A02"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
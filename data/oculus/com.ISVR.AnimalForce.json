4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g9AqCvHc7sQ7kNvwFM4bEo&_nc_oc=Adq0aPNjMf6t2QPeAUPrP5iI9EC58UZ0OAPfo4WwK0N_ARVN7uCbUZKoDROr-Zh2oSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTvIy7jLKS347Cz13RXFMfeXbodPgXSRdfbXO2RA3d9A&oe=6AB7E212"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiy5EKZ2kkwQ7kNvwEpFFqc&_nc_oc=AdpWjhK7TQ4FUO0xio7h7kor9mteUar-6VEahcYYsmkwWcCjfrgR6FxmUIDIfN1G0QU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEDmE0vZ5VPzHLsl7gSWOGrWF3j3sEaL0lPy10CMe_EQ&oe=6AB7C90D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRlq_WFnOk0Q7kNvwGrljkI&_nc_oc=AdoHDYNsBgQCfpca5VTMYvl-DXTxp0fLQC5ZaAXvgZohok3P-jtLSyEYT0F9k_5r_5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9p5wGq_6NwmhLDyZW1G2gzOFJi4WKZVbq3B_n38sNiA&oe=6AB7CD0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0eJV4uvaF8Q7kNvwHSsXTe&_nc_oc=Adr_l_vC44ALwPiObWfOiwsGa8lJ-J81uilMdV10cTzMC5eKxOQVUAN3jviQg0QMK80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn_xbYGR22oWqsEG8t175KavuO1oDC5OceupdYutNGJg&oe=6AB7DD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vodGJu37WGgQ7kNvwHYkyba&_nc_oc=Adpy0ULbCv2oZnleh2Lf6TeSf6dc33xZsGo-f4f1lKh6L2csrfDA0CFKvkGxXHnwBcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAzkzn0uwRbkpz2WGENZCWZ83luREiOJbaZCyxe9kMuw&oe=6AB7B882"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
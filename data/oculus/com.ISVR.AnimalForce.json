4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgyvwnVHU3kQ7kNvwEzs8OC&_nc_oc=Adp3gH-PPFeBtjsoAVbbanw2U2CSYqnaUk6IpUm3UQIE52WwSEDWdPrZ3tQ_zWeR5ew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e_DQ9KJI1j_IMuOn6qE3vfryewanZQhJVtAbM7ogC1Q&oe=6A2AD192"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNcoldpHrbcQ7kNvwF0AMyM&_nc_oc=Adruwv7rzpW6VQgtTPAkVppgJdyMw25fYtRHiH-nHAnb7EZvftbmtzxNEbj1txgntJo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CWi8kd0KM1MmWZhlCYpmmsJMRwg0tbbxbnNQO4hV-OQ&oe=6A2AB88D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkonLJjIIB0Q7kNvwHCmp0b&_nc_oc=AdqkFVT3YPFtNyox996UzIc676kbOds2WZkVbLp2efQNY9irSzcnedLfpc912aS9Tp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_w4XB2oGd-phoZKczZOGFIuwpWnBVt0Pcb9JEiZztUA&oe=6A2ABC8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xTjMBW29g8Q7kNvwEQWfA1&_nc_oc=AdpeR9IYqzKX51Iuq9C4zcR2MYC6hutKHbgBvnLkAw5JNZLQ07EoG02W8FwTt63EIpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t3RViGMSIf31fWVxQNctvlxZAjEH8DYHbrLhCH_nsmg&oe=6A2ACC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6lj-_163WwQ7kNvwGn_Cde&_nc_oc=AdoGLep2cOCh-RH4qkYgK5bZY4xI3w5wKmKt9w4QsnkbM_7PeYJyC9pLNeUpWWTr_GA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WiDl9fnAe0NpdnuiQqIb6XvjUAfs9pcBj33LylzrHXA&oe=6A2AE042"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
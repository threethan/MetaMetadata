4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1xGPxWcM2MQ7kNvwE1g01T&_nc_oc=AdpvyF0gZEVvcYhjTZgJRtw5fPhxZ-CRrXqaCSD8NqVldHn49bO_4CBiVefzkOVTDGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQKetI0dhyjw95dK6Q2b1BdFK5feohCTR8hzIPDqnusw&oe=6ACE4B92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDABpIIBrYoQ7kNvwEHk0od&_nc_oc=AdqKrxf1X7qRO1Sl8z0Lc6-x3gqcbgPpTNSC149aUsowB4axmKrkjJMyzfXql1VrCTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBZTTMdpbPQPMcPkwC2Gm7mHWOA5umb9I5OhV2ZsKe6Q&oe=6ACE6ACD"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0kMBK_MdyAQ7kNvwEpCkid&_nc_oc=AdrhgB0T51wLi8-5L0LVZgsQWLr8NfeXGLJan-tH32_087R-6aKxi619HtZmiDxAjgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCqBGdtvM268vUYPIFZQ61RaptV4RU1_Nis3SuQdssGA&oe=6ACE368B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDfnFhxyDe4Q7kNvwH9Llm6&_nc_oc=AdoOkZO5l1slT8bqqRW-rhCEJY6kvurVBx0llsRwLaXWeUXtbe0hb8sYOs5dHbfhIPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmECJheTq0SX2FytK6IYejseg8TBK713FIa2zuJHo50w&oe=6ACE468C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkr89fgKPhIQ7kNvwGyxuof&_nc_oc=AdrCv2nu9uV0pc9oaRCA9mkkfT0Dh73JzT8xE3fLQOg24s1DiTn1m-lg36gbgHx36v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTnCYo8EdM-lETJ1z5FKbouGTsLSVc0IxH6CW6jWoQWA&oe=6ACE5A42"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
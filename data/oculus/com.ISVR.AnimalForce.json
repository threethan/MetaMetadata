017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5TLNmOQhqkQ7kNvwHtsHdV&_nc_oc=Adk3pX3bxG_dpjt3ZOjdH28oohuprNzcF-KXt3XHskn77GaD4ZFACRciXYZ6dpFJGwg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWtWk9r_b8s6vLYu1xjIN4Gy0gesGcMepbvcjs-BfFUw&oe=69B2A0D2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAFkH_YlvVkQ7kNvwGgofQl&_nc_oc=Adk0bB8D8eWkQus6ZozH0JDURY3wlMJlsvAAAynTWJVFnHvjwd8m8oP_9-VyiMQEWP8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVm7pPhIObAnTQ6Q3tq9KKPBnCWXYo3FfPuSNME3HZ1g&oe=69B2C00D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhN9DAsEvTcQ7kNvwHT3fQ6&_nc_oc=Adl_lCLO6Cdj0fvkYjbCSrtpFZxBvk5Z-vb0vxHkNCNEIekBSSSCyvrys2aAd0ItE2s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCHvr-7oJ9fLrBYoqR5_Su95i9tmwdvPd_tpVezSCCag&oe=69B2C40B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4O4LYj3xvIQ7kNvwGLvd9o&_nc_oc=AdkbVpfnHo-C6zwZKFZzNmMp2JcpL4cAUvuLZ72yh8YZh96eoMBN95Jx5WiRYYTVGyE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKDJG5zUvsfgQwuN_8hK3Db0XoeWhqHeLq9a1_Wj0bfw&oe=69B29BCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7OiCqeQmTcQ7kNvwEYWeyK&_nc_oc=AdnHu3cEFGjDoFgB7QH_UYMYd5V32BYzd6IY0xniyMeqdZYori7CnMpyIE-7UdG0WCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyD0QJ1xjLCVCPLIbX9H9gXZvgoO4tlLWj5fbt-d_hSog&oe=69B2AF82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
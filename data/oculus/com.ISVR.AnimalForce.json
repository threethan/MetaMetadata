4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_j_syjOJqLQQ7kNvwFYLE-T&_nc_oc=AdpmrhBN0x-ZV-BHma8UY2Nle0MmbE6F6r7sEI059yIYG3ceiqaLrGq8ata9gU7aS58&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g8K7K5rvEGBfydmXme2hlw4cm4NdFcfuzLG427mbN4g&oe=6A1AFF92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRht0eCljFUQ7kNvwFGdRU9&_nc_oc=Ado2sRcWkv4RN2iMPkMUm4TtX4B3KmQUgMI994DyvNfucBKc7E8tCusd9jPjhKAYWlU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73GWhKsFdfhUngHka-eQEehv4W_JkzhyjgvYNB78bq-w&oe=6A1AE68D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93KgiaMNf_AQ7kNvwG2wBDR&_nc_oc=Adpz6-p9kZ8s_9fxHODSi-FViR6iwnNn4CZ-O0FHy2fkaDEWrseJRp2AgDXLJ7EieDU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ySxX4ZHctE90n1XNyVSH1MH8nLLPtVmi1g19Fvdzgg&oe=6A1AEA8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWtTWR1C8zUQ7kNvwEhTWz7&_nc_oc=AdqdRrPlQ036R2bAH-M7jYvsVhuJXvKkl25dtD82SStEdW1e7IwjtXLylcvemR5R0oE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63CGNOKIEz4ST4AnxTLysvm9AuUwMefj1TlRTKP4ZXHw&oe=6A1AFA8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaSY19do4NIQ7kNvwEMSiKP&_nc_oc=AdqQsr0EDpks8zB9WmddP5tZfRx-a2zxrOvYObbfjyJOwyxS-KJPwjLxYH6J7Ah_t-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hAhChUhyoDSdv3C5RV5hiy48vGwaeHMHbKNWQZeBQzQ&oe=6A1AD602"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
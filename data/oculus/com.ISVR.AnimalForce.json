ent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQklNrn-upwQ7kNvwE_CVYB&_nc_oc=AdmGZIbNLGI9iFbwGWAv3alh9r1d0GLRybC9lo7cxdSNLB1FZekx974Kl5Hb9GmRLRw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft96NYSM7XPvGqK5rcewEUJkah9lockmy3TNguI6T9EyQ&oe=699AE5D2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7Ks8cPhp4sQ7kNvwGNecZU&_nc_oc=AdlLkDmMj5Kt2gj0-FCJCXeCBSSpE68L0JOWr-ITxcOrZfc8JCr3d56eWK4CwGKRhjk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv5QWZQNcXV4KXEI0CTNpdkgkx4q6eB4qH3UP27-aN35g&oe=699B050D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6g7iQft7RMQ7kNvwF7uxg4&_nc_oc=AdmJzd64TZ5b2hctUXzLUG-4kW3gM_wNHoZe5xwSl6kywORhvTE2wgd5YSO_o_IzWCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsVkc0sekxdDziY6EyF9aoYpdJdbtk4tfJMOV4LsZwmIQ&oe=699B090B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0UU2OqeBk0Q7kNvwE-SxZD&_nc_oc=Adm49WUuiHGFOKMmZOFLVoKZnCbPNwlQu7k0PaWk49Y1BdwgPTr9eJ7dWEUyNJg6IjQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvE2eWeHeGxxRxdsffRVTALy_ZFqQtPdUiAc_fFdbbpvw&oe=699AE0CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzqyY5qVYVAQ7kNvwG6kFfB&_nc_oc=AdnLC7z7y5-gkGhOzlfSTRg-VKYf0xqjdFOSEik8U-X57GyxWGyxKbDkg-1qWsQF8bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvREZG7ReFZz_zLyhem5oHwkra8ECjnqo2R3Hg8O2Griw&oe=699AF482"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=451A6tJhFx8Q7kNvwFbeu2q&_nc_oc=AdpsAzuqw0u-dYl9tFvSmiqc7dGSF9Cv3jGwrrCxMXWnKz5HGqTcC7huGxzP3AxhKJQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnnz61ytOPbJA8yUHli-x1IeWOA3D2V8JsSIQzt8Copg&oe=6AC7B412"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tp00lgti98Q7kNvwFwQa4x&_nc_oc=Adp4J5QdTgOz-Baulb83ibKbyGwiPp46M6hnIByzvkDUDITRxSyTulg8rl5n9RFeB3Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3ieCgsXVmK4j1xARkf3S4QKxppiZE86O5678MD3tLjw&oe=6AC79B0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cl1oRC6dL7UQ7kNvwHqk6Gv&_nc_oc=Ado8XOXhl2bty57vIefynwFAjlPPKjkAxFRPRY6wzKj_fScKN8JUQKOo1SNm8T0GOr8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAdsLmqJIsL1KjXjbIZ0uZaZ8bXlPU1wjmJiAWCKm-vg&oe=6AC79F0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTy0TmHlQj8Q7kNvwFnFlhB&_nc_oc=Adorg3BIUtCDVWLW5NiNw99QxClIz_ljF9Z4ccindamwo1JuK-ufiWtXRHPUQBFKSQs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPihqNeot3xZvLsU2-ybxLBLPoQ4zGEDVK84sPA6aCLzg&oe=6AC7AF0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBXo5Vtljj8Q7kNvwHHAFjq&_nc_oc=Adr41ZdPu5tR8eUyajonCVLi5zRqzRUGmuP1FhcWtpXcCtsb5ph8Y-o3RobB9poERWk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS0dKi7XKQQyc3tTD7cH5URV8CR8rqEQbb5tXJUo7hRw&oe=6AC7C2C2"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rswreJuZFrEQ7kNvwG8Snwa&_nc_oc=AdqPMvB48IE7TunuUVbQNaCVIWg3QrCyB40vf_3sp-RTSvWRQWSeQkyH0LSkwel7INA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7nPay8cVLlgUTuSd28gdCp7zbi_JtROYsP7JMUHsudw&oe=6A550192"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeSWdAoUL5kQ7kNvwGNvsEd&_nc_oc=AdruA5EGpiYnRcINt83gFEPwZ_i2X19sX-jYWJ2i4o-BgxW0QUmreonE7NVrz1kTFLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFAGXslPiXB23VCfwUqAxiiAklNTQMAtT2hU4rRZEldA&oe=6A54E88D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7asFCdBbLtMQ7kNvwGoFNM9&_nc_oc=AdoUC7ZZgL89mZoPRZnlzYu1Xl8jc1GnJedTA0aaD9P__FiRW1GZlC4WdXyB7JFlJy8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0Lq78SnP6NoKfZeWv_Dyalrr26SXZLnOAM2dRU2ZVyQ&oe=6A54EC8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olO9v4xA7AUQ7kNvwFhwCRD&_nc_oc=Adq6RdLOcQ0Nd73ys1WjPO1nihItESZICrK3FE6Ry3vfmY8fMAoHnqKVtWmsn9yCsTM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr_RkLsdVT-DM-Y7TRbSglWXDiqqNxzOKk0-xw_AcHPA&oe=6A54FC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcujd7FbLKoQ7kNvwHnB3Eo&_nc_oc=AdpMHxa4TtoVa7A3QgIgmRF0ygdu4wdocUlrc6HeJROm4UsPMUi9Rftvd_yqgKKzGR8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCu_-xSO-YW9PGJEedLYVlo4t-3KdDpe0c4kSoGmtDFEg&oe=6A54D802"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
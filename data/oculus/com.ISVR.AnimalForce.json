4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWX-PfTbxr8Q7kNvwF-p05B&_nc_oc=AdoGuuaDP26zLBK3fmm2aLwBjcfUIx6VgJyum6Q8Sxf--oPawhxX0Sv-LXf9-Q8OxxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzTrOTHgVGz6GjB07LKQMRDWRsdu26qkGwq1pWBe_Phg&oe=6A804AD2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYdJXv3KuxcQ7kNvwG7Ve-1&_nc_oc=AdosVUDCpDlpyZ_Tcg8w2RBtSNzzPMD2sMJndCRSvbCnsziAjldeZH63QQTap1Wky60&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8IEuyzLVh2q5D3QW9vww6HqwA1fftjjE8ovZAj1OoCQ&oe=6A806A0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCixo1rps8gQ7kNvwHfL7GI&_nc_oc=AdqgKgxQ5qPgG_u4shHVHo-QhyC1Z2h_bHJCa4dRyi9Hs8dUSu6H5d8RuxApTbyWy8o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGySCLqmQhYDaQOfsl-riCI8uiTgKokh8-_7kSmb8djJQ&oe=6A806E0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMDDI2IxmpIQ7kNvwGMx2L-&_nc_oc=AdrH_LlWvaWegvsnGH169Ok_md2YsjkEXLBlo9x_Leh5wXuKOe-WGuUyL9U87Eo1vgc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSMAANI8jkjoV99NxyVbZK38OhjE-O1bt1rE-PIhlD-Q&oe=6A8045CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR8Z03ZwzAIQ7kNvwGZk9Ya&_nc_oc=Adrkb9dv-8zELHO5E9zjkXTeDcEy4L-g6yjf14fRDl_bVgskHHoYvGyqOH28YMPWBqc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcPIn84TIBoSmu8wLo68ASMZJr7AKlV4-SRlzFzdc2oQ&oe=6A805982"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
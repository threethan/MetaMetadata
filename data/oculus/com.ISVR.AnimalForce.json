4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN5RAIXsPkMQ7kNvwHloJs8&_nc_oc=AdqMrc-RewcL9NFbxU_QaM2FDm2XbN3uhkP2aSF4Uy83yMc326eHjxE2Y9urpkriUoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzL1LMcabszR0LMRy9-KEok3JYrM4SAfwCTnLugDPV54g&oe=69D0F352"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LkY8WhHpJQQ7kNvwHludFa&_nc_oc=AdrVkZDJatOzVKrOXmgNj25a_UGyjIgLtP2H5jWpZivozUtfWFjNVqTAcIOqGjf-qBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9MKGLHnDWnUMCmOfGKdLXOpahrs1HcBhoh15Eb1AxWg&oe=69D1128D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJJc27-2Kj4Q7kNvwHkNH7I&_nc_oc=Adq2_oXZCInSN0vJr8tgt9P0wH4-W6_3JdjIfYNWwAb6pc9uFRY2jK8hwOUWwKhVb7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFsP0YoiefLBCRqzoAsXl-Szi6TP7jBP8ngTFZh7C1Eg&oe=69D1168B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1xExTVcAlUQ7kNvwHhuYLP&_nc_oc=Adq9lOvnTNG2vmtsGqX1v4YDqoVZnavUxZxjPQVZdsJJKgnBAUVpGfkjd5eaiGQU_Q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynjY4m8Oz_NNu9OUobnwAQC9ceIle-dGBybTYMX7NgPA&oe=69D0EE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Uf3gWtygKIQ7kNvwF8vama&_nc_oc=Adq5Jju8Qzfq81ZS4NDh-odT-Hy21cyl_Gy0TtcTxzUgOzk5nobzY5vsIH8rOheiyoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvKW-EY4LgGYlvE4XC3U802Cc3ct9meGsRrfmLj96yIg&oe=69D10202"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XICA77NRLrIQ7kNvwGKVFlT&_nc_oc=Adrp6q1NVUd28Wrs5GSF6rm_sDRNj3SSyx5eRwBlI04xzl5adEeo48guBy1gQBMWYVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_wCrPTd6F8JPTLyRDlNiRzStAGP_jLkg88CicYOqBOA&oe=6A1DA292"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LT3IrReTugkQ7kNvwFF1wCR&_nc_oc=Adqp8DxrXPakYi1RRurZm3S2rJmnTecN9pqiwFSj5bbFgSDyileLOy5GjyOqw0t1skI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JY8nYY7MzXZFWXfAVKRYFLlfkd5HgFV8_zw8oRin9Mg&oe=6A1D898D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93KgiaMNf_AQ7kNvwHB7pMm&_nc_oc=Adq6em5rPfD-fNUJlCTcpKPS24qKE2ThGCEnidRrRpjIZRyaI_46Q_4lpRZBTcpz0y0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oqZgtNGDPQDxiaJ_lyae2SJimYznyRK_5YeVX0Aqlig&oe=6A1D8D8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWtTWR1C8zUQ7kNvwG1Rvvn&_nc_oc=Adqkfk5nzkhdyRuhB4QHKF7Arv644TSUBrHLzLTx-X-cot15GuktlZfvgSpcq887Sv0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XfjLBig9wR3EOeuFlIayVLhx3eY39QSgujKF57qR96g&oe=6A1D9D8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLnOBO1MV4MQ7kNvwH4JwNa&_nc_oc=Adoc-apjN1P85kBGIo1jnEM02IJZJoyXRk7_YvHgJdONTlPkOGYA7rZO37gYgkA2bwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nBjY2pw5V_0ApjIgdit93s-DLveT0aY3CPDhuoGJgOw&oe=6A1D7902"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
4"}, {"file_name": "Screenshot_2017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIYYYcfHM1cQ7kNvwFnZ4ZA&_nc_oc=AdoM9h-lX2MPR4f2ljwvrcftlXGg6LNl2E0sj_ur2nbIK8c12MH_rlOXSg7pjhEQmaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhHpkwDLE3Al6zkcs2Oz0Kr-UcY-XqbszISw_VdBm5kQ&oe=6A92BFD2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SMmW1QSbnYQ7kNvwFg-30x&_nc_oc=AdrmyUIGDZOo0ZqMFzzREhFVYhVsF_Ido0Z2JhGYZTbWhX4_MmSisgMk2CitAaKrFCs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy6D_K3wbA4l1C4znzWg9SbhPGnPKf-b8eY8v638E5mA&oe=6A92DF0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol0FKWJRXDoQ7kNvwHdEnfX&_nc_oc=Adob8-dPgCrOEXnIv2WHShC4_l4kd_tzr0Z2s-XbvaL8m9xzB_Fqt4t5pzD80dpg240&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHmQLAfHMMTRDjo95XW4vrH-5gPmpE4_4OxkX1iabrGg&oe=6A92AACB"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70JBOxoaWsUQ7kNvwF1isEV&_nc_oc=Adq5kjjF2rQ0BNbSYPb4RJqvya67o0Yyy6_o1w-CeCKbsmE4ievF9u5zAsFcr7PFqDY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_pbzGKuKZqacPVOpkNBx4tgAie40JXQMK7tOTBuneg&oe=6A92BACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFU37wZMBAsQ7kNvwFZ-KoA&_nc_oc=AdobqvbFOnAOGi8J8s0J8iZRZ3150AdJvIeJPwfma9LN-ofwDijaDh_mB5kEU1T6Z5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCEcotB86S4xi0a6fjl8rWG8Q-RZI1ecUGj-TptiMzUg&oe=6A92CE82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
ent-iad6-1.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD30F6dxRS4Q7kNvwGnPEEs&_nc_oc=AdofUMTbHdGduftc_P8HlwTo8XDNtsCwcPELnGEqVG4RRQ-zzkWKHgLb5a5prRppEzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0LE7tvixNfr7hrh2_XMV3j9kTnFYIl61pvnykgzosHrQ&oe=69F0CF92"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtz5H_zaFOMQ7kNvwEeFZok&_nc_oc=Adq-O0d5GMBg9Wi57p4ra6qt93QW9RcZzQFtZKy0Ln--al0a5NWF-wE7vOLa1ZRJSqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2Jjr598nJrzpE0sDTPTPu4lw2rt8kMvpn0ynIILUvlUw&oe=69F0B68D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWf7Pxb37pMQ7kNvwHHq1yx&_nc_oc=AdolXIgQuLMieO0MIcm7pNUEfQBILa9ux3sH0xwDnOw0ohcQyMbUGp6zfcTa1iz6Fpk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2Ewlk6Lx6YOQMOrSOSWP-S780tzkrjn9xHHQOiSmgZAg&oe=69F0BA8B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrJHGw7xjvEQ7kNvwE1fVfh&_nc_oc=Adrcc5f_soa8er6dBlqOQ6GdeDJeDVxOuI7T4BPA7eDA1KDdTG5_M7_DCU_bZ-A4G-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3naeWWB_FAIFJF53twKztjJBbuGO8856BUw11pOKy6VQ&oe=69F0CA8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8V9lyaIe-8Q7kNvwFBm_uL&_nc_oc=AdqHPSRkUwLTMIyWLGb-6cXLAtOl-YflZ1R2q8pTLs0gT12RfrOPxbp92F-1-aMonqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af17Z9-mu3AIUueW44USf-u_nUgbFcJTaY8U0ckhu-cVuw&oe=69F0A602"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app
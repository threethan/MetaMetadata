_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lf_unzRMx4Q7kNvwHRjlB8&_nc_oc=Adl1qzoICq1Jfy5WhSRzJNoqnb7AJRNSEmw8qVbKAD3tA-XPd4Ty9f__K0BgK0BHohQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsR209drp8chrewb4ZfjeBteVzYhb40GHY3H_rl0i_cBQ&oe=69A2EE0D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=minbXrv2-3oQ7kNvwHoGbM-&_nc_oc=Adk3bqMakb8WL26sZHN-l_tQ98BLeXnQb5FwKFeUvdjfkvtWwGANhECAOHEc5WmLRH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDcP84ITF7devatKzfx4rd3DfBDnXz29wDfZYKjmD1sg&oe=69A2F20B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UOWxVNk7iEQ7kNvwHS4Uc-&_nc_oc=Adk_AMEmQRdCfr1jkkwr0wKAsCMgQIABLT6Mzov-s9vGvoQdX10RlnssATHMUegwelw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbkXZx6un6QM2yF51nq5gVz_6hDNACTKZamSF7Hg0etw&oe=69A2C9CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCn5kCHTTKsQ7kNvwGjq3cS&_nc_oc=Adme0dfTTs2F4CW-dDYf8H3d-IMbspcB6KCAOj__hpcTzLDACOPbj_Jsv64_EDnhmjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftZckfNxop8ZU0Su8kulu3EYHV1J3c3tVZAsPG2DkVVcA&oe=69A2DD82"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2042489419283185"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer":
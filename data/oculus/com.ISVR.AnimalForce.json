017-01-23-15-13-40.png", "id": "1105808883436910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974830_1105808886770243_4375658163679701454_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGeCW_uYoBsQ7kNvwH6hjET&_nc_oc=Adk5f6dotmML0fjH97u1xEFN0WtwCZXAsWey91bUNzZYzK0UQwtLpCFoMBjdb74qKuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcuRtEB3c20xmz5CkR9zJvdsERP0y7bYIxeVGwgCCdzA&oe=69B7E6D2"}, {"file_name": "Screenshot_2017-01-23-15-15-13.png", "id": "1598008824009685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_1598008827343018_3231187027395478361_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPOPfMKUVcgQ7kNvwG08_lz&_nc_oc=AdmV8rN3mblX8BiaF7bLsJ_gcODWGHX5-LUt6EsjgVUI7k1JSg0MslSv58C5haxPH-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzKPWnlxKwkRlVlCsxzi7Q2Y9edqJYvuVZ_ZJ1clbavpw&oe=69B8060D"}, {"file_name": "Screenshot_2017-03-08-10-56-15.png", "id": "2358145034367106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036671_2358145037700439_2777417424089655378_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClnTta8f1VwQ7kNvwEaKZ-2&_nc_oc=AdkzVGB0zbBN-NV8-SQYtnTjP4ENCZDAv6V_WZfrOqpI361lFF18DLwHejbLNUig5uU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLUxR_z_6VzzZi0RWBSoEe-bbhuLl3j2VXl1W84aKgTg&oe=69B80A0B"}, {"file_name": "Screenshot_2017-03-08-10-57-54.png", "id": "1817079225327719", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974661_1817079228661052_2337513292644716716_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5cnhW_pYGAQ7kNvwF0He0Y&_nc_oc=Adl14coqfAQ2ovAf34kpBHsHpSTDOf3KKSY5dulAiOFRK7T9OyxdqBQTXJpE_wE8kAk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxiULrFXPOkn2FYhRn_y2N0lK35FE1b9Lo3SpTunl0tRA&oe=69B7E1CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandScape.png", "id": "1582461385554524", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75556277_1582461388887857_4145530523862444788_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beVm7ut_Vm4Q7kNvwGpJW3G&_nc_oc=Adn34Yt0GSudvA3u3V3KxjOr4G6hPlluf6CZu32trVaHb8-B51KmM-BPa2HBYxuMifc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfztInqu91jYLk-A1XNBBeZ7pBoKhOIQDzBdti1TAMPJhA&oe=69B7F582"}, "display_name": "Animal Force", "keywords": [], "long_description": "your mission is to save the Earth from an alien invasion using a menagerie of super powered animals from different countries(Totally 11 animal heroes). Each one has its own unique ability, and as the player, you must use these in tandem to defeat the dastardly extraterrestrials.\n\nAt its heart, Animal Force is a tower defence & action game, which take full advantage of what a virtual arena has to offer. Unlike traditional 2D tower defence games, the battles in Animal Force take place in 3D arenas, so enemies move in 3D space.\nyou can place your defenders anywhere in order to stop them.or pick up these animals anytime when you need.\n\nOr,you can keep the animals in hand, swing around enemies to attack them (Animals attack automatically, do not need to press any button)\n\nYou can freeze the animal heroes which in your hand by press and hold \"trigger\" of your VR controller.\n\nDon\u2019t be fooled by its happy-go-lucky appearance, Animal Force is a game of skill and strategy, and with 7 stages packed with new enemies, twists and boss fights, it has something for everyone from the greenest of the greenhorns to the most seasoned of gamers.", "short_description": "3D tower deffense, with 11 different skilled animals as towers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.is-vr.com/Privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "ISVR", "support_website_url": null, "website_url": "http://www.is-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4
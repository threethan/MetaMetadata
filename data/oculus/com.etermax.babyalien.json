7f20f&oh=00_Af5NEAjia3z5g5HIa4RHJ3xEl9odSzbgsycsKhkyGhB07Q&oe=6A1C48BB"}, {"file_name": "Screenshot 5 (1).png", "id": "2698782630320345", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392182_2698782633653678_2631618318702544829_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAh580FDZbsQ7kNvwF2e_X0&_nc_oc=AdoUBFYYAoUnn-ujw4InVM8p_05tAhAViGBQiylSxxCpjGD9-dFNPanoljhNn2yEed8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R8WhBbcu82lBfdf6NKWSbTW9qI_2AaTz7aTKwrVcWAQ&oe=6A1C34C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "653473027473273", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392182_653473030806606_4323543168817991348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt6I9-MKMs8Q7kNvwEZkCVY&_nc_oc=AdoNvPT_DOT7y-bndBpKIs46fxy8Cc521T5ysFJfdubyavNFiTObHCHPT1Liob2FmhU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y5BJKwopRXOJEk0nHNvCz6O_AaS8aKrmxoadP31sB2g&oe=6A1C32DC"}, "display_name": "Room Invaders", "keywords": ["invasion", "shooter", "alien", "arcade", "free"], "long_description": "\ud83d\ude80 Your home is under attack! Zooky needs a hero!\n\n\n\ud83d\udee1\ufe0f **DEFEND ZOOKY**\n\nYour main mission is to protect Zooky from endless waves of invading spaceships! Arm yourself with a variety of weapons, whether close-range or long-distance, and stop the abductors before it\u2019s too late. The battle takes place right in your own home, thanks to Mixed-Reality technology!\n{1038179834826079}\n\n\ud83d\udd2b **USE POWERFUL WEAPONS**\n\nGear up, hero! The invaders won\u2019t stop themselves.\nFire up devastating laser cannons, rain chaos with explosive grenades, and unlock a legendary arsenal of weapons designed to obliterate anything in your path!\n{1183784452819341}\n\n\ud83d\udc7e **FACE DIVERSE ENEMIES**\n\nThe invaders won\u2019t make it easy! Encounter different types of enemy ships, each with unique attack patterns and strengths. From bombers to snipers, every wave will challenge your reflexes and strategy.\n{1335919561018440}\n\n\ud83e\uddf0 **UPGRADE YOUR GEAR**\n\nEarn rewards and upgrade your weapons to take on tougher waves. Unlock new tools and firepower to improve your defenses and keep Zooky safe!\n{1006996291379135}\n\n\ud83d\udd79\ufe0f**HAVE FUN**\n\nExperience fast-paced action with old-school arcade mechanics in a whole new way. The fate of Zooky is in your hands. Do you have what it takes to stop the Room Invaders?\n{692045160160326}\n\n\n\n\n\n\n\n", "short_description": "\ud83d\ude80 Ready to defend your home and save Zooky?\n\nDefend your home and Zooky from alien invaders in this fast-paced retro arcade shooter. Aim, fire, and don\u2019t let them in!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "http://etermax.com/terms", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9059489400818885"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1639370800776104"}, {"status": "PUBLISHED", "id": "2333105387126124"}, {"status": "PUBLISHED", "id": "1090346792534587"}, {"status": "P
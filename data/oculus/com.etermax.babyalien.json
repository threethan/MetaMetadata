20f&oh=00_AQMzGuPYP9aUCG2mKAfXZqzJVrSCzzQ5CbMMbjBn8jnebw&oe=6ACBBE1C"}, {"file_name": "Screenshot 6.png", "id": "872475761674651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392182_872475765007984_5239741455213438326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d97zo419CFAQ7kNvwGBDAxj&_nc_oc=AdqqPq1dcK8HbpHoNYGNcO7fqUppWvBEhPy3lgZFmzhjSrvUqQVDS4eRudBXFUo2AEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWZcnaBQjm_o8jfH_CE82lWMqD6RV6fJhuvbOzomGZvg&oe=6ACBA03B"}, {"file_name": "Screenshot 5 (1).png", "id": "2698782630320345", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392182_2698782633653678_2631618318702544829_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDfSimPiAZ8Q7kNvwHjPTIU&_nc_oc=Adr41odJbSNfR3tuqFAsxsncHGX1Z4Dk4jKMNN4Hpp39suft9Be-425buhNhtVt8CrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj_9C3N1YpaNWinsJglIzdCNkfXeBFBc93ZcydFgtSCg&oe=6ACBC487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RI_2560x1440_v2b.png", "id": "25097651039895720", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_25097651059895718_3192009958970806879_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTCglhAzh9IQ7kNvwHZwZtM&_nc_oc=AdqYMsyjv2hDrwiVymcchqi7L5-l-OLvVbtZW8Dsvjr7GrdVTDEF_9cYUISEkBhBmt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs8e3JeT9dyMX_aewaDaAsUeYaM_mVcXHBfKBCUc726Q&oe=6ACBA9CD"}, "display_name": "Room Invaders", "keywords": ["invasion", "shooter", "alien", "arcade", "free"], "long_description": "\ud83d\ude80 **Your home is under attack! Zooky needs a hero!**\n\n\ud83d\udee1\ufe0f **PROTECT THE BABY** \n\nYour mission is to protect Zooky from endless waves of invading spaceships! Arm yourself with a variety of weapons, whether close-range or long-distance, and stop the abductors before it\u2019s too late. The battle takes place right in your own home, thanks to Mixed-Reality technology!\n{1038179834826079}\n\n\ud83d\udd2b **USE POWERFUL WEAPONS**\n\nGear up, hero! The invaders won\u2019t stop themselves.\nFire up devastating laser cannons, rain chaos with explosive grenades, and unlock a legendary arsenal of weapons designed to obliterate anything in your path!\n{1183784452819341}\n\n\n\ud83d\udc7e **FACE DIVERSE ENEMIES**\n\nThe invaders won\u2019t make it easy! Encounter different types of enemy ships, each with unique attack patterns and strengths. From bombers to snipers, every wave will challenge your reflexes and strategy.\n{1335919561018440}\n\n\ud83e\uddf0 **UPGRADE YOUR GEAR**\n\nEarn rewards and upgrade your weapons to take on tougher waves. Unlock new tools and firepower to improve your defenses and keep Zooky safe!\n{1006996291379135}\n\n\n\u26a0\ufe0f **Early Access Notice**\n\nThis game is currently in Early Access and under active development.\nWe're constantly working to expand, polish and improve the experience.\nYour feedback is key to helping us shape what comes next.\n\n\u2692\ufe0f Check out the **known issues** here:  https://tinyurl.com/roominvaders\n\nJoin our Discord crew \u2014 news, updates, giveaways, and good vibes await!\n\ud83d\udc49 https://discord.gg/etermaxrstudio\n\n\n\n", "short_description": "\ud83d\ude80 Ready to defend your home and save Zooky?\n\nDefend the baby alien and your home from otherworldly invaders in this fast-paced retro arcade shooter. Aim, fire, and keep them out!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "http://etermax.com/terms", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "45978150496848
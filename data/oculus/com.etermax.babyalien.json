c=Adrc8RB3DMa3yLxHod82LTRI3660sdliEFH6X8zYuT88gGMrwLANb8ydsUlwRP6V1NE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXkK-m2G3e57bEXiamg1r4xEWOrVA-yvjRTv3tNO2KkA&oe=6A9426DC"}, {"file_name": "Screenshot 6.png", "id": "872475761674651", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392182_872475765007984_5239741455213438326_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KB3IN7NiJ0EQ7kNvwFjFcOb&_nc_oc=AdoCntok4rfZkObA_NRhXYFff051oOGXuU7TiLiEGl3CmJaGFvd5fxksucXQHdEdb8U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbACD-v9ylmmtgKIJ6-3pjIJ0ZhUBDjMRC4fZHuDGjCw&oe=6A9408FB"}, {"file_name": "Screenshot 5 (1).png", "id": "2698782630320345", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392182_2698782633653678_2631618318702544829_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7nf09EnaPoQ7kNvwFw0Dw1&_nc_oc=AdoZoKcj0QsGVoXrf5qemZpJQwRcvN1pCxJsvjwYO8UFF0zfWPkay4UTYBE9a7Uw6WE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjOd8YGNO4eLT-N6AkRihlckC8RF_q4ACZn5SduS1OEg&oe=6A942D47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RI_2560x1440_v2b.png", "id": "25097651039895720", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499303391_25097651059895718_3192009958970806879_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhn3oOjMf3kQ7kNvwHSHT9j&_nc_oc=Adq-oIsldnUxep4IEP1-IQF--5m4pwKLNyPlNMz_fIn-EHep66b9bDogpNKcQWyD--k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCj1TlN1Yda5G7Be53ZhtwKwo1fA9BgpPcTlQsQb_ENg&oe=6A94128D"}, "display_name": "Room Invaders", "keywords": ["invasion", "shooter", "alien", "arcade", "free"], "long_description": "\ud83d\ude80 **Your home is under attack! Zooky needs a hero!**\n\n\ud83d\udee1\ufe0f **PROTECT THE BABY** \n\nYour mission is to protect Zooky from endless waves of invading spaceships! Arm yourself with a variety of weapons, whether close-range or long-distance, and stop the abductors before it\u2019s too late. The battle takes place right in your own home, thanks to Mixed-Reality technology!\n{1038179834826079}\n\n\ud83d\udd2b **USE POWERFUL WEAPONS**\n\nGear up, hero! The invaders won\u2019t stop themselves.\nFire up devastating laser cannons, rain chaos with explosive grenades, and unlock a legendary arsenal of weapons designed to obliterate anything in your path!\n{1183784452819341}\n\n\n\ud83d\udc7e **FACE DIVERSE ENEMIES**\n\nThe invaders won\u2019t make it easy! Encounter different types of enemy ships, each with unique attack patterns and strengths. From bombers to snipers, every wave will challenge your reflexes and strategy.\n{1335919561018440}\n\n\ud83e\uddf0 **UPGRADE YOUR GEAR**\n\nEarn rewards and upgrade your weapons to take on tougher waves. Unlock new tools and firepower to improve your defenses and keep Zooky safe!\n{1006996291379135}\n\n\n\u26a0\ufe0f **Early Access Notice**\n\nThis game is currently in Early Access and under active development.\nWe're constantly working to expand, polish and improve the experience.\nYour feedback is key to helping us shape what comes next.\n\n\u2692\ufe0f Check out the **known issues** here:  https://tinyurl.com/roominvaders\n\nJoin our Discord crew \u2014 news, updates, giveaways, and good vibes await!\n\ud83d\udc49 https://discord.gg/etermaxrstudio\n\n\n\n", "short_description": "\ud83d\ude80 Ready to defend your home and save Zooky?\n\nDefend the baby alien and your home from otherworldly invaders in this fast-paced retro arcade shooter. Aim, fire, and keep them out!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "http://etermax.com/terms", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
vwG-iWo6&_nc_oc=AdoTch6MILdJCbAerzP4eyIMA_qRvdkMWdGCayveEpeaFRQo-eRtZWRDbV_znazD2T4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXK3lwjEdSzpkIBiyBhSofLFAzJ4FsPcm5Gsd5ar-VQQ&oe=6AFF289C"}, {"file_name": "Screenshot 6.png", "id": "872475761674651", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392182_872475765007984_5239741455213438326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOnImyFGYtwQ7kNvwECuZfP&_nc_oc=AdoLerxOa7j0krTlblyDZ_1nbmoeMUQCSsRI3imd40f7BNnM9jD0km4wdne4sA_D4kI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUCFSP8RyASGgN7WdknuhUdj_cttlqeg9tV1B4fJ3anQ&oe=6AFF0ABB"}, {"file_name": "Screenshot 5 (1).png", "id": "2698782630320345", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392182_2698782633653678_2631618318702544829_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOjZEOPY1-AQ7kNvwHlviRM&_nc_oc=Adr-CDp1bDPVMstDToG0vXX5sYk3kX6F_v6Q3xXLxWbM2dy-W9GDtgaQirDWBrBJttU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAnjzaL7NVa-y0Z9pheFmM4O4uvgkqPItbXSUEOZ7lzw&oe=6AFF2F07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "653473027473273", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392182_653473030806606_4323543168817991348_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4ZqG56wuLMQ7kNvwFW-728&_nc_oc=AdpevSARZTwwLG4Yz1s43B5ocoxHcwQmyonTT7OnNKBp_GCe5VTQlmRie4BQ7BO-MLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQytKU8plQK0IPUhdHQKoAr-FCmaT6aGH7IpmtI5SSYJw&oe=6AFF2D1C"}, "display_name": "Room Invaders", "keywords": ["invasion", "shooter", "alien", "arcade", "free"], "long_description": "\ud83d\ude80 Your home is under attack! Zooky needs a hero!\n\n\n\ud83d\udee1\ufe0f **DEFEND ZOOKY**\n\nYour main mission is to protect Zooky from endless waves of invading spaceships! Arm yourself with a variety of weapons, whether close-range or long-distance, and stop the abductors before it\u2019s too late. The battle takes place right in your own home, thanks to Mixed-Reality technology!\n{1038179834826079}\n\n\ud83d\udd2b **USE POWERFUL WEAPONS**\n\nGear up, hero! The invaders won\u2019t stop themselves.\nFire up devastating laser cannons, rain chaos with explosive grenades, and unlock a legendary arsenal of weapons designed to obliterate anything in your path!\n{1183784452819341}\n\n\ud83d\udc7e **FACE DIVERSE ENEMIES**\n\nThe invaders won\u2019t make it easy! Encounter different types of enemy ships, each with unique attack patterns and strengths. From bombers to snipers, every wave will challenge your reflexes and strategy.\n{1335919561018440}\n\n\ud83e\uddf0 **UPGRADE YOUR GEAR**\n\nEarn rewards and upgrade your weapons to take on tougher waves. Unlock new tools and firepower to improve your defenses and keep Zooky safe!\n{1006996291379135}\n\n\ud83d\udd79\ufe0f**HAVE FUN**\n\nExperience fast-paced action with old-school arcade mechanics in a whole new way. The fate of Zooky is in your hands. Do you have what it takes to stop the Room Invaders?\n{692045160160326}\n\n\n\n\n\n\n\n", "short_description": "\ud83d\ude80 Ready to defend your home and save Zooky?\n\nDefend your home and Zooky from alien invaders in this fast-paced retro arcade shooter. Aim, fire, and don\u2019t let them in!"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "http://etermax.com/terms", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_t
nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMpqsLKgs74Q7kNvwF7aneA&_nc_oc=Ado-F41DVVoAsFUNNCV7QCnXVcp1GDW-_1wsmXtQboP3fZJhHjrjDUTuvLTCEf5tPF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaMwY8zlssasK4m5fjT1bnQSj4MoWJdrjbyrUIUIO3ug&oe=6AFC7A66"}, {"file_name": "screenshot-5.png", "id": "1821969852349302", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1821969855682635_3939912209488818539_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaNQmP78WyYQ7kNvwE6ow23&_nc_oc=Adq5FKt9uPLvyog7Ub_acEceQ-IUGC_ijLtQO3hnUyPbw5IJCu-6aUADmXz0RTFAojk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6ZC3noNKTImh93DpNBWHLYKiYjusqLafY405-LNdj2w&oe=6AFC610D"}, {"file_name": "screenshot-mixed-reality.png", "id": "1419122816333554", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1419122819666887_4633100902195319092_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZSV2F7bWTsQ7kNvwGIkVCo&_nc_oc=Adp_phdjZsdbtxIQaMTvw9uszA_BrUBZ0gwNeERKRtvQZdIhHbVQJ7O6k_UWK9QylZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMNekHCyTDlDbWLiRrZ-J4xcSxy1lFKUyrW8hzShYBLQ&oe=6AFC8CA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blackflip", "keywords": ["puzzle", "think", "polarium", "slow", "solving"], "long_description": "One rule. 11,500 puzzles. A board of real tiles right in front of you.\nblackflip is a calm, clever puzzle game. Every puzzle is a board of dark and light tiles. Draw one path across it, press FLIP, and every tile under your path turns over. If each row ends up in a single color, the puzzle is solved. That is the whole rule, and it goes a long way: the first levels take seconds, later ones will keep you thinking.\n\u2022 A board you can touch: the puzzle lies on a desk in front of you. Draw your path with a fingertip or point at it, then hit the big FLIP button and watch the tiles jump and turn.\n\u2022 Hands or controllers: play with hand tracking or with your Touch controllers.\n\u2022 Your room or ours: play in a quiet dark room with tiles drifting by, or switch on Mixed Reality and solve puzzles in your own room.\n\u2022 11,500 puzzles made by players, from quick small boards to tricky large ones.\n\u2022 Three stars per puzzle: solve it, find the shortest path, and get it right on the first try.\n\u2022 Stuck? Spend coins you earned to see the solution.\n\u2022 Puzzle Creator: paint your own puzzle, prove that it can be solved, and publish it for everyone.\n\u2022 Beat the record: find a shorter path for a community puzzle than anyone before you.\n\u2022 See how others did: how many players solved a puzzle, and the best time.\n\u2022 No ads, no account. Just you and the puzzles.\nEasy to learn in a minute, hard to put down.", "short_description": "A calm puzzle game with a single rule: draw one path across the board and every tile under it flips over. Make each row one color to solve it. 11,500 puzzles made by players, on a board right in front of you, with hands or controllers, in a quiet dark room or in Mixed Reality. Build your own in the Puzzle Creator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blackflip.flaboratorium.org/privacypolicy/", "developer_terms_of_service_url": "https://blackflip.flaboratorium.org/privacypolicy/", "publisher_name": "derFlugfuchs", "support_website_url": "https://blackflip.flaboratorium.org/privacypolicy/", "website_url": "https://blackflip.flaboratorium.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
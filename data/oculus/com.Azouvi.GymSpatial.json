rateBay-1.png", "id": "992281240641857", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823783_992281247308523_9106681715076336624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9tay0WfrxwQ7kNvwE75mDr&_nc_oc=AdpjVvFQY7ujItTCmJrZhkCp6QiQm9QQ2JM2KO4FMUHuJgGuokp9tiYBLT7JAGYdzB4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHymEEMM6AzP08GZgvL-E2xp1pd-yBQ1PRhIc1WrlPpfQ&oe=6A8D77EE"}, {"file_name": "paris-1.png", "id": "1276641851095132", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819356_1276641854428465_8129846065035173896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhZq33m970cQ7kNvwF9wMfe&_nc_oc=AdrsqBdy7UC6hrLG7HXuktgwSX_5nwhL4QCRP1hUz-XRcfuPwcpfQ42EAygdPX1N4io&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFURE7n_gDkX7oKxtFf0KpbCQzvPGN5yGosL4a9E3mxbQ&oe=6A8D8D89"}, {"file_name": "cityNight-1.png", "id": "4424082057916103", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823351_4424082067916102_7165907099665424911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhhOvJEJVn0Q7kNvwHWMnfJ&_nc_oc=AdqhUBT2H2lmqVv4NRDLxdBpj68hXVuVRsPu1PI5ZGQ4L_RfCnhJWy34bEMag8q8rlE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWZFBY7qlvGRZ0Yth0-KjmF1-eL2f3TVyEmkawJVh3-g&oe=6A8D8F6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshotsGymMeta_0004_5.png", "id": "3891362797675098", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830027_3891362801008431_1155935362882217486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkkHM0MdiUEQ7kNvwHvzlT3&_nc_oc=Adpvajw-LJEOioTPPbGU8buCDi1N735tw2tOlE67hM2sAdI9zc9JGkad-0w38TjRaD0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENImLcD2qRqILWZ60u2PA6MiatdTPZ_S1V9ntcnXzjwg&oe=6A8D6826"}, "display_name": "Gym Spatial", "keywords": ["fitness", "treadmill", "rowing", "bike", "gym"], "long_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, Paris or a futuristic city... When using a treadmill,  stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever.\n\nNo need to connect to any workout device or equipment, the movement is a simple animation that you can fully control inside the app.\n\nAlready 7 immersive environments available. More virtual environments, and full guided workout sessions, coming soon!", "short_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, a futuristic city, Paris... When using a treadmill, stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emmanuelazouvi.com/gym-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emmanuel Azouvi", "support_website_url": null, "website_url": "https://www.gym-spatial.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26613409818251994"}, "review_messages": []}]}, "cover_square_image":
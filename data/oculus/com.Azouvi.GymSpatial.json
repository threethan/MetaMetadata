ng", "id": "992281240641857", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_992281247308523_9106681715076336624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyXZFzhPUG0Q7kNvwGmcsSC&_nc_oc=Adq_vGdlLi10LpXAwKaRX3Z6L-UMph_dYf2fitw_g-9S4NXM98C_uia3wQAzOWkL_gA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm2I9W5dc1PrfRedtXvJB8PKw27CvxaYEofMgmQ6A7WA&oe=6ABBD4AE"}, {"file_name": "paris-1.png", "id": "1276641851095132", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1276641854428465_8129846065035173896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJgnZLwgDaQQ7kNvwGlF3gu&_nc_oc=AdoVV3ge9dHFU1nCVCPoNRTePke3yfEVShcGGVBGxfiqnCRiyA_ea1MzjQvZRpKhbmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbddVy0WPp93EN5xizYgF6Yb0XMeWUfOXZQniNjowVgQ&oe=6ABBB209"}, {"file_name": "cityNight-1.png", "id": "4424082057916103", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_4424082067916102_7165907099665424911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj2QtteudbUQ7kNvwHdyp1w&_nc_oc=AdrouWw-ctDbGEw3DW-yyMeUXXcl3TRrZfKQjutEzBpz0fu8ScM6YHgZe5dvSItd8J8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm4UHE5i_5YkkqcmwHICjaGPLr9_bLvvjjDFEaB03_2w&oe=6ABBB3EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshotsGymMeta_0004_5.png", "id": "3891362797675098", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830027_3891362801008431_1155935362882217486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6do2Vn386XEQ7kNvwG943iZ&_nc_oc=Adrv1PiuP4TnGEiC9K0R9LrWdzThmjXGyrnNumQlIERnurCvZvNX6PnKNdS4L_Cl4SQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIduQaAEJOhx__knrz7fjXmFBc2vy5KedcVODWylJm7bw&oe=6ABBC4E6"}, "display_name": "Gym Spatial", "keywords": ["fitness", "treadmill", "rowing", "bike", "gym"], "long_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, Paris or a futuristic city... When using a treadmill,  stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever.\n\nNo need to connect to any workout device or equipment, the movement is a simple animation that you can fully control inside the app.\n\nAlready 9 immersive environments available. More virtual environments, and full guided workout sessions, coming soon!", "short_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, a futuristic city, Paris... When using a treadmill, stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emmanuelazouvi.com/gym-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emmanuel Azouvi", "support_website_url": null, "website_url": "https://www.gym-spatial.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28530782589848031"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:/
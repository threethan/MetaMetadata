ment is a simple animation that you can fully control inside the app.\n\nMore virtual environments, and full guided workout sessions, coming soon!", "short_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay or a futuristic city... When using a treadmill, stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emmanuelazouvi.com/gym-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emmanuel Azouvi", "support_website_url": null, "website_url": "https://www.gym-spatial.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25052714924321499"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1597294028408746"}, {"status": "PUBLISHED", "id": "1559282548504509"}, {"status": "PUBLISHED", "id": "1288160352490334"}]}, "baseline_offer": {"id": "1597294028408746"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787571900, "status": "PUBLISHED", "id": "1597294028408746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes
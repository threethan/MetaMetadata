ay-1.png", "id": "992281240641857", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823783_992281247308523_9106681715076336624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R84QXDRCGVEQ7kNvwFBTjIq&_nc_oc=AdpjusN_3ExS3Z4wf9JYLMAypAuYwWUMi5o1ovROk-37HVAUQByq30rqa1djjUR-8E0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeNyQHS23OD15rKlLxdvVKKgA9335z-QgIdlL9dpa23Q&oe=6AAEA5AE"}, {"file_name": "paris-1.png", "id": "1276641851095132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819356_1276641854428465_8129846065035173896_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72CEA7DmrZ8Q7kNvwFI5zMu&_nc_oc=AdpXOCMdgbFhYix44Zk5OXwOKy3_s1D4EcpL3eW4UQtpD4bXCo4ZJp6U3-AFugcyeLM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3RePyn-HXQ_WhH7DGqfOKsb9vKWTvz4bQxEWsXifG7Q&oe=6AAE8309"}, {"file_name": "cityNight-1.png", "id": "4424082057916103", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823351_4424082067916102_7165907099665424911_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pccOQEvCAoQ7kNvwGfMr32&_nc_oc=Adqk5wEda5BAx3gESam3JcN0PC_FoP2rslbXOcpQyyGqqn6NfDyNbhqq7VqXGIhkK9A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDfMffBAU0Z_4-GDUnyn5xZSeCfjTv6GQGjtRlZY0sqw&oe=6AAE84EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshotsGymMeta_0004_5.png", "id": "3891362797675098", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491830027_3891362801008431_1155935362882217486_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0cVb5_oHoAQ7kNvwHplkUv&_nc_oc=AdqIHXG6K4p_vkllzjnr2129fDyXenkoRs7j14hxl2elwCzpaH9z-V3AuXmjc_QkNgg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI9PijoK7vhG8kxLt9k3_SqWb6G0eaGk-aLuF_Ne1LgA&oe=6AAE95E6"}, "display_name": "Gym Spatial", "keywords": ["fitness", "treadmill", "rowing", "bike", "gym"], "long_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, Paris or a futuristic city... When using a treadmill,  stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever.\n\nNo need to connect to any workout device or equipment, the movement is a simple animation that you can fully control inside the app.\n\nAlready 9 immersive environments available. More virtual environments, and full guided workout sessions, coming soon!", "short_description": "Transform your workout routine by stepping into fully immersive 3D environments, where you can run, ride or row, while being in different and fun worlds, from a space station to a pirate's bay, a futuristic city, Paris... When using a treadmill, stationary bike, or a rowing machine, sync your speed with our immersive tracks on the control window, making cardio more engaging and fun than ever."}]}, "developer_name": null, "developer_privacy_policy_url": "https://emmanuelazouvi.com/gym-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Emmanuel Azouvi", "support_website_url": null, "website_url": "https://www.gym-spatial.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28530782589848031"}, "review_messages": []}]}, "cover_square_image": {"uri": "h
7568173592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593790560_28848497578173591_306259083928308453_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArVNjjh9rNEQ7kNvwFkm2kw&_nc_oc=AdqiwHiua99Y1_wcFzItUm2tiol8zgQHoeymrNCkTC45tEnM1HKbrXUkSOq5aEWmKO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd8Tk2NW6wWkhIgl6LhRgyyZfs2tiYHpWywh8Z5Tj5-w&oe=6ACF8411"}, "display_name": "LiDAR Simulator", "keywords": ["LiDAR", "Simulator"], "long_description": "**LiDAR Simulator** lets you try 2D scanning LiDAR in your own space before you buy it. Place virtual sensors in passthrough, watch the beams hit walls, furniture, hands and feet, and stream the scan to your PC software live.\n\n## Features\n- **UST-10LX-compatible simulation**: 270\u00b0, 0.25\u00b0 steps, 40 Hz, with occlusion\n- Detects hands, controllers, feet, walls and furniture, plus real objects via the depth sensor (Quest 3+)\n- **SCIP 2.0 TCP server** per sensor: existing LiDAR software connects by IP and port\n- Multiple sensors with automatic ports; see which programs are connected\n- Precise placement: grab, two-hand fine adjust, tip placement, two-line sighting, fine position and rotation\n- Fix a sensor to the headset or a controller\n- Saved with spatial anchors\n- Web viewer: 3D view and one-click IP:port copy from any browser on your network\n- LAN sharing between headsets\n- Works with hand tracking alone\n- Korean, English, Japanese\n\n## Please note\nMade by an individual; not affiliated with, endorsed or warranted by the original manufacturer (Hokuyo Automatic Co., Ltd.). Model names indicate compatibility only; trademarks belong to their owners. Results may differ from a real sensor.", "short_description": "Place virtual LiDAR sensors in your own room and check coverage and software integration before you buy and install the real thing. (UST-10LX-compatible simulation)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://minsol.pe.kr/lidar_sim/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "923621093838403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1089402740673227"}]}, "baseline_offer": {"id": "1089402740673227"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790782380, "status": "PUBLISHED", "id": "1089402740673227"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "923637963836716", "version": "v16(260930_0142)"}, "id": "1084920627848125", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "923621087171737", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "923637963836716"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1084920627848125"}]}, "change_log": "\uccab\ubc88\uc9f8 \ub9b4\ub9ac\uc988\\n\uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294 \uad8c\ud55c \uc0ad\uc81c\ud568", "created_date": 1790700332, "id": "923637963836716", "version": "v16(260930_0142)",
ohc=fS_gO6CbKKsQ7kNvwFLcvNk&_nc_oc=AdpGCspS8ewz1pxWBq6A-LoD6cOJMmaJC6KV8x-h-QO9OwP-L36j5FEvAM0UGXEz1RA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK7x3HzQ3-SKLgRkrxR1UwLNDoq_aSvpsmuBerwG3vyA&oe=6ACF91C8"}, {"file_name": "SC_01.png", "id": "1116958914123108", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623185_1116958917456441_5208334275313024132_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqml1-AtHqwQ7kNvwH4WHjZ&_nc_oc=Adry5ep1Vr750g1xWb_rbziijbH5MEBVVUG6JA9StilS60pLI5E1nbO8Sf1ShVqwwbk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZoOsWZyNTwnUSjjUSW9taBBPDXAqTFBmkem51dAhNmw&oe=6ACF8F16"}, {"file_name": "SC_05.png", "id": "1111907264686214", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627379_1111907271352880_2043678175065998858_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfn6ITKi_EwQ7kNvwGqvVU0&_nc_oc=AdpVz1lVdDCtUSVrJxCYkaT5ohEJlTYaD2OC6U1PE7vqfuBL7q_cJFppjxHtffUCRAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_lW7dNk60D1OfCBh4fgskq1-yIH3ESpkp_2GH1dnZTA&oe=6ACF9D3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoStop.png", "id": "28848497568173592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593790560_28848497578173591_306259083928308453_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArVNjjh9rNEQ7kNvwFkm2kw&_nc_oc=AdqiwHiua99Y1_wcFzItUm2tiol8zgQHoeymrNCkTC45tEnM1HKbrXUkSOq5aEWmKO4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd8Tk2NW6wWkhIgl6LhRgyyZfs2tiYHpWywh8Z5Tj5-w&oe=6ACF8411"}, "display_name": "LiDAR Simulator", "keywords": ["LiDAR", "Simulator"], "long_description": "**LiDAR Simulator** lets you try 2D scanning LiDAR in your own space before you buy it. Place virtual sensors in passthrough, watch the beams hit walls, furniture, hands and feet, and stream the scan to your PC software live.\n\n## Features\n- **UST-10LX-compatible simulation**: 270\u00b0, 0.25\u00b0 steps, 40 Hz, with occlusion\n- Detects hands, controllers, feet, walls and furniture, plus real objects via the depth sensor (Quest 3+)\n- **SCIP 2.0 TCP server** per sensor: existing LiDAR software connects by IP and port\n- Multiple sensors with automatic ports; see which programs are connected\n- Precise placement: grab, two-hand fine adjust, tip placement, two-line sighting, fine position and rotation\n- Fix a sensor to the headset or a controller\n- Saved with spatial anchors\n- Web viewer: 3D view and one-click IP:port copy from any browser on your network\n- LAN sharing between headsets\n- Works with hand tracking alone\n- Korean, English, Japanese\n\n## Please note\nMade by an individual; not affiliated with, endorsed or warranted by the original manufacturer (Hokuyo Automatic Co., Ltd.). Model names indicate compatibility only; trademarks belong to their owners. Results may differ from a real sensor.", "short_description": "Place virtual LiDAR sensors in your own room and check coverage and software integration before you buy and install the real thing. (UST-10LX-compatible simulation)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://minsol.pe.kr/lidar_sim/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes
6hm26tRQTxT5eUJ1c0Hht5wYAIXCCVjuG7Ct6yWJBg&oe=6AF35A80"}, {"file_name": "vxbnt5q (1).png", "id": "2477363409340446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312439_2477363412673779_4860384472073203880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7yqOgom1E8Q7kNvwFRUKia&_nc_oc=Adoo9i5C1qtxctUyPD_5kQbacGNgFwbLbTqt4nsqxlcDrQcAH73bHTuk6fXwcrY6NS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTsjQGQ-iQtudAvDttnGJjpAOzRZ4_f5mSf_3ugEVFfQ&oe=6AF33FBD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NAHG", "keywords": ["SAMG", "GORILLA", "HORROR"], "long_description": "**A spooky gorilla horror game!**\n\nStep into a creepy world where you play as a gorilla trying to survive against a bunch of creepy and downright spooky monsters. Explore dark and strange places, run around with your friends, hide when things get too close, and do whatever it takes to avoid getting caught.\n\nExpect plenty of screaming, close calls, chaotic chases, and some absolutely stupid moments along the way. Whether you're exploring with friends or running for your life, there's always something lurking around the corner.\n\nIt's scary, it's goofy, and the monsters are, well... **pretty spooky dookie.**\n\n**IMPORTANT COMMUNITY NOTICE**\n\nWe are **SAMG**, and we've moved to a new app due to issues with our previous app's keystore. This is our new home, and we're excited to keep things going here. Thanks for your support and patience!\n\n**Good luck out there. You're probably going to need it.**", "short_description": "**A spooky gorilla horror game!**\n\nNAHG is short for NotAnotherGorillaHorrorProject!\n\nStep into a creepy world where you play as a gorilla trying to survive against a bunch of creepy and downright spooky monsters. Explore dark and strange places, run around with your friends, hide when things get too close, and do whatever it takes to avoid getting caught."}]}, "developer_name": "CompanyScaryBOI", "developer_privacy_policy_url": "https://foggy-dessert-b11.notion.site/Privacy-Policy-for-NAHG-2df5906b958c8024aed5cbe495ae0b82", "developer_terms_of_service_url": null, "publisher_name": "CompanyScaryBOI", "support_website_url": null, "website_url": "https://foggy-dessert-b11.notion.site/Privacy-Policy-for-NAHG-2df5906b958c8024aed5cbe495ae0b82", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1075227758843913"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1092274223601036_2299524184487484681_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbUlvi-SNzUQ7kNvwETatyQ&_nc_oc=Ado6vfkI5QreIhjN66KFEh4srGSbH11-n4q0GBcCsonJIJ9wy-ROUS0_EXSBXhAbHlw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX-9JCi2VpD56LM8y5EKYjifWdEd4Sr9flN0ESb99wJQ&oe=6AF3519F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NAHG", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 
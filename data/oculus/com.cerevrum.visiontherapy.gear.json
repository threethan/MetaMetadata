.com&_nc_ss=7f20f&oh=00_Af6ZLoC8IKIkP_ktT_fUO6-wGljVf2dssSHycL2-GmBJ-Q&oe=6A09C827"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO6AUsClmooQ7kNvwGed91H&_nc_oc=AdouifQ676v3ZQkaG5G_JhYDBPs68iovskyn412lOu7FELLmkeka6oqTXr7X8XUcWYc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78AxxoYhnxdT7cTmopR2PKgKf-BNomnkSVHVespqbRlA&oe=6A09E3A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icxFB1xqEdoQ7kNvwHW1i4S&_nc_oc=AdpZzXumXY46Cx3I9od2bnWRCtlMa-o_tWrrE1qucVC06bkj1Q6ObQQuQz2sfpTB9BY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48wIvifcPHsm64RrHMaaTgHxY91rZ43werJ0BU0Jj1vQ&oe=6A09B297"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7a30f&oh=00_Af38lkxYyMsWo2bypqtwmMGpaK1sFgPz1pZW-pKgHeQJWQ&oe=69E78127"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAQElgI5OhYQ7kNvwGkayk3&_nc_oc=AdpZvNUYJqOwdIlm2yhoT_97qodHvFzhKMLH0BfoLpMKe7lOF_DJe3rZIPGtTQi8Iss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ko8XZ93xNOJRzLPMkZyDiJ1JjSQnw8l3qUgN4RapApw&oe=69E76469"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEUSrZQ0DQUQ7kNvwFdn_R_&_nc_oc=AdpVWvn3k_1vSeMDNR3OmaTdtFZ5vmJ2VqK2vLxOXP1tVYfQWGKH_E8vzIJb6spXmhw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z_wfJkDvPuit_B0Bxr9ypW3xvkGMfqdNdG0VlNBlNJA&oe=69E76B97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
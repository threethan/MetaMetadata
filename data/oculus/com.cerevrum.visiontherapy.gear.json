.com&_nc_ss=7f20f&oh=00_AQKStn9xQ6xZN0bh50hfn5oH_jqaJ_O5vnNJNaXjIQTYlQ&oe=6AA6AAA7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_V3q5Z_wkgQ7kNvwGpZR2s&_nc_oc=Adr8IrfRu-4ZH6xjMG2TsHYY74gsMieCleN9Lywwc192bp9FXMe9TYgvsnL60ICr86I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-ob_lOPfN9yozezB5Ybtet2WcNFW9dAmCWn_QKnEIEg&oe=6AA6C629"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Key5b3gygUQ7kNvwF5KnTJ&_nc_oc=AdrjuKKs77PXNkULtvQ-1bwsv0MLSAe_u3pJPVP_KhSCP16agZwGvK7pLEhaAJ93BFM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXZqTcUt_nJW_ysB_Vla7H3c3cMRyMCMQURdzSofo0Gg&oe=6AA69517"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
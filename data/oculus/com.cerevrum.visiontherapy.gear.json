.com&_nc_ss=7f20f&oh=00_AQHDJyw2atmoGBFGuAhiDtLOVy4BvAteR7cypC_a1Kih0A&oe=6A831227"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kO41AeSVysQ7kNvwGwmn80&_nc_oc=AdqrrJtUzxwbNTberEKBXqOs-wqQykJfNlQUc9oyp4c5GeY_XKAHk8yh6iuZAI7q9GM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGajwP53R7wF3aQseDfgBcsJJ716Z2yIv-qCt7McjCzcw&oe=6A82F569"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1KjAuPTNo0Q7kNvwEKGzIJ&_nc_oc=AdpJbKHAlY7mV5nIoj5rweIjEvZHckeEixvukY15ZpkrrEtD-wjeYO1aKQOTYEe-M98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlfzDaOk2vYLGXFmQCbRNFn0spzMKVoB-kzuTSpdDNWw&oe=6A82FC97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQPNfXxg9iPl3MpMfPTt-lwB6JqjiQ4ah78QwBspulDGKw&oe=6AC4FD27"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKueUJxBR-YQ7kNvwEI9Zh-&_nc_oc=AdqxRTjJI2WBAh6-SdKyYUysUh7L4PJnCCGq-HTEqo8P-8V3tWMH-letmGD7ux2EZtI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaS_a9idN84uOyMJGnxKfvvws3ABpDM9G-Ggp6Q60RCw&oe=6AC518A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkXQC-ECdbMQ7kNvwGfJenn&_nc_oc=AdpkFa_MH_YxYZ9iTXvoANkzNFaiXAvZ7_XQtNHTsZEcVlJxEWHwAUh4juRulL_1UVA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwaUOOHKlScikCXeAPJyVkKti-E2WB4PA6yTDP8iu_Ew&oe=6AC51FD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
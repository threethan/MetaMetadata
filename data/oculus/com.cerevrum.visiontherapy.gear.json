.com&_nc_ss=7f20f&oh=00_Af_xuiNXM_3g6aWCEHf7fmRrT2XmkiY9O9QvUFB6zNfr4Q&oe=6A47BEA7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBFKoOhO2g8Q7kNvwHNuxBM&_nc_oc=AdpJaMQQq-R2oRROUiHbSWGZwAFVNm46KtYKl_DY1WX53HdIu_-S691PkHqnDjB-Bls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Fm6bIsIPLCvc6J2-6TMPfEI5flUfWAIvNgdP64BlfLw&oe=6A47DA29"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uitm8WskylkQ7kNvwG0eOdc&_nc_oc=Adr3qYxulwu50GbRTCGBTS3p4q50BMWDANWrS1zoOXxz2v1_qftCZoGu6dHDKTa0gfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x9__5uLcxJLCFhVeRJNyQpMyRJamAMZ_7CHIvar_gVQ&oe=6A47E157"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
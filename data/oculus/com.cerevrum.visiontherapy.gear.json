.com&_nc_ss=7f20f&oh=00_Af4TeHmJmCSybY0Jpj_Kxo3RYGNm1_XcFW2FZ27AorJfoQ&oe=6A0876A7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uO6AUsClmooQ7kNvwHC2guX&_nc_oc=Adqee-FWZQRCAfKuJ8_g6Q1Ac85T4K64F9LcBUR2fivIHpfhIteWQ4Lqe5qBffPEVq0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GogahnOWWnyc9-AZysAQ53brNNaXoWFqNcShiacuN-Q&oe=6A089229"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjm_UqdwHXsQ7kNvwHrAdKU&_nc_oc=AdoeyKsofZzMIDYLeVxjPFVL7hPcz2W1_UFBW4GbsjPotU_VRttGfa3ToUABlLLZLrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_jdeE2DJ64xk7nfmY15Gwz67LKyBBwaSD14K6ul1Ujg&oe=6A086117"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
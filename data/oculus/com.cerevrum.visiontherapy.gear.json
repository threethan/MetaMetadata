HbcNYw-csHPNWKO-3FyZPI6mJdyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgoMpGGuGZnxSS1w2QumoBLh6EKbTKM7V8qsIU3Ah-kg&oe=6A54D817"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cerevrum.com/visiontherapy/privacypolicy.pdf", "developer_terms_of_service_url": "http://cerevrum.com/visiontherapy/terms.pdf", "publisher_name": "Cerevrum INC.", "support_website_url": null, "website_url": "http://cerevrum.com/visiontherapy", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SOCIAL", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graph
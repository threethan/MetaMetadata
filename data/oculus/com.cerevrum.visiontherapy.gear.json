.com&_nc_ss=7f20f&oh=00_AQSWJBKwl_BH5dvarU0a2uTg9DCp3Pwhi3I8KKHvKejQHg&oe=6AEC8A27"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLE-5DRcPfoQ7kNvwFNduK7&_nc_oc=Adq44wvgMqirAnUBZ04j8qiXF_vd91ZFEda5zL6FNhW32sPA0zYdAeO-R47y3ddghsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzCflSQxpubmoe_aZ6gpCmaHXt_8kVeH4VpKgCOu8igQ&oe=6AECA5A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvGzRJA-ivIQ7kNvwEeYAg_&_nc_oc=AdpywRp1Eymw0Mwwkxhl3gy7_wjpw3mtC3OtMJULo2j1baIvRY_58eHUpc60t-efiZo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSmKQGnlwP8IWznPe2XHNAK9iht9WHbUDhOD7rILXoUA&oe=6AECACD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQC7HBezOlZmO04pD-QZw6A4LPnR72Aj-zFMT9pSkkbcdg&oe=6A6DFA27"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuKukJQR-Y0Q7kNvwHR7hfC&_nc_oc=Adrdi-XYGI5yX1dsPDLxhg7AAWZJmjlrnbyIwn77tNxNqJbpmw26U7g4-kCbKJFzals&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgwRp6dul5wZa6khb-Gmoo7C4ppjWjxCgN35-eY549tw&oe=6A6DDD69"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NemTBJAfMTIQ7kNvwHJSGvu&_nc_oc=AdrpFzWDk6SZI3fuTrUA2aAEZOoIIe5KR-6kZMyvN11oYXgtlfUkKoiD-GP8YKjYDu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmPqAR2iIqqcp6SnmMm17mwkKZ2EIWdkXy7QlScj2UkQ&oe=6A6DE497"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
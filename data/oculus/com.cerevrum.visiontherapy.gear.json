.com&_nc_ss=7f20f&oh=00_AQIMXNwWabj4dQHAl4c4S0zi3olwKiQHAz5ddWyBQ1eypA&oe=6A9EC1A7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VrCiqkuKO4Q7kNvwHpUk9O&_nc_oc=AdpOxZZIISWCTdlchaZhKCuvVTZU2Z76DSqnZ6cwbrdNgrqjazKY4-I7mqwGSyoPIgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLurYHq8uYeBS1mHD3pfm7sJ490THP-X4QeyTRU-xgdA&oe=6A9EDD29"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDzDbI5XsBcQ7kNvwFo_85Q&_nc_oc=Adqptw_2n7EpJlF7Fym_tAbEft3WWDVVj3It6fTB-ncMtHztoDP5koKfhrM0X9n6fWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYaEpnev9NvtT5QcjzXeZrr5iXfFCUWuy8hxc6x-bgfg&oe=6A9EE457"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
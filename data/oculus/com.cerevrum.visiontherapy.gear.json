.com&_nc_ss=7f20f&oh=00_AQQOszYdKZswvl2-g-F0nFbT7-wOdgrOXOTI0yT-srtKAQ&oe=6AEF6567"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLE-5DRcPfoQ7kNvwE2eYlE&_nc_oc=AdqZ3CDYsASxfEOBWmpZUq9b5ibyTUIYMBLqKVujFkhAoEkjzq_SSVC22F9IwRK9vf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPSOylrsA1qqfUSWRd8Wyze2YXwJFH1u2t0iQrHv3gqg&oe=6AEF48A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZGS98pcKfsQ7kNvwF2fC-f&_nc_oc=AdpsU9ZGRpkd15ivR4qUyJL6BrAA3-SSrV_d45-xN6nEfyjR2sSd_0ocw2gjw4oLjF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKRAsrrvNtVAQ6jG0QakdQ2rEBmpZm3nV1RqLfaf2LZw&oe=6AEF4FD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQCqHhjM7q0y38soMsU8lAC6mbLxCEFTkA9U1fCW5e0G-w&oe=6A4BB327"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHrfkT7adt0Q7kNvwGqRaum&_nc_oc=Ado6dmriS6u0-FmnnfiiYI1NwRVWMwRpsOYpcJlYRcRrLSW_q7sfppz2Q66NuRquhfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKg_W_J51y7t-JQbj_PIkLkqTy-5rE18sTQdV5l0dUhw&oe=6A4BCEA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leU_KHJlS0EQ7kNvwFdDOsr&_nc_oc=AdrYAyqj7kcHoMyWWCre06XG9YvZP3pcrlDhUe_H-mCUmCaOE7-7AjxI2_VTmkxFau0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDkCHm-uBfADcTwvn8d0WoBloh_otBiBRee3nPyDxaDQ&oe=6A4B9D97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQJeCrOBqnbF5wFq6mlyCvs0oZD_1ZX1DbpcFDD4-K5rCw&oe=6ABA7127"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1utpYEpKKuAQ7kNvwHUgeuk&_nc_oc=Adr6RKUnpwmKWfFQ4vvtq3qC-_26XqWoyjq3MOSVsJWibAK9M3FPW9IlZGUNvvku9pU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrXv-eDXt1kmDlyAuR0csAHJ75nxVDI7N1bIYyTXdCPQ&oe=6ABA8CA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zum1pQ_r7gsQ7kNvwE3yoL2&_nc_oc=AdrreRdq9y6X2R-3QrwPnCVaKAftnrsV6InhQUZYFTfsnuyehSMOZoQqhr6bgSiafHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr50Ok9hw14sAgYy1A1CWAWQskIp8GJJ3Ym9O_cSio3A&oe=6ABA5B97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
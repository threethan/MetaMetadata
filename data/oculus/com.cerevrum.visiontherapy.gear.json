.com&_nc_ss=7f20f&oh=00_Af-gaYo7xB9VUOcYAsVjbRy0nBWd3NrgzL3I6Jz0_tW2-A&oe=6A3A8FA7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R98MMk6lKaEQ7kNvwEMqPE2&_nc_oc=AdracdbdY8_-wWDZFbHgc3WenFj07RDD8akM_T1R4QDcAPBrLXNu-_iWPRoTqTUqRTI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-cJ3RvuVxQH1WaWlA9O22ZtfdDsQKyQ_pfc-WjHNdGA&oe=6A3AAB29"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DQL9HsghlwQ7kNvwHPyAUZ&_nc_oc=Adqu31qVuwz8dBY978oUNciJ4-yVsweD-yTYh8PDEknrj2veM5saiJlP2gprmMK3jnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gyKXymwbeO7ylNmnO6__cBPNk3HGei9x6d7-td4PPdA&oe=6A3AB257"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
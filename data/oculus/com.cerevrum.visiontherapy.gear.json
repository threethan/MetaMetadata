.com&_nc_ss=7f20f&oh=00_AQT51Q_xwt-ewUbCr4llW4MBwXH7JeYqT0PnAyxjvhF9Dw&oe=6AE895A7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ojLl0P70hAQ7kNvwHcwWza&_nc_oc=AdqXx61sSDNJwdhP4r1Rx9YDIwaaN0HYnWAOQnLTc92UE2Us-gAiFWFHKUv7ylaEHxU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0BYLsbm2kHqIJycU0b9nS3ELU38-t_pxQUechx7jj6A&oe=6AE8B129"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmYJcgG6zh0Q7kNvwH6C2k3&_nc_oc=AdpWtCkseOQSc1jFIYKTOqpwxaR8FfdIlh6cArXuna7wjRwOMARx7fw5VWG72-jCA8M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoX-DBUKD7HZLctCT9KXeSLOPS-SeNv0lyewbcKR5KiA&oe=6AE8B857"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
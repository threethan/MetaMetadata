.com&_nc_ss=7f20f&oh=00_AQGGNl9dUHaPafkRk8R1xf8QNTPWyBpU3HG_gLt7TJNGfw&oe=6A8C1467"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0ITJTmPWgAQ7kNvwF3RH0A&_nc_oc=AdoPOwr59FpUUroerFOhw049wfaT-WbLFzF9gDCtduMqE-5TyxZgCn-osqYUej2njvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDN5iO-5Bljl82t0epfVwDJq8VuL_C9aaO02mLFY2hVA&oe=6A8C2FE9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O8l2a0odGoQ7kNvwFMHWPy&_nc_oc=AdoD7jjIrQw61YsqFzxj-DKnBmHt1zeQDXJOPFYMNMX2xhIRXOWe0I66hy6VW8fMjAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_XvtTlfMYJI3ZnVZHc6N5fVvq7A_2oayIk6je6Bs7Sw&oe=6A8C3717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQCplT8kxjjdoSv-FmhtNhuswI5dp1CQv_FE1Rh1KJO8Xw&oe=6A661127"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoXmiyI56_0Q7kNvwF4mZDl&_nc_oc=Adq5ajHO92QL7AUsSSF4FXn5XMnj_HxTkl0H6z4BdPbUJkobUQdovt-PJ_uBCz9mDGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzZSJY5XEsHfOmtjQK2Hudgv37cJk6bk9BnLiJVeWuPQ&oe=6A65F469"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eec74_aC8c8Q7kNvwGh-M56&_nc_oc=AdpBFl9YjZtgKwHBmY_npWCc1aa4MYdrUrFD1sD7PVHATCB7DeYRSS0di9Czi8o_YcY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuqSC-XfqxthLh717O8prAkDyXqDioMz7R8Jb-0gdyWg&oe=6A65FB97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
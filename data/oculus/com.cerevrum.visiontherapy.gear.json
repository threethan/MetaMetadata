.com&_nc_ss=7f20f&oh=00_Af2H-I_oIHNM5T7WHXDFQ4LbJADRovCyRkgXHAiTkUCJvQ&oe=69EF6A27"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9auLeHL5DKQQ7kNvwG4Vz5T&_nc_oc=AdoQdH-REBGLc6zTDtVoI1Fvlnpe__whYki15HeTiEJ3wP92wnI4AhfARPGuUf3yGYk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uFB0ePzdeFXOoEpNjkOvoigMVYPwvdSSHeVDg48WJ8Q&oe=69EF4D69"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS0EV8HpB_kQ7kNvwH2AgKA&_nc_oc=AdqfxxBXqNidmDC34IhXSucxsGY-CbHTFeEI-6JGjXdfPgaK3jeD3U8wPM4vit5nBmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32__WFouAHwiQgibD0tYakvkJZDRAuRiNRMl5l6Poe6A&oe=69EF5497"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQF18pv-hW-nj1i-CNCoB_8G9ygTdmfF7_WXktmjtQbgUg&oe=6A7491A7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrmqkykATM4Q7kNvwF0QMyd&_nc_oc=AdodFy_BTRpEmfWhsD-a-bzddBPWap6D_lgkai9JHChVO_yrM2To00EBlVraiKLBFS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmbTiSXkXBpDARtV2Kmw_DvZ3HEw59OO9cQIvhTFUOww&oe=6A7474E9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIauukouJQoQ7kNvwHsWPPF&_nc_oc=Adpz2VfnxEEkuNWhPw-iOsJIV7JVtL-MucwZb-aRDXS0UlP5QfQoXyVCeZTWUw5DOg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENEFSINravkgFZcltQgiwssLg2SLeXPCckxsE6VnDdPA&oe=6A747C17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
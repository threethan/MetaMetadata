.com&_nc_ss=7f20f&oh=00_Af_326OXtgBdRAlP-XE5g6ny-S2sK0x9gieH7H_bs_6OLg&oe=6A2D60A7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI5v46p4ocQQ7kNvwGsJJEa&_nc_oc=AdoRvB1FxDDL4-4m9s3xq91D3hHpKM-aN-wWETq445GcxFnmWiSjL-InPenPYsHfyi8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8895ZepuwPzHL7WkC_PfKI42mnSrEowRtq5VIDB1E61A&oe=6A2D7C29"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDMeO0nMOFoQ7kNvwHrIwIB&_nc_oc=AdqFnmP0pijlWs-rvwkpwWyN4d2T2qDwX5v7XlOfnX4wfzyiulGnkD9A16VGrNgFjj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8PI5E22YxRhyn2P81rVZLIKRANLLYBaSIe_iQhmbifA&oe=6A2D4B17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_Af-LQXenPvggpbw25O-OthYpZY6shFp_EqTAFZKQFKN6og&oe=6A3E8427"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEdqjM8VIscQ7kNvwEIyStX&_nc_oc=AdoPpPAGeiNGKLpu0o4iAYJuAnOuOp1AGoPzG4pFAG6AN2dGriQImuJRXh4DZQikEnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1uvYFqpWlQebHI9ga0ARraUDNAG0hXZvXTvwKk6NDkA&oe=6A3E9FA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oIdBv5ntN0Q7kNvwFoEJvO&_nc_oc=AdrQgC8j4e1oavTuRqurofR8facdFDm9PLXzmzYZHWEmRQ5-DhHE3ywUwb8sp7RFbog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MzHnwRK3L4mUvy3C5OZfqEn_UnoInyUz_ttKeinxK2w&oe=6A3EA6D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
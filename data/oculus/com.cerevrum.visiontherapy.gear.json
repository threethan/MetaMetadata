.com&_nc_ss=7f20f&oh=00_Af7bPnf3QDqrjWa2AkEqknE2VB9E5HSgZi_-5PyqhqUGIg&oe=6A048227"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o75iExul2kQ7kNvwGvyo2F&_nc_oc=Ado7_WRoJVCmx0ANiAnb5Od2QRIfOH9Jsag4563ugLP6BsPwsVVMJF3RS1-BHVgswFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kS0sjN2j3tTLAxaaA24oI_IquKwKRAyrxW75ClUJ1Pg&oe=6A046569"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV6U3l6Zmb4Q7kNvwFHjDjv&_nc_oc=AdrVQQ2qNMIGRAz38McVxxhicfkEWPXmpcrCGFxNfI1RhHSncjHBj28708lr8nQy9kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mdCHjsTOMoN_kdxE2U_70UrQlL-9h4ZakXVGV75TvOQ&oe=6A046C97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
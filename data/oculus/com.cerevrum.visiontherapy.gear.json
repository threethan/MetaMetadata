.com&_nc_ss=7f20f&oh=00_Af-pP9_eFC-n59HGuji3SCQYtPWxneAIGSqDDWJPQ2bWJQ&oe=6A2EB227"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wwSzHBKJM0Q7kNvwHGtBUH&_nc_oc=AdoMGznpvugFHos4meBQbq86PxWtYACQFdOpIOpVir2zM8ukvFsas4n87ZeIjQsp1yg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IV0tfMrfsfHajLaB_UTnQx9fjeG7FYUj1Gn1usdK1Vw&oe=6A2ECDA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDMeO0nMOFoQ7kNvwGMsxf-&_nc_oc=AdpN9fFOLrMdbk3Kgsa4R-1XDWUIO2n504aXaphA1tUkZL96H0VboN4kwYRkmomRl78&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XSukrOxbMOLo45PwumqBiZk28bOrAGJDMDREqhR7miQ&oe=6A2E9C97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
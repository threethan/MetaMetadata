.com&_nc_ss=7f20f&oh=00_Af5F7d7TCQ4yiJl8mGMKYfodyM8HrBFuj4pghjotO8deEg&oe=6A1EE027"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvXRKDTTB9YQ7kNvwHDcDso&_nc_oc=AdoNgXei12fVkrnmjSMMaktcGWTUC_cI8SXSySoZD29ShMSHXLevE-b4tpNYp36GJX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BlU3YofNqTbgnTKoa-_TcB3zIKvRacdKAV6oOaUT3Kg&oe=6A1EFBA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVJwI5BQseIQ7kNvwGkZ4FD&_nc_oc=AdqABj20C9aQVzhtHn2K9cBWi1C8BeMXNsF0df204GZgeDV9Lwm0ldh7Z9-wuw_NNWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OifNNZ1rOBjA0c0VG9LM0zpWUHtogk1dYEZ4a2m7x4Q&oe=6A1ECA97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQQruC1f6fmkDmTtYNRe_k1TVPZmFDWkmvR_Ggb_RXfxDg&oe=6AE9E727"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ojLl0P70hAQ7kNvwFMoMly&_nc_oc=Adpv4tE4bTDnbHauITM1qS8tXFLp0eyqkZOiwpI8J8XJuWHg9i17tbOBgXVidUbZd_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMf9ucfzQZyIh-sotjO76fPqMGsZIWJBOlcNLFFumVjg&oe=6AEA02A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmYJcgG6zh0Q7kNvwGQJ4k5&_nc_oc=AdrG1jGfwuIM6IZP0EY0feaUD3AvyTIjEyc1cGsGNhhB9EdCRPbrXU8bnrqzPyVId5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_cl6J-niOCUSGQWR6sTCyYXqRzb8x4PbbqFfVq4S_VA&oe=6AEA09D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
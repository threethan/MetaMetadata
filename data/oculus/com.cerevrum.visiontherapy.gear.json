.com&_nc_ss=7f20f&oh=00_AQE7UHXouLWVTGEBIPmrrCDnOV4pX644V6qfG6aULbd6Vw&oe=6A7F1DA7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSs44Fr99wcQ7kNvwHDNAWG&_nc_oc=AdoMJWe4cED1qQ6mG3KcjFP-qeslq8gPOL53nXK1q-JfJIYH0noclrqB0dha44X0k3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG62NuZtdcnmfT0yge8mGit2kvK76rg3Ov4bewuESBPig&oe=6A7F00E9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp_j7yMZOiIQ7kNvwEoeOIw&_nc_oc=AdrqI9aG35V0fFh4QaOWxzwkjdZDByoBRof6Rc7siYTPwLXQa-kRqiVwjg9cBtxSMvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFb8az4IzpC-N6p0GJ1hWjDV-kb9SghP_kgG-BGP497A&oe=6A7F0817"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
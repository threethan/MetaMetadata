.com&_nc_ss=7f20f&oh=00_Af3I7B-XpHi9ejp-7I57YS02XiNEHyMi5l5gP42-1O9gbA&oe=69F4B027"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhzMscIXNWsQ7kNvwGlt3un&_nc_oc=AdoJ2WKlkNdfImwu3fWp2ROAGPwj8NwB-itP6FIYNgbJN8a3mfWYf7dpJuRejq638YY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yuyr88bftxKSk1QfLCaZ6d6YFQNRvuyY4DT4gjh9tHw&oe=69F49369"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h7t9ieHdtsQ7kNvwGz9O05&_nc_oc=AdocfLuion2bKt_1yuxFE9DQfTCt7CGr6sGbGypctHC81vDYNEYViJBg51Jso9DMjKU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wqEw83_W58jlidKkGw-134Kveq-4W4QfG_eTRvJvGSw&oe=69F49A97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
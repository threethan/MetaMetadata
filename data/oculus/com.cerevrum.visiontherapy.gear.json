.com&_nc_ss=7f20f&oh=00_AQLcVBZvEJj3_52l6af_8YUIvLF3vDNZXNGN8GLPKpqmrQ&oe=6A986267"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdMlxXtvrrAQ7kNvwGobclS&_nc_oc=AdoYviDTglDs45Gut-6WzpBSpGn5X3d3co0SAoAddRVQzdWcBiuaiEd4ikdh03t4qxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF05UwhTsu-Mwlc2eSgVD7Vpjeu0qtoxXymTmjkrX_Cw&oe=6A9845A9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC5oYI1-X7cQ7kNvwEWW_ci&_nc_oc=Adq5obIwQXO8Y854r7oAZ00FFL_X0LWq8krvQZBwJltxy0nMA5WFEbs1Hj8Qjpq-YuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC3CH3YYWKIkdoQZ2kO1hGOU_s3aFQQPSg5OoHZyD4Nw&oe=6A984CD7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
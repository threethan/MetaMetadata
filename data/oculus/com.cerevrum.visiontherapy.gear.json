.com&_nc_ss=7f20f&oh=00_Af8-nOcRk7GsKKcy1PLUtRrd6EmwXJlxZDNTGym0asCcvw&oe=6A3BE127"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R98MMk6lKaEQ7kNvwFfaP_G&_nc_oc=AdpkUsAVbb0CevrbHTzo-OlDtmPl25bgSaK53UKUu3tXk_KKI4HE1D8WYF_CUJE8D8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eStXqNw7Ka7JTF5Ubo-hDNF8-3OO8CK6PyjQ2kPvLtw&oe=6A3BFCA9"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DQL9HsghlwQ7kNvwHKUzfM&_nc_oc=AdrmAzx1OUYIoQxWusoRb5pFCvhSllvDfHtO_8q7xqIDxb1cvIUXvrqYZ5dQxKaX7qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ABvW-bmc_JUpw9N1DAirb-HVSP9Gsw3ewWXD5SF094g&oe=6A3BCB97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
.com&_nc_ss=7f20f&oh=00_AQMP-ppbFf0fhTAG6GwaWNmWwPH7Ed6WaOGjmTU87lgZXA&oe=6AD3B5E7"}, {"file_name": "migrated_image.png", "id": "208881450362458", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138843_1229798390411056_1701466670293319680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-mYk9RXh_gQ7kNvwHxKVAE&_nc_oc=AdqSkDuZuRr544h_lVT2Ofk77iDGAgYkFAANjL56mpbezpMdySKopBN3KgRw3ZsXk4I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz7Z9GMWoIOaFc1m_4423ELelD00pz-DmKREd1ZMKJOw&oe=6AD39929"}, {"file_name": "migrated_image.png", "id": "520974558830714", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12482214_222358041525570_3376895015455293440_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR5_gnrBxmQQ7kNvwE5ojQT&_nc_oc=AdrbSE2hitLjZ31LE5raza9ABM4r0vLaCRbOeqXLkMByGnoG7ZFmxN_Q_fY9QatQRf8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO812eUb-vMYkqG-rIWyFVlbkGXqScEC5nNkDfzDkHlVw&oe=6AD3A057"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Therapy", "keywords": ["eye", "training", "vision", "relax", "fun"], "long_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time.   Stunning scenery helps to leave all distractions behind and stay fully immersed in training. It\u2019s easy, fun, beautiful. VR should and can serve our well-being. Healthier eyes \u2013 brighter life.", "short_description": "Vision Therapy is a unique VR tool to keep eyes strong and healthy. It contains simple visual guidance to sets of 5 exercises randomly put together for a single session. Each set includes classical techniques which ensure that your eye muscles work proper: tense when necessary and relaxed when it\u2019s time. Stunning s
CAzUsI_VoD57Cazbp3jipFv55Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q08j467ABjMPl4mPsnWAv-IgT_rkUI6Ctmy0u7xsBgw&oe=69E37BC7"}, "display_name": "High Mountain Roller Coaster VR", "keywords": ["Unreal", "Rollercoaster", "Mountains", "experience"], "long_description": "For generations, the High Mountain has preserved its reputation as one shrouded in mystery. Its origin remains unknown, its interiors remain unseen. The dreadful sierra holds many secrets bound to be unraveled by one brave, or rather, reckless adventurer. Thou, come forth and let the world know of treasures that no eye has ever set its sight on before. Exploration is nigh.", "short_description": "Embark on a daring journey and discover the remains of a long-forgotten civilization nestled on top of the High Mountain. What tales have never been heard?"}]}, "developer_name": "Micha\u0142 Gryglicki", "developer_privacy_policy_url": null, "developer_terms_of_service_url": "https://www.facebook.com/HighMountainVR/", "publisher_name": "Piekarnia Olejnik Piotr Gryglicki", "support_website_url": null, "website_url": "https://www.facebook.com/HighMountainVR/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ROLLER_COASTER", "ADVENTURE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "639013217155313"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448961_2026094244087067_633536658599313408_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXyQxsy
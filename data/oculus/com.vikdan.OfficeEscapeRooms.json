_sid=6e7a0a&_nc_ohc=V9NTB97J8OoQ7kNvwEh31te&_nc_oc=AdprH68-os14HwcMwWoDFr1NXAVLShI99J44SxZp4ya9w4CutferM-uonK6PxbZPkkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTany_yzJZ1kVazED8nLt_SW3Tmgac8x4WvlmLwKkpntA&oe=6AE7558A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ALCoverLandscape.png", "id": "514478426666006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348038_514478429999339_583829579942729446_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70mCcerdBPUQ7kNvwEwCBNa&_nc_oc=Adp8hQMYsz1WB8IhYVazRxqKpJ0yxnf0pih3OrYYgEGgeHJ1p-Lmx6iLdFCIb_YoGA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxX5NJzpkwYvLIVP5-OeW5MUYaQ_MWO_YxcEQLLoCK0Q&oe=6AE74D76"}, "display_name": "Office Escape Rooms", "keywords": [], "long_description": "Office Escape Rooms is a series of rooms and areas to explore and solve in order to complete them. \n\nThere are 4 completed levels at the moment. Cubicles, Kitchen, Office and Toilet. 2 more levels are coming, and will be announced here on Side Quest and on our Discord Server as soon as possible. \n\nThe controls are simple and there are teleport AND smooth locomotion. \n\nFeel free to rate, comment and give us feedback about what you like, dislike and what could be fun to see in the upcoming levels.\n\nIf you encounter any bugs, please report them on our Discord Server.\nWe will also host give aways and events on discord so join us and be a part of our development.\n\nDiscord: https://discord.gg/EGdpMnq22Y", "short_description": "Office Escape Rooms is a series of rooms and areas to explore and solve in order to complete them. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://vking.dk/PrivacyPolicyOfficeEscapeRooms.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vikdan Games", "support_website_url": null, "website_url": "https://twitter.com/GamesVikdan", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
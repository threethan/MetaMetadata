7kNvwEFXaqC&_nc_oc=AdrwT1QGU374GdHFxYjmKOE0Wx_JvGkTGGp-s_g_-WjJsTCopqrQI6H2PqoRwEelnPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTURdvqd1Q0h0L4_B1wuIE19yDJRYTzdvaghQNWleSWsQ&oe=6AF5E3C8"}, {"file_name": "screenshot_2.png", "id": "1639291624569205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_1639291627902538_7794985106321573851_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkjRp6d6WXsQ7kNvwFpS9qN&_nc_oc=AdoTHkhQvkOAdjEQaqbBI-bglj3dyIrlALmnlRpjUScuxMcWaxA6cwPFT6hXEHXmzQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGRimXIrIvT6X0o31xXSC68zdyoHkzHEukQO37F-NSWg&oe=6AF5E8C8"}, {"file_name": "screenshot_3.png", "id": "1614050170365909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673645340_1614050177032575_2968235630250269519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbkeWUgDoQwQ7kNvwGJR4Jb&_nc_oc=Ado44mdkw_0BODKgFDzYvZswtzvpVM7Cxoqb5KXPy7d8aV2R9xb9nmdK60ptvR4eBVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ2aX9XqChK0LakmLZwP1kQ8XCg51-MR9F9BzrFfWEOQ&oe=6AF5C069"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1106595418562677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1106595425229343_5467085476028955926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8NtcjGjeTsQ7kNvwHCmiVy&_nc_oc=AdoLpddLrkKqZ8baqXimUICJaA55vCg12G3WaMVM5dghiNr3t19hfjBkgZqorqVoTD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1VZ0Jo4Jo3x9zDp2TqevN9lULG2IWbbudm5OjTFv4Eg&oe=6AF5F589"}, "display_name": "Flight Simulator Paradise", "keywords": ["flight", "simulator", "island", "airplane", "helicopter"], "long_description": "Flight Simulator Paradise takes you to the tropics. Your hangar is a bright white glass hall by the sea, with palms and the lagoon right outside the windows and your three aircraft waiting inside.\n\nAN ISLAND PARADISE\nA Bahamas-style archipelago: a main island with an international airport and a pastel resort town, thirty little cays strung along a vast shallow sand bank, a deep blue hole, sandbars, and water that runs from white-sand shallows through aqua and turquoise to deep sapphire. Thousands of palms line the beaches.\n\nSIX AIRPORTS\nCitiview International, Palm Cay, Coral Key, Turtle Cay, Flamingo Cay - and Sand Dollar Cay, a short strip on a tiny island. Can you stop in time?\n\nTHREE AIRCRAFT\nA business jet with a real glass cockpit and autopilot, a helicopter you can hover anywhere, and a fighter with a head-up display and afterburner.\n\nYOUR HANGAR\nPaint your aircraft any colour and finish, and power wash the grime off after every flight until they shine.\n\nMISSIONS\nScored island landings, a sunset arrival at Sand Dollar Cay, the Reef Run low along the cays, the Resort Run down the palm boulevard, fighter missions and formation flying. Your logbook keeps your hours and pilot rank.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join a friend's wing or ride in their right seat. Voice chat stays off until you turn it on.", "short_description": "Fly a private jet, a helicopter and a fighter over a tropical island chain of turquoise shallows, white-sand cays and a deep blue hole. Land on six island airstrips, then taxi home to your white glass hangar by the sea to paint and power wash your aircraft. Solo or online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorparadise/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorparadise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subsc
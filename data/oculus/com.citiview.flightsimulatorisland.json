-7&_nc_sid=6e7a0a&_nc_ohc=iBC-eMTGc8wQ7kNvwFAxeKG&_nc_oc=AdqXBIT6SJ_HVPkudXrZ6zO7qXubOe3heYGj4smnpQbshRBh3jUdl9yMxWaHxWihrL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwGe5gu0Qbit4uIUG21uC1AljkHSi4tiIjh1-YTARkdQ&oe=6AF1F2AD"}, {"file_name": "screenshot_5.png", "id": "2333935790695899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_2333935794029232_6080340927994687273_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqpoX0kGbj4Q7kNvwH0zmoH&_nc_oc=AdpapRtyZHejrTqhGdiqeLIQPDCW7LCw0FRl1WcqH1F3YbHCMnKLFlV4aS5juBbyeSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqSMHw7eOiv8wN9Zz2jv3Lta2m4eUyhRX4aRc9kI9_wQ&oe=6AF1E5D5"}, {"file_name": "screenshot_1.png", "id": "28457860173840382", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_28457860190507047_2451693681936219321_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVZ7OZ3xa9cQ7kNvwELtu87&_nc_oc=AdoFsU1YVYIUWn1eXP0tm2P7INs-ktr0shwr74YZFPXIH4bRXNuq-1enXSWedEsSx5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQmfrcW1F0I0A9dCT-b2Q5_2Yx7BAwz-UNKZb41e7MWw&oe=6AF1EF48"}, {"file_name": "screenshot_2.png", "id": "1639291624569205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_1639291627902538_7794985106321573851_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cL_qxyAmbzgQ7kNvwEkmacV&_nc_oc=AdrxqvwcmtB79O3KwrXeREDDrwBgKGilPIVyVjZKRyTFaJMVEw363zwjlc1vnlpUVzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpaY47daF7rIaEyxHg5JvrSVOwZOfjyKfLXzeo4AmrMA&oe=6AF1F448"}, {"file_name": "screenshot_3.png", "id": "1614050170365909", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673645340_1614050177032575_2968235630250269519_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=469vT3DUeOgQ7kNvwF_w49Z&_nc_oc=Adri68adNPrCf9H_jPXaqy3xfBZRLInHBjiHohkGVlBM0_BGV-P3-zztK0PYw7ixWYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV2qTN4ML0vvpE4ypsfAlE0HJVNuK8ZMApv5AirTehVw&oe=6AF20429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1106595418562677", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604347072_1106595425229343_5467085476028955926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKTAD5T-LV8Q7kNvwGkFU9a&_nc_oc=AdpEFE31k-eRp8hx-jj_xaIFI2RdIXXHzYBZj8mm0skIVPf26_X0yf5iF1EjgZ1clz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm2hshwTDh_l6LFSNCIk0t2P9dfLyOLkBW5uIz8VIUqA&oe=6AF20109"}, "display_name": "Flight Simulator Paradise", "keywords": ["flight", "simulator", "island", "airplane", "helicopter"], "long_description": "Flight Simulator Paradise takes you to the tropics. Your hangar is a bright white glass hall by the sea, with palms and the lagoon right outside the windows and your three aircraft waiting inside.\n\nAN ISLAND PARADISE\nA Bahamas-style archipelago: a main island with an international airport and a pastel resort town, thirty little cays strung along a vast shallow sand bank, a deep blue hole, sandbars, and water that runs from white-sand shallows through aqua and turquoise to deep sapphire. Thousands of palms line the beaches.\n\nSIX AIRPORTS\nCitiview International, Palm Cay, Coral Key, Turtle Cay, Flamingo Cay - and Sand Dollar Cay, a short strip on a tiny island. Can you stop in time?\n\nTHREE AIRCRAFT\nA business jet with a real glass cockpit and autopilot, a helicopter you can hover anywhere, and a fighter with a head-up display and afterburner.\n\nYOUR HANGAR\nPaint your aircraft any colour and finish, and power wash the grime off after every flight until they shine.\n\nMISSIONS\nScored island landings, a sunset arrival at Sand Dollar Cay, the Reef Run low along the cays, the Resort Run down the palm boulevard, fighter missions and formation flying. Your logbook keeps your hours and pilot rank.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a 4-digit code. Join a friend's wing or ride in their right seat. Voice chat stays off until you turn it on.", "short_description": "Fly a private jet, a helicopter and a fighter over a tropical island chain of turquoise shallows, white-sand cays and a deep blue hole. Land on six island airstrips, then taxi home to your white glass hangar by the sea to paint and power wash your aircraft. Solo or online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorparadise/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorparadise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1262093063663333"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1425861079648146"}]}, "baseline_offer": {"id": "1425861079648146"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790972520, "status": "PUBLISHED", "id": "1425861079648146"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1262114380327868", "version": "1.0.0"}, "id": "1799112787989338", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBi
n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2yvmUabw5QQ7kNvwEouSZr&_nc_oc=Adrc_8FDqAoB-Vw5adaceA4oYqbSYYMp10WuQIWuUjb6aYomTVMs1cO_10CZkpivSXY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zyjB9Hlpu4TRP4QCmSjDhTPi5hEoN2ttk73fZpG_1Fg&oe=6A2ED531"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I am Goal Keeper - VR Football Fun", "keywords": ["SoccerGame", "Football", "GoalKeeper", "FootballFun"], "long_description": "Get ready to step into the gloves of a professional goalkeeper in I am Goal Keeper - VR Football Fun!\n\nExperience thrilling VR football action where your reflexes, timing, and focus are the keys to victory. Dive, block, and save powerful shots as you defend your goal in exciting soccer challenges designed for virtual reality.\n\nFeel the pressure of the stadium crowd, react to fast penalty kicks, and become the last line of defense for your team. Whether you are a football fan or a VR gaming enthusiast, this immersive soccer experience delivers nonstop excitement and realistic goalkeeper gameplay.\n\nFeatures:\n\n\ud83e\udd45 Realistic VR Goalkeeper Experience\nFeel like a real soccer goalkeeper with immersive VR gameplay.\n\n\u26bd Block Powerful Shots & Penalty Kicks\nTest your reflexes against challenging football strikes.\n\n\ud83c\udfdf Immersive Stadium Environment\nPlay in exciting football arenas with realistic atmospheres.\n\n\ud83c\udfae Easy Controls, Addictive Gameplay\nSimple and fun mechanics perfect for all players.\n\n\ud83d\udd25 Fast-Paced Football Challenges\nFace increasingly difficult shots and improve your goalkeeping skills.\n\n\ud83d\udc51 Become the Ultimate Soccer Hero\nProtect your goal and lead your team to victory.\n\nIf you enjoy VR football games, soccer simulators, goalkeeper challenges, or sports VR experiences, then I am Goal Keeper - VR Football Fun is the perfect game for you.", "short_description": "Become the ultimate VR goalkeeper! Block powerful shots, defend your goal, and enjoy fast-paced football action in immersive virtual reality."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1755947379107282"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_1860464504621689_7500045251261612895_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rPbVANMfkoQ7kNvwFT3SdB&_nc_oc=Ado76DC4nuY0jiMVEllnU9f8dQBLIpyXSsQEAR2f8rdnRc5ZhotWeb5HoQvG_eJCsLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oUcFj3qoYjftDYGUZzhABDOBs-B_TchwphfTXeDcjIQ&oe=6A2EA74D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am Goal Keeper - VR Football Fun", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1779740460, "lastRevision": {"nodes": [{"id": "1755947385773948", "release_type": "SCHEDULED", "administration_status": "APP
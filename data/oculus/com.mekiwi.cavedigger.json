ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001727_1130238993840340_2424151538399182848_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf93estML5cQ7kNvwFGI1yd&_nc_oc=Adm9YlGGMvS52hiRwcs3MYm8EtM7riQZRlwcpuu_l8gMhSpsLUeGXlPW63NAmotsMug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftKkvte1-MU9enHTqp9Qc-6N2r5NKSWzzJZ-4vvALDFuQ&oe=699870DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape_Cave_Digger.png", "id": "1269024983756439", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036614_1269024987089772_3848843021127142018_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExapOd-_OQIQ7kNvwFQE6O8&_nc_oc=AdltcvJBArxDhVQm8hcCsYDIkXudSkWQCCQAeGg5mzXA8IXlZACesR6pR_qYAVvlqaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs3CSYGMCrJz_1zGUWBo9BVp-aIvx3KHsSA3NF2olrSjA&oe=69985901"}, "display_name": "Cave Digger", "keywords": ["Digger", "Western", "Adventure", "mining", "Cave"], "long_description": "Now with improved graphics on Meta Quest 3!\n\nCave Digger is a mining adventure game taking place in a small town in an alternative Western universe full of mystery, dark humor, and experimental tools for the brave miner! Discover secrets, easter eggs, and multiple endings!\n\n{2019576195147413}\n\nGear up to explore the town and the depths of the mountain. Excavate bedrock with your hard swings, reap the rewards of Mother Earth, and trade mined valuables for new gadgets. Outside of the saloon, a town in ruin awaits its savior! Fix the train to enter the mines and dig deeper than any miner before you!\n\nHow much riches will be enough? Will you be able to stop? What happens if you don\u2019t? The answers and more will be found at the bottom of the mines!\n\n{560393183497708}\n\n# Features\n- Explore the elevator shaft and four massive train levels full of mysteries, riches, and strange encounters\n- Build the way up to the mines by gearing up your train and tools\n- 9 unique endings\n- Meet a companion to help to carry the weight on your shoulders\n\n{541702068848475}\n\nFor the latest updates, insider peeks and 24/7 Saloon talks (memes)\n-> discord.gg/cavedigger\n\nCheck also the other title of the franchise below:\n\n- The sequel Cave Digger 2 Dig Harder includes the first-ever crossplay at this scale: pretty much all platforms in both VR & standard gaming!\nwww.oculus.com/experiences/app/4687168774709280\n\n{1976064879573710}", "short_description": "Cave Digger is a virtual reality mining game in an alternative Western world. Gear up with unique tools, explore the depths of the mountain, and discover secrets, easter eggs and multiple endings!\n\nNow with improved graphics on Meta Quest 3!"}]}, "developer_name": "Mekiwi", "developer_privacy_policy_url": "https://vrkiwi.org/what-vr/eula-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mekiwi", "support_website_url": "https://vrkiwi.org/portfolio/cave-digger-vr-game/#report-bug", "website_url": "https://vrkiwi.org/portfolio/cave-digger-vr-game/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24249379121405074"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036608_1118156746223909_2103085767345964526_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_
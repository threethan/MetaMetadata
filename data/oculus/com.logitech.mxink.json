34087164771261", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298281_1234087168104594_1699296495370824017_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnZNg3RLNegQ7kNvwGNYCML&_nc_oc=Adp0FGSpcVQWu94AmfsJGSS3rsqJHZqRJo2AlRT54sUbnfBB9h8_bTnLxhHAde1wihs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4ZDAwZKzbq3FXUANfb1mXCIVIPq_nr-A5jYhdb1Hqlw&oe=6AA9559E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Logi MX Ink Experience", "keywords": ["stylus", "Logitech", "creativity", "drawing", "handwriting"], "long_description": "Unleash your creativity with the Logitech MX Ink stylus. \n\nMX Ink Experience is a showcase app that lets you tap into the full potential of MX Ink and Meta Quest. Write, draw, sketch, and even trace real objects to turn them into virtual models. \n\nMX Ink offers a familiar pen-like feel, precision tracking, and a pressure-sensitive tip; you can explore 2D & 3D creation in mixed reality or full immersion. ", "short_description": "\u201cWrite, sketch, draw in 2D and 3D with Logitech MX Ink\u201d \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.logitech.com/en-eu/legal/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Logitech SA", "support_website_url": null, "website_url": "https://logitech.github.io/mxink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
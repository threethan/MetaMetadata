al of MX Ink and Meta Quest. Write, draw, sketch, and even trace real objects to turn them into virtual models. \n\nMX Ink offers a familiar pen-like feel, precision tracking, and a pressure-sensitive tip; you can explore 2D & 3D creation in mixed reality or full immersion. ", "short_description": "\u201cWrite, sketch, draw in 2D and 3D with Logitech MX Ink\u201d \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.logitech.com/en-eu/legal/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Logitech SA", "support_website_url": null, "website_url": "https://logitech.github.io/mxink/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10062174327207815"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294598_1218925879699123_2216490228400302207_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZ0YIxQhCgcQ7kNvwG8Kat5&_nc_oc=Adm-R_RMlol08ddWt_CE6DnuTBSIV8pcEWYf3cRbxU7OpIhwjfhFG0gw7JfemIwNwms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxObjelC7IKCO9AQyYMuhZXRzVp3iN-o2Zd6Wr3R_oCEQ&oe=69B4029D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Logi MX Ink Experience", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873
b8TaocPBUbk5FsG0PcWd2NpjWgoIZi6OH2IFK5vtIb4PVlU-BwMw5cEtP4t0uPw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoCbpt_hkSiMPOqTX0qMh-EK9ngn7Rm1m7ZpflpC8MpQ&oe=6A71F345"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3X4htYWUNIQ7kNvwHB9zvw&_nc_oc=AdpL1rCS6JIGQbtV7LYniVd8RFn4IVR7DBryV05XSD7FzYtTZeIhg9U9PO5xtllzVqg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHckuTVGdV7fb38-te77RKDzJsXIblcxbUPOQ9R7Dw3uw&oe=6A720477"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkJfDhDaXFsQ7kNvwEgd2gM&_nc_oc=AdqH3MSOZRWZfRkwHfvPK1o5y1sed1ANgShCnYk8n2rmUzsa-xxjwKdfsk9XfxSokac&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF61LxgppWstiMz8KoZ-zBU69wSTccMRLQvrtslfjeTTw&oe=6A71E30D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C46k5YFLWp8Q7kNvwG50dtH&_nc_oc=Ado66FDFlEFmqwtvzP0OItBo1t8R5ehUNrlvDjfMSwFhFPSfxcwQuEc5paUUALQicZI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiT2Ly938mn9KK_qzkBq4b3uwx7bUDLx01T7Hlb1dR0A&oe=6A71DDA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAIdyYape08Q7kNvwFKzhjz&_nc_oc=AdpjXlNW0isl3nRatTxogvO6pzo-zErD9jvUZ-NJRiCqS-YBxBGYRNiqPgQAcreuvYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTPstrL2st-aCTYsb_zWs24wxEAsIuNyV9rlCf-_8p3Q&oe=6A71D93F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
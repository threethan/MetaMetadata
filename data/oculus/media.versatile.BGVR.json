StEeRuYMieawQuezoKVZGBNNFkYzlXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvt_5jqgyRDPfm2W-582LFyE2z-335g8-uX_iHrQ4HALA&oe=69A83DC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWOrFF2gLd8Q7kNvwGyMfIv&_nc_oc=AdkOoaw_aHm8ujwkE13kw4Kl6KhO_5nVLQ9VHk5wWaLNcSQMEvuHqHcLl9XGKk0kJkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftHhVuL21gMJDw9zFulYNfNWqWXq5VQnU0z9VIgnNLjBg&oe=69A816B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97OHtH7elpgQ7kNvwFXla1W&_nc_oc=Adnid0FQK4eAIfn0RGVMHVqYTUmVvn-_joHxVDoSXRvrK9X3HSwjLp9RzQ1pjJmv3_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft17TZteVcyp-RCGn3UpPWgiq5yjWWSf3IrgmbEL7sXnQ&oe=69A82D8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APGxOPlK1G4Q7kNvwExaKAB&_nc_oc=AdlFQZNl9YMRHqyP26uTNLHLLCcvT89WMbgw62ZHzcHAuEZeAuA5wswpFPYglJOAajw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7lUsgXGsgd8gZioyivGy7MYxAlSaS6vXv5r9WBOa1Ug&oe=69A82828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMBoRBWlAxEQ7kNvwGTukpm&_nc_oc=Adkgu46hV7r6O5zWcwrz9Gj79CF4F9duUitT0GhRUvPZX3W0BA7ybYxjBJfT7uXT9RE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvrWjH37rNlOa22yccNGKTiB2Z_haunGLKiuD21uu3xwA&oe=69A823BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
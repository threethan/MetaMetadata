iiDXqJ4eMhGSB6a6poR3hIa7amCz5yDVUWol8VYtS8wUhWE4HjCwKJgkH2-_wtc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vzCIJ6uXRbEFs9Tq6TABxdfeonRIgJaCofQuGlk_1qg&oe=6A427D45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWr3PgWFplgQ7kNvwHaDXRw&_nc_oc=AdqLjrFUll1rlTpY2sUAb-DamNq5jP4Jp8ji3C_pjrEZOsjtXLxyW5wIGTg0oH2bwCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9txX10sp79IcmExmaqTqqk1ZOWn_Df-wSYSdIynjDRbg&oe=6A428E77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qH1DRSWoaG4Q7kNvwFuOmnU&_nc_oc=AdokiOUJ-WADjjwiU0hXJgiQo-zoY54YtGW1pGG_00VBbA5qTXOJUm4ee3ASNcJu3wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lE5egA48yjdl0vBG76Q8MAFv1Q2Le0hYl2JXUFUrAmg&oe=6A426D0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbW3l4NyhhEQ7kNvwEAY165&_nc_oc=AdpHXyiRTFKKEiQlZ19YG5qRhx5ALfUZX6Nl8y3aw3loR_lBDbDHugkMjtJPNyKV-as&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I46txeR48PXM0wCcEVro-4SXCtEUoKeVl8p74B1HBHg&oe=6A4267A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxUCBQFNW1MQ7kNvwEr68fB&_nc_oc=AdrrrzbpL3wcv6EPIPsvbNqorfnp7Bu6Th_n0F_REFqipZcUthfySU_XhvQ0miSwqyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wxat66PaoBLXC-xdFcwxT31FbM5jkMmOHx2U_3MQhNw&oe=6A42633F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
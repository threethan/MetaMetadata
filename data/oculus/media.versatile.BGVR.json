ZXSal6EgHHDzRmf39HXc6Wmw4kiDE-ohnrSdhyGc0cpjML_03lAGRrvDMeBgbb8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RUdsa9mpZSDvtg7Gjfc_mLRvEe133ugiRmc2pgZcpmg&oe=69D7B3C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctog6y6oEQgQ7kNvwE2QU6P&_nc_oc=AdryfzAdbgRSaPEXnisg5KaDP15gXnlXoLzz-kr8JUuTiWL2UqSPRDOAkEPr-jd0Z2A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G5SgNJrsoq4duHL7P1sEPyoAodw4P7VD0tsv4tdNuuw&oe=69D78CB7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhccvFoVWykQ7kNvwHuK-Is&_nc_oc=Adr_WvlqWlKAgUI3tlzC_K2rnULTPhyMEJePlJwXgw23gRym9-lNu-EGS6svZd21i6Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bSK7MAdyneBg16zw898HdHlrjOHR-UdSRkq5umDXTSQ&oe=69D7A38D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLTxLskrluUQ7kNvwFe2_4y&_nc_oc=AdrLOlDA6hCV7IYxkV8h1cHMTsCBl7jf_HgYmc2G1NJQ8cnvpfoVZpD5EEFGL7z5Paw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tWgpJOmllc5uB7J754FzGpoJNrzTmLH1dPkMHj_CSQQ&oe=69D79E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvnaXXXBpG0Q7kNvwFXFQLF&_nc_oc=AdqM23xa60KxOFwL6uPaSeWVKVi54sV8TqaHMo0Jg5llhprqjIDEq5wFC-eOe2cFT-k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RXl5TKg_2IXDOI3P2nTyOdO0PLBXmHTad-kxb2kzIzw&oe=69D799BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
qtGm7ccg7OrHnjpAfOVqpLHSB1HQNoOKRgOUA9wyN2psKecl_ddG5_hLcqWCzo0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvbQ3oUbZfVxlwL6EFN8Cet6lVwjnOkdpOI1DV5tK2mw&oe=6ABBC745"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=273fI5T64NIQ7kNvwE7DOro&_nc_oc=AdpPjJe8IkHOVRSq0xbemZqaUBf9Ev-UWiy5i0NWAX-AJYgKXvDKMM0LDmqhhoNimmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQAci_sH5-GNwaLkzV-cOLmYLFIgXiLqZ4zBC0tNZf2A&oe=6ABBD877"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PO-op3VSCkQ7kNvwHCOfhh&_nc_oc=Adq3D0wnrNCRkqsclfSw_mdYcABQYOeuF686qUZHoXu2iUMlmfWSawKvkaQSJ2_IvLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB3I6hVYGFVMN4b7g_cYxE4PQhakXxMW_xJxblLW6scg&oe=6ABBB70D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7OA5PXJpzwQ7kNvwGigg7H&_nc_oc=AdpMhbUivb5ORSuxsYNhQaHsvWDQLO4p0xUEAAtXGVnCeWKixhcVzq9V5-X-SWJdJFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0DMHJhTn_wuh3rI5e9lhPEMuFPcskt0C2Qxwsi06WHQ&oe=6ABBB1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF6XgPkYXSEQ7kNvwFOpgmh&_nc_oc=AdrBDHYwMqcll8fgvBUo5CxJARIZcOCa9miT7aEsFoGPu7CfW6NcV3t_2Wtji8TAKYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJP0DX0q8sHyrAwmPxIE5ydJDhb15OU6VC9TdwRyRdQw&oe=6ABBAD3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
n.com&oh=00_AfuctSgfP1HdY4X6La54Zqj-cOod-_GkiQcqHntyVt4qDg&oe=69A44945"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhPK6ci3q9oQ7kNvwHQvHcZ&_nc_oc=AdnHfV3Vx-6rFeCNE2-vjcouXlKXZCTXaw9M38RyO1JTdTLpXHsgG1zNsm06t4VyjVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv2UGoeTCsFOWHbYxH7SH_We93Za_hknUvMHE5LFPlJlQ&oe=69A42237"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx_c6VQg3ncQ7kNvwGbatxI&_nc_oc=AdlKJF6Gh4LamBS4fUaN3ka6Kz-c4hMAzWxmZ96li-e9pses11ykP45Lq_8DCyGGm7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvUIUlkwdEAoxC9gcsd4EqQaRYoFDkiFx6HNyVHyOqcFQ&oe=69A4390D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKpyT3AZDqIQ7kNvwGSCRN4&_nc_oc=AdnWda4oT9Y4m8G4S9K2UGjZs4rDZj_yRoQfX9lw01XXmYLa7B3JpTAQuE_uBoklCME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuro3LZuTSoc1JjidvVDhzLSWFN4jN47XD88OUqoh9btw&oe=69A433A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17asRXdi83IQ7kNvwFu3YDJ&_nc_oc=AdnUCCwrXJoKMSC4Yqkqix0bnw9ByUbs8D4_18oPr2gt_jkNutKUWKyMEe9r6pz_JCc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu34A-Lh5uSJqV24JHq_jJMlvJpizpx-4o5nhLWsm2rmA&oe=69A42F3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
ontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xFch3J98IoQ7kNvwHOVRA3&_nc_oc=AdolSo2k6Q4m4DOTzx_8V12QYQaT2ckGoveEcBeiD4nW19ybbs3xDZg16GyUqlrn91I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWeWJnyW4z2izUiviJGYRUW67Jx2vOVy2-svpNMqxw5A&oe=6AB540F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z93vLBjlGtQQ7kNvwG2VdUx&_nc_oc=Adqrg6MuLFtoM3suypYjsJ-mE-jrrvqdrqUr321S9eT88-1JZXUrfOzYYY5OQzAlDVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIs1d6XmvTbD1Whis27WuhOZME4uKgUVb7LrMIID9C3g&oe=6AB51F8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GBdxc7vno0Q7kNvwFpm8Xv&_nc_oc=AdoMl-kcKzocHYu6Ui-0qJH1h-w0mVGznCyHbQSaEAHuX1GH6zMbajFjepnzVsvil2I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjtTx1WhOh7x67YoVSDgX5zf5_z973bSLaBiPdjuMHHg&oe=6AB51A28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj82BOIEhUQQ7kNvwGLp0-o&_nc_oc=AdomoWUTmRelzAo1hf2D8yUIvd55A5WCHG6az3EGmxCm2qgqiwuBPBFZUxL-56P0rko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxfRcVDQY6I0IVBcyctMpPCHdvx4FOvT4E1PO_aAdmzA&oe=6AB515BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", 
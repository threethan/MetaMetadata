erTJpf3JyNiZ9dJldYXjAjK00gV_Y3JxqU96u3srLTBH01ceAuCKxE1m3D4IwSI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_ZSQNGq7hGcnBf7DCKQq_LWFFOF3_qi7clgXHi9WzPQ&oe=69E8D745"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbR19VjoWLMQ7kNvwH8u1h4&_nc_oc=AdpQMcwlW_J8fdCGXkOz9ZB1xPWQ4Q3iAtZbWiBwY1FuOkoKJS6NrnJMwJ4PwpqCm1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tc7afYEzKZuXK_mZ3R7AEGrA3ok3vRaRh8ZL8_ffgVw&oe=69E8B037"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxB_hAlDgQAQ7kNvwFivDxu&_nc_oc=AdqOrzQT25ebccgMSdxf75uJ92AntnmCffuEJ5hDmLE8aVs-l4azpEhY5ga_4chCD-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3apWJvv3VrcOxhWvzZRGQkxbCZU1XzvvJv8i29p4jBxg&oe=69E8C70D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uEhQpoTBYoQ7kNvwEBKQ8z&_nc_oc=AdqLwJ4SzSViGdvdL4wGG6ouPhCmn80DXlwwhB3Mt2cCKs5NTbwqDaSMUNCqOuXbPAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af324k0v9WvLppEmbhuD_PAxlUiC2wUbrs9ntNn5aBmftQ&oe=69E8C1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7vs0fi3xOEQ7kNvwHNq-cZ&_nc_oc=AdryPQq_hQmoaUCYQloGIAY91DK1_goIgEtZ8j2PH3ZzrEyg8Ii32NHRrWCkd2TfRPo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OQA9_kqKaZSG04NYC2QXuv79AFIvH9ViQEKn1R51eJg&oe=69E8BD3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
rRo7Z5u2FlEyAeu_Bg9RDE0O1WbnwIahYbQ7adSc6hz6a1eaZC1288-OGR3ERzM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gvAyXSe16pK3-NLUOimHFNJ88y-sPK1WjHK5XOWWpig&oe=6A2C13C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTBcc63DrCIQ7kNvwH8WISm&_nc_oc=AdpNidDXitPtlrThJY7inHbnH8TIQsx_3hDaOnKqh2OpC-Tx7MYUMZH2ZbvJn2zRvFE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x7jbhk5So9PP-9j4md0eHyrXFgFfFotjaqAY8SYjCUQ&oe=6A2C24F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPsoEhgU7rYQ7kNvwGoZPCK&_nc_oc=AdocsQSesvFYWMX478y7IHM1cHQMrj-z_RmtoqkZazkpEM_S2IhAiATUJE1O13YAsPE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JwNNxsz90gDcfv-buQ28H-xdgVFxaanvD6Kvl5En7Fg&oe=6A2C038D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVEfpGdYRRgQ7kNvwExFm1U&_nc_oc=AdoZ48Wjco_kYjF-UvqZCI23DB9eFmUE75lVYk5wWgm4xoCctXS4qvusXoSVWaS15DA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lQLPC_ORFBJEU-4_6KydRr3ZAobwk1L7pTLxbRS_xfA&oe=6A2C3668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgsc86AWr0MQ7kNvwHdMTh-&_nc_oc=AdpsPHyO_4fKp96IAQ6tjGvj_sT51Vqno0QxBTr2iOzTdc3t62wAZf7sOh6_t3Et1T4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EX7mbD0WN9ZxWk1aeBJ1bpfP0R_R0Yo0Sq7drGKLGvA&oe=6A2C31FF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
wOwvHW3EhqfbKK2w1rhyAVrhiOT_gPVPiReDvdoxQ0jDAjp76QS2NrP7TuiQFGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqs3mFg89pA6dUEVQ3-UHMSDb_DGCk3YpVow3FLg6L-Q&oe=6ACB9945"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePuVi3KUzLIQ7kNvwGqAHHI&_nc_oc=Adpr9Sl19hG3qPyOnRJRBIn_woRXmbcFRIn_cDl8i29ATSmU7pUv83_5JDmFLdudkYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPV4Wtcz1MDugC0bKSXAgD3HjEKCDCTIRv6tqQgn4Xqw&oe=6ACBAA77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYihvIrAZTwQ7kNvwHEckSb&_nc_oc=AdqcdLxLwGi_AOSW4tu0Uxrao090a3EplrnxoLpfn4q3YuY6aS8hnbxuJSJT7jXikzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOrUaaX5NDwKLkZ9lb4G4yeDWY95G1JefO3zfaR1cOPQ&oe=6ACBC14D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dK8BjO5I-msQ7kNvwEe1aJr&_nc_oc=AdoyAaRnOqWHVBBH-go04EOJzGJ2FE1R_rnz54egw4CU9ob7n5L0o9T8zoMj3eukrrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORiwZtrH5i4wWzlpJiDnz5rhxgfypl9pfk82p3LPqyNQ&oe=6ACBBBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaK9VdUSS8QQ7kNvwHs8c0Z&_nc_oc=Ado-vGmpwyBzcPM09Tyil1IeXBOltvxAaBVk33u1I1qRmTlrxWuOIEjHawHlOHiS8bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDJp9H8ZgST3xSmdJ49l-tpBWhhN-r66v7EV0lQ4nbkA&oe=6ACBB77F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
_iiKzrBTqUF8dCmsCzNd2LgdLsvON4WWSUlxafOpGfNYSgTYbHYXTk0HfLvCC9M&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kZYa6QgQXPPbQMPaKrxXgq7pTF8jkeJBhbcHRUmqMIw&oe=6A09CCC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaZiJtCSS3kQ7kNvwHwCG2H&_nc_oc=Adp3Uy1GQL27WdfN6extt4_67hRgZdCWoUchvwxHuCDl2mEye0rhMQywLYCfkSHCuG8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bpid-zhDJxWNiXBdqvbLGgUWjagb8oSXoqy79Bsi2Jg&oe=6A09DDF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnko2wFBtI4Q7kNvwHEjxUD&_nc_oc=AdqfoW5iQCi4CrPdXxr7V0D-BXA1VJiD8TjgdHbGw6PQCsFKeOi4Hz2UEZC4agItNCk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aT8Z4CYpFwitfUb-yNsfQv5NJdcMpjC2sXKE9F_XcrQ&oe=6A09BC8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rpjl_uoPPCcQ7kNvwFRv0mD&_nc_oc=AdrUOinviwCrTw_F9XtupsLER5hp4Ni9D9bVJudf7AeLJkXxA8zgydtSqoKmx-LHLQ0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79IyGWKXKYpnVFI-KUFEfFySeSMQsdgLmL9kEQ9-IMJg&oe=6A09B728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ak2LNi6MtUoQ7kNvwHjYbO1&_nc_oc=Adr34IWqdBvpHPxdB9DAGevvhSguw5d2ECUBxzB3BaA9NwibK3a1Rq6AXWp_d3MkUGU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kgv71M-9E510JQILJLTY5Hn7txdiM8Lzxm5eDeq6oqg&oe=6A09B2BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
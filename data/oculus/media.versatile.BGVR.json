ibXO5Xm9VZxDa50t0edNubdUathOk3KK6gwwJlad8N7n2K-truo5sDCpGjCCd7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwioWMkdlM54J9tuia9pAu-G1ub0Uv0zKEsBy76EvDY8w&oe=69D11C45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSgpnHeQO2wQ7kNvwG2Xp2x&_nc_oc=Ado5YV4-ScWv7NiMehBTb1Gib9D-ZqulC1Hh3McRjDg8hxkBjjJc8WRmI5OhGCLfV5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRqP7GKFbtujhjIR_8FrbKIz98ZTXfOq9yPKo-UJHoCA&oe=69D0F537"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID23Gik0rFYQ7kNvwHXo9pI&_nc_oc=AdqyDbxpzWZRqnh6Xy3Ig-jm2OVwQ7l8UgFYoDb0E7UB4jGMEH_ah74XVdDkz8MqbLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxyrof38tIKRkB4fD90o-dTmuH_fYqUU0J_NYARVN-eDQ&oe=69D10C0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npf0ooa3Rs8Q7kNvwGkr8eq&_nc_oc=AdpnFeQCnXHy4u5_h6YX8vfVHp13AQyBmxfxpeg7L84k7dQxgce3Ez8WbV8gQitpPJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk5dTSFTdNGoh1xfOo9tPPpUJZV3QpnstSQpMg6lLbNQ&oe=69D106A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ikNfrTUwAcQ7kNvwE090Cm&_nc_oc=AdpcJWub-bvgLmyIRBmdn5qTIa9Qhs6MCv9EV04aIFYE2Qb2lcJ43nPWefXO7Ll2zpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9OLiWlZePetycGC0AhaJG44D5oI15RtouzuQpwq4HSQ&oe=69D1023F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
ed7BIDWvcwDZMDvXiYYgaUau_aUbOuGq40I9_Ji5m_0UhmIJIbXIHoQWG1_AvSw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ult51bkxlrmgy2DrhDbopB_4ZNrb_hqmByg5HrwJ_nw&oe=6A130745"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFruED2zEFAQ7kNvwG65pg9&_nc_oc=AdrY6EhfPofnLEGRV8bQczhGnlpOEY7viU1gnCSppPmzg7wSI1sHOWGPHom3qDC3v80&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eet6j-9RInMlvG00JR7kAdeV5g-edgzBtkJ2D6-cSuA&oe=6A131877"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSUrtLhW81oQ7kNvwEEWo4Z&_nc_oc=AdrRxttdjsdiK-l097XxuDjElKjZuSIJaozvH9JQhHXO_aEg7eavgCvYoj0oAyLatVk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U8-dCTIwA0aK-7V_4izzLXHUnzozBBkcSme1YsdKoqg&oe=6A12F70D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTo_G_UQAKQQ7kNvwHsF1CY&_nc_oc=Adq0mOQ3mu42HLp7txmyiW2Xa2q8SSXN253qlmBNp36c0jVqtEk4amgyZ1LqAQPjUz8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UStbx6Bu233Qt9ZVIlZjjfpfOgb0MYzOYQEyr7DwuCA&oe=6A12F1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMn9tDgAtlUQ7kNvwHxoTwd&_nc_oc=AdoJL18mNoheSi5b8cyQN2rMCMdA2BNBA5CK3cQ5lCZAiKoe7w06KLQU1kc3edn9p4w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LHmCSgeEQAsfAiNoJjjGWyNUL4JBJdh4NR09P9rBoMg&oe=6A12ED3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
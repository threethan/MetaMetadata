V4WHpjRBGrBdq7K4h345rvO5ihbmfZ9NmKP6fgVWg7GP-lONJic3nYaxxrMtNHk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8nrK52HBEX1PftDf2cePRz2gQotQ5cBst0Q9SzOuwJA&oe=6A32AB45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNl2yWpbMrcQ7kNvwH-3wct&_nc_oc=AdoYjxol1YrQjf5ydzsaNbMOTNmC6aXRysYUIo4mfeD94pYHSSpvmlxmmdbua2mT6RU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F_Vrmk-qw53rIoc2FSazhy7n-6SPThITG97HbDjsDtA&oe=6A32BC77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBUDm5Ivq1wQ7kNvwFGv01W&_nc_oc=AdrIUZKCT5n7yg5pzFUzda6vVwEXhA1gPGRMsIO18CnvMwSt38HUaUonI4Q67oKzmQ0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83xj7zNKfKqlLWlIRikUeHfbsqzSqD-OvJbrbs3yfJlg&oe=6A329B0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7xoP-bdGLoQ7kNvwHc329I&_nc_oc=AdrDOJZdv1uNQ_KIqGTseI-NfPs8iVKiFT2btuCBeiDGq289cgJSO7orGTiGER8IX-w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZxeQQkJSTjZyiseuYv6J8ZdQUjBq4zBL7AB9mkLnMpA&oe=6A3295A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26kB8Q8D4gsQ7kNvwFcSDJZ&_nc_oc=Adp_-VUw7QVfZI0Vx1pVKBJopm2qgi3F7RsHzSWrGiw7uKi8at2hRQ50b5Ax9Z6_6lY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89I_rQ-NYwWv9jCPdiqFMz1ReS7VXMXZWQiIG1XAIGTQ&oe=6A32913F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
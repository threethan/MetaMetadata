i42Pg_HR6gsr3yijlKoXUmdZZeKP7TZlDOsS00Nx3KGiH9AljOdo0bDdCtv-gdg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH0OXdSy39Qh3nD0OKySMP2w4XqRVYe-vHD_IOiZH1kQ&oe=6A81C545"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNG3pQixrE8Q7kNvwFj623E&_nc_oc=AdoCUVRNzAXYpqmlhW77wbY997hbev_ddB6BVFoSt6tfXZzwCApRlTydbhW4mRN7lmY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqq87Bq81KLUCbiaN-jxt2Hn2LjEKIYkQgkk5K_LhGHQ&oe=6A819E37"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH_IVjOzaRcQ7kNvwGAgeVl&_nc_oc=AdoxXYRI8JB_oVOHrgFqNRp7BF-_8UJFL7fTeATgNAK-WYbYF9WiNoChh5_IMbmVvJ0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyThw2v-XiSlAd17tK4rnmJmw3QOSd0WdAPfc1Kf8kdA&oe=6A81B50D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rcf1x5I_-eYQ7kNvwGY_J4R&_nc_oc=Ado4gGxCRWa7qtQkW9nOK7kjfQxe2YzVj2vjVEU8gA-p0zVflkvksbIgDZoeIBDjsTc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhinBeBerNiKPqdpbAD-ZSWQWQoE6mKmJKD0BrVVslKg&oe=6A81AFA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh_JzWhFDH4Q7kNvwH2miPa&_nc_oc=Adq5Ss-t7E6UeWGcC-Ao2savnok0bw0UaUOA-G-UXBx2UvXLlaovwxoMblxaXlhcwiI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpSGVFM58RcDjt9SUGwmrT3hTQdls08GnIDabWzpNXJA&oe=6A81AB3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
wE1UKvQPjNCSgz34wSPFx6CxKmmTftIMD4qLowkqiHmm3WWhAUZaTkOnJZhCRRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9ax-9buXVHO9piJqJyi0_na8d0rSXRRnmkwUVM6AgUA&oe=6A92B085"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA7-qnljA1AQ7kNvwEVFJfB&_nc_oc=AdrTu403m4oeKUmLEKCQvkz8Z3Bn4j8uKty3EHMlsfYDCy_PsAaGTFJH_ubFx8p1YcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKGLld7EkTUzAQ-cn4QEptHZKzaFmHoCitgwyD4fKJBg&oe=6A92C1B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cin5vLjXuPIQ7kNvwFT2UqV&_nc_oc=AdqdNrLSNrlDht5WFvriKUoJye2D0weinxN1rQkUNyapYiEzYZFUzeQ_RiPZuXwmQaM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaqedGDpQHhY7oYzJnHHHUxekFgYlPrfWPupyuZjKmtw&oe=6A92D88D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oxwqfb48WEoQ7kNvwGGuj-0&_nc_oc=AdrGjnWWchdRYQqS9ywOy1dB_i6vOKqIUYRWv0CRH9qvfC04xgYOp43lv4uvqP8OQjY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEr38OuNIUH5fEGH9GEfhIIqIY193i_ScyHpYblw1tVWg&oe=6A92D328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBSkcBb6b3AQ7kNvwHDNJw8&_nc_oc=AdqaKcgdWZRDpot75zV7bWN7Ts4LuwRsmjVQ377c50vIA-Q7UDL7VIOEBOqyYlvgQ2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtFzHjviEezEaRqYu0VtQ8AZ6stLxUTIlq5vXdpPvZag&oe=6A92CEBF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
t7dwgLXarPqdKjji4JOz3HZIapczDy7-W3kVul1d2eXQ_ou0ekdkTOTmecSXfrk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOy3b7M-JnNJ1FadNNhyBf0n9spLiIGVV0IPFdo5bDprg&oe=6AC501C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4ld1aR25Z8Q7kNvwGHY0eB&_nc_oc=AdoefVYTgr5nhErS572riqkUklk_dCBmNYTkU9o4upYmeQVImIQNaOt9Ig4smmeg_28&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBkP9YCAIOuxJHGIlMYACtxAxUQRbxHb3cIh7ZPNImIA&oe=6AC512F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6sZQJT_wuIQ7kNvwE2Pktw&_nc_oc=AdrNDvnM55UbrEQIT-5HKmfszBWMHn4845eIvnI0-H2vnRncDPZ0MbejYaqZSo6367Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjM8ApGUaWYc2d1ul3tnfZ4MGPf7Qg9vAIbw_HFOhQQA&oe=6AC529CD"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJExg7RORqMQ7kNvwH15kqM&_nc_oc=AdoJiuUhUxNvsCuPw2MvH6x04dGF_FIorGqpet3lV5hwkIoXF48RM0NKFwOZngeoMDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuGjCIecKhiqEJTWD_RoO_Aa_-6fgdFQYCpGoKe__kdg&oe=6AC52468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dkMeIdgA8gQ7kNvwEsA8i8&_nc_oc=AdrQcJbH58L5O2CTScbb8jR2lQjI0LcChoGroGl6ZWEy22G-ahPR1GTZl4i8eLZT2pg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwiJRBWVLN4l-0cNQCxOWu0632DTbQ2oA1INn07_Ib4g&oe=6AC51FFF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
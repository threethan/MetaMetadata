ZMonZH1pWcvc5CMpoLSaMMdvu86DxU8WYx_rmr7mshsf-xonTvVS6o5kXx-BqQM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxxl8UNpv7ROYCalXZKEPZXDYF7jj0Eq37pynmZyXxf2g&oe=69CFCAC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSgpnHeQO2wQ7kNvwGvv4Wn&_nc_oc=Ado2tjElXbjHHl0UfKFbi6tMtFime5bfkG1jB2HMiZa1l_BkyxI1SY5aBvdMCH_73y0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1m9uTk-kbIUuoEaB5vImB8uHRixg8V_TN5Xwvjho85A&oe=69CFA3B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld6Hks1Y8zEQ7kNvwGVXqzK&_nc_oc=AdpOoz9MOu4Crp2m7IZ34fUQjsk6DDgn14MlrlguCGDJCQw1msWQmbYkLFIMEUaPTc0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN6sJjDaNuR-XQFyNil97x-hPfJLjrAg4Rjaok1SdIRQ&oe=69CFBA8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npf0ooa3Rs8Q7kNvwE1TkyK&_nc_oc=AdqVaeuIivDUu3-Bz7O-F3_nJfoIc47kMfZQKHgqwJWslsihhahRg-sgD0WitUz7Yy4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKM2Vv37BwDJlNNGSS4MpfrAW809gqaM8bESeSd8YoSw&oe=69CFB528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4sU071K9oMQ7kNvwF-dNNu&_nc_oc=AdoTWoOXWKIVcVssaNy_6VD2ZBffCXdVjE1d-nZzu_GhWXObKyc_9QMzcQTMLe0-zQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcoybIEMitLEYKMoyXpYDSI5h7Gv-R4cu7lpRIoiQRsw&oe=69CFB0BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
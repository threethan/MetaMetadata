H_IU-U-ATc8Ody0XW4n2KtgEzn7t-XtyuASA8YgekyY1HsYS0HUYhqKBpVQ7w1g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9R9nZ4Ie6dhGbGzM45_d6e3sklN1u2mLEhaZ42nDLGA&oe=6AEC8EC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH1YsshEgxQQ7kNvwGZ9RgM&_nc_oc=Adqa1QBhZWP72uBjBd__Lf5gJ8WedZLAPuCqBHydhAEfCLpO0jJ4hJZlXVdW_5CmToM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AnDTndYb8QHdyxILPG1d46iWYVMI2qiohPU3uod4Ig&oe=6AEC9FF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2zEZ09ixS8Q7kNvwGNdpjJ&_nc_oc=Adp89ec5tEusfhdDuUV0_k8GfyAewRnBe_K9rWPFQ92jyQh5KMJiS-Lk2PBakqrIl40&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFKrBkWvehWp3lrl80qRtScvxkv-ynYkYLpqDd0Z2dOA&oe=6AECB6CD"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NY3E9UA1yokQ7kNvwGavxft&_nc_oc=Adol6c4M2LMX01xr18QFq37gSV5Rme01VJqjuJepHgHB1ulHiUG1M5msnwmFKWRzayI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQMqMhJFVhr_pGpHQT2E_w6hoOVeOPnCU0KTiElBzCqg&oe=6AECB168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlgEwyFeLcQQ7kNvwEFrKtt&_nc_oc=AdoWFxfZZHCqIQwAs5L3oJxkW1yJLXNTwZyvipj2j9d8KM5ObFX1UkCqUg1mbDHb9DM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbYO4tCD4g0VLDrj8Yw2pGW_1ZR4fiWcBkIA62el1Ekw&oe=6AECACFF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
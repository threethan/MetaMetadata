igqvkk_MTCknz-CJqoCJmQQ2EsIEeOQuKLnZop-_xaVerEMVSpnskYE7FC06JRo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97VURXS-bNNDklxVHwSR53rzaVIU21wPeoeYxCIeITpQ&oe=6A4671C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INoWDnUn46QQ7kNvwE8huYh&_nc_oc=AdqnXBGkNVu1Yu3RxTggHvEU150CHOdAlqU_4RawIHYJPq2memr0KRnzPAw-VZJz8Ck&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tg6ZThOPIGA9ZIGDFfU06ANwtJNxFN6Vrs5LHaXSy_Q&oe=6A4682F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gWyu58ZqU4Q7kNvwE8O6Ou&_nc_oc=Adqh1bgEcdzZPpbNWjIOKLfQ0V3q04alhYoqYy-W5bDgWR0tQJDLj04ubXqqIRgyxOY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kgKBzNwA-iw76vcPzyWfG2uE9gG2nGYHAEsn7l1Ohnw&oe=6A46618D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py8YFMEb8SwQ7kNvwHt309I&_nc_oc=AdpYkDexPJh9MZv81bPBMlRd8gftr1AJiEw8sBgCXXDokLd3--GTylGv_k3uhsD0kqI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GVLeZgpyVeOFoY94XId8UmI9rlJJgWAhAAzZiTafIFg&oe=6A465C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAmQhAAilG8Q7kNvwGOOKZX&_nc_oc=Adq7EDwaHM_mEF8mLVRgFHEFosiqzMyZHOG85hAiJjAFVQjL1waagGi8JJJ6u6dpxIA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4AQs-4RK6JShn3fUAr9Uhaq9YJFuoSgX3C7nIq2kkQg&oe=6A468FFF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "int
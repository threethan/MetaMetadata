4dqNPW7HW-OYvHqIt7jh_iomqtXe2u_yiaJNJj9x1FSkT13qhVXsrT5jW5aPos0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R2QT43lFEBT5_MQuay4f4HjNq0ewp6Q6Z419cvR1DXw&oe=69DF9CC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3Fb7aWB_iEQ7kNvwG7UZ69&_nc_oc=AdpefV8GdvEBvi1Xd9ht6XPRTj-EWR87zw5jL4Ar-XFU_U2JMQcUx2K_geGKunfUskM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wITF5_hQpnpQh63KCd0e3NDHkKsN9MAtogg73kRodHA&oe=69DF75B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1Rg8hxafpEQ7kNvwHEyaGk&_nc_oc=AdrCkrzm6dzCi1D7QHjxs5rJ4bJy38xXTBCzGC3K5tIOPje11EJ5KeToxhnwB6Cwpew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2J6afDbJn_tesTKeEhXwX_KAfBAYUFgCXuCWzM1bZhaw&oe=69DF8C8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faeI4JJz9boQ7kNvwHWwfmw&_nc_oc=Adps2TaHNFJqX62l5lmKQ9XP_16HimJc-HdWE0QGDzpQFwDwDXVpq0YKsj4ucZJHJp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sEKOXrEo6lpEOLy49OdcfI_c376xkGo7FV4eSVk4FjA&oe=69DF8728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmuuohPb4JYQ7kNvwGmgBCa&_nc_oc=Adp7h8rLvnE36ZYNt9Xh395esNCG82ysnRadE5qmoXEun-cTpC_5Js66K2V7teDJv2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eBn8Vw-LE4nCll4cbh7hSQqIcwr_UqTp1ZjdkZyXXnQ&oe=69DF82BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
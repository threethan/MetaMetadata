?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RWFX_mWc7cQ7kNvwFZtrmV&_nc_oc=AdnQdkXFA74u7eAtkm3NEp8fxaG9l3XJWsJin46W7I64Qd_0St95hyVlUjvOHOSAPnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnMpoVIA4OiCtxBPB7q3gsfsbWGM5jVuM-umv-4cB9Cg&oe=69B545B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwFiV22brW4Q7kNvwFH6jK7&_nc_oc=AdnThDc0BLFPGx8zgdvz5fXrPHc15orWgQVoYKb_8JJRwYo87POXr2GyeniJltGub-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyfiKXAvYbzfhQn35LYJx5_B9WKjiV49H6VrMXKDWNVTg&oe=69B55C8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uW9hdIP87IQ7kNvwGyt-y0&_nc_oc=AdmRPfVRqfRWZjRRCZWjGuvQNMSTB5vuO_ZL_-qXd1KakO3Rke0SsRUy1--uIGW776w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzplAEkNV-hiqhqbcd4LAEO9vbcRmwkVUI9ZOS-DndiDQ&oe=69B55728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=172K3UkyD54Q7kNvwGbAnki&_nc_oc=Adkivh53rEud_D275iTBrqFFcwqw88tY_qvvmlFmJgI2QqPe2-1cLkrP79EePDNPr_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTOq2uzMip5ZKDgVxCP-3yHCXDTy-KSpmY_xycx8STtw&oe=69B552BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": 
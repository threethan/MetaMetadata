rDn4iJ53d7AWAaLUGnaWQi4bD7dSBefucyukdyvPr8lGbXRV6etBBpKcvXmrGZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQejRP5SNSrdS3ha2JcdqSKuPUTSFUZItN27DRaA4lEFg&oe=6AEB3D45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I3EE2vcXnkQ7kNvwGabdi4&_nc_oc=AdqzrDCiiYTtgoziYuklb2-bLhy_BnXONzWsh7Qr3wjtQaQPcsryy-5gBVJw3Meu3yE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvSev8a96BG5v_1gn6x1ZsEQks8wrsdbKqgvNBxK7J0A&oe=6AEB4E77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2zEZ09ixS8Q7kNvwF8uzKq&_nc_oc=AdpENM1czgpYXH7qVgVxRSlchxdJBscUJ3_ShH2WkIhiYl0h0AWEWf6cLIh2d89TKZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVIjCOp3cu6zGbN5OIr91dd0XVXS-GWVspdduuh5EyPQ&oe=6AEB2D0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFoAm-MDhV8Q7kNvwEs-3tr&_nc_oc=AdocMaN50fFXT6e9KqHUYna2FaVhmI7L1CA0q45eWLXTMYMgvpGeJEo-6JUZbx68UZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5AVDUPou2dyBgw-0b_pp8Icr-42i5Bs9l1gDv_8IEHg&oe=6AEB5FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlgEwyFeLcQQ7kNvwFTttMX&_nc_oc=Adp8-89ZzbjdUstU0ijO34NjMzfRD9WtN5dca-qvwtVvyzOSoWYpUfWplEtTL1aEawI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU8jLCot1wmBu8xfSZ-RtrgH6JTibarxj7lX6IJ5qJJQ&oe=6AEB5B7F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
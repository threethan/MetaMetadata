?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UlfIcULawoQ7kNvwFXMMAX&_nc_oc=AdkRLlAzXWNJCb-16Ya-Evep_8xHeobz7_dLpTQs5yyqrzeClDYZJckLSJcjFWb-kaU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOX5vmXrz976W1qzc92qYWkj-UjGZIY7qdRGc4cg1p5w&oe=69BA8BB7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHYzhoN0NdsQ7kNvwExNtf7&_nc_oc=AdlNaMfwuGAqqb3E8Er5G34LU7x8mPpQ3eaL_ce6AiQ_2K_BXiV_JK642ThnUk_12XI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfywTck75rCI3Daqcra26uVqfhBN5X-T_91LsCbmQUEx5w&oe=69BAA28D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb8OKQc1DQoQ7kNvwFvOl-O&_nc_oc=AdkUvjxVCbkKm8CaAXdSf_RgR_FAU5vrFzP4I-FG-O4AQGJcwhdAsrl2Bwh491cdS_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfymK4d8pBZXbQmqRRFy9c7lKP-mOPg11PjQf72LkoDxUw&oe=69BA9D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x28KK6JvwUQ7kNvwGijHJv&_nc_oc=AdlFBf5ksOHnAa_q0qKyc8HRuoD67EtmptBYtWQNN-wZOxDK-gs6-tJ_TVDXpz7fAhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsVDvSBhUKm8zhh5iptXU-EV6hn3WJXUjHnoHxhhMjuQ&oe=69BA98BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": 
OwF_BZxJxlW9Q6JAyBqX6b0jOzGQieelUVL9YdgJ5jYw1HWtymvphmr35SDoKls&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8xKoLQSwRQkw4L9UMz8QnYELVXsiunl-Iv899y_49LA&oe=6AA40C45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEHrAP776qAQ7kNvwGJTI3w&_nc_oc=AdoNMfzY6AhwlqsOOE6NnlhritYdWjo6vjOMUvKsuq12P93metsBxn9Z5-Us0a7NYxk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJml26w44e5rTV5AC9vdZy_OomeNc8Yf0ZDeTLQzl6ZXg&oe=6AA41D77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JVlWccnIUMQ7kNvwHLwrM_&_nc_oc=AdrUT901SOXECQO2EBGHncegAZpX3APeX1O8ADfuuOm3t4zV8tmbaR-IsFmPA0zM_Ng&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLohkbZWscIcj471MAM3mLwTI30MfYzz-wtMWCPZktxAQ&oe=6AA3FC0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvmYkFRR9DIQ7kNvwERblsO&_nc_oc=AdrWB5NmgoJT1BaeY54tzX2J1wgGoYuQDhi9u5G2WMe2STWFgaG3Rkr69Zq-ewnwCMg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE9jh0nyhJ_ium5VjhTlb8cvj_QFC75y6fe39A4yGVWw&oe=6AA3F6A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNu6IC_dNvwQ7kNvwHaEtA5&_nc_oc=Ado-oMZmZC7d3efuBRCJxlSVwD2AXKViuofZp3-Eg-fvzxS16SVz93lEaAGZjjEd_Zk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNKeJj_caLS1ZvsXlc-G47Sl7zBvzZaQm0RtIz8ZLuZg&oe=6AA3F23F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "int
PHkhF7t7SPja34MJjNrVWG9tOH10-S8qG_3_Xrc8G5co2mBeGJfbaojaDSvMldQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_Mg3K5oUnGq7PdiKumAIVp5awxBhllK6w4ZAq5017Gw&oe=6A0F12C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6z_cLFoYikQ7kNvwHKKiE9&_nc_oc=AdoPKAXFOGhg8YUk1VvLMb1-3Cqji2yRSQifrslI20_qzUnhVRhGtoRbDrQd6HSaBbw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T7z8_W2gW4MMEluByx1fHHak2YU4YqcOf5p9mPum9rA&oe=6A0F23F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLjDwK3VMUcQ7kNvwF-cxe0&_nc_oc=AdozUj9a0NL9OpGKxXFpLuHmgYybWZMQ8d8DUiPzgT09EmjOsxkCDds78x8F_5exv38&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6igMcW1u0g2vP6wlhEHr6wEzS2Gp0ifIYBlY3Gw4jshQ&oe=6A0F028D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8kQ07cW6X0Q7kNvwFkRXM-&_nc_oc=AdrJmBrsZMavEbO1Mh3U_BHjcGTfQhi1drh3oAXQF6MscqeMgr8YDX5B2zGzLjKOiiY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FlogREAA2Tgd96_nVe3OSE-rt1qaPpgyxNRAuRU8g6A&oe=6A0EFD28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7JYHT5mkjgQ7kNvwH8cXgL&_nc_oc=AdpC6uZgRaIIXNw3ZmmqNGbbfZ8CVY1LVGeEZtpFUVIJFaYJW9Kn2b4Q1NEsW0AxTrU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kr5YNSDm5LtnPGn_tH6xIimC9rn1DMce-Z--UwusMGQ&oe=6A0EF8BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
Ai54znQ7Yk-IHkdykUbAcgaQ0YgGolAU-qWS986Db23FN7-CmJjO_0XMTX2kmVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HwzUpZqRKfid4mG9KXu5DlJJs6asEnBQdc6tBUshEBQ&oe=6A3159C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWF-pOePk08Q7kNvwGXC8nw&_nc_oc=AdrIFzQJ7MNKhbjhScPH9-Ro4j9xJLsEYzU8h51XeYKqTVtXn6i3ATJuVaItkcsyM5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M9rmYY9UKLn7LRoTsBvb7JofrgF5UzyRA0cJBnje4VA&oe=6A316AF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBUDm5Ivq1wQ7kNvwHtEsTo&_nc_oc=Adp72tpL-V0I2STPq-NrJDoPqUahRe9soz9ZbTYTc9ZIdKmFkLB_Q-Zc_MGz9sMm_dU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81nAzmNrBkI_sDDGHZ6Vjnz34TodtLz7l-Waew-o0XAQ&oe=6A31498D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrAC77Ng7DAQ7kNvwHUJS8Q&_nc_oc=Adrk4sadjS53OKJHf-40w_oCUECC0VQp-OUlVcBTx1GJ6Rgg_Kon9qTr5wRHufGz4iU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FjcxQWtXF-pKdsJi36o2gITVLFbBi4Dlzn_uD3ICTWw&oe=6A314428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26kB8Q8D4gsQ7kNvwHpMMkP&_nc_oc=Adoew7X4_gE7Zh6lcFhdNnmvusg96oR6mTAymKOlVgmm7xrl-ig2RR78xEyURIYL_IQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GYjIgEzo06Tl2ms0O60GwDwg31mjJ9opHtyOthXP14g&oe=6A3177FF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
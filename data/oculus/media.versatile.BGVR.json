5z8dSmaLOX5SRk1BUhrn9Zkv833xsQ2XwUWOqkS8SBHXLku94eEEuHbMw0Ipp6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n_zxJkltJdm0Vp1T74_uqqEfr2kR0yp6cehxfvx-UzQ&oe=6A452045"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWr3PgWFplgQ7kNvwG4990Y&_nc_oc=AdrSHxouZKMtC4So8bpk7aa_Bw8oLG3HsY4zOG0bhtXfOyDGPcwyhXQEX3V86bsd1qk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n_bEtbbvywEg9l7CnjBTpxUcCxypecGgQdAIFFX31Iw&oe=6A453177"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gWyu58ZqU4Q7kNvwGuorXq&_nc_oc=Adpd77XzHFxZ0J8oSj0bpPKzeSNT3p7zJWxu5qihZh_at2tcct6ufpMYhQs4Iky8pWc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YR4UXBsK_RPfFGHkY6HK1lFevpSs8muEsTnE0oZzOkg&oe=6A45100D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbW3l4NyhhEQ7kNvwGNyaFN&_nc_oc=AdpIsjFSKSe2RdI2oViqlO0PJ-vbBYUuhazYY_4r0fCyGlAZBDnmd5T3LaPj-o2YUZg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TPnBIlj1wMbXTxZ2dH072rempX66sd8qaN5lLd4GbNw&oe=6A450AA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAmQhAAilG8Q7kNvwEeN-gq&_nc_oc=AdrvpEJ87Tmsxugc_yvydqdaBUrKSuuXQDpTp8kbinaVdjeqlabmn4nPE1pzfgNc_ME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S8vg0mK2bZZqXprRplBfAZc7IFaCDP5GKe0Zgd0ygqg&oe=6A45063F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
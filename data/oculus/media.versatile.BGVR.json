_2SFv3x-I4CqrRrZWZmgmjfotJaAkOhb4ougeUJZT7AnJwn6-PlMVF3Kn-ydEJU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHq-bvKGWRcMA_5OU3wyBEjbhLsSUdbfA-TkoEBn2RkQ&oe=6A5A3845"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBKY34AZnlYQ7kNvwFbugb8&_nc_oc=AdpJrxtB_ouuV3RS0D6gIaOAau4XOsmx-gnaCXfgn8Zme72CXJRxtrtzzahOVvOnnkQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRacIpNMLJup7PWc8zXMKBGGlEmmIpmpHYpBu5jSFboA&oe=6A5A4977"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEqi6ZCE5TkQ7kNvwGTH4Lu&_nc_oc=AdqCyI5ORVOcM9h5NTZccH4AV4rsc43xWbjUSurmffkDr6cpXu7QxqzlUZJ3UJVh9-A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVFAGJlEBXzrH7xq5yNKbWS0legGiUOQuS6t7yiunPTw&oe=6A5A280D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g22s6spRtjsQ7kNvwFCDgQ-&_nc_oc=AdobhUwa_l7sGdr6YxU257VqZGgL-Q0tXNfIBvoeeB6M49abP5B_NRlambWI8ltj1wo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBGqY4_lGtM3UlJPVICDpb5dHueZ9SfX3K5cY6fsbsiw&oe=6A5A22A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11ygrcW3Lz4Q7kNvwFU--hX&_nc_oc=AdoKzlyYHR_99AAfiTPJX48JWfMe-X8yxXtPPOglPGw1VtvhvdHUnx9TyKXCMQ5HziY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBId8pKHSAohSQJjtkDkzyKwkf6CXQbK72Ur3W0M19LcA&oe=6A5A1E3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
TDZIVzDH4fekQ4fMXDLKxsbyhdceD2RVCfzqf4cedci2jf-FWc25iEBWc75uWxM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LXukQVNpB7u9Ict_DoJEFmg-1d74yIMWABeS9I5Hq3g&oe=6A199EC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FfNS_gLA8kQ7kNvwG-pYyv&_nc_oc=AdqzCeW_rjC4NpnacDwo4Cj7NJI6xkG-MUnvdm6cG7S01kEHHqoYr-345aLBRS40Ugs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PfjY1WtjCqKWOAsHriRyY_yIJbb0EKjYEDd9IQ8Q_Dg&oe=6A19AFF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsmo7JVQoN4Q7kNvwE9oUWo&_nc_oc=AdpT2XD3rw5sfHfU1fYRYeOjoiq6Rjf3ljOIxMEZLJVkCerAs4Rvi2P4NfIj8ceXNc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lrRd6xilqhCKN9GmpuHiPBv69DvQRX4eeCf_vmD5JZQ&oe=6A198E8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s4p3VEH-z4Q7kNvwH32DaM&_nc_oc=AdpYxgQ7lCIlEM_-0a0JUUVBGYpdkpYlyFOQPupGYbyoc7NrtCXCrf_m0Kjt7Dy6qCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mnnOHE0N2EjxiLjd_gSGlKwtjh3WHOr7bek7NZuI6LQ&oe=6A198928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvJk2aTEed4Q7kNvwGlyuSH&_nc_oc=AdpDrxwjkJ7x35_BODa86mUa1zjOq9YVXQSsi0_vhlssKbW9T_NL-d4LzNyplAE3VcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-QfWbb22iHWlo2nZfE_zE8IoQUvJcU8Z-96brcWyvtA&oe=6A1984BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
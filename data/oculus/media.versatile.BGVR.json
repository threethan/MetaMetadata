LU-wprPZLkfMzHbZ82GWKo8298A5tdk14Wr9RItt9epWWAy4B6lW3pKHBKHu8y0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvu916PTrzLf2jPtU8qIuGSYZBZaMJD6EK2SELITGIOQ&oe=6A9AD1C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyCmzGmZWeAQ7kNvwF1CYcT&_nc_oc=AdpnX44FnlFd5etVDkTt5hRW61IMpmJ7SIxnufbm2VXqnFR6G-HJ2qmIo5jjecTkc6A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQfVtWYrWovt6pbLcZd5xWmUGu3--sbdEIPQZ7WVnJjQ&oe=6A9AE2F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV7qozbw_OgQ7kNvwHGic_D&_nc_oc=Adoyg62QyGKzslk7lMjd0-eUcZtZ98gTiLopxy-8AG-R2AqaOP-uGX7bPYSHQwZS3bY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcSrPN6aQlImgfCLfd-Z6zT2SCQ5oMi99AjjgjmhyaSQ&oe=6A9AC18D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lt1MtJsOjMEQ7kNvwFRZblo&_nc_oc=AdoFBhY9aOMIMFSMDVuG_OLV909o1FZdHfi5foVtIGFUiTDv7p-7bPooVRa4OXYxZiI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWCFtlSzoOmQCRhEdTl91eAY4qZ6w-Ak_bDIkk8Gew7w&oe=6A9AF468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSsbyPbakDwQ7kNvwG0eJVS&_nc_oc=AdrQqvDs8GTdX4XuAX1smONKvde5Y4jWI0B_h3e1pW92SMiaeAGon52s_k4HejP6y3k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRXXAjsqInasQIAyBcAcT3curvkC_2nyq5JifYDRyySg&oe=6A9AEFFF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
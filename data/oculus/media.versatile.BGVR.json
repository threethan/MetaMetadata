Rq5STtN9ToWObFXieKk4tj75K8MXpe_oleh8jFtxnpXNrjNZqgUpRIkaEzy_CjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3Edz8oWNWduNKUZ0EQ2JCrxdZ7UI5THZ13V6yyh2A6g&oe=69C93345"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD9WJlWjCt0Q7kNvwGhGfLV&_nc_oc=AdoTfBMQ_4nQc7so-a5asYHf-Vvahj5QqxAaqBpdnzgfMWVgUS2Ora2NGEWc8TJovXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn__0--Q0MtPEOVY37NGj-v1hk5b6DMyE7rwjscHPfHA&oe=69C90C37"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OGWD0Gk4zgQ7kNvwEEqNwF&_nc_oc=AdoXcEy62RygwR56wmfHqO70uXqUfeljHvucTn0QJ-jfc5LGMOoawev0r8r_bkZ4Geo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlixpR02dIp1Da0XjNCNDxQ1zwCHU-eTYOHZa8LtKxvg&oe=69C9230D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlsAakLRWPEQ7kNvwGflo5X&_nc_oc=AdpKGnz_LG237OFmYXvuiazOFnRjWsci4tguQAyuXtIV46DsJ1XWNL0Cnd5r3PtkxEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeE8QhwVcxlcpEWBTPo3W33NmeDtLsy3kU9QSfQC9wvA&oe=69C91DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdY29lTqJuQQ7kNvwE7_ZcV&_nc_oc=AdqgFZIhM5RYEC8ABg0VwjhQA5nbe3XgDT_AryjUQYXOLMnXvlUGZEit4JU_uT9eyWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3foEsAfh-_93NkNJw9A3H8-1XYrMP69neU_tGCsh5WA&oe=69C9193F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
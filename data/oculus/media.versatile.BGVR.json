QoBTLcpb3nh63C0qYNmkRaT06_q9R2JmiP_Op-HA6dddnrHeVr-WSsgd-RJXrVI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv6qFzEVYvZlvmBjHsUIIMQ1j6beldxWXC2ztO1x4XUA&oe=6A6B5BC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21GBmqm2wXAQ7kNvwGSFjgw&_nc_oc=Adrd1qdRtM8-VsIn19AGLLmWqqARyaP8jTQK_7kwE73-fxgH9VUQFhrDhsoyox7mbqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_7vCKFA9XjtkHpjSUJgmUyqZnzBGAWpkMU-aOcrtvzw&oe=6A6B6CF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYfgxXC0wcIQ7kNvwFaNSzb&_nc_oc=AdrLy_3bCi3OsbFKzZXfHgSz1dLgC9LF0Qu3DX589NeNhsq79Zjw35cAafGKasBwr6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4KoBuWlOI93wtSFoqQ-pjXFZeC-T17LwJrzb_FzCvPw&oe=6A6B4B8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCUKSCFRFhgQ7kNvwFCs2gb&_nc_oc=AdoJWlr5PDhVh8Y8KjYQ6efuAPaeQ-tBrKa4uotJeFRF1KFLcEwXT4MeFmJT7ODwNbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ7d6OQf6jlj_QHKhIZA3EsDHFOZtrE3TDbfPfausIog&oe=6A6B4628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpSLyiDk5jAQ7kNvwHFLX-Y&_nc_oc=AdrQS1p96LFaRG2w1b0Rg3ieo2yZrmGGaFULS08VYCTi90vk9TIVE9uYUfAt94zZbJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP6asqeUaMeW4MFJdsQma-w-f6lURcWPyQI73piUnBRQ&oe=6A6B41BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
dAGucVpsDg-I7_ScATEd2jtQ6t2kJndOilvVsZPCM0whe_wBpTQhsat7Bb-PD1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOMlwfxG7y4JUoWNtUzsS7JvF2TeOlrNY5o0JfycvaQw&oe=6A6372C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlLlpDNTW-wQ7kNvwHaPDvC&_nc_oc=Adpf97e0UTVdB91lEQ5QUDgfo5EK5bTsgdrQlF9kxQrFOlsJgP84twUwOVsaOGu7Dwo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATtJdKo41ZDsz1KdpIriDIsO5c_2YfMk4W7CvQni94KA&oe=6A6383F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLpPdx8IKkAQ7kNvwHQqVT0&_nc_oc=Adob7P-S9dN5QsTKUaQXhq3N_-y4lxaw-vxFNh404WBQDCTrC4gG01VkVuy2NxVWpbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTfoaAv7G-51DqaOH1Ibz2u_TJdtKl4iA1GryYzh6Tjw&oe=6A63628D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGua21sARiwQ7kNvwHARcMj&_nc_oc=Ado3emZTjwAsLNVGS-WV_LtoqjV2camKzsuasdzwTZh_I2fCmQPtjM2tOqEbiR7fu0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChxAij4VivghvbUPZsg8GGyc4cnuQoBOLMDl2JieIPMw&oe=6A635D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jxikf_LXG4kQ7kNvwHdliSX&_nc_oc=AdoeVjBqaJu_noTTn7h4R5RRb-xwKgOJMFX4-QvktIhk6IuzpVp9Fp-HVLwNeS6a86E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_MVX0AiUYlxCaSmepsrLwDwr8wBwpX1rK24aefNL78A&oe=6A6358BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
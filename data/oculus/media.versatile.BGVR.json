L-Ew9dTUl_2NjM6onC3zvvVyGHnH8HU73Mg0EIkQPVo6c6q_a8TXpb74SFVv78Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdipKatkrilOClJe_CPpnEikKd942pldkq2fpfOXdnqQ&oe=6AE5F745"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zw1uFRNOgPAQ7kNvwEKzlKn&_nc_oc=AdqtSvTLT3SfmZwPmoR3r_8hfESC4J0rc2Op1IPuTpOc8NEEh-Pih35lEWTaGXsmJ-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7sNz129F4B5k2U9gSN4vcFNCL0rmMuXdvpwnd-43aLQ&oe=6AE60877"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGUQ5B38juwQ7kNvwEGVZZn&_nc_oc=Adq3J5bNx9wTc1eNrYFHDiK7GEFXpr5pXtJES99d4orJoVfApUjBCXUeV3WAtffhvm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWty8Dll8kr1tJ0W9l0sZkH_Z7AVSugZwk0-flWiXtoQ&oe=6AE5E70D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Wn54Tg_n_kQ7kNvwGXF8Gn&_nc_oc=Adr6p38Ed_kNcj4Y2YkCx6HoT_1LfI8YRump4Cr5ejLRA-gnRuWZlQ7JAYhBUiu0Be0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpEWrL5oEvgBRShdFxToLBdKcaBxtqiYYaugCbQpFjCQ&oe=6AE5E1A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIOACAvIQ18Q7kNvwFA7Y_G&_nc_oc=AdrBM2eKIOvFrbCwgTVg4f_s_vTo_LW4fwvuv2zmTNTc-biH0n50DFvS1a4QlsMYDjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEz1v-2rj0jOoQ346QOBfukZW44S7PbGRL0i9jwDF6ng&oe=6AE6157F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
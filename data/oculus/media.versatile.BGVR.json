ontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21GBmqm2wXAQ7kNvwGQcUdx&_nc_oc=Adqn5Ms5oqN7hcyRDH3xxjJ3Lg1-aGmuF5MM7nYndB_QQvgCaLgzjlB0puXr82gBhQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjUXSookVDMIWO5aUOGBO0IIH9509wCMkLaQzMn-spwg&oe=6A6CBE77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYfgxXC0wcIQ7kNvwFI0Nfj&_nc_oc=AdrFkAdEVgqpyG2buGkF2kihWyg8W-CnOiUQEKPc8-9bDZtzuueOlaYTiWwEUIVUfZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfIq1ZZdaL3EWaOWApYlCybqQN6u0pz0L8D96aDa952A&oe=6A6C9D0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCUKSCFRFhgQ7kNvwH7Ogou&_nc_oc=Adq9sdNV04-oKnVnrC0yuKMvDHamBMY7RveWHVRT_B4DCuQX_4ye2Fy3LP0kFDfOoq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPtlUgWGdT1ua0d4s_3hOlyAVfYN7bxRDIKF_xI00i8A&oe=6A6C97A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpSLyiDk5jAQ7kNvwHHEctZ&_nc_oc=AdpZS8SJoYfqknCz4vkXI0kXjVqFhHsnu6MM0ak9dIvAqGUoR7gLl-LKjti6AwLXlkA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXbnLCEcEwboxvRjZaZ0JHsD372vZ8yD6iXrerThilrQ&oe=6A6C933F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", 
x-owbR68q2L8nf9vlHMgsTfyrsFwyPL-fSOS0U8t4xMB0Jm8EGwnubKMFS_8_D4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dHEtBd0fZ802Gdpp2OjuPGtXNIDYdp7HpMnRK2kkrVQ&oe=69EE1D45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg2MoaSdqsQQ7kNvwHlNmOj&_nc_oc=Adptf-nMwH6RTkvd6_Us5YeXrdpoGfa5qf-eb-8yQ1iwF9nItJnoju8ciKVAtuBcbvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m8Zdf9MpBjBH0PfDoVLQHfFiaATIH_kxiWvdQmjVGlw&oe=69EDF637"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YL_baRVCaoQ7kNvwHsfqlt&_nc_oc=Adr460yG2QR3RzPDcJGazPPAAAIqt5h66gpxAU83Mavuz149Whu2HL8cjZ_dLqBQ0Lg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29w1FuwqO0XfO95sPu3n6Pbr0cOF1dgBH4R--_YFapLA&oe=69EE0D0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzz7D137g5MQ7kNvwH4fy8W&_nc_oc=Adq2ZYG7UUiQQYFIvOAtYenFq5sCPynprEmrqY1k7Z0FPeyXhXJpwO8onTiEsmQQmKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xOplQfJeCcwK-D1hu5XtzQ-J-9OYB_evA8j6vw-SrPw&oe=69EE07A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNWXN0-QI94Q7kNvwFJqFmc&_nc_oc=AdrdmRpelj3FYnvSDDECN3kr-ian-_m8TlMTcFbwoRknxzJ6qyIjjpzjiS_Ud9bXTrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z47Hd5wz_u32bGmhEWhfkY2Xfomx3iLaFP-7RIakYEQ&oe=69EE033F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
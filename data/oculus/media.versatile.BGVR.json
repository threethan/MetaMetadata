VdW1TeMvZ577l1Bh6nWAUapgRchul3FxzADJgqMJi7UsPJNaZWa1r7Jd7AhXTAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--Go5wiusD-Qm7eMoWf2t34nkVHhgfyaJlImaN2YVF7A&oe=6A3E88C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2luxHdEtJbMQ7kNvwFzVToa&_nc_oc=AdooGrTLLTW0cAuZDXiQ4eLrUMEmfaHyzGfNBLrp2AMGgArQilHL7tXP0dUMAxIAZIU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Mkxs1eZQgjs4jP_2D9uHoC0ljSKdrnS7QL45v2INIwg&oe=6A3E99F7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3jZmohxL2cQ7kNvwHtC1G_&_nc_oc=AdriPsZxuorAOv4Nr4h8oQowTMGIfMSFishp3mFeqjuZnQlWlgkQYY9FXtcYG3N91vs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EnQEHs7s4tWWsC0YgVNmXd_PndxFtfbFq5h8_kz1RDQ&oe=6A3E788D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XYwqFoWv_QQ7kNvwG1M6XK&_nc_oc=AdqPxzr9mU3FALOQAuv34UamEgcOQIU-JB4ZMDfFMCfJhnDFxgFKY_QDnBCH7YcuAjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-efLGlxdPfqPcoRGOm_m3DPRvgNUbBjLkZAATKoY5tiQ&oe=6A3EAB68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwyYD0rTg1YQ7kNvwHMstkC&_nc_oc=AdqQSjvO1z08iOOw1DUoSkHY_HyAeTvE1gIUK65w8StxrQusLTPdZgkEpVD__0hKzWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QU-4MpPfI0_5muRuNSCucVDfa0U9U5NOpJ86N90WJvA&oe=6A3EA6FF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
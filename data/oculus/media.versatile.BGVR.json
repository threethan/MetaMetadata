JQ762SypaaLGOIPBE6YFBQaI-kWvX29wtbEJoGd9UVxKJsvxRINiHObfDZWBJ_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nknwULt2sin23PHPkpetk_req_LhQpzw3HhH5Xm38QQ&oe=69D90545"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctog6y6oEQgQ7kNvwGqkWDi&_nc_oc=AdpKHpQnCx7eVP8zW8wBiwlCLiMrQ9V_Rr1dpADXYZGOat6AqNM_gkSXCkPvBwHRr-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XTgnI2fT8Tuednj-Sm-HvSWuRHBsM_Iqp7HvpRLmrYQ&oe=69D8DE37"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s17qAkalBCMQ7kNvwF9DkuJ&_nc_oc=AdoDusrHaY0DlljOuPUZ0J338P6wtbgykpB86Bl3OYriNQVVfe9262uh1h1xqDGZlCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rncYVegmQoQJK8b9eOVKYeNhVy1_IGknFF3c3w8G-pw&oe=69D8F50D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLTxLskrluUQ7kNvwGgovgN&_nc_oc=Adqe-Vy1QUZrS11OkbHCs4SYps98N3F2i5oUGINQG9tdwjzqAv48vLuaJNPay3N6ROU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af301JIOIaHxrtBqoqGTvew3BQmB0grQfc95c23KBrU-sA&oe=69D8EFA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=futZl9MV1QwQ7kNvwG6uak1&_nc_oc=Adr3EhBAertw_XT38IDM2QmDvAeXLUH-8Zs3tjO2wHs9i0Kwqob_rbSxvaoKTZzD_7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2flVYfhfmirKpKaCMWHl4TU_RMrj7DFnNvT9vj5uJVWg&oe=69D8EB3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
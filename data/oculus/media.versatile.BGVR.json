hJ3XW_VuxRkmwUSC8N0TKSzPs1D__sq9ZTbI7k-2vuVRmNqhFgh6RqufmOmuX7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAXDRHz8wA6dtVF-4lJQho7AVpvHg1VRC8RwkmVpX0qQ&oe=6AE0B145"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvxV4hkM52oQ7kNvwFHiC4i&_nc_oc=AdpXwE078t6j5eYZzvnKg0CzO9r7NAroNq4xr5eCgzwPKsOtX6L1eJKscXBaJs8MI4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtpm_1_tRAhkxpZ0LpOcDjxPJCYYCQL5JGxQA1u7Jg3Q&oe=6AE0C277"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ml_0I_dbE4gQ7kNvwGdsr69&_nc_oc=AdruAG0knORJcBiy2ssicccpP0KU0YMHP9UD-FBUcE5crZSFB5sxl2EJekyCNkijTnc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHfcsHkC8C-C91AAZoSWaaXkFd08FNd37GJzwyvYveWw&oe=6AE0A10D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z6QlZLNlc8Q7kNvwEOnZZn&_nc_oc=AdqVQx7TBknIeH8AzXqXr1JKf8mcLSD1ryPkDb24jOM1Wfm_rRfzQtXy6YcN0Bc43x0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBySqUS_rK4udZTduJn5zwAbSDyyGnG5H869bPcLElrg&oe=6AE09BA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iicYfueZWNMQ7kNvwEztwAY&_nc_oc=Adp40zKYicW_rz8Lk611LuA4QHe7V7zgOz265F4hlF2Rhy02n8KlETm9YMe9FNNUmK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpOWk1652Uwwb_fG_p3wX7OHN1Fa3554XzgKT1C9e4DQ&oe=6AE0973F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
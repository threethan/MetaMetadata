ESSzjgY4pg14Htif5LiAOKSiTbx-GmLseoFin4Tq8ySMP5f_4u9Rx6axk3hdpX4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uEVGUuL4EBDWZxE4YfzuYmLUEN9xtwop_mbhlLebHZA&oe=6A184D45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FfNS_gLA8kQ7kNvwGPdmuK&_nc_oc=AdoFMZT52WuEtCNG43H6CJzg1lqx78tsJ6FkY3anxzG0lEfods7sj_-ij6ruFYyLAG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p60NkNXGffeFjLWO9LBcuEwqyIqiV0mhSFswnNOwlvA&oe=6A185E77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsmo7JVQoN4Q7kNvwF-2xcB&_nc_oc=AdqCuwW6VXuG4HokOmS4KOcPFHMK89UJMtIBNEMpNg3s4IJMlEQvi4DQAUMgk34X5ZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lSzXNT6sLEsXNiy_i_nwtE-GW1WA3uN4QhwaJQ2y7aQ&oe=6A183D0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s4p3VEH-z4Q7kNvwEKlBg2&_nc_oc=AdrTLgqBlG92OYzHxQG7SQa_kBRZHeU0RjI6aYb3NLYes6wWEWifxuBLhF-RCHOVBAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WxBOW_Lg5_lnaVX2O0QuwoulH3Q298NGaYxemGoOQ-g&oe=6A1837A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvJk2aTEed4Q7kNvwFcUQ8O&_nc_oc=AdpaxeDgZyAJQb4yCmKVVRLqaS-vk3B9y_vx5OJF5tNRNjkp8Tv6zyOY4r85PLreK7U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q5Co818iQ01os3DcEF-GTTpdnTnqj6LmOeQrPitEhPg&oe=6A186B7F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
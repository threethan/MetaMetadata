8fV3dioWXXlJ4e4gMt9GIv1l1yUtPeHVLujeDFD-vyKU2ABhV3CeV-9LME42dT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54GFNJW1MkjadeZSVE7X1DTNi-SRYmMMbKXojM0_g3FA&oe=6A203645"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qomBwu8TaeQQ7kNvwHV-9UF&_nc_oc=AdpLaSvOo7FVsDN56G7aLNIrPEovnyctzSFN4LBEqOCGB_3Ym7mySCcH4uc55X68QAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hCPGYBwsuX3rLauQI7q6Pyc6yJ2gdac9Y8Rvg_duzgw&oe=6A204777"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EM-GzK9QwiEQ7kNvwEWqbpX&_nc_oc=AdrO9-0V_arM5hDMXWz7R5yzXmlufqHsIen_GiAEgKtbL4ca26-pTTlr3jm1kf04OqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40_qVAd1JvSXtMm7BaO7FoqcS2q8whegA4dBsL8Tig_Q&oe=6A20260D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9vExhZoLnEQ7kNvwG6KFY9&_nc_oc=Adr1NL6AQ3Fj73Cra4mSyIYJpyuM6FpyNzkjyr96sfpWmgSVMuxrFQpw2UEGEmx8sOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JBNuJJ30AdFUABGqU_ghRJwSYlJgmVo_T6bGRUuZ70g&oe=6A2020A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UYH2Xge-xwQ7kNvwG5Pb5j&_nc_oc=AdrH00nyd5M0RxlzKpwesjpoveZMTYEQOIzztrILICWL9gN-gzIzeogmE7KG0xUL4q4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af537plWMLyytOhbDBGWjUYEFt1_cjO4MTczKL-Upj-cHw&oe=6A201C3F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
mYYLu4Gw5MYgUVghUmDiTKGOxtsX57td6qgqM1QRsyJRwrhDHB7A-_tvuFrNaWA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kdrS6cflmmh7gS5ui96ueQzoFPijzZFFlTSSJxezgBA&oe=6A257C45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHp89Bj-xvcQ7kNvwHOnjCK&_nc_oc=AdqJwfJ_quCm8cp_x0JADhExpFL51n1bpUpaJkfN46Uc52KZFjmEPC7GkNNiMbruxPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_8c7bOcZfimizi0qckiBMGrAVZ5EtPtlF6bvkVkOpKA&oe=6A258D77"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYkG8UM4OcYQ7kNvwGjmbqI&_nc_oc=Adq_3Qj_6OPhItvpbO31BScYfUHYZXbHlDHa4vl2STtgYvT9oNSOop8gQRdj9NNT_bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kyvV8nWoiEairMfLcPUIDCOhxme-ybJHwEvuEln-5Jg&oe=6A25A44D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhddciuqiPsQ7kNvwG0405m&_nc_oc=Adrg_nVf5aQLZW5dZP-8Z1C7enOdMn_N6o8MyTm-5zsX6ggOa28O50HKskTni5p7wnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yNxtNDL1DF7Z7gY3KvXQWPZBYdwd9L7Z_M4H7xPUGXw&oe=6A259EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WECTNL5EUIQ7kNvwEgiS-g&_nc_oc=Adp6H8WiAJUE_xGVSaEgzTz3egiLgf0EaYlfwC17ZwzaHWnyfHPDYaDxyUU5ipxVBLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P5cNMDvRzGgzRoS_mLsTZxRez5Vdsb_cXsyGP1nPSVQ&oe=6A259A7F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
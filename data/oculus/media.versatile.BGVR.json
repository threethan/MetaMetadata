gJOSLT_JSG_z_xNQBmvEq0axmG2SzHNqIzxeSlZl3hCobQLnvjdUdZH_1k2U4BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwGr1IeonHO-T3M7xBb3okWbsEPyKw3pAWga_hnm1vOQ&oe=6AF71AC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt_uoWQe7P4Q7kNvwGaBXQK&_nc_oc=AdrMtoHnk8naGJtsq1H1o6K8jurwDDwz11uxLHrvm0eZDsR3GnyFVooRqon6Ev-ZS1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShvQDJlXsrAbhX8xEq_5EGuHcABy2TgTWYzJwS_ZqcZA&oe=6AF72BF7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOcqp6t5TFUQ7kNvwEOvoRu&_nc_oc=AdqR4Rbo5-MMg5VXict8Dxy1uwYRRSsmLeETBci4JFfBGwXVkPXMTeQoe4FTsRInOP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUIApZjPdXH8aMNK9giM6h1QgUf0LPYWlqt07veyZmEg&oe=6AF742CD"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfpaEG_RWiwQ7kNvwHiemEd&_nc_oc=AdpWWsisjQpqqqviqirfMO1yQTNMUrQ5L6udG8iXmkcosiOvfGNCMQwgzT96nJdYCTk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo8WlGMqRJlg61VrHQTdyvmjVnXbWp-JsioDEuJ3gH1w&oe=6AF73D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdJo2X9NBDUQ7kNvwHY7NFr&_nc_oc=AdoGPWwWHkZx1kWTS-P-_uAtxC2ITm0HkQlFs-Z9pMu6Tt1km0FEIC28EzYZ82WUZjU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPgTIe7ezDXhsrgY-BoJI64GrLdqFsVDOcS_g2DjSOcA&oe=6AF738FF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
ss2q-3PswN-q7nnljjevbSUGH59ndAgcT4CuHhtNKnHaptne25IzyKPLg5cVKJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN4qJERzlXnpCnlmJubOlW_q165UdLAwRijRI9SEVEaQ&oe=69C53EC5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr8UB4OIppMQ7kNvwGBNZVy&_nc_oc=AdrLtGuEzTw8nZAv5wtNehBYjY-W0Fly_WSAFmgGnhaqOVUL21BzxQG0nlng568iXIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFvWJ9iCqMGljsjILAVKoWGBeqP4J82B9NTpLhswbIMg&oe=69C517B7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0ez7pDMUDgQ7kNvwHoephz&_nc_oc=AdrNnBcHH5d2btkJo02Q0go3o-BxPa6nimhAV_1mV8yY6y4LTitLFLoWqkkhh4HAXPM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6K9VwtwPgoJs0EEmIv7n1EQJTlQQ1ICpVVGAU5Es28g&oe=69C52E8D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJQ6-p0_hsUQ7kNvwHcQBf3&_nc_oc=AdoYEtdiFX73nUUoNTl_DbDpHj4GNX6W91k-lFyizp3AaZtc9bhcjlr8beUmSH9DN6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUjwo_9J9SpcHQPpiXMApRfl1bEOR0MKgl-1eqCQcXJg&oe=69C52928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osoF4XpknewQ7kNvwG4PlXG&_nc_oc=AdqavsMoYc64mfpgX4bkqG3wCAR_mFndQDYGesK_SVJ8ntmapSWK_ojnETOwvUT7HTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqlPM1-NqLrRvmYgnSVL9EhnsCFfZj3YRf1GRThhb0RQ&oe=69C524BF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
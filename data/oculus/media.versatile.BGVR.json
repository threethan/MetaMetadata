d24yn-x0g1yWPvOeLCXIl5W8XN3ZD983n8Ar2mMMYoG_Yq6UJ7svQj_9VsvdMIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz74hH2InP2W1oy8WGj-ZTZz4mP3s6SQMdx3XCyKyBpqA&oe=69C3ED45"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr8UB4OIppMQ7kNvwEF9Sps&_nc_oc=AdpNKMXGvKVkOl7Z9D8oWPXlv5odwbioixNYcuxpu5caMJgkRs-jU4XXOgQSjMu8WiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxLCEbpiCeVFW78sThGyE9hXbXDWn8_-q_WElBgWYOwQ&oe=69C3C637"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAfxOsgJLvwQ7kNvwE8OMmc&_nc_oc=Adoe165icJwloZRJ_UWlx1hoG2wdVVKAIYk1lmJYANKHtsAwwnctWzSPkHcxFCPLqVA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzme_ncTzDAK9iR6EMP4n1d_wemCIhPjRl0SgfzFRF8kA&oe=69C3DD0D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJQ6-p0_hsUQ7kNvwFhy6Ma&_nc_oc=Adp9yHxBV8ncTTQ8_SPP4tHVzTJXSJjU7P3nQh9geaWbCfMi56YjySuZpU6P2-1b-K4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzG7gjT2yfX2lJ9hiWb8BCZyRaiikq34ahseK_1fXJ7Iw&oe=69C3D7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqCNDuhm_igQ7kNvwEOBaXP&_nc_oc=AdpZY7OneUZFL4QXiGMBXj36AxXPvSHtmhEmsNCLd_Nl1VjWyNQ-yS_A0Incpdq8tes&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP_ITM_VEgsVyXuwMkNVZca5_2IrEAQz0oIGc33kw9QQ&oe=69C3D33F"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "interne
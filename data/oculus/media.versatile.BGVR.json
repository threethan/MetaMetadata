n.com&oh=00_Afs23M0ouO-TBMzUCfl6MdKDkarnttVkAWqAZoZo2EUoxw&oe=69A054C5"}, {"file_name": "ScreenShot_05.png", "id": "510052743867196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974610_510052747200529_3666543449626173299_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBQis48mht8Q7kNvwFoAv8h&_nc_oc=AdnujvfSZxLuU_MjsNFuVRKyreUOAS9ifJbu0njUv5AB5DTkJrXdrrCYkh28OwHl9zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvs3ti2BwtTGUBDkkpIPQrl5XBMnDK9yBHQP-49Y-4sEg&oe=69A02DB7"}, {"file_name": "ScreenShot_01.png", "id": "289498299927784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_289498303261117_3221700474339040959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3rLLr1nQIcQ7kNvwE5NNPH&_nc_oc=Adley9Vp7iQ6P3-fuZyD6vU0w95nFC8omBiPjCfKQ5qZbkjAahRqjIH2FZm9pO0Zf8c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftf6tJhMsgapQWiLz0WTUKX5hhsBadDxTobl0EhMHd24g&oe=69A0448D"}, {"file_name": "ScreenShot_02.png", "id": "371584171518633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_371584178185299_6298883299761893553_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-QvNScsvZMQ7kNvwFEkcTT&_nc_oc=AdkRFulZKJQVha140HXFh4j1hFL82HmFlg7sE1jm2uHvF-I3ChIQWnfY0OgiCWFe3Iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuaanimuIY4Ed0HJTSzkqbvP2c2oLN5dW4HPiCVent4Zg&oe=69A03F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "770904687212817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75488375_770904690546150_215956748943225609_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DScUY4qlhSwQ7kNvwHG5N1N&_nc_oc=AdmN21P9wPWHpJklwgOI4KMlewtVYQJXk6dfd8O9WBK5hOqW1LQq5X8TpFkkLH62ssw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-YQm9I8TCkxQ6i9qAi2VhLznM5ozDxEDGtYjJpoLx8g&oe=69A03ABF"}, "display_name": "Alliance XR Culture Gallery", "keywords": [], "long_description": "Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED (avirtual exploration of the Mythic + da Truth!).  Visitors to the XR Culture Gallery will experience works of art by Catherine Blackburn, Lola Flash, Jessi Jumanji, Karo Duro, and Valentina Vargas \u2013 and many others to follow.  We co-created this space with the hope of building access to technology for those traditionally excluded from opportunity. We share a great resistance to participating in a virtual reality where many people are not safe and not seen, or cannot afford to participate. We hope that one day, our work can be part of the global movement for a more humane, just, equitable and sustainable future where we all survive, and we all belong.", "short_description": "Over a year in the making, a team of international BIPOC artists collaborated to claim some space in the metaverse with a new kind of Gallery of art and storytelling. The exhibition centers women and non-binary voices and identities, in an expansive, cosmic exploration of cultural, personal, and mythic experience. Come experience the first exhibition, a work-in-progress called ANCESTRAL FUTURISM: UNAPOLOGETICALLY MELANATED."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thealliance.media/research-policy/the-alliance-xr-culture-gallery-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "The Alliance for Media Arts + Culture", "support_website_url": null, "website_url": "http://www.thealliance.media/programs/XR-Culture", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
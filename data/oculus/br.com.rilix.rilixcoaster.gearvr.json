5_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob8e0YVW7IwQ7kNvwGs4A82&_nc_oc=AdqtB1Rg7OMAiIxD1N14rszjB5LHmzUqV3onWQBGBiAcjithScr5swBJj_KdOzgS73A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S6Ugrg4hB5mdvRlHarXt1um_J1xWuaWD9-sdbD_cXww&oe=6A23011C"}, {"file_name": "Guardi\u00e3o_do_Egito_VR.png", "id": "500664954222740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001673_500664957556073_2114205590089140013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccgMqq2IqDoQ7kNvwH3d-gx&_nc_oc=AdohN-tt_rNPyPHTGDspS-vSaA4GuoVfMV80DqoqNlVhc5wf-w6wTCDwuXt8NvY-Eqg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TSdZv2DcC6M9JEjEFjMaA--lzg3nUYtWFx3-JB6-urg&oe=6A22EB88"}, {"file_name": "Dino_Land_VR.png", "id": "280500153255067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031608_280500156588400_1900585261341490933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhFWksFFoc0Q7kNvwFRguE_&_nc_oc=AdpQisKsBrXWDKe7UCcUF3YpTSETV-45phgIjqROS9UBo3KJPYHFe-EtTUq_PJjPBpw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jW1-ZeKcPXk4vA0mMuqZOfDHcHDDq4164efRhLbdkMQ&oe=6A22F45C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumnail.png", "id": "394612834999269", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_394612838332602_195144323685108825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84XXwrSq2QYQ7kNvwGYxQWO&_nc_oc=AdrKsOm09931oVw-s5Gr8JRG9bh08CJWubCXI2DrbuKCHhTfMkzsCY9LsMzChEJN5Kw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wLGA2Si2d1yJU_-OS841emBsDeOv1t7Da4itSyuBtfQ&oe=6A22DAE9"}, "display_name": "Rilix Coaster", "keywords": ["rollercoaster", "roller", "coaster", "simulator", "exploration"], "long_description": "With the Rilix Coaster app you will be able to experience one of the best action simulations in Virtual Reality. The ten environments available that will make you feel like you are in an immersive and fun roller coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxb7Y54mi2cQ7kNvwFb69oj&_nc_oc=Adq0V6nqG1rtBUdM8xylzlgAvZP9dMf4giRNVgbG6eV_R8-psRXxCMFFnibOnpc5n-c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0_xc4-yr2rqh_ci-vQhDxQySgsYI2Kw7bhv3Kb5GMeA&oe=6A22D1DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster", "platfo
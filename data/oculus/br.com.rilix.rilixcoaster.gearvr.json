762993265_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srhBhre9xbMQ7kNvwH5VPq4&_nc_oc=AdonILBMJ17OGCXh5BD5D-RONTqQ9hwRD0SQHjjR9C5OxCcMESev5IdWLX7nCRDwW54&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiz74tKekgbF2JrSdsZ9ZxxROgFWd2lMU_5EPqBAodVQ&oe=6A8EE3DC"}, {"file_name": "Guardi\u00e3o_do_Egito_VR.png", "id": "500664954222740", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001673_500664957556073_2114205590089140013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5VyCU6ziywQ7kNvwHw5VEd&_nc_oc=Adpk_PNecnPu8YPTyyXozmLUSwdvgH0ZpJzx2iDtjCK-Wl3GXgi17EvGsZ6NF9SPSCE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwrs2FVt-LHP3idbod08r5DGPGXyW8vy4keJE_HZ-QRg&oe=6A8ECE48"}, {"file_name": "Dino_Land_VR.png", "id": "280500153255067", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031608_280500156588400_1900585261341490933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOxrCpKveWMQ7kNvwGpwQsT&_nc_oc=AdpZ5eVlbHsodQIwc21rWNEbdfAUAD3VhNaaXd-XVJTXAWxRsp-QHDIfWxSeSZiaTvY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfIgapscVv9R_UwD-7NnWnFZqUai8V25BiAFiyJ15HWw&oe=6A8ED71C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumnail.png", "id": "394612834999269", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001691_394612838332602_195144323685108825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi16_kcfuSUQ7kNvwF3PSva&_nc_oc=AdpZ5hmywgim3Yl4J4l7YFvHJXXz9VavYDyQgPpI9uHFmRlFFHb9bECc3ViXO4RIQlQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPeWwD53QRvIwc6DoWhLvDWYiRhsiIxx0JT4xlFlJnZQ&oe=6A8EBDA9"}, "display_name": "Rilix Coaster", "keywords": ["rollercoaster", "roller", "coaster", "simulator", "exploration"], "long_description": "With the Rilix Coaster app you will be able to experience one of the best action simulations in Virtual Reality. The ten environments available that will make you feel like you are in an immersive and fun roller coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU9ZYyOpodUQ7kNvwHjkZUp&_nc_oc=AdpgP9LYMqabHUIo7tRCYntU01nXBQpTsEhTyaOyAqQ2R4MuSoYRJL0jWgE2vg_26bU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6b1kqhBXq_3vGhW9m6rdauVw6sDDE8Bg1lrJFxb7FmQ&oe=6A8EECDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster",
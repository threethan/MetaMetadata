5_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yamvQefYgZMQ7kNvwHg8Qyq&_nc_oc=AdqUEfDN8kutxq1L6mtDQ99wWod88XrdJ7uaEA4bwcGbLJXDBsgGLE6dfiY6XRynMM8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHogb0y6uA7L7UXy6kCF91cxV8A286gQiwPvNW55FKdkg&oe=6A7DC05C"}, {"file_name": "Guardi\u00e3o_do_Egito_VR.png", "id": "500664954222740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001673_500664957556073_2114205590089140013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYH8GOJAZToQ7kNvwFK38fN&_nc_oc=Adp0Dd9WvUhtrH69wai5wXBOqyGHghnZrIqqRn6i-pHDC2G4n8wpf47wdy0iZcX5OIc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbn65BbpaWJhgbFjdne4KbfE2o7VYxijLjnM3xjmQi2w&oe=6A7DAAC8"}, {"file_name": "Dino_Land_VR.png", "id": "280500153255067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031608_280500156588400_1900585261341490933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QgTkl__zEUQ7kNvwHNpYsW&_nc_oc=Adrtwxe7ZuoFRZdqnRt0b0hHbfPzjPTKarOtGOvuECfTGNt2s453NhoSThHzDVjLX0I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtfDtXivVGziGr9eYU-EzodDHSyBhsk4P2_yfKJahPLA&oe=6A7DB39C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumnail.png", "id": "394612834999269", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_394612838332602_195144323685108825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvulQS0US_cQ7kNvwGhQL_i&_nc_oc=Adq3Zc8mvuLrkeGeA4NXvaa7uG3UxeOAlUWmOfBymJnxkc11Ft0mguFRkFjdv6sO1wI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGotLlm4FCVJ0M2AP9w0L1CXprlGV7r6CfInBzmIeCJ_g&oe=6A7D9A29"}, "display_name": "Rilix Coaster", "keywords": ["rollercoaster", "roller", "coaster", "simulator", "exploration"], "long_description": "With the Rilix Coaster app you will be able to experience one of the best action simulations in Virtual Reality. The ten environments available that will make you feel like you are in an immersive and fun roller coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ogvwDtH1NwQ7kNvwFLx4nI&_nc_oc=Ado4Bwz9CxkfheLT1ZdOMMTSv0Q2zlWRqQtyAKbY3fRk491-zCvcA5gsf98bjjs7luI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr6QFf89aGcPzx2ifLLGCXC5KJBNGeh6LUFnc19bUS3g&oe=6A7DC95E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster", "platfo
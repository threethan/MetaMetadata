5_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncSPBlgc3CEQ7kNvwHsNp0Q&_nc_oc=Adr6nWRB6_kMQKUNmvRChVFxbfeazw6ju9zhNiOC2iXr8l21gROhObshyd5eqdqCyds&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc4bSv5FRJNbM1BJNSRCE0Ff79ZheZ0wCCGhzwHvPoFg&oe=6AA3FBDC"}, {"file_name": "Guardi\u00e3o_do_Egito_VR.png", "id": "500664954222740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001673_500664957556073_2114205590089140013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfjGDh4qnVAQ7kNvwG55-tZ&_nc_oc=AdpJh2ZCRWGdfs3j9hBPMaMMbNRabqNPBTGGqQfST35h5sZ-4VXzM0kWmliyFwAA52Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6PopOZE3MeMt_r7lkoepYbpSPMKjOSu6TpzaV2avCOw&oe=6AA41E88"}, {"file_name": "Dino_Land_VR.png", "id": "280500153255067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031608_280500156588400_1900585261341490933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5MLICDbUAQ7kNvwFJQvCy&_nc_oc=Adqaa4JRVdPMi5Wylp4AwoIZNFEGOEDDR_eevdwM5Jz1QGg-by0uqToqc4qfV0lp_K0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuEKN_wSdcNhBAaKZ2CTNPJ2R6rk-XlvF-DtjPk4rZNw&oe=6AA3EF1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumnail.png", "id": "394612834999269", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_394612838332602_195144323685108825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGh_7RFCBgwQ7kNvwGnVQXD&_nc_oc=AdqLHQGueSmxe1wmiOhBOXDqQTxzYJxFbpNMpsjiiQdYbgiZrvej8ZHU1A0_citrUE8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILKpYB8fKBQbh7iRWdNvdir9XAViEf5R6ZNWvEBGY-ZA&oe=6AA40DE9"}, "display_name": "Rilix Coaster", "keywords": ["rollercoaster", "roller", "coaster", "simulator", "exploration"], "long_description": "With the Rilix Coaster app you will be able to experience one of the best action simulations in Virtual Reality. The ten environments available that will make you feel like you are in an immersive and fun roller coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phd7eViMClQQ7kNvwER2DzX&_nc_oc=AdqtInkfMdLa4uZeUwPfPSfMU-PB5fcTTNIAj3SNw3h34jyXf2-p7DEOrQYRltaZjg0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwROELZYf6xLrac_gshw-O6nuDfZ3Ibzv8OjR2hB4JdA&oe=6AA404DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster", "platfo
r coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQs95vj_moAQ7kNvwFlDa3K&_nc_oc=AdqUN5p1Elc8asdw4zEZaCe45d2pBZullxzFp_tSTXFLiCGD7EGoI9YWPWlglP_vg4o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mdOCyvfUH7BAr3Pp6igChMIT-R1qA47DeTa6E5OSZKg&oe=6A1C3A5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster", "platform": "
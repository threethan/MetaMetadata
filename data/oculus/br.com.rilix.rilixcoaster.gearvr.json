5_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUIxTw_ovy0Q7kNvwEK1K6N&_nc_oc=Adq540-JaDAxIkbkeDtVkckIGEnPaf74FiNZ3Xuvgli8LJoxkqqeZASozaSwshHVJkg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ArfbZ8pk0V7o1Zr6iOg4m7hXOc0ALRNokTzKYDDPd8Q&oe=6A46615C"}, {"file_name": "Guardi\u00e3o_do_Egito_VR.png", "id": "500664954222740", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001673_500664957556073_2114205590089140013_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Ic4UoRpJgQ7kNvwFAhnLz&_nc_oc=AdqPZeqa8PCbow8K3RQS3iEGfWPjcV9fsdn9R4xcEt2nHJbJNovEMf9TYZX8Tc3kEDg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tgSv7tJu4LWUZRi5GOQmOlKnxuV7Cf1_zZOkoKATYNw&oe=6A468408"}, {"file_name": "Dino_Land_VR.png", "id": "280500153255067", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031608_280500156588400_1900585261341490933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBn4tLcitf8Q7kNvwFrrZnH&_nc_oc=AdoRPhAMWSn66RMdkLnpx5UW8DN-A8oA3eljlJ8HgZzI3FVO56ssZ5S554a4U-iM7vE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BE2i5bxo5gVdXszzxQaLyZYLbywZ_Rsc_jVj5jLpwVw&oe=6A468CDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumnail.png", "id": "394612834999269", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001691_394612838332602_195144323685108825_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnbaFmV9NfoQ7kNvwG6SxDQ&_nc_oc=AdrOWbJtCv3XxW9wx7PE5Lsy0EjLEISTcYaf-4ezuJt8VHs53OB0hE6MHJGNlCf-LwU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98qyAJ9gJO7B9F9lPV0hEmUJ9uty9A10euXRdpFFtWUg&oe=6A467369"}, "display_name": "Rilix Coaster", "keywords": ["rollercoaster", "roller", "coaster", "simulator", "exploration"], "long_description": "With the Rilix Coaster app you will be able to experience one of the best action simulations in Virtual Reality. The ten environments available that will make you feel like you are in an immersive and fun roller coaster experience. Rilix Coaster has some diverse environments that will make you hold your breath and allow you to travel to unfamiliar places using Virtual Reality. To experience all this with 100% immersion, look for the nearest Rilix Coaster from you at rilix.business and discover other experiences! Rilix - Real Life Experiences", "short_description": "Rilix Coaster is one of the fastest and most radical simulators in the Virtual Reality market. There are ten environments available that you can choose and you will feel the action of a roller coaster in a virtual world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rilix.business/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Rilix", "support_website_url": null, "website_url": "https://rilix.business/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6896725590429912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162753_1699348493422930_7945026642412306432_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4nUezu-_CgQ7kNvwEj30q3&_nc_oc=AdpIBpM-RQn5bws3wGUTpoVdDfoUrzG-vr7gA_E9z3m0eWagc7cxwOxVSE3WnBGh_OY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v3P1wV2xEguqQ8L3GzUqGOdmmKNzI_Ig0YXew03I4IQ&oe=6A466A5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rilix Coaster", "platfo
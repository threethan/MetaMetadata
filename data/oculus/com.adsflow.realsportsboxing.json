c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFkEIg5Y3vgQ7kNvwGDEmcO&_nc_oc=AdqjeG8KsBFo0tZfcByqk6HFjIFOsv6Lcr0RhembSybI7RSZ1F6-wlEqt1WY9y5f6vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb7C_iC30_U81TI3PrQTNqh1rJ2BKAD1ez6Jq9z6XWSw&oe=6AFF1804"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfHueF7MC1AQ7kNvwFPQXi7&_nc_oc=AdoM904CPT-Ry16lDrzIU6nNABMBUG_7EnlbG3gu9QyxECAepE3qR6Y_wslwJjLRGJM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt7eff-JTNFoypBCj_QvZDmma7N-HrpeCD_NEG5_qTxQ&oe=6AFF1983"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvg3nq1gc1AQ7kNvwFr7hR0&_nc_oc=Ado51gGX01cxtl3z9_KNqXaBxaU6GP78jIB6qSjbpRupHg5NYZNrq-nIJ2vf-Pm2nQk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZUxMUy7AaYK1PAfrBUJoTLV9RPpiFo9TBBYo7Tll2qA&oe=6AFF1A43"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4r8AoGjDwQQ7kNvwEHUupx&_nc_oc=AdqjFBez4K6N_nPp3EXDoSBJG6e7KFq0GTqDuXAK98DlcfuUbR8DNvh8ClDx7K-gT7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTS43z3c60MjzgIYi48YiJdY7NhW8XuwSqJE2UhgBJQA&oe=6AFF232B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQesk7CqNWoQ7kNvwFn3Yic&_nc_oc=AdpxAVTFdTqEfhoHix6L0EbSs2cICeOFSjIm3AGQSkJsO79Lp5DeZMWXOsKA21kpDrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV_65J5KCod2votNFSjcqXoJx8YEjdtKtwecHDJOdLIg&oe=6AFF134E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
g5boUD402lWJX1bLAHpaSc2Un7YKPov64rCDKSgC3rQ&oe=6AEF4604"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQAOTNoNmagQ7kNvwEk09gH&_nc_oc=AdpxBu-dXwPwDT-e2fIxasow-gSQSeo7xQ-Hx5O-XWbTVNIwTTsPbJh-glssvClXlrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE2SKHRxBIjneW147Ob9_MJd0ini1Q8Ma7-ZtVZzmjQA&oe=6AEF4783"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmtCjNlFNjIQ7kNvwE8GQAS&_nc_oc=Adq67kV3kQbFyYflmdvJcdbQZjMmXTj-b8yd0Qyz8BrTxUudVGMRnZdhGE8oqO3h0GI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwR-v8iXWZOmim4F0BPrNSDLCTWOww_4m-Y1u5B_HcVA&oe=6AEF4843"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPWwe5XQwGoQ7kNvwFjZ4ua&_nc_oc=Ado0MQDNJpzYOUninmS7W3LD7k4g8P0v5R_aqyRh-CqcJZR82hoGvi92hbNVOUmohuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkufc000pibIsPlBU56SFVCki4esyJy-oIgToMbXx8ZQ&oe=6AEF512B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KWZe8R0W_oQ7kNvwF6dyvU&_nc_oc=Adrfhqe-aKukyc55bt1ug69AqDozRLsVdXHbyS4LhGAvn_st5cukgh3DHeEyh26Nt8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrDzy0FgCZ_1nGcGTgmcXdcFXDNkp5-ckbckJX8JyiiQ&oe=6AEF414E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
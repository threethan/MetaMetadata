c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUzflxwBdksQ7kNvwF7PJ_N&_nc_oc=AdrmPFZRLyZS6gEVmnXjWSDb_-EtajufDFOYx6O7RnJqKiw8ObB3bzfr7w9e4WSBjdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4kA0i6Dp0dLCJtLHVc-Tq5uIsA_4v6toqnQmkNCscpw&oe=6B006984"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfHueF7MC1AQ7kNvwEtaI55&_nc_oc=AdrvFiVPYqV2UFbfjIQeQVyINzbZBmFrPtqVNdljEEDipbLOUh3w8gbxbfJeeb3F_Os&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5vzz4TxbTXEu1SfOpt4umCUHcxCUOdx4R2mlyE9iaHQ&oe=6B006B03"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvg3nq1gc1AQ7kNvwHTAllY&_nc_oc=AdoIJYYNenw4gldepwgBv4X14oNHiCGyMRq_QycuxUu4dsHMs3GAe-dl0S13W0t1--4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtu-E-TIWTakssN6wnxVQOvzcaLKe-2gJYxTUZU0VMuA&oe=6B006BC3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgf0oKdTh4Q7kNvwFxx6E-&_nc_oc=AdqtuuPaQXifNIiWCFrWWeiHtmtdk_XZCgLBxfNPkD-zlSj_DBJuILdrkaM9HeeiD7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOncUVw6pZP7Ggn_hfacVFdLtUYRFOqeghGza7DFRW-g&oe=6B0074AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXxoGg3FHusQ7kNvwFgSWwq&_nc_oc=Adr9ZaBRDNQYjujoBNDzvvv1t7k75lO_GmYFEf5R0Wp6EXcg_1Kf-FDZ6DlhA5WMgWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8bUaGLuHMJ5JYjwwy5cvseBk9GwxN4j91y_0ckkd-EA&oe=6B0064CE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
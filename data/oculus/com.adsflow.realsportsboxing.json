c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFkEIg5Y3vgQ7kNvwG8st5p&_nc_oc=Adoo8KIYH2Nn-LN20r2Sr3-kP-G1VEWEEfNP4z-2JBPxu1LLXoiDCIE_BO1OIbxLKQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn3vzJadQx0otruBFpiFfR_N4SlA9mzxwBZWlmyKhCBQ&oe=6AFDC684"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfHueF7MC1AQ7kNvwGKAxMC&_nc_oc=AdrlOv9ryRcgSKDhA1Q6cWcUDH2zwI5HTu2bs9zBqStvGQRwprtUmzVSnj4WZvuQFT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfgZjeI8RTmck2OlisSl9qhR3XY1j85AoQ67UWAJtXyQ&oe=6AFDC803"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fvg3nq1gc1AQ7kNvwHFz0fw&_nc_oc=AdojXB5m6KCfGEqKviMy8nYNt-F76zIN9n5kpwmsslQVG525poHIheSJkvCG8SxQlic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUMaKde4XjHEstfq2cPqf4Gd4Ivw8Ki_LrFdaI1IaGWA&oe=6AFDC8C3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4r8AoGjDwQQ7kNvwGiNuQQ&_nc_oc=AdoEileuORJ-GF1M5S1jq7GsrybxlDB3kw6xVHFaB20gTvtyyc9zWWdr0tXQefJ2zC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB5bH8OX8VkC7zx6QsloDUUG-eOmiuly7UI-cBsHVysg&oe=6AFDD1AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQesk7CqNWoQ7kNvwEx8URH&_nc_oc=AdosyqPpk0zpO4on5OUEZG4EEAv9OyY0nYHyZE6Ci6ZOuEdzxCnudN34M3GFooaBYTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe-GwsvCcIgWMuCQ9ONRLt0F1R4YrRybqagM9bNsJ7Xg&oe=6AFDC1CE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
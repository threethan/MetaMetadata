c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUzflxwBdksQ7kNvwFgFEIs&_nc_oc=AdpEF_yx6VerEJhsudi1TEa1UY_HOUbgmI-pcsZrl3YylTbpHyG8UQ11DxHS4XIf1bA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg8T3PHirHBeq1yI5CGl9ca5Bs3WfUu5-bkfq5o3YCnw&oe=6B01BB04"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM2DZXS6RboQ7kNvwH4IlwP&_nc_oc=AdqJyFcfOpy9esH7Ki_IT0i1ybwArN9xwshlxX-3pfzYKNizz8PzOcTpmjI5XCUmYoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPkYNlbuVl7Wd_XubGN_HoqLGDG0fxyywbXzsK5O1L8Q&oe=6B01BC83"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT61LwLgmfgQ7kNvwE99SJ-&_nc_oc=AdqJvhRvqjsx6nmvoEYwptgeGgqX9df3pe5j04Sb6u0tngnabKYQJKDHTZ7LZLXyBt8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxph7wppc0Bi5Ds1OPxsIEA56GQR_nl0ew2GV7NWymBw&oe=6B01BD43"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgf0oKdTh4Q7kNvwHEV2xS&_nc_oc=Adr69eXJU7LUmMv62sSxP0Vs8ijNoIIfwErObhR5nvTQmVyGNh9D3wS787ErreDrlwk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAm3Z7Ol4YwQSS56mqF7RehAREKy4TviQx7Iy4zkt-Vg&oe=6B01C62B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXxoGg3FHusQ7kNvwGF-4D0&_nc_oc=Adop1Vko8O9mFtSLJDfekvdWNPoN185zc8a0PGM-4nib7eYnaSJjcESOhOI9TuPhZYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzfyQDwMv1tLVPC4mluqU_-gOwc1ngwa6DJxM-uLjb0Q&oe=6B01EE8E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
00_AQIVND2o-7dSIEMo2H9j14GS4BiMpC1a7W-rmCcKIAf6kw&oe=6AA42084"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_av6X0ItqwQ7kNvwF3VAF-&_nc_oc=Adqw1mjFR59v3iNJXh6FRmmwSJ5mNJ7yacJd5g9VuYU75Ml3EMeBr7g4n8D973jqprU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzOKV23X1Z7F7hi4RH_X2FPfWvGMZammL1TCtek16wiQ&oe=6AA42203"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWLvtRTZp-4Q7kNvwEmaT7l&_nc_oc=Adp31C6vRcJrfIuohQlRgLLOFwfcnboTaFVSbUzO38wubi3a-k65tlWHb3_sgpjskzo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIuk6qHKOa9zccWczqSP0ekcVnEbp5oM5L9w1zQqdhWw&oe=6AA422C3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUwiVjmJOAgQ7kNvwHLBBH_&_nc_oc=AdpndVOxiCIA91CvtwBh5o7Fq36m-h5iLvNDhZISygD0njvHP8omIwkvBs72Ryzh5pQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5b-wt7xrMOtnDzSVDkUup2F4skCPO9ufiHI6JycF5iw&oe=6AA3F36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdrPwDGzaegQ7kNvwEyn7M-&_nc_oc=Adq5btzDDRMUonE9hhVrbTvXByferRSheXEftegN3iJkbLlwhNIdD_cCWvULu_HXc9E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzx-UsioB9w0lc4lh1Ho8nHydPtuXfVM1kCIaLhWtRjA&oe=6AA41BCE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "r
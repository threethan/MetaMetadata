c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPgXqp98G5MQ7kNvwFzk6Kj&_nc_oc=AdpFZZ-izdftXDAXpbpmjFQGw3aNeaOzz1EgBRBybPHM37zl2p7gzbzbdMV6xYNPvEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1K-GaZX7gbTRH4YfDzTRmDsX25YTpiOyp3jnppG7o3A&oe=6B05AF84"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTiO87GFiMQQ7kNvwEqfyOm&_nc_oc=AdqvaY0tF9fPSodrnmuk2GjPfR58wcZQwM4633BThwnd5uBMVfzf5mk0ZD3VHqjmzRw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpplYqNrb9KRVvMw_kYO_STGFotnFhLH55d2kUC_LM0Q&oe=6B05B103"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekL0bsRvaXEQ7kNvwG4qEOf&_nc_oc=AdrNVGGobRNuHg1ARZohBX5Tfpo6Qrvu6w_hrIcXYTln8XJDHZjDNXNOKeA6BL0NRf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-b00bYG32toe-F_5aA6OYmgDK8GQFwRpICTzgviG04w&oe=6B05B1C3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPjWGcmAK5MQ7kNvwHuf04H&_nc_oc=Adr0jsZxfL7gLi8h-mwbFFaPy_Gm9Oc3VhoHP7OaPuqd7FaEfrQgH64yN6BlZnr0iG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqdBvaLejpOItFa9Yacq9XYgz3Ax1NIRzGFLc34XmQQA&oe=6B05BAAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE8cdCwmlmAQ7kNvwG0UqTZ&_nc_oc=Adovw3rChFC5IMmNpMLapDWpWM0lZ7w5xXXc4Bgd5MtQoJ-KkyuIuYag2KNal5Xlafk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8_xbaRY4o2wC0nJTybAGfj6STRjUwHIoA2IfqVCj_1A&oe=6B05AACE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
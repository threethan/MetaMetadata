c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YODeZsRM38IQ7kNvwHt3Oy5&_nc_oc=AdqaXiDvkNo9Sb6lyAqDpH6aEolhjJNvuoXrwa4pf6A-r436aA7Ngj1C6H5lqXXWnLk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMrCC_iBAWAGPS9XJohJh2QJ-ibjDRuZ9pvhtO1h7a4g&oe=6B0B2DC4"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZArFRSb-ZAcQ7kNvwGODsPM&_nc_oc=Ado-LqqJPQqua-4Upk8tbDnlVll8EMTGsNHSOyDeOpX9Snev4LGrnKygZ1ARYZFFTIo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ0Fi1HaxEyRN0Aq5QSrbBiszhM5cdtGDVl-uZSeUlmOA&oe=6B0B2F43"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I0pcONSVuYQ7kNvwFVGkCB&_nc_oc=Adpjjykd1Yaz7HYBIb4-5oDJHxjE6ZyoHTuWQBMKHXQvXtE9jvtDpNNSf4kSJ1feljs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSn2ST4jamTzOKD1TDF9KssigUSQ66CTc2cZ-YCR6uxKQ&oe=6B0B3003"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1SxAzG3ptkQ7kNvwFd761E&_nc_oc=AdrOPBHqJWaUEaQubulPcysuLn-zNRf3WVVnxO2RP8UUZPvADXukfvo4mAnqo2UhSNg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQgykUi9c2EvRchGwyeckXHj7S_KseUSZPJGChzYLXk7Q&oe=6B0B38EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPBF1EZj8lwQ7kNvwEXh1hB&_nc_oc=Adr8xN3pqeOWEBCMZnkdB2bnaZhE0Qj5dPT5GyuN0fO-pFDCTfoek2OUmXfPbybM0eY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRe3bcF9Lm-IiUNPC_E0CcIH8116G4y74S-rggKVBo4KA&oe=6B0B290E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPgXqp98G5MQ7kNvwEiKbY5&_nc_oc=Adp0Vuh2x1ZQdaoi4oIsFJvICD72nsIh8fMv2wfmiIyS62NBDgurHMtyaKWiJLgMmi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiXjNus5ROK4kFw0pj62n55YRpj3-SPlVcAFiNPpar5A&oe=6B070104"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTiO87GFiMQQ7kNvwFh80Cs&_nc_oc=AdpHU0aky9TU9HFY6YOvNFdLWcEBQjiJSOMJki3QzQIeZe4Nwt0x0L0nPmIyu72xI4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkzVotFZYGe6ayQgI-N892AvuKbP88Uv5HG4p0xysXiw&oe=6B070283"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekL0bsRvaXEQ7kNvwGCkGJO&_nc_oc=AdqGrZL__WJck4_LJWg9-Z2fc7M3H4IZLiQtRCyIC9aBg2VyaPDYcD57z47Yp6P3tbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlqsUx08NcCxHCNfnGmd5QkE_jUIEm0VrS-m-t88G3_Q&oe=6B070343"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPjWGcmAK5MQ7kNvwFAAtng&_nc_oc=Adr6PAIOVgU6ChO3kk9G5Hp-1qKtiNeLgNrQLVm1CiGgO90H9cEBzWJQ8aV07A6uzG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwfgRwlqiu2NvinPLTMyvuibKWIiG-7rv2dGS9vOLGyQ&oe=6B070C2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE8cdCwmlmAQ7kNvwE2K1Su&_nc_oc=Adps7kQ8XxcsGdRMMnY_yO72rSbK-lEU9ynhQlRxKT53zr7LoxjdXBzWr2KiiJw2ILU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo_te0AZmHTYpdB87wJjTB71g-9fDfbPQ8eTyCfZFXRw&oe=6B06FC4E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
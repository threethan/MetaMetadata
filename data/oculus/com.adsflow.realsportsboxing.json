c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UrzqbROWOgQ7kNvwFQPky4&_nc_oc=AdqiK5sMmYDn6r9Lo5uEVx-fTYU1pPLpQgLditptQ9SvLZA1xUOCqFYN2DaSEbLGHBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTia6EqNud7Plx27MXrGw2j2djjTMQCPq8j8JTkNVOOLA&oe=6AFB2384"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qP6C0O-dwoQ7kNvwH5Ybvc&_nc_oc=Adog1-LSCsn5PcGuqmfCB3YhbUdGqqp3PCD_896O3f6faUAqSWPrWDXrQsk_Ne3ztY0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQRJqSbQ9yr4_fT3T_lJRFyygkFF3ExnPNFo6u2mI_EA&oe=6AFB2503"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbbM9vl1U-MQ7kNvwHRXOrX&_nc_oc=AdpsX4I030fBlSyIf1wga3sNIQekS6kKjKIQKXFuJWA4QpU2k14jBCrCHn8Jrgz5kkw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYrmIS0lSBAH-yyEfVY4BYAn18fw11Lgiw2FULgjfvEQ&oe=6AFB25C3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxSzS-oWzKcQ7kNvwHN8ign&_nc_oc=AdoovnZ4VVoaNrbLMiwSZUk-qxuKQ7SNwvCbQNDpW_PSJQpF58rK7NtWD37xGdAKMyE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBYOozKRBrdvgutS5xiD-jCj3832BR8AKggumzr1k00A&oe=6AFB2EAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eylN10wvYnIQ7kNvwEAg_8k&_nc_oc=AdpF0BYE0UglzBuyPtF_b3wbRlz0zqV3Z8UlawCXxVDai7fZXt6c-qV34ojKssooEU0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2Br2fES7bPqZ_FzMVjmfasx-t767WA7LpOajoQTcOdw&oe=6AFB1ECE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
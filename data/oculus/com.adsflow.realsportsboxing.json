c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUzflxwBdksQ7kNvwGPxSii&_nc_oc=AdpOYzMSow7JS-G5uB1f8XL5YE0KOExR-bTFZsA0_QzYvPScg9hv_PxBPUvCkxjhNmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9NVzQwjQBCiFj5ipp3DaS73Z2rBlDGRoP-shFiOyhvg&oe=6B030C84"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NM2DZXS6RboQ7kNvwGd3ioW&_nc_oc=Ado5j6PK6zPZyNhpQUs2cDzE5VDV7YupBLi6NJqY3CHwXWpo7X1rJutjJAWN1H4HHak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKixc-8Gu0v_zHWgBcriqfxo8kS4pGs1QRGPBcWOo11g&oe=6B030E03"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT61LwLgmfgQ7kNvwEXR5et&_nc_oc=AdpBU6x3uh1BQwLI_tFnCefBAcibbSmfUklEbVoaBMtkxdHy_m2tm2iKywuApfvwg1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkrPHg8OQrHGqzFJZ7Fgtv194avdGy4FZak09HrIQvBw&oe=6B030EC3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irgf0oKdTh4Q7kNvwGyu18S&_nc_oc=Adrj21ii5WoU2DQkq71YBSwSbmfAmGIBfJxWRWfOgmdFQK7sO_hrOrZZCb-jU308UkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6IeZOUFp4eeU1LKtk3bx9Tod64sN1lrBcAQbQ66Xrfg&oe=6B0317AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXxoGg3FHusQ7kNvwEugye1&_nc_oc=AdpLiMwUFLBzgVght-GrHQG7vdVc-xyuKLkQde1Gqzkup68wkz6bHYg5p29UDoB0-8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxExQQsscdj-TPPcOuB-WIbwo-4lpkRu1xeMZW9J6K9Q&oe=6B0307CE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol4INpODcNIQ7kNvwHXdyCB&_nc_oc=AdrojgfBq7Adf2T73m0O811RZEsmjcEY0B9H2B7BpQIjlDpClJry9PgauomVfSlBPDo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSYCx81aURRMA63Bsc9VyaHn0am_manChBE0osDpFwzLQ&oe=6B0C7F44"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZArFRSb-ZAcQ7kNvwHP6WcQ&_nc_oc=AdoiUAY1wqsU3gcrYjcFWrs7BX6i5uKIKf7yk-DfZLeeGXl1iLz-f3MvWvLxR6QgkP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSin-D7jBm7vCB0E3q4ex4kTa14eF1ixos58UeFNc5ssQ&oe=6B0C80C3"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I0pcONSVuYQ7kNvwHpV9wO&_nc_oc=Adqpzu8peBiMUKpmQ2Rmzjvx3STKNAsI9PTH0lJDoFzMYTlkef7nLxZZ5JzbBeOkuFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsgQD25dHkjS0mY5f9vsmJwJMMNQXmuZax17BcjIeXYQ&oe=6B0C8183"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zE0Xl-7l3GEQ7kNvwFjcRXw&_nc_oc=Adrlsdv82wCb7uZAMx7AX_hPmmEOu_VzwtXSHmhd2YliTN6Gzy6AmTzF4cHA181GVeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTR5Yxb93KGc_RUrasnAYeCBDzVHhml4sVCJTtZMxwg0w&oe=6B0C522B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVA_2wvBerIQ7kNvwEm6GfY&_nc_oc=AdqPDU_83-mEbAIgX-_PAcYqjbq4a43l9m0Ltnl-vVs3SqQU-cwnYTI3qf7co5nmXqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFKn1y3Qidl1ISY462HN9NqGb_ViO2PVq1H8qJ2z4g8g&oe=6B0C7A8E"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
c_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA31rz-onqQQ7kNvwEFyCwW&_nc_oc=Adq4YENi8zhSXFxgtuaiKENvy1K7G01b7MTVcqnoZ4hj0kd0Iguft9vowKGsk7YO9iU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXyzBIdsjXC7omI_hC_UXtNVngZugFmjfry1D3cR-ZDSw&oe=6B103B84"}, {"file_name": "a4.png", "id": "1012939483219453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1012939486552786_4821246281568995178_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGsHfgyviOIQ7kNvwEBeTEn&_nc_oc=AdqtYbFvbsnYSEdK4uIdBxBWqIy7r7W0UXGegCV7x8jcCZPd2IzKL3fXb1pKUztSU7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdwoaGToajbPjOon2sbyvjOJy9fpKCi1_r8LXy4JbPLQ&oe=6B103D03"}, {"file_name": "a3.png", "id": "1437082900412152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_1437082903745485_3664678695243093240_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sT3W2b1bhqsQ7kNvwFQp5os&_nc_oc=AdqBemaHpXDTbuwyfCOEtpyncxdAnQnvSdBAS7EdL091Uo4YqX-fWX1nmLxH-95bscM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEjJfDAtgoJcgfkcsJQKxeKbvs15fZR_-vdJys-fEtNA&oe=6B103DC3"}, {"file_name": "a5.png", "id": "1342971789624478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982505_1342971792957811_6709759533051903104_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeENqujkLQsQ7kNvwEBG7Rg&_nc_oc=Adrsa8oO1f2QWlFAoL0mOlCZgNhVmsNx91sRWhdKX7nNhNeulmtDiuRyYPIbauzkAcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjiDPXH59J8TRG_MYkT34BLPYHEUiSoQRsszbwurJRPg&oe=6B1046AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "599088686063676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_599088689397009_8050319103537501749_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZXy9N4uE14Q7kNvwGp-J_Y&_nc_oc=AdpQ0J92hq5_G07NhQVP-ndJ8uFaZSr-SEL6TFYXmJ8dNgG1Bkn_5a5N7kRAaCE2XAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVicyQSACNCYzq_riVU2TdzFombH9pSyCj4xCP2KLmFOA&oe=6B1036CE"}, "display_name": "Real Boxing", "keywords": [], "long_description": "Step into the ring with VR Boxing Showdown and experience the most immersive boxing game ever created. Face off against four legendary opponents with stunning, lifelike visuals: the charismatic MCGeorge, the lightning-fast Mayweather, the powerful Wildor, and the tenacious Ortiz. Each opponent offers a unique challenge that will test your skills and determination.\n\nWhether you're a beginner or a seasoned fighter, VR Boxing Showdown has the right level for you. Choose from three difficulty settings\u2014Easy, Medium, and Hard\u2014and tailor your experience to match your skill level. As you progress, the competition intensifies, pushing you to refine your technique and strategy.\n\nThe thrill of victory in VR Boxing Showdown is unparalleled. After defeating your opponents, you'll be awarded a prestigious championship belt, symbolizing your triumph. Celebrate your victory with raucous applause and a spectacular display of background fireworks, making every win a moment to remember.\n\nPrepare to be captivated by the urge to play just one more round in this endlessly engaging VR boxing experience. VR Boxing Showdown is not just a game; it's a journey to becoming a champion.", "short_description": "Real Boxing provides a fantastic in-stadium experience with excellent images. You'll undoubtedly get shivers from the continuous AI audience applause. to give the encounter a more authentic feel."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.theadsflow.com/realmetaboxing.html", "developer_terms_of_service_url": null, "publisher_name": "AdsFlow Technologies", "support_website_url": null, "website_url": "http://theadsflow.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "co
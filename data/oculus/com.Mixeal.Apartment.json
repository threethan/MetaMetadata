png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRFtKpGfvMQQ7kNvwEd-Ylo&_nc_oc=AdmFQ7iW3HErp7B8E1-8v_iLvR3KsPpsH0Pgk0jvTPoE8S1YQYW6dOiUYduErc0QVcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvT09WJwOMZIFdKxl0E0qV3kMZoWmWcetgWCHIYb_pFFw&oe=69A570FD"}, "display_name": "Mixeal Apartment", "keywords": [], "long_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button.\n\nThere are few technologies as immersive as VR, which can digitally put you in the shoes of a person walking around a building/home. While it may seem like an expensive investment, it helps your business in the long run. You don't need to stage or show properties in person as much if you have VR tech ready to go.\n\nThis demo showcases the potential of VR for Archviz and Real Estate industry and an example of work we provide at Mixeal.", "short_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal-apartment.flycricket.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "http://www.mixeal.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [],
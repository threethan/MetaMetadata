&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPu5cka3naQQ7kNvwH_BLGy&_nc_oc=AdpubTSqbSSzmC9ifKJ67_XnLeA4XSAQZwSg-45S2NzZe4HLZjfz8a35uRoUqveU-qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRM-t512ICm7snOLYcGD5iyPmfr9Hr_zvJu_8k-p3NXqQ&oe=6B0DBCCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "576613263726293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031395_576613267059626_4126064381610460160_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkOChIDnSz8Q7kNvwHlG-CL&_nc_oc=AdrVFUWV8gCA0zxC-MUCako1BtBNmW5Ri5aC3wzkwBdGgyr1D1LrpjMsgcOb6M6Fltk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQYXu9hhETh6pV_jG_4h0EmW_9NNkmPMR1kQ1gXDY68XQ&oe=6B0DCAFD"}, "display_name": "Mixeal Apartment", "keywords": [], "long_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button.\n\nThere are few technologies as immersive as VR, which can digitally put you in the shoes of a person walking around a building/home. While it may seem like an expensive investment, it helps your business in the long run. You don't need to stage or show properties in person as much if you have VR tech ready to go.\n\nThis demo showcases the potential of VR for Archviz and Real Estate industry and an example of work we provide at Mixeal.", "short_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal-apartment.flycricket.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "http://www.mixeal.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
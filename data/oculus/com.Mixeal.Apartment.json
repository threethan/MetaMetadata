&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA-Gq5AMqx0Q7kNvwFLoYxj&_nc_oc=AdqzJgZPFPVNK_QsUs96hlKm5TLqCIqNzD5OLYAKKQBtnxm8qNMfFkD3WRVKihNpb7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUKxfg99QYnI3_E8PiZZc-Bd6AD0j3kqZaU9cVVe7DkQ&oe=6AFDB28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "576613263726293", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031395_576613267059626_4126064381610460160_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrfXcKbe5-EQ7kNvwH-9zlu&_nc_oc=AdpHIvHWgjgKJ4Ez3E58FF667llQr8He79Vs8bjRL9NE19veq_wdWYqRt96jbt9niKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf_ettmCq0RhXh7CgcAo1HDfnALU5guP1k9FJMcRNVRQ&oe=6AFDC0BD"}, "display_name": "Mixeal Apartment", "keywords": [], "long_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button.\n\nThere are few technologies as immersive as VR, which can digitally put you in the shoes of a person walking around a building/home. While it may seem like an expensive investment, it helps your business in the long run. You don't need to stage or show properties in person as much if you have VR tech ready to go.\n\nThis demo showcases the potential of VR for Archviz and Real Estate industry and an example of work we provide at Mixeal.", "short_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal-apartment.flycricket.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "http://www.mixeal.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
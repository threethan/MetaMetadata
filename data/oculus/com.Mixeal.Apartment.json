&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MaM9o7JnJkQ7kNvwEq4yCY&_nc_oc=Ado1NrCb6L7rVrxdiFn5oDqFE1iAb1_0Co7gvjpYUuPod4j8oaSAJOIB1ohtyz8zlNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvY42sySQIKcrIEgsL21CnydU_XZk89qmsixHrfD1s7A&oe=6B05D3CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "576613263726293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031395_576613267059626_4126064381610460160_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GCkB6l5NzIQ7kNvwF894dS&_nc_oc=Ado9HcgCpXHW2Dut_DrZUWI2VbNhSGl48vU4n4EzZWKuI7hkpRhFEzH1SWUJdvmEiJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3BhoS-P8gJ7hCADpUTWIVDuSgBaDX7zE4rodkMeW2hw&oe=6B05A9BD"}, "display_name": "Mixeal Apartment", "keywords": [], "long_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button.\n\nThere are few technologies as immersive as VR, which can digitally put you in the shoes of a person walking around a building/home. While it may seem like an expensive investment, it helps your business in the long run. You don't need to stage or show properties in person as much if you have VR tech ready to go.\n\nThis demo showcases the potential of VR for Archviz and Real Estate industry and an example of work we provide at Mixeal.", "short_description": "Explore a double story apartment where you have the ability to change the design style to either contemporary, Georgian or Mediterranean with a click of a button!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mixeal-apartment.flycricket.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Mixeal", "support_website_url": null, "website_url": "http://www.mixeal.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873
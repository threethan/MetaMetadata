A"}, {"file_name": "com.oculus.vrshell-20250908-115117.png", "id": "1109020841199173", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819473_1109020844532506_6061756646041302208_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjEFjYuOy1QQ7kNvwFKpO4e&_nc_oc=AdrtkAr98FBDlzEcfk7OdsryB5hbv4kTSWsm-VoFvEE_rnNr_qBC85ZolY_WB9pfVKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0oRhnIONpqxsljim1Ir3AdJm4ktda_VcpE5PiBW76VA&oe=6B09C9AD"}, {"file_name": "com.oculus.vrshell-20250908-114952.png", "id": "1325293998939572", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499314643_1325294002272905_1741532084690396752_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HSlHJuo6loQ7kNvwHr0lrB&_nc_oc=AdoFtRbIiDWp3zxn7YtXWJWfOTsMR1VXAcjotF7sTG8ItC3h1lfV87hDziud-_Siq2U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvN6YcSpgkCa3omBnh0QbsIAxZU3ZGZsIQUmXnj3unQ&oe=6B09A3A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Sitter", "keywords": ["medvr", "vr", "patient", "sitter", "medical"], "long_description": "Patient Sitter is an immersive VR training simulation focused on patient observation, safety, and care monitoring. In this application, learners engage with realistic scenarios where they practice maintaining patient safety, identifying potential risks, and responding to patient needs in a timely manner. The simulation emphasizes critical soft skills such as attention to detail, communication, and decision-making, which are essential in clinical practice. Designed for medical students, nursing trainees, and healthcare professionals, Patient Sitter offers a safe, controlled environment to build awareness and confidence in patient care responsibilities. By bridging theory and practice, this VR tool enhances training effectiveness and prepares learners to handle real-world patient monitoring with greater competence.", "short_description": "Patient Sitter is a VR simulation designed to train healthcare professionals in patient observation and safety monitoring. The app provides realistic scenarios where users learn to identify risks, respond to patient needs, and ensure a safe care environment. Ideal for medical students, nurses, and caregivers, this immersive experience builds awareness, confidence, and essential patient-safety skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24614337048185852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491822800_741443842054627_8446678945726735209_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znpqGg9TdcAQ7kNvwEl_0d5&_nc_oc=Adog0x6jbVOttK_R7PMaX4vC-6GEAIu412pJ0wLtA_0XE34f3I_bauOA1x7JKm4Sa-Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsjXPDR3Exui7VrlgJHZK9RHRcbSu1DFwOC7_4a36zYQ&oe=6B09CC3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Patient Sitter", "platform": "ANDROID_6DOF", "context_categor
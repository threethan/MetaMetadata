", "id": "24157835060554808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824203_24157835063888141_6925101410682090484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiKhENGP6i0Q7kNvwFp5U06&_nc_oc=AdlOFW-cvx75sKKAiSHe4Q488gjSNw2MBiAunGpOtfe-D8dmko7cr2IauJrCN6G-6Ow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKODsylWPA3ia6Ok3RTSSXwZUEccwyEyFh12CHZLOc7g&oe=699DB2CA"}, {"file_name": "com.oculus.vrshell-20250908-115117.png", "id": "1109020841199173", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819473_1109020844532506_6061756646041302208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY8yyAFy1c0Q7kNvwHuXalB&_nc_oc=Adn9fhuOmEMJ4_sauO-eC2grUSz6iLcrTr3_nlexO61W_ScbEYdkt1FyCnHuzpWRd3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv87_qiiOkH2SXpD_jYr17thXNIFx-lOxxMzPE9ixSmgA&oe=699DB36D"}, {"file_name": "com.oculus.vrshell-20250908-114952.png", "id": "1325293998939572", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314643_1325294002272905_1741532084690396752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZwTjOu58lgQ7kNvwH6z1wD&_nc_oc=AdlS2dm_b_l9ZbH5xhlqOMxRkpD-hs9LRy8L4fF5JfeKT1gtKayA6xAZ0c0rU1XDdA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs_Lp8YT1T7Ql5fpIbzXN7A3m1SswrvyHpJkH_j1CYTbQ&oe=699D8D65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Sitter", "keywords": ["medvr", "vr", "patient", "sitter", "medical"], "long_description": "Patient Sitter is an immersive VR training simulation focused on patient observation, safety, and care monitoring. In this application, learners engage with realistic scenarios where they practice maintaining patient safety, identifying potential risks, and responding to patient needs in a timely manner. The simulation emphasizes critical soft skills such as attention to detail, communication, and decision-making, which are essential in clinical practice. Designed for medical students, nursing trainees, and healthcare professionals, Patient Sitter offers a safe, controlled environment to build awareness and confidence in patient care responsibilities. By bridging theory and practice, this VR tool enhances training effectiveness and prepares learners to handle real-world patient monitoring with greater competence.", "short_description": "Patient Sitter is a VR simulation designed to train healthcare professionals in patient observation and safety monitoring. The app provides realistic scenarios where users learn to identify risks, respond to patient needs, and ensure a safe care environment. Ideal for medical students, nurses, and caregivers, this immersive experience builds awareness, confidence, and essential patient-safety skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24614337048185852"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822800_741443842054627_8446678945726735209_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4WL2ItpHMwQ7kNvwGcM-lk&_nc_oc=AdnlVRNfFv9s4O15jnw9Gkty0PzVf6er2Gu6PSaLbzJ-cNfka5KI
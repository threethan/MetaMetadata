l-20250908-115132.png", "id": "797270276147214", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820566_797270279480547_465225718338829070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s3yIs6oeSQQ7kNvwETrf-G&_nc_oc=AdpvTE34f_Y-BJF4L_Vd2-reeKjEDboioXzVl7E6vmUtsK_FJeJlSfw1xquAp7cWgKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qOtEbr7kwHYYGYueCJ913uMmA2MUixtL3f3F36Wv9vQ&oe=69E4E4E4"}, {"file_name": "com.oculus.vrshell-20250908-115029.png", "id": "24157835060554808", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824203_24157835063888141_6925101410682090484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MqTZ3Wp7T4Q7kNvwGdp5x4&_nc_oc=AdoXBO3ny7Uraw-9nHtkhXRYzqxWCH7rK2Q63J_J-1hjgZXU0_bGA8HxofC5EwjJ3Wg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QQvOMel01CE5CLJ3fAxrHYGd2w146CjvGSE3tSwsBzw&oe=69E4E3CA"}, {"file_name": "com.oculus.vrshell-20250908-115117.png", "id": "1109020841199173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819473_1109020844532506_6061756646041302208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bsmn4Zo_A4YQ7kNvwFpb4Cl&_nc_oc=AdoxkNN3RKTsT9kGhXvujTvSGQTpnKxZykRW2yoexJA9CowLEUkVihDxd1tPlQT7qhI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qKo9ExhbaGI5s7Rc9h_wTZrKF6pOJkm6FcRiPXc6hmA&oe=69E4E46D"}, {"file_name": "com.oculus.vrshell-20250908-114952.png", "id": "1325293998939572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314643_1325294002272905_1741532084690396752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PrIp_HXEfIQ7kNvwF-GMb1&_nc_oc=Adr3iRoCF1YOuSCPHQl0N47hatDpU5opyx1vkOmPyl8KuikK2gLchnbxSH8o-6jU2SA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wx_oTU58HBT4uk2bURv_7RjiY1UsRmn_eAV_FCOMpXQ&oe=69E4BE65"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Sitter", "keywords": ["medvr", "vr", "patient", "sitter", "medical"], "long_description": "Patient Sitter is an immersive VR training simulation focused on patient observation, safety, and care monitoring. In this application, learners engage with realistic scenarios where they practice maintaining patient safety, identifying potential risks, and responding to patient needs in a timely manner. The simulation emphasizes critical soft skills such as attention to detail, communication, and decision-making, which are essential in clinical practice. Designed for medical students, nursing trainees, and healthcare professionals, Patient Sitter offers a safe, controlled environment to build awareness and confidence in patient care responsibilities. By bridging theory and practice, this VR tool enhances training effectiveness and prepares learners to handle real-world patient monitoring with greater competence.", "short_description": "Patient Sitter is a VR simulation designed to train healthcare professionals in patient observation and safety monitoring. The app provides realistic scenarios where users learn to identify risks, respond to patient needs, and ensure a safe care environment. Ideal for medical students, nurses, and caregivers, this immersive experience builds awareness, confidence, and essential patient-safety skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
l-20250908-115132.png", "id": "797270276147214", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820566_797270279480547_465225718338829070_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rPFYwEzQNQQ7kNvwEjNBel&_nc_oc=Ado2oCECey8248VhLek69KU9qKohKEan6RAAK2Pep-5bfvPR8SaIdDcG9POPFT_f1Is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b09O9V4lV2IOP7lLJoQcLn0vCefehPG_rbfQ9mlTU_A&oe=69E0F064"}, {"file_name": "com.oculus.vrshell-20250908-115029.png", "id": "24157835060554808", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824203_24157835063888141_6925101410682090484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb-9bR87i2sQ7kNvwETuI9-&_nc_oc=AdqQGM9Tfnfa6FCd2Dx6FtlMDL6TQb6VXr51JYmXIUmqqGhbXocwSaxAgd-37ESKEsU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1moAVZaAHbyHYBwEQCaZyWXyoXJFfP7NNOfhU6HBU9nA&oe=69E0EF4A"}, {"file_name": "com.oculus.vrshell-20250908-115117.png", "id": "1109020841199173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819473_1109020844532506_6061756646041302208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZNuHW2MSGwQ7kNvwEXlmot&_nc_oc=AdrTk3CVkmvx-wKCRh3LjJXgRXmAZe3B7JQr2QYh2v1er-PlB9zuAJ-dMsS8NBUbuPY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B1RigQVxXdY9Cmy0DIqSqpm81FpYjWDTxM1u0any3QA&oe=69E0EFED"}, {"file_name": "com.oculus.vrshell-20250908-114952.png", "id": "1325293998939572", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_1325294002272905_1741532084690396752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-19FI3QiMpAQ7kNvwHbN0kP&_nc_oc=AdpX5lybhFjYnXuyoRFveDgJsuAJ8pT7dGJGu0OLPRaJVNt1q8Bfz3cILsYt2XpIz8A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OPUqH2ikm2xo4MFnQjKHfFLaBiNnkX4Jc58HHwS3B9A&oe=69E0C9E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Sitter", "keywords": ["medvr", "vr", "patient", "sitter", "medical"], "long_description": "Patient Sitter is an immersive VR training simulation focused on patient observation, safety, and care monitoring. In this application, learners engage with realistic scenarios where they practice maintaining patient safety, identifying potential risks, and responding to patient needs in a timely manner. The simulation emphasizes critical soft skills such as attention to detail, communication, and decision-making, which are essential in clinical practice. Designed for medical students, nursing trainees, and healthcare professionals, Patient Sitter offers a safe, controlled environment to build awareness and confidence in patient care responsibilities. By bridging theory and practice, this VR tool enhances training effectiveness and prepares learners to handle real-world patient monitoring with greater competence.", "short_description": "Patient Sitter is a VR simulation designed to train healthcare professionals in patient observation and safety monitoring. The app provides realistic scenarios where users learn to identify risks, respond to patient needs, and ensure a safe care environment. Ideal for medical students, nurses, and caregivers, this immersive experience builds awareness, confidence, and essential patient-safety skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
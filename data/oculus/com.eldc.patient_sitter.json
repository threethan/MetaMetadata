0_Af9AcfpTm0VJ141p-pigZ1Q3fxRbaKVhpUq9GR665OlfQg&oe=6A3A9664"}, {"file_name": "com.oculus.vrshell-20250908-115029.png", "id": "24157835060554808", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_24157835063888141_6925101410682090484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c1S9liJzcwQ7kNvwErAYcM&_nc_oc=AdqniowbyTwQQbEExEm_8VxvtmRVy1AnyKSYlXY7qv-CmK0kK9DmBHx3cQsZUvPULgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Qj6duDIfaflM0SBySqGkBwxu3cVCL4j0MzGtY-LrUJg&oe=6A3A954A"}, {"file_name": "com.oculus.vrshell-20250908-115117.png", "id": "1109020841199173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819473_1109020844532506_6061756646041302208_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwDFhjHUVVcQ7kNvwG193l1&_nc_oc=AdpC--0hJcXPTpUZ-uID7AMJAmDXPeFaKGG0UZWqcPlzilUen3LyvXkd7Zz_2KpfBAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95Ae29HKvKRSO73vlnLbQIcTJ6Fx6UJGHoQzrWePnJog&oe=6A3A95ED"}, {"file_name": "com.oculus.vrshell-20250908-114952.png", "id": "1325293998939572", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314643_1325294002272905_1741532084690396752_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMMmuPjtz6oQ7kNvwE-Tx49&_nc_oc=Adoat_C9YDLlywzetRA6IMXQYjtCnDwo105B7P3FXJb_0KHuPyLdXImIfjjhqGWF-zA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9pKRFVWPX-1mdcViqFL21qbmE9Om2tegkN5fTtQ10hg&oe=6A3AA825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Sitter", "keywords": ["medvr", "vr", "patient", "sitter", "medical"], "long_description": "Patient Sitter is an immersive VR training simulation focused on patient observation, safety, and care monitoring. In this application, learners engage with realistic scenarios where they practice maintaining patient safety, identifying potential risks, and responding to patient needs in a timely manner. The simulation emphasizes critical soft skills such as attention to detail, communication, and decision-making, which are essential in clinical practice. Designed for medical students, nursing trainees, and healthcare professionals, Patient Sitter offers a safe, controlled environment to build awareness and confidence in patient care responsibilities. By bridging theory and practice, this VR tool enhances training effectiveness and prepares learners to handle real-world patient monitoring with greater competence.", "short_description": "Patient Sitter is a VR simulation designed to train healthcare professionals in patient observation and safety monitoring. The app provides realistic scenarios where users learn to identify risks, respond to patient needs, and ensure a safe care environment. Ideal for medical students, nurses, and caregivers, this immersive experience builds awareness, confidence, and essential patient-safety skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24614337048185852"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1471214830789156"}]}, "baseline_offer": {"id": "1471214830789156"}, "is_app
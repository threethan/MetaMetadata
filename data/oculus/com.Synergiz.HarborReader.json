Gdr8UTXYfyS2lCbQ&oe=6A6766D5"}, {"file_name": "screenshot03.png", "id": "678744611759271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818876_678744615092604_6463317622794927132_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQW-gVWWI_gQ7kNvwF5GpbW&_nc_oc=AdpKaNo01Mtj5z3KpPvIC9gpPDVRzME3p4OqCcTNui6ICEUhBz0bLp_lVqSQ_vbTC20&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1o8J39SpOL4vePHvVKOoWPBhBPCoPduCYWWz6KDrgzw&oe=6A675011"}, {"file_name": "screenshot04.png", "id": "562311586909111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819349_562311590242444_2667854444132631345_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmxTr3IUnk4Q7kNvwFyQAWI&_nc_oc=Adpm362XMBL23B01bA27TslpJIPMZEGG3vWZNjoigpGRZe6F18d7jo3qcOPEdOWWPhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZaZBukom7x1hjhte77zA9jhDDpCSdiLrtkY2Urrm11g&oe=6A674E38"}, {"file_name": "screenshot07.png", "id": "1776486566600785", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821657_1776486569934118_267836418216047418_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkWFbj3qZPIQ7kNvwF2sGyZ&_nc_oc=AdqU9Su-KyiYq8tUBYUOr7bxht5FN9gxGbnQpzmq3fM_gdlDDCnN2WSo2IPHDjjlw5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsCFDo4gA0YF6bvVVS-vrvBXH_HyIH_A6rBvvigJ98nA&oe=6A67774F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover_metaStore 1.png", "id": "1634968870521038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824618_1634968873854371_576791669114623649_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCPxOLkA6zwQ7kNvwH7M-gp&_nc_oc=AdqV_KsqTtKBwJnzFL6FVH0u9ZbotmjjP1k9yfntV8IK5Fn88x1VBevT3IHgn_cyUn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6kcKqNiyz6VfSKADfDGzD1LWUPJQhwS8LaFvw2PplIA&oe=6A677279"}, "display_name": "Harbor Reader", "keywords": ["Synergiz", "R\u00e9alit\u00e9", "Mixte", "Augment\u00e9e", "Harbor"], "long_description": "Harbor Reader \u2013 L\u2019app la plus simple pour exp\u00e9rimenter vos contenus immersifs !\nHarbor Reader est une application XR intuitive, con\u00e7ue pour tous les utilisateurs, sans comp\u00e9tences techniques particuli\u00e8res. Il suffit d\u2019enfiler votre casque, d\u2019ouvrir l\u2019application, et de plonger instantan\u00e9ment dans l\u2019exp\u00e9rience immersive.\nPens\u00e9e pour les profils non techniques, Harbor Reader offre une interface fluide et intuitive, qui ne n\u00e9cessite aucune formation. Que vous souhaitiez lancer une seule exp\u00e9rience 3D ou d\u00e9ployer du contenu \u00e0 grande \u00e9chelle dans votre organisation, tout devient simple et rapide.\nAdapt\u00e9e aux besoins des entreprises comme de l\u2019\u00e9ducation, Harbor Reader est une plateforme puissante qui permet de g\u00e9rer, s\u00e9curiser et diffuser du contenu immersif \u00e0 grande \u00e9chelle. Elle prend en charge une grande vari\u00e9t\u00e9 de cas d\u2019usage, notamment :\n\u2022 Formation professionnelle\n\u2022 Visualisation de donn\u00e9es complexes\n\u2022 Pr\u00e9sentation de produits\n\u2022 Visites augment\u00e9es\n\u2022 Design d\u2019int\u00e9rieur et architecture\n\u2022 Et bien plus encore\nFonctionnalit\u00e9s cl\u00e9s :\n\u2022 Visualisation fluide d\u2019\u00e9l\u00e9ments 3D et de contenus multim\u00e9dias, int\u00e9gr\u00e9s directement dans l\u2019environnement r\u00e9el de l\u2019utilisateur\n\u2022 Exp\u00e9riences interactives pens\u00e9es pour renforcer l\u2019engagement et la m\u00e9morisation des informations\nPour toute question ou demande commerciale, contactez notre \u00e9quipe \u00e0 l\u2019adresse suivante : contact@welcometoharbor.io", "short_description": "Harbor Reader est la version d\u2019Harbor la plus simple pour acc\u00e9der \u00e0 des exp\u00e9riences immersives. Aucun param\u00e9trage, aucune complexit\u00e9 : mettez votre casque, ouvrez l\u2019application, et plongez dans l\u2019univers XR.\nCon\u00e7ue pour des utilisateurs non techniques, Harbor Reader rend la R\u00e9alit\u00e9 Mixte et la R\u00e9alit\u00e9 Virtuelle accessibles \u00e0 tous gr\u00e2ce \u00e0 une interface fluide et intuitive, sans besoin de formation.\nLa solution id\u00e9ale pour d\u00e9ployer du contenu XR \u00e0 grande \u00e9chelle, facilement et efficacement."}, {"images": {"nodes": [{"file_name": "miniLandscape_1080x360px.png", "id": "9491000647649629", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820625_9491000654316295_2409258008242048585_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnVQhP0g1CYQ7kNvwEHi44G&_nc_oc=Ado7kU9rmqwrQifhRZ51bbUrGYo0UcqWiQDp8wKUWckV4IgUQJk2e1oq_JmC7IT2H8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWsVSIZ8o4hGTtYMwVrEMszyExvok1nMMdehwYt7AXyQ&oe=6A6750AD"}, {"file_name": "icon_512x512px.png", "id": "1696636420951864", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824507_1696636424285197_6632252401445725919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thOvWE3lMMMQ7kNvwG1lWlf&_nc_oc=Adq-wjxDBAzaww49LREYRPeAAimLFXqnDkIBaDhWzlpLJA_78tRpCLoQ3Cl2Y25xtFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0T60HO81a5SYXpgOa87bsoeNoA2MeWiVLoczPy1foQA&oe=6A674708"}, {"file_name": "logo_9000x1440px.png", "id": "1625598154762126", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823447_1625598158095459_553315110069549271_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGnrZLxo8h8Q7kNvwF8iTxb&_nc_oc=Adobb8xru5GtjFqTBNXKXicfZVltF4d9yHiGxr-K_Fi9FTsoApjxFNtUAVg9cXYU1IY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ6ek_QWr4WC-VxSgJKoZqSc9aTBAkIeGEya4Iu_isHw&oe=6A675679"}, {"file_name": "coverLandscape_2560x1440px.png", "id": "1199956614869461", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827133_1199956618202794_6555976
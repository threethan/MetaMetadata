kt_zQ&oe=6A67636D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover_metaStore 1.png", "id": "1789369431920280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824188_1789369435253613_7172951094541486876_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5fLSfc9XAoQ7kNvwHPxDrA&_nc_oc=AdrsstyD-7-3iYHQ2GPUNj2aEDhx9yfMynNJGgBKOGaxW5ssafHqbYrpoPYHUhpUAsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtL7bgNi6PqYMIaJ6sACROqVnKPwdJO0uFRLxqnzTrMA&oe=6A675629"}, "display_name": "Harbor Reader", "keywords": ["Synergiz", "Reality", "Mixed", "Augmented", "Harbor"], "long_description": "Harbor Reader \u2013 The easiest way to access immersive XR content, in just one click.\nHarbor Reader is a user-friendly XR app designed for everyone, and no specific technical skills required. Simply put on your headset, open the app, and instantly explore immersive experiences.\nBuilt for non-technical users, Harbor Reader offers a smooth and intuitive interface that requires zero training. Whether you're launching a single 3D experience or rolling out content across an organization, Harbor Reader makes it effortless.\nIdeal for enterprise and educational needs, Harbor Reader is a powerful platform that lets you manage, secure, and deploy immersive content at scale. It supports a wide range of use cases, including:\nCorporate training\nComplex data visualization\nProduct showcases\nAugmented tours\nInterior and architectural design\nAnd much more\nKey features:\nSeamlessly visualize 3D elements and multimedia, integrated directly into the user\u2019s environment\nEmpower users with essential interactive features for deeper engagement and better knowledge retention\nFor more information or business inquiries, contact our sales team at contact@welcometoharbor.io", "short_description": "Harbor Reader \u2013 The simple XR app for everyone to experience immersive content in just one click.\n\nHarbor Reader is the simplest way to launch and explore immersive experiences. No setup, no complexity, just put on your headset, open the app, and dive in.\nDesigned for non-technical users, Harbor Reader makes XR accessible to all, offering a smooth and intuitive experience that requires zero training.\n\nThe ideal solution to deploy XR content at scale, easily and efficiently."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.synergiz.com/en/gdpr/", "developer_terms_of_service_url": null, "publisher_name": "Synergiz", "support_website_url": "https://www.synergiz.com/en/synergiz-support/", "website_url": "https://www.welcometoharbor.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9652803154814292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827058_964572455875042_5068611679669048777_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfMxuqjF6GUQ7kNvwE_FUTQ&_nc_oc=AdpyVVKQA-sKglEy7768Hm9AK8I9g7SZ_adgNwXY-9Pksrkn3QO61QtS9_AXto-5_e0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsnxy0W5MOuGZfTRxinKobtm1lTlUoF4KSLypgfQctUg&oe=6A676125"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Harbor Reader", "platform": "ANDROID_6DOF", "context_category": {"context_category"
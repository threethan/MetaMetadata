8y1ncqlvU4NonAGKlcQZyg&oe=6AE48ACE"}, {"file_name": "12533893_1868211036810456_1413905441456390144_n.png", "id": "283953866563712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_283953869897045_3790473181351733818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFgNlryHXOYQ7kNvwGCryc-&_nc_oc=Adoy8oHGfYcGHaSUOM6TMFKEdpVQ7ukqGT-gcrBtkJ3WZjR-lB-m_d9w3Cknds4oszw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeGOeoaMR7WS7Aflg5SUCj-5nLvhA-6Hpz14aNtz8V_Q&oe=6AE4BE29"}, {"file_name": "12410280_2092372077716159_929760415565479936_n.png", "id": "4363577010425172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_4363577017091838_5914970981483448679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLi_l7E9lTMQ7kNvwEwSEJI&_nc_oc=AdoRPRsgoGwnysRWjv9Hdbs88f9gSTobhGSqnfqwHqvrCbtvhV27YY3IHmRGKYIREBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTUoCJDkuFgfOgOxMo7G3q5tSjBPq9NsMovNFXVstdbA&oe=6AE4A440"}, {"file_name": "12331069_160468287993322_5972463010785001472_n.png", "id": "438337284255288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001713_438337290921954_707755681439087945_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oT-PkT7VSKwQ7kNvwEwgR_J&_nc_oc=AdonalHD2xnaERnPAsyI_kYlDETqOlBg1JLtO_306kaf8xDMTX8Iiip9OcArxawp9rU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOroac-E-m073vXmqqlRNugsh2PHhIRDfhu7P2jGmOrmw&oe=6AE4A08C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12410440_161187991252513_7573761693591797760_n.png", "id": "443504130284780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_443504133618113_6202141701920609476_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Grv04Vkh4eYQ7kNvwG_hmmt&_nc_oc=Adqw17Hx90FkEGTq1-4YM35CeSjpBc51s5cQqYwDcoNeA13-6K5qU-bY1zGZcwwvIeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBDNSAwk_o03goBY_nfRlRZjcQdErJGB_j-c8lcJAIUQ&oe=6AE4BD5B"}, "display_name": "TrainerVR", "keywords": [], "long_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive the trains inside your creations!\n\nHave you ever feel the despair of running out of tracks just when the fun was sparkling?\nHave you ever dreamed about a huge train network connecting towns, going  up and down, intersecting and looping?\nIf you liked building with your own bare hands, you\u2019ll feel the same in our limitless VR world and see your dreams come true.\n\nBut this is not only about the destination; it's also about the journey. Enjoy building your structures, growing more complex, while fighting against Newton\u2019s laws.\n\nOnce the job is done you can place as many trains as you want and ensure everyone\u2019s safety avoiding crashes acting like a profesional train traffic controller.\n\nOnce you go track you can't go back. Come aboard!", "short_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive trains inside your creations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/trainervr/eula.html", "developer_terms_of_service_url": "https://sumalab.com/trainervr/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://sumalab.com/#work_trainervr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
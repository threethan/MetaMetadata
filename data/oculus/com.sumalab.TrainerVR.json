QqZjMR_wiuKhR44cf7cDaw&oe=6A747B4E"}, {"file_name": "12533893_1868211036810456_1413905441456390144_n.png", "id": "283953866563712", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031316_283953869897045_3790473181351733818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oJ-f1MIN5IQ7kNvwFxiB20&_nc_oc=AdoZ8LVAPu1CScny_n3eVs3v7DbyY9ajE6rJzmwwWJldk8uPvsH8d7YQawAbz7rOoV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAGRIEMckeRQuq1XtDRgICnkx3JlFb5mJc_2oPpjEaVQ&oe=6A747669"}, {"file_name": "12410280_2092372077716159_929760415565479936_n.png", "id": "4363577010425172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031326_4363577017091838_5914970981483448679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD6MC8PU3DoQ7kNvwEeZTlb&_nc_oc=AdrOQwwncSr7jK9M0TQFA1jfMgeGSKSx5K7eEVcOD3GQxbgQDvC23ehXAUh7wmDBG3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5SP2bt2YeYDSjdTIpXgxIYG74fUXTHUqiBqs80nOMhQ&oe=6A7494C0"}, {"file_name": "12331069_160468287993322_5972463010785001472_n.png", "id": "438337284255288", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001713_438337290921954_707755681439087945_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FjdueOQczUQ7kNvwH7gdgN&_nc_oc=AdqBFCRQF-Cla-y_ZzrvdBlb7bmcWSEQYpD3Rqyyw9VJdTXl3GdimOSFdaeHBLohTbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtSlQra2WCPjCD7JsIXYAsqCbuW_9X1ituqx6XlxPUcQ&oe=6A74910C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12410440_161187991252513_7573761693591797760_n.png", "id": "443504130284780", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_443504133618113_6202141701920609476_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbbgJIB9NIEQ7kNvwGCAlkq&_nc_oc=AdoAE0z_ZqYTnbUBzXP4qziOxgC646ckWvnQxts2oujZnnzvQagTaW9b1g1o4USa3KI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2ichKqoF6aUKQz3N3uTwG9ByrfKmi4241iU2N9lih0w&oe=6A74759B"}, "display_name": "TrainerVR", "keywords": [], "long_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive the trains inside your creations!\n\nHave you ever feel the despair of running out of tracks just when the fun was sparkling?\nHave you ever dreamed about a huge train network connecting towns, going  up and down, intersecting and looping?\nIf you liked building with your own bare hands, you\u2019ll feel the same in our limitless VR world and see your dreams come true.\n\nBut this is not only about the destination; it's also about the journey. Enjoy building your structures, growing more complex, while fighting against Newton\u2019s laws.\n\nOnce the job is done you can place as many trains as you want and ensure everyone\u2019s safety avoiding crashes acting like a profesional train traffic controller.\n\nOnce you go track you can't go back. Come aboard!", "short_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive trains inside your creations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/trainervr/eula.html", "developer_terms_of_service_url": "https://sumalab.com/trainervr/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://sumalab.com/#work_trainervr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomme
no&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsptC_k_uQ7w_eHrs-0LSzx1MNJxczzzWyt0sf3lBqM5A&oe=699C4069"}, {"file_name": "12410280_2092372077716159_929760415565479936_n.png", "id": "4363577010425172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_4363577017091838_5914970981483448679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOyDnswjm5UQ7kNvwECQoi8&_nc_oc=Adn26ifBhY-y0FIQ2OVKCfcd50aQ_cihV0Hcf37p3LE1mNAvRx4LXqBioNY2G8RPLeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvz0JBWRjqRkO10DYT2gD0w-l0FBu0qK5V2j_ifwNxmwg&oe=699C5EC0"}, {"file_name": "12331069_160468287993322_5972463010785001472_n.png", "id": "438337284255288", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001713_438337290921954_707755681439087945_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3l7SxEz8-8Q7kNvwGxBDou&_nc_oc=Adk6b3PQQcAUiR_IpfkFIJmTZcjxiOTdxxbthF1XdXrLqA5WeIzgnn7RFucNkNdBqio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftL5OfwnFF_67v8OBavqMLg-rIWu4XujyUzlyRBTGlG_w&oe=699C5B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12410440_161187991252513_7573761693591797760_n.png", "id": "443504130284780", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982708_443504133618113_6202141701920609476_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQVPT6m0r3kQ7kNvwGTeWRX&_nc_oc=Adllly76xkRR4GhLxZP2eaElPQwytvsQEj1KW7lgEZ0XcQ2TSfuZRvjUPkVbXm-V-Q0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftie0wEjrmi8A0qIancfzO4wJCzQeNjb1STkEQMw0QUMg&oe=699C3F9B"}, "display_name": "TrainerVR", "keywords": [], "long_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive the trains inside your creations!\n\nHave you ever feel the despair of running out of tracks just when the fun was sparkling?\nHave you ever dreamed about a huge train network connecting towns, going  up and down, intersecting and looping?\nIf you liked building with your own bare hands, you\u2019ll feel the same in our limitless VR world and see your dreams come true.\n\nBut this is not only about the destination; it's also about the journey. Enjoy building your structures, growing more complex, while fighting against Newton\u2019s laws.\n\nOnce the job is done you can place as many trains as you want and ensure everyone\u2019s safety avoiding crashes acting like a profesional train traffic controller.\n\nOnce you go track you can't go back. Come aboard!", "short_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive trains inside your creations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/trainervr/eula.html", "developer_terms_of_service_url": "https://sumalab.com/trainervr/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://sumalab.com/#work_trainervr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1207629852978572"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "87611033
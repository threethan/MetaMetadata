Nb2rPXHBR5gzPMFZuwEoQ&oe=69C9184E"}, {"file_name": "12533893_1868211036810456_1413905441456390144_n.png", "id": "283953866563712", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031316_283953869897045_3790473181351733818_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EudXA5YmIUoQ7kNvwHpNASo&_nc_oc=Adq4UyXBgx5mVa04PC5f-p7ngh4RmZI4qG6w-YJ9B8NzXW5w3lcqLo6WYaZEAFlf8G4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcS4E8enUkgM6KOqs0iO4odN-asyk8SXi6pse78WmFRw&oe=69C91369"}, {"file_name": "12410280_2092372077716159_929760415565479936_n.png", "id": "4363577010425172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_4363577017091838_5914970981483448679_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcFp8f5akXkQ7kNvwHIzCIy&_nc_oc=Ado6rsTUIBe2XNYzzdRs-mx2CG-J2V4dqklssIdh9kAVRpnU0Zl1QlVfZXf46yqXYks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxr6ey0oSl12ugyVu7XMnGWUWF7Qig7PFemDC7WVZ9nbg&oe=69C931C0"}, {"file_name": "12331069_160468287993322_5972463010785001472_n.png", "id": "438337284255288", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001713_438337290921954_707755681439087945_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQBqQ87E8msQ7kNvwFfpKx3&_nc_oc=AdozBtKV_VvY1R4VvYtE4EiQjwnbdOHuqx-G1fQM0Zu4JyRcXPS9IPG1qQTUlJHbv5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQX8EpCp83sVty9tATEuTz8Tiw2fECUgxU1CxxOZOLeA&oe=69C92E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12410440_161187991252513_7573761693591797760_n.png", "id": "443504130284780", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_443504133618113_6202141701920609476_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67vUbIcbaqUQ7kNvwE7NSQD&_nc_oc=Adr2fisXdR4fDciks9yi3kaLZJJK1F_ZZOsxYjlTZpLlgH0m2ieMJOTjBpOqOMUrmO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO58trP3Ale_qhef5wXP9YvaW3MwaJFjYXxqLpAaBlTQ&oe=69C9129B"}, "display_name": "TrainerVR", "keywords": [], "long_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive the trains inside your creations!\n\nHave you ever feel the despair of running out of tracks just when the fun was sparkling?\nHave you ever dreamed about a huge train network connecting towns, going  up and down, intersecting and looping?\nIf you liked building with your own bare hands, you\u2019ll feel the same in our limitless VR world and see your dreams come true.\n\nBut this is not only about the destination; it's also about the journey. Enjoy building your structures, growing more complex, while fighting against Newton\u2019s laws.\n\nOnce the job is done you can place as many trains as you want and ensure everyone\u2019s safety avoiding crashes acting like a profesional train traffic controller.\n\nOnce you go track you can't go back. Come aboard!", "short_description": "TrainerVR is a unique physics-based VR train construction game.\nIn TrainerVR you can create from simple tracks to an elaborate rail network, just like the wooden piece game, but to the infinity and beyond, and drive trains inside your creations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/trainervr/eula.html", "developer_terms_of_service_url": "https://sumalab.com/trainervr/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://sumalab.com/#work_trainervr", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
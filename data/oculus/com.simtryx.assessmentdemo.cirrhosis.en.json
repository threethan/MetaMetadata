24857382221306_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5U0IVMT0usQ7kNvwEdjmGo&_nc_oc=Adr8mUuS4wIEGOmH6uG-Vo17BKrr4jbJCTcFKw4Y0LYtDXLizJ8LsvwVqUvM4DEUa3g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjPe63XYpKyYklPKxdWsaAHvrmvNbygwslppyWz9GIcg&oe=6AFB4ABC"}, {"file_name": "38974771_914663160423989_8412528913888708301_n.png", "id": "1471442040147115", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003240_1471442043480448_4137664387287025678_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uItlcUiT7AQQ7kNvwFIC1B2&_nc_oc=Adq12S_AHcHyqj94qwMJmKY1TlvCBHJuWKYUIDoluNEV8e18v0tHn4qryOU-XIF4kV4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFpr2woAzWlrTQa5yTyhi1RVozqX-M68d3vvULAHVhjg&oe=6AFB16D6"}, {"file_name": "57568678_442736708598857_2601426099645306453_n.png", "id": "1585260168698302", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569443_1585260175364968_5377620633503669556_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcu1clJB5bIQ7kNvwHH1h2p&_nc_oc=AdrSLjyQL1JYjlrDPi7Be-dNwLbdb5LQxct7B-t_YgHwEIosHqBgy2gdzI9CJVd7a-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBsw4WnGnNFibe2noSS8wxn7GxWpxvK3a-nxL6IQUsqw&oe=6AFB41F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simtryx", "keywords": [], "long_description": "**Experience the next step in virtual simulations for healthcare**\n\nTalk, observe, and interact with your patient to diagnose them correctly inside the most immersive and accessible simulation for VR headsets.\n\nImmerse yourself with our powerful main features:\n\n- **AI-powered speech simulation**: Talk freely with the patient to learn more about their history, habits, and to empathize with them.\n- **Advanced hand tracking**: Built from the ground up with hand tracking in mind, every object in the world has a physical presence, and your virtual hands won't phase through.\n- **Seamless onboarding**: Through video passthrough, bring 3D elements into your physical space and jump into the simulation in the most comfortable way.\n\nWith our focus on accessibility, ease of use, and immersion, Simtryx delivers the new standard of healthcare simulations for the next generation of headsets.", "short_description": "Experience the next step in virtual simulations for healthcare"}]}, "developer_name": null, "developer_privacy_policy_url": "https://simtryx.notion.site/Simtryx-Privacy-Policy-a5977ffc191d4a22a4bca6330d8d855a", "developer_terms_of_service_url": null, "publisher_name": "Simtryx", "support_website_url": null, "website_url": "https://www.simtryx.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es_PE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7801311536570570"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1398570188250779"}, {"status": "PUBLISHED", "id": "1674801420021678"}]}, "baseline_offer": {"id": "1398570188250779"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772042880, "status": "PUBLISHED", "id": "1398570188250779"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28976591085282641", "version": "1.4.29.s1094"}, "id": "1002083254599925", "channel_name": "LIVE"}]},
857382221306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKJvFp9_sE8Q7kNvwF4B2s4&_nc_oc=AdnIBYGBEtPY5CCy7I8IxEfvHaNeVfqzQoPSd5rXnjgNiFA--p6yIT_IK6S_JT34q8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvyxlpj6Fbmv_WeVBwQy49p5mP-0EqLIj-ieWOwRUvcnA&oe=699C637C"}, {"file_name": "38974771_914663160423989_8412528913888708301_n.png", "id": "1471442040147115", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003240_1471442043480448_4137664387287025678_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1uSK-4uELIQ7kNvwHCu1dT&_nc_oc=Adk0tAg5UGM1g8OJo_gnMPOMCBAi4aQdvQqyUUyp0yL3UANINBGPH-K4Ga9RSRU9USo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvjp0O_ei2yednM60xVbsFBqmQZSPqbSMdtK5ze6X7cyg&oe=699C67D6"}, {"file_name": "57568678_442736708598857_2601426099645306453_n.png", "id": "1585260168698302", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569443_1585260175364968_5377620633503669556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4ezJST-kGwQ7kNvwFdJ1K1&_nc_oc=Adnm2hJNLEMqlsnEPvADh2uzIS6glSRpz_es65sYspCuUrc429PfhuZXN9UBvV-VAAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3mxG3xV-floKZxw1RNO9iqlFshwWneRTwEzyc96iZxQ&oe=699C5AB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simtryx", "keywords": [], "long_description": "**Experience the next step in virtual simulations for healthcare**\n\nTalk, observe, and interact with your patient to diagnose them correctly inside the most immersive and accessible simulation for VR headsets.\n\nImmerse yourself with our powerful main features:\n\n- **AI-powered speech simulation**: Talk freely with the patient to learn more about their history, habits, and to empathize with them.\n- **Advanced hand tracking**: Built from the ground up with hand tracking in mind, every object in the world has a physical presence, and your virtual hands won't phase through.\n- **Seamless onboarding**: Through video passthrough, bring 3D elements into your physical space and jump into the simulation in the most comfortable way.\n\nWith our focus on accessibility, ease of use, and immersion, Simtryx delivers the new standard of healthcare simulations for the next generation of headsets.", "short_description": "Experience the next step in virtual simulations for healthcare"}]}, "developer_name": null, "developer_privacy_policy_url": "https://simtryx.notion.site/Simtryx-Privacy-Policy-a5977ffc191d4a22a4bca6330d8d855a", "developer_terms_of_service_url": null, "publisher_name": "Simtryx", "support_website_url": null, "website_url": "https://www.simtryx.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es_PE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7801311536570570"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1674801420021678"}]}, "baseline_offer": {"id": "1674801420021678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1721918234, "status": "PUBLISHED", "id": "1674801420021678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25754853914123057", "version": "0.23.27.s776"}, "id": "1002083254599925", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
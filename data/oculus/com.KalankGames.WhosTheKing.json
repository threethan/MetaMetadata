scdn.com&_nc_ss=7f20f&oh=00_Af6gYDKw0ugEWOyM7ZDv4pTJNCl2caBPzX6G_XN7vR5sYg&oe=6A09E1EE"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDbwUm7zJfAQ7kNvwFz0gvQ&_nc_oc=AdpIFtXDeKIA8hcQGYj0w_3HsNcsBoTaakorVZyeohMlIGC35qymBg6k85RhmVYkA6I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pY_FvHvtBeNu45Pz_9PpGCSjavaHjjL0RIPGcfrCRVA&oe=6A09DAE7"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFnZtnmXxcEQ7kNvwGc9Lnz&_nc_oc=AdqT64b3F5KHF33PSQ5O7sF9eJ8uOp3PoVg7aBZkXlx56IHtMHEzALHOa-R9DNKoVTE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pnzyTp13IRW0ksYqn5jh60xE36sIrfGLtf2HAgqEC4w&oe=6A09B055"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mcJZPfThJcQ7kNvwGirqUY&_nc_oc=AdrbOm-vF-ds4KtgD_kPJvm2nRyya__D4zb0f3O16uEAtnEEYm_zUukmrLKR95eO6iw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UxlxgN6Pk6Np-C-GNhzuXYKs60s6f5bXwGZjx-2FbZA&oe=6A09D69B"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igJpi39GdAgQ7kNvwGfVLg5&_nc_oc=AdoXhbaLKjiwqRgyKlaOflXcc6ifgjOsGVDFf-Lll4TuZp34U-uR6FjcW4xec5uzaCY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sm5SHETkcFphXIYG0EJ82_zwXL7fqbwX6qzFEJe81wQ&oe=6A09E2B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": [], "long_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne!\nGrab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n\ud83d\udee1\ufe0f Protect your people\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n\u2696\ufe0f Judge. Decide. Execute.\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n\ud83d\udd25 Avoid the Revolution!\nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_
scdn.com&_nc_ss=7f20f&oh=00_Af6Q0BW2DjId2n_3j9tv_uhVOUmdpIokBbdeyvVOOza-VQ&oe=6A0F27EE"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lZNUrexbrMQ7kNvwERKpUB&_nc_oc=AdowLCE3gd-eke0RBKnL1iaHq7Auvv_x2DY8_dqOIHmtAS0gUjCP9VKMq65apatBlF4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OpjG9ZmniCXjQL6L42A0IyWzOlV19-PQsrVU2KML7xQ&oe=6A0F20E7"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lPDDB5tD70Q7kNvwFvQ30N&_nc_oc=Adqemsemo3ZjhfBZGbSPCj4-dnrL3rxn0jU2ut8EYZVu8bI0T5dpV7aR0-E8H2gqf-w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af564V2O9iNpIMEJbwPsN9S95OVF9wjd9n_VE_YxoISdyA&oe=6A0EF655"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9uJjyaWROMQ7kNvwF1NBXu&_nc_oc=AdpA8FTDLFVqYC71zIJtNE53kYKrPgSdlS3rnZsZrEGmXCYzJHB3SN3WhtHnjawu-aY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b6fwBwnFZP7TMHSdzqQ7NEU-SYT9QoqIl8ynALU0FbQ&oe=6A0F1C9B"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1Hl4mG9vPAQ7kNvwG3zfGf&_nc_oc=AdorPFGOc3bCzrPTO73ysKd0dQ5J6nifzQylCLCe6kVrhWGPUIaoxpEItKHW7dUjekw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O1lZ8HSVFmqIc355T8izUbJWM27LIkGyU6KvmXwH8eA&oe=6A0F28B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": [], "long_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne!\nGrab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n\ud83d\udee1\ufe0f Protect your people\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n\u2696\ufe0f Judge. Decide. Execute.\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n\ud83d\udd25 Avoid the Revolution!\nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_
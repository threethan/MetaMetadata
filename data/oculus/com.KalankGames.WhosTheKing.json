ent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyseKJ-xVy4ljJp6G71vnweqJD-5oIKXQNHQXI3opKqFQ&oe=69BC1056"}]}, "id": "2239329459808267", "locale": "en_US", "screenshots": [{"file_name": "Still 2.png", "id": "1613740816300459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823270_1613740819633792_7534861503693310936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQXvHQmVb18Q7kNvwGzMHG5&_nc_oc=AdnEi4D-N_qaa5k4BZTksn3s4OtXBBN-B834zVa746QXj6UHrIL5OMuh4vkch60e7Vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzd6nDtIClaEX7dpUgIwiODCLBTWHeUDUtBzRU792W_ug&oe=69BBE12E"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_oAW5N9E8UQ7kNvwHZLR-K&_nc_oc=AdmP0jG30qEdmjDJWknLm_wQLfWbuCsKy_jppIKH8ctt-XAS3dWEch13LSxmQ1Z9tzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUo6WpYP2fVnmdBQZerpLojpm6EAquTKng5lN-AZlJfg&oe=69BBDA27"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6bSOnUIi-MQ7kNvwFFR_PY&_nc_oc=AdksZ5cTA5ur0lnZdDD-BwUd0wgcWfloQUeeO6XD2exA0VCGi8rkHSLfmfm-mNd_97E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEQkHCFs32G_LPYIJoSX1TahhwuQx3Q-ksaUiwUzz_sQ&oe=69BBE7D5"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5VMBSWcQr0Q7kNvwF8mBx8&_nc_oc=Adn-laolIDLJZixReOBU83Znjg9rYPjFedUWBFQUqznKNZP6rnpnRDUaGjEzSmT2p_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5URk3N9zeiMCfN4s9kJPgtHaPeZUlyXn1A6FdkebxTA&oe=69BC0E1B"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5Ywb5G6BUYQ7kNvwF3BrXF&_nc_oc=AdkIZovRId04-RLkKDRbFyewV5OeB7ovFyVd089JOHyCr-dnL-kf1nFeRKMa2AHiFHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3mgCCZb4iUEIcPI_OuJweF0AYvZLgL_8aBvK1tt7-CA&oe=69BBE1F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": ["king", "simulator", "sandbox", "survival", "medieval"], "long_description": "# \ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne, grab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n# \ud83d\udee1\ufe0f Protect your people\ud83d\udee1\ufe0f\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n# \u2696\ufe0f Judge. Decide. Execute. \u2696\ufe0f\n\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n# \ud83e\ude77 \ud83d\udc51 Choose your Queen!  \ud83d\udc51 \ud83e\ude77\n\nRuling alone is boring, why not make one of your visitors your queen? Give her items, maybe she'll react differently!\n\n{1247756353992587}\n\n# \ud83d\udd25 Avoid the Revolution! \ud83d\udd25 \nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/whos-the-king-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26149362984683029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820441_1008061319063074_6142364316204512152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYlLrDTz
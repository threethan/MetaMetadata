uozHeG1kV6meKwBKvQiU5SqAsofq7LKCarHFghYZ_w&oe=6AFDC76E"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAW9kSOIGhYQ7kNvwEs3FuI&_nc_oc=Adp7-O2BcM_AR1lDo5AbU_yk0gH5DuBgLdSmHFCUHVWWeSKuVbgE-cTB6cLYt0XdzaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFgL4TOEI59xNcwoEEzoX6j4bkj5OLK9yZf0HLKTfsKQ&oe=6AFDC067"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_hLE8MhdTcQ7kNvwEjeq6q&_nc_oc=AdorD7TZF3FHYhKFV22lA0lPzET6tWfCZ-sreBFn0F7ypVKnxOGGcXeuh-1-3iQBHac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP4I_U6Thz4ZOpP5WyNzUnAOifizcPyj_wPs6fWihw3A&oe=6AFDCE15"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYpnDeavgFYQ7kNvwG9RyrY&_nc_oc=Adqw3qq5d-dERHq_frQzLux2RlbgPrh4ku3XbyZ1prNPD-Aj_MrvXTN_co4-lGNDuSE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVUDuqxGq57rY0Cq4taGGSD7hMiA0krmpcgYYvkA5IDQ&oe=6AFDBC1B"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iiqz2vxkbjYQ7kNvwErfe4k&_nc_oc=AdraB_Le_dTUsEv4B1J-Ygh2tsZ_aMoMCxJfgWKdIEyNiseveuhq7gfi65wKSzACi6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUO3dFvBpsubqtz5FBVqdeA3CxTRZLGZM9sjQXqj2XXw&oe=6AFDC836"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": [], "long_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne!\nGrab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n\ud83d\udee1\ufe0f Protect your people\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n\u2696\ufe0f Judge. Decide. Execute.\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n\ud83d\udd25 Avoid the Revolution!\nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/whos-the-king-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023103350642337"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1882774026432882"}, {"status": "PUBLISHED", "id": "1142146321568941"}, {"status": "PUBLISHED", "id": "1068550589131796"}, {"status": "PUBLISHED", "id": "1698492964595720"}, {"status": "PUBLISHED", "id": "1766098751406144"}, {"status": "PUBLISHED", "id": "1986059005381110"}, {"status": "CANCELLED", "id": "2225194238218584"}, {"status": "CANCELLED", "id": "1481583339560197"}, {"status": "PUBLISHED", "id": "1440680343849820"}, {"status": "PUBLISHED", "id": "1280461693546696"}, {"status": "PUBLISHED", "id": "1614622852908869"}, {"status": "PUBLISHED", "id": "807640992361939"}]}, "baseline_offer": {"id": "1882774026432882"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791444360, "status": "PUBLISHED", "id": "1882774026432882"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28436990822586889", 
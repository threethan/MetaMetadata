ent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhX0fQPj_CHOs527jMGIOhymsF1h_ctDBklWPMLzYung&oe=69C11E16"}]}, "id": "2239329459808267", "locale": "en_US", "screenshots": [{"file_name": "Still 2.png", "id": "1613740816300459", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823270_1613740819633792_7534861503693310936_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWudLuQGhQ4Q7kNvwEZELH8&_nc_oc=AdpeEjtAA6C5uvMlUz8p28cWj_xqt6zO6acjj1gmcYCXr5eC5jnkIY-PakavIcAhruo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjWFrIvaV7g18sgtdOFnslB_i4vLom92irclN4zguVWA&oe=69C1272E"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaFObyRlLA4Q7kNvwGhLKk5&_nc_oc=AdrwxW6N84jYv6Hmg1OKr7jDsNWbr5LrzxUGsmQ7uzgemvbqIftdoVQJI58LSwOCPRg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKTm8-kgiibcmfTDJQAK8adCnjxDzEA3dQvzQN-9lOyg&oe=69C12027"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De3watSodYsQ7kNvwFLdzKW&_nc_oc=AdpscMTHE_zQSbH3Y348wv_xvbHgc69E4UBSKHiUslXnT79WNELz3m358eQ4zgvxszc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwr1-M3DshPJUFg617tNLAwLKj_0YvsHNp3fMFrpj6TBQ&oe=69C12DD5"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQSCo1oJzNgQ7kNvwFPwHd5&_nc_oc=AdoqrwsjUKzrnfiNvZI-PLsjDRkxnurCATHOEMOaTgpLoXpFwuNvOBlfFAGIXg7QBxg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqNxctx3ZZnEQFSKSI7C9LQRLKVSFXu1yxmDkdCaN4cw&oe=69C11BDB"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyTcDJAEjqkQ7kNvwGQP2PI&_nc_oc=Adre87kunTRUX8PrEuWYdG4BN0RSjOhCUueserX2bkrOjIoKQtmL-kGgwMmgM5W8Vew&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiOi0GLLu0MgxqQxBcT1-N6JsFmAYP68god9vGOijq5g&oe=69C127F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": ["king", "simulator", "sandbox", "survival", "medieval"], "long_description": "# \ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne, grab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n# \ud83d\udee1\ufe0f Protect your people\ud83d\udee1\ufe0f\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n# \u2696\ufe0f Judge. Decide. Execute. \u2696\ufe0f\n\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n# \ud83e\ude77 \ud83d\udc51 Choose your Queen!  \ud83d\udc51 \ud83e\ude77\n\nRuling alone is boring, why not make one of your visitors your queen? Give her items, maybe she'll react differently!\n\n{1247756353992587}\n\n# \ud83d\udd25 Avoid the Revolution! \ud83d\udd25 \nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/whos-the-king-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26149362984683029"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_1008061319063074_6142364316204512152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGjBVe-F
-E8JxhWCyRIXkYygz0sW7hcPzMAgVppbhuONv6FAvw&oe=6B01BBEE"}, {"file_name": "still 3.png", "id": "2364781913960894", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820558_2364781917294227_6286268374579906745_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3NlERPuCr0Q7kNvwFF8iZq&_nc_oc=AdpcRQcKvV4TgLLkqu2OYx_KPiiRvsirQkAd6tvA3xZTumMHHExiw1dSlkY6690t6vI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRndJpKHZ_lJMOgoVBg1YIPFtT7jrej2V_vmyp3ejvwww&oe=6B01ED27"}, {"file_name": "still 5.png", "id": "1516202909487617", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1516202912820950_1194796726858880456_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lq11_zG6DMQ7kNvwH_nby7&_nc_oc=AdrwpOEVxAHcSruCB0McBbAumO6qJURHGvz49udDqhN9ijPd8Tb2SLao8goE0uYLmaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQu9EgM3vL1MBFcvkBHh81DX71yXMfI4wv4u93PF1gNrQ&oe=6B01C295"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1rrtPVkWFsQ7kNvwGBnCk9&_nc_oc=AdqJsvR_Ekdo9uHwEoBPI2jglLcPUydP7sN7d-Ot1Jq_Ck_vl2Vr4NWm01ZREMFeYl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjzblGEhxWEM6VicsG_8Kbd_AQ-rwN4dqxheo60QIJ2A&oe=6B01E8DB"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7i8kkRWzKAQ7kNvwFUsCL8&_nc_oc=AdpbGynbEszCtfjhk34XkR3d_llTkcGvoXEM8hUfccIAvJKRnQZ1YJFMdPi612bxCHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReXwaFBcKqqTjn3n8ClDLGrYWrWP4O7zZIp3axz_UnsQ&oe=6B01BCB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Who's the King?!", "keywords": [], "long_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\n\n\ud83e\ude91 Sit on the throne!\nGrab your sword \u2694\ufe0f, keep your eyes wide open \ud83d\udc40, and decide who gets to enter your kingdom. Every visitor matters\u2026 and every mistake could cost you your crown \ud83d\udc51\ud83d\udca5.\n\n{1615794056264358}\n\n\ud83d\udee1\ufe0f Protect your people\nPlagues \ud83e\udd12, criminals \ud83d\udd75\ufe0f\u200d\u2642\ufe0f, traitors \ud83d\ude2c - danger is everywhere. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\uddea, and stop threats before they spread like wildfire \ud83d\udd25.\n\n{2230833630778102}\n\n\u2696\ufe0f Judge. Decide. Execute.\nSearch suspects \ud83e\uddf3, treat the wounded \ud83e\ude79, cut off gangrened limbs \ud83e\ude93, throw criminals into the dungeon \ud83c\udff0\u2026\nAnd if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n\ud83d\udd25 Avoid the Revolution!\nThe people are angry \ud83d\ude21. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long \ud83e\udea7\ud83d\udd25.\n\n{1386775932368428}\n\n\ud83c\udfad Cartoon chaos, twisted realism\nA colorful, unhinged cartoon world \ud83e\udd2a where power goes straight to your head. Absurd situations, dark humor, and impossible choices \u2014 just like Scan or Scam, but with a crown \ud83d\udc51.\n\nRule wisely\u2026 or lose everything.\nSo tell us - Who\u2019s the King? \ud83d\udc40\ud83d\udc51", "short_description": "\ud83d\udc51 WHO\u2019S THE KING \ud83d\udc51\nSit on the throne \ud83e\ude91, grab your sword \u2694\ufe0f, and judge who enters your kingdom. Inspect newcomers \ud83d\udd0d, heal the sick \ud83e\udd12, jail criminals \ud83c\udff0\u2026 or cut off heads if needed \ud83d\ude08\u2696\ufe0f. Keep the people happy \ud83d\ude21 or face a revolution \ud83d\udd25. A cartoon, chaotic, twisted power fantasy \u2014 in the wild spirit of Scan or Scam."}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/whos-the-king-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25023103350642337"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1882774026432882"}, {"status": "PUBLISHED", "id": "1142146321568941"}, {"status": "PUBLISHED", "id": "1068550589131796"}, {"status": "PUBLISHED", "id": "1698492964595720"}, {"status": "PUBLISHED", "id": "1766098751406144"}, {"status": "PUBLISHED", "id": "1986059005381110"}, {"status": "CANCELLED", "id": "2225194238218584"}, {"status": "CANCELLED", "id": "1481583339560197"}, {"status": "PUBLISHED", "id": "1440680343849820"}, {"status": "PUBLISHED", "id": "1280461693546696"}, {"status": "PUBLISHED", "id": "1614622852908869"}, {"status": "PUBLISHED", "id": "807640992361939"}]}, "baseline_offer": {"id": "1882774026432882"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791444360, "status": "PUBLISHED", "id": "1882774026432882"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28436990822586889", 
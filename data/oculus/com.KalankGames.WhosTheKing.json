L6yPAI0GoRcpQQV2Lf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFw2sX-lO5Dq3Sh10kl1wmaDjinAnoGU-BmTaF26OEmA&oe=6AF5CE18"}, {"file_name": "still 6.png", "id": "1415620343253395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819375_1415620346586728_7294806654877176970_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csdv9apnMVcQ7kNvwEAZMoT&_nc_oc=Adr6EVu8_OrDpBJgwjSnmbc5yh07JoinmN-WjvwP_tVczcd1P1ip0lUMC7qmr24l8_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzBrzi4KLiE4n90hMF3sGeaX8bqRVnmeyp4s-YwtZhRQ&oe=6AF5D31B"}, {"file_name": "still 1.png", "id": "1765534908166923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_1765534911500256_4266532870211439759_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7N03I860zYQ7kNvwEkAt6B&_nc_oc=Adpk15Sam-KKcdqA0hTPmpFIcUxvDtFtYnRtjoZgXoC3ImWM83C2dQQvaatu1qjUCTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdPB7zRW-E0D7vp9LZot_x_WK-tFJGJ4V5ymGuJUOGIg&oe=6AF5DF36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WTK_LandscapeKeyart.png", "id": "1132956412660642", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673819499_1132956415993975_1054784912952177821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjP5DRBTFtQQ7kNvwFxLuvM&_nc_oc=AdqP0qc6YHpSEUwBWQuKKqyBHkb9fJLYf1r_k3NPf5YCNDdY_HeqcfQTeVxShodQswM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_t2mZaAESaWP2sYrkTVM6xhNZ7aXR-R0oayDGnd0fnA&oe=6AF5D2C7"}, "display_name": "Who's the King?! - Dragon Update", "keywords": ["king", "simulator", "sandbox", "survival", "medieval"], "long_description": "# \ud83d\udc32\ud83d\udc09 NEW DRAGON UPDATE \ud83d\udc09\ud83d\udc32\n\nSurvive long enough and a merchant arrives with a mysterious egg. Set it on its pedestal, keep your kingdom standing, and watch it hatch into your very own dragon! Your new companion stays by your side for your whole reign, and yes, it can set your visitors on fire. \n\nSix dragons to discover. Collect them all.\n\n{1903965901012732}\n\n# \ud83d\udc51WHO'S THE KING ?? \ud83d\udc51\nTake the throne. Grab your sword. Keep your eyes open. Every visitor who walks into your hall is a decision, and every mistake could cost you your crown.\n\n{1128980472761253}\n                                         \n\n# \ud83d\udee1\ufe0f Protect your people\ud83d\udee1\ufe0f\n\nPlagues, criminals, traitors, danger is everywhere. Inspect newcomers, heal the sick, and stop threats before they spread like wildfire. \ud83d\udd75\ufe0f\u200d\u2642\ufe0f\n\n{1496286202200083}\n\n# \u2696\ufe0f Judge. Decide. Execute. \u2696\ufe0f\n\nSearch suspects, treat the wounded, cut off gangrened limbs, throw criminals into the dungeon\u2026 And if justice demands it? Off with their heads \ud83d\ude35\u200d\ud83d\udcab\u2694\ufe0f.\n\n{1271212228167016}\n\n\n# \ud83d\udd25 Avoid the Revolution! \ud83d\udd25 \nThe people are angry. Be fair, be smart, or be ruthless - but don\u2019t push them too far\u2026\nA bad king doesn\u2019t last long. \ud83d\udca5\n\n{1386775932368428}\n\n# \ud83e\ude77 Choose your Queen!  \ud83e\ude77\n\nRuling alone is boring, why not make one of your visitors your queen? Give her items, maybe she'll react differently!\n\n{1247756353992587}\n\n# \ud83d\udee0\ufe0f USE ALL NECESSARY TOOLS \ud83d\udee0\ufe0f\n\n{1918928978816754}\n{2592041227901346}\n\nRule wisely\u2026 or lose everything. So tell us, Who\u2019s the King? \ud83d\udc40\ud83d\udc51\n ", "short_description": "\ud83d\udc51 WHO\u2019S THE KING?! \ud83d\udc51\nJudge every visitor, survive assassins, raise your own fire-breathing dragon, and try to keep your crown.\n\nNow with dragons.."}]}, "developer_name": "Kalank Games", "developer_privacy_policy_url": "https://www.arianestudios.com/whos-the-king-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "categor
3usCL9jZKMsj3oGcsC4niE1zcpSoppvZUBbJ2wXs7rGstCKt0XqdMm6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8ks6B_ziyAjNWDJEsi3FlRxsW1Uz6-zEyUESdd5RxBA&oe=69B2D218"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJqwhq5qAmIQ7kNvwE4Kt2y&_nc_oc=Adm7cIRcMxYir1p7ZJyKWx7R8WfGrEMPUNVLYZkvm09uOaHZNkBkunpJLDyrYFSEyVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzwMh8PWteDVcW5lzwxGsiJmT5kND91jFtvuXI88-LXug&oe=69B29E26"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-3RXNme7YYQ7kNvwF5Or3i&_nc_oc=AdmYb3JZ7aU7nfBO1OuGuM4PLTNkiZq3oyly9fJWbOtgepZm3wUHqsMV16KbweDz0gM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV8kIR-5-EG9WUXD3Ajra_m5ed7IVqV7R2-yVysLhy9A&oe=69B2B6F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16CVFta1j2UQ7kNvwGknr4_&_nc_oc=Adk7UK-byTC15tFjXK0Nz0kQfNC3EcZ-JGk5JrFTAS84eHxO2b5n0fo1ZQXvQ33xzyM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTLWWYRB207EOYhvGUhf-_frwbiZpC5gOlzUhdTM_EaA&oe=69B2A9F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAg4O94VQf8Q7kNvwHcPs-9&_nc_oc=AdmQXsJNenMr5rWSGdUaHGLuelzBDYxDq6tlJb8S8lta2nWxQgn9-FvBz6uQgDS3QaQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_HZuydoSiTVTxricr4-OMPbk-l8C9NnSaxiJuQLjWd
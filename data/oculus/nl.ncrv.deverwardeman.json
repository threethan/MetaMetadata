0Q7kNvwHL8oIG&_nc_oc=AdoFkCv_AcIydrxwsI2T5KEz8zmFx4Y3U67goQ7pCDu18ML7ls_SePU-uC_PT0DdJOA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iWAUeBH0vuuQin2fTbKAwq52_Wp-5JKiC1WxRQwI65g&oe=6A219018"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qC39MamVcVYQ7kNvwFYHFXg&_nc_oc=AdpKMmMyKDackpOmS5C2C8A7L-_LUCli0jtDCb3lybHpgjT25JGsvLj547N10xMwn7s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wWS1QywXYbDH9AeG7yh1vI3gAkUNhJLsTfv1QdflIyA&oe=6A219466"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_9MqQm46DIQ7kNvwFNYAds&_nc_oc=AdoADQcRAtEwSPeaRJZc7j7vcTJS0O5AXknIeI9mz6IDCQyblPt6sDEaSTCXyp0B-x8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EtdAr5aa0vz6-gvPonpURB1-I-j-aTRMJZCUB920BZg&oe=6A2174F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-WLW38jIC0Q7kNvwF903M-&_nc_oc=Adp8YfG3fqFwOKeFjIgqxv9p3ffkT-Js9rJm8_hYlkm0BNqwmFyQxM-gbsbcfF5XexQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DsiXQinalX8FbHmDEscLXLbEfViD54mjnyTWcp5Q3-Q&oe=6A21A031"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CufYGbaGSBQQ7kNvwEdpLmF&_nc_oc=AdpRqlQeaQwnOKseWyA3gAsQ2UdAa7OxNPcoaSm69D4xu4BWZIzlFOGTAapIslH3CIc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f
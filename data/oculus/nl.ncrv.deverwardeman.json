=scontent-ord5-3.oculuscdn.com&oh=00_Afs4QJ49IUbo2wan9_oHUZv_Rq1mbGLMOLemhCwoU7ViKQ&oe=69A41958"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eS1jaApcWXcQ7kNvwE60fhz&_nc_oc=Adl74yt-zT-JSeMNxGeU3T66ELJq_DXShRBMrMN6iY2VQp9OFCh4Xh7uNAowf3Ivzi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu3vvl1a9ZZIOIhe_5UGlMOwoHKNcF3fz-7Ogg63u0GPA&oe=69A41DA6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a8U15LIM6MQ7kNvwFEl8qN&_nc_oc=AdkriQcIgc5-iMspu0F3TgY7ge587ECIKeLKikmqmtn30WVaAL_rI6TUF6aWmozkHuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftIMsG9xJU3c6ISACr6GxO2PQNjO83YoVGT3-Auh0dVqw&oe=69A43671"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4JxxYRovDEQ7kNvwEbbIEk&_nc_oc=Adnka1LsxoLic8D9ci5q2xySBhcTzbOl1M8Ti-Oz6d76MT-ItPoIimzpwOxrRriZ-Jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft0u4ugvOH7SI7FcUXHdgJEcr2Fe8d49YNlhBT2_wtgkw&oe=69A42971"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCDzrel_NHgQ7kNvwFzD2Bq&_nc_oc=AdmKiWF0I3VllsateTcIcZ5p--2CnuZCnnm7L4AyMZoWbod25khhCnc1OPV1FcRhuow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftt8bdSgU4UorIZEqwkYJZZR7UYZRYn1KNfTTFdzQqZMQ&oe=69A438BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "De Verwarde M
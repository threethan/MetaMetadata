vWWc2TRU3e7UpqYGTQH8dR7j-548QFjk-l-00nwiw0Pkj8KZowfhjFcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUR6ZRSmaEh1cuoyIcfE5OL7Ok_GX2qDePyOoq9h3hhQ&oe=69AD53D8"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsKLh3UnK8IQ7kNvwEfYniQ&_nc_oc=Adn4vpimJDPSKOAgbMMNfAssBgml0-5_nPpBtfOln2gZNsJF3wfF9ezjLuN7UuQG6YM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx95jkunGPTVha-Iec9bxeGaZFpMoBbYyd7CU2KyHWbhQ&oe=69AD5826"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W04bEHoIy_gQ7kNvwG5ndBM&_nc_oc=AdmVQdadvLbCXPvYrqnDsGaL4Jw58L9OhuWRlAZuUR8EGD1Mk7HfWCXKMosLAHIlGvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzniSTb35m4VN5OmhpKlrtzEcnR9fevfJ5c09bX9OBXDA&oe=69AD70F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzgbZBSZcuoQ7kNvwEJTprA&_nc_oc=AdllgA_VOGRryPiSdRHaBvYDf8EhVoOFgRwepIEYQtrjwmRILJygIlfou5vXrLwyS3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFdFG03HwWFpBKdNqskWNXUGKOhvjhIlMSA9c81DT46Q&oe=69AD63F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pzdv_0NQDYQ7kNvwHaFqar&_nc_oc=AdkgPGnwGnKn4rCMb-Jtvihtr7bpqdNDYev7i_zWXfJh6Y6cMmz214x7ey-qP_7zNCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx64jBXrwM4fUVGNcFq7L5Lap4eFJ2hOBdr82zewnM6f
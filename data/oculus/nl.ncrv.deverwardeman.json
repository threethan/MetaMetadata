ZUrhEe70fZrBQPeVXUytRmWZghbn2_jCn100&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1AykGwIDSH9bF_AykSzHjfn3hnRWli6U6S5Acp12jt0w&oe=69F21A18"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAzCDc7sbQwQ7kNvwH2v_-7&_nc_oc=Adq89wz2C0Ygo6cYwu2I3GF--HJH4hwkTW8x89DGK6Gdd1qOHhW4IpO_o1DaujqTm2Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af09zMoaUzeiLS7Q5JjAjoSG7cui-57ITxtoYoxfQRNTWg&oe=69F1E626"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfmfSUALKX8Q7kNvwFeWgsb&_nc_oc=Adp0bV_smzmomFOsQOTGzhewGp0HgZuHFB4x0T_RxfGq-Uz36G26ygG7VpDyt6lqc0U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3S26So6bJ2MNcCeD6fUBRWZ723skNeR_GfJR3Jdrh-YQ&oe=69F1FEF1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcrMrSa1Il0Q7kNvwEOxZ1B&_nc_oc=Ado8WukpJDqVcB2aRfp8TMIjaHZW5iGtJfEWUH0CN8gmL8bPyqRaRG53FjwMYG62Qf0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af15ppPLEynrkQ7azG_3rCEpKrPBneC10Y9_J2hsf0uKMw&oe=69F1F1F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vduA0sgRWMQ7kNvwGDw9A_&_nc_oc=Adp1o3irTYC-cdsmeM5sPSXmICTACvLqmzGkFQp2ED9wJjBdo-UZL8OxmuSwN5hDVak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1IjKh7KIBEHjyFSJdnphir48vRrLo4Jrtf4v_L50Nr0w&oe=69F2013E"}, "is_concept": false, "is_test": false, "is_trial
uVjNvCMNSbagKRXF3OFGtSqBzftVE8vvGmnFJTO_z1Du_4FeTT6d7kK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzg7uhF-y4e6j-FNmpWHllMJh799ldH3yvLRF2e4lKkEA&oe=69BC0C98"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3CXkvbFSiUQ7kNvwEWV7fW&_nc_oc=AdkEiEn7-qk_WP3HCMnl5PjiZZ5082zwDeiyNosBBaJZvdk9ayPob59OHGPwEkGSW-Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkVl2gSYReUK0iMCaXXIxfUKehXlEfF8jDx7NvHFH9Pw&oe=69BBD8A6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9T7aN8R43AQ7kNvwGu27DD&_nc_oc=Adn9wC9yIdjB8ydqx_-lHW6Vb6dRi8-EBaBjpsIaPQYe--adrsGlahWyOKCCu4tWMQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-OxNlTtFWFTm1ipPaKtuG_qUuXsffusP1gvxXpfX3Iw&oe=69BBF171"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0B9LV5oXVwQ7kNvwFOF0WA&_nc_oc=AdkaEsYF3gwJ0lmZlqpPJcFQduYS47JWJP9bs6akjcb5kF9ynGiKTDRoglVLqq3WaEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhgjBo-m81C5wmPmIYkX806V22evtS7nHmypyKvEheKg&oe=69BBE471"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DxvPg5P1-QQ7kNvwFnTbno&_nc_oc=AdkisTSzKBCG0OckuHf50rppMM11g9wPRlsYi3Ng3ZvDLczNw4pn_NbSbuBg9M3CBcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3rRvlAkCa-0EVbdNjsq7754Ii9ANTfx1CY4TDYOliL
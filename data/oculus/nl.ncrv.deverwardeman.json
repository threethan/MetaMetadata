YQ7kNvwE1LF2S&_nc_oc=AdoyqnFnYHoyl-4tPRy9t41dZ5AQPDEAx0kXOGvX8BCPZKTgOwC3fHIr_IloQU-WdgY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_0tYW0BrlCyMEbwipMfuGPuSrqaNrnIrtVr24mgi97w&oe=6AD0E798"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZUQKvB8Ce0Q7kNvwFyoLQk&_nc_oc=AdrSUp7xDFiJ3xPnI9Vf41D0dsMO4AVNENRQzqw_rJtPA-jgXjrsivJheokUrPd7FW8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0NoL0VXRElYbqI4SX1dR4PaFs0ysySo5US19eNMYV_Q&oe=6AD0EBE6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdCylMkNNiYQ7kNvwEr1WII&_nc_oc=AdqD6dz8T-NmrFaeefh4osrxL7vtN-3OCE4uGZpyv4pYCYzgE8aXji9aqEAV7DWXwoE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0b5KJAnqMvDIKCLEAOtctKKdLJqGW5oF5T8F532uykw&oe=6AD104B1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjJqsFV7uZYQ7kNvwGTtMsh&_nc_oc=AdoAhp4Y7KU0l13l3gMvotykkWmjFbeY5tLtNOvFMoNRQxAnIH_uNzVckpsCRlBK9nk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeJIqmRzznu-SmTAkNyQrBWYlUWQlG-eSdk7xgiFNH3A&oe=6AD0F7B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRG1BXC_rfgQ7kNvwGggtw0&_nc_oc=AdoEP5sonQQ3lzTVOMib-SL83C5FFa3TflbGKebKssPSPOeOp8prAopRIzu2ucQ2yak&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f
IQ7kNvwGJyABn&_nc_oc=AdrO0kCPrSWInLD0jha6fmbrlHW-gm6-Y4jKFRKqqIW74vOKiCjENjLIJ9gst6zNVPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStbuXQhQS5_M8BmbDhhIesnpYvPctILW5L_-ya2yodcQ&oe=6AF8ACD8"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8BBzKJrtmEQ7kNvwGVtv4r&_nc_oc=Ado46LHhxbYOqoPGenALwWR5zp2vFdnOWWXrdYJNX8y6z8i2DWI_BQUHJJGfvOdPkKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPO3ozmcLHuZQIei4APUKK2cwj8MkyeJDZeBD7ECVanw&oe=6AF878E6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L934r3MvXeMQ7kNvwHord9V&_nc_oc=Ado85iSO2A4mHSkbztYh6eyGYWxZiljvzIF3xLTfyrebZ1p6gm5-83rgemFk_pzl6JQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeT_dO3eLpMSTV0sIm3id7bRHXuCz54f2cqe0yEyNiow&oe=6AF891B1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqc_SPfBSUoQ7kNvwFwHcQv&_nc_oc=AdohmYoBDm-EkRpdeWiQaHOU8rnrMFv4zrsGfpzuArZn02NF036dsRr1OejaisviNRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqNZ1VTf7aHKHR0fm80PeTYR2C-DlLY1knBPfgKXFwGw&oe=6AF884B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXhAbhxJcKkQ7kNvwFy3KYh&_nc_oc=Adqx_LI-ld1s6vU-hho0bVIbhqO8oKE9IJYeL-yJ_ewxgDtfgoZvJneM2-MpyDcExy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f
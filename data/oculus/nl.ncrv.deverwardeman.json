81gO4XNfM9Q-RUwyfS3zLGZIUr2x5omqbaa3J3nGuKokds--hPWQM234&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxAjszwe8nzeFSgzgxc2AlTsAAWMYZW5jJ-Bfkn7e9Qg&oe=69AFF6D8"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHEXvl9h-24Q7kNvwGb2Lvl&_nc_oc=Adk7rtNC-cwE5ZwbW5HJ-f9zn_4DSl7QLLx2ijK7lbi8sQaUWGxBPfWUfQY2HU1qkIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyONUv8y9tcA7S_P8yXIpGwGqEtcwOKwZP9K6LH9FFJ7Q&oe=69AFFB26"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ4bgV27p80Q7kNvwE4LM8S&_nc_oc=AdlO-ptyUw4mKzhVq45bDi3gP-LpLzwoX_QvGaF6IG48WcR0PqjIgsHc0bcvWflqeeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyvs94_SYmVERERvIYTd-JEiERM6oGqjRjQ30Qz0ZptPw&oe=69B013F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-XUO2wSOkkQ7kNvwFqbRob&_nc_oc=AdlKK1vNpr5-99f3KVI5A_Bxh2UlY7mwVRflcQbYfXPT8EeIECnBEqTHj7KvokJpIco&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdLnLsql-jmZaq-sg5Vg7-XLyzK9ZW000jJhg0LY5JLw&oe=69B006F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEKUCTy_mAsQ7kNvwHe7Lj_&_nc_oc=AdlgAqF48173VUfEe-446K8Q5PRpVrzdqiPer3hRQaJ7CcPdvQsz2o7xhVIGKi8Rc9A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP7_UDyPyPG1UtIJi2wDOAin35-uHeFWepEFnSPfObz
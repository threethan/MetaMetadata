8Q7kNvwEL0a-K&_nc_oc=Ado5I20xxExN66MOxFcNgvOx0OM5-S-xuWGe8U-3lNrbYIx2Vb6bbGlm3N6aE8ettT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PcaOEYwaPpZaPtc266uplbAid_yOgHvAMQ7hrX1bD9A&oe=6A15B298"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18_o9aoleekQ7kNvwEA4fBU&_nc_oc=Adq75I-2QgAiNr14PSyhClwVehwj-C_m9SObSAUk__Ny2VL4b3Xy9KRRyhddGVV1kds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kn2-rBeePU_zMwAcNnhdodWGtfaINKEkAUKuaytZWbg&oe=6A15B6E6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74doReZCmggQ7kNvwEkbyh3&_nc_oc=AdoKwP0YSyzh-XS2dVsEPGkir3Iguemu42N1Wrxj_pvZXkQLzIbMgy0bnEwCWD2rd1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48hOWRB4tNiKD_Sk2WXw8mUQFss9d27ZJowddaYsJW1g&oe=6A159771"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LalRd-_ABncQ7kNvwEOffQG&_nc_oc=AdqCyyxYdA1AaRdfQOY0mJaUcL10g6eZ4rYNVHHF_PE44rdqI5xawK5WXpP4ujoBcuM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WICRvzcyVNepLmKdnqHwJxlgBgrIy2TNd0jI6V3DRcw&oe=6A15C2B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5QUtAC-f2cQ7kNvwEt9rHw&_nc_oc=AdqwNrmyue7Yvtf_r6Wgq7YMMzv1k4MFLfv7DiSpM20ewZORfaLrDntR0_VYiadbVAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f
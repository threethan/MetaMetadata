0Q7kNvwHzZRnT&_nc_oc=AdpOdc9xDTqxgGt3ko-I0fcpow2PYHuTsG6b67v2-gW1rxJJ6eqJvZ_KbZiseudH70c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Dlrf4rjudpJB15VuBV1DSjsS9EDconw_crTIzP_LcYg&oe=69FA0318"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UF6-WTX7hwQ7kNvwGWC-us&_nc_oc=Adq5V9EFtdCSL63v4i-s85ECTuA5Oi385It2DSWYTeJZsoIkAT7yjUYa5RIr9cCgjR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ad3hT74vsIfeh9yqRZQENGRb4rvg62PMyMxwyWta5OA&oe=69FA0766"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNymE_1sALYQ7kNvwEwWL45&_nc_oc=Ado4_Wckaz0USwGkp9RICR8x8ityFu9lOCYvwvS0CnH6H6eZcVvouhJZV10RKWG8W-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6td-3NqWwBc_BWsYPXXvb3WbpRRymIsBAx26U5agCv8g&oe=69F9E7F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgeZ2PoDMYsQ7kNvwFHtL74&_nc_oc=AdpHx7rhX71YEEhxPcxzxnSrbO7Uij1RyvYJ_Z6KEyjjpc9TsHG4alSwRsGmnDIKc0k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CYKAwyDpiyLhi80z6oc60DDHlyXpky0YhK6eTAVJ_0g&oe=69F9DAF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XMa3_8BNVcQ7kNvwGKOJCF&_nc_oc=Adr9jtoGSjCgeu8p-pwtaJOyGznBngeWEMeAtww_3uAUY1CDIVDixkLHgpIm4PKZyWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f
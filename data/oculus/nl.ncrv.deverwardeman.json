xBQ6sl6xB8uN2DRssz-hEPA4LV8Gioc4HlJFcbkrUCLkoY00Y9Pxn5I8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXn6rACdwOvamLgVk8IQadRwW_VoMSkabQw8-QBlq2gA&oe=69C11A58"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrmS0bbkOOYQ7kNvwG4dUKI&_nc_oc=Ado0IsBf0ev92Zi2HJej6AWN1k-JQI0f2fmkos0AvUeHNDDhR8MFgoJkg8ffJyc0cwc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXleEjOLiwY30OsZSGBPqtKcBWvy87KHDQ-L6ddVnojg&oe=69C11EA6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5PnCObG5MwQ7kNvwGnY9iK&_nc_oc=AdrW_7qiypn4lQlEdhDH37xCUGZJwgq9l7BONk5-4A2a4oTyo8Tz15iYijSbdDulU6g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMkCVB0M8DTL_UCRafgV7DdAUGIWMXAz8Gr4-iHp3P9w&oe=69C13771"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS4k_DANEGEQ7kNvwFbEnlo&_nc_oc=Adp7-EX9vMwAIOQPfMKrwRIB1wSB7tllikcNw1CeC3q0rYkHeWBfc05ZoejMG0pkwHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaaW4hcl3gR4GoGgi88LnRCgAX4ozTWUWstE0Eix_DGg&oe=69C12A71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZQDXwCvMvMQ7kNvwE19Cqo&_nc_oc=AdqswW1Hcb6XSvyGTCiQzdAvhd1LlXKyeCl0A6zVIQBBjJ49PUpcZqz7kTOmnJ8K7js&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFzoKK3ImRnMXEllKrzRaOfpNZ4l9OvSlhuylUT0KeA
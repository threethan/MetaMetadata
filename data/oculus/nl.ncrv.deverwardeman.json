wQ7kNvwHNqX3e&_nc_oc=AdoZTaLWpfQIFLDTIdPUkwvxWqdA0eM9hPomSeru_gTAXiiVYCi3vLVpO8CZoLd8Rxs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zyFLuefBn4qO5dy0LslXVbSLJDCglYd1ycWgB0gJnvA&oe=69F36B98"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAzCDc7sbQwQ7kNvwFWlMVb&_nc_oc=AdqdMVm0TDpHdC4Fc5xdH-_FExhXc46pxxCXxS6AvDmmlMgW_qDz-7Z2azxMWvB21rQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11v7By_rEVsb9a6A1crhEx0t5eWaVt-hLcxxKi6QzJXw&oe=69F36FE6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfmfSUALKX8Q7kNvwHfprzw&_nc_oc=Adp0OX0ATdiQOr81WwvdIKZYOXEVs8W2pRNR--6xqDZ_xM2FieoGLrCJDomnGac6fks&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DKwUGK47S2D9JMGWN_3N5ceyHt6twJx-ZTxuV6QRTFA&oe=69F35071"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcrMrSa1Il0Q7kNvwGOMLd8&_nc_oc=Ado8AWb5vNIx79mwCwaAn8_GkZcZnEIq4yXB0JRY2eTh8YMHHgODo-z-yeece4hNJ-8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3peG834qrjW7w9Ecu4QxXppjCtDmQuaSnYR9R8_4zhqA&oe=69F34371"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vduA0sgRWMQ7kNvwH8-hm1&_nc_oc=AdpJuXtrLK48IgrfywisyK6tJ4byf-r10JNao8XbvSrtI-nFtYoZAkwe8TD3xmGnVzQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f
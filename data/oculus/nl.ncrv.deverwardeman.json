kQ7kNvwFyoiry&_nc_oc=Adr_OY05yLlTKglI1sGoeaZl4m0NOAA-6LcxT8QliIfUv5Obn57K71GSAxsT9iFhJQM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd2llnX3i-nPQwUjZaRauD1THJ88TJb9gTDvyhUAyu8A&oe=6A9015D8"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSpQS8Q_bBsQ7kNvwHB7_zT&_nc_oc=AdqCGkXaJ6FT0UwlPQP-_vLshr51E1ZXYkK1tSM_rn95506vMFDjs5gFRo1k9M8M46I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6AB_5HF7lCiVfadVEzZrk56W84Mzj59vTEs9CsagEpw&oe=6A901A26"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvYIkMYq184Q7kNvwGhqAMH&_nc_oc=AdrmkN5Wv7mYFm-ZxhiPkcOSrW3x-OnfEjVTmxXT6_oszc8KxG8rAwTAsViX59nHig0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgaFz93030CIvpYLlZlTv2ENUops5K-FygMXIfvN1Faw&oe=6A9032F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d89thl__7i4Q7kNvwEs-Oiz&_nc_oc=AdrDgv3-V9d3RrtQ7p6I_bAuBD0JkjM3uSW17uP1OSYTBhblQ8fVdEinoakhyByVx8U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3TsNpetxzRSsb2ONplHZ4uk0LS6t1uJjRH2Ti2cj7qg&oe=6A9025F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNo7d1Uc1YIQ7kNvwFVkiFf&_nc_oc=Adqrtfc1VFsKCz3XOOFijgkf_c8RrqyQFa7bzA3APo33LeEGKuRUUEXX5wISaH33q2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f
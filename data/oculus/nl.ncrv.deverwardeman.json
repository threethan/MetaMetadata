5qK9wpAQ7kNvwHEp3PH&_nc_oc=AdqZ2WPM5N3YK82DpuJvO9D5U6zhG5n7zHsGge27SJcQR4_4q7kicTHIfVZqAoWJodw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66dg9gOAnVEY69VR02O-qQuKC8jN69UbB8SBJK9HK4SQ&oe=6A11BE18"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMksC4sKVUwQ7kNvwHhdyh3&_nc_oc=Adp5ztGvio5j2CrZQKVXoNEBNyICABzS1uxWnaMUJKGvwk2CfCvZrUI6yqVjbHdHgok&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62t96wdGIys6FxpcOFnVGzhW1KEbucJLejgOL6fG8WHg&oe=6A11C266"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCF3RuxzJ7kQ7kNvwGOg-u3&_nc_oc=AdrcW7l_aEHYTcoCxplSU4stILV7skmCLTW8eSvl_BcO-RpNd1evQPQRb1HnqVqebaI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JmUKPvd9UtnVDLLUhHjQvDeZbOmE2jZoJVVQohlsUxg&oe=6A11A2F1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gST6XJYck5kQ7kNvwHBfFV9&_nc_oc=AdrilvF2BPYM29pzqmLCm9W9oYFutbeFTvK-6Jf2B_9Kbb5HxS98fNtKHQFuKJOyZxY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7owkenszBtkuAvDRahC-Fir3t-Rbdhr0QPaDy4k5-HQA&oe=6A11CE31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ipWNZBTkmgQ7kNvwEtmV7c&_nc_oc=Adr1ETVuAapfq8h74GxP1bTH6FRGPSnuZ27t1jQ4DXYgoW5gyvOiCm-gjAYFGX2AxT4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_n
12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sL5-IyoWVDIQ7kNvwFEzkvr&_nc_oc=AdouOdBwuVU2YsxkTRz-Yn1K7tEveME5xrdotKVWfZxVFgJn1d2vWtlxO-bmhqJ45ZU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1GFC_gW5Lve6xFloBNbLLTD3cpQcEc8sKO0DgpL-g5g&oe=6ACE54B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLO
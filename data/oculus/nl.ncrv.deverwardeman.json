=scontent-ams2-1.oculuscdn.com&oh=00_AfvT50JCxPlurnIbO1ORRU4uCF5TSIYQskOT8vyk_SrX_A&oe=699ED358"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHzLq2INYywQ7kNvwFgChKL&_nc_oc=AdlKzXkoJ0Tw0h5GbqQ4g9zVcog3uYVpcuf155-Mm8j_doluBH7rxtvRXIk2Td755mk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvd7dbZcViPkiWwBqkWFYhtNgz32RzudSQmTwop6jErQA&oe=699ED7A6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7_VmpQ3q7IQ7kNvwFJj7mV&_nc_oc=Adkc0FGQw8xseIdSSZlYGfXWwcQCVMZ2ULBpok1VZ8DsNpZUbn5Mbsawg-sO1cp-488&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu5pXt6jGOIyeK6vDC0hV8mCm13-LXWDtVqtbV7-ysiMg&oe=699EF071"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dAtBjVBkgWsQ7kNvwEOB3B_&_nc_oc=Adlf065phFqA4iP_ylWA9Sjy9NwdrPw9FBllZ-kfwL4Wb3JxDhsGwZfhGOuNYVTGjXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuKIIyUTdRE2XL70CnUJAwSMULVOvBbEgL9Q69GY8bPNA&oe=699EE371"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA-ryZFNCooQ7kNvwG26AB7&_nc_oc=AdkAMBHgojRhNkWbxzFmOh4FegYEQaZs9whWcE3ZLnIwEarqt33xibVSAIcqTMarxBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvnqRwVIwk2PBcrt8C4q--Kvz92O7Fl1ZNP2miLPzJPeQ&oe=699EF2BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "De Verwarde M
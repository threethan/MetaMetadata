UQ7kNvwHchyVJ&_nc_oc=Adqv5vSfBf_eWGCQ9qcHKSW3KEvOmT0UdmR-XLB4xcw7-Kt8UUqCZ0VsKFjtgadhqgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5wr8n4_4UMIWU2dEltYgO2dNn9oTphrD0fv6S-3NsQg&oe=6A676F98"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgaHB3QMY8oQ7kNvwFHUkG1&_nc_oc=Adp797ICK1FiZLdLqy0r6w1TMp9C48BOC1KZrhFsIdvFs_bso97RQpZVO_1myD0XrH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhFjI2dIyOxMHTnjtmAndtyTBAQN1jwmOabHQEntnYTw&oe=6A6773E6"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tb9bPomLpRsQ7kNvwFJZokL&_nc_oc=Adr4ego_BIYxl3koFTiEW5SpN_NOGCRZJtS-958DXKloBMyXNddtZ-ugB1I6pHpuZlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqUATplF8pYJfgDuiBbN91PI3qUU4HOD072rH_fdVrEA&oe=6A675471"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nucrnl5Blb0Q7kNvwFrP7GX&_nc_oc=AdqTpDeS5sGAY3wbwslatJiNG5oJJp5taf_1lC1nNR9J7rdla6smY66Wa1R0B_UW0lQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiGpNW28rKQAJw2HiwCsiE3rk2Pi-QU29fOK-Cx4sqNA&oe=6A674771"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqFo8R02ZTQQ7kNvwFza2Q7&_nc_oc=AdrTB3R2qsBCApuo-DN2OZd1GIR62QOW9PCJNpZrSN3fyjBR6RIHoZlGF6hEhvRHjbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f
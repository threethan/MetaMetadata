=scontent-iad3-1.oculuscdn.com&oh=00_AfsfkfCTkeqDlHLZCpK314GdQkOlnw0iE5pnoW2YVMb3Pg&oe=699D81D8"}, {"file_name": "migrated_image.png", "id": "3841786405862133", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139431_1214669848618527_3908070654791909376_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6QwkfvfwVcQ7kNvwFnLN_1&_nc_oc=AdnhkIOuIPS7H-4pCjBCPMFq65aUg4eSIvYExYQM_zoRI0Pvx6iI4WsIGHvmUDwm7-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsGMBDqm1eiMDZkMlJp-GPIfhOSzbi2DhGi648ySbl-xg&oe=699D8626"}, {"file_name": "migrated_image.png", "id": "518213532441875", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139431_1579963145366417_8040831806414520320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toG-AnaG5lMQ7kNvwGE79Rg&_nc_oc=AdkM1XdU-z7t6Td6HtLhBksfZXSp8dvvWsqiV3fuyQ7TaMhODLaRA9hgFgLZKey9-g4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsoRLqaDQIF3u5LOodPtwZYKRDDRnnJU6Pf7MVdxa6AOg&oe=699D9EF1"}, {"file_name": "migrated_image.png", "id": "553112161985032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533755_1079415035518095_8440956079310897152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0X9mAcSbfAQ7kNvwEMsUiG&_nc_oc=AdmsyaqtOAoa-KVFcKKVbYIGB_o1-cvkNRUlBA7v-4oxYH5hBdUlnxiVPX_tk6Z-lIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvWznZ7rd6RNJCK2FS_NpxlD-UAnkp8RMX6Ipg-Kf97tQ&oe=699D91F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "De Verwarde Man", "keywords": ["psychose", "verwarde", "man", "monitor", "kroncrv"], "long_description": "In het eerste virtual reality verhaal van KRO-NCRV stap je in het leven van Jeroen Zwaal, die in een krantenartikel 'verwarde man' werd genoemd. Op basis van zijn waargebeurde verhaal over zijn 5 psychoses stelden we deze meeslepende geanimeerde experience samen. Je hoort wat hij denkt en ziet wat hij doet en waar hij uiteindelijk terechtkomt. Door telkens de stip in je beeld op de gekleurde objecten te houden, houd je het verhaal gaande. De hele ervaring duurt ongeveer 10 minuten. Met deze productie wil KRO-NCRV meer inzicht en begrip cre\u00ebren voor mensen die in een psychische onbalans terechtkomen. Het verhaal maakt deel uit van het dossier Verwarde mensen van onderzoeksjournalistiek programma De Monitor. Zie: http://demonitor.ncrv.nl/verwarde-mensen De Verwarde Man is een samenwerking van KRO-NCRV afdeling Digitaal & Innovatie en VR-Base.", "short_description": "Stap in het hoofd van iemand die de grip op de werkelijkheid verliest (VR)"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden", "developer_terms_of_service_url": "http://www.kro-ncrv.nl/over-kro-ncrv/algemene-voorwaarden#Disclaimer", "publisher_name": "KRO-NCRV", "support_website_url": null, "website_url": "http://demonitor.ncrv.nl/verwarde-mensen", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "662249074824779"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533901_372245609799057_121840894973313024_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4PN-q3ftEQQ7kNvwHEyUWG&_nc_oc=AdnjK6VZJ_3W56PFNHvYTn2HgQcQwN2eQMAx5rnHVQLwT_Hw25nEiB472F0pt8fKPz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsSIuobwFTjrvSJ-XIQRSi2s4fYH1vQlhgNYT_QbCO2AA&oe=699DA13E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "De Verwarde M
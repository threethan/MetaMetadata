lxlNNBYqSQQ7kNvwEHqUFv&_nc_oc=Adq5aXyivsLrLDxAMnAAjzyHPHXc48MtGihNqyC37P2jTOuFvhnN-PleHzVY5raPzRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGArsk_P9jh1MUZX41rRTdoaKIJlLUDAwXial7tpbM8g&oe=6AFDE339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2718368381923999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_2718368385257332_5584676912459447055_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-WpDnW-K0cQ7kNvwEJprmi&_nc_oc=AdpXn_G91LNJKbdQEMZRMlzths_Y4La7-0V7-yBW9fPmYt608WFqn2ZVNv5es7yE9ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXis1OC3gE9L6CK8Co6-FFe_Q89pOAwvTCx9gbEvNxnQ&oe=6AFDD600"}, "display_name": "Flight Simulator Kuwait City", "keywords": ["flight", "simulator", "kuwait", "jet", "pilot"], "long_description": "Flight Simulator Kuwait City puts you in the captain's seat over the real Kuwait.\n\nTHE REAL KUWAIT CITY\nThe Kuwait Towers on their point, Al Hamra, the NBK and Arraya towers, the Liberation Tower, the Grand Mosque, Seif Palace, the National Assembly, Souq Al-Mubarakiya and the Sheikh Jaber Al-Ahmad Cultural Centre.\n\nKUWAIT BAY AND THE GULF\nFly low along the 36 km Sheikh Jaber Causeway to Subiya, past ships at anchor and dhows off Souq Sharq, then down the coast past Green Island, Marina Mall, the Scientific Center, Messila and Fintas to Ahmadi and Fahaheel.\n\nA LIVING CITY\nTraffic on the real roads, yachts, dhows and tankers on the water. At night the towers, the Corniche and the causeway light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar in Shuwaikh, the skyline out of the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, Ali Al Salem approach, a sunset hop, the Causeway Run, between Al Hamra and the NBK tower, the Gulf coast, a fighter scramble, a city tour, Kuwait City by night.\n\nENGLISH AND ARABIC\nSwitch the menus in Settings.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly over the real Kuwait City: the Kuwait Towers, Al Hamra, the Liberation Tower, the Grand Mosque and Seif Palace, then out along the Sheikh Jaber Causeway across Kuwait Bay to Subiya and down the Gulf coast to Ahmadi. Start in your own glass hangar in Shuwaikh, talk to air traffic control and land at Kuwait International. English and Arabic menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorkuwaitcity/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/flightsimulatorkuwaitcity/", "website_url": "https://citiview-games.pages.dev/flightsimulatorkuwaitcity/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388420801021122"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1388586171004585", "version": "
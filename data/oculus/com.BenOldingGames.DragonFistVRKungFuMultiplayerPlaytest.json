56772_4918853589962715064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7iPYOZq_O54Q7kNvwG_Ef9s&_nc_oc=Adq_An321Az2eilU6a0_wCfxPKXFPutDlwc0KTEmLgY6hsKuosohM6LvXawyrd3l-Zs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlC3fqonuL_71BlumUexLJpXTYyy0VQlmWLXT7bwah6A&oe=6AEC886D"}, {"file_name": "aplb - ss2.png", "id": "3805304573031216", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566686_3805304576364549_4697030718551306604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OYechLn7LMQ7kNvwH9TRUD&_nc_oc=AdqYlYKdONHbtW_PCmXoqxyeVkmIScV9f2H8MNmunKRq26PnhBmXQmMHLSCwoI0X_B8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkzc4rkwEjuO0QdFO3Tw3FXz-U-UqDA2fCVpui3oq6Kw&oe=6AECBB3E"}, {"file_name": "aplb - ss3.png", "id": "823840649246178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974645_823840655912844_5288026250863127288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70_PBSsJna4Q7kNvwHl8YyW&_nc_oc=AdqdwuGABDxhTKTJo_ol5WIrF5ZKJ0W79aebBs_26hlReDCZrMoqLrxzBhNYW0tREb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtxEw0EPmfGYA10zFLJFZuoB7DOUsUXZicI6LKHsrQQw&oe=6AEC960E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest main capsule oc.png", "id": "219723111022984", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031446_219723114356317_5827204287518780281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--ZS5aOpkNQQ7kNvwFass8W&_nc_oc=Adre_hSD_edBLAGIx0p8qJKu-qmRpG9SLisc6AzEsZAx5hjL_ZkT25npbtSvNB1ofeo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSZ2ds1YWVzBF_0jQ8HdRML-Ur03evFmtWnjMg2U4lMg&oe=6AEC9850"}, "display_name": "Dragon Fist: VR Kung Fu [Multiplayer Play Test]", "keywords": [], "long_description": "Be a part of the next evolution of Dragon Fist: VR Kung Fu with our Multiplayer Playtest! Help us test, expand, and break new features while getting an early look at what is to come. \n\nStep into your own kung fu movie with legendary characters inspired by martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nHow you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.", "short_description": "Playtest all upcoming Dragon Fist: VR Kung Fu features such as Multiplayer, Co-op, new interactions, and more! This playtest is available for everyone and will feature experimental features. Have fun! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://dragonfistvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1460875271410287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9
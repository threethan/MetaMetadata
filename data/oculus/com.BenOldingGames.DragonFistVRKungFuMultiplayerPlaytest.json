56772_4918853589962715064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve2Bq7GnzdsQ7kNvwElDSAO&_nc_oc=Ado0hcum3NM_vG_l5h5kzXIbW6YdC_NVNl-uYTe7lcDHySxZBOFwirZlLyMzgVyYRTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg8qKP8e1fyqIbm8Nm9HaX5zQ6RfTuHmalTWYF1DpMEw&oe=6AE1FC6D"}, {"file_name": "aplb - ss2.png", "id": "3805304573031216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566686_3805304576364549_4697030718551306604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVYsRNOwSSoQ7kNvwHM2Uyn&_nc_oc=AdqIXQCqR22FQBzo7fo845I9t2pLpwFqxUASLqst_G-VHjFIkgC7PBf10o0gB744F7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL-ke2UrVD2rLMCD8LlIySPkHfQA0QjdsOkvaQlF5vag&oe=6AE1F6FE"}, {"file_name": "aplb - ss3.png", "id": "823840649246178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974645_823840655912844_5288026250863127288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37WWAmSH8DMQ7kNvwHERlPN&_nc_oc=AdphGp0TeEuGwalX0R8jJl_nO72t_9Q7oYR0OMnqh651ZAWR30DAjL2vM4nfj_F0bUo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPHGLUZNRkq_dvlIO_8er3HGQ6M1KROOZyWjDs9xa0hg&oe=6AE20A0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest main capsule oc.png", "id": "219723111022984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031446_219723114356317_5827204287518780281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vyg4wBDBVzQQ7kNvwFkiZsU&_nc_oc=AdpQZydT90p1hfdQYPGW76SXJA8zFQUtLFrhuhyLQ6MV3vnvsfbzvjye1-YQ-AK1SDY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOStaGYFQw3gzOLzUM_7ILwP-7t3UDBmY3Z9r_iQ9VdQ&oe=6AE20C50"}, "display_name": "Dragon Fist: VR Kung Fu [Multiplayer Play Test]", "keywords": [], "long_description": "Be a part of the next evolution of Dragon Fist: VR Kung Fu with our Multiplayer Playtest! Help us test, expand, and break new features while getting an early look at what is to come. \n\nStep into your own kung fu movie with legendary characters inspired by martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nHow you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.", "short_description": "Playtest all upcoming Dragon Fist: VR Kung Fu features such as Multiplayer, Co-op, new interactions, and more! This playtest is available for everyone and will feature experimental features. Have fun! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://dragonfistvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1460875271410287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9
np6vPGaNkacrZwxxOpUC5WrFl3rd7ZqhH8GiWvTSdmFTZSnUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33BVSSfvQyvPUOBPbDCplNNg2vS3ACnDQnVhJbrz4cbw&oe=69E8D0ED"}, {"file_name": "aplb - ss2.png", "id": "3805304573031216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566686_3805304576364549_4697030718551306604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjRVILscEMIQ7kNvwH0U6B5&_nc_oc=AdrpSdFOa9OEwRPZ05qzO7wp_p-XBBE_wbKnpkGuEwAeOII1Le7eTSPywCnVzeAR6Bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m-wn9ap5lYnjc_PK4gFvXXoSONJcj60WD1Bq6s3hqig&oe=69E8CB7E"}, {"file_name": "aplb - ss3.png", "id": "823840649246178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_823840655912844_5288026250863127288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ww5LCz9ZZ0wQ7kNvwGfBeYa&_nc_oc=Adp-oH7CK16TPhqNrqnHxrOeqBTjsyyfX5xo1vqCEma8b-4YFFzw_XJjtHHSr4TK9dI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CoQk4PRvQhKnN_nEl31Ek7oLx1o_ai8EqPSJJ5mx5Vg&oe=69E8DE8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest main capsule oc.png", "id": "219723111022984", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031446_219723114356317_5827204287518780281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ476jS-RJ8Q7kNvwH6e87s&_nc_oc=Adp7MpRG1q7BEL6MWkqTPMv604JyrHxyymiJHZ1aA6Gol0HRWst3gz4DgteqiueOoC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04TYw2Tce6aG9e-H6eI8GB6ydzX9t8ZxK2Qm4OjD_0yg&oe=69E8E0D0"}, "display_name": "Dragon Fist: VR Kung Fu [Multiplayer Play Test]", "keywords": [], "long_description": "Be a part of the next evolution of Dragon Fist: VR Kung Fu with our Multiplayer Playtest! Help us test, expand, and break new features while getting an early look at what is to come. \n\nStep into your own kung fu movie with legendary characters inspired by martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nHow you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.", "short_description": "Playtest all upcoming Dragon Fist: VR Kung Fu features such as Multiplayer, Co-op, new interactions, and more! This playtest is available for everyone and will feature experimental features. Have fun! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://dragonfistvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1460875271410287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9224007277676959", "version": "2.1.9"}, "id": "670615851251499", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false,
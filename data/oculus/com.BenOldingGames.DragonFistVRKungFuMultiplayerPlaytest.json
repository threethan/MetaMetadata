439", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982619_978800083356772_4918853589962715064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcghR0FQ3W8Q7kNvwEnZqxG&_nc_oc=AdmXturU-L8dQ3txAjqeSDAbVY31AtVzX8SO1nAFSdt9m2qG8M1GE4C-Zvz_i5K44DU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyClLWqzY4NanoQNeipVlBLj6tc57mQWLfQr_y4hS9CUw&oe=69B95AED"}, {"file_name": "aplb - ss2.png", "id": "3805304573031216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566686_3805304576364549_4697030718551306604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5pvouIfrd4Q7kNvwHSlHlu&_nc_oc=Admkkh5x25hSYWCSodNJ7j5zsOWaNtZxeZWfxQfy3xdL8d4bn6_Yz5S3MFJFkOBr5G8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywugjW15n4k1EaqDOd3Ybknl01rSOD_SK_PL8zMTLuzQ&oe=69B9557E"}, {"file_name": "aplb - ss3.png", "id": "823840649246178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_823840655912844_5288026250863127288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trlu3lPvYeoQ7kNvwHAt_ju&_nc_oc=AdmaePYkVBlgwgMAg6AJ-oS3T-QxlNkLNCUvKZ0yhlL6gQwejeQB0gAzSejRqG6Ob1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyITkF8Oh2QkxBtDqy4JgkIzyJBP7Dqt6mZ9UZP4MEhwQ&oe=69B9304E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest main capsule oc.png", "id": "219723111022984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031446_219723114356317_5827204287518780281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHlweuwWRGEQ7kNvwGcCy_A&_nc_oc=AdnQ4wfspdAMVC7HOeFaltWSU17gpInFk1PRECb6ve07HKwsfzGfjkdsE8ZVCn8Dr54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWieQeWxJk46O8Xl0e6YBlVTQM555K0xbTMUlUksx0tg&oe=69B93290"}, "display_name": "Dragon Fist: VR Kung Fu [Multiplayer Play Test]", "keywords": [], "long_description": "Be a part of the next evolution of Dragon Fist: VR Kung Fu with our Multiplayer Playtest! Help us test, expand, and break new features while getting an early look at what is to come. \n\nStep into your own kung fu movie with legendary characters inspired by martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nHow you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.", "short_description": "Playtest all upcoming Dragon Fist: VR Kung Fu features such as Multiplayer, Co-op, new interactions, and more! This playtest is available for everyone and will feature experimental features. Have fun! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://dragonfistvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1460875271410287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
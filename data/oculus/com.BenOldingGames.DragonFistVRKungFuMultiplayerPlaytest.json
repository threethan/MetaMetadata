978800080023439", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982619_978800083356772_4918853589962715064_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=774hqGB2LqEQ7kNvwFS0K3J&_nc_oc=AdlG-SSndqJ-iquMUpka7xi_puClXF8RbTZL7hyQiLi8HGhhAIYhhkFobirR6eS4Nus&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzuyLAbzf4fkldx8kIQIqneUI6N7PlxZRjeVcAxl7Q1Q&oe=69AADA6D"}, {"file_name": "aplb - ss2.png", "id": "3805304573031216", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566686_3805304576364549_4697030718551306604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhFQajc0ScwQ7kNvwHKs5FO&_nc_oc=AdkEDPFPmVroYwJ4-j4tZ1DcmWHe_xRxWyXGt5Pte301TJ4D309Rc7Mdysoo-JQWNio&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTGQF2q9Dl_pZrie5X-PhkTahlgQ2sn-eSCz_Vd55OGg&oe=69AAD4FE"}, {"file_name": "aplb - ss3.png", "id": "823840649246178", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974645_823840655912844_5288026250863127288_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-_CmAIh7ksQ7kNvwHcAdhh&_nc_oc=AdmTgTLWqofs6ELFmmjg7i67RSoYUsK_tmy9giLx3-PEFa8WGrkLvMLQa5_xX_EbACs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfyF7Pz0Ow8PTA1eu9dn9PyzR2QP4LqBERlekqubaQMXhw&oe=69AAAFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "playtest main capsule oc.png", "id": "219723111022984", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031446_219723114356317_5827204287518780281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rq65W8UOlQQ7kNvwGGdIO1&_nc_oc=AdmZR6p1HdPXxVPh8T-UNQgdwILbYZq9sUBJ2HuYU38t6vOWcNS2yuah3tSpUQrT4os&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afya_JuNo5Uh9Zr51yHn4DMropjwpZU11IFp0Yr45_S8fQ&oe=69AAB210"}, "display_name": "Dragon Fist: VR Kung Fu [Multiplayer Play Test]", "keywords": [], "long_description": "Be a part of the next evolution of Dragon Fist: VR Kung Fu with our Multiplayer Playtest! Help us test, expand, and break new features while getting an early look at what is to come. \n\nStep into your own kung fu movie with legendary characters inspired by martial arts movies across the decades. Whether you fancy playing as an old wise master, or a young gifted female kung fu student, or a shaolin monk, Bruce Lee inspired character, samurai or a ninja there's bound to be someone for you...\n\nHow you fight is up to you. But your opponents might use different strategies also, so you must learn how to foresee their attacks and how best to attack them.\n\nYou opponents all have the same controls as you, no advantage, no disadvantage. Except on easier levels they will have less strength - they will also have their speed and intelligence reduced.", "short_description": "Playtest all upcoming Dragon Fist: VR Kung Fu features such as Multiplayer, Co-op, new interactions, and more! This playtest is available for everyone and will feature experimental features. Have fun! "}]}, "developer_name": "Ben Olding Games", "developer_privacy_policy_url": "https://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Games", "support_website_url": null, "website_url": "https://dragonfistvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1460875271410287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_
udying.\n\nWe combine immersive 360\u00b0 imagery and video with historical context, expert perspectives, and guided lessons that invite you to look closer, ask questions, and make connections.\n\nWhether you're exploring on your own, studying with a small group, or leading a classroom, our experiences are designed to turn passive viewing into active discovery.", "short_description": "Watch guided 360\u00b0 study trips. Open a trip and go! A narrator walks you through each site while maps, dates, and references stay on screen. Now you don't have to hop on a plane, train, or bus to explore far-off destinations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrstudytrips.com/privacy", "developer_terms_of_service_url": "https://vrstudytrips.com/terms", "publisher_name": "Kinetic Theology, LLC", "support_website_url": "https://vrstudytrips.com/support", "website_url": "https://vrstudytrips.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1072650332013874"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1471222158375239"}]}, "baseline_offer": {"id": "1471222158375239"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792645380, "status": "PUBLISHED", "id": "1471222158375239"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
74510_7160104258973022658_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdakOjjwADgQ7kNvwG_GOA5&_nc_oc=AdoGudw3OBWGF5npd2TCJgtVBFUOixBjah9GiWy5wcoAcgLlsCeAG664hASv6qriwSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTs80SGcqcaB4TsP8DonDW2QayEg62ltpecISet4urdA&oe=6AFDC82C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Study Trips", "keywords": ["travel", "study", "learn", "bible", "history"], "long_description": "Anyone can watch a travel video. But we think meaningful learning requires something more. Every virtual study trip is designed to connect you with the people, places, and stories behind what you're studying.\n\nWe combine immersive 360\u00b0 imagery and video with historical context, expert perspectives, and guided lessons that invite you to look closer, ask questions, and make connections.\n\nWhether you're exploring on your own, studying with a small group, or leading a classroom, our experiences are designed to turn passive viewing into active discovery.", "short_description": "Watch guided 360\u00b0 study trips. Open a trip and go! A narrator walks you through each site while maps, dates, and references stay on screen. Now you don't have to hop on a plane, train, or bus to explore far-off destinations!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrstudytrips.com/privacy", "developer_terms_of_service_url": "https://vrstudytrips.com/terms", "publisher_name": "Kinetic Theology, LLC", "support_website_url": "https://vrstudytrips.com/support", "website_url": "https://vrstudytrips.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_conne
F90"}, {"file_name": "05-profile.png", "id": "1839689434122784", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/908842262_1839689437456117_422902036628009678_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGFMIHEBTlAQ7kNvwGxocfl&_nc_oc=AdrD5lsxs9uzKbcVD4xU5iEyFWJymAmfbtHZYdT8SUAihXYKxbXQGCAFF4ZZOU06R48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaixYfrKHpBugfSrJ6ugL4-L2z1PODnBadaDUBybI_XA&oe=6B10649A"}, {"file_name": "04-settings.png", "id": "1143645794815279", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842187_1143645801481945_6748922578018352496_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dA8yLSNER14Q7kNvwGYbAo7&_nc_oc=AdqeFjstUa14p7Ywjle8s6wJ5BO5BLDawl9NwKeQU2X5Y6Iqd01ccIrjHhjAqLVD1ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXRlIeVpYD2oAy5e56QJ2oJGMkL0HzjkH5SPS0-vDwWHA&oe=6B105DF9"}, {"file_name": "03-sign-in-password.png", "id": "972321588949825", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908842187_972321592283158_2733396519056782407_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRGvcCXi6kgQ7kNvwEbAN4D&_nc_oc=Adp7XOUiCP7WJvqYLYTIfHe3q9tm-s1T9amnr_2zUeT_NEYQ2hjZMqFF0-ZRkdT4KkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzyaNEJ4eVbI7WrOHsrbqiQ-JEc7TZMoIAs5Nwp44caw&oe=6B105754"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MetaSeat: Front Row Live", "keywords": ["360video", "liveconcerts", "livesports", "replays", "virtualseat"], "long_description": "The best seat in the house, wherever you are.\n\nMetaSeat puts you inside live concerts and sports in immersive 360\u00b0 video. Look all around the venue from your seat, like you are right there with the crowd.\n\nYOUR 360\u00b0 SEAT\n- Pick an event and step into the venue in full 360\u00b0.\n- Watch seated or standing. The camera stays put, so there is no artificial movement.\n- Use your Touch controllers to move panels, set the volume or recenter your view.\n\nREPLAYS YOUR WAY\n- Scrub with the seek bar or skip 10 seconds. MetaSeat remembers where you stopped, or you can start over.\n- Choose the picture quality, or leave it on Auto.\n\nMORE THAN WATCHING\n- Chat with other fans during the show, and react and vote in live polls.\n- Chat is filtered, rate-limited and moderated. Report any message. No private messages, voice chat or public profiles.\n\nFREE DURING BETA\nEvery event in this release is free. No purchases or subscriptions. Some events include short sponsor messages from MetaSeat, chosen by event, not personalized, with no third-party ad SDK or tracking. Adults-only sponsor messages are never shown to users under 18.\n\nGETTING STARTED\nFor ages 13 and older. Complete the age check, then sign in with your email and password, or a code we email you. Under 18? A parent or guardian must agree to the MetaSeat terms.\n\nSTREAMING NOTICE\nNeeds a reliable, high-speed internet connection. Connection problems can interrupt playback and may cause discomfort; stop watching if you feel unwell.", "short_description": "Watch live concerts and sports in immersive 360\u00b0, from the best seat. Free during Beta, ages 13+."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.metaseat.info/privacy/", "developer_terms_of_service_url": "https://app.metaseat.info/terms/", "publisher_name": "MetaSeat Inc", "support_website_url": null, "website_url": "https://www.metaseat.info/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
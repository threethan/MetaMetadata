ics! And More! This Is And Early Realese So There Will Be Bugs! More Updates Coming Soon!"}]}, "developer_name": "Vinndog", "developer_privacy_policy_url": "https://sites.google.com/view/cebidaeprivacypolicyvinndog/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Vinndog", "support_website_url": null, "website_url": "https://sites.google.com/view/cebidaeprivacypolicyvinndog/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25663496806645138"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619685_3100381523472553_5205588471392396970_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYJYlmQ1BEQQ7kNvwHJIqbx&_nc_oc=Adpx6v9m5fyrtD9naGlI1yCQw24FfhKzPHVPBZBHnuVhYi_L5VQHUyvBczw54yKhmzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwz7HMzAtn8yK8ta6DtpCCsokEmgjWw-cKKAJeq-FpUA&oe=6B045891"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cebidae", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "10237707
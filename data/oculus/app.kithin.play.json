JstOElH9SgYZ6MbO_vQGJWs1SutqRdS3vU9l5dXN3tYptd4UE-6yuS7w744G2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWxP8VJb9n1lQ7mikiflmfkg5KKXNC7Ugfxfl5IbiFd3w&oe=6B0EFF01"}, {"file_name": "Fernando Merino - 2026-10-01 17.55.31.png", "id": "1066012212978991", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_1066012219645657_6298015952090882686_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QabE9G60SGwQ7kNvwGEMDd1&_nc_oc=AdqmLbIUkxlbdAfu2nn9MceljtIBhVn5K8lWUsfazFEt2i5pm30B1Wlce8kyh5ING7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoI9CduJUWXrmPy4iy6n9gp6of_ti0MgkZjn0G7F-JsQ&oe=6B0F07CA"}, {"file_name": "Fernando Merino - 2026-10-01 17.55.29.png", "id": "4112375742400027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_4112375745733360_6252809948218340026_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qq4bGcmvLEQ7kNvwEc6BNb&_nc_oc=Adqark_XyvkHNWDD1B9emEddn8Ivda7eJDrdQMOY0Yw4RK1Vyyiby91jHusgsKkj8wQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKUtu9xxaYUlF96Lfes2O-W_PQpPBdGbO2F2SfoJ6FYQ&oe=6B0F1F93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kithin", "keywords": ["sandbox", "social"], "long_description": "# You are made of what surrounds you.\n\n**Kithin is a shared 3D space where the people, things and places around you become part of your experience.**\n\nGrab something. Use it. Keep it. Give it to someone. Take it somewhere completely different.\n\n**If it works here, it works everywhere.**\n\n## Take anything with you\n\nObjects aren't trapped inside the world where you found them. Keep something you like and bring it somewhere else \u2014 it will still work.\n\nA paintbrush still paints. A gadget keeps its behavior. A game stays a game.\n\nSee something interesting? **Pick it up and find out what it does.**\n\n## Yes, even worlds\n\nEntire worlds can become objects you can hold, keep, share and activate.\n\nTake a world into another world. Give it to a friend. Step inside.\n\n## Better together\n\nInvite others, interact with the same things and talk naturally with spatial voice. Found something cool? Hand it to someone.\n\n## Make something\n\nCreate toys, tools, gadgets, games or entire places with **Kithin Studio**.\n\nBuild it once. Take it anywhere.\n\n**Bring your friends. Bring your things. Make something new.**", "short_description": "Kithin is a shared 3D space where everything can travel with you. Meet people, grab and use interactive objects, keep the things you discover and bring them anywhere \u2014 even into completely different worlds. Create your own things, share them with others and build new experiences together. If it works here, it works everywhere."}]}, "developer_name": "Fernando Merino", "developer_privacy_policy_url": "https://kithin.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fernando Merino", "support_website_url": null, "website_url": "https://kithin.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1597080012163452"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2017582205582014"}, {"status": "PUBLISHED", "id": "1088897827067010"}]}, "baseline_offer": {"id"
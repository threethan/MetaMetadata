a8qfp9JGHtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhzfSJBK0YcCvhEUQoSQKm7c-QEe6u2YuLgAygIQtm2A&oe=6AC66F68"}, {"file_name": "SS3 copy.png", "id": "1255978846019581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294630_1255978849352914_8488809938311789365_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RlRRpJHGZIQ7kNvwHyr0X_&_nc_oc=AdpGgi_tKELU6j9YOcd1irsRdgeMYRYu2Er3b5JFKKFxiGUL7gWwFsIts3OT1GfGrjk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUiXM2wAS7CEDhAZeVf8-dzAe5TdWoM1xubfs5Lf-F0Q&oe=6AC64F57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary night : Morgue", "keywords": [], "long_description": "Scary Night: Morgue plunges you into a heart-pounding VR horror experience where survival is your only goal. Trapped inside a dark, abandoned morgue, you must navigate eerie corridors and uncover hidden objects to escape. But you\u2019re not alone something evil is lurking in the shadows.\n\nA ghost haunts this place fast, relentless, and deadly. It hunts by sound and movement. Every step you take, every breath you draw could be your last.\n\nExplore, hide, solve, and survive.\n\nWith atmospheric visuals, immersive sound design, and intense ghost encounters, Scary Night: Morgue delivers an unforgettable horror experience that will leave you breathless. Will you survive the night, or become the morgue\u2019s next victim?", "short_description": "Step into a terrifying VR experience where you must survive a haunted morgue, evade a deadly ghost, and uncover hidden objects to escape. Can you stay alive long enough to make it out?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarynightmorgueprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "ravipipariya1213@gmail.com", "support_website_url": null, "website_url": "https://scarynight.travellersthirsty.com/", "category": null, "comfort_rating": "COMFORT
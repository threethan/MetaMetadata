uscdn.com/v/t64.5771-25/499295542_24655305037387193_5840857603212206681_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO7T1pZaTNoQ7kNvwH-NW9s&_nc_oc=Adq_U67-vfHDLg7tLOCPW3dlzFkOXfe4A0SGty4-dXE8BBRGNfHmVZsFZ4Lk_u8sRdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZgC8ce0h65beVgwcJZMtB0il4GLFDqCRR488ht6Eyhw&oe=6B104368"}, {"file_name": "SS3 copy.png", "id": "1255978846019581", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294630_1255978849352914_8488809938311789365_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnuAOTvbR5QQ7kNvwGLDYI1&_nc_oc=Ado3qSHanIRANzMWKxGz9z1reNDGjTUoBpEWk96ewoSor_rgNbRlAafBcS7wbfs0XTI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOEXAfPVGLwpFSgcA6DAfr6Znrcg9rtGU6XCgQ0s0AXg&oe=6B105B97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary night : Morgue", "keywords": [], "long_description": "Scary Night: Morgue plunges you into a heart-pounding VR horror experience where survival is your only goal. Trapped inside a dark, abandoned morgue, you must navigate eerie corridors and uncover hidden objects to escape. But you\u2019re not alone something evil is lurking in the shadows.\n\nA ghost haunts this place fast, relentless, and deadly. It hunts by sound and movement. Every step you take, every breath you draw could be your last.\n\nExplore, hide, solve, and survive.\n\nWith atmospheric visuals, immersive sound design, and intense ghost encounters, Scary Night: Morgue delivers an unforgettable horror experience that will leave you breathless. Will you survive the night, or become the morgue\u2019s next victim?", "short_description": "Step into a terrifying VR experience where you must survive a haunted morgue, evade a deadly ghost, and uncover hidden objects to escape. Can you stay alive long enough to make it out?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/vie
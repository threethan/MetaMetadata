uMf3cjJfEdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqhz_U2sJ_cYGjVTrxbPtjwDS3Lk3C78-GQDPX7xth1w&oe=6A523328"}, {"file_name": "SS3 copy.png", "id": "1255978846019581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294630_1255978849352914_8488809938311789365_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x41U9mzqImMQ7kNvwEtYw5b&_nc_oc=AdqoNDrSpJegEQevDkpgSVyiG1dLtBRJKtgU1B0LCVWIu2LsZBp1Cc5wbWfJ1dIeXn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuGg0BpvvvvFgUCVhfPvvbK7OSaLdWdnxZLEUHme5JnQ&oe=6A524B57"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary night : Morgue", "keywords": [], "long_description": "Scary Night: Morgue plunges you into a heart-pounding VR horror experience where survival is your only goal. Trapped inside a dark, abandoned morgue, you must navigate eerie corridors and uncover hidden objects to escape. But you\u2019re not alone something evil is lurking in the shadows.\n\nA ghost haunts this place fast, relentless, and deadly. It hunts by sound and movement. Every step you take, every breath you draw could be your last.\n\nExplore, hide, solve, and survive.\n\nWith atmospheric visuals, immersive sound design, and intense ghost encounters, Scary Night: Morgue delivers an unforgettable horror experience that will leave you breathless. Will you survive the night, or become the morgue\u2019s next victim?", "short_description": "Step into a terrifying VR experience where you must survive a haunted morgue, evade a deadly ghost, and uncover hidden objects to escape. Can you stay alive long enough to make it out?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarynightmorgueprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "ravipipariya1213@gmail.com", "support_website_url": null, "website_url": "https://scarynight.travellersthirsty.com/", "category": null, "comfort_rating": "COMFORT
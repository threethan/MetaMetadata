/t64.5771-25/38974738_416159510283723_7195158608165123614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1voDcja7tp0Q7kNvwGOdTDW&_nc_oc=AdkK3BGa_2SbxMxQUXI66KP7OXpVCd-ZRsgQrkPVaf_33JcoZgJxZSOa0fyX2kZe5oE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsI6n-vV1lZkjSUi4ULi2F1iFXzbU7x2hGJfzod9ZJjLA&oe=69A9718C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wj0OhGe7p70Q7kNvwHILDGW&_nc_oc=AdnYFMD713FPIQxlg2G011ufCbmE_h7MqRxquytWZOJSrDaCHC5OnP0kkVA0W1bewJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvCbOwsJq_XpnX0GNgcq-ZL8xUb9ySVxn0JG1QBc42vdw&oe=69A96DF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=150zkhSWDnAQ7kNvwGdnrcX&_nc_oc=AdkNruZOFRELyKF3mVbh9oKFFYYWWpXR8zsWrJkLa1NFHPxS_NlCw5Oq-scOpkUKJAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv8F4g3QTeGVOILrrgD6bJsrad5saXoGsXqLTfzoUFRnQ&oe=69A98375"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1LgAEqxUdXAQ7kNvwGp3s9r&_nc_oc=AdlT8SboTNUco-2Qo9Imh4TBacUxDOAC6boUNPuBfJ44kvHEHSSf-jpEvb6dU7FHmZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftbT7zpJyV-5IxIqzyPQ-UcPEyRpzoXNcjbigVyGs421A&oe=69A9629C"}, "is_concept": false, "is_test": false, "is_
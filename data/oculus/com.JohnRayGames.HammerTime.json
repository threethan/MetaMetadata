d=6e7a0a&_nc_ohc=o4YuwtDrXC0Q7kNvwHoETpj&_nc_oc=Adna9kdvYthtBQyJ62AU9hte3-YqNaKp0nk0Ad3f-n5Dyj5NG1LxWaJqnz_HjHbinoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmXZoA5tPPQvSzT3m5CD5zwwAX6qvYrT9NPn2KotvyIg&oe=69A0370C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxR48UtxTrEQ7kNvwF5M9Vv&_nc_oc=AdnxP-pCX4apsJTKMvOLRMPiCa0QvzwzsgtIGQx4SYu89sEHweXhO-LVpX2ELbi2DT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvDFEoOxZI_1bKJZKlLvt122QHw3CBHSVKFLK1WJ5J1Eg&oe=69A03372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8iGoW4BQzwQ7kNvwF14iyF&_nc_oc=AdmUbT-Jf-szAj4qGsm9A8k4PobciuIYUIHuMNkSvuIn2wtHnJVUJdTbVunIqtGBBqs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAPWj_KpmbJLYYozpjkBN0j3VYGSzB9AMz6dYCOV4YDg&oe=69A048F5"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZUjals-i3wQ7kNvwH4DiWA&_nc_oc=AdmythtjpvpUTmezWSjhwrtzTUxjslviSbgarvTKl-JaRqnRiIUc_SZbhJq8PWQMeAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afssb4tQge0RSGPNCVYwqHM6TyiAKE_4SSwfDhP64xPU9g&oe=69A0281C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hammer Time: VR Platformer", "platform": "ANDROID_6DOF", "context_category": {"con
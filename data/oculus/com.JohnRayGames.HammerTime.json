/t64.5771-25/38974738_416159510283723_7195158608165123614_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60E7Zx0tc5wQ7kNvwFBRGS2&_nc_oc=AdkNiXn0CpOfXAjn7loSKbJ00QCII5ekcNxwh7NgIAApyDi4-euNVZG6F6I6dCuCXM0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy2KqcOAbyxtYlZKWReSxVc693VgSUbn-Hz7ESBOM0P7g&oe=69BBE68C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CuGm95JjLUQ7kNvwHQmAV3&_nc_oc=Admrm3Apn2X9g5JX01Vi5RGEU-rquCT_b4A9ENcQOSRx-32BsKxvo8ipQGWTo_-V7u0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOSC8gAV8u67KtT3C8oNM6HMMYOEuFSOQE7VtYoKMrOQ&oe=69BBE2F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gx6_ifIi9FcQ7kNvwFYlJyV&_nc_oc=AdmsbN1XSlCfl0hwJYTIpzrdzriuECKCdLVvwhop5HoAr-KCNE-rljhAhyLx31CWiis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxb_hpSn78GIuv9yOzLd-fFk1eXdOUnyBazBYfyzqL-gA&oe=69BBF875"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeUEx6HTnRAQ7kNvwGkZ6Pk&_nc_oc=AdmBg_rpSO7oAfVpaBYu8_k9dtqy_aUafwGmQ8kYeKaBO52Q3IXEcmbzQxnQ4CEt-88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2_QapirFA24BoMyBNlc8MKdZeJQRoiEX2MfEZ2aFDig&oe=69BC0FDC"}, "is_concept": false, "is_test": false, "is_
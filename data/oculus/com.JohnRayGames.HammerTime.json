d=6e7a0a&_nc_ohc=o4YuwtDrXC0Q7kNvwFoVTLK&_nc_oc=Adlw6gBflhXkwhv93wZahnuxuMLaIGcKAf0PI-nOUsmxmQ_K8y2ovQy6SdK1r552HrY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfumatAXpdTQgOpV87mrkKQijF-zZevSL-77l83YyMmpyg&oe=69A1888C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XJLj7M4h_AQ7kNvwG7X5it&_nc_oc=AdmJPS-bka_lfefrgj9vyyJSDPbfScocyIjs19PFI-fQm8YoJBnK8AKNvgzQwbY6taQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Aft37jV1Iqea_N4uy6dRUPh6h6VOh39iUsg701C2k0-2Jg&oe=69A184F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8iGoW4BQzwQ7kNvwEDnqEl&_nc_oc=Adkg1q31oi60tubm96B3of-uZJNGVzaP6zMBHDldIIJNqGoffaS94kjuQcu5BptF6bQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvfIkw7_R_6SMHxUksECl9jOgDfiw8brHVwN9v2o6pVYQ&oe=69A19A75"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZUjals-i3wQ7kNvwG6h0zj&_nc_oc=Adn2nqD-_W-Kc0rfQXaccVofv7j3QRUQSYW9TbqvZeIEcJYZ6ccw_xRhPJW38D7pP8s&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftl7thiJJzPZ4quRzdQcAW9DA607bLYrZ3rQUoBw85n9A&oe=69A1799C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hammer Time: VR Platformer", "platform": "ANDROID_6DOF", "context_category": {"con
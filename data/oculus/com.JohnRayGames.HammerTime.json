d=6e7a0a&_nc_ohc=zbj14sZZB1YQ7kNvwHLkM-w&_nc_oc=Adk86cHVISsVaJAj1EFYQg4cQ9SdmWrTwJCYilLiwcO-7R9B0e2CQCPzWTSRCKj5mUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuM0SeiKSTYy0m_3WC-sOg2vw6PBqBRmzt3EYuMlgXzhQ&oe=69999F8C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlSETdKZXAEQ7kNvwFEy_Ag&_nc_oc=AdkDwoSnICNMMAUT9wMmqhnlR7HBKOe1z-g_dUDewU9NhMUOw8dQnGdUMYJCgAgpREU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPrLxaea5upfOA42ZD6pJxfJ9Kx9Wgh1dq-8_3QvdAWg&oe=69999BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsXG7tqbeDUQ7kNvwHhnz3Y&_nc_oc=Adk2AVgejBC8qDVQhoKNY6gYEC4M7KLXdUcloTigtThu2xClSVjLB5fyrKhzhXxgBko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvH_4XWQZdLM3l6SuzBaQ6YP3tFcMyeV_TIeeqFzL0UHA&oe=6999B175"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozlyy-2aG-IQ7kNvwF5Jx4o&_nc_oc=Adl5tfTo-Emgcc1CkG3cmiqHnWGTOhYU1dusJWEnR0ZInseWhf-c1U1MMsdpB2mtnSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswivJfKrlLiJ-wWDcrrxFUm-Cp1AQGrUa-j1FoQeMyCw&oe=6999909C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hammer Time: VR Platformer", "platform": "ANDROID_6DOF", "context_category": {"con
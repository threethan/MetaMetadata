d=6e7a0a&_nc_ohc=yj5cvMMXqHMQ7kNvwExoNUi&_nc_oc=AdpFvWTkj-Dy8ZB9IpjLMBbTmD8yp0pH6bYr99_mNjwsooppQq-qAz169E0AhiFSPN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2veiVEERmpRKJYKqT9yO7zAE6cm9qUMHmsxcNjLmlRow&oe=69F0A28C"}, {"file_name": "3.png", "id": "1158649528341650", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031618_1158649535008316_3821315598928508434_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6P3tBD22PsQ7kNvwGQlKbe&_nc_oc=AdqHKAF9DSR2LVA1tp2hCPmWU0EhHROSXx7a2bYvInb-J1RZXWKj7jdx1WDuyVAEU1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ypFw5uKBDNlZ8ulPg2l6LNh0LB_iBW1Yzi7KOXhhGRg&oe=69F09EF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "738182480790918", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035453_738182484124251_1738354868188433945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKV0tsNK2RIQ7kNvwE4abyu&_nc_oc=AdoNWepzehgFKfh5dqZDhqtoSse7K4dqL0vvuG8GNViI5Ayfj76grGCeMaWhE1kAwEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1IJdXbuF6rLhuVxJNCH7fQ3GsJ0ybw6WJqcJyav8Ep5w&oe=69F0B475"}, "display_name": "Hammer Time: VR Platformer", "keywords": ["robots", "alien", "retro", "action", "platformer"], "long_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels.\n\nRandomly Generated Levels: Experience fresh challenges each time you play.\n\nExciting Gameplay: Smash robots and collect gems to open gates.\n\nUnlockable Hammers: Use your collected gems to unlock all 12 unique hammers.\n\nHammer Time is a joy to play and a challenge to master, perfect for any Meta Quest owner seeking thrilling VR action.\n\n", "short_description": "Hammer Time: Smash and Collect in a Vibrant VR Platformer\n\nStep into the fast-paced, colorful world of Hammer Time, a VR platformer that captures the spirit of classic games we all love. In this dynamically generated adventure, use your trusty hammer to obliterate robot invaders and gather all the gems across various worlds to unlock new levels."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/hammer-time", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ARCADE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8225192910871367"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982484_1063929070927637_4810610347782275970_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q-RnS1yTZAQ7kNvwFpwYQo&_nc_oc=Ado21tEgyg58qkSYip-z1w0w9WNqGfwTzOoh9FBbEt-YCApXoQjIFygnuMmWPR65zpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Imx1dTDqyk-Xg0D93V61Rk3ylrYH8acpK2n_MW4odGg&oe=69F0CBDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hammer Time: VR Platformer", "platform": "ANDROID_6DOF", "context_category": {"con
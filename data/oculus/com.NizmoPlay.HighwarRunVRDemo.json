: "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/625957865_2410736082768505_3075583499717415746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eD120nqZrTAQ7kNvwHWt7rF&_nc_oc=Adq50mLa91SRtOrPPeezV9FBcc-jD7lVQCl6LMrVQSkWfAr41V-w-_gQ95JgBWIbReM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNe34vTLOLce238XKCs331sfAF_tOqnrybaW_y8CcY-mg&oe=6AC66CA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highway Run : VR", "keywords": ["Racing", "Car", "driving", "simulator", "city"], "long_description": " Welcome to Highway Run VR!\n\nThank you for playing Highway Run VR!\n\nWe're excited to bring you the full release of the game. This version introduces a much more complete driving experience with new gameplay systems, improved visuals, and additional content. While we've made significant progress, we're continuing to expand and improve the game with future updates.\n\n Current Features\n\n* Realistic VR cockpit driving experience\n* Smooth and responsive vehicle controls\n* AI traffic with realistic road behavior\n* Garage system with multiple unlockable vehicles\n* Modern highway environment\n* Improved driving physics\n* Optimized performance for a smoother VR experience\n* Enhanced visuals and environmental details\n* Comfortable VR gameplay designed for extended play sessions\nComing in Future Updates\n\n* Day & Night cycle\n* Dynamic weather system\n* Vehicle customization\n* Larger and more detailed maps\n* New roads and driving environments\n* Interactive vehicle interiors\n* Missions and game modes\n* Further improvements to driving physics\n* Enhanced engine, traffic, and environmental audio\n* Additional vehicles and garage content\n* More immersive VR interactions\n* Ongoing performance and visual improvements\n\n We Value Your Feedback\n\nIf you encounter any bugs, glitches, performance issues, or have suggestions for improving the gameplay, please let us know by leaving a review. Every piece of feedback helps us improve the game, and we'll continue working to fix issues and add the", "short_description": "Experience the  Highway Run VR. Drive freely on a modern highway in VR and help shape the future of the game with your feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nizmoplay/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Nizmo Play", "support_website_url": null, "website_url": "https://sites.google.com/view/nizmoplay/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1185068944694352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1570714471096936_2587389914617785801_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zP1UTGRE_NwQ7kNvwFL_gIV&_nc_oc=AdrfTkGuGOp-lAoYkrjyiEpei7ohPBrko02Kh7uEcW-ImFFL9ku27dnXMQJjYRmB-iA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh0OftDaFogr_wKnBXm7kvYTkOrlrB8Fg4nWOgh0J31Q&oe=6AC6506F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Highway Run : VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1783397460, "lastRevision": {"nodes": [{"id": "11620
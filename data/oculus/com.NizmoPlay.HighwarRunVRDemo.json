=6e7a0a&_nc_ohc=v1ayG9YC9j8Q7kNvwHVfUsP&_nc_oc=AdqVPwZQYDnFx7uohYeDrXumIHF1FUvOq69CAWIH5lb3FR3D3fvlR_MDyoNmVWoMJyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhh9Xk00P44C07EvXIqS00hyX_1RJRNyXSTTzdNEC45A&oe=6AC66712"}, {"file_name": "1000206910.png", "id": "1386866453347094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312332_1386866456680427_8707309475710712953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRUHUoZIYRwQ7kNvwHtca9i&_nc_oc=AdrdY4iw1Soc_CzJd4E4C7a0seQKJO-CMOXztCWwEQ_9IMdtRYoKetZyaToY_6YmWDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmQdjzORNaS-FI-dcd0F06WhyfZSuCSbP87Dj6ihPI6A&oe=6AC64EEA"}, {"file_name": "1000206912.png", "id": "1645485516556066", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311582_1645485519889399_1441942599882426683_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vC7iF4N7qhgQ7kNvwEKbOWA&_nc_oc=AdqL2Z40RrWk6wjc_QjZ_xcDMHUE--j6IoWvH2Sfgx5AVNYUBCGsXcJUXf636MZ15nQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJeftW_IGqlUoQHqK3vZad38bfod9NQNdCSiM2qPKAgA&oe=6AC6546E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highway Run : VR (Early Demo)", "keywords": ["Racing", "Car", "driving", "simulator", "city"], "long_description": "Welcome to Highway Run VR Demo!\n\nThank you for trying the very first public demo of Highway Run VR.\n\nThis early demo is intended to test the driving experience, VR comfort, vehicle handling, and overall gameplay before full development continues.\n\nPlease note: The current environment is a temporary placeholder created for this demo. It does not represent the visual quality of the final game. A completely redesigned environment, improved graphics, and many additional features are already planned for future updates.\n\nCurrent Features\nFree driving on a modern highway\nVR cockpit driving experience\nSmooth and responsive vehicle controls\nBasic driving physics\nInitial highway environment\nThis is NOT the Final Game\n\nThis demo represents only a small portion of the planned experience. Many systems, environments, and gameplay features are still under active development.\n\nPlanned Features\nAI traffic with realistic driving behavior\nMultiple drivable vehicles\nDay & Night cycle\nDynamic weather system\nVehicle customization\nLarger and more detailed maps\nNew roads and environments\nComplete visual overhaul with improved graphics\nEnhanced engine and environmental audio\nInteractive vehicle interior\nMissions and game modes\nPerformance optimizations\nImproved driving physics\nMore immersive VR interactions\nWe Need Your Feedback!\n\nYour feedback is incredibly valuable and will directly influence the future of Highway Run VR.\n", "short_description": "Experience the first public demo of Highway Run VR. Drive freely on a modern highway in VR and help shape the future of the game with your feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nizmoplay/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Nizmo Play", "support_website_url": null, "website_url": "https://sites.google.com/view/nizmoplay/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1162085173659396"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1583964737075
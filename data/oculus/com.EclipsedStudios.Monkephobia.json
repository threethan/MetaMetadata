N2WQB2l5pWz6QrM-niw0yVlYBTiSCrBtS-nzk3zvV5pd350Ry28hQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4flSfpjVwEy_BU3jYhucTpFrMrddYkmrZNk6bG0icJzQ&oe=6A144B8D"}, {"file_name": "Screenshot_2025-05-12_192242.png", "id": "593257557136991", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821200_593257563803657_1743502573912361781_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9NbDtd7q9QQ7kNvwF0ughk&_nc_oc=AdqL4OoyJQB8GF6okv2mTmqJWeLGz3U0HbMdINul0A2fKT-g5b5uFVRlEuQnyuxzNtk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YkZ3vYARAN0-L_imX826QTntXrayMzaeVfRgAU4nlqQ&oe=6A143F82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_3025.png", "id": "679286518177669", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820067_679286521511002_3477351066852010640_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipGYjW6O6_YQ7kNvwGHUitQ&_nc_oc=AdrQDXdyOJbRXf3LOl17EcZZmGWjx1m-gkD-APW6PhYwzyuWGwr3XamUG0fB-w-9SF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mIAUrR_Qmcpol3cUOj9NExxmsdGyCJ92YtK1Aybfs7A&oe=6A1449EC"}, "display_name": "Monkephobia Reincarnated", "keywords": ["Horror", "PS1"], "long_description": "Immerse Yourself.\n\nYou\u2019ve just accepted an offer on a mysterious vintage game. The game is old, decrepit forgotten. But the moment you press start, everything changes. The world around you goes black and you awake inside the game.\nWhat was once a curiosity is now a pixelated nightmare, rendered in eerie PS1-style visuals. The only way forward is through using hand-driven locomotion inspired by Gorilla Tag, you\u2019ll crawl, climb, and scramble your way through a shifting digital hell.\n\nFind a way out\u2026 before what lurks inside the game finds you.", "short_description": "Monkephobia Reincarnated revolves when you (the player) accept a mysterious offer to keep a vintage VR game. But the moment you press 'Start,' your world goes dark trapping you inside a shifting digital hell. There\u2019s no pause button. The only way to move forward is using a hand driven locomotion inspired by Gorilla Tag. \nFind a way out\u2026 before what lurks inside finds you"}]}, "developer_name": "ECLIPSE STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/eclipsstudios/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "ARMY", "support_website_url": null, "website_url": "https://sites.google.com/view/eclipsstudios/games?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9943589865748998"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1990815911448627"}]}, "baseline_offer": {"id": "1990815911448627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749748380, "status": "PUBLISHED", "id": "1990815911448627"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26233625019652224", "version": "1.2"}, "id": "4044826949083747", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9695074243933896", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2623362501965222
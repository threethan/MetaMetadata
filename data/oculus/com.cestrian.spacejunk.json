luscdn.com&_nc_ss=7f20f&oh=00_Af_EkEcZrB7rJTItqkkFifnC6pLyMyKuTj0NpCQ_v06UsQ&oe=6A31447B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_Syrl6t5g4Q7kNvwFfyCo3&_nc_oc=AdqJsx5L_ziCopl2mhmH6ympvjzaf89nrLwmHC7BWEAULgbWYglzAdg70BwLumPBExU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l7nfKfghJJMjaYzpeRxYboCsuRbQdptp70POpomhXJA&oe=6A314905"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-watx9RDdwQ7kNvwHsMXy5&_nc_oc=Adqk1nd2rVrlrueaXA_jT-VtNilix_n6QmzwUId9bGaFr-xb_I7mKPysZr9YWnCMz-Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FpBicYJfe0Dy6FrsD2Yt_ncgPYvqlsODGZxdbmQ7_Pw&oe=6A316F90"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
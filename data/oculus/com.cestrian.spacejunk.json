luscdn.com&_nc_ss=7f20f&oh=00_AQGtQonqOu_50XLBeITrScDuNKsynLJCkLUIpRJSZfhpjA&oe=6A7723FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPjQ94KPrRcQ7kNvwHDiSuK&_nc_oc=AdrZxL4C_iKFYNNg0DvCUzgHKXg6dtiK5BAaflL9RDsset8JVTWN3pHjjvDwL9A3k38&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKw-e0mVueiNXdX4xLs_eKmC3UDS6RcQ_pKsS9T7OSlw&oe=6A772885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_VPonF3DQsQ7kNvwExYJhu&_nc_oc=AdqO36K68A1HEcORKPY25II9JC9EkRTO5Fotmycv73ygRCj861Aue36cHOiAItd-N1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAv_alK_Qhe27iQiqsPOTKOjkDqgmE4ynVBDM-Y3Dolw&oe=6A7716D0"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
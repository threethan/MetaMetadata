luscdn.com&_nc_ss=7f20f&oh=00_AQHkZCFl8roEYlwRaojB-9i_p38BBukv4aMo68nLXzS0tA&oe=6A8AEA7B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E0bb_L9KKYQ7kNvwEBhRUJ&_nc_oc=AdpoPbssIICCu5kpYzLuQ-Xe_m1j283E3DzbcnX02C7pjRgwDzG9UkN_PqqKThmBPZE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqnNK8ofGqBvM40fn4Wh0gCi2zT6ecjSQ0jjMELMfC0A&oe=6A8AEF05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B81IMJtREocQ7kNvwEAyWZt&_nc_oc=AdoTypRA4qTZaQG9DlfnlbHvlDRVghULAIm_JB_x9Cq1TOmLOdUeHZ4iHFyGZRkxk4k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWFTQ3XOs7LdLhhc9-37MkODIlmtlHfYsgngfnhhl_5w&oe=6A8ADD50"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
vmXU&_nc_oc=AdrIU8h50COzta7DmJIxpILYx9Mweh1OzXZNdY7LRXM2CUjpKdYNkg0bCl7Wm9FdW-Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtAms9LS3zqkirCJRbVRs2ChLtjkQlFOWUOrCYkXnYIg&oe=6AFF32DC"}, {"file_name": "ScreenShot5.png", "id": "339808587315522", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_339808590648855_7348019694279176940_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0eB3LDSPBcQ7kNvwFk9N5G&_nc_oc=Adqivf781h8j9QDue-rH0Jkb_D52oN5fHLM0_iGLCyAvwUmLhFkPON7I-iRknLZNeTQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM9QZRSv8DzMZMnVnknfXC5Hc1VVWM9Gc932z3m6AQOg&oe=6AFF3427"}, {"file_name": "ScreenShot3.png", "id": "182597576594931", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974444_182597579928264_1491608471790034217_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxMy_fsEXskQ7kNvwHzS3EU&_nc_oc=AdqSqFittj49QTAL54ARAXOwc_AmzqrPUmN4CoSrk4RoQ8eL5Gv1C7ThcW1rXZ2YZvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCNnM4qwCrPgmlWnYNh0PSkby5rl6gdXm4gEHBTi-LOA&oe=6AFF26BB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVmIyMm0Z98Q7kNvwH2lYgY&_nc_oc=AdonrP4yrnRn74qWvF84Ii2WS_jG-zlR_VMcknPTguKowjtjZe3Wry4PWTRICykvAAo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuANX3bP7GZdjiRLAcQCFeUXPzAQXaBxGPmXTQ2001-A&oe=6AFF2B45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk1k6rPc0lwQ7kNvwHfO2FP&_nc_oc=AdrE_iTXxJaaaRZ4X70gXgweHlx8brf6rOlqw2b1S8_6-bIJVBUU5bFAddGtfc3Jmgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwkbMnK3sFjOEmJv8TGUH9aIYBZJO3LLBXW5T23WzfEA&oe=6AFF1990"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n10 challenging stages for free\n10 more stages available with in-app purchase\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cestrian-software/space-junk-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cestrian Software", "support_website_url": null, "website_url": "https://sites.google.com/view/cestrian-software/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_int
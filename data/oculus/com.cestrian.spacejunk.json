luscdn.com&_nc_ss=7f20f&oh=00_AQA1eBVg8oxfVKwutdBzh--dOmSX7MjMeffcOUFYztuCVg&oe=6A6F3AFB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wd0mJly472wQ7kNvwG5VUcF&_nc_oc=AdqfR0VDDxXCRb-pqhWmh_-gQ9iYZmD1Y0fAzm0Dw7QbOnMQt77g86EN5M90leK9AE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLCr72-gfWkmoIRKujpMOqDfiQ4qLwRfrj4EhPyej9Gw&oe=6A6F3F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvo9qzFMoBQQ7kNvwEg7CLQ&_nc_oc=AdqGVn-6LjkUnoNW31kNXDc7l-UluOV7CUB6GZydqQnfSglP7jJauhwcjYJLeY5hIgk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUv2amfnoJIM9Y8MRz50yC5N5AfH2CFj-C_o8KH1OoXQ&oe=6A6F2DD0"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
luscdn.com&_nc_ss=7f20f&oh=00_Af-1Sg2LLK0y3jUmY9kjl-5alXFIiBOToNs8Gf3uAk4jwA&oe=6A26F0BB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIjdevVRey4Q7kNvwGSkYvF&_nc_oc=AdrKrif-gaGlmArwJ9P9P6zGVTRD-n-yTUmdLOEia8tHdgIjVSWJceSo-4UjUrB7l6Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-So4j0vcueGg3e1Imx-YDqlkQoV7lpCWejbo2L_zzMyw&oe=6A26BD05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P31CCBC406UQ7kNvwGLSoCG&_nc_oc=AdqM3hojRd3XJ-CnnFbtTzG2qPtEPtiWe76jkkjY5WHLbW_KDl8tUPK2hkt6ZApdvpg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mPF8U-2IQDPwkA5IcEAIfJqsKbKA4wrA0rR-XMdq1rw&oe=6A26E390"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
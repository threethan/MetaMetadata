luscdn.com&_nc_ss=7f20f&oh=00_Af6gmPT9vyDKzfTb9AUznqW5jAaiufoSqTSicwOQo79kQg&oe=6A05C2FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ2CNDKrgdQQ7kNvwHB3lbY&_nc_oc=AdrmmzjaBDPzR7W8H_GqYYuK4FlH0NAALxJyYBWDpbRRQ7z4cdoo37PloVc2nXn233M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52xT3SnASTGRFUfWkmVvdKoS6JROZF-0zyGLI3oNh7Zg&oe=6A05C785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2aCOy0PjmEQ7kNvwEZhRSn&_nc_oc=AdpZq2FeJfgjxEA93I3JFX0yYOwnMCkM8hGfQ7yYPSlzD8ACDVV93NrP9Sz9dMdI6fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dSEU1ISh0eHWIX4mU4NusG2n_0Rp-TJiTq_iqcJpQGA&oe=6A05EE10"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
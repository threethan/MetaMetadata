luscdn.com&_nc_ss=7f20f&oh=00_Af3QFCmL5fZ5M4XdpJkj4WdneSQKZE4SfGTdDHjeNI6XVw&oe=69F34DFB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3BAItAuHhUQ7kNvwGEi32C&_nc_oc=Adp5h9Jafj26nmFwfOP4WXs87QF8-XN81IEOnq-J2z9g9beGnoeMYKN-pxxPj8YdPD0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TnyfEFAlfthsklZCgTwokYgdhLHwriL-gzTJ4A3crLw&oe=69F35285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UM6ezXiJd5cQ7kNvwG6jSGk&_nc_oc=Adq7OJK_qqrss-SmMAku99d0lTkMatn1o0NAkc6atRHDo88I8EpbtgVuzKtbL_sPl-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nH5qQ9RlghS7OjPDJfEdGo1fVK7IH9ZOMmXBZLDsKXQ&oe=69F340D0"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
405103300608_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sAHz5HTxxgQ7kNvwHrf-IZ&_nc_oc=Ado9dESj7pdGfy2wJhewr5qU3sSS49inG08MK-IOz1b2y_Zh40_IDGLZ2b73HUUOI_I&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbxvOox_XCQzL72mnuUtAkQLC6CBHCsbcbQk8gJO0hKQ&oe=6B086E20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/pmAnrh", "id": "156014975921448", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75371507_156014979254781_6908529318809305088_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEBxvmS512sQ7kNvwFqzG-i&_nc_oc=AdrnlVIbuB9zur1XgHwkPEUXmTM3X5omcUFoyJRuglEnmFaLodZQdCZK2O0gywmd9C0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrQV1hPHp1LSZUZ-Mi-rgfGPS0XK0gdFkIxyRa1Po5-g&oe=6B084271"}, "display_name": "Space Junk", "keywords": ["space", "junk", "magnet", "debris", "shoot"], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n10 challenging stages. \n10 different music tracks.\nOver 30 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\n\nMade with Unity exclusively for Oculus Go.\n\nPlease leave review feedback so we can make improvements in future versions.\n\nLook out for more stages and new locations coming soon.", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": "John Rowlands", "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "developer_terms_of_service_url": "http:
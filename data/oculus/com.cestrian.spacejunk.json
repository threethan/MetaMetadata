luscdn.com&_nc_ss=7f20f&oh=00_Af2ZqBM1mHpvH1DKj_Zyb1O8SnuCyavR5ljcgEdjB64HgA&oe=69EF597B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMFPXWucs9AQ7kNvwH_FpIy&_nc_oc=AdpkeH6srAL2U2N3SsjZySc6Gf7D0y2fpDe-928Ufhmw9fPhB6PRLI0hysVEDfnnnGs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28fAy5lNfZqnXTRqra4pRGdv7P-72xhnoniVxYXs8-Rw&oe=69EF5E05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB3mr4ca_MEQ7kNvwHZAmCP&_nc_oc=AdrUt4scf_ujJ3LpHpaQdCk6Q90b7GDCBvLkOE2P2dmB8xlwNK9hU23iJT4eJoF5nlU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vy86-Z-bQ-YNjPSd3SESRz4Tz0_rmfr0FldIVmSnRhQ&oe=69EF8490"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
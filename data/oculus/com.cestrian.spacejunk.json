luscdn.com&_nc_ss=7f20f&oh=00_Af8qpk2bT89tNsMr_9qjgnsdpMZ5ZxSrpVq7u57M1ETH4A&oe=6A295B7B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsvJL-CJz3kQ7kNvwHa8c6g&_nc_oc=AdoGPyIkg0_GnVPolMPrqR4DZ_VMAdmzbyi-Bb4KS1EFSl3miJVGp6pvCDVN-kkWwkA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M4esMSxgx0MlTvg5ki9JJ-_onlGR6uxH3cxOrVA5-LA&oe=6A296005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ulkq6zyUWv4Q7kNvwF70z9y&_nc_oc=AdoKeOnYP8jyojoldPZJ3zuQn1aGph9rUX-8xb0p8P8XjpKeChR5zTf07cKCDF_lFdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A2Kfa81KchGnthhvhFLbWSAdjpqe1SMPGggJlebNyGw&oe=6A298690"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
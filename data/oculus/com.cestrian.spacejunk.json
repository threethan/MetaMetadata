3l&_nc_oc=AdnXZMDXeCf5T0nTIA6pSkxgG2fIVdRD94U9AFlBwJ67LldVfhOCnGrNj-3fZ6AbJPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu1HcFJBo8EonuNPNUw7hNx-j1Qh1B4v5dzUaop1MkUtg&oe=69985B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItjBHPWZ6DEQ7kNvwEQd5j4&_nc_oc=AdlnoF21CUNS8z2rMHO5YWTJU17Iz7nWtvrksN_bmyGoOUrDCXkTE278Go6h2Sw-qMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuuA0lIxkoueRLiVPqXwYQZg3-tkDAmm-S28WTinFuTtw&oe=69984950"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "developer_terms_of_service_url": "http://www.cestriansoftware.com/space-junk/licensing/", "publisher_name": "Cestrian Software", "support_website_url": null, "website_url": "http://www.cestriansoftware.com/space-junk/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categor
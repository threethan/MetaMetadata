luscdn.com&_nc_ss=7f20f&oh=00_Af9vN1lm5PO1W1AC-bwqoocrx2D-kheIq0F5jp0oOtyVqQ&oe=6A2AACFB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsvJL-CJz3kQ7kNvwFWTLpa&_nc_oc=AdqlSTClkNJNqOo5SeKwBfCmO3UQ9-jrv0xgh5QFn5stpoCxyH2D8KPu7TJm8GJRFC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GRwVaZicH1Zywh2zEP_HsvKDCqqC6tFIK1G4Pj_Al1Q&oe=6A2AB185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ulkq6zyUWv4Q7kNvwH7amps&_nc_oc=Adqp8wIEiRf0-9CCZVLjlKQ1QBjahcAHibAFc4vPstqKYJlrJ7ZxY1dhHXfvYkyPftk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SM-U0IctqtoV8VMdIP9cB3tZi0IXyLYusWtNeDiiGuA&oe=6A2AD810"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
luscdn.com&_nc_ss=7f20f&oh=00_AQEQ-b8N-O7TV4znc_6EF5Xbx64XJhG8r5RiT8snrLEYHw&oe=6A86F5FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQLXsp-_8ZcQ7kNvwH6BbZp&_nc_oc=AdpO7Er-j7m5FkczlpsNUZJxF2gZAFwnN9JXkz0FowwS0BKHIN4kJjIMP6RDL48Bw1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtbKEe6rx7dOX4KPvShAGvhp_8GDtiv_ikIflWnf0Nkw&oe=6A86FA85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvOQ1VP5unYQ7kNvwHf4RM6&_nc_oc=Adr4K_1DRh5BYlZ-R6X8rbSVZgkFDD7_3mqU7CzEBwtis4xSswUZQCoV9pLaahs9jek&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMMdOMowRHHROD8gCY149tKMZZvoJqV_WlzVzgXXrSbQ&oe=6A86E8D0"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
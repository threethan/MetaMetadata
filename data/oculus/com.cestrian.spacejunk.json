luscdn.com&_nc_ss=7f20f&oh=00_Af1F7JdktQF9w72u8jbxnkIelx_U6k8PtH7lig7g7BzK2Q&oe=69F49F7B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3BAItAuHhUQ7kNvwFrQ_Bm&_nc_oc=AdrGj3A5BMDA7OQhN9jkrcjemRPJnamfsA3Tp08SJeLT3wLbEETExkKJf1DkQbZX_GE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2f5ehuJKlNu8VJwK-nKFXCqzqSw3sik6h2toX5CD7ECw&oe=69F4A405"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glMAdGzSdlUQ7kNvwGu9I-L&_nc_oc=Adp0_dinwRJfRe7vpUfeqY-F08KgKApDgvbma10vWWkvA11Ao-UyMMi_IoS29cqHVzU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hWU40AzOUR26dG089OiFkssw1Y64Xgy_-_bhPs0T8bw&oe=69F49250"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
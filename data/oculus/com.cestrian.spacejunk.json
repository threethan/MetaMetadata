8529318809305088_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GQ1THQoHesQ7kNvwGS3kHD&_nc_oc=Adn3iKQandBIyeUNjoiWj7QXr8HfF5IHTrv-wJIud7Cq4XTSfCSG58TIS3aJSxg_d3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2Mf9RY9z_Wd5_oomkUcValNk-6alEFp9JYSGx01MtpA&oe=699F0771"}, "display_name": "Space Junk", "keywords": ["space", "junk", "magnet", "debris", "shoot"], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n10 challenging stages. \n10 different music tracks.\nOver 30 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\n\nMade with Unity exclusively for Oculus Go.\n\nPlease leave review feedback so we can make improvements in future versions.\n\nLook out for more stages and new locations coming soon.", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": "John Rowlands", "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "developer_terms_of_service_url": "http://www.cestriansoftware.com/space-junk/licensing/", "publisher_name": "Cestrian Software", "support_website_url": null, "website_url": "http://www.cestriansoftware.com/space-junk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": 
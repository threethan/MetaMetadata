luscdn.com&_nc_ss=7f20f&oh=00_Af0tUwZ8QFAVlu_na-rTUkQJPXpA1PLqwQcEUct5CUetFA&oe=69F893FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_M2HKbD0D4Q7kNvwEFn29B&_nc_oc=AdplOpki3c6trfRyHCgzuXUamzFn5yohqSN-cy1n8Iqdu6xOr0wLEE8v1MCWCgGzOYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aPx4bvGIPZG9TdwKo0nvEEFjpKPkqfwynNe7Rf1APxg&oe=69F89885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqoCklQuPkEQ7kNvwFTxwW-&_nc_oc=AdpKnm1MXBFIA2tD1p5XgzXf8nYfgj27mthT1u_JcHlGE1J7o7DTI28w6sv8SLjku7A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eGUNShvc-XelqVFlzvm3NYtuRnRTU_WamIHi_hWcO8A&oe=69F8BF10"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
luscdn.com&_nc_ss=7f20f&oh=00_Af5k9sxNTq3Q_vL2yTXrZPOQgWuVV-uxWJs-ZNj_9UTWCg&oe=6A1837FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWTGWt0nn4AQ7kNvwFsdKdg&_nc_oc=AdrqmpFMkFG1-aqeWGSntZTcpHjaanB0s7zAdbGhWISzfS9kLkT4GpFoIHw1NQPjTx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nioHpVl9SKKO3ZsEe52fMW0V7F3-Qhw0Jkbul8OAgNA&oe=6A183C85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNLVViDex-wQ7kNvwH2YSEJ&_nc_oc=AdpPMYrbM_xUcMAV_ikoeT9tjRxrAMHNOyETLBEQlarak-dCYsruTKq3fBV-r3mafrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QKbt9apdma5NN5z7yJWm0ML0PHDN0LWIQyGbz51qUEw&oe=6A186310"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
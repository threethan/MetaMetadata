405103300608_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBd_Rsf_ZLAQ7kNvwFFDJFd&_nc_oc=AdoDD_umKb0RawOr2lWmc2NmyP-yzcECwESHGSs63X8mD5A3HU_AC6FsVbqxJYz-Ayk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvNycbKi-zN7LgSDf27APG6_nB6FwqEKIm6ZT5JHeLdg&oe=6AFB3F20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/pmAnrh", "id": "156014975921448", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75371507_156014979254781_6908529318809305088_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz7l9GSvSWQQ7kNvwElb08r&_nc_oc=AdrzsXIzJgxIX0F-dUu_AGO0hyhhk4gMn6YuuYNb4Yikqxg4jXbK6P3Z0KtUfs4VDqE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcveN7uhcxQlWp_q0kAgJGXKJ4BErGusP-raFGRyjWRA&oe=6AFB4BB1"}, "display_name": "Space Junk", "keywords": ["space", "junk", "magnet", "debris", "shoot"], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n10 challenging stages. \n10 different music tracks.\nOver 30 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\n\nMade with Unity exclusively for Oculus Go.\n\nPlease leave review feedback so we can make improvements in future versions.\n\nLook out for more stages and new locations coming soon.", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": "John Rowlands", "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "developer_terms_of_service_url": "http:
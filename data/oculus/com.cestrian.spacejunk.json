ontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TIZ7YuwTZf8c-ko3u7UPve6ExyzksEa8IngSSXgEk7w&oe=6A11A07B"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpyQHvpTeScQ7kNvwHS9s__&_nc_oc=AdqqbChyfnnAFkkIv312HLckZCLsVWgJvwQtIskIN8KAxkMnrE_PrBRyDMEoFCX6PeU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XZm1QyCQ-6wxMLFajSGpIHSsSEPYZ37s8MWt95FDYhg&oe=6A11A505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfYJlEvoo0Q7kNvwFrFvEn&_nc_oc=Adr9GqTptEFmXSpecYXEgt8kGWLYK1LcIY4TUQhNZLR7xmWfomS0xlKw90PbZomruX8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CJvN34dnhqNVeVYqlCJS6Op8EA_MVWRx9Gi0RAHBOJQ&oe=6A11CB90"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/pri
luscdn.com&_nc_ss=7a30f&oh=00_AfwldXvRiu5vvDdygzCPTTq0JvO-fFZ046LOyvWLsLFf5A&oe=69CE63FB"}, {"file_name": "ScreenShot4.png", "id": "147281473885122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982441_147281477218455_2707899911583084471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN6tsrR8AT4Q7kNvwGYZlSE&_nc_oc=AdoUIF4YKrLPYF18zD-9iZ1Px3TQxVo4asc5ZCMLswH2HU5YQUTz9B8Qiw_nASLj9sQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoeyShYkWKs7jJNUBEDq30SFr5gja3ygf-EEWtFgSUdg&oe=69CE6885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SpaceJunk-Landscape.png", "id": "466040047768418", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974591_466040051101751_162512089677994575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTpxQAfTYbgQ7kNvwHNIX8W&_nc_oc=Adq9tonpnRGyFCZUmVMlpZoFvVZztzucPgvwpRxvdl5p5K1BC8RnrCVbQl21memqEcw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKsB9NjtXBW3xm19c-hvcHoVEHB_jdpuGW9W0Twp3o3w&oe=69CE56D0"}, "display_name": "Space Junk", "keywords": [], "long_description": "Space Junk is an arcade shooter where you blast garbage and magnetize metal trash into your ship!\n\nTake on the role of a Space Junk Operative and work in zero-gravity to clean up orbital debris!\n\n20 challenging stages.\n12 different music tracks.\nOver 45 minutes of original game play.\nPlay again to beat your high scores.\n\n\u201cThe year is 2054.  Orbital debris is at critical levels and someone must take action.  That someone is you!  Empty Space Incorporated was created to clean up all the space junk orbiting the planet and make a profit in the process.  Your training starts now.  Good luck, Space Junker.\"\n\nPlease leave review feedback and share what you think about Space Junk.  ", "short_description": "Shoot asteroids and collect space junk with a magnet!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.cestriansoftware.com/space-junk/privacy-policy/", "deve
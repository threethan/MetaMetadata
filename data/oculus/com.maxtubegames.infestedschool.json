g?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uST4ag-GQq8Q7kNvwHMphUL&_nc_oc=Adp0yWLflnNivtxhKuuB_ihHAV-OaXtRFt49R5idooRDRc_ARNO2Pzbl2bDvehJMdsI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIVdBjaX9JKXX3FSU-JC6aT4nx9mI-RX34q6NjW54c9w&oe=6B1053CF"}, "display_name": "Infested School", "keywords": ["Horror", "Zombie", "Shooter", "Survival", "Action"], "long_description": "**WELCOME TO INFESTED SCHOOL!**\n\nWhat was once an ordinary school has become a terrifying place filled with horrifying creatures. Are you brave enough to face what lurks inside?\n\nIn this immersive VR horror action game, you're armed with a gun in one hand and a powerful axe in the other. Your mission is simple: fight the infestation, defeat your enemies and earn as many points as you can!\n\n**FACE YOUR WORST FEARS!**\n\nGet ready to encounter zombies, terrifying spiders, cockroaches, snakes, rats, lizards and other disturbing creatures throughout the school.\n\nEvery encounter brings a new challenge, especially if you're afraid of creepy-crawly creatures!\n\n**TWO WEAPONS, TWO WAYS TO FIGHT!**\n\nFire your gun to attack enemies from a distance while using your axe for close combat. Stay alert and react quickly!\n\n**HOW HIGH CAN YOU SCORE?**\n\nEvery point counts! Keep track of your current score and challenge yourself to beat your personal high score.\n\n**AN INTENSE VIRTUAL REALITY EXPERIENCE**\n\nInfested School brings you face-to-face with creatures that might make your skin crawl. With immersive VR gameplay, the fear feels closer than ever.\n\nAre you ready to enter the school, face the infestation and set a new high score?\n\n**INFESTED SCHOOL \u2014 FACE YOUR FEARS. FIGHT THE INFESTATION!**\n{1406379857935799}", "short_description": "Enter a terrifying school infested with zombies, giant spiders, snakes, rats, cockroaches and other creepy creatures! Armed with a gun in one hand and an axe in the other, fight your fears, eliminate enemies and score as many points as possible in this intense VR horror experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publisher_name": "MaxtubeGamesVR", "support_website_url": null, "website_url": "https://davisamuelmaxkids.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1412613825270201"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "981290411192807"}]}, "baseline_offer": {"id": "981290411192807"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794280440, "status": "PUBLISHED", "id": "981290411192807"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1413427765188807", "version": "1.7"}, "id": "1927521815340221", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1412613821936868", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1413427765188807"}, "release_status": "RELEASED"}, "binary_release_channels": {"node
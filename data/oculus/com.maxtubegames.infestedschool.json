_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCfKfJaIpeAQ7kNvwHq2EJF&_nc_oc=AdqGqz_SyRW2PGFF55VU_7SyZNujOaG78iTVvufuNqRK6KlgGFx1hSvg_Dkf3hRNttM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQChgUYPJt7IWWZhQVr0hpaNXhSNVAE6kKKPMXivcMc-Q&oe=6B0C52E1"}, {"file_name": "com.maxtubegames.infestedschool-20261107-011202.png", "id": "1130273832920009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1130273836253342_6236926475287664566_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0v93bavS2xgQ7kNvwGBZBrm&_nc_oc=AdrfuPhD8xruCX3mslvqNydf2b_N7OA5d_sSUopEPt7-zTEY5k7tTRmi_wmX0IPJaGI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZDM6BECrluGl5GupUaq0ebLg8bbLoBR5xl8kF7Y7ihw&oe=6B0C50DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Captura de tela 2026-11-07 020024.png", "id": "1902493921133078", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831299_1902493924466411_7179822747106252394_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYg65BeeZYsQ7kNvwFFp8AF&_nc_oc=Adp5j1eIY_a7MD4QCI_HRFs6NwqF-FE_Habadi_EIW8Qh5dsicktyiLp-FZ1Sgi8lk0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzBtY8GKZXPlM_Xy4KMuK6m0B0mt70EMnEivdMz06tCg&oe=6B0C5F4F"}, "display_name": "Infested School", "keywords": ["Horror", "Zombie", "Shooter", "Survival", "Action"], "long_description": "**WELCOME TO INFESTED SCHOOL!**\n\nWhat was once an ordinary school has become a terrifying place filled with horrifying creatures. Are you brave enough to face what lurks inside?\n\nIn this immersive VR horror action game, you're armed with a gun in one hand and a powerful axe in the other. Your mission is simple: fight the infestation, defeat your enemies and earn as many points as you can!\n\n**FACE YOUR WORST FEARS!**\n\nGet ready to encounter zombies, terrifying spiders, cockroaches, snakes, rats, lizards and other disturbing creatures throughout the school.\n\nEvery encounter brings a new challenge, especially if you're afraid of creepy-crawly creatures!\n\n**TWO WEAPONS, TWO WAYS TO FIGHT!**\n\nFire your gun to attack enemies from a distance while using your axe for close combat. Stay alert and react quickly!\n\n**HOW HIGH CAN YOU SCORE?**\n\nEvery point counts! Keep track of your current score and challenge yourself to beat your personal high score.\n\n**AN INTENSE VIRTUAL REALITY EXPERIENCE**\n\nInfested School brings you face-to-face with creatures that might make your skin crawl. With immersive VR gameplay, the fear feels closer than ever.\n\nAre you ready to enter the school, face the infestation and set a new high score?\n\n**INFESTED SCHOOL \u2014 FACE YOUR FEARS. FIGHT THE INFESTATION!**\n{1406379857935799}", "short_description": "Enter a terrifying school infested with zombies, giant spiders, snakes, rats, cockroaches and other creepy creatures! Armed with a gun in one hand and an axe in the other, fight your fears, eliminate enemies and score as many points as possible in this intense VR horror experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://davisamuelmaxkids.com.br/politicadeprivacidade.html", "developer_terms_of_service_url": null, "publisher_name": "MaxtubeGamesVR", "support_website_url": null, "website_url": "https://davisamuelmaxkids.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supporte
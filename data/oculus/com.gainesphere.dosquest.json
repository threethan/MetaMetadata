0_AQQR8SuSCTIeIEy4S4B8RQDTw4N_y6rn_3TJS6jLTj244g&oe=6B0C68E6"}, {"file_name": "shot2.png", "id": "1601796521630033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1601796524963366_8238975125094311076_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1-OBHgxieoQ7kNvwFCY4UC&_nc_oc=Adpmyxy40soCrY0fnopED322b8qTJc5T2aVfarnwKSiBZVc2K3lyaKTiRkPG0b-S8ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUwBDqFs0X101dHyoS0cnkL4u5BMNDW-sWaKcyAlutVw&oe=6B0C4FCA"}, {"file_name": "shot5.png", "id": "1447093710730245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1447093717396911_5648553696192289985_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ_0Yj0yXw8Q7kNvwFF02E-&_nc_oc=AdoXqAQ6V3JWXOn89sSf3s4u4g18hsEGL5Mk7rE2NAl5zWyeA7zSAAGQ5i-rgksF90w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyZKzplX_CXSZh84BMrAtBKkrNd0f7WOwcay3saqks5w&oe=6B0C527A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOS Drive-In VR", "keywords": ["dos"], "long_description": "DOS Drive-In VR turns your Quest into a DOS games console with a drive-in out front.\n\n- A real 3D drive-in: eras, seasons, golden hour or night, a snack bar and a projector beam\n- A shelf of DOS-era shareware: tap a tile and it downloads and plays\n- Play your own legally owned DOS software, added over Wi-Fi or USB\n- Giant arcade deck in the lot: a person-size stick and 8 sewer-cap buttons you stomp or slap\n- Get out of your car and walk the lot\n- Head look for mouse-look games, aim the controller as a mouse, a full VR keyboard, save anywhere\n\nPowered by DOSBox-X (GPL). Source code: github.com/gainesphere-studios/dos-drive-in\n\nThis is an early build. Please report what works and what doesn't.\n\nDOS Drive-In VR isn't affiliated with the DOSBox-X project. Made by Gainesphere Studios.", "short_description": "Your DOS games on a giant drive-in screen. Park at a drive-in at night, pick a shareware game, and play it from your seat, or get out and work a giant arcade stick and sewer-cap buttons in the lot. Powered by DOSBox-X."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gainesphere.com/pages/dos-drive-in-privacy", "developer_terms_of_service_url": null, "publisher_name": "Gainesphere", "support_website_url": "https://discord.gg/7tDn2AAXEC", "website_url": "https://gainesphere.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1474680089058665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628447_2158594578875946_1666062690220323490_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6tzlNXlfRUQ7kNvwGKRjNF&_nc_oc=AdrR2P9wxeIpJYqIKKlA0Rwd94C8-b8VG8-6-Iy9RLJpuyOQWQRQpN78L1-_74OYbDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhTkh0rqTw2mn6tsY4JVtRB9me36VfeC8LVVuluSoOtw&oe=6B0C6001"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DOS Drive-In VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1795030020, "
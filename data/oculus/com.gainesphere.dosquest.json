_JOQ8JBUMtLImRaASLM2ebo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQaY4C5y0B_Nq3FOQRXWhkO4bcRpKqdoCxto-GOeC2Aw&oe=6B0F0BE6"}, {"file_name": "shot2.png", "id": "1601796521630033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1601796524963366_8238975125094311076_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsNJrNPzawYQ7kNvwHypn9w&_nc_oc=AdqXbjCkfc-RBJqGJvQfEe08C1NkmXZNrY5Rxg3rED_6OSMBVdrIC8SDg6BxApA4En0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUuUif3KoET9hAW-JfXnLni5vrPBXubEIBA_djWDTuP3g&oe=6B0EF2CA"}, {"file_name": "shot5.png", "id": "1447093710730245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1447093717396911_5648553696192289985_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ1w7a8UMxoQ7kNvwFBWfKE&_nc_oc=AdrQg7p9sZzClE0zQT0Zy9Pt7pn7Oa1u9C1d00q_-Ukwd3DKwo94gjCeiIG0FFbODKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDm8S3AzJb_TT-j1jHH6nMHjuv2k_esxtXu641D_jEkA&oe=6B0EF57A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DOS Drive-In VR", "keywords": ["dos"], "long_description": "DOS Drive-In VR turns your Quest into a DOS games console with a drive-in out front.\n\n- A real 3D drive-in: eras, seasons, golden hour or night, a snack bar and a projector beam\n- A shelf of DOS-era shareware: tap a tile and it downloads and plays\n- Play your own legally owned DOS software, added over Wi-Fi or USB\n- Giant arcade deck in the lot: a person-size stick and 8 sewer-cap buttons you stomp or slap\n- Get out of your car and walk the lot\n- Head look for mouse-look games, aim the controller as a mouse, a full VR keyboard, save anywhere\n\nPowered by DOSBox-X (GPL). Source code: github.com/gainesphere-studios/dos-drive-in\n\nThis is an early build. Please report what works and what doesn't.\n\nDOS Drive-In VR isn't affiliated with the DOSBox-X project. Made by Gainesphere Studios.", "short_description": "Your DOS games on a giant drive-in screen. Park at a drive-in at night, pick a shareware game, and play it from your seat, or get out and work a giant arcade stick and sewer-cap buttons in the lot. Powered by DOSBox-X."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gainesphere.com/pages/dos-drive-in-privacy", "developer_terms_of_service_url": null, "publisher_name": "Gainesphere", "support_website_url": "https://discord.gg/7tDn2AAXEC", "website_url": "https://gainesphere.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1474680089058665"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1679243676881928"}]}, "baseline_offer": {"id": "1679243676881928"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795030020, "status": "PUBLISHED", "id": "1679243676881928"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1474833509043323", "version": "0.7"}, "id": "2377467989661119", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1474680079058666", "is_concept": false, "latest_released_binary": {"__t
first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25204663795872011"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1928913551324748"}, {"status": "PUBLISHED", "id": "1214440247537702"}, {"status": "PUBLISHED", "id": "1930057337886747"}, {"status": "CANCELLED", "id": "2099211900484984"}, {"status": "PUBLISHED", "id": "1066879825501200"}]}, "baseline_offer": {"id": "1928913551324748"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775905860, "status": "PUBLISHED", "id": "1928913551324748"}]}, "liveChannel": {"nodes": [{"
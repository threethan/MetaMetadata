.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q38-0JYL7W0Q7kNvwF9UaQi&_nc_oc=Adq0Ax6pXUNSGNetqxVhRoqSQJo8Pzs2qNT1CE8EzRZQOnBfzYKjjGCEBgE7mWpzTS8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4w9-FRoAmKIKQhldOJf_CzqECQVZ1KSCZPN4rDSPe-Q&oe=6A8ECDBD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVEeAkd_MskQ7kNvwHr_qvn&_nc_oc=Adra3rIrDvdkfEoXWmn2EAy5Fw9I_Lg8NjNxqSAJ19wXG--kJFEeHHTStyGQcCbDV7A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpJ3wpIo2Zd4Nlt6eaczL99qkKxiIAno1ZJBj1NdK0wQ&oe=6A8EF846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9771.png", "id": "32632832129697768", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827567_32632832153031099_3980470301009259003_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-kyO4MbmQMQ7kNvwGUhdJF&_nc_oc=AdpfiG7_rN9f0vW4aFpZrVKY9-blY0FcFSuWK8XnrT77ts7qkY6Lj8Z07ftJMMQ_OeI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIfxndtGqXSiIc7vtWwsojVTZxbzibMIG3LWm28Ozn9Q&oe=6A8EEDB9"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25204663795872011"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1928913551324748"}, {"status": "PUBLISHED", "id": "1214440247537702"}, {"status": "PUBLISHED", "id": "1930057337886747"}, {"status": "CANCELLED", "id": "2099211900484984"}, {"status": "PUBLISHED", "id": "1066879825501200"}]}, "baseline_offer": {"id": "1928913551324748"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775905860, "status": "PUBLISHED", "id": "1928913551324748"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25360268806978175", "version": "2.1"}, "id": "1395084828909908", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", 
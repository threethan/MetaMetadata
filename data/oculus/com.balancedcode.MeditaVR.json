-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZXtDFemRVMQ7kNvwEIUMIZ&_nc_oc=Adkc34PpmkO1vkgHq4htF8S1rxz_VA2BRUQyY2AU-CAp6BNi6paVIBlBDvsNdH_ib1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuyFw9H59qGFpupZk3u6cIHvvdPJO4wNspeMQO4a2h_Rg&oe=699EEB1A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt0IWyfspeAQ7kNvwHcRDtx&_nc_oc=AdmN_dAqG7n1O3eRkpJnYN5d694HmmPz4r8tT0ONnVVjsmZm7r33uOFnBYHn8NNo2Ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu-T2UH3I5EiMmYt38NQkJhxhnBbwSeEyG9TiiKRUoUGw&oe=699EE48A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3z661QITCcQ7kNvwGcdGSG&_nc_oc=AdkihiG5_VUVRSAaYfD6LKSquii_O49NQ3cxOuCBIe9QB7SNmlx7tkbjZ-aoSt6lweY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afti2bGEdE7hTC96Y2JRepwL3hzd6OJeBjM4S5rjRWbAzw&oe=699EDCBD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFUZZK7wNxgQ7kNvwFl-ZWn&_nc_oc=AdkbDAzyPG6rsN6lg1QuAIbU_5EuHmdYXwbAg8KK4flitfl-GktWTmY4zDqihRoOJaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsGIbxT69EErVkuWiard181yZUAjrHSeyxcdk50Y17VXA&oe=699F0746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm4N6lpq4FUQ7kNvwGz3cqR&_nc_oc=AdntMxwOCG9a1Je-yitb7YE_--mUCuZ_F4sBxv3X2XaWo086_GbNFm8jfhoYTl5mPDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuK_b53MoMU2V_nA6eOMLUQXN9ooo-g9-VFFkacRrEHEg&oe=699ED4F0"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25581153041556416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculusc
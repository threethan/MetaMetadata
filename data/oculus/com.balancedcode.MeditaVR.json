id": "1870571347185617", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UtZ6bdQiJgQ7kNvwHmW8yY&_nc_oc=Adn_E8LHMzNQSlpBHGMlu2kVE4i3bCdRNPfYVHb2Z4LlqTiYKPK_B_ITOHEVOwKAtdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxK2nHMDS07qZ3-zAIjQ2Xg_zAcyZGg2Tb6RpOykS6RXA&oe=69BD3D9A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7yRsNdFJdoQ7kNvwGGyUlX&_nc_oc=AdmppxdocnJeBRl2lzKtQUIITnhn0zxDZTITuPwpd2GFIt77s5enctKBUBUcnTlzKIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCY-5kY1KSRglYZsuZLXzU-eX4JdijIWMukrCyZLEmfA&oe=69BD370A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC7WTIFX2yMQ7kNvwGm2Jdv&_nc_oc=AdkLKfTl9zuo-OA3aADwLgil9oSP1L99B_RRCkeCQRRlq7P3hP6A3bPT2-rNQm2QYlI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMyifZdIPsJ1OjQAbcMK9HaQq6yLNkgFu764HqY6ws7A&oe=69BD2F3D"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWsDgKBwLHcQ7kNvwEM8VhK&_nc_oc=AdkL5bClcNrt2Zxv2WiZR_-P9joVzAkpcvX7Rpm59RWdTR6jUv5ijWChsNZq1Iz7qa4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMOutweVzDLGfgVvUf_PR5bu5VZZebiXi2Gsjmwor2Cg&oe=69BD59C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q265r9X0Y5AQ7kNvwG9BN-c&_nc_oc=AdmCFP4-1itHCFuS_85l6GBb0EtvRqFFS64vCCTaRYHznh70lnHD4eE7jZQ-LeLV4X0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5BVazMbZ131fBhn_W4s8_2jtnAy6MfJ6_nExp2jwV6A&oe=69BD5FB0"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
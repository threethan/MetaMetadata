.png", "id": "1870571347185617", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DwN-hoVopIQ7kNvwE_0Jks&_nc_oc=AdkREO8V_8vw5EVfyhqsyzDAWfCXvG5eelJ9SuvPRiaTr5nQzYIDVkQ3Xpfl83A3aJ0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBgkHMeRlJeOsF6Q_0BTuxtW0zeS69iSfqwEB8ogpSaQ&oe=69AAC89A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfKvDtDPplQQ7kNvwFF7o-Y&_nc_oc=AdmlRrBIDBnrFaZ0KV-WGB1mSm0o9lXjUq18DovSSZ-DSOze6B_aMYg5rmbQPuiR9Yo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afyo-2XYaz7_xpPuGQaCt5EjAsCLbIPDwM1mS_7gDLDr8Q&oe=69AAC20A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSzffFZTzicQ7kNvwGoanX1&_nc_oc=AdklrzXBiV1MVGpaNx1t4-o4AUCDv-R69uWUF4fykEFPR2yE1uRoYFYi-quqffXVrU4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpxE7XfQBKReVaYuzgm5RyHSuoArUIDApEs4PLBk6SOA&oe=69AABA3D"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzIOxVVLGW8Q7kNvwFueKEx&_nc_oc=Adkvk-_XotmVUVRzdx5h1o6tT1Lvecx1QhEQsTkHtF_gsdpi7QDjPy6N2bITExuDL8s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt7bmO9MzBZeEPHjdVh0PAtzM9T02WMC8oRkYNckjMsg&oe=69AAE4C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EKYg0ohc78Q7kNvwGYr3Nz&_nc_oc=AdkZ6m3pZhPPjESpqDEGtnq8U7kmAdrU-VjGC-W2YFl_4Udwv6VO6JxobVDcV-MK58Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFyzPVIPoFu_LBi-NpnPNf1gPEfg9W6v2bLZJ-FbSngw&oe=69AAB270"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes
641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt0IWyfspeAQ7kNvwHcQys9&_nc_oc=AdkOoVOUx6voaUI93ac3wccfW9tvbjPIA5dVTGNGwYzriUMXJto-p9SKab2Y8NhLqLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfthYmh6VtozwatShjzlOTPoSrqoGaPSHcq_ffe-r8dzWw&oe=699C418A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fps4MN5CfnoQ7kNvwHeS95a&_nc_oc=AdnMIMXGFkqMQbLtUP0nxJvV-QDS5rAPrF_R8iBIz1rvkz2mmhZEDLOsbep4jnx43Xg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv4CeJSP1-4dLrnquTE-G9DonfXzNRK7sURohT9KLW91w&oe=699C39BD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVNODAZhqjUQ7kNvwEnd-68&_nc_oc=AdnuwISCNOwDwKMeP8o_V9FZdlSqStgxioUYnyvmURx8iZUWBz6lRw7cScpAZrSM5BU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs2ttMsa4evgNywO9x-yD1p4IQFA8G0xr1yWLZKNfh3bQ&oe=699C6446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9771.png", "id": "32632832129697768", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827567_32632832153031099_3980470301009259003_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvQp3HFUwV0Q7kNvwGujVyh&_nc_oc=AdnZiTTOdwoyuR_AqRdJlygAmUDWEK8YHCepgiDKxTpyuoCF8Ctg7DBfoMF7Qissk6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuDN0HDi_FvkNMfgMD1BnqQYRr_pCEe5APV1RJ08NEPpg&oe=699C59B9"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25204663795872011"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1214440247537702"}, {"status": "PUBLISHED", "id": "1930057337886747"}, {"status": "CANCELLED", "id": "2099211900484984"}, {"status": "PUBLISHED", "id": "1066879825501200"}]}, "baseline_offer": {"id": "1930057337886747"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1214440247537702"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25360268
id": "1870571347185617", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkRxlvgNbsoQ7kNvwElfTsC&_nc_oc=AdnGlKekIxnc1KhgBWU52k4OkU2VJijcx4GM5zlFe8oNDzXlaOAJrKkF4AA_NznqbBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afym1A9LObnqatA5P_qQwtLVj6-AT8-7MpyOnL1lW47b9A&oe=69B00E9A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdiOx0wazpsQ7kNvwGanEky&_nc_oc=AdmsYTa_cxz5_gUt7L6C0jqOVrau37KZb7uVEH0Et0OtQu0FNMw7W3c1DCAkmpuohog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwP0RKizyrCDUIYs9ZCVOtGwQPdu4n4GG1DdJborD8img&oe=69B0080A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6xmB0Lzjf0Q7kNvwGezS2m&_nc_oc=AdncbYKvokMOd_ZMEFJSe8KIRFOIzzJNDVCCOJ_FJn9R8TVtHTJ9LmTUQH3kzCGNpdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHI1ajdsSWuspx8soNKCe5cjkFkhcCHQovALRr33OJmg&oe=69B0003D"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iljx1XURmVEQ7kNvwF_lRSp&_nc_oc=AdmxdZ-VAzBqPyn8WW5zvwZKAcAWeYDpTYq4dOL2fJ6ld2jI3N3nSbMLiHkgBe-EU5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdG5TcILulVWU4ODWggD6Y2nj1qfyt-HJC2vdgrbPFvQ&oe=69B02AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pasjow_kLpMQ7kNvwGoYnKZ&_nc_oc=Adl4CWEZpo1aC5kl5DEorus35VTUS4K5zGa2R9ibOWNtZ2-bgsMsaj8NZ6OKBehJeew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV3LlUO3Lw2V-cwibWnVuToAlZom5sMJFs_e2KPa17CA&oe=69AFF870"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
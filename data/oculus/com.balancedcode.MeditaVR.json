-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qw4dntmz5bEQ7kNvwFhRDw0&_nc_oc=AdnhwwWJ-rozghUQjYjsnTFBx9hYjgTLzN3YSAO2NH2FJH_-21eGcy13v1aILvdVWJI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsobrz8xUX_PWGWzFk-8_coaGI7hX0uK8qwtLcrxwExEQ&oe=69A18E1A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekwVaHvelR4Q7kNvwFZv60a&_nc_oc=Admzv4iE98GKOlwoWD7VtLj11JkmydYMQ7GW4eWEI0du5vvyPdBfA3ojK5Xapagt6DU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfthAD_QzFB2MPFchcgBInyKbLS8Ojra92wxxazrzLpjjQ&oe=69A1878A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3z661QITCcQ7kNvwFqWd_Y&_nc_oc=Adn8pAVrTomji5MrZLjttpmpudLfPP-dIXoIDS7yImwFMgdM-5a6bCL4uwjbF5wsVvk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftZ53lqV1TFhaEYdSdmxe45WIp7IGP2M4l2kobFQ12Etw&oe=69A17FBD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hYgG2DSAO4Q7kNvwGPay_Q&_nc_oc=AdkWSWPZ5QQHl2Z3YA5rTFPWgvN7Jkml8ANhulzYoSuzJGVuCTf3xI4MP5t1uRVsDJw&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsNQ0iboycAisN4VmULU-Y1mPxKrKV2nIYr5_yWwfhLWg&oe=69A1AA46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vm4N6lpq4FUQ7kNvwGzY10B&_nc_oc=AdlHVDRDxU-yjrCbiHruVk9kY5MM0oBlO9N0iXN7ab8hQ7L5rL_UytfGljRmUT2BWtA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftb4WL7DZDmUjWqb1jHA_NItY6ZGZuK7ZBff8mnlt2FQw&oe=69A177F0"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25581153041556416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculusc
id": "1870571347185617", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqN3IcuJnaYQ7kNvwGCwJWz&_nc_oc=AdkWcUnnL5HXhz7vwn6yspDYEWJO0RZdH52Xz2sbIggCamSyPxAIJqTGber5UO7IlAM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwvHLQAU8eY3J6S4gF0Hv1XtGuGQZF2dlqXDp-I7hPyg&oe=69BA9A9A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cupvlMJe39oQ7kNvwFGZOYN&_nc_oc=AdlyK8O91dntF6Swyegb7LuBlxTZRXNF8PugJk9sLLETSMjYE_vQFRh3nedbpZtD3nA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwe9u3s3RuDsqT6okwe6hQdjt16KwH3DwNc9gKaimh9Uw&oe=69BA940A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC7WTIFX2yMQ7kNvwGCtUMy&_nc_oc=AdniHmbD_xbBIO5XmuC_ctPuu_2lA1NJUswHgx6OSVB5h7v6TOc-BCA4OOkuxN78Y54&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA3w5LC9TiCoYa0UcKjPNQQtY_LXiJB7AUsdqlcUxeig&oe=69BA8C3D"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E805Hkm4TcQQ7kNvwG3dGI8&_nc_oc=AdklljRP8lL86ZZq6PcQ4_jFHWICNeFwVQIuGWbwIk8HU0j9xxqXr2QKvJRopjawmGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZkyUwpHeo1Z7mASow5LnCCvHUh1QfmS1I4dN48AtMjA&oe=69BAB6C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q265r9X0Y5AQ7kNvwHALWfD&_nc_oc=Adn9kjjvmm9rlY0tJOmbQI2kpCE7byWMnCiPjBUIOwNXQ4k2kZm1qT1dsjrHc2uXCzk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6A9M4GfLTvmNnE8SxBC-7X4p5cmOHTo_KZAGsrd90ig&oe=69BA8470"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
JujMODB8x9FPmQSRJc5y8B6p2oFJ_iYFzfZQh6pKP2p-g76gY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0mX5IteTQ8k8jpD-dtWyQ4oyL_TVovI1FYwI_GMDyzNA&oe=69F0D1FD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZU_Op05i60Q7kNvwFQULHb&_nc_oc=AdqhTgII7WS-W10ANP7kAjeke66w75rHRx3xnY4UCVsEwq7IEWGoqONw5tcsdF1EJWM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af18pgbTvkOR9rI2xBapAORS71PV6qnq3UIJdo_HdN88WA&oe=69F0C446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "9771.png", "id": "32632832129697768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_32632832153031099_3980470301009259003_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDg5so6HRSEQ7kNvwGzXlaI&_nc_oc=AdowHhFTuSx8aJH7FwLfr7TN9IlmZRMcGd-3viTKA0MkK1AMN7x6nBRDwalKKu3e4I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2FdrxGqaTTpRLhpZcIMjDVh5LNZPledCO319SIxxzehA&oe=69F0B9B9"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.ht
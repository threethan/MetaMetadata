-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwObtzZo80Q7kNvwFBrALA&_nc_oc=AdkfjmmM7pbveqLa3ikGEI7FJNvMHUM7WWXfgpVjrc9-Pr1ac8VCOKuhkm3lHWr0C7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6Lffr9-7kbYmzL0HwckIVovTU7eAflYWkMQ0g0bruhg&oe=69A6D41A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9BZiIQSlTYQ7kNvwFHsYfr&_nc_oc=Admscuio1MFiQOElaLGGMJn_Tpc_9I_JJesl2Dldl71yJc256FojHjYOdLxIxw8oijU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsgahh7yNysji5yCZCj1GpG6wzwcqewMNgFBTxqAoDB3g&oe=69A6CD8A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-d2d_bxcA0Q7kNvwEtfCky&_nc_oc=AdnYeJ3mvgqKQSR22cmS1GijO9YYw6sAUzjT8LTZyNSsCU3G0e5krd0mGixAjOEKhZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsss6Xtm1ZuQdeKxDJUkEAIFNsYD-tdoqxq9IkLIgf_eA&oe=69A6C5BD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqVCFN_xw2QQ7kNvwEY7IgV&_nc_oc=AdmReGFoyRuZ4KQDMwl8DelrQrokOFHCnVzlWX-EHjfDlLcwXqiznQnlbbnB16Raq-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftdfum64DtHI0lkX5spgxpOVV7PFrGU7t1NvUSygNBdqQ&oe=69A6F046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjH4MQ92NPcQ7kNvwGhFGuO&_nc_oc=AdljqbecgHxu0yp71nKbhGUn30FdbGP2yjpyhIAWGXRB_NlKCvjgRhlbiQtBCxFSZUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuL15tcItNy_lEQ0MyyA0YWBQV94u8bhw_w2QLmAMTHpQ&oe=69A6BDF0"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25581153041556416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculusc
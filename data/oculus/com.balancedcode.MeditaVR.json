-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPoWMCO3sbkQ7kNvwHdbf1N&_nc_oc=Adlg66fDt6okTuytERS1GPYgaJieP7se3WugFJPhUACdUikPjGyfDvS5XPQdBQRaSsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftN8AHFRB2OarDsxpptsXTzh7pVrM8QHzF-5qVttJuPfA&oe=6998539A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDZ_N21-Fo4Q7kNvwFKsLuM&_nc_oc=AdnsCOdGwq78ioCu-ScVYH111lV38DQpsiGAPgkMyZqil7AI1mdMxXKfu0JfNfR69LQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfslCL8F_5k9BvhQ6kCM_5GCkawKiQF9qmQWKYuTuX7Gpg&oe=69984D0A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXGv1rus4WgQ7kNvwFI4szj&_nc_oc=AdkXGqVT5jwF6y7093q86iRiKl5txOuO7i2bHvc_mmiRFQVsMrXvc7L8xU2HUhEeCLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsZFscGEhVAh7BY-Lk_IIJCrs699v4u2dOcozK82Ig3TQ&oe=6998453D"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBh4yKGqHZgQ7kNvwGpaKmh&_nc_oc=AdmlEuk6gwXaBHSp7LY-_w1mzeMIA5dvVXVRNKqQDJVJtvZBtuSNvERRj_fyDEWAjdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsBBf8Vzk7WufSsIODKchiegv-QPFGtkpTp5O7kEQTI1A&oe=69986FC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5LP8nP9ok4Q7kNvwFZeU0x&_nc_oc=AdnLSmLfNs1E9HDDk0MW1fwW55TaBCEfHa8y5iEldr4WBrAPBrznn1EgtNJCkNEQvek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsgBKr8fjcdsKC666K-f3qRk7JadZ86K_5fqwVCfuNmnw&oe=69983D70"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25581153041556416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculusc
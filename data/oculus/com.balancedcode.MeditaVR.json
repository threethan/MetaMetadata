-25/491825462_1870571350518950_7077439399944818454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuwObtzZo80Q7kNvwEVkN9U&_nc_oc=AdnSG61q09CEvouFpdlGYHAU2T3-M_y2CS3-m4AfZ6TJL2LWBBgoO15g3tps9MKxveo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvbVYuea3fQaZh5iGNcxhJdlcRTAjdfRiwkSdcZDXVQYQ&oe=69A4311A"}, {"file_name": "10060.png", "id": "3203926789761737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821081_3203926793095070_2837989129871641071_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9BZiIQSlTYQ7kNvwEE_q0i&_nc_oc=AdnELsvJUoZdEhW9NlG-nSs6UZESuytzuo3WZ30aiqQudELa2Hyr7CiSeWnPBsRTxGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfutmF3BR8Oh0m_LCJBsYdtlwtC1It1-eiG2tFexhTFukA&oe=69A42A8A"}, {"file_name": "11707.png", "id": "720270210691191", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_720270217357857_4783553879400563174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMiOxQTbNR0Q7kNvwG74xec&_nc_oc=AdkvxjlullAu6nGAtObQhiEfp8CoZ8ymVfpsyTSa3IH301NTKChIAwdEuc9A2LAz6gY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftgUbI_vAjSZwPXEihcHo4n--ftsGeplEwP2S_snh6NJA&oe=69A422BD"}, {"file_name": "10579.png", "id": "749870444785677", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818849_749870448119010_5614376207262095413_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hYgG2DSAO4Q7kNvwE_45v7&_nc_oc=AdnHbPO6OkiW684c0NyU8FAwxfkVHMplMQ-OmgyfB4u6oTc9saf9sg3440oTCElTLq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvWFaVi1S8zI7rQb1zb4N0PNKs7qt0vCBNvTqrS5Y5F4Q&oe=69A44D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LandscapeCover.png", "id": "1581974616470505", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823286_1581974619803838_4754795341212443399_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbwpDIDm3rcQ7kNvwG1Z6_M&_nc_oc=AdnbMIniFcIxE_TSKe2cuD5FI3ka6kr05zNiXo0knlLs82SzaJ6h43lwLqLCthJe_Is&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftqz5R1iG0EFewgVJRxxqIf-gmxp_OQaXKLrROdaKOo4w&oe=69A45330"}, "display_name": "Medita VR", "keywords": ["VR", "Calm", "Relaxing", "Arcade", "Handtracking"], "long_description": "## Medita VR \nA casual gaming and relaxing VR experience.  It is very suitable for people new to Virtual Reality to experience the immersion of Virtual Reality in a relaxing and uncomplicated casual game setting.  \n\nIt is a hand-tracking-first arcade VR game where you throw paper planes to hit targets. Using Meta\u2019s OVR hand tracking, you can steer the plane with a right-hand fist and boost it with a left-hand fist, creating a simple, gesture-driven control scheme.\n\n{1392984625625855}", "short_description": "Medita VR  is a relaxing Virtual Reality experience for the Meta Quest 3,3s and Pro. Test your skill with throwing Paper Planes at moving targets and enjoy the immersive world around you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.balancedcode.com/meditavrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Balanced Code GmbH", "support_website_url": null, "website_url": "https://www.balancedcode.com/games.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25581153041556416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculusc
ds to notes and chords to score points. Use the app to improve your music skills and impress your friends! \n\nPerfect Pitch lets you practice with individual piano notes or guitar chords. Level up your listening to improve your improvisation abilities!\n\nPerfect Pitch is an ideal app for all types of musicians who want to improve their skills. Develop your chord recognition so you can jam in any situation!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-perfect-pitch", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.my.canva.site/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7851288348254936"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003252_731459388816256_3190142654612404449_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqvxVrZx8vIQ7kNvwFeJgzA&_nc_oc=Ador1JQ5_0rvRW_sPcb1ewjpuMJ0yMVlvnnmu3emVv5uoMH6j23_DFyfQQbbxqDzEuw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAbDoYB_dBfN2ZAAMD2-zv7ub9j9Je5qWYCo0UuLbdwA&oe=6B01D9DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Perfect Pitch", "platform": "ANDROID_6DOF", "
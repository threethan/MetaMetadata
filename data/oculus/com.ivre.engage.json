kzr0xJtsbxQaNxFRDXQ-sZ5qFeWaB__IZKVHrzKlT8oA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_MGVE9azzZN6Sj-gOWIFlv4cyN0nD1v17PvN0i4r8nQ&oe=6AA6B54B"}, "display_name": "Engage", "keywords": ["Events", "Collaboration", "Social", "Education", "Engage"], "long_description": "ENGAGE is a next generation communications platform. It empowers educators, companies and event planners to host meetings, presentations, classes and events with people across the world. \n\nUsing the platform, virtual reality training and experiences can be created in minutes. The tools are very easy to use and require no technical expertise. You can choose to host your virtual reality sessions live, or record and save them for others to experience later. A wide variety of effective and immersive virtual experiences can be created with an extensive library of virtual objects, effects and virtual locations available via the platform.\n\nYou can host virtual events, stream in media or simply explore user generated content the possibilities are endless. \n\nENGAGE | Communicate. Teach. Learn.\n", "short_description": "ENGAGE is a next generation communications platform. It empowers educators, companies and event planners to host meetings, presentations, classes and events with people across the world. "}]}, "developer_name": "Immersive VR Education", "developer_privacy_policy_url": "https://engagevr.io/privacy-policy/", "developer_terms_of_service_url": "https://engagevr.io/terms-and-conditions/", "publisher_name": "Immersive VR Education", "support_website_url": "https://engagevr.io/support/", "website_url": "https://engagevr.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SOCIAL", "UTILITY", "PRODUCTIVITY"], "has_in_app_a
t": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27941226108849258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "587050702004345"}]}, "change_log": "FIXED\n- Issue that prevented experiences from loading if a file is missing\n- Issue with transparency on skyboxes\n- Grip buttons display IFX bubbles on VR devices\n- Issue with spatial audio on video screens", "created_date": 1785336745, "id": "27672272242411314", "version": "4.3.1", "version_code": 4320, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3092079454190601", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27941226108849258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "587050702004345"}]}, "change_log": "NEW\nDictation option for text input on the Virtual Keyboard in VR\nIn-session browser can switch between Desktop and Mobile view\nIntroduced PRO Group licences\n\nAI\n- Added support for Google Gemini via AWS Bedrock\n- A new IFX \u2018Vision Request Camera\u2019 that can be placed in an Experience \u2013 AI Characters use the view from this camera to make vision requests instead of the users\u2019 viewport \n- AI Character Builder - \u2018Hold to talk\u2019 interaction method is now the default interaction method \n- Updated the OpenAI image model. \n- Updated the Meshy API Model \n- New IFX to allow the Experience creators to define where images, sticky notes and 3D objects should be placed within a scene \n- Ability to search for a specific custom AI character in the AI Builder and when loading the AI character into a session. \n- AFX \u2013 the ability for AFX to send messages to AI bots \n- A new AFX that uses this feature that allows users to type messages to the nearest AI Character\n\nIMPROVED\n- Spatial Recordings now save as they are being created so will be useable even if the user leaves the session without ending the recording\n- Spatial Recordings can automatically continue between location changes", "created_date": 1784127280, "id": "27513633114941895", "version": "4.3", "version_code": 4317, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3092079454190601", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27941226108849258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "587050702004345"}]}, "change_log": "IMPROVED:\n- Users menu loading cards are now correctly labelled\n- Group Hosts are able to submit bug reports\n- Fixed networking issues", "created_date": 1771867634, "id": "25924337133871509", "version": "4.2.3", "version_code": 4234, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3092079454190601", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27941226108849258"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "587050702004345"}]}, "change_log": "FIXED:\n- Some avatars invisible in sessions\n- Recording playback causes heads to nod\n- Non-hosts unable to start Experiences from Cloud Files\n- Teleport arch not always displaying on Quest\n- Keyframes disappearing in the Experience Editor\n- AI language recognition settings break bots\n- Some GLBs not working as interactive objects in Experiences", "created_date": 1770805037, "id": "25811172815187942", "version": "4.2.2", "version_code": 4230, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
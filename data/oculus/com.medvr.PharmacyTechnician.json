0.png", "id": "729541039868403", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619504_729541043201736_1838179915308509626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyT_dnjyeDUQ7kNvwH_dR7u&_nc_oc=AdoimYMOEo5BeY834tWIE7PFPyJc0pnMxmNAM-O6VIn_lQhuJkstQ0Ahg7gncs81F48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64_NYzVmsA3M-ZOx1YzYXsWenZv4fC_WKAih8qxmsURQ&oe=6A1ED108"}, {"file_name": "com.oculus.vrshell-20250718-162008.png", "id": "1684679825525031", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298467_1684679832191697_7907575370902159542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIPRZDIXDZkQ7kNvwE6u3rt&_nc_oc=AdoTO1RjOvGCQDsSE75YafPcu_oLQM9-LOpp-k_5K-NPC-hxxxUX4fvPsf7UALPPnBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cggRBpFQEYhf2aKHAHLnPVV0kDnSgkAS_sPKWLDmokQ&oe=6A1ECAA6"}, {"file_name": "com.oculus.vrshell-20250718-161859.png", "id": "1835197684012573", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301053_1835197687345906_3873692057525823371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqAhKeqL2PQQ7kNvwGs_F9T&_nc_oc=Adr3nmCAFxG_ygkydoJcInkpAtGlhncYHeW6ZPXzC7vI9V4-24aMYnDG4u9j5rv5WfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yFl8PAJxhNw4nTf0RAaJ8W7Jb9Ry839WRKfGMcyS49A&oe=6A1EDE72"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician", "keywords": ["Pharmacy", "immerselearn", "VR", "Training"], "long_description": "Pharmacy Technician is a hands-on VR training experience designed to simulate real-world pharmacy operations. Explore tasks like processing prescriptions, measuring and dispensing medications, handling inventory, managing recalls, and preventing common medication errors. Whether you're a student or professional, this interactive simulation builds essential skills in a safe, immersive environment. Developed with industry standards in mind, it\u2019s perfect for educational inst
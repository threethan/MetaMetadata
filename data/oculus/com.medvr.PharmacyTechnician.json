"video_trailer_thumbnail": null, "display_name": "Pharmacy Technician", "keywords": ["Pharmacy", "immerselearn", "VR", "Training"], "long_description": "Pharmacy Technician is a hands-on VR training experience designed to simulate real-world pharmacy operations. Explore tasks like processing prescriptions, measuring and dispensing medications, handling inventory, managing recalls, and preventing common medication errors. Whether you're a student or professional, this interactive simulation builds essential skills in a safe, immersive environment. Developed with industry standards in mind, it\u2019s perfect for educational institutions and pharmacy tech programs.", "short_description": "Step into the world of pharmacy with Pharmacy Technician, an immersive VR training app. Learn prescription processing, medication dispensing, inventory management, and error prevention in a realistic and interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23902998959393720"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1157688503083376"}, {"status": "PUBLISHED", "id": "1083649
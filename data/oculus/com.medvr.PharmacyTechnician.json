30.png", "id": "729541039868403", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619504_729541043201736_1838179915308509626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCDMB4utGUgQ7kNvwEQwVa0&_nc_oc=AdrGT8N3eR2n8iYDdJK9gVfMEAWZ1CrQE1uuKYwbkXLV4Y1cm7OWvZq3bMLUxJyGFFw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCZLsY6FZqGShWWfEteeyVyc5HELt7rOQ73D36HTBRWg&oe=6AF9E248"}, {"file_name": "com.oculus.vrshell-20250718-162008.png", "id": "1684679825525031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298467_1684679832191697_7907575370902159542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM4U0bnUuoEQ7kNvwEeyxpx&_nc_oc=AdrznWvK2MqeRMP0I7LPTdmC_ijodfj0mnmazaZvciPkdgTirgwStRudVlhYQwj4X48&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSps7-AAkvxn-WtoTlhtgg-VtW6eZApBckgphBgx5C8cQ&oe=6AF9DBE6"}, {"file_name": "com.oculus.vrshell-20250718-161859.png", "id": "1835197684012573", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499301053_1835197687345906_3873692057525823371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-8HvrzqRIsQ7kNvwFFy1Af&_nc_oc=AdoV-J_W5DU3-ESE_l2xcfeELtAK2eI6zL2XFy-6yffoK-I5-jVNmCUvhCss3L4ZY40&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1bIu6aMj78xmdSHr3nJqrrcnTjH1GVb9Eednx4DCw9g&oe=6AF9B772"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician", "keywords": ["Pharmacy", "immerselearn", "VR", "Training"], "long_description": "Pharmacy Technician is a hands-on VR training experience designed to simulate real-world pharmacy operations. Explore tasks like processing prescriptions, measuring and dispensing medications, handling inventory, managing recalls, and preventing common medication errors. Whether you're a student or professional, this interactive simulation builds essential skills in a safe, immersive environment. Developed with industry standards in mind, it\u2019s perfect for educational ins
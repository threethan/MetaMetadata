dn.com&oh=00_AfsrjCl-0Horas-YlpnENZMuLgSTl13i1hKki5DqhPGlug&oe=69A4371C"}, {"file_name": "com.oculus.vrshell-20250718-161630.png", "id": "729541039868403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619504_729541043201736_1838179915308509626_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kap7ochnDjIQ7kNvwEmMfAU&_nc_oc=AdnEu2kDI9a0ecmECycXKgKekcVCmXgv8XXcMhmPEBA8i3bHm5EW2ecaLO_5h_nDIpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftIfJCUyomaRu7K_LZyQwV6RoQwr9t6awwOAmM51o_yfw&oe=69A43588"}, {"file_name": "com.oculus.vrshell-20250718-162008.png", "id": "1684679825525031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298467_1684679832191697_7907575370902159542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g69aumrfYRoQ7kNvwHVbZG3&_nc_oc=AdlZ3uEJ9F19PpbxAC6XXSoxVvrogzD41pKnHESZuGLPyD6nZCTSWrJy7PgYYB0r31o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftruWR808UVMmlROhSnb1M1PylGie_2J26eKKxz7qTsWg&oe=69A42F26"}, {"file_name": "com.oculus.vrshell-20250718-161859.png", "id": "1835197684012573", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499301053_1835197687345906_3873692057525823371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjAdKrtlc20Q7kNvwEKZ5rf&_nc_oc=AdmyAqJiYQ8FE-QsYHzLr35sgyJufFJwEi-hQh0nNjbrlkot11WlKdqwpG0tB7gkVm4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuwimoLJN_ppUaDlxy0htey2_ya9FOd2v0YpXbzCsmPJA&oe=69A442F2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician", "keywords": ["Pharmacy", "immerselearn", "VR", "Training"], "long_description": "Pharmacy Technician is a hands-on VR training experience designed to simulate real-world pharmacy operations. Explore tasks like processing prescriptions, measuring and dispensing medications, handling inventory, managing recalls, and preventing common medication errors. Whether you're a student or professional, this interactive simulation builds essential skills in a safe, immersive environmen
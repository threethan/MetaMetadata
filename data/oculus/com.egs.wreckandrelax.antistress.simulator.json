-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVEiM-7khFwQ7kNvwFAiW7C&_nc_oc=AdqBGFRYNgo2yKTCJyjrvpmY0i0tM6JJhp8TjCJp_TwpYEgHWA3WDT6qe5bOZx2a300&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRzwQBiOvyxD1ZM-fMEsu0Rgpo-Q5nrBBCVWabVamoRA&oe=6AAFF4E7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT__P09rbioQ7kNvwHgmdT_&_nc_oc=Adpy9zAurN37R8XcpZWgHtJlVpz-rBElsP9C4jzVBscstV4rKBIXpxIojPtaWizxIWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjS8kHnx5gIf0PmPikW8Bx5Xg9oAyXQajHGnLX8z4Bqg&oe=6AAFE445"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OvkiqBSl6oQ7kNvwH0pspN&_nc_oc=Adqe7YqhfUB_4tJP-PdLFxl0qitgC7I5UEP9LuJjMK3hiKxHa3KBBd2X2lW-Lk72irA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcx2DqzZK4sfIr_TLCETDW6yGdtdR-qEh7qQ4fmjNgyA&oe=6AAFDE0B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kR6P7805l1QQ7kNvwEy6ujr&_nc_oc=AdqMo0y6B-ub79IB8fMDe_djs5BMA8wuPEVwuTbFBqej0hnHtxs5wBd25Ch7oUBUmyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1_9VolnGpmKw3YuX8JSAnWs9YzMDk17BIgvnt9GYZzA&oe=6AAFE5A5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYA4TgnKiNoQ7kNvwHxKban&_nc_oc=AdpAk0tQplXBcx-5jfwJqePMu888Pujx29n6F0f6JghKSzLDpoAIwz49FXfTgvujnKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCYpJQPRKA86Zt795uquaTCoFLUTeL5edmTN7jG-FrPg&oe=6AB00646"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
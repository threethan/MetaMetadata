-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLpzniKVHfMQ7kNvwHEGrZG&_nc_oc=Ado3ztyNiibDKE3RtDdT8KXGbSJTU766C94eYu5qGZpePG_W_yFOacVAkznBR-Vvq8Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzzwAG_JWIw1DzP6sweCM_mKOG_HqGCn4xANhUEYNbbQ&oe=6AB14667"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gT__P09rbioQ7kNvwHdS290&_nc_oc=AdqOSHm8Vb9XyhYbeF7T952bOet7o5BNn5QPbwOkvdxqezRFsOY8Wq53mayuqxYAwqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9HZe6oL6PQH8TRyMot2t0CxstoWjSNsycwUuNcZ6xMw&oe=6AB135C5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWPZyIiw8gkQ7kNvwH--8lD&_nc_oc=Adqdi7qTFFN2HSlNasnmWuT9ihl3QVX7u2mim8STu1OTMNnZPigg6jPMDjLAeU67Hik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqzN1w_xbbtSMtBIkq_bp6gtZYr0D4qXaNiScKwdDqBQ&oe=6AB12F8B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1-K8gDoEoYQ7kNvwHj-idi&_nc_oc=Adp45fwLV_mosuQUvUTTuQ2eyAkMGwHWNQnT9LzvP8f0k1eFzTjHLkZUsQPqgokBFa0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBfcG64QrEszMtKVnQJymCMQLfmfTRS9gkaHBXa-lwhQ&oe=6AB13725"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYA4TgnKiNoQ7kNvwE94Z0Y&_nc_oc=Adp2PspRY3Tb1xGNT1tEYgCgSmXgWk8AJB2L8-htJYaQqeUQZLUmlYpkyw87XsDUPG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFkZHE_TusnmM1y0XJox2EfLtZgYpGfRys_w-xiOh1sg&oe=6AB157C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
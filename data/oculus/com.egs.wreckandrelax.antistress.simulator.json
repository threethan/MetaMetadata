=lFnoUZR1CmwQ7kNvwGyS55y&_nc_oc=AdpZ_swKaZ3PXDdgeZQZxbbDdhnA6dXmbnK5znPouelMhflKn680ZYE6zVSXk4fjX3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKNjc9V_d25lyZd0U7BLWWs-Ei74SZ9pmtziDGs3D9xA&oe=6A9ED167"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m15YmDpwhVAQ7kNvwFi4qep&_nc_oc=Adrw4RjRQyQVb3tcO7IiL1dOZ5RqQhIpsuKWza_OI7RCkS_EZJCGZrulY9Sb5A3bRME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLA2X4ZGxyMQAB8EJ7NqAcW1BMAS_Hwh-Y5ni8OsxYicQ&oe=6A9EC0C5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjeBrmpeEugQ7kNvwH8QiMV&_nc_oc=Adq2Uot6xF-N6tmzjpuT4Cdn7DDSBdVjgMkxcRVbJV43C6wku8qFfEqveYLDMd_-ifs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXKXEC2HrADpHiw049xQgyu_5L03xvMmV21RZOzLpv7A&oe=6A9EBA8B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_ulm6qyIvcQ7kNvwHZ3-5M&_nc_oc=AdrYCCm-02chG8ziNZ2yOTRDEZCTDbnbLOROGniI52jsJxm6_7zo4M7C9EmFpmCRJtM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRqeBWkF0k3-haY0Ovw3O71aLWLaRgr9mtud37mB5mHA&oe=6A9EC225"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6v2DoQcIloQ7kNvwFN2BQ6&_nc_oc=AdorkKZ7KakH25kQpXH92lRMLKTGdbyxLE_S6k_PhkhL4ahzRwNsn1rfo9PzIRGPKwA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTjeanhb_kSNl76a9AGBTlBWp8atY0JcbAs0Enli8uuA&oe=6A9EE2C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
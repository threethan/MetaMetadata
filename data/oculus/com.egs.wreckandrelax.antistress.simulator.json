=Xi7HcgqeLZQQ7kNvwFjCYWd&_nc_oc=Adodc2i1dm6qSLHsMw5Mu9m-KlyrkC696uaPWpKQmlTAZ7NjNdlOdBe5EPDU1Uxi8_4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZQO02wMucMsSrDVlE2EVJhsm3dlwe82SGn3gFalA-Ow&oe=6A9720A7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X96wszvalJ8Q7kNvwF0l723&_nc_oc=AdoT_cmG_WJcCDqZZLtgtKqMEHa7UQ9g5oHBGSSKFj4CkPtIcSEA9Z8QYfQq7heG7zw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEFDszQG00qJfT9bHNsZsz2hpCSBhRXPaoZd1MhzTnqQ&oe=6A974845"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOJpBjKaVIAQ7kNvwE1DQyD&_nc_oc=AdrPSOuWTc_oBQtexu9O3t_eftp_ViWweI11p00DWKfnhVBxpoIoeqoRtpR5djnjHAg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELLdtg8xErVLKplAoDFnwUBo100gscix30tpnUMR6Z-Q&oe=6A97420B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOuUl-_jfvcQ7kNvwFH0OkL&_nc_oc=Adr3jKhRT3rWztAF_I0ju3PzaeM1NYH5JgYVuVWG1ng0Dxso_ryYcpdoXQ_CwVA7E9M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrTzaGBU176p7iHRtYOP2LFWcvoI10IHOrGCw4BwlO9A&oe=6A9749A5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKvdDC--lIQ7kNvwFXjDiX&_nc_oc=AdoYjso-VuYCzSEUyCgYr6-rM0j-O65JqWSY6xvO9r9ACoqQ3ibwttfibUF8NwcfqUw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQdiSkFUaErjuSzhI0zj_7_xtivd7eIGWGJS4rNGaDKw&oe=6A973206"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4efTY2cRycQ7kNvwE0Ql_y&_nc_oc=AdqQRVLudFxHONSurm7nqaLVScpSn5L7Fbzwn-LQNEPJYz8PFp3vMRaaGsMQl67xtwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5W2fU3rctxJAKgqbaUZukpdWU4gKDK_z0NmEiXa8uKw&oe=6AA80BE7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yHGGWmoLKkQ7kNvwEPAuFY&_nc_oc=AdpbeG5QUn0kVRnQJ9N4InAaZ3gIfWzKnCy2Bse5D8qI1SLQ3WRU51dlJfIrYx-J_gI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ82wCN3UHWLVR3sdx3-HIiYm5lAE58KBeaBy0_LKbvQ&oe=6AA7FB45"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjuVoYogUb4Q7kNvwEI7qeO&_nc_oc=Adovs98v7AcwfAswS1H3w_BwBOJex9-hD9FPq7kNHXYmqLz0WsVNxBwi6NXHu6CvsqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGntqglNe7x-8UrlG0uPwa5K9lwCSKrFaDbMVZhc7dCw&oe=6AA7F50B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2QbRi0mKQUQ7kNvwGJMUA_&_nc_oc=Adopr1AHNLpUOmtoXz0nUUj8-gU_jPLjN1-0yCVpWqcA9l98vpBM6rGq2QRC44ESR6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBhg2ObXw5rwjzHPa6mGT1PWB2rpf3L-fQAY39LeaKAA&oe=6AA7FCA5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDA6yZatA6sQ7kNvwFjyI-8&_nc_oc=AdopnUb41kZ9kEWNMSWljQELKR7D1MZ-SR97N67XRLeiB7XuUzleoT4Gk-tM7ezborI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWLsy9xpYydaic0Gmm6EK7QtYubqeWDTecqxnAyHk-hQ&oe=6AA7E506"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI6Musi9_gYQ7kNvwElwgEd&_nc_oc=AdpbObgi1hylY2NhRJSQ3Puzr7wC_hDxJ_FCPvVb1P6t4YWZHXn3toIpOytY2uGLUZ0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS87mqAGIEf3StOT9iMRwLKYtekN2D9sz9iyrUtwrdLg&oe=6A916A27"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqYKEcPcWW4Q7kNvwFAxTFU&_nc_oc=Adohxfvr5lTZHAX7sbL-pmSXZmH9dLvOcMtnXwET_FxjdP3PlPRkStXRIm6uYdjDu7o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6vBoFZaHwXetcXlDG3Ek8lukwloX41hWkxvu21D3sDQ&oe=6A915985"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFeOSFzXzwYQ7kNvwH4cRyV&_nc_oc=Adrl40kwwLVmqi0XycotbClYmy8OV7WROXqxjaNQnBNuTpSd8yIAJ8ZKrrPXjznr5bA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCoqd1zk4zcqgs3Caw4vKRFbuupbitr7O7L7Lk7Y61oQ&oe=6A918B8B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYuS-LopqoQQ7kNvwHEClu4&_nc_oc=Adqk41HGZ2a8jF077YTbrwTJTj6f2ladQRbO3G_NuYlsASj99SNncbDwscUUgkeN3Cs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGI89L5mazljNOR1S-2TYv6EWIaA6XQp2xOo-1i71P5w&oe=6A915AE5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXoFL2AhkK8Q7kNvwFiVGVr&_nc_oc=AdpsSFJt8_d2lVsOuf8tdgmZoYxqUKI8WEHmjV9cezgfP2N7jIHB1s-7yL259w_JGHM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1gd-2HT1lgek0UzbnssL35Hgys-rq0AEBCeRAYpcRYw&oe=6A917B86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
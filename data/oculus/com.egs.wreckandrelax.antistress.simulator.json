6089515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv31FYMzKugQ7kNvwFOd3vK&_nc_oc=AdqMWajqdQHm05wkOyaVMPCVC_1RB0iDKndf-OD1fenrbcLV-BXr2sENVefTFC7dHBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZf2NBuy8yW8j5RRzXAgYZte0TSgw1u6huhfhyuQDEdQ&oe=6ABE6625"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo_X6Gw3OwIQ7kNvwE1AmZ8&_nc_oc=AdqOH5Lfx9MrLEwXrYbsdzZj34HpIwH4uznLuUmjAjkWV9ZSgo0nzbllbxFUBoEZNQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG8aHg3jrduASI43pj6_ApFnb33tjgOZkszyQlu-Q_ww&oe=6ABE86C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1144833212054277"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2150628572466692"}, {"status": "PUBLISHED", "id": "2505234259900079"}]}, "baseline_offer": {"id": "2150628572466692"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789978440, "status": "PUBLISHED", "id": "2150628572466692"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1164364800101118", "version": "1.0"}, "id": "1951688705547694", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1144833202054278", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1164364800101118"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1951688705547694"}]}, "
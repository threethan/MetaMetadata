-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzXVK5DyOZkQ7kNvwHiOOs2&_nc_oc=AdpSV8-MJgdOWwjgjl6wlZv2W0YyEAHRSN_XGf6_1EvlIZSRylGsF0yleVB3OVUBIsU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiSDe4JVkyfQfi8R1fO5kDQTN1Fhhm2TdRZ_Vfn6RzJA&oe=6A9018A7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqYKEcPcWW4Q7kNvwEcEemc&_nc_oc=Ado8tf1sx1XtxDc4Erx8N_oD5p6sJb2pkau6Vh6Y-NDGR0vjfQEdMBwuqFU-vZiUypU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErHK05o0Koq-bLKogqk8Js52qMgFJGCMyQtBq8lyIi1w&oe=6A904045"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8bX82lzZ9cQ7kNvwHOn2Iw&_nc_oc=Ado7bbPnzC_Y_ZqusGRPGwMLEfHXoc24QyrLynRfAzK6iW6SPF8RfX2gUzR2QNrWXPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhH5jeNHJ92IKO658VeKf-WJlT6tgwlPlcFZD3hxckEA&oe=6A903A0B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCZl68qZsIYQ7kNvwFFoar-&_nc_oc=Adp0OHMOMP3GLmCXKNL45gqOre98P-xIRHPey2ke9I9mcp6UArIIB7qb37FqXFwy65s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5iv7Tn7NHxPDTccHC35GHK1ssFQ9q2USb6fqlfmUeSA&oe=6A900965"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXoFL2AhkK8Q7kNvwHq87Ep&_nc_oc=AdoNYXNk2YuJYqDFwGZblQ2hDtWpXqhgrRsG9J_Ul46i76IjbEBy9KiGC9hhdzAHQQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVPJ2Sxplq9CW1OoIizbuatbcnXIk9TvLOij1hvgYqYA&oe=6A902A06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
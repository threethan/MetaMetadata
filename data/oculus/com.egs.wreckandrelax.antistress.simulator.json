-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4efTY2cRycQ7kNvwHwou3x&_nc_oc=AdqLnyMMZfguIiPkt1pPnS_hNg2_o_q786kq74stvzT9r-wYktBz5jtZtbdDSyOplqM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBxr4xs5WTQr5rU3RT-sRMNycEfiCYe7PaN5K18eQ3Uw&oe=6AA6BA67"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yHGGWmoLKkQ7kNvwGqeJWN&_nc_oc=AdqeJ0lnVWcUI-clgDpt_udr01yA-Z8yCvckfxBsEgpvNXy9exoMmjieYciMGYryA2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBzVF2gzrQAxuPI0fCR8OczBMULVVcd55UGxAS-yoklw&oe=6AA6A9C5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjuVoYogUb4Q7kNvwFT5LZ3&_nc_oc=AdqbystyqNQIbUr8lKGAPMUcRmMwK1Uly3FaSTBKnahVXlFPMkwD2B7AzSBCzy3LwQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0-j9s7NP-ghkqpxXpRbOjV2mmJ-HOkPAGK3eHWjIzqA&oe=6AA6A38B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2QbRi0mKQUQ7kNvwFgyEn_&_nc_oc=AdpPsGdYORKnCS3t2KVG6XtCf_WC5WMS1mhzRPuv_T9sYufoBosvs-RXXJOJi8Wxzyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7NqDQqIH0FB92Cp2vS0nywwpxvPUwX1tDM6CrDVPo-w&oe=6AA6AB25"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDA6yZatA6sQ7kNvwFwa-vR&_nc_oc=AdpSbpNwvGiwGJ-tAPP9dGIuO7n0q69nPFn9YmHl4eiB6_MBqLv2Jqvk7p0sEKr0yaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpGH8wzH33AI2GAKRrF6qvcuKcbIFtOZ1CvKYvCRFNfA&oe=6AA69386"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
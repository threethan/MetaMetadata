-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90PWxREV_0sQ7kNvwH4hAy0&_nc_oc=AdoYmnkjCEGcYBt4g5wtT9o9b6YTumpMTtYT44QpLCcjqsKTQ66-h7CmNPKW20mf53Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2JvlAMFmQP3Ds4gPiP9G5CT7eUVUHB3DoKPT4-Wy_CA&oe=6AAC0067"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTYm2RXOfDwQ7kNvwFPtyUK&_nc_oc=AdrS7aM2e-ca6j-nQRIpRlk4AQV9g3FJrEF5uC140Wuy3HByFW6wAGijitafxBU7gAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHaC77kTcw0o5-i9BMrQcH6rJSgaKpsIC9Z480TztKBw&oe=6AABEFC5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf6YjQVXTo8Q7kNvwG_JIfF&_nc_oc=AdpWbbrRv-H9WInzhY-sJFPc_BQMgi2BoWn8y-uf-cu_QgJXYPDoTpLibVIJT108cP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK311tmVLYHyIwkAcIhm96KC7vf3fQbqBZj8Flzurq1xw&oe=6AABE98B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXJaEUxhBn0Q7kNvwEcihE0&_nc_oc=AdqeRYi6cuqnZwoC9e1DndMAb7sbv9kkIHBSBLw8R7plcHxkmT3oJcpAYoki6VqtZqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvcACcuHSXUEYw7mp7lFSb3Pb1jgp1mDYDvOQLl30QbQ&oe=6AABF125"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppPpmHvvPWoQ7kNvwEc2DOX&_nc_oc=AdqQET8Imu6m1MTlLqTq5f4YpvyWYABjOCLj4PUyrP-1F88HIRH-xwCdz7hHE5OP7jA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUplOMWEmR_8_mXoKvOhCatVez8wGrtwviLJvIoiDuow&oe=6AABD986"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
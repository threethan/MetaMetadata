=Xi7HcgqeLZQQ7kNvwHJB0kr&_nc_oc=Adr1HJaEqMGUXJEwHU30kY3jb0Yoscwy3MiyI7u40PhSQko_EDIyl-R1u4FG9xIj0qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8SwX-KCEdSN6xJCovct8Hh2O7t4F_YFk_tzqjM7hO1A&oe=6A95CF27"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjT8DHztw1gQ7kNvwEiaCi7&_nc_oc=AdoCpXE-_Z3Al-YK9c214BSib1ClhgYh_mFj7XNzo5prNmda1SSoSV1f9ZB0AWt_5_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCVmcQ0pNtX-XkPcuQxUHO5trnFhhmJA5Gn28I7w8ZTw&oe=6A95BE85"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOJpBjKaVIAQ7kNvwEiWUGd&_nc_oc=AdpQP6qcROwfM74Vjs66uvCNqcnXeriZDy9gn4r79Xg5HIKk5o9sUudjaStTL37tPeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6G6EKxM7dZlfU_F-fxANv3JhN2vuyQEbQ94AQC7_1ow&oe=6A95B84B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOuUl-_jfvcQ7kNvwGT_SLO&_nc_oc=AdpNKfuwATKBeLis9thec3zszl0fJVGp-GurfQIdoHngxOplMTSgSoEgdbBrBT0ApR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQLwWl4aVDAnRF-nUZ-rLtvkGR2zbVCJXR8O_DZ08yrg&oe=6A95BFE5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKvdDC--lIQ7kNvwErn00Y&_nc_oc=AdqKpO7YHNxn6NB_-QYCwqTz6Ul3kK5oMIwO9r1l3lrZbwSFaM0ftdi4SIPX1MdHmfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyxdVM2P3mwS49NoS9D5cF8VjnzPQsSiWqVTcffS0g1A&oe=6A95E086"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
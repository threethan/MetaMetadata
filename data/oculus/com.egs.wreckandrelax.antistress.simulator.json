=Xi7HcgqeLZQQ7kNvwF6LKMd&_nc_oc=AdqHzDEzxPyHaXk9GFH-4GgSjV4QiEUG5crebk1gj9b-L2rx6r2gnpQvbt9NvNulQQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdmNzfX4Xif-ZtGyBeglZTpduvvuIlCXjnEY0SG3IuTQ&oe=6A9839E7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X96wszvalJ8Q7kNvwH8CWQ_&_nc_oc=AdojKIhbFlTB1zmUMQcYsioT5fUsTt-_r7HyoBm4cPtmpjkadW4937OjadJEkRORIB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeQH7jYJOZ4qd9bgGiCzof2qWYHkIaeqvFFnPInUJxKQ&oe=6A986185"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r30IvPtHsaYQ7kNvwH2eVAc&_nc_oc=Ado6AfWTTnKavqEm9PPSsOZR-gk-ixaYm6w8H-16RDjo0-jgL_NTk_XZtSyOh_0ZooQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbQyx-KwHQPC3yz-lEHhu5FiNVpQb6OLYylv9I1tddwg&oe=6A985B4B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOuUl-_jfvcQ7kNvwHhRE9g&_nc_oc=AdqJfOUUwA47mKL16FcCB5if6OzqNq3R3SgS5x9rHikbpLiA6q1KpckUzLqcNJTneqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi_O_nXlF5-iScO6R2RNxLcexO5_IYEswvM5Hcbv4rHQ&oe=6A9862E5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuKvdDC--lIQ7kNvwGdvE3x&_nc_oc=AdoustqzGBz7Pv_pP2tUyHSeu7aOKubuU9uNf_6kAB_NroBKAg7wue1hXw-6lP3jCGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5s1L0SNwYH4f-1lNfJyQcRhaW5pEbN9bURY8_aPJ0KA&oe=6A984B46"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
t-sin11-2.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90PWxREV_0sQ7kNvwFMyy5i&_nc_oc=AdqLZ-BMn7ODUTDr6dZtLW5IolHgCp7V_VQEfUKwvptE6_4QZQADZPETZB_p3KygduA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKapGxWX5QFPCgW-0kZ4z8KEMCAcsP_ACdFnkV1yAHKQA&oe=6AA95D67"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yHGGWmoLKkQ7kNvwE2sXrc&_nc_oc=AdpirXSpyTPOULglyR-Uc9v-DN4b-ijvoir4XkhkzlaWNWMJjlx3Pr9KwHL_Q7BYL-c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWfjMZxV0ZghQ7Oqqjpvl6vmAlsS3ACZPu1iMo_m-7vw&oe=6AA94CC5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kf6YjQVXTo8Q7kNvwGFRI0B&_nc_oc=Adr0hNsAMVvLg-43B7neg_RKl7CIzkevpz6FFRqrqF1Yd9y4CF0f51oDroUe3Kk-Ajo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-DxQu3CNni-S7R0-A6ozYHj9AbRreqewO8-pPV0lTPw&oe=6AA9468B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXJaEUxhBn0Q7kNvwHrMrCn&_nc_oc=AdolKgr7UGN0OCwjh6eZjJjJIosTYXAqJ4A_00gLZC9i86MTDg55kKKgOqQfTbuKVCg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmVk3MAnLzg8sr1gvSMINO7nmY2q70C97SfOp3nkugWw&oe=6AA94E25"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDA6yZatA6sQ7kNvwEdecXF&_nc_oc=Adp6BtG4Lwd0xAGfM8Ikyry9Nc1u5d_ICMafTdUYEQ9kPEWt4jNuZgDw5pfetgdUBNQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyvOrbMSDzfI3v977rUpncGpS5hoUKDVR8FQI2ztc34g&oe=6AA93686"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recomme
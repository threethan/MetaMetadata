=lFnoUZR1CmwQ7kNvwHzdgvC&_nc_oc=AdrUr9oPyz27b0JByioJKdBhjlZiWcBrILTttCW_jzjz9k8QJsD4aSS5FPenDsRiQ_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDo8L3LHrhs1NmDEa8QblbVwSS9XpdadIvn4igAZzzhQ&oe=6AA022E7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m15YmDpwhVAQ7kNvwEMrU45&_nc_oc=AdrZfLDpCyKraOcUGZp9gLdWJX-kAgLN5DXFPQAqo83tZCbh6vK8IyBEO4ofzbjyc3k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ75D-6nQz0Ox0nffvJ2vWKb2vBPWMx1FDThX0zQtOIYw&oe=6AA01245"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjeBrmpeEugQ7kNvwHEW4_X&_nc_oc=AdoTol61Xxw2_bkK5udVq2STWZ1AN9Qnca-8aBEYt4WhBoxMs8t-nczClIVEEshO1uQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSg9vioclt4fyqkLrr-tmGE-FHEuu9tDhnwPekoJ1Uaw&oe=6AA00C0B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_ulm6qyIvcQ7kNvwFkm8J8&_nc_oc=AdrkIAy7TYzbo1d-wkBTSfj36rGAmCRqBTGcU844IenGJ9GJBgtnmc35COIOSpYXIlA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_y4H4OCy4xhmOenUMpp41r5jHubwtkxpPI7TGLH8nIg&oe=6AA013A5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6v2DoQcIloQ7kNvwGah14U&_nc_oc=Adq5LXW3-aMajTmVPAz4Cnjw-iajI_HAoBO8Hhy0ud3CLO3sLp6AiQGNlKYEUyjYQ7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEW0wEHa7fVf9DUsRVVmcO4P9Ur3Y6F88dtAN7-rxHeQ&oe=6A9FFC06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
=lFnoUZR1CmwQ7kNvwEQsXdm&_nc_oc=AdpzhcA6rDuI7aE_D7sEzQSMBgE31rpcQpd3ff1fCh6mWWaN6uHzls-gc88YbLqdJsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfuo5vHFblPe4AgvY3lqsNE7RwCEnYVWOC9sNNRiI5HA&oe=6A9D7FE7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOrvk5Ay3SsQ7kNvwHgtf-1&_nc_oc=Adr9-19OmJs67gFLhaMBCCGKbaMnNfRMgwu84llE7Ef4A6zQ5Zbi-5DRMdbGBJWaGuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhqk3JMZQEUpm8HhWVAHVZQpHo7Mr8u2l_qzI-28nVQg&oe=6A9D6F45"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjeBrmpeEugQ7kNvwFsTn-A&_nc_oc=AdpDvnFZreZ03BLa8An-EJ26BsTkJe2BoPx87zwTRvL9wOY5qgYXbzzphjVTt9HSxsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwV3xrtp3jw_e0VGdeT5QshWSTedFSV81eRKV0gxsJBQ&oe=6A9D690B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_ulm6qyIvcQ7kNvwHb1-QO&_nc_oc=AdpI6zSrnSb_6Uoc7P6ocs_RkAnFpb4LEfTvllnVgp3hMO4BSykpSj66Sdfq2h49FJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcveQALEMGjn9GTTxfxNK5nWO7XH0OvOw45CM-GA3jrw&oe=6A9D70A5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fk4TTfboHoQ7kNvwG8sCiB&_nc_oc=Adon6EcyR6ZiB1HJ6srTorDelVYW93GJIvgi1_PcJBYUATRnSq3EacFh9pzH2gBqZos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaXYWoYYP3iJ9Wa8J0rYG-XeZrOTt0bfrWqZ8RHp5O0A&oe=6A9D5906"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
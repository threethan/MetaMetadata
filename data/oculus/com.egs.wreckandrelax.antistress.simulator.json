-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI6Musi9_gYQ7kNvwHL3M7t&_nc_oc=Adr-EA7FVHfGpHl2pooTEKNl1LjiPRbzsvk9ahLlg7bZkOgrztGjz7ZribZPxHWhbRQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCMvKm0URKcVHgoqpRMfb6TzUkHAfOFelIfUFymPouKA&oe=6A92BBA7"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjT8DHztw1gQ7kNvwFd7Fdk&_nc_oc=AdoYa_00_zP7oPLhz6fPoQQ9If5b11BYh5h46C6OydF2elvLi6buxwcCcgMy1U2Pfgo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfE4KZBm0t7RJv7wi7PD1o27WKoKLAUIp049DI4Om50w&oe=6A92AB05"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFeOSFzXzwYQ7kNvwEmYsTB&_nc_oc=AdoNuLbJzWePn3ucUzz95iCsJoo4dmGo7npkCWFoFdeZFB7vV7aFwB4pV4nS8ZD4VUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ3RJoWFlXGrT3BnzgIhOUIvKGEKbJ7pOEzkw6AaXzFg&oe=6A92DD0B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYuS-LopqoQQ7kNvwF7G4fr&_nc_oc=AdrCqvBvKo0rFUai3urP3hDZUkIEfS9uxV7L-RZn5cH39WVEEFCJ8BXMMm3kPJPRuhY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj8V--X4Ph29I8D_GoJiy1GjOMPybB7-TsCpuRsig3iw&oe=6A92AC65"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfKMCwUVfsAQ7kNvwGAmoSG&_nc_oc=AdoUGHDW2_xElUUfug9wcFyGceCWUqiUc16zlvUTlnTVPCMUXWrzbE7ikgkGb7hs47s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP69YylHbyvXQonMpAmLgnM08d9S5_GHGBC8i0lAjxvw&oe=6A92CD06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
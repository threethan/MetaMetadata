-2.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI6Musi9_gYQ7kNvwFmN_nD&_nc_oc=AdoKWpwDPRe7OWbGrOWLDCC8sVHQIzxkV9Ds65kET6GyKIemPhdl21i0jx4OXyxNJoE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGgoMFfSn6C-aF73Oz3krIOhKVTAr-Ozm0cQip5BVqWA&oe=6A940D27"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjT8DHztw1gQ7kNvwED7z2y&_nc_oc=Adq9bR85xB-vi1Zq2IoD3EwudtGS6nL_xsbSudiH0zjBy4eP3UgWd-tGLQ5Dv7Edya4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXxzVmTdJDHqxSznwRY2-_ONRD3rJKj5solzSo1HH9PA&oe=6A9434C5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFeOSFzXzwYQ7kNvwFfCboR&_nc_oc=AdpdQPH4oEA718C6dvUTp6UHOxSYBIPhaaNn2HIDzkkCLsog9fUnEwSa6ud4owe0O_g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoe_k_N1lTtNDYiFq8qCm-ZNEdAJQlHE6TjYXN19fsNA&oe=6A942E8B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYuS-LopqoQQ7kNvwHeLo6F&_nc_oc=AdoeX1Beb41gov9yHanr8fMHvudIkXD0XokHhmWeQJ8gdn5mh9yakShKlvTOmNI_MKs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQWDe2lc5i1FbVkmsjU-aNZf73MmWdlYPa8uM9P2DWOA&oe=6A93FDE5"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfKMCwUVfsAQ7kNvwFmD_Vy&_nc_oc=Adre7E6HJc0d2O-ZH36k1_QgC-UxpyCFqPVegnIrqXUV62Juymu1aYR2W2FH-dwfhBM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExKTR8IcQA2Y6QuyB2URZZIgXeuanhX2g5ZdLKqa1bhg&oe=6A941E86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
=nRfXTXqi27cQ7kNvwEp5n0u&_nc_oc=Adrxio9f3SFkVxEeavFXOPVijmFN1WqpuaSOCvUCVAoGxUD1t3ZM73lHS0iV7otTM4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvgMY2e12F-fpz8kxSiq7C0pgVBvXBiy9XUgZKsgVhcw&oe=6A9C2E67"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOrvk5Ay3SsQ7kNvwEltTtz&_nc_oc=AdqLnUcIF49oblLaVNpASd_NgnicQws_A3JPz0tiheMZ30dd0U3-mSBSLTD4k-UWJMc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaGTY1LcB3NX_VlPcTUYHsQ5xMi0Z1dJRH82FenOAVTg&oe=6A9C1DC5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r30IvPtHsaYQ7kNvwG8LFPN&_nc_oc=AdpOF8CTnFuq7NcrKcC57GG13f5QcgCeLa5uM8gmtEVza73VOLK7xpAf1p1LeAIvOOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiyuAAFCnUSTcoiuaQZx4cmvtDKN00ITIwyzVppzWv1w&oe=6A9C178B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S8VmCbTbywQ7kNvwEeGMp6&_nc_oc=AdrpsADKyXrqPLmUr3otae8xRXQbKbhEj9bRjyY5gyO1l8ljn1Ltw_h4qRhJenfduhk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh3H-0z4WO4YPKyyM8hoUhy2h_x-OaxQUYL-7xuKfN-g&oe=6A9C1F25"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fk4TTfboHoQ7kNvwF8pHso&_nc_oc=AdrmHXIhWxqvHsdiqAQzFPhR6k0UWgytcg9E0dl0ACMUkJIFvoMVo9Z3QLFRoNhbGxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtrDDiIAESD3RUkKehpl-yibsKlh4p4Y-lzwPzXEBTUA&oe=6A9C3FC6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
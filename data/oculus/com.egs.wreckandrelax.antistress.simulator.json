ale": "en_US", "screenshots": [{"file_name": "Wreck_and_Relax_01.png", "id": "867071156261366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312454_867071159594699_8543531065572179344_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLpzniKVHfMQ7kNvwGAm_yM&_nc_oc=AdrWBq2Z1ZEDXdm1hDxsrLIgsI-fvzlwVGwwMlZYvj0jnQ2PzE3ws4wBrtxTahxIZzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcW6PRcOUbAlGhByIgm2cOL-vCD4peZbHdIQ0Z4j-YQA&oe=6AB3E967"}, {"file_name": "Wreck_and_Relax_02.png", "id": "2027692744558770", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593902063_2027692747892103_3367801366316758179_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2D937oo3nAYQ7kNvwGCPV4p&_nc_oc=Adpn6VmG4m8kUumJZHiWA6pdyzi0a2f3jEvvWrUTOj_wIgvl97yIpX-CWwH1Mf88F_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLporzjstf3DqE4Iq19qmXQUuNu1gtVnEzkrEke-T78Ig&oe=6AB3D8C5"}, {"file_name": "Wreck_and_Relax_03.png", "id": "1017685797557127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308699_1017685800890460_8069973007905230751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWPZyIiw8gkQ7kNvwEn6Wvf&_nc_oc=AdpR8uhrYQRUZmqOYZ_I4UwjM50T8t4lSyYH4cRwiGUZPHElBr8EFAuwBUZNuxC69nk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK76fipjCTxNyiSDqcTOD1Os3_yq2K_TQSk9USYvUkAw&oe=6AB3D28B"}, {"file_name": "Wreck_and_Relax_04.png", "id": "1750986726089515", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593909648_1750986729422848_4283549006510047583_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1-K8gDoEoYQ7kNvwGOrV6Z&_nc_oc=AdppF40WPSwOF98BNd6PpD8dq8UtSajFsvGd5NCIVi20GeFfDEhD2IbmlMt26lByC-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLoAhVqr7IERGBj8qIAXbXrDiHbpCcNC83gjXJ7sOU4Q&oe=6AB3DA25"}, {"file_name": "Wreck_and_Relax_05.png", "id": "2192570244650376", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2192570247983709_5704826598787164870_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7tito2iZQ8Q7kNvwF4NSic&_nc_oc=Adq6H_cHb4o4aRbJ5CvAEYkdpDwf5YHkIwmm0hLJf_OFHjKAe_eYglQ4RS77OtOgPtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAamFtzwYEKsbMtJhjO59WlgqXxQ4S6GeOdSN1tagDMQ&oe=6AB3C286"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wreck and Relax", "keywords": ["rage", "destruction", "smash", "break", "stress"], "long_description": "Had a long day? Step into Wreck & Relax and turn familiar spaces into your personal destruction playground.\n\nExplore offices, homes, and other everyday environments packed with objects waiting to be broken. Pick things up, throw them, hit them, and keep wrecking until nothing is left standing. There are no real-world consequences and no mess to clean up\u2014just immediate, satisfying chaos in VR.\n\nGo on one wild rampage, experiment with different ways to destroy the room, or enjoy the sound and spectacle of everything falling apart around you. Each space is an invitation to forget the rules and make as much virtual mess as possible.\n\nWreck & Relax is easy to jump into and built around one simple idea: leave the day behind and have fun breaking everything.\n\nEnter. Smash. Relax. Repeat.", "short_description": "Step into familiar spaces and smash everything in sight. Wreck & Relax is a satisfying VR destruction sandbox built for pure, pressure-free chaos\u2014with no mess to clean up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED
ntent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_1181988860314483_4568798451517882246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3s7-r6FeZAQ7kNvwHOPB2-&_nc_oc=Adql1pYrA1_sVD_JlZFXOiwMcJO_CQbLJ5381A9oJe0ewz_MCNLxtfQMqtSIiajgYLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgQAbaSgdhWwsQQP_ms0A5NpTRXIkYMPDTx-af_h7YQA&oe=6A79E0CA"}, {"file_name": "com.oculus.vrshell-20250228-183931-resized.png", "id": "8829806823790596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_8829806830457262_8712194524679424456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnsNKQf1ONMQ7kNvwEpELbK&_nc_oc=AdqbPYjGVi7QkJbXXUxlbB1PtYHUyFsYzrSkoqbykqqJwZkFpFInoZv8CczOxDJXTXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLaTQWN2aWwGOadIPuYTso8qQ3LKbqaf6Pi_EZLa-A9w&oe=6A79B0C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1628508374697598", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392305_1628508378030931_157976051703495219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqrnCWonuAMQ7kNvwGUOuA1&_nc_oc=Adq1hBvD4hOzKYBJ6eIHE5dvUqowpNdJrnPlP7G3d0ZwQswQsvmwrP0JYAzILt4ECjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsgigMlCqT_emLOURpXS3r2fHgw-ClOTdBOpLi8xe7GA&oe=6A79C9F6"}, "display_name": "Are You Aware?", "keywords": ["aware", "shooter", "endless", "effects", "action"], "long_description": "Get ready to be immersed in a whirlwind of laughter and quick reflexes with Happy Bunny Studio\u2019s latest VR game experience, **Are You Aware?** \n\nIn this high-octane, humor-infused shooting game, you\u2019ll test your awareness of every sight and sound. \n\nCan you rescue the bunnies from their predicaments before they become too fond of you? \n\nGauge your awareness\u2014whether you\u2019re as aware as a plant, as agile as JCVD, or as intuitive as a jehdei. Gather your friends, and may the sharpest eyes and ears win! Let the challenge begin!\n\nDisclaimer: This game is not affiliated nor endorsed by JCVD.", "short_description": "The poor bunnies have been put a spell on.  Only you can save them from their torment.  Sadly, the only way to save them, is to \"relieve\" them. Will you be aware enough?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://happybunnystudio.com/terms-of-service/", "developer_terms_of_service_url": null, "publisher_name": "Happy Bunny Studio", "support_website_url": null, "website_url": "https://www.happybunnystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7797714853618510"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1148565294046472"}, {"status": "PUBLISHED", "id": "678444931865184"}, {"status": "PUBLISHED", "id": "1067432485336666"}, {"status": "PUBLISHED", "id": "1007200537458666"}]}, "baseline_offer": {"id": "1067432485336666"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1148565294046472"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9550121831711128", "version": "1.0.0"}, "id": "2273580266318978", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "A
ntent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393491_1181988860314483_4568798451517882246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAyjF1lHCJoQ7kNvwEk5WUg&_nc_oc=Adq-oPpIJq2kp7b4krNloLQ1g9XmYYvh1Ltz8BSxlJ9_S2j27aYwj9IzX6sRlNrwUUc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNxpYlh7-SkPTOb6kObmyESsZZN73rmBeNa19pciTbmw&oe=6AD386CA"}, {"file_name": "com.oculus.vrshell-20250228-183931-resized.png", "id": "8829806823790596", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_8829806830457262_8712194524679424456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MXvBNEW_NwQ7kNvwGcRrEW&_nc_oc=AdokNH2QHkWIYX58DnbYHuFziCz0NSgrF6Pr3PzWtL2ArDw65JfwBYdcZurhkiprnWY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr_WGtKYNWWo8iXqwxH5NoRtCZJNMS52H3ire5-OS6iw&oe=6AD38F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1628508374697598", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392305_1628508378030931_157976051703495219_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QACopZv6uxMQ7kNvwEsuWps&_nc_oc=AdqCiwvfHUCpM4FZr8ZPphyk1up5sCiJhMANZ20aY2TkfrrfOvqvwTDjKleTGHHgA3k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5Hu8bwVCb745scvTRhZ7dhAzFGZ1nY5qLaU1BkMo_pg&oe=6AD3A836"}, "display_name": "Are You Aware?", "keywords": ["aware", "shooter", "endless", "effects", "action"], "long_description": "Get ready to be immersed in a whirlwind of laughter and quick reflexes with Happy Bunny Studio\u2019s latest VR game experience, **Are You Aware?** \n\nIn this high-octane, humor-infused shooting game, you\u2019ll test your awareness of every sight and sound. \n\nCan you rescue the bunnies from their predicaments before they become too fond of you? \n\nGauge your awareness\u2014whether you\u2019re as aware as a plant, as agile as JCVD, or as intuitive as a jehdei. Gather your friends, and may the sharpest eyes and ears win! Let the challenge begin!\n\nDisclaimer: This game is not affiliated nor endorsed by JCVD.", "short_description": "The poor bunnies have been put a spell on.  Only you can save them from their torment.  Sadly, the only way to save them, is to \"relieve\" them. Will you be aware enough?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://happybunnystudio.com/terms-of-service/", "developer_terms_of_service_url": null, "publisher_name": "Happy Bunny Studio", "support_website_url": null, "website_url": "https://www.happybunnystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7797714853618510"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1148565294046472"}, {"status": "PUBLISHED", "id": "678444931865184"}, {"status": "PUBLISHED", "id": "1067432485336666"}, {"status": "PUBLISHED", "id": "1007200537458666"}]}, "baseline_offer": {"id": "1067432485336666"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1148565294046472"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9550121831711128", "version": "1.0.0"}, "id": "2273580266318978", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "A
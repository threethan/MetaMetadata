838498942302_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsLOe69AWGUQ7kNvwEPjGaU&_nc_oc=Adr0I5lWMicEbd3uE8EzXWNcQqUteEy9Rtzy_PETTFkrp69tK7ReyIBaurQMb_9S-CI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWgipHtL8V23WSPV7WjnB8ue29TjjLg76lWw-8JGTvyg&oe=6AF0886B"}, {"file_name": "Placing_Brick_Menu.png", "id": "4671498676407753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDr6grTUFQUQ7kNvwGPQA8j&_nc_oc=AdrBaVSCt2TvPbYRMe_Gn_vabVFfjMXEae43s1DO6uwYnMnzaABzDyo7-EHlmEo8gKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTedUUUxkVay7DlvlKReIDfsbiXF7kcQQk_WedWg0y7KQ&oe=6AF0A351"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63yRrudKZB0Q7kNvwE-e3_9&_nc_oc=AdqDo_pYvc_RyYRvmG2pd2LBumroiXnfuqDMOCmWe47yp22y4ioS7BrQtfzBQfDrn8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60nAxWO8pI2rej2IzEVtspsXYJLdkZgxooUN3XMm3ig&oe=6AF0A277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsDolsbJMOoQ7kNvwEIV5Zy&_nc_oc=Adop6O-dplAA1--8jPu52lboBYYHObldWXPZMD4u5GVNEydlXK6AikpJZTLnqBaeCQA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrq8O-W9dvUroNxZRvoITxkf00Hgbu4PkkcQS4wUKssQ&oe=6AF0B2C6"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8656251671121626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/390
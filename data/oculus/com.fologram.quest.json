tEsy5Jb3dQtlTCNbpChUtx8xIWIE_Fzdb4MQRR8EDa8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftsbhKmDWDef1GCwafZeK5p-Ugf3NRv-0y0TDDVLqfRMg&oe=69A44E6B"}, {"file_name": "Placing_Brick_Menu.png", "id": "4671498676407753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtl6ThleFtYQ7kNvwHjTOGZ&_nc_oc=AdmtTuWdfqIKdUY1kzK-cxeJsdnmVP5kXHXSAtN8JLcMqNtgAn6BPjoUP8-1Hdmb6Fs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfspELldMEUCumGi069He2-rLXRYhSqNbOXbE9Ljp49N7Q&oe=69A43111"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0Hpg1rAYLgQ7kNvwEzYprx&_nc_oc=AdlmzTmFcXsSpIgU2rbe-ieo1Ber7LOTbek6o17C_IcIoa92GcxYS2Ku4jB7Jox6KhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftg2oXi7WBkD02Bp4SRPSzcaPAqGGHTeBzPIf1x1mPdUw&oe=69A43037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwM2PYEUvF8Q7kNvwErYtTs&_nc_oc=Adlpm809af2_haCysW75QsCuBYWOYLB68Hy_O-u-Z_G8mW5VNOuZufHCMbH38yWyDok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfufnEJKRG-mTFezihV8dI1aqUyBDwjayewI2LZcpeaBZw&oe=69A44086"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8656251671121626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031328_1797869130719608_3931696136850101550_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvNYPNlNIwQQ7kNvwHQ8u48&_nc_oc=AdkxoP3Bvv8aeLu1-_gyoH02K
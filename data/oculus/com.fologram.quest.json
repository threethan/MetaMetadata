-ViUxcR4hc_zGPlFP_pUTAbjJLrXpA1Ecb6Q3JxnHy4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfucG-3bxzCNeZYmdZ2AOnXRF07wX7GuPkPCEW-6yA4_ig&oe=69A59FEB"}, {"file_name": "Placing_Brick_Menu.png", "id": "4671498676407753", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ3QC_Vlp_YQ7kNvwGNgvri&_nc_oc=AdnbemutwJdqfP5eYP9WJfw3QX0QM-w8Epoa0saCrT8KC09e6dedJ6fDfmTKsgl3b2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZLIyXIaSE21J2KGEBqA9hsK_ZQvTGEe74cj1Rk8toFA&oe=69A58291"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0Hpg1rAYLgQ7kNvwGdeW4j&_nc_oc=Adk_fxmuNRGlMlFNc2Lf7aAchNzsGjhMMmfMZ33dk-TULT583L75kpVF5x_fePk23So&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsTlqw1ryJbynpPsIM50gi1OZjKW1xKm_7F29-pu5edDg&oe=69A581B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwM2PYEUvF8Q7kNvwFcnAV9&_nc_oc=AdmkLGSjMKoQ3GutB_ZPu2Gv1iM_cO68KBdX6Y1TLvx9n4YaXD5I5GfwM2KvnShl8d4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvRgUyN8_Pno1tkEOo-3ny8rX5XLSczhV0mfvri4KXANg&oe=69A59206"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8656251671121626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031328_1797869130719608_3931696136850101550_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu_sqWokdo0Q7kNvwHgV7rd&_nc_oc=Adk8odu2v66jnPsCTvyrLYHq4
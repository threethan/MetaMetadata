/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybSwia_vItUQ7kNvwEP7dxz&_nc_oc=AdooiPxKo2TQlueWsYiYzMGVFkPDY4jxgSMJjPO3TbO5-lsdiqoOWd3ioGVUuUzDmss&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHZnqrKgFYlNYggdD3zAq79rgurenORDNbXpBlpmz_BQ&oe=6A562B91"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dozgkg8JPgYQ7kNvwFYr0F6&_nc_oc=Adp2xhRHRShquSMnjtMZeznDXVcy23XDrZ7jVgvzO_Sc5-otdcgjBZ4r9NCww23OQ9g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ0n_o83olC1nlIkwkYDNXlKGwj96mB8GSF4HpKZd1kg&oe=6A562AB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zk_uEFEVmRUQ7kNvwHT0j2b&_nc_oc=Adr7Qj0vvQuNlZgFQbKWZ6XBQnaYjUrI48_zcz8zybSJ27o2Dsgrfwyvo-O_Qtv715Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNjH0FgvgzePF999MKz0wVKf_y8m9h74v9KKuTRlXuDw&oe=6A563B06"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7839894052757396"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "441571705518798"}]}, "baseline_offer": {"id": "441571705518798"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722220897, "status": "PUBLISHED", "id": "441571705518798"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25935902706063254", "version": "2024.4.13"}, "id": "747833139485182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
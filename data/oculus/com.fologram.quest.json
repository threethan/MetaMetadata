AnXk2VVfE3O385O-wU58gASRGm8znE48FzGClzz7Rb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvy9mQB07oNZsG_WT0skcjODD2R8x6qWi7RbSeVVD2M4g&oe=699B13EB"}, {"file_name": "Placing_Brick_Menu.png", "id": "4671498676407753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PeNPAn-r9EQ7kNvwGUGqkx&_nc_oc=AdlU8Q7r7A5WndSYUp_7E1LKVauHVj3NqaG0ZdG4r_sfCCLh6MMW0-juWmxf8DkfLdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsNyRZR2Ri3n-hoB4Z22Tr5N5rd5ghc7Q5FtRJ1jDMEeA&oe=699AF691"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iazst8nQkN8Q7kNvwHOO-F5&_nc_oc=AdlcB7BKBWsgHZg7HKALqYbjjHEjMM2nixUWne0E05iVl6CGwYGBvEEBDiC2Sid4hv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvAAivQt7w5Bb-yvpuhOTlOnWQcXiibCdmX5OrEhHzR8Q&oe=699AF5B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xapBE4oPow8Q7kNvwHKuBpR&_nc_oc=AdmDOmi8vHQPPTGerJRLdJIRuI_PH49z6o-wP3QWgs3lZOUHVbdM-xdK_oox8QRkqFI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvgn61Py0G2TzX_3e2xD9RFTvHrrxcou2l9LnrBTha9vQ&oe=699B0606"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8656251671121626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031328_1797869130719608_3931696136850101550_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Zm_U9QtMMQ7kNvwGWv15_&_nc_oc=Adl86zTkKrK7YumXu8YDB5ZTY
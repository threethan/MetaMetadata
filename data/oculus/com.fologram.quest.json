sWR5Sjf44f-D9j2pSHfU9J4mHFqV_6GxP9VqDNxuTzU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afvtxi0ShrlCZeFJUvC0iOl-EkYxBjaFX5OfEEM2DvbLIw&oe=69A1AB6B"}, {"file_name": "Placing_Brick_Menu.png", "id": "4671498676407753", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035334_4671498679741086_5633484767255347672_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtl6ThleFtYQ7kNvwHcGKWH&_nc_oc=AdksrR0DZcWOEAK2Fe99_DeJXEIZoSzRjuLo7pAhaWIYrfLdGBDzDJZnXZmeAJMGl1M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afsdjk64akOOmJKPJqrR8XKdHO0YSiLkUqtBorvkt-_I3A&oe=69A18E11"}, {"file_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGEOIxBL-dAQ7kNvwEqNtbP&_nc_oc=AdlP2j_IfX6rk6Lk-xvBL6_wVazKwgNRxTlykKXX8zdLGM6FgQthcB4qhb01jgNVGlI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftRf7M-9j8Ln1SRpmBa-vtzsNIx0cyCkDrgG_P9BKpibw&oe=69A18D37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEOjdzt5KoAQ7kNvwHsghYM&_nc_oc=AdkSPUzoJw48NZ9b6vW9FCLHqo20eqmTbLvdmg1YMWRCqvrduRRe_hnjHKqMLBJwj9M&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuJm3-4Or3aCDdqfv8SZedto1Rdqxrl2ZbLG3d-fmeGoQ&oe=69A19D86"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8656251671121626"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031328_1797869130719608_3931696136850101550_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvNYPNlNIwQQ7kNvwFoYv2S&_nc_oc=AdloUPJ-A8uVMqqQBhfVEyh_N
ile_name": "Pavilion.png", "id": "1209570750075209", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035334_1209570753408542_5194570992197225579_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iazst8nQkN8Q7kNvwHX-KEd&_nc_oc=AdmVIGtYu2d1fZ_Y8cp9YABI5mGzx2cUXFAcySvRwyKGZ0CgST6lXhEteLKYL8-dBYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsw5Q8q58OO6-hhH0WszbTjKo3V0EFj3ZyHhaLLMOLlfQ&oe=6999A437"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "7876264889096560", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974577_7876264899096559_1504742761731754594_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xapBE4oPow8Q7kNvwEsyJAV&_nc_oc=AdkJp7kw3Fe_kZTnq6wwykpKwcGOvernsQKRE-Z4PCMiMMvXM4SS-KK-5YZDCsEcL7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR1kgUP-fVfUDkqRMNKFamXZM34NR4iX7hy7BT0VcuQQ&oe=6999B486"}, "display_name": "Fologram", "keywords": [], "long_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or even prototype complex mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. \n\nFologram is free to try for 14 days. To start using Fologram, download the Rhino and Grasshopper plugins from fologram.com/download then check out docs.fologram.com for example projects, research publications, tutorials and troubleshooting resources. \n\n", "short_description": "Fologram streams Rhino and Grasshopper models to your Quest 2, 3 and Pro for presentations, model making and design. \n\nYou can use Fologram to view designs at 1:1 scale, build custom 3D modelling tools, create and follow interactive assembly instructions or prototype mixed reality user interfaces and dashboards. \n\nFologram sessions can be shared between multiple headsets to create powerful immersive presentations and experiences. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fologram.com/privacy#3", "developer_terms_of_service_url": "https://fologram.com/terms", "publisher_name": "Fologram", "support_website_url": null, "website_url": "https://fologram.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7839894052757396"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "441571705518798"}]}, "baseline_offer": {"id": "441571705518798"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722220897, "status": "PUBLISHED", "id": "441571705518798"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25650628404590687", "version": "2024.4.8"}, "id": "747833139485182", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3728318473914995", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25650628404590687"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name"
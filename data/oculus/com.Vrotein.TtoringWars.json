9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X60YYQWRqywQ7kNvwFJhZ9d&_nc_oc=Adq8Z60DK1qLV67lf64q3sKMQly7falZQZbnRx8pu1ljVjHK93DwNSQ4oaCBkKV_gUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47n2uk5nUL0HpBDjbKNmwhuL3SGOiMKBpE4h0I1_8Iew&oe=69FCAA9F"}, {"file_name": "migrated_image.png", "id": "823992008120943", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162812_1238788786242741_3975762856955084800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkIaFsTRxqQQ7kNvwF4_5DH&_nc_oc=AdqSoPFyXhZ1thGB5cFSZt--PsrWOUerBghuegRDAylI7PQ0BCRQ4TCfqoZDZN7s6EA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xu5qkkzCOg6UodHNT6xTXy9wwXkry25R6beRdDekEOw&oe=69FC9A2B"}, {"file_name": "migrated_image.png", "id": "576723509853201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727760_1348437318558369_4568011019980374016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB86IEAbK-QQ7kNvwEE4WmH&_nc_oc=AdpAIte6CgJylXDTwdAb8Clgx5fDlib6_GzblLg50iMTkdNplM3ANAlAgIX1Kpgul5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZMAFK0r2y_C3VvqpkRtEBdZDhPSWZMOpKl31IUqlp7w&oe=69FCAC7F"}, {"file_name": "migrated_image.png", "id": "439144016871938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162762_133894660481200_1476219202103672832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSqtDbOH7DQQ7kNvwExDqjc&_nc_oc=AdovFdVYkDn-4sbT9GMdCXSVKGgMcatgIyuddHHG0WvQvt0IbW_bhNNNh49phMNCZ5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vyogm_3whurqSdj9OvtP2B6zzf07smDeKxZsMNG1kzg&oe=69FC8890"}, {"file_name": "migrated_image.png", "id": "201413787852725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162699_1866190333669199_2436194686826708992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iELo9T98PsQ7kNvwFRXvKs&_nc_oc=AdoIxP_rmwRwz3QIbY6uCcUOfhscjH2mvYedF4ibBLL-Axri9rm_efypWkWkiOyih0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59_9OUfImBOR38Dn0Ev6-7nmyUXYtbjB2RQVf1L9vNPA&oe=69FCA7FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TtoringWars", "keywords": ["ball", "pvp", "multiplay", "action", "casual"], "long_description": "A new sport has taken the world of Ttoring by storm! \nIt\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nPVP is available through playing online!\nToss as many balls as possible and stun the opponent by throwing at them.\nDodge the balls that the opponent throws at you!\nIf you have a hard time, try jumping or dashing to dodge.\nYou can also use the special items to throw your opponent off.\nWho will come in 1st place, will it be you?", "short_description": "It\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nTry competing with other players by playing online!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_t
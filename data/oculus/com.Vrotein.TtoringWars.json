7a0a&_nc_ohc=p4PDsupNQN8Q7kNvwEEICZW&_nc_oc=Adpo4fNmuekcIe6Icpq3a77mymW_NuZAx-qsaYXmIUy9ST2biIborRf7BGwyAh_Ui4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ipzq-uMrzpFfHjj4Zv9TevfO67cuKqCytbkmBQIj2SA&oe=69F1E83F"}, {"file_name": "migrated_image.png", "id": "237136071017196", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12602290_852520254885999_1155626436355162112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=510qMJg02uoQ7kNvwHhYJ4V&_nc_oc=Adp4PaPj7ef4CwxGumliIfKlruWymyHpTMfOcEw-8CZ6MlqsPOuFaRDY5CcP22nYFI0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14VaZGSZsdID2DAPymoq53WpgqYvMaiX0iKkOvU8CpKQ&oe=69F1E65F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store-Cover-Art_Landscape.png", "id": "407651706255469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504601_407651709588802_7813775130496073728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcewC29s6j0Q7kNvwGcpNcQ&_nc_oc=Adr3S872_PKj_D3IsYAIrz58R06bBBl-eb9qt66N03ZX7vav7x0pJMo_lbESgqb8pUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1361XRJN3qOfcPV0kRr_EQrA25l8RiFuZF7-nvC9QXYg&oe=69F21457"}, "display_name": "TtoringWars", "keywords": ["ball", "pvp", "multiplay", "action", "casual"], "long_description": "A new sport has taken the world of Ttoring by storm! \nIt\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nPVP is available through playing online!\nToss as many balls as possible and stun the opponent by throwing at them.\nDodge the balls that the opponent throws at you!\nIf you have a hard time, try jumping or dashing to dodge.\nYou can also use the special items to throw your opponent off.\nWho will come in 1st place, will it be you?", "short_des
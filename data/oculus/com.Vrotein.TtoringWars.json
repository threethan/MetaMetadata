yNRjjtcCB99sKdkUr0WtHhhkPrDDd3iqGuWPD3a_w&oe=699ED9BF"}, {"file_name": "migrated_image.png", "id": "237136071017196", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602290_852520254885999_1155626436355162112_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UvWgGuYBWkQ7kNvwEeTQzK&_nc_oc=Adk9QqQ5I--MSz2RMxPMaFd8qv5FsRM0cazih0GRIaA7rTdyMoYif2OxfR36i3SXeaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDsYmonjP9b1J9yozLLxCU8D7ZCUWM9DS94CGUAOOv-Q&oe=699ED7DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Store-Cover-Art_Landscape.png", "id": "407651706255469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504601_407651709588802_7813775130496073728_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPv28IMu45cQ7kNvwHCNzhE&_nc_oc=AdlEsmY978OhAp7ZPYEMrEzoj00w3jnAz0GGeUE8f_5ED3ZxRf4BEna8tIdM3DdCPhw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfssfM8pdrid96eYr5VxhyQ1juxNPn_VKAXDzi6WHo-THw&oe=699F05D7"}, "display_name": "TtoringWars", "keywords": ["ball", "pvp", "multiplay", "action", "casual"], "long_description": "A new sport has taken the world of Ttoring by storm! \nIt\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nPVP is available through playing online!\nToss as many balls as possible and stun the opponent by throwing at them.\nDodge the balls that the opponent throws at you!\nIf you have a hard time, try jumping or dashing to dodge.\nYou can also use the special items to throw your opponent off.\nWho will come in 1st place, will it be you?", "short_description": "It\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nTry competing with other players by playing online!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "2102474253245742"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1223720751088792"}, {"status": "PUBLISHED", "id": "1732510283714248"}]}, "baseline_offer": {"id": "1223720751088792"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1493917200, "status": "PUBLISHED", "id": "1223720751088792"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1270017409785903", "version": "1.01"}, "id": "279445129155811", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1224996980954613", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1270017409785903"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "279445129155811"}]}, "change_log":
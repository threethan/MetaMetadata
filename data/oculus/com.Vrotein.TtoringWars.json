9&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTnuTGofP44Q7kNvwG8H07K&_nc_oc=AdoDMvV3SewyFO0Tn-fm9fsoZP-RZSwCX18vD9TQb00-hk_RcyLwtjDkoSLa_T_q-aA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyg-jGYN3Hsua4E6a0rs1L_-87AGUeAe2r7m48O6BgoA&oe=6ACBA61F"}, {"file_name": "migrated_image.png", "id": "823992008120943", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162812_1238788786242741_3975762856955084800_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pQOQGISqDwQ7kNvwHA38Qe&_nc_oc=Adr6DI9RsLaVCRFOSRsTRWnmYf-CBUxVPA_M9UDrS_iFu89_gkqbBTwaeyybs7KtjDY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO4jOCiMnIXBWOeKr5FezzLk58GdjoLWTB6_q1JxekIg&oe=6ACB95AB"}, {"file_name": "migrated_image.png", "id": "576723509853201", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727760_1348437318558369_4568011019980374016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiS-GH4D63YQ7kNvwHiZoAO&_nc_oc=Adrp8K4quD3uaCEJt_jeIhjjgmGubeWVvRkrYYwPh932H8MK3mBbyHmgWc3nGGufTmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrU5iAOQMwlrrvTdswy33w0E-fNdRP7xBoUJmY-mtn-Q&oe=6ACBA7FF"}, {"file_name": "migrated_image.png", "id": "439144016871938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162762_133894660481200_1476219202103672832_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozF4ub_CiGIQ7kNvwG1UOgN&_nc_oc=Adr499vsIJ9AtT_BFaFP2rInVAOI_rx_owpzkkjiU5Iq0vMwkUaRHmOpJ-OmIYFYVoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh_U_ZKRXkOqZ0RpNlDSXAh0DN8a68GNvNo4Z2XmDP8A&oe=6ACBBC50"}, {"file_name": "migrated_image.png", "id": "201413787852725", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162699_1866190333669199_2436194686826708992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-k6UUR2G_QQ7kNvwEnL-Zg&_nc_oc=AdqJvML9F6UwXty1zIMCabVwSqU57ZMQLSSPtJc6Hbs_cHasPiNZZokumLOeuNfMr3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGYkL-uwLARv9IBjEC1yje0WG2z3s240v_KYRn1oDTIQ&oe=6ACBA37E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TtoringWars", "keywords": ["ball", "pvp", "multiplay", "action", "casual"], "long_description": "A new sport has taken the world of Ttoring by storm! \nIt\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nPVP is available through playing online!\nToss as many balls as possible and stun the opponent by throwing at them.\nDodge the balls that the opponent throws at you!\nIf you have a hard time, try jumping or dashing to dodge.\nYou can also use the special items to throw your opponent off.\nWho will come in 1st place, will it be you?", "short_description": "It\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nTry competing with other players by playing online!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_t
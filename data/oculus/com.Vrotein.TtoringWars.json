thumbnail": null, "display_name": "TtoringWars", "keywords": ["ball", "pvp", "multiplay", "action", "casual"], "long_description": "A new sport has taken the world of Ttoring by storm! \nIt\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nPVP is available through playing online!\nToss as many balls as possible and stun the opponent by throwing at them.\nDodge the balls that the opponent throws at you!\nIf you have a hard time, try jumping or dashing to dodge.\nYou can also use the special items to throw your opponent off.\nWho will come in 1st place, will it be you?", "short_description": "It\u2019s a 1v1 sport that you can win by tossing the balls at the opponent, or by sending more balls than the opponent after the time runs out.\nThe sport looks so simple, just tossing around the rock ball, yet if you get a chance to participate, you will realize that it involves a lot of strategy.\nTry competing with other players by playing online!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vrotein.co.kr/", "developer_terms_of_service_url": "http://www.vrotein.co.kr/", "publisher_name": "VRotein", "support_website_url": null, "website_url": "http://www.vrotein.co.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SIN
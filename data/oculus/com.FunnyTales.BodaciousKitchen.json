ideo_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-AssestsTrailer-Cover-Image.png", "id": "467404592609734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974819_467404595943067_4787336645653391938_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dIsY7P95TIQ7kNvwHA8xMv&_nc_oc=Adpblvt1Wm_VwdzgU642WuVjaqUjAs6TFH2gJcPnEaZwqQ8dmWgx8B3i96dVbf-z4jM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jqMf8JdetwjLU6Fkg0GLbcOk8T5u-uBSPfD_GK6Ku7w&oe=6A43D097"}, "display_name": "Automobili Lamborghini Bodacious Kitchen VR Experience", "keywords": [], "long_description": "Designed to embody the spirit of the iconic Automobili Lamborghini brand, each Bodacious Kitchen\u2122 is meticulously crafted with Italy's finest materials, delivering top-of-the-line construction and the brand's show-stopping futuristic angles. The sleek marble countertops are designed to stand the test of time with state-of-the-art acid treatment and 4D natural texture, making the stone feel alive yet more resistant than ever. The cabinetry is accentuated with a premier selection of metal and sustainably sourced wood, every detail has been carefully curated to push the kitchen space into new frontiers of elegance.\n\nThe \"Automobili Lamborghini\" and \"Automobili Lamborghini Bull and Shield\" trademarks, copyrights, designs and models are used under license from Automobili Lamborghini S.P.A. Italy.", "short_description": "The embodiment of Kitchen perfection has arrived! We are thrilled to announce the official launch of the Automobili Lamborghini Bodacious Kitchen\u2122, a revolutionary fusion of super sports car aesthetics with cutting-edge kitchen engineering.\n\nThe \"Automobili Lamborghini\" and \"Automobili Lamborghini Bull and Shield\" trademarks, copyrights, designs and models are used under license from Automobili Lamborghini S.P.A. Italy."}]}, "developer_name": "Funny Tales", "developer_privacy_policy_url": "https://funnytales.us/automobili-lamborghini-bodacious-kitchen/", "developer_terms_of_service_url": null, "publisher_name": "Funny Tales", "support_website_url": null, "website_url": "https://bodaciouskitchen.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25745810545067134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974512_1719809241883293_4534491264782289400_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XrqS504MCC4Q7kNvwGh8w6T&_nc_oc=AdrwrvhinHcM87G77o2CQds4UlsZicy6hBQSSG0kpCry8EtNOb8K2LGhCl06XFOcWTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vZf-PJkYLc0GkztX0Qd-FSTh6IQXCO9dATyi0J7eQPQ&oe=6A43CA47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Automobili Lamborghini Bodacious Kitchen VR Experience", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1718051340, "lastRevision": {"nodes": [{"id": "25605171765797680", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25605171692464354", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "110921482
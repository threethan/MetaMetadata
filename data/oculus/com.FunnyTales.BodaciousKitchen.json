2675730_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YNaI5j8M64Q7kNvwHvkkNW&_nc_oc=AdpO7-BL9YusXHDYlRjV3Odf0q6ICvL7J8ibqqQBYa7YnwUHWE6RiJBymshr_s0zZT4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNjzIxofg79dY_qSAkJmCvLMGCkk6uXlSriOCcrBskTw&oe=6AFF2464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta-Store-AssestsTrailer-Cover-Image.png", "id": "467404592609734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_467404595943067_4787336645653391938_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4igEc57fl0Q7kNvwHmP4aC&_nc_oc=AdrHkwMRPqNMvD6FkJW8Bh15kL6otH2hwEMqdrOOn3v0rA5W-ZRqWbez2aTp2u24PzU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFmv9bqUf7jwZxnjW9Y1nIwUupPoDjUvZJ2JHX2J7Zig&oe=6AFF0597"}, "display_name": "Automobili Lamborghini Bodacious Kitchen VR Experience", "keywords": [], "long_description": "Designed to embody the spirit of the iconic Automobili Lamborghini brand, each Bodacious Kitchen\u2122 is meticulously crafted with Italy's finest materials, delivering top-of-the-line construction and the brand's show-stopping futuristic angles. The sleek marble countertops are designed to stand the test of time with state-of-the-art acid treatment and 4D natural texture, making the stone feel alive yet more resistant than ever. The cabinetry is accentuated with a premier selection of metal and sustainably sourced wood, every detail has been carefully curated to push the kitchen space into new frontiers of elegance.\n\nThe \"Automobili Lamborghini\" and \"Automobili Lamborghini Bull and Shield\" trademarks, copyrights, designs and models are used under license from Automobili Lamborghini S.P.A. Italy.", "short_description": "The embodiment of Kitchen perfection has arrived! We are thrilled to announce the official launch of the Automobili Lamborghini Bodacious Kitchen\u2122, a revolutionary fusion of super sports car aesthetics with cutting-edge kitchen engineering.\n\nThe \"Automobili Lamborghini\" and \"Automobili Lamborghini Bull and Shield\" trademarks, copyrights, designs and models are used under license from Automobili Lamborghini S.P.A. Italy."}]}, "developer_name": "Funny Tales", "developer_privacy_policy_url": "https://funnytales.us/automobili-lamborghini-bodacious-kitchen/", "developer_terms_of_service_url": null, "publisher_name": "Funny Tales", "support_website_url": null, "website_url": "https://bodaciouskitchen.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25745810545067134"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974512_1719809241883293_4534491264782289400_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qIQVz7Z7icQ7kNvwEnVu8D&_nc_oc=Adp1nnjXbdQ8Mi0HVrgckXEg8JdsKjUOvg-qXqvXjWvZ6PswVU2lzjDS3GWCDno7-RQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEI1zp16VZeHbbOFpw7QEvzQjlKVxJJDckqbgEsFgWIA&oe=6AFEFF47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Automobili Lamborghini Bodacious Kitchen VR Experience", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "relea
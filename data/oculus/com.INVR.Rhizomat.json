.5771-25/499327010_735894282194194_554594768329450585_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1yLzlUc2NIQ7kNvwHGQIDt&_nc_oc=AdriOhIOKmK8tqx-w6sxIK4AxieO8PfNycQiaeOvePbTrBHw_Go4eGgEyjmDxWNRr-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MwK0aI3CvU7zvWaFSzik83VjPHKcBCqRxJpadHiWfAw&oe=6A19BFD4"}, {"file_name": "Rhizomat_ScreenShots_04.png", "id": "10010033185731188", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499320953_10010033195731187_1033932675632698971_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmdFKTAkWgwQ7kNvwFxOjvr&_nc_oc=AdpE8HP1_vVOc7RW3bqIU0Is6vb59FOK-cZUVDdWqfWHhj9mVAc43nsBT36tdMjzMCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vVnbn41utX6Eubm5a45aZfo-zR8xhgC6tzHsboaprdw&oe=6A19BEAF"}, {"file_name": "Rhizomat_ScreenShots_05.png", "id": "1649125629106120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499357865_1649125632439453_2503025008738710840_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FehcJoo7uCEQ7kNvwESlREr&_nc_oc=AdoCPY_BiMQ_33mfk1_RXUSfPR9ZFegmc0GTTFqvclmaNXLP2gwK79Xf1CsUCWp4yNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e4nPugoTeI2C5IRmJRxDEtglrKYbmBV0EkY9X-sAU9A&oe=6A199EED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rhizomat", "keywords": ["Fiction", "Rhizomat", "Dystopia", "Futuristic", "SciFi"], "long_description": "The 360\u00b0 experience \u201cRHIZOMAT\u201d extends the Narrative Space \u201cRHIZOMAT\u201d, built by the artist Mona el Gammal, from physical into digital space. In the world of \u201cRHIZOMAT\u201d, the Institut f\u00fcr Methode (IFM), a global private company, has replaced the state and suppresses and monitors people with the promise of security and stability, down to the minutest areas of their life. The underground group Rhizomat, whose members push ahead in research into an alternative social order in individual cells, as well as organising practical resistance, rebels against the totalitarian IFM. Rhizomat has set itself the task of snatching those whose free will has not been completely extinguished from the dictatorial system. The regular mind control tests by the IFM are used by Rhizomat to set up alliances. Between dystopia and utopia, obedience and freedom, a struggle develops for each individual.\n\n\u201cRHIZOMAT VR\u201d is the pilot project of a cooperation between ARTE and Berliner\nFestspiele / Immersion. The film, which was co-produced with INVR.SPACE, explores the artistic potential of connecting theatrical forms with new technological possibilities. At the same time, the film reviews the new medium with criticism and reflection, thereby leading the way to the development of virtual reality as a medium of art. Welcome to the Institut f\u00fcr Methode.", "short_description": "In the world of \u201cRhizomat\u201d, the Institute for Method (IFM), a global private company, has replaced the state and suppresses and monitors people with regular standard examinations. But the standard examinations do not always go according to plan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://invr.space/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "INVR.SPACE", "support_website_url": null, "website_url": "https://invr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2475
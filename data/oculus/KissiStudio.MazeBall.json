e": "vlcsnap-2024-12-05-12h33m28s0434.png", "id": "1698753247354950", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391899_1698753250688283_1945521280646569377_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6nV6by8RNIQ7kNvwH19fwt&_nc_oc=AdmUpmnm6FVxyT1c1PVN6-zEuTdg0PQjZe7NtTj4Cz-Un-wa4bB1OLUyzTGgv3T3cus&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvgDPqUj9z7Mh8mB8DB0nwq765TIStZW3RwENpyqHQ-sg&oe=69A59605"}, {"file_name": "vlcsnap-2024-12-05-12h33m28s0437.png", "id": "8478305922273730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391988_8478305928940396_3600149355462907753_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LneJZ2pneawQ7kNvwET7Iyh&_nc_oc=Adk38dEpJVxFDwOch7qtiU5MtJfkES40B-bcItQISrNubMreuDOLe88ZiP0QPPwHo5A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afuo-6pWXhcNGDbESO01nRnye9hgFiob0q5iTVgESOlQmA&oe=69A594DE"}, {"file_name": "vlcsnap-2024-12-05-12h33m28s0439.png", "id": "946090240822988", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392016_946090244156321_1791498614154345535_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hmn76rOeRIQ7kNvwF-sYjw&_nc_oc=AdnvjbiGktsaGhuyOwR64mc4T5BvVTncMkSQr1C6g1AfTffuY_c50DglalixaZlduzQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuWkpO1w6vKU4DK7LW_-YYnI7e34avpMuDA_ckdn6MYmg&oe=69A572E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "623719806660076", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974796_623719809993409_4410330902145971880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKUXM1N9_6sQ7kNvwFuLDFp&_nc_oc=Adk057YUMeC6TrWexxDXKq_2ZAZ06rR2m9nklEllyAAmpPXafOsKx54da8gQcq6mOEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftc07MWeREeZnerJehb010GlNUDNavNwghB3N7tqUibSQ&oe=69A5891E"}, "display_name": "MazeBall", "keywords": ["mazeball", "puzzle", "mixedreality", "toy", "Physics"], "long_description": "# Early access special price, includes 12 different maps!\n\n# The favorite toy is now in Mixed Reality! - \n- Enjoy exciting mazes, tracks, and an all-new arcade mode!\n- Experience realistic physics that bring the ball to life in Mixed Reality!\n\n# Use hand tracking to control the ball \u2013 no controllers needed!\n{558691627060910}\n\n# Arcade mode with maps only available in Mixed Reality!\n\n{8515711355206315}\n\n# Speed run against other players around the world!\n\n{1275387267005139}\n\n# Scale the ball to any size, move it around your room, and create your perfect gameplay setup.\n\n{986706286830904}\n\n# Interact with your loyal flying droid companion \u2013 or just annoy it for fun!\n\n{546369714954430}\n\n# Upcoming features - \n- **Level builder.**\n- **Ball decals.**\n- **And much more to come!!**\n\nEarly gameplay footage was captured on the Meta Quest 3.", "short_description": "Control the ball with Hand Tracking in Mixed Reality! Enjoy realistic physics while solving mazes, avoiding falls, and exploring amazing levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kissistudio.com/mazeball-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kissi Studio", "support_website_url": null, "website_url": "https://www.kissistudio.com/mazeball", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id"
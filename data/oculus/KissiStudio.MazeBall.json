69A59118"}, {"file_name": "vlcsnap-2024-12-05-12h30m10s226.png", "id": "468360056290485", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031612_468360059623818_6640972744293883690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z74kxam0UbIQ7kNvwH1VTGH&_nc_oc=AdkzA-W-rIwynMdwS0JABqhDqjDFQl6CBaBzym-OECHakoR4BphJD7ZKIJgKml2NBrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv5-hia-aXWYUygU8P0bIbQJ04NGNHp3ZxcRCm1HZ9j4w&oe=69A57B87"}, {"file_name": "vlcsnap-2024-12-05-12h34m33s663.png", "id": "590777140168156", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/229144902_590777146834822_1497920964037956634_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOul2AsUIEgQ7kNvwHc84IJ&_nc_oc=Adk6TupRED7HkMqQQCPxV0cHLH82LIB07WuNib17JSifJhOqfjQLeijFZ-f-vQII84o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvFVgDJjD2yix4-YAWO0LtVuFnrooO3LrrJsBpPVnzWSg&oe=69A58317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "623719806660076", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974796_623719809993409_4410330902145971880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKUXM1N9_6sQ7kNvwFuLDFp&_nc_oc=Adk057YUMeC6TrWexxDXKq_2ZAZ06rR2m9nklEllyAAmpPXafOsKx54da8gQcq6mOEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftc07MWeREeZnerJehb010GlNUDNavNwghB3N7tqUibSQ&oe=69A5891E"}, "display_name": "MazeBall", "keywords": ["mazeball", "puzzle", "mixedreality", "toy", "Physics"], "long_description": "# Wishlist NOW!\n\n# The favorite toy is now in Mixed Reality! - \n- Coming soon with tons of exciting mazes, tracks, and an all-new arcade mode!\n- Experience realistic physics that bring the ball to life in Mixed Reality!\n\n# Use hand tracking to control the ball \u2013 no controllers needed!\n{558691627060910}\n\n# Arcade mode with maps only available in Mixed Reality!\n\n{8515711355206315}\n\n# Scale the ball to any size, move it around your room, and create your perfect gameplay setup.\n\n{986706286830904}\n\n# Interact with your loyal flying droid companion \u2013 or just annoy it for fun!\n\n{546369714954430}\n\n# Upcoming features - \n- **Speed run online leaderboard.**\n- **Level builder.**\n- **Ball decals.**\n- **And much more to come!! Wishlist NOW!**\n\nEarly gameplay footage was captured on the Meta Quest 3.", "short_description": "Control the ball with Hand Tracking in Mixed Reality! Enjoy realistic physics while solving mazes, avoiding falls, and exploring amazing levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kissistudio.com/mazeball-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kissi Studio", "support_website_url": null, "website_url": "https://www.kissistudio.com/mazeball", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8250536591679485"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "722406380826663"}, {"status": "PUBLISHED", "id": "853405807533841"}, {"status": "PUBLISHED", "id": "1649397786503613"}, {"status": "PUBLISHED", "id": "865452845955263"}, {"status": "PUBLISHED", "id": "801444416002996"}, {"status": "PUBLISHED", "id": "1407408767002433"}, {"status": "PUBLISHED", "id": "802009945484648"}, {"status": "PUBLISHED", "id": "1408435786855227"}, {"status
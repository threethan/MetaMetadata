HqA5wQ7kNvwHPRfs1&_nc_oc=AdpU-b-Bs6gitIE1wYdf07W6yf24BHbd8MG4sf_-8Bp6xDuCT42KHbMB2p5p_jjDDB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQfxNUBNjwJ3ZwEWbwe4aO46qck2-Cna6og1dxmSXt5g&oe=6AAFE56C"}, {"file_name": "2560 x 1440px (24-Bit PNG).png", "id": "2021149414950575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974771_2021149418283908_2196074273883749439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRbBFB7_ScQQ7kNvwGsm-l6&_nc_oc=AdrEvGsY6l-Ft1E_rka3DiNf6hi-_UCCzN_9v7kKM-KNQhZ_IWgObZRtXPMyFOMEYLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ20JtqPKPorLD8x3z95DG1ixcSuXlLsmOKdkx19sPJHA&oe=6AAFEAEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (24-Bit PNG).png", "id": "413320524383415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974848_413320527716748_948685097875047050_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qOthN1QGwQQ7kNvwGnkcaH&_nc_oc=AdpVT7Tfp2461MApEte8OP5sxHcJUGZFhf-wPude3RVtmc1rlCdYNB10OPcxFN39ynw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS9Cw8AQ9Dlf9qqXMRcGglgykNJONFvAHGzpey-IogDg&oe=6AAFD4E8"}, "display_name": "HoloConnect", "keywords": [], "long_description": "Have you ever dreamed of being in two places at once? With HoloConnect, the portable holographic teleportation app, you can do just that! HoloConnect lets you create and join rooms with other users, where you can see and interact with each other as if you were in the same physical space. You can use any device that supports mixed reality, augmented reality, or virtual reality to experience HoloConnect. Whether you want to have a business meeting, a family reunion, or a party with your friends, HoloConnect can make it happen. You can also record and share your holographic adventures on social media and amaze your followers. HoloConnect is so advanced that it has been used in the International Space Station to connect astronauts with their loved ones on Earth. HoloConnect uses volumetric video technology to create realistic and lifelike holograms of real people and objects in real time. You can also customize your avatar and environment to suit your mood and style. HoloConnect is the ultimate app for immersive and social communication. Download it today and discover a new dimension of reality!\n", "short_description": "Early Adopters HoloConnect: the app that lets you teleport anywhere with anyone. See, talk, and touch holograms of real people and things. Try it now and be amazed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexa.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AEXA TECH", "support_website_url": null, "website_url": "https://aexa.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6938716546246886"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1116698586450598"}]}, "baseline_offer": {"id": "1116698586450598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707261600, "status": "PUBLISHED", "id": "1116698586450598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24244162271942378", "version": "1.12.0"}, "id": "819348593293219", "channel_name": 
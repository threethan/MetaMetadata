c=sDfFvPdW-eYQ7kNvwHzgYcv&_nc_oc=AdpL1knvoQts0Ijks1qBczC3iPMKg2Ju2PrrYXzfTpSOd48iaTFdkC7ivfkPgXVtyNo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hHyWLQxteJKSupGkg39enVZQW_7jRTWJn6uP3BIiUWA&oe=6A466D6C"}, {"file_name": "2560 x 1440px (24-Bit PNG).png", "id": "2021149414950575", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974771_2021149418283908_2196074273883749439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCBGjlJSdtcQ7kNvwGtX3iu&_nc_oc=AdqYbE5j_xGsceIrU3wi0ldA3g58qla0BXPtPus3it-cmw0a1yIWuBVSbYP3iIif-dk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AFcrNIYVPEYgY0RbyTyXM5nU974vS3u2luuUpSZ88Yw&oe=6A4672EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px (24-Bit PNG).png", "id": "413320524383415", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974848_413320527716748_948685097875047050_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZz0WPuSGxQQ7kNvwEEjKR1&_nc_oc=AdqYpmc0Rb9JXo5vU_MzU2l9hOTN701-45_DGTkqePGPoUbRdXLz5t9KHOtIpjEqh7U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__BT8huIzv-I9Uiyh6YX1BZJjMabxBpDV34riiUkbb0Q&oe=6A465CE8"}, "display_name": "HoloConnect", "keywords": [], "long_description": "Have you ever dreamed of being in two places at once? With HoloConnect, the portable holographic teleportation app, you can do just that! HoloConnect lets you create and join rooms with other users, where you can see and interact with each other as if you were in the same physical space. You can use any device that supports mixed reality, augmented reality, or virtual reality to experience HoloConnect. Whether you want to have a business meeting, a family reunion, or a party with your friends, HoloConnect can make it happen. You can also record and share your holographic adventures on social media and amaze your followers. HoloConnect is so advanced that it has been used in the International Space Station to connect astronauts with their loved ones on Earth. HoloConnect uses volumetric video technology to create realistic and lifelike holograms of real people and objects in real time. You can also customize your avatar and environment to suit your mood and style. HoloConnect is the ultimate app for immersive and social communication. Download it today and discover a new dimension of reality!\n", "short_description": "Early Adopters HoloConnect: the app that lets you teleport anywhere with anyone. See, talk, and touch holograms of real people and things. Try it now and be amazed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aexa.tech/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AEXA TECH", "support_website_url": null, "website_url": "https://aexa.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6938716546246886"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1116698586450598"}]}, "baseline_offer": {"id": "1116698586450598"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707261600, "status": "PUBLISHED", "id": "1116698586450598"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24244162271942378", "version": "1.12.0"}, "id": "819348593293219", "channel
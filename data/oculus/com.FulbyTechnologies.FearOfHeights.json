6_794856764011012_6713161392637083648_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg_iNUTk-RcQ7kNvwEfPCBt&_nc_oc=AdqhtHLu8DYiHb7x8KjR4kLU-xm2WoBg_4RK7cWao0yWCVUXQ0bljVYGhEpx7ZW91x8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGAE5qXmfoARPMrWKnYvrF8R6nbZ9F_70PJZlhGrE45w&oe=6B06FB37"}, {"file_name": "migrated_image.png", "id": "138929254210136", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_130780494119676_1936810915106127872_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utbaVjh9msQQ7kNvwErhVaI&_nc_oc=AdrfCRw1YpdT2n-k9CN8iYsJ4dblE7T75MZ_D57F8gOxePAZvxY3CZw-joe9W6maB8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBatXLXqXDvZvR1a9ql9PvvJSJkRPFrfm77T5k6il4eQ&oe=6B071888"}, {"file_name": "migrated_image.png", "id": "871844183286974", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602128_192882641203272_214217137475026944_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5cysbvDLBEQ7kNvwFd25YC&_nc_oc=Adr7RsX_yiobuip6AoApfjuj3gs1dfuerEnEGxfu21eA1R_GqAn0zDU4o_lqNHlXi8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl4W-8jtEmt58KJZ30cLa92i56D3tpXyJSoq82Mo69Ww&oe=6B07080F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Fear Of Heights, And Other Things", "keywords": ["fear", "height", "horror", "scare", "bridge"], "long_description": "This is a VR experience which shows how virtual reality can invoke an involuntary response. The current stationary scenes are:\n\nA wooden bridge over a canyon\nA narrow ledge on a cliff\nBeing in a dark passageway with only a flip lighter\nBeing trapped underground with the walls closing in\nIn the ocean surrounded by sharks\nOn a window cleaning gondola on the side of a skyscraper\nPerforming a base jump", "short_description": "A collection of scenes for demonstrating VR presence to new users. Has no jump scares."}]}, "develop
217137475026944_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCV5zn_j6S0Q7kNvwEJIsm4&_nc_oc=AdrEjTcVwvvKSwzTTpqu7i8-O44YQiM4YP1x31IyUwKzR940deZ9RPAl9Kk1ImeS6mk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgrH5SvgyFsTzmyXnE021H7GWoztz3Px0zy6E8B5bbnw&oe=6A75CACF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Fear Of Heights, And Other Things", "keywords": ["fear", "height", "horror", "scare", "bridge"], "long_description": "This is a VR experience which shows how virtual reality can invoke an involuntary response. The current stationary scenes are:\n\nA wooden bridge over a canyon\nA narrow ledge on a cliff\nBeing in a dark passageway with only a flip lighter\nBeing trapped underground with the walls closing in\nIn the ocean surrounded by sharks\nOn a window cleaning gondola on the side of a skyscraper\nPerforming a base jump", "short_description": "A collection of scenes for demonstrating VR presence to new users. Has no jump scares."}]}, "developer_name": null, "developer_privacy_policy_url": "https://s3.amazonaws.com/arduxim.com/privacy.txt", "developer_terms_of_service_url": "https://s3.amazonaws.com/arduxim.com/terms.txt", "publisher_name": "Fulby Technologies", "support_website_url": null, "website_url": "http://store.steampowered.com/app/535460", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5037793769613903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.
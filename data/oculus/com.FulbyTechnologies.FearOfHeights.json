6_794856764011012_6713161392637083648_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6sUoswElncQ7kNvwGev1ez&_nc_oc=AdoQ-2BuCkTpfhtE2f6Yxi8F994BrF0ogX6-ewxKYz72VUd1ggodKTXW7gvv42IsUok&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStOpISjO7-a1fdkv5N7mUVTmLs0vCEl76z4i_XU8s8Gg&oe=6AFB1DB7"}, {"file_name": "migrated_image.png", "id": "138929254210136", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12602290_130780494119676_1936810915106127872_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yEHPUPTs_oQ7kNvwHyJUIu&_nc_oc=AdoEHrT-ggD9SvNpwoSsmMStA7SqIg8hJBJ54s6g2RyzMKkgXhgCZgYfjRmxv7oX9hE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv0NTKTHZtXmGfXfI2RkE-lajG6Rt4QYy7OPEShqdT4A&oe=6AFB3B08"}, {"file_name": "migrated_image.png", "id": "871844183286974", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602128_192882641203272_214217137475026944_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emszgd8_MZkQ7kNvwEG0l-y&_nc_oc=AdoV1NmF6VDwDXg2N9DOmCBolbap4bsrFa_ecUbw2rzCcFKAjM-e8JFz_AY7zYR6aHg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGSk-p260MGjgJ3AGHTosgPj_i57edzZTs9lwCseOTwA&oe=6AFB2A8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "A Fear Of Heights, And Other Things", "keywords": ["fear", "height", "horror", "scare", "bridge"], "long_description": "This is a VR experience which shows how virtual reality can invoke an involuntary response. The current stationary scenes are:\n\nA wooden bridge over a canyon\nA narrow ledge on a cliff\nBeing in a dark passageway with only a flip lighter\nBeing trapped underground with the walls closing in\nIn the ocean surrounded by sharks\nOn a window cleaning gondola on the side of a skyscraper\nPerforming a base jump", "short_description": "A collection of scenes for demonstrating VR presence to new users. Has no jump scares."}]}, "develop
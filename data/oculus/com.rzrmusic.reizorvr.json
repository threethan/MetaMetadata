vr images.png", "id": "1586032425600932", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001716_1586032428934265_3674098814508108597_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_y6p23lOhQQ7kNvwEkw1up&_nc_oc=Adrmzivsa9lSx7eaVQMssNCidDSnXq4w94a7ZrRLTV7WNGxnObTyI_K0jIr_BM92X1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTBuPnanUV5xlYGcyTLzI-56d_5A6-CFtaRl9VJs0ulg&oe=6AFC5EDE"}, "display_name": "ReizorVR", "keywords": [], "long_description": "Immerse yourself in the vibrant world of Reizor, where you can explore a curated collection of talented artists and their stunning galleries. Discover a diverse array of simple images and videos, along with breathtaking 360-degree images and videos that allow you to experience art in a whole new way. \nNavigate through interactive panels to view each artist's work, enjoy captivating visual storytelling, and engage with immersive experiences that transport you into the heart of creativity. Whether you\u2019re looking for a moment of inspiration or a deep dive into artistic expression, Reizor offers a unique platform that combines simplicity with innovation. Join us in this artistic journey and see the world through a new lens!", "short_description": "Discover and explore a curated collection of artists featuring their galleries, captivating images, videos, and stunning 360-degree experiences in Reizor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://reizor.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "RZR Music LLC", "support_website_url": null, "website_url": "https://reizor.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
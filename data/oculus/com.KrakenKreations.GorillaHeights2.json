eren\u2019t possible before. Whether you're speedrunning to the top or just vibing with friends, every climb hits different."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorillaheights/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "Kraken Kreations", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillaheights/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27158354457099361"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1697717341388192"}]}, "baseline_offer": {"id": "1697717341388192"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775144280, "status": "PUBLISHED", "id": "1697717341388192"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27174142208853919", "version": "2"}, "id": "948780894312838", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27135626782705462", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27174142208853919"}, "release_status": "RELEASED"}, "b
iends. Whether you are trying to beat your previous score or competing with others, Gorillex provides a fun and memorable gaming experience every time you play.\n", "short_description": "Gorillex is a very fun game."}]}, "developer_name": "Gorillex", "developer_privacy_policy_url": "https://sites.google.com/view/gorilllex/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gorillex", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilllex/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26371377919181511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "887787567356402"}]}, "baseline_offer": {"id": "887787567356402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772985540, "status": "PUBLISHED", "id": "887787567356402"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27520573470928611", "version": "0.3"}, "id": "1651220425903152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26371377895848180", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27520573470928611"}, "release_status": "
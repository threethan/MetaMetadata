FNTuvzoi9g&oe=6A395D98"}, {"file_name": "Sk\u00e4rmbild 2026-05-07 095314.png", "id": "1874741636546928", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821782_1874741639880261_2410570034555875815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrE752IYqmkQ7kNvwHdSOdm&_nc_oc=Adqvca0JopIGZQ1aErhHUnD-gKqhWXQTFeaj6WQoR-wgtEw8hoLEWP9KMLpNUxzxLIU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u2dd0YIrY7xYlCxqIxFLL4Htp8-Snb9SAUxr7uBxzrg&oe=6A395073"}, {"file_name": "Sk\u00e4rmbild 2026-05-07 095249.png", "id": "4468524213366411", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821782_4468524216699744_5750690307674098994_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apCvmvxVCsgQ7kNvwH3PWrH&_nc_oc=Adp9KAja6kYdjxEpY1ZqoMl1jtpic-sHuGo-yXsmK35Kr3sTg4qmxRBnzA5BNm08sMQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9v9ur7SUE4P1rhMIdP52OQcC_ZK85PwQ3OHVQOYRG_2A&oe=6A393D2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Old Lethal Ape", "keywords": [], "long_description": "Old Lethal Ape is a very fun and exciting game that keeps players entertained for hours. It combines creativity, strategy, and quick thinking, making every round feel fresh and engaging. Players get to explore different challenges, make interesting decisions, and react to unexpected moments that can completely change the outcome of the game.\n\nOne of the best things about Old Lethal Ape is how easy it is to start playing while still offering plenty of depth. Beginners can quickly learn the basics, but as they continue playing, they discover new strategies and ways to improve. This balance makes the game enjoyable for both new players and experienced ones.\n\nThe colorful design, lively gameplay, and sense of adventure make Old Lethal Ape stand out as a game that people can enjoy alone or with friends. Whether you are trying to beat your previous score or competing with others,Old Lethal Ape provides a fun and memorable gaming experience every time you play.\n", "short_description": "Old Lethal Ape is a very fun game."}]}, "developer_name": "Gorillex", "developer_privacy_policy_url": "https://sites.google.com/view/gorilllex/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gorillex", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilllex/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27022340490751914"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823270_1703117617788815_7412972511682338937_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoaayJbFHpgQ7kNvwFAYI54&_nc_oc=AdoTD4PvCNkDR5TX1F847BDliCfMTOR023N5v5plkI4sTWwJgipjqBj3iORYmWy59hg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__nxr6B-L0-mtk8hw6pnJVJEoM31XOwIE5OnhceSNkvA&oe=6A392C1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Old Lethal Ape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1772985540, "lastRevision": {"nodes": [{"id": "26371377999181503", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale"
a30f&oh=00_Af0D7canyMHpAB6bpoIgoIMTbEX8Jzd-xyb4nHoca_E50Q&oe=69EA2C81"}, {"file_name": "Screenshot2FIX.png", "id": "1626921311841169", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825257_1626921315174502_7414445095998610265_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mDFC-YJSuIQ7kNvwGMml8v&_nc_oc=AdoZPkCAXl17zfW9HMjGbhmYoGOyLICkDXpZ529hk3mry5skUgh5IBi7E4xhx8BOjXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-fBfXPvTJrXbN319GYEwuS-fgWuIH0PJ88N2dCD54uw&oe=69EA26E9"}, {"file_name": "resized_2560x1440.png", "id": "1507328021029958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307451_1507328024363291_1330560444394397530_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saUeTdz6plIQ7kNvwEuKJYL&_nc_oc=AdqKmXTnKHLBf5YMrJh-xizs068C4_GRuDAC0FG0D-aclwAj2w6a79a46AOuxc4OBqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12M3s65v1UpGsj2bw5P9nOywh_SaNrC2GxE5ZDjmoDIw&oe=69EA196D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillex", "keywords": [], "long_description": "**Gorillex** is a very fun and exciting game that keeps players entertained for hours. It combines creativity, strategy, and quick thinking, making every round feel fresh and engaging. Players get to explore different challenges, make interesting decisions, and react to unexpected moments that can completely change the outcome of the game.\n\nOne of the best things about Gorillex is how easy it is to start playing while still offering plenty of depth. Beginners can quickly learn the basics, but as they continue playing, they discover new strategies and ways to improve. This balance makes the game enjoyable for both new players and experienced ones.\n\nThe colorful design, lively gameplay, and sense of adventure make Gorillex stand out as a game that people can enjoy alone or with friends. Whether you are trying to beat your previous score or competing with others, Gorillex provides a fun and memorable gaming experience every time you play.\n", "short_description": "Gorillex is a very fun game."}]}, "developer_name": "Gorillex", "developer_privacy_policy_url": "https://sites.google.com/view/gorilllex/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Gorillex", "support_website_url": null, "website_url": "https://sites.google.com/view/gorilllex/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26371377919181511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "887787567356402"}]}, "baseline_offer": {"id": "887787567356402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772985540, "status": "PUBLISHED", "id": "887787567356402"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26669827956003171", "version": "LethalApeAlt"}, "id": "1651220425903152", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26371377895848180", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26669827956003171"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1651220425903152"}]}, "change_
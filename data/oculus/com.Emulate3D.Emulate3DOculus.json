5/38974717_945087326237384_1040395005170793042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBfGG2GgNzsQ7kNvwGudU1V&_nc_oc=AdlVVpNesisg3DV5AvETBBMs85y0XStc8fZd7QTIfj9iCmCS5FYL8Iiv73Qn46zcAeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv6knktpmfEji8gcgt-hSBjq-uM41z9L1cCH1KCytcLTw&oe=69A04590"}, {"file_name": "Screenshot5_2560x1440.png", "id": "769597437011005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75568723_769597440344338_244696081608794280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTDlXS4f7GIQ7kNvwFAURO1&_nc_oc=AdlrahHE0Fp16sEQAs9rYlthTtyXhJ05QHtbsyPar_vlMKOFZTkromxkNqGTD7EZINg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWjluN7Kr1PKp8sSiM0oJGy_Pn0zedXioWGKigBn6Kug&oe=69A04D86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emulate3D Viewer", "keywords": [], "long_description": "View animations of material handling solutions and equipment. Communicate proposals with your customers in new and exciting ways. Help with training by showing animations of system behaviour from the operator's view point.\n\nThe app is completely free for you and your users to enjoy.\n\nFeatures:\n\n\u2022 Connect and interact with live scenes running in Emulate3D\n\u2022 Playback any .raw3d animation file from Emulate3D\n\u2022 View any .raw3d static file from Emulate3D or SOLIDWORKS\u00ae (using the Emulate3D plugin)\n\u2022 Open .raw3d files from other apps\n\u2022 Store files locally on device for offline playback\n\u2022 Offline sample animation included\n\nRequires a license of Layout3D, Demo3D, Sim3D, or Emulate3D Controls Testing, in order to generate animations or layouts in .raw3d format. Please contact info@demo3d.com for license information and sales.\n\nThanks for downloading the Demo3D App from all at Emulate3D by Rockwell Automation.", "short_description": "View animations of material handling solutions and equipment. Communicate proposals with your customers in new and exciting ways. Help with training by showing animations of system behaviour from the operator's view point."}]}, "developer_name": null, "developer_privacy_policy_url": "https://store.sim3d.com/demo3d_2022/meta_quest_privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Emulate3D by Rockwell Automation", "support_website_url": null, "website_url": "https://www.demo3d.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "838932134050524"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "866493744391504"}]}, "baseline_offer": {"id": "866493744391504"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668212760, "status": "PUBLISHED", "id": "866493744391504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5363800740413311", "version": "1.11"}, "id": "267056911476056", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3451213635005374", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5363800740413311"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "267056911476056"}
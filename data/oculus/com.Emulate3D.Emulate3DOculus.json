 format. Please contact info@demo3d.com for license information and sales.\n\nThanks for downloading the Demo3D App from all at Emulate3D by Rockwell Automation.", "short_description": "View animations of material handling solutions and equipment. Communicate proposals with your customers in new and exciting ways. Help with training by showing animations of system behaviour from the operator's view point."}]}, "developer_name": null, "developer_privacy_policy_url": "https://store.sim3d.com/demo3d_2022/meta_quest_privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Emulate3D by Rockwell Automation", "support_website_url": null, "website_url": "https://www.demo3d.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "838932134050524"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "866493744391504"}]}, "baseline_offer": {"id": "866493744391504"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668212760, "status": "PUBLISHED", "id": "866493744391504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5363800740413311", "version": "1.11"}, "id": "267056911476056", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBin
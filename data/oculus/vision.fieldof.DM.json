972221440_n.png", "id": "1413855549526198", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_1413855552859531_742967447879524699_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7Lz3so4HkUQ7kNvwEZ569o&_nc_oc=AdrV3G4H_nohpcS7Y__kki2LWvRAKZcDqX9TtHh4gMIewrn88zgn_gOBCAr-t8n4nYg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTUdWiPT8lf51Cv-mn_wj2S4aUBG1P3Bfw2yjhMmWWJQ&oe=69C5414F"}, "display_name": "Dark Mechanism", "keywords": ["infinite", "steampunk", "clock", "tunnel"], "long_description": "Travel through clockwork gears and use your gaze to dodge obstacles, collect perks, and avoid touching the Mechanism. With a variety of upbeat music tracks, infinite levels, epic scale clockwork rooms and obstacles, you'll enjoy traveling at high speed and testing your reactions and focus. Keep your eyes ahead of the game, don't touch anything, and survive the Mechanism as long as you can.", "short_description": "Travel through clockwork in this infinite level game. Avoid obstacles, collect the perks, and don't touch the Mechanism."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fieldof.vision/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Field Of Vision", "support_website_url": null, "website_url": "http://fieldof.vision/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24939827902332620"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-
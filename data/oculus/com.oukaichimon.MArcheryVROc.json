6356_244289922786527_6435381681233854464_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aAGFmkCK4AQ7kNvwGRUhuy&_nc_oc=AdrZNzccF-ke8QHd-dRC5ORCDbwLQwbNJjP0zFO9UJM0Yx_xxc5dIoKq_oyvWhc5oD0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ozefIsR83VBPjMFy2yAGMugLWgO1E39hdNUMWuN8_Yw&oe=6A0F2B01"}, {"file_name": "migrated_image.png", "id": "143857460315906", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12449084_171174863711859_918031053153632256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYJHLjCdBKoQ7kNvwE9XrxZ&_nc_oc=AdqAIORAm-sRtn3lFaXISV3ShFqQb3mLYcIks6NfNiuqfWG0DOjICXHGdfgQfpkgnFM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YJjv4npl31gi9bzXP12QY-aHNu0xEYHhUEXC_sI1i-g&oe=6A0F15D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["Sports", "Archery", "Multi", "MultiPlay", "Japan"], "long_description": "Reality is messy, complicated, and tiring.  Unlike reality, this VR game is very simple.  Just aim, shoot, and hit the target.  With these three simple steps, you can reset your mind and feel refreshed.  \nIt's like yoga for your mind!  \n\nOne game lasts one minute.  However, in just that one minute, your perception of reality may be a little different.  \n\nThe point of this game isn't to be fun or exciting.  If anything, it's a calm, zen-like experience that allows the player to feel refreshed after playing.  Our mission for our players is that by focusing, they reset their mind and refresh their mood before getting back to reality.", "short_description": "Reset and refresh your mind with VR and Competitive Archery!"}, {"images": {"nodes": []}, "id": "348352732742319", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["\u9ad4\u80b2", "\u5c04\u7bad", "\u65e5\u672c"], "long_description": "\u73b0\u5b9e\u662f\u6df7\u4e71\uff0c\u590d\u6742\u548c\u7d2f\u8d58
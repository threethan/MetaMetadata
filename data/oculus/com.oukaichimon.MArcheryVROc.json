6356_244289922786527_6435381681233854464_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_krcJ93aUoQ7kNvwHwwoZd&_nc_oc=AdoeJbSVTJrDAGHE1fkIB5b1T8PLSizYkmtB2UZMU3zuveqTT1TQm965NEIxYs0SFRA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnhT0OI92bl0L5MLMTPK9UJGEtml5GtTcpUq4wLVF9tQ&oe=6A75C7C1"}, {"file_name": "migrated_image.png", "id": "143857460315906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12449084_171174863711859_918031053153632256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DZpk2EH8WMQ7kNvwFIURA1&_nc_oc=Adrvo6CgwkIDnjsvsj3EwhTxLgK8Bv2ug-w03txrDZZCSZ9Y-YxKuHfIKEIQnuxPaMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe3k1_RKDXKlIIwNzqsMCbloLBdhxppHzuxkmYbRZzEQ&oe=6A75EAD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["Sports", "Archery", "Multi", "MultiPlay", "Japan"], "long_description": "Reality is messy, complicated, and tiring.  Unlike reality, this VR game is very simple.  Just aim, shoot, and hit the target.  With these three simple steps, you can reset your mind and feel refreshed.  \nIt's like yoga for your mind!  \n\nOne game lasts one minute.  However, in just that one minute, your perception of reality may be a little different.  \n\nThe point of this game isn't to be fun or exciting.  If anything, it's a calm, zen-like experience that allows the player to feel refreshed after playing.  Our mission for our players is that by focusing, they reset their mind and refresh their mood before getting back to reality.", "short_description": "Reset and refresh your mind with VR and Competitive Archery!"}, {"images": {"nodes": []}, "id": "348352732742319", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["\u9ad4\u80b2", "\u5c04\u7bad", "\u65e5\u672c"], "long_description": "\u73b0\u5b9e\u662f\u6df7\u4e71\uff0c\u590d\u6742\u548c\u7d2f\u8d58
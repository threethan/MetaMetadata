6356_244289922786527_6435381681233854464_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IIoKYb8kfMQ7kNvwGF1zL7&_nc_oc=AdrUdZuqY0hhMYZOVdhDy_m93YJvkWwGLDP_YjRxxCjTndniE8E-SKjgFWBZvANp8As&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yF8xzGyAqFVky4PRZbuV8REVeOtLvFH4i-nyg-pOgOg&oe=69D24DC1"}, {"file_name": "migrated_image.png", "id": "143857460315906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12449084_171174863711859_918031053153632256_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ph4nBe3E3sQ7kNvwEUHsKR&_nc_oc=Adqo9PK_8YRCExbXW-Mn1ZxROkuP3Hn8K_Gcwl4lZ4kWDGe7ChojWzRuaSFMMhamJRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21BKzkI7V-VFJcIuqIhKNLWjzmtGRw72rK8prgNEWy-Q&oe=69D270D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["Sports", "Archery", "Multi", "MultiPlay", "Japan"], "long_description": "Reality is messy, complicated, and tiring.  Unlike reality, this VR game is very simple.  Just aim, shoot, and hit the target.  With these three simple steps, you can reset your mind and feel refreshed.  \nIt's like yoga for your mind!  \n\nOne game lasts one minute.  However, in just that one minute, your perception of reality may be a little different.  \n\nThe point of this game isn't to be fun or exciting.  If anything, it's a calm, zen-like experience that allows the player to feel refreshed after playing.  Our mission for our players is that by focusing, they reset their mind and refresh their mood before getting back to reality.", "short_description": "Reset and refresh your mind with VR and Competitive Archery!"}, {"images": {"nodes": []}, "id": "348352732742319", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Modern Archery VR", "keywords": ["\u9ad4\u80b2", "\u5c04\u7bad", "\u65e5\u672c"], "long_description": "\u73b0\u5b9e\u662f\u6df7\u4e71\uff0c\u590d\u6742\u548c\u7d2f\u8d58
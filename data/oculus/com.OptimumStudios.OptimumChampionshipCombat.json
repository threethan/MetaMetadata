ZWSGbe57hW1o6_CnbyxN-pX7-wd9K0eDfx0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLBzYLZY4yvpnE994mbRGJWPe2xWAkz211NSKTuMCHGg&oe=6AFDD42F"}, {"file_name": "gp3.png", "id": "1556982628549908", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdaT3nSbs64Q7kNvwEFQgP4&_nc_oc=Adr2eCQJHMZSoFVvWjWw7JJzwIG1eXJALbkc_Ewgx4C-8XSkYbYtLKAjrTPlaAaBAWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU_jOBP1_zaLvpKAQc4GD_DzePF36BGWmxA7ij38_pKQ&oe=6AFDD787"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6dhh1UwC2MQ7kNvwE4r41P&_nc_oc=AdpYXMPi3z2f4FYofkGkjBxpc4CMbZbZE2NvlICK92h6DOygR6NNznRZ1G9ej7KuG64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQenNBJHvNdlEWBe6bQDJjHJ0Iv5XkwWvR5EwGJuPaGGQ&oe=6AFDC038"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Erffi8_6iMQ7kNvwGADqCg&_nc_oc=AdqcL7otFZZ5bQxUMdL5Srt7mB5VyyTjiOmtcn7vN7Hu56lSlMCBiT392fglQhZWGyI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkh8eatzGMaoWtJNO714GCCV2kRXnBN1clKS0-wfq7wQ&oe=6AFDBD1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GWykVjQDgcQ7kNvwFyeQ0L&_nc_oc=Adp8GJ9WXmEkWDxhOam0WuFtRKqoYcZ8AGJrHGTjP0hwEUin_y4gUq0QDoMrWbUTM-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlAl48ujViS6SAjE_gX67Do6t0vyYMXEd8A_FJSJF8tA&oe=6AFDD288"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes"
tent-ams2-1.oculuscdn.com/v/t64.5771-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExBCKbyBGxoQ7kNvwG8rb1H&_nc_oc=Adqo3cCyq1j-da8QpiQhd5aZckQMYRlPOuMwzn7zcfUQUMMPNMQ2LZJkaeYB6fg2Kpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32KAdxmngbI4srwvOl5u5j5hlw8CmMN0ugTx8UuJH15A&oe=69E0DB47"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeavWb6MzZMQ7kNvwHNJ7Qj&_nc_oc=AdpbcjuU6UZz2ZalArp1i6KmRUFU-dwmdANbK80LJOA-yFlrOlSqU16SoseHW9na_GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16CgDqxIEZLN-8e-k_D3rM6EfgQWgQ2U5CSSTr_gBnHA&oe=69E0FC38"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNnGr1ZZLacQ7kNvwGBPU3K&_nc_oc=Adohiuu0VVnEuUiSkBt8WHS2lJL0QeP-DrFnNFx4TOAoSiJkIJ-EasNAakz13Nu0MH8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ATW8LGvyFReAFSauvI0z_2oQoAy0-kqFHJVLeLfWMaA&oe=69E0F91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-MuOvr57ngQ7kNvwGHRr_p&_nc_oc=AdqzPI_OuJkGAZeC4VqST3O8sgY_r-g___QglE_ek7zOPaqlAYr9hp7BTHJKpWl9dyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XJhielsRjW-a0NqZHmLndQGQU5_tcBU6w34RQcN8O9w&oe=69E0D648"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&cc
tent-ord5-2.oculuscdn.com/v/t64.5771-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6I3fa1TODEQ7kNvwFXbO6N&_nc_oc=Adqi1r9LDmvdaQY2O6kN0Ml-e1KO2YvjaxWEjM_2J4cFPXNU5D0rqU8V9pve2XiDN0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dvjvt8dpvSK74jbRqUG9IZJu-_wj4qg5gAAOMVKeqTA&oe=6A01D0C7"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVM5BRaNmXYQ7kNvwHx4wcc&_nc_oc=AdqU1pnKn_ROipojZHTocxr62bH7uGQ2aeUx2o5YYYA_aEj6h4w-DYQsDJbLtNNOOjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5apOKJKw8m106SX0KDu_qIi7JdIplR0ypYK6jUmGRUjQ&oe=6A01F1B8"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVPty9nqYLwQ7kNvwHyTn9e&_nc_oc=Adp3Nwj1HbqPQt2C-j6XSprmvZXGqR-iCEkez2ct3CFEK-VykRbNR_yKx16us0Zn4G8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OE3xhQVwUz4io1teakSW_2Kn2BV_fv1AA-QkM_bF-1Q&oe=6A01EE9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50scZd0ZbNUQ7kNvwHONrdt&_nc_oc=AdqkXyaF4TnmSJAYWVq9K6hfo92zIyee7CD5vfJASsIEjh30wYaa8CC3IonFVEticJY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65NyiKv4y0X7IZxuOG7wpr4u-VXXqOKgbS7-dAYBIzxA&oe=6A01CBC8"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&cc
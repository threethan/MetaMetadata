tent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_G_Poc_2S_4Q7kNvwGIUHZ2&_nc_oc=AdqdgxgsjeqDUgLEvjROrQu76OFAejF6ZqNCQTPh0BjCsSP0voHwQ9HhA3HPiddcO2Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKGgVxboLwUKK3Rpy9fDVC47DA6gyFWyE_I9p_sUMLfg&oe=6A918447"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZzwEDf-EfAQ7kNvwGH6aH5&_nc_oc=Adrnh1k6ic3zIdcEAFzrRWl5ueri_yEq8wf0WtPGEf8QZQ0UjphoCASkUTvXC0F1wIE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcVpITFoVzqU21VkSqD6SWCVq6lOxgdqfm3IQdUqMcEg&oe=6A916CF8"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYSIcdrzgNUQ7kNvwGY_EK8&_nc_oc=Adr2wAkoCS1sjf_2pEErzFBhcSyegWtnoETQnzrQsCbl6ngnVE9Qw46h9nowuvBpQ2s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc0x4ZSFGM9fdrwMWZsg4Ufuq6EECEccUMpiTIGwKH6g&oe=6A9169DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ-qe9-2L8YQ7kNvwFZkfdW&_nc_oc=AdqvmKEYJkdG2c8myhIEAMcmqKxneBP0PeoXK3zIwknSOXzXdL4elgB0KyAaWlh28Yw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcQRmj-ZxAxmP259uQPMFYmhBBMdEYZmrXDRrmqySOkA&oe=6A917F48"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&cc
tent-fra3-1.oculuscdn.com/v/t64.5771-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1Ol4t8P5FkQ7kNvwGbAcjw&_nc_oc=AdovoigZfjwoAf6ZLbxTNrcMqd0bFEb2mbAXROIsjuNYJkVOyERGihzt6T85BP5ZtfQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3inXa1zELM_Z2kIVZ-9787zHtUh3RPrT7ayRDUYCr2Xg&oe=69F5F347"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQWbbbCiCCAQ7kNvwGH4Qk0&_nc_oc=Ado4LqzoA7vgO7r4pOIAesrlAbmPqxJsCbZthmU1hv6h9YzOVG0ta8GmyPoIeRaHYEY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3arjh7-uETABqwJp5YxPQfYyy6S_ccBCx9b8X9Kpcg1g&oe=69F61438"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZpFhU5Yvh4Q7kNvwEZdRD4&_nc_oc=AdqjbJF3mm7Yuk4nM68d50FWS3iv_f_2SjH83LtDHd_iVLiZDUZU_ZyNCV_J7Ov6kYw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12dG63qCvXPbwvglpWuH4mbGZaUP3H3sQmjDXzUdiTYg&oe=69F6111E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cN03-wncB58Q7kNvwFaQFD1&_nc_oc=Adqr976jVnCvRXQCYsEMJvt8900hJGyxJaHKXFegzO_CorjAm6jDIKQm6GcB8us5GJY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NkLQYnC2vIJmua1I2xFw6eU2dpGmG7vPQNzVcvUJbcw&oe=69F5EE48"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&cc
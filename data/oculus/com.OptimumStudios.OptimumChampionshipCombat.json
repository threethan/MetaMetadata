id=6e7a0a&_nc_ohc=jnb5uae3uLUQ7kNvwGWGf0R&_nc_oc=AdrBmqyEHevsSKuVNERkrmDNj0wCZ-oiE91L1ZyoT6wVU4BZrwQvth96oRS9CBCjnh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3WVYCyyE13TdLswH40tJNyBE1kiWcH8EWidGG-7f5Cdg&oe=69F0AD47"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDf0tdlapkkQ7kNvwGTJS5b&_nc_oc=AdpcQjZTLEwRRaNEAvyZQYwKSJWQAiu6fu7la0MLkEdhged3rThOSM3oMLJaNRaqI18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0Mjs7nMC7moF9sI4zpG-2m6K7z03bGM8GgGmt0Qd1GPg&oe=69F0CE38"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1tVfXuuG1MQ7kNvwHEriBb&_nc_oc=Adp1X9NyOQt8bF7HMdquNtcQae8wV4aVP52uB1kdXjGOBGNbAqRgP4RZmqxVJ1xQ0FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0FHI-fbH94gZdEUs0MwWiXimCaDTqRIYXm9rQic6FJyg&oe=69F0CB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ppWuVXuZzcQ7kNvwHphdB6&_nc_oc=AdoncIbEzNoYquWKe3nXIWW6n5YRWBR30u9qf-Ydy_5HqSf_h5DcdspxIseglR5gtj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2KgvSpxBYtIEh8e8LN0zcVM_b-x7ifIUciCq52S6gvKw&oe=69F0A848"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FddmxaXOHoQ7kNvwEPo94c&_nc_oc=AdrZZxiKoZQj-n-f9940k-DS7ZeYiSeJiW2lnEUVwzaFlL1x1hA-UGJz5sLT0HRM2Qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn
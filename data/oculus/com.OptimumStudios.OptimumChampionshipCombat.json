63199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJT4pcAVOrMQ7kNvwHQQJlN&_nc_oc=Adq8ZwFzKi63LG_Ljn8A1x_jBcXpIrww1umd53ayZadPKm6x3TefvNbOwjqP_z3SFos&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sBsXXg5oFZD2Gqma2DTbcTy4-QkjUOHrskGnLFAjuaw&oe=69D27BB8"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE8Iuc9dI1oQ7kNvwGK-Z6n&_nc_oc=AdqWXBLEg8Cgo2OOJ8IlT5FDyGFdh-KDIzgcdqJZIQNhX-iXazIoWfJFbooikIRY7ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B8PC1O2jwYE1TRQfbfOKqB6S08ohH2p9jmOk6cX7fPg&oe=69D2789E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TobxdcZfn2sQ7kNvwFEizHN&_nc_oc=AdrWXlUYovwwqEl9fHeB6MqDqkfDU8GuWnyeJNe0sGrOKrBZdN826RWAwccwlrSTeVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZAM4ntjiwejqE8geezlwQVXzfpAoYf3hmwyKgsi7Gpw&oe=69D255C8"}, "display_name": "Optimum Championship Episode One", "keywords": [], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "This is the demo for Optimum Championship, a fighting game that transcends space & time. Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be Optimum?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8649967535129054"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "618354610554160"}, {"status": "PUBLISHED", "id": "846251067383591"}]}, "baseline_offer": {"id": "618354610554160"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736308320, "status": "PUBLISHED", "id": "618354610554160"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25937322355966970", "version": "4.3"}, "id": "1949766811881191", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBina
-25/38974863_1556982631883241_7363249922218798521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Db5cJhHhnUQ7kNvwFCMV1m&_nc_oc=Adk6jfowQsjnJN2WJj_FHuhbEzSdorVV_TfoquDlxNXibVlRAKOZ7yaLK0wzR9skMfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPNIQexqnlWJgm9xpIA4UAZeHVdXBJDbOSRHlL4hrzEw&oe=69AD70C7"}, {"file_name": "gp1.png", "id": "1142278683726059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974863_1142278687059392_2906263199071376096_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9yElJ-FZW8Q7kNvwG1p_UU&_nc_oc=Adks_wR5mmFacqb_qhed84HkqqpoWj6Ln5qSMhHIigEeMPbR8XvHpIDRPd5fEmXOIwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHFhNjj1jk6bwb8ZIaXQvT0KkVTJS0tQSwqujh6l1TNQ&oe=69AD5978"}, {"file_name": "Untitled.png", "id": "7569894256472929", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035310_7569894259806262_7151631013236152165_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhU303VGgIkQ7kNvwGFnOq8&_nc_oc=AdmAdGNMEV5f8Pw0m10_eoYinDdWYjc2COHOuMZAhcpr-UlvWjweDGBm7g4tB0snNoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwcz9hr-_JYpUksXH0bGT_sLDi9kFDrnWI9Nm6ssNobVA&oe=69AD565E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "APPLAB Optimum Championship landscape.png", "id": "1542918709634266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036644_1542918712967599_2041103033551509623_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFJr--J1LZUQ7kNvwHuVK5I&_nc_oc=Adk8FnWv8hM-tmtjGdC1QNq_KMOeHMlpuqr3JkScpSAjGF8dCNiryrymygvl7lMBL3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaABzzfk8BQUeJs0TdTHw1ngpTgLnbplpSkd2UTGuGLA&oe=69AD6BC8"}, "display_name": "OPTIMUM", "keywords": ["Optimum", "Sword", "Fighting", "Bow", "Combat"], "long_description": "The losses had been in the trillions, and so an agreement had been made. One name from each of the warring civilizations would compete for the seed of life granting the right to grow the next scale of the universe\u2019s fractal plane molded in the image of its champion. In this contest of deities & fiends, an ancient fallen foe, the shapeshifter of endless names, set aim on claiming & destroying the seed, to reset time & space for without a new scale all existence will collapse into a big bang. But Optimist have faith! As you have uploaded into this future body & mind, so too our last champion has into your own, the one who reigned by his word without ever lifting a blade, but now robes must stain red, less to the abyss we all slip. Godspeed to victory may you lead in the Optimum Championship!", "short_description": "Are you ready to take on deities & fiends in the ultimate fight for survival? Are you ready to be OPTIMUM?   "}]}, "developer_name": "Optimum Studios", "developer_privacy_policy_url": "https://www.optimum.college/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Optimum College", "support_website_url": null, "website_url": "https://www.optimum.college/championship", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8684149351710872"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468731145_808391144761649_796137040071478195_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmCobP_Z6cEQ7kNvwHxJvU4
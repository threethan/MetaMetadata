77_170931719135496080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PIDBbgOIeUQ7kNvwGhspbK&_nc_oc=AdopZTdHegZ0Lagu8UbSDlyXVBq6KiCrYU9weLqHLQxE3uXxypJEsy6mSabQa4QAJXM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ18jBNgSEVkge1uZUF3YOG1PEwy4_s10FMEUZ9lFCj1A&oe=6AE894FF"}, "display_name": "CAD2VR", "keywords": [], "long_description": "CAD2VR brings your CAD models into the world of Virtual Reality allowing you to review CAD models in VR and initiate multi-user sessions and invite your clients or employees from remote locations to virtual CAD meetings.", "short_description": "CAD2VR Standalone for Meta"}]}, "developer_name": "revis3d", "developer_privacy_policy_url": "https://www.cad2vr.eu/en/privacy-policy/#app", "developer_terms_of_service_url": null, "publisher_name": "revis3d", "support_website_url": null, "website_url": "https://www.cad2vr.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8925667377511885"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "478423894714740"}]}, "baseline_offer": {"id": "478423894714740"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732531800, "status": "PUBLISHED", "id": "478423894714740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29122742294044429", "version": "1.0"}, "id": "7705317296214178", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122742294044429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.81.1:\n\tHighlights:\n\t- Improved animations\n- Update file UI\n\n\tAnimations:\n\t- Reworked animation groups\n\t\t- Animation groups are now collected under each doc actor\n\t\t- Animation groups now group parts which have the same animation tracks and are next to each other in the hierarchy\n\t\t- All node animations are grouped in one animation group\n\n\tBug Fixes:\n\t- Fixed a bug where the standalone version crashed when closing the application.", "created_date": 1793188407, "id": "29122742294044429", "version": "1.0", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122742294044429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.81.1\nHighlights:\n-Bugfixes", "created_date": 1791457787, "id": "28845052218480106", "version": "1.0", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122742294044429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.81:\n\tHighlights:\n\t- Added Animations\n\t- Improved scenefile storage structuring\n\t- Settings are being saved\n\n\tAnimations:\n\t- Animations can be loaded from GLB and GLTF files\n\t- Animations can be saved into scenefiles\n\t- Animations are listed in the animation menu and can be controlled as well\n\t- Animations can be loaded and used in multiuser sessions\n\n\tScenefile Storage Structuring:\n\t- Directories can be created and navigated when loading or saving scenefiles\n\t- Scenefiles can now be moved from and to a connected quest device\n\t- Scenefiles can now be moved from and to a cloud storage\n\t- Scenefiles can now be moved from and to a on-premises server\n\n\tSettings:\n\t- The following settings are automatically saved and loaded each time CAD2VR is used:\n\t\t- Loginname\n\t\t- Rendering settings\n\t\t- Scene settings\n\t\t- Flight mode settings\n\t\t- Last used import- and scenefile paths\n\n\tBug Fixes:\n\t- Fixed a bug where the standalone version crashed when closing the application.\n\t- Fixed a bug where the standalone version crashed when the Meta Quest is set aside.", "created_date": 1789738989, "id": "28587752860876711", "version": "1.0", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122742294044429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.80.3:\n\tHighlights:\n\t- Added support for Offline On-Premises Servers\n\t- Added an Abort-Button to the loading display when loading CAD-data.\n\n\tOn-Premises Servers:\n\t- Option to start a CAD2VR server locally and connect to it in a offline network setting.\n\n\tBug Fixes:\n\t- Fixed a bug where part instances from scenefiles were loaded incorrectly.\n\t- Fixed a bug where user entries were not cleaned up when participants left a multiuser session.", "created_date": 1781614920, "id": "27448246748160667", "version": "1.0", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122742294044429"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.80.1:\n\tHighlights:\n\t- Added multiuser improvements.\n\t- Added bug fixes.\n\n\tMultiuser Improvements:\n\t- Quitting the application as a host now also correctly stops the multiuser session.\n\t- The messages for muting and joining users have been improved.\n\t- The fly warning does not appear multiple time after joining or leaving multiuser sessions.\n\t\n\tBug Fixes:\n\t- Fixed a bug where calling \"Reset Parts\" on the scene object did not work correctly.\n\t- Fixed a bug where adjustments to the transformations of models and the scene object via the modelsettings menu did not synchronize correctly to new users.\n\t- Fixed a bug where users where teleported to the start position after loading a scene file.\n\t- Fixed a bug where loading a new scene file during a multiuser session did not stop loading. ", "created_date": 1776776619, "id": "26754498754202140", "version": "1.0", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
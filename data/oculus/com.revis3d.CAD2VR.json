_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m7-a_C18r-vj1OUca5CQ6HNP6CupV5moXU9j_A-XUEA&oe=6A2C0D45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CAD2VR_Meta_App_Store_Thumbnail.png", "id": "823250142928844", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036669_823250146262177_170931719135496080_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxJkAw-jIh0Q7kNvwFO4O6v&_nc_oc=Ado9TlZWQG6xpmmuuoqwvMurim2Qnw_LR1mek9fxUDVglvRPKTXM69Hrv3QP-tykuDk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PUuNK1XCv9h-oAjnH5qtz-SEBvlY43-NuWzbxCX05Ag&oe=6A2C0E7F"}, "display_name": "CAD2VR", "keywords": [], "long_description": "CAD2VR brings your CAD models into the world of Virtual Reality allowing you to review CAD models in VR and initiate multi-user sessions and invite your clients or employees from remote locations to virtual CAD meetings.", "short_description": "CAD2VR Standalone for Meta"}]}, "developer_name": "revis3d", "developer_privacy_policy_url": "https://www.cad2vr.eu/en/privacy-policy/#app", "developer_terms_of_service_url": null, "publisher_name": "revis3d", "support_website_url": null, "website_url": "https://www.cad2vr.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8925667377511885"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "478423894714740"}]}, "baseline_offer": {"id": "478423894714740"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732531800, "status": "PUBLISHED", "id": "478423894714740"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26754498754202140", "version": "1.0"}, "id": "7705317296214178", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26754498754202140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.80.1:\n\tHighlights:\n\t- Added multiuser improvements.\n\t- Added bug fixes.\n\n\tMultiuser Improvements:\n\t- Quitting the application as a host now also correctly stops the multiuser session.\n\t- The messages for muting and joining users have been improved.\n\t- The fly warning does not appear multiple time after joining or leaving multiuser sessions.\n\t\n\tBug Fixes:\n\t- Fixed a bug where calling \"Reset Parts\" on the scene object did not work correctly.\n\t- Fixed a bug where adjustments to the transformations of models and the scene object via the modelsettings menu did not synchronize correctly to new users.\n\t- Fixed a bug where users where teleported to the start position after loading a scene file.\n\t- Fixed a bug where loading a new scene file during a multiuser session did not stop loading. ", "created_date": 1776776619, "id": "26754498754202140", "version": "1.0", "version_code": 43, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26754498754202140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "7705317296214178"}]}, "change_log": "CAD2VR 1.80:\n\tHighlights:\n\t- The standalone version now supports multiuser sessions.\n\t- Several functionalities for multiuser sessions have been improved.\n\t- The transfer of saved scenefiles to the Meta Quest device has been improved.\n\t- Memory tracking for crash prevention has been added to the standalone version.\n\t- Added a basic tutorial for VR controls. The tutorial will be shown to demo and eval users when entering VR the first time.\n\t\t- The VR tutorial can be started manually from the about menu.\n\n\tMultiuser:\n\t- Starting a multiuser session directly after logging in has been added.\n\t- The selection of the audio device for multiuser sessions has been added.\n\t- The selection of the microphone and audio device during multiuser sessions has been added.\n\t- The usage of the participant list has been improved.\n\t- A host function to remove single participants from the multiuser session has been added.\n\t- The mute display for self muting and being muted by the host has been improved.\n\t- Added the option to manually retry connecting to the voice service.\n\t- Added a voice connection status display to the multiuser information menu.\n\n\tBug Fixes:\n\t- Fixed a bug where the application crashed when creating a montage instruction.\n\t- Fixed a bug where the application crashed when deleting a montage state.\n\t- Fixed a bug where the active toolicon was displayed incorrectly for the standalone version.\n\t- Fixed a bug where the standalone version crashed.\n\t- Fixed a bug where UI elements in the standalone version did not show hover effects.\n\t- Fixed a bug where the visibility of the cutting plane was not applied correctly.\n\t- Fixed a bug where the snapturn did not rotate the user around its own axis.\n\t- Fixed a bug where the user was positioned at an angle after loading new CAD-models.\n\t- Fixed a bug where the check for new released versions did not work correctly.\n\t- Fixed a bug where starting the montage tool would also open an instruction.\n\t- Fixed a bug where the montage state UI-element was displayed incorrectly.\n\t- Fixed a bug where the controllers where blocking the measurement tool.\n\t- Fixed a bug where grabbed objects could not be moved beyond a limit with the right joystick.", "created_date": 1776263282, "id": "26692616107057072", "version": "1.0", "version_code": 42, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26754498754202140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772466191, "id": "26228018966850124", "version": "1.0", "version_code": 41, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26754498754202140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772191789, "id": "26197658006552887", "version": "1.0", "version_code": 40, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7878148605597106", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26754498754202140"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1770302228, "id": "25992517340400289", "version": "1.0", "version_code": 39, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
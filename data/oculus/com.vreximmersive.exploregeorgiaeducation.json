uscdn.com/v/t64.5771-25/38984472_389428555600282_3003053972459182054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCs-N6I0EFcQ7kNvwGOmENG&_nc_oc=Adq0i_KV8GSe7StRy2VhA3HiC904rVZx8ndj4mwwNqDQcutEymeS9--7iPfklKR9yBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1khtr2HCEsK2GXtv2i8O1BhDoFNKIvV-guoTkXQ6TitQ&oe=69E0CA49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4WwN7y1LYYQ7kNvwF38D9P&_nc_oc=AdrRM5PwN2hDIk488Jfbg7wEf3cI7SNznkEz61bIMpfQlxI_YHW_en21auaEZzMt7_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zVApqdHzBs09anF7uLc6onnR56Ae1oUkQTkS25xr5VA&oe=69E0E09B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "contex
uscdn.com/v/t64.5771-25/38984472_389428555600282_3003053972459182054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrvXV0AWNO0Q7kNvwFvzWhA&_nc_oc=AdobYwxgvKm3b3NdEfYV9FyCyOLA28YAPW3I2sA3cCUIOzOR-tQBGO3AMtNla7Gan3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2W0XEfd2UfWZ-00qBdgHOUTYcIfhHwt6whIRd4G2w-g&oe=69CD03C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKzKdDWJi9sQ7kNvwEVN9Al&_nc_oc=Adp9QNLava3sz9d0YqSaYtj0Vl4dzhhGU08rRvD2ZwyrispWBoJhLu5z1obQoL77u10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEO_y-bi8eWxl0w6FIQghHVeNFJVEIykX1oEH7NH4T8w&oe=69CD1A1B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "contex
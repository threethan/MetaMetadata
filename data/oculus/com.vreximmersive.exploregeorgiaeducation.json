uscdn.com/v/t64.5771-25/38984472_389428555600282_3003053972459182054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnqRR-zfDskQ7kNvwELzJ3V&_nc_oc=AdrhOw8yN2rPAK_9mUF_vL-SkR5CFawpuia-t2OUewwTpqQ-P41IBzH0gD6ZPbuzASU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvMB-Vh5kTlXT3Wtr6TxboqmyQ4LoOi8uJWue3h5VWFg&oe=6AC27309"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EqdjQwr4RwQ7kNvwFai9ai&_nc_oc=AdqnvN72tQb3s3J0rrSfJi_rqS2SY9mrAh78KJfD1rVplcCcU93JBDNLcTR6b7mze7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2aY7e6OeOBx0MM54HCKhdEgdb4EvrprujruxD3zlztQ&oe=6AC2511B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "contex
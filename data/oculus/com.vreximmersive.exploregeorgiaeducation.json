7kNvwFPPlbP&_nc_oc=AdlBlw_xFMU0p3Sq_5dpQb1UA2oeZriYaqKO9_8H8o6UeQ07fwofW_M4dv3ymE3zaxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqVRF0IyYBrExEOze4E4uGtjiBZ_PTsvyizOki7zAOYA&oe=699AEAC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hVUhqbIP3MQ7kNvwGo0D6U&_nc_oc=AdkktxvCYLK7RqiNH9Y7cBMnUZQ-8F_0NEoY_-Zznsl9cg8PtiV33fffC2q3FPxTobw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv76XDJGr9_JgbSs648VdCk2G37qbe3B0y-ZmioSaS0ig&oe=699B011B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIR
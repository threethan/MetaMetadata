7kNvwEPIQzu&_nc_oc=Adl464eqR0_FUWBDwTqtEpNqcjzb8Rlv_eZWa8pQ7Pooy4qZoPC_7FGYlADYKnPGHKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftgqibf-fAOW-UZtxiRoAPTndKtZI8LuSarmIwqygdoNg&oe=699C3C49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0F01Gth6wsQ7kNvwHPQwjl&_nc_oc=AdmwzDLagJyQLHJDTOmPFYzBwJaIeWiv9cc3tL1U_kRNnj53pFxj7mQydY_0VFszk-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsEIKD34XWEPUpVmt1bnyl2liPSGynEylpGkrW3VU3S_w&oe=699C529B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIR
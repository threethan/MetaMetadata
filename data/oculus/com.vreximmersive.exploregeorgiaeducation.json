uscdn.com/v/t64.5771-25/38984472_389428555600282_3003053972459182054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wJPDV7XsF8Q7kNvwEzg9MX&_nc_oc=AdqDFogqGG-5XjDRxTq3eoC51TIzsriuu1etXcBkY-jtYS2JPwueZHlbNT0k6yPzdFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79AjU4RsiWTsG9l8-f5XaVXJIX3xKwjesFIsQWbF2-IA&oe=6A131B89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "133100415030455", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984464_133100418363788_9068777434616357734_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUNULoq0SQYQ7kNvwHFsFDx&_nc_oc=Adq1SqUB9z4J-Cdu49dApe8hTIQUFUf-9VvXYBui0d4tFktgS99laKzybCKFqTfkTXU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fsHipsp_-5vBg55GTsPZ3YlJoJgKNdawtGOUwhnUO0Q&oe=6A12F99B"}, "display_name": "Explore Georgia - Education", "keywords": [], "long_description": "With this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \n\"Explore Georgia - Education\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.\n", "short_description": "Explore universities and libraries of Georgia. \nWith this interactive VR experience you will be able to explore several universities and libraries of Georgia.\nYou will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "contex
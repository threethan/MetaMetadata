stic industrial environment featuring conveyors, stamping presses, robotic welding cells, and controlled work zones. Machines behave like real production systems \u2014 operations only proceed when conditions are correct, and users can observe the impact of faults, stops, and unsafe actions.\n\nThe experience is designed to support workforce upskilling in EV manufacturing, maintenance, and battery-related processes, allowing learners to practice repeatedly in a safe, cost-effective virtual environment before entering real factories.", "short_description": "A VR digital twin of an EV assembly plant. Master industrial robotics, stamping, and assembly line operations in this immersive technical training sim."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vml.dkut.ac.ke/docs/Smartline%20Automotive%20Privacy%20policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Virtual Mechatronics Lab", "support_website_url": null, "website_url": "https://vml.dkut.ac.ke/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25194495346844382"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25344575981836317", "version": "1"}, "id": "32652398003
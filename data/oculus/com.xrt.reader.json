d3-1.oculuscdn.com/v/t64.5771-25/491821796_1730869148019720_95970580610708326_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ye7j4b48maoQ7kNvwFxVM41&_nc_oc=Adr9ZSyuw8QMTNqbC3rct6QlSbzBeOKbx9WBSfqj1OqhSbqWm_WMhgwYnWbZvFlZk5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5zJVH6d4NvvUcF1bf4mGl2JPYOchX0lA4fIdCGcbh-A&oe=6B047C03"}, {"file_name": "screenshot_2_library_grid_2560x1440.png", "id": "1752163406331976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_1752163412998642_6777994252524648108_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvb2yG-fp-QQ7kNvwG-Lzob&_nc_oc=AdrSGYtrooPX3Dp5iJSD3H28SelPUwXmAb3Dx4n8RMtuw0DjEmahp0gqrD3MV790QhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcbB7sKeLhrDDe6WpWTLnplAsRcBJVS65dJiX6TxEAgA&oe=6B045D89"}, {"file_name": "screenshot_3_reader_paged_2560x1440.png", "id": "1468053125270630", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_1468053128603963_3497338572931483777_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYoez6RLBeYQ7kNvwHZnwiB&_nc_oc=AdoLpKeETaI656LvHM2AO3Elh2N25Bbpbq5_ASxyZVdGhqo-nAeX740Lnz2BkyHamrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-BiwpDtFxp2z9StxeAiiefGxLypuuyse5a037TkTPag&oe=6B046331"}, {"file_name": "screenshot_1_empty_library_2560x1440.png", "id": "3752908314862072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_3752908318195405_7433024696342290201_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEdvOCD-fjIQ7kNvwHzFIjw&_nc_oc=Adok1OUC2KZqX59m3M9TrAgX83_RT4EK6uh-Cj6nvfHhW3Pf8VbsChavKYMR1vZxd90&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHBuB6LoNPnMb2aWXBGe32BHBPvoVLtSvoFUhjvRCU-A&oe=6B0479AE"}, {"file_name": "screenshot_4_toc_sheet_2560x1440.png", "id": "2176031966630595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823259_2176031976630594_5644171680599409922_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDw1tqVVDr8Q7kNvwEH4vdy&_nc_oc=Adr2sheZwPdDLmSKZjW_dHJL4AAR_h-q2n0z7ioT8UvR7wyCT0VqFLEdw_XwSfaSfsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsTPIa-KisEbt8vfDONqTmaKeIevrDI7jpBdut9btQ9Q&oe=6B0479EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reader: EPUB, PDF & FB2 Books", "keywords": ["tts", "library", "ebook", "reading", "novel"], "long_description": "Reader turns your Meta Quest headset into a distraction-free e-reader with a page as big as a wall. Import EPUB, PDF, FB2 and TXT books in seconds, then read for hours in comfort \u2014 lying down, sitting up, anywhere. Free, offline-first, and private by design.\n\nFEATURES\n\u2022 Library with covers, reading progress, and shelves: Reading Now, Favorites, To Read, Have Read\n\u2022 EPUB, PDF, FB2 and TXT support with accurate pagination or smooth continuous scroll\n\u2022 Table of contents, bookmarks, and fast in-book search\n\u2022 Day, Night and Sepia themes, plus font, spacing and margin controls\n\u2022 Read-aloud with text-to-speech and adjustable speed\n\u2022 Reading statistics with remaining-time estimates\n\u2022 Resizable 2D panel with controller-ray and pinch input\n\nHOW TO TRANSFER BOOKS\nWi-Fi import: open the upload page from any browser on your PC or phone (same network) and drag files straight into your headset. You can also import via the system file picker, or open books from other apps with \"Open with Reader\".\n\nPRIVACY\nNo ads. No accounts. No data collection. Your library, positions, bookmarks and settings stay on your device; Reader works fully offline. Optional Meta Spatial SDK telemetry is opt-in and governed by Meta's privacy policy.\n\nFORMATS: EPUB, PDF, FB2, TXT", "short_description": "Turn your Meta Quest into a giant e-reader. Import EPUB, PDF, FB2 & TXT books in seconds and read in comfort \u2014 themes, fonts, bookmarks, TTS & stats. Free, offline, private."}]}, "developer_name": "Savva", "developer_privacy_policy_url": "https://savvazaicev.github.io/reader-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/reader-legal/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1461631767025207"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1459857586090394"}]}, "baseline_offer": {"id": "1459857586090394"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793988000, "status": "PUBLISHED", "id": "1459857586090394"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1465305273324523", "version": "1.0"}, "id": "1113736574597092", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1452337637954620", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1465305273324523"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1113736574597092"}]}, 
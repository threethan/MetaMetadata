U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb51XSoQlsqSXqbtf2bNn5-FUWHhJCsq5UqAgw7arTwQ&oe=6AFB4183"}, {"file_name": "screenshot_2_library_grid_2560x1440.png", "id": "1752163406331976", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823905_1752163412998642_6777994252524648108_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mcrVpYADZ8Q7kNvwEaquKx&_nc_oc=AdoEi2rv3TN4tAFVIAsqwRFwSWvDMLLWSz62JPmf4_eC-zQUFqJU0z_5M4KNxVAdQ-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAqGhHLPbws0E6GQHnXcXUFzl4rT1UUhR96qnbN6xYMg&oe=6AFB2309"}, {"file_name": "screenshot_3_reader_paged_2560x1440.png", "id": "1468053125270630", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823341_1468053128603963_3497338572931483777_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1_GbrxGcs8Q7kNvwECktHG&_nc_oc=Adp_f4Oi6XGdkR5frXNAz0oogb6OHm0yELO9Lf3ZemO6gM0BOvtKqpVdFm30NrwVbFw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCSb7RS8LiHEkCeED1wkuTcoaKYapSreZDN4G4xBiqsg&oe=6AFB28B1"}, {"file_name": "screenshot_1_empty_library_2560x1440.png", "id": "3752908314862072", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_3752908318195405_7433024696342290201_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJkKOkaXHHgQ7kNvwEmk-SG&_nc_oc=AdqsCh8shF_7QWa8YBqGsqZ1Sh7EEbg6LKgEa45JW-vUQH4eptUw0y59E5Bmt1WG-6c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo16gGyPm8GWxTwVxg1SxnLe4fv0Opl5f7bzof7D8EIA&oe=6AFB3F2E"}, {"file_name": "screenshot_4_toc_sheet_2560x1440.png", "id": "2176031966630595", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823259_2176031976630594_5644171680599409922_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie_lfiUamLEQ7kNvwHnWuXa&_nc_oc=AdpfbRtRqmLXdqaMT-wVLHhVtthoHkvs5H2lBBTZ1gCwU2XWqW9e1cFGxkBldSf7MLc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5CZ6adhgrqvwTYK9dw5_yEvKmOuukLrtfG0aYRV4Jzg&oe=6AFB3F6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reader: EPUB, PDF & FB2 Books", "keywords": ["tts", "library", "ebook", "reading", "novel"], "long_description": "Reader turns your Meta Quest headset into a distraction-free e-reader with a page as big as a wall. Import EPUB, PDF, FB2 and TXT books in seconds, then read for hours in comfort \u2014 lying down, sitting up, anywhere. Free, offline-first, and private by design.\n\nFEATURES\n\u2022 Library with covers, reading progress, and shelves: Reading Now, Favorites, To Read, Have Read\n\u2022 EPUB, PDF, FB2 and TXT support with accurate pagination or smooth continuous scroll\n\u2022 Table of contents, bookmarks, and fast in-book search\n\u2022 Day, Night and Sepia themes, plus font, spacing and margin controls\n\u2022 Read-aloud with text-to-speech and adjustable speed\n\u2022 Reading statistics with remaining-time estimates\n\u2022 Resizable 2D panel with controller-ray and pinch input\n\nHOW TO TRANSFER BOOKS\nWi-Fi import: open the upload page from any browser on your PC or phone (same network) and drag files straight into your headset. You can also import via the system file picker, or open books from other apps with \"Open with Reader\".\n\nPRIVACY\nNo ads. No accounts. No data collection. Your library, positions, bookmarks and settings stay on your device; Reader works fully offline. Optional Meta Spatial SDK telemetry is opt-in and governed by Meta's privacy policy.\n\nFORMATS: EPUB, PDF, FB2, TXT", "short_description": "Turn your Meta Quest into a giant e-reader. Import EPUB, PDF, FB2 & TXT books in seconds and read in comfort \u2014 themes, fonts, bookmarks, TTS & stats. Free, offline, private."}]}, "developer_name": "Savva", "developer_privacy_policy_url": "https://savvazaicev.github.io/reader-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Savva", "support_we
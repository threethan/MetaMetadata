ohc=tjS16lhED7EQ7kNvwHL4pyI&_nc_oc=AdpnHmFySZtjysq4_TPXKEaxzL1Rp2Is7SWqzgcTQ84FE_hqHqx3AIjSoc3--VmSJXg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2wbW7UF96b7lW7elUcWSQlK5TI8_mqjqw6NnkWEOlEw&oe=6AF9D189"}, {"file_name": "screenshot_3_reader_paged_2560x1440.png", "id": "1468053125270630", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823341_1468053128603963_3497338572931483777_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5HjG6trz-8Q7kNvwH7Lzun&_nc_oc=AdrUTuoTGDuTwZ7X803HwPTxeI0gnvfww9qfSgxxa7D-Sx8l_QYHBPDj0M-WyUdkhp0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSsRwJ0al-I5tlkvqGrka6ZF0pEkLxEc-ObmanxkYyeA&oe=6AF9D731"}, {"file_name": "screenshot_1_empty_library_2560x1440.png", "id": "3752908314862072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823351_3752908318195405_7433024696342290201_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMRqFN4cFzEQ7kNvwGCDbtG&_nc_oc=AdrMkpjachvDD0yUGK96-iPGiKeGAe2__dNekiuMt5cOJy2w3mgQcNBdh_6hr_ArcMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRese_QuuzEoIs9ixKTkZQi-V14TT-bxcUyDK8z-vCh2w&oe=6AF9B56E"}, {"file_name": "screenshot_4_toc_sheet_2560x1440.png", "id": "2176031966630595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823259_2176031976630594_5644171680599409922_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie_lfiUamLEQ7kNvwG3ZHvw&_nc_oc=Adrx4kCb22OBKGOeeKJ_Ree5XLX537eXOs7hat8BJU7qPTbyNel0yDVTW3ItEoupd3s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgJauNjtOYOd9l-V3qUKuk2HLkpRgKiQFKCqRhRERRSA&oe=6AF9B5AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reader: EPUB, PDF & FB2 Books", "keywords": ["tts", "library", "ebook", "reading", "novel"], "long_description": "Reader turns your Meta Quest headset into a distraction-free e-reader with a page as big as a wall. Import EPUB, PDF, FB2 and TXT books in seconds, then read for hours in comfort \u2014 lying down, sitting up, anywhere. Free, offline-first, and private by design.\n\nFEATURES\n\u2022 Library with covers, reading progress, and shelves: Reading Now, Favorites, To Read, Have Read\n\u2022 EPUB, PDF, FB2 and TXT support with accurate pagination or smooth continuous scroll\n\u2022 Table of contents, bookmarks, and fast in-book search\n\u2022 Day, Night and Sepia themes, plus font, spacing and margin controls\n\u2022 Read-aloud with text-to-speech and adjustable speed\n\u2022 Reading statistics with remaining-time estimates\n\u2022 Resizable 2D panel with controller-ray and pinch input\n\nHOW TO TRANSFER BOOKS\nWi-Fi import: open the upload page from any browser on your PC or phone (same network) and drag files straight into your headset. You can also import via the system file picker, or open books from other apps with \"Open with Reader\".\n\nPRIVACY\nNo ads. No accounts. No data collection. Your library, positions, bookmarks and settings stay on your device; Reader works fully offline. Optional Meta Spatial SDK telemetry is opt-in and governed by Meta's privacy policy.\n\nFORMATS: EPUB, PDF, FB2, TXT", "short_description": "Turn your Meta Quest into a giant e-reader. Import EPUB, PDF, FB2 & TXT books in seconds and read in comfort \u2014 themes, fonts, bookmarks, TTS & stats. Free, offline, private."}]}, "developer_name": "Savva", "developer_privacy_policy_url": "https://savvazaicev.github.io/reader-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Savva", "support_website_url": null, "website_url": "https://savvazaicev.github.io/reader-legal/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
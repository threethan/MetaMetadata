AXcnYr1KH2DPYLenYIbiap80F8-mfO0-WOiHg&oe=6A22E385"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwljwnchrZgQ7kNvwEoHt2g&_nc_oc=AdpoeJ0CFDyjb4UA0wOC_SjPJYzYUqStzqU8bDMFhtN1uzeuDzwPOttQsr3aiBasgF0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1n-d-gr9y-xglcLNxXkHHAgkCOq_hcg4AXpgYbsUdkA&oe=6A22E44D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5okizmv5WsQ7kNvwGJVY7t&_nc_oc=AdpgTsUaPIT8O6bvBvUHkRRZlM3AdYXdIQw-56VaOIM7UkAMMiVw7TnKO0Y7CrThR9Y&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y0ZWK4NjTKUoaytBviU9XBED3oJTOCc2JI6qOuIwwHg&oe=6A22DE29"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3nocTLm8UcQ7kNvwH5hfPV&_nc_oc=AdpWxfEAzeHEkufnm68deIj2dZKRoc4uW8WtAkTGYXQ5tQQQvkouRbO0jkmmYXauZ4o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CKLYkJ3-iogQ4uoYGycxZXOlwnHBo_MjKEVVIQVlGkA&oe=6A22DC92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
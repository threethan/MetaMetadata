E6kzhevrqu1EXB15eEVSIFpVDnFYnxdvI9Usw&oe=6AAA9EE5"}, {"file_name": "studio.timestep.rocketgarden-20260312-133621.png", "id": "847085628392650", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_847085631725983_4527945713153426439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azspqstvdicQ7kNvwGNIk7v&_nc_oc=AdoWck1kISAK5Azf56ebbDDZK6nSaeoSUoaJ7fcCtUWCEhQ55jkqkLUEHRqJVESXcU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUR6ykUGQzd5grhCctNXTOM8dYxmlu0iKisgtgUZvz8Q&oe=6AAA88ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RocketGarden_icon.png", "id": "819080953828712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585720338_819080960495378_2221077586596345452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS3-mAQCHz0Q7kNvwGI-_uK&_nc_oc=AdpVtlCPGNkyVmHcEUIDN8NqgeucTNtWglxjwWhDaZx0-qTMAxLnSHwfDOhdqxbecZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf9oOLnJgO3ydJJap7AG7eQnBStsj2D_xEVTE4I6pj5w&oe=6AAA908B"}, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "*EARLY ACCESS*\n\nRocket Garden is a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts in a virtual museum setting. Walking among these vehicles offers a unique sense of scale and a chance to see some of the machines that shaped space exploration.\n\nThe experience is currently in EARLY ACCESS and will continue to grow over time with additional exhibits and interactive features. Our goal is to create a place where people can explore aerospace history in an accessible and engaging way.\n\nRocket Garden is being developed together with the community. Your feedback helps guide future updates as we expand the museum and add new ways to explore the technology and stories behind spaceflight.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune", "short_description": "*EARLY ACCESS*\n\nStep into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere.\n\nRocket Garden is currently in Early Access, with new features and exhibits planned for future updates. We welcome your feedback to help shape the experience.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26610704985230518"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507818746_809337668715208_6974470156784993145_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6ixBp9-s9IQ7kNvwHoGwqp&_nc_oc=AdpryrymNypirPXJHDd7JFxn-cY9xqM_mTM_MZupIZiYrrjVs3B_4fueyZSXPWDV93M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIctpyc6v3FDCqJZOMYii_k429_KLlu3YGgOFS2Yntb4g&oe=6AAA9293"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rocket Garden", "platform": "ANDROID_6D
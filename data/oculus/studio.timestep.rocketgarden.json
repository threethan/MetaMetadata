0i3ksxDQYI2fkfF0kk8UkqiKiWwXMUp-Ix2BQ&oe=6A11C005"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgihhaa3UIkQ7kNvwHQP-tH&_nc_oc=AdqeSljMx9FamaDGV8JkmoRML9NHRVPNmiff97FPvbnKMoJMyk_9ZdDXGqpjAAfX24U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SKp-YEp6syXD1jHFLpXvdjsyDZAVV76RAvU1LYuy0kg&oe=6A11C0CD"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meVx8HeAQnYQ7kNvwGcLgXt&_nc_oc=AdpHeevO0GeOkqkiSY_WzfJeteCr6tytXuCUO2LKZjjqOzCMDDedUzcB9JeWzdSTAAU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4coJkkMnLfFn3B6rXvsip1XLIg8Xd_4VjzaxtqI0FdWw&oe=6A11BAA9"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzOef-Ej-vEQ7kNvwF82Dbk&_nc_oc=AdovPyMgOEOl9yvjNo5EB7EJtV9CdpPPNvMGSNQApjDGA6o-i_tcgVdC5TpUKgLtp6Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YrAh0prAk2AzYEn29p6VCF9O2vo85OxyZykWyReardg&oe=6A11B912"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
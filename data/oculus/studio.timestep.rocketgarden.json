q61RkRnIce9XoCKcRPQcERWfS9a_f5jFZlM_w&oe=6A8D74C5"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwdpDxb3s9gQ7kNvwHZiqY4&_nc_oc=AdptLikhMjJjf97aY2IB9oals5CWHC-2BLsjzuK7mYopwsDjBRzUKU16Y1UomrLx9jQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXU65kL6EYhr2ZOvmxPpVNGFDnXCPx2b6a_c9ybRTtzg&oe=6A8D758D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2qmu462MogQ7kNvwFFKkUn&_nc_oc=AdopHSZJ4T4F2leSg-BWEk3LZ04CCf8RX0PArkRS4mJ4Z16L-B4_akODAxBgmtSwahw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvGqkyQ6DwKd2WQtWtpfWaGI8icDVVPYOyQZVoAk4FYg&oe=6A8D6F69"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rSUDvXAQg4Q7kNvwGCfXEY&_nc_oc=AdrVMCozP_xwDoaYJZ7er2KoB8rC2XBjJKC7Qp98WDCoJMdGAVMMv9I0NFGLBE3r84w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbd1gcsBCqdfzTl4Te7p2v8j0dXNSv4PrA4QVFvSxaOw&oe=6A8D6DD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
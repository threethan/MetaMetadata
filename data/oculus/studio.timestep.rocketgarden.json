jcQlP07pQcUWU-Ye8QxS-bV7d3M-DGztsYS_w&oe=6A858BC5"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv4MA0PAL7kQ7kNvwFPP2oA&_nc_oc=AdrmHst-r9Zd0_P4RD3-VO75Jt7QX6keIDLqw6hbExlpBnWZKNQ-1KIiVrHm8E4dI2Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxpyAnFND6no7Q6sZCM1bbIQPsmNu5BkzOa9KJ4guk4A&oe=6A858C8D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyt2w-CqvmoQ7kNvwFihOwD&_nc_oc=AdrGU54gyQwm58B3fV_23vlb_-dMslCssJGcuDvSomcKLHeantDoYoFskNIsdUOEZGo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5pnJfQV-saspdGTqNRinxCBmcMIFSqRKplxmApxeyow&oe=6A858669"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyjb-QZxgoAQ7kNvwHk5ZYi&_nc_oc=Adrg33e1mX5LQZHh7bRmkTPngp7QuXl4oY0WR6K6uxVB3swMvrBZ0ajXjF-yHfG-8H4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrA-N1v3_ReCSUMZVKgw6vQLEwKJMe82h8rQageaVwjA&oe=6A8584D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
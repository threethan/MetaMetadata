5BreSI-UWCEwMtHVvKh8H_wmsMygtqqZiosuw&oe=6A7885E5"}, {"file_name": "studio.timestep.rocketgarden-20260312-133621.png", "id": "847085628392650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_847085631725983_4527945713153426439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJNtFnIFCMcQ7kNvwG7f69i&_nc_oc=AdpjAS0d323A8FFJulGsYSqV7ftUf5jFghsOQ9dLaHgT5dq1qWE2iKvRNelsga_7RjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHFx7ZAjaFfMkqf9QMvKTBYQb6MzZXG3BopnDZpsgb7w&oe=6A786FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RocketGarden_icon.png", "id": "819080953828712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585720338_819080960495378_2221077586596345452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gUOI3hDhEAQ7kNvwG_3qZP&_nc_oc=AdrhGiL0q3jq5-aY49Uc_571lz5GHB_3NdT7gEG-2S54YV4seSplTCuGvx2Vw6VstZo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2URyAya4jvUrZKjyU_RW9h_cbhIiYhW8VGcXZyqXszw&oe=6A78778B"}, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "*EARLY ACCESS*\n\nRocket Garden is a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts in a virtual museum setting. Walking among these vehicles offers a unique sense of scale and a chance to see some of the machines that shaped space exploration.\n\nThe experience is currently in EARLY ACCESS and will continue to grow over time with additional exhibits and interactive features. Our goal is to create a place where people can explore aerospace history in an accessible and engaging way.\n\nRocket Garden is being developed together with the community. Your feedback helps guide future updates as we expand the museum and add new ways to explore the technology and stories behind spaceflight.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune", "short_description": "*EARLY ACCESS*\n\nStep into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere.\n\nRocket Garden is currently in Early Access, with new features and exhibits planned for future updates. We welcome your feedback to help shape the experience.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26610704985230518"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_809337668715208_6974470156784993145_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg7LWv_dWN8Q7kNvwFBZOQW&_nc_oc=AdoEYY8AelMFbIrMsX9hrNRYEFQ2dE7-4_Wo-0f-3wCzMal-iVIyQ8rmt1I_7EmWe5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR-pmzoBG9c1Pc15WSL8NAmlze8MfXVY9ZjYs7b0rM1Q&oe=6A787993"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rocket Garden", "platform": "ANDROID_6D
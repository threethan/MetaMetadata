R2r9KPbjlyRKEMKbnHPZ17pYCJDdHYXu7oAuw&oe=6A394D05"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptOn4awLHHAQ7kNvwEe0Wbi&_nc_oc=Adq4HzG9CDm9O_RiZQHPGgKZHcBFu5tadi1cPHU2rqIi7JTLECfKYAzr7JBq1QwzrJU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IqKOudKd9-Cvg5vlnZBU_SgHu-69QXFTGZU7NBsGs1Q&oe=6A394DCD"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM4jDhiVaM0Q7kNvwEqeSnx&_nc_oc=AdrGwh8BVkLfHCeWT0TE4lObSzNh2GqS-tDEN32_G2gfBXreL1_XtLOO3TPa7cx0gjY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bOaCAx9cnN71OdVG0gitKX6sLCBGSe6K942cYCa8SUQ&oe=6A3947A9"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLEvLjdwSnkQ7kNvwGfWWVZ&_nc_oc=AdpeCC4ggum95j7VNB-ABricsDPupgs8iveMcMq6ja4f40rN8CDaVaXDb2E4nqcBeGU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8toR8dQPAR1fBMB95-9x2YeUYD9GKWquST7b_SmOD7Cg&oe=6A394612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
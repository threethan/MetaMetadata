fYep88Eo7e-JO4L8qD8V9dcqWuj42VgyXtDfw&oe=6A36AA05"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oA_QLuq4zjYQ7kNvwE4r7d7&_nc_oc=AdoXR38AAaRs9T07e7uUaEHIKUrAGGgxdwq3bFL0GNYN_05EXe9Li6cZcytgbBjQo60&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89XQNkVpaPVyZj7s5-DzMjS_fUndCJaLxnhj8aSCDKgg&oe=6A36AACD"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObbY9u74ucYQ7kNvwHUPLb9&_nc_oc=AdpfHb-vL-42i4PE_mR2wIsYNDsUhVf8kBsOufrK8B-aNzl4WjsNr7MoIKRcR5tPCK8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83uBwX-M4OqCFumWzlzTitBCLwNnhS0zk6FxmhWyckVA&oe=6A36A4A9"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QlfYy3T4tgQ7kNvwG1JGHK&_nc_oc=AdoUta-ng6bZbpKW5IbSNmsbAH6wEtqBjF5ap51D18Jr95vXbuoN_NWXdgfIhUk5fmo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HaHGtECS6YBb-54ogO8Y_uHSf7unhWPwpdC0ViiCYOA&oe=6A36A312"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
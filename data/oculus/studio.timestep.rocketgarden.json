29605", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_946389957962938_7280145648904174733_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C719rnr6qoQ7kNvwFOAOsH&_nc_oc=AdqIWENw_MRdQLwks_TJ8tP3K0mX5aDib7bhkldLz2XGCjfbIcUUmkFmRa0ka2XOkNI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoX-bYMmDxxFBsCgeVO9nqPSNgzGj9MBcuSFcKX4pHjg&oe=6B01DA25"}, {"file_name": "studio.timestep.rocketgarden-20260312-133621.png", "id": "847085628392650", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_847085631725983_4527945713153426439_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E1ZT7369aEQ7kNvwG3K-mg&_nc_oc=AdqefSTc7sao9R-Yo_oRNC2SPP6K6CcBNO0hyk4M7rHyH6N1f9C44CnMHttUXSFWkeY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStJetRJPo_nD41ohxDSgpDn6XJqRicJdu8TTQE5TP4wQ&oe=6B01C42D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RocketGarden_icon.png", "id": "819080953828712", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/585720338_819080960495378_2221077586596345452_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5NEp0h-lGcQ7kNvwEcQ2-h&_nc_oc=Adq-8sF3UspDeG-VuQyI8mOkGHwNcjl1FlWEbDj2DVmKl3UICXbDJb5gfplKU2JPM-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2TtG6-gJliycF2Wxrl2HrPI4B-TrkmccGNo0N2x8l_A&oe=6B01CBCB"}, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "*EARLY ACCESS*\n\nRocket Garden is a free-to-play VR experience that lets you explore and launch life-size rockets and aerospace artifacts in a virtual museum setting. Walking among these vehicles offers a unique sense of scale and a chance to see some of the machines that shaped space exploration.\n\nThe experience is currently in EARLY ACCESS and will continue to grow over time with additional exhibits and interactive features. Our goal is to create a place where people can explore aerospace history in an accessible and engaging way.\n\nRocket Garden is being developed together with the community. Your feedback helps guide future updates as we expand the museum and add new ways to explore the technology and stories behind spaceflight.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune", "short_description": "*EARLY ACCESS*\n\nStep into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere.\n\nRocket Garden is currently in Early Access, with new features and exhibits planned for future updates. We welcome your feedback to help shape the experience.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28771642932470035"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507818746_809337668715208_69744701567849931
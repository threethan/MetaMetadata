GvUUYeovtjOOTmqVKHEj8BETNTQ&oe=6A452A85"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRyAHTiCRggQ7kNvwHGRqds&_nc_oc=AdpIAqU5BEcBxigtnhI4JwkmmNfS6SKDweMUlgJDdKxBCS8CI9K6ivRVNwS8N-cO-LI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n9MT2W63s-LmCs2D5rdZuspOFGbtnhX97XN8JSmfYGQ&oe=6A452B4D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asWCRjGpTSAQ7kNvwEX4KX7&_nc_oc=AdrciBIZHjFBKNYHtBJOLm2DCA53TuinUh3maDqFdNX0HAjJRKybZhI_LBG_xSaIrNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TTGoCaFFTDrnjL1XN9QiQPvwOFTl70PBPcAoodr_fsA&oe=6A452529"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAHmAq16BQsQ7kNvwFWIPcf&_nc_oc=AdqFW_MN5Tgws0T4G0ycgQv5gAtoI1IDBKT4S5ueaMjhKZ_cOko0m0um1HEVDWIYitk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JXibyYbW3dQd2sROVISkAq05M1IDaoJ1EyV9Aelubfg&oe=6A452392"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology in new ways. Rocket Garden is also dedicated to preserving aerospace heritage, offering a digital space where history can live on and be shared. Built together with the community, it\u2019s an ever-expanding museum without walls accessible to anyone, anywhere.", "short_description": "Step into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24464863616481343"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1280264174021057"}]}, "baseline_offer": {"id": "1280264174021057"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776175260, "status": "PUBLISHED", "id": "1280264174021057"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26928592080108472", "version": "0.4.0"}, "id": "1487459929369481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
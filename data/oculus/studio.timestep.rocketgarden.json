NQowOikaMhkPw_KoEbKZdZRzVQ_K1e2Mo4ETA&oe=6A467C05"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRyAHTiCRggQ7kNvwGMNChn&_nc_oc=AdqzTBnmkComSQ4IQocn2UA9C4Z-HvUBOjmgD0Es7shuXWmaLQG-KUheKBRSOrWLNGE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KgoWaGU8D3XmL-6iSVMYseTdUl8fvofG1KKhDxoD-ag&oe=6A467CCD"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asWCRjGpTSAQ7kNvwEcHAkZ&_nc_oc=AdoZf55Ara27IM_BSkHbdPehGm9eLm2GCfSDjI8yDORsY26O0QMIdZB287OnuOzUPNU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PSltEOuqWh9SfHxZmatz_E4AIlQnEvAywuC0a5HLJPQ&oe=6A4676A9"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAHmAq16BQsQ7kNvwGaNp7R&_nc_oc=Adqil0me6c1vBKoBHDy2xn_ZYkBo5iTFX6AJ37L4d2ZrG2XxUD74WL3C5C1puCaJknU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CrXby9fLDDzuBzVVnGydhkU0QKaN_pwTWdqgmjoNP5g&oe=6A467512"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
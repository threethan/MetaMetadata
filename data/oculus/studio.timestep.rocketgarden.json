Qig6M4NPlSZzaZqBZGfjnv7yqUr2KMcxdbAtQ&oe=6AA95C85"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAS34LsHfQkQ7kNvwGWJEhg&_nc_oc=AdrbNgIo1UFfAIrhJ3iZpnVnoy2PPCB2DjcB2rR8Do5Z36gseS63CXPBQF9tWWtGegQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_4ksrMGtFMKmhV4sXknE0C1XzQSa3uzuVzcAignGjZg&oe=6AA95D4D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKFPR3n8aWEQ7kNvwFFlP6s&_nc_oc=Adp6XAgLwKg_IIh0nBORPS6KncnAlVK3F4ggCN-GCONu1oykuROd9l8zpwkfu1lUBsM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz35Y6ZCh8VH8dGO31DpWR4AoriEMkNthEh9SrkEhw2A&oe=6AA95729"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHzXWRZE5yYQ7kNvwF-Zc68&_nc_oc=AdpRbOxttsNz_g38LNyeR9DYJVUT1uqUNsUG-nztSwjMpCZP0V7mPJrffrul03udm-k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq-raL7LIth2p7j9toH1OZF3oToWZO4MXPY_npbZrzvQ&oe=6AA95592"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
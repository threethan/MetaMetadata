q2j_QtRqC5vIkllxoXiXcEunpWyiN2V_md09A&oe=6A7DA2C5"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbRB-FYV8dcQ7kNvwHlGTt8&_nc_oc=AdqloPue-KwhWOKLhhSgxBAmMPVamtpAxQaE5K2qBBGpZMVGq0m3l0RuIGjlfMqWYKY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBus0Le1aGxNAdpU3a7E8ttP00SONiEQ4bqy2cTrx9uw&oe=6A7DA38D"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIRLFeYd2xoQ7kNvwELzSOU&_nc_oc=Adpsg6qg9t875h0V6SirBze6_HEPQfHHdxXZJi0l7OB4fQqW0KEye4WNb1XX9ZVNFaM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7CqNNpQgxIjN24_RrGloizfDygzdVe0QcqIwXsY3iuQ&oe=6A7D9D69"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqQglA3RGtUQ7kNvwEr3ZG0&_nc_oc=AdodbnTrMbHh-4xiRSLWc3c6XA6EnB20I6YvqCeWUxpDBp34s7ovDG1f0kuADg-eOGc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXlvpSWJB2nWRLP6IZCQ_4aK40NlcZBeBs3yhCjSRRwA&oe=6A7D9BD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology 
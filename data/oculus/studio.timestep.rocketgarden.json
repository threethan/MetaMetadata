6RLJ-MP0VOaa7Ab106kgK6_a-mg&oe=6AAFF405"}, {"file_name": "com.oculus.vrshell-20250923-145405.png", "id": "1351047513104848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499315359_1351047516438181_5862049257615185594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo43fPK5gwUQ7kNvwGY_Kxj&_nc_oc=AdqaGcu7sA2QsY_t5DzFsUM5Sg_wN4hRqmjyMyovrJFgc_-g-oDa5KtSur0S0JU74Dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_HGDa0ms7gg5YxscyN-YtQ7VCRPdfx_8Ac4HrYV9A1w&oe=6AAFF4CD"}, {"file_name": "com.oculus.vrshell-20250923-145520.png", "id": "1292336789040587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827718_1292336792373920_765760379123384915_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxEFgGjWpPsQ7kNvwFwKzsm&_nc_oc=AdqsRChNAgs-o1j45SX4F5M7DLhnYKvdJ_w_w3ZTlKMWnjumO-vbnDX8hi5v_giCfD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYRrD9JseE2zYImPoKvwSGTxiliaMlPaYSCi3WCeqHyw&oe=6AAFEEA9"}, {"file_name": "com.oculus.vrshell-20250923-145323.png", "id": "1956411295182720", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303280_1956411298516053_4406228804045032768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zT_goRsSroQ7kNvwGFONJp&_nc_oc=Adp965xK1999vJRrgjOPJIj8q1CYN3m9MmZ4Nv0SbNSRIphj8bur8yJGh_STvyBNSA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPU_6SfOj6zEkExu0B-vTe_-5bncU8MyVYclxTYJz8MQ&oe=6AAFED12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "The free-to-play Rocket Garden museum is more than just a VR experience, it\u2019s a way to truly grasp the scale of aerospace history. Walk among life-size rockets and spacecraft to see them as they were meant to be seen: towering, powerful, and awe-inspiring.\n\nThe experience will continue to grow with interactive exhibits that invite you to engage with aerospace technology in new ways. Rocket Garden is also dedicated to preserving aerospace heritage, offering a digital space where history can live on and be shared. Built together with the community, it\u2019s an ever-expanding museum without walls accessible to anyone, anywhere.", "short_description": "Step into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24464863616481343"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1280264174021057"}]}, "baseline_offer": {"id": "1280264174021057"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776175260, "status": "PUBLISHED", "id": "1280264174021057"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26928592080108472", "version": "0.4.0"}, "id": "1487459929369481", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
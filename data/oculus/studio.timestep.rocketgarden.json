lCdAiz8SU2FOqVavoZ2WRNOcdlykl3g9WBJZA&oe=6A3A8F65"}, {"file_name": "studio.timestep.rocketgarden-20260312-133621.png", "id": "847085628392650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_847085631725983_4527945713153426439_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVN9JpJTh1QQ7kNvwFsefz6&_nc_oc=Adqmig2pQ91dteDWaPJz6b4VQLoJmd81Mw2tw0yxQpqz4wS6z3_TuBor_VVtfxmR5fE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VrJ1zzjWDtWr-mNuqx51tLL4s1lxjfxNcDtp489fuUg&oe=6A3AB1AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RocketGarden_icon.png", "id": "819080953828712", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585720338_819080960495378_2221077586596345452_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b34TGB4TscQ7kNvwHZvGSi&_nc_oc=AdoVk_P3Vxp5M0LrGbCJ0ayI5A43dJz0KgR8bnPBogF0Cn_CnQWX-cAVMDOx_hem0zM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AlNQtaCBfHlwXIDw3gSn77gbUVZOQWlMSUYB4Ltfujg&oe=6A3AB94B"}, "display_name": "Rocket Garden", "keywords": ["rocket", "free", "space", "museum", "aviation"], "long_description": "*EARLY ACCESS*\n\nRocket Garden is a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts in a virtual museum setting. Walking among these vehicles offers a unique sense of scale and a chance to see some of the machines that shaped space exploration.\n\nThe experience is currently in EARLY ACCESS and will continue to grow over time with additional exhibits and interactive features. Our goal is to create a place where people can explore aerospace history in an accessible and engaging way.\n\nRocket Garden is being developed together with the community. Your feedback helps guide future updates as we expand the museum and add new ways to explore the technology and stories behind spaceflight.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune", "short_description": "*EARLY ACCESS*\n\nStep into the Rocket Garden museum, a free-to-play VR experience that lets you explore life-size rockets and aerospace artifacts. Discover the wonder of space exploration, accessible to anyone, anywhere.\n\nRocket Garden is currently in Early Access, with new features and exhibits planned for future updates. We welcome your feedback to help shape the experience.\n\nJoin our community and share your thoughts on Discord:\nhttps://discord.gg/qPGyZYQune"}]}, "developer_name": null, "developer_privacy_policy_url": "https://rocket-garden.com/privacy_policy_rocket_garden.html", "developer_terms_of_service_url": null, "publisher_name": "Timestep Studio", "support_website_url": null, "website_url": "https://rocket-garden.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26610704985230518"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507818746_809337668715208_6974470156784993145_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymWHWSj08x0Q7kNvwG1kOqs&_nc_oc=AdphDO_nfTwkdf4hq3gqN6hgZKP6mIYNin5mx0VOvf51CosLDLFjhDgSBuPagUoyftE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xsj2jXbms-KKg2Bcdm5hdD-le5VOHQd0fMbQTIjg-fw&oe=6A3ABB53"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rocket Garden", "platform": "ANDROID_6D
DPDKvLUGTtxZJMEYqQwG2-R37ameibBXN2w&oe=6A86D665"}, {"file_name": "vlcsnap-2026-04-15-15h39m55s778.png", "id": "1615718142883220", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300897_1615718146216553_5823441326554517600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5nRTe9e4y8Q7kNvwG3eVxY&_nc_oc=AdpH3PHlC6o3jRpgRjtQFu5uEEgg46qhPwDn0UpN3vMSwVWmAVABdoiTdWp4G8DbiDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLBuwMRLPTGEF9jphH1WP0ioZw-gdhAFXZlCs13idRoA&oe=6A86E02A"}, {"file_name": "vlcsnap-2026-04-15-15h41m32s653.png", "id": "978502838031705", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499301053_978502841365038_6720049361169506703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqT07otRzekQ7kNvwESkEO1&_nc_oc=AdqrQ8c7tv1s6SQMREZgSwG1hvM7ODob9-qAQnPBgbjPNoMO9Rk0YNu_0GrSm7BeR-o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESA2bPawP_QD-wkmR-BpMZmxPYUQFx50-tSnMhelobqw&oe=6A870074"}, {"file_name": "vlcsnap-2026-04-15-15h36m14s842.png", "id": "2507447059703175", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304162_2507447063036508_407484139736360692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHYrojSVMzEQ7kNvwFj8m74&_nc_oc=Adp7SO09kZVv7uxcFMWBZJWVNYfSFHCrbgEEAESBAPL0RFUVPLTOArqEK8HwSPS1K0s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_gtZIT-OBBdSqDFodZfSi1RwdsWDPR-vyGSJcVXaUpw&oe=6A870571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Compass_Thumbnail.png", "id": "2001555260444150", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499296123_2001555263777483_7751305571821604775_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9pybrW5YkIQ7kNvwEd0fsA&_nc_oc=AdqBdc28MHPBPoZOmO4J8hRoIDt0z3CU38jRpO6GxmKJEABoGJGQhAWWolxyFFegU78&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMIg7WnO10Qp7wx2ihr-6BGtHURDBubXJQG5UldHeEnQ&oe=6A86D61D"}, "display_name": "Compass", "keywords": ["open", "world", "flying", "cute", "grapple"], "long_description": "                                                                                                                                                                                                                                                          \n{1286261207054090}\n\n**Compass** is an open-world VR flying adventure set among otherworldly skies.\nYou are a scout flying ahead of a wandering Caravan, charting safe routes through unknown skies.\n\n\n\n# RIDE THE CLOUDS\n{1681112086404919}\nTake control of your flying vessel and travel across vast open skies filled with changing environments. Upgrade your ship to venture farther and get through dangerous routes.\n\n\n# COMPLETE CHALLENGES\n{1158286549797869}\nLeave the cockpit and use your hand grapples to swing through ruins, climb structures, and complete environmental challenges scattered across the skies.\n\n\n# SCOUT THE UNKNOWN\n{3135182253350722}\nExplore new regions, recover lost cargo, meet the people living among the clouds, and search for signs of your missing companions as you discover what lies beyond the horizon.", "short_description": "Explore long lost skies in Compass, an open-world piloting adventure about finding your way through uncharted clouds. Maneuver your ship through hazardous floating landscapes, solve puzzles with your grapples, upgrade your vessel, and lead the Caravan forward."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-compass", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET, Creature Label", "support_website_url": null, "website_url": "https://www.trebuchet.fun/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTUR
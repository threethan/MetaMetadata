n.com&_nc_ss=7f20f&oh=00_Af9tjVUjaBU70NAz0x_8-fgzsPPCjQgKQGOFZoMlX-XNiw&oe=6A465D50"}, {"file_name": "ScreenShotCandidate11.png", "id": "1589272062329443", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618251_1589272065662776_1199646432508608244_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfOigNDtwcUQ7kNvwFDfqm8&_nc_oc=AdrhwbqeqLtaaOJ7JR8500tCUnzDZbIQw3xK9GuCaEhDU6OwBDJq1nY0q4ywPPzdsak&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NOiGXzCVHvIJiDOKer3GzjzO87Pcr6TcGRZzZhnhPQA&oe=6A466D65"}, {"file_name": "ScreenShotCandidate22.png", "id": "1432584137876060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499299789_1432584141209393_7938539299899564702_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo7m9QnKzJoQ7kNvwFZv2Oh&_nc_oc=AdqtccI7U-O8nYlSPmoVXFuCHc4mntR0VXGJ8OcthZUXE1cGooUZXV7nFvlGDfUBmQ4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G0AiHQfP-xjsGgGeNtHSebPDQlRh7GmB-Rr8V2CIkxQ&oe=6A466B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Compass_KeyArt_Landscape_2025_V03-Logo-Big.png", "id": "1329904238958888", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307339_1329904242292221_1839899639082968986_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HO7j7cv65AQ7kNvwHtTFff&_nc_oc=AdpakxTb7rZR59NUxHkAaRdSVfrSLVe11Ews4YbMyH8GRHpoGJuggBSBxu-Kr70nyio&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aztzDrKIRapnr9vbkbQZOPrUK0OXEGaAm20phwHGPlA&oe=6A468C7A"}, "display_name": "Compass", "keywords": ["open", "world", "flying", "cute", "beautiful"], "long_description": "                                                                                                                                                                                                                                                          \n{1211527024302816}\n\n**Compass** is an open-world VR flying adventure set among otherworldly skies.\nYou are a scout flying ahead of a wandering Caravan, charting safe routes through unknown skies.\n\n\n\n# PILOT YOUR SHIP\nTake control of your flying vessel and travel across vast open skies filled with changing environments.\nUpgrade your ship to venture farther and get through dangerous routes.\n{1667912944395115}\n\n# GRAPPLE AND SOLVE\nLeave the cockpit and use your hand grapples to swing through ruins, climb structures, and solve environmental puzzles scattered across the skies.\n{1500295318466408}\n\n# SCOUT THE UNKNOWN\nExplore new regions, recover lost cargo, meet the people living among the clouds, and search for signs of your missing companions as you discover what lies beyond the horizon.\n{3964099993887053}\n\nComing soon to a VR headset near you.", "short_description": "Explore long lost skies in Compass, an open-world piloting adventure about finding your way through uncharted clouds. Maneuver your ship through hazardous floating landscapes, solve puzzles with your grapples, upgrade your vessel, and lead the Caravan forward."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-treb", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET, Creature Label", "support_website_url": null, "website_url": "https://www.trebuchet.fun/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
Xvu0RnQMMlRH2eLFxLCjj1fHhv4EYIDJiRg&oe=6AEDE3A5"}, {"file_name": "vlcsnap-2026-04-15-15h39m55s778.png", "id": "1615718142883220", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300897_1615718146216553_5823441326554517600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UJF29cChGIQ7kNvwFqiXeX&_nc_oc=Adr6X0x6lfiNT1HSMVDpE8vYnYxWzH6pN_cYPzFVXMNBj5w0GbOmurzjZN_2UhGjI5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVkyq9jVOAxPISy2_oUNUf-Irgtt13TyEAg460ARZw_w&oe=6AEDED6A"}, {"file_name": "vlcsnap-2026-04-15-15h41m32s653.png", "id": "978502838031705", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301053_978502841365038_6720049361169506703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsrEUmb-uDEQ7kNvwG4oPiV&_nc_oc=Adp4eAnLTemNyHdXIDouLX-pLAOVXBKaXgjH5-hkTp3rlgNfunkGnc2GOQJSHMbX3RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_LInNJCnAGd2sU9nFEW3hhJqXUmH-YE_Cqg6Hvm2BQA&oe=6AEE0DB4"}, {"file_name": "vlcsnap-2026-04-15-15h36m14s842.png", "id": "2507447059703175", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_2507447063036508_407484139736360692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JIVBfSpun4Q7kNvwGOs3sJ&_nc_oc=Adryaa2ngtV4LMipNQBy0OMLBNPOfK7AyIYm6vs4at80htzXY5oiYqQWblqqVFnc36U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9Orx-aVjrgySXlaixclukuoeJXsvlp8ot6vDG5sXbGg&oe=6AEDDA71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Compass_Thumbnail.png", "id": "2001555260444150", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296123_2001555263777483_7751305571821604775_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufcYC9ubnXUQ7kNvwHkrlHK&_nc_oc=AdouQKcX2RDe8M4b20Bm2TUUwHiGkn2sc57VGj9IJ44Cq6QJEiKvrCQI3CbHttygtdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa7McTnxOXcT2le1yVwB777wUA6ZabggPuwD21XBJrLA&oe=6AEDE35D"}, "display_name": "Compass", "keywords": ["open", "world", "flying", "cute", "grapple"], "long_description": "                                                                                                                                                                                                                                                          \n{1286261207054090}\n\n**Compass** is an open-world VR flying adventure set among otherworldly skies.\nYou are a scout flying ahead of a wandering Caravan, charting safe routes through unknown skies.\n\n\n\n# RIDE THE CLOUDS\n{1681112086404919}\nTake control of your flying vessel and travel across vast open skies filled with changing environments. Upgrade your ship to venture farther and get through dangerous routes.\n\n\n# COMPLETE CHALLENGES\n{1158286549797869}\nLeave the cockpit and use your hand grapples to swing through ruins, climb structures, and complete environmental challenges scattered across the skies.\n\n\n# SCOUT THE UNKNOWN\n{3135182253350722}\nExplore new regions, recover lost cargo, meet the people living among the clouds, and search for signs of your missing companions as you discover what lies beyond the horizon.", "short_description": "Explore long lost skies in Compass, an open-world piloting adventure about finding your way through uncharted clouds. Maneuver your ship through hazardous floating landscapes, solve puzzles with your grapples, upgrade your vessel, and lead the Caravan forward."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-compass", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET, Creature Label", "support_website_url": null, "website_url": "https://www.trebuchet.fun/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTUR
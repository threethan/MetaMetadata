aCtlFge_gPFyaB6UBMLsTg3eClPx5QJvbdg&oe=6A43D225"}, {"file_name": "vlcsnap-2026-04-15-15h39m55s778.png", "id": "1615718142883220", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300897_1615718146216553_5823441326554517600_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8cMZPzM0GkQ7kNvwHh8KG5&_nc_oc=AdoqG5ZU7Ii86U4s_1mnmrsa578olpAtWmpjFpeQM1Mcj0cMXl_lB_kx7fGK9CpNmD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KOw5MeFr1ecyPEcepOA9Uk5aNBCeDD2EHW4Zk8ZWPKg&oe=6A43DBEA"}, {"file_name": "vlcsnap-2026-04-15-15h41m32s653.png", "id": "978502838031705", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_978502841365038_6720049361169506703_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX8oLgLJaNsQ7kNvwGN8NYM&_nc_oc=AdpMQROmhkgl1wk-kDeqiPc7MEOZIweBB_VORTHGUB1P6AGNTocbJ1tsw5-8gvapO6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZEEYyWdwtyjMhGF5NXKSIvQmn-5ajfkGg0AKGlo8Edw&oe=6A43C3F4"}, {"file_name": "vlcsnap-2026-04-15-15h36m14s842.png", "id": "2507447059703175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304162_2507447063036508_407484139736360692_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEY1fGKM2fwQ7kNvwGd8i3Q&_nc_oc=AdqxTedRH3P8sKQfA8DpSCQPZWUbDmhBK7lA3xds6ZH24uvT5TZElav3vvXjbA6qNO0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6mpKyefByxMy-xLZNleDhK0af9akjib4ic8tmEFla6w&oe=6A43C8F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Compass_Thumbnail.png", "id": "2001555260444150", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296123_2001555263777483_7751305571821604775_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GiNbQtQlJwoQ7kNvwEYndfh&_nc_oc=AdrWcHW5ohaZcKisohHsC1J7xdB8X054a8kYChleArztQS_W1rgdfIjD6FVzB6ZhRRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q2wdJJR_Qspr94_gmFIFmfgfdT8cVWE_0xdDJFLJWyQ&oe=6A43D1DD"}, "display_name": "Compass", "keywords": ["open", "world", "flying", "cute", "grapple"], "long_description": "                                                                                                                                                                                                                                                          \n{1286261207054090}\n\n**Compass** is an open-world VR flying adventure set among otherworldly skies.\nYou are a scout flying ahead of a wandering Caravan, charting safe routes through unknown skies.\n\n\n\n# RIDE THE CLOUDS\n{1681112086404919}\nTake control of your flying vessel and travel across vast open skies filled with changing environments. Upgrade your ship to venture farther and get through dangerous routes.\n\n\n# COMPLETE CHALLENGES\n{1158286549797869}\nLeave the cockpit and use your hand grapples to swing through ruins, climb structures, and complete environmental challenges scattered across the skies.\n\n\n# SCOUT THE UNKNOWN\n{3135182253350722}\nExplore new regions, recover lost cargo, meet the people living among the clouds, and search for signs of your missing companions as you discover what lies beyond the horizon.", "short_description": "Explore long lost skies in Compass, an open-world piloting adventure about finding your way through uncharted clouds. Maneuver your ship through hazardous floating landscapes, solve puzzles with your grapples, upgrade your vessel, and lead the Caravan forward."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trebuchet.fun/en/page/privacy-policy-compass", "developer_terms_of_service_url": null, "publisher_name": "TREBUCHET, Creature Label", "support_website_url": null, "website_url": "https://www.trebuchet.fun/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTUR
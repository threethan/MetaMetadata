/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821749_703443168738210_5975666557185393621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fLLD2W0G0UQ7kNvwHGWg8v&_nc_oc=AdqYwR_Mj6PkfqAfJUNRP5psQ5JDjqzgKCLzYHxUuOHa3LxV2aaLCRXQOzPNRzmbqJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ30TXhlrup9exzaL-p81uMtQEuKPN9rrD_wPQ8gqijAQ&oe=6AB3CC1F"}, {"file_name": "ss3.png", "id": "721614983534597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391739_721614990201263_1954640068842603596_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gmkcLNQJ0kQ7kNvwHcKvul&_nc_oc=Adpvdm0UuGsmqxMXsLUbK7H8gNC1eAcMQ4SZd_L2LbsIIoXctvYieUhBjxIgd9WlFiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGalcVIZZ7jGV3Z4PdY0GDkJ8xn4jrRLefQ9_Zpm9q2g&oe=6AB3F7B0"}, {"file_name": "ss5.png", "id": "683966611055955", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821681_683966614389288_2274191694718336705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFhlSHFZ9ksQ7kNvwGx6nlj&_nc_oc=Adr1_Zvyfb1-Tiyu_rAspN_HNTG3LPGfnki8EvBkwDyl0mBOnKquY6xf1tgQrkaL9WI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5BtSaHSyNJgHQKRURqh3r6pWqLuLJJEipXpa0LVtawQ&oe=6AB3F6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "665822159635025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391863_665822162968358_4220580312025639177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGFhmLDQZ6AQ7kNvwFExxFP&_nc_oc=AdqUsHA7oRjn2yvarqwrWFLiUv6ZacN4VOXhtpaLRm5oDAiq0crkHPnsbm2Lbujq0Kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMkGe1p6R2tZ39zOHO_rz6vtpEUbPD3LNaop7r3NzG9A&oe=6AB3CC44"}, "display_name": "Farm Island", "keywords": ["farm", "farming", "buildandharvest", "harvest", "island"], "long_description": "Farm Island is a cozy and immersive VR farming simulator where you create and manage your dream island farm. Surrounded by beautiful landscapes and peaceful nature, you'll plant crops, harvest fresh produce, and raise animals with your own hands. From planting seeds and watering fields to building barns and decorating your farm, every part of your island evolves as you play.\n\nWhether you're a casual gamer or a farming enthusiast, Farm Island offers a calm, relaxing experience designed for virtual reality. Explore the island, discover hidden areas, expand your land, and enjoy the gentle rhythm of farm life. With intuitive controls and interactive environments, it's perfect for both new and experienced VR players.\n\nSell your goods, unlock upgrades, and build a self-sustaining farm filled with life and charm. No time limits, no stress\u2014just pure farming joy in a sun-soaked island setting. Escape the noise of everyday life and dive into the peaceful world of Farm Island, where every harvest feels rewarding and every sunrise brings new possibilities.", "short_description": "Escape to Farm Island, a relaxing VR farming adventure! Grow crops, care for animals, and build your dream island farm. Harvest fruits, sell goods, and explore a peaceful rural world surrounded by nature. Whether you're planting seeds or expanding your land, Farm Island offers a cozy escape full of charm and creativity. Perfect for players who love farming simulators and want a calm VR experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
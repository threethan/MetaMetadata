/scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821749_703443168738210_5975666557185393621_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tdD0xXP6hcQ7kNvwFS6fSQ&_nc_oc=AdrdQ6T9nKScbnE9t5S6ap2KtIdXfiSg_8lNpbWjz0_3Q4vOziRMql-ahK8ZVnhUAGs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZKPBZuqWsHJju84levRiR_t4OCvcBYYdy7zv8xdMsmQ&oe=69FDDD1F"}, {"file_name": "ss3.png", "id": "721614983534597", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391739_721614990201263_1954640068842603596_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDSL5TvadMQ7kNvwFa637R&_nc_oc=Adob0HYUaDlBqPu1pyJHbHDXNw-FhQemekWCVV-x6pSBe_1MIMk9BBeB1jR2tWrsXPw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68AaLfvlgQvUg6zbJkVTrloFoxXLZ_G43ZIyGXmFQdBA&oe=69FDD070"}, {"file_name": "ss5.png", "id": "683966611055955", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821681_683966614389288_2274191694718336705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-YlifiSxs4Q7kNvwHdC6Uu&_nc_oc=AdoZDot_ngoAUeOGGFHbMhjt4gvocfDX_ec8kWYINn3xz6fpYVwv7As1_zU1qI_-u7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oRJr2-bhC2HVAh7vnJlR75PgdGGHVNIk8zI8hemjvYw&oe=69FDCF6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "665822159635025", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391863_665822162968358_4220580312025639177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDuBwqtvcysQ7kNvwEEP5vS&_nc_oc=AdqZea6ellEMCvBfU5h8HOTZgecfVYCkqKkcCKUBuiCWK84TXL85J8SNGKazXgi7Sn0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61nl-YoSJcmmMKp6raoxreAIoBTBYxP138KlAMhZkmgg&oe=69FDDD44"}, "display_name": "Farm Island", "keywords": ["farm", "farming", "buildandharvest", "harvest", "island"], "long_description": "Farm Island is a cozy and immersive VR farming simulator where you create and manage your dream island farm. Surrounded by beautiful landscapes and peaceful nature, you'll plant crops, harvest fresh produce, and raise animals with your own hands. From planting seeds and watering fields to building barns and decorating your farm, every part of your island evolves as you play.\n\nWhether you're a casual gamer or a farming enthusiast, Farm Island offers a calm, relaxing experience designed for virtual reality. Explore the island, discover hidden areas, expand your land, and enjoy the gentle rhythm of farm life. With intuitive controls and interactive environments, it's perfect for both new and experienced VR players.\n\nSell your goods, unlock upgrades, and build a self-sustaining farm filled with life and charm. No time limits, no stress\u2014just pure farming joy in a sun-soaked island setting. Escape the noise of everyday life and dive into the peaceful world of Farm Island, where every harvest feels rewarding and every sunrise brings new possibilities.", "short_description": "Escape to Farm Island, a relaxing VR farming adventure! Grow crops, care for animals, and build your dream island farm. Harvest fruits, sell goods, and explore a peaceful rural world surrounded by nature. Whether you're planting seeds or expanding your land, Farm Island offers a cozy escape full of charm and creativity. Perfect for players who love farming simulators and want a calm VR experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recom
mJcd3CDLlA4LaC8BG8KLHSvrsHmR1YKwjzT86g&oe=69F0AE1F"}, {"file_name": "ss3.png", "id": "721614983534597", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391739_721614990201263_1954640068842603596_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f9CXJ47824Q7kNvwGs_dvI&_nc_oc=AdqyaRyZZK_nquQ9PrFSFl4e5vRPjv_fFaSdKMoTlrmu1w2GIyRvUvrvEVMbQawnrV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1tpV2W-oYJlbn7GnyaxFmloBCJrRTNXLn32aDtN4s20A&oe=69F0A170"}, {"file_name": "ss5.png", "id": "683966611055955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821681_683966614389288_2274191694718336705_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugMka44Fo4UQ7kNvwF4m_H1&_nc_oc=AdpycGk6e860ZHJkw8UmCAfbUZC7ga4t84xoYBQUwKbdEuwAVUTqo7a5U0n4M6qDeBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Yl8aBR5UXR3DwdwtmGtKAnklj2Lmj_x2_a079EGuPvQ&oe=69F0A06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "665822159635025", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391863_665822162968358_4220580312025639177_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwgUHewlDQsQ7kNvwFXDIAn&_nc_oc=AdpXPoRgmHaVxrLz2gFIxi03AOQO7WmF2-rxvAyA6O0JIvi1eDaun49Xor1slWwH35Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1mMfYLfRWLHRWvP4zwhORJDgE2jqIGbwSCosHoxfl_eg&oe=69F0AE44"}, "display_name": "Farm Island", "keywords": ["farm", "farming", "buildandharvest", "harvest", "island"], "long_description": "Farm Island is a cozy and immersive VR farming simulator where you create and manage your dream island farm. Surrounded by beautiful landscapes and peaceful nature, you'll plant crops, harvest fresh produce, and raise animals with your own hands. From planting seeds and watering fields to building barns and decorating your farm, every part of your island evolves as you play.\n\nWhether you're a casual gamer or a farming enthusiast, Farm Island offers a calm, relaxing experience designed for virtual reality. Explore the island, discover hidden areas, expand your land, and enjoy the gentle rhythm of farm life. With intuitive controls and interactive environments, it's perfect for both new and experienced VR players.\n\nSell your goods, unlock upgrades, and build a self-sustaining farm filled with life and charm. No time limits, no stress\u2014just pure farming joy in a sun-soaked island setting. Escape the noise of everyday life and dive into the peaceful world of Farm Island, where every harvest feels rewarding and every sunrise brings new possibilities.", "short_description": "Escape to Farm Island, a relaxing VR farming adventure! Grow crops, care for animals, and build your dream island farm. Harvest fruits, sell goods, and explore a peaceful rural world surrounded by nature. Whether you're planting seeds or expanding your land, Farm Island offers a cozy escape full of charm and creativity. Perfect for players who love farming simulators and want a calm VR experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24275654592036167"}}]}, 
tps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821923_1077566293859512_3499692111895547476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFVgmm_x-2sQ7kNvwHFi8bd&_nc_oc=Adqh6eUF7IYouvBcTkKDZD_lQThPjBP6HhdFEQXZhOIz7VcHm1iIQOG73nijE6qRSu4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-UzajXRF-zqe5-LLrOHJec57I5FCHqf_PjtXzU3X1Mw&oe=6A072553"}, {"file_name": "com.EngineRoomVRLLC.GGVR_FoF-20250724-091611.png", "id": "572298672487295", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305050_572298675820628_1482399442038117872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is9pCcO7RjEQ7kNvwER6tdu&_nc_oc=AdrRDcUCtFp6OG2Yn2fnTJi2wmBrJ5Bp4yO25M4MFgexnvCdfSJYpRDR2tuXmCU9y98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nGTSHD2QGtWmpo25p5aRIsYMdPSNfrrH_VRWuwge7ZQ&oe=6A0731A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tempImagevrcn8k.png", "id": "1443243466866064", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820983_1443243470199397_32396993155886215_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLXSSaP-1EsQ7kNvwGoWOvy&_nc_oc=Adq2Z_VPpcdsZOgSbG0CiFXzAfoRftZufEvUey6pGQniRYGl5_P_uagRZUTdKAGpCeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qjBhzSsB3NvlxvbGKwEEsqVjlfHaU-IGiL4DESS9WXQ&oe=6A071BAC"}, "display_name": "Fists of Fury", "keywords": ["Boxing", "Fight", "Punch", "Box", "Fitness"], "long_description": "Ready to throw punches, build real technique, boost your fitness, and break a serious sweat?\nStep into the ring with \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now unleashed as a full standalone experience!\n\nEarly Access includes 4 unique venues, customizable speed settings, and progressive levels designed to sharpen your skills and push you up the leaderboards.\n\nUnlike rhythm-based games, Fists of Fury is built as a true boxing tool \u2014 helping you master punch transitions, timing, and proper technique as you train like a fighter.\n\nGloves on. Game on. Are you ready to throw down?", "short_description": "Step into the ring and rise through the ranks in \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now a standalone experience!\nEarly Access features 4 dynamic venues, adjustable speed settings, and multiple levels to sharpen your skills and climb the leaderboards. Are you ready to throw down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/fists-of-fury-privacy", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://discord.com/invite/t8NsuFfWSm", "website_url": "https://goldenglovesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24587158920870277"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "969121845824159"}, {"status": "PUBLISHED", "id": "1602841127650258"}, {"status": "PUBLISHED", "id": "1473870644287686"}, {"status": "PUBLISHED", "id": "4224883804324332"}, {"status": "PUBLISHED", "id": "1113563767314683"}, {"status": "PUBLISHED", "id": "1429786408364378"}]}, "baseline_offer": {"id": "1429786408364378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "969121845824159"}]}, "liveChannel": {"nod
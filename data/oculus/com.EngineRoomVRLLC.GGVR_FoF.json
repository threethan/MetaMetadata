tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821923_1077566293859512_3499692111895547476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqqkh3ksiHQQ7kNvwHOMO22&_nc_oc=AdpQvMKtgyNVbDE09GNe2V-XUQ7_QKQfiGy2eekI2kYm2ednHWPhgRV9uROILEsdAFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PMElalRnUqvCy5OR4RkFxE0uFc32oBs1kPwfYJUa-XQ&oe=6A0DBCD3"}, {"file_name": "com.EngineRoomVRLLC.GGVR_FoF-20250724-091611.png", "id": "572298672487295", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_572298675820628_1482399442038117872_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAV39gvj1HkQ7kNvwE_rcp5&_nc_oc=AdrQleNmyfjZIHbOUAugeyec0QcW6GK27T_IVquHexX4JLlXZaTiTGdBCvzHsDg5tBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BwE7oxztE0xxCrFP84cZs21glRnsBV81kupbdDqhdNw&oe=6A0DC927"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tempImagevrcn8k.png", "id": "1443243466866064", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820983_1443243470199397_32396993155886215_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLPeYURj2voQ7kNvwFVFIJ4&_nc_oc=AdrzMG6_KUx2PryYac0VCcwbVyugogZnDHCEBbEvUwmS8DFxsc9YQ5BaN9lDDj0CFBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53u4OsHXKWsh2qJI76kFJ4UWyu4lDWOma7mUT4LNg2xA&oe=6A0DB32C"}, "display_name": "Fists of Fury", "keywords": ["Boxing", "Fight", "Punch", "Box", "Fitness"], "long_description": "Ready to throw punches, build real technique, boost your fitness, and break a serious sweat?\nStep into the ring with \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now unleashed as a full standalone experience!\n\nEarly Access includes 4 unique venues, customizable speed settings, and progressive levels designed to sharpen your skills and push you up the leaderboards.\n\nUnlike rhythm-based games, Fists of Fury is built as a true boxing tool \u2014 helping you master punch transitions, timing, and proper technique as you train like a fighter.\n\nGloves on. Game on. Are you ready to throw down?", "short_description": "Step into the ring and rise through the ranks in \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now a standalone experience!\nEarly Access features 4 dynamic venues, adjustable speed settings, and multiple levels to sharpen your skills and climb the leaderboards. Are you ready to throw down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/fists-of-fury-privacy", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://discord.com/invite/t8NsuFfWSm", "website_url": "https://goldenglovesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24587158920870277"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "969121845824159"}, {"status": "PUBLISHED", "id": "1602841127650258"}, {"status": "PUBLISHED", "id": "1473870644287686"}, {"status": "PUBLISHED", "id": "4224883804324332"}, {"status": "PUBLISHED", "id": "1113563767314683"}, {"status": "PUBLISHED", "id": "1429786408364378"}]}, "baseline_offer": {"id": "1429786408364378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "969121845824159"}]}, "liveChannel": {"nod
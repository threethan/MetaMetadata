id": "1443243466866064", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491820983_1443243470199397_32396993155886215_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT1b3c2dgD0Q7kNvwHxUSh3&_nc_oc=AdqAQu-XxgE-Me9FfGrOph_4HxLr4hEsh9ttTyHjIQ1ER9Kmlqf47mNAMKsRSGgUeeY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiyQfnwlunF2ON5KK8N26ex4ue2fsqsW468FXuxVGV_A&oe=6AFC8AEC"}, "display_name": "Fists of Fury", "keywords": ["Boxing", "Fight", "Punch", "Box", "Fitness"], "long_description": "Ready to throw punches, build real technique, boost your fitness, and break a serious sweat?\nStep into the ring with \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now unleashed as a full standalone experience!\n\nEarly Access includes 4 unique venues, customizable speed settings, and progressive levels designed to sharpen your skills and push you up the leaderboards.\n\nUnlike rhythm-based games, Fists of Fury is built as a true boxing tool \u2014 helping you master punch transitions, timing, and proper technique as you train like a fighter.\n\nGloves on. Game on. Are you ready to throw down?", "short_description": "Step into the ring and rise through the ranks in \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now a standalone experience!\nEarly Access features 4 dynamic venues, adjustable speed settings, and multiple levels to sharpen your skills and climb the leaderboards. Are you ready to throw down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/fists-of-fury-privacy", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://discord.com/invite/t8NsuFfWSm", "website_url": "https://goldenglovesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542
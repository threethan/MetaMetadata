en Gloves mini game, now a standalone experience!\nEarly Access features 4 dynamic venues, adjustable speed settings, and multiple levels to sharpen your skills and climb the leaderboards. Are you ready to throw down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/fists-of-fury-privacy", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://discord.com/invite/t8NsuFfWSm", "website_url": "https://goldenglovesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24587158920870277"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1602841127650258"}, {"status": "PUBLISHED", "id": "1473870644287686"}, {"status": "PUBLISHED", "id": "4224883804324332"}, {"status": "PUBLISHED", "id": "1113563767314683"}, {"status": "PUBLISHED", "id": "1429786408364378"}]}, "baseline_offer": {"id": "1429786408364378"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1602841127650258"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24586999004219602", "version": "0.9.1"}, "id": "699766499526994", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
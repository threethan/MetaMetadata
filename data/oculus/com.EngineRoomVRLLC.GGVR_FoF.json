&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hfJCDV7pKupZU-1IbpH7Q7LEjjrj_FM8bGjZvimh7_g&oe=69E8C92C"}, "display_name": "Fists of Fury", "keywords": ["Boxing", "Fight", "Punch", "Box", "Fitness"], "long_description": "Ready to throw punches, build real technique, boost your fitness, and break a serious sweat?\nStep into the ring with \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now unleashed as a full standalone experience!\n\nEarly Access includes 4 unique venues, customizable speed settings, and progressive levels designed to sharpen your skills and push you up the leaderboards.\n\nUnlike rhythm-based games, Fists of Fury is built as a true boxing tool \u2014 helping you master punch transitions, timing, and proper technique as you train like a fighter.\n\nGloves on. Game on. Are you ready to throw down?", "short_description": "Step into the ring and rise through the ranks in \u201cFists of Fury\u201d \u2014 the viral Golden Gloves mini game, now a standalone experience!\nEarly Access features 4 dynamic venues, adjustable speed settings, and multiple levels to sharpen your skills and climb the leaderboards. Are you ready to throw down?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://goldenglovesvr.com/fists-of-fury-privacy", "developer_terms_of_service_url": null, "publisher_name": "Engine Room VR LLC", "support_website_url": "https://discord.com/invite/t8NsuFfWSm", "website_url": "https://goldenglovesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
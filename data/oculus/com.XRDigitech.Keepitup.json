1081195_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4Jpl85yIy4Q7kNvwHv8USN&_nc_oc=AdrHsGartrTU56EaPQZddY28NryhKZ_9w7GN2PBmeHRs3_Dpedk611SAV4t8ybDygLk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXufpmSp4XtTEnVlp-xJTg04cjKWtgd2b7kZNWNlOPZw&oe=6AFB4534"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover2.png", "id": "1682955155500847", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031384_1682955162167513_8563851205302125112_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL5kvgHG5qIQ7kNvwE91JLz&_nc_oc=Adrc3xfVbE8UlyaWGjaJ33eK0MILaa5yeo7qS0ce-fHKbQXtZtkRBUPrNs-JKoNduPY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYUSYDSCGf_Tq0ULCujQZoRmBkB_Y-C_e0ZC_QOFcGAQ&oe=6AFB1943"}, "display_name": "Keep It Up", "keywords": [], "long_description": "Experience a classic birthday game in mixed reality. Keep It Up is a mixed reality game where your objective is to keep the balloons up in the air. Balloons will fall down from above the player and the player has to track and hit them back upwards so that they never touch the ground. There are powerups and scoring system that keep the gameplay engaging and fun for the users.", "short_description": "Keep It Up is an action game in mixed reality, where you try to keep balloons off the floor by hitting them up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/keepitup/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech Global ", "support_website_url": null, "website_url": "https://www.xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNL
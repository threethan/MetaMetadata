1081195_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsbzZyBFndUQ7kNvwEy7URg&_nc_oc=Adq_7KBT8uuyhngXNHzSLcF2Rk12j8U8bv7UhNC8C8yB2SsW2mFE0YxF9LbDaPl0xjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxomgHQcnWjKBmwGpqMoFDd0zpzy3ig6fmCPfeahiMJQ&oe=6B0052F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover2.png", "id": "1682955155500847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031384_1682955162167513_8563851205302125112_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFcnK0Kx8ZEQ7kNvwEEMV_-&_nc_oc=AdpQpOwka4X8KxRNYD0E8GL4Tq969iNAeAGgj7T0EFQZk1Xnv1hpiLIcJssI-_DUIBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK8VW2u-m8jpiSGib4OcCkM3K3aN_uJIei7-upOofudA&oe=6B005F43"}, "display_name": "Keep It Up", "keywords": [], "long_description": "Experience a classic birthday game in mixed reality. Keep It Up is a mixed reality game where your objective is to keep the balloons up in the air. Balloons will fall down from above the player and the player has to track and hit them back upwards so that they never touch the ground. There are powerups and scoring system that keep the gameplay engaging and fun for the users.", "short_description": "Keep It Up is an action game in mixed reality, where you try to keep balloons off the floor by hitting them up."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/xrdigitech.com/keepitup/home", "developer_terms_of_service_url": null, "publisher_name": "XRDigitech Global ", "support_website_url": null, "website_url": "https://www.xrdigitech.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNL
FMihfP&_nc_oc=AdkcwFhMEXb1pRrE1595BibO3bhMe9n5UOswh2N5GfGvdfQSt63iUHOp-vOY631Vtp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsT6Rb7V5qu6vRohZAJ3hrGywr-WMetmpE8gtzjf5zLWw&oe=69A96304"}, "display_name": "Lemurs", "keywords": [], "long_description": "Lemur Runners is an exhilarating VR game that immerses players in a vibrant and breathtaking world, where they take on the role of nimble lemurs racing through challenging environments. With intuitive controls and stunning visuals, players must navigate treacherous obstacles, leap across platforms, and outmaneuver their competitors to become the ultimate lemur champion. Get ready to experience the thrill of speed and agility in this adrenaline-fueled VR adventure", "short_description": "Lemur Runners is a amazing game to hangout and chill with your friends. It is super fun and you will have an amazing time on it."}]}, "developer_name": "Swanny", "developer_privacy_policy_url": "https://sites.google.com/view/lemur-runners-2/home", "developer_terms_of_service_url": null, "publisher_name": "Swanny", "support_website_url": null, "website_url": "https://lemurrunner.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "766718688542544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982635_6539697749428802_169762547022970103
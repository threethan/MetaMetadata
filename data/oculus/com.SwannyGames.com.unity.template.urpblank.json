ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2BN68KIi-cQ7kNvwGszMF9&_nc_oc=AdqyEQ3Vh2u4LyV61_Pk1LO8TAT5BMkAxqpErGDO-fg_TOhTvitUgAdwDOeEJK8BuO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H6vV_lYAM8wOLokpCGM1_g9odT09ksZX27YLjU8Lj0A&oe=6A37FD44"}, "display_name": "Lemurs", "keywords": [], "long_description": "Lemur Runners is an exhilarating VR game that immerses players in a vibrant and breathtaking world, where they take on the role of nimble lemurs racing through challenging environments. With intuitive controls and stunning visuals, players must navigate treacherous obstacles, leap across platforms, and outmaneuver their competitors to become the ultimate lemur champion. Get ready to experience the thrill of speed and agility in this adrenaline-fueled VR adventure", "short_description": "Lemur Runners is a amazing game to hangout and chill with your friends. It is super fun and you will have an amazing time on it."}]}, "developer_name": "Swanny", "developer_privacy_policy_url": "https://sites.google.com/view/lemur-runners-2/home", "developer_terms_of_service_url": null, "publisher_name": "Swanny", "support_website_url": null, "website_url": "https://lemurrunner.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "766718688542544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.
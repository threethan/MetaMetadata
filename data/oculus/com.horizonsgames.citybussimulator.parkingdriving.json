0405064_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZRdZ6Xf0jUQ7kNvwGPe7OR&_nc_oc=AdkwsCY05sp2wYgsKoMW6ysT7qT3LEsfHO08GSqBgXn5r9D8kM6f85YaRLjMV5M7N50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftytbvuTrH80ikctIxouEkx4naqVDmZXvpKuI-6bwW92g&oe=69A04CFD"}, {"file_name": "Screenshot_19-01-2026_12-24-31.png", "id": "1423300999229883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1423301002563216_1369812650048433076_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAU-2yqvfwQQ7kNvwGefB5n&_nc_oc=Adkrmiy51mWYNt2fOgdQkKZ632YFhrVSaSuMbj4NK3lpRRrx2AWodXBuTvdPHEDgrks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5WAwHHzHedtkbdX5HqLuEEQzOCYytkYTh7UPN6o006A&oe=69A027CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Bus Simulator : Parking & Driving", "keywords": ["CityBusSimulator", "BusParking", "BusDriving", "BusSimulatorVR", "CityBusDriver"], "long_description": "Step into the driver\u2019s seat in City Bus Simulator: Parking & Driving! Experience the thrill of navigating busy city streets while picking up passengers and mastering challenging parking scenarios. Whether you\u2019re manoeuvring tight corners, following realistic traffic rules, or tackling multi-level parking lots, this simulator offers hours of immersive driving fun.\nKey Features:\nRealistic Bus Driving \u2013 Handle city buses with accurate controls and physics.\n\n\nParking Challenges \u2013 Test your skills in tight spaces and complex parking areas.\n\n\nCity Routes \u2013 Explore urban streets filled with traffic, turns, and obstacles.\n\n\nImmersive Experience \u2013 Smooth controls, realistic sounds, and vibrant city environments.\n\n\nFun for All Players \u2013 Casual or hardcore simulator fans will enjoy the challenge.\n\n\nTake your bus-driving skills to the next level and become the ultimate city bus driver. Are you ready to park, drive, and conquer the streets?\n", "short_description": "Drive and park city buses in realistic, challenging routes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33445789311702764"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "896105006609031"}, {"status": "PUBLISHED", "id": "894363399627671"}]}, "baseline_offer": {"id": "894363399627671"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "896105006609031"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33568618726086488", "version": "1.2"}, "id": "1213994423527051", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33445789261702769", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33568618726086488"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "12139944235
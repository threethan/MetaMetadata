iEyWhDvhKk0jw9NMA_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW1fvEK5ISoo_h2yIgCPSn9eqjJId45oI4mFArzp3fDA&oe=6A6DF6FD"}, {"file_name": "Screenshot_19-01-2026_12-24-31.png", "id": "1423300999229883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_1423301002563216_1369812650048433076_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl2HhBT7kQ8Q7kNvwEM9GXl&_nc_oc=AdotAIJ4Hg5WfyweDHamx0U8LXwuT40iJEnHoqm3MoZubMF6tpiI6thyfkvbC07GDcc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT4-QV5lmHEf10tH6WJRMLQtvFHghniaJ-6lrAkgjIaQ&oe=6A6E0A0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Bus Simulator : Parking & Driving", "keywords": ["CityBusSimulator", "BusParking", "BusDriving", "BusSimulatorVR", "CityBusDriver"], "long_description": "Step into the driver\u2019s seat in City Bus Simulator: Parking & Driving! Experience the thrill of navigating busy city streets while picking up passengers and mastering challenging parking scenarios. Whether you\u2019re manoeuvring tight corners, following realistic traffic rules, or tackling multi-level parking lots, this simulator offers hours of immersive driving fun.\nKey Features:\nRealistic Bus Driving \u2013 Handle city buses with accurate controls and physics.\n\n\nParking Challenges \u2013 Test your skills in tight spaces and complex parking areas.\n\n\nCity Routes \u2013 Explore urban streets filled with traffic, turns, and obstacles.\n\n\nImmersive Experience \u2013 Smooth controls, realistic sounds, and vibrant city environments.\n\n\nFun for All Players \u2013 Casual or hardcore simulator fans will enjoy the challenge.\n\n\nTake your bus-driving skills to the next level and become the ultimate city bus driver. Are you ready to park, drive, and conquer the streets?\n", "short_description": "Drive and park city buses in realistic, challenging routes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.goog
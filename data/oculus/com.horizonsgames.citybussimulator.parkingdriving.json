eas.\n\n\nCity Routes \u2013 Explore urban streets filled with traffic, turns, and obstacles.\n\n\nImmersive Experience \u2013 Smooth controls, realistic sounds, and vibrant city environments.\n\n\nFun for All Players \u2013 Casual or hardcore simulator fans will enjoy the challenge.\n\n\nTake your bus-driving skills to the next level and become the ultimate city bus driver. Are you ready to park, drive, and conquer the streets?\n", "short_description": "Drive and park city buses in realistic, challenging routes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33445789311702764"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1902394907809303"}, {"status": "PUBLISHED", "id": "1831247331568800"}, {"status": "PUBLISHED", "id": "1109838438400890"}, {"status": "PUBLISHED", "id": "1525538265686234"}, {"status": "PUBLISHED", "id": "964996226358558"}, {"status": "PUBLISHED", "id": "1321816803166684"}, {"status": "PUBLISHED", "id": "1574504523632741"}, {"status": "PUBLISHED", "id": "1426475021769268"}, {"status": "PUBLISHED", "i
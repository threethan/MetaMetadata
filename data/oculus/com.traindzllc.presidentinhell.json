_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXB3wzeJcQQQ7kNvwE3dEPE&_nc_oc=AdqLbonsFRRnMna3E3zegD8X9MD8iSYHQwgQ7aaDAL4ZLgi84B-z9vu7vL8C3T5MZzQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kr3dllNYiXqZqVZy2iDTfRUvBo7QQua4-eF4IjTk3Yg&oe=6A2D55A4"}, {"file_name": "SCREEN4.png", "id": "1223099789507791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310886_1223099792841124_817344223102498974_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pnLs94I4XcQ7kNvwF0Ng8o&_nc_oc=Adrl9sSDTyfsAOx-bvNNUt-UKtieNSBS1q8S-zXSyyt8FSV-LaWYNeJZt8m9G-a5nho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90pgAGkXtareD41-sGBC7PLw88rTe4SQICsRpDfNbZ_w&oe=6A2D5FEC"}, {"file_name": "SCREEN5.png", "id": "4148355815409794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507878115_4148355818743127_7566838704394905356_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcWU-3GJD1gQ7kNvwGkH57S&_nc_oc=AdoUEyoYwUIhiv4Qloy0ZBf-x9YbsDymf52mWTGhwiZAuKCsSSlf9TOqaMtTKCceeOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mXONjGoXeRiL7cewqrG2zyGvoTUCZQm_fT1uBFeE6gg&oe=6A2D7D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE.png", "id": "23969876665983271", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618937_23969876672649937_3972440680810082778_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-G_XvwQ56xoQ7kNvwHfrY3q&_nc_oc=AdpEkxtC6itNM0c-MTEZjTzYWoQmwZQqs_TN-rsfiPycfDTzh-yWjLnfj6B4i4C612w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JD41VZzIaRM3atNcRkn5FLJp4Bt63Hhgdan2N8XmfPA&oe=6A2D5611"}, "display_name": "President In Hell", "keywords": ["shooter", "action", "retro", "arcade"], "long_description": "Descend into chaos as the commander-in-chief of carnage in President in Hell, a relentless arcade-style VR shooter for Meta Quest! Step into the boots of a badass former president armed to the teeth, fighting off hordes of demonic enemies in the fiery pits of the underworld. Wield powerful dual weapons, earn score-multiplying bonuses, and survive wave after wave of unholy foes in this adrenaline-fueled, retro-inspired VR experience.\n\nClassic Arcade Mayhem Meets Modern VR\nPresident in Hell combines the nostalgic thrill of old-school arcade shooters with the intensity and immersion of virtual reality. The action never stops as hellish creatures come at you from all sides in an endless storm of fire, brimstone, and bullets.\n\n\ud83d\udd2b Dual-Wield Gunplay: Take control of both hands and unleash pure firepower with your pistols\n\ud83d\udd25 Hellish Arenas: Battle through the blood-red skies, lava-lit cavern, and twisted landscapes straight from the underworld.\n\ud83e\udddf\u200d\u2642\ufe0f Relentless Enemy Waves: Face off against increasingly difficult demonic hordes in nonstop arcade-style combat.", "short_description": "Descend into chaos as the commander-in-chief of carnage in President in Hell, a relentless arcade-style VR shooter for Meta Quest! Step into the boots of a badass former president armed to the teeth, fighting off hordes of demonic enemies in the fiery pits of the underworld. Wield powerful dual weapons, earn score-multiplying bonuses, and survive wave after wave of unholy foes in this adrenaline-fueled, retro-inspired VR experience."}]}, "developer_name": "Traindz Gaming", "developer_privacy_policy_url": "http://www.biims.net/presidentinhell", "developer_terms_of_service_url": null, "publisher_name": "Traindz Gaming", "support_website_url": null, "website_url": "http://www.biims.net/presidentinhell", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO
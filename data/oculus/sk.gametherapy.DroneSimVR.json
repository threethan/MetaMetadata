art with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4545138309051240"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1657317539222210"}, {"status": "PUBLISHED", "id": "4717554265232342"}]}, "baseline_offer": {"id": "4717554265232342"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1657317539222210"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_re
OKgpsr5a1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNr1EQgnE1F0VUx8hMqSuhKO8v7sxHxvstEkD_lB1gHQ&oe=6AE9EEC4"}, {"file_name": "02_Industrial_Inspection_2560x1440.png", "id": "1179656981671829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1179656985005162_103017809827273498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up9J4CdZgi0Q7kNvwFMIb6R&_nc_oc=Adpj2aT-AuUzrZwxGZhlGDZh2sp-J4YKpNhg-imWTn8zeXzu_32POEWSvPb7dNii-0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShAeYL7ymHm_dbssR3wawYbBp2-XpjXVFTW5K-JcM4oA&oe=6AEA12F9"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYf-oZmEuQ8Q7kNvwF93Lgx&_nc_oc=AdoSPybuD0Zq9ShI5LeRNfSEBAwKH1c_jcy4WjNdoRrrzKVJgOQAY-b6TIG2d2grYBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjq_JjzB3pc8uvR_jmVsOk5Ci272J6Zg792z9iYdIMvw&oe=6AEA0353"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvg0cSu6N9wQ7kNvwEwhSc5&_nc_oc=Adrd2-ugV0O-oFaO72WGNiJ4-ulcUA5uwCTqxeP9dybzMiaCuUvlnc4cFRi3oYWFYLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxd4DXatL_jHNZ4kql08wW5WvkBeHhtBEtII4jqMbORw&oe=6AE9EF3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkQNVsK1rO0Q7kNvwGHJm76&_nc_oc=AdrwwhHwXuzZJyep6DEuwtwgK1bXM13Xv_gSIIlY_WILsZBskxnm7XeAsHfT-pBACHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ_VFiKu1E5AybaS4utdtIfBkvg0sJwE8XyyRiyeQsWw&oe=6AEA06A5"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comf
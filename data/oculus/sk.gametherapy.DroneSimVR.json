_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9gui186pBsQ7kNvwG1RaTd&_nc_oc=AdqOpYv9h58ipYhegOsItQnPHvi_cV_9vsvjSTTe_f7g7Mg4m4-WlGfVPetrrSdNaQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu87uI3nYOwag-FK0HDVqINldfvw2ZfFRnUd8THsOFvQ&oe=6AFF2AF9"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MI4SRTpmkHEQ7kNvwGtziqZ&_nc_oc=AdptwddWwoyNCiZP2aUZFBCvBSNmSXKZvfuiF96nAuNIQuZ3u79AIFElZ8Zh8-znf4A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB5LFo5-MgJ8qhwiyO5htH4bNUtq1EIaQRL5X7a2nHZA&oe=6AFF1B53"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldARfAZLujIQ7kNvwGIwL5N&_nc_oc=AdrlqhaPiRCDOa5gGTcwgfzpXAfyOa0HSKXwvJzyLTeDN-MRNdGeXUl9rwm3FBXzi3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIidl8Ek_Vg_qpXZGi_sFPLCUc-HYJZXE7bjnhAyyBdQ&oe=6AFF073E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jOqjkzCmPIQ7kNvwFFyyF3&_nc_oc=AdoMsj9bswy06ZYOlBx5nKe-lrbE0z4Vr7BDnIntpbDRuQ-bdJe2tED9SEGAbonAPDY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeJrArtDHL4soUrTH4GrLMS_LBalvlDCooKDfz2gFwSw&oe=6AFF1EA5"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, 
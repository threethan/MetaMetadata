 "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z4YX6tffywQ7kNvwEMO9jn&_nc_oc=AdoBYaps1jJ3b13Jbb9SdpEN8FCBXyAFDaELKkhGTf2E3PvNe1w0HcBiiBxpu3mcbFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzcobp5vEqVMIS2jv1fSd4A01AUWahK_-U0n9os3xDug&oe=6AE0C8D3"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0SI170gvoAQ7kNvwFYOMo1&_nc_oc=AdriSY9To-vKhK1sEZOz0FTnExK0DtVJXGTuMBpoxPxiG-uBuHpzuU-Gj_qmZ0tuPRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWnPVnRW2xcneALTyalWovPSaYDxMeIwbhEtFPDFu-Wg&oe=6AE0B4BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eoUPdbCoBMQ7kNvwHlrksq&_nc_oc=Adrh_hV-BC_ET2h49d50yMnre6CdlpLPR91fZyBGRz4l8kCFmzJ6GTPcxZdKXp-Y4Wk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjtDtGXEh8AQJ-Fkx8vNol9bM8elnZ107qqbJJqnxCBQ&oe=6AE0CC25"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4545138309051240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
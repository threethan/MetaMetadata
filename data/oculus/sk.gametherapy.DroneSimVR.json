_LANDSCAPE.png", "id": "942726861931614", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_942726865264947_1440058703484180952_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HovBjrZ6POQQ7kNvwFB_bKi&_nc_oc=Adov6KDDDVoMA8lg7uX9eTQo4fRKb5QjuB9RFli8iStbik4Hs7GVOLn6vKYhOlZJsUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRETDQwmHCiErMwz2krYlDCxgjWpzC7Ej-VcGlT-drVHQ&oe=6AF7470F"}]}, "id": "867415029505178", "locale": "en_US", "screenshots": [{"file_name": "01_Drone_Launch_2560x1440.png", "id": "2878604402539091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_2878604409205757_1407514537668829308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m-x536niCgQ7kNvwFVY5oK&_nc_oc=Adp0nt-FHKY7oh94uaNMX4fPnPIiDFrFebTo-reLwra5fhWv1nDyU21d0__swazbSzg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgdTxm2S_K-ed0UaaXk9O5i2I4S453yRpqvtcAw56_6g&oe=6AF7263C"}, {"file_name": "04_Confined_Space_Navigation_2560x1440.png", "id": "1664669445109744", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1664669448443077_2370521189460363504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ2NxH-BB0gQ7kNvwFVWtjg&_nc_oc=AdrMVStQHd-IN_5SummbGTWvfdjcmYA4t_zsaH6_vj3u-ER_2BgmljrllakIL2fGU40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZV5Wj-rum4PdCy96Fjo3CFpJFztzMHxR9ZNo4ZAq8ow&oe=6AF71DC4"}, {"file_name": "02_Industrial_Inspection_2560x1440.png", "id": "1179656981671829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1179656985005162_103017809827273498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzyx3sorDzoQ7kNvwHAmp0l&_nc_oc=Adq-vMkaXwa4lxL8gw0eD8aNof0VaztD043MYkMIzGbRRGRKI6ixM-CemElQ8VH3Gmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvaIvAivgsSGqLu0FiexY8vTs1Oy9A6ekoZ2Prpwh1fQ&oe=6AF741F9"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkB4C5hdKK4Q7kNvwEf0Kys&_nc_oc=AdqDd3C5-S7Pk4WhVTZ-M9RLltE86JqKBFfBA2-MmlkxIZg6sYHiEUWY2x7Va85ucpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS06KaDPSceRE1F44C2CEQ5BTMS_Y4F9-M7trV4PRUVcQ&oe=6AF73253"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbvMusdoZksQ7kNvwHWFEBx&_nc_oc=Adq_H1DykRWYosgooTiXPBHBzQ7qCuu33spbEYGRvGkT5rdVtai18B5aa3xh7w5JPZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY8ZHWtc-VCzMjF_QdJvLUhBfj5VIkY1cFG9SOCyNXnw&oe=6AF71E3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWH_kQTFQOEQ7kNvwGJRnrD&_nc_oc=Ado-aHMbgceEZirLuiH8gEKT27wk_qpTt7q5-uPUkkTshesW5VFGMD0LGjYAMFgnSe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-VOE86eVvglIN61YPhlVO_AhvrJv0s4czgRagO4Np0Q&oe=6AF735A5"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4545138309051240"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent
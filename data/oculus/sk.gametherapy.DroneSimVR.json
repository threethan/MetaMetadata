Dx1IIrhQFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZzDQOl6Y5ZQ-fQAb6ed9ivnquNBU8L4QyesHtLXunvw&oe=6AF32944"}, {"file_name": "02_Industrial_Inspection_2560x1440.png", "id": "1179656981671829", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1179656985005162_103017809827273498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqIHZoQtxFIQ7kNvwF1eCz2&_nc_oc=AdombnHlU9LsaMkKacP2Gsj9tqlBniJdM07O1J2cQD3NPtbhHoutTEiZ0eUvD9K4WI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaXbW-X2niBmLAlItvkjnWwfbKmlrq7Ldvmw2HfuE0bg&oe=6AF34D79"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQP3Fr6nDUIQ7kNvwHc-tz2&_nc_oc=Ado67ocCBK6_YyZS6zXbaWMQh5tFryx3J3m6tqryLQT3wn3lQFcxXZOcjZGEJqfQNqY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScvQV14Apn-zdg0jx1EwsH3Et-BIFxJLv1baOBF5wWeA&oe=6AF33DD3"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VlqeTLIIMQQ7kNvwEhS12T&_nc_oc=AdpNVujJWQNLfIYDdqrRJZwucN-hwuJnDhGj67414dUa_pmpb6BHRYRXt9kBano6l7o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhJytTvJmGowm2E-yY9MZQKbp4oalF8bdfYV06te6RMg&oe=6AF329BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0kN_nhcCCsQ7kNvwF2J6az&_nc_oc=Adpz3UyRasWI-w0FH5wTrdXglcSvpowYC9dQ0_jEDPdE5-JDyFJ8y_ICcbjl0A_mVew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGuJ1p5i2rTyzwtNxKCUo5ei_o32mHakDZyT8CoMBSyQ&oe=6AF34125"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comf
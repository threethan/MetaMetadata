kkhI4wHD8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKE-WtoEnZpH0jWAjJR4kh7E6V8Y1wQ8PHlPpflccU6Q&oe=6AEF34C4"}, {"file_name": "02_Industrial_Inspection_2560x1440.png", "id": "1179656981671829", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1179656985005162_103017809827273498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6YW7T2pRiIQ7kNvwGPHH-O&_nc_oc=AdqTP4UhoZ_Yw2pGvDKxowe0aeXty-WfuGBVaPz_PKcbtsEj1TMXCnb0F9cACCkynro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvHnRJo9_Fss7bzrJuc_uuqWDaaJvmNuWIyiiZJB-h_A&oe=6AEF58F9"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO8DJYfmCH8Q7kNvwFv894V&_nc_oc=AdoDpn1zU3wQgj1Bd-UJ0p3ZyIsGGswlfLwhShtSUI1MnTp4U7GFuq3cIcRn7c3TtJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiIfRJ0W22IjS0_7b8FAEAq9w-xVfNTVzkUeLyVQ4gGw&oe=6AEF4953"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SVAcGF1cUAQ7kNvwHHPBR-&_nc_oc=Ado-q5owzNJ4BNOVga_peoLi7TUQvIz2IrC1ZOlOC8UR8oYGkC3J9qJK-2gLwYUUISc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSupgHQUmzWdiuuLjKRBsMSvmHNTDphbO8OyBqK2cJbZg&oe=6AEF353E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lbjvUCayiMQ7kNvwGE7Y6z&_nc_oc=AdqQ9mURGmE_0qWoXouzDOWzeKuM-evVKwdxVStuo_PDLausyp_y0Saux1Hk9X28ge4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ767thMePWCSwzb7Ut_A7jl104yoV2IHWILVJ2vnZFQ&oe=6AEF4CA5"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comf
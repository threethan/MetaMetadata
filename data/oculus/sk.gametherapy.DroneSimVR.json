_goHSxLmw4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsx7mVlQCrtTXli8qeWSTBKxfOqLNfKN-Lc_9HlNVhKw&oe=6AE205C4"}, {"file_name": "02_Industrial_Inspection_2560x1440.png", "id": "1179656981671829", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1179656985005162_103017809827273498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2LH6hoBkPsQ7kNvwH5KCi_&_nc_oc=AdqJ-yILAlBsnQ0xUy_ro4F85XkHi2muFnvK4yle0oa6N92t7isWzQ0OB9nuUrn9ZEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZH-iCuZYOrhLwaxA7uF6KPev3G26lpQuvg3RDe8ovsg&oe=6AE1F1B9"}, {"file_name": "03_Overhead_Crane_Flight_2560x1440.png", "id": "1625548985820893", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1625548989154226_8545029774009988429_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--DTKQ4vSacQ7kNvwHma5Dq&_nc_oc=Adq4-zwXXcMIB_49N1jh7sK9VzX5isc_4ZW9FDJ55f0TyU3RcWk20-X-3wbi3incRdQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzx4nEdEfdlY6jKB3altVTO9tnyRrRb09j4OLf2St_Nw&oe=6AE21A53"}, {"file_name": "05_Moving_Target_Tracking_2560x1440.png", "id": "1409672964558583", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1409672967891916_8481643579843169386_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0SI170gvoAQ7kNvwG2kDCC&_nc_oc=AdrQOJhOcgqTSjQf7FahHH59xg2Z-_jhOtBMXKqJ42XbshLq7nSEoDLkWiZ4w1kxZ34&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuCRhAKRQSHVnJKwFjL_5xUCFBv-ozhMXGLTEVMGlDPQ&oe=6AE2063E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DroneSimVR_Trailer_Cover_2560x1440_RGB24.png", "id": "2138507660036490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_2138507666703156_8737027430414240933_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdHTl9tmACEQ7kNvwFnsIxV&_nc_oc=AdqpfG6inVgBO9HPujniCSvbrPL0Bll35dio5Ap2XaGxpoiQw97a5Tn81Cexzkj9nbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpdrFOLul-leW330ocha2U1wRe56srzgdDFEae9vcyQw&oe=6AE1E565"}, "display_name": "DroneSimVR", "keywords": ["dronesimulator", "FPV", "virtualdrone", "UAV", "flying"], "long_description": "Experience drone flight like never before with DroneSimVR, an immersive virtual reality simulator designed for aspiring pilots, drone enthusiasts, and professional training.\n\nLearn the fundamentals of flight, improve your precision, and navigate challenging industrial environments without risking a real drone.\n\nFEATURES\n\n\u2022 Nine progressive training scenarios, from basic flight control to advanced industrial missions.\n\u2022 Two distinct flight profiles for precision inspection and dynamic FPV flying.\n\u2022 Physics-based flight simulation with responsive drone controls.\n\u2022 Challenging missions involving industrial equipment, confined spaces, moving obstacles, and inspection targets.\n\u2022 Performance scoring and post-mission feedback to track your progress.\n\u2022 VR comfort features designed to make training more manageable.\n\nStart with basic hovering and navigation, then progress to demanding missions that test your accuracy, control, and situational awareness.\n\nWhether you're exploring drone flying for the first time or looking to sharpen your virtual piloting skills, DroneSimVR brings hands-on flight practice into virtual reality.\n\nDroneSimVR is a simulation and training experience, not a substitute for certified real-world UAV instruction.", "short_description": "Take control of virtual drones, master precision flying, and complete immersive industrial training missions in realistic VR environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gametherapy.eu/privacy-policy", "developer_terms_of_service_url": "https://gametherapy.eu/terms-of-use", "publisher_name": "GAMETHERAPY s.r.o.", "support_website_url": "https://gametherapy.eu/", "website_url": "https://gametherapy.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comf
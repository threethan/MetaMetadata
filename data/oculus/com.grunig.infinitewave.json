shots": [{"file_name": "Preview_MainMenu 2.png", "id": "1679027753449224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/618758916_1679027756782557_6946082455910692057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK_l0IrE4BEQ7kNvwGuSL1G&_nc_oc=AdrU4wuozgenu74M0nJEfMeuhBYDCYXe7y_IBg21QvzGUQ7HKa2890eCccD2PsiPIRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtRixYrRpy0R7L2Oz4F4tHU0ySRgEt1TP4NJ6P3_sAHw&oe=6AEDDB9F"}, {"file_name": "Preview_RoomEditor 2.png", "id": "968825615760124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295279_968825622426790_1049309075501400002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRrykdP03hMQ7kNvwGd9cuF&_nc_oc=Ado_OxWkMNyTWKJACCvThcZRe5R81WcEQpiwnXD9fDlmJqOpdlsrJOV_TJArRPcsJME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLSOOByP6BoXQ25_KnN3Ukrcu78Z9DCJ_WofHVoSkDfg&oe=6AEDF31D"}, {"file_name": "GamePlay5.png", "id": "26791298913888531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_26791298927221863_8230803629923898613_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjRhir5XSMQQ7kNvwHwBvp_&_nc_oc=AdqvQKaTAdxKLdSdgTMQL1yOfpexxfr3HWYk0yx1hCEKCsz4tF5PLbYHMvyJwW7R-kY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB5mWd4Gjvljd2wGMjbQtUD_RDHrt00xr1IdzpfbhgyQ&oe=6AEDEDDB"}, {"file_name": "GamePlay7.png", "id": "4293257440929235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_4293257444262568_3651547262775710859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKCG23e9284Q7kNvwGpIUO7&_nc_oc=AdqvmmfOULCX6_cWwDK8XN0mEbGmwYfTWGX7Gm3w9h4K551IIPo_5PpUONib2gXqbjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjNTi7PaoGsXLrtT5YniiYk0dY3A8QYrpryDob9xrlkg&oe=6AEDF2D3"}, {"file_name": "Preview_Battle 2.png", "id": "884794624638232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_884794627971565_4563735209082997460_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hrJ74-ood8Q7kNvwFsmnmY&_nc_oc=AdoiYGlMk-Fq8ixLAUkcYeUL0S3zJUUVPznqKsik8yQ9MZjysojP356BZrJzCFwnhjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtwIXNbt22AiKLcIE6aiy5TIwBjEDo6aZ9fDl_SNDjtw&oe=6AEE02AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bedroom Landscape-Cover.png", "id": "1377990497536094", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_1377990504202760_722799078201510601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YvVw3I_IU8Q7kNvwHaBcr3&_nc_oc=AdqufrhKGTGTXv30Mi9uVNtbYFDnVpXPkdjW7-tFtvzd-3mBzocOZ3DsTSTz2OIfdvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMHdwDyVFyx27EFLAWr9PU5Ho3YCzpwKSvPlVSRp_WvQ&oe=6AEDDFD0"}, "display_name": "Infinite Wave - Invasion", "keywords": ["Shooter", "Survival", "Invasion", "Defense", "Tower"], "long_description": "# Infinite Wave\n\n**Infinite Wave** is a mixed reality **survival shooter** that transforms your\nreal room into a battlefield.\n\nUsing Meta Quest\u2019s room setup, your walls, furniture, and space become\npart of the game. Take cover behind your couch, move around your table,\nand defend your environment against relentless waves of robotic enemies.\n{2687987704919603}\n\n**Designed for mixed reality**: Infinite Wave blends digital\naction with your physical space, creating a unique experience every time\nyou play.\n{1298964038570663}\n\n\n**Shield Energy (Power-ups)**: collect Energy cells dropped by defeated enemies to restore your defenses and stay in the fight longer.\n{2152778398788390}\n\n**Turrets**: Deploy and upgrade automated turrets to support you in battle, adding extra firepower and strategic defense.\n{1490952212440086}\n\n**Room Adaptation**: The game adapts to your real-world space, using the shape of your room to create dynamic and tactical gameplay\n{1504177144704707}\n\n**Room Editor**: Mark surfaces to exclude them from gameplay. Useful for outdoor spaces where some walls or surfaces are not needed \n{1305204535130787}\n\n# Important\n-   Complete an accurate Room Setup\n-   Include all major furniture for best results\n-   This allows enemies and effects to properly interact with your space\n\n# Early Access / Alpha\n-   Infinite Wave is actively evolving with new features and\n    improvements\n-   Your feedback is important to shape the experience\n-   Please share feedback or report issues via email", "short_description": "Step into Infinite Wave, a mixed reality robot invasion in your own room. Scan your space, turn furniture into cover, and survive relentless waves of enemies. Aim, shoot, and climb the leaderboard as each build evolves with new features. Set up your room accurately for the best experience and get ready to defend your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infinitewave.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Josef Grunig", "support_website_url": "https://www.infinitewave.app/#faq", "website_url": "https://www.infinitewave.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29249828957975660"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827585_1680575833145066_7839658687137089127_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1
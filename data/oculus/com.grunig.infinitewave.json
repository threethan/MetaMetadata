zOqG6rhWK69uw2HF0NEF9JfLVh9E9kFLLBfFqQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IUm-f97rnTh-ZRD8qTw9WXY6DLTzo5ddyd7vcaYzn4w&oe=69FF54B6"}, {"file_name": "GamePlay4.png", "id": "1493244782386650", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828038_1493244785719983_1226333999787569680_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hnyl-_Ib3YsQ7kNvwHoIPyT&_nc_oc=AdrzeRp42Xig0hWOrMSkTduiyRoKDhKZcyuTPuv36OgegSiR9UViaAz7r5yCv_pl0WQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GHvigaj6LcDnGXfFxh6_QgGl4jG0h6r87QNfnGrB5ew&oe=69FF3166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Infinite Wave - Invasion", "keywords": ["Shooter", "Survival", "Invasion", "Defense", "Tower"], "long_description": "# Infinite Wave\n\n**Infinite Wave** is a mixed reality **survival shooter** that transforms your\nreal room into a battlefield.\n\nUsing Meta Quest\u2019s room setup, your walls, furniture, and space become\npart of the game. Take cover behind your couch, move around your table,\nand defend your environment against relentless waves of robotic enemies.\n\n{1452957722497118}\n\nDesigned specifically for mixed reality, Infinite Wave blends digital\naction with your physical space, creating a unique experience every time\nyou play.\n\n{2687987704919603}\n\n# Key Features\n-   **Mixed Reality gameplay** in your real environment\n-   **Endless waves** of increasingly challenging robots\n-   **Physical movement** and positioning for survival\n-   **Score** system and competitive leaderboard\n-   **Clean sci-fi visuals** designed for comfort and clarity\n\n# Important\n-   Complete an accurate Room Setup\n-   Include all major furniture for best results\n-   This allows enemies and effects to properly interact with your space\n\n# Early Access / Alpha\n-   Infinite Wave is actively evolving with new features and\n    improvements\n-   Your feedback is important to shape the experience\n-   Please share feedback or report issues via email\n\n# Objective\n1.  Defend your space\n2.  Adapt to the waves\n3.  Push your limits", "short_description": "Step into Infinite Wave, a mixed reality robot invasion in your own room. Scan your space, turn furniture into cover, and survive relentless waves of enemies. Aim, shoot, and climb the leaderboard as each build evolves with new features. Set up your room accurately for the best experience\u2014and get ready to defend your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.grunig.eu/infinitewave/pp/infinite-wave-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Josef Grunig", "support_website_url": null, "website_url": "https://www.grunig.eu/infinitewave/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25966570129634909"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1567041921659304"}, {"status": "PUBLISHED", "id": "2356367918173584"}, {"status": "PUBLISHED", "id": "1715679673174432"}]}, "baseline_offer": {"id": "1715679673174432"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778094000, "status": "PUBLISHED", "id": "1567041921659304"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results":
shots": [{"file_name": "Preview_MainMenu 2.png", "id": "1679027753449224", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/618758916_1679027756782557_6946082455910692057_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avPYG9k8tCUQ7kNvwG6CuvR&_nc_oc=AdrpzF7u-fzi3lJ7T2gdRKGDjKyUxlhFfn6K2YM2fjpjATu7gLdXpWm7m0XyRaU9ciM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0jXnj8q8xDmykVMb-oIaBynN6agSg0AU6m-XXurpuRQ&oe=6AF9B91F"}, {"file_name": "Preview_RoomEditor 2.png", "id": "968825615760124", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499295279_968825622426790_1049309075501400002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-Qx8otw2dkQ7kNvwGGCdtm&_nc_oc=AdoLWyD6CcBLuvdHJCUU4s7vaKvAtzwoweX9K6rd6KYlsI6pOwCETIxa0Z-h8FncCLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLNPaq-F7AMELeaqQexS3bFgt6PHBlcY7zY4PFywDGaQ&oe=6AF9D09D"}, {"file_name": "GamePlay5.png", "id": "26791298913888531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822307_26791298927221863_8230803629923898613_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZRQxvDF1MoQ7kNvwHIgA-o&_nc_oc=Adqnb7MqVNbW-v984FYPAkyzqX0HNAoEVq47NU0MK9J3VAag3GzUmT4m5a8kMUoCxAY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnmpQmZ6hkoKqGPTHLf48CF-Y8Z8OlmT8U2CZrn9TQhA&oe=6AF9CB5B"}, {"file_name": "GamePlay7.png", "id": "4293257440929235", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491818890_4293257444262568_3651547262775710859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwvGelvlUVEQ7kNvwFDTObp&_nc_oc=AdpEkkXfgy72aEH8iY97MW6vGxhvr8FAzs3fePlnthwn69d_vXumJOfICpHCmUWp_RQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMiRNE7h2f-1c9gvGnznGbJP6H35P3bKC6brhAGIDc8A&oe=6AF9D053"}, {"file_name": "Preview_Battle 2.png", "id": "884794624638232", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619187_884794627971565_4563735209082997460_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ipCtYrHBhwQ7kNvwFQ4AKy&_nc_oc=AdoZ4ICUjWqLLtsoIbzBVYbhGQ4NvBL9mE5eLbCDA0LH4J1THY3pV6vF0qjSGT-yrHE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_PUmT2hu8i_lqPrVFIuVwn-6BECSRbzD2EFJRaCoZ2A&oe=6AF9E02B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bedroom Landscape-Cover.png", "id": "1377990497536094", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824671_1377990504202760_722799078201510601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqFcOhNbHVUQ7kNvwGO7Uzf&_nc_oc=AdoccS3aO5Je2I2yU93gUdu0fCXLxoOGsiWM3aEpH-lLbqCJnaqGOrjU41sc10-4LSc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBCG2qMQVnAKo2wuP-4FePKyAtbKhLOMG29kpywpXwNw&oe=6AF9BD50"}, "display_name": "Infinite Wave - Invasion", "keywords": ["Shooter", "Survival", "Invasion", "Defense", "Tower"], "long_description": "# Infinite Wave\n\n**Infinite Wave** is a mixed reality **survival shooter** that transforms your\nreal room into a battlefield.\n\nUsing Meta Quest\u2019s room setup, your walls, furniture, and space become\npart of the game. Take cover behind your couch, move around your table,\nand defend your environment against relentless waves of robotic enemies.\n{1303363521935955}\n\n**Designed for mixed reality**: Infinite Wave blends digital\naction with your physical space, creating a unique experience every time\nyou play.\n{1298964038570663}\n\n**Gravity Glove**: Clear wave 7 to unlock the gravity glove. Grab any robot with a beam and smash it into your walls, your furniture or its friends. You can also load it up and slingshot it across the room, or grab it with both hands and tear it apart.\n{1656163952816185}\n\n**Shield Energy (Power-ups)**: collect Energy cells dropped by defeated enemies to restore your defenses and stay in the fight longer.\n{2152778398788390}\n\n**Turrets**: Deploy, upgrade and repair automated turrets to support you in battle, adding extra firepower and strategic defence.\n{1490952212440086}\n\n**Room Adaptation**: The game adapts to your real-world space, using the shape of your room to create dynamic and tactical gameplay\n{1504177144704707}\n\n**Room Editor**: Mark surfaces to exclude them from gameplay. Useful for outdoor spaces where some walls or surfaces are not needed \n{1305204535130787}\n\n# Early Access\nInfinite Wave is actively evolving with new features and improvements. Your feedback is important to shape the experience, please report issues via email", "short_description": "Step into Infinite Wave, a mixed reality robot invasion in your own room. Scan your space, turn furniture into cover, and survive relentless waves of enemies. Aim, shoot, and climb the leaderboard as each build evolves with new features. Set up your room accurately for the best experience and get ready to defend your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infinitewave.app/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Josef Grunig", "support_website_url": "https://www.infinitewave.app/#faq", "website_url": "https://www.infinitewave.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29371646092460612"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827585_1680575833145066_7
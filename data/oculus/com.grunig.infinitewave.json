HetsSnFAW-E28Ry__zWCCm23LdUzZwDtGytU-eGdlPI__ATCCyx9tc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjrEDfJwGZiIdG8ivcGcmfAwdgKBhbd8zVfhayuO86jA&oe=6ACCFD53"}, {"file_name": "Preview_Battle 2.png", "id": "884794624638232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_884794627971565_4563735209082997460_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRHZOvfz6Q8Q7kNvwEGHPlv&_nc_oc=AdpDuv5aoX0LmPe2PAcUQF0jXGS6R2i-sypiUrd-ZKlcrfmrU_qMz9kVVVFKA92GKlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoz6kDebdcovVowzEUIk-AJ0FYjGFdN2Jod_IbxPqBnw&oe=6ACD0D2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bedroom Landscape-Cover.png", "id": "1377990497536094", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824671_1377990504202760_722799078201510601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfScSX1qHfAQ7kNvwHowfTr&_nc_oc=AdqdjzYSv6WSbjk67Vk1-8ljlQMXZ8QtDCVn0ktoQQ6EyDMc4RdyawWXP9XhX0YX53Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJANFuqYQwdpDo9SFlYDffgT8k95jOgt0PF4XbodX3qg&oe=6ACCEA50"}, "display_name": "Infinite Wave - Invasion", "keywords": ["Shooter", "Survival", "Invasion", "Defense", "Tower"], "long_description": "# Infinite Wave\n\n**Infinite Wave** is a mixed reality **survival shooter** that transforms your\nreal room into a battlefield.\n\nUsing Meta Quest\u2019s room setup, your walls, furniture, and space become\npart of the game. Take cover behind your couch, move around your table,\nand defend your environment against relentless waves of robotic enemies.\n{2687987704919603}\n\n**Designed for mixed reality**: Infinite Wave blends digital\naction with your physical space, creating a unique experience every time\nyou play.\n{1298964038570663}\n\n\n**Shield Energy (Power-ups)**: collect Energy cells dropped by defeated enemies to restore your defenses and stay in the fight longer.\n{2152778398788390}\n\n**Turrets**: Deploy automated turrets to support you in battle, adding extra firepower and strategic defense.\n{1490952212440086}\n\n**Room Adaptation**: The game adapts to your real-world space, using the shape of your room to create dynamic and tactical gameplay\n{1504177144704707}\n\n**Room Editor**: Mark surfaces to exclude them from gameplay. Useful for outdoor spaces where some walls or surfaces are not needed \n{1305204535130787}\n\n# Important\n-   Complete an accurate Room Setup\n-   Include all major furniture for best results\n-   This allows enemies and effects to properly interact with your space\n\n# Early Access / Alpha\n-   Infinite Wave is actively evolving with new features and\n    improvements\n-   Your feedback is important to shape the experience\n-   Please share feedback or report issues via email", "short_description": "Step into Infinite Wave, a mixed reality robot invasion in your own room. Scan your space, turn furniture into cover, and survive relentless waves of enemies. Aim, shoot, and climb the leaderboard as each build evolves with new features. Set up your room accurately for the best experience and get ready to defend your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.grunig.eu/infinitewave/pp/infinite-wave-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Josef Grunig", "support_website_url": null, "website_url": "https://www.grunig.eu/infinitewave/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_inpu
g&_nc_oc=AdrQs-cGQVx6FIPxkuplnCnOpTlyQLv13VPlBPnB8UdDSNlG2thfHp59uY7FbDjggOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dwGPcb0gv-Fep5Cx4blwW63w49qEFbbWBfnvW_xXNsQ&oe=6A072805"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Caad90ZEa9cQ7kNvwFSC7_f&_nc_oc=AdqqMgYaM7Tz_2NlPj_OLjcPNb1LTKBcfpqquSFL38N2GarJZkF2neyXIKIVXAJwSOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pNJjsKvwgaDYTZN0TGW6fgP1JduLnNVXw5G-dcRasMA&oe=6A070C16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLb9iOdo8q0Q7kNvwE8Ocn0&_nc_oc=AdqR9eJz9OobYuUK_4Da0vALyRfl9wl5u33oRsxNQVZE32ocfjj_Q4-HVZMCzRb06EE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72IPI0XaLXGZZjBfPofInXEVSl46QFFeFwCFbYFPvfHQ&oe=6A073EB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMTGNkQrlAAQ7kNvwGEvGi8&_nc_oc=AdonQZW1NqeoHKm9xmyPcjneAOsqL1-T3DOaqxOZ8jrrsFXRDoQzNV41BQA0KY0u1tQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XrQagBVQHGXz8po4RwwUXttPPOBzme4CJOeTo3aBhnA&oe=6A072F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5mxFH2vdysQ7kNvwGf3C_S&_nc_oc=AdrEk8dFsi5mHd0J0mLTZx5SuV_jmKBs-MnYWLFhfWD2tC8hQphMLX4KkdK4Fr5sbrg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UDnXfbooOTLeD2xdLLmH6Q89YoL2eiLqBRUttmdTYUQ&oe=6A07431D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD89op6_OjEQ7kNvwFDA96M&_nc_oc=AdkoPtMhpxgrWALYjTZGpg6kpTaDsM8DwKTlSFhuWPx439DRDh1fnnxJkUr-gUtFwHI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuY4j8rDqNpNaRLoBmivwHOkZAhxJe7nawAODdU9ikaw&oe=69B80E05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXa8X6jLVBEQ7kNvwHAm6Pv&_nc_oc=Adk6jAxcbFqYMZUL9Wx8fchgQfxPTWLsbrwFLORCXMx1DqLjjmi87A1XNOjXmPuYjWc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfUN_3QobR7fjx6LNU6bL34mEpPZBvgU5RbQBSYCZyKw&oe=69B7F216"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-qeAQNzmisQ7kNvwEMLQ9Q&_nc_oc=AdmO0toaGI4dcsoKTv9TGAnSzkiOH5wCwFBj2BhAclwxZq2tdOnsJKbrWYzooxEZfrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9HZvcZMPcLY0CjY-K9iKNF-v_86-QG5QbHXbLMJzS4g&oe=69B7EC71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAxLl4zV-ssQ7kNvwH8q_eF&_nc_oc=AdlWJ7_MnH4RPGFNyLvC9jHPHkf6Fjteif4l3FPdWjo0cAxSY76F7_KdkxI2V-tpjaU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwTpHIQRKlkLprPfg8y8jgTnoh9PlDJUNOR5vByl5pUCw&oe=69B81504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL_lCmxbj2MQ7kNvwFG6Nl0&_nc_oc=AdllOaFrsXhiY4A4vZmitdTWkNfE143CtBnnTZX1KJ8jZq7IKYqK9CVHInDbCQH_E4o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyea4Xf7JyvrtB_IORy9QHMaFfBfyJwonlI0KasxciMtQ&oe=69B7F0DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
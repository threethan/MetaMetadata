.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg9S1AeRK7wQ7kNvwEJW2BJ&_nc_oc=Adpsi3BrukS-b7e1nGCsIXJD0-GbpQSEZLTCNmRaOHQvY7195NdL_gGkP1w5LDofcSY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWsdFO84QMXjC4ETrn6ixjLqxkn4nnzKUaAlOKeB1xOQ&oe=6A81C385"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAHBvIO74p4Q7kNvwE3TYOL&_nc_oc=Ado6RBRyKy5vJHE0lCLClDKOy6f-_bRCkLrJDYuaVMErO53j85nktBODE9M__wNhbZ8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPtgAQqSlRxxsF8ya7C5VmHggJ8o6nvkHhra_AOFS_xg&oe=6A81A796"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MGqK0wVRf0Q7kNvwGxF5eD&_nc_oc=Adq1Qy07qC3tJCkw13GmEhNthJkV2lu0fVhvAn09nbi8u3-oWzWkQ3an26HDOAG1ec4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUZew-ukBMdVlEcMoIj7JVgqycOriWuTbml4Oi4P6_kA&oe=6A81A1F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3d3SJ6glsgQ7kNvwHlbdMP&_nc_oc=AdrpgFGm6rMFyarJC5xlHQUtryWtW0tJMMbMaqy1u8O5ttjyXGr7fOdccPcWf_wD40s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZgqJ44j1Q77TimJ5hPrjwFb2EPMD7NtxkGnnKihGsrQ&oe=6A819244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgWiC11k5nsQ7kNvwHPNe80&_nc_oc=AdrQZzPq6w7sFt-mvXLRYyJ7TW-7pmcI3hG633GinmOrBFPr8CxzgSQKFCVDmLmqOlc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcmywc-c0CkDgRM-wY6Ec3IS64QSTrWNt8_e1_D1hbAA&oe=6A81A65D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
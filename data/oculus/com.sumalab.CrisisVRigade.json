m&_nc_oc=AdoG2K5k7edDzSQo7SsYnI8vGCpdDGmwKgrnxRXpOmhWZMUAXUO2lgukwxyIa80nwdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hkYY0lrpOs-LAUpg-fQ7CIOzoS1CDRoPXA16MPXw63w&oe=69EA2705"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-wvYla_Z-kQ7kNvwH6g_sF&_nc_oc=AdrNRMTiRGKqTZhc0HqR60_58A3hKBwjhqG5tkZKy5xb8fDB5WHop70ABc-xad1ZR6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZiFbJ3K5OfjaKCzIlc-tM7QKI9CbVLpuo514RY_IV8Q&oe=69EA0B16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAfmAw8PrOYQ7kNvwGL6O-I&_nc_oc=AdqkkGYtZxZmMcyblxpcSwIGAHuPS9rYNjdOHAMYFxWLARAfVhKgYbjlpG7sVedMegs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v63NVxrbxhBWBJEt8ok8rZ01Yh9ZwijZoT-UAOxH2LQ&oe=69EA0571"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfaP3Tar6S4Q7kNvwH5Bh9f&_nc_oc=Adq8Nd4e41rNYM8TWgL7BJHSGVbeVtn3V_xT_RNgLYONpvNv-u1cHNJUwaJRM2C1sLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1j7CkVIcTrEKtmHm1t7HhwL0dIO8DntoGctZBBK16c-w&oe=69EA2E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNpr1iwoRCAQ7kNvwEXLptR&_nc_oc=AdpuGeCnc3tpIc_L3bgx0nsDwuN3Low3H745nxkj-UCjcA126uU_cQSHjYkycpy0kyM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G0TVuFiB8QEQVcgy3d1Q_0OuwgbKtSYcekmFqjPNbeg&oe=69EA09DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbkMi0SqVp8Q7kNvwGCG05L&_nc_oc=AdpVe1HcENCGkkqpHIAFx1N10hzZvmTbWQkJkUQatq4_EG-zZBKus-2gVXLV2H9_F_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQt1DtieDBdhZNKqVt8bR0XMRGy_IhbtDtt-SGLQIDyg&oe=6A4D0785"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9BxS3k3ODsQ7kNvwE-clD-&_nc_oc=AdrQWS56I2zPB4hiHSPsM_aJMKmT8077wU-lfiGicvZU-9B1Eut3ynlsp7kf4kYk8J0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBo7pDy-OOJmfTwhPOde16GWYsMHULoieVKcahjUjaO5A&oe=6A4CEB96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1PrqYSVkXYQ7kNvwFWM_uV&_nc_oc=AdqrFQ3jPk8IZvmh0m1NNEVAh6gKyFXxxRRRrXqQcUyUT-X3zEkyQdyXymEajD6vkXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCex6iCkZM_RM5OS56fBQmlpJX4nbMUBTiNRT23wcLaIw&oe=6A4D1E31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLioC2wdQ_kQ7kNvwF4_3zn&_nc_oc=Adq870OKugeiEdcmSvHodrdsqd-NGLr_oEj7HMXWF5xz572dhjfbTCKw9-ehGrcLI6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBROCWr4ZJLtvSsCpu5oWDsWZ0FstKrDXRNPqfDKjxIFA&oe=6A4D0E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo7B7P8CPZMQ7kNvwHDacX9&_nc_oc=Adp2c20fe9GrOhDd9C7rNyb5w4NuBgW9XmHmWzV3Bfwch-0vYcGPcOBD2H9fMZjAMhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEqZAWWgGm0zcpCSorl4uaTMoNpgLQ0LppZ1got-M3GA&oe=6A4CEA5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
I&_nc_oc=AdrvYHsAhP0P9AnE54LaXrqAOUTHmSirLv0vJcPWr3ARpucwyZw3o5n_d2XHev3P7JI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4chK0HjpKjD_JqK1CAuOXJUNFloaHl_U5zMAJor7F6w&oe=6A43CD05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WklsJy1Qg4EQ7kNvwHsU1oQ&_nc_oc=Adry2Lm7tLvzJHlFZ91Lq5BtmoKlKTySrsZ51Nfv4vNCJa2rxAA-blb_7-tacqaTHcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XkGAUyZDfRtZgFT7MR3udJ2YtfIVOMxQ1Ua2I9MLF4g&oe=6A43E956"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7cZiEpb8yQQ7kNvwFbPoWj&_nc_oc=AdpehZuM6Hvc4qbF7_sNIPz2uDwmKIh-1H1qKx1Czp3kiYZB7lD_1S1LIMn0byL4SQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Pm557AoXwdSlB7hxYwPBKRI5jyIWDVwzKAWuRexcCHQ&oe=6A43E3B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdXX_HQjFp4Q7kNvwHjRTtG&_nc_oc=AdqxdHclfQM7CQjMYuxxcPyxv2j6ufozwVZ1K732V9kcs_QYBS5TjY6Aa7ho4d2YHu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vO9eSWqiyvWn27dI3luMHH-AbxgE0RmVa4njfuNq6aA&oe=6A43D404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--qaoCGzIWQQ7kNvwFeQqJd&_nc_oc=AdrHnXTks-t9EPfF6wz17Z7tOmW5QqPwy55lWpy_qCZ5sL9KBvf3xBQsCWc8z-x5vBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jgia956mDk01cl5bpcx7bTr_uPncmQnx6zWgwVALuFw&oe=6A43E81D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
S&_nc_oc=AdocklfLf_JGwNZp3S15zm4U0CaashRbTQWVSO0nQMc072fWDEomgKKkGX3ayDAM-AQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80KzeSQyGe5fBFm6TL_DhGo8EPxXGe16gT_rWcvNcWvg&oe=6A451E85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WklsJy1Qg4EQ7kNvwGAb9by&_nc_oc=Adopbg5XM4Vg7rORpkINAKT7Raznp2jfJFtGjYQD-Yw8Ko3ZH_3_nn_IV7L97nakt5M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lv3mBv10iybR6HDrpo11nkSNcAcgnkRnwXPnzyjMW-w&oe=6A450296"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6dZEK2vmoIQ7kNvwHY9htz&_nc_oc=AdqkXcoQdLYByTw3Eq3Hx51xDdLu4R2euuNRRXvwLPz8f5eff7gGtO9Nmrbwjg1flMw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jajCBQZh0W79TCSEUAfRmZAmNNmPzZAJvB8U7NQm7Bw&oe=6A453531"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdXX_HQjFp4Q7kNvwFuLSHn&_nc_oc=Adq4p-VmuK6DqVybYoy2NirYq8_K75QGlVojZ_FtlXXpRxeeProc8JW8PVS2sinwPHc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dmpl658h_wdOYsdYY7SF8dDTHnCzsitIEfq3qvBhViQ&oe=6A452584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCnWEP6EDlYQ7kNvwGAyw0W&_nc_oc=AdrrplQttk8KYYjVgJPTISRfNXsSPnPEPVJymEMGeYBx3tCu_QMQIxfTGXgDouPlCtc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kopu3tnw8Qc47_O1vTHZ_Vf5eNuza0g025zR8vUmcJw&oe=6A45399D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
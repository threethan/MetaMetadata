Q&_nc_oc=AdqDHZmEQgDHMSY430ToOXA7oYwLu5IYYbianR7JLYAGtJC4ig0HFdeo0oxCQUIP_2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lwTdoGgVxhbRT-sxmqEljx0V5I0f7fnw1aeZWGhvQdg&oe=6A199D05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPHYRMOuhEIQ7kNvwGuzdlC&_nc_oc=Adq3gKwatsiTrH7UXTdUfVWZZBkOHNfOBZPWN6PDMBxvkhDFRVRoP_paGiBPsVUTHl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Io3TkkoeKaTU7MFa74cFp-UW-wf9fma1dOyYQJlHPww&oe=6A19B956"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7Jg3tLxxhoQ7kNvwFAbiL-&_nc_oc=AdoJBGQ8vdAVx6H46x3GzPIuh-ES2AVLU221XveXzTt4Jb_nGcTMeJTc-dJ3k2acQhw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41SCMUp0b71mbc76n17mb8mCZeJxEfnZvcDqbTMqyFEQ&oe=6A19B3B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On9QSaPE6H8Q7kNvwHmdAVI&_nc_oc=AdpqI6R9onVqbA6hu5jNBV0I7KD3SNmSfNQovcJ3TgjWlOQSKRvF0t4fPl0D0elpjNM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BGpOGMRtLTi_-XxlcXXEGMVZnhOoeOsuEmu5WImfiKA&oe=6A19A404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrivZHe71WgQ7kNvwEql7aL&_nc_oc=AdocLmaQNQk3N-8nw650aHpZu4kRR5Mx0sfXDVUXqshzdvwjoH_7e6kQ2M-Lvn7zoFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zaldCN0nIrex0G3WmMtpNsneklno3O9JlCzMKpIbaKw&oe=6A19B81D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
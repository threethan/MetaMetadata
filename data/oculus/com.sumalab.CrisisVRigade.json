.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSsMZLnSn-cQ7kNvwEEqOUj&_nc_oc=AdqqIlnm2JcrBDwGaF_geSREt7jrB5xWvarcTuOtb772a5zpZr-6xS7uuk-mOxD8TK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SDnTaMM4owE_CEw5xZce8R9008zQj8qlyM0wJHP1iJA&oe=69DBA685"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMgey078lKcQ7kNvwFjHgIS&_nc_oc=AdpfYPc3h2xQKyA-8K8dkG0M9wNJrpabGFDXg-GCEles6mqI61tN5XmxFI17tdjbWFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qq1NhJykFLOvWlR6BDsMyUSl1jRPRu3yRzsUMgOlXkg&oe=69DB8A96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHsMcUkoD_QQ7kNvwGOn4x6&_nc_oc=Adqh4rMeCb2erchNt00go8AutdJ0BiWiI0LHNTWnCORD0JdRvh3Wp2M0yc6t_3353HU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af301bI8Qz9ZcQPa40gRHjQ-Ccy3pK5GdzorRuPdSRBmwA&oe=69DB84F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVl_eGPD-xIQ7kNvwFmHf0Y&_nc_oc=AdreYB1fw5VZG6kwaGK28VF8oum4l3Xa4EtPutHmhUF6T9QKIW95_paYtGXstRfAjzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j4DUgp0BHe4ovk9w26EH892bzoru6REW9mqUX9sIQDA&oe=69DBAD84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsNbGpU7u7wQ7kNvwHyB4Xa&_nc_oc=Adr4WzuGuxMYzvbWv0ev1Fdu7PK71sXhn9T9Tz1QUjuhmmNs9I0ram-w1wYw9U49WMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18k-8ghvDepk04Mm9MVwKk0LSmnDMElALDnTYrdOiAnA&oe=69DB895D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzBaL3EZ0MYQ7kNvwG5qYHd&_nc_oc=Adq_z-a6o4jdKB2lPeV6-T37U8msdOIRaeof71UX2z5Vz_CujhMafufwvSzEnam5WP8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3kIUhiAFo1rGqPM3zhtALiJt0X3TOrvnN0NTdd9jN0A&oe=6A86D145"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd1BlzbhmkAQ7kNvwGIqR-L&_nc_oc=AdpiQvIEFCpDe3vJEEP7DXnCI0oWt8VIkVstX5CEmO3uecbtRbc3T3A3_VFki-OPWxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtK-3fUPsaI42NiZUifxlt083vbOOJbDPPaK4J70sABw&oe=6A86ED96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1iruXAllEYQ7kNvwGaE-5U&_nc_oc=AdrcAX58sX9mR55Ld4OBsOxNdoiRVSKEMllqrdyIhy7upAmRC0iY6ndASv-qFBBfCNk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYnlKlcNeBpRsHYf9gelxnpKTm5wAaZSNW9g9K8Gr8AQ&oe=6A86E7F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzEhvJ4bzmYQ7kNvwHeX0F7&_nc_oc=AdpKHDSk7xyDWqWAnBfj50MGUM_18CCrtELwvya--7IOpUkGg8k0KZJUaofkss2Q7wU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXbgyOaNqXQcuAkTdZ9Z1-bMM0c42T_7dXULLEGM8ASw&oe=6A86D844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c5nwuT4TkYQ7kNvwH_qiYS&_nc_oc=AdpSeNXRg7nKINHshAEau2Rde7musehrmxGFKvXzSxUKPYfs0HIY1Y-PqdZxk93fsB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpLkYdbt6SxetofvkDil2TEMuLSDBprSQ50vlyIxIo2A&oe=6A86EC5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
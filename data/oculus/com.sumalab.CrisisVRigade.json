R&_nc_oc=AdrN8QJx-M62kVXbc-QmPho136STVK4CJF-TJvJ-dhH2b2Q39soZSVvdnZry7o8Sqx4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WRaGPXEIrUHrymBD50yCVlX-aGPkx3tKWMIXrOc4OMg&oe=6A16FA05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPHYRMOuhEIQ7kNvwEBtHVm&_nc_oc=AdpjBMkJGTwKDRgDPg-uVu3MJx0FlLO48FWdXtNc-q693VhS57x0F1oFdeyFvZG234k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XB6hpYv6fNWyboqAzzDDLf1g1ZPq51kvfcsSNWeBOPQ&oe=6A16DE16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWzkOWUkWYwQ7kNvwGCpiyd&_nc_oc=AdoDb7yTP1JTwyFPHrcZV2-3JL1KlpEIdKylJ5rRW7h9ceaJyBnHmAD56i_KPsZC8Bs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-WdXGZBgM11SSqh426h7k2u0s-F_zwRSnFmucZJ5yyw&oe=6A1710B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUhxpFnVnnsQ7kNvwHw1d20&_nc_oc=Ado_WyYLjAMxthOm0JgrduFwtxxd--7g1oygUg_o3_dmih3MT5eTXwEujxTMv630AzE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lmxw2nT3EHji7u7KjoEaG3RUafFLvUM6I5lRL6_xNaA&oe=6A170104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDh38Mb7z9IQ7kNvwFkUV4e&_nc_oc=Adqd50RhLZ6iXPS3GFV746O7LDFBsRHrYX7w_ansdrZq79vh4UWR2gvCvHjK7ZBHXYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jGb2ZBB5I7flyMx_a1dqGMVv304Em4QcDJnBHRtZBuw&oe=6A16DCDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
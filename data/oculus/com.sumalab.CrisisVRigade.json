78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJ0WKHu3Xj4Q7kNvwEhnZ0e&_nc_oc=AdnfodzJ88B8TGrxR92DAQr-WIuut9Un121V_EhPucrvfy_mDYfehItwn7NOcJeLVh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPyEhYSBt5D_nxisl_9zGJ8u4dWN1L873duf363QgKNw&oe=69B41985"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXa8X6jLVBEQ7kNvwF8Bx0F&_nc_oc=AdnUAreTEFm7VNonc-zqC5EaIe7MqCkkSf2BpzA-bcypHeoS4pbRinrkf-kICvhN5S8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRG8j_ppO34-85pG9b95SU9sv5sWFmtFrjZVJ0fII6XA&oe=69B3FD96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL-1wdYnKDoQ7kNvwGsTc7n&_nc_oc=Adnuujkbbwi1Zj3NnvNMXoRpKSu8fsyRevB9NHob7epKuUkL5y7k7ZjISSG_s1-gifA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkLgrz3ZwEzUvQILeIxHbGBa_5PLYjMs0OG3aTZiA93Q&oe=69B3F7F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yPGT5vqr1MQ7kNvwHTe54k&_nc_oc=AdlYekbVheKEgg88wF7M2AcwnW-gNbLM5zjzc5H8Ptl8XyrIhEn_mkPKGBHZ-XHlnz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGZ61KiVpuoVBeP8vFWVWwV3_6g3JogyHcNDPAGYzOfw&oe=69B42084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfMxe4sXoFAQ7kNvwEFarz3&_nc_oc=Adl08LVw9awW9FQYFuR1mjfROq2ts13BAmuWxys_56ZHcsNVZePD6kNQj1bE4YIn4W4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXv7AXrbPUYZfBm064p-cL-12Q1p4ma4RNlbHHX6-OBQ&oe=69B3FC5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
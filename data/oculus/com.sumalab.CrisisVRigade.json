.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQXdHa6BqNMQ7kNvwHvvQno&_nc_oc=AdoELWCTng61qCBjIuFL5ABxS1RClXPcabl4d8y0kPObECSyEUw0xCeW74PfB4oLJyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmqLwhJZoL27usMhyfLY51W-vKrTuHZv8uexQMi49u4Q&oe=6AEF6845"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2dkSvvPtcwQ7kNvwEGEoKL&_nc_oc=AdobYMcA2MxHYAGjJStRERQ8frdnA87IMmngqPaHwdpjjrNunPNSjE5v7vOq2HCsosY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnWLGf8-tx-O_829Br5r7bJAztZvbnijxCb93uvKrX5A&oe=6AEF4C56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AshPcjEoHyMQ7kNvwFo-G7g&_nc_oc=Ado4vs_69bfsReEIUjP5Vw_2fWTYOV6Tf6oP8immqT_Z1Tg5RUwJaCrO0tjbBmA307I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHs6hW8UUmtDeuL12eCFfSIVu0HnfOyeZn2_rag1N8kQ&oe=6AEF46B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxyhfsP-MRoQ7kNvwGCyms2&_nc_oc=Adpf8AV17j2iGYNesSzx027fDWV4JYlcrjRZElKcNCCEo-3d0RB-70h5ew6q4vPyAYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9nGE8HdkLwK8nmTDuHz4bdr--hpS9A-6PEmUbZ4CV0Q&oe=6AEF3704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0va5ntCJGEYQ7kNvwGt6CNq&_nc_oc=AdoY-j1chLdIdPGnadz-zrmlVEr7HWmBajwmxyMSXBKPalx50Rrf-2nPPLZCTGwsYhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrZ1nDzlPxOWnKD8_-Cm5-koUqEQDTRGyu7f5XVvwrwQ&oe=6AEF4B1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "https://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
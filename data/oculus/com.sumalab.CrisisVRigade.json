.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEa8nyFiVV0Q7kNvwEwNSOF&_nc_oc=AdoMSdizWTFSWRWAIeuyt8B0Tf5eJjYAO8M9vS79QkRkGCnjdYCJ4r5oUkb8xkorThA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIWXhFY29CVRJv9JCF2KPoBK3KviLFfSxh9Vn-rJWhyQ&oe=6A900BC5"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GQSt0wMNE0Q7kNvwGPubSh&_nc_oc=AdoNCCLk_WxFzQidQxpAhDDoP3_52CT8Q0FdC6eW_slOwxR1zPn-PdV6t3vqn7D11-Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSmZWTbo_Ajnsxuy7oCF7kEqyP-m8G3RNo8ENL3ITE4A&oe=6A902816"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAcXTGhAWqAQ7kNvwEjgebS&_nc_oc=Adr8BOBzl9yONqLslWVhk14ZTF8h3WV_bBKfu2YW-X5JTypakldMhKtxGqZDgpb0lKE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS3pKHOiPpoHW0BbgXYRtokvDII6swBNNSUOXRyB9jvg&oe=6A902271"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-MfvWphGRQQ7kNvwFNpNMf&_nc_oc=AdqTFJEXVG4Mpe_4m5-zjbSoNbN8ib0osJsHRbWsUzGKp5MnTP4CFgZ4otQTUBcP1ys&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHz-4Ds8iHJSr950pW79TakzJ7dyhmgECG0piL9yLHAA&oe=6A9012C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuWpJc0pRh8Q7kNvwFpCF1x&_nc_oc=AdovaIgTEsRE7WCsg2Wi_g3BXHBd5adi13mfFj_EKJuw8NrjJyQ2RcQCl9xxvk-GY1A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFCRLjaqOfoG1RXv9L5PDT1S2Wam0ztT6DGN-NpyzGMg&oe=6A9026DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
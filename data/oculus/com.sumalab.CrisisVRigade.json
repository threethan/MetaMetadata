.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8WtmpTQRwcQ7kNvwHWpdH2&_nc_oc=Adopy_wwxwp5LJu6CJKfgOZoO87qz5Qdkla6kHfb1gJOrLCoXk_SZTxJTndMDVKX7nQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC27cv-Hz9dRxzo8lZRNq_y9JqXpc0ltFxylOKFPIPFQ&oe=6AC50005"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJk7oS4scwQ7kNvwHhmoqH&_nc_oc=Adr7t5ySVtPIYxNIJRFc1n7wbfC0vUdQQFd80OcxWN9p3UEW7AEmWXOQ39VYr5qsDSY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-4iOFh5bnvChAeMp5f4l6PXqoyM9PLH8WIggLW6emMQ&oe=6AC51C56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPGApYi7IT0Q7kNvwEYm6u5&_nc_oc=AdoY_NFfvWYZOMd_C6i3Y8vTj5IzsV2nouwPZE5Q0b4DsT6Qc7AO22KYosWq5kmJB44&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy9rGfvi_0wF5tr1M0_iQHo3LZUXeQbpVdDTGTP2YNWA&oe=6AC516B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81xQW-sCptwQ7kNvwF-U2K5&_nc_oc=Adrm8dTLv9i1NDFivGGzOQ43qDOx9R_MH5crEkOop4dN28--fxpjR4B-MTX0-UWsI20&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9Jhfvse6fFW2ahmkxsVHZn5zaenXAqtxa2JxzC6UZ5w&oe=6AC50704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bgA8vsIpGoQ7kNvwE8K_mm&_nc_oc=AdoK5vst5pg_fyNjqUGu0VpBXbTltB9Ll2YV5UGJUmVR931bY8oPxR31ehtY3dd6KMc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONptyKVvTV7elTuhvjQZEORLGkfpkrg3g0bhniBOYihA&oe=6AC51B1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
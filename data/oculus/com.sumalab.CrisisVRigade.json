.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGZwxFkkwDcQ7kNvwEaew1A&_nc_oc=AdrMJnZhiLs4m4tzVJNYMYdMSjSpA2Ssy5OkhABHXit3Z7ATEl9VhE4CCvPZVt239D0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFqSAqlyo2a85GTzz7yBUaEOU4pjTRj4nCV3bl27QgoQ&oe=6A5CD985"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M0sUTtgg3gQ7kNvwEFajiw&_nc_oc=AdrfGiPdM-NZiqSvFiZJKsb4GOhST0--fzuzCh1TJNp8ilG2yAy85L3JYdniA5LrYSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXVcmBoXMiVB6RzWpMdWh-t1IOC-Ii6BqyCo57E_gDlA&oe=6A5CBD96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86YJPXTs1s8Q7kNvwEzhuf7&_nc_oc=AdojAHgPyKYtXRmYO84P59uPuQHkvf9tqUu1B0ligYftkMRjluWzN_q_wsnqJ7j8GCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP95cqFkIUTV4M1bvrefWxWOPeNn-wjCcL0XNQwXTrnA&oe=6A5CB7F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amVvWJtabJcQ7kNvwHnSi4K&_nc_oc=AdoXG70mfRCI5iZmIcXO_i30d9dRY2oLh2D0D5xWboIpOIP1DgRQ7vMOhTmmXrpuwok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaiVH5kFmx3gDeytUsH7c2ggwKVGqs5AJIrHjz4ch9mQ&oe=6A5CE084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpyDET91wg8Q7kNvwHDEOEL&_nc_oc=Adr8q8f-lna35b3SDxcRMk-ceEUmztynSua_QOl4Ka1UHl1EwTxbgGac6WNwFovEksM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXcuTjZUeQNNnXuBYI2eOgg2XkBDoOQEHSDY7W_DPEBQ&oe=6A5CBC5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCKXiFkGVNkQ7kNvwF8Pmq3&_nc_oc=Ado204TeOCnwTp4IhvdyJAgwrvybff1NB4naB0j5ImoimKEutNY_Yzx2oYIDgDPtzxo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5JLX0ja0taM-5qdizguuX9JSeg3vHIoWgUdqT5sYRbQ&oe=6AF9BC05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdrLripowyYQ7kNvwFxS5GJ&_nc_oc=AdqsDGq1qajt-mBlAY343863zwsgbeYqloDlW-NDz8qoA4BqsTC4Xlf1m62yfc2gzdo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA3p0fCBTVSLd9eHYCWtYT2B5a-gT3k6_qBc0b_vtCjg&oe=6AF9D856"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5gUJg041xQQ7kNvwESnC1n&_nc_oc=AdolwalCezP_JsqmqfetWnb5YLTacfxPSgyMhotkEnUs1hL4u-xPIXtWjDkGKQbDijE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBrFoz28IisWzXUWzbGHYlR8VnmL0mIR6yTAw0tO2FJQ&oe=6AF9D2B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mltYUu0ujsIQ7kNvwHK2RRr&_nc_oc=AdpoB6xEV8yNiiaqscECwu5u80e-B2MoqqhRBgOGWpOwgi0BdpaIxLpjQaca3bDroaY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCpTdfy8FsJZdroRvgM63dZ1Q35Fe0jm4FJAfwTdej9w&oe=6AF9C304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmoOqvBzhx4Q7kNvwHa5q3S&_nc_oc=AdrOZ3S6S1hmHgwhPRdKW1HMD58PGViSZO-J3EWHja5oyeIS579T0M8u1YN5O6NYRIU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSVHC43WYhvJOPnsw8z2V1JF1_XjYmaukBrptA9w2iLg&oe=6AF9D71D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "https://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
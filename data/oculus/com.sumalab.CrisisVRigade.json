6&_nc_oc=AdruDua5Y6CeFTdMnbUv-eQMajonxW3sa-AecV6wBf4DvHRVRATNc5Vz2BY72oUpwAQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27yCyINzjwrNokqUgKfZLyXSvkBpPuA7ZWJOyRCywp1w&oe=69EF6D05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK2UVJuJhaIQ7kNvwGfHcFM&_nc_oc=AdojZqwTMzWqquTnthEWWbSODsP_XLnFoHJgi85MGK_Dv5f9JZvSHOjpj4rMZhIm1Ow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TuivXQJ5mpuSw5B0j_cOaT7niwnsxQQFDM4rF3lVTqQ&oe=69EF5116"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coWFIiwLGCsQ7kNvwGGYRjE&_nc_oc=Adq8oEHtB9Qr7uZ6NnHGYdRwzryoCX8h1Y1juJvpt4GAFmRgF3NiaigJ0EkLRTxdGso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UAN3Uo5eLuf3Au-bvZQ3gmfjP4pLJeF4b2-8nNqpkaA&oe=69EF83B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6aDFqLDNqMQ7kNvwFea9Z1&_nc_oc=AdoFllBIwDUQIQzQJ6Oq9Dm0RVB6zF1OACc1qwUE0OySpvG91_wEYMIn3pYvFw_yQP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SHhxrTs889O2sxN93MQQVwLGkMOCubhnMJ4Mt0j8WKw&oe=69EF7404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXF3nE5fwQYQ7kNvwEmJKPs&_nc_oc=Adr7fWYX2e4r9ZYjN8xAS-5h7F_CeULn5hZhO3KyJA5bd-RoVBZ-DYL7WK4XZlr-4i0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22VCStCsWNjMBQn4fWi-Ucg8jaF54XIoZfIQkp9URZ5A&oe=69EF4FDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
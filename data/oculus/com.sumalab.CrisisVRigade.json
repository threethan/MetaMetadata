R&_nc_oc=Ado_6lQs2uidV0xOghbc3AYda8qme72Ve-omA5iqEP5NTAvDTk_O0tDQEtjhfdnCJKQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qBNoy0Ml9PJFwSDmkPhVWmSDed6_x3VEXCXF_4l9OHQ&oe=69F8A785"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0cQIkrB-GEQ7kNvwFGN_Ux&_nc_oc=AdoUhxOtkK8Uju520ZDwrPWzK5SnPcaQkI2PyBMHLliX0e_PgKaLhwS8tps3qagY2hs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gMVnzeqR5HGLWdyq2QGzLv4qeKcNcfEg3R7qwocr8bw&oe=69F88B96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz33-34IcoMQ7kNvwFfFPrM&_nc_oc=AdpvfaBYav_wVRo5q_sMqyIvg2l4dNxpXUhq-J5HL4nOqIYn9acrsrzC84CEs_2cOUQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sXAw150ZURAbEpLJqPz95BvGX7rI1BFs6SvPRGp4lGA&oe=69F8BE31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpisEuIOLvEQ7kNvwGIq_74&_nc_oc=Adrgqb82YpAZs0gV3d9mP7D399YXsJQeXMzU39nrhlnqUpn-3Czghw6TzhJn5RbMqOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eTTI2ePyz_LZTVkbLRxGIlkTDAEzdkM9UAhGc0C4Krw&oe=69F8AE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du6r9GkvEkUQ7kNvwF03AU9&_nc_oc=Adoyp-p4EnyF_irDWi0dC3UcInu_eObPYynCRRx2zYutc3QowLXW5D1-Ydn90wAEW3g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NMQ1mLfmYkjCz_oIIG2whTzkswO3eM_jkBkZANunDnQ&oe=69F88A5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEa8nyFiVV0Q7kNvwFNNQfW&_nc_oc=Adr52mPfmL-gANlSo7aASw2h7edyC_ovd2r3KsOgzbdRihZgMKwMG7fQpPMtxSLEmwo&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWpN6tswY8VRH7kSur0_D9FX_8ppv8YJzBk0IofmMpgg&oe=6A915D45"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GQSt0wMNE0Q7kNvwH3QJDk&_nc_oc=AdrPERj2K0MQdLqVErf24IGwda2qfSS3RgiZGlDXmQ7-yTvbgckNxDB50BkLLaPDlwA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNmKmHH1iMCW6qBwiPXnwtxhhLn2P7AqzWrPu4QlgM-Q&oe=6A917996"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAcXTGhAWqAQ7kNvwFHq82Y&_nc_oc=Adrdkn73ZHkHGZlbhPY9zH4-noxe_dHKbHelhR_ff7QDnWE8HM5BCrJlBhMfSmwojMs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvmZAyidSRUem12csWRhB2gBshpF6geoA4yFnLKGApZQ&oe=6A9173F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-MfvWphGRQQ7kNvwGJU0iH&_nc_oc=AdpDLLEYQ3TPWagFYzJC0fNfVWQcOdH7BgYadwrW93CIaaszfdbD7bcPtWHr8tO8uSg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1XOZ7uHa7KnXlU9R6-2U48Sa3fQjAUMsAgK6IP3sE9A&oe=6A916444"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoaUjEl1pjAQ7kNvwHz1f6Z&_nc_oc=AdofbcHKgQDPgbmLE8DJ_rRXbmbKLXG-Y9NFsuX3cpGi5NFFQyMH4kj5pkdOEhkjDaU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG45XdkLJ3b9WQuNJb0LXDYT10EbD1EzwAFkYr3a8SecQ&oe=6A91785D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
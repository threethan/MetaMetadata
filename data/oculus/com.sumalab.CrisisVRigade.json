.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-BSwsYuOsIQ7kNvwGiNl4F&_nc_oc=AdqRrYdBJ6z9H_iMdbFu7M9YJW_LY9m-5DkC6btp_CXs6CNOvutyH5T1dTNLXhOToqw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgakJFhxfFwkQtVV0UG9vvGFVL-wMzNFUN2x3r_BvjMQ&oe=6A940045"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IgaYzauz1UQ7kNvwHxq6cI&_nc_oc=Adp07X4m8CK_iAnshb9FZgZ6PyElCZreB3UQUJI_etjMGCYRu-YM8aDMgTao0Yd3NCg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_2yEdzPtwxVvtUlRHEzbaGkvIta4qT_vObOtALSTwuQ&oe=6A941C96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rosJ0SFKR5wQ7kNvwGMIAr_&_nc_oc=AdqXko7ouZuC_5kl5cL4j03qAi258XVtrVRGciCzT4D3j1eHQ5foPVXVWT_oyTYB3UI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOB8v0a9D92DkeHrSRkfe9lZ9XfTU5LvFU7e8qW9757Q&oe=6A9416F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAkkftO71ywQ7kNvwG1i2C5&_nc_oc=AdotHos5I6-h328CDIroxeDCgCeo1U92sh971L_FI3ROF5ydeY5KLzb819-A6d262xI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQFEiLworR6pKWwDM8FUyj1_6shVI3RwH-pR_ynMHG7w&oe=6A940744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoaUjEl1pjAQ7kNvwFfg7E1&_nc_oc=AdpCahf8Lc9VzcjA5DbLbpE8Nj1Z2LemdEHhf0tO45HvcwBYejp2chkx_TIPXp19hAY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmtnAt3twYoIWlFBJ5jJJzTU_w6KpjaLfeM3Hvew6I6g&oe=6A941B5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
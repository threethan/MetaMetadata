m&_nc_oc=AdpBszE0y-pqyLfC14fRZiektez1eUpHNsnhDEGgLxQOSFcka8AVRGJBl2_EVmDycWc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PpSBk6RZMY0s9ptzonmWgkiVLrLcnvh0v5kW8rqZR-w&oe=6A1AEE85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONiluvj9JoIQ7kNvwG3SnGx&_nc_oc=AdrEJixeIv7ikLagwB8CWojvKoB90A6oQ6LLPYz3hArIElsc_lCNczFyVsiuCrHRlmk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af566ZLlkqiF_cG-JMnaEJEEEZ1qMDpiqzK7ESw13a2aQQ&oe=6A1B0AD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7Jg3tLxxhoQ7kNvwFH2bwM&_nc_oc=AdoA6i673utUMCd0y54L4yZSFYZMSGHkuWdh1A9lNu-GjgyDXDJ_0Zf-Y7xrKPGGCEM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-ss3QFGUS5WasCrGeV50WjQka40z72blZ8WvjNiZV5g&oe=6A1B0531"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On9QSaPE6H8Q7kNvwEn7xTV&_nc_oc=Adq_qK7sITmrUVRhcbfMUOTHygZmKSGFEjXHxG9DeO5zgx9-AlXQQji4wlECgZdRvt0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pk0Ifi9UF2tPfV5gQWbWnsa2hK-upnM6AMPRXZjMz_g&oe=6A1AF584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrivZHe71WgQ7kNvwGOTe9G&_nc_oc=AdrHmPI6kMgiL-D6kcnUnM_vDYblm3vIZ4JU9c05culvdus42LIwjLDtfoYkKzz1FN8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64QQw08-4W__IHIAl4OsiUjZt6wL91wRbdzul2E4myOQ&oe=6A1B099D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeM0LXrSjaIQ7kNvwE57cGw&_nc_oc=AdqKA3hghuDBnogUEDkZNF7IPrP43O9UFmLePSyY-vDsScb2Mpwwj2W-fysfN428bpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJluqIU-6AlZAItW3tooKjIQM9bMTN3bvcjYCzof7DyzA&oe=6A9EC485"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIiErM9ZnDEQ7kNvwFKwaUK&_nc_oc=AdqL_k8YxMJgWOefMkiE2CoJgLHDAdr2nRngQ4iy5xAQE79t_7CYFtJRYJijNTku_GY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-0YdVGrkzODNuiZxNMdXFq-CQWeppz61vg8uN1x1yuA&oe=6A9EE0D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJkwi7JxvggQ7kNvwF3Gydu&_nc_oc=Adrqqd2iEgUHFVlsL_8XDA-9Mc_U_WPFDvsIbEDOgBGEgTeB15i6xTufygmn7dDmgDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3P-cFcTgBGOhif5T57UHr7f4UzF3Isw27Z2aTlsnjcQ&oe=6A9EDB31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eiLJ2pcIMsQ7kNvwGUiZ4N&_nc_oc=AdoSElar0gCpFjK3YSK2HYdEue9rwFKwNbM06dUz2qYfLo_F6sfTX0_iZbHcHOxdkwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi-pVcL3hAZdCnqPhymXFlehdLQEy1mLPcl4fgnMFAAg&oe=6A9ECB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avMnHlzqt6QQ7kNvwECegyo&_nc_oc=AdpjDM59kxdE-udJ6WT6-CwkS94VC2iKF034n8qhlqlQ7lgGrpfp-ag-J0WddQTrdFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsOe-cR_u4MIes3i55_oOvAf9cAtfJ8TbUB8FcAMxeSw&oe=6A9EDF9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
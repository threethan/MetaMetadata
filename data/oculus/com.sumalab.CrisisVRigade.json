78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNUT2Bf0ZykQ7kNvwFqdMCF&_nc_oc=AdkdWJzok0x968Jgf9QxtV9MKokhYdbhW2JSUJJK3-TCJ8GaxNSriB8a0XXKpqKvB7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpv5tgTTJUszzJTheEdMtTeo0Yg6l7JR9qiPR_3OXZFQ&oe=69AED385"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTU0xoYSx48Q7kNvwEnkq_6&_nc_oc=Adk_-ArwKX4Wn3sIQa6T1GZwnol3MSanbEGPxOPsmZVinypx4Cn2z0CCVz4WLdTAtIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN_Z_Ov1vIcZd6IL3qv0dPHF_WxSwBBh6FoZD_f_iQYw&oe=69AEB796"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV_9Za07vJkQ7kNvwF7fcmu&_nc_oc=Adm6djp2z_P_QPsWmMpIdpsYSNtYQkkjCYiywKN0QAdt5HcCUxGD0WNP-Hs8W_VwDqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8BC6H0P7yxsM6ZIn1Tj4eq2-9DgLvTBimF2pM3Gi2ow&oe=69AEB1F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezQUbUNyfD8Q7kNvwHtmxc2&_nc_oc=AdnVky01er61o5Zyt2_eNUhKuISCJQd47QIjbjV4RzgdVtNYEfamAnZoumdg8pqm34U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxDtu43uMqhSBxzVV4p2toGaB-T0SwRHllBTqz9YTQsA&oe=69AEDA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2XJ5qNooKkQ7kNvwE7yYWz&_nc_oc=Adm0PdmdYjGGJw82wh8DQEwLJD7JnXE-6EyuTNR0Z7lf5l3smuQ-Qbt2oTAx0PWh1J0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcCLs2sk0f8vIazDcF7Pca6qNfAjjgxTwo7LSM8SaUwA&oe=69AEB65D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
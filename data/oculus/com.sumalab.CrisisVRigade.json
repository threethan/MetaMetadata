.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeM0LXrSjaIQ7kNvwHQ3dDG&_nc_oc=AdrPUJRZ8lE0_5shDAxANrZEPbjspS3FRt4ShUh6Rg5nZB4pstOZYJURv-jokV5ZTE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa4Z4hBwhxNzmGLjWAoyI8GHp-lbwAas6odeP-HJnbwA&oe=6A9C2185"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrWuKYq1IOkQ7kNvwGh82io&_nc_oc=AdoGZLAWl_adha5vCwRLcbnGaJYbXPAsfB5R78d8Ufck8UPYgWaYJHhjGb4eE90H9jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlDhezKfcrSyALgZQnVd-5XwksiRGf9blShpXxvcPLcA&oe=6A9C3DD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJkwi7JxvggQ7kNvwHd2Nyj&_nc_oc=AdrdmJeXg_T9xCk7_L9imEzcZL6S5ZHiblpkibpzUVgGiMuALm0RH4rpki2z1cuCHQg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRfqE2fga2fiw7wN6UcfqoLNpaSoTlpEgoBOOswcI2Lw&oe=6A9C3831"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_h1a2QZHM4Q7kNvwEqmUYK&_nc_oc=AdrW9eC8EpoXyfyHlKVNfw05ba0C_vpvxwvlI931ZQyCbpg5UGcCKfAHJ-YAPYy7lO0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8BV43T6Xj-UqS_h0bqQclJoj1HGdjWXc5KTzavOsZpA&oe=6A9C2884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avMnHlzqt6QQ7kNvwEg4zJI&_nc_oc=AdqeoQECd7ADFfoaQuikSwG9ZQorROfhdzOmzM5eDGw-n3_TcJBr6fy0rWskgBeWtKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo0oqJC3Tr4u79O4EXVsRq-c2u3hBnHQu3fgZjo0ZD8Q&oe=6A9C3C9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
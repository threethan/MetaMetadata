wEueiee&_nc_oc=AdrTYwtXTv0a3urN4DbXhd3UZdr5jzJUsNnCKbkNmOmC9yydh7AqF-pcweQ6ukYgE8I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZN8-XJdR2wPYO_RzDaqLyChh9VCMLciFMeRO7IZZyaA&oe=6A22D785"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2YZEHzoWrUQ7kNvwFqLM_e&_nc_oc=AdqkX2gFVdRob_45QWQK6KMXub7xzoZWVdZlPPSJxlNLRI_3TqQco-l8uACMDbUtY6I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J-dfabY3uk3wu0Hi4PsNEfokK7YcaaH-wQF6Gwi4aCQ&oe=6A22F3D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8y4zQWoO0UQ7kNvwHKlnuC&_nc_oc=AdqPlrBOA2tjH0u_M5fPCLPF3cBrnHW35lYv1dngfY579Z5kKCLjJVG1wpLque2Xdgo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9stDjSyNlds4ZehAzoj19xCQQXkivrh3ykqKjFqoITxQ&oe=6A22EE31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0laE92-mB6gQ7kNvwE2W5Ko&_nc_oc=AdoEWNEmrm7Uz3hs5ggArTeqFUF0uBkEGcxk_o2OFsy7H3WzcNstKL45U_Z5s_ymdAg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pYCz3hK1qM3Pu3cnX3-xPIwYUGh16Gy4wgxOdIFeL1A&oe=6A22DE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD-nhEGvtEUQ7kNvwH9Rlz9&_nc_oc=AdppXazbbcHJYA8xOjcBVQnL_ZFuE1tPD5Qeh87UI6T_7-6mDJekEmV3Gl9_L693HCM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ToyWUFfL6IFRVxMWH_ZyOc21AcAeVx3KH-cYpAOyrfQ&oe=6A22F29D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_a
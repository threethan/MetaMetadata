j&_nc_oc=AdrzUyhhP5a-glgsP4hFEPkVZLXBkGESbes0SbmwcxYmU4MkM_bKhqyFsWO0jvV8ZXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QMQbZ1JgORauXO2WWp-qzA7KIZkEH1AZo8xlZGXtKnw&oe=6A3BE405"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iffYNhiWBrYQ7kNvwElhj8O&_nc_oc=AdpbiMUXsRS8hEEeDmsahJxl-MVRME-npWBfCcc3woDxIDm2al1P7frdcAz1KXx6ri0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83WgpMZl9EBRyjRLvgRXk1XgG9EJgOdPl228tt-n7RlQ&oe=6A3C0056"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBWav3GQYiMQ7kNvwF7pWle&_nc_oc=Adoyp-2t_UgnNg85lSuObXYlclTrWGv0PTPtStY2d8Ve0TRyKRuSeY27O_tFSR7Kyr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3mweX2-IW9OfCPzWc_ILGyZ9UPIAkg8gX9vISqnKTCA&oe=6A3BFAB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtvm80gWiEQ7kNvwGGp8C5&_nc_oc=AdpsoYcMhJtOGrmW5AJn_b2BoUKQnvYEu2YTEtfkZyOywfz6Hoo5s7GfXnNTj_L9EjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3DAiVRMT8u5rUqZXtVan0aHbrit9aQpvysnCdTy-Y_w&oe=6A3BEB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmZGQ4dv6NIQ7kNvwG3LlAd&_nc_oc=AdoGqEJ83R9TauTpFyR0UcjWxkUBcyqXy8QBWKEzB5MmYuZ8NqxLynG_gDjOxJxPguA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hgxLC9KlMjNlygeDjjNi0P21waQV__ID3xejgM4CAUQ&oe=6A3BFF1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
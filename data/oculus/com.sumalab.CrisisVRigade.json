.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bugg5S8WmkEQ7kNvwHXgK-E&_nc_oc=AdpBxTB3KKd65edNNSikD6pPSDJEhU3rPMLCnuIetGICuA1QTd83REghnxZxtO4yIpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8Ki4MTNS7N4bn75EJnfSjVtm89EfGfLYUM-rPKMnrcw&oe=69D11A85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKk6WSKlFtkQ7kNvwFBId_l&_nc_oc=Adp_ZUPO931UF7Xykuv52iioPH5PbXV84osfjbiSzyTzDeIflm3RecG75cvjQqRrrW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0tgNr_Qx185n4G569DBp1sGo6YbxvlSj3shuQ-UvcmQ&oe=69D0FE96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvSiv2a6KSIQ7kNvwETlKeA&_nc_oc=AdqCemVl2mf_UjVMrChoxvjJJ9wP0OQ9_DebEOyzXmEIBp0xI_bqbj4oIVzZlibw0UE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLB9FgvLIfcZo-7pbT1tsqLKffF2lbq1CSKCZ-7YBOsg&oe=69D0F8F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-cQ5z1fAvYQ7kNvwGss_lJ&_nc_oc=AdrE5ax_se89PPkzRTjGeHxh5yuf5T5Xr31IyTkMb2xyEbMUyjar8xpOEZCBIVOgVsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaUZt-MkL0neW2uXEGmHmZ7VOq6M7KkkeaubB8CNzniA&oe=69D12184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xH6So4vfGJAQ7kNvwG6uxTR&_nc_oc=AdrXh3o2trIGsXiZEuu3V_2--U3IbjiFFAH6wE0JmfppaNNP7MEJMaU1YVMi80u1dZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUoRwPJAP_jTKDCdMpXk0hiyQwGbcmnZFGh3jfppZX0A&oe=69D0FD5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
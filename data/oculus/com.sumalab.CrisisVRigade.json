x&_nc_oc=Adq8p2HuZZ6fBqsvtxZb_R3NeQiYRYoA_UnQsHIaQon1DnTVHMe6CiDaUM-p8k3y81Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MKhFx3mKwLdKAAzuTQ6z0855rlMdq8i9RQJIp2NO83g&oe=6A203485"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve-BDHmHPA0Q7kNvwF2u_db&_nc_oc=Ado17LUENiAuA-JbYFF_ibd_4g7_fA3nAWG8lREDKKvwNynD_wTdvxtYy3YldaXRmZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Kz_-PjPYsRPu1WLoPA3mZVCSikZ3rOzTngTEonn1UA&oe=6A201896"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC8Erj_-CjIQ7kNvwFXCPXy&_nc_oc=Adrug_6JIsxnBlI-rFamqX53bgPYykB7bncsjWm3SpqoLVPbcOJt6MltDoKnHrwW2EY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xyqw7qat5AVqy6LY-O6DV4uv9Bqf-vcNpe3yp9EDYDA&oe=6A204B31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0laE92-mB6gQ7kNvwHFzk9T&_nc_oc=AdqQe355EZJittTWBSkF7tQWlPzPFbqHbm-68l3fbD32ep4w0-hPaOj_x2GLU2UggOQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Sd_r8opotLCdNcgTNzDcA2TIVJKxmiTu8_e7Gv6bFtw&oe=6A203B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvgPlNwmlOgQ7kNvwHgXd65&_nc_oc=AdrBmkvMOusMfdQI6M358ZWXV5jdE9pDj7wzQLUwS3DhvexeHM9tV1K_7sM7toXq_Nk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v9VHncRPWqFO9wNJRsfcTWYIcxWjsb45RL1FKYrdN6A&oe=6A20175D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
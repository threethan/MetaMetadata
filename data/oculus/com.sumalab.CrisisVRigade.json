G&_nc_oc=AdpbzG5pOatSJlxnlxwbRGDphAZvepv8yH1FOOk4vrqAu2P9-qvGkKb6vc64OtWIEjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RaLaSEnmoAcYo7QoQTWtdj2jP--YEuzV5pbrlCj8_VA&oe=6A1D9185"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONiluvj9JoIQ7kNvwF_XHM2&_nc_oc=AdrFlHX0sjWOaUj6Cq2EgladOW1eNPlqzpenDVm5Lj7-ZOjMmrKf8jRlHTtk3MzBDr4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lE241Hbamf6s70mOgMf0sCOvN9fXy0s0i_pKcxjY00w&oe=6A1DADD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC8Erj_-CjIQ7kNvwFTqHM7&_nc_oc=Adr0DZEZ91Vi5AdwnDE7ZOL3jg7Eo6k-euh_r3NhBeGBORaY2Vkxno-yzsevBouAJRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U6C9zmUYXVaEy1W9d5yQ5tEEHKbKKJ8iuKmM7sZVoTA&oe=6A1DA831"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deZDl6BOzLgQ7kNvwHNrbeA&_nc_oc=AdqN0L94_m5M1639VTfvOVRrz-9IIO5nfzf86nBbQH8DJvJ0cF8qRJ6noHqy28bFaiY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POi66F_zJDd-bh5nGSASLqFg7UXkpwxXTUAn3oThJ7Q&oe=6A1D9884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvgPlNwmlOgQ7kNvwGHpnrE&_nc_oc=AdrYetVe4g7tWCIjOTXwbJkeY6jDJFD8-jxjOK-ehaA8KjmAFRUtFof3jT8xx65jBTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52rgOvVSKsRynnJcyCf4qaVRi87tL_z2KxntB98C5u_Q&oe=6A1DAC9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
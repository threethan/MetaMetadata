.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I-Tr9M7MJ0Q7kNvwHwKwAX&_nc_oc=AdoeG1v2aFsaIebabJAs5Ohqgs1SgmUYtKM_Avg1k3-A1o_mGLHq3Yfkrp3qpikXDRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfXabLnY5BhQ23FT9zpgfbfa6YjnCSAj-bWgRpav5CIA&oe=6A50FC05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5abeChJDykQ7kNvwGaMlln&_nc_oc=Adp2LXQg92QfczKxocmsdqrKOzS9U_seNuIjiRXPHbRKN14uyrb5KZPtCzqf1tk3tog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6WpgDPdPN7wojVFaYc_0mHCax66IY8T_JHra2L9n2kQ&oe=6A50E016"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaim0DzkGEQ7kNvwFVdlX4&_nc_oc=AdqFKo1Cl3LMFpy9vVJFXTyfISNrgHi6L0ewKYh_5PV3kxNYwuFwd_FEKCRhwiCYVIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy5q-5d8z20JtFImmBUCw09pKIr8s0k0cqsgjaDwe1vQ&oe=6A5112B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl7nO2qt_wwQ7kNvwE9umH8&_nc_oc=AdohiXcLY3Ay5ztTx1YwYRf6OyvLn5Al4BTKJY6UAeEFvKZF-cLjlC8YR1EMwEdrHFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGTg8ttsOEi4Mghho0Sg6dhibVIBKuDVoUkcrouRFNHg&oe=6A510304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHzOncq8HgQ7kNvwEENsO3&_nc_oc=Ado6cE7iOQGZhO2wmf_4jnBN67DRYcWMjcvTh0sk_-j_TStNNuHZC0Ag_D0pnxN4wow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZdPoCoz78OP5JI6myd9D7fJSwKnz3Ak8_hjnnVsn_SA&oe=6A51171D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
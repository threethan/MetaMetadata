.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y89yFDLX6qoQ7kNvwHM7ekI&_nc_oc=AdqRX_LU_Ah5RzOpWWwqvonPKKYUQlFUbCREwwzDdAcS54T0_vCyKTUCAUNOMk9LNCM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiT1rSaHTidU2OYdefjZXiAMX5LoYe1B3pMRVfyxW8Kw&oe=6A661405"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cev9m7TxFxIQ7kNvwHpF92I&_nc_oc=AdphUds3f52vfdlvHZ3zRH1DZfO6pMB6QK1HuJlhLHvzCLUTLVw9bjbeQNNmXyGwbLU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyFObS6panQVdRRW79ak2J8eomKqf4f3sCBSzlaNRwrA&oe=6A65F816"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ge9KcisqdwQ7kNvwGjZAzd&_nc_oc=Adq0Vi8YcHgUuiiBqCMAu3Ze5ODRV1kGYzvRJTP65SSEgsT0ikQ0fItNzCznjHVynHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVnzfzy6OdbPoMd8zuOZ3WSrUsBjCHsxvi2POnrak2dQ&oe=6A65F271"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfoWnGhVU-IQ7kNvwE1elYg&_nc_oc=AdrBWI6dEwXSGBS11ye0SaArMrMkkSLiY2WkPfNW_Ttb0wyYARE5aobdTKO712uKTH0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlDUlf1daN74GS38adwkn9oYM2cjFx1FLOZfSgFD4QaA&oe=6A661B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-cn5GGU5EEQ7kNvwHEqCmk&_nc_oc=Adqgk6DbSKF48FIbog5yq7Q3z9ca1vp3yVNtdISBgtwIWTvGjlomRUInOTX0J-LaLkY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGanQ708UiTe8IiimMSNhWhHMCUCwc5Nk_FKLBye8tHA&oe=6A65F6DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
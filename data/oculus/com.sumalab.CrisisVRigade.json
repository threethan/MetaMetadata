.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYiInEqWYSwQ7kNvwFv-baS&_nc_oc=AdpSvCeXVA3jNQ8c1Po4jqhs6XJHhg5q4NFH6aNlY63vMacmAwWA1EskRIDw-F_Gig8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRcTiBweMsNNeXLbQyfacBc5AvkOX2mlyj4mmWVVIuTg&oe=6A54F085"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xsUkgXjq0MQ7kNvwFGv5dP&_nc_oc=AdoL4DS-Z-rO6ejJA_957WDpwh7BhXBwMzkZ__a4xEyCvzWMqBqa-0cdDWYAQqCbKi4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwtz4qjtg7xqlg1b4fQVwcoC49NUigvE1aAS3nG5k_EQ&oe=6A54D496"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfhc_25XBo8Q7kNvwHtvZnA&_nc_oc=Adq-v3xKfLaweonsdYwHSEPOTAxdwbGLtTyTYU_ArTisseVz6k4Ud7bowIMa8eHMBBs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyc61HxGaZ_b57abaS8Fi1mywX1DHKLOO_OqsZJanzlQ&oe=6A550731"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM5b6evxq-8Q7kNvwECmMO6&_nc_oc=Adqjz2dS30jXeg39_94XaTQG0gnZPgQ0CTlKIZLnZu5luyWvd1E5Tfz4-0aTiLUtgRE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7-4kR91NIOdvV7AVw1UCz2G5ZSiik92mzc0mfD4ersA&oe=6A54F784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isx-DVpofMQQ7kNvwEyRR-3&_nc_oc=Ado49LkjBxdrXXhjpjNUagWnHcCou4TjSZuvoX6oGS8VJkf_oucZryLPpGi4aKzX5ag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASCVkEIY8cJ5M7SMVLqWlDbDqpfIjcQfHRpnxATXzv5g&oe=6A54D35D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
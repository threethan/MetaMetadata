0lxU0q3q_7ZcMnUKMZLeB_AjRIji88Ew&oe=69F0BE85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK2UVJuJhaIQ7kNvwHuCJ87&_nc_oc=Adpzo5RS1LGloyKLxZ4YOCBih_9QmHT_cPXWqK_2aS13yp1tqWYZ3ZWSYAWeVaWGad8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0D45dz54GPY9R0Xnx3K6oSSYR0ljWSEinQgv7petTdSg&oe=69F0A296"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coWFIiwLGCsQ7kNvwGXPqS5&_nc_oc=AdpX9T4EVa4GTL73JoZt0EefH9qK_JCg97TpzeiR4eKqbd5AvMEmdjN_W29JjVkmfSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1zQIH8N3Ws3dYDtKro6tzFT_fXEhYqhvWhW0g-p9Actw&oe=69F09CF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaMAzrHnTJ8Q7kNvwHFZ_lD&_nc_oc=AdrflPdFWOFgF4fXDqA28r286esHyL1X9TmKS9huI5ojqZcJzEnmr5pZ-1lHffRlV7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af38OJ5Gsk6P19ElUClD-fRN1w2BE5KqbfFI0CrwEpHlBQ&oe=69F0C584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXF3nE5fwQYQ7kNvwHqcmfK&_nc_oc=AdpzfO_7F4dCuXMm-_oPAxoDQZeL5tN8cCGENCkbuihLV1hOwLuqlWi40zXKG_9bNXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af03rDt_pSrNYcQFy2vbOEEymmwyCNJ-pXMj7ZeRXE0b-g&oe=69F0A15D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"],
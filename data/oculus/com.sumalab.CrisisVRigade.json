r&_nc_oc=AdprJj5iscldZWcLfBRw6O0amwPP_a9_DkJu2fdcomr_YgdDBIb2iKd06xcVAiHOepA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V23BnNcz_oT3m2YM-Icy4Id6x_Dvc5sn5FZZ0R8i0_w&oe=6A2AC085"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t86NwKYOKG8Q7kNvwFVhFPU&_nc_oc=AdqNCSRka7F7XSQEyfbHZrLp1PlEVxfN8DlsJr6lcsHya7Dgm08Kpdhni0C1aw9d9iY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81UI6ron--9UKDlmpMUr10Bt6-8UWEV-m4h2-z7vgwlg&oe=6A2ADCD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCCNU4RzfLwQ7kNvwFKd9Ie&_nc_oc=AdpBmyZkEfQhH1tz3ayzXhDBj_D7alkE5rpEmDSjTTSq6F7Py8J_jusfACy2vE-xp44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nOAhvPlvI51wYoY_Tetl44PL1t8-p5VsAcWu6nHDLrA&oe=6A2AD731"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feH-ukCKu1oQ7kNvwEL84ex&_nc_oc=AdqV3b1KRw38Psoodc5IDSzbufEs0wGO87McxbJtWZNbtRef10QE6fVPkeMmJOrTVjY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MHmyx-DXIkCtOVq8bqHoZZuuGHHBBiz5HFL8Rp0qIzg&oe=6A2AC784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zxu74zHDgQ7kNvwEdtgWZ&_nc_oc=AdqKFnZGgM2v_Qh8PTrgX91s9zrr2_HtLO-97Fxed80rXen0pH_EEeY7TYVwkkjKESY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GVK9fqm2fy586sIQNwTkg3DRX1uVPywG7jxtbdc4G4Q&oe=6A2ADB9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
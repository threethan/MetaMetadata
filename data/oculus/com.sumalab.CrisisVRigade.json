c&_nc_oc=AdqIg2xDUtSGeY8XJND8XUTEt492yJuUscY_t5v7sKjOhR36mSGBtVIdl9NrmHsP6c4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v4RT1Pf0BHMW5dkriyIH21btNquwryb-IboOKWjxVkQ&oe=69DE4985"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMgey078lKcQ7kNvwEd5C3Z&_nc_oc=AdoxRG9kwicriKlADzwKJAF6pT3SUqTLAJI0gYSkUOZoqQwArTYycrMQzCVIySX1Vfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af200PsU1sf2HJ_VUOxonp-_2B04j7MsGjT96pfBxkze8w&oe=69DE2D96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foe70ofo17oQ7kNvwHMxHwD&_nc_oc=AdoXNKeGEUj4TUItQutqpDDoxHbOF-yex7Ft1UCGbiwPFANP1J6rkIbSM9x0UZrg36U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FwO820Ax3SbWHy2RtQ-gN9cVg-YBuwwP6YXfUa_jbjA&oe=69DE27F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzxLi6xqMBsQ7kNvwEZ9QOX&_nc_oc=AdodrL8_HDeJdQs4OhvgJfQBNIm8NjhuHWWQffhNe2jxY6IzkLQ87e1xtCszH8imm4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VCjg75cv-kgofSCsGnpVZnaEre6GQ5q-1_awYAMN-7A&oe=69DE5084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUgfM6w192EQ7kNvwFmvsw-&_nc_oc=Adr7mVwjHqLIO5gx0cHhrIY2KAwFW4logk6isP_KBcybxmWQvV4MCp6l189cb1DVCGA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IRN_HB0J-YMIEcfPL5eQqn3sPr2xlZkO21yWBZlzg3Q&oe=69DE2C5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
q&_nc_oc=AdqQv5zCJ2v6LTdpXABFcQJIj-O5eXN8XRc8-CBNRSRcJohcYtU8WKpV5EgSX7vBkHU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j5nk2jHOovwS7088mBA9No5Wf4efATRpA_zF-fArzwg&oe=6A33FB05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9cUomoaHeUQ7kNvwECInOe&_nc_oc=AdpyKXPb0LFnRJZYsNodMjYgXUYWfbXxsREaVBVHl9KPR5U8OPn9IV-t2eZD2ZZCUXU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5Wvr60O8vvvISU-pRF1Bnh3Ql8JYyOyzkRU7ZvhKfxQ&oe=6A341756"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd0WGAi5A3cQ7kNvwFAR9Bq&_nc_oc=AdqsRykLUteXK_MiSWBhCLWMWN9zazifEK4FjaTmyUL6U63_rHZcFEqeyaEqwMN-L_o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MsjAfuzM5DO5zo_fwxr81cqVm1KgNGlvF-8Nr1Z45Lg&oe=6A3411B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzPJ9RLGcKUQ7kNvwFEu-o2&_nc_oc=AdrWbwXBwVCiCZ1rZTbKeN5xi5GBnpRwdY7Y3hOMlC63fRn_2LKO_Ehz7cEBPIoWWZI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gSprpYc9myFX8NEBlzyMcDRuAymm4K5McCX8fefrOYg&oe=6A340204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVdZx2wO7oQ7kNvwHoUhI2&_nc_oc=AdqZm01-OaSYAi-6AMffYmsTQLU_SfPEo8Ab00pstOJZP2Ckfgpcp-Gh5SnBiIG5z80&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TZVARTwe87AC7u7U1rPn9KOw8aB9dDr6Lvuzju88NiQ&oe=6A34161D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
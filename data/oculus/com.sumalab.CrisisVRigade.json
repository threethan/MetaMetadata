E&_nc_oc=Ado6Ja9MGxgQ8e6TzCoYdFCr-TjqjC3V__Z5_uOwYNJatVozJgZCu3OnTij1qviYSm0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T6t3e7omPSh9nbEyri30oGX1jjHlAKkaTnquAVEj7nA&oe=6A32A985"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9cUomoaHeUQ7kNvwGQCfp-&_nc_oc=Adootx3Ujs7PwpLVDW8KCPVlYMPXQ2S2qQy6Q--oQjnfndzfCaHylgm-3AvEgip7l7w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6hNFT7gsAqyGx2pkpkKvlh9_2oIEOvjD5Nlj0TCV97g&oe=6A32C5D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd0WGAi5A3cQ7kNvwHXVt3P&_nc_oc=Adp82cJoOo3JZTfT8O6yD-73vt_kPMjuwDe4xx6htrnGxD_WHIEVCdyR5NfMZ9Bh1aE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OHKJ_1asn8X5Z2W_Rz7HIwPVnULkT8MzSAPzSqxdVFg&oe=6A32C031"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea1AebMKNfAQ7kNvwEM-K0k&_nc_oc=AdoxZykk3vObdd5NDMIxNKd_-EwGvGpUxDfXlZnHAxgwajUFrSB8DOz_c8J2rDNbkjs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eYELWnkWIjE98_YFEA3YI_-Q17iv57AwJeDGCX8V55g&oe=6A32B084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlVdZx2wO7oQ7kNvwHC0P_6&_nc_oc=Adrlo6I3T96r_qWZ5_dOjDO6lvttepq14s90Nado822oMx8AhWh21vYV6thR0Jdethk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V5DLHKLfIEaBVW6bJ1EqY_REx0zzZJPXztiFz7I1AVw&oe=6A32C49D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
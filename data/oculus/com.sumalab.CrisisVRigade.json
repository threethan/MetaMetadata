.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STBL3mCTbEUQ7kNvwGlMQub&_nc_oc=AdoVq8_lGrT-wOKeuVRfPomBsMqM2XFecRCFy8t2264AwKfX5v4ZH3Yqx_cHr1pg9qI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRtaITG0Y4wZ3ySx6JGBcLdetPyFDa0-2Y47B89GyKCg&oe=6A6A0885"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3c3bCPp6VkQ7kNvwGHjaXT&_nc_oc=AdowpAhIgdls9YhQPg21mtFQoLOIrfY4FidLn8F3AD02WRn5-pLecS1e4BdMSBIBxmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAev9nHj8Ddm9TPPxGdrRRA64C8QzfgndJb2JpCUO7HoQ&oe=6A69EC96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMNNTaozk7YQ7kNvwGRbFvf&_nc_oc=AdprTMMu5x-OcZK9MPm1h9Bq8McKfPO3LCS_cPiZ-o5CHBVHaWyQOtfDh3QEemxsXE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARH0mqRCaEzpl_-ICqho2xwk9GxllYQokhyq9nz0nQbA&oe=6A69E6F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MyuQiLXO8EQ7kNvwFixnLr&_nc_oc=AdpNtSn9DOMwSJGfLMJSIOz0yk_acADox7eKyFN4ixIKZBl3KSImsg5OfdCVWoVRqlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvC_304SfXlqKjuZce150GL00BXGOyvJ_HyIOd984q0Q&oe=6A6A0F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTUUMtUHIwoQ7kNvwGryk9M&_nc_oc=AdrVGEnNDIEQhkgzyIKdhWy1VzpOc3A1YdGAaEBuP-SYGA2BROkShVy_Vnbs3r0EsnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ddxgkWM8FMwkuYHRoxFG_rjjGOECsUQPyNg-w3BX-A&oe=6A69EB5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
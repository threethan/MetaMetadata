R&_nc_oc=AdrjOp61NHfNBLAf6A8cp43iJQYmTePhrfn9Z6wPIQTRsxW_beXI_GMbqUdOgpjYKfQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iiu_q94z7vmc9X5gujEWiZy0gtOa1fE2Yn_UDuLtFNQ&oe=6A2EB505"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXrhgffJlfgQ7kNvwGkTVRJ&_nc_oc=AdqxMMQGcP9CCmUUKhhDOfaIvdcDxKXOml-c4FchtJND-TNQce6shm_pLa7vcNiBeHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sfaf0P4obyohQPFLh4w_j0BBnHOW7lxFp0ATti8dqfQ&oe=6A2ED156"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdi9LiCki_sQ7kNvwFiwlXF&_nc_oc=AdpBgEEbYc-G060Yk4rFbEHMbGsgUe4dQkkDxCfn64dU9HWlfwlMBVBj1FSnfAKLDaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XVABDYmsB2mk-xK7fTj96z_EsijReUl6J4Y5__PtBEg&oe=6A2ECBB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6X2F6cecy4Q7kNvwFmyhXL&_nc_oc=Adq8clQjflNrOyvafMcK4jZ03gktCQtVTsrW_Pw5dwsOeRVPrKE8_975Nu81Pw-1EHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NqUFxC6GuAn_V2brCRqOGhWkZjWNL_LF0Z9pR_CGP0Q&oe=6A2EBC04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSxCVkRZskEQ7kNvwEwqzb0&_nc_oc=AdraiBLccmpO8RwasG27vh4gc7Yw7fhJTXy4KGg1XWioRx6cUl4JYZQJkHEWweFF8wI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kq3JUHXv3YmJDy12n9WS9HRPGw8FqXdtV4gEmMKPMIA&oe=6A2ED01D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
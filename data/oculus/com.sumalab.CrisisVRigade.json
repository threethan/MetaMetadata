78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn3dkyn_we0Q7kNvwFjSBpW&_nc_oc=Adk0uk4hzoYAsSmWmxebZtXy7jwi0KDUikV1X66OzkQ_zrQ5Q2-br_7aFPoyF84GWzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTCsKmjWgcZ7cP6x0gegZpJkhFNEDVPy_VftwsNFM3-Q&oe=69AC3085"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTU0xoYSx48Q7kNvwG7h5gk&_nc_oc=AdnxWgxAI3_LF97-n4NBL_YTONl-E1N4SAZ-wM76h7ZnXivhT9ai5DbsTCpTQ7UqCY4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJU2c8L8IGQ7PopiI6k7tFEo8r3O__S5WwBVJV6j2ycA&oe=69AC1496"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6KA0ShzzAcQ7kNvwE17q_X&_nc_oc=AdmkJzlmkUQHa8kpwte5SPurvThQ3HtJQTffmahsrAs1rbR12KVWLL-z1PE2sAW2Mjk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyByODuD_0tWm6gu5Qdt35zuOFlnmolURmcooDzCG8w_w&oe=69AC0EF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2wcmnEtsJwQ7kNvwF_LPix&_nc_oc=AdldLSg1_dw3wyWN4hz4tR5dxr2sZd_HruIhaV_vueWy4-23-97-VC_v8cCTXDT2G2o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyulsO0EI8WlgVdf2bNscRqtHUdX_mr-XKUoQpd0DJtlg&oe=69AC3784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pANRYxocxtEQ7kNvwEVc48u&_nc_oc=Adk881q-R9vHm6qOpqEwmqaPsGp34IwOs2BbqUqQXmlaC_PMyjKIcaVHJ6Ipj1K2I0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afye5WcMm0ibqzulazRsu6u-DxocQZTlVIzMXv8yqh7n8w&oe=69AC135D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
2&_nc_oc=AdrpLzc6x59NT-nzTlGqmY7e0ikh7RtgeJLA8zdeyimKWaNozEkd5hiOOaKb9-9Uk04&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UmLL849fCsJIzXxdJ35csBnb8K_t8W1gtoqD0g5lWFg&oe=6A218605"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve-BDHmHPA0Q7kNvwHJmvAw&_nc_oc=AdpqjbLoHD7Uvn0r-I7Ueaq6Ca-0qU9f3o3caWxkzgLveYqqdwKmyiRPrfBBbGgSxAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97UOjVPqcPgtIhsoyiaJvyvSmotBNLwlFr7YstaG9zxg&oe=6A21A256"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8y4zQWoO0UQ7kNvwE_YqM6&_nc_oc=AdqZfNcxe8cSkMWqOCuLqJIel6vt29TxvRidzPmmc4yVEirY7Tvj_Ocpm_VfgWlGkzM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af807mzWOj9aKlBKKG8W9fNTxDkyA9SZfwIqwaomEW_oeQ&oe=6A219CB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0laE92-mB6gQ7kNvwHVO4cU&_nc_oc=AdoQInaLfpfRWdu9jf0xy66J-q4fDWqFCQ8opZdreLF7vU9wWOuOU1eppqBdfg6srU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NDSdl0PbV0nWds1JRJoSgy8-4WvCqxr0ShajRleLzcA&oe=6A218D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD-nhEGvtEUQ7kNvwHC6Jc3&_nc_oc=Adpu7GJGpcepybi4TaH2qhv3a_-MpvEhxdzxhgDE3hVRZW_z2Kg6X6YAT82SHvXoE00&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89f9k3SkYo1htmJxPjC6q2ORl-vIERgCY6j3Zb6zqInA&oe=6A21A11D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
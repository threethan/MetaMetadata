J&_nc_oc=AdpV23YAT2W5MgL_At4VbApLMstQkOyOUzDuwfMGEDXNePcU4G51tnSXbCLAyN4EcWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wh5XGcacbjpeohj4RPQoV9PStMAGndfrSh3YCrDTysw&oe=6A0DBF85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQXcWjN2eiQQ7kNvwGjWQwp&_nc_oc=AdpbL1uH2Dj9k-2TBeZhljGElu5u3E10Yr5HCpKrXlIOHpn6OTIMBf0kAeyz6MCBXeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ht1r8fAtHFHqLavzZeC6x_JnnGSEf1EtZOoyVGmFbRQ&oe=6A0DA396"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIc69HB5oJwQ7kNvwF_1O9D&_nc_oc=AdpWzM2-wd5B3Qyw_cF_JZ6g7kA8C9ZScYCxInP8irgywl9nhJI2JwAzAQ5-g5r5QuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LgsSIpexMn9-S99ylNv_Brxke3NnKbxDRBghvQhXvVg&oe=6A0D9DF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUcLqIQqYRoQ7kNvwGU_R1U&_nc_oc=AdpqtNeUUNMkG6GFAO-RouxCyb07ZopieyyFtdKN4l_0KaXvEoHotsi-wECT7SDNVxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7H2cvEFGzdIqFrGJnt2r9dFqYe1hZ1hyS8-9I33eZvEg&oe=6A0DC684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edyDIprQsWEQ7kNvwGmY5bP&_nc_oc=Adp23hHiadXIIT8qy2HWVTcra1boH169cd5fcF8LQns5hiF_4LrxWJZ-DhBA9NmDmeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4p63GCMXRABEF-UA0EyhL8R5uyxOjqcYcNIn8hL7NxeQ&oe=6A0DA25D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
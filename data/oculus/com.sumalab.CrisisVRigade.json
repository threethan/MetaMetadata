78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlGUdGWxcukQ7kNvwGWzZv8&_nc_oc=AdpY8Iz6NDzmoDq3PQHf8an5ea5K3dAahTDfzgnWeuHyUxsgyf4jcz0oKGky1QAi5QQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxj38P7sLOHr88vZGkjGdI8gqfOm8TVZ0iP0dv0YyGswQ&oe=69C14885"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WvfQcnCItUQ7kNvwFt_3Rq&_nc_oc=Adr05HeY_P6DS07cwh4VRsgJ-XiqYAQRsgrz2IqJuoYNpLSSiHifUGy_R3LnxTU93Wc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBDp25bWjVzdhjebVO7gkdP1j9wYfjouKEoRqzIP3yXw&oe=69C12C96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1haWIgecKoQ7kNvwGRtLu-&_nc_oc=Adp6uDHNNDoWLSmEH_xBxDkEn3MJYswh8ogqzZsAbnOwyTvuCFqlIohbuLIB0KcCbAg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTEK4YJ1rUov2OlQdnhRIMOF_7je_0FOabDjAJj1U4Lg&oe=69C126F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s_OgDmFAtQQ7kNvwFuAIBi&_nc_oc=Adpo-OvFIP1JjpCXHYr5STDm9YDnpjUgCHVv9DnyYNYfwz3X0dfgEZwgrJ4xvwdletk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwT5OdWSstX70J20gT9oyKZWdF_njtRQ5OkA2mwz99mEA&oe=69C14F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaaUA4epOHgQ7kNvwGsjNTV&_nc_oc=Ado_AxNuyf3TzHy8_F91PtoR9oKLUN_sTTm3yjC7YlxEy84RQKMiFjJBLm5h1bHoLeI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzx4BOnAI4Vjmxk1GZZydNCknG0trEuzGi01hZ8mCCHAA&oe=69C12B5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-uYGBvmmPwQ7kNvwEkBW4m&_nc_oc=AdqO6JzC64HM_Uyy2HWEZzdMVEuuPuWzZBJQ3rkM0w4VrtazrmmM8A3EhAPVDSugg8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYs44yK_8R9nOn12T58dlWMqV9njYRRbO7iqEHvZ5Sw&oe=6AEC8D05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2dkSvvPtcwQ7kNvwFj5mKN&_nc_oc=Adrm1p5_KAfd69Q_6tkkOuqp62yKoxDEB2rvQ8crkKUxhBB-oKjH8R_aBZyydzPQPJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlP736lmeVH8C-pfXW12XYqRYOjbpU7k5uGUmM_2LvYg&oe=6AECA956"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GvDEQNaZSkQ7kNvwF9I2WX&_nc_oc=Adp0HrRUXo8tUOUJa6M9E8rO3RhVXB9CFWFXszhRcJ1QZhoZuFN3_KnCwrEcnkWUL0g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStcYcZwIM7gj_mV8T46NALaCoVpm-3JasfYqcd7nsXpg&oe=6AECA3B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3k5gfMR30kQ7kNvwFFwk33&_nc_oc=AdqkTjKcYo3AmUrR979W6nBh9HWMDbWOuvOSxSvS1mN6C6veLYq9Rv8dGapWn2PRJpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfPhIx3GuX-p5CE-ciaCFSaJ4nBrwJkKCdhptfRVW7vg&oe=6AEC9404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti1ZavaFRg0Q7kNvwG0EsaG&_nc_oc=AdpUWHDzbR1bDBDz_vDjkOU6JzM8xqbtbDpwS4AYZZmxu3Oa1YCB3cnN2tJ_4FSvhA0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsyAL4J4GkhVkL_0NHMzmsgG45NZLrIoKdFJUKrgYxlQ&oe=6AECA81D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "https://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
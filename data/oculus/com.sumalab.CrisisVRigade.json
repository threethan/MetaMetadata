/v/t64.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqeUhv1vJ0AQ7kNvwFEeKH5&_nc_oc=AdpnkLoKx6ZBHquXCjMpwodwWxEQZfRlEN-zb5GQy_BViDC7j1uxfZgpfoasvGjPzUM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyX236v1gbGINwMyq3eB1ZWxsSTgX4kDM0Oorhx97Cew&oe=6AAE9685"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YrY_3m67FwQ7kNvwGBDLxw&_nc_oc=AdpqObVeRFSMCso7r152vt1phsG-JSclcQ69dcIVkqrN8OUxMx0DNJAr-2aFZhw1774&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUzyEQdBMWCv0js5DgZUQGcd6tfW291SwXdTnNJ0Sj0Q&oe=6AAEB2D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIBCQR02KnQQ7kNvwHkFGpn&_nc_oc=AdpTbNV6duDjmojPufPIGHROld_D9YvoP436moh1A0Xvi7cD8DEgkX2cwMsa0zXYxz0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK2ZP1VHC3-7u3O3oRGDwYWP4FV6d9663lvOj6-hHFQw&oe=6AAEAD31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTKvWCLsrkAQ7kNvwHWAvnH&_nc_oc=Adp3LK6t984ZRqa2JTIjFwZaT9wdyIzZH5LRCABS2U2Tq3HinfHIl7zTi-TtRP72_lU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2_WmR6nu10BFycs73boW0p3UNiyIsntUpbdee8_6ogQ&oe=6AAE9D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz8VJdk-4F0Q7kNvwFTwzWI&_nc_oc=AdqtbvFQOaIdPwed3g9eTjRGTxwzlKGnFfymTbDUD-1EnatntO2dTD016G224cSONPM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMDrZGUAo-nMQLgVW1Xdj8CTy3Rpby6qU4zK_Vbhwi_w&oe=6AAEB19D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"
i&_nc_oc=Adq8kMdUQcvgnnlXDyiomcbVCNwyySocIswCfszGcpE7jjNWFI_QKr3pbBJe723LQOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NPNu4N--T1vPcCbNi5hcrjZb3nmGlxuegLvIBh30r3A&oe=69E38F85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqrs1IjV1IAQ7kNvwGd7mqB&_nc_oc=Adq1AAHnQ-iu6GjXZNC3Q_l6oq5UefbfVK4Wo310r9RkDIIaDzS6UiUyuNNoi3xw9CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y41JOP5b2Gud7jq0iyK34cBFM4Kq5UxsBi4MtY4rwrA&oe=69E37396"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC6dmP0OfmsQ7kNvwFyD1Mn&_nc_oc=Adr-hp8jfus0iLcEUHEEvuZI_z_TXOKgNavREgRcQWUcWpieK15iHIH3PuOqP9833gw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Mc0E_23AHxzeyhXk2eOLigm3TaQbnueqM7GB4IAhH9Q&oe=69E36DF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNdxMaVX9PgQ7kNvwFWtsIl&_nc_oc=AdqEJQOS1uipZq3pE3NEZ4rFdxC4rLbFhiessNqK77fNIVWLSk341gUe0uNGKt89pzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h6Pya1pewxmfOwCvuQBTO1Oo_FQ23LjwiiCtXpOr3tA&oe=69E39684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Un1MDIkvS8Q7kNvwGr8EOS&_nc_oc=AdpvgNLLt72LciJT6CtDKaORzp8H2PlJIaUTmhPGRyziD6izvhM0s2gtty6mV8W_unE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1silqHp8UgQ-ZuVikwZ6i4zECy3bSKv2JAFM2UU-M0ow&oe=69E3725D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
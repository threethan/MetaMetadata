.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPZ5S_13T_QQ7kNvwFucA_N&_nc_oc=Adp7mEK-vNCuiB6vB0Ip1n99gRoegKUIV9rtSXLJr1OQBennRud3b24f9lPjpq9H054&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm-SoG5LpU5T3HnQJA8ykqryTzMaxjMp9AxoGFcFUsXw&oe=6ACCE905"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKszllmLwH8Q7kNvwGOFXPP&_nc_oc=AdpHKE-ZMbVsD1aUsOamP2u8zebEdL3LrC6uDf36tp356afgpqyAeYd9yo2NWJZp2dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOGYlE9eHPAmxraMvrcEiyUSBMBN9arV1utGUDToU8gg&oe=6ACD0556"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hl33r580Nx0Q7kNvwHyOKe3&_nc_oc=AdpvzW0cZiEb4AbEhnNkqsuDxpxVrVpOtv_6Yyq6lV4QilqC7RDvLC_zLq7q_pdJ34o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmgD2IBfvFdvXENruNc_hP5y07ZFfSMb-C_3gJ1yJVXw&oe=6ACCFFB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWb3OOp3L8cQ7kNvwH6M0tO&_nc_oc=AdrGacXkOODRvW1pegRIElTVuAjwl1c0M3pFPYlV_pul12vI0h8ThBbfUHsramN8PTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQX4UOkjzv_wDt3ssaEC98LveppndmX1FoOZugR3PQRw&oe=6ACCF004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0ys4hg6GLcQ7kNvwFzWLir&_nc_oc=AdpxClLy0FKoY9vQuQQVuN69AaNtt_8tFmga1ugZxub5J2OpfkIJ8ecu3wjRoSb1TtI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTU3XI1DflEXXSv2vPHLI8JcYzUkBcWLgd9oADwTNcQA&oe=6ACD041D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
t=scontent-atl3-3.oculuscdn.com&oh=00_Af3i11rfyGWPSgNPZac3adVkj67WOWDYe6gu1SYJEoMg0g&oe=69F21005"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK2UVJuJhaIQ7kNvwGy97KG&_nc_oc=AdqRYociJ-L9FjeszQdafinBGCio6TqX_TNA7FcElEzRo-JFLog2hsnyN8cph9b4Nt0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nV1kdKgO0TnOQJZPCw1A6glPgblzZkpUggkWzpkiwgg&oe=69F1F416"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeD2LF3BNGYQ7kNvwE7fqAh&_nc_oc=AdpUT7Q73IR2R_fQOFCuiFktHyMc7WwerQBUcI0H2zBpFl1U4PBeVpCqExbzcBEs_6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WJyVRZlaFRG1bO0B--w6rTFZ3lSiCqzOxdK5L3x2ajA&oe=69F1EE71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaMAzrHnTJ8Q7kNvwHDvIuI&_nc_oc=AdrH61SI6hrFPIeb9jdd6oH7OcY_vVlaallwryBlbta4ArDfUEKvFZqK5NyrXJMeQdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HkKwMLabhrwXV-XIe3ekIDLkVE8at-ZLMtMh_Yg-Ytg&oe=69F21704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORRfZvHpeEwQ7kNvwEtz0pP&_nc_oc=AdpJeGlgMMmQ_alfYw98xKNBlrFI66N5VyVCEpbfej1gXgbadcMf5nYlmyENJvUvuSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2VLUwNrIm3nUTasal7B2tIjYM37jOblI--BeGQqVpJlg&oe=69F1F2DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_m
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFBHSWG9JP8Q7kNvwGG6Msr&_nc_oc=Adqkl_DpK6PpYFCZ15JPOMn6HZGpa98ojtkk82I33MoOR6mow3zFZ9p9QP9gAPnZnhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCP04Gy5EB9RGbrCwq06ZcTtbXHCgaFptuaWnnMspEfkQ&oe=6A60CE05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-otIgecCRcQ7kNvwF3YTCb&_nc_oc=AdqRjNEzus38L0AtYQsgK0DEpSFJs-ScMLX86awQqrfMlM83_4WK4rZXkcTGfj-EYF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAggdWnvoMeWhVHNj8UY8bemvXvz09q7ZDJBblE0avzJw&oe=6A60B216"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkSMTnt0FQsQ7kNvwHnxUkv&_nc_oc=Adp9pYBD2oXNb6PPBMbLK8eITY5yKs_Vi_7nRx7MxGxa7chmYrAIqaxNX53pu2qN3po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmi_PcyY3tuVRL2XPG1j05EeS8IuPB0aEzN3gxgN7cEg&oe=6A60AC71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glqPsZ9tUkkQ7kNvwG4pCl3&_nc_oc=AdoXPgAsEX6qS2CDDNfMR8ngdljKxBQx9OY8pHQEjvwBroaGZxv8TMK6DgvnN_3bnG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUK72F5h4Sqjtj_s7i458e7aHa_o5-UwkFSNlr2sG6DQ&oe=6A60D504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRxlgEOfVAoQ7kNvwHwQzsI&_nc_oc=AdoqUbcoCn0KdPzM1hPJ-TtNiBFub-uLwswiQ9y2u19yrqDH0Wqmr1VUiYZBEUCrmWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Hc5TWDHQ4Zuolpsg7Qc6nH1Wfqr64LcIDnEmctSxug&oe=6A60B0DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
wH6VNer&_nc_oc=AdrsJ_BuLRo6xKWualpXlBjB5AxBGpuIhuUWkf3QAe-PywQWghiReJWX35-G0t8HgcQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TU-Z4gbsR-__pkVLTtfzhBObrGUlrRmjpf1TIi8I_Lw&oe=6A11B405"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xirJo5vCXEcQ7kNvwFyX-Dh&_nc_oc=AdoM97NYDNrXJ1-2k4kwBdA_gDeU3Hl1Y9fQG3Wf2Gm21rJiOXFV53ESL6y7CGQFSzI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iPZj93LOu6x6wYrAL2HwnbNIvXJWt9ALWCZC-y2o3Ag&oe=6A11D056"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sobB0PJmPGUQ7kNvwGWsKk8&_nc_oc=AdqDDwt-sRUIlEG7F4lFRk9fLCdm4_z_YlEDcoEJ6wILynFT8KV1BNoLDWX8pbb3vf0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WzMeX966MlEzcITbSuwUJocZT0JPMgTIK1ZesEUE7Xw&oe=6A11CAB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PztjNezn9kQ7kNvwEyAuba&_nc_oc=AdrOWxmHEs6wzuYrLF_8j0ss0_UmzsmRCknm1B91ZpBpQ7k4Wq3yeAX6ZskfJXXGYO4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Esx20ai2Mcoln0jokersIyKtwzxZ4FEznJnPU5x96Wg&oe=6A11BB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUKpag44udQQ7kNvwE_jAUG&_nc_oc=AdqdIzcycIt1uiqFqkdiI_B_oCUBQVCsXl4P-JhBoSyD8dUq-dWbUl_CB53MpvSZJ-s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZlMlfRFvDTbLDa7x4TdflPjAKsAb1fkUzMZxbBqFhsA&oe=6A11CF1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_a
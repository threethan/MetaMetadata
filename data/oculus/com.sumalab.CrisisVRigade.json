X&_nc_oc=AdqpOtKxeBFPOUy3JY0gW6CauAfPqA6ZaqoRMOJZn6qM9SByG6LHELNaNp8zlPXZulw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74pdygxCAxXj8N_ykl5XpBh7JWM6TscuJb-GrHH80_tg&oe=6A15A885"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ17kZiConcQ7kNvwH8A7X9&_nc_oc=AdoAc3z5liN4RSvj0kH816DEWwzzBh-6m5LlEEB3srUPFvUWRmnmD0VOTfEC9hlamSA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RgQ7Ybe28qeOID-g9r-AHDwxfO77d-_lV3STqb7NgdA&oe=6A15C4D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWzkOWUkWYwQ7kNvwEI047-&_nc_oc=AdpPkD80icmPI4bkH0Im1DWEErh4mhD51Yct9tbMWhBfkrWN9D555sQtmyaRKIsdJE4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vcTHNscQ2Lb-XZqeR8L2U0fFbiOo80PI4gHnL5pnI-g&oe=6A15BF31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUhxpFnVnnsQ7kNvwHR__1V&_nc_oc=Adqoh4gmbIhTyRQEtwnZBnk9wfSY50IEky-CNjHp18WBspZ5PLdB0lOfDHlGqzb8RMc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vBocHtE6syCdHMTx7xQWNZ3liHSAuMBd6JN3SH3GdhA&oe=6A15AF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDh38Mb7z9IQ7kNvwFAlKED&_nc_oc=Adp7nRpgeWCy58hqjcwjpPxxhDzUdfgWsYAScrZdSzxqewKiVnaEhxQhWwq1qStamMY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EBWeORIHO-in4dbFJh4GbllwPYZmzTZo1vRC9Xta7FA&oe=6A15C39D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
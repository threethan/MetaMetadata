/v/t64.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZOewjrP40sQ7kNvwHyqfSz&_nc_oc=AdrAbCIoqXasEgIgI9uDMxObYAw36vdNvcDdDg3lCRR3FaFUgdPjPDNPs305p9VVDks&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGLyLxm2FPx1aTCIf6ahpv0y5qh7tcYbzfAS6RNzsHyg&oe=6A7DCF05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hn4xRnZhFoQ7kNvwH11gUJ&_nc_oc=Adqci8SbZKmzGMqyoq-009mCZ6U67gvyv1zl2cOoYZwYuTAyxCeS6EHW3zpTube0vkI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7rHluTMW4tmqm8GaFfpPrR_qwikS3vb0HscuBzEBDlg&oe=6A7DB316"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgkXJzx8h2IQ7kNvwHmwrCt&_nc_oc=AdqSjnNbLPZEGmoQfDEYcydMKHSAYytvYs-NWEhJlEgNoQ7UT4PIWoCvzmfmGDuHwOE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHynqkmTn8bGxvgpPmWi7axPqmtMDR5lxRzItOcLSw-ow&oe=6A7DAD71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZxb4QDZQdwQ7kNvwF0m7Zu&_nc_oc=AdrC0INi8us2iHxCeXhfBNZytFRRDxn5qjBX--L3whNcmPbz60Nc0nOWYico0hYTync&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMtiddjWRhmgnE0cjkMlRkXphxYmZaMdHL_NTTZzEGZg&oe=6A7D9DC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJ3h2tlSjx4Q7kNvwE3lXe3&_nc_oc=AdqTssps-_JdsTr-WXJmuHHjoNukk5ZF4xqWwagffATrgDYOqdkYewjVqKaqxFbRPtM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkycdmNO0OpRDe8PlWh5XMg62KXBP_Z99CrTqjOkSRdg&oe=6A7DB1DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"
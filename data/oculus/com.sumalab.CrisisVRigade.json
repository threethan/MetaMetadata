.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uva1kKdXnr0Q7kNvwFghn0C&_nc_oc=AdpE9Xos7f6ZYIEmNkH23Cmqg5TX9X1-gfAhUX2-AEGJQ3jS7jx1zaNWakP0QzAzWLY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt9K1Ded2xCl6tOApfrr9A3_NIQIUWeAF2uXMW6QVMyQ&oe=6A986545"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkXWR_gSWCgQ7kNvwGnUY6U&_nc_oc=Adq9z1fKtbUCTjh_OV3F5J4zCIrmjRoFG_K3hPx7kUFKOcReq6zGEdgJdqkmy0Kgn24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvHMIKyO3o18-AQPcdneYj44Gwm6tWfgactSyLt9sZrg&oe=6A984956"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd6l8I_mmAkQ7kNvwHJNqQW&_nc_oc=Adp6RSkkq7VpuIaku28jzGGsJPM9m8w0btUBYdEttk2sJv_1fhMJcxB_ndt6d3yVz8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwMraYw5tikQfz5bLsuTEshmsfdu1_ccuXjs_IGirfOg&oe=6A9843B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7iMdm-5abgQ7kNvwE63jWN&_nc_oc=Adqo_mdgtwiYO94OzxjmbMPb31R8deoEiqYJcPei83N4gEYczt05S98NqwFVNufIH6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9J6s9UcPhW7hKiTKwUJ8jUtQSe7_5bbVcadKlaOngbg&oe=6A983404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZMK5pXNS1MQ7kNvwHRwuBe&_nc_oc=AdrRtuc6Cb_OxHobWOXfzZpxjv8LLfOJan32M0V3Tx0pGD7OevP-fhUj-srZcPTPGPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ4w72I38kGmc-CfXRSg6OT6TUyqnx_UdgMIYf5Av6IA&oe=6A98481D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
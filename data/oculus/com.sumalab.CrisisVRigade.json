.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eYumI3f-5YQ7kNvwGgD0BA&_nc_oc=AdrENc5qRqWGZpAo18c0Gb1qzwaWFG6dsG8UUGg48L1RNuqJKGcMZiUqcjNwHHgd0HM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlq-xymWsG8nIRbaWZ2-SuOeKyHx7uHSnkYQYc8BvsWA&oe=6A8AC5C5"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsC7OFk-ZEQQ7kNvwGC5JoN&_nc_oc=AdpktwIwivugTN_IDUhgUnK2suSNLlv_6STvUPciuKvloupjWr3x8-f8GysEY2-S82M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAPNR6R368vl-J4E8-9M0vC18NRWTXxuN6Ghda3P6t9g&oe=6A8AE216"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VWN7VV3rqYQ7kNvwGLI-Jo&_nc_oc=AdoThgvXneboR82SE3dUC_sevCo22JQ4Pa3BHKJSS8cAGEKaV69emvS0-KYuaTF8hH4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4stG2__QfbiOAaBafG-5VydrTscBSg1XhftcCeELWeQ&oe=6A8ADC71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHbLBWiSDIIQ7kNvwHxpa1L&_nc_oc=AdpGg0X_WcHBbJha-p0xZgu7vQ_O8cQzSKmw0th1K9GB5A-_T1iu5ipUHzvCdnP08OE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4ilIH2LDBXnZ0b5UeIyYiLZCJsrQ83oVoYcskn7nb2Q&oe=6A8ACCC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi1jmL31c-AQ7kNvwFWmLom&_nc_oc=AdombGIWY1xUSmWYR1nrl6HEpUr83J70yywBRy17jj_eYv6FFelZPOB3UX7srBFU3wM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElCQEDa3FfvEMGImjODc_ai9CIBkf2f1QRjq_8bdgBxg&oe=6A8AE0DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
m&_nc_oc=Adrj9QjzxUGla3DNVXIswhjRC7P9Ag1xZQkSWJtovxwIW1FjlPYSyKZ4HTbCkhpTclk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_tOWDzWh8WeFNKz4kYdf8MB26USJkBSsRE9LHLRyIUQ&oe=69E63285"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqrs1IjV1IAQ7kNvwF1ZXlG&_nc_oc=AdrRI26H1OEHsWwr4FvcEWMzwUIgalB7YRcKOpKhfx77FZYHDBMClp4eaab8hy7qxFk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YKc3MUW7Qwoo-tkxI9Hk1_hPgxSpNcpMg3WsAqO3qNw&oe=69E61696"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_dDw3WXWKQQ7kNvwEnIX4m&_nc_oc=Adp_OXD-PI6LBLczHDfskZaaYZLRyYEcBT8r8-9g2PEnP7z8TlvJUCwqxhZuFpQLGKg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2slzoiCgzrv5yLSxiqSIPUZMML4gbmsn0zYfb1PWtsXA&oe=69E64931"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_tz9RV8R8oQ7kNvwHQdEzr&_nc_oc=AdpZrbme7K9HkLVw_uovk7soLZTm4LbRlvtyVHQnmwvFYbofrEroug12MnRhqKC_55o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dmpHDU4pe9lGi2qCr_2NO3V64rrp7AHuKhKEL5BOjhA&oe=69E63984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QbaM_43xH8Q7kNvwFjfjS7&_nc_oc=AdpgVrhVagFzdaiDCoTF_dZJYDjUHGFnAlIKN4Rlqy7Eq8xiqbHHTUR8wWpjAv8_QWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fGH6LfqYAQz-UEpqptcIVRNwDbZFjsX7UJLfrZilPhQ&oe=69E6155D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSsMZLnSn-cQ7kNvwHlPFM6&_nc_oc=Adrt-HkhNgja7vszDUV4Y_FH_2uWj0WcY-9xElEFztpfnp8uOuf-RX0FWtjwNyUFMjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ATZC7yHaRc2d6FVbleWyGgAczbO1145K7qlkDixd3Jg&oe=69DA5505"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWk-8P0scPYQ7kNvwGFj8h2&_nc_oc=Adp-z-tDwhFdWmbVenFzEI4BuGqCkHawwCNHU8aBvmiUnpT8i_wztfB8dCvqGA_QZqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xr-KKFXHwNT1f-1cpjtDdxFSbVCkr0ktFkAilw-PfWw&oe=69DA3916"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHsMcUkoD_QQ7kNvwGaIzHb&_nc_oc=Ado2ji7oq6mcLXOzd9KHRxd_Cgbj5oD0jIv682aaj_TuS4UFDpyxPv3rn7fhJhRVWzQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y3G-HWCfZF7gF4p4x-7iexdUlvHKccMzfuMLtq-Eu0Q&oe=69DA3371"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVl_eGPD-xIQ7kNvwE3RsPg&_nc_oc=AdpKVSU0I680V3rQ3JpxxO1NeCkfmyggMqjreYWA6On50FyH3H7h1poJzbK1UXaD_3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E6QdAvdQsHGzBsa7sDiGaguLgecmFakpzJf7at__2eQ&oe=69DA5C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsNbGpU7u7wQ7kNvwE-ef0V&_nc_oc=AdphYhBO9BqSRyBqBZwo6ymJNcAeHmQpwx2YvMnaedxpfvJoTVa2f23Gh9jGbBtIti4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cb8S_oLmSiOjx2sKObrfI2JNmd2Xq3pcFOKF8TSLXug&oe=69DA37DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
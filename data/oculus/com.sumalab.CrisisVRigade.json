.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OZ_ZuuN7PkQ7kNvwEC453t&_nc_oc=AdoZVqMEM8O3fIfZr1QIUe5s8u1WNE35zvhgqyJEn76fbOqvsVO5Re9hoVD11eTaUNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKszDqDGqqU20ESEz7K3qRiuZL6KgVHDp37liiP8lSjA&oe=6A70A005"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjilrBBY64QQ7kNvwF_M8VV&_nc_oc=AdqyYUpYz44wk4GuylW_6r5uQJiy8LQJuC08U8qqWSJZXL4mJLibvQIAn8ZfzDZ9_kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8qveocnoYvqNAKsTWWE-NXJbvF7DAPMrIcY6a14YMzA&oe=6A708416"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKOAavB4VPIQ7kNvwHbZPsF&_nc_oc=AdqC9ajNjxHAGnGNQA-1HroHjWJq7LetrYfe5NpcgFlUSog-JJ-mBHQ7i8sVNB3PlsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhpJqXH1cAEN4OnPh97Sr0pRKLA9C4traJU-tpgqI4tQ&oe=6A707E71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr93RB1E_fAQ7kNvwFcTasO&_nc_oc=AdokGpKz5R166rcbCUGZwBRJBb3tdxJvfIA9DV7FgveOY9bSIAIFjT6zksnC7MpZSWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQh4Q7fZH7OybCkFFXHFhDGsR_iFbKtsVuMZYEuzmynQ&oe=6A70A704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3tpPhYAdBUQ7kNvwGFFps1&_nc_oc=AdrpO4n-2t_mhs0T9MuEmLtzYGyZVMitFyHQ-7Srfq0G70_CJtijHcrn7B0cyVgHgoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9Q0biomdpuQPPMdbpuiJ3qHRfI8Ea3Q05qzyioGVS6Q&oe=6A7082DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
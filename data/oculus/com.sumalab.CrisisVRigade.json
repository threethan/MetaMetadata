.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_1LifaSa18Q7kNvwHy-2ms&_nc_oc=AdriiqHix3S4hjYk5grE3OqXmmBsEfYcCzoaFL5C3IJYhya6CJFCEzXQsp2UG5Dc3iE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK_91nB9lC4Yc3nlAFJnKeyytEd_GfAGmq5_qaQrWBNA&oe=6AAAA205"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpwDKEPvY6AQ7kNvwE-MAsX&_nc_oc=AdrNAe4tdmALrds-gxg3wojOzPUPYjaqs5aGpRKRTVYffFXjrYH3yXLX6U7Z_kHokEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuU-Qjadebm5u5wPGZov1CyQmN8fbdnXfWwLgbnKN_yA&oe=6AAA8616"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRAo-4_fkXAQ7kNvwGDwZA-&_nc_oc=AdrL23MiGFTAbuzTSJDRKs8YhNlO9_ZIU8qtjAsT6E-NFs1e-EOXR7YKYnYYgOh4b94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ63AGp1Rglu1N4BtXAINfZDpH5WNN_KB05vdJ-VV5_yQ&oe=6AAAB8B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z5Mq__ZQEoQ7kNvwFDsd50&_nc_oc=AdrTTxOWxkvkaoh0ZIKAMlF4yrKTEZ-tbMLrlR3GlJMYM6R893leX3AsaxL3mBDS6Ps&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOzyXAaCFkWpci4zWveqy53RnwHhiG07Hj2TEJj1Z2gg&oe=6AAAA904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YRISgEaVPMQ7kNvwGdlLZx&_nc_oc=AdpFVqHAFaVgNXF0O-ldpuZzKd1kAMZBpgEl7NX1qNjE9RjFzeX1OIXxmOQ7vNsG324&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBluf_v65W6Vw8JcAYutj2NxljbzQ4lo2Oad-jrkpt6w&oe=6AAA84DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
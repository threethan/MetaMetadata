A&_nc_oc=AdoakV-n1l6nRb4gjnqTJj4j_a3Hg-0f3bOhhfyRbyzbQVhXAk8-0LYZwkub_p2QBSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gSJRjQO_YGz0RWai_ToHqw1Fw_UWa2wM0tSakZyGiSg&oe=6A296F05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XXZquePP-IQ7kNvwH4HU1U&_nc_oc=AdoDz_oYM2S_jEZPThHhvGtESrzHeD6fDMR6QFyIn33qBSYlmBECvntZtHffo99eMjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CTzVRthAno-WC3NB2AZJta128svOt6JXdDvmF2Jx6og&oe=6A298B56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCCNU4RzfLwQ7kNvwHT7ppW&_nc_oc=Adr7RZ_yFlMoPZciR-QlHcx6eC2OVIDcv1H_1idNJ9bmoMHd7fw2PgAPRDF_ZC4qN2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LGIM6nMpI_7wllE9YpveJZ92-2WuGTKtfdC2227kWcg&oe=6A2985B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feH-ukCKu1oQ7kNvwGmtQBS&_nc_oc=AdqJ1H4Sk2iPZHXsNaCQEmQGcRu8EUOTqPgJcs2jynK-STtLMzx6qZ6VmMRuF8YsBI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98oebfLOmjobJ-pMFSZGjCQ1n4oTIvceWYJ3_55KUMSw&oe=6A297604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zxu74zHDgQ7kNvwEHVkEZ&_nc_oc=AdqevKDpr1oBbumzl4VO6aAv_wD-tlmmPQtSB8mI37bcTZXrPGlpQy3BT3PNWEwghUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WkCMUe0BLHjRZsbfbqcWhpi20NSiq_CTxRNJzAMajGw&oe=6A298A1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
k&_nc_oc=AdrXS8vlfw2ZYO86eYo2zYxf4slEStQs3Wkhy3iNS8hOBGu2mO1WQoZHVQUUg5pYsp4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__fbwVhC8BB81bIm-bFJDCU4mDZ1BQ226UM8KW_o1tFA&oe=6A242905"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2YZEHzoWrUQ7kNvwHxho2H&_nc_oc=Adq4agU3Tqp6kdrpQzUQNCmsf2VACfFJofuUiZbLw5UWTQ6W5pt7v7wZy5iLw7h8kpc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_spTGDDrSr3smwB8Kmb8e3r9MAFTmWTx2yDDE08pEEMg&oe=6A244556"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8y4zQWoO0UQ7kNvwHEX7Y8&_nc_oc=AdoyExXwV-5oaAEdgWrnkVyOFoHmJ6uKjIZDfLqbSvVewoa5GGfD08UupzX7L3paCUU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qOkBwk37Mj2UcUidywTnnSIO9d2t6E2F7PceXZoolBw&oe=6A243FB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLNkCR7UJFUQ7kNvwEgc6h_&_nc_oc=AdoCMRYR6t7vhBhiBxOy4mVk9cycxIC1SAK0iGdgElRAExnFSYVKpoy7kiY6EDo3fJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PTqpcNBeYfiRbhijZlm5Zc_3Z0_ItBSFta7JCT3kbDg&oe=6A243004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD-nhEGvtEUQ7kNvwGb2P7b&_nc_oc=AdrCQx7wysvz-HuFMYkAzVaIVi_YzACZmD4rIY5J7KlRRyt_CUMAgcNooJGAYjUHHYY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IKNp1S2PxkOkt0fEJIVyqL7-QugpuHmR8_PR97UbVfQ&oe=6A24441D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
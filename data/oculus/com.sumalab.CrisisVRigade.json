.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqeUhv1vJ0AQ7kNvwEYdCbk&_nc_oc=AdoXVKAvdV-wMOz0-6zDQRqQzgEtsElaYpyxEAfSza6D7GTlClgCrssT33HAbzQw7EE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILQynS35hc1oI08nQedwI4E-3mocUec52M2nwd_Rk5tA&oe=6AABF385"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpwDKEPvY6AQ7kNvwEu240w&_nc_oc=AdrpaBJAOoOWFHbLgbWXNM3W5hV2LBTN1U0pL3l6rjGCeWWgvp6JeJAeiVFKs82ZccY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiazRodp6D7YOfdn6ZUE_v-SzXs9BqY9FLx04QgHI6-A&oe=6AAC0FD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIBCQR02KnQQ7kNvwFn2mvL&_nc_oc=Ado4wfUaraCQC938HTBJ9wHo_eU2qKKigZzSN2qEllx1ftbk3E4SKfsyoE-P-d5hFEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPs_sSH85mBy1uCPL5SOCcDoM7hDaeZnM7I-wSDmZevg&oe=6AAC0A31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z5Mq__ZQEoQ7kNvwHHiL6q&_nc_oc=AdrR0Ka9J7PKcnAXhsN4UWN5Ga7DaAz_kG03_9IP604XEXtuDnw0UWk62FdLqAiWliI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKevgPtIW6nH5jzSpzQGTcWMrWYLc8zl3u8OGxpHTYsEA&oe=6AABFA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz8VJdk-4F0Q7kNvwHXr0Vo&_nc_oc=AdqXYrBYe1bEBKhMLMqAZqcOTcy86cqveIndLh3jEhwQyKQNY6j2tLtzp8Vg6uG_LNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzGFU_WeIDXHSafJP6ruubTF1qoACdeSwUSkiTUErxDA&oe=6AAC0E9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
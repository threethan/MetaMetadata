78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD89op6_OjEQ7kNvwGYX4mh&_nc_oc=AdmeNATSGk3dV9BiEojVXUAnEo-vvvPFYKeQfoX66-QpQFC2pjfRLsVAu4FLMZojRk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRlr6pDP0Zw7jhTjlnhOx3N9sLcGAPfor0uusLv_sxkQ&oe=69B95F85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_2y1fjepuYQ7kNvwH-cOz_&_nc_oc=AdmlKReVotbE7Gwfl1wSId_SRu47dGnCfNPLW-JRgjjIzTy6ixj5MSDR_ZQ71hpxTlQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRNHE8cTyrEsTgviUHmDCzL6t5sv6EmqSTbLyq-1Ekxw&oe=69B94396"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-qeAQNzmisQ7kNvwEqPXFg&_nc_oc=Adk7SAwrzkP9soJvxedhCV0A_QEqDChKFgjaCitvllk3n9txoDyTnxGEXIWf0r5fN6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqlzUHlUBagv5PmvgORl8lOM3MMGNpMD9lAGzvuutGbg&oe=69B93DF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVGgeZ5Bw5sQ7kNvwHSOgye&_nc_oc=Adkc70veJBXHpF2S9uOqaX1JDNDjImlODcfnORDBkJ81PMykGxrTYloAFCmL2CwnBXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBhiYu-fbc2mMuE1rQQj8jjlDB5IdwBV0EzP7NuGul8A&oe=69B92E44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL_lCmxbj2MQ7kNvwHHiqe1&_nc_oc=AdkHvCHVx6qf6naEhhNqMJQD1kikqSJET1AlClqNE3wo3O85ske9fIHvUlEHht87ph4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXRca04_bLC-s5cNVprUja5dkH1koTW7GxAqDl5kKrXQ&oe=69B9425D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I-Tr9M7MJ0Q7kNvwE0gSPx&_nc_oc=AdoSY1YzAcoo4LBDODehmZdukwcH-zX0gPdJFIquKKFp31W6JVFnR3C0KY1AL6p13TQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADNgcqlJYNcFxQShih0H7nBaTrIR7xxFWGE972SiP6eg&oe=6A539F05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xsUkgXjq0MQ7kNvwGTlLXk&_nc_oc=Adp-b09SzvAtnHIzJy9HoLd_034QZzLPR8RRqgGjb0RmkM5u5o90V620GL0FQ6PN_2A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIrGJEsYRge16sGwUxO0Eecx7Xjh80uAJ1vuoD6Ftarg&oe=6A538316"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaim0DzkGEQ7kNvwGFZcKU&_nc_oc=AdoFwNUirYtURr1tEyKGk7RbsbNq7NhgslMPt1H1FfdmdIg5LwLBAwdESSraBqIq6_0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3M_8W-twMJuaUz1xHgP5IX0U0OjjMOW44zcCiAE-fDQ&oe=6A537D71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM5b6evxq-8Q7kNvwGz0fuj&_nc_oc=AdoSGT7LXKcVWxqqvT41yEo1hyvQx41Qd7Sy799t8on5BhSmPmiy4DLRPUnIVL_gu8Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOhfMiNeVKIrlouTXw9q9ZmtP9_0qGNHP1Q2ulkc_q6Q&oe=6A53A604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRHzOncq8HgQ7kNvwFezovG&_nc_oc=AdoAYwp-OCncpIJp-Sor8Yp9kkpyTdB-AWFvd0C3bsysRYTSelNlsoMWfv_vrhyG0gA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRo7Rm4zBfOdEwRT0acmtMyedl7LsDfDKzxnHVTTz63w&oe=6A5381DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
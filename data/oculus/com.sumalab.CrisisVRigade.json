wEcAYs4&_nc_oc=Adqf7r8evBMH-1O_s7vcec_VKx-Ns74yriX8V7tu6P1SbFnwd0kp4Wa0Ra26jDfE8v8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yw-UYoUNKQLcX9u-oPw2lgKtG7zgwvzPGTmXEFRc76g&oe=6A467005"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc_oslayqzsQ7kNvwFK2ZCy&_nc_oc=Adron5TeRpM8rJz2Dg6RLylWuXTayfW28UnXIVDuv7FuLGhcOnKH2SRv6XOzxhvJBHo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kw661ui4CNfaNcfwnVjVVDHavxvdacCk8HlI21GtnaA&oe=6A468C56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6dZEK2vmoIQ7kNvwE1LrsV&_nc_oc=Ado9UJ3R8MzKe-DKqSvSmfMnj5quYmJsFxqT9ckX0rIDR2EtLCpyRp99-DKpkoXrh-4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BnpN9cXN5-lPCyyFpWQGDJogyAL-xAOZyCPL8VTz9iw&oe=6A4686B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdXX_HQjFp4Q7kNvwGKdC1X&_nc_oc=AdqOkG7lGlhJn4yJorTPa2l2Ns1bQxWznJ6M68RyPnlVrqfBeoOywh6mKPtu_R3oy7U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yQAzRbk_-m6Bioa1JMWXW-E1W241aebGei5WHLQVOUg&oe=6A467704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCnWEP6EDlYQ7kNvwFOv1uG&_nc_oc=AdqaBa4xshTdsmR00vyXJnH0wY49JLfvTwR5GQAeGnnjH57xHUxIx60F3NNx56oX5ng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gHft5gnsIWUEe5qKRTiwTEbckTSympMIIcN0V5BiR8A&oe=6A468B1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_a
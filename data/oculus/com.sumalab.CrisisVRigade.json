.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5X8FG5-jFIMQ7kNvwGHIDOe&_nc_oc=AdrhbY6AZIDvlt5CjMmg575Cv6FonSS8_eOcinzoMl-kizoZ0dd0Wx285GCdCpeCi4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7NqOpNOwlBiRhPtKmpnRAm9JErgTtqz-l2Uyq2ktL4w&oe=6AA16785"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtBA4-8GJToQ7kNvwG6-YS5&_nc_oc=Adq2X8KnyBSK8YCPgX__Z7JvKgWkXPdQ_PBztjgOxqfqes0P7ae0xoRwR5uhb-Yx980&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBdf3AFRNNgisd0_-VFNyL4y0iLTxlIok3ZluSfDPMDA&oe=6AA14B96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Z5QBV98gwQ7kNvwH3_FK_&_nc_oc=AdqC_nE8TOXp-8qM4T9zcS3S2KYwVfVFV4jyohpYHoRoTAQSmEq06nAH391mZFOTZP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwECL8pAMzkDfV8n3CXK0lNXLFvbXkYxAzpcQ2ArdYpw&oe=6AA17E31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eiLJ2pcIMsQ7kNvwE9ikN-&_nc_oc=AdpqVOwn6fahXAbSVGLlsFkOgy0h0Y7yO0WTMvh5xo0K3Hyf9cbxuNIfDMJUo4vAWE4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRK_wgFxFbBqGmxnX_s64Vm8h3g3i_Kz01taMfzkPTeg&oe=6AA16E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdXL8fZgCRsQ7kNvwHuCIWM&_nc_oc=AdplPffJCIMMBXLAdqRejwRVmd3b9AtvpeSSmaffpFiT_VwHDi-XmxHoDNqeX38NCmk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-cSrBtk9GE498p6eJJYWfZ_dKnKkqaBjNGvrgVN4fjw&oe=6AA14A5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
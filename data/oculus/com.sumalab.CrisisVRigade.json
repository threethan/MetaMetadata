.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E07Yvg0HfIwQ7kNvwGB3STI&_nc_oc=AdqLMbn_If3yH2SJipCrQjQXhJ-H1drGEsV2yjDEqHGQbDahL6IgFGaOIB-y8DZr2bk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoJIuPHOvazgIZWX_1c4iWYEHcLo2_ilZJWQ9DCAEPrA&oe=6A4BB605"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9BxS3k3ODsQ7kNvwGp4uYJ&_nc_oc=Adp5TiXDADJ4_jyJC4jD7i9_pRliNYwWgqI4DYndvec-ElDxRskvhLacyQTBgx3iEDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-raiOFfniKRECSbdLiTEJbKuggJ9_Gu9_szU3BEyHzg&oe=6A4BD256"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFBUQGAd3hEQ7kNvwFINPhJ&_nc_oc=Adq8uvnyxmgmlAVzcOGe-1RQNHLCJOTkt-vuMesz0nNuQbO-2lcRjY2GR3rzxaT5cMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVM55QTXSjAntNbb4qTIm_039-KW-MHBGJG08YBDpE7A&oe=6A4BCCB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLioC2wdQ_kQ7kNvwFmTna2&_nc_oc=AdpDCRM6W53-MrsHBN8pfcZsB4dj9J_KQByo5qwHO7oqvFG8GG-axIzkdhfFcf-drjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCut9Ctv41L8bheDLhNSmxi9b-lj5O5ITIngUazVD7BCg&oe=6A4BBD04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfDfrO1jy5sQ7kNvwEYLpPh&_nc_oc=AdqXLiw6QBXghdSbfjQ7_goCkA5GqO07DTLED_jUlOB1A3yP3Eh-nI0gancmo2HBFCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0qyfAv3XB_pdNdbdtnsqVgwUcErxuSe5U9h4ELsh2qA&oe=6A4BD11D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
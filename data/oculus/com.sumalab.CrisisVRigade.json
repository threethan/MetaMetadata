V&_nc_oc=AdrJ2FGtp5_SE8Zjy7L3ZnUwKYpczfZsYAo7PayqVdN3Zs-p7OyPkofqEmmaw-Kl50Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5w1vv0QkuINqSR_kw57Uve4UzvYrjITDJ6Qejduze4ZA&oe=6A009085"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73BLOtqskgcQ7kNvwENF4q7&_nc_oc=AdpoPunDcsoqS1Q5dOf9Qkfv4xbAf5WHUvwNe-8hsE7FZzjynwVQg-RXmfEXUgo9G2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZRBpm2n01fTXG10meMNpTyktwvJ399zSwWqmFMVIY0g&oe=6A007496"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaxmysQf024Q7kNvwHS0P2r&_nc_oc=Adqzu9CQT8IbRlkVDIQMuY7wYg_bb1dJrguLgI1qL5g--bKo6lqqePitcUyhrMu5EBs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nLOYiRrCTontpqPtiCuirfQLY6hDGUIc0yYiOZK61dQ&oe=6A00A731"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGrnw4TRxugQ7kNvwGUsgx0&_nc_oc=AdqndqQBrf2Vk76vBRoCdXdQ5XO8HZBcSj9GSIIam44XXV3WOt9xt9PZD0_fOKF9lZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i1XNXxvsBeuXYPKqUpDQPFynCrnrKTxlKm1ponOG1Vg&oe=6A009784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMQcv-YcJtcQ7kNvwF3lnYY&_nc_oc=AdqsFp1D4hGD_5sQSvKDR6Ax6dNRckNlSS4PXaGobMXztE0ss3tdtIUZhgEXLj3RvdA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cdBadyv3rpjQu1f3U53zxrIC2JL0KOp4PP6TC8bZrLw&oe=6A00735D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
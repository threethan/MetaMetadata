.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8WtmpTQRwcQ7kNvwG1t915&_nc_oc=AdoLNJUa7OjJOXpOWgMnZdq7VwGHQaCayLaiVphGmQwDNIAFyArG8xXAOxW7VxHhQpE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzWG7dYzBM70DsmO4CwJHg_E1Bpz_PEILU2KeftOy8_A&oe=6AC65185"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfJk7oS4scwQ7kNvwEgRYLA&_nc_oc=AdpK_XXkKEOTwZiJkT8YZbPyQjK1O9nkj3dtqSgKQGvh5aDlyRlzBTC1byZl_VjBQj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbIUO-okpKoKNq0cdn6Vz2bJPLX6u2MbpnUAuY5ZNzpw&oe=6AC66DD6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPGApYi7IT0Q7kNvwHOCT17&_nc_oc=AdpJm-XmRvNICfFnmBVUAnJVmwZ8spUPhcjrPeoIZI4W82wlt_FRizlQSPRqZbdlmwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUpbHfH0aPYsjs7dOwMM5umsoRztH92swgDdgoLWAt3Q&oe=6AC66831"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYVXb-zYgQ0Q7kNvwHc5-HN&_nc_oc=AdqCA2hHm1t7Z9idIwAd064vG8ixiIM0_hoI6brecUFu-DtvH2-Jamj06gbg2dWvGtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3ViUzz70KkYscpGhoD5KID9VgbsO0fPqz6VgMbgQeUg&oe=6AC65884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bgA8vsIpGoQ7kNvwHWfs3p&_nc_oc=Adrp-qpqvuixjRmdJ3fMATwCW6LXVEA7c-fzyLORVV8nfHCXM8uxLAmGbO2wMfwJQaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv5H_NOOCJx6k3n8V1RlLvl06u258pkp-5jfNWDdctTg&oe=6AC66C9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
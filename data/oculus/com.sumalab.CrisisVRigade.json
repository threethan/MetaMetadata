.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eYumI3f-5YQ7kNvwH7ERV9&_nc_oc=AdrEY87wqQc0QD0pRsZVZWeH6cRGR4VfkC8azIYQBI4FL6Ee6PgUU1DhXxbR0MM9ots&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBlEh0msesTk1v16Giy1EsXtc5fq08gWmWyEPiLxRKhA&oe=6A897445"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd1BlzbhmkAQ7kNvwEh9_pO&_nc_oc=AdoeVFQ0a1XRB15ZlE-LzGngmzenXRafiaTcIx15FVZnLEWtHaIDrZauoyBX__snCvw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCLe7nxE7_x03Kn6DlZOJqqexjWgMAm5NVWrgVP7Uqrg&oe=6A899096"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VWN7VV3rqYQ7kNvwHTyqgX&_nc_oc=AdrD_g1yosZnTNW9KGOHg3lyZqiDuviqm-pGroqjsPBUfaOLBabp-bQa9fgxkTZwO4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL8LJpvCuiiMv--JxruyCQX9aq0smTLE_QXrkocDnF7Q&oe=6A898AF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzEhvJ4bzmYQ7kNvwGkWlTv&_nc_oc=Adox7aDKvfWbl63r_bIA34fHmUm7Pe3kosHQ0DiHQmYDaAZp-kQKVnqmIpp_3RiRtSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0QQg7Dh12XS6isH3_qZ2IJEQd4STDDHFM9uLA7mQOeA&oe=6A897B44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi1jmL31c-AQ7kNvwFju3q0&_nc_oc=AdpIQfaZlRXHDtYXvT3ww7ovch6QjImft3uVG2JYR7plOBjc19x44eMt8SjqEzPa5Ys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7EOzF63y_ZVHOiXK0skxQtpx_BnGQGiN2SrLNl-dxww&oe=6A898F5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
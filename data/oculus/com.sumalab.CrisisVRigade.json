.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUNaEmQEjkYQ7kNvwEBhtPO&_nc_oc=AdouAyzCMmctGD7zl2dA7eLjGo2WHkB7oZiUFw3doXdBDYeryKxMFGouTNJ0wNOOUNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af079CIZhjg1Cl3tk9H2yrWAblfxNuw6_1zdvTscJPxMyA&oe=69D26C05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKk6WSKlFtkQ7kNvwGpMOTD&_nc_oc=AdplMiEW5dXC5qIObPwRyBNPCq-lB7_1vvSBBtLv-OnMeWkoWeAktOe5IMunizHM3PA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u9kFsNN5v1xgfZipgTOOKlgl6uwDSltOmU3gWwprMwg&oe=69D25016"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV-c5NKzOPYQ7kNvwEBD6JO&_nc_oc=AdpDLillymeKSMP8YE5GWkaxY4UqEk6eIEo7miPiBbHcuBY_uC7pthjPNR9DRfFp3P4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HRS7KsJ5May6BrBFoCgFIFt68x5zoT9nKSNElAJjAxQ&oe=69D24A71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-cQ5z1fAvYQ7kNvwHbcDIb&_nc_oc=Adq1guOMm_WxQhqdzKSVsuAtgA1FMorGe5IOHdL0kyziIAoZYRoSPJ9SrV1-BB2vRyA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GDdUxXQAxK8sFuRdealLS8cT1ReyObv-Ft7liFr4A0A&oe=69D27304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSSVFb-m7b4Q7kNvwGpl335&_nc_oc=AdomcHkxVqwSr4ul4oGsY2T2DsYyso7krm5F3JJjF8yxb2JDW_Iqk3L0cy76m9z14mE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bIL-NB01vB8prEkKEDQ4a_m5et7Pr1ulv8sxljM1_IA&oe=69D24EDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
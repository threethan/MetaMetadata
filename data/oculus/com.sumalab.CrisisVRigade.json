.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wafs9BfeUVsQ7kNvwESuX0t&_nc_oc=AdqDexxHvSVEsv_4SThC2WvLFfVHW2zC5aoqY8ntnhsNY-KJ-eJudvsP5bN06f0myag&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXZakfaYusHZOar4ON6cjahbvKQ8EX2Net8UM2t9yZBQ&oe=6A5A3685"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M0sUTtgg3gQ7kNvwFGgJmc&_nc_oc=AdqoAUuGKKAUwr8XmlFZHE6b8ZjBq5_juyLBTFjuh6EBKaZh3tdoztbeCS_LZOlZA0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVRbON4O-CsbkIvWVtalOoM2wrhvtQDuubi0cpOWEz3g&oe=6A5A1A96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vBL59Ho_TIQ7kNvwGv-XGO&_nc_oc=Ado_3ar2CdyxYx9I6gO3gNkUzcgaTNmfZ-2HQvLI2Hr4t5RAzN1sDeWfAE1coMI0c9c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBubIJ242rJmVCJjNCfdkFAWLVpjd3tMlsYpKWUOGyz1A&oe=6A5A14F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7XJK5go4goQ7kNvwGyqZiW&_nc_oc=AdoP_B_dh7r7miUVvk8zCxFZQou320Jeyh18caHKUhV0bX-5wmpgJbTIA0YdMJbyicY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlYUmDjkv3niPRfGhJAFKIxsxLeXL17pf9eCJcyVpQmQ&oe=6A5A3D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWuVKd3NOfkQ7kNvwH0NVap&_nc_oc=AdoDB3I5AcS4mGa6PRG-ozBVYPuwszVj-nUAzB5Lun0Xr8Q8HUg_prqtJQImwjlMcxk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfjvgTVBTRIboGd0ib1LIHITgkTrvXd7AytAXY2qA-tg&oe=6A5A195D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
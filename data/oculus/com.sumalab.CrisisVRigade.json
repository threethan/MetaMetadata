l&_nc_oc=Adq-WWxGIzqfU8XJSanqr0E98CCWtolvFW_hukfgqfR5Pt5ZY8mBY1417hX5jqY17CI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z9MR0PrUD6GtxuJdRxQj1XpwVa_1GUriPpacaf3F-og&oe=6A2C1205"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t86NwKYOKG8Q7kNvwFFcnTv&_nc_oc=AdrX2icecsPpiPguT4-xxsa9eqe262rGeFFQVvBzy1H9yxrK8Rl5uLwH6ExIyoKDqiw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Tf6kOv8DHQe1dUS-oIf-2L_RnVdggphqKmcxO5NzYw&oe=6A2C2E56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCCNU4RzfLwQ7kNvwGqxQ7h&_nc_oc=AdryUCKGALfQxu1hz68Eqfuf09bvjCloGizyFRNzco7uSc8Di2SV8bx7MfY161IrT7Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FDKKerabD3LhlUtXc_5Qyji2sHYXe6_b51LjUpZfVsw&oe=6A2C28B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6X2F6cecy4Q7kNvwEBSvuQ&_nc_oc=AdoAvH5atVWdHIv9N6LUzpFLVmmox_kgiG_FHUHMJMTuL2yVrMmlix_5DUpLCDnD8MM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JcgB722VYoCqWiMIF9bO9QoqC3iz7SfmIPBKVBtmTHg&oe=6A2C1904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zxu74zHDgQ7kNvwF30WbO&_nc_oc=AdoeWMVT4KO-xAhOtQLWNbltMW3USalG9q_O8sv24WrWjivmbxh4ZnKcMtZnYEcnKzk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7z-bbbctHdghg-JUqYX-nP6iBx47oFLRdMvMl2SBD_A&oe=6A2C2D1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
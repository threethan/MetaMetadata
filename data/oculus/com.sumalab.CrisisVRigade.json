wFJgDs4&_nc_oc=AdqPJUqEYexCbL_Y0OW_I-draZ8w1k5H1ogmaUYZv-j5E3TPvrkAFagxrM-kZd1dG2s&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lm5STn0QJ7FPG0RVr8vqeeMqxyyZyCj92tiVU9FXa5A&oe=6A394105"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw5E1Tk3boQQ7kNvwH5FPQ9&_nc_oc=Adogql17lwNafq9PTEfqKIn3kkmJEE9zlGltN7bimHfIgjY0LLQM1XZpZcvxnyM6_ls&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q05nDWGNRpbkCpBIITmQBYLxWQ2_wmIuWoLpOkPPduQ&oe=6A395D56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBWav3GQYiMQ7kNvwEBVfho&_nc_oc=AdoC5p3PcKrTSqAQhLiLQuB67sGwNC_RfTwxf_htEJXHcx-TkmOra9wLtXvMe2j52_Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cN-KsG3YIC-5MkylHRmXbfsPT49w1tHPlJnIYqgB85Q&oe=6A3957B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZOLlrPlT5QQ7kNvwGiCTM1&_nc_oc=AdoSPdvm5uu4oUHSdle3sXKX5lQBbgY0JqWoGjRPX-wGFDIGeAOwv8lpkQM0W6Tculg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tpoLt0b861Qdo_MQlWOPVAwWRUW592KagBv3hJPuhyw&oe=6A394804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmZGQ4dv6NIQ7kNvwGTVDo0&_nc_oc=Adp9mzJ2VWKonTtQ7fqDt23tlMKaWHp7B2niLlEBf0a3jfL4Hdtd4Iblsn3B-l6dSe4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EGKOo7ZbXkK3UnZv9P1ZPyV6ZjJT_VLqZJ9VujlHD8w&oe=6A395C1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_a
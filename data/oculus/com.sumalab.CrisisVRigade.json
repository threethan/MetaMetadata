.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-BSwsYuOsIQ7kNvwFCGUD0&_nc_oc=AdoBu5oYp6OivoyiqLcJ1mBVLgEPrac-zgboDRhLcBOwWyfwlfQqWzBVcoeu8Bhcb_g&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2sQ-9Uqz8BrgOlowOwQc4KtJ0nVjjr5oZiK4pzeaJPQ&oe=6A974C05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkXWR_gSWCgQ7kNvwFbqxSp&_nc_oc=AdoSl_b0c1suf6gBb_b0RpwEY4nyEjWzFndVdOTSn0HLfl1N_mros85LcukgcOeut2s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG094x_g8FB0QtbRtUg-xdruUAUIyvJcCqAz7EqFVuQLw&oe=6A973016"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rosJ0SFKR5wQ7kNvwGho7LM&_nc_oc=AdphsOTo5WENJOCPALxhoE0dsg1-QcnSnrrfTuTdXhccJvkv9ucudDC-tfdAHgl4Ckg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFAIuVRZvRkCEh5BQi87LAA-0wbiKL522Jxvcf-CpB9w&oe=6A972A71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7iMdm-5abgQ7kNvwH_43ja&_nc_oc=AdqmtXImQLDq1HLyS_NPHwMMHSCcIxlU8w2_m_lbcJqVWj2MHOMfRj56kh1axVWc-40&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5gNQHvRhzsh6J1tgf3uBcyB6xYf5gAZBfFrYxjay91Q&oe=6A975304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIP5yOTx7kMQ7kNvwE1LdAh&_nc_oc=AdoxhvXrTO3PudLc1-FVMokzBO3ch5Ygf_VS_JYKw0_u9oUMKShdOtsmRt28qL4Am6g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8I3EHLMSa2hl--b8_F5mEUkg8zoR6jpQzzU9ANTqnqw&oe=6A972EDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
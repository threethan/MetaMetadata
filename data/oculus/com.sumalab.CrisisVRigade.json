b&_nc_oc=AdrFCj1Th3yP1K3r3nsHsFJfxmnzyYk33t-YNmw7MdOxABwJY9mExlLk1gbVkYOBR0U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76hZPzsu_k0lQOYVBFkS9RovVzj_KM_uqoJZANu8sNuQ&oe=6A0C6E05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQXcWjN2eiQQ7kNvwGKvTjn&_nc_oc=Adr05bdj9eqEx7bLMPxcKqLZH3K4pp13UusJb27vZj4AxCND0D4EBhc9j9Wt_-cqGck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MbgNN7rkyHe-H_WTutzGfG2mOfbwz0LhPY97nv4EE7w&oe=6A0C5216"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqBaxTiIZdUQ7kNvwHe20O8&_nc_oc=Adp0E7IK7mLoxWDUgc6c7frLzhRdmVzY9i78KqvuzMGWh_QTFqGzHdLD-guuDn3zDsU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C42Op3XY1cuKQl6-gzk77QcpvGh2lyBSW9HZgV_Cbnw&oe=6A0C84B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUcLqIQqYRoQ7kNvwEqpvzQ&_nc_oc=AdrQPzOiRjP2vVTisM3qDLdOcmThksAXf7ClH-jYkY-zxVT6UMftShG_K0LiOixgKac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JpJqZJDMp7XYMiDqlYLLHtGy9BUVuNkd4Ziypl8h_CQ&oe=6A0C7504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcP1XvnAaQ0Q7kNvwFYN7XM&_nc_oc=Adoa-sM_xCm9mITQBnnyuzkcSfGMmahprcXaOvmjbd1jvX877Xit_iYxGyduZhegXhY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lDPk3BmHbXdz1TWbA6fi_XODZmMXvK7CGxqnVBnexAw&oe=6A0C891D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
om&_nc_ss=7f20f&oh=00_AQLyX236v1gbGINwMyq3eB1ZWxsSTgX4kDM0Oorhx97Cew&oe=6AAE9685"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YrY_3m67FwQ7kNvwGBDLxw&_nc_oc=AdpqObVeRFSMCso7r152vt1phsG-JSclcQ69dcIVkqrN8OUxMx0DNJAr-2aFZhw1774&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUzyEQdBMWCv0js5DgZUQGcd6tfW291SwXdTnNJ0Sj0Q&oe=6AAEB2D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIBCQR02KnQQ7kNvwHkFGpn&_nc_oc=AdpTbNV6duDjmojPufPIGHROld_D9YvoP436moh1A0Xvi7cD8DEgkX2cwMsa0zXYxz0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK2ZP1VHC3-7u3O3oRGDwYWP4FV6d9663lvOj6-hHFQw&oe=6AAEAD31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTKvWCLsrkAQ7kNvwHWAvnH&_nc_oc=Adp3LK6t984ZRqa2JTIjFwZaT9wdyIzZH5LRCABS2U2Tq3HinfHIl7zTi-TtRP72_lU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2_WmR6nu10BFycs73boW0p3UNiyIsntUpbdee8_6ogQ&oe=6AAE9D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz8VJdk-4F0Q7kNvwFTwzWI&_nc_oc=AdqtbvFQOaIdPwed3g9eTjRGTxwzlKGnFfymTbDUD-1EnatntO2dTD016G224cSONPM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMDrZGUAo-nMQLgVW1Xdj8CTy3Rpby6qU4zK_Vbhwi_w&oe=6AAEB19D"}, "display_name": "Crisis VRigade", "keywords": [], "long_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode.\n\nDuty calls! You\u2019re put in the middle of the action. It's a dirty job but someone has to do it. Together with a SWAT team you will have to deal with the situation and take care of the terrorists. Your mission is crystal clear: finish off all hostile elements and keep your teammates and hostages alive. \n\nBe aware of your ammunition and take cover while reloading your gun or you will be exposed and the mission over: maybe you see the bullet coming, maybe you didn\u2019t,\nbut the terrorist got away and your partners now have the unpleasant task of giving the bad news to your nearest relative.\n\nEveryone counts on you and your first-of-the-class aim. You got the highest rates at the academy, it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOU
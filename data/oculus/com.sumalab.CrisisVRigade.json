.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjsYeKThfV8Q7kNvwGuOsQ9&_nc_oc=AdosEsNqFWfqbuPUQhYh8LRitRvBx075_KRpVZwirt-LrIas-Hnrp13YJ-cmHpuLfuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3VGodyLCyod9UIA0svTdlH2UAVnPpXYsv2ngtlgtaFg&oe=6AC25D05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3soClensHnMQ7kNvwGjNQoY&_nc_oc=AdrNR65w1zx_dIkdJ9SL7aJKU_1MEaajrPUZHGiuQb5Q_mr-BcXmaWWRwZRGEcF-Cmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9-VYo6oSWum1q3EJD73S6dPT2H_qJQZOXaaPF5Mg-Ag&oe=6AC27956"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_v-quRLuJAQ7kNvwHqZYTZ&_nc_oc=AdoUPGSz44NPXi1Z9-xl-VooBvqUTsSidqVt1D7450C1HfsSm5guE8mxvNk5HRnor1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDao1zz-oAXAC5ff3i1Ryb-gVRJOuskkMTEJ9FY9_4zw&oe=6AC273B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81xQW-sCptwQ7kNvwHekSY1&_nc_oc=AdrM80I4hNBhKrv0DAjV4vnnGa_JNzN44i6wMqwUarZTGKiodCmNjaH7Wt8Ee9cI3Qs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIR5VtHEOOvMs7qXzpOX4Li_jNfI17eGlxVOjfdDqygw&oe=6AC26404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtw6KIVg-nYQ7kNvwFb8PYm&_nc_oc=Adq-rmPpnFoc7bKQscz_FTduqVxAk8-eev1S1v6ya3MR18tWtaXNmhu2TEWD3QBUKqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSBJ98nzGvcB5P6lbDH_cEC578lPapJ7qNu0sEHMBHWg&oe=6AC2781D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
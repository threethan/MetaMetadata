.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCVt8y_l2jAQ7kNvwEl1fQa&_nc_oc=Adoc15QBnQVKp4aYpQRP9r-TeZ3tET93Un78Avk2nc43gdsE1BaJR_HjKXif_nKx5Ns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_WIKkG0bJorpMiotmTPMpDRD8FIoHp_MFMLQkig4awA&oe=6AF32485"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVwG0vCm530Q7kNvwGJC9qT&_nc_oc=AdplNgiP7nHEgbj_dIslt2deZPgRTKiAa4J-Y7zEFjdaegXQ4HZJI3_vRgYc2IMBWmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm0vEQhy8ifdV8Qtczo2eMSzMGkypOU7kp9VA9Fv4krg&oe=6AF340D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPIssxwG58QQ7kNvwFFVwPv&_nc_oc=AdoSnnzXJgCeOJkcr1hdiKgVn7OmzHQ-GpHmdOwYv8QwS5LxSlS0dHL35_C74N9FOlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7wKWf-ZFSVQFLh4kfSCKjgKQlec4Dbs7-yd9Dyo6zDQ&oe=6AF33B31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mHGHFBrXpwQ7kNvwEazsuI&_nc_oc=AdpfTUaX3PGzD346VrlHVNE-mqfhFnI4wxiZduTHu1FTu6jxztyEc8_RxXifcNxQWe8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFD0y3iMQmiCIJaCis5PTJMwGd9a7GCzM57Q2n1N9V7Q&oe=6AF32B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz5WHA7bq30Q7kNvwGKXJX_&_nc_oc=Adq901OK30USg3qk_P8sS1jhORPJPn_jUXueUTsiFLCqARvoZaR8eflxSVMHWXnUDmg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBbnFSTpyUAIJadHUTp0WIXxkrjexpE1_4m39d9yYOCA&oe=6AF33F9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "https://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
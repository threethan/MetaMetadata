.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSsMZLnSn-cQ7kNvwF0yDg6&_nc_oc=Adogze1Z6VlxBx98_THHFAZRGMYL3pSONGKeBy7pw6ABi4Hs41mEzS3jyKaKxWN-ptk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ePjtUBCSCwAhT1C4qrqB69B_F6652fmFQJ749z7uzDQ&oe=69DCF805"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMgey078lKcQ7kNvwGhrAsH&_nc_oc=AdrEOT3tXkCDv2auHj8hWPMEUpZcVIL-dGu_Jzil7k8Q8nnPh_eSzdb7WEtOmD6xWPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wf433ak8SXkZPKXovKOxow5BUOkFHbLYgMKwKbtMKsw&oe=69DCDC16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHsMcUkoD_QQ7kNvwExmYKe&_nc_oc=Adq40y30Uo0wL8-2vCm-BSFDEZ-JSyvHeKZ0AVGR8oqGelMfI2X-6iOu3yhSioSmkx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3smOpWxoOqFohY119UAm6kBGTIOV_n-QGC6hFCcKgQNg&oe=69DCD671"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzxLi6xqMBsQ7kNvwGlXNkZ&_nc_oc=Adr6uglY7I48_FiuV7p8kiQ4SwCFKLBFYSwXyIxzbHkE5IGkX4UYwwJGQ_ASBEi5Fig&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZT9ZODhWE_BDolrCnc3E6Df-V0PuBaIpO9EeratK1bg&oe=69DCFF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsNbGpU7u7wQ7kNvwEeGEEu&_nc_oc=AdpsZyzp9KFVs9QgnTkcARUcPXfAPYRQADqh4pBlEfWxxCbP6m1QnKrALjC4yvgv-Dw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-BmhDCMdXeTv4vfbTSQYxd1bj6_3f-7_wFUQeMPe92w&oe=69DCDADD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
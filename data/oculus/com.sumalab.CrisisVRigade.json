K&_nc_oc=AdrzE6kTP6wxS4CNfw-0ck-3pK8ArpN10Q05Q8S7j2LVpKMpy84Tu6iZ9W1WgLoQngs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4je68-JCcnD-BP-tFXMihjm56GjN6yHJb60ZichdwMw&oe=6A3D3585"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iffYNhiWBrYQ7kNvwEbQh2a&_nc_oc=AdoHdvJeb-si6hi9md0oCOgrUh4mu6TVp74FzjNqjK25tiroBhXr-7awCGBURVBXVTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nxsS8_lYGGmz_feP993WXIIB3HWIzXtfF3F59quvMBQ&oe=6A3D51D6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cixG-9wP8h8Q7kNvwEz-XaC&_nc_oc=AdqmSx37kKNAhbhadm6qUqrC-Wnn76o4lYQRIEv6LniLpHcHTrW2w6REvU9hcTtb_9s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LHL2b4Pz1p9AFfhY8rhizrHkHUWTA7G-InbD9iLpryQ&oe=6A3D4C31"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdtvm80gWiEQ7kNvwG92wY-&_nc_oc=AdoTWrO9EYrBo3CS7WMZlZMPtqcfshNvKLSg-zurXAgRmzKoUcRuByf4axZZbak9kSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_whdoCVvISF4atEbuZAxx0giHaQlz1uMPP9Uaq2OiGow&oe=6A3D3C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX3ql40T79oQ7kNvwG5A0s3&_nc_oc=AdrAXKxOnjVtOhmWOJotbhp75wwgBerZ3rKl3W_TDl2fY1H11RaYT-MxdUNUv6Nb6G0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yhVH1tX8B377Ea85bCeebzU3iMiQrkQCpxzwpBddaow&oe=6A3D509D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
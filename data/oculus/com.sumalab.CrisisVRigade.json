.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObAo_nou3lsQ7kNvwHBFE93&_nc_oc=AdoW5_17dFT1hT7FR0FKexzBkZzm_81rjasBgB7_-wxAl5YXYVfR9aCb2Pzzs5usT_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBQeJSl68hcbzVM_QsQO3Ro7r3RO1iZFcF1HQ0MqP_Sw&oe=6A7B2C05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hn4xRnZhFoQ7kNvwGYOTY_&_nc_oc=AdrdFComMD5h83gO3wM7XzOlQUAW_9o_WZIMRtVdCidU3pF5oKuI7YGN32fGiTB3klU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE08mAILbEcHCO8eU2MxeUhW66D-1KiVlT-i8tFxOmYUg&oe=6A7B1016"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAJonxtp5ooQ7kNvwE1VV8f&_nc_oc=AdpQBMq7t56rcEIdpjzNMf09eMAvnYzMrp_9wSgpzmmGP4YxAQrrXGdlNGh_MohKPGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAGHa37Zq5E6Ozdgjo6WDvV2ZZ5WFcuUvPa7eFRgmi7w&oe=6A7B0A71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZxb4QDZQdwQ7kNvwFFtgHH&_nc_oc=Adp8Vv6J5iLXUU1r6mPp-NCJhSF90indWBIP_mQlKQBBBssOaKII26dFT3HgfFZikb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDIA2WHYXYJ9WVGZRhoi8rasNgZwHIifua2Gnmam95dg&oe=6A7B3304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUk5-zDl_2gQ7kNvwH4un0k&_nc_oc=AdoPckmdF4ZijWl8GDgSA4unSvsIQGug5rM6_fdmo8iurXT1Xpsk39r0rja1G_jaSsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_P2WJPRaaBCtnFqaodJpQlBK-MMfHub_04fMzFjZGqQ&oe=6A7B0EDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
g&_nc_oc=AdrHKNMBzX6uYJjFpTKF1flbH_Ucem2Lb7iY4zlVDCQ8AqC7NSWGoftYjXXj_2aLYUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TjjAzbacaRQaxiT4br1Kg67UsAMAMMa35d7DTW2iH0g&oe=69F36185"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzWBVGQi03cQ7kNvwEyom6N&_nc_oc=AdqiJ2BZrOaomnG866-xqVKp8el2YeaLRbIvCNWTXF_kiTJHWpEqqxCDKVZJt3clFR4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af066fepGxvjfNi7Tn3xrbciq4sAv1BpE7IfXVlyabAfxg&oe=69F34596"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeD2LF3BNGYQ7kNvwFsltim&_nc_oc=Adpis-HKRGxovM54LlnAGj2SbslZfjXgfB1arWcshUEpwTZxNpgsKy2Ds4ulIjhv9OA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tAzfY8psUGNrXmFHHL9JzgAqSJda50Dmr4aQbOCd-6g&oe=69F33FF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaMAzrHnTJ8Q7kNvwFNBIWZ&_nc_oc=Ado-wsIvNdekbmV6E8AkRTKvSypdO9X8IpDmC0mfuHjUVT-yXGjlAZTGtI6Gqxk5YTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fG4upCQR7LaSTzkjuR6fc2BvBUGJ5cktHvsPqqGd5CA&oe=69F36884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORRfZvHpeEwQ7kNvwH_VfOD&_nc_oc=AdoPUiCmsYt8WVinSIbW5v59FK7zBlArGTrtsa0DX7RF3A_v2C7alBtCYZVeDapFno4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1krUiAExq0kJBtbYeiA46NxlnZiPC5kw9riZpkv7RcCQ&oe=69F3445D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfWQx7KMFYAQ7kNvwEjqkRm&_nc_oc=AdrlyLBA4inDIfgEnDPZOPLN6d38PfGa06G91pH2bb1zR9Z-r6BC-McTfb0DNEt-G4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENAAEF5JnHE90Z7K-5qS9BXTOvEH8TnId3KlaPjc9wqw&oe=6A773785"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0cGMKi4ei8Q7kNvwFSL2ba&_nc_oc=Adqe9pTM5Vt9tjqUaepqPmddPhcwqZhhog3BhWGNtblB7bq7NtTv9iGvg-5ecxPC0ZA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPUPCGVXFYgDXsk8OKyIwD1SyO6XCxtCxiyFDdyLx8Cg&oe=6A771B96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1Z3-rlTwo0Q7kNvwF70xPE&_nc_oc=AdpxpB3aOdWYokLDo_U4H7_lSRsnBJHJF9LNIQ402N3kmjjiHGDZPHoLjihTs28hsiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9tOm-MrsRwhKZAP4X-T6LKG3f7d4uwmLJDK10DPLRhA&oe=6A7715F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xAINc7HyK0Q7kNvwFKHvE8&_nc_oc=AdqhmVc4IMJ9qy0Ktm3kHkJ8Rl6AQ6uzii3KC6RH8nicFCGiAqi8s5xdMzkyDMDkB6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFkG1iYh82fVoHt1Hmnnf0w0FrxUzwk89WHfzv3VKI0Q&oe=6A773E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jafpLNW5DLUQ7kNvwHgZ1eh&_nc_oc=AdqDHHhv3xSAuNQ4ulhmmTPOjNyWp9Xu_ChshrFP53c6gajvCKHD79ynOUzFTk3VRao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG02IVqH5NK-l01TjLv1e31DPxTCGTUjJRi6_zB3yP4jg&oe=6A771A5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
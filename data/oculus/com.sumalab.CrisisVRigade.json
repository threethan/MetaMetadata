YN4f9GO13AwkZ14G4jsg&oe=69A6CE96"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlIx9XbqKXkQ7kNvwGchiWS&_nc_oc=AdkzDvjJve0Em7-7SmI0ioxuE--6teAKz3MbHunw5AoufHOT1Fjhij7Bw5DjAwFLGFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHLDrWkbiwEJ3I9RCSsuZlLgvy8TfoQHnAS8qJcV2GuA&oe=69A6C8F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OFkwUsItH4Q7kNvwFiEEux&_nc_oc=AdmAV5lVcCgXjxB8-yXiGE_XT5DGvm88G6oMP8gygZfa7mDeo60SNURMjFBMxxET9hM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVYbvJJfIWX9tLjWDE-23gLPiwZi-SpPgnwU1mLG9AAw&oe=69A6F184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOyrwmc_rKgQ7kNvwG5wuh6&_nc_oc=AdlmMqOURkXpP1muyu-NHf7Pv2qjRKIgy2TDX5Jk32noeBxl_RsbIsYmY3097Hv5OpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsk6pfrKsvPfAtkX4zbcdl6nHNC_DAMvBo29xeGCspgZg&oe=69A6CD5D"}, "display_name": "Crisis VRigade", "keywords": [], "long_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode.\n\nDuty calls! You\u2019re put in the middle of the action. It's a dirty job but someone has to do it. Together with a SWAT team you will have to deal with the situation and take care of the terrorists. Your mission is crystal clear: finish off all hostile elements and keep your teammates and hostages alive. \n\nBe aware of your ammunition and take cover while reloading your gun or you will be exposed and the mission over: maybe you see the bullet coming, maybe you didn\u2019t,\nbut the terrorist got away and your partners now have the unpleasant task of giving the bad news to your nearest relative.\n\nEveryone counts on you and your first-of-the-class aim. You got the highest rates at the academy, it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "491092572367913"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "917962391169533"}, {"status": "PUBLISHED", "id": "1190068103213727"}, {"status": "PUBLISHED", "id": "2086170428812030"}, {"status": "PUBLISHED", "id": "698154853243446"}, {"status": "PUBLISHED", "id": "1252124919886170"}, {"status": "PUBLISHED", "id": "2071838506648352"}, {"status": "PUBLISHE
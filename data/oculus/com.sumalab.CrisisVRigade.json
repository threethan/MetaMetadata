9&_nc_oc=AdoZUa35S2VTQC934qhRxmX6F-P8BkMn5tSVd_uJbxZuzrUCC6XRaKvxCoZg7dWIgFk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oxUvGXM5klpu8To3574eR-06MsPJ8EkIP-yJBJWj3Rw&oe=69FDED85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFWLo5omq3IQ7kNvwHJEfV6&_nc_oc=AdoEzatbGXemd1LiihNlC-6MZq6gs9Z6gh3dLgeuiCD0vsCHrpzVl6O1918SaDJIQw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QZIVMTGekiKAB-b8J1uQLPGEOcz20hrByUVFwYCv62g&oe=69FDD196"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaxmysQf024Q7kNvwHUGJeh&_nc_oc=AdodOl3xY7goqF3ZLAfieUJO1WSe4E_qG5zfd3j1Lg3ZhUpujH8vzsOSf9BvY9ZGb_4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M99TgVm9Wgzlrcc0W6SN52Mn9M5YDTK0mZ5heAvz45A&oe=69FE0431"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lapfw8loFR4Q7kNvwETb2zN&_nc_oc=AdrFEWELgH9QtlDuQWIVE-LGFOVVfMqW7R18o3-nj41YkeYTHUZLkLyIVn2C07JjS_w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ouvLQxgOQEWZGTRoW6wGm0r70LkBTH4tSF1-_BGvf2w&oe=69FDF484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMQcv-YcJtcQ7kNvwGHIG2v&_nc_oc=AdouhTuQXc1mtMA7jOL7Bvh_pncfRHuWFZ5kDxwkS4Fe0ugb08o0j-IXjLq85SdCU2g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v6Cj8qaqDWSWAomGhZd-OvTt_SHduL6Lu0vnzsuuzDA&oe=69FDD05D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
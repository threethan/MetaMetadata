.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J7OMiTQCbMQ7kNvwF-iHRb&_nc_oc=AdrQB38tcAvPyxVY2epl4alvNk22NsCYVBfrW0zsnmJMpIoIB4DPBy9U1wNcHnwcrA8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaEV9TC51bd_BVgayVQVF6m3USKf592xU8D5grHHCbtg&oe=6AB28B05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVVoqkrmIPIQ7kNvwERkgqh&_nc_oc=AdpCK2IGY05QmCIW_cYvVuFC7SVYqthR3t2FUjaeDb23Jc0fxnDVqqGbNndXKTi9Qio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqGJvVmNL_8DennA8tUG-rdVO5jmfVhl9yAyXKKJP2_A&oe=6AB2A756"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y24p-npF8WMQ7kNvwEwNy_d&_nc_oc=AdoLuvY6RfNz0BlzpMN-h40GGtpITPwMNVRUVERin1I54-EdysrIA1kixo7z_Z0C9X4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWH5XtEF7kqw4Z_MGiqPlGS-vxP9IWRw20_pSZaoWoqA&oe=6AB2A1B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhMRwmKKQfUQ7kNvwG_XHs5&_nc_oc=AdrLBoJ5IASjHZZBft3rO-ItR3WnxGp7dIU0CMCLupqiNMnbaiqcPTJdp9D31ng3rQs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMmLiB7pYb7wZB5Hd3kSqleBcQO5R6qZKjFLGHtvlsfg&oe=6AB29204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97OfM2mA4RoQ7kNvwGk8QJY&_nc_oc=AdqiavOb6J0JN4bzmLTmv53eS4FvBJR7vwSIu2UfFVLV8m7HDnl4xGhk4oRso8-qXAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpRa6VRFwjAtgfxHk1xUe68yDOUmbSA2FIWX9I6S3aRQ&oe=6AB2A61D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
wHFR_-l&_nc_oc=Adpeg6apZAQwq0Xhv5meGvCg7ys69DCQ9aPqTgtYN1ad30O62HpAx7q7EXXzjONcunI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pVp9TPtZSseq5LskOmM6_SSq8QdHgCgclCDLKsbxdLg&oe=6A369E05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw5E1Tk3boQQ7kNvwGC1hSF&_nc_oc=AdpVMCJAP-nlHe3E61IsPHi6JYarXvGiGGxHSK3KukASSnR21Nb3ED_wtxBScy33T5A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L7yOEhmYw4BBPvUyr8qE37KuIVQJsXs4a8vLfUrBhpw&oe=6A36BA56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urOznpsx5ToQ7kNvwF-Gesv&_nc_oc=AdqgfB2yOiGPx_e6AG-LWKXoiF0DLU_W3S6xUw1LnHdKAzyplB-1fd1x3YTSWstqPSw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CUyEWlH3sTPhzLxGuv7bjf9e-5w6yw87WPXHS61cnyg&oe=6A36B4B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzPJ9RLGcKUQ7kNvwH0Ucj1&_nc_oc=AdqQK7JGAIQ8DKUqlflUYU-WNcGXVnoOWcHluoh7sMq_yB8steg503fB_mM2h_mi3yY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SkiPW04bpwSg6dUlyOPWIsYkYbyN1rf9MRdf9EjUiuw&oe=6A36A504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2iUZi8b2toQ7kNvwGsPXfM&_nc_oc=AdrmG_AqNygqHRxkGP4zqv4h9oqEyut76qs6kAj0mpJWYA4Q01CeMGWii3dqHpBawkA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J2W69bLnL1GuyqwlfyRjatyAWpfMIgWxSAyRhXElmOg&oe=6A36B91D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_a
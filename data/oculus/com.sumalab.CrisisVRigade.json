.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STBL3mCTbEUQ7kNvwE24hG9&_nc_oc=Adpj3R5hYbLk6OiL8CZALa9NqXXQaMbt3YkBWiVQY8N7RfUgFKb-ENjAtESC4obaIzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSjXge3UrNfyx2Tn-lI3020GGVHvUThiEhuehHELolLg&oe=6A6B5A05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3c3bCPp6VkQ7kNvwG62mfR&_nc_oc=Adp8t0tkA6T5ZpBf1lVq8HTWnt0iPP0dOyEKU2_fEFkgW-60hbU-P0WnVd05OdYdKaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkomTLp96n9D6n6f0x9TjQPKC3-k8u4ti7demuiruWLg&oe=6A6B3E16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMNNTaozk7YQ7kNvwELZOU-&_nc_oc=Adqb1ZSxdwSKSM-cxj7MhgWXjW9qV7cu-ODtVDTrDX_XFZoNvIeRKAIpNxylCRxt250&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrSOJyxKeF4smaOZ6kA7LBOpGA074rwCsT6G8g5Lqplg&oe=6A6B3871"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27rNhbx63WcQ7kNvwH7UZ10&_nc_oc=Adq7fuY_J1lSH4e5Jb2aIAJqw8Esq2rU1Ts-CXsXrvypO4YCJRJtiXLGJXfM9xpd_cs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWbGNIEF9BPVSKA2OQc3VbxTLDfxdzny1h6ZxjAaMdXg&oe=6A6B6104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTUUMtUHIwoQ7kNvwHkAW6y&_nc_oc=Adqg92ESv4ozW8ecv-O_1NLXyaevJ231ObAkKXJHVee6KdLatMXXWTszzuwQ41Sw5HI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhRm1FtId4XWbGOdkDuBj5aZxO1mu28oMov740sMw5eQ&oe=6A6B3CDD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
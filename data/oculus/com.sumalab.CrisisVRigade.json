K&_nc_oc=Adr122lj7VLJdnEoFt0bduzF6C9UPqcZE7S9EPk8sF2lVfsw6Eca4Zn5N8_Wr31JkXw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SwiOjrv-4ip1rKcop3RnDUxepN9Nb9qXjimTF0WTdRw&oe=6A1C4005"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONiluvj9JoIQ7kNvwEVcdTZ&_nc_oc=AdqfhfIzZgk_sa0uq8lAdeBNiFLn1sFn0Sy46bpNGgiLS5wViNczlSwf6Mo-Y8oKAlk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qqTkRov1W-BqZ-yhXSIifmQmu87oOrxOhAxwU6uR-NA&oe=6A1C5C56"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7Jg3tLxxhoQ7kNvwGawqnR&_nc_oc=AdotFnMV93HbDhCAWVehKSxftSLbrbwUTT-g4ymk-vegvCAKimmh4mD06PCbbU95vZ0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6toZS3NTR4R4XqY9SJWBBw1jfajcO1KsUM3TTsr6kS-Q&oe=6A1C56B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deZDl6BOzLgQ7kNvwENvdw6&_nc_oc=Ado0VfL_ywADw45JBR1nfQd-HaSktHi8pk6dTr_5GLX7bflA1QHR9P2D8mpBVMXY-zU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oDYp0JFNmzrmeOuogWHodZQAbGwZ-DlFqI50XAoTXdQ&oe=6A1C4704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrivZHe71WgQ7kNvwEB6317&_nc_oc=Adpz8dKAvX-VGBFcXHRNlQt3_SZMhJXsGVQmLduOTQnhl-EQ9zlpvftJ7vOvojdqW2A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57-aJwQVqF1h8-hEKpg0L1PlfUqCsMMuunFJlpubtTWA&oe=6A1C5B1D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
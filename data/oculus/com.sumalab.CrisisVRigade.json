.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wafs9BfeUVsQ7kNvwEEPzQl&_nc_oc=AdoYeSBYBFx7nmY5OTKM7ohp-zdIpLVHqP1laA66hrGO-FmwqR4oI3rAae3I7MSuRow&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaOdh5xy-WJpeDy8ng7p_yyxPkzmCxXKJe5mfebNGa3A&oe=6A5B8805"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M0sUTtgg3gQ7kNvwHTRFuW&_nc_oc=Adoqc1cFIKR0i5qrWJYWDNUIEIqp5B2_bu0G5OWvJvqfqHrsXPHFRZzdNFF8mzpqjgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ2qpYegrT3uIfY9ZPo-VSgpuJ0exJr98nTTCjoEyXBg&oe=6A5B6C16"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_vBL59Ho_TIQ7kNvwFP2HhW&_nc_oc=AdrJjoeswmXeOfOZ_allvP3dqDaB-RlESSruXsZ_0RMp8V8dG-8EFWQcxuJzg3Ek11c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaUCf-HdE0GtEEhhi2KggTWKKSgq4AVQMuIa87W_uVWQ&oe=6A5B6671"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amVvWJtabJcQ7kNvwEfouao&_nc_oc=AdowRdCL9HoZAMY_NEex_WBd55CbUl-kzcGlUCAJqAXvJ2US66eTRLuDJpBDgpk2Aeg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBelmUZEzTbNjbiT82p3x4ZDw-6YhafkDc4CKJYnLTeuA&oe=6A5B8F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWuVKd3NOfkQ7kNvwHm1FLQ&_nc_oc=AdquAMKQZhNg3jg_ot6zG7DnX8yeOotywX0vT78iTKEDxve2s6U_jDJ815EVRUANHwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXmiygtGjPmxhmj70kzh8Aeydi9tn7yGVCcR0iPo6aYQ&oe=6A5B6ADD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
R&_nc_oc=Adqv1ZEG2rSArPoOvOLQqgq0zV94kfiiFBSdmFHWOs2fpWxymuXluUaAQgcaf6x2s60&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_BZQMgtdm4vuqCU6l53WV-022vEEztjEx8uFC9httjw&oe=69F60485"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzWBVGQi03cQ7kNvwE730WZ&_nc_oc=AdpLs7cHiQr56QpCn8Mw1yzjlpDnmkLEzMeRmUpEIxVLvbMaVREQMXM1OPKukZE86Rk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0P4Ykn9ksBJfYSnHWce3wCNQrkPeQBgzDJLT0I5wnyQg&oe=69F5E896"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz33-34IcoMQ7kNvwHYCLev&_nc_oc=AdpQdJagHUQdbJaKERBQDHYDWPwzoVSA8y3-5Xdnr5Ik6ERY_8iWCJJRY-Qwbt8WoDE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30DZ-YiuQf05QzrWgJsGVb-53un5yJMmIrmykzwaP1KA&oe=69F5E2F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0F_le7rG868Q7kNvwGLAnDy&_nc_oc=AdrLTV9E617X3Z5w31CP3TsttEd9zy5p11iw9C2norShsRyvpITLLSkVwfjMaUeb7SU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wWDsMSt0QmD5wBpzqzmUsoyGY0vWHSWrhWs38DxlW1Q&oe=69F60B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du6r9GkvEkUQ7kNvwEypnf0&_nc_oc=AdoVVcKleEcUPLlR8EpIpGk8YYOZ-CUEiesx0NxaTvVIiIZ4WnTFaH-RwtWoidzJf4M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Ct-7JWzpj6AT8hLOZ11UBpPTu73c4-NmSVQfIlYZ2xw&oe=69F5E75D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
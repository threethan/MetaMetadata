1&_nc_oc=AdpG4qa-diPS0q3anIW3_enBkx-FcBp1PeLYswYx9R-CSmDGQVX9Z1957weAMc0S8TM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iAai_dL64PPpW3jK-XHEAxdbxaKVLXtk6ca_9Jc9Uqg&oe=69E8D585"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-wvYla_Z-kQ7kNvwGpsbq0&_nc_oc=AdorPuChUFYf_55R6SnEWeuVOcuJcWldOeROaBUtKUN8HpzzMZ1we4u2Mai5W43pyJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WGvAGSQuIMKYKU9XbNS2DMEQuIh_HXzd8L4XDhHvu-g&oe=69E8B996"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_dDw3WXWKQQ7kNvwEs5k2G&_nc_oc=Adq2yHkrbgQlHkg7sU7m9Bz6sOQaZsVM4O8v6gW1BHKNT0ZMiwROvFFfjgLjvgBcCdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CBuKsZi2KkHp7p82vY0pCAJ03i7QAlfJ0TCYDBCPeyw&oe=69E8B3F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfaP3Tar6S4Q7kNvwEbfXV3&_nc_oc=AdqaU2FBQEB3WCdMEWIH5PQmGBpw71TFlToZ31xg0LeTCW7hBkz7ifFO9maGhWFKMUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CYkN5Bn1lED1sddNkXq3crQeEzNQahmihi_hw5bk4VA&oe=69E8DC84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QbaM_43xH8Q7kNvwHU9ZdQ&_nc_oc=Adp4SowRhkSc-UlHAsq4JlcNJ_nPOzFJG5lx96hPYjt9O2-_ErxayzWQh8Bx6xMPKhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V3eOp_pOeAWMfxeT3VrKEU0W9P0AivTAySdvDKeFQIg&oe=69E8B85D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
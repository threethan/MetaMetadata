.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DDD4T_0l7IQ7kNvwFAMgC2&_nc_oc=AdqPdOv_u42dSRKihHb0FIeM0czzBKLdWmyaDdXNIkli_zk54My22gK5nyrCQ_h2zV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrh34Q5l9qa9vUB74SPDMtgkhF7EkV2OZt-1vCztiAoA&oe=6AB92285"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0x6r7oLjE0Q7kNvwFZ7-pC&_nc_oc=AdpJ4lBxIPqCtqcxKIZyQNbPoeBEQgAd027VaJp7V2dm0Ryj_LoDNCa1fgSaqa0J4IM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU891alnnCjUVjtpTdOzFszdkO0Yhq0VmwH58dN8gK1Q&oe=6AB93ED6"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0QEeQUZQ5oQ7kNvwHvr7dv&_nc_oc=AdoZNoy0-n5D49mf28hqX6k-Utvb0c_3IUYxJ4RYzKN1bqxsV_1O2tOmuJOSM3B34Tc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWEFMDb31PtDcbL6kEI0TKL8VmWNMamYerUdlK8ou66w&oe=6AB93931"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2qHp9HNtEsQ7kNvwEY4sTZ&_nc_oc=Adpza0aLFiW0Grtps12ZtCYBz81JPIutJGQ8A7s46CxMp67709tjEAKWC5J4X-kHnA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0lUtKmCi5uKWjrRnTvEJhK9BLR1AMRkwnV7qBU8I_Fw&oe=6AB92984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt1jeUvgSA4Q7kNvwGew0E0&_nc_oc=Ado0bAFvd3MBDIX18iFm3WSJ8lWo2wPsGocYo3RHgTuwzfnSPVHJW_6qRpKFgJdIfYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxvROz4EcXqyx9gIpWGudGT3f_5UVfa-c0wIhnrIwZDA&oe=6AB93D9D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
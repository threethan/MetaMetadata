.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfWQx7KMFYAQ7kNvwFoF2n_&_nc_oc=AdqOdorwOTyJL4XHy-cupkx7BiULlr6layygaflG0ltchq0wUzEXHXFg62FiVncEA0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGINR06CM2pXcQSsQLiK9e4AL0nUCtyFaG5NbOAmJ76yQ&oe=6A749485"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75yo4oKWNFcQ7kNvwHIfroX&_nc_oc=AdonXSGcV4fwbVg0DINXTrzxeS5AmKH5sC_mSOsRn8c7Qh9iVBaVH_jchWAJ1nexWKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8bntnV3XmClNCHRRKs26NAypz9BJ2GNs2AOQiipBYMg&oe=6A747896"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1Z3-rlTwo0Q7kNvwHt0-BH&_nc_oc=Adrgx_DgIZauAShazXDmQvu7a1KMKkjTHIC8LkG4bBnUMXD0YondJa0Av7LoUzEeYUI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyzjQ83NStQ2zRsz9jzKNkJoSlBbG4JCaA6U1yw2qm7w&oe=6A7472F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6Sl8AqAfI0Q7kNvwG_ZAXk&_nc_oc=Adrwh59q1O1vDSjv9srCUqbIMW7XVvpFEJMouRkDhy1ZwxZsHBPXrVBo19vibZ4mLy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHusMlzfbDWEb2JHgU9ILOBoRncP76uODjRfMcnFtglGQ&oe=6A749B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jafpLNW5DLUQ7kNvwHhkY5u&_nc_oc=AdpIVq287a_3cYqjzO8hkOtQip1-lQjrBL8wOCPXd-9r0qplIJ4-VXex3sAhWhKpwRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFXxNusj4xEe54ZPK7fja2wI-x084NhN9iiSlD9N958w&oe=6A74775D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
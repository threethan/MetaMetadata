78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JoZKQ8RQHYQ7kNvwGbh46n&_nc_oc=AdmYqhbC7ah1DKZonj0-usmDQFhqdbVJCdoVMDk8bFUlmBDCUr3Xa5DPolQ941Qe318&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOnCY0byEq8QBO_Xcoo2sQMPf0HdO1uHiO2MTAOzVZwg&oe=69BAB105"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_2y1fjepuYQ7kNvwGCpofD&_nc_oc=Adn4tUdZC1igsH0_Sjftk-vroqbNLK_ZoS7QlGeWswrIsIVuOTQOzJBZPO8sLxYhcIs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqYrNxeop_ri-HqBR008brkX4Gwg8eppSdLeplwyE50g&oe=69BA9516"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keEMW4H03M0Q7kNvwE29-aA&_nc_oc=Adnv9e5gKX6SMfxpGnANVKLulhBS7tTvs2my3Nq_l2CGgh8DvUDPRi42m5f9xcmrWUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0RtYrjMXJmCSslD3bNlJm-K7i7Bfdv9lfjjRemTcmXQ&oe=69BA8F71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVGgeZ5Bw5sQ7kNvwEUI-bq&_nc_oc=AdnLilT8mqI7D1UZQJl-70qrfGeE_LlPCcroLUbavBTjwIIltXwdwkWF80gD81QOHb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP0fxWmQFej9E3CrUPE-rDDAtyMSsmy79H6Hg6lvHK8g&oe=69BAB804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWp-o2yEYE8Q7kNvwF_1CZr&_nc_oc=Adn_uUd3InewNSHUo4j8SMPSIMHari-cOhwi9Ertbu1AtqGIOW05MrrThFFfMRgqKkM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmZHrIGBROcXftSLp554CvGxMFW61jnDk4TOB05_F7OA&oe=69BA93DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGZwxFkkwDcQ7kNvwEuPdi1&_nc_oc=AdrRQmvGYf6nJJQMrz1j3hrjKgHNQm9EpP00BPnykdU_55Eron6eD587G19GCpnKPH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhIzT0PEmUeU5wY6UIGQPwsVuLL35r_0eFrl_nHgdjVQ&oe=6A5F7C85"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-otIgecCRcQ7kNvwFNTFYi&_nc_oc=AdqgJOx7iqfbRUBU2b4GSqoHmRLWQRnQiMHVnvl_qRufvw6BuRrzwKXqnDI-bAmHlpY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXONoyI24Qoex19eiOQJ5mwLw6UXOl-pa87fsMjVddQw&oe=6A5F6096"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86YJPXTs1s8Q7kNvwFE4rtC&_nc_oc=AdoJvUwbyKQDhqEA0ETG68bsTgYJeUJUB6HNr7uk5PY1rC8xeuDI05QeLOARYYwwgOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD7lonXHWhrDDnxqHSFmxkGD5JjuecZHUXaYT6wWrksw&oe=6A5F5AF1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glqPsZ9tUkkQ7kNvwGtHTWR&_nc_oc=Ado7aG3oafv75H3Y5sqo1eisch_kIfzCaShb_8lmcywl6n8Lh1spX9GC1GXUWIEBUPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAjIv6KErYDGsVSD5v9l2bYv0UyvRH5dpvWWa0k9UhFQ&oe=6A5F8384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpyDET91wg8Q7kNvwFLNz81&_nc_oc=AdouxyMwnkq9-8EzC7y0qeWpm43YiHtvvrD6-DAivAhsY3-2Q1zBc9MP8mjIh3lmrEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFaTAMzbtxa_AcPSFXUTcW1FTzvFOywuflEIvDsQlSWw&oe=6A5F5F5D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
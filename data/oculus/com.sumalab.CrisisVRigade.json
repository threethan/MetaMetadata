.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UTOW4NcSWAQ7kNvwEkZLRd&_nc_oc=AdrNyG9vLBB_lcasvKNeXKOJ-j-gbUXa1rZehf_1QcjiC2bV_1bkxckMP460DaTCXSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M1Lmk24AsWNrbCUz21kNEMqOQgE0hmE7I6fzGxKtBrA&oe=69D90385"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWk-8P0scPYQ7kNvwEav5_R&_nc_oc=Ado3GMBtJi9Wuwv1Ggb_W80qhayNGOa9vWKrz4cv_LX01KbZR-S860mvpINaRPPGY3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32EBwZhqRFKOZTs6EUq8SXShbJMtduJgT9JZPD8ILuxQ&oe=69D8E796"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgNt2vo3WWUQ7kNvwHTFnef&_nc_oc=Adr4AiZgq2kXjbcehciS4bTNKnRQlY61mdbf-Uq8RwMBzd4-KMds91EiMwLYX6KLuLo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04SsKRXGBbDiUxFw5SQi5kYdEItDZGnc_cp8p476Z3Xg&oe=69D8E1F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVl_eGPD-xIQ7kNvwGHJfye&_nc_oc=AdqXKWsymyIwk89_bqk9SpmUEohukBGhzNvCTPtVEFYG8Weyo1qBKuSvcE4Q9svMIIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02DKF74Zt5PHrI644w27AJMaYgVcIM_dmADNspcn2LQw&oe=69D90A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAntidnlVHsQ7kNvwFD_TRJ&_nc_oc=AdpmoAeZhuemX_zek1c4cgaHWvKI_4dBid6aIYkjg9UKbHT2tlcUB_TV0pOF_VxG_tM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LqsqlKiZYFKmkfaiwVyQfgllvqgIGiAc4LTGPnTvY1A&oe=69D8E65D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
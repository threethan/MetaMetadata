.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_tpfx1KsxMQ7kNvwH4OzDI&_nc_oc=AdrCA7qjorXzs_ZECBnZyJABe-phLuVA-yx2yc01I-KdcNxJQAbpNkLMQFcTGfL6FF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi6cRbtb-c74r3keVhVhf6A-Webn7-0rEtDqE5yTj7iQ&oe=6ACF8C05"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKszllmLwH8Q7kNvwHfdhYD&_nc_oc=AdpZjkElYh0Qf2xGA9ghsMc2IzIKasoCNTlRCccRE0f76wwJ16YCivK1380xw8ur-0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsfi4rJ8QsbXN4LDNErF-1iPROkW1y4_N397pYjXhL2Q&oe=6ACFA856"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRA5B8IYuF0Q7kNvwGBnvNZ&_nc_oc=AdofuMX4pWn7zSUOJY2mkKe9qWgeq3d6kFYR3SF9wwLbiFodDlme0a4mVENu0ofSW-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMouK2u_GwRJMVLzRt3N2TBTGgtcWd9H62kNATuMpjf1g&oe=6ACFA2B1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqobPBg6PDYQ7kNvwGC5AHV&_nc_oc=Adr6XBwMI884Ymp0HbSS_o2uwrCiQCAxnf5ltbh-_0DMbMbrZ-8w6bCpIv7zpOJrkyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6KqAyHbVLG010iH_55RFjWdWNvccj_ZQ09ZxL7hnz0w&oe=6ACF9304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GZ5DWr8WPYQ7kNvwHKevUp&_nc_oc=Adq_YcxLzGCYvV2-Rmz12OOIxGwF4uzXkiF0F43XwtXnfPHnRYxuiBv4LmubsrkxlZ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3vrzM1U6fIlrA3K4jnpPeQfX81d3Sct36prnSktBn6A&oe=6ACFA71D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
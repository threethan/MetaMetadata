.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI8NSjc5dhoQ7kNvwHk51oU&_nc_oc=AdqZMAOoGppzhjCwXwGg64zzUicH-ZEUopUM3LhLdY1aFDYqRmoQUYOCrl8hU3d3uDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0X8tN0Z6hLx3v_StVfIxaZeLfYR8C9kS2poDWZ-IFyg&oe=6AE74705"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbo7vSxu9bkQ7kNvwEQt3-N&_nc_oc=Adp1rPBlqkYS1CzuvBGNUp5HjHgsxcQJr-MHYTb2sMqCmA0yuQhv1eu37qHjSR3ECHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-wMyj1BJnlh2cUJsEioNpo4011RsweaXy71mKKQotSQ&oe=6AE76356"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VN2JzAvLsoQ7kNvwFzZlOC&_nc_oc=AdpLSzgpqIxTUyicp0E7wrTi-xr1Hm-e_426Nhc5CvXDuRuGEqAC9HnILIF_WduHpgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrR1zqOB2aWD9eqc85tVNLS_lTCGuc62yRB8ETMIVy6Q&oe=6AE75DB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooUZ0WoqVSUQ7kNvwEdtU-L&_nc_oc=AdrrUjn6u50hBJk2aKFHXK4f48Uo4fDU1FHUuGtRpThI0FutzqjWygXXAZqAfopL5pI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbUGVvE8B-wBaWRju1vtRHQK6lXzHUAOxetiKrwc1WAg&oe=6AE74E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMHS6udMoZkQ7kNvwHvBN1W&_nc_oc=AdqA-0YtgISr9pzbeLvTDXOaIr2eMvWVRAFoGgjxqa-rgiPM6O5g9OSFbG5_gW0zjdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIr3KM0nYVVnamSEcDSSZnUSR8bZjLFa8KkgsI_YWAdw&oe=6AE7621D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "https://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id
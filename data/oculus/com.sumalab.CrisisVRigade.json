.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwFS_rkXqiYQ7kNvwGwYD09&_nc_oc=AdnXlV_ayTRByLuGew_9g8C1bhGjDoF_aqGjHUb50uBuz1sEzt8-gAiVi8-JBs7SqcQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsYYKmAQccmjla7e8cAOQB9szNtEbRFR5lZeU_lPR3ZsQ&oe=699AEB71"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8u2IgW_qv7cQ7kNvwHKgtiP&_nc_oc=Adng4EokZUt0hGd31FtE8bqPnfrsDh246u2GTJVgWd5AhEL9HhcINA6aSTtobfcgUfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvMfoCdaV4zeu_kv_TC6vNbnpe8Z09-7zkHigAkwxYgdg&oe=699B1404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9L-Zpem8sJAQ7kNvwGjEnPc&_nc_oc=Adk2ykZv2kIJgApjFdsYGoiIAP0P-9K3KBJG9Imx_006O65bY2VVXpmGEnlAVgdbuzU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfteDUFz-3ZWsb0J3A_Myv05bPcee1doUk_b2B4ey5Wh2g&oe=699AEFDD"}, "display_name": "Crisis VRigade", "keywords": [], "long_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode.\n\nDuty calls! You\u2019re put in the middle of the action. It's a dirty job but someone has to do it. Together with a SWAT team you will have to deal with the situation and take care of the terrorists. Your mission is crystal clear: finish off all hostile elements and keep your teammates and hostages alive. \n\nBe aware of your ammunition and take cover while reloading your gun or you will be exposed and the mission over: maybe you see the bullet coming, maybe you didn\u2019t,\nbut the terrorist got away and your partners now have the unpleasant task of giving the bad news to your nearest relative.\n\nEveryone counts on you and your first-of-the-class aim. You got the highest rates at the academy, it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality action filled first person shooter that lets players take on the role of a SWAT trooper and deal with terrorist situations. Play solo or team with your friends with the coop multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "SINGLE_USER"], "id": "491092572367913"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1190068103213727"}, {"status": "PUBLISHED", "id": "2086170428812030"}, {"status": "PUBLISHED", "id": "698154853243446"}, {"status": "PUBLISHED", "id": "1252124919886170"}, {"status": "PUBLISHED", "id": "2071838506648352"}, {"status": "PUBLISHED", "id": "667900035690144"}, {"status": "PUBLISHED", "id": "431436686573547"}, {"status": "PUBLISHED", "id": "3615855601796117"}]}, "baseline_offer": {"id": "3615855601796117"
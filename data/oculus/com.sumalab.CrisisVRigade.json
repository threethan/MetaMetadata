.5771-25/75458098_175636257653193_7328413935578852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y89yFDLX6qoQ7kNvwEpBfW9&_nc_oc=AdoLt24UQFZPkRijyoYc8fTRqfbEjs_u9_uGEZ5ntUSbHfc2qRwMnxEmZtPE-Ar8j4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAO17m_C7fp-U6viAixO_xw0n3G9IaD7Iu-oWWa6KJAmA&oe=6A64C285"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBNgFJiX3JYQ7kNvwEtJjMd&_nc_oc=AdowT3ZqPQNou6A8VOP43gZhIRUfyvXk-ATcYb89ZBUGtb54paU20MwshVeLDvBWOMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSygGzf8knZn-KCHnMqGC6HrcjZmQ1dDigAqpioG119A&oe=6A64A696"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ge9KcisqdwQ7kNvwFip5Mw&_nc_oc=Adp9xI1BgUjJBMkONLpBx03oPBpc_yIEZbz7TxarVFuapiX7gRaqr1s56EQLFZI5H7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWzdKoWwNrtgdlbITutjmZT2W50Y7v9Qeqzr8QDwii1g&oe=6A64A0F1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfoWnGhVU-IQ7kNvwH3EN-v&_nc_oc=AdqxJe3zAhJ4jGqfyHiHUdlmZK0K8jiLwqiIr-ckV0mW3B6LKxcvyCNSX2uAyCqJu6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh8a_xuhtAKQ4nNJML2LwRfqlkIzoVHag_LAAJiNE8Xw&oe=6A64C984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-cn5GGU5EEQ7kNvwG325aq&_nc_oc=Adre-Zxsyj9F_jRu0azDLnU_vFnhpPYRWgI8S-MZbhTUxK6jI-OV6RSdVumhYIicjx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKziw8TwA0Czq-ZKHEwuzPjDjPZTf0ctm9QlrRZyWrCw&oe=6A64A55D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
78852771_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JoZKQ8RQHYQ7kNvwEE_6HN&_nc_oc=Adkbcmp_SpStJ7xHZUnDUj8k9WtN9O-aQjOtnpAIJSPmCZMmY2H-FuoaCIvaxt_Z1mE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfykiV0tvldqxhjW_MYb-tzTC6DgEh2MIHVGUzh3wLF6pw&oe=69BD5405"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9VZ4OAeJ2YQ7kNvwEdg_qD&_nc_oc=AdnjGwv960hjyje7TpoAeY54hlhlrJGFJfFoLJS4Zzunx_TWod5yIXTp-nn_Me5X7ws&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5ccme7x5g4dOIJcF0Dd67cali6rnl10FyyCD0FSmg4Q&oe=69BD3816"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keEMW4H03M0Q7kNvwF2f3e3&_nc_oc=AdkHN163EF6LJ2zKLGZ968hohLq-Uo66_5cSWtSZjFJ0HK_pRwU-lH-0F8OcmvOFwpk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcV1cL0jJGhRF-GPoNCnooccX3_H5o4M1VULOg0xCegw&oe=69BD3271"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gEQt_ykNroQ7kNvwGoSiOZ&_nc_oc=AdnFJmFks3m2E3z2AO8Mkqnxinvjkz5nqwzmYwpd2f1qoOw5aP7qzGc6I9_bTbMJTq8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2uvkX2_yAASqXQ4QG6z3VdG9VZU_viATtutER07Eh3A&oe=69BD5B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWp-o2yEYE8Q7kNvwEvmyNc&_nc_oc=AdmaMaXQVYnqTeMpsJ1LXAn70xRBqqRZ-Kxqfmg04ziHEZv4XzYmRcFuOBLIinf7Q0M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQ9GFgh6sqUX7MHk1YunWkW4Bdna2yFtAOzruMwNGGiQ&oe=69BD36DD"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED"
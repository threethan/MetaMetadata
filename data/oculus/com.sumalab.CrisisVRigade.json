W&_nc_oc=AdqZqqvpgu3Zv3fvQab62C5D3l7uB6K5KavvyHNKxPvRUCKWqTXyQsJX0GOWZhmknZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qKOfD-yeaYLe66eP65wqym0LJQK2ZJtG1xTseS1T_rA&oe=69F9F905"}, {"file_name": "screenshot_2.png", "id": "785319099007255", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75476757_785319102340588_7231434580565886837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0cQIkrB-GEQ7kNvwHFL_xz&_nc_oc=AdpOrLCxDqPFPRnrfk_MYT1JBzRbWBDNVjvh6kqqXGjd2hXmauXCpTcOZWiIpE6Pl6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BFuXS6k5-XwZJScW_QXN7qMbUmU9cYrJe5kIacYCjFQ&oe=69FA1556"}, {"file_name": "screenshot_4.png", "id": "708705256496072", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458098_708705259829405_8803113716442490122_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvHo_lAjEP4Q7kNvwGnTA5O&_nc_oc=AdprwXjnSInVgdCMyTshqgIna8KsROMI3S0iJ2cWrwUYbX6lr7k1nY0NM1Tbq-8hHgs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z_prt5-WP6JDCDhRCpklWV2w-zt9RwmR76WnJrsuYAg&oe=69FA0FB1"}, {"file_name": "screenshot_5.png", "id": "849308229197408", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75295292_849308232530741_7781627022644428508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpisEuIOLvEQ7kNvwGbMvmk&_nc_oc=AdpEm8-kXEI02Em8KLusPxWkP6SpS4Z1LqSz5l1trURW9nFHE2MG7YH5XeXN9qTrRHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iMt4zPWNGWZu4wmSPMRqCfsJ_-Ytqz8o5oCUEg68qhg&oe=69FA0004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot_0.png", "id": "769625846989375", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75458092_769625853656041_2552122811397093536_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpjqtCYWS0YQ7kNvwH26xxl&_nc_oc=AdrZqqPw9x1ufRRG5f-ARpe3GIBqFk7EI9vCvPxXCTpQ6dTj07v7hvj_dhs4KVI7Bpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mfgCOeSobF6X8EUKfdaVhU6AdYpNtRkyt9tdoWtGrag&oe=69FA141D"}, "display_name": "Crisis VRigade", "keywords": ["shooter", "lightgun", "multiplayer", "coop", "difficult"], "long_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode.\n\nDuty calls! You\u2019re thrown into the middle of the action. It's a dirty job, but someone has to do it. Alongside your SWAT team, you must handle the situation and neutralize the terrorists. Your mission is crystal clear: eliminate all hostile elements while keeping your teammates and hostages alive.\n\nBe mindful of your ammunition, and take cover while reloading your gun, or you\u2019ll be exposed, and the mission will be over. Maybe you see the bullet coming, maybe you don\u2019t, but if the terrorist gets away, your partners will have the unpleasant task of delivering the bad news to your nearest relative.\n\nEveryone is counting on you and your top-class marksmanship. You earned the highest scores at the academy; now it\u2019s time to prove it!", "short_description": "Crisis VRigade is a virtual reality, action-filled first-person shooter that lets players take on the role of a SWAT trooper dealing with terrorist situations. Play solo or team up with your friends in the co-op multiplayer mode."}]}, "developer_name": null, "developer_privacy_policy_url": "http://crisisvrigade.com/eula.html", "developer_terms_of_service_url": "http://crisisvrigade.com/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "http://crisisvrigade.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads
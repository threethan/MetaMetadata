eH0OvxX3T7xtVg&oe=6AFF2413"}, {"file_name": "screenshot (3).png", "id": "1112223371485915", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499626728_1112223374819248_8982326543034472794_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQzI2SGbRzMQ7kNvwGO7qbC&_nc_oc=Adr1PeegGFCYn0cMDDvjZE5GRkRKOa_uvVabYZp-Zmmj-cpD-RBwHmmGUhuAEMOZ1S0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe8h1t1na3jYJS7i_azqB05WOGssXPkuAY5ZxgXcvYIA&oe=6AFF33FC"}, {"file_name": "screenshot6.png", "id": "4670495713179914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_4670495716513247_7491273190052097010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqg3BDjZyuQQ7kNvwGMChSf&_nc_oc=Adpp5cmntXmbjdK7I3coCdISy8VxrGt58jnr2f98KL5bzdCc6xv5LL8WoEQXR9vQXZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtTLh1bNf3k0QK96WE1krcAIwJ6cH2VPBCVznmDfoDiA&oe=6AFF0C8C"}, {"file_name": "screenshot (1).png", "id": "1673840887442595", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_1673840890775928_521816420773614370_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33ODSoQQ_dcQ7kNvwGjTA9Q&_nc_oc=Adr6bDraZLwossOV8lc54qpW8TmqBwkzX7QJXFiLvUUXn4PVzObbLbhWY5NEB9gJbYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOp-S5C6jtnglXmrBW_qbRrIDdtuRaBMOAYII7cxXE7g&oe=6AFF333B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ropes: Boxing VR", "keywords": ["boxing", "sport", "dodging"], "long_description": "On the Ropes is a VR boxing game built around one thing done right: the feeling of a real fight.\n\nFace off against an opponent who reads your movement. Watch for the wind-up, slip under punches, block with your gloves, and counter when you see an opening. Every punch is driven by your own arm \u2014 no buttons, no combos to memorize. Just you, your guard, and your timing.\n\nWhat you get:\n\nPhysical, motion-driven punching \u2014 jab, cross, and hook with your real hands\nAn opponent that punches, guards, and reacts instead of standing still\nBlock and dodge to avoid taking hits\nA clean, focused fight with no clutter\n\nWhether you want a quick workout or to test your reflexes, step in and see how long you last.\n\nMore rounds, opponents, and challenges are on the way.", "short_description": "Step into the ring and box in VR. Read your opponent, block, dodge, and land real punches. Simple, direct, and physical."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1074665754944840"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3667838076712035"}, {"status": "PUBLISHED", "id": "2255968211642606"}]}, "baseline_offer": {"id": "2255968211642606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "3667838076712035"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1123944326683649", "version": "1.0.4"}, "
9469902996628", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821796_1129469906329961_8651100498909643493_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlvHTsRqvF0Q7kNvwGtVzgu&_nc_oc=AdrjIlGZlH9VPEVcvSuCccuzppIdDQIFEbYEqpuXL8RmQvH5pUIrbHRUSqDk2BzEj84&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwlnbLhqWSH0OR74GYMvOcDwDVD-q82zr7LdcoOgoG5A&oe=6AFF0BA9"}, {"file_name": "Image Sequence_001_0001.png", "id": "2229660340916839", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593716858_2229660344250172_3536162062990748219_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er8K1nHM2W4Q7kNvwE5WgSy&_nc_oc=AdofDed6aoEMir0X7rrLU3dpQwT5FQ8PgQ74IEvN2DGypVfsSh9y_jpngMLftpM01Ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMBE09GLVSZOwQniN0V2QsYvNPBhrMkXjWbp0ZsZJYYw&oe=6AFF0558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bx2560.png", "id": "1760589918509005", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623115_1760589921842338_943831502555437030_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cl-Exg7184Q7kNvwEio1D6&_nc_oc=AdqP-o4_ViLdrK0GhkHR6AYead5f7UfnELlHwbNtZSGJwcVQnwqFsWYxMcf_6_h83ZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtFcAUbMifFeJRHGDexuWiTh4hwEG_6ohnpkIhZQoBcA&oe=6AFF1328"}, "display_name": "On the Ropes: Boxing VR", "keywords": ["boxing", "sport", "dodging"], "long_description": "On the Ropes is a VR boxing game built around one thing done right: the feeling of a real fight.\n\nFace off against an opponent who reads your movement. Watch for the wind-up, slip under punches, block with your gloves, and counter when you see an opening. \n{5599872360237942}\n\nEvery punch is driven by your own arm \u2014 no buttons, no combos to memorise. Just you, your guard, and your timing.\n\n\n\n\nWhat you get:\n\nPhysical, motion-driven punching \u2014 jab, cross, and hook with your real hands\nAn opponent that punches, guards, and reacts instead of standing still\nBlock and dodge to avoid taking hits\n\nStep in and see how long you last.\n\n", "short_description": "Step into the ring and box in VR. Read your opponent, block, dodge, and land real punches. Simple, direct, and physical."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1126386269772788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1043345031825183_5328719171401184511_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxlDZB8x5gEQ7kNvwGwOU7Z&_nc_oc=AdrpyRDzLXa26WOfW5-7ggMspZLX0xtIIFY1R1l9D-8l8xdCCf_QeimemjFSBaClQf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS79gydZZpLJHJrXqpCqFEuCU-wxzcxy85rTrmZVz7_kg&oe=6AFF2500"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "On the Ropes: Boxing VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}
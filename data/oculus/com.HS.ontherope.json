X_aMsyocntnqmg&oe=6AFDD293"}, {"file_name": "screenshot (3).png", "id": "1112223371485915", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626728_1112223374819248_8982326543034472794_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQzI2SGbRzMQ7kNvwGEAarE&_nc_oc=AdpggGOPozMXB6LQaCxvLnGa2z_gpFJrDrvR9ACTtsYe7WSBEdQgPCc8FVa9mX3cjjk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvslx9QvETnkvIUp2BKyrxO9Aa5l1TIHvPebBNw8n_fg&oe=6AFDE27C"}, {"file_name": "screenshot6.png", "id": "4670495713179914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628454_4670495716513247_7491273190052097010_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8onw7ni7h2gQ7kNvwHVjeOc&_nc_oc=AdozhtbN_nymnPVJLtiErBmPYk0DeU26Gak2G3-2jl0xNrjrw2-dl6JiawsEFWIy0-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ218eAecki3nbh6OT9CDdSCDOaK6LVDM8DmHKYFsLOeA&oe=6AFDBB0C"}, {"file_name": "screenshot (1).png", "id": "1673840887442595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_1673840890775928_521816420773614370_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33ODSoQQ_dcQ7kNvwHkWkmJ&_nc_oc=Adpyd6RCv6qv9sSqXK9pcEk1Ja95Fq4V1ey2CfZPZKfLzfvMuXMpx9GM5lUlpTaKMVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIXBuAzQDHdOWumZ6_0ytxiBSbRIZG10NIw1XSaXk_iQ&oe=6AFDE1BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "On the Ropes: Boxing VR", "keywords": ["boxing", "sport", "dodging"], "long_description": "On the Ropes is a VR boxing game built around one thing done right: the feeling of a real fight.\n\nFace off against an opponent who reads your movement. Watch for the wind-up, slip under punches, block with your gloves, and counter when you see an opening. Every punch is driven by your own arm \u2014 no buttons, no combos to memorize. Just you, your guard, and your timing.\n\nWhat you get:\n\nPhysical, motion-driven punching \u2014 jab, cross, and hook with your real hands\nAn opponent that punches, guards, and reacts instead of standing still\nBlock and dodge to avoid taking hits\nA clean, focused fight with no clutter\n\nWhether you want a quick workout or to test your reflexes, step in and see how long you last.\n\nMore rounds, opponents, and challenges are on the way.", "short_description": "Step into the ring and box in VR. Read your opponent, block, dodge, and land real punches. Simple, direct, and physical."}]}, "developer_name": "JB Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "JB Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1074665754944840"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3667838076712035"}, {"status": "PUBLISHED", "id": "2255968211642606"}]}, "baseline_offer": {"id": "2255968211642606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "3667838076712035"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1123944326683649", "version": "1.0.4"}, "
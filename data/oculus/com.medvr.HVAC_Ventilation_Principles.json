1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp0oVPbxw1G8-XO3bzQO66Pu3yi-lZe6UoCC7vNFqtxA&oe=6B01BA5D"}, {"file_name": "HighresScreenshot00004.png", "id": "997569592609674", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_997569599276340_6473609502598423805_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTivSp60mOEQ7kNvwGzRjmO&_nc_oc=AdpFFRFrHHHfE4FYx6r_dAX4VdO54dnxy36DzrEn7ixRKq-Z_LTKCebCJnXwjgsluoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk5izX3invPPEVy59CD57H6kTU1JFFE6RtTrK6jG-J1w&oe=6B01E653"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kx2Txh9FesQ7kNvwGI9kHb&_nc_oc=Adri9OojAmHTImRn0d73DT4PaY5NQrxkDEN3WH9HnRVxrv6OsLyOpFl7buDUaCvLSjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcSpV6kc5CMcS27HFTMyiK4hQXfCnDhaXR6nXzF7Zs8A&oe=6B01CD1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "
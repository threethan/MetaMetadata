t=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LTmutUiC9VksngPVLbbo_l4BWNlwWoT2K3kASMSOYHQ&oe=6A243E5D"}, {"file_name": "HighresScreenshot00004.png", "id": "997569592609674", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823783_997569599276340_6473609502598423805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp3KrEdvcVAQ7kNvwEp0m3q&_nc_oc=AdpuR8Q8lTZlqrw816sBFzw3iA6qyDJjs5wRFIlsxquWe-GMYUeZOxV6BmG4ts5CU-k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zLbeKe9swRsuItzZBUILbqaf0IJWLcFJZEUlNfKhWVw&oe=6A243213"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbCiSW58aZwQ7kNvwFpenO4&_nc_oc=AdqeOWneakyS4j_nORs3RgMQpu_2xmuWCee9H4ntSGGlRs37aSCE8ZNQkasOTO6Jyzg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oibmnPbW4oIqo9qZxnX8u6zK3DJfnBI8MfVrBabyEIA&oe=6A2418DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "short_description": "Explore core HV
2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYFEh3Co12NfN_HRu_JMih5WB91k_22aqHgIfQXuzWHA&oe=6AFDC5DD"}, {"file_name": "HighresScreenshot00004.png", "id": "997569592609674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_997569599276340_6473609502598423805_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZhxOVwt1dsQ7kNvwEHbxw6&_nc_oc=AdpW7L9lJqC3MAxX-KMygiaemRBpOSHMoOxuP2JnA6elODkHZ_LJzcgthMcEFH_dyr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_x-3sZ098JXj1kyPheVOOMrmwnCzMqYVclvqjrkZ79Q&oe=6AFDB993"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biMFzdZmQX8Q7kNvwGjztHr&_nc_oc=Adqv-O2sD-ijEDMWNHiT_mJUb86wyGmJfd6NeeKqg0ALzGGsS0tXyV8z-VVgEq3H2a4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWG9B_MSXPJfFCifyhaVfIG51uQxOOzH4wjwI83ZB2Sg&oe=6AFDD89A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "
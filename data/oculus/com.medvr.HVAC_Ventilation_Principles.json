81IPRnCX6MiR3Bsl-FlA&oe=6A3546F5"}, {"file_name": "HighresScreenshot00003.png", "id": "2020611959333095", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_2020611962666428_2998139495118739510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I96cKvANvDIQ7kNvwHqTXCA&_nc_oc=Ado2Kk7DaJjrnVKf3UqA6evNc9aKn0-V_AdXfCfmQcg6LrjMVqe6Cb36ZEui5ZVJHxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_w7YTXLgysZjAylH1BOQB2MVQ1KBw8cduMOGFMNA84Xw&oe=6A3561DD"}, {"file_name": "HighresScreenshot00004.png", "id": "997569592609674", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_997569599276340_6473609502598423805_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcl53LaC2xoQ7kNvwFlbcAV&_nc_oc=Adpo1eF5PWFJ_ca7IVP-HXAYm-Ab3F7VmxcBJDy3_nDhWt7UyBQVYspfbrOi08AyMWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96G62tdE1BYgZ2pmYWuI-_csmGuLGt3e9fyXq0lYAV2w&oe=6A355593"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s696pAQnsDkQ7kNvwF_RLrP&_nc_oc=AdoiO8qe96Sx_cumplRbvJb0gmEfzgU4bsKXBLF6Q2vXiLQT5yI-Ckz42YSLBbl0Saw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8imaOGQzM5frDELD02EZe0CDyP2ma37fjfY45tdYoylw&oe=6A35749A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "short_description": "Explore core HVAC ventilation concepts through immersive VR training. This application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is designed for enrolled learners only. Gain hands-on experience with airflow, duct systems, and ventilation fundamentals in a safe, interactive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35324512830529594"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818852_854020717042991_7689257426607531633_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAcrX3QtPpgQ7kNvwGD-Wm4&_nc_oc=AdqpK2JPyAErU5EaiK1hJnTONwcAvNgyOiYy5Bna-ldEsL7xFAbwm_C76DQCIlAPiWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2RNLGJID84gMP-gP8_AHCkEa20dogR0j_MqZ8j2d48w&oe=6B0068DD"}, {"file_name": "HighresScreenshot00004.png", "id": "997569592609674", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_997569599276340_6473609502598423805_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTivSp60mOEQ7kNvwEF7y7K&_nc_oc=Adocjzyg6O6CIlolacYzTD7NkrQcDXn5QZyIgufqcElQp7HBHDpx9gfVMIJ8zDO5owo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR60TNGAXxFze0FCR9BFcXsBGPCAe4YRxDeV9vlMTqTqg&oe=6B005C93"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Kx2Txh9FesQ7kNvwEC6MiM&_nc_oc=Adp2Eph8iVfIAjwwSNgP1bQmrAZpoHVdzbU-qyqdTIHuF-BTbvrhcg4cUq8I7LJXHZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5zx7H8AkwvxlZXqNMLVIUVtImji1psjjYPJcr9u_XwQ&oe=6B007B9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "
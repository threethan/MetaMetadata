f7z6G_5Np1ZS9uTcPbbZg4i4wylImME7ZGq20hW1TU99A&oe=6A170313"}, {"file_name": "HighresScreenshot00001.png", "id": "1305303338366587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_1305303341699920_3974367169439771769_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ0nZqGR5Q0Q7kNvwFsNFH8&_nc_oc=AdqhQo84lfbQtRAjS7kf8xaYCbGdSdH7w4ukRNgJFgVH6v4UaUN9rsajT8p2ysVZlnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sfF7IFHkyPFMcmxnL8XpcHlqvTps6qOJsy399wO-Z-A&oe=6A16E9DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Ventilation Principles", "keywords": [], "long_description": "HVAC Ventilation Principles is an immersive VR training application developed to help learners understand the fundamentals of ventilation systems in HVAC. Through interactive simulations, users explore airflow concepts, duct design, ventilation components, and system performance in a realistic, hands-on environment.\n\nThis application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is intended exclusively for individuals enrolled in the program. It complements structured coursework by providing practical, scenario-based training that enhances technical understanding and real-world readiness.\n\nLearners can safely practice essential ventilation principles, visualize system behavior, and build confidence before applying their skills in actual HVAC settings.", "short_description": "Explore core HVAC ventilation concepts through immersive VR training. This application is part of the ImmerseLearn HVAC Ventilation Principles micro-credential program and is designed for enrolled learners only. Gain hands-on experience with airflow, duct systems, and ventilation fundamentals in a safe, interactive environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support
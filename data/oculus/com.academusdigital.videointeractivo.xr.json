s en el dispositivo."}, {"images": {"nodes": [{"file_name": "portada-horizontal.png", "id": "2062883984362214", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/831048856_2062883987695547_1770000366938608694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=654b-l5ems0Q7kNvwElSLym&_nc_oc=AdpWyXxwQf5dwp2cIVPxIo_e_3ZKxhR51g7ueCwRSSX9slDv6kpdBn6c1nYEeONKh8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQByWeYF349dZGnAD10j7HtF29194--6Smh9lPGS_M9hg&oe=6AEB3A00"}, {"file_name": "portada-vertical.png", "id": "2002624273753644", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/737543484_2002624277086977_3673111185441615117_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1oiydmIcB0Q7kNvwGBhy5V&_nc_oc=AdqfBBb9Msw9ccza0v_5LFNinMbEX9YJNolgCwrSs3wCtCazfkjuWiXZ-kb-4MBg5Is&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Kx7-cKM6x10cZWv2gZxVuOMUQgD7emIe_MQARJ0XWQ&oe=6AEB34C5"}, {"file_name": "portada-principal.png", "id": "1768137627779634", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646443466_1768137631112967_716579605633656818_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoN_QSDhuToQ7kNvwHoudYm&_nc_oc=AdrYeDjeqnZvi69vykK6DXEQB50kA6lJCnQuBbwxw3y4ObuwBTmxXqFDXahkrKRILA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsw8ngBAZ2DIgp2TraWsZ6QmA6OhywgTKoNVLYgF_JCA&oe=6AEB5758"}, {"file_name": "icono.png", "id": "1662051992059968", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/654922264_1662051995393301_1381838087085823467_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NOy-k6vnwUQ7kNvwGtCqiB&_nc_oc=AdoK4DoWaenSez2NCdbe7taOd1OQN_adnuS3ze-4dufIBHVt29Hv3SPeb-3lt3nCljY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3qOf9M4PfjSeDSugH2zl_e634qsXDKCg44Do-aoAodg&oe=6AEB4E1B"}, {"file_name": "logotipo-transparente.p
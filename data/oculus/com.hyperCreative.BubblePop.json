nt-ams2-1.oculuscdn.com/v/t64.5771-25/38974825_332016533000796_2098751578640501908_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=X0flGcGeRqQQ7kNvwGmR_4Q&_nc_oc=AdrArAsjxr01Ya4RMvMDJoh3OsdpfnD2_m00ODtjeWw9fPwqLNk6XXdIFDzqXx-PcME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IrIJz_hIdYKkvEARMXPaUowjBkYyeV4Qi0uvFGjJikg&oe=69D279FB"}, {"file_name": "NotAlone_hard_0515.mp4.png", "id": "1834560810346274", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485576_1834560817012940_5193466785641071115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEMwY61kTyYQ7kNvwFEo3Vt&_nc_oc=AdrT2SDxg_7EFjKKqBjb5697Z_CWlWUFRDaPpvdibmXBuZxGHAcTgFoGyQ2LnDWBF8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HzhCy6NprjV95SXnUeazV30ogMAVaZgBjgRlgorHgxA&oe=69D274FA"}, {"file_name": "LunarSync_MRC.png", "id": "542493068760919", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982477_542493072094252_5868106385987132485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWn6TKEzfmgQ7kNvwEGe_Wh&_nc_oc=Adri3ZbX4zlDGSWszY0mJ8crr6gugYxAcoTwHA-v4MDXjdGMkClO52BuxJV1OIxBq48&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20gZ3cEKmtTsTVm2RNjgkxE96xCey3thE5WBAW9LrGjg&oe=69D26E4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "820996726026654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610562_820996729359987_4412348469651450537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71ul1HzFU_gQ7kNvwE8Eq0S&_nc_oc=AdpXqNM89x3FMLMegK2ol3j2qX3CJFYTGXzm78bZ-xR_gOIwd5oGcngS3SYM7zyZRe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pGIC0GEFUZP3TxTjV0Yz0GbkCe9ee7tFELccB5w_fAg&oe=69D26C99"}, "display_name": "Rhythm Pop!", "keywords": [], "long_description": "Rhythm Pop! is an addictive Music Rhythm VR Game using your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!   \n\nHere's the twist:\nIn our \"Classic RPS Mode\", you would beat the bubbles by making the OPPOSITE gestures.  That's right, Rock beats Scissors, Scissors beat Paper, and Paper beats Rock!\n\nFor those looking for a more conventional rhythm game experience, in \"Copycat\" mode, copy the SAME hand gestures as the bubbles to pop them.  \n\nIt may look simple, but it's hard to master!  How fast can you move your hands?!  This is a hand-tracking only experience.\n\nThe game currently includes 14 fantastic songs with 5 difficulty levels (Baby, Easy, Normal, Hard, Crazy).  The song genre ranges from pop, rock, classical, to EDM.", "short_description": "An addictive Music Rhythm VR Game with a twist: use your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!  This is a hand-tracking only experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypercreative.games/privacy-rhythmpop", "developer_terms_of_service_url": null, "publisher_name": "hyperCreative Games", "support_website_url": null, "website_url": "https://linktr.ee/rhythmpop", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9004269699701704"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476595_2250722861941990_1613619129447981166_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FysDMEl5MwgQ7kNv
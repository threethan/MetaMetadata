5/38974825_332016533000796_2098751578640501908_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=zR-oov0uiEcQ7kNvwExLdfK&_nc_oc=AdlI5YzqbQK4EBsr3aYPPKP-L4rcRdtbS6mEdcnOrl3fxcDk2P_6pwC091Zz4ichhik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft0gEMd4ZGitH_FUtAVgSTr4h8eDi_BsNkdF5sWOBP_lg&oe=69A9633B"}, {"file_name": "NotAlone_hard_0515.mp4.png", "id": "1834560810346274", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485576_1834560817012940_5193466785641071115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf1AsIda448Q7kNvwHj_O5X&_nc_oc=AdlBw1wVgobCDmHJ-90Oa9j6eVfV2AZ48sIgxe7e0MDWlANkGVqDlg3z5v8ABLUk0Oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvsCCoi6QJbf-5l1WKPM3gH9E0v1VT76TEaDKVJ-MPreA&oe=69A9967A"}, {"file_name": "LunarSync_MRC.png", "id": "542493068760919", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982477_542493072094252_5868106385987132485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWVeD6W7CqYQ7kNvwG1wYkC&_nc_oc=Adl0WyzAZQsdgKPDbIjxEHWadP_IZoOKkoX7gpfdH6kJg8rSwxKAdaYm4Pc_dVbCYLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftdJd75PVbIDm9an-dsoGtMjbUlP2gQGJchrtyPujMWKw&oe=69A98FCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "820996726026654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610562_820996729359987_4412348469651450537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwKEJsLt0gEQ7kNvwG4_tYl&_nc_oc=Adky0x5hdCRAkqE9t9-1RqvSDy8rtRDMFyCQ7vExvtTT8sIXJsor5ABF_LS3GDfbwxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqLpus6rmDKNgcMU_eazx5VPkCR7grXF2bWuiRF71i1w&oe=69A98E19"}, "display_name": "Rhythm Pop!", "keywords": [], "long_description": "Rhythm Pop! is an addictive Music Rhythm VR Game using your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!   \n\nHere's the twist:\nIn our \"Classic RPS Mode\", you would beat the bubbles by making the OPPOSITE gestures.  That's right, Rock beats Scissors, Scissors beat Paper, and Paper beats Rock!\n\nFor those looking for a more conventional rhythm game experience, in \"Copycat\" mode, copy the SAME hand gestures as the bubbles to pop them.  \n\nIt may look simple, but it's hard to master!  How fast can you move your hands?!  This is a hand-tracking only experience.\n\nThe game currently includes 14 fantastic songs with 5 difficulty levels (Baby, Easy, Normal, Hard, Crazy).  The song genre ranges from pop, rock, classical, to EDM.", "short_description": "An addictive Music Rhythm VR Game with a twist: use your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!  This is a hand-tracking only experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypercreative.games/privacy-rhythmpop", "developer_terms_of_service_url": null, "publisher_name": "hyperCreative Games", "support_website_url": null, "website_url": "https://linktr.ee/rhythmpop", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9004269699701704"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476595_2250722861941990_1613619129447981166_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZD842oJa5wQ7kNvwHAKyBO&_nc_oc=AdmmJnqonfU1Dz7LvjsPRZnnjVr2G8J0Wc0ht
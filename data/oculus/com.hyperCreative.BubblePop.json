3-1.oculuscdn.com/v/t64.5771-25/38974919_789872242581977_6372004608634830410_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f5530QASaIQ7kNvwF76bqR&_nc_oc=AdnOHkST3GJnqdRjFlfIS7a_6_N23qRGbd6RCBM9lu7Ku_mbR7AD7p1V3vbn-1sWsEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuPH2ofbdyeDpeo9hxY7sqMfWFW6PsGyirrWMXJcL-4SQ&oe=69984203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "echo_2560.png", "id": "379905024899686", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001715_379905028233019_3723091916722888668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM6YO3slQDUQ7kNvwF7b0y_&_nc_oc=AdlTXPOzMG9Q4d63MDSC9Q-bH1rhVyKr66j5Hn2fdUwy1947pCBDJzNTKTOHe9rw53E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfteDt0_RqobnzFnHYZ_SEynVhvdn0McTt6GsvQ2tLCdZg&oe=699852C1"}, "display_name": "BubblePop! Rock Paper Scissors", "keywords": [], "long_description": "BubblePop! Rock Paper Scissors is an addictive Music Rhythm VR Game with a twist:  Use your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!   \n\nInstead of making the same gesture as the bubbles, you need to make the gesture that beats them.  You've known it since your childhood: Rock beats Scissors, Paper beats Rock, and Scissors beat Paper!  How fast can you move your hands?! \n\n This is a hand-tracking only experience.\n\nThe game includes 1 fantastic song that is free-to-play, with 5 difficulty levels (Baby, Easy, Normal, Hard, Crazy).  You can preview the 13 additional music tracks which are available as in-app-purchase.", "short_description": "An addictive Music Rhythm VR Game with a twist:  Use your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!  This is a hand-tracking only experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypercreative.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "hyperCreative Games", "support_website_url": null, "website_url": "http://hyper
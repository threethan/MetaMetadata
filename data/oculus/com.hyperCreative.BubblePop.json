6e7a0a&_nc_aid=0&_nc_ohc=7N57YsbQC5AQ7kNvwHbkuWq&_nc_oc=AdnXj2mO1Nvlq3Gd40d4iF45b_jYqIbE0WS1MFOn_i1eO3F262ih3G5Urg80XEw1K08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftrcr2eEX_okBfKYawtykv3Wla4FNPhNDnD98WGTY_2Fg&oe=699D85BB"}, {"file_name": "NotAlone_hard_0515.mp4.png", "id": "1834560810346274", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75485576_1834560817012940_5193466785641071115_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VqWCMN8RlQQ7kNvwGU_b48&_nc_oc=AdmgYcyNzliDPrGLw-4X9lQEv63usueW-lOEn636fypRtC61XquMYrr5ySbuV5ShZMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvRPA8l0-5FrvuFgMaw9GqhnrAUgZewoWdiOKsJebni9A&oe=699D80BA"}, {"file_name": "LunarSync_MRC.png", "id": "542493068760919", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982477_542493072094252_5868106385987132485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKmEa82sSZYQ7kNvwFKlrKD&_nc_oc=AdkpcUKdTJFS2xHCldo5Z62LqPcT3rxX9tRjlJUtSk3qRb_cOY06Z-9IXRQr0naCkEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afurfi1TIOtJ7w_Q-dBz9iM-dpdLvSwqYjcfHWBRiq4_hg&oe=699DB24B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover.png", "id": "820996726026654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610562_820996729359987_4412348469651450537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYuwSygigb0Q7kNvwH2z2EB&_nc_oc=AdmZQsxYzquT4Tnvfug4mNGxQqmC5vRa02gvrp1QfLq_wXEMDwhdAiQSwXtaPL7Cr-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuwtbr41gy9E8VV57b4tSXB8aya2gc1hv4WH3UUV0gODQ&oe=699DB099"}, "display_name": "Rhythm Pop!", "keywords": [], "long_description": "Rhythm Pop! is an addictive Music Rhythm VR Game using your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!   \n\nHere's the twist:\nIn our \"Classic RPS Mode\", you would beat the bubbles by making the OPPOSITE gestures.  That's right, Rock beats Scissors, Scissors beat Paper, and Paper beats Rock!\n\nFor those looking for a more conventional rhythm game experience, in \"Copycat\" mode, copy the SAME hand gestures as the bubbles to pop them.  \n\nIt may look simple, but it's hard to master!  How fast can you move your hands?!  This is a hand-tracking only experience.\n\nThe game currently includes 14 fantastic songs with 5 difficulty levels (Baby, Easy, Normal, Hard, Crazy).  The song genre ranges from pop, rock, classical, to EDM.", "short_description": "An addictive Music Rhythm VR Game with a twist: use your hands to beat waves of bubbles with Rock, Paper, Scissors hand gestures!  This is a hand-tracking only experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hypercreative.games/privacy-rhythmpop", "developer_terms_of_service_url": null, "publisher_name": "hyperCreative Games", "support_website_url": null, "website_url": "https://linktr.ee/rhythmpop", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9004269699701704"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476595_2250722861941990_1613619129447981166_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJkJRj85yycQ7kNvwE6xWJP&_nc_oc=AdkbkwzMke9CFbKGCPCRtBJtvTM75QeH12D7p638QThhAlI9iJNe8ccPkj-yr7Rq1Us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7RuZ25NBccQmdptC0NWH9ap682vc8Cs
_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStHHjwXT6EXzQfvGaovyxyZ7xCCuLOVfQNFijj2V42vw&oe=6AFF1646"}, {"file_name": "MyVrPet_1_petting.png", "id": "1666219834839997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1666219838173330_886191741722259131_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC471_0LyTgQ7kNvwFFbbRJ&_nc_oc=AdpB02JI4lih0bv5bHHI6_MrZnLwPZEK70daEYbK0j-WlyqJzUcXXUFPlGpPqqiYMrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgB0Z-POQApuDnQ-ISPkYdRzCK6u3Pp2YO7mkJkAvl_g&oe=6AFF1B60"}, {"file_name": "MyVrPet_1_petting_tuxedo_alt.png", "id": "1624056532509555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1624056539176221_7469513480552630896_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pihAWE370UQ7kNvwFawl9q&_nc_oc=Adr2VhYQZ2qkSrYXEMjoR2pIhPkXmzZNYXoG0ChJE7ki3Ggjs0tYuacWdh19O_qaJtU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi-dB1sJXgtwk7jfVYnXt-jdl26v6qMn-Cz95IO-WoeQ&oe=6AFF0233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_1_petting.png", "id": "1167056619606201", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823366_1167056626272867_7360216479381422110_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qM-9y6Dgo8gQ7kNvwEFd2ro&_nc_oc=AdrMUqgIUaQkFxuSjC11Hchi26GxZ_W69yvWNoYIiaG9ocPyJ94IaarvBs3pBQK9384&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjS71Za31EJD89vyuRiw-sFQ4oggN7tbpYkgtryXEVgQ&oe=6AFF0256"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# A pet that lives in your real room, and slowly learns to trust you.\n\nReach out with your bare hands to stroke it, pick it up, brush it and play. It roams your floor, hops onto your furniture and naps in its favourite spot.\n{4240380252926560}\n# Build a real bond\nGentle attention earns its trust across **five Bond stages**. Find its favourite scratch spot, build daily rituals and come home to a happy greeting.\n{1802219420795733}\n# A mind of its own\n\nYour pet asks for food, a brush or a cuddle, gets the zoomies, follows you around and sometimes knocks your decor off the shelf. Each one has its own **temperament** to discover.\n\n\n# Care for it\n**Brush** its fur, feed it when it's hungry, and scoop it up with both hands.\n{1646224283824248}\n{958049147160087}\n# Play together\n\n- **Pounce Patrol:** point the laser at holographic critters and your pet pounces. Daily hunts and Hunter Ranks.\n{1921188992199452}\n- **Guardian Mode:** swat invading pests and your pet finishes them off. Cozy wave survival with 20 upgrades.\n{2537985816683522}\n- **Fetch:** throw a ball and watch it come back.\n\n# Pets to adopt\n\nStart with an **Orange Tabby** cat or a **Shiba Inu** dog, then unlock six more pets with **Sparkles** earned through play, daily rewards and quests. Spend them on decor and toys too. No extra purchases, and more pets are on the way.\n{4424009351244345}\n\n# Good to know\n\n- Mixed reality for Quest 3, 3S and Pro\n- Hand tracking recommended, controllers supported\n- Scan your room so your pet can explore your furniture\n\n", "short_description": "A pet that lives in your real room. Pet it with your bare hands, earn its trust, brush it, play laser hunts and defend it from pests. Adopt cats and dogs, from a cozy Tabby to a Shiba Inu."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
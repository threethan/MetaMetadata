t_Thumbnail3_square_portrait.png", "id": "1233274368209533", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1233274374876199_6432387455122002144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIiL8IcCcXAQ7kNvwGmGqld&_nc_oc=Adrx8HZdy1s-QeZo7eim6okvJnu6DrqyTMuCZhRAS4nE6VpffMCIK5Jvic1SK4EHRKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZqFwLxoON6kdWZcJxAUOJpm4mIY5u7gPpNiVDbUwBlw&oe=6AF3396C"}]}, "id": "1522719439666151", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=185l4xH8Qx0Q7kNvwEZvJn2&_nc_oc=AdqCrRTq4bV37cbfYfEYwR9XKQF3u2U_S4TSqctvrZLrUHVSHzT29mw7Mt9JykTozGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBMfCiGQ4HCNk_gsv2miQcMNX499f4dNIInWJvP4Mu0w&oe=6AF326BF"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5luMRgJfq40Q7kNvwHU9q5v&_nc_oc=AdoCZQAHH0NmkdxTGSi8Y9ORP4b5GH9XtyMoiZZihoaRvGR7iS0Agyll9gtYhY3OBZ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXC-IVYj6ixaqPBvLIXQ8yL2EBHJxN7GP2Y-h5JAbMuw&oe=6AF3546D"}, {"file_name": "MyVrPet_4_guardian.png", "id": "1674559800848306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_1674559804181639_3867291446791519111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVpl-Ij_HPkQ7kNvwFj_gfa&_nc_oc=Adphs2_BAhDO692AJWPzIceOxbwvEg-unmOcRd6NYNkSIdnZr6UdiO33ERoa62FF4BE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7w1R-IU4vSgvoduM1a8fE3wbFP3zw6VxgPmnVQgY-Zw&oe=6AF338C6"}, {"file_name": "MyVrPet_1_petting.png", "id": "1666219834839997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1666219838173330_886191741722259131_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxLJnpkQMUIQ7kNvwHL90pg&_nc_oc=AdpjtqPeFcJp1PnnyAtqFzNfZuBji63raRDTe560TGBwgypJ1v-PF3P0BBArMtszhEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCQ01SZqi9AIB6jPGvx0Dk9KTWR-muMLWHIa32fDrqLQ&oe=6AF33DE0"}, {"file_name": "MyVrPet_1_petting_tuxedo_alt.png", "id": "1624056532509555", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1624056539176221_7469513480552630896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXjJQfp_0pgQ7kNvwEgaA2J&_nc_oc=AdovcrEj30p-8X6aosPGZNbG8inMQ1P9HidDTjI8Xvd0FMnBkudEyndkyO1QRQvSMzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSs6EYSeCw8zdbiMkCHVtVdwDhgj81Xv9S2PqAGtHttQ&oe=6AF324B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_1_petting.png", "id": "1167056619606201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1167056626272867_7360216479381422110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=986q6ocyfCEQ7kNvwH1yiHy&_nc_oc=AdrjQflIYcR3kWy4rG_p_KHeL78eaW4tHvYzKibLAwfKqRhMhKIf4c05Q2DE_Ic2bb0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGebZX_HSjRW6x87W8p_WkS9A7CCSxwR7D6OyOBwB13Q&oe=6AF324D6"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# A pet that lives in your real room, and slowly learns to trust you.\n\nReach out with your bare hands to stroke it, pick it up, brush it and play. It roams your floor, hops onto your furniture and naps in its favourite spot.\n{4240380252926560}\n# Build a real bond\nGentle attention earns its trust across **five Bond stages**. Find its favourite scratch spot, build daily rituals and come home to a happy greeting.\n{1802219420795733}\n# A mind of its own\n\nYour pet asks for food, a brush or a cuddle, gets the zoomies, follows you around and sometimes knocks your decor off the shelf. Each one has its own **temperament** to discover.\n\n\n# Care for it\n**Brush** its fur, feed it when it's hungry, and scoop it up with both hands.\n{1646224283824248}\n{958049147160087}\n# Play together\n\n- **Pounce Patrol:** point the laser at holographic critters and your pet pounces. Daily hunts and Hunter Ranks.\n{1921188992199452}\n- **Guardian Mode:** swat invading pests and your pet finishes them off. Cozy wave survival with 20 upgrades.\n{2537985816683522}\n- **Fetch:** throw a ball and watch it come back.\n\n# Pets to adopt\n\nStart with an **Orange Tabby** cat or a **Shiba Inu** dog, then unlock six more pets with **Sparkles** earned through play, daily rewards and quests. Spend them on decor and toys too. No extra purchases, and more pets are on the way.\n{4424009351244345}\n\n# Good to know\n\n- Mixed reality for Quest 3, 3S and Pro\n- Hand tracking recommended, controllers supported\n- Scan your room so your pet can explore your furniture\n\n", "short_description": "A pet that lives in your real room. Pet it with your bare hands, earn its trust, brush it, play laser hunts and defend it from pests. Adopt cats and dogs, from a cozy Tabby to a Shiba Inu."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_
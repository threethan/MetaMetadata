a&_nc_ohc=4jDNGT7EG70Q7kNvwEug7J3&_nc_oc=Ado3edexzmcnTLNRFHmHkJvoXkRNoWhgUch4hekD9wIBgHsGiRw4aCLzfoH6i7stWI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo7lrr3Tq4e1bldLIrvgol7rt2qL9pb9b0hDLXidI0GQ&oe=6AE0C8E0"}, {"file_name": "MyVrPet_1_petting_tuxedo_alt.png", "id": "1624056532509555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1624056539176221_7469513480552630896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbf8jgDi5FsQ7kNvwFRg7ja&_nc_oc=Ados5CcxnsKa-GWkz1rTr_AOVDMLW6ZEcP9oCaRnBgy1vx2W0Vhr-n_SbXZ5M8qIlOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwRF86DfQPvGT1w0QySmO7PUawZs078HUKqx_4K4X-Cg&oe=6AE0AFB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_1_petting.png", "id": "1167056619606201", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1167056626272867_7360216479381422110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqRmTz6cDe4Q7kNvwFSTRPV&_nc_oc=AdpDGCUExSI9tmvSm_5WgBuvevqdypGWeUE5A53F92BkAHyEgeEzJAR0nOptQPeboxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMf5r3jCPzmWj24cV2mKxAJ3O8XjMpvZCvrxlxBbT8YrQ&oe=6AE0AFD6"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29391048830502238"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sj
id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QluZJPlwitAQ7kNvwFxIvrP&_nc_oc=Ado2gXGe8930Reht9IZXVAzz7208uWPSNN3GXr4XAjbM5OZw8D-0AIkOM4u9MFNqsrU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXRS1QL5LBV8OUmweVr02O5wx75TyBbJLDPmDHG823ww&oe=6ADCBD3F"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEFfEXqDuhIQ7kNvwFXGMtY&_nc_oc=Adq-6Ql_C5HfMVQ-fikhnQFueNk94nk5UnG02eWdpdMJ_v-omjj8V3TiQarXEK1MhT4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRIeTMITe6znLpRooqUVzJiI0ae6otZzOf435YTmkNvw&oe=6ADCB376"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybQgpCGOHiEQ7kNvwE3K8BV&_nc_oc=AdrbQ2bGLk39-GY9GxhrbR-xLyKF85ooH5tEIVAeoOm_2qzSV1QCr3Rf3o1muCVueq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrDPJyjH1taH6vVIuuMh6Qz9L8Q0JNtG_aFWyyHe2XNA&oe=6ADCB2AD"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly1oaizCJgsQ7kNvwG_6ORr&_nc_oc=AdrfdoPPnTDNbX6rK3ir0CQdZJwAnLL89iLA538CqNXkNWIJ1t0Yyq_T9kg35DhwDK0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9iriRHZrQQWG7hrwcmeu4f4ify6v5aEhuttVZ4g7mmw&oe=6ADCB576"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdRCIF0yUikQ7kNvwGd9Omp&_nc_oc=Adrb2pLCv9xA685UGUucEN1YDhU-AjTQy8aOB6W2lT2mqd7qVRoaXgCTMcZSw0U-g1c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0wUB7t6CHv2BQuyxscG4TFQp4Vol55XWTwQ2i58mMyQ&oe=6ADCCD73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5k8XZU8zi8Q7kNvwGSIUjL&_nc_oc=AdrDbcDlINd4ddoTTcjpPODU41arckrRQbeKxZ4qeCDrME3qN-auSPIwXW1XZTHoIcI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu9QFWud8mBeLSGtMvQH1iS2mPd-LkRHRrJNE9Kq3sdw&oe=6ADCA5FF"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Aoc9AEW28IQ7kNvwHXkVi4&_nc_oc=AdrZJIfmpWwYRv6KNy31ANg5dyH3T0otIpljk-dFjoeSRszGN-M54bqj0yKfUcrflTw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNru_fmB5YQTPz8aoP0R7YHNoU6HIL5Bqhv0dl7KyMF8A&oe=6ADCC40F"}, "is_concept": false, "is_test": false, "is_tria
, "RealTouch", "Pet", "Cat"], "long_description": "Dive into a new reality with MyVirtPet, the ultimate virtual reality pet companion. MyVirtPet transcends traditional pet simulation by offering a deeply immersive and interactive VR experience. Connect with your virtual companion like never before with a new \"real touch\" technology that allows you to really touch your pet! Engage in heartwarming interactions, play exciting games, and don't forget to feed the pet. Experience the joy and fulfillment of nurturing a virtual friend, built specifically for the Meta Horizon platform. MyVirtPet is where emotional connection meets cutting-edge virtual reality.", "short_description": "Experience the joy of a virtual pet with My VR Pet. Interact, train, and form a genuine connection in an immersive virtual reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25807701588836998"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1312239700753171"}, {"status": "PUBLISHED", "id": "3694100077413910"}, {"status": "PUBLISHED", "id": "3586564644818082"}, {"status": "CANCELLED", "id": "4365188313748017"}, {"status": "CANCELL
id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6fa_X1pq38Q7kNvwECX1Wu&_nc_oc=Adr-RVl6FvXSr7eFyebrq4_Uo37PJoA_wX4I_IzIWadiNl6Nu3I6rTZpAy03P6jS4d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv2nF-ek8APYEGzcfnz3hJDUD5F3VVDW43_U3wLXn3HA&oe=6AA2BB3F"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHq8JqTPGT0Q7kNvwEO3yoD&_nc_oc=AdpTxxngpvnPjrpZAvVmW7of0zo6sHCIe7ImaPrfZfg0oqz4uPu5gOYDPYPx8BhkJQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYM-OYjPKkQLkY5iTsBNoKCV0jegta5SFqJH6c5dF2nQ&oe=6AA2B176"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnL1ceqZzV8Q7kNvwE_IDE8&_nc_oc=AdoPQ7uAHm9B60Jqa0ebC-V2hT5-sJw65ZqJOXAmqYILyNGwylTl6Srl1kyx96qE2CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJShpV0DwcjRl4h-wG_JxhxZvMG5xLenku7HHtEYIYVVA&oe=6AA2B0AD"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr73UJcq8sYQ7kNvwFH03fG&_nc_oc=Adpc6znOMBVyMbMqLZGzI1R7OUYewbUmdskWI3kQhmIA1klpJNnfaFZG9VhrUsos5tY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhJbj2_dizexSj957JzArt8XHvfOnE2eojclGyTmg0Cw&oe=6AA2B376"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w96BEmemKXYQ7kNvwEn8GVr&_nc_oc=AdpzNE8Lca7y2c8vOEgTPz9UQ7Ak8xzNw-L2hU9QkI9jKY07qKZz6wf2VzjoPqsXhJk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRzLCuHkXQdqLhSWjw_fHkvn9SmKVjVZTx8pLtbiHYdA&oe=6AA2CB73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSULLpm4sEYQ7kNvwEnbSbZ&_nc_oc=AdrQwxI7DNVXLHhdmZErYkW1PPT_Djdw9OlPIKTU72WhkT319cppluE6etJ3Vls6e8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1jmn1oG5LnNM6GmPJ5_G8D3XUwJz8xm3wP-W-ukTc-A&oe=6AA2A3FF"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TrCd49u5eQQ7kNvwEzsEiT&_nc_oc=Adpdh83J5PeNShSzTKtLEOuQADwUhG7-QEQngVS7VRCwh9NI7zSMEqEYhq2ShkGQtbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvN68D6MDK506OYA6SW0X4nEHuBJkQ1lFu-WiMY-RdWg&oe=6AA2C20F"}, "is_concept": false, "is_test": false, "is_tria
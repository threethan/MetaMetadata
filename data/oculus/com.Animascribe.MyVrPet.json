t_Thumbnail3_square_portrait.png", "id": "1233274368209533", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1233274374876199_6432387455122002144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qiXXN8tWd4Q7kNvwFFn86b&_nc_oc=AdqJoVr0yyXWjnLAl_JcGFbX-M4ARH4EBs3hIMLjxLRh-AwC11ZxIhWBayZKuHSKu0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnjeM90n4-aNNPTob1yfKP-5gbDmhVDuGYrsvNspSE1g&oe=6AF72DEC"}]}, "id": "1522719439666151", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwylgNnyPzYQ7kNvwGQyZ21&_nc_oc=AdqJ7pzZwveHz-XLuikguH6M12xEA7uX33l82iNwRG-JUMGtORn53CmhK1wI8LnCBnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOUYYuvPHp1eQBTIOMLIW4d5LK-ii_S5baKxNSajXGQA&oe=6AF71B3F"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efsZ-GdpjWgQ7kNvwHiYI5P&_nc_oc=Adp4X_3LIiRdf_-VmUd00GQ0wCye_L7OMXKJV8bvWHIzfo8czx396s81PP4aSwwaN4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0USwbqjBxIRTxSZKaQz0n1-pa4ht0C2VdbT0WUYKdoA&oe=6AF748ED"}, {"file_name": "MyVrPet_4_guardian.png", "id": "1674559800848306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1674559804181639_3867291446791519111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmWXWyD5D0oQ7kNvwGwezko&_nc_oc=AdrjSslKJX8_a4GVqDJ6boB9ZaS-Of_aFxzj3bvHkl3yuBZVGPK1Ot5M_b0OT1cTDBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRCL8oqMvcg_zcqSCV9Qsy2olOxuaovZxls0PfXFGEcA&oe=6AF72D46"}, {"file_name": "MyVrPet_1_petting.png", "id": "1666219834839997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1666219838173330_886191741722259131_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcAqlHNafCkQ7kNvwFBCq2J&_nc_oc=AdqAXny8BflsoFkz0eGCyNDkpyIaP6iuX6jpPZE8Uj2TWggkTh1XTKOIUn0k2NfTi9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnvGeTY0MYOnOeGvmF-aLGzaXQwWZMCAKv2KpRV06bKw&oe=6AF73260"}, {"file_name": "MyVrPet_1_petting_tuxedo_alt.png", "id": "1624056532509555", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1624056539176221_7469513480552630896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXFBVrXExDgQ7kNvwE3fSJl&_nc_oc=Adqt2emN1KEEcCHBUSa6T0Qu-yKEOl3MCOJhNktYKsSuMXH9qQw_OwGcp5G_5R9cUgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaICN3sb_jbs1A6hfGG7dU16CNVD6yBKGKb7oDuaJm-A&oe=6AF71933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_1_petting.png", "id": "1167056619606201", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_1167056626272867_7360216479381422110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbPUrCxiVlUQ7kNvwFvDHXF&_nc_oc=Adpw-A4zXxEtli8z44p-jn55RZFlbtZJ0Tkt2m22AaK_JT3TQZK1-q0CRkkDbKZMCfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyNMVVH-J_Hk3sV9rBL9bcse6VO0vcAt778NJ21eu4VQ&oe=6AF71956"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# A pet that lives in your real room, and slowly learns to trust you.\n\nReach out with your bare hands to stroke it, pick it up, brush it and play. It roams your floor, hops onto your furniture and naps in its favourite spot.\n{4240380252926560}\n# Build a real bond\nGentle attention earns its trust across **five Bond stages**. Find its favourite scratch spot, build daily rituals and come home to a happy greeting.\n{1802219420795733}\n# A mind of its own\n\nYour pet asks for food, a brush or a cuddle, gets the zoomies, follows you around and sometimes knocks your decor off the shelf. Each one has its own **temperament** to discover.\n\n\n# Care for it\n**Brush** its fur, feed it when it's hungry, and scoop it up with both hands.\n{1646224283824248}\n{958049147160087}\n# Play together\n\n- **Pounce Patrol:** point the laser at holographic critters and your pet pounces. Daily hunts and Hunter Ranks.\n{1921188992199452}\n- **Guardian Mode:** swat invading pests and your pet finishes them off. Cozy wave survival with 20 upgrades.\n{2537985816683522}\n- **Fetch:** throw a ball and watch it come back.\n\n# Pets to adopt\n\nStart with an **Orange Tabby** cat or a **Shiba Inu** dog, then unlock six more pets with **Sparkles** earned through play, daily rewards and quests. Spend them on decor and toys too. No extra purchases, and more pets are on the way.\n{4424009351244345}\n\n# Good to know\n\n- Mixed reality for Quest 3, 3S and Pro\n- Hand tracking recommended, controllers supported\n- Scan your room so your pet can explore your furniture\n\n", "short_description": "A pet that lives in your real room. Pet it with your bare hands, earn its trust, brush it, play laser hunts and defend it from pests. Adopt cats and dogs, from a cozy Tabby to a Shiba Inu."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_
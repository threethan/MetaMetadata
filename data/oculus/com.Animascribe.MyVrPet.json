id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1QPlyl0acQ7kNvwGowW09&_nc_oc=Adr84qw4u3DrFly38cCxIh6oiAlxEsrFCTfg63VfxatHT4BUarsIV9sABz3C6RJjvxM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3ZFeXTKD08RXOcZAz_34xxnKJfNIb1PWFOQQGD85LBg&oe=6AA169BF"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHq8JqTPGT0Q7kNvwG5u-Gs&_nc_oc=AdoGDlHu_2wP9K2NGN3_JErGNFAZcOtBZ9wH3sw3o8AZLcUkcLWJEz0dZky0KajoBbc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK61AwB74mUfp57HK1oi0kSvkTuC_9814T3qd1EdHZG1g&oe=6AA15FF6"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqS_OGIQJ8gQ7kNvwHNXwv9&_nc_oc=Adpx6Nz6UJkTVHeu5yJ6jW6NWOgcaPBeu8_nNZfbkV1jYhXTSy88J5UgpyvpXP9rUgY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWWZfJTIRMddFxd56NzWFnJAERKpr3oxYIUe1VN2hSdw&oe=6AA15F2D"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr73UJcq8sYQ7kNvwGG2PGB&_nc_oc=AdqcECkvJ0XU1t_C9CTSFv_2zT0E3hI4yVVfQTzAHoi6F1uzh7NbmxmOdt_13StsD40&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkXkcQrIS9HXM5MtKI0AKzxA8bthPb-fnUzpEqCUCxuA&oe=6AA161F6"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w96BEmemKXYQ7kNvwF2rPeM&_nc_oc=AdphGTNpcN6s5pqHt6UDlQ2FE3kbBFr0VXmggi0SspejGExeL3AJZ0S8bkohkduZLqQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyFa-JdKyrt1VkJOP6mpXXtpT7-Ecj_0WSRfKlJ6LZig&oe=6AA179F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSULLpm4sEYQ7kNvwE3M35d&_nc_oc=AdqgPEkeervpmULzR1oA06zPF1ycbyGOUhAZTKhXfaWRYzX62Fz3i47tUI7QtLia4Xs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYbcvhH5Z6AmUABqBTw_bdpKu45ucQvxFh3mLs-sah4g&oe=6AA1527F"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0JFtRq5giYQ7kNvwEiF5cP&_nc_oc=Ado5QHRzr96WqjMhT4K70FOUEGbf457j1EiPo5raouGiL3ZUmNwz_af_hRdfNtvKL10&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_NI37Y2O30hp5_r_hISxg-KO39cBVMuHA5CeC_b01YQ&oe=6AA1708F"}, "is_concept": false, "is_test": false, "is_tria
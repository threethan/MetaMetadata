id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MJJAEVlRwHoQ7kNvwH0-nVI&_nc_oc=AdqEPqAsrxbMdO5UsRy8zpclMLiSUhJMUYT7btCA_qhD21yAS8TF50MorgPkbt_7tI4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNMvHXrfDioqVi_PzLgQ_1q6bMTV0wjdzNE5Lg_eZpaw&oe=6A9AD23F"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4vFUFfzS2EQ7kNvwHUSPCT&_nc_oc=Adp4-sRtjWoNHJoa_NMJ55tHdyASJ6IbFTU8vzHlTLYodXQlASeKF6YufwuL5Ss_1go&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWkG3DM8BFHZ9motP6WvQa8JVwJRB_4qsW_g8Gs8Vg4w&oe=6A9AC876"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnGrXYVH-ScQ7kNvwFda9u4&_nc_oc=Adpa_waz_DCMhLd0hi6lGghyp_x4UO4IQCHxOgml3ftwBrgEaiixS_CTaqUbCMuG-co&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIACDWje37rHpkv-0QxPxGlHbqmeICfUciWgSk2OSAiaw&oe=6A9AC7AD"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HatuDNGNj3YQ7kNvwEHW8oA&_nc_oc=Adpn7LkxDCuDtnTlyIVaTqWkLrfhRWICSILzeG0BpLmai1Ux8SRK9T_IDiyRz4lipiQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDk8L8YA0hlQkS4rtBiP8JmDVRVLgCbgXqGt2fnST8pw&oe=6A9ACA76"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P17km3crMdAQ7kNvwHzy4lY&_nc_oc=AdqB21_H9VPwrW7YGteWKZFCXtNo0K8OB7BTa70NiKZhGfxwR7znEXt1OhBlRE2K9ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITN5UJXeZ6Hu4eMB1V1Xzsc7c0xl04uf67g-_jKDauhA&oe=6A9AE273"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-fgdYh2XIwQ7kNvwFfX3Me&_nc_oc=Adpk_AF5pNhvIVBO7Vkw5ergFxDrfphy9atnSptvt6rY8Qky2v8fqgwXiKU6C9TPRx0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPlUfoEU21wbx9Pm1x3Kgbwuc5lqIcjvGk9_7v46BrFQ&oe=6A9AF33F"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbyhXj7PBVcQ7kNvwHfskWp&_nc_oc=Adp1OkcyPBqNvuA5b-H_BRPMgOP5UCe9V60Q-GhvvUWlvF966rQVKiOQQQPB3fHI1Lk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItJibQwwe9743DC9WZv9pHxBejrM-vBbmq0p5jjNyrEg&oe=6A9AD90F"}, "is_concept": false, "is_test": false, "is_tria
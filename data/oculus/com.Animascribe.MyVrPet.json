id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1QPlyl0acQ7kNvwEACP9t&_nc_oc=AdpsJ-BpdxPagm9PkoOVSFGqnC27Wg24gWqkAmXCTIEhwIUZrk6Xc_geSJrMN7l37Yw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLICJKQrQBc9WEGVLkm7qRQvgcEujku79JjZ7la8ntOcg&oe=6AA0183F"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxivZGl7AcUQ7kNvwGYH2vm&_nc_oc=AdroXUbj_-5SfYU1vTu7oANfWaJBW5H5Kz3roBq-b7poLylgnA-Mfvn4vmdHZLRcXG8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhpuRDUifSl4bDcic8jWLi1dAcMidxjXrO5YHbuhVv1g&oe=6AA00E76"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqS_OGIQJ8gQ7kNvwHBZul7&_nc_oc=Ado7Sp_wwPNisinQIYU1JO-mn7LszHRnb-17gYaNoPmGPmP66_vzr2klcQcaIMOJWt0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-LOo4U26yldOeHhI7QO6QmTo98NWySnHmQT5TpvSWgg&oe=6AA00DAD"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5s1wGzlFla0Q7kNvwE3mxOW&_nc_oc=AdoaXeVyPRpywgIWQ8vHeC-t4skQcT2jJ1JHwlEy_eX4Q5ZgwQBGtSNmjFT53tE7O2Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsSXNkkiytEv0wTh-OjUmz_r85pNABUoDj3lLAV1obkg&oe=6AA01076"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w96BEmemKXYQ7kNvwEhWRh2&_nc_oc=AdplcLcbcDzc-QE65iLnjEHZ1hNK0a-Mfj1N4ybWzr_7eGQRV4zbXgeXEbS4Ag94giA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6yG7cUfoF1HvUL4mbJYa5enKKPoxYwNQT3PLjc21a3g&oe=6AA02873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3Kw3d6iBakQ7kNvwHPXd0f&_nc_oc=Adpu7Tw4HgzR7f5b0NAZTeaalzyHIiBgv-5cBcgsm7GQ6binwaPtbA6PP7O4n1qOqC8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ55jn5ZVRjd-4iCmNtxMKpIFZywJQ22nrI_FrIThMjjQ&oe=6AA000FF"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0JFtRq5giYQ7kNvwG88RE_&_nc_oc=Adpi6G__ArXLpYUuExJF6YkDSf30EyGs_Ls0XVEIQL7ItBRGTjM2LwiLsJcYjkdf3Ok&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqZE6iUMR823EGoy74zg-Vn5tJtYa4tjhocXVj1fnPCQ&oe=6AA01F0F"}, "is_concept": false, "is_test": false, "is_tria
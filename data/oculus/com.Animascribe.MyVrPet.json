t_Thumbnail3_square_portrait.png", "id": "1233274368209533", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823802_1233274374876199_6432387455122002144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ3FPBKP9PcQ7kNvwGIprai&_nc_oc=AdpTNm0R0NLCwcUkmE9nHnFRBm7aZsxx20hF6PJDGHHc8suzGiU3qRqITYHgvoHiV6Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3qWtRwfq0KJ29lsoI6VJmhpVbl1uNQ3vD343UUtOPcQ&oe=6AF9D0EC"}]}, "id": "1522719439666151", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ntz6XurGch4Q7kNvwGD3NqH&_nc_oc=Adpzm6l7yPUdiypLvP_WiepCJ_K6br8966lBzVEkbT_ZEJc73TtI4OqYBedDnDp5nwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVopN1BMG8w9WfGrTZbMMCWJpimF3wknBhBZW7JcuI0g&oe=6AF9BE3F"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78sA5F2gAoAQ7kNvwHI48W_&_nc_oc=Adq_Wacb__sY_iGsX724bp1XByl3C0EBGr_bl8XhPra_PftrmsieoQ8FEHw38RP8MaI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBOtFTfPTPtoP6l-BP64Ze0UsTxRR3lXYpJITsSGbLpw&oe=6AF9EBED"}, {"file_name": "MyVrPet_4_guardian.png", "id": "1674559800848306", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823930_1674559804181639_3867291446791519111_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmWXWyD5D0oQ7kNvwFULPDb&_nc_oc=AdqwBDOdcpy0gz4yLuQLaA1G7DWqbx-jh1O39FkNvRHXkfzkP68Bo699W7JpEKgArMk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtLl7XerM9sPPgb0lYSz2AdV6MeIxAGd70yJFL-k9XSA&oe=6AF9D046"}, {"file_name": "MyVrPet_1_petting.png", "id": "1666219834839997", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1666219838173330_886191741722259131_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcAqlHNafCkQ7kNvwHb_weH&_nc_oc=Adqk0B3HJdu-bWlTLhrab0gGvhELuTqmUbWXrr1cLL0tJ5E3_lwvpqrqXB6wBWKGgas&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJBCbv-EAiTa6JPzfZ3NVyCVAAY6bcTo730zvAUJbb1w&oe=6AF9D560"}, {"file_name": "MyVrPet_1_petting_tuxedo_alt.png", "id": "1624056532509555", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_1624056539176221_7469513480552630896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q08Hkito0sQ7kNvwFLzh32&_nc_oc=AdpQXpRx2sEy16abzxTgIZjjHPxRBHZv1KPV5uuQx5YWelnAElzWzLMyIyUXAvBLi80&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYhduQQzXWDxG28SDnAgMC2sgc3YUEFBkLv2MJ-9EZ0Q&oe=6AF9BC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_1_petting.png", "id": "1167056619606201", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823366_1167056626272867_7360216479381422110_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU4IwgPlgcUQ7kNvwGPjFBM&_nc_oc=AdrFrrfLKyBZTWWXPMQbdTRFfyPanWJj1VsxL3owRcF1dcfiQe6lJaVW0sUMXvZqTT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOET8JsfDHWdHaHvhNRQvR24LBNtPxwn1jit2OJRwoQA&oe=6AF9BC56"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# A pet that lives in your real room, and slowly learns to trust you.\n\nReach out with your bare hands to stroke it, pick it up, brush it and play. It roams your floor, hops onto your furniture and naps in its favourite spot.\n{4240380252926560}\n# Build a real bond\nGentle attention earns its trust across **five Bond stages**. Find its favourite scratch spot, build daily rituals and come home to a happy greeting.\n{1802219420795733}\n# A mind of its own\n\nYour pet asks for food, a brush or a cuddle, gets the zoomies, follows you around and sometimes knocks your decor off the shelf. Each one has its own **temperament** to discover.\n\n\n# Care for it\n**Brush** its fur, feed it when it's hungry, and scoop it up with both hands.\n{1646224283824248}\n{958049147160087}\n# Play together\n\n- **Pounce Patrol:** point the laser at holographic critters and your pet pounces. Daily hunts and Hunter Ranks.\n{1921188992199452}\n- **Guardian Mode:** swat invading pests and your pet finishes them off. Cozy wave survival with 20 upgrades.\n{2537985816683522}\n- **Fetch:** throw a ball and watch it come back.\n\n# Pets to adopt\n\nStart with an **Orange Tabby** cat or a **Shiba Inu** dog, then unlock six more pets with **Sparkles** earned through play, daily rewards and quests. Spend them on decor and toys too. No extra purchases, and more pets are on the way.\n{4424009351244345}\n\n# Good to know\n\n- Mixed reality for Quest 3, 3S and Pro\n- Hand tracking recommended, controllers supported\n- Scan your room so your pet can explore your furniture\n\n", "short_description": "A pet that lives in your real room. Pet it with your bare hands, earn its trust, brush it, play laser hunts and defend it from pests. Adopt cats and dogs, from a cozy Tabby to a Shiba Inu."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_
 "id": "1728998924807671", "locale": "en_US", "screenshots": [{"file_name": "2026_05_10T09_00_24_000Z.png", "id": "965710112912438", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499303391_965710119579104_3871767148604700771_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6fa_X1pq38Q7kNvwEKWIoZ&_nc_oc=Adoa3A4t30F-pVl2SVfVcvztkhc9zBZktBpwelDqXV2QjtH6JvKScVOemGbbyKnAQRs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7TVP4UcYj0ZsoefQ4uqiX_RvCElUBNLbUwaF_g6iPjg&oe=6AA40CBF"}, {"file_name": "Menu.png", "id": "1349385013674719", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499304938_1349385017008052_7343399153665946756_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHq8JqTPGT0Q7kNvwH5IRs5&_nc_oc=Adqxj_n-xdBBXcjT6N8-jTETbQhWPEqKt4C6L0efTZg6M7YSW8o_PdxkSg7KIOgUE8k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhVLOywjiVHxRcf_KSR2MYns57WYiU1OAL1XZlL30ssQ&oe=6AA402F6"}, {"file_name": "Laser.png", "id": "1917507465569361", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499303391_1917507468902694_1005378183334960383_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnL1ceqZzV8Q7kNvwGDlu1u&_nc_oc=Adp6jQwA9LQkDgzPgzKDsuvuD1cngN2SdC0Sr-gVyQKdxjpAQBB06qxyzrDd3gjkfMs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8YNTGhy6SDllK43tS0bXT_Be8FDyCOkOJqqx0UXCmeQ&oe=6AA4022D"}, {"file_name": "Shop.png", "id": "1557701039111782", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499308307_1557701045778448_7676133339445337734_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr73UJcq8sYQ7kNvwFXGvin&_nc_oc=AdqVBgYExNFPRp0Mi5l4vhoJ_J1PTjsLGL9sQT5ZFZuV-cV4xq-1bXhSPj7MCreDy_o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLarKtjhWJ71yQ7C9SD4BWKEE1xt0niIZe08CW1PLk2MA&oe=6AA404F6"}, {"file_name": "2026_05_10T09_03_40_000Z.png", "id": "2212014046211227", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308050_2212014049544560_5744980226097404565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oxx-l2zo24Q7kNvwEm5rfy&_nc_oc=Ado_0bjTdq8coqhUIulKcpS-be-pGbCel7KYWZKY904SV7ZtJfWuC7h__okM7uPQH9g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILbI6Jj-NYGm5vUnzfXS0geSIBwigJsfqzikHwLVOEGg&oe=6AA41CF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Store_Fixed.png", "id": "1619123119883621", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824322_1619123123216954_8753445427866463415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSULLpm4sEYQ7kNvwGNH5Vg&_nc_oc=Adr9Qx0KrAYmgzNn0IEPOEYqXytEaTVZC5RUW-qYQ6sBcnKWlWPJU5op-z2VnMKxngk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJy9MVdb5TcIxMvhJdz5yPIzwbjG64tlGTh_B7y0VTrA&oe=6AA3F57F"}, "display_name": "MyVrPet", "keywords": ["Companion", "Cat", "Simulator", "Pet", "Handtracking"], "long_description": "# Meet your new mixed reality companion\n\n**My VR Pet** brings a lovable virtual pet into your real room, turning your everyday space into a cozy playground for care, play, and connection.\n\nReach out with your **bare hands** to pet, feed, carry, and care for your companion. Your cat reacts to your attention, follows your movements, wanders around your room, rests when tired, and shows its mood through playful animations, sounds, and emotes.\n\n## What you can do\n\n- **Pet and cuddle** your pet using natural hand interaction\n- **Feed it** when it gets hungry and keep it happy\n- **Play laser pointer** and watch it chase the dot around your room\n- **Throw a ball for fetch** and enjoy active play sessions\n- **Decorate your space** with unlockable items\n- **Earn daily rewards** and complete simple daily quests\n- **Build a bond** by returning each day to care for your pet\n\n## Your room becomes part of the game\n\nYour cat can explore your scanned space, move across floors and furniture, and blend naturally into your surroundings with mixed reality passthrough. It feels less like watching a pet on a screen and more like welcoming one into your home.\n\nWhether you want a relaxing companion, a playful little friend, or a cozy reason to return to VR every day, **My VR Pet** gives you a pet that feels present, responsive, and close \u2014 without controllers, cages, or cleanup.\n\n**Step into mixed reality, reach out your hand, and meet your new companion.**", "short_description": "Meet a virtual cat that feels at home in your real room. Use your bare hands to pet, feed, carry, and play together, then come back each day to care for it, earn rewards, and grow your bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28370692542537877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618093_4278994889030160_8213558866266595046_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TrCd49u5eQQ7kNvwGoV_K1&_nc_oc=AdocrjTXov4f-v3vrASOwKR9JeWFhaBbDK_32SyR9ztzJdQU5pGBj79O5QFG3XRdZ_4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcoFcZ3xo5Rf4Jo5Gt1cUTQnxMroRlMEIfSu6PhuPgaA&oe=6AA4138F"}, "is_concept": false, "is_test": false, 
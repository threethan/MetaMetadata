92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyVrPet_Thumbnail3.png", "id": "1942520110018720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_1942520113352053_1794903035974090417_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V480VGHI3c0Q7kNvwGdXs24&_nc_oc=AdrI06EC3-5_XePmY6it7nbqH6SyeImr8WxDbrR8MbXxX2E0uEuhIMRQ2raYjU8RUN4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz1iC41r5l_29StQz8rxdRchKiEGIzimWCBCykVCtZkA&oe=6AE6156B"}, "display_name": "MyVrPet", "keywords": ["Companion", "RealTouch", "Pet", "Cat"], "long_description": "Dive into a new reality with MyVirtPet, the ultimate virtual reality pet companion. MyVirtPet transcends traditional pet simulation by offering a deeply immersive and interactive VR experience. Connect with your virtual companion like never before with a new \"real touch\" technology that allows you to really touch your pet! Engage in heartwarming interactions, play exciting games, and don't forget to feed the pet. Experience the joy and fulfillment of nurturing a virtual friend, built specifically for the Meta Horizon platform. MyVirtPet is where emotional connection meets cutting-edge virtual reality.", "short_description": "Experience the joy of a virtual pet with My VR Pet. Interact, train, and form a genuine connection in an immersive virtual reality"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.myvrpet.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "AnimaScribe", "support_website_url": null, "website_url": "https://www.myvrpet.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "rec
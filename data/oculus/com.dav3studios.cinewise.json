9S8m9xpR8YHNK8tyw&oe=6B0F03A1"}, {"file_name": "05_about.png", "id": "1460481959393539", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908835827_1460481966060205_6317653499838212430_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OodJgsC6jbQQ7kNvwGAQkpX&_nc_oc=Adqnwqk0hpR0J3kyBb-ce_hfbetke6q-Sd5YCZGkiBXTjdgCDCsKRkiy081jCKCh0HE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0BxfO2puEHvTuPTfw0Bsva6sXGPY7hAD3h-PmrdJdmg&oe=6B0F031D"}, {"file_name": "04_nas_settings.png", "id": "2355518881910813", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835887_2355518885244146_5567062589185599854_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVO0dvZ_S9oQ7kNvwECtIA0&_nc_oc=Adq0oRnjG0xT6KN-GRuQq0vYQg5dyOEfK31gSfg2cZnbZfGpHypMj2fRQzysTahTa9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW44jmCLww3LxSCLYuLuYVB3A_DGFgGpdLOPOdMEIVX1A&oe=6B0F05C8"}, {"file_name": "02_movie_list.png", "id": "1533216203204731", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835827_1533216206538064_3751738792676911852_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QS1lqimKpqUQ7kNvwFyppF0&_nc_oc=Adp3zBSJVfAUV0uLycpt9wNO4PovKTqEg51DgqkKCOAycsYvs-ftnEAdSul8ynjHjIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX63fBW_46qI5JmBNORsYfVrU2sRLbPeVY1jYm5f_xMzw&oe=6B0F048C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1869309224254681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835821_1869309227588014_4954622477431962852_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=payT98rDkKoQ7kNvwHw6E-D&_nc_oc=Adr5xtmLnxU_AgYtVct8jRQ-K6u0YG38z3oxS8BoFCcpdZyTnD5uTzVtll95E4WUpVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwpuk6uWkIu7CsIn7seMgdFUMEM-FNGEiLyvivq382aw&oe=6B0F137B"}, "display_name": "CineWise", "keywords": ["cinema", "media", "3d", "movies"], "long_description": "YOUR 3D MOVIES, IN REAL 3D\nCineWise sends each half of the picture to a different eye, so a 3D movie file has the depth that it was made with. Pick the screen size, from a 40 degree screen to one that fills your view, in the dark.\n\nFROM YOUR OWN NAS\nFind your NAS on the home network, or type the address of its shared folder (SMB) once. CineWise lists the MKV, MK3D, MP4 and M4V files in it and plays them straight from the network. You can jump to any point, even in a very large file.\n\nTHE RIGHT 3D LAYOUT\nCineWise reads the 3D layout from the file and its name: half or full side-by-side, and half or full top-bottom. If a file is labelled wrongly, pick the layout yourself. A 3D check shows a different colour to each eye, so you can see that the 3D works.\n\nSAVE FOR LATER\nSave a movie to the headset storage with one button and watch it on a journey with no network. Delete it with one button when you are done.\n\nSOUND\nPlays the common surround sound formats of movie files and mixes them for the headset speakers or headphones. Pick another sound track, for example another language, from the controls.\n\nPRIVATE\nYour NAS sign-in details stay on the headset in encrypted storage, and the app does not send them to us. No ads, no account to create and no in-app purchases.\n\nWHAT YOU NEED\nA NAS or computer with a shared folder on the same network as the headset, and 3D movie files that you have the right to play. CineWise comes with no movies.", "short_description": "Watch your own 3D movie files on a giant screen, with real depth for each eye. CineWise plays side-by-side and top-bottom 3D files from the shared folder on your NAS or computer, over your home network. It finds the 3D layout of each file for you. Save a movie to the headset and watch it with no network at all. No ads, no account to create and no in-app purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dhl84.github.io/cinewise/privacy.html", "developer_terms_of_service_url": "https://dhl84.github.io/cinewise/terms.html", "publisher_name": "David Lee", "support_website_url": "https://dhl84.github.io/cinewise/support.html", "website_url": "https://dhl84.github.io/cinewise/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1517741711413084"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1173372555395236"}, {"status": "PUBLISHED", "id": "1127723153427292"}]}, "baseline_offer": {"id": "1127723153427292"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797278400, "status": "PUBLISHED", "id": "1173372555395236"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1517747604745828", "version": "1.0.0"}, "id": "2745461752555030", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1517741708079751", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1517747604745828"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2745461752555030"}]}, "change_log": "First ALPHA build of CineWise.
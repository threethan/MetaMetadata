NvwGJZh4b&_nc_oc=AdpQFq41HxeifXvJtfDfsnenc91GZjEsM_B-K_o9EKqob2IOAyH8avNeaIFl-zkq9Vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZPeNSZERWtgPYAjjTi4fxpTjXsfuSjrHbHMb09RsQXA&oe=6AF8A28E"}, {"file_name": "HalloweenSneak5 (1).png", "id": "1573950076564522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1573950079897855_5936192113943480356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CD4Ea8UVawQ7kNvwEfZM1y&_nc_oc=AdrbrvyTOMFLrPdl1fX51pCkElsHb_z0U4p-DNBuX3bg5BhVsxfxV3oY9d-aempMTBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiH754zuZolrOSWaslpx5_66zDuUOsHVRwbLf2VLkAFw&oe=6AF88804"}, {"file_name": "Training2 (1).png", "id": "993997169161194", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974900_993997172494527_3748398888020150400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtolF0HrsFYQ7kNvwEuNCqo&_nc_oc=Adop_LOrcK96rAjNN9IWLF4dZGjOJDTzaEsQ6qP9Ln3NVWMBxkfuM9wZ8GIaOqH6BxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTozOHAq4JxL0_KuRebgRfbkqNHJV42tvyAEBSuSIeopQ&oe=6AF888AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Knockout", "keywords": ["Boxing", "VK", "Virtual", "Knockout", "Box"], "long_description": "### Virtual Knockout \n\nStep into the ring with **Virtual Knockout** the ultimate free VR multiplayer boxing game. Whether you're a beginner or a seasoned boxer, VK offers an immersive and exhilarating experience.\n\n**Features:**\n\n- **Multiplayer Mode**: \n  - **Public Lobbies**: Spar with players worldwide in exciting, competitive matches.\n  - **Private Lobbies**: Practice and compete with friends or selected opponents in a controlled environment.\n\n- **Training Arenas**:\n  - **Public Training**: Join sessions to learn new techniques and improve skills collectively.\n  - **Private Training**: Train solo or with a coach, focusing on specific areas like speed, power, or defense.\n\n- **Realistic Boxing Mechanics**:\n  - **True-to-Life Movements**: Experience authentic boxing with advanced motion tracking.\n  - **Dynamic Environments**: Fight in various arenas, each with a unique atmosphere and challenges.\n\n- **Customization and Progression**:\n  - **Avatar Customization**: Personalize your fighter with a wide range of options.\n  - **Skill Progression**: Track your progress, earn achievements, and climb the ranks.\n\nPrepare to enter the ring and prove your skills with Virtual Knockout!", "short_description": "Welcome to the first ever Free Quest Multiplayer Boxing Game! Join public or private lobbies and brawl!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16nVx6NY4obMdecDeanQVyuQt7YWvr4kuDTn19ccpQ0U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Phoze", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1YkGs89urCk65xODWdYlGF4bFnXxgmVktcYsBFWT1tn8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8442250215885863"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8514601398650744", "version": "0.25"},
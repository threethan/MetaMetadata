Fmt29Uq6mAQ7kNvwGMLMMX&_nc_oc=AdrhTm4c1R5rsSkumfJKwv1bTX7JqQcQ6VYkdGG1MEaWvQ9ByXCNphhuM5Gvx1yc9mM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44oZ0WwSUBzCMwktqQb4tFzzRpWlZA-TlONTYCkN3Ing&oe=69F9E1C2"}, {"file_name": "MikeRing (1) (1).png", "id": "1104907238013447", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031551_1104907241346780_2679845581644232202_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8rXlNbWNSAQ7kNvwFK0au2&_nc_oc=AdoZIkGwLsdrY4m_zk_CGENkFe5Dlq0DiUGXidVlvknhVz0GLQbGEvGZUhZaZ4kRuA8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W26QHmPWQvXy8OxlLcYjTRHy24hRkXkB6UEA3EP6J8g&oe=69F9F8CE"}, {"file_name": "HalloweenSneak5 (1).png", "id": "1573950076564522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1573950079897855_5936192113943480356_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hE45J2OW18wQ7kNvwGcBvMR&_nc_oc=Adq0NALzZ-iciyAIaEQfwrBA_EmMwMhD2GPGiArzswE87d7K73nBYWcpttJxD8mjKOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jXKzN-lgWY5orUcMBVvp5Mz-7o9DO4ZHKWD2UGO5VjQ&oe=69F9DE44"}, {"file_name": "Training2 (1).png", "id": "993997169161194", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974900_993997172494527_3748398888020150400_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns6LyYBacX0Q7kNvwF0MeXV&_nc_oc=AdpcgD5a7ADa3S3k-ecjHFrqAqydCjnDfZXcGLT3pHv8KPTz-pksxwRGzaZjRk9Joe0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XdKjib2fiPUpAPUP9DadQgfz7mkALs0unCxkQqcZGqA&oe=69F9DEEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Knockout", "keywords": ["Boxing", "VK", "Virtual", "Knockout", "Box"], "long_description": "### Virtual Knockout \n\nStep into the ring with **Virtual Knockout** the ultimate free VR multiplayer boxing game. Whether you're a beginner or a seasoned boxer, VK offers an immersive and exhilarating experience.\n\n**Features:**\n\n- **Multiplayer Mode**: \n  - **Public Lobbies**: Spar with players worldwide in exciting, competitive matches.\n  - **Private Lobbies**: Practice and compete with friends or selected opponents in a controlled environment.\n\n- **Training Arenas**:\n  - **Public Training**: Join sessions to learn new techniques and improve skills collectively.\n  - **Private Training**: Train solo or with a coach, focusing on specific areas like speed, power, or defense.\n\n- **Realistic Boxing Mechanics**:\n  - **True-to-Life Movements**: Experience authentic boxing with advanced motion tracking.\n  - **Dynamic Environments**: Fight in various arenas, each with a unique atmosphere and challenges.\n\n- **Customization and Progression**:\n  - **Avatar Customization**: Personalize your fighter with a wide range of options.\n  - **Skill Progression**: Track your progress, earn achievements, and climb the ranks.\n\nPrepare to enter the ring and prove your skills with Virtual Knockout!", "short_description": "Welcome to the first ever Free Quest Multiplayer Boxing Game! Join public or private lobbies and brawl!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16nVx6NY4obMdecDeanQVyuQt7YWvr4kuDTn19ccpQ0U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Phoze", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1YkGs89urCk65xODWdYlGF4bFnXxgmVktcYsBFWT1tn8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
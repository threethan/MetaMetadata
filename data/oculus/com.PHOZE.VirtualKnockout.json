9_487640174257079_4205197844445410285_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFoLLMgB188Q7kNvwHudLGL&_nc_oc=AdqmfJWreskf5NPx1NCp4HPxcOlAPJHYvsCahcihydu-f29eiFOhkHvZt5WCogxTr5Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdaCn37N5j_1SIAhKdvofLKOUj22Jc1ZhJdkdtFiuYDQ&oe=6B0B38C2"}, {"file_name": "MikeRing (1) (1).png", "id": "1104907238013447", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031551_1104907241346780_2679845581644232202_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWSARihIleEQ7kNvwE6km4A&_nc_oc=AdoW_4jPLNVso8TGZpXmlhlOj9HbanFoP8IpEwhDyaZFrNtdm8t94HbIq9Mdbr5DJxI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVIo2O_p4BKh1ENhqhkFST5goM_8piDA6T_a1lxWIhxw&oe=6B0B178E"}, {"file_name": "HalloweenSneak5 (1).png", "id": "1573950076564522", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974854_1573950079897855_5936192113943480356_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzXnErFU0BMQ7kNvwG-wWJD&_nc_oc=AdqJbnfE69f9_6r2v6bDjrD1FhD42FHkYOceSwlMYRxuwGIWQ3qyn5xeo9BH36nmpvI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjiGruRYd_p9zP2_r_6wjy4CSfsqbZdvQe8bvBpioHmA&oe=6B0B3544"}, {"file_name": "Training2 (1).png", "id": "993997169161194", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974900_993997172494527_3748398888020150400_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1EirmxTdJ0Q7kNvwFcRSD9&_nc_oc=Ado1R2EDPDQUGO-FkuPgESVDSXOBoPvTnikZI-dVUSzIjMai78QmHc7oi767ohB4tFA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSls25n06SOeM4V7QSjFWm4BckoDULdIoJt55uDZ9DemA&oe=6B0B35EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Knockout", "keywords": ["Boxing", "VK", "Virtual", "Knockout", "Box"], "long_description": "### Virtual Knockout \n\nStep into the ring with **Virtual Knockout** the ultimate free VR multiplayer boxing game. Whether you're a beginner or a seasoned boxer, VK offers an immersive and exhilarating experience.\n\n**Features:**\n\n- **Multiplayer Mode**: \n  - **Public Lobbies**: Spar with players worldwide in exciting, competitive matches.\n  - **Private Lobbies**: Practice and compete with friends or selected opponents in a controlled environment.\n\n- **Training Arenas**:\n  - **Public Training**: Join sessions to learn new techniques and improve skills collectively.\n  - **Private Training**: Train solo or with a coach, focusing on specific areas like speed, power, or defense.\n\n- **Realistic Boxing Mechanics**:\n  - **True-to-Life Movements**: Experience authentic boxing with advanced motion tracking.\n  - **Dynamic Environments**: Fight in various arenas, each with a unique atmosphere and challenges.\n\n- **Customization and Progression**:\n  - **Avatar Customization**: Personalize your fighter with a wide range of options.\n  - **Skill Progression**: Track your progress, earn achievements, and climb the ranks.\n\nPrepare to enter the ring and prove your skills with Virtual Knockout!", "short_description": "Welcome to the first ever Free Quest Multiplayer Boxing Game! Join public or private lobbies and brawl!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16nVx6NY4obMdecDeanQVyuQt7YWvr4kuDTn19ccpQ0U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Phoze", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1YkGs89urCk65xODWdYlGF4bFnXxgmVktcYsBFWT1tn8/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connectio
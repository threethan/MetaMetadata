?\n- **Totally Insta-worthy Views**: Explore a stunning night city!\n\n# This Game is Purr-fect for...\n- **Cat Lovers**: Who wouldn't want to be a kitten for a day?\n- **VR Newbies**: Easy to learn, fun to master!\n- **Thrill Seekers**: Get your adrenaline pumping!\n- **Anyone Who Needs a Smile**: Kittens make everything better!\n", "short_description": "Take on the role of a cat and cross a dangerous street with zooming cars to reach your owner!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9234950079926763"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "699494079916932"}, {"status": "PUBLISHED", "id": "1219336476524375"}, {"status": "PUBLISHED", "id": "650817990609716"}]}, "baseline_offer": {"id": "650817990609716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "699494079916932"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9235662666522171", "version": "0.0.1"}, "id": "477656662059109", "channel_name
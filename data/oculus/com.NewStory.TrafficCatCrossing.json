.oculuscdn.com/v/t64.5771-25/473391906_979247220218756_3651339460610878182_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN1335k2ROsQ7kNvwFkBWMd&_nc_oc=AdnNQClUtOUFazV4a1NXDhdVW0DmLUCiDkP_wrCv-QueBDCRNfxwfoSDEhoQ7oIMr1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCCyxA5GT2_rLVmW0uf9st2-P0d4FB9wUptDkFH1e6mg&oe=69BFD308"}, {"file_name": "\u2464.png", "id": "656862350099082", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392167_656862353432415_2745064853244479451_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlKOK6LGZ4AQ7kNvwGpv5VQ&_nc_oc=Adnu9HMC9A3TN-R3E2Wtl1neFyzEy4cKTb1SVaXWAO8W49vzVZ1FHY5dNxUIulMdYpQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuvnUsGSAYXZ6Wwu7elk6wtY65bMI8BtLLE9D1REEpXQ&oe=69BFFD91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1150529536712248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391878_1150529540045581_8652329326866766139_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSzORwnuNqsQ7kNvwEBVNp0&_nc_oc=Adn905tP1UxaYPZDC5TAuJLyC-FGa09z9Vc6E4-FTk7_5wMwPKR5np56x-mLRMZgE3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBwSrkFsjO2qYC2a8m_14H0aHKOqo-aB_C712qk6Ij5Q&oe=69BFDF44"}, "display_name": "Traffic Cat Crossing", "keywords": ["Kitten", "cat", "Pet", "Danger", "Adventure"], "long_description": "# Run for Your Life, Kitten! It's Time to Cross the Road! \ud83d\ude97\ud83d\udca8\nEver wished you could see the world through the eyes of a kitten? Now you can! In this VR adventure, you're a lost kitten trying to get back to its owner. But watch out! The road is packed with cars, crazy creatures, and tons of obstacles.\n\nUse your kitty senses to dodge traffic, avoid danger, and follow the yellow brick road...err, yellow painted footprints! Can you make it home in one piece?\n\n# Features\n- **Paws-itively Immersive**: Feel the rush of crossing the road, from a kitten's perspective!\n- **Easy Peasy Controls**: Anyone can play!\n- **Wild Surprises**: What crazy creatures will you encounter?\n- **Totally Insta-worthy Views**: Explore a stunning night city!\n\n# This Game is Purr-fect for...\n- **Cat Lovers**: Who wouldn't want to be a kitten for a day?\n- **VR Newbies**: Easy to learn, fun to master!\n- **Thrill Seekers**: Get your adrenaline pumping!\n- **Anyone Who Needs a Smile**: Kittens make everything better!\n", "short_description": "Take on the role of a cat and cross a dangerous street with zooming cars to reach your owner!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9234950079926763"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392145_915401430803674_7234024128773300782_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pf9tYQkAiYQ7kNvwEW6qFr&_nc_oc=AdlbwS7TIn4sHmf09P5on7nkDvm_KTrSUa3moUTyYaf3KfH_Q34pXJX64lReVxTPSvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCiWcSYDvXQpDGMKXOisZe30kkEcU5hIR0_XcIaYytRw&oe=69BFEA74"}, "is_concept": false, "is_test": false, "is_trial_o
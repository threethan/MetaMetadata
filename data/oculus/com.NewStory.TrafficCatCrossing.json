PB5tRCk4uZsGUXIhB8XA5ndRjA&oe=6B0C7D88"}, {"file_name": "\u2464.png", "id": "656862350099082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392167_656862353432415_2745064853244479451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKjmYdHh6n8Q7kNvwGU5jhj&_nc_oc=AdoIDYspiQmDke-bpFSuEWhXj33PhrBBWSmKOe-pFqZg6rKF_he4j28SXCh6kxkIqH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRiALMmhxYXnlfmQbnWHrFKufwg8V2MvWMC2pM2hnzAA&oe=6B0C6FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1150529536712248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391878_1150529540045581_8652329326866766139_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imtGrQRGx4QQ7kNvwEaK1ll&_nc_oc=Adpu5YSJ6RS62-x5ygHS8XgSuYJ_-8IAZAVPSp1bZgVnWn9oghGaI68aEtvFYTkQKSY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzseM5XheihDpkImViwVIRtMSFIvtISl7xhak9qhQ4cA&oe=6B0C5184"}, "display_name": "Traffic Cat Crossing", "keywords": ["Kitten", "cat", "Pet", "Danger", "Adventure"], "long_description": "# Run for Your Life, Kitten! It's Time to Cross the Road! \ud83d\ude97\ud83d\udca8\nEver wished you could see the world through the eyes of a kitten? Now you can! In this VR adventure, you're a lost kitten trying to get back to its owner. But watch out! The road is packed with cars, crazy creatures, and tons of obstacles.\n\nUse your kitty senses to dodge traffic, avoid danger, and follow the yellow brick road...err, yellow painted footprints! Can you make it home in one piece?\n\n# Features\n- **Paws-itively Immersive**: Feel the rush of crossing the road, from a kitten's perspective!\n- **Easy Peasy Controls**: Anyone can play!\n- **Wild Surprises**: What crazy creatures will you encounter?\n- **Totally Insta-worthy Views**: Explore a stunning night city!\n\n# This Game is Purr-fect for...\n- **Cat Lovers**: Who wouldn't want to be a kitten for a day?\n- **VR Newbies**: Easy to learn, fun to master!\n- **Thrill Seekers**: Get your adrenaline pumping!\n- **Anyone Who Needs a Smile**: Kittens make everything better!\n", "short_description": "Take on the role of a cat and cross a dangerous street with zooming cars to reach your owner!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9234950079926763"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "699494079916932"}, {"status": "PUBLISHED", "id": "1219336476524375"}, {"status": "PUBLISHED", "id": "650817990609716"}]}, "baseline_offer": {"id": "650817990609716"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "699494079916932"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9235662666522171", "version": "0.0.1"}, "id": "477656662059109", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application
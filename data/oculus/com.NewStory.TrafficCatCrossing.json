AQRHggLFB72eGbCjltdAnwqXvXk6YWxSvEh6Qdo8oLGNxQ&oe=6B05ADC8"}, {"file_name": "\u2464.png", "id": "656862350099082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392167_656862353432415_2745064853244479451_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knK8JZ3H5LYQ7kNvwFHXfJJ&_nc_oc=AdpgmQCDmZbAjTBt3QbGVvGt4DVtfD-QXWdXzmyFpN7EuKA2rCZ7VYDRWUKb_KuOFR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEFV40LqdQXAvqf3s_slkZlOaadf2e4XY3FUvHuvuZ1Q&oe=6B05D851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1150529536712248", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391878_1150529540045581_8652329326866766139_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt5WilVEvwsQ7kNvwFb7U8s&_nc_oc=AdpsT8vK_mExZvqGo-EJjLqlgZFUMBcnaEeQhmG08mKRp2-JbXkyKuogYmwF_1oEZBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4R3dSIdK93cWq1qspXBLMhhqVWmK7pvgsm-cdWqpTDw&oe=6B05BA04"}, "display_name": "Traffic Cat Crossing", "keywords": ["Kitten", "cat", "Pet", "Danger", "Adventure"], "long_description": "# Run for Your Life, Kitten! It's Time to Cross the Road! \ud83d\ude97\ud83d\udca8\nEver wished you could see the world through the eyes of a kitten? Now you can! In this VR adventure, you're a lost kitten trying to get back to its owner. But watch out! The road is packed with cars, crazy creatures, and tons of obstacles.\n\nUse your kitty senses to dodge traffic, avoid danger, and follow the yellow brick road...err, yellow painted footprints! Can you make it home in one piece?\n\n# Features\n- **Paws-itively Immersive**: Feel the rush of crossing the road, from a kitten's perspective!\n- **Easy Peasy Controls**: Anyone can play!\n- **Wild Surprises**: What crazy creatures will you encounter?\n- **Totally Insta-worthy Views**: Explore a stunning night city!\n\n# This Game is Purr-fect for...\n- **Cat Lovers**: Who wouldn't want to be a kitten for a day?\n- **VR Newbies**: Easy to learn, fun to master!\n- **Thrill Seekers**: Get your adrenaline pumping!\n- **Anyone Who Needs a Smile**: Kittens make everything better!\n", "short_description": "Take on the role of a cat and cross a dangerous street with zooming cars to reach your owner!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9234950079926763"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392145_915401430803674_7234024128773300782_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOrda25E8e4Q7kNvwGj3lNN&_nc_oc=AdoNOc7-5OF9aKH0JLQTchKX3jeg-VtQVscYI4vmypXEz3GP7U9p41cKXYAd6U8kYOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7NNgLqh0TVv7qDTH5f-S2EwRQa_i8f17Gx2Cjxn7ZNA&oe=6B05C534"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Traffic Cat Crossing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
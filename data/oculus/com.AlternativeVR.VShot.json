 can hone your target shooting skills.", "short_description": "\nVShot is an exhilarating virtual reality experience that brings a shooting range right into your living space. Immerse yourself in an action-packed environment where you can practice your target shooting skills. VShot is the perfect choice for shooting game enthusiasts in virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alternative-vr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Adrian Barto\u0148", "support_website_url": null, "website_url": "https://www.alternative-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8199278966820586"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974477_357648457400845_5431290817072610319_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCaNSUgWHHYQ7kNvwEEt1ev&_nc_oc=AdlPU8ieUSZDRAiiMnG4xhUnmCbtstLG0-zdOnyz1sTW4mCzU9lTOEX19vC54m_tDCg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL_BKCF3Fa092bcDXXMDJquu98HG-E10ElLHetgHUQUA&oe=69AAD27B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V-Shot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040
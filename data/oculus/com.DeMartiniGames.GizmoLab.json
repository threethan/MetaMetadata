c_yw7hs7oYzlHYfvCPQjU9gD-t6BhFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJkJJKxjIYnsvcG-VThOVClKsr3G0jINbNyhLv6nbV4w&oe=6A846202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GizmoLabLogo.png", "id": "1011963554248355", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392023_1011963557581688_6243267122045382057_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0K2gM4ao6sQ7kNvwEXU4r4&_nc_oc=Adqgj5-Jn5xS4laHWWEbFtjkuUDMQzGXl9r6tjmqvuWoWbqCoAwod7__Ovf7kCowHYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8IzCofMRuwoJD1AaWM6r-HcSOQ4s0DCI0oUj68M8IyQ&oe=6A84655C"}, "display_name": "GizmoLab VR", "keywords": ["electrical", "sandbox", "scifi", "puzzle", "simulator"], "long_description": "GizmoLab VR is a VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, gizmos, doodads, and thingamabobs. As the new lab attendant, you and your robot assistant Whizzy can work together to create sci-fi machines that solve challenges, serve customers, and whatever else your heart desires.\n\nUsing the Wire Creator Tool, create wires between electrical components to create circuits. Switch between dynamic and static wires, allowing your components to move around and stay connected.\n\nGizmoLab features over 50 different pieces of hardware that can be wired together to accomplish a variety of tasks. Many of the devices are either identical or simplified versions of real-life electrical engineering equipment, allowing you to apply your GizmoLab skills to real life, or vice-versa!", "short_description": "A VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, with mechanics analogous to real-life electrical engineering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3055fe7b-b9c0-4bb1-b7a5-83d20b479b7b", "developer_terms_of_service_url": null, "publisher_name": "Hidden Roll", "support
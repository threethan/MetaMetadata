r1BaTRySfbiXw0rbNuUSdnc9sa55Yw0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgIJndX1xMzeytVUZYKlQ4g-WOYi0GfDMuSdehFVhcyw&oe=69C7DB82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GizmoLabLogo.png", "id": "1011963554248355", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392023_1011963557581688_6243267122045382057_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=965BBjkac5AQ7kNvwEvkLk1&_nc_oc=AdpYJ2C4XEq1TmYs2hBIw1bHra7zwlTQ9jsbzb0Whlo6CJBRj8VlQvdNYUk_sWmVp-s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZloxNzFIcw6zcqL4YRwn2kTF1Rgh4nsqXeR8Snj6DPw&oe=69C7DEDC"}, "display_name": "GizmoLab VR", "keywords": ["electrical", "sandbox", "scifi", "puzzle", "simulator"], "long_description": "GizmoLab VR is a VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, gizmos, doodads, and thingamabobs. As the new lab attendant, you and your robot assistant Whizzy can work together to create sci-fi machines that solve challenges, serve customers, and whatever else your heart desires.\n\nUsing the Wire Creator Tool, create wires between electrical components to create circuits. Switch between dynamic and static wires, allowing your components to move around and stay connected.\n\nGizmoLab features over 50 different pieces of hardware that can be wired together to accomplish a variety of tasks. Many of the devices are either identical or simplified versions of real-life electrical engineering equipment, allowing you to apply your GizmoLab skills to real life, or vice-versa!", "short_description": "A VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, with mechanics analogous to real-life electrical engineering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3055fe7b-b9c0-4bb1-b7a5-83d20b479b7b", "developer_terms_of_service_url": null, "publisher_name": "Hidden Roll", "support
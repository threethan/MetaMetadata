scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwke0eZKL60N7vm2PMpaV6XrIjGHxfKjJvQthDFmUdoCg&oe=69BAAC82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GizmoLabLogo.png", "id": "1011963554248355", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392023_1011963557581688_6243267122045382057_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTpWvPJlv2cQ7kNvwFGsD7k&_nc_oc=AdmIvR9mi6znhwg_QrBXr2bi29yCUl6byxS8e-xaInOCn3-Cn-iiRYiH_7KcxZtqwIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzzt-FKVzmENx4ZG0zq1bPavD-VoVAee7iNb6lEtgRwAQ&oe=69BAAFDC"}, "display_name": "GizmoLab VR", "keywords": ["electrical", "sandbox", "scifi", "puzzle", "simulator"], "long_description": "GizmoLab VR is a VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, gizmos, doodads, and thingamabobs. As the new lab attendant, you and your robot assistant Whizzy can work together to create sci-fi machines that solve challenges, serve customers, and whatever else your heart desires.\n\nUsing the Wire Creator Tool, create wires between electrical components to create circuits. Switch between dynamic and static wires, allowing your components to move around and stay connected.\n\nGizmoLab features over 50 different pieces of hardware that can be wired together to accomplish a variety of tasks. Many of the devices are either identical or simplified versions of real-life electrical engineering equipment, allowing you to apply your GizmoLab skills to real life, or vice-versa!", "short_description": "A VR sci-fi sandbox game where you can put your skills to the test to build crazy inventions, with mechanics analogous to real-life electrical engineering."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/3055fe7b-b9c0-4bb1-b7a5-83d20b479b7b", "developer_terms_of_service_url": null, "publisher_name": "Hidden Roll", "support_website_url": null, "website_url": "https://hiddenroll.
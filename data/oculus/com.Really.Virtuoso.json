jOKdoogLtJvF9_6egw&oe=69BC03DE"}, {"file_name": "Virtuoso_Screenshot_6.png", "id": "325506343926900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031535_325506350593566_2900022331007622192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68QpNTmHQukQ7kNvwF67-PT&_nc_oc=AdnBWwyKHzsPmjh_qFQD9ICwudBmexoXN5TicBAJ9Ihz3TIvJvW3xPnzNgjOoY0dUNA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6MHDlHryhybvnf7SRH31kWkwzqulorEntaY5VHdVxBg&oe=69BBF6CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtuoso_AnnouncementTrailer_Thumbnail_Main_2560x1440.png", "id": "493858408787112", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974456_493858415453778_1388767016000051640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ES7BGcwcCYQ7kNvwGpRBS_&_nc_oc=AdmJdQ4WsuaCQ1NFRdItqNh-CoJLpRIXjM4xGkE9Jiiom313OxbVwoBCukag61XmBBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxY5rXoqGxM2Xd66lN9Aum1DhJdzgRgzqDqG-N6FT3j-w&oe=69BBE1CD"}, "display_name": "Virtuoso", "keywords": ["music", "piano", "instrument", "synth", "drums"], "long_description": "Grab an instrument and get ready to jam in **Virtuoso**, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!\n{566909679460699}\n# BE THE ARTIST OF YOUR DREAMS\nCreate music in real-time using the **Looper** and easily share it for all to hear! Even if you've never touched an instrument before, features like **Tempo Sync** and **preset scales** help you stay in time and on pitch.\n{553504424257133}\n# MADE-FOR-VR INSTRUMENTS\nThe seven instruments of Virtuoso have been created specifically for VR. Set up your own custom drum kit with the **Empads** and tickle the keys of the three-dimensional **Oorgan**. You can also add vocals with lush reverb using the virtual **Microphone**!\n{1114318553015820}\n# FROM OPENING ACT TO HEADLINER\nThe interactive tutorial along with intuitive instruments and tools means that everyone, from professional producers to casual music lovers, can become Virtuosos!\n{1322385425866029}", "short_description": "Grab an instrument and get ready to jam in Virtuoso, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!"}]}, "developer_name": "Really Interactive AB", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games AB", "support_website_url": null, "website_url": "https://fasttravelgames.com/games/virtuoso", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8997599283653254"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86636484_351323016823417_8910622515579488370_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWkpXqeYOGgQ7kNvwECsb07&_nc_oc=Adl4ROqcu6ZDHvvA9kKOrplPVz_VQvczWK0ibJcd7hSN_zBx-cy0kejvpMTmaBRD_38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzKPnNd-zyRcN3uuWs39dTSLl5jWbQhWinrPgOkW05J3w&oe=69BBE4BB"}, "is_concept": false
culuscdn.com/v/t64.5771-25/39031535_325506350593566_2900022331007622192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzcjOGaeAtsQ7kNvwE0SL0j&_nc_oc=AdnOLPB1Jx96nLIZDMTV8KHKCzCAL_w5ZhqHAF-MfWjY7OzzMH9BGZ2j-Lv9yKf-RAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5gQDReOA5Sg2xLpD96lvvXX8qOQRL-g71QOv7kAXZnQ&oe=6999AFCA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtuoso_AnnouncementTrailer_Thumbnail_Main_2560x1440.png", "id": "493858408787112", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_493858415453778_1388767016000051640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJyRLc8X80gQ7kNvwGKFIX9&_nc_oc=Adk2sIGG82lCVUJrIY8qBDWt2GZecFlGG5fFVg8u-rl1Kt-Vj8cjboVeeGEjTQeTLwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuE7aHO8zX-kdaADc9bosqkZAyTlD7E8WIzle2Ew36cyQ&oe=69999ACD"}, "display_name": "Virtuoso", "keywords": ["music", "piano", "instrument", "synth", "drums"], "long_description": "Grab an instrument and get ready to jam in **Virtuoso**, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!\n{566909679460699}\n# BE THE ARTIST OF YOUR DREAMS\nCreate music in real-time using the **Looper** and easily share it for all to hear! Even if you've never touched an instrument before, features like **Tempo Sync** and **preset scales** help you stay in time and on pitch.\n{553504424257133}\n# MADE-FOR-VR INSTRUMENTS\nThe seven instruments of Virtuoso have been created specifically for VR. Set up your own custom drum kit with the **Empads** and tickle the keys of the three-dimensional **Oorgan**. You can also add vocals with lush reverb using the virtual **Microphone**!\n{1114318553015820}\n# FROM OPENING ACT TO HEADLINER\nThe interactive tutorial along with intuitive instruments and tools means that everyone, from professional producers to casual music lovers, can become Virtuosos!\n{1322385425866029}", "short_description": "Grab an instrument and get ready to jam in Virtuoso, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!"}]}, "developer_name": "Really Interactive AB", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games AB", "support_website_url": null, "website_url": "https://fasttravelgames.com/games/virtuoso", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8997599283653254"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86636484_351323016823417_8910622515579488370_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtVzupz9_fsQ7kNvwHH4p8C&_nc_oc=AdnY4RMngo7qe5EU2lZIrWPKnDpUxElcrskIWnSndX3vVjp0B31JZDurPwLB2BMMSGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR4_qV4RDeIrXNDaTJGEkHA8Ot1mPtqnWfavKbmweAqg&oe=69999DBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtuoso", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id":
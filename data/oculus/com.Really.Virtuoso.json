oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjy5hsiq9yLC9G1Q07relnBi8EVFLlun7LIGh4nHXxog&oe=6AE5F6DE"}, {"file_name": "Virtuoso_Screenshot_6.png", "id": "325506343926900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031535_325506350593566_2900022331007622192_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQGknZZyNY8Q7kNvwFt0DfS&_nc_oc=Adr43NXNO1dtgyr4ijuX5ks5nCwO6qLqEB3pGYSq-5NY7Zg-bDXCnddtPV2l9kEzOlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk64fBxqFbdbpgzctXWWYQsnTz8GizNEdXonVYUBV_Dw&oe=6AE5E9CA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtuoso_AnnouncementTrailer_Thumbnail_Main_2560x1440.png", "id": "493858408787112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974456_493858415453778_1388767016000051640_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXy7bVsdJ4EQ7kNvwFxd7L7&_nc_oc=AdrpSay5e5brcl2pd4dADDj2vRtkCOHhn_mLsqkPSqXt0qMJyRQEb_6IYE0bkycbXVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2XID84xrU0mQmCDAyTVCyJWF0WgAqnrvi-S1XlUbMOQ&oe=6AE60D0D"}, "display_name": "Virtuoso", "keywords": ["music", "piano", "instrument", "synth", "drums"], "long_description": "Grab an instrument and get ready to jam in **Virtuoso**, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!\n{566909679460699}\n# BE THE ARTIST OF YOUR DREAMS\nCreate music in real-time using the **Looper** and easily share it for all to hear! Even if you've never touched an instrument before, features like **Tempo Sync** and **preset scales** help you stay in time and on pitch.\n{553504424257133}\n# MADE-FOR-VR INSTRUMENTS\nThe seven instruments of Virtuoso have been created specifically for VR. Set up your own custom drum kit with the **Empads** and tickle the keys of the three-dimensional **Oorgan**. You can also add vocals with lush reverb using the virtual **Microphone**!\n{1114318553015820}\n# FROM OPENING ACT TO HEADLINER\nThe interactive tutorial along with intuitive instruments and tools means that everyone, from professional producers to casual music lovers, can become Virtuosos!\n{1322385425866029}", "short_description": "Grab an instrument and get ready to jam in Virtuoso, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!"}]}, "developer_name": "Really Interactive AB", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games AB", "support_website_url": null, "website_url": "https://fasttravelgames.com/games/virtuoso", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8997599283653254"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86636484_351323016823417_8910622515579488370_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Won2ODUj5p8Q7kNvwGjeoT5&_nc_oc=AdpdAyCUpW7tZHPYaGvdDkoyPPcAyXPufHX4_W7nzBpZG6Hls69d7V7nzddTlfDdg3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTZNKM
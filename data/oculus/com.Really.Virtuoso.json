: "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86646546_961314061424943_8799712959930446865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-lxPfdSXaUQ7kNvwHRG8zB&_nc_oc=AdkNbJtR-KFVL_EXtKGpZWaMk_vbVcxTEEuUE7_U8wtl_v1V9kyHqDZGo3UnIr2FSPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9veUXEBrV7CwFgTmnmlefpNXtMTrZ-xhGRqTWg_Bgvg&oe=69BEA6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtuoso_AnnouncementVideo_Thumbnail_Logo_2560x1440.png", "id": "604103097341700", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031501_604103100675033_604749419717409359_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oe0wzc3WvXAQ7kNvwF1zwkt&_nc_oc=AdlhZw9qDbzYFDO_ROLEQ7pVzsZde84pVdYwBAo3ulbyxrnaC-8nzgZqLDLba0yeO64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5arQ4iUPx0ZJ2yiG4NjuIdgYd8FEh8rohTw6dNuPxNQ&oe=69BEA53B"}, "display_name": "Virtuoso", "keywords": ["virtuoso", "virtuosovr", "music"], "long_description": "Grab an instrument and get ready to jam in Virtuoso, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!\n\nBE THE ARTIST OF YOUR DREAMS\nCreate music in real-time using the Looper and easily share it for all to hear! Even if you've never touched an instrument before, features like Tempo Sync and preset scales help you stay in time and on pitch.\n\nMADE-FOR-VR INSTRUMENTS\nThe six instruments of Virtuoso have been created specifically for VR. Set up your own custom drum kit with the Empads and tickle the keys of the three-dimensional Oorgan. You can also add vocals with lush reverb using the virtual microphone!\n\nFROM OPENING ACT TO HEADLINER\nThe interactive tutorial along with intuitive instruments and tools means that everyone, from professional producers to casual music lovers, can become Virtuosos!", "short_description": "Grab an instrument and get ready to jam in Virtuoso, your own virtual music stage! This VR musical sandbox lets anyone play and perform music in new, immersive ways. Explore a range of unique instruments made for VR and share your tracks with the world!"}]}, "developer_name": "Really Interactive AB", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games AB", "support_website_url": null, "website_url": "https://fasttravelgames.com/games/virtuoso", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1049933645567093"}}]}, "scheduled_offers": {"count": 45, "nodes": [{"status": "PUBLISHED", "id": "2412869115816972"}, {"status": "PUBLISHED", "id": "1250130690555231"}, {"status": "PUBLISHED", "id": "932443379351075"}, {"status": "PUBLISHED", "id": "1173783488300235"}, {"status": "PUBLISHED", "id": "897540509292943"}, {"status": "PUBLISHED", "id": "1124858079569776"}, {"status": "PUBLISHED", "id": "787371640407374"}, {"status": "PUBLISHED", "id": "1766160384109861"}, {"status": "PUBLISHED", "id": "1340869130364102"}, {"status": "PUBLISHED", "id": "9620711231292993"}, {"status": "PUBLISHED", "id": "1582355539030252"}, {"status": "PUBLISHED", "id": "1379675866323055"}, {"status": "PUBLISHED", "id": "51081051156
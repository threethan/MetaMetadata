OUlVthr7RINchsKPeaioxnwcO0W0KAF4fYAeJAPw&oe=69A0522D"}, {"file_name": "6.png", "id": "1455117118981506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619140_1455117122314839_8638705813961536897_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-x7obyj-n0Q7kNvwHU2oW0&_nc_oc=Adl5q9e8zav4a3xj6oeQTiLZf9UUhExlfVYqpljiXIFvtJj6RFW9tVHOYCgRqps1xlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMrNszDteaTlUW32l-cjjV9sEEHWqbM3Q30OM604NHnw&oe=69A04B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Eggstoriesposter.png", "id": "1029208006005056", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618930_1029208009338389_3137365717513334394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDIKexS-LuoQ7kNvwFgvSHB&_nc_oc=AdltyYOXoeZ-suOG2mRJu33ep_EHvbdi_XHBBt2ugPjC_or3IQQsphD6mr6a2Xwrgbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvrAGzeeSrctB1iRamBk5lKw9XLOpFvacw8ugfachAL-Q&oe=69A040B5"}, "display_name": "EGGSCAPE", "keywords": ["Games", "Social", "Action", "Casual"], "long_description": "**LISTEN: BE AN EGG.**\n\n\nBE AN EGG **NOW!!**. \n\n**BEFORE IT'S TOO LATE**\n\nThese eggs are **CRAZY!!!** \ud83e\udd2a\ud83e\udd5a  \nyes, indeed. These eggs are quite insane.\n\nFull **MULTIPLAYER** shooter, runner, **BAZOOKA-er** with level builder.  \nEggscape has the most amazing BATTLEPASS of all games in VR!\n\nThe most absurdly fun cosmetics. **Weapons, power ups, the best rewards.\n\nNew levels coming all the time \ud83c\udf1f\n\n\n# In this game you control INSANE LITTLE EGGS \ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\n\n- **Multiple game modes**\n- **Fully immersive level builder**\n- **Weapons**\n- **Vehicles**\n- **Realistic physics**\n- **Evil robots**\n- **Magic Powerups**\n- **EGGSTREME cosmetics**\n\n\n\n**Free to play.**\n\n**ps: egg**", "short_description": "**LISTEN: BE AN EGG.**\n\n\nBE AN EGG **NOW!!**. \n\n**BEFORE IT'S TOO LATE**\n\n\n#these eggs are **CRAZY!!!** \ud83e\udd2a\ud83e\udd5a  \nyes, indeed. These eggs are quite insane.\n\nFull **MULTIPLAYER** shooter, runner, **BAZOOKA-er** with level builder.  \nEggscape has the most amazing BATTLEPASS of all games in VR!\n\nThe most absurdly fun cosmetics. **Weapons, power ups, the best rewards.** Become an EGGSTAR  \n\u2b50\ud83e\udd5a\n\nNew levels coming all the time \ud83c\udf1f\n\n**Free to play.**\n\n**ps: egg**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eggscape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Eggscape Entertainment Inc", "support_website_url": null, "website_url": "http://www.eggscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24468781969414360"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300873_23870198839319351_707310657209983445_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvhyk-aO-r0Q7kNvwFt-Urq&_nc_oc=Adn7PUUsFM4ueBtoPb4nQZ7AbDWhJLM6T8DvGEXIfHJhYaUkPvwYAIIk4tcEWPtVzHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu3NnpelmM4Z0jHtpTO9_wbFhwCn0dHQUCwabxfEugEWg&oe=69A04586"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EGGSCAPE", "platform": "ANDROID_6DOF", "context_category": {"c
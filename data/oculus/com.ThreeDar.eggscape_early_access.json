3APivUL_x-HcTUVY-miWxJ5kPOP05g1wdSDWSdQw&oe=69F0BDAD"}, {"file_name": "6.png", "id": "1455117118981506", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619140_1455117122314839_8638705813961536897_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktw4bqWEEjEQ7kNvwF8qR65&_nc_oc=AdoFnlMP1STpYGZthcXEYt-UOzcIAPopPl9uNDx6DfCJXoP8h32k-3sEuxdAqQ0RzOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3i8cFusr7mYbzZ4xoqsT0xoRNOV_0BRwoJerRahNE-jQ&oe=69F0B6E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Eggstoriesposter.png", "id": "1029208006005056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618930_1029208009338389_3137365717513334394_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2BIN70UZ8gQ7kNvwHuI_Lp&_nc_oc=AdoBBRWeYQtpNhMPTBAEGPq5bDg79PFbcbVyznpEeqh4znVgu2QUk943vHFl96j9HcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2prYrXActW7xx-UGdBr6wWz6oqvjrTdH9bkYtkvyES_g&oe=69F0AC35"}, "display_name": "EGGSCAPE", "keywords": ["Games", "Social", "Action", "Casual"], "long_description": "**LISTEN: BE AN EGG.**\n\n\nBE AN EGG **NOW!!**. \n\n**BEFORE IT'S TOO LATE**\n\nThese eggs are **CRAZY!!!** \ud83e\udd2a\ud83e\udd5a  \nyes, indeed. These eggs are quite insane.\n\nFull **MULTIPLAYER** shooter, runner, **BAZOOKA-er** with level builder.  \nEggscape has the most amazing BATTLEPASS of all games in VR!\n\nThe most absurdly fun cosmetics. **Weapons, power ups, the best rewards.\n\nNew levels coming all the time \ud83c\udf1f\n\n\n# In this game you control INSANE LITTLE EGGS \ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\ud83e\udd5a\n\n- **Multiple game modes**\n- **Fully immersive level builder**\n- **Weapons**\n- **Vehicles**\n- **Realistic physics**\n- **Evil robots**\n- **Magic Powerups**\n- **EGGSTREME cosmetics**\n\n\n\n**Free to play.**\n\n**ps: egg**", "short_description": "**LISTEN: BE AN EGG.**\n\n\nBE AN EGG **NOW!!**. \n\n**BEFORE IT'S TOO LATE**\n\n\n#these eggs are **CRAZY!!!** \ud83e\udd2a\ud83e\udd5a  \nyes, indeed. These eggs are quite insane.\n\nFull **MULTIPLAYER** shooter, runner, **BAZOOKA-er** with level builder.  \nEggscape has the most amazing BATTLEPASS of all games in VR!\n\nThe most absurdly fun cosmetics. **Weapons, power ups, the best rewards.** Become an EGGSTAR  \n\u2b50\ud83e\udd5a\n\nNew levels coming all the time \ud83c\udf1f\n\n**Free to play.**\n\n**ps: egg**"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eggscape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Eggscape Entertainment Inc", "support_website_url": null, "website_url": "http://www.eggscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24468781969414360"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300873_23870198839319351_707310657209983445_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miISMsrO-X8Q7kNvwEzY73c&_nc_oc=AdotAt_0EEDOMVt-rGMzb-Y0Kpril-9dy_OFQ4i1O4tBX4SMTNM5jQ-LGuPJ4frvdTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af24Adph2J5H8yP9YgQqyBf12ksfN-nJAxeQ_I_NTNDxeA&oe=69F0B106"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "EGGSCAPE", "platform": "ANDROID_6DOF", "context_category": {"c
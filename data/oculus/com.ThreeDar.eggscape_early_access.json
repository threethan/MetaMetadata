wGEAMTj&_nc_oc=Ado360Xbwzpm6Hb1l6alUcgKg_KKCmWZxZDYSDxf2FZUeOoZTfg5gEY7R_do3NNuLhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gu46hzn6MZJmuyJw2NNMGmcjuL3coFC4bLysjii9hsg&oe=69FF2FBA"}, {"file_name": "Thumb3.png", "id": "25796711610002366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_25796711630002364_8978757246336577580_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpKEoiItjx4Q7kNvwHi0zJF&_nc_oc=AdqTCZtLYYSONYDQ98VlTzDHo38YVa6X2QFNgZYfT9ybTg6EMTLCk_c9QPUOFxfzwqk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lZJZcboifa4-3C8Yi92th0b38uauqIgCNM7cMONaHnA&oe=69FF30F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "_TRAILER_GER (0-00-05-11).png", "id": "1637863157428009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623384_1637863160761342_8236348888702488657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JccI--TWimMQ7kNvwEREfU5&_nc_oc=Adq0geYNjbowCzDh9VgQVHsrCngg72RDDnd2cZNMiBs9VhoiaI_O_oRJndGXaWq4IQ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TnG2mXjSv-qtrdGQTg-aqlhpyFFKVQo6DcUl2d923kQ&oe=69FF2012"}, "display_name": "EGGSCAPE", "keywords": ["Action", "Multiplayer", "Shooter", "Party", "Arcade"], "long_description": "You're an egg. You have a bazooka. This is going to get weird. \ud83e\udd5a\ud83d\udca5\n\nEGGSCAPE is a free multiplayer VR shooter and platformer on Meta Quest. Physics-based chaos, shell-slide racing, and a level editor deep enough to break.\n\n\ud83e\udd5a  BE AN EGG\nSmall. Unstable. Every round is different. No two eggs cook the same.\n\n\ud83d\udd2b  SHOOT EVERYTHING\nBazookas, grenades, magic powerups, vehicles, and an arsenal of silly weapons. Fresh items drop with every update.\n\n\ud83c\udfd7\ufe0f  BUILD YOUR OWN LEVELS\nA full level editor with logic and triggers. Make maps. Share maps. Play maps. The community keeps inventing things nobody saw coming.\n\n\ud83e\udd16  FIGHT EVIL ROBOTS\nThey don't like eggs. You don't like them. Everyone's happy.\n\n\ud83c\udf96\ufe0f  UNLOCK COSMETICS\nSkins, weapon camos, trails, and emotes in the Battle Pass. New drops every season.\n\n\ud83c\udfae  PLAYS ON EVERY META QUEST\nRuns on Meta Quest 2, 3, 3S, and Pro. Free to play. No paywalls on gameplay.\n\nSo are you gonna play or what?\n\nLISTEN: BE AN EGG.\nBE AN EGG NOW.\nBEFORE IT'S TOO LATE.", "short_description": "You're an egg. You have a bazooka. This is going to get weird. \ud83e\udd5a\ud83d\udca5\n\nEGGSCAPE \u2014 free multiplayer VR shooter and platformer. Bazookas, evil robots, shell-slide racing, and a level builder deep enough to break.\n\n\ud83e\udd5a Be an egg. \ud83d\udd2b Shoot everything. \ud83c\udfd7\ufe0f Build your own levels.\n\ud83c\udf96\ufe0f Unlock cosmetics. \ud83c\udfae Plays on every Meta Quest.\n\nLISTEN: BE AN EGG. BE AN EGG NOW. BEFORE IT'S TOO LATE."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.eggscape.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Eggscape Entertainment Inc", "support_website_url": null, "website_url": "http://www.eggscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27008420775450454"}, "review_messages": []}]}, "cover_square_image": {"uri"
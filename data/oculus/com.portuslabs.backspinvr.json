release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1284567633335251"}]}, "change_log": "**v0.2.11**\n\n- Added on-the-fly table height adjustment, allowing the table to be nudged up/down during play.\n\n- Added a small power boost to breaks in Chinese and American 8 ball modes\n\n- Minor reduction to side spin\n\n- Fixed bug with small cue angles + side giving significant cue ball swerve\n\n- Fixed bug with meta usernames not showing up in online Quick Matches.\n\n- Implemented more realistic Snooker rules around foul and miss - including options to \u201creplace balls\u201d, \u201cmake opponent play from current position\u201d, or \u201cyou play from current position\u201d.\n\n- Improved the American 8 ball black pocket selection flow. Once a choice is made, all other 8 ball pocket graphics disappear. A \u201credo choice\u201d button has been added under the scoring card, allowing a new pocket to be selected before taking the shot.", "created_date": 1786612757, "id": "27994031156923434", "version": "0.2.11", "version_code": 73, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24032826349710621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28556483830678161"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1284567633335251"}]}, "change_log": "- Updated table alignment to be easier to use, including fine tuning options.\n\n- Fixed table boundaries getting stuck on the \u2018real table\u2019 surface. \n\n- The table boundaries on/off setting now applies to the vs AI mode too.\n\n- Snooker pocket tuning\n\n- Fixed the mismatch between the billboard colours and the tournament American ball colours.\n\n- Updated the tutorial to provide better onboarding steps.\n\n- Updated English pool table cushions to be smooth + higher quality.\n\n- Updated table cloth texture to be a more realistic fuzzy texture, with better lighting for a more realistic feel.\n\n- Other small visual tweaks, e.g. new ghost ball look.", "created_date": 1784827197, "id": "27747876948205524", "version": "0.2.10", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24032826349710621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28556483830678161"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1284567633335251"}]}, "change_log": null, "created_date": 1784824330, "id": "27747417784918107", "version": "0.2.10", "version_code": 71, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
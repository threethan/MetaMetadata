n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FyCoNiBZHEQ7kNvwEo0kfW&_nc_oc=Adr7QuAGTwc1kcMn6LoYXn_ZSVgSyDSv3G1ZQniG99hLR8yvDhQgVDQaiQSHbiDW0Bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsvAVEdQwI3zjDzXeCE7An7oNV_sspI8dcvlHBB3leWQ&oe=6AE49D1E"}, {"file_name": "AmericanRest.png", "id": "2596287607415038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_2596287614081704_1545559327705622933_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqcC7agdV9sQ7kNvwFPH6lC&_nc_oc=AdqmNSCbRx-mZQkwtccpQzitodv9gtlND9f9nIv-NeSEiz0QZYtq3aKc8wk_lJ-rfMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPKKOtQQUSeKqPCejXsiobwjSb0C3naHF9OkyGORZfWg&oe=6AE4A12E"}, {"file_name": "EnglishPool.png", "id": "4204622056427091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_4204622063093757_6459519643035966708_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5f_zHwzKloQ7kNvwHJXqCx&_nc_oc=AdpYDotOme7THN0L8sgquAss5NRTpqvtOeLdhp1ox28kk7Xne_ZeAjFA6td20cxxigU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEY2Da_pGWvQSteAptfyhOvi_XuD75YCGvZWVYj9tQ3Q&oe=6AE4B820"}, {"file_name": "AmericanMP.png", "id": "1893542834566587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_1893542841233253_1703008746654317532_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GcTwsT3c80Q7kNvwEy-4Vz&_nc_oc=AdoQrnIPlAzrHxpg7H6UEEj4q1fkKnWFZ3hTpD0r2M9_vjBKKO6GYxEjON7MxibmCpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEzrPXkGsf60gWnQRhr6_j5ZFreB_beIAbNGcQNf1GpQ&oe=6AE496AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0ff07622-58b0-477f-8274-588ca5313de9 (1) (1) (3).png", "id": "1570662874122857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824303_1570662877456190_3653996715888255952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-Zka9iOXS4Q7kNvwFlvV4u&_nc_oc=AdpitR-8xYjK2etVbCNdcZMisTaHJE57SZmSnrPccr9wA2zyMKCNdkg9IiQGFSClog8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRYRowQJTo3Heg7_kipITWt-La3ruDok9OBl2_JWeWLw&oe=6AE4A3D9"}, "display_name": "BackspinVR: Snooker & Pool", "keywords": ["snooker", "pool", "billiards", "multiplayer", "simulation"], "long_description": "# BackspinVR\n\nStep up to a dedicated VR cue-sports table built on **geometrically accurate layouts**, **spin-true cue ball physics**, realistic throw, and believable table roll. Every shot reacts the way it should.\n\n**Real cue-sports variants** \u2013 Play full-size snooker, American & English 8-ball, Chinese 8-ball, and American 9-ball, each on layouts tuned to real dimensions and pocket geometry.  \n{1841114623165523}\n\n**Natural cue handling** \u2013 Learn fast with an intuitive aim-lock-strike mechanic, accurate bridge-hand support, and a toggleable rest and spider for awkward reach shots. A short in-table tutorial gets you started, and the free-play sandbox lets you develop your stroke.  \n{922653590925418}\n\n**Choose how you play** \u2013 Practice alone in Sandbox, take on challenging AI opponents, or jump online with random matchmaking or private room codes. Meta Avatars, spatial audio, and smooth networking make every frame feel shared. Optional aim-guides help beginners build consistency without affecting the underlying physics.  \n{1566460714352221}\n\n### **FAQ**\n\n**Does it include full-size snooker?**  \nYes \u2014 you can play full-size snooker or 3/4 size, along with American & English 8-ball, Chinese 8-ball, and 9-ball.\n\n**Do I need a real table or cue?**  \nNo \u2014 everything is handled virtually. You aim with controllers or hands, lock your shot, and let the cue and rests track naturally on the virtual cloth.\n\n**Can I play solo and online?**  \nYes \u2014 practice in Sandbox, face AI, or compete online through random matchmaking or private room codes.\n", "short_description": "Master realistic cue sports in VR. Play snooker, American & English 8-ball, Chinese 8-ball, and 9-ball with spin-true physics and precise mechanics. Practice solo, challenge AI opponents, or compete online in matchmaking or private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portuslabs.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Portus Labs", "support_website_url": null, "website_url": "https://portuslabs.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24032826353043954"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "943040998158500"}, {"status": "PUBLISHED", "id": "1060181239828513"}, {"status": "PUBLISHED", "id": "1674234943801397"}, {"status": "PUBLISHED", "id": "1184794746996741"}, {"status": "PUBLISHED", "id": "1466611741715200"}, {"status": "PUBLISHED", "id": "685232404555690"}, {"status": "PUBLISHED", "id": "1285302443634158"}]}, "baseline_offer": {"id": "1285302443634158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "943040998158500"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28556483830678161", "version": "0.2.13"}, "id": "1284567633335251", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "An
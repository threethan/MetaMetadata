in2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e5yabU_RTZi0BTWW7PXXotlCoKT-XwNHj_QSjTZ1VAA&oe=6A11A6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "0ff07622-58b0-477f-8274-588ca5313de9 (1) (1) (3).png", "id": "1570662874122857", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824303_1570662877456190_3653996715888255952_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1cg9MAV7MQ7kNvwEerYji&_nc_oc=AdrLlTPWmfIZP5_0SVv_o-HY8VRivQ7Al4MApZpY6I_R2VtFki-9oMmaLGyAVSttxJ4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73imS47BEytcR13Z-i4ukvglTyuQTbwR_onQ7KNrpK8A&oe=6A11B3D9"}, "display_name": "BackspinVR: Snooker & Pool", "keywords": ["snooker", "pool", "billiards", "multiplayer", "simulation"], "long_description": "# BackspinVR\n\nStep up to a dedicated VR cue-sports table built on **geometrically accurate layouts**, **spin-true cue ball physics**, realistic throw, and believable table roll. Every shot reacts the way it should.\n\n**Real cue-sports variants** \u2013 Play full-size snooker, American & English 8-ball, Chinese 8-ball, and American 9-ball, each on layouts tuned to real dimensions and pocket geometry.  \n{1841114623165523}\n\n**Natural cue handling** \u2013 Learn fast with an intuitive aim-lock-strike mechanic, accurate bridge-hand support, and a toggleable rest and spider for awkward reach shots. A short in-table tutorial gets you started, and the free-play sandbox lets you develop your stroke.  \n{922653590925418}\n\n**Choose how you play** \u2013 Practice alone in Sandbox, take on challenging AI opponents, or jump online with random matchmaking or private room codes. Meta Avatars, spatial audio, and smooth networking make every frame feel shared. Optional aim-guides help beginners build consistency without affecting the underlying physics.  \n{1566460714352221}\n\n### **FAQ**\n\n**Does it include full-size snooker?**  \nYes \u2014 you can play full-size snooker or 3/4 size, along with American & English 8-ball, Chinese 8-ball, and 9-ball.\n\n**Do I need a real table or cue?**  \nNo \u2014 everything is handled virtually. You aim with controllers or hands, lock your shot, and let the cue and rests track naturally on the virtual cloth.\n\n**Can I play solo and online?**  \nYes \u2014 practice in Sandbox, face AI, or compete online through random matchmaking or private room codes.\n", "short_description": "Master realistic cue sports in VR. Play snooker, American & English 8-ball, Chinese 8-ball, and 9-ball with spin-true physics and precise mechanics. Practice solo, challenge AI opponents, or compete online in matchmaking or private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portuslabs.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Portus Labs", "support_website_url": null, "website_url": "https://portuslabs.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24032826353043954"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1184794746996741"}, {"status": "PUBLISHED", "id": "1466611741715200"}, {"status": "PUBLISHED", "id": "685232404555690"}, {"status": "PUBLISHED", "id": "1285302443634158"}]}, "baseline_offer": {"id": "1285302443634158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status":
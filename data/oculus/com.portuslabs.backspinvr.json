eenshots": [{"file_name": "5.png", "id": "947151344988393", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820141_947151351655059_4482162346435140835_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpMnujqovbsQ7kNvwH1BBzw&_nc_oc=AdpQQoObk4KnZALCr1pLnDRbREkX-YYynSMDR-SVRIpfPRQMQclozKY0Ogd4BdmG0kA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj_tXrvCgvhYXJWGpCcDsL7R1Pfwy9nIOXdSuvek5BGQ&oe=6AE498AF"}, {"file_name": "2.png", "id": "971556338595523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819845_971556341928856_4567615917748463326_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JLkVn5n3DsQ7kNvwEexwfW&_nc_oc=AdpnHokFnkxKGCqVpS0OXvbBHzFmfavfz8Q3TyINhPdHNVzN1Gv34M7tuqybo6FrSVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ0tvI0MuESH1Uevo43-3ocg85v6yxrF1SNfwhht6y1w&oe=6AE49F37"}, {"file_name": "3.png", "id": "2090515618347736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823270_2090515621681069_4286749925744030311_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRPod93WCVAQ7kNvwHnQzcJ&_nc_oc=AdrXVDfpAhZ7D90-vt0Hy8ZxutL9N3siLPuwiEUKUyeAlAufoUQoY8rZtMHdps8eqek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2gmNVvmFq0RXq_zAaQQ9Nhl9LDaLNRbyjRpWpwzm18g&oe=6AE4A030"}, {"file_name": "6.png", "id": "1489418282715496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828028_1489418289382162_8906198334898612569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktBaC1scZVQQ7kNvwHZ0mpR&_nc_oc=Adr-xZ8Mn3LqVHh33CjAavuVNg0vUcm4KsruJCmdmkVd5HNZgxaqw9j4j44zQI05T-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlRM4XD4Jg2XLxo97AFcsIFJcPsjmRNBGRYWzU98RyzQ&oe=6AE4ACA9"}, {"file_name": "4.png", "id": "4406084923043139", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593854747_4406084926376472_6517323821825973449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqK3nLlLiqYQ7kNvwGIU4EM&_nc_oc=AdoQpOXqhuUm1LpDTx0ql1ItyHHdnlGpCqxp477xwvyRoc7NobYe1Sb7PYa8LV8pYuQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc3MMVijnS1snwHdiCwsvK4Ob6gfwKsGI37ePc2q9UAg&oe=6AE4BFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "final_render_shadow (1).png", "id": "4434521320195990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596149727_4434521323529323_630524672989001333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIwOK1sszAgQ7kNvwGJ9aGP&_nc_oc=Adof5cNjQ0-PcMhSoaN4ZjyWnnF01Mc2004Bh7ah3j6fX2w5Eo0IufxEQ4oM8mIKcx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhf8q5YmeROEPpPuwy1tBJ7ziO_ZcFVmfkj1EfJZo5Rg&oe=6AE4AD1F"}, "display_name": "Backspin: Snooker & Pool", "keywords": ["snooker", "pool", "billiards", "multiplayer", "simulation"], "long_description": "# Backspin\n\nPlay cue sports your way in Mixed Reality or full VR. Backspin delivers accurate tables, spin-true cue ball physics, realistic throw, and natural table roll.\n\n**Real cue-sports variants**  \nPlay full-size snooker, American and English 8-ball, Chinese 8-ball, and American 9-ball. Each table is tuned to real dimensions and authentic pocket geometry.  \n{969944136006796}\n\n**Natural cue handling**  \nUse intuitive controller-based cueing or enable Real Cue Mode to play with your own physical cue, featuring one-handed table adjustment and optional mixed reality support. Choose between simulation and arcade cueing styles.\n{1658616635270566}\n\n**Choose how you play**  \nPractice in Sandbox, challenge AI opponents, or play online through random matchmaking and private rooms. Mixed reality and full VR support, spatial audio, and optional aim guides make every frame feel shared.  \n{982461204440218}\n\n### **FAQ**\n\n**Does it include full-size snooker?**  \nYes. You can play full-size or 3/4 snooker, along with American and English 8-ball, Chinese 8-ball, and 9-ball.\n\n**Can I use my own cue?**  \nYes. Real Cue Mode lets you play using your own physical cue, with one-handed table adjustment and optional mixed reality support.\n\n**Do I need a real table or cue?**  \nNo. Everything can be played entirely virtually using the controllers.\n\n**Can I play solo and online?**  \nYes. Practice in Sandbox, face AI, or compete online through random matchmaking or private room codes.", "short_description": "Master realistic cue sports in VR & MR. Play snooker, American & English 8-ball, Chinese 8-ball, and 9-ball with spin-true physics and precise mechanics. Practice solo, challenge AI opponents, or compete online in matchmaking or private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portuslabs.dev/backspin-privacy", "developer_terms_of_service_url": null, "publisher_name": "Portus Labs", "support_website_url": null, "website_url": "https://portuslabs.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28571172785875932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_845757804820490_2584379182059735379_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDhCPrvpI-IQ7kNvwH1I4Xb&_nc_oc=AdokAZIvIZ20V8LhtyTKnjWobFxdZuDNvlueZitVoAoSeBgbJUK7mbGmVN0YywJrFC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkUXruk0ZYFLejA19HkBcqF9mkVutPtgWHAJslu
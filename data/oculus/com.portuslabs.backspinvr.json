QwyAizfCc79F8j2hSAIVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVmsw1fSgjkbpCkOY_orR3Y3VWAuR50E1mgZ2TQlcBCw&oe=6A5117CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bs_hero_new.png", "id": "1258697243053945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1258697246387278_5575945946411648104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA6OS7KURVcQ7kNvwHdlf0w&_nc_oc=Adqd_oy5iNuwznRJNPpAlzLSVY96ju0vjnOF4goW1Xz1QPkmkM2UjPb3vPVTSPtt3c4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW2m7GmY_V0h9mVw5oNg8mY5umBleRigky0zl8WvJ2vA&oe=6A51077D"}, "display_name": "Backspin: Snooker & Pool", "keywords": ["snooker", "pool", "billiards", "multiplayer", "simulation"], "long_description": "# Backspin\n\nPlay cue sports your way in Mixed Reality or full VR. Backspin delivers accurate tables, spin-true cue ball physics, realistic throw, and natural table roll.\n\n**Real cue-sports variants**  \nPlay full-size snooker, American and English 8-ball, Chinese 8-ball, and American 9-ball. Each table is tuned to real dimensions and authentic pocket geometry.  \n{969944136006796}\n\n**Natural cue handling**  \nUse intuitive controller-based cueing or enable Real Cue Mode to play with your own physical cue, featuring one-handed table adjustment and optional mixed reality support. Choose between simulation and arcade cueing styles.\n{1658616635270566}\n\n**Choose how you play**  \nPractice in Sandbox, challenge AI opponents, or play online through random matchmaking and private rooms. Mixed reality and full VR support, spatial audio, and optional aim guides make every frame feel shared.  \n{982461204440218}\n\n### **FAQ**\n\n**Does it include full-size snooker?**  \nYes. You can play full-size or 3/4 snooker, along with American and English 8-ball, Chinese 8-ball, and 9-ball.\n\n**Can I use my own cue?**  \nYes. Real Cue Mode lets you play using your own physical cue, with one-handed table adjustment and optional mixed reality support.\n\n**Do I need a real table or cue?**  \nNo. Everything can be played entirely virtually using the controllers.\n\n**Can I play solo and online?**  \nYes. Practice in Sandbox, face AI, or compete online through random matchmaking or private room codes.", "short_description": "Master realistic cue sports in VR & MR. Play snooker, American & English 8-ball, Chinese 8-ball, and 9-ball with spin-true physics and precise mechanics. Practice solo, challenge AI opponents, or compete online in matchmaking or private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portuslabs.dev/backspin-privacy", "developer_terms_of_service_url": null, "publisher_name": "Portus Labs", "support_website_url": null, "website_url": "https://portuslabs.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27537467059246515"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818885_845757804820490_2584379182059735379_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zFAhG-V3QcQ7kNvwGzADv9&_nc_oc=Adp_UUmQUNs74F7wi__1CO7Go-wwi0VEArP_GoGp4PPN6g0ykUIU4jlPKkr6PLkEQvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcivsIUReBow-MemBPhl-QCC2e_CkujKT6-4My4itj8g&oe=6A510DA4"}, "is_
_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eOL8E0u2Vc7RDfJtKsvdQSoZnCvziYEyimdCid1UgDw&oe=6A26D4A9"}, {"file_name": "4.png", "id": "4406084923043139", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593854747_4406084926376472_6517323821825973449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiH2fSHLfpcQ7kNvwEYm4os&_nc_oc=AdrXAyvnTUbSfKJdvruyjIQSFYsF-P6f5NupWnHz8BUrPQk8W_-ujfAmudEiWZnuvL8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r7L_T60agjDlA1K1IMU23m5hxkum3_3c_ccOcHK9CMw&oe=6A26E7CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bs_hero_new.png", "id": "1258697243053945", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823271_1258697246387278_5575945946411648104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_39CFgo3OZYQ7kNvwG8m6Vs&_nc_oc=AdrzxN2U34hYjytCUYURC-CFGp4C9nSrpeaN4PCVSqc69g1yqt8yR6EBbfql4Dk-h9A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UCA3Gmn0Qdu4l0oyiTp7GB_D-XxX2FV0RxATAt4PZxA&oe=6A26D77D"}, "display_name": "Backspin: Snooker & Pool", "keywords": ["snooker", "pool", "billiards", "multiplayer", "simulation"], "long_description": "# Backspin\n\nPlay cue sports your way, in Mixed Reality or full VR. Backspin delivers accurate tables, spin-true cue ball physics, realistic throw, and natural table roll so every shot behaves as expected.\n\n**Real cue-sports variants**  \nPlay full-size snooker, American and English 8-ball, Chinese 8-ball, and American 9-ball. Each table is tuned to real dimensions and authentic pocket geometry.  \n{969944136006796}\n\n**Natural cue handling**  \nLearn quickly with an intuitive aim-lock-strike mechanic, accurate bridge-hand support, and a toggleable rest and spider for difficult reach shots. Choose between simulation and arcade cueing modes, use the short in-table tutorial to get started, and refine your stroke in the free-play sandbox.  \n{1658616635270566}\n\n**Choose how you play**  \nPractice solo in Sandbox, take on challenging AI opponents, or play online using random matchmaking or private room codes. Mixed reality and full VR support, spatial audio, and smooth networking help every frame feel shared. Optional aim guides support beginners without changing the physics.  \n{982461204440218}\n\n### **FAQ**\n\n**Does it include full-size snooker?**  \nYes. You can play full-size snooker or 3/4 size, along with American and English 8-ball, Chinese 8-ball, and 9-ball.\n\n**Do I need a real table or cue?**  \nNo. Everything is handled virtually. You aim with controllers or hands, lock your shot, and let the cue and rests track naturally on the virtual cloth.\n\n**Can I play solo and online?**  \nYes. Practice in Sandbox, face AI, or compete online through random matchmaking or private room codes.", "short_description": "Master realistic cue sports in VR & MR. Play snooker, American & English 8-ball, Chinese 8-ball, and 9-ball with spin-true physics and precise mechanics. Practice solo, challenge AI opponents, or compete online in matchmaking or private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://portuslabs.dev/backspin-privacy", "developer_terms_of_service_url": null, "publisher_name": "Portus Labs", "support_website_url": null, "website_url": "https://portuslabs.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
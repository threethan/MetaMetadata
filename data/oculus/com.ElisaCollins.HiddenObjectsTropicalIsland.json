25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc3YK-sT3bkQ7kNvwGO1zfu&_nc_oc=AdqUKH2LVmp4JxA6sztoNDSZ1CrRRPZD8mSP08Yxx3jFHA4Vu2IiAE7d5JiA8iAR14A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdVPUe78xPiGH6yYHkGevPN1pb6HY_2wYOJPDpCHHDqA&oe=6A9EB882"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRHGooogj5QQ7kNvwGI-Age&_nc_oc=AdqTbAS1eroQm5GcN4UnNeNWXXTEyfTZwMhPBo5p-X9hp5yIfM5aOyjlnik3NlA6Z6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoNGWqosQTYgnaas8peWGQyMhTOXkIsMLkUpZm1a7CMw&oe=6A9EDBD0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ru7zIvKmHsQ7kNvwHya2Ag&_nc_oc=AdqAsqj4tHRZZpuv8o49-hWrA2duO6-MZ-KiIeazwLG_Dvh50DWMXsh3xc6jipk71L8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy3FLzlD2lgULtuLYRYdC7SOTGduP30XgwoHrGVjPN6A&oe=6A9EC391"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yB00Z6wump4Q7kNvwE_eEqc&_nc_oc=Adodsz5Y5JVeqCCVclC5c8aqeO--kPqRYGbrhJlUyVSRPmxw4Qij_UF9sq46_CblyG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2MvtZF3RJKKPwqskx0yz266HqjPdeMxXdhxhrcJGkig&oe=6A9EB746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8045Mxp0OQQ7kNvwGzeFvl&_nc_oc=Adodmai6M61h3H5Nq0xDSaLnjDM2j9rHjd1VDx1tM6cqvBUlzOACyMXBDN0kdlh1FIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEQcfSZlbBQH3_bz28Z2AGZXxNOmS2U3BMnslr0wY9Pw&oe=6A9EBF6E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp8k2EuA014Q7kNvwH2KMeC&_nc_oc=AdpjA3CU1DXTZ_WNvEFl8DWpyJlW5L6UqhKxLsUwDdVEVS7JK4cf4KYRuLjHGfRo4pw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Ksj2N8Ieeem9x7si9jpJx4T2qynSsxEbMyKiaj5IAg&oe=69D26002"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-v2QRT4rCsQ7kNvwGWnSS0&_nc_oc=AdreN3z57QUwhZ8kf28zEhJJx9Ou6DI6Kn3pmVmZR0zbNalNi_8r1zB0RhkNZPr-dT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gy3QjVxIfAAT7On_FvBaNQ2QctPsdaaySQTJaMWywkg&oe=69D24B10"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrOMYsQvhDYQ7kNvwESZFQf&_nc_oc=Adr5Vk4Hrj1qk0pU4nDEveV8v7i9mWtNGe2INZP_iqQXFLawjqSHy62Bpa8v4urvnB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UVFcoIw_0JZmVQLeRn0bxWvfVscEXMWVBz6qar1wPgg&oe=69D26B11"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brQC9iO361kQ7kNvwFc8c9t&_nc_oc=AdrDQXN9mrwd2H9Q-XShEsNoZ02sE-Kf3ZVYLhvwhaDPixBu32j1bB2VK0YGjAf5wfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qUdroAF6mV-sIgDq-RHjaUVC9X2B8ShMqJ1fg0q-lNQ&oe=69D25EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ueji_XlTsEQ7kNvwF_YhEP&_nc_oc=AdrkugyLKmLOfP484_T4vskYSSBKPCBK5Vex1FnDqWO9PYa-9tR5DFmDC9d2FHuETd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZpstR8HOBSbEWIqfdk3u8xV6lsPSVbB7XY1Z9j9r_eA&oe=69D266EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
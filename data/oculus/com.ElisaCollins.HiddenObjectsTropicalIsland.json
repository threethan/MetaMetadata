25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFphrXz83pUQ7kNvwGeBLxT&_nc_oc=AdrBny5J1KytUFKDNOqne7meDzd3k72srN1yFUMYD5B96ND-1bxoBuvD7BhuXb0rq7Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3MLjYA-sm4_H0LJpKBoBoG11PZs9Ws4MXt936YVhr0Xw&oe=69F5F882"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQPIBBr-v-kQ7kNvwHbqXfZ&_nc_oc=AdpOG8xnwiGLOc_gYCFmCS50FV-taEH8Zp_UMJ0Uevaf4QOvOdhhVY80GunPjNKD9wI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36Q8P5KbkIvczeY9Q7qGQyRtoS6BKpdQQ4uynmLwwUXw&oe=69F61BD0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Iul-r_hu2sQ7kNvwExNuSb&_nc_oc=AdrCkNNlYSK5unaH4GtLOgGiaaGu4jsiBqdAKdTrtv0j7t6k-zBGD5rs8YZM2MKhltI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iuB6T-w8nkNHcMQZguCEZ415eHlC_VtakPGyM9TYd7w&oe=69F60391"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTrIPfStFT8Q7kNvwGnGwL5&_nc_oc=AdrSHWk6TEtHS4b7RaPJZNuNAMTdxjMIiyBUyoyeHIrjVoxgiyPlCIlXuQOjNYuh0hY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1B_cDoSNAiFkTjQZEybH3h7RPvcHkJLII5htYd0Ya95w&oe=69F5F746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hf7Z9bqmy50Q7kNvwH78IRA&_nc_oc=AdqjCbL9nAVCpe7M6GGkYF_gitG4SkAlnaw0yyjcaPq1I5mwu6knshpLkLe6TYUMFNE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1b7DSXVH-2T6Ny_eAaOn2it0MKireyrzYVVGFx_KrytA&oe=69F5FF6E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
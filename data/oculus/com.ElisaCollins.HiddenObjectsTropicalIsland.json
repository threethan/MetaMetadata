25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZJKHo10PFQQ7kNvwH46Gr6&_nc_oc=AdoWR5ocziqE4ZYWPMx2wF9ebs4wi7f36qbvNnMxbMqreOniHKJ9V3WcWtiAe2BL3f8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLootqoXdc3BcJEBcuE3hQyy4ioQyt0SWyNp9PzCfhOTg&oe=6AB27F02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTCKcsx2zWwQ7kNvwEnvH7z&_nc_oc=Adpv25sgiFm2s6rMyFXm0NGKIJcdHA6bPPpv8Hs5sBKphsDLRCxPvMQc07wfN1TDw5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIInU7hxCZXpEgyZBaMoQTv3iDPO-plpK4HNJioaKEANw&oe=6AB2A250"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYVYNWcqrTwQ7kNvwG7PgoA&_nc_oc=AdokGIkSQoSik5-MlZq_UCmfbNwq8-DgBtAeHZcp5GpN2qmpkCj9oBaiXOYvRmN_7js&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID2vKmLAT4uA2CfBF5ufged0TK0WFeROQ9xesTCcAF_Q&oe=6AB28A11"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tz9jUWYAl0Q7kNvwHUAqtd&_nc_oc=Adpi6VSrtjP6rynXXNof-p3EW1OHssxNGO5SXJxubzhTAHCebW10d4xO0FoFBlKe81w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlQNaGEvWCSkcrfMZdRN5JBL6AZiGRXQxW36F4ujPdaw&oe=6AB27DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDys7WpWdtkQ7kNvwEv7P0B&_nc_oc=Adp53Kc6mnx-aKU8KnpFbuw2j8FHoYeSX2IB9bQX96LubeWhkGWaJdossyhehwU1hvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCbbpj53hb3bdizEAYQBeaEq0KeOYzS5jfF9vAS46qyw&oe=6AB285EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
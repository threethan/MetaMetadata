25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxNMwqzPA58Q7kNvwH18z4s&_nc_oc=Adp06u6npA1MZDIdJ0-o13_9gHJq4-tFRitsQHyUpcD-S1SmufBtxt6JjcwN5ABu0qQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxhGLpZfo3vACMr6qQ0DKlYEhsYJ2Fxr5gbabAwfcN3Q&oe=6A58D902"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBVCSGSuaW0Q7kNvwEVvt3l&_nc_oc=Adrm1AWIrQ8LQIgQ0NOyIab3bG0dOxx0ogGm1ucEdCN0e6vu4zIIsERgQzg1HgIQ_JQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4gvDF4ZvALxzQZoYAkb7nTMX8YyFSvCOz-lZpOgpwsA&oe=6A58C410"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9E_89YnPxwQ7kNvwGnbYKK&_nc_oc=AdqXyMPPK4bP_c2wUMUz4H5EF7_UHuot7HugCcmrPcgSkZJuDet2mT6JsFnNpXcQBCI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVKW9X--Xt9rRAKCJQU0DberZ8NUHLM89fpFptiiZJig&oe=6A58E411"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t12WlGl4SSMQ7kNvwHm0OKD&_nc_oc=AdoLopW2tTW8YWNsoOiLgBOvnDYyFJ5oWgGkLak9f3z35QtfopTI4UfPGGqKso_sxJY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAp_-mkYCs_qBCE043OTd40whkqOxtviDl34VHFbZwgQ&oe=6A58D7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jurKwpNTZDAQ7kNvwETR2dT&_nc_oc=AdrtXKxuTGHIuPcczOuLQ-9wg81jRb3eimCUdj3XsudRX7F68BB7L8Us2An6tpIsJDE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf8_cYEUnI-e-FSg2teKAufcWW74eT3I3VpPdeKkgysg&oe=6A58DFEE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
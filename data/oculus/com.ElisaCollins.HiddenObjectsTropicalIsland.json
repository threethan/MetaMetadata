=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4p3xBA0uzU-4gMUhn_9N9WJXfTXtK-hkK43H18LOhRA&oe=6AFB3886"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po3fd8IEEwUQ7kNvwGOaFWh&_nc_oc=AdpQdVBxVmKYjv365ExPAb87x8bkRz5dRa9EN41omuVM3Q5idHw5XaUgXaK--FvTNug&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWHgQZ9fh7od7SjENFlajR2----G_j19cP_ozoOrxrKg&oe=6AFB40AE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.co
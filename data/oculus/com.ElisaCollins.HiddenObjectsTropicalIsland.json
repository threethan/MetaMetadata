25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7xNJJBn46MQ7kNvwGzudUQ&_nc_oc=Adp26fL-IzIqz2tJcPC9vPYKjL8GGwo2YxScf0YYzWfEVgEQPEW7d6GbG9TlHpKgoSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRuEjmeTU8FxRsaUc2zwQ4WTdNGJRBcK6id54n4aRyag&oe=69CD1A02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_vO_MccGxkQ7kNvwHvbLE7&_nc_oc=AdqjyDmCFnNt5V_0yYmiJzDLq86fmRxVzW9vdz6TYe9ejMc8zneXgL_1tBdNZNQ7Fnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHY8dsZevaD_ynHt2Mcnp2Zvoo1xzneQzBgjo-ps70_w&oe=69CD0510"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mj9rQiyDqm4Q7kNvwGhbiFg&_nc_oc=AdooRERMHBy8sEx1CNN1pbgAWzqLdq2NaM5iVS420vHl6Ntti6ZUl5n9KOEoCRzjqMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOWsGb9xWiDMncligRWDh5QKWx4NfwNPhztKCn7WyRlQ&oe=69CD2511"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGz4klU_OjoQ7kNvwFAujqg&_nc_oc=AdrNSXPU96l0dKoYTVYOBNsr67YQAuxFEWbwGtBfphjYwOESbOIRAw5zqUCgvIkdr1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGY5SV6P0-PKqEqC9CTtA6tAAw1u4TuqmDP2_q9wgynQ&oe=69CD18C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfFAglKqn-QQ7kNvwF9Bwrk&_nc_oc=AdrFnp0-PQcCIl8yJIExQaMpdT1qTCzv2YBgz15g2MgmcyvT0PqO4TTvrwaU0dxuvKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOj2Fzy474iNrWcmszhIIdrlFR138T2OgJ5v7Sgs1NdQ&oe=69CD20EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
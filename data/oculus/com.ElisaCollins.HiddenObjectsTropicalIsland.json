25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnyhxOK0slkQ7kNvwEoQbLg&_nc_oc=AdqiGBddIbTaL0R6OUDeTJuMzTMuSNHghNzEVebBK463mR9S0qcfFg9-GW_dQtKhCDg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_DLH025B-YCINHzMafVLrQ_V9vvazh9kAwedXK2rxaQ&oe=6A8AF202"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jz-huzEQea4Q7kNvwFNkgYA&_nc_oc=AdrYKv4vnGx6jrRryxTXS6pkQBhGyHw36cc8jrRrcjYCXFpqfrJxdZ_DPQoOTAhPupE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9nHU7fFUyvNnU-fcTHdzzM25J0zeOk9R_SZuzriFfzw&oe=6A8ADD10"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYUYFoOmzQMQ7kNvwHp0awj&_nc_oc=AdozbYXQvlzr75DOv4SJdzehBW5LoERly-Bu1J-iYO9Pzh0rCjzqrd1O9SVVDYBGmNM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFzjBu01lE3RQrwzd55PgkfAZ3zVB4WKxPHaD3wBXO3w&oe=6A8AC4D1"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdt9CHbPKNwQ7kNvwE2o4mr&_nc_oc=Adr-ELlxu54eZ5I5bHbRbFxzziyIaiqOz-R68Nsqs_3iUCQH1ftBevphZY2GG-H3RSc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbr26yabUb8zH3PZsk4YF5Ls9IdfzvGy42nYqTJaffWA&oe=6A8AF0C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAy2KDvFQooQ7kNvwGc3Amv&_nc_oc=Adpuk7ffoZ6SCnGk55s1-eSR-guovdSARwDMtqLyIq9k_zC3XWxIUOWrWUDd8iunxIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETgK9YefugRbLuuOg_m4swbfE1zk-xkyy5K7cWzDNxjw&oe=6A8AC0AE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
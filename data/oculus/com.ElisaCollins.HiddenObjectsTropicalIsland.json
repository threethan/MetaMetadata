25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoC2OIygXBYQ7kNvwF3T7-C&_nc_oc=Adq6toS-gcTcOTe5mOzulR4YmLAoxHvWiH0SZTXMejPY-3JFCxtN1Imq-t0MTj4ngwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-59fAl6-lwtzOtTLojfA_8K5d5fXVLYY-yyNVkNC4EkA&oe=6A256E82"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2aKxeUcZPXYQ7kNvwFuHQvx&_nc_oc=Adob5hnYw-O_GbPypPLeqhl87-GvNBBr0YE9HOLY1eGQV1jeNZJsXKE9PS38Kvi1gSs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ncD-LV-8EGNwJwufL5vGAHTmEHHEAF4tEfrdMY8Dz6g&oe=6A2591D0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgD4swBesNAQ7kNvwG8zPxd&_nc_oc=Adrntyu-9xhmHpIubT71_XspRGCYf49UNfgwzkOUedWWNuDXL81W1TPG9ePOlq8iQAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UYTbrXRG3cNQikQA9HwXo7IJ_HuarMD0D7qm0p8zwAw&oe=6A257991"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1W1AeqBZasQ7kNvwEhhvY5&_nc_oc=AdqCaOUtf0GMkOxFLAt-lf1BzFfnGX9dAVQh8wyFhj1poT_OiZHTSbFiSeAiGQ7KkM4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gKWRgbn27xFmehxUCM4NCA32O-d1Th3p3sB6xsGz8pQ&oe=6A256D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFu0YjjGRmkQ7kNvwHmCTI_&_nc_oc=AdqwM7Ovu_1moa8p6TwpN7Q3XnFMA3b6HjXEE3WIfLcxcwxZ3GiJCF6X4JPru7QZIs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vM7OcFBMe9iymw52GO-PfxhGIqotEQgM-dXyS8Me_Qg&oe=6A25756E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
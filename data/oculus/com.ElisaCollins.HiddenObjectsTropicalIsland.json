25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCXzImuQxgMQ7kNvwGJ_3wr&_nc_oc=AdoLqdyzvM2r39HCLUrB8zGfyJZ36tqV2EqYCTTlix9jaNGOzM35tj4yghE2p3YCm2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw1VovzB_uO1i7ggemt1tGSz2xRriEFLVYu4Bw1KCe1Q&oe=6ABBB982"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpFpy8GjvjkQ7kNvwFxuMwu&_nc_oc=AdrR56uspviiJdJLQ5Zy4FdqqG3XYGoZugDgycg3n_EbP18TQRYdtAsAvejODhM7NRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJUVFRopEE3L0wj3_uRu_bPC1gjE90iEut2RUmK21Zsg&oe=6ABBDCD0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBDSj_4vsSEQ7kNvwHLMyzE&_nc_oc=AdpE6cpM946jlBoikAj3lFFwRmURQTH9Y84umapHsvj5YkaPYbxhfbB9yFhqsFtMpPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3s_yS5Xk0VslMTy5uobBp5NfxEzuretDl6fUYIx416g&oe=6ABBC491"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m51XsKUrPVgQ7kNvwFkDPb9&_nc_oc=Adq8AUpfnK12N-4kI7dBZEGr-ab3BhFsDFjqHtqUvdizj_zEE7qatbmoe3PA1YDwpTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLquMMX1QsSLf6sED751vnKABvIchPWv08lo-rabfTL8A&oe=6ABBB846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb2LEVqs7G0Q7kNvwHa_c4v&_nc_oc=AdrMJ1-QY5u8MsD-E1U8BoCthLhsYEM9pj-PUvfjUEAmnHOzUz8Mtwv32Z-BGD1Cku8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKIM5qrQWD6cqEj2J_x_UjgeRiNpx7DCbx7Bnp0rP-7w&oe=6ABBC06E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
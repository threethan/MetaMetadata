25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZSDHwyCDIYQ7kNvwEj0goM&_nc_oc=Adqqamsyj0iLklTSatOghZewMD52AfeRhqHFpEXIcIzN7RtmkagWHvT0x64FnkR40pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WiCG5Nf2vYl5kyYZekFz_a3NUF0tKt23E7tyK7_aY4g&oe=6A2EA902"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PU_FHnYRWYQ7kNvwE9hkgl&_nc_oc=AdpaB2jWrh6B-RLTeHDSvTgsf3nIYEsZRzAhfrFIb37POClXnF__ewdHBoUD0RR0HM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ya7ZceENy0IYpcW28B7w85gQAtj9Puaz8W2RtWgB76Q&oe=6A2ECC50"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvPgwPCCJwUQ7kNvwGlLTP8&_nc_oc=AdqVcQjKrhZWCQmNZVIIrwYmvD8waZ5vPfE0PXDaqKqiMeIip1kk1JIyCdyKGHcXh9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bXjv6VmWoDBJhEylat-PHh4yRhg7j2cfGCY0O8lilmQ&oe=6A2EB411"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omrvh1swLEIQ7kNvwGNtSt5&_nc_oc=AdoDSU_hZBpeK4gtlnn9X-YS5yr9-QbMRYXG13PTnjlvR1uP-U5Wrah1QKiyLPORcwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yVtvE_c5VSepaYTVIGROTpRwl9BmRK4tLzJ0jxUM9GQ&oe=6A2EA7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt5V967sB_kQ7kNvwH95AEZ&_nc_oc=AdoWOQ9O05CBg2cRXc2kjFAeGBNXtiBdsImP0Fp5APDOn98IXV4zAETzVu1pwCTznc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vM6N8C2ieSMBcP4a-nK8qSmHItaWfQ2sezUoRn007hA&oe=6A2EAFEE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
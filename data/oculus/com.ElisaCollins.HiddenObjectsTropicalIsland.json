25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIHlTYV31b4Q7kNvwE3bEHk&_nc_oc=AdpfvBTZnD_ncj7Gvh5IzwV9hlLvDky9uJrL9WOX1gLdtKyM1He83CgUOaN7FoIcyN8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G5b3GGH-ECr42e6SfiS-XPtk0HG_OChAoJ7U1qOq_og&oe=6A09BF02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxF0Un56lKcQ7kNvwFBgTvA&_nc_oc=AdqKt4Qm5-7xFTrczUhvEuWpf-yx4yssdQF3-gjxPp1JI-cg98eOqEVvCvp5yjiiTEk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68Dhp1IXo7UAolfwl71bWoESXliNq_f-LRClOwEA3LxA&oe=6A09E250"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lan3huf2vacQ7kNvwGjUgTd&_nc_oc=AdoP8vGOw6ZsEph6738P9YepesJI4YBtZ_F5BUysByo0b-syRaWVVPFezlFcgT43ubs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ejJaBkYjS1uFtqu7xG8QwgFkI99-W5IxIm741Kn5hxg&oe=6A09CA11"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMokKTpswjEQ7kNvwGAksCG&_nc_oc=Adrm16UV2uUtuNSh1eouxXZ0BgVmTSBTmxMPGjPiF_sD4XvpeT0kn6AYahOQE3DGs5k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pKxGHrhqjzkucv6GLLPGKEZBYhPYbCWeH15i0agg2Lw&oe=6A09BDC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e7N3TxGMhgQ7kNvwHeq7CJ&_nc_oc=Adpbl0_e5XjQNOrl6cw4E1efsFYSWxNiR7QmtVQUoLe5NugDmLWI8SjsDJDt3p8druM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lj5PfveM2z5KzcEKl3DV2Z08QgWDTbky1U0sDBVtMwQ&oe=6A09C5EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
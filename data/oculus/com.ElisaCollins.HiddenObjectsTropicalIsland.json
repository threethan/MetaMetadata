25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waJxx1k4MFQQ7kNvwHWYpRn&_nc_oc=AdrRbxg-TpldhdqIlV5euP1dpO-R5TZDaQHgxfy0pcHUfLqbdqpRaXD46X171L7_e4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U15F0P-m74s7h3NTMMBBJOk1np7lC7gHwgwaW11RBfA&oe=6A47B582"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfNBDN20u7gQ7kNvwF4AU_F&_nc_oc=AdprNvqCrfBbOmzpcABTU23dneKclF0zwXdzdfIlPBIfw1lQ17CUK_V5u3s4UpN7BDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ILuhakCE6bC7XNVd7vnFN-JothvfHNnmpfaRf7KEOQA&oe=6A47D8D0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY-0h6p0aRUQ7kNvwHyGWhm&_nc_oc=AdqRnun_1x0BQd--snakagVL4LL2cyIwn925ej7h2ChugLhZujsaOi9RGAimdlZ5gUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90UH07qgnxuu8_YI6xqlvPHXDJ0sR42SURSzhpIxP7uQ&oe=6A47C091"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-a-RwqhvHAQ7kNvwFs_CAq&_nc_oc=Adpj0nC8JwiQD8NhtlEVE4teU-M5qq7dSSigzNZnK7GMcDB2Nmty8-gEhm-IUe0-yns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUVoYXh4Jf-m8KkZJvO1FmD7OOo_ceWtRCt8sfzorZQ&oe=6A47B446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd9yldOK_zAQ7kNvwF0cfrp&_nc_oc=Ado3mb0CHToOhoiV2Of3md-a8meK_CY-1ZFVT6NXZjDhU1XLb9Mxz00-JwTFhpLSdj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xCA0iYYQM0vNwBC6KepGTfZNfnmLoARvDSkmcBKYpJg&oe=6A47BC6E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
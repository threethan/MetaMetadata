25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErtyoX15TKAQ7kNvwHfsngq&_nc_oc=AdoaKBWrV9proM9n3pSADicbUwsIR8HjkDFopUYHMiBVSKZcXWt0jgfoCvi_ZXz-RT4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSd65dPzNpsOMToQ3svb2g_fsxVsrSHkiSQxKjWyseZQ&oe=6A4A5882"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ-zYfGjU70Q7kNvwFBYOi-&_nc_oc=AdqAgMQCWtW8sQaZmkxL3FjqFPVvzDYRh9FMSKSTBW_-qKjpQ6qg2HU5g0dxbD3Q3Xw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfwR9tgF0egRJXBlzH7iyHkwDC4E6Tx0KP-Y486AFQhA&oe=6A4A7BD0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yyfa3rKYHDcQ7kNvwGIPlJ3&_nc_oc=Adomwikd_e2lFYHrIcWfnLP7jWI4DzgyP3C92bFXGQ_jzWxa2KCYpUev25rekFU-EN0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrB5zqyN_RnqzGAN7f-i0FJrENNxXode4YCnI2sbfDDg&oe=6A4A6391"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFbCUk07tUoQ7kNvwG0vQzR&_nc_oc=AdorTwqx-Dh8_k2BInKyDz36xlwYR53Jh1FekFBZEQ4ZOyl97MikaUxcrQZE_zQlOmk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuLh6CmTF7oLAcWvGx6TQFEbwSy1Ckqad6xtzzKXvBUA&oe=6A4A5746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi38F3je9kUQ7kNvwFwgYWV&_nc_oc=AdqVzh3Z52lH-3xmHs35lyE8TepGYy5rjFiym9L5bhRB_5BMU1xhuiPILe9jPfNijIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1jqjVmYzPFvMW4iq1zZg2Jj0ALrsxDLUExKpW3T3Qrg&oe=6A4A5F6E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk-dSwaWK90Q7kNvwHHmVvK&_nc_oc=AdpW8NCGBDKT0shICnxgtimT0lXHK-srpCfQcMXd4q1Y9nuryOTtTwIb78pzx_5j00I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9YNADXdl74pq61bWoiE2fWy-T10U2MBly0fmOm72Ryw&oe=6AC137C2"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tcFvQsoz_QQ7kNvwHGK37J&_nc_oc=AdqkDOch9ZWBJe7Vbx-ToM-8VjRIYiug6vIiBnFReZfiIZDgJEUGeZLfGkpV2Bip3lI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMluqpWOklZ1-GiHtrFL36E5rljKXBpFYJONd4wjAxZMQ&oe=6AC122D0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nlzdn242ZasQ7kNvwGNm8gN&_nc_oc=AdoE4CmqHRwRhzN-AB8gxPV7UgZarQTZ_Y6cstzSQpqEZGzWbk8wgokCl8wZ7aQjeDA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd3_EYiGSzV32DdkkzgOPWpPe4gsAafVawWpwgJ2cOVQ&oe=6AC10A91"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbIfEDJMarwQ7kNvwGjQkwF&_nc_oc=AdprsdUuc6nDWlCwqvCgAyLxcTLWjE-xfVNcvdsl2ma3x31NTeDrxIg2MHREZUuxvW0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnzubXB9CyfC8PMBNZuVqqHXAwquIFIvUIqSLaSlcHyA&oe=6AC13686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qcMsW3G_KUQ7kNvwFYCBg0&_nc_oc=AdomSXchGGLl9pQp_EcZe0n2V4lkVg7qRwIWAHDKn-NTJGoW8Kj2EOKxbw9Z3UqW7so&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGs4tqCHRIvDbiAbdHuEszvKm_j75MjehSRmlOKKGdiw&oe=6AC1066E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
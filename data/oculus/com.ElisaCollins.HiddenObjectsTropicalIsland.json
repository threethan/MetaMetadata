25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFphrXz83pUQ7kNvwEZAiTv&_nc_oc=Adrmv3Neo-eh6CjoZaxWahWLNTLWuAQ_gQypZfUslc5cUBGP1r9_N74tvGEG18Ngw5w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oYjGbGI0DVkFgo_cZjABwIfBV0Ti4BqUVIFswv2oUkQ&oe=69F4A702"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cf9OdEOUogQ7kNvwFwlJkV&_nc_oc=AdojCS-4h77zxr9St41Q-2j3JzheI-4dHwJ9Afv2bwnI7SaMEJIKtFjS3jUfMj3im4w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SofWmIO-ExSqVeRRZpCcsNy8e30e72M6EVsNl9G_afQ&oe=69F49210"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXXMX-xTF3gQ7kNvwFGx-FP&_nc_oc=Adowy8Z0wspgxf0hEemVQ4FI-kazNZndvnj5RzOWikLiz-F3RwnDZ9Vm-rhaN5TNUws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39MkLeDgBtSxrFmbxVQ4L4OBA_TRxx_SRPaYRvvEYUJg&oe=69F4B211"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTrIPfStFT8Q7kNvwHXoBn5&_nc_oc=AdpJyQuh6Q4SBEiPMRArNLQrQKzh9VyxIvluQBzwtu3LkwnOpVH56Yn1WsD1-Hr3hs8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2CzE7LiLFpWhyYo7SBLzr6Ocg0NkJZV6jJ2NS0LIwcqg&oe=69F4A5C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9fV5Nm9q0oQ7kNvwEMsM_w&_nc_oc=AdohJl6YAxGifFBqTrBZke8cCi7cXByZE9lndiYstcMWbGlmSdkaLEdKgv7nX2SksKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ktx0-8b-ufda0gQ0Q9BMqi9Dnpo_Iq030gzEjdq8zRw&oe=69F4ADEE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
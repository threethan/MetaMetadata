25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcHVWBzyMHwQ7kNvwEFl35Y&_nc_oc=Ado5h2X4_nqPa9V4pyXjuzuZuAOVLumM8auBj4TyY15L4oh1uH167EjxwIFFSkQKlEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z9tnemsYXXyqVj_PR8wR_Dm--0pfHpwb0rZfCo7m7AQ&oe=6A12F982"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWNKsxQZM1YQ7kNvwEEfSIE&_nc_oc=AdqZaHzLZnzuZyEkrUBB7zyiGPWXwhrUAvxActtnRtlJPzoPh9d7AqCCI5Pg6-hWxg4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ps3ipdGlWkvMIKp7PZ3P974cuHwCuhwZuFhhNm7EvZQ&oe=6A131CD0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c5jrNywNQUQ7kNvwEqKb-H&_nc_oc=AdqiRMB6uI3cew87AddmeeS3a3qqL94vkxYQvt8oYjF7CvsLDOjYv5DdvwYfZdxtC3Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iYTed4858sv_6lH3nBephl-rd5clVtNEDW3eNc9anMw&oe=6A130491"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbwnTCzLzvoQ7kNvwGl_jLH&_nc_oc=Adq3TlScbQa5rEy9CdWR5MWvvtXaCLJe6iawn1Gw9LS3LZ7kVifnQpL5I_zrB7sXkas&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YIvsTqlOj6-m6GtdQraxsCgi6dumoDPiRXs3qpNLfmg&oe=6A12F846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmfOqjEVhcoQ7kNvwGhLVlK&_nc_oc=Ado1OAZz0pJxozoBgyzhuhHF-Ys_40YLVyLy0pRC17z2zP7K-XvulZ2jkOnAWGwwWCw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PBYJ_G2A3lpA0luZ8Dt6VRLq5ccbvgI06Z8pcCrzt5g&oe=6A13006E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFphrXz83pUQ7kNvwGxJBDI&_nc_oc=Adre59Oi4pGHStMdourSgxMBsQZFubgv4b7wcF5ziXhKQ8pTMRlpze2Dm5hhak4VDxo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2paOla6oC7hZyNfF7dz2zcbQjk9-fFkn4c0Ki9RaZt_Q&oe=69F35582"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cf9OdEOUogQ7kNvwERohVk&_nc_oc=AdqzPLLrPobh-iFoSdMYD53_XLQSx4zM8Dv8CMADwe2E6bilS-2p6b7PjFNFqjXTTkA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vwrz3kPQXrdZ6Ermb02FIjOwZCETUqhnwx05fX_pF4w&oe=69F34090"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXXMX-xTF3gQ7kNvwFe8jx3&_nc_oc=Adpe6dbCPle2NPTukyY_lLJjRhbQUq7-FNaUk9ezlSuj6Sz92PCGf1FcDw2eoA67Wcc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lXFLF5EJ18lnhU1zpSkF0PP0nENNCUwMF0LQIWNFGyA&oe=69F36091"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTrIPfStFT8Q7kNvwHyg53w&_nc_oc=AdpBbeXg_MZvWI7t77k8YUheO-1oraEouUsNE5eehU6xtX4jfGRDxt_lRTa_9apyd5w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SpRBR5sSTtZm3Oi-_rFnQOuufZ_Y6MuDvyTsZmToOvw&oe=69F35446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9fV5Nm9q0oQ7kNvwHADeoa&_nc_oc=AdrNmEXIwF6jDK-JOa_fWtBbEzP9MRleTOaMYCuymv25CT3J6l5Y15JrSOuEVkW4EKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GP_YmAKJdU-ov8b2uT41h9XjI3O1JLi39Cd3B_0xiSg&oe=69F35C6E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
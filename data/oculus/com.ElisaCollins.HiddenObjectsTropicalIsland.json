25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6x2omB-Vn40Q7kNvwFdGxOc&_nc_oc=AdpClHNFLOqLY2l8Z9eO5L-YVfC_m9QVEufZA9OyOoLD4ChPtoyOcs_15nIgamWTOJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbdtcw-I8Hp-1poQRofnQN0eYm9qx9Wr2K1feDvF6H2w&oe=6A69FC82"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuWxdxDFg1wQ7kNvwEpeqMs&_nc_oc=Ado5UsN0nq4c2-kJkIarQ0jfU7QuBR-qrWG6izjF1_0kJU3wCwuSmO8NSw_rBxwJqpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUjnJYRGem4vPVh5ixkMOnXHP5Gcymh212TKSMk5quNg&oe=6A69E790"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dusvBwS-68QQ7kNvwGlY9YT&_nc_oc=AdoW-lDdaw9jSlbOnT_CjK5A64WCc1fynKp4SHx65M5DwTc5kgAKx0N3WoTpCpjqLX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBVCsuU44Kpng5g6u_xij67TCqbX61hqAhNlsrPzlI-Q&oe=6A6A0791"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZLuM-QhIc0Q7kNvwF-n1B3&_nc_oc=Adr0hr2cot1Ru4W2SrHLr86bU4OxcMEKDFYCN90suS_8W94gWj9NnqlZZ91He5qT7DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl6jN7dn67BWaf8K3yW6hrY-754asxCSkW9acGAvkUzA&oe=6A69FB46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8muumlp4FBkQ7kNvwFshD7F&_nc_oc=Adox_gdKgC7JZK00TRTEzlEuc4AABdqooJgGuPmEnXjsKX_SBmakVGejNkZzWgmZV2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIEV2rcYoUYUyYCsnghgaeF3oNZZpi4XtOQmzI76B0Tw&oe=6A6A036E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
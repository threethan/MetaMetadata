25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q8VjV2ZztQQ7kNvwHq-Fcl&_nc_oc=AdooPimYyGtaDnzXbftIca0d6BctDDUfSneqH2d-U1MPyxIvDm4gUDHmK9RKy-pyGXY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wlCwJGB7jCimvUYK0MfXacyDD_QcMfEyd2ju_2pY5Ow&oe=6A1AE282"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6kH03F6cCsQ7kNvwGoVMJp&_nc_oc=AdpPjF-ylxP_FtgsEnpQIAC31wKerniW3guMedU78s0O__ggpBT2-PX-dj7h_OrB_7k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POfWsuN1Aayg1eqYF_mook0CJ2UD9uofBvirtGhn4kA&oe=6A1B05D0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew1v3b88yV8Q7kNvwGtcFMs&_nc_oc=Ado9r4_gfpTu0EOemla5pSLrfDws8yXQ9t8EH3i2JuY6YRF_2x7uD2RxFSYhFM3icjk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ghkvVQgk587wwwpcrVQ9qGHeDCTCsDPFcrdUbBjWGIQ&oe=6A1AED91"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khEUBprnFc4Q7kNvwHl5odS&_nc_oc=Adovhoqeo8wp1HppelZEnd350IDv1fg5-ZK0uu3NO6-1qTVpYDn1W2ybhY6ZiJbe8FY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DTEmB50j0EL6q2r6oH23YA7PCMd8UBfSq7TVS7cn7vA&oe=6A1AE146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwL4j8ZfyPsQ7kNvwEXwjpj&_nc_oc=Adq2E31SDzoFv0voVjkhutdqXpArpZeCplZhaq7yCjAQnsSP65CWMHYNRvIUIQ3X-Oc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bk3GuR2K5111YnKlktA95tAi7DQvVxPl4ToaxYHpmEg&oe=6A1AE96E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
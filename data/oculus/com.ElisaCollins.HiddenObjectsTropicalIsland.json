25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4Agmm1ZtI4Q7kNvwEkR8ix&_nc_oc=Adr9hSBqbwCa7C_yVLlF_fIlnZ45BdetwgS-vu1Ey5ksJaLIjvk1qC6CZnM63XSN17c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QzSC_i2rv_Au2MRRpyS3dgKK68MqiXwiHa5pxkQIHTg&oe=6A0B1082"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxF0Un56lKcQ7kNvwGNx5Vc&_nc_oc=AdpyAqVikwlZGm6g2W8qW_jId6aHWhj5w9hPKNgozlzkHuddG05D-dQn00k5EF5KWuU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oSsD9DXz6FnIczSbUvLep6nF_qz_ETE1jqTl9cEg3PQ&oe=6A0B33D0"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lan3huf2vacQ7kNvwHB4iWa&_nc_oc=AdqK-SoAtjKnKFBjVEvu9J5f9XfoarUpALwQMd3_fN21ckqtPh4IlMGj5d_laJ4W1g0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wY1NYfVb-yGDzQZvWdAS7ppXcvzSkFTQqWX9irQpIOg&oe=6A0B1B91"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZtsAMEXnIkQ7kNvwFAWOBG&_nc_oc=AdoR-sADN8Q9RCLEHsWi8O9yLztXXl1CZ_iiSAHx_OODotQ0GMi3xjp1q_tuL9P5hqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pLp2sD4w6gPthXLFRXkaNl9W0oS0aOJbOKRp1e-b8PA&oe=6A0B0F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e7N3TxGMhgQ7kNvwEnMw2t&_nc_oc=AdqngpkP6QQ_H454Du3OAWXRB40DT0AwHIFgmCIKrW8y0HDXSEz5PYub2GBCAojMngI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7el2Je85VHwdwyoSpgCLFiOgNtj4mXct7u4AXC8Bwg8Q&oe=6A0B176E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
.5771-25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGjI8FCbp-oQ7kNvwGaf7K-&_nc_oc=AdqX-z2NG4OBAl7xUYAr9ueb-CWy7pB5Q2aEL0zuVk1IscMsdYFyqiuEZscA6VBcQXk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3MtPW-kasn2yAwSUpc-ymS0Kocsu2XDpwcIaHJKgDIw&oe=6A7DC302"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvXWW6EOaAsQ7kNvwEEfyPP&_nc_oc=Adq54b_i_2_yx5B0GOpeqEFB-BTlB3EMbZi4OOSi3k9rnU11eEUnKm168_zAxsfyX64&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkEAOO4QSM9f5oj3jaehbHm1IJc-2jpXVbBi4lznJiKw&oe=6A7DAE10"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deoiRYctAWAQ7kNvwGaW5f_&_nc_oc=AdrpU58v08h0tXlTMGy7_snOcRxcNnm-tq2iGizx0Yp5elvDaxPSQ6PqczWkgF0Y9OE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_m4yT2rgRTxTYVCzovBqlwKIBM66uBMPo1_BtIZT7Cg&oe=6A7DCE11"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWq2bTRC9CEQ7kNvwEVY3fb&_nc_oc=AdorWK7x9uDJ5_fRERSwjSda3_HcOr3Qc5pT1KvVaNIL55fJ_K-1XY9NbWFb6Uzq-Jk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMLKFUXnxg0gcSGBwwXLZnqK5ACR2vxuJ_mWa-Rs8fnA&oe=6A7DC1C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP5Q84qb-G4Q7kNvwEunkce&_nc_oc=Ado8EcsF4XareN_mAwsmXSVrwmp2WIWqeHdfFWqQ8kEzIw18n9VYZLm9kFwMtTVk0T4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkFZNshbIhdyvGWs38frS-ZrAqm6UXZuhM2MEdMz_7LA&oe=6A7DC9EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326
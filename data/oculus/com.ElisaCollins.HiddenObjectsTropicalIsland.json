25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVIRmF9keYcQ7kNvwFjFWbu&_nc_oc=AdrC6fuhrTB6YnHq9U13AhpAwQLeGDn1-usRjJsNsPULLXLECZszw1UbTmQwmZRbdew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rey0rnMLOx3fSnLig87BSyr_ZRbWKx-_t78MN3iy8_w&oe=69DF8F02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pJRcxnWMYIQ7kNvwEAtw4m&_nc_oc=AdoKT6Jnp7h5iY_iZlmWXtmCyXxz7ZO06vfjHJrFgXcxyWVXvxfRHIIMAUTBVYrokbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03UOaP87XXOpOC6myUcbHos360IQgoGsfRPznbSrucUg&oe=69DF7A10"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WD_4ockCBwQ7kNvwGVqSOw&_nc_oc=AdoQEkpRNLs_rkXII7naPkWn2hKhXBFdrs9A4KTXiqEsC5XwkFDgX9JFFvRfyEy4Q4Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MF6HCvgPgoPQn1jsQR0Xen6s_cWgkhcIs1f3ZgZRF5g&oe=69DF9A11"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe-WrGED5vcQ7kNvwEs-euU&_nc_oc=AdrQ-R9L9kdiM1Sdzmp_IrgXDp6ulwjkeClvad7f6PyJ0qI0aXMBGfG6Jle1nwSDrbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vXIOza-n3W_mM1CzNiiwOaxXrjPJDQHrCt1siV9OzbA&oe=69DF8DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuUD0XK1I_MQ7kNvwHsPpj0&_nc_oc=AdpR0ZZRc15FIKGyLT885hVAfyyInfPpduuTu32_F6XVduOJVOS5arUFsrAapNv1CVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qRNh8CK_qVdKdzb_I2FTIvhzilP-XiECQ49FnQ8bqow&oe=69DF95EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
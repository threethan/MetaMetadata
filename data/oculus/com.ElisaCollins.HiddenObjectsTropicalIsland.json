25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdI_L8eJ-PIQ7kNvwEZhsa8&_nc_oc=Adp23DCW0eSNlK62YXJVpbAFjI-OQ5C2l8hvC3RrojXWvcSYNt-x2Sjtk_F9IlCSgMQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJsFdidfecuR-ER2chXLyB7nOwc3PwHc5FD_znfeyztA&oe=6A903802"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJsRdQREzE8Q7kNvwGUaX-f&_nc_oc=AdoJH_5dh6DPqQvsZFfonVYIp_HY5IDjS0P9SdtYsjg3A7JZhsFWAAMGCQWgov1Uq1I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjaSVJAqnZ1VkAAEHCFv9bJZ7qfFZ7RpgFPbaLCimC8A&oe=6A902310"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu7ITF_k43AQ7kNvwFMpueI&_nc_oc=AdrpypKRzm08B4jEK6iAMk-ufMRIq-HKcpZIE-99YysQ9Lzu8O6wO3hzRQtZvXEY9ZI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeJHEVmeCI6a-VmnbDClirH46lPCvv6cpBgE1icP1eOw&oe=6A900AD1"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FgIZeIpV8QQ7kNvwF84WIz&_nc_oc=AdqcSH8ZLaTeBYCl817rKGtyP7XkrqlZKZJYohUCw1787Jze4DReqo4ZL4NoAku3iRI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsj4nFIViwEFiH8wOiy3KfiNtaP35Uy8YTaGvPj_r7sQ&oe=6A9036C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXB-soPfPzIQ7kNvwHhwiue&_nc_oc=AdqghqZsPfoATkNqdhuXnPamAm2HeFO0gdgVNnsnUTKpSliCNj9Ep4r3qLd4w4xvIF4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBo_uP3wTR8ZoAvlxwl714guJY55EINUL6hcdYbK9uYQ&oe=6A903EEE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7XQnrdb8EYQ7kNvwHZk2Pt&_nc_oc=Adrk4DqQas6P_CObsZwEB-2Z9iacIXkXnDIjG1JpabeXZNEGAGzdaBUfJ5gyI1d277g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8LKQ_i622HGNxReVUOdfAvzYrahct0I5Mo68DVUXQPw&oe=6AF74542"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyQFNgy-eLcQ7kNvwFMkjVp&_nc_oc=AdqF4GVZV5yAeHgBo9yuT8XEVuJkHFiN3Kg80pvLOyBhLkd5yU351Z70cFW9F3w7Wsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9m3cIYuiVqAKPPtLDT19vCPQWHnf61WytkfOzz2Go8A&oe=6AF73050"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVHbXRnkIDAQ7kNvwHbSVDz&_nc_oc=AdpGtEF6DwXHBoQfnqlHhcATxcuEUZBTOxGntk8O2RUQrlhYnG6wM4acGgWpmsv00nU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg2zDH_iY6GEwgKHt1qhb_Zf5M1h5E8vzjDYHt-V-IxA&oe=6AF71811"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBYuUwHfT_oQ7kNvwH2SgaJ&_nc_oc=AdqlloK9MQf6DFpVCL-48FKlRJXrV66HuNUAhYZ3THFOnk2MS905UEG3P6BJFW7Alvs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTllnNVA1G2-V8q9aGJXfOAAu-yrSiGcCYMbPuLB3UF1A&oe=6AF74406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7JCKusj10cQ7kNvwF7SBa6&_nc_oc=AdpiIgeZ43MBDE2CPzZ288OeekLlzTiKMm6_Aa5FeDbcbbUSQFNcgvOLeRaw9cEpPi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1etTXkYOVvQx-n2rgI-jYi86SxnLNE0M6oebTX_Wlsg&oe=6AF713EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
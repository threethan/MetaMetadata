FD49zkQ7kNvwElPziK&_nc_oc=AdkrRdJr1NGoqdCWX1XcJF4GdEySu6PnuNt0kbESxEA6QhfTEPirR63zU9ZKKGwbjkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvqWjx4nWNBiMlRydYuNQQV9Xqe_kWhjMVuVp7OmgUblQ&oe=6999AF82"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lAbL0kr94gQ7kNvwGFMIlC&_nc_oc=AdlxEJQkop1E711LPLcMs299zRbtYhn3hwNl3FDc2BoXqIDGVegtC4eL-ZZen0V3XSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGda9JgOB32zgCLKZZ5i-XP4tVuEHhDhfVPqFK-OJa-A&oe=69999A90"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBeEgPr88mIQ7kNvwG5CW5-&_nc_oc=AdlEGcvWeyLq7IQsFDgNgC4-9rWuinV9khGPkOoln3oMCYxsX9_BX2kfWUtUd4ibpuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuofiN6XdFdER6f99vVkrTQFIMkM_TkE4KLtBKTZFq84w&oe=6999BA91"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNK-APx-HiAQ7kNvwGcXdFD&_nc_oc=AdnNjuyxcdQdjjd0yIXuXKAc0Z7JtoeNJlhkUWJlGBNyR3qH9vkeHALTFtc2kIWh3_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDV6xk7Y_U56_csFV76fFE0jiz4kdFuNxAWQxuxQHgdg&oe=6999AE46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmOVaV5hRAkQ7kNvwE2sIKU&_nc_oc=AdnZeGFlj4Zs0R6Sagd4Cj5NoD6Wm-7Pzjh9-KBGSe9-_fheCT-iSj2G89tKyqBZpcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv10aCpUkiSxih3lom6pJwaTSqjvxvhg78UtMZ3X5K6uw&oe=6999B66E"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
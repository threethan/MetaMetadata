25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl3iyRfvy8MQ7kNvwGYhWME&_nc_oc=Ado5f55jPj-SJPr5f1TzvF7WI-sMVRXunSmjeU9KE2daOp8Dc2hOoZSATbvVHU22Qo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qdBDUgMC8sJC8uL_1aHFnS4tvNOiVnFgj6eGJpz4NoQ&oe=6A3E7B02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6NIzQSdQmsQ7kNvwHWjVp9&_nc_oc=Adrtr6hfSJU_HIjTESP9Y-DhuOecfpZDLUtGcrRwJYvutcdhlamgRY-wFpG6vrDXdac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EwRZDnhIQBAFkuqrsIC51UasEKYzHH0E3dT9r26Epyw&oe=6A3E9E50"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13zqFl1bABgQ7kNvwEQYV8c&_nc_oc=AdpOh6KXGe1NLZ7jjmOT8WvXI07wRLBIBlYwaN1UqDVrfoi75xZHOdbxH03f3zrOqXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oGZvRbEZ1VH5BRjHb1T8gDeCJ6GM_SAqIgmsIAxvQqQ&oe=6A3E8611"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UN8jNCDZ6YQ7kNvwHq68Nm&_nc_oc=Adp7kUe-vc_t968jVoQel2j7H0Ro6huwcIZbbt1O5ilkddU3kBsHfyaSJq8zW5G4wfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sDB2ctpO1NXWl6PCbPc_f0KFjPDoRyQvpJCCDXwqdYg&oe=6A3E79C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh6fSoAb5vUQ7kNvwENYAHz&_nc_oc=AdospJiwhCQkbib_xf0cmpUft8LS06oIgmbslB4hl-8aXv_jG05ICFhya6HxueK66mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97Toh8UHTYAYC9RJMBzzPMdvgsK3E9NueoaZXRnP0ZiQ&oe=6A3E81EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
25/473391959_1289486818789151_7884773057646010541_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5ZF5LxbNSEQ7kNvwFkDt6z&_nc_oc=AdqkjmaVG3NZvAQ3ITXZrzeEd0X-Da2Hq3b4Yb6a30A6yoWMYYFg5uMzM6mJU3qTljU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1ZEovIzhvFwI77Maq5nxDaLjoiy-lnfOydlDR7o009w&oe=6A5B7C02"}, {"file_name": "wolf new.png", "id": "1616282618993373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_1616282622326706_4896252184150422810_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBVCSGSuaW0Q7kNvwH3qby7&_nc_oc=Adrb-wuGjNAnAw3WTqsiKanGGiJ3hijyUZanTATE3fJlgtvUV0Itl5JzDw4hy-F7xZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB87LRI645eLozcouiAvR6f7IPvAAfdu5pium_Bm0F27A&oe=6A5B6710"}, {"file_name": "submarine.png", "id": "1350222886162300", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392309_1350222889495633_5789316705970653923_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9E_89YnPxwQ7kNvwHuwWKI&_nc_oc=AdqxNA1DbckXU8D7dRxh57IRWE_bidt_qy9M7uo0N-u_g-nswOAXBMxB8pSC0S_p6j8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcNbM2FRkk7kSPNOD2q8olBFcV6ddoSyRcDcSr6dM0BA&oe=6A5B8711"}, {"file_name": "car.png", "id": "1005751941422631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391949_1005751948089297_2711390350780175151_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr_VIdqwD8MQ7kNvwFWnsM0&_nc_oc=Adp3FX1gb1O7mbtp4B0axL55no4I6mIULAcnqgLJJkOWibvzhfoTjv_7_5022pdt3o8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAacEvXEV5MIlhC_kDx3gKkjlpwZ2Qe6DxsDea_LBpwZg&oe=6A5B7AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "segull.png", "id": "3894615550778611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391959_3894615554111944_7745214895827150132_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jurKwpNTZDAQ7kNvwGbHcLw&_nc_oc=Adru1VWq1DipobeX27ZgMZLWW7bH2elrrRTV-cS2dst7daCRsRpEUxq-l1cyl7z4YuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0yc0I2t3_hyWA84aHO25-K0ILs47djQO6T9vCoiHbtg&oe=6A5B82EE"}, "display_name": "Hidden Objects Tropical Island", "keywords": ["hidden", "tropical", "JamieDornan", "nonviolent", "family"], "long_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Pleasant, relaxing, and non-violent.\n\nIncludes a Jamie Dornan tribute, with objects from his movies, other shows, and real life, plus fun facts. (Although some of Jamie's shows are adult, this game is completely family-friendly.)  Or if you're not particularly a fan, just enjoy finding the objects, 52 in all: Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, stethoscope, camera, microphone, metal detector, ambulance, and more, even the kitchen sink.\n\nFull version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n", "short_description": "Find the hidden objects on this beautiful tropical island, exploring land, sea, and air.  Game is re-playable multiple times, with object locations shuffled. Includes (family-friendly) Jamie Dornan tribute. Helicopter, submarine, wolf, sheriff's car, wooden sword, ice cream cone, and more.  Full version; no ads; no IAPs; no data collected about you nor your device. Just plain fun!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1_8owt359ta8z20HrlFwpUNmGU0hSXmLHNNXKcCddKss/edit?tab=t.0", "developer_terms_of_service_url": null, "publisher_name": "Elisa Collins", "support_website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "website_url": "https://docs.google.com/document/d/1XGptkBnxxB1ABqM1vvT23Z8V0HM4cLCeUfBjPnjcURY/edit?tab=t.0", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
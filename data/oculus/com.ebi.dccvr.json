n_054Q7kNvwEhVpUg&_nc_oc=AdoTaE-6uyKLErBmJVjT1jeLYcr1j0R9tXc8JgegdUPsYBfi2QSVzVeZusjvOqToI9I&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pwEH0eH98z-yB-VVsfDC_-ap1_iqcvJi2jUSICcnGaA&oe=6A09B3D4"}, {"file_name": "DCC_Screenshots2.png", "id": "1899343234790182", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499622211_1899343238123515_8538789473441342933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhsQvtA3ArQQ7kNvwEeR_XR&_nc_oc=Adp2v0638YR9W4c1DncCN1RF5s7LOXnLuv5Sj1FQMhynXtdAcLWf3BtC5SMvqfZ6Xxk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qeDMb7-MCtyFw7OOLs1yQdBqzKilimsWxhj6aLn1-fg&oe=6A09D76C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCC_Storefront_2560x1440.png", "id": "1996218940991772", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499312402_1996218944325105_2911285227185214447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Irv9IEj6AgsQ7kNvwHVtG5m&_nc_oc=AdqUWlSNU_G9Cd_w6VGSsIJ1TJUHU1plze-ub0KdsFSCE7K9kVWWeC8YfpDPfEBfYps&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xwYaUcNlS9ieTEp9XOQ0QDGeh1WCkknIIBdbUEip-4A&oe=6A09B080"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26509487792013150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499622285_1640777400297735_6526912770450480917_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwdFDtrxNfsQ7kNvwFDnKsZ&_nc_oc=AdrPbrhesEcEjlX2KQfgN_7XIeT6ESooUsuerzOM8kJ8gSKLM2-cYDwQHekv8zcVNVQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HrvOubQfGkodSwEHJH2_4qWYqv64W8Z1Ua0fV4_fPCg&oe=6A09CCCC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drone Core Command", "platform": "ANDROID_6DOF", "context_category": {"context_categ
scription": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26509487792013150"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622285_1640777400297735_6526912770450480917_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VG8WjbNwiboQ7kNvwEAeUKe&_nc_oc=Adq8UA0RvuBDbyDsQD_-FCgedlSE0Ss9PlzwYlFLOePvjIzJLf8n1nGFET5htBAt3rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lHwVDyg9LtS-kFvNmvUenKfnB35qN4cWTOvGvqQqqKw&oe=6A05D84C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Drone Core Command", "platform": "ANDROID_6DOF", "context_category": {"context_categ
: []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27045535115075079"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.95\n\n- Haptics have been integrated in most places where appropriate.\n- First pass at hit reacts from enemies when taking damage\n- Adjusted some alignment with the inventory spawn point given the new spawn technique\n- Added materialization effects to both inventory and gun types when phasing in and out based on cores equipped", "created_date": 1781732795, "id": "27020305047598086", "version": "0.95", "version_code": 95, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27045535115075079"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.94\n\n- added a hud element during ground ops that indicates when players are controlling their drones targeting system\n- repair process has been modified to require a gripped hand state when rotating the puzzle\n- increased delay time for respawn of acid bubbles on the acidic residue puzzle\n- slowed board speed and increased strafe speed for recon runs \n- added a reset orientation setting in the settings menu\n- the first repair puzzle will always be the easiest (previous it was random)\n- slowed the speed of micro parasites on the respective puzzle\n- when players are at their deploy confirmation kiosk for ground ops, they are informed if they should repair their drone first\n- cleaned up some ui formatting on the deploy kiosk\n- increased scale of the enemies a little\n- updated inventory open/close functionality to be tied to virtual mechanical rotation on the left arm rather than gesture based. this reduces false positives and provides the perception of a 'key press' of sorts to engage the inventory", "created_date": 1781633782, "id": "27005827269045864", "version": "0.94", "version_code": 94, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27045535115075079"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.93\n\n- added a hud element during ground ops that indicates when players are controlling their drones targeting system\n- repair process has been modified to require a gripped hand state when rotating the puzzle\n- increased delay time for respawn of acid bubbles on the acidic residue puzzle\n- slowed board speed and increased strafe speed for recon runs \n- added a reset orientation setting in the settings menu\n- the first repair puzzle will always be the easiest (previous it was random)\n- slowed the speed of micro parasites on the respective puzzle\n- when players are at their deploy confirmation kiosk for ground ops, they are informed if they should repair their drone first\n- cleaned up some ui formatting on the deploy kiosk", "created_date": 1781556517, "id": "26994671406828117", "version": "0.93", "version_code": 93, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
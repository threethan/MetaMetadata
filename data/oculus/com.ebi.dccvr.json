oxfoFvNN5zh9nCk_dEfPokmwjts8JYPVNMSnuEpad3AlZIyJuSasrfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SJYXrveMw2Pep-Q2N2TAoOnGIWGBwpyMSE-K2m7Kflw&oe=69FF2480"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
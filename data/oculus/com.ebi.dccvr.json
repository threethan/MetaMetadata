gTmsRGiKD3Hay4ST25kUvZuqmAA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NkcscLxtiNhzdncI3Lc4WKDUTiZ6V037mBMiIXLcONA&oe=6A32C1BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCC_Storefront_2560x1440.png", "id": "1996218940991772", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499312402_1996218944325105_2911285227185214447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxH09xetRdcQ7kNvwE0J5s1&_nc_oc=AdojL_lFQgv2mjGmP0R4nrGc2FCTi5vMz4gK2C3TznUEOAUBmf0HvSSFrleZoculU2I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BfX9R-Ghq87oh7qXgq-AbxLIU73t96Yrea-HBIym-wA&oe=6A32C740"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interac
upk1TqS78vK48x79EurQFZ9NtTBqE29FbcEIteRtuUKBe8-s7cPW5XU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vhoYXmsC5Haf2dFXUaK6IGKAVkbGgLGq_u__EViWTBw&oe=69EA0C80"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25243862408575701"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1484097030176174"}, {"status": "PUBLISHED", "id": "1213234084345273"}]}, "baseline_offer": {"id": "1484097030176174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775584380, "status": "PUBLISHED", "id": "1484097030176174"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26205235129105086", "version": "0.63"}, "id": "3773658732765551", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26205235129105086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.63\n\nNew\n- Continued progress on optimization - reduced draw calls, audio optimization\n- Bug fix in boss fight with intro sequence triggering twice\n\nKnown Bugs\n- Audio can cut out occasionally with some music and fx\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1775856960, "id": "26205235129105086", "version": "0.63", "version_code": 63, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26205235129105086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.62\n\nNew\n- Continued progress on optimization - updated sky boxes to reduce overhead and clean up pixelation\n- Bug fix in the recon game with timers not cancelling out as expected and some collision modifications\n\nKnown Bugs\n- In the process of debugging an audio issue with the soundtrack so it may pop periodically\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1775619147, "id": "26176694761959123", "version": "0.62", "version_code": 62, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26205235129105086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.61\n\nNew\n- Continued progress on optimization\n- Fixed a bug with repair tool not activating when expected.  Still some glitches here, but works much better than it used to.\n\nKnown Bugs\n- In the process of debugging an audio issue with the soundtrack so it may pop periodically\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated", "created_date": 1775605690, "id": "26175071785454754", "version": "0.61", "version_code": 61, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26205235129105086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.60\n\nNew\n- Iteration on recon runs - new boards have been integrated\n- Reduced recon run times for 2nd and 3rd regions to 1:30min and 2:00min respectively\n- fixed a bug with repair upgrades health not updating as expected\n- iteration on boss fight tweaking some numbers\n- modified targeting reticle\n\nKnown Bugs\n- In the process of debugging an audio issue with the soundtrack so it may pop periodically\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated", "created_date": 1775070011, "id": "26107410252220908", "version": "0.60", "version_code": 60, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26205235129105086"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.59\n\nNew\n- Release Candidate for Early Access\n- Removed experimental flag for com.oculus permissions\n- fixed a bug with repair upgrades\n- railgun cooldowns only trigger when successfully discharged\n\nKnown Bugs\n- Snap turning options in the settings menu only indicate use with hand tracking, but can be used with controllers as well. \n- audio bugs out sometimes.\n\nFuture\n- continued optimizations\n- iterations on recon game to mix it up a bit more\n- systems balancing still in progress so any feedback here is appreciated", "created_date": 1774330360, "id": "26015305648098036", "version": "0.59", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
IKOw-D_kw2FFvSBDqaz6ky3EM4lHwuy0PmOGlwuK6dGjYMLW89mgC4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PxbpkRp1656tOCO8zxVWvumg5QZY3-p9bh-etgztXrA&oe=6A01C780"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25243862408575701"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1484097030176174"}, {"status": "PUBLISHED", "id": "1213234084345273"}]}, "baseline_offer": {"id": "1484097030176174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775584380, "status": "PUBLISHED", "id": "1484097030176174"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26493117273650202", "version": "0.68"}, "id": "3773658732765551", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26493117273650202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.68\n\nNew\n- UX Iteration with onboarding\n- Fixed a bug where batteries sometimes wouldn't spawn in recon runs\n\nKnown Bugs\n- Some art assets are still in progress given the new performance push\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1778109329, "id": "26493117273650202", "version": "0.68", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26493117273650202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.67\n\nNew\n- UX Iteration on upgrades.  Knobs were difficult to turn, so these are now switches\n- Fixed a bug with map mission description telling players to do recon runs when they don't need to\n- Fixed a bug with trying to scroll past the last map\n\nKnown Bugs\n- Some art assets are still in progress given the new performance push\n\nFuture\n- continued optimizations\n- working on improving onboarding flow to help players engage quickly with ground ops, leaving recon runs as an option.\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1778024056, "id": "26481555951473001", "version": "0.67", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26493117273650202"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Added button support for inventory activation when using controllers", "created_date": 177793745
, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26503622742599655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.69\n\nNew\n- Amplified some fracture visual fx\n- Increased Fresnel glow around the player's drone to give it more screen prominence\n- Fixed a bug with recon run territory display name\n- Fixed a bug where players could still activate weapons for the recon ship when not on the flight deck\n- Fixed a voiceover bug with the drone when receiving targeting commands from the player\n- Adjusted some shaders in the first recon run world style so it wasn't so bright\n\nKnown Bugs\n- Some art assets are still in progress given the new performance push\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated\n- adding more granularity into puzzles so pinch actions can be used to fine-tune puzzle repair pieces\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1778179966, "id": "26503622742599655", "version": "0.69", "version_code": 69, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26503622742599655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.68\n\nNew\n- UX Iteration with onboarding\n- Fixed a bug where batteries sometimes wouldn't spawn in recon runs\n\nKnown Bugs\n- Some art assets are still in progress given the new performance push\n\nFuture\n- continued optimizations\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1778109329, "id": "26493117273650202", "version": "0.68", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25243862388575703", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26503622742599655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3773658732765551"}]}, "change_log": "Drone Core Command v0.67\n\nNew\n- UX Iteration on upgrades.  Knobs were difficult to turn, so these are now switches\n- Fixed a bug with map mission description telling players to do recon runs when they don't need to\n- Fixed a bug with trying to scroll past the last map\n\nKnown Bugs\n- Some art assets are still in progress given the new performance push\n\nFuture\n- continued optimizations\n- working on improving onboarding flow to help players engage quickly with ground ops, leaving recon runs as an option.\n- systems balancing still in progress so any feedback here is appreciated\n- XR gameplay is in development, but not ready for release into production channel yet.", "created_date": 1778024056, "id": "26481555951473001", "version": "0.67", "version_code": 67, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"
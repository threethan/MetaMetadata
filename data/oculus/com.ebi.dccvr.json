&oe=6A15AB7D"}, {"file_name": "DCC_Screenshots5.png", "id": "4209357562649044", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618444_4209357565982377_9214757835864523109_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOIlkiO6_H0Q7kNvwHjoTw7&_nc_oc=AdpznBIrceyfLmu4Ovu3PFcyr7zOeU-IAvn5wfcU4iQld6aeBgxtuBwL0bbOgugMxSQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ha2GJvOBSuKCyfgOz_kn8Thk_mB9wW0JJjYHcfVmDwg&oe=6A159154"}, {"file_name": "DCC_Screenshots2.png", "id": "1899343234790182", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622211_1899343238123515_8538789473441342933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMFkFoKAbNcQ7kNvwGqWoVs&_nc_oc=AdrZlJ2qtyuCFNkmurcEcTqS_684MDkoEUAU-J7LTTCaSCZy5M1u3H6HSMoay9vHboo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A5OrErcMHqzSZRhE-9qrHUWkSHz6OIhNgNCFRQTSnlQ&oe=6A15B4EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCC_Storefront_2560x1440.png", "id": "1996218940991772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312402_1996218944325105_2911285227185214447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbgagrBrSBQQ7kNvwGsB1Z5&_nc_oc=Adpq5L3ppPc-I2ABqeLi-_r-mlc8gdl_0v-XjXU-Fl2jg9r2mXLSPKkbnLPquJ92UmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MrVcl_B9U7zuJ5ZFIsxj_rkvksPUHxrst-Yivgh-AbQ&oe=6A15C640"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25243862408575701"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1484097030176174"}, {"status": "PUBLISHED", "id": "1213234084345273"}]}, "baseline_offer": {"id": "1484097030176174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775584380, "status": "PUBLISHED", "id": "1484097030176174"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
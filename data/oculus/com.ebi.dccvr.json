lRt2WZ5yGP--w7LyS3joxW1_0Q&oe=6A11B6FD"}, {"file_name": "DCC_Screenshots5.png", "id": "4209357562649044", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618444_4209357565982377_9214757835864523109_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vbCLAqFEx8Q7kNvwG2V4P-&_nc_oc=AdoZrHCEbW-fV5frev8nklF0r6Ax8_9xQS86fm_MTW_nK8miYOl2k4L7kCDvY5QPyD4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RDMNWNw2kZGsknakztKsMGIvrqmGlj49itYj3n-sGiQ&oe=6A119CD4"}, {"file_name": "DCC_Screenshots2.png", "id": "1899343234790182", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622211_1899343238123515_8538789473441342933_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hn1BuZUpxHwQ7kNvwEjNrPu&_nc_oc=AdoPafJTpBAUValomrM8A3bW9tj-kB54Of76nr0PYDZVqsjmaFtoJhCtQloGtUgKTiQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MYnveZkn4RV1_YUcRsFKXGIWH6orxUTr6O2WXp9XNcA&oe=6A11C06C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DCC_Storefront_2560x1440.png", "id": "1996218940991772", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499312402_1996218944325105_2911285227185214447_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0apizdWp7IQ7kNvwG4Ej8y&_nc_oc=AdpYnQcZqpZG4KgsayLIVA7oHqSvV4gd7S8j6LiAlE6tAhqu2w2f8MDUmMrB5M_nR9k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pypxs7opQy_1WX4cvRE_UL0gjJpqfYfBxlEoky5eP1A&oe=6A119980"}, "display_name": "Drone Core Command", "keywords": [], "long_description": "A drone companion game where you command a responsive combat unit through hostile alien territory. Secure zones, adapt to evolving threats, and follow Command\u2019s escalating objectives. \n\nUpgrade your drone with modular weapon systems, choosing between human\u2011engineered firepower or experimental drone\u2011targeting tech. \n\nFly recon missions using a virtual flight path to earn research intel and secure battle coordinates. \n\nStrengthen your drone with mechanical repairs, performance upgrades, and tactical enhancements as you push deeper into the planet\u2019s contested frontier.\n\nDrone Core Command is a short story gallery shooter designed for use with hand tracking and also supports more traditional controller use.  ", "short_description": "A drone companion game where you command a responsive combat unit through hostile alien territory.  Guide and strategize as you and your drone secure zones, adapt to threats, and carry out Command's escalating objectives.   Drone Core Command is a short story gallery shooter designed for use with hand tracking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": null, "website_url": "https://www.earthborninteractive.com/dronecorecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25243862408575701"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1484097030176174"}, {"status": "PUBLISHED", "id": "1213234084345273"}]}, "baseline_offer": {"id": "1484097030176174"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775584380, "status": "PUBLISHED", "id": "1484097030176174"}]}, "liveChannel": {"nodes": [
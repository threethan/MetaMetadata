0a&_nc_ohc=g-R0enhZxOIQ7kNvwEM-xwe&_nc_oc=Adr5kvA2j9vUFgJJJ3d7aVfaQuxGfaOP9NdbP8hlC6aCzmUu0CW_4K6yI0sX9FVKx68&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4EyNlF0v7OkVlraDHlBfV6RUX6w5Vv_0fFw6Xc0_UKw&oe=6AE351CF"}, {"file_name": "1.png", "id": "2120108415285999", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620669_2120108418619332_2327701348485131596_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFc71WEigwoQ7kNvwEdgAOA&_nc_oc=AdpviT7eyZ6dqs7NMTT6_EsMAPtahJ6YNP1fTbvdmAx2wsdj-gNNaUMiSL7tqhJaY00&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDQBSmiuQocaZi1F27bs2Hqod2uHBv7Ug3_oSWBttBHA&oe=6AE36A2D"}, {"file_name": "0.png", "id": "3796966767135079", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622153_3796966770468412_3779062224324981979_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WcAnfwlHQ8Q7kNvwFS3n0-&_nc_oc=AdrZ8PAnfGwuW6JicvX6192lfO4QN6x6FZFuRsFpkp81fQMyrUhfOR1ypn06LLmbGss&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnvP6MT0Cl_xLmt9xTf08Bd4PZ0noFN-Df2CTbBpvNnQ&oe=6AE36E8B"}, {"file_name": "2.png", "id": "2158734748377841", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620599_2158734751711174_5094440100030539460_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW3EUvOgPzIQ7kNvwHbGSvc&_nc_oc=Adq-_Y_PvXdQqrcja7i1FzeqLcLoh6bYpuOWQgxQV7TGPSeXGVymUZ1fk-ZhsJpGAvc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNSj-PDLW4rK-rr3dX6azEk0QLAusQxaYHk9Jp9lEDFQ&oe=6AE364D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_idle.png", "id": "1746262743337840", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623185_1746262746671173_6610015124905803577_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zed3hBfKKiUQ7kNvwFJMMTT&_nc_oc=AdqRvaqu7-NAZIaY42AjdvWOnmkWbgdEvbfGTXrG4yHQM96drcXAYkGDfR2N0wPBOXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYR9ylbd4eLKP03GOjgZF0uNz_rUJd2bz2E1DcltBFlg&oe=6AE36093"}, "display_name": "Deep Stick : Spatial Drum Experience", "keywords": [], "long_description": "Your drum kit, anywhere in your home.\nDeepStick places a full-size virtual drum kit in your real room with mixed reality passthrough. Real hands and objects naturally hide the drums behind them, so the kit feels truly there.\n\nPLAY YOUR WAY\n- Kick, snare, three toms, hi-hat, ride and two crashes\n- Touch controllers or hand tracking alone\n- Velocity-sensitive hits\n- Pedals on controller buttons, a keyboard or a USB/Bluetooth foot pedal\n- Move, turn and raise each drum or the whole kit\n\nA KIT FOR EVERY ROOM\nDeepStick remembers your setup in each place you play and restores it when you return.\n\nPRACTICE\nPlay along with your own songs or music videos on a screen you can place anywhere. Change the speed, and record your stick motion and MIDI to replay later.\n\nRHYTHM GAME\nNotes from a MIDI chart fall onto each drum. Score, build combos and aim for PERFECT.\n\nPHONE COMPANION\nScan the QR code to upload music, watch a live score, record MP3 or MIDI, control playback and edit each drum's sound.\n\nLIVE SYNC\nPlay for friends in the same room: viewers see your drums, sticks and video in place and hear every hit live.\n", "short_description": "Play a full-size virtual drum kit right in your room. DeepStick puts a 4-cymbal kit in mixed reality. Play it with controllers or bare hands, practice along with your own songs and videos, and take on a falling-note rhythm game. Your phone works as a companion screen, and with Live Sync friends in the same room can watch you play live."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223929197098", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "conte
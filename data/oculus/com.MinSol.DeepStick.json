m&_nc_ss=7f20f&oh=00_AQMnvP6MT0Cl_xLmt9xTf08Bd4PZ0noFN-Df2CTbBpvNnQ&oe=6AE36E8B"}, {"file_name": "2.png", "id": "2158734748377841", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620599_2158734751711174_5094440100030539460_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW3EUvOgPzIQ7kNvwHbGSvc&_nc_oc=Adq-_Y_PvXdQqrcja7i1FzeqLcLoh6bYpuOWQgxQV7TGPSeXGVymUZ1fk-ZhsJpGAvc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNSj-PDLW4rK-rr3dX6azEk0QLAusQxaYHk9Jp9lEDFQ&oe=6AE364D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_idle.png", "id": "1746262743337840", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623185_1746262746671173_6610015124905803577_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zed3hBfKKiUQ7kNvwFJMMTT&_nc_oc=AdqRvaqu7-NAZIaY42AjdvWOnmkWbgdEvbfGTXrG4yHQM96drcXAYkGDfR2N0wPBOXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYR9ylbd4eLKP03GOjgZF0uNz_rUJd2bz2E1DcltBFlg&oe=6AE36093"}, "display_name": "Deep Stick : Spatial Drum Experience", "keywords": [], "long_description": "Your drum kit, anywhere in your home.\nDeepStick places a full-size virtual drum kit in your real room with mixed reality passthrough. Real hands and objects naturally hide the drums behind them, so the kit feels truly there.\n\nPLAY YOUR WAY\n- Kick, snare, three toms, hi-hat, ride and two crashes\n- Touch controllers or hand tracking alone\n- Velocity-sensitive hits\n- Pedals on controller buttons, a keyboard or a USB/Bluetooth foot pedal\n- Move, turn and raise each drum or the whole kit\n\nA KIT FOR EVERY ROOM\nDeepStick remembers your setup in each place you play and restores it when you return.\n\nPRACTICE\nPlay along with your own songs or music videos on a screen you can place anywhere. Change the speed, and record your stick motion and MIDI to replay later.\n\nRHYTHM GAME\nNotes from a MIDI chart fall onto each drum. Score, build combos and aim for PERFECT.\n\nPHONE COMPANION\nScan the QR code to upload music, watch a live score, record MP3 or MIDI, control playback and edit each drum's sound.\n\nLIVE SYNC\nPlay for friends in the same room: viewers see your drums, sticks and video in place and hear every hit live.\n", "short_description": "Play a full-size virtual drum kit right in your room. DeepStick puts a 4-cymbal kit in mixed reality. Play it with controllers or bare hands, practice along with your own songs and videos, and take on a falling-note rhythm game. Your phone works as a companion screen, and with Live Sync friends in the same room can watch you play live."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223929197098", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "941146042085908"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1618085829759069"}]}, "baseline_offer": {"id": "1618085829759069"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792533960, "status": "PUBLISHED", "id": "1618085829759069"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "939263852274127", "version": "V59 (202
96_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkO8i5CbEZ8Q7kNvwF4qx01&_nc_oc=AdrgFxF6sUGBMD3uN5HQrJX2oP-tRLwJwV0d1mfertxBfU5Im9qTjgKAS-dl-3cznBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV_QAdPh8qN80kehVCZu30Cf3h28ngTaFhrAr4jlPm4g&oe=6B0EF810"}, {"file_name": "02-tussen-de-figuren.png", "id": "1432930815088526", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1432930818421859_2109163933637767528_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWzoEFFFiKIQ7kNvwGYhe-e&_nc_oc=Ado-7QMlKVnOVdBR7uAC_-v5DMXtqI9unBraO__wGpzXUffnv_TM4109ZAL6E7JJFXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmApjH0pLkm7hERxBuuR5Kz2bLT47fmvMAsRNqYqd5Sg&oe=6B0EFDB1"}, {"file_name": "03-bos-met-zonnen.png", "id": "1426401005614352", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1426401015614351_4597531886130395829_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tOFLSB5B68Q7kNvwEPzlpr&_nc_oc=Adrg2pCanNkOEp_66jMdxjOE-EwqkilOlx4N-HsyiSlv4Qn0d0eQI5f8B1noPy4B8H0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXKWCMbg0xXUeuWhZrZz1tJpb8HTvqpt4kctzMz6DkBGg&oe=6B0F0A81"}, {"file_name": "04-vuurwerk-wereld.png", "id": "2198151384381789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_2198151391048455_6443560361723578064_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmaygetAZasQ7kNvwHKHUxk&_nc_oc=AdpDD-AqNKCRoL8vPQ2gNvaM5DFZyAi3qM_SQJk8t78KwIkY5nZPzcN90qEkO3gBajU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1y_2riswWNbjTNDbqmfiHwSptBNuycMFkvkuE-jwzHw&oe=6B0F0557"}, {"file_name": "05-gallery-choose-a-drawing.png", "id": "28888794317428669", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_28888794354095332_4847343219987343247_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7vHg9LOtp0Q7kNvwGhol3N&_nc_oc=AdpgaQGXFXPRvWa46tQc7yPiXHxUB2RDJCVqZ03JizLIFCYYMdIA20rzXpjxJakmE4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXnPJIL4Vpeu-ycpSZf1fPulX0lxtr_ucGyvt8oK21Lkg&oe=6B0F16E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step into your drawing", "keywords": ["drawing", "kids", "family", "art", "creative"], "long_description": "Every child's drawing is a world. Now you can step into it.\n\nIt starts on paper: your child draws with pencils, markers or crayons. When the drawing is finished, take a photo with your phone. Step into your drawing turns it into a world you can walk around in on Meta Quest. Not a template, but the drawing itself: your child's lines, colors and characters stay recognizably theirs \u2014 all around you.\n\n\u2022 Made from a real drawing on paper\n\u2022 Each world can come with a short story about the drawing\n\u2022 Comfortable: teleport, seated or standing, an easy way out at any time\n\u2022 Parents stay in charge: purchases and settings behind a parent lock\n\u2022 A private family gallery. No public sharing, no ads, no microphone\n\u2022 Data kept to a minimum. We don't use your drawings to train our own AI. Delete everything with one button\n\nYour first world is free. Extra worlds are available in the app.\n\nMade with AI: the world and the story are created with AI, based on your child's drawing. Every world shows a small \"made with AI\" mark.\n\nFor ages 13 and up: a parent or another person aged 13+ sets it up, buys worlds and wears the headset. Children aged 10\u201312 only use the headset with a parent's guidance. Children under 10 don't use the headset \u2014 they watch along on a phone, tablet or TV.\n\nCreated from Kindertekening, a project that brings drawings to life for children in hospital.\n", "short_description": "Kids draw on paper \u2014 you step inside. Snap a photo of your child's finished drawing and walk around in it on Meta Quest \u2014 their sun, th
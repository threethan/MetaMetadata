_nc_oc=AdowlCqYekYkPgCLvBFxUlg00m2itWHJWuJEnpO3Rgn8n5rgnDp1LpegN59_OcRHdw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWkPoqE7VicMLb7ZGLaKB86Of4gqt50k9A0NQpM5aEQPA&oe=6B0EEEEC"}]}, "id": "1160850723171113", "locale": "en_US", "screenshots": [{"file_name": "01-gallery.png", "id": "2332495147660204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_2332495150993537_7798416971394379886_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOFQqe26d8AQ7kNvwFVReW2&_nc_oc=Ado854WrizD_9Hani1Q96tNsCN9LTZwaZfe_qofhuDVAA4wnznpRXfe9g1SntMeyuuA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqZtHUhRaO_khdoptcnmSSQYdz9w_zZppqabcTJAmgYA&oe=6B0F1CB4"}, {"file_name": "05-into-space-hands.png", "id": "1682262666634944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831279_1682262673301610_7161924317640034039_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMMKHpFhhnYQ7kNvwGrxb4P&_nc_oc=AdoNOXHEiP-_v0izL0kQaQ3H60ZEd2kBp1IV13o2LuMbbnhUzxb4HhY3uZYIaW_I40M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV61sSyHQ5DEBNbZo4_tNHuv8UjYSFhRTxvauINn9EQSw&oe=6B0EFF3D"}, {"file_name": "03-party-more-figures.png", "id": "1484920393545198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303976_1484920396878531_6057458867668122835_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0_dWNMxFjAQ7kNvwHZxoew&_nc_oc=Adrj1hm3zTxTey-BVzstZBT4WSn7prQXA6KSLb_odM4aV_ayvNXt_fh7H9syV7ktHFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvbt_zyjqrzY_1Vxr5TmEkPzhIPMonAP28ZfevrR5lVg&oe=6B0F1A78"}, {"file_name": "04-fairyland.png", "id": "1151609184230559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308026_1151609187563892_6464634565650914453_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vlg3RZUlRHMQ7kNvwFfOG2v&_nc_oc=AdrpSGOUIj70VjDiBG2GZnroBMZ4sL2AyQrxQhLvpLyhYfu_P_rlrMnoUOwfRFmObGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWg-VUrAJRYvDjwOcAXL2XAny_KCe8H1wk36WBzvnBiEA&oe=6B0EF3FB"}, {"file_name": "06-nature.png", "id": "1601301291278830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/787089464_1601301294612163_3802152754380402570_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGKOtR6wFiwQ7kNvwHlpfMt&_nc_oc=Adqhih0icGdMK2gNSVd_OxvHYEuYwYTKO1McvSLBx9sWGQts4dfhHVPNJKBdoCnCfH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVnGOWqYMfN0pSR0L0agZ2-6qC8v7AAAOkzUzcWEtSN4Q&oe=6B0F1A20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-2560x1440.png", "id": "1921896102593335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1921896105926668_3639972138206611821_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuSzWtHKmMwQ7kNvwE29vIm&_nc_oc=AdqbiDlsyqI9pUTCCZCFo_U3OBqCt3wLr6_qPv44CEbg3kjEJhQCQaTwC6nyFCGTL94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWq3zUk2O3jTH6e7LTE7jH1_aWyJ_zk9JmXL6QnCh8Igg&oe=6B0EEC95"}, "display_name": "Step into your drawing", "keywords": ["drawing", "kids", "family", "art", "creative"], "long_description": "Every child's drawing is a world. Now you can step into it.\n\nIt starts on paper: your child draws with pencils, markers or crayons. When the drawing is finished, take a photo with your phone. Step into your drawing turns it into a world you can walk around in on Meta Quest. Not a template, but the drawing itself: your child's lines, colors and characters stay recognizably theirs \u2014 all around you.\n\n\u2022 Made from a real drawing on paper\n\u2022 Each world can come with a short story about the drawing\n\u2022 Comfortable: teleport, seated or standing, an easy way out at any time\n\u2022 Parents stay in charge: purchases and settings behind a parent lock\n\u2022 A private family gallery. No public sharing, no ads, no microphone\n\u2022 Data kept to a minimum. We don't use your drawings to train our own AI. Delete everything with one button\n\nYour first world is free. Extra worlds are available in the app.\n\nMade with AI: the world and the story are created with AI, based on your child's drawing. Every world shows a small \"made with AI\" mark.\n\nFor ages 13 and up: a parent or another person aged 13+ sets it up, buys worlds and wears the headset. Children aged 10\u201312 only use the headset with a parent's guidance. Children under 10 don't use the headset \u2014 they watch along on a phone, tablet or TV.\n\nCreated from Kindertekening, a project that brings drawings to life for children in hospital.\n", "short_description": "Kids draw on paper \u2014 you step inside. Snap a photo of your child's finished drawing and walk around in it on Meta Quest \u2014 their sun, their house, their world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stepintoyourdrawing.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "NIMCO Studios", "support_website_url": "https://stepintoyourdrawing.com/support", "website_url": "https://stepintoyourdrawing.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1396190100246760"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_1154334353777744_6654046576373260363_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A83JcDlMDNIQ7kNvwFGCjDQ&_nc_oc=AdpNEuUHlVaNVUncsY2p_8SxZPuvjnk8QWRWsgzUAJS8kpS2PwAZlSnRFkkLNyBVJZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdMrO9oZBDk59S7M_HN9xiIBHZdr0nX3xSI_aBU_qgBw&oe=6B0F0BC2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Step into your drawing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1795759860, "lastRevision": {"nodes": [{"id": "1332391766626594", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1332391743293263", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "28939517785660290"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2285330808900153", "locale": "nl_NL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step into your drawing", "keywords": ["kind", "tekenen", "tekening", "kunst", "familie"], "long_description": "Elke kindertekening is een wereld. Nu kun je erin stappen.\n\nHet begint op papier: je kind tekent met potloden, stiften of krijt. Is de tekening klaar? Maak er met je telefoon een foto van. Step into your drawing maakt er een wereld van waarin je rondloopt op de Meta Quest. Geen sjabloon, maar de tekening zelf: de lijnen, kleuren en figuurtjes van je kind blijven herkenbaar van hen \u2014 overal om je heen.\n\n\u2022 Gemaakt van een echte tekening op papier\n\u2022 Bij elke wereld kan een kort verhaaltje horen over de tekening\n\u2022 Comfortabel: teleporteren, zittend of staand, altijd makkelijk eruit\n\u2022 Ouders houden de regie: kopen en instellingen achter een ouderslot\n\u2022 Een priv\u00e9 gezinsgalerij. Niets openbaar, geen advertenties, geen microfoon\n\u2022 We bewaren zo min mogelijk. Wij gebruiken jullie tekeningen niet om eigen AI te trainen. Alles wissen met \u00e9\u00e9n knop\n\nJe eerste wereld is gratis. Extra werelden koop je in de app.\n\nGemaakt met AI: de wereld en het verhaaltje worden met AI gemaakt op basis van de tekening van je kind. Op elke wereld zie je een klein teken \"gemaakt met AI\".\n\nVoor 13 jaar en ouder: een ouder of iemand anders van 13+ stelt de app in, koopt werelden en zet de bril op. Kinderen van 10\u201312 gebruiken de bril alleen onder begeleiding van een ouder. Kinderen onder de 10 zetten de bril niet op \u2014 zij kijken mee op een telefoon, tablet of tv.\n\nOntstaan uit Kindertekening, een project dat tekeningen tot leven brengt voor kinderen in het ziekenhuis.\n", "short_description": "Je kind tekent op papier, jij stapt erin. Maak een foto van de tekening als die klaar is en loop erin rond op de Meta Quest \u2014 hun zon, hun huis, hun wereld."}, {"images": {"nodes": [{"file_name": "cover-hero-3000x900.png", "id": "3198251857036424", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_3198251860369757_869126857453246582_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPWqsMoTXfYQ7kNvwHNB4h_&_nc_oc=Adp18Lx-kueiEzDm8qvNCefRPz6jRW5RlH7vwM0qcg0AA2qXhxNqGZ6nwXqnK7sLHwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUQ15RSQT_qdUV2p_wvtNwUjlfe6_WZS4W0Z4AQ_mV8eA&oe=6B0F08F5"}, {"file_name": "logo-zon-transparant.png", "id": "1805283200685343", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1805283207352009_5801278100215942723_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKmyrshNWZAQ7kNvwEoi3aO&_nc_oc=AdqU--JjpS9GiZI2DZddr9GZEL6war3D-CpL-kiMlKomSyE8ZdGP7kEk
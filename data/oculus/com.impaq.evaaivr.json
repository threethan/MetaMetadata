8_6140531119969108121_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKKh3IpYJNYQ7kNvwG3Xw-6&_nc_oc=Adrzr9VgvkTQLOgRKVpDBys2Iz8WVmbdN_VT34fZZRxzKq4rtZCAuLpJuSWphW_dFks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKdx_3DD4IuNM0943i1smhvGiW-n-R5vpb770mfEJbEw&oe=6AC11CD9"}, {"file_name": "IMG_5696.png", "id": "689527310168885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_689527313502218_8993669588941917448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTp3SV0L7o0Q7kNvwG7bU4K&_nc_oc=AdqyqueF8dlhhd9hvX_QVuQdz02c_paV-Ztl_QD3Fup5JUXz_LE8ivVdi5Q9D9TnQTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeXiAby9PZqy99ZSMiR_Z-16qywPt3Hok73-Xvat6j9w&oe=6AC10833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473393228_1349603712877823_2117815253901809382_n.png", "id": "641918998454317", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392000_641919005120983_7402817797120560677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMw3zDKlowMQ7kNvwE4BI8c&_nc_oc=Adrlw7O4jnIJtv3jn4qjtC0u8nOXgEaWZaBLpPY0ybWmldgGSY0EDzIz5grD2E-qZZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC1ua0f5-SOytOdD_Tagni1aJrDIkgjH4a3T7n8PsbPw&oe=6AC1223D"}, "display_name": "EvaAI: Psychotherapy \u2013 Early Access!", "keywords": [], "long_description": "Early Access! Whether you're feeling down, celebrating a win, facing tough choices, or just looking for someone to talk to, Eva is here for you. She\u2019ll support you, help you deeply explore the patterns of your thinking, and guide you toward changing behaviors so you can navigate everyday life more effectively.\n\nYou can talk about your life anytime, anywhere. There\u2019s no need to worry about how you look or sound\u2014Eva accepts you exactly as you are. With Eva, you can be anyone you want to be. Our app follows a strict privacy policy, giving you a completely anonymous, judgment-free, yet supportive space to share your thoughts.\n\nPowered by artificial intelligence, Eva helps you organize your thoughts during conversations and identify actionable steps to tackle your challenges. Even if nothing\u2019s bothering you, you can still enjoy insightful chats with Eva, reflecting on topics that interest you. She\u2019s always there, offering a moment of calm and clarity.\n\nThis is your time to truly relax and shift your focus away from daily stresses. Through this process, you\u2019ll find your inner peace.\n\nPlus, discover fascinating insights about psychotherapy, VR therapy, brain function, and human psychology.\n\nEvaAI gives you the tools to explore yourself from new angles, relax, and build vital stress-management skills for everyday life. Get stronger!\n\nTake a step toward mental clarity, self-discovery, and a healthier life - start a test session with Eva.", "short_description": "EvaAI is a CBT-powered virtual therapist designed to support and guide YOU through life\u2019s challenges. Available anytime, anywhere, Eva offers private, judgment-free conversations to help you organize your thoughts, explore emotions, and build healthier habits. With stress-management tools and insightful resources, Eva is here to help you find clarity and balance. Start your journey now. Prices starts from $0!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://evaai.health/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Impaq LLC FZ", "support_website_url": null, "website_url": "https://www.impaq.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
21_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVaxbqRdxQcQ7kNvwHNnQEP&_nc_oc=AdovF7EWSt1t7fQgKoaP61adhufPk_otn9pVXHYgH5BYstIDz_GG08_UbxDN7sAgMOo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57va5JH96Gh-YJvMsjwOkYcJhQ_gIoBu9yOEybCOhhNA&oe=6A01F359"}, {"file_name": "IMG_5696.png", "id": "689527310168885", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391952_689527313502218_8993669588941917448_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFFlC797RmIQ7kNvwHppc48&_nc_oc=AdqLUIT-Mq-Y_oIIkrHs1mmioAcYlbHuj3m3cUA00WXJUTXiGGB44YuU4agqfEz4EyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5krQ1SIxEGSP58q2h1dotl-Nyt75tt7pjv8ngbTfh3vQ&oe=6A01DEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440 (2ver).png", "id": "1159679369464387", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1159679372797720_756815148343397171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZsxJ-V95vAQ7kNvwHODNGF&_nc_oc=AdojVgKwmwkuq-HaMzKu0RUdw9Bp7JnTOKNNalHeyY4cmDd5m6eo_Xzi6nhraYcaF_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b1ax9tWRT7CSD26bIm39JnvHRInW42w20YYILb0CjEQ&oe=6A01C1FB"}, "display_name": "EvaAI: Not a Psychotherapist in VR", "keywords": ["meditation", "wellness", "AI"], "long_description": "Early access! You can discuss all your most intimate, complex, or frightening thoughts with an anonymous and supportive companion who won't judge or gossip. This app is your partner in exploring your personality and leveling it up.\n\nEvaAI\u2019s VR experience simulates the conversational flow of a therapy session, providing evidence-based stress-management techniques; this does not replace consultation with a licensed mental-health professional. EvaAI offers VR-facilitated coaching, not licensed therapy.", "short_description": "Early access! You can discuss all your most intimate, complex, or frightening thoughts with an anonymous and supporti
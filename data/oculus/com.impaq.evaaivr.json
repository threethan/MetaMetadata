://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593749142_1663813651505328_1033669020522861862_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SERDBxeXdRMQ7kNvwH3PtNW&_nc_oc=Ado8hKCtIdXB6SXNRlYDCMK3lF52ij1SXl4IHwtk-OD5FgxBDNBhDP-_90KLt7xtYyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWwBcpsnKm4V1ihftyYmCOM9rKbRKAuvtd-tPxnkM9xg&oe=6AC114EC"}, {"file_name": "Screenshot 2026-06-10 17-19-27.png", "id": "1269764384997687", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312439_1269764388331020_4405846602110591679_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eF4eOFNNA3EQ7kNvwHrTSbU&_nc_oc=AdoxNctLuoSbWW-ey5Tnd3omqN5anVotFAX47GSEDSRVXqhpceXRdECy1OcYf-c2ibM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAbOmOjbQDGYdQXpKI35z09SPI8xjFXv_jewX7qFsC5w&oe=6AC1320E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440 (2ver).png", "id": "1159679369464387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819854_1159679372797720_756815148343397171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p17ihU8bYlUQ7kNvwHU7EMQ&_nc_oc=Adr-RkxLIlwI-h4ZY_uC_H4AxKI_63Hw8No5LWYcidqFXT9RYxWzp8_kTebKrQ_2MqY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlS5O0k76mCYdeD7P2msPELXsJjw52EGOUD4azBDCUkQ&oe=6AC123BB"}, "display_name": "EvaAI: Talk to AI Companion Find Clarity", "keywords": ["meditation", "wellness", "AI", "Companion", "Emotional"], "long_description": "# \ud83d\udd0d REFLECT ON EXPERIENCES\n\nWhy do you keep repeating the same patterns? Dive deep into your daily life to uncover the roots behind your habits and emotions. Still wondering why you feel the way you do? Reflect. Customize. Find clarity. \u2192 Start with Eva \u2014 free\n\n{1667828694441095}\n\n# \ud83e\udde9 MAP YOUR PATTERNS\n\nUntangle your complex thoughts and clearly map out the behavioral patterns driving your actions. \n\n {1784234882958499}\n\n# \ud83e\uddd8 FIND LASTING PEACE\n\nTurn your self-awareness into actionable steps to achieve true and lasting peace of mind.\n\n{1115983327546899}\n\nEvaAI\u2019s VR experience simulates the conversational flow of a therapy session, providing evidence-based stress-management techniques; this does not replace consultation with a licensed mental-health professional. EvaAI offers VR-facilitated coaching, not licensed therapy.\n", "short_description": "YOUR AI  FRIEND  FOR DAILY REFLECTIION IN VR \nUNDERSTAND THE \"WHY\" BEHIND YOUR ACTIONS\n \nEvery habit has a root, and every emotion has a pattern. EvaAI is your dedicated VR environment for uncovering them. Step into a private VR space to untangle your complex thoughts with a supportive, non-judgmental companion in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://evaai.health/privacy-policy/", "developer_terms_of_service_url": "https://evaai.health/terms-conditions/", "publisher_name": "Impaq LLC FZ", "support_website_url": "https://yevia.co/", "website_url": "https://evaai.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28453221070941599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_1323528089463915_758192965692748746_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&
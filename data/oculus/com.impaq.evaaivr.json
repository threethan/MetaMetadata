4JRt52Od4nfiSWL4SNWkGMjzw&oe=6A105F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473393228_1349603712877823_2117815253901809382_n.png", "id": "641918998454317", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392000_641919005120983_7402817797120560677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIFOm0v4UtgQ7kNvwEmE03L&_nc_oc=AdreZM152u--f57Dta8q_iDrdva7-Hjaptx4aQhogAXVAkiesAUAHlgziElvLJWh18U&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CRH1jkdGgWh_GOhiGIvsyZN7-9D_MC0lKIuOU6p7_7A&oe=6A10793D"}, "display_name": "EvaAI: Psychotherapy \u2013 Early Access!", "keywords": [], "long_description": "Early Access! Whether you're feeling down, celebrating a win, facing tough choices, or just looking for someone to talk to, Eva is here for you. She\u2019ll support you, help you deeply explore the patterns of your thinking, and guide you toward changing behaviors so you can navigate everyday life more effectively.\n\nYou can talk about your life anytime, anywhere. There\u2019s no need to worry about how you look or sound\u2014Eva accepts you exactly as you are. With Eva, you can be anyone you want to be. Our app follows a strict privacy policy, giving you a completely anonymous, judgment-free, yet supportive space to share your thoughts.\n\nPowered by artificial intelligence, Eva helps you organize your thoughts during conversations and identify actionable steps to tackle your challenges. Even if nothing\u2019s bothering you, you can still enjoy insightful chats with Eva, reflecting on topics that interest you. She\u2019s always there, offering a moment of calm and clarity.\n\nThis is your time to truly relax and shift your focus away from daily stresses. Through this process, you\u2019ll find your inner peace.\n\nPlus, discover fascinating insights about psychotherapy, VR therapy, brain function, and human psychology.\n\nEvaAI gives you the tools to explore yourself from new angles, relax, and build vital stress-management skills for everyday life. Get stronger!\n\nTake a step toward mental clarity, self-discovery, and a healthier life - start a test session with Eva.", "short_description": "EvaAI is a CBT-powered virtual therapist designed to support and guide YOU through life\u2019s challenges. Available anytime, anywhere, Eva offers private, judgment-free conversations to help you organize your thoughts, explore emotions, and build healthier habits. With stress-management tools and insightful resources, Eva is here to help you find clarity and balance. Start your journey now. Prices starts from $0!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://evaai.health/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Impaq LLC FZ", "support_website_url": null, "website_url": "https://www.impaq.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9914155658608088"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1264684581691457"}, {"status": "PUBLISHED", "id": "2202214970181041"}]}, "baseline_offer": {"id": "1264684581691457"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751359320, "status": "PUBLISHED", "id": "1264684581691457"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27390199210577129", "version": "0.5.8"}, "id": "1636649730337631", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9914155648608089", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27390199210577129"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1636649730337631"}]}, "change_log": "Version 0.5.8\n- CBT Triangle is now called with button press instead of auto-popup\n- Fixed bugs related to UI controls and audio controls\n- Updated UI in new modules: Settings and Insight History\n", "created_date": 1778851998, "id": "27390199210577129", "version": "0.5.8", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9914155648608089", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27390199210577129"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1778842973, "id": "27388595207404196", "version": "0.5.8", "version_code": 58, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9914155648608089", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27390199210577129"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1636649730337631"}]}, "change_log": "What\u2019s new:\n\u2022 Improved Eva\u2019s memory \u2014 Eva now remembers previous sessions more reliably, helping conversations feel more continuous and personal.\n\u2022 Upgraded Eva\u2019s conversation system \u2014 we improved the core experience, updated internal protocols, and moved to newer models to make conversations feel more stable, natural, and context-aware.\n\u2022 Added Session History \u2014 you can now review past sessions by date and revisit their insights.\n\u2022 Added new avatars and a new environment \u2014 more ways to personalize your VR experience.\n\u2022 Added a new Settings menu \u2014 manage background music, choose your avatar, switch environments, and change your conversation language in one place.\n\u2022 Updated Eva\u2019s voice system \u2014 Eva now has a new voice for a smoother and more natural conversation experience.", "created_date": 1778509906, "id": "27337066672557050", "version": "0.5.7", "version_code": 57, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9914155648608089", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27390199210577129"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1777623865, "id": "27218040664459652", "version": "0.5.4", "version_code": 55, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": 
v/t64.5771-25/38974560_287960923016542_4239528364866348391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6HKN28ydBUQ7kNvwHVtsKi&_nc_oc=Ado_rs0NF37pXlIkO8811DEUfcfu9nNxYCv_riuvWhwABJa8O6Uo0ru473WLRu1Yvbg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbXwDP2JLn2L4hdQ0xi1ekStBD4PB_mS-L24IPJ084OA&oe=6AFB3B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusLabs_CoverImage.png", "id": "292382419225781", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572943_292382422559114_5503116956755119952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fKr1OyYsngQ7kNvwF0NRMW&_nc_oc=AdpLu0ESj92Cx96xkcRdfgk3wgBq-RSa8Lgs0LjDz-8cNk2xhNsLYjXGQEmsYhii2gA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ2S6GxDFQXmM6nWQzFqha_tm8r1MFveEqlmzHV0F4hA&oe=6AFB1F45"}, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs gives students access to a state-of-the-art laboratory or workshop. It also makes it possible to make concrete learning situations by offering an immersive, interactive, and realistic environment. Proteus Labs can be accessed from anywhere, making it perfect for online teaching or isolated students. The multi-person option makes teacher coaching possible and easy.\n\n \nOur activities promote the development of the skills targeted by the curriculum of various disciplines. Certain elements of the content can be modified according to the teacher\u2019s choice. The results obtained are as valid and varied as in reality.", "short_description": "Simulate chemistry, physics and biology classes through Proteus Labs! Endorsed and validated by teachers and used in schools across the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proteus-vr.com/wp-content/uploads/2021/06/apps-privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Proteus VR", "support_website_url": null, "
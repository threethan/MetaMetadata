v/t64.5771-25/38974560_287960923016542_4239528364866348391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fh-06QKnAkQ7kNvwHQGbnH&_nc_oc=AdomPYx9p4gjH9KboVCRDSbEmt0yRf6S2VwWhZ24ZI_oB41ito_uyDteaKigXLNUTTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfX4l4xXtMWJKl3EL5ZQm9-acYVuBy63jZvj-MCHFsAA&oe=6B0DB05E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusLabs_CoverImage.png", "id": "292382419225781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572943_292382422559114_5503116956755119952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KexCNwypgQQQ7kNvwHuhtna&_nc_oc=AdoaDF93lIPo47fCh6jAukkd5fpCd2O9hC8W-45YR4LmbqqW1-Kt9U9DyFFM-yMwB8I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQa0C4BN_By6lF_82oyYfyVhP1Jx9i4pOVqoi-p9gPf_Q&oe=6B0DCC85"}, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs gives students access to a state-of-the-art laboratory or workshop. It also makes it possible to make concrete learning situations by offering an immersive, interactive, and realistic environment. Proteus Labs can be accessed from anywhere, making it perfect for online teaching or isolated students. The multi-person option makes teacher coaching possible and easy.\n\n \nOur activities promote the development of the skills targeted by the curriculum of various disciplines. Certain elements of the content can be modified according to the teacher\u2019s choice. The results obtained are as valid and varied as in reality.", "short_description": "Simulate chemistry, physics and biology classes through Proteus Labs! Endorsed and validated by teachers and used in schools across the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proteus-vr.com/wp-content/uploads/2021/06/apps-privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Proteus VR", "support_website_url": null, "
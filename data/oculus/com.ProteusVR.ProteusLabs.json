7_1114973930782644_5334310797836009658_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPRcAscp8akQ7kNvwHk3v-M&_nc_oc=AdoptFJ93iZrcp4pCmpjlqR5dK7nAtUU5w-yjzjwWYHA5uzuEU96w8-lG88JZeVC78A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOEDjEL3iAiXJEjU8j9vwEj0TXvK1HFW62WorLiOgYUg&oe=6B106346"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Proteus Labs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1628547955, "lastRevision": {"nodes": [{"id": "4239692762748777", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4083148155131756", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "335169871381883"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1000359420709594", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs permet aux \u00e9tudiants d\u2019avoir acc\u00e8s \u00e0 un laboratoire ou un atelier \u00e0 la fine pointe de la technologie. Il permet aussi de rendre les situations d\u2019apprentissage concr\u00e8tes en offrant un environnement immersif, interactif et r\u00e9aliste. Proteus Labs peut \u00eatre accessible de partout ce qui le rend parfait pour l\u2019enseignement \u00e0 distance ou pour les \u00e9tudiants isol\u00e9s. L\u2019option multi-personnes rend l\u2019accompagnement par l\u2019enseignant possible et facile.\n\nNos activit\u00e9s favorisent le d\u00e9veloppement des comp\u00e9tences vis\u00e9es par les curriculums des diff\u00e9rentes disciplines. Certains \u00e9l\u00e9ments du contenu peuvent \u00eatre modifi\u00e9s en fonction du choix de l\u2019enseignant. Les r\u00e9sultats obtenus sont valides et vari\u00e9s comme dans la r\u00e9alit\u00e9.", "short_description": "Simulez la chimie, la physique et la biologie avec les Proteus Labs! Endoss\u00e9 et valid\u00e9 par des professeurs dans des \u00e9coles \u00e0 travers le monde!"}, {"images": {"nodes": [{"file_name": "ProteusLabs_Icon.png", "id": "4381960035161134", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429295_4381960038494467_1732173401242729257_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9c6lYJLwI4Q7kNvwHJjjzV&_nc_oc=Ado8gotaCLRGXd-JOP403RzuXNtIttndTpMMvDBmD0iWXExAjD8-kkK33AE9rFqZsOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVAcDNaeev7WfVSrGIYbXaTbIYtu8tL8QR7p5VzSlatg&oe=6B106286"}, {"file_name": "ProteusLabs_1080x360.png", "id": "3006749922878727", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203619_3006749926212060_8851401734746462968_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x_Z1mMDbEMQ7kNvwFX5t9h&_nc_oc=AdoLHQKXwK6kItzKITvLo7H2ar2Q76R4CU3zfUZgcwvfoovTa_d9BntiQSxeAn7BIck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYYZl028dzQ1dfOQVZGnBuacj3oMxGUj8aUETyrA5DWw&oe=6B105FBC"}, {"file_name": "ProteusLabs_Logo_2560x1440.png", "id": "1467295343624364", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_1467295346957697_7388907762043359903_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aFVl8ovGDcQ7kNvwFedlDO&_nc_oc=AdrndB0WxuqqKg2z_nQ9hHNHsX1L3Da0IyiNy4GeuIy5yB0rofOxlwQFkvwUr8L6aGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhSv7I2BioNGbT9RvW-0NZ-FjO2ocNuqUdHyVNbbWLZQ&oe=6B103656"}, {"file_name": "ProteusLabs_1440x1440.png", "id": "493816628618311", "image
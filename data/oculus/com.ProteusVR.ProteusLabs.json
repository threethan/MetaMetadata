v/t64.5771-25/38974560_287960923016542_4239528364866348391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz6AdHSr26sQ7kNvwGBWM6v&_nc_oc=Ado6BQhGJmjXTtR5LfFkQUfDvCu4cRJkcHt32WQgwxMScL7jcx5F8545crz9xgQvfUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfaZm3GXrqojf6vckZIOqGBQIJ6iDF-ULuzIzsq1_lXA&oe=6B05C75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusLabs_CoverImage.png", "id": "292382419225781", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572943_292382422559114_5503116956755119952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kbDPsmPryYQ7kNvwHtPVW6&_nc_oc=AdrND-RMtMQ1LX4kEJDOtoHAJAHwswi8zL0xH1dz6VSgtFkza3IHCpq-_NrkWNKwSyM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAEgmDu7mj63-xtkCoPC0jg5WyGB-f8va0VTIjBdlb7A&oe=6B05AB45"}, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs gives students access to a state-of-the-art laboratory or workshop. It also makes it possible to make concrete learning situations by offering an immersive, interactive, and realistic environment. Proteus Labs can be accessed from anywhere, making it perfect for online teaching or isolated students. The multi-person option makes teacher coaching possible and easy.\n\n \nOur activities promote the development of the skills targeted by the curriculum of various disciplines. Certain elements of the content can be modified according to the teacher\u2019s choice. The results obtained are as valid and varied as in reality.", "short_description": "Simulate chemistry, physics and biology classes through Proteus Labs! Endorsed and validated by teachers and used in schools across the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proteus-vr.com/wp-content/uploads/2021/06/apps-privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Proteus VR", "support_website_url": null, "
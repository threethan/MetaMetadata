7_1114973930782644_5334310797836009658_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suPdR0idZHsQ7kNvwHVWasi&_nc_oc=AdrxqNaAnxzEnHj7GCtizClvepM86To50xPfmYBnymwPfyBqph1_8ITcUI69j6_vC_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIkio1Eq3UK86gfe9SMdOBeVv_9V_pHbB-klMKN9SkyA&oe=6B0485C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Proteus Labs", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1628547955, "lastRevision": {"nodes": [{"id": "4239692762748777", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4083148155131756", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "335169871381883"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1000359420709594", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs permet aux \u00e9tudiants d\u2019avoir acc\u00e8s \u00e0 un laboratoire ou un atelier \u00e0 la fine pointe de la technologie. Il permet aussi de rendre les situations d\u2019apprentissage concr\u00e8tes en offrant un environnement immersif, interactif et r\u00e9aliste. Proteus Labs peut \u00eatre accessible de partout ce qui le rend parfait pour l\u2019enseignement \u00e0 distance ou pour les \u00e9tudiants isol\u00e9s. L\u2019option multi-personnes rend l\u2019accompagnement par l\u2019enseignant possible et facile.\n\nNos activit\u00e9s favorisent le d\u00e9veloppement des comp\u00e9tences vis\u00e9es par les curriculums des diff\u00e9rentes disciplines. Certains \u00e9l\u00e9ments du contenu peuvent \u00eatre modifi\u00e9s en fonction du choix de l\u2019enseignant. Les r\u00e9sultats obtenus sont valides et vari\u00e9s comme dans la r\u00e9alit\u00e9.", "short_description": "Simulez la chimie, la physique et la biologie avec les Proteus Labs! Endoss\u00e9 et valid\u00e9 par des professeurs dans des \u00e9coles \u00e0 travers le monde!"}, {"images": {"nodes": [{"file_name": "ProteusLabs_Icon.png", "id": "4381960035161134", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429295_4381960038494467_1732173401242729257_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBvW3EagcT0Q7kNvwGEoLeN&_nc_oc=Adp5M-KGYg3N8kpu0jVO0eFecKugXRjgqTgyKQb_Tajk9w1f7i9Wd6ADotuR2Q39L8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3CJkk9tP8rJrAMbotsUtQqS9CTH7fJC0ZsZpUImr_CQ&oe=6B048506"}, {"file_name": "ProteusLabs_1080x360.png", "id": "3006749922878727", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203619_3006749926212060_8851401734746462968_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdPacPaMjN4Q7kNvwG4Douf&_nc_oc=AdptOn6alDpHSclFxOaG7L154zYsLmpv2gpd0VGPJ33QUfCovHyFgY4oOIawFIeXQiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS06igbzK1A_6FsdcSXo4R2qwhqeVHSYAro_9J_l5Likg&oe=6B04823C"}, {"file_name": "ProteusLabs_Logo_2560x1440.png", "id": "1467295343624364", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75203625_1467295346957697_7388907762043359903_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9UT4GLf3AkQ7kNvwHGqyX9&_nc_oc=AdrYOKOawO01Cg_bwu3g8Y7hMGix4h2vtXhDzhPjU-XyruqwYK_u2CAzl2kckyZckOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9wHQ60ffn1wQewPdBOUIXMiVMo2NDpkSCIROcBtaQxQ&oe=6B0458D6"}, {"file_name": "ProteusLabs_1440x1440.png", "id": "493816628618311", "image
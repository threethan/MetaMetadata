v/t64.5771-25/38974560_287960923016542_4239528364866348391_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOOfn-wjC7kQ7kNvwF0FJG7&_nc_oc=AdpjwcW7h8KY4STIbVJ_n-xJa6OsgTfQ1Lkg0LCjIfhoqPdRBiiDXutT302KiKHO27k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKo59KBAm_tcyY62vRizmbf13PUH4_o7HhffNWiwUOMQ&oe=6AFDDE5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusLabs_CoverImage.png", "id": "292382419225781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572943_292382422559114_5503116956755119952_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fKr1OyYsngQ7kNvwFSLivf&_nc_oc=AdrSipqo73IBPKtdCAbhSD_248zLKYoUmqreiSzGToNaUKrjf3Uqew7FQ42bmORxsPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS37mBWrAbSDIlhjcXDhk_h8-d1qU1HIBlf9CmNaiIF2A&oe=6AFDC245"}, "display_name": "Proteus Labs", "keywords": [], "long_description": "Proteus Labs gives students access to a state-of-the-art laboratory or workshop. It also makes it possible to make concrete learning situations by offering an immersive, interactive, and realistic environment. Proteus Labs can be accessed from anywhere, making it perfect for online teaching or isolated students. The multi-person option makes teacher coaching possible and easy.\n\n \nOur activities promote the development of the skills targeted by the curriculum of various disciplines. Certain elements of the content can be modified according to the teacher\u2019s choice. The results obtained are as valid and varied as in reality.", "short_description": "Simulate chemistry, physics and biology classes through Proteus Labs! Endorsed and validated by teachers and used in schools across the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proteus-vr.com/wp-content/uploads/2021/06/apps-privacy-policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Proteus VR", "support_website_url": null, "
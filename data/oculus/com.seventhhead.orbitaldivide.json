CT6YaUJyPK8TybzUKnYz11hTavJA&oe=6AF477BB"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXGX-Pyab70Q7kNvwGqy90s&_nc_oc=AdrlsG1qsfS6yliV4FReljwjG8YdoZGbleQJYH-aBBVsL3FxKjVPWku0fwLiLd5RKsk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9K9HmXnFKmWCxy5Qk6kFK8CkdLuSrgN0A16wPS6OS0A&oe=6AF48E34"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13VlaPfQytIQ7kNvwGEMDhP&_nc_oc=Adqz1_qeUnJi6EB6j4oRtskJo8M3IBH19E8oq4292jC5GULHNaZJJPyiabnq9qgpS5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7viU6Dj_vG5Zz-fjpoPgW-LTZLGYy4DeJA7jsjRg4HQ&oe=6AF48A5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqsqZTReLKsQ7kNvwE4fnNA&_nc_oc=Adp31cEDEgx78vyFMm8t0Fl_Q6FKyjrVw7mCQqzXgKvhcK2pwCGFsrdw5w4669LPMWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1KO2BrJeZFMLwZnPoe7d2gEZbZJRk9w_z5kUxlqMnqQ&oe=6AF49D61"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323504600846102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_27908851432115198_4701551711023765680_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmovb2sWhFsQ7kNvwG_kSpz&_nc_oc=Adps4l7wYW4Sq9LxnlDLAt3bCn2uiHUjx8GtBtHZyeNVTMdEm3dxYv8HCoj-S0TtBnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb
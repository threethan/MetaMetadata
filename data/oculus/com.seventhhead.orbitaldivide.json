https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWLNHthnl-oQ7kNvwEV8ZMP&_nc_oc=Adob_dlAo9KzmWEWpt1Bi_WMS6m3Xt_YCI8DS580Byj4bVrmzTXuTloxJhwQcqGlaXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSedRGdDDk5mmvr8-ByxttfLeeS_PNO2M8J1Pq-QizjRA&oe=6AFF165C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "co
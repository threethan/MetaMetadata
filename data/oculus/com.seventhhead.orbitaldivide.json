.oculuscdn.com/v/t64.5771-25/491823279_2023823921576323_6576770721604090318_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbf1SRxwxLYQ7kNvwFVmIPW&_nc_oc=AdqiW19kEoOOrf-a8BsPVLFSd6W0nL8lZhELKyi-KWY9TcfKbkC8_rMuYpI_81j-yPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYY9V_AwEVLA6Wa4d18oZAH9SMM0kiagnELInssOo2Pg&oe=6B0C6AFB"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlSLABlVfSQQ7kNvwEaHIeb&_nc_oc=AdoYemahAzezsHkqrJJn5GhnxsAo7aUIbGVCJrawp6JbaYrtr4RIrB4F35Q6ABwYO2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQUYsPGNQS0cb-_PCfzztRKh4LwXH3nIxizguIAXp8gLw&oe=6B0C8174"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HzBtVZ7L50Q7kNvwEN3jI9&_nc_oc=AdpAAb2NjZICcpMUvodZmwy9dGhUcz-ZMofG7fWagRsx4-0CBh5xzFGHjGKNJnPqTD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUhBwQaxsa8Hg9SSIWOiqpzPTyiM5EyO60AaCUNiMxUw&oe=6B0C7D9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfITHdBwGqQQ7kNvwEiAf-U&_nc_oc=Adq6TKxEYw8xND0lTapd0A6PLGl5jcETqP7_h9P2GrxR43h9R6OyJreaWPn1D8FrcuY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRmHfB4bgoplAZWHbcmWKPn6xCwSp-KTTWZHVCZIngnZw&oe=6B0C5861"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323504600846102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_27908851432115198_4701551711023765680_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw3Kfj_UbgMQ7kNvwEjDgTj&_nc_oc=AdqQ3ZQzS0lrl8StxHMZuZOHWBAOSTZjx4NbhHtDRAZCaYOpQQbyuOrITqX1EFG6XIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFXX3ZHD-WqAErdhFKDtO_BaYU6_ksEHpreovkJQ9DUA&oe=6B0C820D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Orbital Divide", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1791565200, "lastRevision": {"nodes": [{"id": "1299854249877804", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1299854236544472", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1826293995200910"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "OrbitalDivide_Meta_Cover_Square_1440x1440.png", "id": "27908851422115199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_27908851432115198_4701551711023765680_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw3Kfj_UbgMQ7kNvwEjDgTj&_nc_oc=AdqQ3ZQzS0lrl8StxHMZuZOHWBAOSTZjx4NbhHtDRAZCaYOpQQbyuOrITqX1EFG6XIo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLHdCaDzBxT2twxZCox_ltoSkqEAto5jZfOTtOy176NQ&oe=6B0C820D"}, {"file_name": "xOrbitalDivide_Meta_Cover_Landscape_2560x1440.png", "id": "2272553533582206", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2272553536915539_75023
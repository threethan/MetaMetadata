.oculuscdn.com/v/t64.5771-25/491823279_2023823921576323_6576770721604090318_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRG3r7PjdZ8Q7kNvwFrCTH4&_nc_oc=AdolSKnNECvI5m7W5qLFQzVO5sxe0s9ghZ2mNZuihfSLoedBt6Nm23gnAZo91w1kEUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMy4bQCcNLYE_xXYLLV9q7IcpNA0FbLaoY91QWxgBvPA&oe=6B0481FB"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc1T6wk2qxUQ7kNvwHFu6-S&_nc_oc=AdoISYxYQ-QHHFtjVGqkF0jS6ZH3Pw8ULsgVDQ7pnFTnmNR-JHTGU8uFMM_BpbmUQZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnW35vjhVJ6olg3jX0pI-t8PGfys0FL2FVQXdL9Tg8wA&oe=6B046034"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJbnrSBt0EsQ7kNvwE0Pi3d&_nc_oc=AdoOsWRsV3eW9Wnng6sX72_sCl1QDc4SjDRuyBRakV6j9Z-SYPUATcFmtrrAh2sqous&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC6PJveMApAv2Vhj8TFrax1T1v3Q-U0zUh3-DuMR5uAA&oe=6B045C5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29e9SkXaB7kQ7kNvwEPH3vK&_nc_oc=Adqn574otH17p-MuinMhrLkDWghuM32N2DNLvULxPUIovikQcPATQygqMFrZFU-2Gy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThMdQvRBpCIDgI2K50UTaBgtDOWk5a3ARuvnbdiLGQ7Q&oe=6B046F61"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323504600846102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_27908851432115198_4701551711023765680_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R27Oz15IuqkQ7kNvwEc_Gtk&_nc_oc=Ado-T420MaJH3mtcEx_p57EouW7VhTOWKohIE1omLvqD-PYZusfqnhhvL4tZ-XOF3xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgWek51RrG8bKdLtmghC96BS2G8gatnemFpdS7YZDu5A&oe=6B0460CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Orbital Divide", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1791565200, "lastRevision": {"nodes": [{"id": "1299854249877804", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1299854236544472", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1826293995200910"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "OrbitalDivide_Meta_Cover_Square_1440x1440.png", "id": "27908851422115199", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_27908851432115198_4701551711023765680_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R27Oz15IuqkQ7kNvwEc_Gtk&_nc_oc=Ado-T420MaJH3mtcEx_p57EouW7VhTOWKohIE1omLvqD-PYZusfqnhhvL4tZ-XOF3xE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKjPRkm7QOjeXuRRVvJZtNItVWnadXWersDPjY3gTBMA&oe=6B0460CD"}, {"file_name": "xOrbitalDivide_Meta_Cover_Landscape_2560x1440.png", "id": "2272553533582206", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_2272553536915539_75023
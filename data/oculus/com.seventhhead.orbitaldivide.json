.oculuscdn.com/v/t64.5771-25/491823279_2023823921576323_6576770721604090318_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul2sBIJzXXEQ7kNvwFhgOg_&_nc_oc=AdpT-5T-JD-jxFLlEoRN7Fcy-_StHTSL0b_s134sckTRqWRmcEo0FiB6ctwm-WzgOAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVgfXGxzIx38_pgeiP5fnSRZqo7LaDEz8yK69XDYzw4A&oe=6B0F0DFB"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj-21lRdmZAQ7kNvwFt1B2E&_nc_oc=Adp7w_KdrPnmuE9XV9CxaxcZrn04pgNixastg8ctBBjv3W_ecz9ol1a_MnV3Jc6J8Wg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2QQTl-OkAIrhAhLznrFlW4qsdswIp0b_ATO4sFavvwQ&oe=6B0EEC34"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HzBtVZ7L50Q7kNvwEAdCV-&_nc_oc=AdoVbU6Z-iqrIj5ySnPfFOQHvMATqGU64uxO9xkgodJG_PaQLrNybYevZUN-xV8F1Qo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVkeyOGfkGZncC42IxTIHVedPaDp7SNPvjleHc4H-ph_Q&oe=6B0F209C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPSKsvb9-cUQ7kNvwGE_4I0&_nc_oc=AdqbyrZXqugolqy8MesgZ3VfH_e5ALl_CgKXcdQm2CscxFGciuDKm3HnOczwwGb0kXY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWPm2YhxI6fyEv3B96L7hZgJ_9YkIzh6dn1b0tSujhfUQ&oe=6B0EFB61"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323
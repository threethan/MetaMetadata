.oculuscdn.com/v/t64.5771-25/491823279_2023823921576323_6576770721604090318_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rx5jm8PQ5EQ7kNvwHz83YG&_nc_oc=Adq0hfWWkGqH070ylCJFthLeeQD5btz8h_Bz4MSYVbqoUjc30DdhCjO0_2s7M4y7eBg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKNXyz-hOqvXAIJwKDdrquI66C3AYJ4007dRMXzGCTdQ&oe=6B09C7FB"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlSLABlVfSQQ7kNvwEKG5CM&_nc_oc=AdpHGnxAYxX3plaK1qKe1zd3mZitAfJOoWtWZ4KbzDp_tMvmRIv9-721SQrqTDhKxdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPe0aPwqstVe4i6fqsKxFd-1v61jMnNr3KwmDTgYE0CA&oe=6B09A634"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dveqBWtGE4wQ7kNvwEq3cTz&_nc_oc=Adq_MZ9YrlYg4D8aSY56LzzcW2bUcQvs2NmMfNSs2ZOY4tMWjf12DEWA9ngeBsucwyE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpgvzKb15JFLHfzZQ93ZXjK2H5pf-8o2M-JiheV36O-w&oe=6B09A25C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v76UY5eSfwoQ7kNvwFjw-DJ&_nc_oc=AdozO37Fe_Xv8kL7zjFreSOwhtqz6zTNhttHxKtkan54Of3fCCKlrR4M92ckNi7XnHQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnmVBGcJv4P-v986OP32sMacumGx-LppBsSIfbZLJXzw&oe=6B09B561"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323
.oculuscdn.com/v/t64.5771-25/491823279_2023823921576323_6576770721604090318_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-Hblae0Fo8Q7kNvwGaJO7n&_nc_oc=AdojQ9IUO16C1yD_qwr1aq71fsnmSIwg20AsJnjuRs793EfU-p_1NVEJdofFuq5yYJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShMiseeeGsRcGffp5CHL7JBcClDgfMzEaV_C-yRcjrCA&oe=6AFDB23B"}, {"file_name": "04_OrbitalDivide_VR_StillGrowing.png", "id": "1743353463373774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1743353466707107_6086079953947476570_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFlv_aaA3C0Q7kNvwG1KoAK&_nc_oc=AdoOjzijhIqB4bKwJUbfK-kGw2Esu9DldS_7GDw-8jbvyfMINTI4s_7eiRkGcZ8wDjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXwWP61J98BFWDwlpZfjRzThXVsYjWo2uSliRKr9kuAA&oe=6AFDC8B4"}, {"file_name": "03_OrbitalDivide_VR_PauseWindow.png", "id": "1966117547404776", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1966117550738109_2466600132054488806_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWLNHthnl-oQ7kNvwGAIgNV&_nc_oc=AdraA5UYcmZ7SLXSOTapz1gYMe32zj6zn4lD9o8ecj2REPnvxDcNfdsDoVTzlhZnLZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmPM7SzlQd5J1EZ-j6F9_j0LT0gdTA1BuwJZwoOW8G6A&oe=6AFDC4DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "UPLOAD-THIS-Orbital-Divide-Cover-2560x1440.png", "id": "1607317330739494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827987_1607317337406160_992878697367268936_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxKaHUDj2_gQ7kNvwH8oyOp&_nc_oc=AdohvT4vHEUZNyBlprEpxQ9ZSTb065SJ36yYmhPezFvYZg78IgK2uahWj0V_ol_LW34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa1TBDk7Ylj8gNxM4Ss18ImTaMZwoVAAdmJSsgWnvKIQ&oe=6AFDD7E1"}, "display_name": "Orbital Divide", "keywords": ["strategy", "arcade", "retro", "puzzle", "mixedreality"], "long_description": "Divide space. Control the chaos.\n\nOrbital Divide is a neon spatial puzzle game for VR and mixed reality. Build partition walls inside a three-dimensional chamber, claim the required volume, and avoid the moving orbs while each wall is forming.\n\nProgress through 100 handcrafted stages across 10 chapters. Earn up to three stars per stage, improve your rank, and unlock seven distinctive badges. When you want an open-ended challenge, Endless mode keeps the pressure going with adjustable difficulty.\n\nFeatures:\n\n* 100-stage campaign across 10 chapters\n* Endless mode with adjustable difficulty\n* Playable in virtual reality and mixed reality\n* Three-star progression system\n* Seven unlockable ranks and badges\n* Clean retro-neon presentation\n* Focused single-player puzzle gameplay\n{1419490683704744}", "short_description": "Build walls, divide a 3D chamber, and claim space without letting the moving orbs hit your unfinished partition. Master 100 stages or test yourself in Endless mode, in VR or mixed reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1323
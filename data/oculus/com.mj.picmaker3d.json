ppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1424759047391002", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1450302254836681"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1132107522563501"}]}, "change_log": "Startup: the app no longer loads AI model files on the main thread while building the menu. Rendering is never blocked at launch.\r\n\r\nAI models now load in the background. The longest pause between frames during photo conversion is about 6x shorter than in the previous build.\r\n\r\nThe default depth model is now the light, fast one (about 13x smaller than the maximum-quality model). The maximum-quality model (Depth Anything 3) stays available as an opt-in in Menu > AI Generation > Depth model and is explained in the store description.\r\n\r\nThe Meta entitlement check now has a timeout, so a slow or missing platform response can no longer leave the app waiting indefinitely.", "created_date": 1794492267, "id": "1429165753616998", "version": "1.2.3", "version_code": 10203, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
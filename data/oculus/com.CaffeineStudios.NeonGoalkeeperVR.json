ave_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Q1DI6TxqUQ7kNvwGNTUi4&_nc_oc=AdqKeHsI2Q31r-H6W3lOdXCpf7Ha4tYN24BKtPVYlsWeaXorvFvZ5Lk8OPjqSRA3KoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfpiEA0otJ-UqwQtZDl_Acos9K6V9tw2jbJgkPuJGvdg&oe=6B0862F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX9drt9KBRcQ7kNvwHqQLsx&_nc_oc=Adrupi8zse9oY8MStVb93Tom18QAcgP-OM6AoD0UtLT1VrpItJ8ZaOb9Br-guDEAYfI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWJ3fol2CBoEieMRgNTWvssSXE8MaisfFx0zzPbL_YkA&oe=6B086C57"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1286770344518242"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1456913733035036"}, {"status": "PUBLISHED", "id": "2708266016294663"}, {"status": "PUBLISHED", "id": "2334837194013634"}, {"status": "PUBLISHED", "id": "914420618385171"}, {"status": "CANCELLED", "id": "1051805717222871"}, {"status": "PUBLISHED", "id": "1076192061634085"}]}, "baseline_offer": {"id": "2334837194013634"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "145691373303
.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ4m4LkI4cgQ7kNvwHIDtoI&_nc_oc=Adobda9N4feTzpREFINcKGKVC95E2Mk_1fjc0_n_YdlreOdT2jStBIvmQ-d_C9c8Td8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm2yowQSwuoXRrSQ-GGSidXCoGWIofxHTeY50lDy6mlg&oe=6AC7AD54"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KvCW7E32yoQ7kNvwFid8Sd&_nc_oc=Adq-0PQIxv0tlD8PbCNLMYIx2hbsX8oxga4sOE0cUBLwewjeWxXAoBu1MJCa8sKhobY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBsqNzGnzh-vnhi2cYpGBtrQRRNA-9zLiNn8da2QWHPQ&oe=6AC7BC3E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4W0Q8agd_QQ7kNvwEj4M6O&_nc_oc=Ado_tcY4hDt4g9czmPWT6drvu94FMQMyhygPK6VkK41noJklgutYbUh2ogqyL8_5Pv8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNux9YCDNyXmAQBGKyBlB0sg6HcriVd75ao3goAhByeqQ&oe=6AC7B17F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue05eIzNB4AQ7kNvwHYJZ4e&_nc_oc=AdpzO9DvJ3k_epkT7XYD5ubapR1Ord0CWO8zyPT_sJL3q5grwjFHaVHTLggZWtq2ee4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxmpQnEbafcVlaJo3KVriVdSlGhhvZeHwsjZM-2VTujA&oe=6AC7C971"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWVdsw_Gi_AQ7kNvwHakBSk&_nc_oc=Adq-aL74vh-Krp27eQjvO7uaXhwkyuwHf7QtadjaFpQqMYWUBoZFTBaWW24U-rOGL5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ4ECb3H3RJpKJSEWhUHQCaXU5jjYYYcKef_z_9TJX1A&oe=6AC79A97"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
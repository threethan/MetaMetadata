.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehC-JdRba_oQ7kNvwHBGnHy&_nc_oc=Adqt2HCvjenWsQD9svNLNViLhgJ3iueK6o-WeyITsJxLu2hEOen1UkZQSMlKQm7_LJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuLhIs2lO1TQbRWZtj-R9kheB-b9lMOrezWQIq0RhUxw&oe=6ACA5054"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KvCW7E32yoQ7kNvwGf_SsA&_nc_oc=AdrjaNNf8Cpui9dBUsANm_PGjqef8UXPr3RIm8C9YJslQkpsjxA3kVhY8jx3pICmVJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXvZr45CjiZsNvUhSK8Cev4n4SSGqEjFZXpqKeBl0GDg&oe=6ACA5F3E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrstU1ov1U0Q7kNvwFwzsKB&_nc_oc=Adqd-sgLoJThgPNzBqVU-Pb17GboHXUfIypFySemlFwbLi1aS0LmPMN-osUTl6ZNUug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO88s_d4qE2FY-_NtjKU-ebezqi-VzHaSO7fkd5bqnlow&oe=6ACA547F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PDoUalC9gEQ7kNvwGnSsNr&_nc_oc=AdqV6JybNRUP7vs1LrgGSolMDcuKHKarXIqEQ9cmFZTZUudJ8xOZzqcaG1rHByFvjog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3b_EimgeRlpld8sTHtWLwMn9vmW956ZuJrfpCqElxxQ&oe=6ACA6C71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0qbO3MOCQYQ7kNvwE3uEbY&_nc_oc=Adpn0H0IWtumZ-5YXo8Ps50KQ6iJDlMPyjS3nNwiTN7MaUCRgqtxfE4-QKFMbsLfxkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj_nIEC-2h6-qTKB5i7bKYE9KnINxPLvBbJwiGkzuUgA&oe=6ACA75D7"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
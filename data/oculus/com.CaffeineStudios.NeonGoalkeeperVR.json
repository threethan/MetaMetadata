34381325965168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622919_1034381329298501_5220187855728107336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-hXJBnSupQQ7kNvwE03OWV&_nc_oc=AdonY7YXSPM1p9CF9q5aPpJdun1h7Rm8IUQq3P9touZ4dtpb7AVEFDVGnL6NVEuVzIE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj6_BnVv-RZPljLRRVbfI1fk05xmmKAeMxzvoV0Jbp5w&oe=6ADCC554"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yxuD2XC4X8Q7kNvwHsUyEY&_nc_oc=AdqZ7O5-HclhO-vjjDs4fNW41XMln6-Mn5x5u5L-zgxs7m7XdUJ8A4bURjCNPWY6rFs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPop9fm3b-tto6KiHT_YVQWzTniMkCfT5Gy3eSzFWySag&oe=6ADCD43E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM49JUvGStIQ7kNvwGNa5Di&_nc_oc=Adp9haLQyrfRSplg3soDrbL_u7K8Y63xDXEzhDQ-taF3HgYx2waVuaZRHG7TQg8IMFU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6RNUHgwbVoAcQQLl7aPM0tDT2y5xVezwsbUMjkOZMeQ&oe=6ADCC97F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpdFXPduEJwQ7kNvwGHLim8&_nc_oc=Adr2URaP692RDNV-Pxd7Fi-E9Q1Xdg_AFmhhZjZr0c9DOcHJJbrxIwTfEcMTHtZ6fSU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqyos3pWHhNEXK7Dty4hhOS8LfUibdRXIL-OlfqW9qUg&oe=6ADCA931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVshwNguNfEQ7kNvwEValCM&_nc_oc=AdrHupvYom-iPXE81aibQgcGOaM73mNnko-N2BOoFNaZFDex7ct24RDxBSh1Hl7pJn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSIsH8wIvCTbaKO0A6vf5M8S78jPA_UsBl0i-ZZgsUaA&oe=6ADCB297"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "websi
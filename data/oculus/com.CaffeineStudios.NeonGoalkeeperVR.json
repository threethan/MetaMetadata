.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ4m4LkI4cgQ7kNvwHa82wX&_nc_oc=Ado0KgN0RJflvcu7Dib9mAzqwhMPu6JJ1ixOE7U4P1n_so-GOCw0FjHuSZmF7vcWf2o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwz8FV-qz9pbmHu9zDQn1taFxqwJBgCcFSzz6j9pWF6w&oe=6AC50A54"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdToOJXmX1IQ7kNvwEow1SA&_nc_oc=AdqnMR8PnmM1sX9tOm4FJyrq8z9DRG8YWLeyBiW758HM8UhzVSdeIHQr7n-fczCUQ98&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuD7KbHVQYPA-6Ng-DLFy2cQP3XLOspFZLl2wylsqEtw&oe=6AC5193E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvl1xxqZPOoQ7kNvwGfta3Z&_nc_oc=AdqPE39pKq_pixZY2iodqVTIn0mIkHN4tmsIwq6yVpnRwzapF1FOmjY3tzSGG9hJz-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1o_SxqWNjPEWevePOib98RRXiCfAEfp372x_AZ-MGGQ&oe=6AC50E7F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue05eIzNB4AQ7kNvwHTe5KG&_nc_oc=Adou7WKLlJ9caZeh_6d0oDgDnR_bHfz9kqDVYNrZvuwc8J3nvX5BF5Ed_udt23stovg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7QbCtzKeZh10WXbf7O41V0O9BvKk6W8doWmsf5y9rbA&oe=6AC52671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWVdsw_Gi_AQ7kNvwFGAlw0&_nc_oc=AdoqEWs9CMnKVGnmGtohwkJdL1TMC7sHp1eUUteMtCWgVsAFUewOIlvQ8T0RAxxrgrU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD22z01wzsFl13uMUluFEVbu4NBR8eFiCUlYJvEafQ4g&oe=6AC4F797"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
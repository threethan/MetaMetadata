tl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7GX6xveb2apnxYW79O7VhuXDGPq1IYeayGPzxSn378Q&oe=6B0B263F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqeJUY7EFjAQ7kNvwFbzIm7&_nc_oc=Adovh1uGyel_xMMGRm6toenxvwpJj5mCVfiBG1enocXjKF6iOOeQuhTt0tFArFmHl50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNicGgZMCNe1NkVu5fawGSV00ctG1Hf-_eNGfITK6WMg&oe=6B0B3E31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX9drt9KBRcQ7kNvwFuSyXq&_nc_oc=AdqmY38zvGyO9hHSmrvOZSQ5v59rf7532CEa3YY7WLopSqPmSdMgbvj9YJqX2geo7k4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0Ls97FZyt7FsbZFVtAR9TqOt5oQdqeLOl3WybkP7FZg&oe=6B0B0F57"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1286770344518242"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1456913733035036"}, {"status": "PUBLISHED", "id": "2708266016294663"}, {"status": "PUBLISHED", "id": "2334837194013634"}, {"status": "PUBLISHED", "id": "914420618385171"}, {"status": "CANCELLED", "id": "1051805717222871"}, {"status": "PUBLISHED", "id": "1076192061634085"}]}, "baseline_offer": {"id": "2334837194
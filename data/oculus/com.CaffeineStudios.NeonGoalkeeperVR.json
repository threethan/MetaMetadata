.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qrRJBnZiOEQ7kNvwGwZkAo&_nc_oc=AdpIX8fqVr2Y1oGmq8kGn3-3B8YUgY5kpIc4V3VJ8fk1LTxxh9CjGEpeKF_1hMMp8yk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdSOl7QdSGFYlTvkgVKMN2LN4Hl95mz_9GI828aUxeoA&oe=6ACF9654"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2R71AWIQ34Q7kNvwH6mdIV&_nc_oc=AdreUKZpb9IIIL2IjSFWYoAyjtWiKA2NW3ywuce2YR5bFh6mTz6vdf1cH_D5OyCNx6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt6fFsOzIqmwV5gJNgpZJLigN3PK8-BF8b27W2DyfkIA&oe=6ACFA53E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFO6sG2q2NUQ7kNvwE5RSQO&_nc_oc=AdprGSGFkfY91ZzmTA2fD9Wg1o-3fDn3AuWOyQbbus8r6TJDYqoGXVx9sBu5zXzV0gM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBeLDLqr2qOwsh8ZBr-YzW1L-7CtCK5AoUt6trLc1wHQ&oe=6ACF9A7F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MVQ3AhDzX0Q7kNvwHUJpON&_nc_oc=Adr0jeejt2_MMgchBxUFPuEnwUuKlxNNPhroC7LP9ZyjqDNAnWtGfF1xZyqfIiyjEps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPmwRXrfBltyFVK5KZ19Wf9DRBhUPjbgVBWCpykrpaPg&oe=6ACFB271"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ib1Xp-3PHzUQ7kNvwEO3fy1&_nc_oc=AdorIpTYyrtincrBvlwxgrPa_xZMZZxduqn1KKAHTxTXvMKe341egDgQzj8QjCaHrSs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOad4IlGq2gHO8jsv9_f5l3a4q953H8nX7Zgf1o-fAGpA&oe=6ACF8397"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ4m4LkI4cgQ7kNvwEP4xnY&_nc_oc=AdorF38UlH1HHFwgbtMD40UvPjOdxRKPoXCAY86ZeiLOgghAsyLSZWH9-FUYp2jWI8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPR-OUc95y2zClFFbLAv3IN4q-sRNrNk-V6VFhdJk7xsQ&oe=6AC65BD4"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdToOJXmX1IQ7kNvwHpO61H&_nc_oc=AdreUva6YUYOw5LcHmHLxmHQTeHrwTYIy75_ky-AEPYUMaPHPYissvEr7Rbq61Glv5s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVpIHlpSSZtK9UKnan7eZSATDByBzUcCBkBJv1IW2MSA&oe=6AC66ABE"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4W0Q8agd_QQ7kNvwGb9gnL&_nc_oc=AdoGyzaZRJD_mvINDJGI5eECdm-At_bcE0jJob0AQ0WIq42A-wMpu6nn14SVESPbwks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX5BrLRUp1fx4zTHNLg1ZhUOgag-VziH1ADqWLPO-Eeg&oe=6AC65FFF"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue05eIzNB4AQ7kNvwE2oBML&_nc_oc=AdosqgC6dagAeQ_Yu91Mefh7V9HLccbFGrYgR51gTRrQfSPvQq9FzL1WY0rc1MEduag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPYywDjabLEPYU0q3WIfmTQbgcz_S_r008vKESJa5hrQ&oe=6AC677F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWVdsw_Gi_AQ7kNvwHUPLBP&_nc_oc=AdpVdwZDN1d9UJ-rVeit588F19HxcotXQMywS7X1lHU3NcD0NZpT4uOtyIvZHWz_J6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ-mbSW5EJd1wwQRETpQDdECyhwPPcCc6MkhO7tPCfuQ&oe=6AC64917"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qrRJBnZiOEQ7kNvwF54Nn6&_nc_oc=AdpO-5H9tBJ-4rsgfVZ4zKtZN8jEqZyvQn02aVMw9iGq4pJyMyqJeIWp32ILEa_lXg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLEqgD76W6Jjvo3nq7oeERaUcTHoZfc_5BUGvofr5UjQ&oe=6ACCF354"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbS6mDG2w48Q7kNvwF02EtH&_nc_oc=Adoe6jY9ugy5NPlt7uKplfrnQ3SyKHNR3qZ5avOXnJLH7CN-00TJp08MtrUpAAoPgHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3vELcZV5byigMzluoIzttWwfymr3mBKx8bblFUJ_zug&oe=6ACD023E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrstU1ov1U0Q7kNvwFP-irA&_nc_oc=Ado7iXM9gDnVAsUtdWaBeuUk4D5nvHevBIWXBur0qXhgLXQXXAFtWSArxFm_0UvH348&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIR7KmWOmAy86nI8BIJ3rix817Xa8a1iIXQpPRhOPmdw&oe=6ACCF77F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MVQ3AhDzX0Q7kNvwEHdyh-&_nc_oc=Adq_OJK7jUCQkO4g2JuaVSsjatIqShWlvgg5URy60fubHFAX63JowQp2E4xGB28Cc3k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUGIzZaJ3t-ulFUGkW5tW2LNx3P4jZDasGbPcK_zDcGw&oe=6ACD0F71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ib1Xp-3PHzUQ7kNvwGDDW21&_nc_oc=Adp33eCFHljeZvimFoXfJTwTA64kspKQJA7-VAPOLCmGoWp1DV4i1cYJoS3qEPvruGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx09tP5-9WXgojg5WoqN4-Ly_p9VoY9knChKZdfeo44g&oe=6ACD18D7"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
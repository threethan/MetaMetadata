34381325965168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1034381329298501_5220187855728107336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-hXJBnSupQQ7kNvwFLIJGD&_nc_oc=AdrZ4gt0t36hGCv4GTrsXLUhAJRmZ1jyhaiF75dOhZa0TuwK5gMv4fAdyr9tkC734aI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFX7pQ7Toiombt9XXpfLUvgdqMTlhwI02khrDcJNXHtg&oe=6ADF6854"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2u8GEs8VJoQ7kNvwHfJ2nH&_nc_oc=AdoE-jlms6ivHsaEDrPKeG-yttKGiBvV93ywbVA0T0ubmiouR7qvsrE5RlyzlCMXMus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrCDv9XhTbQYGXmIyzVnAfRXPNgDTVVTzGksknZCw5HQ&oe=6ADF773E"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nstUnP2V3cQ7kNvwFb8rJt&_nc_oc=AdqD_i1dyRUNLHF86n2nSL8Lxgm44tb5TLMqIX2MnCePY6tWrC85Z6q1OKeVSlk_KpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCmUceHOBB9lHHwmoB3KHnhgkZDWtQKKtU7qdQJ1tyfQ&oe=6ADF6C7F"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpdFXPduEJwQ7kNvwFOaRc3&_nc_oc=AdpNqnw-WJfjRhdMWyRRdqNqnL2ama9dO8HiG945V5jSRzgzhuSpMx8_nWw4AkDetNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOMumSp2MYHvPBQllAfq5iu1ngdDvH_wX6xVQS3ASafw&oe=6ADF4C31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVshwNguNfEQ7kNvwGrbQWo&_nc_oc=AdrQh6yPRmzEUaa0geBITTe1yxZ-8EfxXx-gDyvKJiC3-3XLlVSmW8glzYSbLnmonOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGaQrBbi4cGzNjMXox1cpP5oRuz4HSzCeK9Qkt_6aMaQ&oe=6ADF5597"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "websi
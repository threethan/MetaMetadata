.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehC-JdRba_oQ7kNvwEEyZeO&_nc_oc=Adrnkyfkjbh1Q56XH0CVTIyMcbfE0qdOfsjnokbkJmUUpIclO7zHmSsRBZRgsGzjVcE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSGGWbq-Xc-NGcG84rQJcvRLnF2FkXMIypHVjt3SFyJA&oe=6AC8FED4"}, {"file_name": "04_High_Score_Action_2560x1440.png", "id": "1028521773392488", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_1028521776725821_1955669489237133632_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KvCW7E32yoQ7kNvwEMpnTL&_nc_oc=Adq6mqR23ek6-fcWdqJERLj2Cj28gBGxaw_zNAuXUlZwm5fsBUmf-kFhzhOObQrHYLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ1RtkwOUg4M8VHwGdUVlEKTx6iclRqc_7YuWdUeVD8g&oe=6AC90DBE"}, {"file_name": "05_Match_Results_2560x1440.png", "id": "1605289654506124", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620856_1605289657839457_6929062482953803337_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4W0Q8agd_QQ7kNvwF6OHOd&_nc_oc=Adq-zywABa8lODJgoEtZxSyk8Urbd6ABS20z_kpJPayfbfzZtkM9j4iJ4942yG3KxDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7FNbHqCpWyx_907q-dBoXQLmzVVXdDxEd7xOYEPjYtw&oe=6AC902FF"}, {"file_name": "02_Neon_Save_Effect_2560x1440.png", "id": "1037762695330757", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604275479_1037762705330756_281678885689308599_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PDoUalC9gEQ7kNvwFqGepm&_nc_oc=AdqCLEpfIq47e4TzJgWThQe9c7UDnEx7TY20iKYjiet4vghi8Kac8AdfBHCZYNunyac&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9SleuFhN_iii3wqONwuRjMc1Gi029UNdtsNDHUxGvjQ&oe=6AC91AF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Art_Landscape_2560x1440.png", "id": "1598566005305950", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/646433061_1598566011972616_2340108642938335147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0qbO3MOCQYQ7kNvwGMikpW&_nc_oc=AdpRbQ9EwT1TWchOI-1R4xsPg00vvK5zutNK34PAS7o0-BleL0gkoUzUhum5-vFA9wc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR_SHbmshEnz69TdGmK_mPLStRU5pQ_UGH6NdbT2t8qA&oe=6AC8EC17"}, "display_name": "Neon Goalkeeper VR", "keywords": ["soccer", "goalkeeper", "football", "goalie", "arcade"], "long_description": "Take your place between the posts in Neon Goalkeeper VR, a fast, stationary VR soccer challenge built around reflexes, positioning, and clean saves.\n\nMove both Touch controllers to control your cyan and magenta goalkeeper gloves. React to driven, arcing, bouncing, and rolling football shots aimed across the goal. Every save earns points; chain consecutive saves to increase your multiplier up to x5. Let a shot in and your streak resets. You have three lives and 90 seconds to set your best score.\n\nChoose Easy, Normal, or Hard. Shot speed increases and the time between shots decreases as each match progresses. Track your final score, highest combo, total saves, goals conceded, and best score for every difficulty.\n\nA guided tutorial, safety reminder, pause and recenter controls, adjustable audio, and seated or standing play make each session simple to start and easy to replay.\n\nProtect the goal, master every trajectory, and see how long your reflexes can hold the line.", "short_description": "Step into a neon stadium and become the last line of defense.\n\nMove both Touch controllers to block driven, arcing, bouncing, and rolling football shots. Build save streaks, raise your score multiplier, and chase new best scores across Easy, Normal, and Hard 90-second matches.\n\nPlay seated or standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/neon-goalkeeper-vr-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
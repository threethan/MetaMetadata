m&_nc_ss=7f20f&oh=00_AQQ5z9Cj7TWTNdpGqk4QzJL9ifJPZ0XTubE1oYXsLD9SSw&oe=6B09A5A7"}, {"file_name": "Search.png", "id": "1786576535874801", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824741_1786576539208134_6659170913175043627_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU3sBvJcMlQQ7kNvwGZMKs7&_nc_oc=AdoR4c3Pv9S3uPVn_2iiHuZiSK6dEzU709Yd9Y7wCmnJWLgg0y5a9pJvPV3MfeQOZ9g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUKuQt2bymaB-zNkGmr4FSNoX7ywu0ax23O6XF2QwGlg&oe=6B09BD94"}, {"file_name": "Purchasing.png", "id": "1797147111471483", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_1797147114804816_3167136362555263310_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIoDgFRKiYAQ7kNvwEhvXPK&_nc_oc=Adox_dxSbjqUUf4bG4KXZF6Bk8t5DDtlITX_6Mz4fPDVAzyX_33P4Qc1Je1lmL2IVkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7VOEoDoolsA1YD81vdKXgH0hl3M78otg8OyjxowXRyA&oe=6B09CD58"}, {"file_name": "Home.png", "id": "1644767716982756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1644767720316089_2989267227323805409_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykzIV6TzHssQ7kNvwHn3-TB&_nc_oc=AdocI2d9DqsGslSkTJJ9m2RvHhAOUSsaZwRQuY2YT_I0WbkwU1yWtlSoZyfOrT5afIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc64bzOrYrknmwfEVG7JA2Ic6EXvvE4UKt1hoh1wtMOw&oe=6B09D1B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1070629822620686", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1070629829287352_4041551714504818230_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9iyvDVpz6kQ7kNvwFti8Ke&_nc_oc=Adpjmj11Nk8UvAArtsPWLxz2D2eoS5upoQMHTrA_9F87At1wt3TknYabKSGpyqc2wvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPvBY3CrDaUFSab2uwtfKAp9tJn8oGXh2ghZsvkKXkyA&oe=6B09BC81"}, "display_name": "3D-Spatial", "keywords": ["3D", "VR", "Immersive", "Video", "TV"], "long_description": "Welcome Home, 3D Fans!\nAre you tired of searching endlessly for true 3D content to watch at home? We were too. That\u2019s why we built 3D-Spatial \u2014a dedicated 3D streaming platform created by die-hard stereoscopic lovers, for 3D fans. We are a small team on a big mission: to build a permanent home where 3D art, cinema, and spatial experiences can shine, be appreciated, and live on forever.\n\nWhy You\u2019ll Love 3D-Spatial:\nStream Free or Own: Jump right in with our selection of free content, or rent premium titles starting at just $0.99. Want to build your ultimate digital 3D collection? Buy and keep your favorites to watch anytime.\nAn Unrivaled 3D Library: Explore vintage gems, hard-to-find rare titles, and modern releases. From full-length feature films and series to shorts and movie trailers, if it\u2019s in 3D, it belongs here.\nBeyond the Movies: Go beyond traditional cinema with stereoscopic photography, high-energy 3D music videos, and mind-bending spatial media designed to make full use of modern VR depth.\nPreserving 3D History: We aren't just a streaming app; we are dedicated custodians of 3D history, working tirelessly to make sure classic and forgotten stereoscopic media never fades away.\n\nOptimized for Meta Quest 2, Quest 3S, Quest 3, and Quest Pro. Put on your headset, kick back, and experience depth the way it was meant to be seen.\n\nDownload 3D-Spatial today\u2014because 3D isn't just a format to us, it's a passion.\n", "short_description": "Tired of hunting for 3D movies and videos? 3D-Spatial is the ultimate home for 3D stereoscopic and immersive content. Enjoy free content or stream premium rentals starting at just $0.99. Discover a unique library of rare classics, modern releases, immersive experiences, shorts, feature films, music videos, photography, and more. We\u2019re building a place where 3D can live on forever and users can experience something new. Welcome back 3D!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://3d-spatial.com/privacy-policy/", "developer_terms_of_service_url": "https://3d-spatial.com/termsofservice/", "publisher_name": "3D-Spatial, LLC", "support_website_url": null, "website_url": "https://www.3d-spatial.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26045785591782192"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1098275529445895"}]}, "baseline_offer": {"id": "1098275529445895"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795209300, "status": "PUBLISHED", "id": "1098275529445895"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29099328606427860", "version": "1.1.3"}, "id": "1553329840126380", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26045785545115530", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29099328606427860"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1553329840126380"}]}, "change_log": null, "created_date": 1795011478, "id": "290993286064
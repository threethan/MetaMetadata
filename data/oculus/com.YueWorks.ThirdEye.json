e7a0a&_nc_ohc=zUJLEhhvhFsQ7kNvwGFf8LZ&_nc_oc=AdqIBEMe3t4tfgebfmEEjDmsBNoTvzuMybLL6M2XSKoEJbB4s1QI-juholEBFF27Ars&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_2hUcABTmZ8iwhe_QP86vTwTaAcCk0xG5JeSjLvRXYw&oe=6AEF4CA5"}, {"file_name": "2026-10-16 10-01-10_02-07.100.png", "id": "1398404098664069", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_1398404101997402_7489067126691710785_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in0SB8XcCcsQ7kNvwEeMTLa&_nc_oc=AdqxEp0T82Vv00XVxeWCgGkCDIuO34v-5U7b-Gn23nLubi2FUb6I6gu_Nf7KEvRauGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT44swvaBFeHSpUG7hrNgS4bB6cq19-phpGebqns1wI_Q&oe=6AEF41DF"}, {"file_name": "2026-10-16 10-01-10_08-45.686.png", "id": "1656724939225816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1656724942559149_1126741316023085994_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlGKPmiMqY0Q7kNvwEKuii3&_nc_oc=AdqeN2XMvle7ZAyeJOhp4UPlIHS1epWiTerb01NIsh6txEMD67jROEe3RlJGX7jqON8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7hdTuFlBTzvrCHazBT5uAQHqcLybd89d-AMx6AXwN2A&oe=6AEF582C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v59_header_hq.png", "id": "1944255386549520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1944255389882853_4505101480334913264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31C_0TIG5pUQ7kNvwHSAwtS&_nc_oc=AdppR1e1FpZSPu5k7J4pbRMrr742iywuXGB5uODsIMqooJ-GpRKvvpBCd2M6ANCck0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Ej-n0bvMkvwzRkERL1oLFBg_kAOgJhyOVfkx0hMIyQ&oe=6AEF5DC1"}, "display_name": "Project Third Eye", "keywords": [], "long_description": "Project Third Eye is a physics sandbox built for VR. Everything around you is something you can pick up, throw, ride, build with or blow up.\n\nHit the road in cars, trucks and motorbikes, carve through snow and water on boards and boats, or leave the ground behind with aircraft, gliders, parachutes and jetpacks. Prefer to stay hands-off? Take the controls of RC cars, planes and drones, and see the world through their eyes.\n\nWhen the existing vehicles aren't enough, build your own. Join parts with motors, hinges, wheels, springs and thrusters, then give your creations a mind of their own with in-game scripting. Wire up inputs, logic and math to make machines move, react and come alive. Save what you make and bring it back anytime.\n\nShare the world with active ragdoll characters that react physically to everything you throw at them.\n\nBetween builds there's plenty of chaos to be had: firearms, melee weapons, explosives and fireworks, exo arms and wings, and sports gear.\n\nTake it all out to snowy mountain slopes, a desert dirt track, canyons, lakes, ramp parks and endless hills, or one of the many sandbox arenas.", "short_description": "A physics VR sandbox. Drive buggies, dirt bikes and jets, blow things up and build ramps, across 20+ maps from snowy alpine slopes to desert dunes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/p3evr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/p3evr/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tr
iwJVebydB6i5-B2zvVntuFUgmWg&oe=6B0DB6D2"}, {"file_name": "2026-10-16 10-01-10_06-04.434.png", "id": "988630420945390", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823366_988630427612056_1097731988964918330_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fvqoV6OwJwQ7kNvwEzVlOe&_nc_oc=Adpmohk5cUlytMx5BIVllsi_VRKNMkB3dvlhZ9xy_xF7j5wI5GxuN6VQPvCWBw2LnrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNPS6TE_cvXPFFVh8pV30wZgjHSLst7oyVTpwHjhNf2Q&oe=6B0D9F25"}, {"file_name": "2026-10-16 10-01-10_02-07.100.png", "id": "1398404098664069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1398404101997402_7489067126691710785_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BW9Rx_EVPsQ7kNvwGlIeJw&_nc_oc=AdrmOKFhJxNACOkJuK3Dr3cIHH3bhgYik5HDWR3rO7_c3s2U04ClVjr9kxE6RRbTyW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTw18Zo34A2G24P211RSGpECQhp92cNN0iOakOnqdGBQ&oe=6B0DCC9F"}, {"file_name": "2026-10-16 10-01-10_08-45.686.png", "id": "1656724939225816", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1656724942559149_1126741316023085994_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHL3umimQE8Q7kNvwGN0nnj&_nc_oc=AdqimXFsGdXxB57336O0PPXJ8IZmb-UjkGxSLqR-RQUhB0_WgLcC4V5reKriIb0IU-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1KHGVnZ_m-FXIxMOlQOoLUbOeEL9ryr01dqzv1TX4Ew&oe=6B0DAAAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v59_header_hq.png", "id": "1944255386549520", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_1944255389882853_4505101480334913264_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVuHDW0dxMgQ7kNvwFKhXDK&_nc_oc=AdrQJ0NjIQ-QmcihU45eduY5z59wTtQSMUE-TJ3nstHlnocDYI_xyelUScb3zJzYmes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4Yw-fofQeEmvJtqXOzY1Yt39wMl8rkQ5bwb5-Iwr7Mg&oe=6B0DB041"}, "display_name": "Project Third Eye", "keywords": [], "long_description": "Project Third Eye is a physics sandbox built for VR. Everything around you is something you can pick up, throw, ride, build with or blow up.\n\nHit the road in cars, trucks and motorbikes, carve through snow and water on boards and boats, or leave the ground behind with aircraft, gliders, parachutes and jetpacks. Prefer to stay hands-off? Take the controls of RC cars, planes and drones, and see the world through their eyes.\n\nWhen the existing vehicles aren't enough, build your own. Join parts with motors, hinges, wheels, springs and thrusters, then give your creations a mind of their own with in-game scripting. Wire up inputs, logic and math to make machines move, react and come alive. Save what you make and bring it back anytime.\n\nShare the world with active ragdoll characters that react physically to everything you throw at them.\n\nBetween builds there's plenty of chaos to be had: firearms, melee weapons, explosives and fireworks, exo arms and wings, and sports gear.\n\nTake it all out to snowy mountain slopes, a desert dirt track, canyons, lakes, ramp parks and endless hills, or one of the many sandbox arenas.", "short_description": "A physics VR sandbox. Drive buggies, dirt bikes and jets, blow things up and build ramps, across 20+ maps from snowy alpine slopes to desert dunes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/p3evr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/p3evr/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT
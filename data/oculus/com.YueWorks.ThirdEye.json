0f&oh=00_AQRWD0KK785W0jlGJ-ZlIJnqUokLWVta8QPu2SKhChDqRQ&oe=6B0087D2"}, {"file_name": "2026-10-16 10-01-10_06-04.434.png", "id": "988630420945390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_988630427612056_1097731988964918330_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKmCHb68_bcQ7kNvwEKRvmF&_nc_oc=Adp0771frfbmr9hDE_g1Rr7W8ML7b-bxyejeJg6NXhEc5PhhC3BhgtBUkajtK0fzSag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSioe5nwGrzf-x22luoesc3j5F3DgMYEJc4_8SAYqY3bA&oe=6B007025"}, {"file_name": "2026-10-16 10-01-10_02-07.100.png", "id": "1398404098664069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1398404101997402_7489067126691710785_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnZ8Wmx0pRIQ7kNvwGJqZw-&_nc_oc=AdrULJiZgXLthIQBllsKXlKnD_Zs0L1805mk8te4ogZfJ2_Pelvfdt4LlV3QKq6LpeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTppVKiASGLKRkzwn7nGZjzFIHt6MIR4HTajHWrojlQ5A&oe=6B00655F"}, {"file_name": "2026-10-16 10-01-10_08-45.686.png", "id": "1656724939225816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1656724942559149_1126741316023085994_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sfMoWueExQQ7kNvwE-P3mC&_nc_oc=AdoZeOk6hJcwcqcOooUGh__rXgJjawtscx-yq8C6NLZBT4SqRHDT4f0dmj5w5ttmhMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyG53ZhIHZCRMBFy6B9yajlIpG8Cd6WGanplZR_A2qeg&oe=6B007BAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v59_header_hq.png", "id": "1944255386549520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1944255389882853_4505101480334913264_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3wlDJI8Q4EQ7kNvwGrZPII&_nc_oc=AdqDnaYVfcZ9rzBHY_Y3-Iz-ikS9kL5dTIjNbt9Rw-SmD4luyC08_VUpyQYV8YtEg4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQApSCS91kiF1snM7G0JlYgxiFkowHZRwNXRNvxpanC_w&oe=6B008141"}, "display_name": "Project Third Eye", "keywords": [], "long_description": "Project Third Eye is a physics sandbox built for VR. Everything around you is something you can pick up, throw, ride, build with or blow up.\n\nHit the road in cars, trucks and motorbikes, carve through snow and water on boards and boats, or leave the ground behind with aircraft, gliders, parachutes and jetpacks. Prefer to stay hands-off? Take the controls of RC cars, planes and drones, and see the world through their eyes.\n\nWhen the existing vehicles aren't enough, build your own. Join parts with motors, hinges, wheels, springs and thrusters, then give your creations a mind of their own with in-game scripting. Wire up inputs, logic and math to make machines move, react and come alive. Save what you make and bring it back anytime.\n\nShare the world with active ragdoll characters that react physically to everything you throw at them.\n\nBetween builds there's plenty of chaos to be had: firearms, melee weapons, explosives and fireworks, exo arms and wings, and sports gear.\n\nTake it all out to snowy mountain slopes, a desert dirt track, canyons, lakes, ramp parks and endless hills, or one of the many sandbox arenas.", "short_description": "A physics VR sandbox. Drive buggies, dirt bikes and jets, blow things up and build ramps, across 20+ maps from snowy alpine slopes to desert dunes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/p3evr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/p3evr/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "exter
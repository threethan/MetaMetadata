0f&oh=00_AQRMy1swZguJYKiobcLkQDN-qUL2lGAoULW5wqaVothw1g&oe=6B071F52"}, {"file_name": "2026-10-16 10-01-10_06-04.434.png", "id": "988630420945390", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_988630427612056_1097731988964918330_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HHb0wk-h7YQ7kNvwFVTFJ1&_nc_oc=AdqED3G5TPw8gMSMTWT8nm7FU4iTKQ62FQZYY50PvCNvmQjVzTKbwEg-OHvfBAaAUMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4wmAo4YnOy0m6FxRaIFhYa6vKgdg6sWxdqncfA0g_7Q&oe=6B0707A5"}, {"file_name": "2026-10-16 10-01-10_02-07.100.png", "id": "1398404098664069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1398404101997402_7489067126691710785_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGQ_X0RQSdQQ7kNvwHhMMaQ&_nc_oc=AdqC64S7ncljPJCI417nlHmsgHn793yehBe9MMLpAcOt6Kinun-UoBQOFOqL_vykOl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkNUTG1HuSSameBoFpp22UXmcNoLviWBwcIdHYrlX5Qg&oe=6B06FCDF"}, {"file_name": "2026-10-16 10-01-10_08-45.686.png", "id": "1656724939225816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_1656724942559149_1126741316023085994_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxJu0EeRJIQ7kNvwESaelW&_nc_oc=AdoKSQ7qSd-A4xM9UY5GDVS1dNlTRZyOX-3_esGT8ecDHbUeyDoFnUUN-Oej3ejNuN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyZTuSM9POVbYEIyJgjRNJ4FId1zsiiQHZjhjnOPECbg&oe=6B07132C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v59_header_hq.png", "id": "1944255386549520", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1944255389882853_4505101480334913264_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rEvI59BOFgQ7kNvwHvjZBS&_nc_oc=Adobnw9XUpjDd9bMVGkOzEUpRkE-kF4pj0dox6Bwf1AzwI_R3yedZXFwCs5H7klOD6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQfNBGfai80rDhYtjWk1fpHRFqAq7NWIa8LYIiCtXKsg&oe=6B0718C1"}, "display_name": "Project Third Eye", "keywords": [], "long_description": "Project Third Eye is a physics sandbox built for VR. Everything around you is something you can pick up, throw, ride, build with or blow up.\n\nHit the road in cars, trucks and motorbikes, carve through snow and water on boards and boats, or leave the ground behind with aircraft, gliders, parachutes and jetpacks. Prefer to stay hands-off? Take the controls of RC cars, planes and drones, and see the world through their eyes.\n\nWhen the existing vehicles aren't enough, build your own. Join parts with motors, hinges, wheels, springs and thrusters, then give your creations a mind of their own with in-game scripting. Wire up inputs, logic and math to make machines move, react and come alive. Save what you make and bring it back anytime.\n\nShare the world with active ragdoll characters that react physically to everything you throw at them.\n\nBetween builds there's plenty of chaos to be had: firearms, melee weapons, explosives and fireworks, exo arms and wings, and sports gear.\n\nTake it all out to snowy mountain slopes, a desert dirt track, canyons, lakes, ramp parks and endless hills, or one of the many sandbox arenas.", "short_description": "A physics VR sandbox. Drive buggies, dirt bikes and jets, blow things up and build ramps, across 20+ maps from snowy alpine slopes to desert dunes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/p3evr/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "YueWorks", "support_website_url": null, "website_url": "https://sites.google.com/view/p3evr/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "exter
ry(1).png", "id": "1597882337996056", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z92TSKTxDFcQ7kNvwEPexVk&_nc_oc=AdqkzdR2u8B8NTHDzcwK8xyhtZTkZ_d2qOUA24MomYNadIjxBuvDRpFWj8sJM3rSMWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxV9fDOE2PZ8r4B4IPNMTAucDrlQkvfcZe99hWwxrOCA&oe=6AE0A143"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sq5vUsyFE0Q7kNvwHoHHTz&_nc_oc=AdqKN9OapaIbl7gmMeykIxK2iPy_75oisLANzd8ohF7_GH4nJtzHr2G7YTjLN9EJAKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyVRrMda8tAp2_aCfF4N2I6jeHjbvCiyUVS7wklnwmBw&oe=6AE0AA9A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4xmUbVdVwwQ7kNvwGC_kQC&_nc_oc=AdooxMiYO-R3KLUU5X__jdY-Y34sn9olVZ9whETQDp4PNIV3ntemtMztPCbtlGfNqpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuRV2zS8oRq7ZNLNyYKKD3linNi3CwX5Q_pZ7zOALEuw&oe=6AE0BACC"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew5yTV0JSQQQ7kNvwHPovgU&_nc_oc=AdoBfQItHpt9bh9nHtYK6A-ogNNVSWifapHbAP_GF_IZUZub7QDD2NBaKheMCvOm_JQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-RfJ2r5cza_Qs4JkteCt-RkarGFZyrhQENSc_Sa2PUg&oe=6AE0BF99"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGMXB0MPqCUQ7kNvwEwWqFP&_nc_oc=Adp06jwlaso2fzwg0822NVGRWODJDB8Ze6i289oBgC_8kl8EhPnce8lcX-xWiP96zn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkamMS-YQrfVIEshemJjL9oC6zGsSrTGPBWpe8XfOU5Q&oe=6AE0CCBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDDjohpB1e8Q7kNvwHeVGVj&_nc_oc=AdqxyJOLzyxLoHS7T1X7gA6NE6RWKn2m2FjeLYLRsddys4OZVa7WZwh34tEyEJMuuL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVFRshARY3FVL_MZ6uclDN4uN8zFSmrCWbDwTO9_IAhw&oe=6AE0BB06"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BopfROz0HhUQ7kNvwGxYJd1&_nc_oc=Adr6dtTX30DcV_JkuzgZ6-xBYiIQmTIhhnsRqTOv2VN6KXbXM7qAugA8QL_yc-1Brlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgEmqLmc0x5PcP5nsdq-e0oqZAPXIV-xVRuMHtPX_VMQ&oe=6AE09FCD"}, "is_concept": false, "is_test": false, "is
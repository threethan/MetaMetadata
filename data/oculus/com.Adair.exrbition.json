t Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vr2bsAsBsVQQ7kNvwGXfb-s&_nc_oc=Adqr1ZYTwwXUJT_l_qMcQLtMxC7s6WYJ7uWTVFU2nGT6uzl7ddUARf_9bJ9cVe3ONuQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT27XuUfEQj4d6H0LB89_fwFfvvriHspwowjxmPjZ5E4A&oe=6B09C15A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffw5twx1hEkQ7kNvwEf_1KZ&_nc_oc=AdqadU0y2SuVPHy8vmwDVB4sgBAWTD-a9ToRGasKvHUx1qs_AyB_EIv2N43K9uI4vDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDRKnRZZMlcyNmnTH65ddXGZY9466Na5l7R7KvyG8CtQ&oe=6B09D18C"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCkGjJeGNbYQ7kNvwH9PhDH&_nc_oc=AdqoWrhpLisdxmhsQmGMxTOOU2WGXKIczP6pSLuBJUecljvBmULTZY1STfhET5tHpUQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2S0gW2ZDfZZFuDj7PjrGyImki7QT9Da9eu95rOzV30Q&oe=6B099E19"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-poQXPZkrsQ7kNvwHscGcX&_nc_oc=Adrh1zO3eig6iqZVw1A-cg8dl3oRgc3y8D20VVPQRaE-Aed8KU8W6a6rByUOwYsdOd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR67wyT3whmZc8P0XLz5y6lzixHndaDNpIw0FAklkWgew&oe=6B09AB3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR5iLFILAn0Q7kNvwG1o9Ng&_nc_oc=AdoCl_Hzhy6xrv_vIxn3IsnAIEbE7Pkvjpqd-UdRCUrxe8TBXVBM40a3d1Jg7f7Um7E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzSuG-YK0TVFBzCXXewQ1jahPdfi5TnAtNtob6WlC2ag&oe=6B09D1C6"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1649154759940703"}]}, "baseline_offer": {"id": "1649154759940703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792692720, "status": "PUBLISHED", "id": "1649154759940703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1160704813104825", "version": "1"}, "id": "2277540933096846", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1127640863077887", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1160704813104825"}, "rel
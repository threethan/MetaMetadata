312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RDlCPi8q5YQ7kNvwE-9NzD&_nc_oc=AdrIvMlC9KQy9p4xevSq_vU80LkbYAO-zfc4whamCk2GdM8Ta8W0jiSz9Hi4vZQJQ_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7MaodOnW9rjsE5IvoPFP-OI083tDaOJROtuHX-rxpgA&oe=6AE8A3CC"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vukJcN_gvAQ7kNvwF2GI8J&_nc_oc=Adpw_kj_G80drlg87RZ5zFvu2bbZiEdWGch1Xo34BjZW4rxfNB0FLI2kE7rKS1FynT4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyuwvek6GL3_gpYkY1K8nrCfC0jWBIPsCxKaL5mVXE5A&oe=6AE8A899"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hI67xl8bswQ7kNvwG-f-on&_nc_oc=AdrDb3iMfag2OYpnANtjQu4-qv4EG_xVsDCxJXKYRw9C9k9-lQMcVzJ-AyseFp_oPyc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEtqNuRMHbBucEektK5iJcAHxsUiG27ORfBSsOHHbkpg&oe=6AE8B5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD7qFteUiOkQ7kNvwEeJiVU&_nc_oc=Adoropj_BBImA7rOEdNqrlmp6OEjbyZ-ZgBnadfNpVE0_RcFTNn4j1ak8k2K55NtEZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKK1cr3RyQ5eRNoasTc6UHoUAdU0SXG-3frLTXOfgFiQ&oe=6AE8A406"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
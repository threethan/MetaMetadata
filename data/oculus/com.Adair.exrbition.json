ry(1).png", "id": "1597882337996056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z92TSKTxDFcQ7kNvwGBlQsv&_nc_oc=Adp8zcsVMB6BgsnLHtkTOvVtiXN6SDWyJNwTiB6BQu1gBIgyV_pqE9QJIt6mBPaZ11U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMya6rGNmnGucq9uwHoopJfCpmECLCbyvACqkxT7nXPjA&oe=6AE1F2C3"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuUkNsTEPA0Q7kNvwGsQyKC&_nc_oc=Adqd4HM_L8IeK5nW4H8tiVWJWqbHpGkvV2dwqyk8YLdOH9jGAzyNQHQ7ohM2TmEtAwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqyUolWtviDtXiFUkb-8DcVd6z062SVUPVZE9ivIkHuQ&oe=6AE1FC1A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4xmUbVdVwwQ7kNvwERXnP2&_nc_oc=AdrmMk9RB2s3sIK_fwrUVrOyQRKSjWuMUtSn0dP-VNrhAHpBRq03EzEU-x_r2yySapo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkvIEHORu3f7lXQvlZ6TOYw7guGP58i2xjCW_W_6K9PA&oe=6AE20C4C"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew5yTV0JSQQQ7kNvwEUUjG-&_nc_oc=Adru8Twl5t1UeRRX6rWPPxzlbDoikXVGD-P_EKYf8G7n-bC8XwtzyraiqHnLCm1_Qf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOuung1mSvLNJIsWkFxX0PduDOT3urKUG8TPkAY5nQNw&oe=6AE21119"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGMXB0MPqCUQ7kNvwFYA-5Q&_nc_oc=AdqVbhYV-W_PUVBbaiTaZWxEkChSlNV0lTjfZSH2oGVzQrTUC24min-X4hT9nGZ4YWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx6dzPYVP8EzXTEk0wlyu_Qh4gmj9Hbql-z6pkAagtoA&oe=6AE1E5FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDDjohpB1e8Q7kNvwFoI-qt&_nc_oc=AdpeoZdZ-hYAzUQdelttzY65Rr9YA9D0SNikVAlR0j44FaEzhjG9VL-vAVhdPjtmOLk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgm7skReUr1lrKV-xyANnjESbS4S9R2W6hxb9upzdLnA&oe=6AE20C86"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BopfROz0HhUQ7kNvwHBbB3n&_nc_oc=AdqSwigHWSDlG3jDXlsE96DX439WQAXVqp9bYqxJYv6mFDKQ5C2MU2K6rxjmDQ7M-j0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYYdbeK5GNZFHXLbYIdbs3oDYQpPeAwQApXWcY5Psbcg&oe=6AE1F14D"}, "is_concept": false, "is_test": false, "is
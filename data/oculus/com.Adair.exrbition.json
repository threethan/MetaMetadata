ry(1).png", "id": "1597882337996056", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7qjwVcGEGcQ7kNvwG2mqYf&_nc_oc=AdoECtD0RAMlp_eDGXn-IaeEaHL5FzXsAgoF6rV_FdSGgFIcJHN-zHTael5_2XdIXAY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxz-R4r2s826z8gvPVivMDDELTx9nXmjkG-QoOakpLfQ&oe=6AE34443"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuUkNsTEPA0Q7kNvwFc8g-1&_nc_oc=Adq5VhBkB2IKSmDANoJ0AKWv-86ywtf5KqJAaQLvIu4MFagmwKqrR9SHBV6nrEURtGk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPifZ8LcDfwhpfNW2ZGnzcVrVtf018VvxtQY_lgn8g8JQ&oe=6AE34D9A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKrltlPsMcQ7kNvwHQzpE8&_nc_oc=AdrzJsx5jN1mf2r9jB6fiIR4W5rhaZs7e2O4L_07gE-rFvVUoKAHAhfdvyRKSe-cCTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMS-CbKB8_hN7WraB8t0Xuzm7c5XVY_4j67NRhBjbwe0g&oe=6AE35DCC"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtk8yC0pHAMQ7kNvwFj7k9-&_nc_oc=Adqiwi0dzA877I544iOVEc_50jxe5_hzFbfcsfn_d64F2gj5CgSKArYHgN35r1Mz7Q8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Dr6xw8z6DVQDEGFrSd0b7oTPeMdHyEFbI75EvJBuvw&oe=6AE36299"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCbS9bL9-ssQ7kNvwEQ5iPV&_nc_oc=Adqgr9F4jYBATAYL025N1c_JvhtkcSUtl64J90bNuveUmx-lagjcqu-kP4QPQLJlh2w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtn2FP5OXotZoIK1PEKZmnHHv0WBKDekQ2GDrhYiLeTw&oe=6AE3377B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDDjohpB1e8Q7kNvwGmd3AR&_nc_oc=AdpLG_d1I_gRAuZfjGjLca8Tk_hvyfy_BsJWstb3ZV0dd3_QvIwe1EHWqAAhIxE3V2A&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsH48zfIojJl8SLMULKcPFHHdUeBiANkciuIDZSV7W2Q&oe=6AE35E06"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BopfROz0HhUQ7kNvwHRNkod&_nc_oc=AdoGJuTU1bVz48kgCXeLpg0AsqhW6CKKB12nwDfM2k8Z-UecU51lPrxSKyg0PZl8uq8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJZKNYpUoznud6FVTA0AE02Aokhw5vRQCQaDgIJgE2Ww&oe=6AE342CD"}, "is_concept": false, "is_test": false, "is
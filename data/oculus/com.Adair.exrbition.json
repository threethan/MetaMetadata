t Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdumYYhqeFUQ7kNvwHfnZcH&_nc_oc=AdoHntdYf3o2WDNnGKkB5ay8yZjYQugOF_9zGJlwQcC7EwzQ-aH3to_ICeCJ_l0y7us&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUygONgZkX5k16qKCVAvsadqivQDzymJoh4i69jL3dUJA&oe=6B0F075A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC_Iu80u_NQQ7kNvwEP7rqq&_nc_oc=AdoP-HROmSIW42Qm5s_J-8BmokAUqVJTWupGXXvfV84T11P4Zl2tF0g5V1jjXTCEJDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV76IT-L2e3LfNQ7jBKt7-GV9lXhvBQb0VkoqR7peWf6A&oe=6B0F178C"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpPnujxuWpUQ7kNvwE-V1Pa&_nc_oc=AdpnoFKphVjutlvkZUuHjBuaitcNcIWmfYbt43zbBOQkhhDhJCuJHmQAtr-9Tzb8U_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9oV7SSDlZ0nU24fRVZZ1JkTZogPhjNF07iUtW2wGvHw&oe=6B0F1C59"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbcX_7NOUscQ7kNvwFqyCbE&_nc_oc=AdqEWhGaClihvf6qog_xn0JFWQaDQ_N7WAI9u2Soyd3g3S5vT2dcnNYQl9aT7xLnmTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUqAHGWRHuqVaZMyuaut0PExsnhBdRGRVKlpZWRJs_Ccw&oe=6B0EF13B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uR1FDss09sQ7kNvwFk5yOr&_nc_oc=Adozen0xwlkGoqtpXbQmDOtfruvDdlybFJRFMZJbD8UmQJuT59Esf_FSOOBY4xY9s6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWcsDnc9ounwZPTqmDxMk_OpelJa-WonBCoeDT3BrxyA&oe=6B0F17C6"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1649154759940703"}]}, "baseline_offer": {"id": "1649154759940703"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792692720, "status": "PUBLISHED", "id": "1649154759940703"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1160704813104825", "version": "1"}, "id": "2277540933096846", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1127640863077887", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1160704813104825"}, "rel
ry(1).png", "id": "1597882337996056", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7qjwVcGEGcQ7kNvwE8_uG4&_nc_oc=AdrbpE0lTthMZDnlkySX9t4kc4wGMnqS1yWCPynO29mtQzgAwiAJdpDbWiIIi3T0JNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH1DK_KdEqRZyaD1CXJjlfBmggx670X7htd8hmuqq06Q&oe=6AE5E743"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCaSAdL_BokQ7kNvwF2rcE6&_nc_oc=AdrwB8IyNAD_u5F0oqHpw60zUHtowDIhKrXOiHLK0h6zJr9PTjnROzbL_aY8Nlf2TOo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM433AAcTVyE1J1WZKvGguGcXbe9iV7mymUIqHTN-5-_A&oe=6AE5F09A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEKrltlPsMcQ7kNvwEhm3TZ&_nc_oc=AdqYXr1t245Bc38VZP0LXueym6UFJLnyEDQ_KNkOzTNwZOlYVKU73Kp1HgvG4ZOu7iM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNayZ1D8sMCljnkamXm4ku1C3501ipaj6NXl8k_knMtaw&oe=6AE600CC"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtk8yC0pHAMQ7kNvwGR4pU9&_nc_oc=AdoxdPWAWNe474lyjHg_JygGYNi3EjUYWWWL8sy057DOWOInvXa4Or8CKZuGQrje_ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsSBMK24uPThcS-9YBlnXN6Qdcg260LH6ABxk0dyM5Eg&oe=6AE60599"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCbS9bL9-ssQ7kNvwG0MTgz&_nc_oc=AdoBtU7moy1bjIVQDtkrrMhI8xUj1wrlNEQIf_TOWvlruPpI8ReYeUmMmuu6scbzVXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSfTfEnYcZuSDRD5OIGykliEpr-TzY4mhP3-U8GJuGBA&oe=6AE612BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlk6KJpNKdMQ7kNvwGlvwwa&_nc_oc=AdrVnVja153X2lb7ykAfRtWEeHTKWaKceK-w6nFOVyivg3MXhy7OuwkStsklFgpf9lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPnR3VNLtH2jcg4OzrDidicXqaIHy_-sLSDQArKT3e8Q&oe=6AE60106"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7tOdkjw2pwQ7kNvwFhgxVK&_nc_oc=Adp3_wtvUFtFobOgeZPT57gaJUoJIeF1nNx0nPK3osuTsnPx1bO4HTtVaVKRYlm2R5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD2RYZ7_-3fqPbYVn3tq3z6t9CC4wPQgbIau2rP4Xn_Q&oe=6AE5E5CD"}, "is_concept": false, "is_test": false, "is
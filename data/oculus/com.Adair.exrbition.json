ry(1).png", "id": "1597882337996056", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTt_hzvcKdMQ7kNvwHwdB8Y&_nc_oc=Adr-TyQ8CRGhadDr0VxwbT2CjhHfDshD21vbNPRMTIUdywiuFuGotqrlAIcqJq2U3lY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqq2VBwhQdowK10XZHxH4VIsZIhTeodSCGDnv2HrMaag&oe=6AE8C283"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCaSAdL_BokQ7kNvwEAgEPs&_nc_oc=AdokkN1VpQRT1o_jb1w1UT7z0GpylyYgS9E1smYpZUMORB0Gw2B5jNakNSaBa6gLNlM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOwdXpH-DKNOQeQ5iUFq33LsxpwnDNp7_59ha27SkP3g&oe=6AE8939A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RDlCPi8q5YQ7kNvwE-9NzD&_nc_oc=AdrIvMlC9KQy9p4xevSq_vU80LkbYAO-zfc4whamCk2GdM8Ta8W0jiSz9Hi4vZQJQ_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7MaodOnW9rjsE5IvoPFP-OI083tDaOJROtuHX-rxpgA&oe=6AE8A3CC"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vukJcN_gvAQ7kNvwF2GI8J&_nc_oc=Adpw_kj_G80drlg87RZ5zFvu2bbZiEdWGch1Xo34BjZW4rxfNB0FLI2kE7rKS1FynT4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyuwvek6GL3_gpYkY1K8nrCfC0jWBIPsCxKaL5mVXE5A&oe=6AE8A899"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hI67xl8bswQ7kNvwG-f-on&_nc_oc=AdrDb3iMfag2OYpnANtjQu4-qv4EG_xVsDCxJXKYRw9C9k9-lQMcVzJ-AyseFp_oPyc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEtqNuRMHbBucEektK5iJcAHxsUiG27ORfBSsOHHbkpg&oe=6AE8B5BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD7qFteUiOkQ7kNvwEeJiVU&_nc_oc=Adoropj_BBImA7rOEdNqrlmp6OEjbyZ-ZgBnadfNpVE0_RcFTNn4j1ak8k2K55NtEZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKK1cr3RyQ5eRNoasTc6UHoUAdU0SXG-3frLTXOfgFiQ&oe=6AE8A406"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_apLIgh9F2gQ7kNvwHjNND8&_nc_oc=AdoiufpBOcJY2Dakx-FgPLpqaLR2ShuYxlhHA_I-FcZAlLFglC_tk9b2Zj33K0hvvng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLaIxcH7mwQRXR9L0pdpS7EgdtGsHVm8QBihaS-u606w&oe=6AE8C10D"}, "is_concept": false, "is_test": false, "is
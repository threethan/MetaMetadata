ry(1).png", "id": "1597882337996056", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdqXBbju-M4Q7kNvwHf4m8F&_nc_oc=AdrQxbSPUAOqtKU9O4muYN8o0YmeshaOgD5kv-X3jRWBHT0S0tOhmPLyad_6XG0GFJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT7iMZiNENZKy9VLySQ_q5G9Vgz2WDwJ2_HnX4EC_Krw&oe=6AF74303"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FadGNveBqC4Q7kNvwEaiS-t&_nc_oc=Adpfk7U8eWaW1nnIUCSItF6CeroK-_J8hQ_Gzs8Ez1E-At7I8DjcIOTOqN5X1Hx0lw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMcTaf8rzGvrQcfkP3FvbrPIeiblVvQfBqBPyuAU6d6A&oe=6AF7141A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o437ZOsd5JEQ7kNvwFXfrDi&_nc_oc=Adoa-9tbb09empqosmPBcQ7bJb9pMfk4VaztfoJk9E4WN0A9kiS_AA793KPq1VlJNC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2RC2Ydr1Ve5RhoZBEm50NlkYpv8sMi4gx9ne0vJBa0w&oe=6AF7244C"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3kgwz3KaiEQ7kNvwE1k2eS&_nc_oc=Adqdcir4hsHw7WNMCbolmFI52WIpGKfNCmdraab_5Kx9k3Lo8RktJsurLhz9IPoYS4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBs_1zur_H7BI03e9rIDYRr8k66OWXJZgLAjzLomWfRg&oe=6AF72919"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kctHGLPKHDQQ7kNvwFe3XrI&_nc_oc=AdrVfTtOuiBaBOgdK9yk-FEMakkMc3abYkNOyXDHD2DDjjv-04F65ZMAv2X3J1GpfpQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZxQ0he-7uQKhG2hLzuAQ6qMgL_UvioeSiPGUIKRdBOQ&oe=6AF7363B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQgXZEFH_8oQ7kNvwEhl-7U&_nc_oc=Ado_DQB_rpXDa3-jA8PwiXEe-1IKtZ-XvWkUC-LPprJ6BAwqXxdLNg0wF-HVDGrWMoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnjzN0sO4_tXKP8_jiJt9aSFtmMlqewW3HjUUh3QV9xQ&oe=6AF72486"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lAhHvaF810Q7kNvwHQ6lc1&_nc_oc=AdoTLM7UDjrsO7Pr8vIXYuDFw0w602ZIUlLt5_RwqQRkb_Ok6nM297pRtSux-OEKqp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOJft2HgLjILnU4I1z6RA7Dtiq51iwZYFZ3ri9hU-Bzg&oe=6AF7418D"}, "is_concept": false, "is_test": false, "is
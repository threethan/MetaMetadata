ry(1).png", "id": "1597882337996056", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1597882341329389_7733824754561741658_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C80BFECDAQ4Q7kNvwECsk-e&_nc_oc=AdphdsYAobTOOXDZFOLTEnf5OEHzGlMaI0x6juIfw6DQtMBISxIAkTvleMIJCAUufMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAcfju08CwK6EZ0BjveTk6vVw7Fz0DbP6doAnNk7gRYQ&oe=6AF4A003"}, {"file_name": "Warm AR Art Gallery Living Room(2).png", "id": "3042396239434275", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_3042396246100941_3649808362225203025_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYYOgi88kmcQ7kNvwHTcJe6&_nc_oc=AdpYgp3Lx2fWNNfo1lP2cduZBFAjo1re9LiYTXztGA_tV5f9pYIpBy4N_ojw5F8wYZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWPSliyTm2FUswjD5mlT2gyBEF9z2Tn9yDdzYyErQaFw&oe=6AF4711A"}, {"file_name": "Warm AR Art Gallery Living Room(1)(1).png", "id": "2090226231616129", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2090226234949462_3661144358719312257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaNP0qcaR7IQ7kNvwHFyAgy&_nc_oc=AdqXz0yp2uqUWs9l-wGgbVblLpSSPOomjOKVwg_V3h8wn5BfgFteH7xV96faq5-MwZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP8_aUg1XCN1oOcaMEpUNf8T563wn3y8KOkeZfuESw5A&oe=6AF4814C"}, {"file_name": "Warm Apartment Art Corner(1).png", "id": "1616220006712383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_1616220010045716_7181339922824717800_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1cc4xC3Cc8Q7kNvwEx0Ebp&_nc_oc=Adq3ZzXD6jCIkMNXxUpArGTOd95O5wf8shnduv7r1ObidagKv_gdXHcOeKjlLGyvAuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2jMc6GnD3jPa1EiTcKPIdbdBqQ-f5QI7Nla4cAlcnVw&oe=6AF48619"}, {"file_name": "Warm_Apartment_Gallery_Corner_2560x1441.png", "id": "1642389667465179", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1642389674131845_5378938659006821837_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xacYJzCzB6sQ7kNvwGynHxj&_nc_oc=AdqsEOBtdzKKEfBh3lN4urlTZZAmGABKggM_j_H9te4r1-i3F_S07yJG8InGXPv1QJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQz9roxi9nCghWh3SmdSFh8uYEkdT3FfhMKcxawimtRw&oe=6AF4933B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bronze_Portal_Exhibition_Branding_2560x1441.png", "id": "1421728893379567", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_1421728896712900_2693473024792964989_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQgXZEFH_8oQ7kNvwG-mpRR&_nc_oc=Adq5PAw4OQSSA1uyDPmuU0izsitObwAMi-LNUnIKdXYxTkEvXSpRtsufbxgGLxTIutg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBqNNkVCyqbCJmGHC0RO_80WjEuh5_TD9HkTM_aCMZIA&oe=6AF48186"}, "display_name": "Exrbition", "keywords": [], "long_description": "Exrbition turns the room you\u2019re in into an art gallery.\n\nHang a collection of framed artworks on your real walls, then wander through them at your own pace. Each piece has a frosted-glass label beside it. Step up close, take it in, and open any work to see it at full size.\n\nFEATURES\n\u2022 Mixed reality gallery: frames hang on your actual walls and sit naturally in your space.\n\u2022 Enlarge and explore: bring a picture in front of you, grab it to move it around, push it back or pull it closer, or dim the room to focus on the work.\n\u2022 Audio guide: tap Listen on any label to hear a spoken introduction to the piece.\n\u2022 Hands first: no controllers needed. Poke buttons, pinch to select, and use thumb taps and swipes (micro-gestures) to open, move, and flip between works.\n\u2022 Guided tour: a short walkthrough with a friendly 3D hand shows you every gesture.\n\u2022 Pick up where you left off: Exrbition reopens your last gallery when you launch.\n\u2022 Relaxed background music sets the mood, and a settings panel lets you tune the experience.\n\nBEST EXPERIENCE\nComplete Space Setup so Exrbition can place frames on your walls. Hand tracking must be turned on in your Quest settings.", "short_description": "Turn your space into a personal art gallery. Exrbition hangs framed artworks from popular historic pieces to obscure ones around your room in mixed reality. Walk up close, open a piece at full size, and listen to a spoken guide tell you about it. Everything works with your bare hands: poke, pinch, or use quick thumb gestures. No controllers needed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://adair.lovable.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adair Interactive Arts", "support_website_url": null, "website_url": "https://adair.lovable.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127640869744553"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595133382_4403822126595596_6664104242890540703_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lAhHvaF810Q7kNvwGzYKCP&_nc_oc=Adrzs7Z22yPEI8PI2UDuHPYSxFpF_ErS0EK7PyuLqWC3ivN5Jt-DySeR7FDdaD9KedY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0V8shitx4BMWAKJuSYSUKv4r1XsDzl6nSys8MCjNE8A&oe=6AF49E8D"}, "is_concept": false, "is_test": false, "is
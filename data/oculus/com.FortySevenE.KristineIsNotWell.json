41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWOSP4rAdJoQ7kNvwGDDUHg&_nc_oc=AdoXkWPLfPEdSFiYBqgkx2owLNpz08duBhSJadoW61Qhv5a1kBGpJQB6v2nMMP0FB9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kMMsDk-X9gYlMEZLjOSNUmVh1JkjMzqbdvyn_xY6lbw&oe=6A05E01C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkOk_MNlp_cQ7kNvwGMXzF9&_nc_oc=AdpW_7q9YGY6RXc_5XzMTCU7r8U4OgQRRbutZs8Q0jDyZlShQOtOCBUsXG_2hHz5yIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_z8067i3vCKbMqyIFV-hn71CZ5IZVKRme6ZjCi0z25g&oe=6A05BD14"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76pAoaf20tsQ7kNvwG2XL0P&_nc_oc=AdrbE9el6tJ09NiYX1EQekq5RmSlZR4GwZZZAiwhi7nq0l596HD8RK14bJVfFhciVZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LNs6TmSgqIOiumiUNR9kt6HQw3fJTmUQfixG3oAQ8tg&oe=6A05DA82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vLIewKY90YQ7kNvwFl3ibj&_nc_oc=AdpPbPJvV9eAAZvFHXAH4jZS4EcyQ1QXjOlio4MQzMdVeMQ5ybXOxJW89ZAVFpzNb_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yAAuQYkhz1Yoq5wBkwWnpv0W00MFvu7co6h16fxPIFQ&oe=6A05C6EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e__ZFEDPkAQ7kNvwHq7qW4&_nc_oc=AdrjIbeMkySGdOYwnqsBrU3O54YC2FqKQsjhzN5x7Pm3xhbewxIHx32IhK6oB2HhnSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uwN3tR9PvfXN10spy-OLmHHSI-gGLJLRj8nAefU4faw&oe=6A05D05E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFIBvdwmAtkQ7kNvwE8IaHJ&_nc_oc=Adq88MmDi7iOp5Obfw7AdkScWmsvEGdR0CX6gf4GCznmGXtZcJoY9C1TxDz2_gOFBx0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Gj8YvlJedgPjCalfyA6lnHWUtNDvW0Q12V26zKZDVQ&oe=6AEC969C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5_FEVK8e8EQ7kNvwHGwd_8&_nc_oc=AdoR9IFBDfv3EEDdxONAjaRsprfzNSm0F-rdNX4143p4t5viLtAooa5f_2WxgahEqwA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS06BlC4MnSlWj0Eky_Sz1lTCcJaPT3ltrwVloWZfcNLQ&oe=6AECABD4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUnc-VyZ07YQ7kNvwHy_h-y&_nc_oc=AdrRE6H7dzBjoG-j9tMQIeqOpwnzrieHHu61EK44GBggJhlECWy3kKzlifi_Kssnk4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO_KuaK6f3XeMutF0lfahmyWYfkxF6zbjfEw4sBinooQ&oe=6AEC9102"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAjr9Iwt904Q7kNvwG4uCUH&_nc_oc=AdpNE3vJ5wwE0REyUTfz0sbGNI8pi2nbc7DIF4FHP0wTIQdDwauqPCQ-xeOqsuVhwHQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPZsGTLU0QUXrAQ8Qo4CKPKj1N42xt1oA38cpKhxNPBg&oe=6AECB5AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e08l9Acza0QQ7kNvwE-8uDF&_nc_oc=AdrxHxBOIHRpupL2GeAA36FqtN-cxgj_8MwvTTkWRgIQFSmQLb3iHJONJbbpUlDlJdk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStbiMzHbKyWP8QPwsz21u63MoqHAWJnEVRicyx-7karw&oe=6AEC86DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
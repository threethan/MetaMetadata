41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9s1eppF8Br8Q7kNvwE-0Jnr&_nc_oc=AdoruhV0RqTAV4HE8f2KchiWXv8fodaPzobI8e914VfVuN2CUF279dC-F5pSQC3G700&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_aMS3HEpFaNkYhnvG85xzdsJLchZdUZNyrnRb4qriFw&oe=6A4FB41C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUmG_8wVjawQ7kNvwFg7Ds3&_nc_oc=AdqYaOwdG9tOGGRNqJPt3PVyTsP9YwKPnoojM2xIZUB0ZM44EchB0ENojogQaqL7ivY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1UUK0JNztxR--PCOJ76Va2lIvb_AweY3URfPbyAUFgw&oe=6A4F9114"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HE2Hz-He2gQ7kNvwHHIk8p&_nc_oc=Adp2x--LCBgUMXJCwYVGctT4dG-xzxDj0L80uA6wZKECeYMg0exyubRAWqI92fe_Vcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSgYfwx0CUByKNBtpqW6cH6U9WJ7Lv64Gm0mbLlRV_yw&oe=6A4FAE82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o92apNnYMr4Q7kNvwEyNIWd&_nc_oc=AdouUbaBmBN7haZci7ZHwdbymIyxLZ3pVMw-weT-CPFaxTdFf5GvhtC2vnLNJDDQejQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCowFvXukYmNPkZngVxZAGlAaz5QsSMxP-CscgpS7Om6w&oe=6A4F9AEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vR8j5vCaKGQQ7kNvwGt_M92&_nc_oc=AdoyZDBHB273UXb9CsMnIako7WyDld_1BwHrhMnbEhBOdl-A0TXGhJpnE3JUfJPeHKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYw1cszaeI1k_5PRkWzpxXqnsVrbxdwgr09qqfKst9gg&oe=6A4FA45E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
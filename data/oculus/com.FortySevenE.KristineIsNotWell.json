41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX3s5EQOFxgQ7kNvwGWbRKn&_nc_oc=Adq7ueAw1rSkK0nBbrZL_C9Ztnh_Sb4hc4Ond8jCGGWFNlMVTl4xhW9Izji5QCaOhjA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGlQgi5MZNny2OLPbRFHTOnERj4UO2y5qFKWYqLcrdKQ&oe=6A9AD99C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9jPllsge7YQ7kNvwFY-2HH&_nc_oc=Adr-NXCr7bJJpjre4chTVseAXBaorTDDMP60O9DoHsja_napfSvxeiYY-7pZrhbfNxI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSvU0um7kO8ox06T6GP5arBtucFX-QlMicTfR3xWBMBw&oe=6A9AEED4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWvwou-iozMQ7kNvwE4mhSi&_nc_oc=AdqpVd8nbKAESuFVrqiz4KQkjGIx02QJlVX5SJkrmOwX0YDK1XeGzPdC1BpHXhpswrs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOXUonJD2LvIsmmg9rzauVRVBgqNVGlj5hc-RlZxHE1A&oe=6A9AD402"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGi8VTHLtPcQ7kNvwFU8JkG&_nc_oc=AdopfUtNt_wsKIs39pe30-zZdf_oqlQcThPRh69-0BNaAXw7EE2WUZctDfHIWDhOTPY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLANmEBNEjgbU6ZLesscBWSJSr4LrCrYvnFUZoUVAMNNg&oe=6A9AC06E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tc6kkaV_JakQ7kNvwE0itnq&_nc_oc=Adpm4Dqj98wUQ4nVfL0GWD16CwhoDs99V4UB8FVUjdPTl5o2FODInt6EdIP8iPxuktA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu1pLz8tkT0RJX2ut-VDICvaSiS7lYmSDyEDptAcIeGQ&oe=6A9AC9DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
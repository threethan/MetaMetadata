content-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2YbXGQnPdEQ7kNvwEw_CfX&_nc_oc=AdmPcejtztETpKKYsKxL8G_Z32to8yb1pFI1rKG8xHMp_dapNP-kZib4mvJXOdNPZog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg2b6xfh3F3lfQXOZzp3RWluFQTevqE0XWysE3TB3sbQ&oe=69B56F02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn3C4K-UxXgQ7kNvwFh_CqD&_nc_oc=AdkUb_0BzqU_yyytEJn-GPUyUYZoIg4KuHJpu8P1A-KXfNaSJaawkvL-WPzPZcDAlDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeU1zKDDQ0jAo-mLIGOlrnXh9Ldis4nfSwkn0wwnYSIw&oe=69B55B6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqYHb5nGxdYQ7kNvwE87bAr&_nc_oc=AdlZ0EUgUyIaLv_IrWhMLo5Lnc0B4jaVfGSJ_yfCj7ZISNWKWq-0hMtixzHrlASbh58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTZmBCWveqkMWuiWcFunWxN2QKdX188xqxTuDuW7VoKA&oe=69B564DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
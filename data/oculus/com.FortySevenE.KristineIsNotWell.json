content-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHhzC8jz8J4Q7kNvwFlgKQi&_nc_oc=AdnAcXkob4GJt21IIoUu1Kd9jwrQO8IynGcbZaassk2h3fYQKQ_9HtpDHtPLljDtOX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwU4HE5EZHaXWs7HzT-vC5w3jYzDdJY-HGFXHngcdiMFw&oe=69BFFB02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I1Z5k6Zv2YQ7kNvwFPkGgs&_nc_oc=AdnaDnu7BU2CDaqaaglCCKci5MVe_VG3UjLG9IW6jPv3kG076FfZKH8n9r4DMy17cng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1E5UdyAlIrK4HcB7NGMVTsf3i8GRqD42OVFMy2jBs5w&oe=69BFE76E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqlsabT5LOEQ7kNvwGLG0sN&_nc_oc=AdkZw9CqunR7j9oZibMHhfRgOZnEWNMYq7nU6PRNIf-2KPwDD6Tcqg0jRIwBIKXhjTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzAhZb0GyxACnmf0cIN5bPEFqHvuin4w0eqjrQoq2puA&oe=69BFF0DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
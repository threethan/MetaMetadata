41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdiGIk4rEQIQ7kNvwHQgs_4&_nc_oc=AdqvtqFoEsWllt7HpEBXq7kxPdA_kCzp9Vv8BXUMOOgTkrZ-D6czW6-feRl3yi6KiBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhtsHLl6z854AM_xPXNg2_p5EuLtNH-RpDeSQrEyW2jA&oe=6A82E65C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv6SuN6VOsAQ7kNvwF8Qy7c&_nc_oc=AdqH2lNMPs1nsriS3Cg7yuoZWle_vbvHU9o6Rzd6Qkd66KklnvfWoKGnq-RBYexDxzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH746iPVQP5Tm_TnT70YngManNnrGOV868Sdi5MaIauMw&oe=6A82FB94"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elOWghSKu6cQ7kNvwG3Y-YU&_nc_oc=Ado62aOuRDif77MVr1H7OkRfq0U1EYC-XIdU1TWRrbmDClFr4KMLLiSXGGgJT_Ll_2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELGS0rffn0Mvb3p8l2npRbX46LRo_2rAeHe2i7DSs0_w&oe=6A831902"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97FZXQX0500Q7kNvwG-PgzR&_nc_oc=Adro5sXI6fNIXVtsrHmJyLsTqRSPx1xblp4J6cZ6WZHu5YrPuse-74BU-fyCi-8IcF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa7ftTWUzb5-oTrToGbOGYPSFqpbrUgfsXFberSshoIQ&oe=6A83056E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVLBFWZcHw0Q7kNvwFoCj8b&_nc_oc=AdomORuoiyg9vYYUTiHhqEhQDlHkgFgRpEcqiD-AMaQvUHFRkQZRDQ2jRWzoCD8SH9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb_wJV9jp4SdQCF1TmJBtYIWGe09ZL7sWeAzOj4K4hrA&oe=6A830EDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
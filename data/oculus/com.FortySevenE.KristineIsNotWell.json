content-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKrkm6tw6N4Q7kNvwG-ktPk&_nc_oc=AdlD4f1BG9xqBSc7s08NHEsEct-xdyqR_s9GzoKI3jV7eWBja8lMrwrwANGP15CcoI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwywPQJ9vLO-lg4IMkuyWUV34iYNEWLS0Zb4gwsIDkkQw&oe=69AED782"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi_YSAcEEMYQ7kNvwHMl61I&_nc_oc=AdlZcnCQpLBHr0Sbh6QvsSZmdt4HMorwAGcsddQUSgXLZ6BlbIdjq5b-qYejRBSHosA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPJe-b41Xpuyrz92qkAwseQfcfQHNrc2hKv-q9fPIV1g&oe=69AEC3EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djCHUyvRf0QQ7kNvwFuR-YL&_nc_oc=AdkiJgEy2JbZ7gFU1xbD8nNIgZBmPfvXJtxuJiZ8JWR4QVpBcoc1PmuwsC6UHba1RRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlpYC200ISOLYjL4aWQsRqJwv2w-O0WV9lzV5oa9uPrQ&oe=69AECD5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
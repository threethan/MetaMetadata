41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzJUY7A-2aUQ7kNvwFpM1oW&_nc_oc=AdrDNiOKiJnxVZMODg5BSVhqe7gguR19UNUxXbx-NHoR51hA7E6KO457X71K9ik2778&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2Mp0omfoq6jZsKY5Y1WGLOwyo6G7W6G93tZgdMbQ7pQ&oe=6A5A401C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBGEYTd9AmwQ7kNvwGS4l8q&_nc_oc=AdqMKChMIexEMJni87tUZ5nWZ6lBQ95OCV78YB4tyJ6fnVcszBRou-j-TlaoIl7bWD4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI-qtR1wpwdMMojvbvmilamQ_ELp9cFML1LONRLANmhg&oe=6A5A1D14"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kq0h7zfQfSQQ7kNvwFULCbT&_nc_oc=AdoFdyxYL9FWNXg7TWssozmZs80xLVBnoh90NUTFa7Avm4TZ-JKtriTEMwomKJEKhdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgIv1m6h5jlRu0_wgitGaEOnGZmdhzb-qycjtODJ74Pg&oe=6A5A3A82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBf2Hdq_BW8Q7kNvwGhXd9H&_nc_oc=AdqTlLCZBEek65U89dx_hQ-JSRRoWK4gugNlYkmgnAjGEDeqYkSIGtq018G7yHieDPs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK3lUhaymJpinfswX-xu_YjM2XSJL4S97rzdnKseLLUA&oe=6A5A26EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up-Es5KcdsEQ7kNvwGkz2JS&_nc_oc=Ado3I4xjLKh7seIGI7cA8-TVd6p-HfdNy250zVCDCDVo0VRt12o3iTcwygoNKbgcjO4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsFyKmgvvw1cvlE8eTtOnIMhi2WhA9GA2nlHJA45sa3Q&oe=6A5A305E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh5bhgq2btgQ7kNvwEZWa8O&_nc_oc=AdpCQ0o-ZLpBUH2VUxAxUuEWheTs2wBTR0QUbfqqfHr1__QgZBOVyFqOrz1w3FGhx-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtpH3SWc5j_VR8zr9RekbIunNtwfv1wdWENpm9bLtUXg&oe=6A60D79C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAvqyUqlmcIQ7kNvwFq7QJY&_nc_oc=AdqVCPqnDaS0hnFGHR9kTXWC7HsNXnLZteNFWeuZhWhI79O1d1ynFKlEliuTUDrXtT0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvziYTTa3hNZU-iV1ykZJ85lrRbSzXjIQEkhnqvKnOgA&oe=6A60B494"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wRPutf_HPEQ7kNvwE3Tq4z&_nc_oc=AdrtOc7fhNztXtQbmN9mRHUQLDI_2f-8iq0XN8Iq_T6F4-3T06oTVNH224Zr21UVMe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-0YOyuv5SVzRNB_XsnkGWtgqQydZ1Zqf4tvGzdqWU8Q&oe=6A60D202"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DnWXEk4k8AQ7kNvwGQ1r5i&_nc_oc=AdriJPN3tEO_CP7MO3HLqVnJN10WnNxJtA2lZX8JDQQbvZuGRXIHWx8LIRPInC2aZ-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAJtH-FnqqroHMKYugT5DvH5ApF0le-TfUGG06PmWF4g&oe=6A60BE6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKXdwUOQOJ8Q7kNvwHGvQu5&_nc_oc=AdoVxxrBXCTR7Cw11ZImNsnKjivDzyI75JWwmEcl6n5kttFtGW-4C7xUMpJCFhSB-SQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn_IR-LwpGEcaTwETn2UesZAUjHyLL_1VJ0zBBr7IkCA&oe=6A60C7DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
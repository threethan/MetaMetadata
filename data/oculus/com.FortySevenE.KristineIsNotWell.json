41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efNPuc9eEEgQ7kNvwFMakhq&_nc_oc=AdrO1O5Q-dIdThU764hnQKZIEKNvKicY3jkCO-6TfkucAvrheRElEmksCLyTR3xKwJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ru-bh4hk0pyq9_EqONlxIL0SL5ExEzBtXDnP3C4T1xg&oe=6A07319C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDI3OnyQ5FQQ7kNvwEDkmJ4&_nc_oc=AdoSZPKgpjeKxsV2LijML9_RE9C6GSytWKPAKcmK2f6NSP2fSp-batEYbmVoIsh3SaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ur2Jaipxl60sC-wGZkKjzOidxhr0beu0VJW84tFe_8g&oe=6A070E94"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76pAoaf20tsQ7kNvwFO3puY&_nc_oc=AdrvzaOyR_3K-MD37ZeDJZOGhQzUCtIcoLG1YMG7FSZF2GEVKuI9TXrusCJR5Z3Rfrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6izGIk9LujnL3PTSAu-y7nsSeu0-K7X7sja5PFf-zDdQ&oe=6A072C02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vLIewKY90YQ7kNvwHJVNH6&_nc_oc=AdoJ250ozRJwp_Yru5BO4t5T3S7IkOdtQKU-xt1mPuc3-O6g1S5pAJlfXVefFwxryBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pi3fTGUQ7h8TarXWXwq9zwfqvDh5OaLdrPptiABeY9Q&oe=6A07186E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e__ZFEDPkAQ7kNvwE7HYdC&_nc_oc=AdrzAKXhg4NqhS-ROgvWPq9r8Tr9A9qqM9Lp5NcS6SvhUx-fcGWqgslN7ruohGXUYRc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rk8VKM7pJr1ve-Ct9tACrzR7SKQO5CVONHivkdigsxw&oe=6A0721DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
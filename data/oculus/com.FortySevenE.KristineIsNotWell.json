content-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IykSa0MCzu0Q7kNvwGTeD2b&_nc_oc=AdkooQtOQTQZBWARJA5157RninIQxJic3O20oc6IBGe23vomQnPaN-BeNPFjTrbdnt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxvj9qJkDd063ditupB-9TD-ziiYe8uv_Hub-AV7yyuEg&oe=69AC3482"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ6-QvlTo1YQ7kNvwGwoqEv&_nc_oc=AdmKp68zIiTjA4iLtCG2eUemoTR8PVlQ5NCdkaJkfOCz_TuK0RJ2EZqhAkM8oltUkUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxh74Uy4U1a8lTpNlscjiyORy0TJXDM-J-T7qGp2XkcAA&oe=69AC20EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO1smeYc0JkQ7kNvwF7h-pe&_nc_oc=AdnTqJEd4ZSH6UQvyR1wTjvneW7dFmS_jvr206SWGl20eaXM_ImQBFoIszKds2m7MSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLB80U4gvn_U06DN_kKTiRMF1fwfGaMJsFa56DwQ5Zew&oe=69AC2A5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
l4LX2hi4RuP_v3beT-XFL1KLRmSrJaWVodYpbx221VD43U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGDkVYRDkw_PTSblSxhDpvs8gyyPgMhv_IcQAyv_s0og&oe=699D815C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8BY6xcyjJcQ7kNvwED8KOn&_nc_oc=AdmQ4ao1-b3TupLLTfvfmSUpoeVmRFjKE4vz6owaE63XOKy8gufRzkL03WGWcj7uBDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGv1PZlfrj5UleoOa_Czus7NIPCOaPzMT0jQmkL9cTOg&oe=699D9694"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ63fGAwtaUQ7kNvwFAycc5&_nc_oc=AdlbWooQkwSJoLBBnC28szio78_9t4KbPTziciGpMshx7BUbgnteFbD3_sG25L9EYFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvOTPqs5hyc4ov8PI_oSfXJPQSeh3lTNJy0mpVzvhdPuw&oe=699DB402"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9in006baHMQ7kNvwE4z5JR&_nc_oc=AdlDBTLJffKkSab1KvqeguHJo9u4QZmGeeU3aRVCDOXpKBDgYWowlQyOTzSVKdXMie0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afupvpy_2OSBk8Yu_zwAjLI6TXUwfxz9LK0kDA3nsXoYxA&oe=699DA06E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWOQO5XwUjEQ7kNvwEGJtUu&_nc_oc=AdkidDlx51ifAZYmSc-WUjyV5KSg3cP_Cr4W2OSTsBwRGpq5-3gWW2rli95l05jnPlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvsrHTKW_8NSFAdbbxaS5pzyjPvs5_DXbH4ZTAoghVDLA&oe=699DA9DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506604041656825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75367594_2007167629674893_263573157436873239
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eGO2EKdy94Q7kNvwGwRcVt&_nc_oc=AdovcaiwX22pSDgBL0r78brktOra_ggtXE2UZqJqsnt7OHXGqggWaeLTsnmVBRL-SdQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwkcg_OuCNBUlZYL-kUbhcRNSVbgEch6wuJ3lyTwrDwKA&oe=69C3BCDC"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fQI9I6MLg0Q7kNvwHAnqTZ&_nc_oc=Adqsx625kaMhvPJg4KdsOgKLHeyrLajQHvncDeWCion7M9ot3sHWl2SzujgUgUm963M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwe6I80yhqR2eTtGvRGj4fn87P9nFta51EgpRBo7evspA&oe=69C3D214"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e84DPYSsdi4Q7kNvwEF2fUZ&_nc_oc=AdovwuH9Dfvp5_6ytTVzOpySGPIJ3TMHY8TTdZOptoI6ANm-9Bc7ZBpv1z_WdswWfJk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiYFYv7hRtYGhzEYixg4U0m73iXLqCGc0ki3O6ngro6g&oe=69C3EF82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhnPORrf4v0Q7kNvwHjbgXw&_nc_oc=Adpsz9E5DJrBP90f8KS-e-cofTJw2rv9IQObjE0_pjxykRSaPr6ViHHUBW0GXZjW5y4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNCfsZ8RTIc954O2MkTp9FXrL_GYZcrz_Ze0kH0rEjpA&oe=69C3DBEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vwRuOlSfhUQ7kNvwF3RZj0&_nc_oc=AdpcdB3Lv3ZUD62uI14Ps0yIILZip3ZWhngJKDDzesYqQWssOOkgS8pHVlzemoIdCrc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSDjBO_j7YsPFQJ9x8sd_Ck6NxNKAm3BvlWrEEiDKrxg&oe=69C3E55E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
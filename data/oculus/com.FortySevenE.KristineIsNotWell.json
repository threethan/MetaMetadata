AD0FC54"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-muJYVGU2FIQ7kNvwEhxeVe&_nc_oc=Adp2K7hCcNt60ubsoWL58BEZmbhird70h3EpTelCqPQXQ4sOd9Bopu3s-TMRpjKKPrE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhHkqoF9tLQGs1_itcjIXKs_rElzsQ01N4lF4Eg2dUHA&oe=6AD0E182"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61Nu2QPU5nkQ7kNvwH7VN9U&_nc_oc=AdpIgKW_tFalAPW-FpSQ-MBBvabaATV4x_FERvTSZCkVmlEHSWxPPAx8mqtuVj-pSVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVz57u9aRbClerN-CPYiPMwpcsD-r1hl86FOpEf21DTw&oe=6AD1062E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_30dh7pNhkQ7kNvwFqMqUO&_nc_oc=AdoK84fbPA47EobvpajxyOiumKajY0Mr95odw2iUkb8AYqfDa8lbRjEbEEmGX2ijfgI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAD_N1M5M0JHEOGxQSiPqRy6CgWfnvTMqrmcNYowOzYg&oe=6AD0D75E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506604041656825"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "233915086241175"}]}, "baseline_offer": {"id": "233915086241175"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1689093370, "status": "PUBLISHED", "id": "233915086241175"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6403930626365454", "version": "0.6.7"}, "id": "1667665873616706", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5447907948634398", "
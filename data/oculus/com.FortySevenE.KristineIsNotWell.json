content-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e84DPYSsdi4Q7kNvwEIY-Yq&_nc_oc=Adp3CcA6lIQmaTgMaxBngph843EX4tWHH3bfbovqe_MDGfXIu2pSrJ27SdoMSuvUjLE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7BAKXAfF4CCBL7e8dbDggl6AsN5xZ5sBnVdt5Q0WWEw&oe=69C14C82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhnPORrf4v0Q7kNvwHJ1XIx&_nc_oc=AdobVMCankRsD4wpm4ZilQYUHSDtQ_zLif1Dm3rglrK3-n-VAJxid04BAAkR07OJfh4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhoVOPuudm9-05omE-CdrGkPfqCnE1NaXOqqTDYufdeg&oe=69C138EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vwRuOlSfhUQ7kNvwHDH3K1&_nc_oc=Adok9u0HvdaoDocgJAPVLm-8DJi8v01-pj2Af7VLj-b7n620FFxorcO9YPCOP44waxs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwyvmMcw_prpvpEBhMyR3u0GbbkqIMJUMTBsKVbv3ARg&oe=69C1425E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdxhc4xIRIoQ7kNvwFeT1AE&_nc_oc=Adq1KkX3tJT67nYz2Qiq7ImnVaa8NKxVwf2NnUYW-71T2t-dOh29oJwViXr6J3-tmCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dYqoV3Vt7hdLaQ0WGz6F0Mb8LnAbMR_vlhNtYwk_8yg&oe=69D2759C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ODWN4wNY7AQ7kNvwEcML44&_nc_oc=AdqTx8LZI9sImR5TQclPePRk5F0qbNHrUGu0Gc5mVP88ihBBMzNm66HjjEpJz6dXxBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14pKojDWWZlxsfJFJxceLveoW_uq99mB7PYwb2SFjAoQ&oe=69D25294"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZVAr1IcqJUQ7kNvwHJU6F4&_nc_oc=Ado2xGomrY6CcYGJliJWTG9YdzZH1BkeE8lqekVVzyfxoKj79N0JWQHH5BOEWYzjUNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34qhoWCPd8wycklPditMAC12mq-S7TKc8tU1J9wG-mQw&oe=69D27002"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu2kDd7eZg8Q7kNvwG3biw5&_nc_oc=AdpFNQ6PKM3Ba9Aq1mXRnu_OQUP9ApmDYh4u5zt1lXvc7HZ7afhszpRM9NT7J-Mr-d0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E5jH3aqNjKzQZlOMTYOQIA5sXKQ8ovOkszhg4EubRJQ&oe=69D25C6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KFglmC5wDIQ7kNvwHmKUGA&_nc_oc=AdrDQiX6r1o_Y21HknrDXSpLXGP-NX8Llj39USzsjqg0SC3kOzRgWlirc88xW0yiuh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hcfjP5kZVzPlHzhHmm7wMGX8wuWqF4kAC506OTralcg&oe=69D265DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
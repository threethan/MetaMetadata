content-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAsGNrkRqs0Q7kNvwH6h8xk&_nc_oc=Adk69hxvBSOqlJngSLdo8-PRFoShMaac4CSjWtRsqpQEahVA0KEidCBvHmIrMORY3J4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzT_OHN8fX_MafV2z5gLt_6JsMJ7c5Wxu35TA-0pmGi_A&oe=69B96382"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsCnSoZVUoIQ7kNvwEdNeOi&_nc_oc=AdnVgzMfsIODbgxgTTW3dzYh7xamlC4iQdRaSBtwFBhZadCQ3i9n6FxSirtS-1LpON4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhGBscH6cFS99m0E64uOiXEMtP6yBp-qGRwtKE55RkwA&oe=69B94FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1JSzXNZQcoQ7kNvwG_M4-Y&_nc_oc=AdkBQgn51GIifmQKM5-_NtSHO0z750XktXUrd1A-yh1BCdubpO4UDoKU8ZCPA-gf9lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTZNLDSnrkA3xbuFRGhDcHI54SLPLYwNS-A5-RWl4DRA&oe=69B9595E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
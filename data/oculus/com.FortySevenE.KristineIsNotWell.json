content-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cjwdz-rYWUQ7kNvwH7VYTi&_nc_oc=AdmD5GORmjnpSgXEfVjzvyfH46mwVKjIlH8qdsTzWv2RqqeWwxlxNiy5Jsqh97CnF-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afstq8P1nqtht6m6ORu15xMXvpy7ypAslDFCIiJkYgHY2g&oe=69A807C2"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWGU0mnpcQgQ7kNvwEr38fe&_nc_oc=AdnCUOgejy3jaKkQ0Y4-LMKWfCXphGUD7lBKk2Napu6tlBdIqMjExOMlnlhpm6d0FJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfulL7Qg4bXLKP16x6uZaCNMy6bsqdseWQ2cYfrgt7Qztg&oe=69A82C6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hyDSUVN6k4Q7kNvwEvOdN1&_nc_oc=Adlrw17Qnb51kHrJtwXtGI87anQIBtM07pDarai7kkzYKh04W-Ny5lHR-SduRoc4DCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuUdm5Rk7XFElRsuK01bjLf57H41igREZnSjdR6Zgsy4A&oe=69A835DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65N4mox1_a8Q7kNvwEu65iu&_nc_oc=Ado1isL8ND3M6xJxq34S_9_tAp0QpkbGo7ig-kip5-ulamPNIQusy_nr9_iwX5ieBRI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-xrF-NrGSG5_xSyqDgAhKvRwOCuuEFjvypfq2x0mg6Q&oe=6A1C499C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSOnrS4K95MQ7kNvwHqJbqu&_nc_oc=AdqIDgftb_7vsSJRmM2JuogOzP0Z79_qgQNwnV5bR6O3IjQo4HI3YDHR72FDBhYLLZc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H9BVRng0yRuJ0l13IhrjAwOMoX4OC1hFi7i9DmQ9nyw&oe=6A1C5ED4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ6UJl4kgpEQ7kNvwEVcQsv&_nc_oc=AdpNKLHy1-PUgn_QfTI0WvOkj26Ub_EfDXFbL0LkWXbG0WzDsHKf8O3Qr9NIlK7x92s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EMvj05vLIgM56FFnJ1Na81BCfRHaP7ZSm2tC-pj5uhw&oe=6A1C4402"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn4S6bXS5f4Q7kNvwETrnwz&_nc_oc=AdoHoj9WPnAX3S92eJxaGw59l8rRCb_tUjk1s8Q3ineQ2JrPe4fXroxJLpBE6P9hQdk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PLjlHMSBe6kYT-JjGQYhXH-fmXGfLdbg2SXbgxYREjw&oe=6A1C306E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve5SushU-toQ7kNvwESCGC4&_nc_oc=AdrW13CO8yPKMrRsmzBos7dHsQOoG9EFn4YdFUtf5g5i5PVTvYDchuQ4XlIZcY9c7dE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TSSggWFCUBLbF7Pp7R5Ob4_uTo6seIWSrNuxTHcppwA&oe=6A1C39DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
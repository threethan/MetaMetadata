41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoHccPiUmAwQ7kNvwFxGuBa&_nc_oc=Adq50_UOzJ73tt2NyoLA1Ue9xMy1qs7bnGlAcr0qTchGQ24gx128ByEgUbZQxj0us9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-671MGajpyTlVOy_ZputjFGdOt77zOjFPXmkB0EZizQ&oe=6A53A89C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m0zpklq2fcQ7kNvwG-raNr&_nc_oc=Adravj2ywNE-FzJ6UgR_AFM7bxKkYLfzVKWLha6W59ujbcKtabShTWPK5jOPz-7YdvM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsbnBP7384_vFVd1SBpAxv_ktGcwMLAmxEZEXuwdCEFA&oe=6A538594"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymmwDX1bldgQ7kNvwHR6XlV&_nc_oc=Adpe_3wTjtrYV33ZmzInDQozflM-55qwUaQxaHc8gjGZiS6q1jlO6ydKPuXBQd2ikDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACub4pQJjQGTtyMbmLqMsFHW62XdgN-SYzOMqnbT0REQ&oe=6A53A302"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AlFGYljk2YQ7kNvwFz6QnS&_nc_oc=AdowEYBumiPpDTIWvtkwkLPCgrQB-mpmJAYRwtKwSr-P7k5EuFDB4upe5mtVm_pWIF0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvtit4gcIGlDFjHslBBJowJTfZjmkTAvI2gY7j2Z7xHg&oe=6A538F6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cpw-Btd3AMQ7kNvwGuNBGl&_nc_oc=AdrJFHwtLxSg5hSM7t-f6Ur-DiRdfeimusbCS2Gfpt29p5miEaXNTlBCMwKNLWZ_vXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMq6xPZMWA_8adG_s-40-C4N4zPEX5jf7URmOt8vK6vQ&oe=6A5398DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
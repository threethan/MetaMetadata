41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7nKZjaAHokQ7kNvwF6FlNT&_nc_oc=AdpQA9YkQ1A1VjXUhImtY2Ltwhro5QsggS-iiqQOW6j4x3mvB9vpsO7X6aqPUBNEdRo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X7Lb3pTuzRHehAb3HultssF2IAwN8jcfiKPStUPaLVA&oe=69F36B1C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkBDydM-Jb4Q7kNvwEMe9-f&_nc_oc=AdpnFjzXcSK0sx_GFIdJ5eXVkpBZy4v6QYwfBjoB4U76Ty7Hp1j3K9838-xTwUcFR0A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3S_HGsk3UCMbRtdDDna5rFUq84h7QXTunSAVjsLcithg&oe=69F34814"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7LSP3vm0EoQ7kNvwEpxvLC&_nc_oc=AdptnrC1roWOl-HKeZkVmyfKcxZskBGBxXdxmu0NSjO7a-VnULNVE_wE_hSE6rjfcEI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Sk713v4peiH5FDgK3a8zYLnDgrcR_nPjlbtWEhoxt3g&oe=69F36582"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXm5YkUJdvEQ7kNvwEcbNez&_nc_oc=AdoscH2SLkLUiDqRPmqLJZbAxexpmqBF5dnMGnDV7UJSViWz2ZFmU_rJzOMnKVejuhU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1OKlLW1SlQaHQpWRHQOBEWYXo1mfNmlMCCJIeN7URYMA&oe=69F351EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ijqvbb-b4eIQ7kNvwGRbU2I&_nc_oc=AdqSZ-CBlAp-Tj2gGo9Pw6WsWcKMmBjehJ9fXpl2ufr7IwGQAbH-cVpW60m9gYAPSOc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af368CSZgRtGZL24YHnW2ftfBdavJhtP4OlyLR5njeDhZQ&oe=69F35B5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
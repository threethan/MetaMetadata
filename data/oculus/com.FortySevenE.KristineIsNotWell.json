41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7S9SiS0iBcQ7kNvwGzehxP&_nc_oc=AdoYfExLT2oo-bvW_NrU1TdrJ57nDkkK6-5nCROZmO2ZOtUXf6oTX--Ym4ZtNIrZ-Ec&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVnfxW7toMAhq7kZfQczX3vbVtyA-x8LQxdOx6pK4zBA&oe=6AC8FE1C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKlYSeZHmYUQ7kNvwFRuJa5&_nc_oc=Adq70nxhgyt7HgNDX4d26YqEIadkGDfbTd7kEUEjQbrClnIpczwWpIW-NU2tye81zrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM60rVck6cxDjKy-mGoeniFDxh7srLONaMIswrDcFt4_w&oe=6AC91354"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-A1KVuW-CoQ7kNvwGUAxOP&_nc_oc=AdpTG583e3KLOYgB-XedXmOXeiop6-0BYI5OkInQ9tH07ppHGnxvduYUcrahdPrTVE4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTGB_6dlRCKrQ95QarlIahhCLDvCnhk5zp3GT2gCaEbA&oe=6AC8F882"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkTMNJ3KlF0Q7kNvwEmkd5m&_nc_oc=Adrv_qfhi7HheB-UdjgJoLs4VV01cV_Q5WQEYmLgdLkKzLh9cP2NBqp5Mb8PJkMDDIc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbQCRVeJinMOS1Oi-GkS5U12ice_GpFgqaw_xCBhWjZw&oe=6AC8E4EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL8Qhjdsem4Q7kNvwGa7mYl&_nc_oc=AdrtUtj8ocg42bG5sDuFo2S3D3JY34XnSIgsYDsau2veIObhEc7noxsUArCCcymfEX4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7cLn0esLwhqLTMeDVHMFkmcVbQvbp2pPNFwpbQ49NlA&oe=6AC8EE5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
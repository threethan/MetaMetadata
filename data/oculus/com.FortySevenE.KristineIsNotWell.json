41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaxHo4QI4u8Q7kNvwGXObet&_nc_oc=AdoGZIcYpAoGQY9nlRKmlV_iZk-ihlTVIDeDNVKtwJVFhItOJSWqbiMWFOPioNaTouI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_uhdYyEUYsbxictWdYEofhPaaI5kzg-X7HeEgh_LUwA&oe=69DA5E9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7Aki7ZsdzgQ7kNvwGFUnrT&_nc_oc=AdqPL_vULJOQY-TeiUB94S815m6x6YcQYf_XCdOwbtuHgSOGIQ91okDyioVXSsjLddE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Zf1G7uMi4rV0A59ewBlnlWa-egRg7vEYZtvGUF1uJoQ&oe=69DA3B94"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GC7ltxhOPkQ7kNvwG_NPnn&_nc_oc=AdqG-qJ0QQpLGWyqbxglvMeeFYEOkUSQi4On839RF8A1eD-HWmvwjA6MveNaGNn5wvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ExPwrjOdpM7837JnNyY7eS0TvHZy7jF6rgsbc0Hdz5w&oe=69DA5902"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8BeaUZaq2cQ7kNvwFQ2Kl0&_nc_oc=AdqFrvMrwdwB6nD4qpYr1qhPBD8tlGrymleFn9Fdnmk3NtIwR8WSE-Q658-BTqemZMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SPkqGuMgKId4kl30ccq5HXWUYm7raZ7p86QRSz2dfXw&oe=69DA456E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v89U6YwBvHMQ7kNvwGfM_aJ&_nc_oc=AdqdMKUFcJO9JB5MudwTpceNTyEnLSBblg5RVYMsbKCWnIz6v2ZP5Vs8uiwPrAQYYXs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Po2AQ0jD4jGXoRnSeGtYUnqvcsFzmX5Y3otxOtr8IyA&oe=69DA4EDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTXbUPyQCnoQ7kNvwE4Arq0&_nc_oc=AdqjF2mxGM0NLm9aCGGX-quaIbyF2MHpzRhBdwxsCYk43a_-nNJY7LSxV7hduBYz4gg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6_lyIq_jgp-cYt_97avnEKJma9Al_XaSEdy4AZaYjRw&oe=6A6CB51C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34FmeilAWOUQ7kNvwGiZW84&_nc_oc=Adqnz_V19tiWJS9WiKEwXE_kdjg3nFmzssDuBwc8PHjuw7DnreNHcUyPp7IdJvWiEeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu4J2_JDuXWv8meipndJUBf9gJZ0OPq48uHqEw7X_h4g&oe=6A6C9214"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhaslzMFuwkQ7kNvwE1r_id&_nc_oc=AdoE3TYaZl2YJU5Jg_plbS9iLs8YIxBCb4dPREIANyj-KFiXgXXXsLj_C9SEwZHHsjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRRPj9AW5LAjxveVg0-Mzibdk-lTvKEdQQoOeenJE-Nw&oe=6A6CAF82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7lSR2OY9yEQ7kNvwFQZBoi&_nc_oc=AdpCHB7efH_lWdcT_UKAiFAxzrdvLPufUtoDuRCDrHfUO6UxebPXcN52amE3i1zoeig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvqKGi-fT7MLJu9t9-tCX-S5m_SK8m6ZMAiMs9x3LUZw&oe=6A6C9BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOSIh88a61AQ7kNvwED5WdV&_nc_oc=AdqHvqk-6J_8j2Dj5Z34rFjykQvHnHw7EALYPdB-GOH6Rhrl3R1vWmH8-q3LI-1dors&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyTtuedgbN1e5Teg5XNTJATiUNbN4owzXI8jnGlTTd0g&oe=6A6CA55E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
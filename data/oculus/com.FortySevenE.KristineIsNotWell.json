41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIADEp2ItV0Q7kNvwH3S9WQ&_nc_oc=Adq-JI_ecs2Rl4iIatTS-gaUkLH3bcR45W1Q90UnrWOP7GDIfrBRKQPxziwqKI-GJRA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU4UlcP-H3hSg772H2AIz07ukqmET857zpFN9y7oXdkg&oe=6A564B9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKc-GEgQ524Q7kNvwHaL8iK&_nc_oc=AdrlgJTMrATqJdXONZ93n-aLMG2UmpwH9-sc1YR4icCZRyEpsi0Ghvo5TbU9QZ2gP1g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI0t4_qqNmwdJMrAfkjCEV_gYrIpA03_ORXsMdBamcrQ&oe=6A562894"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymmwDX1bldgQ7kNvwEnr2Ab&_nc_oc=AdoRxjV-e0Vinkny13NAPPPUKRR8tKUfEag5_Nmk7uUEHT-m4tHLKLel-_Fod4PfTco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9RrMJsgpNCJhNy5ruTOprahVZ4UvPzxt7QVcXAjwwmg&oe=6A564602"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AlFGYljk2YQ7kNvwEUvj1E&_nc_oc=AdpaoQykDIpLmSE1c6hrdDV9qhAqKNxwTNLW1H9CRB0WPZl_xL_yGaTv8exVDMUtTvM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgSqE1PPFQdtTBMCLnE8cBfa3x3plz-vwhbVt7UVCH_Q&oe=6A56326E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cpw-Btd3AMQ7kNvwEQYdXw&_nc_oc=AdqrEAw71TRW1w1h0hmZHkNZ0QQv8eKk3nbpTjjthQiZayVmI4kQZWmgLtwBNRUUyyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeRYfDVGQNwFRkdt11AKTSklI3HXdGseLz4SiO3Qu-Sw&oe=6A563BDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
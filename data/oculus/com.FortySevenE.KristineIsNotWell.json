41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKNLvVl9rHkQ7kNvwGdoq2e&_nc_oc=AdpAMIOhYVY2r-hmIuSlZfDh_F8hAKCFBBLD0KZzc1OThqu05-7Pv9Ef-UiJRl9qJSw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d1jH8toz5hPJbBVztX_-IXaRi1hkIK-ENwnpmGuBsjg&oe=6A0C779C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdC0sMGpwHcQ7kNvwHJfjOm&_nc_oc=AdpijQ0UNfAgLVkwkiDWjEO9zyAmxlag85U1PuCow-mc2gFM3-4d33pyXwvYX1vFOcI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gp-Ank5RZ9hBYp8mQ0FUXEiMPkbSeshHPGb3Pf7Vnvg&oe=6A0C8CD4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0uQ0bHPSkEQ7kNvwGxDmNb&_nc_oc=AdrbIDewx7g_7ES97xbyr8fWnYpgx5-4d6xzP-jLVbEm2vIuaZDbfCTE7HP5BvSrnDc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EQ0LD0DA1ZnA-yExFFlr9wyCTfr1qhLMsj5HuZ2R89A&oe=6A0C7202"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgPyf4zqDooQ7kNvwEnCD9R&_nc_oc=AdqxMkkSKFScv1gqbslkUx1FbDZk3htn_YYKHo_62wX5XwxEWbkQsN97gkDYnLc6xbA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wfOGVHRt3ze8w5igbRT6ZndqzrbVdHwyImwv6Hl_lEQ&oe=6A0C5E6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGT-AYdbpLIQ7kNvwEvuQ2_&_nc_oc=Adp9stXHjs9FwrDx49TEdaTzg7AIJx2gcpQhjkehvzUElx32tvkE7YAKnuqPThwma4c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FezNwP-JbBjL9v9F9y_j1K7qDnynQgVM8LHuyOMK-YQ&oe=6A0C67DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
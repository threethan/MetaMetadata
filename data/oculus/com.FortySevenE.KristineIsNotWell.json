content-atl3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAsGNrkRqs0Q7kNvwHQjnbF&_nc_oc=AdnjxfmdkxsAzgAKSGBCOWbikGjZ1syjWkfqEKsagE7AzmtfrLCeQZ2-0Xkjp-7EXqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzidWUqJK4GqRt8AbyQt0tWWf_bWbvcirOqxlaJdqt3Jg&oe=69BAB502"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsCnSoZVUoIQ7kNvwHgJYfL&_nc_oc=AdnRZb-xSvR1VugmrubCzsuBmWixuZPIrtyNb3O73b0ObBGxgM_j7pIQt89L6NMX54k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVk_Wl2R2S37vm2LUM8txlSkmdcSidkjcGBRmvznjpfw&oe=69BAA16E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1JSzXNZQcoQ7kNvwFpjhWJ&_nc_oc=Adnqi4YrvuxyMk9z18M43YOOg9hCaAtWopbo_nLPd_b06AN9f5UXlgHZc2e6thAOjGI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMS8OhTggZtTjJKegq1OapNwq_LX91FIJ48VDKXZ_XMA&oe=69BAAADE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
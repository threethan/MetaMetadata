41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYbFTlG1FoIQ7kNvwHvrMSJ&_nc_oc=AdqxiClu-Rx8w0miMxyi_uQDK1yURlE2HsfvfVC0jJi34iGhC0CZkWYIjn1McDrUe0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34Nk-fgTalDTUQJSMRow50UZe0fiAf6z-I6wBGckCT1Q&oe=69F8B11C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6rBEJMrFCsQ7kNvwF7DE_R&_nc_oc=AdocXXrexHCs2XJNbD_-C4FUrgLP7U-1mlt5Xz81F7Q91zVrm8-g50IzDuM1S1PFb9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FSQi0BqtWQ3y3v4EQrP0vnu4sZffXsCRioZ6uzWrWBA&oe=69F88E14"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LT2yF_zl3YQ7kNvwFvfAaH&_nc_oc=Adr3SRhA6FFtFMxdbvRUdpg34VBdnk6qSgXrfMZ8FjDn4DZM1olWgS7lgXI4xPEO3pw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23QG8u5Q8FV0w7q1n3esFmkrinwTtd9HF9IL1mVkxlxw&oe=69F8AB82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR6-GISZFEUQ7kNvwEruuqU&_nc_oc=AdrEjBKFWwnv37pGNASHmxe8FVPbiqBEuNMjVCG_AhB4lD7qKkjW7VKnqnn9Hae7jJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ccYnOF2TrZJYLCgl7aTbXjd3XHYDcEsIIpIU8JP5EaA&oe=69F897EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lputeprsJ0UQ7kNvwFQAnSM&_nc_oc=AdqXD4Ceq4GzxubBrt-dy3Q-eXDeHdt2JQi9EXv5ELiY_TvIh2UOgSN0WGNPW1VHTmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LPUPk6OqPizZnXMmGsr4LAHvCA4k4w0WHPPVG6m2Bdg&oe=69F8A15E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
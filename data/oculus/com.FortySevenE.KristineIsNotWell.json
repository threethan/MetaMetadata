41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ES-q0dxPA8Q7kNvwFO-CAK&_nc_oc=AdoDD__hk6A7FbTLLQn81nGPDuUpbSMgsH74fLsBjuZm4ZMRwLmds6mwe3pBWFyK9mI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL6vtFFK3SSwiB0T_GSa1VJdfph7PYaIMTqKPlvoFDCg&oe=6AB6891C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6GAM0thwqgQ7kNvwHLWznQ&_nc_oc=AdoFQyDu5GeqG3c9Xl4ZNU-G1KP0-aEheQTt7uxKcae-wqK21MMVuS8didzE1d6P-SQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMTFWWmqU_WaekNSxDGKRy7Y6Qvg7LS8shZizHwkIY7w&oe=6AB69E54"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZcr3bmLpkgQ7kNvwGUrKTy&_nc_oc=AdqfWayyNyR5U5PQwapbNpe4JfsOageIBbmBDC-oqzCVVA1U_yjC5pzvzegInIQKN2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI07wgmVRKB0FYmQbCW4NjRziVbXPXjEYep_Aq3zqHEjA&oe=6AB68382"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVCpl4y2OewQ7kNvwHoKR9o&_nc_oc=Ado1mEaOgT9sx7QQGNDRjqbSABJ2jlv1mBoKUKz03TdnOGq5ZHMPpY4s_J7UAZBS9S4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm7F-SsIPR3LoEyuZv68bZgpb1x4o04voWR4VKHS3SQQ&oe=6AB66FEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGNKdHmus6YQ7kNvwFBSmBE&_nc_oc=Adri-LsobjFXBjInRKydcRbwUYoV5b4nkrxZl87nLJTASKXxb3HNFh2ivmQq7Hm7muQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-_kSTfMhYjWta2Ky3X988bY5x2ObV289qiJ2IEc7J3g&oe=6AB6795E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
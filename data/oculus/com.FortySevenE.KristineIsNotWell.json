41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrDtFILY4VgQ7kNvwEZSood&_nc_oc=AdokNRXF1Qx5q_G3-cesD0pyJyzvK2tw2x0ftELxGIy5ivRzdnFuxpasx4vX0GUx734&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rpi4pa2HgqkM9ElsuhtYLQtTO2DfWdWOC74Q3uW2ozw&oe=6A203E1C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8L-ItYwTBkQ7kNvwF-kjfg&_nc_oc=AdpMxrfhJTvvt1Wd4iqoDd_rP_TpNhQsXAm72mPdyilJCpW3GLiJTyeM0RmEbT_RcVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QOdqnetxUJ-yO4CEcDH33lzy9MJrnenw5ii8lG6S6og&oe=6A201B14"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWCIOLXq5BwQ7kNvwG46O6d&_nc_oc=AdqVA1XnXkCLR9bC0G8rCcvnwp4_Sn9UnRRgFsB5s2b31KneGZm7XU8OEdq6_A8kM4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JZG-lACVNz75pzXsOp9m431YNaOoeLY6YO0-U1F56LA&oe=6A203882"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bJx8l3gV2YQ7kNvwHdMKxQ&_nc_oc=AdqvbPtqolCo9bzSSQjVfFBxptrge9JbTRr2_s5lg53SEb-tqLhcD4VTxH3pc-VlZxc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p9IyW5A-6plJMMM-NJhu81_qdihaoXnqe8DhPs0KNgA&oe=6A2024EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KE-z5lpJNDEQ7kNvwEvP3LF&_nc_oc=AdpnSQzMNq7ocgkzy2TfH-zf1KOB_aAm7k1zvGk27qiDVHNwVBbvADYnhb0YdlLZZJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43CHtG8aYvhYJXfZ5gRVrmKuMWcU0oobp7-oHwJZU8MQ&oe=6A202E5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
content-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHhzC8jz8J4Q7kNvwF7957V&_nc_oc=AdnkD2kBPdgseikkpUihIDoEwpl40i7Nhx-sZTyRAnccv-amjBxhKDJWhPAtidQx3OQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afym2sa0zNAQ8J1f1t-yRSXPv7U9r9bHDMEleBiKhRxlgA&oe=69BEA982"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4I1Z5k6Zv2YQ7kNvwGajpWu&_nc_oc=AdkWKcOKQ8F0F2xn4Mj1hO0pyvgjlhxKj4uqtK6ttDr2Rb-7qeH__udYcKx8MlCOjAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvgldFFGUHle9FDK8KqOBS3ohSYPP6XtWZJLhP7QX4dA&oe=69BE95EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqlsabT5LOEQ7kNvwHcU_Wl&_nc_oc=AdnaezNCexjDJaGgS9tiUV4biInDjRHqNSoJDqW2bFv5syd4tuVzkb2xKlhSxv8oSR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLqyXj3LsPYgbbCCt6o8rdKJ7L8B2x_3Fem9WwcP6VPw&oe=69BE9F5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
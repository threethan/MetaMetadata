content-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IykSa0MCzu0Q7kNvwHf9FC3&_nc_oc=AdkHIQz2B0PCK1qILhL9mHCZzScJKTtAga_ouQrfs7-aV5Yz1YxLLGrkZv-Wd4Tk5JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuQbnX3v1QCJQ3rz5Nzy2Z_TFJ_p_REe63qMO3B4EqNtg&oe=69A99182"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ6-QvlTo1YQ7kNvwGYU-rz&_nc_oc=AdnYSNfnw23vpD4bc3R7Nnp5Sn7s-a5J2TShDvXH4cZn27K2swn3ufmeS3uUbBOlITE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsn9CosiDMuKdATpWzV--Y94hVZHdDuqDO6oBZm8Dfi8w&oe=69A97DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO1smeYc0JkQ7kNvwEUAUdD&_nc_oc=Adk87mm23c-6IhIR06QW3bS3-ph5AjNqdRamQzdy2nisdO3Ug4ZJ14Z7k2BMZ2G9olU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftc2PXcMSsXNqY2zVLoBvxbvEezNRRAEmW10VVp7uwVhw&oe=69A9875E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
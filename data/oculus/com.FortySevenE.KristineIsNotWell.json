content-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2YbXGQnPdEQ7kNvwGlXs1d&_nc_oc=AdnFWoR8JGhle5y0sjhnI6dJU1m7dzaq6ABO4DSSwO-lrxY4nC7BvYoIvQfDo64TVew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyARCfwDl4KBFbjxe-BjcnjiFlKT5ToQloJa5PikiecrQ&oe=69B81202"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn3C4K-UxXgQ7kNvwE5jmyR&_nc_oc=AdkGXXcgakWcdhg347uX3xXhd7E_Ptk_b9KlD5R7DDvCUq1XNUWMRxJwMmnD6aGitJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDnW_LBXN6KasPfArRjVnG1uHBX10BmaQn3HTLUDvlRQ&oe=69B7FE6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqYHb5nGxdYQ7kNvwEYHn2K&_nc_oc=AdnJwJYVCVwGzdA8R_aHdAjtPAaHgOzVhOwOw0BdfpXoyQTBcwUVZ3BpVpmGXdyGHto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwkyxw3vah-N_8G6yBz1OakCw3HjWJS2Pk2zjLCuMGguw&oe=69B807DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
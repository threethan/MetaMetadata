41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7nN-olkAroQ7kNvwEyvP39&_nc_oc=AdpfmypfTEsOcJSgm04qwNoWYij0FwD19VotSoNKMGCa4-QzufLYX7o58tlT4_gU8qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBiIdNcSkzs3YwdAOOib-HDdxYrq4w3ll39y5Apx7-HQ&oe=6AAFF19C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4W6DFuq3LQQ7kNvwH9ktij&_nc_oc=AdoGeP7TezBypp7E8r9b8Iij8Vv22XSp26lWCLj72t_tzVUQKC8_J9xjf-aMgU1lvjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVaIYdBRLbAWtWFphKoW4zb10eHrkGvSLnWZ7KjQnwEw&oe=6AAFCE94"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnhKZGNsiJwQ7kNvwHlXMsa&_nc_oc=AdqPbzVOMOuuOTaiIuORXTQIngtND5prUmT-aUG8-P2YJMGWDOZEAUUT7HHjWgFczyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVwEt6k839c-gKS4Nxv9Us_kigR08ZrxRW7mzwRmPvCg&oe=6AAFEC02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4eeWf_fOrkQ7kNvwFAxxel&_nc_oc=Adp1xKVZiw9cMA2EG1gOv6zkkUuBRXAhWKg0I155NGHE2v7LxAqPqqmOmfl6x2pLiuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy4G9-scuCb0roywqq2jpJMCQoV_pityK-2EnB9ArWag&oe=6AAFD86E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjn_osJ9O9MQ7kNvwFEO_Hb&_nc_oc=AdrjLhbqpOfv0xVC6Gp-K-JMajlDyCh6V-7tJvLu2zT9h9cHXWQMJ80FAQ6h6DgXERY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-71TT_-K5pcxlnU0j2z9vhjzh_-KlFCoD2dcLf3eJKQ&oe=6AAFE1DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
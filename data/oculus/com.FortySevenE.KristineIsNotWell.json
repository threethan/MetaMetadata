41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ9ZsLX2egMQ7kNvwHf6540&_nc_oc=Adog_wpEbB1SB4RwE4UltJu8mwPHvdylqmBwrCiebHqkqUvC8Bwbz_-aMaUrAh4IXkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkWTrrvkk5wtte7NcwFqLDPjAQRatWeyltsZ9QAjeLTg&oe=6A7B359C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6mfPe21s9IQ7kNvwFkPE_T&_nc_oc=AdobcIg6H9ylZpI7THmu09QsNPPd4I42oRUr7AICH0GD6LsOLaHYqAtqKW5fsh7SHk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQFtckYoZ75dwIU2BRoRMA15vvLHdb5Pem7X7uVr_XDA&oe=6A7B1294"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sakDV30lozQQ7kNvwEeksfe&_nc_oc=AdoHUMWGXrAZmeQ3_B3W_JnbrvVJiYXUd6P5Dl5yGAJP9MW-U4K0wnbHKWjriFe_tqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaXtnLZXnZnil_OTMDBCPnGGVszXyGURfuKd6C2WDK-w&oe=6A7B3002"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-jD0vxnqsIQ7kNvwHMMLee&_nc_oc=Adoao6hUKgWx3XhhhxZ19-Yd1vTOnvzQMe_4uneeEkCtAJje0epQPUu0HPxCGpuTN1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2brhJGlrfzZUFD2XgUQ9_aW0JTy9FjUyOBD6L5DapUw&oe=6A7B1C6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXL8zgUNVL4Q7kNvwED4i1v&_nc_oc=Adp9pHRt1WzF2oAgZtPFtHmLESqhrM1WXt50HYZq1o_OLOC_wupSu2JMPh8ecFTIXhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx82yzAqwz4D2LDFIxnK1nvgXXIApbiZFVgjFLw1p5TQ&oe=6A7B25DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0zQYTOmWkEQ7kNvwEWUBDU&_nc_oc=Adrb_qvcB6cRWHy9qf4_FJJpz0jfnkcpcqSkCeqEqeUIDG55o_qiDC6ZkrREx-e4Tk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADcUvuRyeySGSBaXr_92ceWAGnBBu3KtQ9vFybARaZfg&oe=6A491C9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5bl95m0fLoQ7kNvwFV8nG1&_nc_oc=AdpCFUAHU6m1YuU1AXn98Orsx04KUCzpENclCzXzA33XzxymTg6CGmfLgGBLHaxyDRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6RH8F1Jjc8H9Dg9CvPKq_kUweaY_aMAUTyzu4DRJnew&oe=6A48F994"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5bIMnAY6CgQ7kNvwHMBotE&_nc_oc=AdoN71ltUkB53Ilos1WNzvK9Be4EI4LHSTV9NR_VrGVHdBws3GH6pag2EfzdGrmHWQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiQogEOW7nHtY1mHpoc7Z6iwyQLEn8uGV8RTMwha_ukw&oe=6A491702"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kldNwPWMn18Q7kNvwFlIB5Y&_nc_oc=AdqiSCWnpUA17iyl2kwPIK-gxtO6Mz30VD-rX8j-a9CWaECmzL5h1RjWxGLF_1FGyZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp-L-otvHelpgprr1KeLjWyXdBLAodf6rhkMODnlDmKw&oe=6A49036E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRp1ZsaVhdMQ7kNvwGdh_LD&_nc_oc=AdorqTgoBYQrQWnFpjWOLbx7K8um7wEh76SjsrcqwQ9VJbcxFrCHuSZ-qcV4EFGp_KU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzp9ymIpTW2WysNkmLyq2i1-06XI9etO2sxsNj40DuSA&oe=6A490CDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
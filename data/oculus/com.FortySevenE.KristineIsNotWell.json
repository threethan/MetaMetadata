41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6x_i5vlicMQ7kNvwHH9w81&_nc_oc=AdpGyxGI6z97bqb4Xa191XtUhZwTdHujTJtt0gB2pCKW4TAQWR7-gn04_SF97ROdadc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYXVsfmb-kX7gjbMLN2VpkkVN-EW147s3-KG4-cEm-Gw&oe=6AD38A1C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ypuu2HcaHAQ7kNvwEqIeAZ&_nc_oc=AdpnZk7J5BpmaiWabPrSpY0TeSEWhM3Ir7J_xwzRWwAeG4BLPTZTKkQRvtmCyKIUtdA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaqxF6anNEPmeQyz8i5BEW1D4ywgnfJ1rggyD-Z5oeKg&oe=6AD39F54"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1lvLH6lEawQ7kNvwEy3g-5&_nc_oc=AdoAX8hC27ZGa18bkAQxTGUjupQw3SvDubDQQMCuURQ-v57RaIhDH1V2rUEZbBBa1Nc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs119bK5-GRCE63a-XDXn6H7wEyfN708vDxZ2hzEDSkQ&oe=6AD3BCC2"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaTLHjcX4JUQ7kNvwH0oYhA&_nc_oc=AdoEifDwFk6-NEHM_WJnR_Kz4jqvJcz530OZkm5JnW6Tg9zVeBKmBCLqFmGWsWuhpy4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr5KDmwU7ykdZdhrtnWviEk3GRtcimR1vaPXp3EwRlTQ&oe=6AD3A92E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kd6OUNjFu1oQ7kNvwEr0I5s&_nc_oc=AdonTToWimavr-WR0VvIzZtnV6i0tlKRk8Qwe6ms6VnqffHSAyemgs0FHfDc1Q1bFYw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2ZbFQ3oVm9Djq4fioICwQ6gVZDYcLlTfRRWrmpJoJ8A&oe=6AD3B29E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
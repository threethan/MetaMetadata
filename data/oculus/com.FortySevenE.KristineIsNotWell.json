41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B91ab5TsYMkQ7kNvwEDw9Ik&_nc_oc=Adpz3ZJ3wcY0Qlz_67JupiZWVF5sSIdjxYBJZEQm2KMbsnydniRnR-KqH0WatVkBnn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E5Aq746-BNI82kvHZ5nzgSn1TzbmHlUPPPH1CtZ3Wfw&oe=6A43D69C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QtKoSxM0FsQ7kNvwFCnt0f&_nc_oc=AdrbYLAobiQOV_qKq63d0GinuyFZyP0QWnkCGi0T6q_qOiuCYqWW7qDTL8m2xUz5APQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Boo0S4qm-EXrz5Hx0335IQuxLf_atGuusa8ZIE2e3tw&oe=6A43EBD4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxOeqDF5CkkQ7kNvwEpP1FP&_nc_oc=Adr2HuVbJCwLqUkIaUzbBuDpT1qk3DM213RHD-LD73N8ZbE_iJbG3haal2HuKlAYYBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KFQ7HDierwfsQtE2OYS3kD7JNMVYsPmjdCnvRpGvkLw&oe=6A43D102"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ6qnbKxHxUQ7kNvwHQbLYw&_nc_oc=AdqyGAbAZq-TwhoKrpm03BgUTcoxK4OchmwzRvV_CRT-duiDKm2tSuGXzBR0CEbuIlo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3n0kr6FODR64UtNRvabtgHBft2FiCKvGhdfO97qEAMg&oe=6A43BD6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77ZpfNspUzQQ7kNvwHEsE8P&_nc_oc=Adq2AGVySKAWiscs-QxMqz0kB3I1qnp3SeNc1R_x95eBKXmZANfSJpVeT8Snarpd7hw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V3wjN2iNQfFiCwieG-HEOMnlhf-dtpsu5Y6ZbmeTsHQ&oe=6A43C6DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
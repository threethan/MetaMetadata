41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wHtnqwnrmUQ7kNvwGqYso2&_nc_oc=Ado675s_98uGg-uigLxxT44jHNL1nq76Aj6XWGjDOtr9J0uIauiYECroPJUJF-Eo1dA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tnbcLf6dzTAV-06IkdIkE93JqufsMuKYcCk-017sHRw&oe=6A106C1C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC92AXm95KIQ7kNvwEu8o72&_nc_oc=AdrCnHIyHf1c81ZhqSoJa1JWsbzvpHg_snKufo21GxgadiUymJxrh7nDLuUAWJV0QBY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xVc6l9yOD-LPgh_R12zbsNoRV3ubA_WjxIQwUFQ5QDw&oe=6A104914"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpByp4OJNW8Q7kNvwFwYW2A&_nc_oc=AdqdAdE59vu4PfR6ywY-CJV9FWk0awpGeHqGj0WsFkCYQEA_bbK1a1n5mHHmQB-peic&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V23SWnKwj28IMWcMotzkxXEcHttITXvkoZ_Z0ey_ZmQ&oe=6A106682"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLtWQupdgU4Q7kNvwEvA-B3&_nc_oc=AdqFvc0tMXS43PywnTjIE-jqGzzOmh8lNVJ8vx3XKVCYqD9myPpnvMojTo5RW344ZAs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AVnGaiSrt1TGkIwXFy9nji2tp55z1D08VCjua75g8Xw&oe=6A1052EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7OIlNDUnykQ7kNvwFxSQFq&_nc_oc=AdpVC6LQ3CLx-itrQf49tN_rmTBeW3aI_JRnjDD1mIcbE9SFCpiUfMej-ZmMOZq1gbQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kYG-eqhfex_6feyslx72wlwZNb6eJrKwF6XTTOgmfhQ&oe=6A105C5E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
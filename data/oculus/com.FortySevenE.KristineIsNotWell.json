41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jp2OWnk9b8MQ7kNvwGohnH4&_nc_oc=Ado6TM4tBSG4jYICLImfqTnyAtJVOZIxUsirPTdotCF3PmwcpOQRhvNL882PB4K8aFs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n8Fk7jxu1nHwIImgkxFBoZqw2xGSY0GisfKefIvna9g&oe=6A2C1B9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzKvv9VOKMcQ7kNvwE4xYYG&_nc_oc=AdrefamFHn2rq5R7FtRjF1PcjKxZkFBGwY4vpZkHewGKndoAEH_UZ8qHkOQVr2ETLFo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FXjRsNp0xwJl2d7rPTreE-f52qImK0rScq7RTbtnnDA&oe=6A2C30D4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGVCOCpEdvEQ7kNvwEb0VPy&_nc_oc=AdrxdgBJUye2clRPbfP3HmtYW7s4Yef7aQIMONOFGSWMmTfK0LScSjN1XgUNlK2GWFY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R8aeaZhOfL51J4Y4CHmLwBeuq3c_q-MrV9G3CQ_v_dg&oe=6A2C1602"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79XdRf9qWTYQ7kNvwFtzrUc&_nc_oc=Adp_Qv7bhkmzO0Y6XAZuIazBuyusFwIIDYZjq500TwAp9s3euoPgK7gOqW0bZLj46-c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wYz_C5ozC_hAM-_FKsGNAveVkc_lPmuJXIJaR6kwA4Q&oe=6A2C026E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itDWBWB3lHMQ7kNvwEyBLSo&_nc_oc=Ador9ZsgEYQC3kJKL3gjR8Lxr0h3i3bV6oekAfuSBSG1rMQbvGAYsEdsL5PG-4dvjgM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AgMr1AoWVo-smz_Ikd1gao5SwKTfFU54_IBzlhxE3fQ&oe=6A2C0BDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
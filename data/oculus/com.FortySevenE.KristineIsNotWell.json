content-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e709tFsCuQ8Q7kNvwHolMvX&_nc_oc=Adm2NmcAYIgnukuxjSp8E_410nGubeT1Qi73B1nc0xRVuzeFltQKNWqQRI4BKYSJVT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwuIOGixeAkroWQNDIEL92WAsfKZEkuErvTjsQ7qRd48g&oe=69B17A82"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJgyiPZDl_IQ7kNvwEi4cTV&_nc_oc=AdnuJ7wMDMRbqUpXT3gGqf4II3Br1KJw07Mb3OyJK9y-XfOV2ZQ8lJVzKDxaZeOwwkM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTWd2njVLxfiILEO2sSPjwgg9K2rjWLRzoH5lNVsqNqw&oe=69B166EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akM08541PpMQ7kNvwEuI7zl&_nc_oc=Adm_wLSpVqdFZFIdQDLoWoDpVQLZaZBn6K1pdJV6ActV-F0IeTaEml2Sr0hVhM1Z6E0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOZ9fgRBwPXMFV2weXygJVO7K_a25qzGGik-ZXdoJiHQ&oe=69B1705E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_d
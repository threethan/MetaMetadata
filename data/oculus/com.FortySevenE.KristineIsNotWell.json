41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KESt6qHeH0Q7kNvwGQl6J1&_nc_oc=AdpIiCAOerIP-PVQzzPcrqIv6Q2JMA72ixXYGy4NxR4KFftOCJANvB-r4ps-OLD0HCY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQEdAT5Cczc-r02IXzli-YkPqO2xCZACjyGXMhIEeUig&oe=6AC5099C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jHbOKOR23kQ7kNvwH4EpNA&_nc_oc=AdqabcTsRr2JR2VQv4qQYmRgC1ncDuzOcNwAg49IfcijWvYl-YiY7P5hp-noMt-6Sa0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn_7J99xQxJ91yBkmb_CmfnW-_eLoZZo8QFXWMzI-Tjw&oe=6AC51ED4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEuFdWD7-uoQ7kNvwFZb8YO&_nc_oc=AdqoLLdYyKl55dG_2kuS-9GUWMbEQmMYvugXNNRdiVWT1hFZ2go5oM7NvL68VNbIWcY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr5kdn0c2mdgva63sOTzNW8vq5C9rDytsuf-77W8S_5A&oe=6AC50402"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WJiPt-Fm7UQ7kNvwHRanAo&_nc_oc=Adqk11ICccttzoLcX7m5UjG_r0jLOibc3fy7NV1QIoX8Nw69q5JlBv-DZ2l3ljTPywo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlOqu72SFZDHFSRYke_5iHkRipRHA7Z_ZZb0MLAWsnKA&oe=6AC528AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ee8yZWVBbQQ7kNvwFtV9D8&_nc_oc=Adp9X-fQDasQPhJvL2NdbdzeDU7lmhbwVBOAoKgC1u_BJzRhRFG0D-r0GndpDnkPhG0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjMMX1nSSLLkqdMZrGKrENb4eYOP_jWcl5mYYoidZAtw&oe=6AC4F9DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
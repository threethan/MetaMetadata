41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7S9SiS0iBcQ7kNvwGy2Iok&_nc_oc=AdrOkpjISAEHb71oMW0866rqKx4IIKUkLiAxoNFfokcijwJ95djZiKh7_dozbsgEPdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0aoGpvvx4heSCpUtG0U-jGbu44rHBmM_S-649IBjq3w&oe=6ACA4F9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKlYSeZHmYUQ7kNvwHQpSm2&_nc_oc=AdrlUisoHAv_AjZ7LQdwB6-58PyNFq1n9ksDYpuiv89I5BNQVPiVFe3yNM1DS2vs770&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUOSByrGFHN0XPUyjevMQbn8NvWv4SY0PZk8zjPLR6Ug&oe=6ACA64D4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2y_mVUJ9Qu8Q7kNvwGCfXF4&_nc_oc=AdqMq4VZCvE6T6LvGtcRRk69WmqzzStGhClVQ1MFB7jbXrHIj9T8I7aP3oYDWE7Q-Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmvZAcr0ipPuAmUfUHsVT0ASvJGAtU9g0F4YQsDFPO4Q&oe=6ACA4A02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GeVFdZUxE8Q7kNvwElGZ-1&_nc_oc=Adqn9b-lTDzL_GQ0HhUBn_gM-t7-SSEprxq0QWhtZlhAHx_HAfeESX-lf9OEP3YYsXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg5Ar6DZa2qSpIehgVtm_u12eD4MUazHO9b4n_UIBJ-w&oe=6ACA6EAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0KS9ZtBiRUQ7kNvwGn7e4L&_nc_oc=AdooBHVxhUoRFF9lQySezxFypiuJYWXWO0h_R6qozWXz5ceyJK4Lh1x139w74RJBDcs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQyWPF793ypijSDcO0a5fVyM1W4SQzNbFHZGSQnIvpkg&oe=6ACA781E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
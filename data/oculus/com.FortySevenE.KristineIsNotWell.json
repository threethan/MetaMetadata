Q8lU9m5nsF932pBi8z8yaA5BAlJfe7e2fO2tsQPAsliTzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsGAe0371HXJHNF4loBR7LfUkW0OFo4p7SuF7gFTyZozg&oe=699ADE5C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVBUHA5D9NQQ7kNvwFBfAfC&_nc_oc=Adl29UCWiFkBh55I4aHr_A1k5CFFyXfEOy7X73E2FrFGcHb2KlEYEumluoiXPiIYksU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsJY74F_wixvRf4IbTBRlBiGLLJBXIJcNTsR-w9YBTr6Q&oe=699AF394"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIFc8c4cSucQ7kNvwE7PQtd&_nc_oc=AdlHtzh8i8a6KfPO-PhJo4w_Q2JHuqVFzk2JedeWaInGAmsyezBzWKQdZxZ3fbAOSn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftkLEaaGkn9RPZ_g_LOc7n31w2ydtoTdXIrfAId8rWufQ&oe=699B1102"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF1rNOfXPA0Q7kNvwHXdQNY&_nc_oc=AdmhgKIb6dRhpx8xTCMwO1uriJ7meJ8T8NhHjxa1tcxtPS2E8Jlljl-6WfUvlbaEr-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuA4er5fVDyY2ZJqbb2yQFs5-huaSfL83E1-3gQ7-JKag&oe=699AFD6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJ97Q4OdI8sQ7kNvwHydBGd&_nc_oc=AdlC4mJ-s7hteDAN97eMAqtvXTMnQQi0WkMbzwUwcBN5O622bnC2y_myGEefPSfp7Ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsg5_SunSkTV6MrtAJ77f3Xc7d-K89khlxQlMA6pJZXjQ&oe=699B06DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506604041656825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75367594_2007167629674893_263573157436873239
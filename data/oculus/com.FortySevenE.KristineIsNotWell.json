41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXF8yCInsmYQ7kNvwERbGMS&_nc_oc=AdouHVp6FA948aTWKEajPXHU7d8aRuB_TW7aqH4N6sVXCzJjuBJShSLrqHfznk3LPx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95MlaEs6OuQUH8xkm6iYOosoWdtmxwta4q0Z-OpN424g&oe=6A2EBE9C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5F-dn6C2k8Q7kNvwFv7AwH&_nc_oc=AdoWJ0Om-MVdTeNNbbmnJkg_fXf8fbZV46QkCJUCLQGoNIFlXcg2b8h72bEiV-6a0cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rc6FQ3yetbdSXDNsjgvQ3Q1IfEiWnSfXz5UZHRiTDWQ&oe=6A2ED3D4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGVCOCpEdvEQ7kNvwHHiIX8&_nc_oc=AdpQ_DeuEOu9_URkQlPv2B1K9kVudozfAETzaRxkEqwXpbwB26_2CsHdg_R3gMA0K3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UswR3ZczamlrAHWLHzOTUIyUB4ApYz4qDwGNEpeId9w&oe=6A2EB902"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79XdRf9qWTYQ7kNvwGkCfZ5&_nc_oc=Adqg7Bl-nXNx-d-HwBPFPpwuhEoH2r9ZLBaioOycmEGHZAvbd2J22U7ISkxTQp-Yqnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98ypJJ0rRxgHeo7J5vdhvOoLDgA3c8fCbbs3ckvRIy5g&oe=6A2EA56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itDWBWB3lHMQ7kNvwEtKVMu&_nc_oc=Adr7f8fKcF6lBKmQyhOgE4lQvOdDL71sMYFfmSh3cT_3Ufn8LyeNGW0ML7Vr5nJOjVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c8rbKmVzvzP-yqnQWqMvmKdvIgfbZGLp84Zcjh5lFZQ&oe=6A2EAEDE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
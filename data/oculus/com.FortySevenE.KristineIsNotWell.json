41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IWjq3PFnMMQ7kNvwEJZg7W&_nc_oc=Ador9kE9j3Ex3S8bO4294aGl7XA9Yd99Br_XG8Px-SWG1kSkJCsnjYZQzWuei_X-F6c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2p6HSMSrtW4K9AWWm_EjxWG3vIQUbCMFW4IugRGnp7A&oe=6A24329C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEziWeGx3HoQ7kNvwGvE0be&_nc_oc=Adqrwq4KIUkDrUAfGza_rGGxP8DAJVvdH0ObR1oBJSvqm8nToFafdriZCt69HtXBYJ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MjJedUNEOpz_XodbGNvL34EX6rIzg4PoLnDg8j_WGSw&oe=6A2447D4"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_X3v8652kcQ7kNvwGKKrEt&_nc_oc=AdpZQ2sZMC_8tjHB3qH6K0_cn8Ne_pYR_HTOYVC7R_uwlzjjMPNhNb1QqmuvY3_Hydc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M3xmKA4caCit6oPascKo2SA9Y2OboiZEMldiwM4qjGA&oe=6A242D02"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjBOGm4FenoQ7kNvwGxilgP&_nc_oc=AdqKpVsHP4jdrp-Qe2m4O9LodqGI1UTsg23mwtiYEdSSoCMPknu_Im-tbBXFBAcgpTo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KY-0jrxsKaZsP08Df6JVo-5O4gL6_g7K_YNmtSO89-A&oe=6A24196E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoJ5JO8w2fAQ7kNvwHQIJWi&_nc_oc=AdrrkNvuWNS1I84mtReydmWWcFl9-ydrXZa6giEWUj6fh-BdRpFExNnNALYtArmUWv0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_09-t_7trVDiLjehNRiJ_tUZEQy8t0_Q2FZNXFAaUhGw&oe=6A2422DE"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
41_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PyFAUWniJCwQ7kNvwFEi47u&_nc_oc=AdqBsZl8-QpcH69sKoJGZzGCEzCU6XTHE3bL3E3ZZAiYBvgtGq6Ka8VqR42f5YgDJNM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8seRjsAlGKUsCS6ZZMFn04MNRfiO3kSgrd0ANQc3iNXw&oe=6A28271C"}, {"file_name": "KINW_Still_3 (Custom).png", "id": "1982220232117052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982567_1982220235450385_4435327905913321743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2N_yhzrKEUQ7kNvwHsl212&_nc_oc=Adp4kHvwCltPnvfYvip12b3suFm_xbR8b8NHcI45u2X7pcxFMCvSv7tBoRBXsaqW-Yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZyCpIJ5C_gPnHBsuyuVzDg14Ny4bARjayqPdb0e7QjQ&oe=6A283C54"}, {"file_name": "KINW_Still2 (Custom).png", "id": "5938375792896098", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031579_5938375796229431_5210051578887906403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjLcuOVA0XEQ7kNvwG--MsG&_nc_oc=AdqrFwPyKtTRdN_QC3Vr3nUCWhEGPZm-8PF_saYwvn2Xz1Ipw8FSbchHzIaAkaD2OkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ihLpapkkb4dfgse-LOCJBMi2XPK1Z4hIGt5N7O-AqdA&oe=6A282182"}, {"file_name": "Screenshot_2022-10-04_17h11m_079 (Custom).png", "id": "607088364585457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75330717_607088367918790_1865766135820267489_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__qr6x6XdVcQ7kNvwE2Tlrv&_nc_oc=AdpnrkYr9OKW1PD6f9GLq6W-clfnhVZI61nYt2XTVHEdj8JfIzaccxN2dEbL3ycV8Tg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FsnTLJBtmVRs7XK0ut-B81g1eNOe-HlwNU0i5UzOyJA&oe=6A280DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2022-10-04_17h20m_089 (Custom).png", "id": "707620957661732", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_707620960995065_119001060006892844_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0niHSSKmdkQ7kNvwHEdOEM&_nc_oc=AdoJgK21ZJa9f4nCPxyi6Jhg5UFTGQa3PM1IzLDuDROhGEcJzkU7QxTKLZNLjRRVtkM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A0QdbMazrKfdFyz58C_o214QTWqacxUflGAc-GzKZug&oe=6A28175E"}, "display_name": "Kristine Is Not Well", "keywords": [], "long_description": "Kristine is Not Well is a 20-minute VR social media simulation. The story invites the audience to join Owlet, a good-vibes-only social platform that blends elements of TikTok and VRChat, where content creators offer lighthearted experiences like French lessons between reindeer and VR workouts led by a muscular dog. However, when the popular influencer @KristineMusic suddenly gets removed from the platform, the VR experience transforms into a battle between creativity and AI detection as the audience tries to uncover what happened to Kristine and bypass the censorship.", "short_description": "Memes vs. Censorship in Metaverse - Kristine Is Not Well is a 20-minute animated VR social media simulation visualizing the ongoing battle between creativity and algorithmic surveillance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://seeyam.com/kinw/privacy", "developer_terms_of_service_url": null, "publisher_name": "seeyam", "support_website_url": null, "website_url": "https://seeyam.com/kinw/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "ART_CREATIVITY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "506
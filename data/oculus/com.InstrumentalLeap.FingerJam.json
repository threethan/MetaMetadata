 timing and tune.", "short_description": "WORLD\u2019S EASIEST MUSICAL INSTRUMENT AT YOUR FINGERTIPS!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1KBoBiv0jhRBzHJ7TiOqIv9-I03lBougAROPxCNHHZVg/edit#", "developer_terms_of_service_url": null, "publisher_name": "Instrumental Leap", "support_website_url": "https://fingerJam.dev/", "website_url": "https://fingerJam.dev/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "606978394829234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001703_474275511461485_1642457229726800261_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Et-H4QQJ8Q7kNvwH-63xf&_nc_oc=AdkGuKz8FhU42oPx05YOVDrY9J1AvKvJIF1gwSBQUxNWsOH7SVbFrugaPDrYq3UMiUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyv6UBzBTjQEjI5Y3cZMpYpp5R_wJekd-SOf08jAjjnrg&oe=69B56DD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Finger Jam", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1673460313, "lastRevision": {"nodes": [{"id": "6142567609088004", "release_type": "SCHEDULED", "adm
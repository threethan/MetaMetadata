83590809622767160_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDF4RSRWB1sQ7kNvwHlNIrd&_nc_oc=Ado4HWGV6O0H_z8n7VzJIhtItJbwf9XUaqmwMJ8xL0dZdxXe19nniO9jpVz3oztH-YI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_1rvOJ2If0xOoWODf-ioVK9qp_gH4PcJeuXJNVU851Q&oe=6A8D6925"}, {"file_name": "5.png", "id": "815665974518053", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617762_815665977851386_3038315039014140755_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U0C96A44gcQ7kNvwH_Ryyp&_nc_oc=AdqYfn2kVrkRQyao_5tEfiOG_dqIKgcNk9fkDqNMXxCY9I5YANaUmrMzdqCrue4i_gs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrGpN64hGUMcpsEggdZ32BWF_nevYOrUxW1w5B4jAwPQ&oe=6A8D8463"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombie Forest VR", "keywords": ["zombie", "survive", "horror", "jungle", "shooter"], "long_description": "\nEnter the Forest of the Dead.\nDeep inside an abandoned jungle, silence hides screams \u2014 and shadows hide the undead. Zombie Forest VR throws you into an immersive survival experience where every second counts and every bullet matters. Armed with your VR blasters, you must shoot your way through endless waves of bloodthirsty zombies, each more terrifying than the last.\n\nExplore a dense, foggy forest brought to life with eerie sounds, realistic lighting, and spine-chilling atmosphere. Feel the tension as you reload, aim, and shoot in full VR motion \u2014 every move you make could decide your fate.\n\nWhether you\u2019re a seasoned shooter or a horror fan seeking your next thrill, Zombie Forest VR offers heart-pounding action, realistic gun handling, and an adventure that keeps you on edge.\n\nWill you survive the night... or become one of them?\n\nFeatures:\n\ud83e\udddf\u200d\u2642\ufe0f Intense zombie combat in full VR\n\ud83c\udf32 Immersive jungle environment with horror ambiance\n\ud83d\udd2b Realistic shooting and weapon mechanics\n\ud83d\ude31 Survival mode \u2014 face endless waves of zombies\n\ud83c\udfa7 3D sound design for maximum immersion\n\ud83c\udfae Designed for Meta Quest & full-room VR experience\n\nStep into the forest\u2026 and don\u2019t look back.\nWelcome to Zombie Forest VR.", "short_description": "Survive the haunted jungle! Shoot raging zombies and fight for your life in Zombie Forest VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zombieforestvr.blogspot.com/2025/11/zombie-forest-vr-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creation", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32304169029198253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "723921476738897"}]}, "baseline_offer": {"id": "723921476738897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762799940, "status": "PUBLISHED", "id": "723921476738897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32305156742432815", "version": "0.1"}, "id": "1136804731530011", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
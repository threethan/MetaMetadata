ion": "To play, you must sign up for a showtime at www.adventurelab.fun. At the time of your showing, a real live game master will guide you and 1-3 of your friends through an adventure as a new recruit of the V.I.A."}]}, "developer_name": "Adventure Lab", "developer_privacy_policy_url": "https://www.adventurelab.fun/privacy", "developer_terms_of_service_url": "https://www.adventurelab.fun/privacy", "publisher_name": "Adventure Lab", "support_website_url": null, "website_url": "https://www.adventurelab.fun/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "474421390724952"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568668_898680590904043_3432846091822813742_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx_Ci8KJdiYQ7kNvwHNMAy_&_nc_oc=AdoEbWVygFUcArhy0OQxxX5BRjSUaSpLEc-JIzRw-fdIOMM_HEht72o2I0sPjIH79IM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kNCAasy44kfjuJVW8mRfBjge-gzbi2T903pesNnvPJw&oe=69E61806"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crumb", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"
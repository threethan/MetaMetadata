dn.com/v/t64.5771-25/86805183_395249405902470_2491131101137503343_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=388Tlmsi1X0Q7kNvwFJ--BN&_nc_oc=AdolNyBA9MrFQKDAeZXunhkTzvxtQ9W8hKTtEg9KVE2BYJZvAMXbsWUF-mvUbhSj0qY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzKJYdbZ4aSF829SVlp9Y8qLcEHfHnbPggCw-d-v3yuw&oe=6AFB1AEA"}, {"file_name": "Manhattan.png", "id": "769749561031819", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031354_769749564365152_719504838779110501_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOURmLRGu9MQ7kNvwH2nWjy&_nc_oc=AdrGV7QW34r7RGAryN32ePS14eMW5V5Z5v61z84EO0CADR2mJ-OUWnQ8Ab8x5fY3LFE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNOd_PF4Xz3eQkS-BMTsYZdRChTPgpPakUxAr0ZHFNcw&oe=6AFB2F51"}, {"file_name": "Night.png", "id": "1110661989540801", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569445_1110661992874134_6298588856526033181_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OryhMej45TwQ7kNvwFSeL51&_nc_oc=AdpLQxYPts-D9DE6BOjEeVRNLSbJzvM79TUPRTUUYflQ8R85ob4lWNrCzKRae_6Rya8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIAqP3UoBRWbxSb_zoPGq7Ozn9nE2BM6c3dpgp3J7WQg&oe=6AFB4B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1246961292499404", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974593_1246961295832737_6945312466061911653_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho-wAdb2-IQQ7kNvwENM2sm&_nc_oc=AdqVJs3tCeMrsUnooQaIQMyisR2j-V4x0swRCnm9D9BAjde3tTI9BQszA147E6Z7mw0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPQKz6i8PLMwNAl1fWuhylCnQGsSZPtWto5JEXtf0QIQ&oe=6AFB2205"}, "display_name": "World Flight", "keywords": [], "long_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n[Internet connection required]\n\nFeatures:\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear and brakes\n- Take off and land at any airport/heliport in the world", "short_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear... etc"}, {"images": {"nodes": []}, "id": "1046968962646370", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}, {"images": {"nodes": []}, "id": "838494734183530", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reale
_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5ur0gu9GulSPICvQYTLPCwqLpRc4zhV4Bj0s4Cig64Q&oe=6AA95DEA"}, {"file_name": "Manhattan.png", "id": "769749561031819", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031354_769749564365152_719504838779110501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXv9YqSy7JAQ7kNvwGcksvO&_nc_oc=AdoZZLiJocYEn4SROBmmBCHTiJTh9n7X7eMSEBWcaP_AIUSd8TKe1AGIPxW7zAoN0tU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOWW-Lgh2LINEL3IJ8kwVNlKeePiHqgZrQRaoXE79rTw&oe=6AA93A11"}, {"file_name": "Night.png", "id": "1110661989540801", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57569445_1110661992874134_6298588856526033181_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKk9Icy7qNEQ7kNvwHiE5dr&_nc_oc=Adrz2Hyas5wGc6U61QLNV1gADUgzl1hEaaRutlwDoEpvMGqqNDwGpZzXyByKCbLKVOk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMa_jvOjjJqYELJMzkN2utp1Mt3ThmL8TK55O1e06Dng&oe=6AA955D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1246961292499404", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974593_1246961295832737_6945312466061911653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVBVYB0KOBYQ7kNvwGyOlRy&_nc_oc=AdrnaLmeN1tj56Vnn-ddFrNs5LkNEUzqpNc93IESNcynDbteiv47nEdh5Pmi91-HB3Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSHoIP2qRh3QTQW99OcxODMlvaFzX_lpgibWTh8Yqdhg&oe=6AA96505"}, "display_name": "World Flight", "keywords": [], "long_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n[Internet connection required]\n\nFeatures:\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear and brakes\n- Take off and land at any airport/heliport in the world", "short_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear... etc"}, {"images": {"nodes": []}, "id": "1046968962646370", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero co
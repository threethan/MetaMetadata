tent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h5WWwiI8fgzJR_lFxNRbGgl9Rmpg4fgTXc82Jj4zldQ&oe=6A32B6EA"}, {"file_name": "Manhattan.png", "id": "769749561031819", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031354_769749564365152_719504838779110501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88Tf6nd6FvYQ7kNvwFQzFxZ&_nc_oc=AdrILraePOiOXlBCL8hHEsEGtyFEM1uWbTfpI5eb1Lmr3_NkNSrewxBApEp7zaIKt7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NrZyCdET42MzRGxrOUuAtmlsnJ-8KNcC4pdjg7yR1NQ&oe=6A329311"}, {"file_name": "Night.png", "id": "1110661989540801", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569445_1110661992874134_6298588856526033181_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DiQtpOLU8IQ7kNvwETlYrt&_nc_oc=AdpLD9WMWaOt4ojmvgCPlNtFmK1FIVuU_GOh-ey1NE08jm6B4O_ycv9n5sp22xpvGmk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x6awpFZDiPOnJ1vbadWBnUl9z_Q0cwq1y-xdI-N5mDQ&oe=6A32AED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1246961292499404", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974593_1246961295832737_6945312466061911653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0D2KrijxpDcQ7kNvwEoJvSC&_nc_oc=Adq2cKRZw2biFonA_Zj-mTWiFoWuqhbtbqhWzDTdNUeF9n0KhbtYTkER6FmIjqihaWM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_779UzaJEwmqc_7mIQxs6OMuec4dxxTvLK7bDYw1N55w&oe=6A32BE05"}, "display_name": "World Flight", "keywords": [], "long_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n[Internet connection required]\n\nFeatures:\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear and brakes\n- Take off and land at any airport/heliport in the world", "short_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear... etc"}, {"images": {"nodes": []}, "id": "1046968962646370", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}, {"images": {"nodes": []}, "id": "838494734183530", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zer0-gravity-games.yolasite.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Gravity Games", "support_website_url": null, "website_url": "https:
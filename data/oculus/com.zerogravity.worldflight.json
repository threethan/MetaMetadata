tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHEst8hJ65zjIIhYRqOzGACV-75p1a1GNzb5iy38wuDg&oe=6AA6BAEA"}, {"file_name": "Manhattan.png", "id": "769749561031819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_769749564365152_719504838779110501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2LMxfDg5bcQ7kNvwGsKUGd&_nc_oc=Adq884fF93HLZWVyO58pLzUm3EkxAoHPTBM2lKW98AZoX48hqqzcJa874hiKC2AM010&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-kxUxjm9wVqXBYkFDy9QnOBZIdzWaeR4TuXwZJWR0BA&oe=6AA69711"}, {"file_name": "Night.png", "id": "1110661989540801", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_1110661992874134_6298588856526033181_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLfkuLi_BhAQ7kNvwHBlzhw&_nc_oc=AdrzYEAGgS0dV-q0dY9qNHtV2dxox73UR4eQh29ouVWruoRzW6fcVjt8ExymNcCoiLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVJQ7AmbhFB4WY0cR5G7UuxEgMovtYMusBtYDbTip4Jg&oe=6AA6B2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1246961292499404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974593_1246961295832737_6945312466061911653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3PI3Ya_jswQ7kNvwEGqIux&_nc_oc=AdpqMAED4KS377QTRUATqo5RjtWH8XKPmYxhkxvFag9JjL_AYu5UtCnL6pl0eQKjoCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlDiYp8FHSjYX2BOvQmvpLlRhEEINh2QG3roz7PH4yIw&oe=6AA6C205"}, "display_name": "World Flight", "keywords": [], "long_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n[Internet connection required]\n\nFeatures:\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear and brakes\n- Take off and land at any airport/heliport in the world", "short_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear... etc"}, {"images": {"nodes": []}, "id": "1046968962646370", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}, {"images": {"nodes": []}, "id": "838494734183530", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zer0-gravity-games.yolasite.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Gravity Games", "support_website_url": null, "website_url": "https:
tent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18JZqPWp1Q6_pSNhS3mVDGu-l_00NzUCnzKjRplCfw3A&oe=69F7636A"}, {"file_name": "Manhattan.png", "id": "769749561031819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031354_769749564365152_719504838779110501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfzmunUmLZYQ7kNvwEdFIz_&_nc_oc=Adp7kSjIZAB93Yb28YWDRfkq_zC4WBudtr4TQTh-fkCN5jZbM3BctJ5_OCxx0Ow-erY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33-ANVsX6Ci1J-OW120EgPBQvyMIkwQAzoZIMCQwvYcg&oe=69F73F91"}, {"file_name": "Night.png", "id": "1110661989540801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_1110661992874134_6298588856526033181_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waqmTG_jLwoQ7kNvwFAyd3C&_nc_oc=AdrBkHyIrUUH0oR4e5z-i9mKppMCH_GN_ORppMgxjX1rW3Eg8-txtq9eaAjcJUCC4AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ak0qqZprdE9d4nbv1gGm604qQxaowH7CAPaXuheMx3w&oe=69F75B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1246961292499404", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_1246961295832737_6945312466061911653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4MH9JZDwFwQ7kNvwFa4MF9&_nc_oc=Adpy6eNqE2nQm7gskHHtsumxGjPAYS7St4ncAU9sdYV1DEKIUTdXuh6dpAcGsQmkoVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_Uc1CNNDSarDvc_Yx49igSPcjtJVQEGVh7UZj3yR0jw&oe=69F76A85"}, "display_name": "World Flight", "keywords": [], "long_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n[Internet connection required]\n\nFeatures:\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear and brakes\n- Take off and land at any airport/heliport in the world", "short_description": "Fly around the world without limits with your Meta Quest 2 headset.\n\nFeel the freedom, travel anywhere in the planet and enjoy all its beauty and diversity.\n\n- Plan your flight on the map with a powerful search engine\n- Fly a plane or a helicopter with totally different gameplays\n- Dynamic weather, wind and time of day \n- Procedurally generated buildings and water with real data\n- Enjoy some of the most famous landmarks\n- Fully interactive cockpits\n- Manage fuel, wind, flaps, landing gear... etc"}, {"images": {"nodes": []}, "id": "1046968962646370", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}, {"images": {"nodes": []}, "id": "838494734183530", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "World Flight", "keywords": [], "long_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n[Requiere conexi\u00f3n a Internet]\n\nCaracter\u00edsticas:\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cabinas completamente interactivas\n- Administrar combustible, viento, flaps, tren de aterrizaje y frenos\n- Despegar y aterrizar en cualquier aeropuerto/helipuerto del mundo", "short_description": "Vuela alrededor del mundo sin l\u00edmites con tu casco Meta Quest 2.\n\nSiente la libertad, viaja a cualquier parte del planeta y disfruta de toda su belleza y diversidad.\n\n- Planifica tu vuelo en el mapa con un potente motor de b\u00fasqueda\n- Vuela un avi\u00f3n o un helic\u00f3ptero con modos de juego totalmente diferentes\n- Tiempo din\u00e1mico, viento y hora del d\u00eda.\n- Edificios y agua generados procesalmente con datos reales\n- Disfruta de algunos de los lugares m\u00e1s famosos.\n- Cockpits totalmente interactivos"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zer0-gravity-games.yolasite.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Zero Gravity Games", "support_website_url": null, "website_url": "https:
29654033_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj14MVST3cUQ7kNvwHRCx_I&_nc_oc=AdoFWPaRUOiIBJHJeC0a6xdG8_LS1lvFSUq9MgwK8w1B40WdsXDXYGSLIGBKVHkglUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sZ8_fc3ilm4EWhIYwC1HymeqH0Kbe8v9KWsL5aHcdfA&oe=69FB3A39"}, {"file_name": "4.png", "id": "964637915892246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618102_964637922558912_3774379877078149871_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiFsmLGa9A4Q7kNvwHQNANv&_nc_oc=Adr8fExIgJ7f21sXSkH_8fI4pSKJ1oIVQzcAKXkroctykveYC-MaBaIzQZ5ijKcQtIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nhx4FrsCX49hRVjIqwvnkR-JVaKe3ZtVkix3ArT2klg&oe=69FB57E3"}, {"file_name": "5.png", "id": "2044498596116062", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_2044498599449395_6548721925541941361_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqVmmYgl3CYQ7kNvwFprqr4&_nc_oc=AdqXNKe2JT8cumeqFg-QfP_kXTAkrYlNdFOGqFNzucPlpEdUq2M__ne65TDkYLESZlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pSLNl87VbzMd0Cq5EMzQKG9JWgctXomf-UJZnYa4ApA&oe=69FB2A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover art 2560x1440.png", "id": "1501884181536449", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620965_1501884184869782_9006594008355629796_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiEa-FCOvTwQ7kNvwHVBtdb&_nc_oc=AdpR2OJvW4gXLjAdOqiOxxpxd8dy5yRVoBOVBquPi9NACABe9ZtTeL4mfHlC6TJMpvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49GfnR5gliDonKl9lcBbjINbeCJypxXluNMSiN3zYgXg&oe=69FB464B"}, "display_name": "Papi Gudia", "keywords": ["VRHorrorAdventure", "BollywoodHorrorGame", "BlackMagicActionVR", "SupernaturalThrillerVR", "Horror"], "long_description": "Step into Papi Gudia VR, a terrifying adventure inspired by the iconic Bollywood horror film that has entertained generations of audiences. Now reimagined as an immersive VR game, the story returns in a new form where players experience the dark world of black magic, possession, and supernatural danger from inside the story itself.\n\nIn this chilling experience, a powerful tantrik named Charan Raj unleashes forbidden black magic, bringing to life Chinni, a possessed doll driven by evil forces. As the darkness spreads, innocent children become trapped across three haunted realms.\n\n \n\nYour mission is to track down Charan Raj, rescue the trapped children, and survive the horrors that lurk in every corner. Explore eerie environments, confront supernatural enemies, and uncover the secrets behind the curse. Along the way you must claim the divine spear of the gods, the only weapon powerful enough to destroy Chinni and end the terror once and for all.\n\n With intense action, atmospheric horror, and the ability to fly, fight, and explore in virtual reality, Papi Gudia VR transforms a legendary Bollywood horror story into a thrilling new interactive experience where every shadow hides danger.", "short_description": "Step into Papi Gudia VR, a Bollywood\u2011inspired horror adventure where black magic and a possessed doll stalk the innocent. Hunt the sinister tantrik Charan Raj, free trapped children across three realms, and claim the gods\u2019 spear to destroy Chinni\u2014the murderous doll. Fly, fight, and survive in a terrifying VR world where every shadow hides danger.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shemarooverse.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShemarooVerse Digital Limited", "support_website_url": null, "website_url": "https://www.shemarooverse.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads
nc_oc=Adpd3E0Be8sD-NbCGu_927SLOZV2Nn0juQb2P9SB0ujTTSGBfOrzEA8VvVjQwFcKTyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVE-JPeeFlNli6HEyVAXmxym6-Fk7yEq2rIbB6Ikqk5IQ&oe=6B103DF1"}, {"file_name": "robotics-screenshot-4.png", "id": "1640618791146850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771301_1640618797813516_8526078202061736871_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAa34d_Z1qkQ7kNvwHs5vzC&_nc_oc=AdpMvV71D4yuYlKc3zyh5ujqjpdvSOxWTFfY9Zn1tH4yoZ_dbKWzIWT-moFzJPQqO1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnibMr82avL8V9uADvPVZjJrLjnXgIQRfuHm6kDs3-Rw&oe=6B105398"}, {"file_name": "robotics-screenshot-5.png", "id": "1596595059178201", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771280_1596595062511534_6535686872913376227_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOV-U8_2fFEQ7kNvwEBxP1b&_nc_oc=AdqBVdQdvTtgg7yTSZ6Hg4mGdJJHd85Zc28enLGr_QD2tsR45yxuysCW6GWdtssqf0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWY0qwe_6Gkhu5sidLnwse0zqLAOPvVT6U-nRzuBhZJqg&oe=6B104D25"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Robotics Lab 360", "keywords": ["robotics", "coding", "electronics", "circuits", "STEM"], "long_description": "DUET Robotics Lab 360 is a virtual electronics and robotics lab for students aged 10 and over, in middle and secondary school (Classes 6 to 12). The parts look and behave like a real kit, so what students learn here works on the real board.\n\n\u2022 More than 270 lessons and projects for Classes 6 to 12, from LED and sensor circuits to robot arms, line-follower cars and a smart dustbin.\n\u2022 Boards in 3D modelled on the Arduino Uno, Nano and Mega 2560 and the ESP32.\n\u2022 Put parts on a breadboard and connect the wires by hand: LEDs, resistors, buttons, buzzers, sensors, servos and motors.\n\u2022 Write the program in visual block-based code or in C++ and press Run: the simulated board runs it, and the Serial Monitor shows what it prints.\n\u2022 A multimeter to measure the circuit, and step-by-step help in every lesson.\n\u2022 Free build mode for your own circuits.\n\u2022 Scores and certificates for each student on a shared headset, kept on the device.\n\u2022 English, Hindi and Hinglish.\n\u2022 Needs the internet the first time it opens; after that it works offline.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free demo is always available: lessons 1 to 3.\n\nDesigned for users aged 10 and over. Arduino is a trademark of Arduino SA; DUET Robotics Lab 360 is an independent simulator, not made or endorsed by Arduino.", "short_description": "Learn electronics, coding and robotics in a 3D lab for middle and secondary students aged 10+: place real-looking boards, sensors and motors, wire them by hand, write visual block-based code or C++ and run it. Projects for Classes 6 to 12, in English, Hindi and Hinglish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/robotics/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": "https://ashutoshduet.github.io/duet-lms-media/support.html", "website_url": "https://ashutoshduet.github.io/duet-lms-media/robotics/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported
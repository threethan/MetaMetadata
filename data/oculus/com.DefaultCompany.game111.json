_nc_oc=AdpTPJFDXYpCs4E6F8j0-hZz-OZDN4ZyfPu_k9dMkgR9uhlu4XwHu41r9SWplU8mcIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMRLOxGaPH47Qyf8byfPNdlssOmA7OL-AM-a0qHfZgxw&oe=6A6DEBDF"}, {"file_name": "Captura de pantalla 2025-11-02 143332.png", "id": "1884358052478851", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499295701_1884358059145517_5144067951446277172_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWqZMRr6e-EQ7kNvwHFy-2c&_nc_oc=AdqcFXB7rLf5NmgRQ1sxB6Hq0BejgFKqq4bQD22s5m3Ghwy-ClmguMo8sinT1zGaKHE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoEVI7LQmoHoC3S111fZ1neHKOTMyZVNQVx_085Yj7NA&oe=6A6DE2F6"}, {"file_name": "Captura de pantalla 2025-11-02 142941.png", "id": "1526505288296228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_1526505294962894_7874953010502168802_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E0prpiophwQ7kNvwGqyO_P&_nc_oc=AdqFh2XXoWkr6SQvojziSFir-QQ_y_NTry2foM6PQ_2B0BUhVJ02XxR2jktZcrakMOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcEdhNnSbXe3Kna60b0Jk74sdPAHwdIfLMFlR7A9UXdA&oe=6A6DDA53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TheMonkeysPlace", "keywords": [], "long_description": "Welcome to The Monkeys Place, a mysterious world filled with strange energy, hidden secrets, and unforgettable moments. What begins as a fun adventure with your friends quickly turns into something much darker. The air is thick, the trees whisper, and sometimes\u2026 you are not alone.\n\nThis game was made for players who love to explore, laugh, and experience a bit of fear along the way. Every corner of The Monkeys Place hides something different \u2014 some areas are peaceful, others are haunting, and a few will test your courage.\n\nYou can climb, run, and explore freely using your hands, just like a real monkey. Work together with your friends to find hidden places, solve small mysteries, or simply hang out and enjoy the chaos. There is no single way to play \u2014 it\u2019s all about fun, creativity, and the moments you share.\n\nThe world of The Monkeys Place was built for everyone who enjoys multiplayer games with personality, humor, and a touch of horror. Whether you\u2019re here to laugh, explore, or get scared, there\u2019s always something new waiting for you.\n\nWelcome to The Monkeys Place.\nEnjoy your stay \u2014 if you can.", "short_description": "Welcome to The Monkeys Place, a fun and scary world where adventure never ends!\nExplore creepy locations, run from mysterious sounds, and challenge your friends in thrilling games. \n\nThis game is made for fun, laughs, and teamwork \u2014 or maybe a few screams! \nPlay with your friends, explore the dark forests, and discover what\u2019s hiding in the shadows...\n\nRemember: it\u2019s all just for fun \u2014 but don\u2019t let your guard down!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/themonkeysplaceprivacypolicy?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Garizopi", "support_website_url": null, "website_url": "https://sites.google.com/view/themonkeysplace-website/p%C3%A1gina-principal", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24878549411837926"}, "review_messages": []}]}, "cover_square_image": {"ur
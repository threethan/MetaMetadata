86855325681963_8989217553767815737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaGT6aqmMhoQ7kNvwFSJJbj&_nc_oc=AdrthgZl4GCUCOnkwVGya0ldZ1ijTZTqaZCUFdafT5uuPfFg78lBMEt4f6fMTGIO9t8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nGue3171VF9p4j4kZF1zUczErl3JvwVOVHTWDz2ccFw&oe=6A47E2A3"}, {"file_name": "Screenshot_2025-03-30_16-35-06.png", "id": "1688419898716784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393463_1688419902050117_7205293882513245254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBw0AR87f3EQ7kNvwFBPQO8&_nc_oc=Adredo9Bb-1rLDe5kx23NDZaJxuyuNgyRutGG5qoIze5nfp2sbfBoONjoe3baIR16vY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UgVv9EeFmvLbBsbb0EPL6P5uSfGwVdTcrk_D7YY_-zQ&oe=6A47BA87"}, {"file_name": "Screenshot_2025-03-30_16-39-12.png", "id": "554005077166614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391826_554005080499947_6517721594928007831_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIkHHK4ptLEQ7kNvwFQYF6j&_nc_oc=AdoCwxltoZBb-s1_QnUncgbDei-k6-CO7gSq0D-bdsPOHCvTvfi9PGtzF6rKBhB27zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aNrOVA1SYflAdGxq5fdilAjaOHhyDI-YFww0rFNImRQ&oe=6A47BB47"}, {"file_name": "Screenshot_2025-03-30_16-41-30.png", "id": "2086688251758943", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391830_2086688255092276_8966496083934074548_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auxv-a5LtjIQ7kNvwEdDs0J&_nc_oc=Adqv30ikrs0wnATem_fA6i-mPKDr0U7-gClNu8cMJSJ1VKBu4086dyIJxCfs2OEznIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kOA7Ud9bKWL3OQhRi4LHWSoTR4_b8S835mTNtruWcEg&oe=6A47E1EE"}, {"file_name": "Screenshot_2025-03-30_16-39-44.png", "id": "629419176521433", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391739_629419179854766_3664401225442879704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fSScFr6p4UQ7kNvwEtJYBQ&_nc_oc=Adr7N6Mx69z9cS5He0L99kom_aAWJkc-62fGQWtKk6XwTTK58DtgZoZO7b0m9lscP0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ui-DaHjaHVS7GpEYiNe_qvbHJyJr3iceN28WJoA3mNA&oe=6A47E300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2025-03-30_11-37-41.png", "id": "1318194142603919", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391840_1318194152603918_4507675137165197990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAF1lxWz-owQ7kNvwHmw6jy&_nc_oc=Adra0kqC0O8YMNDj9jtELlOeGGLMA5raZ_otyy07Aes04ZBsfnZyS_zBG6waGr-XjBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87sCrobicNLOzR-yyTgta_iDzGC2D8Unsn_Whr15Sd8Q&oe=6A47AEC9"}, "display_name": "RCOVR", "keywords": ["Therapy", "mental", "healthiness", "awareness", "cognitive"], "long_description": "\ud83c\udf1f RCOVR \u2013 Revolutionizing Mental Health with Virtual Reality Therapy\n\n\ud83e\udde0 RCOVR is an innovative mental health platform that leverages Virtual Reality Exposure Therapy (VRET) to provide immersive, evidence-based treatments for anxiety disorders, phobias, PTSD, and other mental health challenges. Designed for both professionals and individuals, RCOVR offers an engaging, safe, and controlled environment for exposure therapy, helping users confront fears, manage stress, and build resilience in a way that traditional therapy cannot.\n\n\ud83c\udfae Through scientifically backed VR environments, users can experience gradual exposure to anxiety-inducing situations, allowing for effective desensitization and emotional regulation. RCOVR integrates real-time progress tracking, AI-powered insights, and therapist-guided sessions to enhance therapy outcomes.\n\n\ud83d\ude80 Whether you're a clinician seeking cutting-edge treatment tools or an individual looking for an interactive approach to overcoming fears, RCOVR is your gateway to a new era of mental wellness.\n\n\ud83d\udc99 Step into the future of mental health with RCOVR\u2014where technology meets therapy to create lasting change.\n\n", "short_description": "RCOVR is a psychology application using Virtual Reality Exposure Therapy (VRET) to help treat anxiety and phobias through immersive in controlled environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrapy.com/rcovr", "developer_terms_of_service_url": null, "publisher_name": "xrapy", "support_website_url": null, "website_url": "https://xrapy.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9971137712917399"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9964084996956004", "version": "0.2.1"}, "id": "1164695914893048", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7420600594637803", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9964084996956004"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779922272, "id": "27536413819296517", "version": "0.2.6", "version_code": 6, "release_status": "PEN
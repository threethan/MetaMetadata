186855325681963_8989217553767815737_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smbayTmLoPUQ7kNvwHbW8sj&_nc_oc=AdovqpfcR0n50Q0h-pOSTn2Hq8Q7nrdSrawfH9qKLsRMa2K7oBzITsfnaNVC2oOB7h0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBXV1jV82k6YRdN3C2TsfzFPKVgLL0LzMGF7Zs5rNUqQ&oe=6AB6A0A3"}, {"file_name": "Screenshot_2025-03-30_16-35-06.png", "id": "1688419898716784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393463_1688419902050117_7205293882513245254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKbID75NgWYQ7kNvwHTsp2U&_nc_oc=Adr95eRTm0E2VhTLm89x7gsBi3XiDSh4lG2kZ3zfx063SAogH4b09an5hPgB4MhZKdg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLresgZrc6-b16r9m5v6YVHpmbzQssoXaxmd0Uh0gHJ8A&oe=6AB67887"}, {"file_name": "Screenshot_2025-03-30_16-39-12.png", "id": "554005077166614", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391826_554005080499947_6517721594928007831_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCVMDcnpLHIQ7kNvwHyVrTV&_nc_oc=Adrb0BtjSMmD0rwaBPmjn0jIwzrJ4yC0BkB-woDUh9jHPVCIqpTBUisDN8QcSWmXEkc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8NOaKbR_Wenr1UukpkCdDxBVBF5ezAgesKfMHHW-TKg&oe=6AB67947"}, {"file_name": "Screenshot_2025-03-30_16-41-30.png", "id": "2086688251758943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391830_2086688255092276_8966496083934074548_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z_mL-L79N8Q7kNvwF32fId&_nc_oc=Ado7W7WEb36Ds-xJ4a-_-ABCFLHdUOBhbIGFKwNatt6uTLIFxf3_mO32_xWCo3w6MjQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL5WwhX4W2p1fpAjbVUKAUyd4FV8RyHutLVSPIdmFNNg&oe=6AB69FEE"}, {"file_name": "Screenshot_2025-03-30_16-39-44.png", "id": "629419176521433", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391739_629419179854766_3664401225442879704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLH_re4uTSoQ7kNvwFegQlm&_nc_oc=AdqrxlxwKuhpVO0p1w4MdTPdgWV74P9bRFl1ASLnPd8E5AxzmfNVJac9F2h7iEOHSWo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX4mhZZEHg8ExAALHppqkJ5BtJm7vir3J9lfOXnh1oHA&oe=6AB668C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_2025-03-30_11-37-41.png", "id": "1318194142603919", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391840_1318194152603918_4507675137165197990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i59wu5vCFK4Q7kNvwFGzahO&_nc_oc=Adpb1KgtmKqqGBFOS5QY0ScefiCl3ywPO98pCxdY09kbRxQPl0-QWG_0vRRahx0ZUjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwnvwUW7w_5UFDRPlY5s7jTtRKHr1Ea9vksEwZzykZNA&oe=6AB66CC9"}, "display_name": "RCOVR", "keywords": ["Therapy", "mental", "healthiness", "awareness", "cognitive"], "long_description": "\ud83c\udf1f RCOVR \u2013 Revolutionizing Mental Health with Virtual Reality Therapy\n\n\ud83e\udde0 RCOVR is an innovative mental health platform that leverages Virtual Reality Exposure Therapy (VRET) to provide immersive, evidence-based treatments for anxiety disorders, phobias, PTSD, and other mental health challenges. Designed for both professionals and individuals, RCOVR offers an engaging, safe, and controlled environment for exposure therapy, helping users confront fears, manage stress, and build resilience in a way that traditional therapy cannot.\n\n\ud83c\udfae Through scientifically backed VR environments, users can experience gradual exposure to anxiety-inducing situations, allowing for effective desensitization and emotional regulation. RCOVR integrates real-time progress tracking, AI-powered insights, and therapist-guided sessions to enhance therapy outcomes.\n\n\ud83d\ude80 Whether you're a clinician seeking cutting-edge treatment tools or an individual looking for an interactive approach to overcoming fears, RCOVR is your gateway to a new era of mental wellness.\n\n\ud83d\udc99 Step into the future of mental health with RCOVR\u2014where technology meets therapy to create lasting change.\n\n", "short_description": "RCOVR is a psychology application using Virtual Reality Exposure Therapy (VRET) to help treat anxiety and phobias through immersive in controlled environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrapy.com/rcovr", "developer_terms_of_service_url": null, "publisher_name": "xrapy", "support_website_url": null, "website_url": "https://xrapy.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9971137712917399"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "680338408015084"}]}, "baseline_offer": {"id": "680338408015084"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743595740, "status": "PUBLISHED", "id": "680338408015084"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28924570790480806", "version": "0.2.92"}, "id": "1164695914893048", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7420600594637803", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28924570790480806"}, "release_status": "RELEASED"}, "binary_release_channels": {"no
vwGK9fyD&_nc_oc=Adojd8_hZuozSUeC8POd82VvU87D7To44YWnfqhZI8TtJqFXlG1p1Tt7Z8IGKFTiw_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_-jtD69XY1z7X9ybBHBi6b9CqHD2FMBHS91zAfGMQPA&oe=6AE20209"}, {"file_name": "com.GrupoElo.LabBookEducation-20260727-134929.png", "id": "911796847993754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310817_911796851327087_4264704991157006439_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkoX_-e_lvIQ7kNvwHE8p01&_nc_oc=AdoU-xaGvH8zxusmhSdDX-6U2rpjAhO9jM1BZ6Nu-0ovvAiuXiBT35wBT4xjoms8K4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbPyvi3p-OOMho2dbXgu9yrn7lW7dmRFioexjHa9rMhQ&oe=6AE21727"}, {"file_name": "com.GrupoElo.LabBookEducation-20260727-135145.png", "id": "1049332690878217", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311600_1049332694211550_1677031004287351947_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjlrPjr8zwEQ7kNvwEXwYx0&_nc_oc=AdoVrc7CjEcw3R-rRmvYpUbpMZf75hiR4zc87enBLpdOQq3AqsBfOdVpYiQDkBK_FhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFu5gFcmUXUkljm3wWMSqm8IhWjykAdw-0R8hqAfUZSg&oe=6AE1F0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LabBook Education", "keywords": ["livros", "infantis", "realidade", "mista", "educacao"], "long_description": "O LabBook Education transforma livros infantis em cen\u00e1rios tridimensionais que aparecem na sua pr\u00f3pria sala. Aponte para o ch\u00e3o ou a mesa, posicione a hist\u00f3ria e veja um mundo em miniatura tomar forma \u2014 com o ambiente real ainda vis\u00edvel ao redor.\n\nCada obra do acervo traz quatro v\u00eddeos narrativos que contam a hist\u00f3ria em cap\u00edtulos, um v\u00eddeo imersivo em 360\u00b0 que envolve voc\u00ea por completo, legendas acompanhando toda a narra\u00e7\u00e3o, e elementos animados para explorar de perto. O aplicativo lembra o que voc\u00ea j\u00e1 assistiu, ent\u00e3o \u00e9 poss\u00edvel parar e retomar depois.\n\nJ\u00e1 s\u00e3o 21 obras do cat\u00e1logo da Elo Editorial, entre elas O Roubo da Cuia, A Leveza da Rosa, Jamila Atrav\u00e9s da M\u00e1scara, A M\u00e1quina da Eternidade e Quando Minha M\u00e3e Voou no 14-Bis. O cat\u00e1logo segue em expans\u00e3o.\n\nFeito para uso pedag\u00f3gico: as institui\u00e7\u00f5es contratantes administram os acessos, e cada aluno tem seu pr\u00f3prio progresso. Depois de baixadas, as hist\u00f3rias podem ser assistidas sem conex\u00e3o.\n\nSem publicidade, sem compras dentro do aplicativo, sem chat ou salas compartilhadas. N\u00e3o coletamos dados de comportamento nem usamos ferramentas de rastreamento.\n", "short_description": "Livros infantis viram cen\u00e1rios 3D na sua sala, com narra\u00e7\u00e3o e v\u00eddeos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://labbook.eloeditora.com.br/privacidade", "developer_terms_of_service_url": "https://labbook.eloeditora.com.br/termos", "publisher_name": "Grupo Elo Editorial", "support_website_url": null, "website_url": "https://eloeditora.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374916395694031"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1798050024515351"}]}, "baseline_offer": {"id": "1798050024515351"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785753900, "status": "PUBLISH
en_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDKhWSUz4gsQ7kNvwFdZvYV&_nc_oc=AdoL67eLEv25ZwUO1RH96xLcIdLs7obnjxfyYBDZnZ_hF-Sp8wUoHYsz1GK2zC58T5Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgynJvwXLez42H1IXlklr1oWXJrujI6e-pUOoHiVvoYQ&oe=6B0B2DE7"}, {"file_name": "com.GrupoElo.LabBookEducation-20260727-135145.png", "id": "1049332690878217", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311600_1049332694211550_1677031004287351947_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9GR9Rc2O6cQ7kNvwHpFGP4&_nc_oc=AdrGhf8ZAHz_wf854fw9tdM2-5dpY04jWEgFTpdX_EIzpMHDmeVIBZyurAdj78_7__w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT2h7KJx25IpmN4y7phxVhp--ielwn2eun65UNrhENrCQ&oe=6B0B3FAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LabBook Education", "keywords": ["livros", "infantis", "realidade", "mista", "educacao"], "long_description": "O LabBook Education transforma livros infantis em cen\u00e1rios tridimensionais que aparecem na sua pr\u00f3pria sala. Aponte para o ch\u00e3o ou a mesa, posicione a hist\u00f3ria e veja um mundo em miniatura tomar forma \u2014 com o ambiente real ainda vis\u00edvel ao redor.\n\nCada obra do acervo traz quatro v\u00eddeos narrativos que contam a hist\u00f3ria em cap\u00edtulos, um v\u00eddeo imersivo em 360\u00b0 que envolve voc\u00ea por completo, legendas acompanhando toda a narra\u00e7\u00e3o, e elementos animados para explorar de perto. O aplicativo lembra o que voc\u00ea j\u00e1 assistiu, ent\u00e3o \u00e9 poss\u00edvel parar e retomar depois.\n\nJ\u00e1 s\u00e3o 21 obras do cat\u00e1logo da Elo Editorial, entre elas O Roubo da Cuia, A Leveza da Rosa, Jamila Atrav\u00e9s da M\u00e1scara, A M\u00e1quina da Eternidade e Quando Minha M\u00e3e Voou no 14-Bis. O cat\u00e1logo segue em expans\u00e3o.\n\nFeito para uso pedag\u00f3gico: as institui\u00e7\u00f5es contratantes administram os acessos, e cada aluno tem seu pr\u00f3prio progresso. Depois de baixadas, as hist\u00f3rias podem ser assistidas sem conex\u00e3o.\n\nSem publicidade, sem compras dentro do aplicativo, sem chat ou salas compartilhadas. N\u00e3o coletamos dados de comportamento nem usamos ferramentas de rastreamento.\n", "short_description": "Livros infantis viram cen\u00e1rios 3D na sua sala, com narra\u00e7\u00e3o e v\u00eddeos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://eloeditora.com.br/privacidade", "developer_terms_of_service_url": null, "publisher_name": "Grupo Elo Editorial", "support_website_url": null, "website_url": "https://eloeditora.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1568524522999883"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310646_1360174532363527_533436738066851882_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmRh8MtWPt8Q7kNvwGnd0h0&_nc_oc=AdqY03G5TrTOXid_IdG0uQ7FdSqwbs2FQC7E0DzT3NxOuLjfknUPSgc39D1t_f8n2U4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_MAxEVikXBnr__8pdtUsvvO9NvFNBNmdzocEVkgzNYA&oe=6B0B243A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LabBook Education", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id"
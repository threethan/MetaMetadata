782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3Tji6PzlQsQ7kNvwFh27Zj&_nc_oc=Adq4HZsZqKC2NH1dd3aMv9XzoAe_PUIJ3mFLFuS5FDoKCoFxVUxmmry2hH7dyxvX5e4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjbqouohRbW9-w1aXykmDEotVTV1KpnFLP6al_50DL5g&oe=69C7C098"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuDRMq9Mck8Q7kNvwFSsjib&_nc_oc=AdqOJmhEr3oXBIYl96AuVHx7P7et0bn2KxZQ2YAjO4kFIYB49VoaMGs6wiVSdMiqsPw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt87BuorkNmH37upikfGFZ52BmNegRNF07vPixzAt5eg&oe=69C7D03E"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2Qh6y5TNUwQ7kNvwH5b52j&_nc_oc=AdrVk4_4eQNL3zDm1bje_-juhnc7JjLmatGTkIn6DIHTIfjvzEnGZ0nRU0OdTV_LeC0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwb8N5vb4nakgHhNpks1Gf9vLOav-YBqRUwfGf2IoebjA&oe=69C7CA25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqK4ryLomRMQ7kNvwEkcg_G&_nc_oc=AdqdIccRJAV8DmCf3QPH30HS75WWG5ZLWLr1UfcAonshgmZDp3ek2qzxMDHhs50LsAI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGxfJcjZHJyScI-uakmoMpknaaetzKhHEU7IMEMRTK6g&oe=69C7BD2B"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1293529914494481"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "60441498
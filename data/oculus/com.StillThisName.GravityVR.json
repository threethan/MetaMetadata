0295_621820005661148_8272682812518160764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1swaPti6_AQ7kNvwEQfdFS&_nc_oc=Adm_9XdH9UMd48CffEJvJ1jdvGw3ypF16xfbBOI52RWE6r-xEuSmqkjhXzJ3R9tprZY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9TwxJYmqykOI4YSVEo9vf7gS-oazO9QrvQUFMqom0Ww&oe=69B93B98"}, {"file_name": "shot1.png", "id": "592538835115662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_592538841782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DJyNmlJQqUQ7kNvwFiFZmL&_nc_oc=AdnPI2lGiIYbaNgngzgfBhj2zt7yKJrDYPa7BXMKzTyDRK2Vj45Qyel_5a3wV9wIlZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvPL-duTMusjsegrDHgwTKijA8HYnHzSYKnqI4_ElpEw&oe=69B94018"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyrk9PjT7CEQ7kNvwFgVJQs&_nc_oc=Adm2uVZvLG01DGZN9McqwDGbh4aqEhPEWv7d-NgawFjKtjm4u1q9ULQkkmc4QoDk5dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm-QafDEu3N892n5a_iD65BYtSxLtqymRtXQxcQudgPg&oe=69B94FBE"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXNsBwIlcyUQ7kNvwE0IE53&_nc_oc=Adkm0ByttiI6dYvuwc5FpLUMaGU49EW3hlpL1uNQjc6AIWVKvGQ0zZNnatt8oB6vcaw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwBTVWGv5htrXKXIUKolhAan3rM66CA4gAfyxlfZBuWUw&oe=69B949A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8lrbH5hyucQ7kNvwHy1rB8&_nc_oc=Adk1rzYWRZVJ4hEEGL929I0KKZq-rn1WiPFPzvb_KWKM80COzRVvxA33Fxy_9f5OJ5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQ2gV4CxrPnQr6055OHBPfEnDMz0lljlmTct2DCEMMLw&oe=69B93CAB"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
0295_621820005661148_8272682812518160764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzWXj9r4j0kQ7kNvwHzK6o6&_nc_oc=AdlynJ6wNMbIgOGfsbPfUhG_Dq7YFvPshQcSX07Gvuli34GJc3STPkmxBOpe9ryHLrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzie6t-yn_rYv3HLcg5mtx6eopGta1JIM1PGKr3sZIDKA&oe=69B54718"}, {"file_name": "shot1.png", "id": "592538835115662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_592538841782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBq1DTrByMYQ7kNvwEEj7kC&_nc_oc=AdlMpDD2TIoq3b99FLZ6Zk7ZSIEZlEAgTKnCkBEiunxSH6vDRoR1253zmBTfQRUzrdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnKlxqpqkQEQmTw1ZjZo9_L2oQVfVvwVkbQQ3n05li8g&oe=69B54B98"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FThX7YnGm74Q7kNvwEKJAv8&_nc_oc=Adk1ORvnKveCDcy8pSzD8vRQi4869O2Fxvgg0sa4nWBjv4E75cL_j3cTZiSju9nIzQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEpbLJfLI8XYwf-E-k6hH6WVHZTV9SwKqDGPuv4TXmbw&oe=69B55B3E"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEYqKQTb-Q0Q7kNvwFHIu87&_nc_oc=AdkcdBQP3ORHOZ2TUyoSpS1MoROBFqpuL7mwY8YNWC8l350UtxKM0vZJI5Ql7rV3GIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzVTSvLTHemuy3Awx63_VIPJDBdpZYuYPSbW_G1JNBjpg&oe=69B55525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XMlEy1-ysUQ7kNvwFQdnrA&_nc_oc=AdkvIAUCAmS5KnRP1T8EZ_ZJqZOriXs2MDioTMxZIYc07ny2IbdRLFqIUtSIoIqDflQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwazuSqK-AfLRrYfJ3OMy4w2K_d8FH8wxNdddwJE3FFg&oe=69B5482B"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
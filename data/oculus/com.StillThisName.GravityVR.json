0295_621820005661148_8272682812518160764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-EBgQ_u6w0Q7kNvwF26Nr2&_nc_oc=Adkz1Z2A-2gU6Z0ZJwF7DZpvIdr3UpGTUQWkHc_Dau1FsnpZNBQSE-Jv2uAZ6ojHG_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoZ6QgwDXzYVMBu2oa4CibtKqEruShP-u8k_szO7SA2g&oe=69BFD318"}, {"file_name": "shot1.png", "id": "592538835115662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_592538841782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImXaDZkmr-MQ7kNvwETBZ2w&_nc_oc=AdkX-4iHxzKqHBrEEg2dGDN2_4oHuJ1x6kpSsehmZhdxxSsScnVyL1eiLmlZxoDNH6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7rkf4CxJoMZFPZ9YwIS9pe6dFJ1Dz5Wy7HfDgxPZMZg&oe=69BFD798"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si4RG5GNA7sQ7kNvwHGL-ZR&_nc_oc=AdnQ4c3mf3FTCP7qaCYvb8vyFPejVwJ_RRBKOb7Lhr9zvLsqKnd0UbSRY80SFwHQjGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeIDpYqWz9tNhxAVKDVavyJ3u6ahydGnSLuJqxazJa6Q&oe=69BFE73E"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euDia7_9DIoQ7kNvwF0ewpw&_nc_oc=AdnrxtbPylyHJd8Ssc2alsZDssSi7n0XiOTjNV_eBNCJImgY8vn0a-8LkWNMy1i0dzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwn85jCkFbvzIz5s8LNWbyay3IPo2jf4wLQ9TGZI9u_Tg&oe=69BFE125"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYRpWSdn3GMQ7kNvwEGuD18&_nc_oc=AdnmjHoHdndB1biijTsAPjAxDjTodJQk5fvrmA-j3GkFRhzTmBjyb2PpsnYYq_67yV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqShWbGHE1wJ69p2kqZdpcSk_r0jSEfjaX_LUl86kuNw&oe=69BFD42B"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
0295_621820005661148_8272682812518160764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzWXj9r4j0kQ7kNvwHKi-xz&_nc_oc=Adnw1gHSQ50mkmaLajir5M9Ltg9zaAC76aRvs-aNAKnKtePvvPbNhhjYhLCg23q5X-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVim7JJlklktaGnGgJjBWf7Opivr27CFj6_bc3wMljuw&oe=69B69898"}, {"file_name": "shot1.png", "id": "592538835115662", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984464_592538841782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DJyNmlJQqUQ7kNvwF90ZYz&_nc_oc=AdloXEIK-kurAlNhtPL5TRjibIadkfNHuW0eigZyGf-vcLoCxvO5pIpQx3MvzT5Eo-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqVTSV0rUOiZgPGDjb_5CzX7TJNAy-qT16F-6jgJGX4Q&oe=69B69D18"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyrk9PjT7CEQ7kNvwFKxUFt&_nc_oc=Adlu4JpRh6sCwA2b1G_TRU9A5qz5ieLhVM7Hm5E_QptZfD-yQfeO6DnR6iSwzo9QFDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhD74MIWvTvYLn8JRDYBMR074pLCdGETG3UmguD_a0uA&oe=69B6ACBE"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXNsBwIlcyUQ7kNvwHtq8wJ&_nc_oc=AdlOLoLcSBw_2N58eagBpt44AKdC4HotDJkXADSCxwUJYYxO9WlM2v1uTFgagt5D414&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ8whzxM5ee6YcsqoQzpfRTHyOgQvq9PuIIBqgJjHTOA&oe=69B6A6A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XMlEy1-ysUQ7kNvwFW0jIK&_nc_oc=AdkZhM5vsPnF-epo3ZMdBNXYVYxSpP8RyFpXt0YJyLiEqto0kGzcDcnkKiKVdoohzi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi8UG9TQyGova9OtgOlmT-oUSGrhSbbw8S_ixfjURzFw&oe=69B699AB"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
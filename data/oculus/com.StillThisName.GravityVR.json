0295_621820005661148_8272682812518160764_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrIljcXGkGUQ7kNvwGJ2ghF&_nc_oc=Adm5sL4hUn0CEH7s9PLcwmWEKwHUq5irx6JSYJZ2gTXg9T8jq7JHsv168Cejxjkhdbs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8FzP4pSMl19NsM7UV96oVu-SllebK3ItzV3dqhNCPyw&oe=69B2A418"}, {"file_name": "shot1.png", "id": "592538835115662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984464_592538841782328_6181936345411636019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBq1DTrByMYQ7kNvwHBFjo5&_nc_oc=Adn4SZbadqyfhFm99ZtSL1HdIUUWD3wMoUFwPiIPlVBTkTXbeuZVeR5C6LNqWCn-bj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk7wlyGMPOwbOyvjfmAxAE4w9xbENUlNZEQ_F9JyO-Cg&oe=69B2A898"}, {"file_name": "cover2560x1440.png", "id": "243973341055980", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75289719_243973347722646_7552601174685460740_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FThX7YnGm74Q7kNvwHEiXLr&_nc_oc=Adn9W3SmV3ffZxRT6KdY2UUadJic4XJpA39COKjB3xo3Vd2n9ir68_l-ohu0VAF84BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuAvsxjxZJs6fMxI1xxXExfv3dQ9WnZp4OaTVeyYDb0w&oe=69B2B83E"}, {"file_name": "shot9.png", "id": "231133592364622", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974444_231133595697955_508502976939701772_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEYqKQTb-Q0Q7kNvwGLeaq4&_nc_oc=Adm5NEwR7-UoQ8rJzLe-4Umd-E1gm44KkivWUsQ977F1hLGw87dIIMSVRSatIbOOZQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6QrjxEm55XSou2XLHXcOu926XDYQ2cy9il43IzpbkOg&oe=69B2B225"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot11.png", "id": "2993083937593903", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572935_2993083940927236_4822662181164399403_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doqycoz98PMQ7kNvwFv9j70&_nc_oc=AdlDxZnUG5BmERNUQRmSARnAI8tNAQqzfpbzLNaNgsC64ITEQ0WPTxgdq1Q7VrlHmEQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9kx6RzGCK591UbAmxqx7LE1k8Wnrk5CQJ-pv5IANJng&oe=69B2A52B"}, "display_name": "Gravity", "keywords": [], "long_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops.\nOculus version looks like a cube, the same as the Gravity concept. You are standing inside. You can switch between different minimalistic sound-reactive themes surrounding you.\nAnother thing you have control of is an audio-reactive geometric form in the middle. Press triggers on both hand controllers to switch between different types of inner and outer things. Press both triggers quickly to get the metamorphosis effect.", "short_description": "Gravity is a virtual reality music visualizer. As soon as you start, you will find yourself in the middle of an audio-reactive environment where you can switch visual themes and backgrounds, walk around and jump with the teleport. It is a VR version of the same-named audio-reactive app for Windows and Mac desktops."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-PrivacyPolicy-Sep-2021.pdf", "developer_terms_of_service_url": "https://www.whataboutgravity.com/GRAVITY-Oculus-TandC-26-Sep-2021.pdf", "publisher_name": "StillThisName", "support_website_url": null, "website_url": "https://www.whataboutgravity.com/oculus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ART_CREATIVITY", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
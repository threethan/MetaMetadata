8&oh=00_AfySnfxgsoc44P2isevYDcA1c-kWZAZea1lNVgWBNu5gPA&oe=69BA8D2A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdmtuzwuQZ0Q7kNvwHqgVqT&_nc_oc=AdmyZ5Pq8u-DzIDqDoW1gWlLbgmGC2qRbdX_34PDGhQw2aNqOmOHzuxGK99DQ-cE6zg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrUAsXYZn6ZIedysJAt0n2-jGqOrpK5VksTWScbHqncQ&oe=69BAA482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxCIB330go4Q7kNvwFOi12w&_nc_oc=Adns53Uam_5lFs9OAEfHyXdN3u9n0cDuMXrJuRlvK7Cn4RM4lHe_Ts8P7SrxnfkkXJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2HtyQR_KzntvOMFveDp6PXa5qnHw1FQS4cz-jlqXCkA&oe=69BAB73A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://superpanosdev.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://superpanosdev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25426317037013960"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1605699143395715"}]}, "baseline_offer": {"id": "1605699143395715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741460400, "status": "PUBLISHED", "id": "1605699143395715"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34248311468147762", "version": "1.3.4"}, "id": "472261345256413", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25426317013680629", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34248311468147762"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "L
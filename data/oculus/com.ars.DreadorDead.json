a0VQVo2koO3BG6kKZ20Op4EZ9THS8yDyVuA8J9u5wyhMENS6ibTOu_KgnQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUy_jrvYq1SDJDOFf9GvYIM1eXr1miaeSpa3Wv8DGqQQ&oe=69C29323"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIxGHM_W_mMQ7kNvwEtiuxg&_nc_oc=Adqz67WiNNR5ewkR1eawJzKstwDXpoc62CC_EWcpGBOgls1L6WIU2u3zFbcXf8Rg8Hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLduFcfJ4WXlhTT9PzHG6OPhlOFCb4E0EdPke25Q203Q&oe=69C2762A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQgZsmQEq1EQ7kNvwF5udd2&_nc_oc=Adqx4jQeCCgwoNGHu1CyTO9b8MXyyOCdssp5cYs4pkhusx5qTWbc7aNTNd91wjr6Zjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1nH3p90anBoiAWpXEuEtiFmDhazt4AUbbwQ10SuHEHw&oe=69C28D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EA3O-Jtie8Q7kNvwFbk3is&_nc_oc=AdrxJJdzEhhJIpAOmFq4zLlNrx6oYth1fa2lCtQffITlfyT4G1dgvHh_jEqbxQt_2BA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHRb_5b5Yez8lZ2rR7OouAD_-ZNUtH1We5CgF9fCT_kg&oe=69C2A03A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDFc0gR4-o4Q7kNvwEaoQlM&_nc_oc=AdrNJ77ZZEd6PLkYqLhAxSOk11HO8EJqP3i3M8X-6N9fePYjiQnvnpw56PaXZ2JlMRs&_n
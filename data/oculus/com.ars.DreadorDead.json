&oh=00_AfsOykz1aXNmi6kyBasJ9gXybnj8k3k_aI_Qqdt3X8rAyA&oe=6999B4A3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEfGk1K1v8MQ7kNvwEI49zh&_nc_oc=AdlU-XJNekC26Aam2BTwj-I0RBsB0c4hsZmbnwoQMMJ6rdHa--f8N-3zkrjDj4peExc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAzU1my8qeKVc81qKcpyRi3v9yskRV95FUXHjgCB_Wxg&oe=699997AA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v3h7F9d0RoQ7kNvwFtqmms&_nc_oc=Adn1s-1CtMALMk5wF8bOIfD2lGxvfvA9gE9SEJIalH5cPICnMYLpzp5FNkjmyMC1Ptk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvy0P8DzmUQoGSQxSFEu53GUJeDvE6T8oI94nC9dyJxQw&oe=6999AF02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r1FjM_FZxgQ7kNvwG6wviL&_nc_oc=Adk2-DS-2PnqSO4ilNbRiau0uFSEYb5znWGYCnB8G_bNQJNQ43F2zOuXn52oj3cHDrM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9X0etOuaYGuqu0mUbH8kdqb2ixs680-vbtmsLU03lIw&oe=6999C1BA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XB86c7XIloQ7kNvwEXX9zf&_nc_oc=AdmwWmi-m5kQ8RjJnDcDf_DQSMQrdI8F2E1AKb1oFaw4QPN1ZfzTOqwSUG_LoteVRHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afswdhi6tS8mm2hy9qdAZ_aTU0C64EGmQmH6Tw_fIwD_qw&oe=69999115"}, "is_concept": false, "is_test": false, "is_t
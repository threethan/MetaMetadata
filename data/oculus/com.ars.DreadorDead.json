&oh=00_Afv4gsS9nYUngxzyR65DMpA0VkpJCXPeM7KDGePhPJbJSg&oe=69986323"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEfGk1K1v8MQ7kNvwFNcljr&_nc_oc=Adk9LeMW93sY6KKOoRlU6R646SWx8y_QTh46LjpXpkTnXGt14ABvePohGz3VNOn2vFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs10cTv16nJhdRtca1HT1K5lHKqrcELLROkX8bY3Z4aMA&oe=6998462A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8v3h7F9d0RoQ7kNvwFAzKPv&_nc_oc=AdlvfnUy1B9a-Q5ldan1EtKqb6wFiEal52_wBXxYMMFTWJURbpRTbNj5Fb5034pLuUY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afto6qzShmDssoqUMym4W5ogXMVFmZ8VRC_z3z6qQ1sJWw&oe=69985D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70uGStg2XAUQ7kNvwFdLlAa&_nc_oc=AdnCB6mXru_SLFFA7iJ0EmflkA_XNwqw4gT-Ep0PnBGp62hvVhdpnpTBLYWgc7nUUF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuwX9sJp45FDO_fV2FYrp3We9IGzrYCNNd4ju1JqTe1eg&oe=6998703A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XB86c7XIloQ7kNvwHF2eDo&_nc_oc=Admpl-pRTqWhx3r0bKh3Y9cLX5qxm5zuYRpKRc7inY1-AlEKiKlG1GukY2rZ4_t9oKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftpZjp0M8hBY3JgG111feMyhT8vDwffDjxBhTwrOnaJ5Q&oe=69983F95"}, "is_concept": false, "is_test": false, "is_t
1845_1362275808115662_6678202708924186761_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHIEvCCFuT4Q7kNvwGS4lAD&_nc_oc=AdpUvvh9oaRzplaRrVtkYMErkvBg7SJ_V6R-QdrXEddykOZHBeWl1Px3uSrUQIGaDeM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhTj-z2Z2MGdxcTNL3vkrVGnAy__LJOUzwWwWuJniHVw&oe=6AFB3EE3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGx4WhCnD3cQ7kNvwEktdD0&_nc_oc=AdrypZpRo9Xo5NkRtobQrhBsGpRKtODiHDSP8gjIma0pgAqqBDUN39yFoka-4JdQEKA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQlnh6kKEyTTNEBwWGpdQ2QKmvQTVlx2pHQYJe8BCvGQ&oe=6AFB21EA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVrKI3rwbREQ7kNvwHPCuE5&_nc_oc=Adp8MQoo-Frm7t6a9FpKlVZw8S9lMoChaUfVhxZ6Zk8C1BUbb71Usp-Zo8wwdcx4Uuk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvzKxP1VPKsEtViaS-DGJavesCI_wXKwRTZGq0dQXFag&oe=6AFB3942"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URPLxvrFtdsQ7kNvwF0X-NL&_nc_oc=AdrNmYB06qrjNLfza-rqTg-4qWn4UKTRLQIm2qwlWF3oVysUlokQF4DFSCzGFB0T75w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrGopL8ICoWBsmBD7R-mZOssP8tKiGaVZ2JPejq6Qm4A&oe=6AFB4BFA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://superpanosdev.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://superpanosdev.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25426317037013960"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1605699143395715"}]}, 
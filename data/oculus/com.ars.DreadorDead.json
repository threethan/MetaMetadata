2qzeUSJNN6YyL6XpFeZKKHyNXMWAl8srE9fYZxvriCUz-f1HEq2kHNep_D0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7vBQwsi507I9WeSIPZyLBPgufbiO8-JAgeFIbfHQ1zg&oe=6AE891A3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcVTlqg7kDMQ7kNvwG-JLwY&_nc_oc=AdqPFKa80N1LZgXIDvBt8intQnMsLHVuqgzf8QcQ7ZjXzSRMnKa4m3m5G3oTTK8tXkA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB0HfWXDvOV6ue7uz2B5P2WRAgHX4OvP0yO8QgejeHMw&oe=6AE8ACEA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-3qlXndPdIQ7kNvwH4c9SI&_nc_oc=Ado-28IN5a1TlAjQl2ELv-sz9lF6AJlWxVeN9AryREmD6SiVs6_W7Tqbew8aYmazohE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMIZV1d1-glxb9hSNj6kjdfNPt8xNwgSS4ap1qedDeHw&oe=6AE8C442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHxk7qn1dtwQ7kNvwFuIknx&_nc_oc=Adp5hbycaBRHTGnBHY3xg6r6hA_QXanIq_U7swNYWb3UmmOGFebsj9d_9FkvX4hQrM4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReoTkaH5GXCPhVXk8ScFGj-gsRGs4NVX603a2Z0CBH1g&oe=6AE89EBA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://dreadordeadvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": "https://discord.gg/dreadordeadvr", "website_url": "https://dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "38062553883390149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnzpObQ0oEIQ7kNvwHRFrRe&_nc_oc=Adp0UKuFVmOzfGy1K3J89xobcIru6DzfSQllSvBmkVWaocMjwnGF
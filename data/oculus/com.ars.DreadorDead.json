Z1UuWWO22zV9u13G63z-KVeXmyukUMZWNTvSHYUYBmsEoXnR5k-orHCJj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-xYic-Byjz-mg-IhqqFUUT9E-7lp9vekiNAVHLi_AlA&oe=69E0E5A3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Zoh7wYPnk4Q7kNvwHVsl3q&_nc_oc=AdpD3oWSfgqDRwwxrTHCpR06vgFBtg1JwI56Axpq7ySJn5_O8EatExiT5NsyeYLxN2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gBuUo6WKt4B7RX5ajZRRNAfhCB2nAXUq9jiPBj7Bmqw&oe=69E0C8AA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTcrM6NfVeAQ7kNvwHXYvFA&_nc_oc=AdqpEPtj93V9xe8tMUQRhiFtEOkMmi__U3_7JKuZ30LKIIGbo88ScFjMahthqIgeGYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QXQC4VEsdZ6oAhgluJg3lCPtc2FbtepcET3O8RBZ65Q&oe=69E0E002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoJAkrotyMwQ7kNvwECofVP&_nc_oc=Adp-Y1bGskbXQH-nWkJrsTn0i5U1wr0iAyAp20dMa7H4T3BKStYs4uQmuid58_HvSTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hC5zGjUZSu2Zcu9cWw__NoQMOwXvHOmtzzh5hrJoXPg&oe=69E0F2BA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOsTnV_iQgYQ7kNvwGCh5rr&_nc_oc=AdqSFpKUIeOYnvbMMekIG-uiGPC-3O4nGKOGjMDH5D3r3HCEFGTC6cvmgAjycYRpnS4&_n
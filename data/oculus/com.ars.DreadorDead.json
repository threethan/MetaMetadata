XfiyDvA6wc2rpS01ziVoqTQOBzDR7FYIzGxSD7Uqn5RcR_5D_fRGTxRMEY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MwdmtO1CDlBnE8QF62SddGqm9rbOWnTkIP2UfeYYM3A&oe=6A105BA3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTXfRsyXxSwQ7kNvwFOIQU6&_nc_oc=AdoyjfIHDIxoJuujwMq41pHFLiMZsIiKKuGNDvvZ0lVCFxy29NTTwQszm1BACleYtkg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qQ1XGManM3oTYigQU4f5EFOmsqwyiR4dcRPCKp_OjEQ&oe=6A1076EA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BeyxHvDqdvAQ7kNvwGoJK5x&_nc_oc=AdocENn92yNjrlK0ABHf3kI9HkuVPbc8c05w3yD40k_nIC8SPJ3WuIZjXq_xJhglMAg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TFa8K4_uPYGVbh83Pd0k5qfAw69MK9IUznsnC7L9o5Q&oe=6A105602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaB2vCfJ3IAQ7kNvwFvWpro&_nc_oc=AdoKfvuEtMt8DWFb5tbgIWupmJp7V8vftiwEAuiVdOO2K9To-4TUv2EC0sSWmkRPCOU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kIKEJBLaGFtQIZSIA5VhXjA1gwk5sSEhSYjF20BrTCA&oe=6A1068BA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYFf_6VTmSMQ7kNvwEZtRZl&_nc_oc=AdpQd_RHg9S39JhXPaoC6rhB80BA7AUh-ypgOKeKPJn5-8Ur8Pgbj0TcOsqRvW7_YS4&_n
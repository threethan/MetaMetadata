4GilHTQAaTVa_tBGVTQV7x9cZJg4b3jxl-HfCj3HuwiH1tzfUTGj0r1LQvY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaz3XVd6PdWuxv7xnRWUsPhd8D2LjvAg6CKZrxQ4gu6Q&oe=6A918EA3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwUL-T-And0Q7kNvwGdJnFi&_nc_oc=Adp8CpMb_hTzzdXSnLKjpG-3GSMYOmp3tij8SXxwT86JOyRmi8NEpreT2Z5fxaJAp6U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECLfJHYfsSaflZUt3A0Fg-QlfqDpTrQ92liOc9ENF3wA&oe=6A9171AA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGo9Y-_77dYQ7kNvwHBOi2E&_nc_oc=AdqTAjBXW9cUNUq4PI6CIir3RQAaTJF-rfXsZQXFNjl0_LYI8aTktqjSk9VWxpxWW-M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx3eXjlwCl5gKQb2Y71u6bYLSGXj_YdPHO-Qa9kGd0Hw&oe=6A918902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1F_moVoDdkQ7kNvwHaj74-&_nc_oc=AdqLRI85koecEuk6a6tmtd1dt-medoNclocFiSJGUMt_yxGOwSEQ0JkG9rYtmavH5wg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJcXLwQ--7laxvJFhkm6fYXnwo1DzOk_jSvzEaHKT0_g&oe=6A91637A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "37477744181871125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43f6aI7vdD0Q7kNvwGt2RIB&_nc_oc=AdojNWuIGuCA8Cytd1sYCNP2tCiPvAylCRaxrY6sa
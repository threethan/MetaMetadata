&_nc_ss=7f20f&oh=00_Af3tgaLWOGwq-YcDGr7yxargYOoT9aZBp6aG6udFFzZ7Bg&oe=69F20923"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXJRxYwyw4UQ7kNvwHa7jOZ&_nc_oc=AdrZsa7qVIeXguUnW1we6F9m7xSlckHNDLXkZn_k-SPDWN7eNpqg3AvsHSn_F5Z-0BY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0MtvQ45byjcJAc7ohHLaolJE_N4QVmA6EFY3wAhbyctw&oe=69F1EC2A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4U3DKtub6sQ7kNvwELlC7q&_nc_oc=AdpzOUEZaX-eW8MS9o02Rv9pDRTw0fOEq4SJ0MSW_8NJUqegiq6u2rGjX23k_sOjxPw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3O4jdpARPl1pf4dGf8Rv8DQmRtm5x_Ng7tSTJMniQchw&oe=69F20382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjS6uazQGs0Q7kNvwHrGo8F&_nc_oc=Adr9I9mWkBw_LzqwbvaMfNjo0ZAsYcmixan6AFjQXmy1OUxIKS0i41cC7l4Hn1kAdk4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0Vuh1nPt4sWn7vDIqF7nNl3CJjl0_tuIcC5brluR2NLQ&oe=69F2163A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzJfK227OxEQ7kNvwFKUtnt&_nc_oc=Adqy6N87b9DiN3Xn_vnZkeiFTuLipNjX1J2YvnFjYU3YNPdDl4HGoX3sDiwHMcGZQF4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0sVXJRliEoBu2aWap0mJY5i16rEW_spqx6Z4TluoZ_yA&oe=69F1E595"}, "is_concept": false, "is_test":
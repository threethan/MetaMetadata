c_oc=AdpZVBNmNvyvmJVybgJ2r3FgcJDjYD6rUkpfuOl-8mi1HNb2o5Ybre-KBifLoMfB9eU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWF7Z3UjR1-qnJg_5pEkglvHXhsiItq5milHp3n4Zg2A&oe=6A8D9A23"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgrnVDTuW5UQ7kNvwHx7ce3&_nc_oc=Adoxy23SrfO8J3EW8r5CIypomPzp2gE81PnlEVhJyAjKCztm4QdxyIQgOv2jdV48pbc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6AjH9_AD70KGthStT2teKCpecMBqxe6BSLDEF6OP51w&oe=6A8D7D2A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgZ6xlsyRtQQ7kNvwElUcjp&_nc_oc=AdqGslGxGSIOTMfA7zLxmN_AsoXSv0OhYq5N52KKmrsl9x388iJp46eMOgrvCqnSX1c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF_Dj9QJe8BBBpX0ggbaF_DLNZKZc3ij0h32Y71YIAHA&oe=6A8D9482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cC_DBQqGOAQ7kNvwGzRd6Z&_nc_oc=AdrA4wB7wFlvh0oOE6UHY4k7GpcihEKUkdDZ001g-kueTJocdaMc-PpevjZ-T6rz0cE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Mk1-jZWQ2Vrl0vFnLya8kqnwO5W3EO9B3031te5K_g&oe=6A8D6EFA"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "37477744181871125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGHwg0SibLoQ7kNvwEe0HBZ&_nc_oc=AdoJk0fa4r5jcUOxjSn8s3Lx
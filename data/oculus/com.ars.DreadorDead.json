2qavDrVmTHmgXmopKtrHM4kKlcO7ukKQZ6feME27aDxuLg2Lh4QRUokotM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ltOFHdtFg1IFy7eqeT5y3q5-YGFxA-_jtRhAaDJ1W4g&oe=6A16F323"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgafTsYcOr8Q7kNvwH_oi7A&_nc_oc=AdpyHjXkYMEyYi1TbXnLCAr3iMxRTIrvDRMJQmV9zstLpeAd5Foud5x-mk9FgZ7w2lI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66_dKC3raRhtus5YzALwFjDyXcXpaSmnxnu_5RuakNNQ&oe=6A170E6A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr0WahntPAAQ7kNvwGHMQne&_nc_oc=Adp6qE-Rb91WEaAM8TIbRCgo9qdVOysuZq6M6LvmNR2Zjv6-z-Oqkk5s_LaLJ5uTM6g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7__kx8bLobrE19tPCtG-jEmHnDq91awHta1m6oyJ8kOw&oe=6A16ED82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uant2A-PZbMQ7kNvwGDp2a1&_nc_oc=AdpAl53qteWZtxhsdkW3j7NHa8N9-yjOs_dbIpCPiEFcY6kca0iBML_aS6s3Sp-cRtQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t9Ev7Mx_HYCGRvmWWX3jvnV_YZ6QIocxqb9gC3I-L9g&oe=6A17003A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbpbWp8xCG4Q7kNvwGUhSn1&_nc_oc=AdrgyrTcMYXtk-imSFGDIXqHLWq_hGcyhKnLiBhuDEg3RvWazUoPjU3iOiQlDdwDigQ&_n
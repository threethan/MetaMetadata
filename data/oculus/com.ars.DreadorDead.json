xnA-_e4PTZwUKyqAzeZ8kiriijpmoQonJ33UVDOlDvt1CEwSL6BrA7Mock0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAlnSf42jmdg8QyyWBmDfZnrq6WTaID_Xi004J6j8Esw&oe=6A9431A3"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwUL-T-And0Q7kNvwHA5D0Y&_nc_oc=AdoNgXpPXnugvQYpACX4EwL6q49DbPZyP8b0t1YMEigq4lqPcguJjC47bLqzcfzqoCs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETnwL8Cm6Gfk1aW35Y7fIZK6p6A0kx_xSXI5cnlyHdJg&oe=6A9414AA"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGo9Y-_77dYQ7kNvwEIWfP2&_nc_oc=Adr8hZqkjmcBQGPFEXCoMxY8eNmrqaBOsjeByoNWgDrXeOABaz4czF9agQiNdxjWeNk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCwHjKWBoh1FQBbklbmrU9hIOXJ-WtQQ5eRwhQekvBpg&oe=6A942C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_7fNWgP0DAQ7kNvwEzgkcG&_nc_oc=AdqudEB4a98S02p_dMvzO3CPS36EFwfMSgun9DzAke29iSGyS5ZFw8ejixSxRFpAdEc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0p-r91WsxmEjs67MykHOItKMrAx-z71q1rkmhVtrHIg&oe=6A94067A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://sites.google.com/view/dodvrprivacypolicy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "37477744181871125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLQyCeuI7CQQ7kNvwHxv38K&_nc_oc=AdrRgUTPsGBly4kGXDUmT3gbSE6jM9KDaJ0I_X70h
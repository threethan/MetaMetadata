V3CF8It-jlmrDouQCrPRuxgdAqteA0LNOsr5qBXDvJsTNNfBWFsuwYxvZj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ7UtbmIrKS5Z4eMpKyOdhi9nWS7uCKQY-W4QuRLmbyA&oe=6AE9E323"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcVTlqg7kDMQ7kNvwHxDc-T&_nc_oc=AdoPJHBmu86PC8TBEGwOewP05MmvO7zc9MwIL0q2Ci-r7lFJM3i-mteDk5wPBXpeevQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwV9LKdkwmOyKnuoWQnTrHVQTGS9pOS2m7USCQ4doriw&oe=6AE9FE6A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-3qlXndPdIQ7kNvwFel57s&_nc_oc=Adr2tj5wXY1gHYmgOjss9snOAJ5Vqz741DOKI05tt4csf7veOa74UK9z2nZKRXHbBAo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOzbN6g2E_ZXuRPetCZ9nD9DUiz-IfdtN9AYFdt72ZaA&oe=6AE9DD82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT2H_L_K-4wQ7kNvwHRHuRm&_nc_oc=AdrU5ySlq31QOJepJtoJT9BPDBWTKe9vmzy8QHETD2VyE2mSdG8_FrQwlET_l-glJkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSneYVkSDC-CpbDnL2vlLM6ThQ3Ib9azFPWqaFmyiN_cQ&oe=6AE9F03A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://dreadordeadvr.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": "https://discord.gg/dreadordeadvr", "website_url": "https://dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "38062553883390149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnzpObQ0oEIQ7kNvwGz_Rgy&_nc_oc=AdqoSMarulat5NYqaOHxfm_vfylEavF6pkTqosiIFzV4Ld_jiBB7
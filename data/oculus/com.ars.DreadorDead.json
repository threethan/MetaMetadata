FiY6gt1N1X9bOeS8FLTC4ujqa6zzQMklZok-coEBImCPagLIABjCZLd3W_oI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Xy4aIWu_EgZlnAqxyfRirBqeTyV9wZTP3sl96-0fNA&oe=6A466923"}, {"file_name": "screenshot4.png", "id": "1175342817457094", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391830_1175342824123760_8535896639887483672_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-YM9F-xHa8Q7kNvwF0Bk_T&_nc_oc=AdrCmJpBEwoWK2hlSF-80vvuYybqsEgEMFAlqdtfzt8OOt4Kl2ofP236qkI5ihQXovM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w5zB2Pf_hUROw1peslYE2r38DWObfzKU8XDycDD-W1Q&oe=6A46846A"}, {"file_name": "screenshot5.png", "id": "1316773356196351", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391826_1316773362863017_7165967295503688214_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQcSj9Ma2-MQ7kNvwFT3QE9&_nc_oc=AdqeReEB5BaPMbFgv_B2j7ob_pmmnxVzgU4Kq8UH0rQ2T9LlXV5r6edQup2TMm56eDI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HCs-lNcWcGR-CrTpIf7jv0vy1yG4ak75oDOhrY9ifqQ&oe=6A466382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer cover image.png", "id": "982679307135562", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391716_982679313802228_7898284411266665802_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nq8pAya3LpoQ7kNvwElFkyV&_nc_oc=Adr4t5K19uXJuHJS4V2pHTJzyYqN7hzs_SHUCkT_cB-mvQkOMgXzrc1bJRqrpnC2U-I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qE_Q5C1mG2U5YLqN3uFDQ_PbQZ7KSvmmjVEj0L-UpUQ&oe=6A46763A"}, "display_name": "Dread Or Dead", "keywords": [], "long_description": "# Dread Or Dead\nCrawl, hide, survive.\n\n**Gameplay:**\n\nIn this game, you play as a **mole**. When the gameplay starts, you become either a **Survivor** or a **Monster**.\n\nAs a survivor, you mine ores around the map, form teams with people, watch out, and survive the Monster. \n\nAs the Monster, you should kill all the players on the map. The more you kill - the more you earn.\n{658816006676387}\n\nAt the start, you are given a **Pickaxe** to mine ores. **The more you mine - the more you get paid in Ores.** You can spend Ores on equipment or accessories in the **Shop** map.\n{1048219707336598}\n\nYou are able to use the **environment** around you to your advantage that include:\n- Minecarts\n- Elevators\n- Doors\n- Tunnels system\n{1868290333974615}", "short_description": "Crawl, hide, survive. Protect yourself using the equipment and mine to meet the quota and earn currency, and try to not get yourself killed by the monster player.\n\nThe game is still in development. Expect bugs. Nothing is final."}]}, "developer_name": "Multithread", "developer_privacy_policy_url": "https://www.dreadordeadvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Multithread", "support_website_url": null, "website_url": "https://www.dreadordeadvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "30488313374147609"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391814_2295684284122042_457080916856540173_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oyv7DuhtO0Q7kNvwEJ5PxP&_nc_oc=Ado1fV9DZ_lDaUfSO4RL73tOYU2z3uc5OX7aMqhX_dumjF6Dl3hX-0x25O59D2vJSx
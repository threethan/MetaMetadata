dr5FE-f3i8cMS6TyYwCSoX6qCOX2_pZe7Vsyxii_19rvyf_AsmbBmMvl8banvt5UIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOc7ZXrKyg4Ln5MzhBnOb5fiMOcXmJxZA6xsyyPwiFng&oe=6AC3CCF6"}, "display_name": "Tool Spin VR \u2013 Puzzle Park", "keywords": ["vrpuzzle", "physicspuzzle", "vrarcade", "casualvr", "skillpuzzle"], "long_description": "Step into a whole new dimension of puzzle gaming with this immersive VR experience designed for VR devices. This is not just another puzzle game\u2014it's a skill-based, physics-inspired challenge where precision, timing, and strategy matter.\n\n\ud83e\udde9 Unique Gameplay\n\nControl a rotating wrench with a simple tap mechanic. Snap from point to point, navigate complex paths, and overcome dynamic obstacles. Every level introduces new challenges that test your reflexes and planning.\n\n\ud83c\udfae 100+ Challenging Levels\n\nEnjoy a progressively difficult journey with over 100 handcrafted levels. Each stage is designed to keep you engaged, from relaxing puzzles to intense brain-teasing scenarios.\n\n\u26a1 Obstacles & Strategy\n\nAvoid traps, time your rotations perfectly, and find the smartest path to reach your destination. One wrong move can reset your progress\u2014precision is key.\n\n\ud83d\udcb0 Rewards & Progression\n\nEarn coins as you complete levels and improve your performance. Unlock new stages and advance through increasingly complex challenges.\n\n\ud83c\udfa2 Bonus VR Experience \u2013 Amusement Park Rides\n\nAs you progress, unlock exciting VR amusement park rides. Sit back, relax, and enjoy immersive experiences that reward your achievements in the game.\n\n\ud83d\udd76\ufe0f Built for VR\n\nDesigned specifically for VR, this game delivers smooth, immersive gameplay with intuitive controls and engaging environments.\n\n\ud83d\ude80 Key Features:\nUnlockable VR amusement park rides\nOne-tap intuitive controls\nLogical Power", "short_description": "Tap, rotate, and solve! Dive into a unique VR puzzle adventure with 100+ levels. Guide the wrench through tricky obstacles, snap to new paths, and reach the goal. Earn coins, unlock exciting challenges, and experience thrilling amusement park rides after progress. Easy to play, hard to master\u2014built for immersive VR gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://moxmindinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Moxmind Interactive", "support_website_url": null, "website_url": "https://moxmindinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25899262053076639"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1763498901300116"}]}, "baseline_offer": {"id": "1763498901300116"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777988280, "status": "PUBLISHED", "id": "1763498901300116"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27156544267348405", "version": "1.0.2"}, "id": "1415923696973004", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25899262016409976", "is_concept": fa
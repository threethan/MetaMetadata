": [{"file_name": "SS01.png", "id": "1567693620990357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619096_1567693624323690_7196159866883012797_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhnQ9QW5so0Q7kNvwGPWBJk&_nc_oc=Adol6fH-3U733mevmA2Dy21xyTc_fkRSwCqji0EzdEmJqNKhRboWjK4S_I5qXL0_-3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPER7ueUI24G4Hw_J58wjFbhEm38LNElYba2CLKapj4zg&oe=6AC3C07C"}, {"file_name": "SS03.png", "id": "909239318760620", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_909239322093953_7510955497980015188_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RI7vg_wpx28Q7kNvwH_tTqj&_nc_oc=AdrZIY6K3Qzf3_wQfi2OtM2JtWXWZRS_E9Bsmh7E2T58OH-0KzKnSiWmF30S5IrK4us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWGfRz1WPc2_2WP4BgC21oTm6rPHNbJojpHeXK4SWvoQ&oe=6AC3ADF7"}, {"file_name": "SS02.png", "id": "1226836355949658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619646_1226836359282991_7624309717803083113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skUe4ZaIEA0Q7kNvwEtVlKl&_nc_oc=AdpHgetPNuK-9rnQH0JCbs4IPCgOtvRxinFOVpKVLZ6wSnw--oy9H_GNQDtV_dF_Y9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPPVu7VG6rXtSoyNMNUuTyYUuKHwlW8e4XDmp_jUdlfw&oe=6AC3CE05"}, {"file_name": "SS05.png", "id": "1144949297750690", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620860_1144949301084023_6150203506823958235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6z7v7cSUAIQ7kNvwH5KZiJ&_nc_oc=Adp2S8_qX3KicTkwB5FtJy743Ohs4QFo6UDbT_IVszWGZDIArK6NBN9fDKnpMAFmoN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2HVEhdZ6s_EJE8g_FthmYG_oMIH7SfiC1zTr7h085ag&oe=6AC3ACAB"}, {"file_name": "SS04.png", "id": "1463805578555059", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595143057_1463805581888392_944017796047826585_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vS79mnTqDUQ7kNvwG2wNKW&_nc_oc=Adp0O6ET0RApB9Mb_QlKYNmvCE3AqfaxKxY3d-0YVnzwSDheqhMMsXHCtezct73xxUY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPmdG1wED3BRACMTc_E9ELw8B_3yvtpJ8H-SAynkeusQ&oe=6AC3CB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art.png", "id": "2213020519438190", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619485_2213020522771523_6531341889730383681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91EW_cC4HzUQ7kNvwGoG2Vp&_nc_oc=Adr5FE-f3i8cMS6TyYwCSoX6qCOX2_pZe7Vsyxii_19rvyf_AsmbBmMvl8banvt5UIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOc7ZXrKyg4Ln5MzhBnOb5fiMOcXmJxZA6xsyyPwiFng&oe=6AC3CCF6"}, "display_name": "Tool Spin VR \u2013 Puzzle Park", "keywords": ["vrpuzzle", "physicspuzzle", "vrarcade", "casualvr", "skillpuzzle"], "long_description": "Step into a whole new dimension of puzzle gaming with this immersive VR experience designed for VR devices. This is not just another puzzle game\u2014it's a skill-based, physics-inspired challenge where precision, timing, and strategy matter.\n\n\ud83e\udde9 Unique Gameplay\n\nControl a rotating wrench with a simple tap mechanic. Snap from point to point, navigate complex paths, and overcome dynamic obstacles. Every level introduces new challenges that test your reflexes and planning.\n\n\ud83c\udfae 100+ Challenging Levels\n\nEnjoy a progressively difficult journey with over 100 handcrafted levels. Each stage is designed to keep you engaged, from relaxing puzzles to intense brain-teasing scenarios.\n\n\u26a1 Obstacles & Strategy\n\nAvoid traps, time your rotations perfectly, and find the smartest path to reach your destination. One wrong move can reset your progress\u2014precision is key.\n\n\ud83d\udcb0 Rewards & Progression\n\nEarn coins as you complete levels and improve your performance. Unlock new stages and advance through increasingly complex challenges.\n\n\ud83c\udfa2 Bonus VR Experience \u2013 Amusement Park Rides\n\nAs you progress, unlock exciting VR amusement park rides. Sit back, relax, and enjoy immersive experiences that reward your achievements in the game.\n\n\ud83d\udd76\ufe0f Built for VR\n\nDesigned specifically for VR, this game delivers smooth, immersive gameplay with intuitive controls and engaging environments.\n\n\ud83d\ude80 Key Features:\nUnlockable VR amusement park rides\nOne-tap intuitive controls\nLogical Power", "short_description": "Tap, rotate, and solve! Dive into a unique VR puzzle adventure with 100+ levels. Guide the wrench through tricky obstacles, snap to new paths, and reach the goal. Earn coins, unlock exciting challenges, and experience thrilling amusement park rides after progress. Easy to play, hard to master\u2014built for immersive VR gameplay!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://moxmindinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Moxmind Interactive", "support_website_url": null, "website_url": "https://moxmindinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27209867225349442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827973_1670399190670491_8147643783362451686_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r
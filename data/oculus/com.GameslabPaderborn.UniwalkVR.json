": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1591865962369444_6878830130768816819_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsYQmHi-FZ4Q7kNvwEJFlRT&_nc_oc=AdrHm5e3byucwz_6JJ6gtpl5OEB86nufXA1arPTpNaRWTLU_IQ3K3QjGcMZyNR4z9aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAFlgGOipTlFDdhFRz1ADb7zgp1esIjY6e7gLxi2-IFA&oe=6AB51996"}, {"file_name": "Image Sequence_008_0000.png", "id": "1903683826972944", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1903683833639610_7565818529399980206_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-kDNj2Tmv4Q7kNvwFoM1N5&_nc_oc=AdrnBJamGNqst464D2SYoR_RnrimRjp1yZw1s4sr32tChaX1kh82ZClhTowBSpci01k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWRtgfx7dX4aSyNMHUzmWuyRbkgcK8tIkeLZvdvuTgdg&oe=6AB54BF0"}, {"file_name": "Image Sequence_009_0000.png", "id": "2299225153949436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_2299225157282769_3903733767519665525_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51O_Gqjs8VAQ7kNvwFxCEMK&_nc_oc=Adq3kckU427YjZHuH4hqnrH1tbvE-XmaCqVS3uMfh_ZP4jKAzaNaY-0xr12_BbwwbGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz5bMrOUDBdVuZ9LWxy_zcLFiNiCTR3a3mp9qtCGYAfw&oe=6AB529CC"}, {"file_name": "Image Sequence_010_0000.png", "id": "1532337558374390", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1532337561707723_3446761254678078487_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA0J4Ro2lbsQ7kNvwEb4J_u&_nc_oc=AdrBdZMcnKnDqTJ_IrAkCfHpqHPvMEF-kcE0ImlrVoKkoOajEBKroVT-bTEoUHH7GA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhmPXZXRnGncuJB0TdL87oxPde_DqhwWV4wwlMlZDVag&oe=6AB52E30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UniWalkVR", "keywords": [], "long_description": "UniWalkVR is a virtual reality application that recreates the university\u2019s main campus as a virtual tour. It is based on the original web-based application, UniWalk, developed by the university\u2019s GamesLab. The application enables prospective students and visitors to explore the campus virtually and gain an insight into what studying on campus might be like. This is particularly valuable for international applicants, as it offers a way to familiarise themselves with the university without the need for lengthy travel. The current version features detailed models of buildings A, B, C, D, E, AM, G, H, L, N, and O, as well as the foyer of the ME building and the GamesLab.", "short_description": "UniWalkVR is a virtual reality application that recreates the university\u2019s main campus as a virtual tour. The application allows prospective students and visitors to explore the campus virtually."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gameslab.uni-paderborn.de/anwendungen/uniwalkvr/uniwalkvr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Universit\u00e4t Paderborn", "support_website_url": null, "website_url": "https://gameslab.uni-paderborn.de/anwendungen/uniwalkvr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28951576011097850"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75361346_697321425882666_9162848725476834403_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=
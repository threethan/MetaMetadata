-1.oculuscdn.com/v/t64.5771-25/491823746_1915155272492157_4915383778857980791_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1-iqmGtol0Q7kNvwFWmAce&_nc_oc=AdoI3LofFCy_HTXZs9zAiLVLDPcKdivW1u2RaMOCAruk0mHN8zn4uhwXKQTmOThwum8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9UDMQnpNsguO1RHORXV3ZbsffHL0DWUj5lxrQlZ5aVg&oe=6AB52DB0"}, {"file_name": "Image Sequence_007_0000.png", "id": "1028404616674031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821704_1028404620007364_6244145881215875650_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ohrP-_ftmUQ7kNvwHzSiRE&_nc_oc=Ado_ybSqN69sZaf_69hHX2Kz24tZCdPHkwqTII3yu2rJegfZUo1oxiUrAtdy5JG9q3s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjLaBstSi1CFCd2s0K5W1PsF5KtgmnD9_D12ZbQ2AsPA&oe=6AB51A89"}, {"file_name": "Image Sequence_008_0000.png", "id": "1565225875100352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1565225878433685_7442666985559621692_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNIqH-IaHeoQ7kNvwGTs8Yu&_nc_oc=AdritZgq8F0h1ebxHm8CnB6h51g8-NYV77UNgskcilz71igDScD45RinJhcrzu8PpP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpydrOnSHDQmJM4PvIyx5ePKfOsH9CzJF7estxG6G-5g&oe=6AB525DE"}, {"file_name": "Image Sequence_009_0000.png", "id": "1090031770016717", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1090031773350050_5245956350922854750_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKSj9DntG1QQ7kNvwHbFCn2&_nc_oc=AdrhAcoa-eBLCFfYUSaTPp3wD9q_dp6hW7E_iUtFqNT_fwbntTIoVfbWBk7c2JGVoe0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2XK9twlBGlTe0oO6ZoX8tyiotB8cC7dpy-pEa9gvXaA&oe=6AB542BC"}, {"file_name": "Image Sequence_010_0000.png", "id": "1547255770193797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_1547255776860463_4438285009005718767_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHrYjnOfX1AQ7kNvwG5GWZ4&_nc_oc=AdqzsxA4LS0n974KxMcmaZWtpPYl1DOYGVk9RzIV7wNgVLqpM3nxRR22KpW-T-bnkks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInHsVmkwCug0Jw_O3GzFcPeV6mq2z-o3AooMgGHdjJ5Q&oe=6AB525F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UniWalkVR", "keywords": [], "long_description": "UniWalkVR ist eine Virtual-Reality-Anwendung, die den Hauptcampus der Universit\u00e4t als virtuellen Rundgang nachbildet. Sie basiert auf der urspr\u00fcnglichen webbasierten Anwendung \u201eUniWalk\u201c, die vom GamesLab der Universit\u00e4t entwickelt wurde.\nDie Anwendung erm\u00f6glicht Interessierten, den Campus virtuell zu erkunden und einen Eindruck davon zu erhalten, wie das Studium vor Ort aussehen k\u00f6nnte. Besonders f\u00fcr internationale Studieninteressierte bietet UniWalkVR eine M\u00f6glichkeit, die Universit\u00e4t kennenzulernen, ohne lange Anreisen unternehmen zu m\u00fcssen. In der aktuellen Version sind die Geb\u00e4ude A, B, C, D, E, AM, G, H, L, N, O sowie das Foyer des ME-Geb\u00e4udes und das GamesLab nachgebildet. ", "short_description": "UniWalkVR ist eine Virtual-Reality-Anwendung, die den Hauptcampus der Universit\u00e4t als virtuellen Rundgang nachbildet. \nDie Anwendung erm\u00f6glicht Interessierten, den Campus virtuell zu erkunden."}, {"images": {"nodes": [{"file_name": "quest-store-grafiken-uniwalkvr-coverart-portrait.png", "id": "2701265666701175", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974856_2701265670034508_7224653232320236755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hGlprjib94Q7kNvwFbjzCH&_nc_oc=Adr8hmR7QMTLD2--gXKjE92bbV2YM22ZJLy-LCYHLEpTuwHN9vH8xhP2GS5t1Jac7J0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAcM9o3MUrxowX4HdcyVdx5xc342WZlVPbOYtGrWtFSw&oe=6AB51B73"}, {"file_name": "quest-store-grafiken-uniwalkvr-pdp.png", "id": "859927219347056", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/427414909_859927
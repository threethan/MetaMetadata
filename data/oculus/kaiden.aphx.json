100829249979_4997509541501882458_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2b9cZsVwsAQ7kNvwFhzy_5&_nc_oc=AdqDZ8yvlC1wMPj1R3Z3oSyvRAWwuLYkzrVXH_KcNw0FC5FY_d8e4oGbEgQCAKLy6BE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1ZZUbXwgnHNjo1L94YhLY3wiJZR5SlLo4JJUHAYNVXw&oe=6AA95D7D"}, {"file_name": "screenshot.png", "id": "721715097224533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617749_721715100557866_4520149675212131589_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CZTtZoEBPUQ7kNvwFQr9O8&_nc_oc=Adq4EYdHNX5Yvar4Nm2vmmya6LCe0IMFItFTcq91FEj5xw5kQLNd3o2BfkP_nXWs9Qc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7JyWm2Was0V9-QAvFhiuj6wYp-ltoUwWw6ke2X_e0cA&oe=6AA9488C"}, {"file_name": "screenshot.png", "id": "608687785129434", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499313105_608687788462767_4570458534046865996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A01Rn6XvMLQQ7kNvwGLp8lH&_nc_oc=AdrRiIcs2E7BpxBVGD96PASUzZ_1HWJtIQEQuc2DDtGPEhVlP5jbBVXzZQrwVplnrE4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfiH4t4j3ejkjxxJBFc0kaJvD5f2kqsusdArL18cxmmg&oe=6AA9518F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AphX: Legacy", "keywords": ["chimp", "monke", "physics", "sandbox", "multiplayer"], "long_description": "# The world is your play-place.\n\nInspired by Chemp Physics by XORWIRE Games, and Bonelab by Stress Level Zero, Aphx is a physics based gorilla-tag style movement game which you can build stuff, or just mess around. \n\nMULTIPLAYER!\nWe have added multiplayer so now you dont have to mess around alone, you can mess around with friends! You can join a specific room code, or join a public server and mess with **up to 20 people!**\n\nThank you XORWIRE Games for making this possible.", "short_description": "Note: This is AphX LEGACY. A new store page will be used for the remaking coming soon. \n\n\u2014\u2014\u2014\u2014\u2014\n\nInspired by Chemp Physics by XORWIRE Games, and Bonelab by Stress Level Zero, Aphx is a physics based gorilla-tag style movement game which you can build stuff, or just mess around."}]}, "developer_name": "SKID Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1yCUMmFDeKtASXafBuxh33yFA2D_A26X20jKFXq8zPuo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SKID Studios", "support_website_url": null, "website_url": "https://skid-studios.web.app/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25985392474469008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824594_1229212618454771_5659198296342605542_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUOAU2unQwEQ7kNvwFDvYa5&_nc_oc=Adpu0qAA_5FeDPgrtX95GrEUlg-KpqB0tiJdF9gBvCFy6ViWBHpNE_sARIUB1LcpCik&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxIB4yhoZ2-C4xyWwdB5MNAG3ikq30xvtZwhl7lbkjNw&oe=6AA94060"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AphX: Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051
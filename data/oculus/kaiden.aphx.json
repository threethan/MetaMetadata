100829249979_4997509541501882458_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzhH631Tbt8Q7kNvwEPlbLs&_nc_oc=Ado1hVH62yHcjy10UEK6sGlcUYPYwejEnnJ6yu6hek5F-fqzsVQ7PfJViJV0AN8UiIw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76PK_7rxEs1hjvarS-KrNQ-EU2r-7qzZLMEydqd38tyw&oe=6A11C0FD"}, {"file_name": "screenshot.png", "id": "721715097224533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617749_721715100557866_4520149675212131589_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yvTCtzGMD4Q7kNvwHeGzXH&_nc_oc=AdqpNt-pb7J-Ymkh0nZwc9zZLNvYybyxpS4dy2eFsMUeVnMzDgzARUkdN23sbdk2UMU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IQdRuLR91lBP6rijdZ-KoBdFN7iVqorKLAlGOVXnP-w&oe=6A11AC0C"}, {"file_name": "screenshot.png", "id": "608687785129434", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499313105_608687788462767_4570458534046865996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceY5FfcPjNIQ7kNvwGEXde4&_nc_oc=AdoiPtqVXThhXAOd-tKEg02ox3zMtmR2FeddAbcMo2f2V-bxL4WHOL54DR6R2aFQ2YY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PrrWryekOfjJ-qzzJMi5SDUNJzhuKkjEqgA2uSJ8ugg&oe=6A11B50F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AphX: Legacy", "keywords": ["chimp", "monke", "physics", "sandbox", "multiplayer"], "long_description": "# The world is your play-place.\n\nInspired by Chemp Physics by XORWIRE Games, and Bonelab by Stress Level Zero, Aphx is a physics based gorilla-tag style movement game which you can build stuff, or just mess around. \n\nMULTIPLAYER!\nWe have added multiplayer so now you dont have to mess around alone, you can mess around with friends! You can join a specific room code, or join a public server and mess with **up to 20 people!**\n\nThank you XORWIRE Games for making this possible.", "short_description": "Note: This is AphX LEGACY. A new store page will be used for the remaking coming soon. \n\n\u2014\u2014\u2014\u2014\u2014\n\nInspired by Chemp Physics by XORWIRE Games, and Bonelab by Stress Level Zero, Aphx is a physics based gorilla-tag style movement game which you can build stuff, or just mess around."}]}, "developer_name": "SKID Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1yCUMmFDeKtASXafBuxh33yFA2D_A26X20jKFXq8zPuo/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SKID Studios", "support_website_url": null, "website_url": "https://skid-studios.web.app/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25985392474469008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824594_1229212618454771_5659198296342605542_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFNphGSseg0Q7kNvwHLvSdr&_nc_oc=AdqS_UJIeYg6MmSOb9HP7aZ06OV-lTVlrydt1BwVzLga7s6QmbRlO1Fna6w62KoNRgw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UqL-KcdWa2xJ00d4_Ygoilae8QpFMvo0FZhLBDhpnEA&oe=6A11A3E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AphX: Legacy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051
yGSREwojOYAvmQSn1Q0Yd9BR_VmbNzdQATl3WHkA&oe=6A8C31B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBD9gYo4WisQ7kNvwGn_D_g&_nc_oc=Adq7o_kW7XUZbBSm3RcDfhYdKHWMcKW_BiDCpeoirRiP8Odm1I0c9pHohpLaUbh2K2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5kaqnfExDgVE5UNU5XNAKrRJUw2JIdAe15rJ7C3C13Q&oe=6A8C1130"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nop-UZ7DyGYQ7kNvwGvrvVC&_nc_oc=AdrGxLx3oZJ2YeyMeys14QaaOffZst4r1Hlyc5A_yPgDfmXUiofQX_tsEhIyxiaZrnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHawD-jt08CeI827L6skZgJiYu_qo-X1X8mP1-8XnTJgw&oe=6A8C27DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JSOU2S1LskQ7kNvwEKQhZu&_nc_oc=AdoH6oxtgOHW6qZdNAmbu5yo527ASh3OA5dvvPOBt01HRylaMdF1fqJ3vAOQfO-2Fyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6NR2oSf81MMWx3QdLUxejI9Xfz5kiiIsGyzabal15lA&oe=6A8C4177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydAiEjmVvUoQ7kNvwHUnjnK&_nc_oc=AdrcIi5jjGZ7QjZ5agZtiZD7EDClykaLntoW3Hu4ew5VIv6TCSKq1ZJqNpUCeTl7e8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFce3ZNjMl-FEGuhvCb3trwQV9qAZuFgO_Xl0CQok0pqQ&oe=6A8C1CBB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBwhqxVMJi8Q7kNvwHvZ7P_&_nc_oc=Adoj3aI1deFknWORDQZrirqn_q19uWHh301qREnnyLdQCr3HFEISN383Wd-DfcNtRuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwHYarjmLe1gvsNWP3ZKruL7KJjAdvFKu4Fx17JcX8Qg&oe=6A8C3933"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgL6dpqsFdIQ7kNvwFEWJci&_nc_oc=AdnO0MPr3Qe6WH9zD9XFc1orjSx9kKH0Po1wiPvFH15Zgxi0YtXRMiKyQqBmu-074Xk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_NbJdXsC_XdcDNYcQCnFrL0jwnp4xhH8azdBEvTlCYw&oe=69AAD8F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sISOZ2tcMfQQ7kNvwE3n2Zj&_nc_oc=AdlCXQoLmk6N36p4Vb84Mqk6gU3UVZdzHRWEaL8H-PSIJQpZwclgozL_BxGwi6VO3yk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZIS-67Swj4ZxGeqxzS7xosD7obaZTE8NMxtWLFvyJCw&oe=69AAB75E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mMkKcvGwacQ7kNvwF0k_UT&_nc_oc=Admom6v0C3jfkQR9HibIO1YcI1_qwBDcsNrPLoZ4bdYNMiBHUGh9cVO0bD-w52lo_GM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpMMmGuRmA2ptxMQP9rvF_prjhpkMwo5RKb7KVGVqi0A&oe=69AAD0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZidUPzUX0IQ7kNvwFABosF&_nc_oc=Adnxb9_ExYyD3fhRUNt_Gy3GKVxq7MFoDjlPMugFjJ8F0f0nmIiKRorh3n1DfPmDNsM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyqK25c-lJ1-fv6nHOo03x-rp-1tx5A23iMdpveMQigA&oe=69AAE47B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDfcdy_-0cQ7kNvwH2ZMMO&_nc_oc=Adn0R8gvXAwYm4fv-gTNwcFjcKiQeEvPGMtf4Fy7zKQrgJHd7YoZFeZqvFS-SdIO6c4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfywBsKEKGCVwS1Zy9W8Vb8Ei6ZRofRRLHic3m5P7y6XTg&oe=69AAC8B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIcToyPZhzYQ7kNvw
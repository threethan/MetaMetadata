3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTI8OC-Fnch-SydPrP_p8r4x79eMsiPI6fTRqkM7c6zg&oe=6999B570"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7AogGJRjJoQ7kNvwEo79QL&_nc_oc=Adlkj4QUZWH6g3nmNOI7KPgXfekZObHdCUBj3N6RkqGh-yNdBgx3QKumoNJNDZRWXxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5RIlHN7ig_jUC3vHDe3gaaTiUCylO0BUbIcwwFaDEjw&oe=699993DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18kJfa54_14Q7kNvwHqQcTT&_nc_oc=AdkZViD7mseiKq9z_ZakaFUqo9Cdsgt1ZZYsw08nc0z5PSR07qke6Yr1hrFOzI44--8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsXvYxMZ0S3yHu3gWo8KF6O-NV0OQdMsXLgQ7YS6Aor7Q&oe=6999AD77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfQ1CNO_OsQ7kNvwFxWWKr&_nc_oc=Adn11CTGnkD-Pt6F_A-a1beMnqJ-EEKU9ZllAsZyRUScndDWfkKtWb2yfXRrZAxAgPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3Xbv8GQLz8UZkdVq4NTBVjfVk5iqIxeSfh0Hpm3hQmQ&oe=6999C0FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ8TcAjhyNYQ7kNvwGMxGSE&_nc_oc=AdnrdKZKXoUv0lg_gP4j1O8tmwRB516Y9IdCHwTQXQoMID6DHuwx72hCfu9Vtdx6-5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsDmSsBqZuXmi4-pINft_IWOFAY9WDlWC0PXmPZ-DVvTg&oe=6999A533"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq-D9BBVnIMQ7kNvwHLe7Do&_nc_oc=AdkdwsNN_LAWyDxpUcsOseiHpd_Fc-glVkTIsa532lKvYG6Yall0YC18rXlrJ_Y2bOc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMxCK-zZFcfEpWedhmghAPeVNtrQVbB5bvyMwV3l3ZLw&oe=6999ADB3"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
BUcA_WQ-VamEvrmFjGlcJk70gzxSVHQ7eohRR-Dw&oe=6AA03074"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQYL2JaWDCcQ7kNvwExZ4u1&_nc_oc=AdrXq_9rD4sMXv_qx6_8xHiYEAR6v167gHw1O2xavju1XYXQWxF6RP-0DyDZX-A76Zc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaOaMkZ8CsSRqEbtOBt8Igm1Vur1o-xONmMRhzyHt11Q&oe=6AA00FF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jki29twZ-8EQ7kNvwHGE8tC&_nc_oc=AdqJwQ3fE9TpkulbKvNkXl8wRevrIa76Nk3e_WNAh4V205x_m_1XPbTAQupYehsuDj8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlt4Pb4UMp9UwiTocJX2uXzmusxQZV6iF5Zh3onkMyyQ&oe=6AA0269E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2QVWtf7omYQ7kNvwFAXR7s&_nc_oc=Adrvy-TCvWhvFZnoUgcMLa7-ZFtx1-Z_LfgkOo71now4Mc8LdboUPofN-HvSKPhefo4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYmuCFkeLyIEOH57SDxX1bxdj6hMKqpXGV51LYcZ3EXg&oe=6AA007F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jJQaqjX1DcQ7kNvwG2jGKZ&_nc_oc=AdpNIBJSgnRYiOaWaXG4zxQYuuuwKo1f1GtZkc52nTeXLxWATxg0sZObb4aj_QrRiSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoTTvvK0blMAcyRYVRKzlLMJqR3I2aftCrW48F1yek2Q&oe=6AA01B7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjoCfMKjL98Q7kNvwHioUPl&_nc_oc=AdpGvabjycOrbZ9CRQw_u3z6Ixpw9c-_1XXybMgRKrMfuvHdzQ-CxXQwjP7J6KRn-eU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnHGetiI2CwSTqqN5IY3hSxlaHu0gJYVZzdsBQeJLVuA&oe=6A9FFFB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
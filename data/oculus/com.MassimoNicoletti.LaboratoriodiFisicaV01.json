9MgKZI9ffBvNT0ZuGqfOfj4xPkHAMnTPeiH4Wrdw&oe=6A2594F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHdZwL2CC5AQ7kNvwEE5DRR&_nc_oc=AdoocM5sQs3mxMqvUBVHqNXOoacTw7ifDAL0m8WE5L2qnCXqGVA0AEheANM6GcU5Xj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZQjs101SERcjPLPb07Od1NvxZbkFJ71r03qyI_w4iwQ&oe=6A257470"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qM25XN0tbO8Q7kNvwHmyDdP&_nc_oc=AdqODUpWVjvj-uMCA7TiXyKKRdXjYW74t4BA0kza0b7WrjORYoBD4xB6ghjv2pT_IE4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PvYp46XyPoPBaK5hcng82fUnpH3SkZ1fzY1J9VO6g6g&oe=6A258B1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG6I00b5MEkQ7kNvwGOZ_-o&_nc_oc=AdrSnqGe70gBpdd4GDsmOVW4UnadjRUMMd7Sj6HKyahXixsXFWiK-PoLH_vmjpwlwjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-7SHqIfN5ERniv-eU0uIH7rLp1bk-oK_mcrkxnzVZqQ&oe=6A25A4B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7IHs-RnEfsQ7kNvwF5q5p1&_nc_oc=AdoGkQlRFhZ8fur9-CFgTZcmo9BUrlpk4pH06SsYKsgkxG1JHfowXAUwn-ddP4BmOXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HGA_hphHAoi4mUANcgA8z8ct9RdXr-nHfZnTts2bvhA&oe=6A257FFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lxbqtb0tJvoQ7kNvwHPztLH&_nc_oc=AdpFRxq8Z9BPObFulA_DVMsfNIOrlqNXj_LTI72f2Q4fXsg7gYc0KKmnrniqEbJEME8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dB07QSOWlBk9BG3AEJYg2gIlhrHg4ziIdP0g9wpshKQ&oe=6A259C73"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
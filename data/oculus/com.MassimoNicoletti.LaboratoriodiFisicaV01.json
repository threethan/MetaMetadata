_sid=6e7a0a&_nc_ohc=rs3n4IBSIZkQ7kNvwHNL9uL&_nc_oc=Adq5TESkxhW4OSJtC8GFZAxC6qtLaov3evsjMVUTMeexbg_pXnLuQgXhMWLB1q2tH24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnV7JvCcL8kAODzbo3sNEzAD3de3tZc4s_kag9gfLgtw&oe=6AFDD3DF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7YV-x98EP4Q7kNvwE193Hf&_nc_oc=AdrR67seXGD91oaJE7krmLpuYiBy1FiVo1SLPDpM6sCpVCb2_HFJdYq5TPAZgN8ZsEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuMsdW799VzQG0FEc_iJc0kCD-hugu-kdiIUsec_VAVA&oe=6AFDB5D4"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6IWmpYFdr0Q7kNvwFS2FPz&_nc_oc=Adry9VN9tpbhke1mWluXj5VCtYjt8gDJWmqh1SjvKeBcPHi7ltylrujGfIPZ1fIsJPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFFg6XmdVGZSzn4QFwBspPcddBqAih88_UwNKzB2Dnyg&oe=6AFDC785"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEW44DsA7LcQ7kNvwHkgFsC&_nc_oc=AdpSqdFX6mBkcVokrE0q-45X1jdRwB7yATqg3CBqfwngrX7u9x8CHZ6PU8eqPTSduDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuA0Lx4rXFOE7H0qOtQmcZVmTleLY0sI-sbEr9NT_x8Q&oe=6AFDB5CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8hnjYj6AdYIQ7kNvwGOEM_S&_nc_oc=Ado7xaz0YAw5TLUnTFY5OCJzWhdqbzMA_2huuUrB-n11XOQliiWVln-yVWMa4xpwY7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqmikUj-G3rcbZg37S3wa02FkeDxghbGgIZ81ygBzgIw&oe=6AFDC98E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
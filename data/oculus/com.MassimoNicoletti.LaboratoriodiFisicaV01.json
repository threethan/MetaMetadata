hwGb1tHpFVDA7buRjgvRMxo391Q7XpZfSt5aHSKQ&oe=6A0DA1B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5p-clSLmpQQ7kNvwHsKETE&_nc_oc=Ado3awCHvf65grszweTknudIUGNExZMcF7LzQYnaIyxnhYzw-UREYXPuw_x3Eich21A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a4JB0pl_CwK5-r04SMP95NkHzg0KEutFAk1kGJrYBZg&oe=6A0DB970"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngfNJVLeW8QQ7kNvwFSGlbe&_nc_oc=AdpcNB_svW8svA7sRF1JhaASW6EgSy-PbP_HUtNoreMDdNnwLHF3DusocSP8D0fQqfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XtBG42XEE2PgduEooStg-b5-X9PPlKPeJY8zeV_GhCQ&oe=6A0DD01E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0uIm7v3DgUQ7kNvwEPo44G&_nc_oc=AdrKfYpL-FWjJgRSVfa0XDNVbLsCMrwnFRJ6I2D_3vHwNDgf4YHndSgPGTpXF5qtFUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ao9Mhd9z5pA7bEGx2uej26jCE9oKWK_CKC6mbeM2QXA&oe=6A0DB177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZewyWWZcvjMQ7kNvwEZrhu6&_nc_oc=Adr0Me4q_CaourfN08xOC9SRWdMc_P_9jTYvqiW--VRkt0NRc8JbjVJ2tL_UztUcLnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IPUknC_pzNFgKIKHR2Gsq8onjzBiL11WbV9Xt5eJw-g&oe=6A0DC4FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R0M9TXL3kQQ7kNvwGJjgGm&_nc_oc=Adp1p0kFw0cDz0wGUDsEpDWbYJCDW1_5r_5AZp-vf9tPkyKFRkx3X2TTis4f0_3xx24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L_fFaoqEFoydwCmvBz-lbcE8YHpheptIYobzBN7hmLQ&oe=6A0DA933"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
content-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipWSHVhwJmgQ7kNvwGf2nK2&_nc_oc=AdqtaBf8ABbEq_2_71eNvwtRdyosUoAaNNYTLSUNrLNP0abyJt1V11Y56omm8Mqr6U4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qBqaSMNTRhWGDuH6-Z9C96qRTQvotpK614JCiEM050Q&oe=69DF94F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2T3nEOTZJIQ7kNvwH7LvFr&_nc_oc=AdqloLsfrHnSFFl4qJPiAB012kngOigTWw9f1lRnxXQZyZpXir7Qeypf3FpkTC2E0TE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m7wO01AkFvwbqa5fzt9CEG0bBJA7G6O6jSAIbx81cFA&oe=69DF735E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09r9sh_0AgQ7kNvwGLM5EG&_nc_oc=AdqTacUMqhZfx2w7M96Q3Pz_oZpblCgF3dRt7p6_-j2TxkNEsTPxfOZzQkYhYAt-fSo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vcbtc9Z2TMbRBRPR4L1pEi_mhT9NcR6dUGCMqltFo1A&oe=69DF8CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crQmTc-6xGgQ7kNvwHUXbP0&_nc_oc=Adr1svc8M6hY-ztqsjwPbsp1OuwEKHhvoeJj2BpjaruQzygO3VIwq21ufO9gsWaJjeA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XCtj5oVdcr8lmwnLYo5zZAij1Gqm_iOOoQECPnP2nPw&oe=69DFA07B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q90TenMl6goQ7kNvwF2EbNC&_nc_oc=AdoyiKcazXcO_jXcXlL7aVnuTT-qiST_qpR4HkyhzslZ8EbJr03PGYh3jDLGHzciyJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pyDHHigboduxzKlEqbjWGu88BLVOVL9sIE8cImvu9cw&oe=69DF84B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
pcnZib31kuDIuu9gcRHLlrVFVVqrFqXQHZCofH2A&oe=6AF5E1F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z7cyA8ExLcQ7kNvwFFSjkY&_nc_oc=AdqgkmEXEzHU-nysWwMTyMXdRGEmnEDpT9SvkbqbRuJTSKzRxFKUZcbvgw6tndJXqQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSJoByWCmfw5rJRBIbleBFC9MRpwP1q2Lm_F0XZ4ClNA&oe=6AF5C170"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbkHdcdRcIwQ7kNvwGiN4ls&_nc_oc=Ado-V5y8FiQ8o1Rlfs4spt2nLjgw7ugKo14Pn70Z13UGlgr2AEABeVTbu6beEJLVymA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP1LGoad8Xo_2Remok5FRsdEzBOEvMeSvZG4LPY7sHaw&oe=6AF5D81E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35jNsZGT12AQ7kNvwHJd_3P&_nc_oc=Adpt7O2HXMon7SuD0srmgq9FacjeXfdttYYRPNXwfyJPUqzYY35Y875eHvGI314Ok48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT62_5_JEwlu8aHMqHQjK_3FxTTZA-u00KhjJZKZmRPOg&oe=6AF5F1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdsajD4KD6EQ7kNvwHs3DaQ&_nc_oc=Adp_9FHrZRLZ7QkfkWY1H5SBGmiScYgxcPApq1w1mPSFgjeoPM9c1tRlIzss4MsFFug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_rljedOX-11vaupyqToDBhNvNTQmd8Lw7wbrAPn0bpw&oe=6AF5CCFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLZnV63YxvMQ7kNvwHkSd_A&_nc_oc=Adp0jwD8s0FgsNFYKJHmDbF1PbjHiYWg8q4PchUotgHdJU3cYWpmr1N-RDO80WLdO6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY7CwAq2kavEQtniJYM_Mr5TQbo81tyFuwSye4eRc3jg&oe=6AF5E973"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
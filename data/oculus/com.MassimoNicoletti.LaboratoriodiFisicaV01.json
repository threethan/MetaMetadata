ntent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEh_-ChSRFMs1HKl_E5hMKlAd4sGbKTq45QWbJmQatig&oe=6A92B414"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyHPfesm3fUQ7kNvwG23KFd&_nc_oc=AdpEF8hch1Gw3InZHOH_X0rsikiWj14rN22FMZ8ex8erIRRpMgEAn4BJzutB2RdCXes&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmD_8t8VFBqIP0I5ISuJDWUYtvCV26RwQIuJoQnu7ZGw&oe=6A92C5C5"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtMmCNa9-p0Q7kNvwFPwLAU&_nc_oc=AdoZVt2vt13Wg3mNXcwSblXG4Mk-4O3NqasrSXQGR_sJDWCV2lXX-UAxwggPDs6WrG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnVm9wNFNJHl624yVhuP6wKV50w8MHBTrBiwPufaFogA&oe=6A92B40B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4K2scb3H7xsQ7kNvwGZIYGz&_nc_oc=AdrE3J4getoAGIl7zi8pqOSAZbH-q_FGNSceTgz3QlVFH72WyVg3dx8tChj130JJpnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZULgsug4LUguF20Cy4shFGdUw6ot_hHD8I4jRHYUlCA&oe=6A92C7CE"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7014635251891409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v
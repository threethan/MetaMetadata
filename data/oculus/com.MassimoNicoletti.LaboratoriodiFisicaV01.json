content-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBrJrQiy1rIQ7kNvwHAMQdN&_nc_oc=AdqoUDVOzTYrfHHT1_l_yR22Lai8fam3IK7Egh8eo_eO25g-7byCz-XOBGMAHi7lsUY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pP7FORrKcwh68S6g75--Cov5aTv9dEpBVeCANzytC-A&oe=69EE1570"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZbqA1xNb1oQ7kNvwHg0lgw&_nc_oc=Adru85m8NBKAXMJWEQURDxmaxrM1rAyIShBVyvvKxUAoJa8iD_2RiTQGQcgw43ocnIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sFynGfM_pYaWL2g5FClKhEY_1rOYZP31HdwRI7p9iEg&oe=69EDF3DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhwsXk3xZycQ7kNvwF3RVDZ&_nc_oc=AdqfBTu0v1YCBDRTm85mZ2ewky04BeuWy0zehvhmUWNwvqtHK8tO5stLW0-8r9MdRMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QluYgxYx-AiWRclJefToXoOArJz4A9B3l5ZUOTlkn6g&oe=69EE0D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXo_VFTsoVUQ7kNvwGfb-nL&_nc_oc=AdqvsdP5Nm2iGjVOqdwwP5fwReswUqYIjKzicDncX_P8_wPkAM36RH5JCV5-ax6g_mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RaXOrOr7Qtp9MS5R9LgJWDl4ZdcRSZhAda0F_tk4sXw&oe=69EE20FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLIWwytcp4UQ7kNvwGK3JZQ&_nc_oc=AdrcC3yWYPqQ9uYwyejgGDDDjd1uvprSK2bpJdWGAuCbiR1SlUcIvImpHGgDAS-ZB6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30v-R2WGZorj8xJA4tatXS1MiW3v3aiUdSme-4TROqKw&oe=69EE0533"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
oPZUEcIA5kB3Vt7AczGJNIxJJbRcsMmMMb4_DDQg&oe=6AA149B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQYL2JaWDCcQ7kNvwGeh8rX&_nc_oc=Ado1EMcve4xkgXxo-EIcFh7weQX1fIt8Rs6vrsudAwzUzy9ggcCyB9xfOau31f2WN9Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIeQUwrFEx4BA-IuDIqhERvA9ywfSwW8f2UDjmiQfedg&oe=6AA16170"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jki29twZ-8EQ7kNvwGCpPBr&_nc_oc=Adr9HJ0NzSIlIiaugC9nAJW1b56oTkB3XQkZ-bat8h73QKCxZWYTAlzbDvDxQ37E4QA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnJ6xleEgsSwQt3BfvauRhdrrsnEsSbXTUoR8tYR4yTQ&oe=6AA1781E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNeer9X8_ZYQ7kNvwFcqKLI&_nc_oc=AdpO7Nfx8TtP-O6bIjSpdvOIcqOAFwS7KWDeV0M5ht3rsg4QJ5TalsFvrcGusIJv1xg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeLhWR_B6o831k6-TFoanTL4Hy_ulcmSc-p6CtPJmfig&oe=6AA15977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adAdxTZiX4EQ7kNvwFfHl4m&_nc_oc=AdpvSF0bl4OKGug5QcBuLQrjlPe-UOBcF6abkdWz2CgWsMM1RA6cHfGcO8klbD7bang&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4AOGHBsnkezBrr0Z_M4YroH5s4TgBQBZda0FISSoA0A&oe=6AA16CFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjoCfMKjL98Q7kNvwHbzMfZ&_nc_oc=AdrUjcapZKYeUnj_7spUHuGtGJliT7fPbaJtpW2w_8pNhFjhdFObNyIkJMczhUpbsr4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkK_zTCZHkt_ugXUATvxxauhX9y2ovZ98N_cOVEf2AIw&oe=6AA15133"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
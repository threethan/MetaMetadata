yxC01Z9AnJw5G9W3YJY5G5sVio1pMC2G4ongFxqw&oe=6A09AD34"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff7KoY7SLXIQ7kNvwF4jYy0&_nc_oc=AdrH8nOPxG8R316BtJdhu9ZBKBanrlaGpHxSj9nnPC0egvzbxu5UxEFRRdyiFWiGx40&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qp5SDTidrIHAk11hAh466Sbrpif-HsBCho6GLJRT-FQ&oe=6A09C4F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAzw7dACzgkQ7kNvwGhoFxT&_nc_oc=Adr56aCevrsrOuOL5vyaGYm9KudGl3vBmIneNmb_AgT1D4J-aHdf0rjmIOaBU8k150g&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AEuRecSI5BfBjheE0H3IJ9e_LPCUPuASJ14kOJQb7fg&oe=6A09DB9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ST49bRMpYoQ7kNvwEikvIF&_nc_oc=AdpvdMe12QXwRhcBMw4hhZKgn2hK8aMcu6b5Ot-bsbCWnMUfyf7Yx1OoSbG3lkTNxx8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pWebVVoi_rEaQ_y3qBTj80fY0W4R68FZkahRh9DIu3A&oe=6A09BCF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOFIrBKrZcsQ7kNvwFdLV7Q&_nc_oc=Adr1ZIUVm3cCl4oblY3gLk2aUsHvJZg93rFcO7ckNV53Bkh53rpQT3XXgvO37vAr8Yw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YvlWNyIsJkm46Q9gI5zbxaEicoMFaGujZ46YH8oNAdw&oe=6A09D07B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXE9KPGvrFUQ7kNvwF3eSX-&_nc_oc=Adq8VvSF3DTlF8BTMl05xjAgJ4DEd6eRYzNZJJi5dPmhTyayQi4fkZ5mLKQ9ZSjd_sI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a57sfnOLh6QXJw6FRJvou7bZhoX53evs8QyHcpZTJgQ&oe=6A09B4B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
8TbI6AoJGe2IjNri_Lh_RFFgEap8cKnNoGuOwvKg&oe=6A9998F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH-JteWi4esQ7kNvwH4xPE_&_nc_oc=AdrF7l6xkaO7eB518elZYI9Hqb4Rj1K-30zyDzYbIBav0BhSQzndFWNy6VQnEO5o0Bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITaTWEtzt8B28pMfLurn6fjTtB3cSOnsMU08kJja2aEg&oe=6A997870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcrj13xXOrQQ7kNvwF7Blvn&_nc_oc=AdoPgb7XuTGeEBOWPswwzi4ewMwxstS_EUiPdE5jhszCF-XxndzA94X2uu9OIEz6kYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsiEAMiK3FI0xFb9oytR0TwAn0vNn5R6gA6YtL-tkERQ&oe=6A998F1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t2K7SnGZnoQ7kNvwEF6J4S&_nc_oc=Ado7MZ9yaXYR9jnTNb7FfEpkQPZW16iiQ1E0avJIg45WqgH91gVZkgzZUMkoaL6wFpY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKttiK-vYAor0Wx3DVCtkQOi0PPJrgRAqMpwHF0DuOUGw&oe=6A997077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egxcbCFb0rMQ7kNvwHDgp3i&_nc_oc=AdocdOgO3vuJa2-sdgP7xLSaVBEQM880F5M8Y9QOEkEoJpYpyT_eaXEuj-iN-85CTn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh9zuCg5CHCbnojrlAsGLd0FXFyOFT7NVVMg-slDR45g&oe=6A9983FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EL44_2rxdQQ7kNvwFyWZlm&_nc_oc=AdrO6gZj1ogyeujakpXCLwRRZ83wt_-khUQLgaGSt3PjhoJ5eW-TatkmhOq3UWNvlis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN7NNUIluZUhbs1PU8bRq8CrV_ZmaMMtgHTrukQliLSQ&oe=6A99A073"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
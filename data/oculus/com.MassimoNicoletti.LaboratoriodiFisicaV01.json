tD_y_oVSa-nLKHgztjYqJ5e4qwGvesrUSPxh_iEg&oe=6A4F8CB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3U14KeMOmoQ7kNvwGvpmYs&_nc_oc=Ado8nGYkfmJUcL1yy25MS95eS0mH3qiRxrfQMxCVAzpOhyZslVtrWEJu1ayxKwT4Hng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB68G4kcme7-EqYNCls7vUGZtL2YvCTN0DKKk7MPG6fmQ&oe=6A4FA470"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aznMWYLGqsgQ7kNvwFhHOqd&_nc_oc=Adr9X3qaCX6si1NgJVFrXeYakHfcctr2tZjO5sZVC4u2wzhOgs8UuqNPJhjz0KPl4ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCz7HgDUeGuYCwPVFBD_bpvypnuD1N357P4OZqowEjx9Q&oe=6A4FBB1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0sepsPF63sQ7kNvwH5GFBb&_nc_oc=AdqiAGwCu71ROG9074r0c-ZJxS7GUOfVzNR2huIaRADAY81XWJSpjFJ9WDFTO8qG7rM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA79WGx-lTLMkz0ND23tjwgDquKVSR0eiMn_TEbTliafw&oe=6A4F9C77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3eEghe5tAgQ7kNvwEttt-2&_nc_oc=AdrzvExl_P3Sq9QCmmgHPZX2oPj6h6vQGC7d3IJkI8g2j1i617Z2lGcor_gO3aDeMRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuZYHkvj2aQ03oU7tpr7_Y6P8x6vO35RBV245flu2SzA&oe=6A4FAFFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YScRL_IiQYwQ7kNvwEJl9Xq&_nc_oc=Adr-rW7UAtYf6ORUxUDAZ4bSfBV5dC70e1vxfhvG3el2RZ-i1KJmiTN8PpBRQ0_7Vrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-oE14u0-iRDABLptsfU2AX8X9_zU8J4sOlBEjLvtDmA&oe=6A4F9433"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
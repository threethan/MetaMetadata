gNlJItczfQidzsb2XXKmyLEJRFiTdECXLHMdPYyw&oe=6ACFA674"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXdny54HRgIQ7kNvwFiTt6T&_nc_oc=AdraPFxJhEMM274e99WHyz-62Yu5tLNV_d85TxEVYQeSPU8ot3szTajUZXq2HUSC_HM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0fFsnKxhvEokB0LgxehoOh5Fvn6UPgple28tNNp4STA&oe=6ACF85F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4EAI3ijKaAQ7kNvwFXY8Vt&_nc_oc=AdqLQPpEWbd-VyatZf8koWWwHbYdlcTuNJTBYgMPcwncmgDsPc8OLoMUr_x3NUzYTZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvm120Il0l0R8QDkg6OYGJU_6AzRhETMgHlU4Lv3ZnKw&oe=6ACF9C9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOS8j89rx2MQ7kNvwGjHIoD&_nc_oc=AdrqUyuwfxaC-EJUBJ5Y2e70FmyOuvkxaVTna4GatsYCkCix3gb1L5QiRegWdY8f9kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAmTGwKN15w5T7qmG9SyKk-fiQEn-QcstdH_pC7B1Zlw&oe=6ACFB637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3uNA4WUGp0Q7kNvwHzSlsA&_nc_oc=AdpkFZr9o2e4bB4RPMm_1sSsngIAoY59_Kp33JEUAKJ4s8h-6VTyPVLF3NMulCB2iYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7Ts8tkWraMY4yr2f5s-ROeWPu-wOaXwaTMe90kBoSBw&oe=6ACF917B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWX91bP92ZIQ7kNvwF8Q5Nc&_nc_oc=Adq_5wLfT81nFWcSQdwZ_qUBu3JwWXVpT9UAR5vEe-zKCPQ3Pqr6klkfLTDRBCFITUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXGpokoZLzhRzEfdvmPHs6dcKCVNGoeS4nUAvRSeeFlQ&oe=6ACFADF3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
NMhMBijkA_TiRofNzpU-M1ZDXUYAq_xEyx-9Ry_g&oe=6AAD5F74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcVQXVZvEVEQ7kNvwGwGkf0&_nc_oc=Adojm-w5Wh-Iezt0DaLYLHC25dzUOUyOHeMINA1PfqtK9NUbJN1FH_0YiRJPYFE4W_w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMRdtKTca8LNoSfsBP5go4j68FInRt7KSNS-WE5t7RyQ&oe=6AAD3EF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w61SMNs5lZQQ7kNvwGwrXQm&_nc_oc=AdpOW-6g9rZSku2ZCIdR-4USIPfwDxpUuIH-NeXWs-X1vuHAJsNUjSJ67-EsTU3AMAg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYF3QkW8DT2QDh_QotcmRLJIvYd_RLJGHgefnK3GHdoQ&oe=6AAD559E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIPyv2GomSIQ7kNvwGRDT55&_nc_oc=AdqwETHXryN-uXEYivHSYEXW3tcwTpfTEdqsXUzM_09NbLKgYZ4gbhtFrkaQM4Llf9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOq2pXXKksy2Y11P75Fb3akwtC1WTYAdizeEU5mtP0FA&oe=6AAD36F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yixc0Y-RQWEQ7kNvwFY59bp&_nc_oc=Adpp4g1rrhdARCDxrQB-b3gZRm71--Zb0JHkmY5wqq-8h9EaipDxa19DskFAImfcQR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX0uw46juABHRyhX-L-tWcd3s0Wficmgbx20I5RBuR5g&oe=6AAD4A7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJXSNM6f8E4Q7kNvwE0SKb9&_nc_oc=Adr5bDqPEm1Gun7qulCJzgzsuTcOIu_6g8D8VHMKNRxwfJqi4O85szSu0q0EaGYX29w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqq8cjyLfbpx40vc-gphk3Ej8XkB-jjHCt1oPgT-lpFQ&oe=6AAD2EB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
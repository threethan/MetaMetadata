ohedodXjcs0iR-9-zy8lsT3h1bsPaAIVMhhbYlzg&oe=6A6747B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq3LRoDeLAMQ7kNvwHk1NAw&_nc_oc=Adre4QLZOGeQsf5LerZfxqGJCROSMyAOCefFG3PkGU_M4Gv9cTMy5bGIeyHJuSe1Usg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB43PCgYyEVDyp4MwndAwp__TF96fZbK0puuS-_vq71Dw&oe=6A675F70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enb4-mWioXQQ7kNvwEvDDmK&_nc_oc=AdozzcNc_Zbt-GvVt1yx-vrKNOejqlCFb8-U-Ic18xggOQqu-pW9SEGJ4AkPuWT4CsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfTz2vCxzXr_cf2kFDHDT4juDGp0E8M6Bx6P2ZOGvHxg&oe=6A67761E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1s6-k2fnU8Q7kNvwG_-z6G&_nc_oc=AdqSoqSBvLGzfcIcsWyqrl8yS2Oj8N36VpoKagAFdLVmbUz8PxJt40AZSkwJ0VxfhkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY_KnURx2K1-1oUGyV_RVsxi-qW4ZKu8iY5lXQKIMWIw&oe=6A675777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwwpws7bP4EQ7kNvwGPgLTu&_nc_oc=AdoxaJrOe3YaWNqqFZX_3Zsj8XlTqPvuP_TMLSjRT9k0IOHLt13I7TzJuOeyk-peNaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVtJ6zJKsbBqtSRzCO9O6taJwSHogzuh9OkR_qlqdQag&oe=6A676AFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQZt-66C1xkQ7kNvwFPE0ub&_nc_oc=AdqdKAQUDvZ2qH3KN7R_dQh8epDtQgzjbsqoaqd1BGAh2-3IEZyAGtDVT4q9435KCQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt-0W_O1x2G1JGoUgotPQcXqQmw_RdtpWBGGSPlmHKlg&oe=6A674F33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
DR4i3wc2GL-_9JtaOWnpOSYeJFR4iAjlUqD9iVKA&oe=6A414474"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfogJicHapsQ7kNvwFLaJXP&_nc_oc=AdqUCWcuqmBD67xj9MZj-VlI0qCfK7Y7kgWkmV4wzp327upy72aIZ6gjExDMijiX1pE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cGQ1rVSntxVQ9Ua_26ye8T9RDOh62yKJmacXgPjDyQA&oe=6A4123F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrWbYhykeuIQ7kNvwGolssF&_nc_oc=AdrDs4NLm-ZHFGUZwITfTc8WZL57HBFBlUTOWQcsN8N7zsDQhu8i-FtjIbzTMx6Tcrw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87MyKt8dbl8Lazy9BfPRr77TEtmR5pGTztcReD3lv_sg&oe=6A413A9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8B20KdvZBYQ7kNvwHgCJnY&_nc_oc=Adp9GlUd_idEhUeXpe9krdi2eKRovqMiH7hxe6adzALrA3EGlypJwO6QQYAi7FaOkwE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rj5pawTcDE3hr5HCG0UYgoTgHC2Ayufdpagl2fk2qHA&oe=6A411BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnM4uRIJfCcQ7kNvwFxBWEu&_nc_oc=AdpfAGMz80DHPHAoFdkpA1eSQdATQJx7FUpwgl0Y2lPJ-cxmPwZZEss_jmFAo1vl4yk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MLxE1J7ojQ5MGFdEUFYYpx5MoDVaBvj6U0N61kXCSAg&oe=6A412F7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frvXeqErjCYQ7kNvwHOuCvv&_nc_oc=AdpxdOdF6TwBNaTcQ_2u-bjc3Nyejo32vlmA4kS8XiI5X8OyCSRQ-2zFhmJAmcTH7Mw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__21PNIyciM3RQbTzYmRkqi2e7utU6AO-nUhpRtu0SoQ&oe=6A4113B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
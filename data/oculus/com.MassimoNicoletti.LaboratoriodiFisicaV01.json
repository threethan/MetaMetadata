_sid=6e7a0a&_nc_ohc=sFbKL9THDO0Q7kNvwE6KJkf&_nc_oc=AdpaCCHLyaifQYBpRlQYwQayCGiZ4pdcy-6womm1jk3BLIMQ6nMDtgZMBR1D54rnQUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1A5fmJ5AtxZ5NawK5ry_MT_F6k-uQku8aGQGsOmTWU0Q&oe=69F0B870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZbqA1xNb1oQ7kNvwHAhUPe&_nc_oc=AdoNVcYHFIP1Fhoz4tT50BmHHZeaUIj2AOHWCK8NbHA1jsy_lIvffLX1zzo8SHFUlD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0lrLMI5n8aVJHxiplKNMPqkWgBZHBTZR7KiinLf8ex_w&oe=69F0CF1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E2zo-ZFHOUQ7kNvwExs01l&_nc_oc=AdpVcI58DFFZYMEBbLpXyHh20WjQIcKH5Y73a2Uctjy6XqxEz566hIBQx4AkQe9MTUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1RZwJNPVc3FfsoV-Vjtg3-1YS52kCI2rZX0OiGGj5ksw&oe=69F0B077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0dU7IYYFAAQ7kNvwF0TUvI&_nc_oc=AdomK91yB1IR-nmmI1j1lnC67SFLQGfOMJMj7qGgZ9IspX9qnUNR7jQAzVc_xUdWqEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1kZa33MfY7hlWHUKq36UPJ_zXnp8lNpjLr_Nh0gQUDxQ&oe=69F0C3FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLIWwytcp4UQ7kNvwGgotUD&_nc_oc=AdpMd6j6FJ2Diz2AKQVSAUFPRcIBZblumEX-XoZRHSjKxeAWOKK2rEhzA8m2J-xShkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2GbYHY_PCiqF0JekWso39cKSLuPlusdTO7A6fnRLgmyA&oe=69F0A833"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa-9W0oZ3XsQ7kNvwE-7isT&_nc_oc=AdrOe1kRHitPBSVc4hlzPIInLRYS-Io7csLAqbY2RqSjKncaWR2zvL39fkBJuedUKV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2H9pgW
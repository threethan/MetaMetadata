biZ3UPbe3xz8OOuwlDW3G8nMEoEdDmXC5Y0a6xyg&oe=6A5CBBB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbJsM1Lm5DMQ7kNvwGkwI6y&_nc_oc=AdolBFSFdDXwdZURLAUgG7UznujVZEZ7hav0dnaccENK82d64U_3C1F8wtUAn5L1QhM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWKznSEw3i4fl6gpChXHtzPpknPxgUtq5WVh77_8azVw&oe=6A5CD370"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln9GB8kvPbsQ7kNvwEFWA0X&_nc_oc=AdpMozgSlxnANEZz2-2hXMff1LVh9z4W6brmRPyLyFezZlFUxYjVMksdLTPdTVeRQIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB82j-BEi7OQ4Icebjm-FCX3ueofWZ6pNvkWvVV-UB0Tw&oe=6A5CB1DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2GOvo63LBEQ7kNvwHqRNo2&_nc_oc=Adru7si9_YHgWJggXmVG4PzZIMkw8GtmTaVyaIp6eui44baZBeaKMZ2TkBt--Xhz9cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS1VRQ0JF5IQhUzvlNwrfuRKsWN9XDYEWrG1v0s-R8zQ&oe=6A5CCB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtQn4tCKQOoQ7kNvwG-Zwaf&_nc_oc=AdpI0d8zu-_TDtA_64QyVczubj7NTjihnSnQjc1CFS6_asQRT_Tb2xjnZxwjIyVbH4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDU5h2DfE4VB_AJmc-VylCELQqNTlvYHD4MW_Py9XesA&oe=6A5CDEFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpsLAkJpbQ0Q7kNvwHi_1iU&_nc_oc=AdpzKJwDDQvhtMuYCYOMEOn6rIeXjDm0eM-JEEcU8l2qAyhP5LKQY1Nqbed8zpZWdrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXaGKYsS_Rf_MpKJRHqh466DV6e0CF9PoZVLReRi6aaw&oe=6A5CC333"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
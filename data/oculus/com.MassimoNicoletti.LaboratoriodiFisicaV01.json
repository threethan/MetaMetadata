771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KdpvtXdHfkQ7kNvwEFqKVO&_nc_oc=Admgh52w6bMf4RIVXvYyn8dp-JjCpglSkCvOBVvqF4hkWPrUDRhi97-BVj7vUAXnviI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6riOnYDBk7-l_0kgJtzhai-L0dr-usLkjVHW7BMmoYA&oe=69AD7BF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sISOZ2tcMfQQ7kNvwHaSv9_&_nc_oc=Adld5Na1YiZlbPKHbmJIZTCXqjdYXT8KeBUqL82OBnm7cKCxw0Uh0DHI7ujO4YBLD7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNuKlvR76IQZQSX-fvHhu0VmRZdNkKCN0X4FOVYLapig&oe=69AD5A5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJcxhXB4o4kQ7kNvwExLxK6&_nc_oc=AdnyEPGFTXxG_6-tDZbk9dh6qFIC_sN-F9Sb7X4FLLttE8zzN4_0wasDsFAxlOfKsto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgEiHtF5SoUkB30LvCiojQan8h3RmSB_4-62sbB1o5gA&oe=69AD73F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhVYGmpl7kYQ7kNvwHgvEWS&_nc_oc=AdnE1Oy0_t95KF9K6YnfLlCGOyY3A_iIV-ClMB_o7Bwuhlv8g8CSuzEzt3PJM4IUojQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWV_DW7Hc7OykVyp7QaWoi1HMRL4CJ328_XutT8NHEkg&oe=69AD877B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDfcdy_-0cQ7kNvwF3nn16&_nc_oc=AdmtbJBsMYJ2vCmR2jg-1ZZ6RnvmkqUrIL79u9_j9gFevhPVINB-4oSqVm3F06tVL2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVIUJ2qzyrVp9V1tg_kp3ClHDGqFKn2-SH3G6fOkgSDg&oe=69AD6BB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D30PfP9cloUQ7kNvwHwku-Z&_nc_oc=Ad
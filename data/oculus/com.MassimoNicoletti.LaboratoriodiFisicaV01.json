Ql3WxxnH42y_YOqaWIlHrNFBr8KhZxImZwFkNEpQ&oe=6AC7BD74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELqgzARWqUQ7kNvwEV9g5E&_nc_oc=Adpd_Jm5or-YlvWJizwgxmglMt5b_fQyGOjxlnT2l2gg8ybgyEHSt5GWYlMf3lYWKJA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiTrJpvwByqrfPdv-dMsp7fA_NYpxWYw2AXeKPgBiILA&oe=6AC79CF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpFRkfsJXAsQ7kNvwF_9oLA&_nc_oc=AdqKy2YoZBFvIR5BMGHKuB9xdeQtw9z7K6RERSHfAlXgmB5sxaN_8aWmONDqI5eOHV0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM8gySvVJ8LNRwtwJfXllqmVH-951wVRxNSvR9tQc_-Q&oe=6AC7B39E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN7FfyQpHX4Q7kNvwG1jHg9&_nc_oc=AdqxNZx26JN6BTzvTLepFBD1Lw7b75yFAjSwFAFBeXn80g_Kc4kK_7oNBeOWy2gCeDg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtRIHoSeGIC1Tz9JW6rKSLY26k7Y9bbEBWy9EAlVFF8Q&oe=6AC7CD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdCfYwMxftgQ7kNvwGVTGn-&_nc_oc=AdokAUfj478QPPuwPNvTM3euZmaZXnnc8yPLKF-Rql7zARbZ4CwKO-pavH4iHtIE13c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoNqgj6cbP0dbv-ur8GaclTa_PJWsWQvmvhQuTPUR0Ig&oe=6AC7A87B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M576eegnBs4Q7kNvwForJzO&_nc_oc=AdrfmBHQ-O6MzROOprOLYzmDs3k9dJZWoz5W6_Bw-0F2yfNiGjS1-1qW1lBnzzHfB94&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg30O6DBdwjuuyq-OS-DbP8L71Hl_VKnTEDpyutK7dfA&oe=6AC7C4F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
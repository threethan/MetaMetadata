4-NzpA1yfowG8t1AOXeRYWwlPU9R0v4JD0LWl88g&oe=6AD0F7F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXdny54HRgIQ7kNvwFL52VU&_nc_oc=AdoF4rk4HX52V_KmdrdCqakNRaFxU4Tk18g8_42DQC2ca_HTGzoa3Yjxruabz_Izt9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVvvlssIr5UdM_FBW0GDLmOKgVPruNtG95qkMLSQ23YA&oe=6AD0D770"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4EAI3ijKaAQ7kNvwG4aoq9&_nc_oc=AdqQQp0uS5x83-QOA-gxA2ETlDaSnhGoh1W-QfKs6TTBQQ5xI5c4hxOnFxvaVTQZEzM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF94Si7WefPZdaAr2uRRoDtbKZx5o9EgCLAfuW2AH0mQ&oe=6AD0EE1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SllK9kNSOnIQ7kNvwGNhKB_&_nc_oc=AdpI2aBFKIy_vXzi-LY1tghDgse3Tmn6WAHILBXuVENAfjR2vJHnUREk7mqPv710aLo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtY3ROSS-hg-AJE5BBQnH92fITbfdzq6k3_A5mUdoxKg&oe=6AD107B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxRu3hJBXXQQ7kNvwFvyj5C&_nc_oc=AdpQs151Tqg351COMM-ArSwxo6hn96iIyLKd_Lw18kGV8ZTzIq6g7gkHI-rQ-rZVGvw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBUEMo4f5ioQH-0gPtQIYI4GmfTH8ELV-RggwrvTEbeQ&oe=6AD0E2FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWX91bP92ZIQ7kNvwFkmV0p&_nc_oc=AdqmCcEHwTNI2aKimfldnCzGvRjdcLV2nWze_omvY7S4HSAMNNswbuPOAh8CuwwsveA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwjQoNt5DWjBPZjhiTAz5mEBS38mXIxTqNNR9rQIh7eQ&oe=6AD0FF73"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
AL7n9ZtIwvq7zTczky5S_txUwgtLhQxvBoOoB3Tw&oe=6ADF7874"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP3o2aB8fWcQ7kNvwEoOqoH&_nc_oc=AdrurZ5t1btnyYAh9mknQeDfqohuIhRgNme1s0eQA4UbZ9x52Rj_oc2jZiitAQ3CW-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoUsz1BsmKe8fY9AogKYtyI-OMmec3z-7FYG8Fr5JlrQ&oe=6ADF57F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JIqprrKQlUQ7kNvwFKpuTt&_nc_oc=Adq1vvH2N-mmdK6ub0v6WgWLRwUxUfrx7OyWbWPgF2NIKC7RL3tIePCBtNF2hTVosMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcbhc35_5sRAcPA6xV5PsJDw3ia6adFwwNcM16jNuZpA&oe=6ADF6E9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmXCBu7zyJUQ7kNvwE2XKug&_nc_oc=Adr9rXzVY0SOxKJysY3PZw4jrjDXZy06AvWdEZ2VXwCrc4BJJiDrTZnQzo0EEUQ7gfI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtwNVenmKC-xauclCBv8Xms8JUJPMPr0jUcxkuFMdLzQ&oe=6ADF4FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtDG7UGVN4EQ7kNvwEk0a8W&_nc_oc=AdpLcLbCCVYm8_gVa-DSqJV-6iYrlSmWXiX49GjGmwCqAgh0Ky2SxHTSz08ttsH_Gz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnpge0u8hsmzsLhw4x60jsVA1V1ERfNGtMYLyAl_9Q7w&oe=6ADF637B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFY5Tnn-ooQQ7kNvwGvDPzu&_nc_oc=AdpHaMHH5wyrjSuQE99NAtNJLoVVg3KtD5dHYx8iBqi6Fcsev7fXqn2_ZVae2W7ftdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJKLNK0EIGPXcRmo_9Gne0-G9v1td0JkVi_99F3mGWEA&oe=6ADF47B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
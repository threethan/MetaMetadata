Y00TGcWDZ8sGzuxbMw3u6tBYSMiXnjFriuUlWNfg&oe=6A15C2F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvH376AsTVAQ7kNvwGExYRg&_nc_oc=Ado_JmDT1P-7INv7HZB6JHrg3GjXf4nXoDsHTPrXP063JnO4DEpBSiDU2O40QdzpbXo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QzvZ1oOHWpuZ8oLpiPRbjzdImTwkBEmHNQa4gy8Yixw&oe=6A15A270"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCE5pUb3pHMQ7kNvwHlPY5X&_nc_oc=AdoGegzJLsONvcm6F3cBmx5Pgjocx_tdt5mF-42SlNk4UaRnktyIoEUiGjruy1Go8qw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t4u8a1T27dxLXbYvs5OIrG0ZhQ7EDy89oDZDYw_xi6Q&oe=6A15B91E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCOm3IqsBvcQ7kNvwHmiUkL&_nc_oc=AdoPGYxMFRveujmlGQFe_f0J7a-g94ocnksMh0Bo-MY_IRRroy_akqQO1IdDF_ahbaM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QRcazPBForGlT19G9ic8_v4V3xlMO4bbzH_FaFjps6Q&oe=6A159A77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQoDLK9hlBMQ7kNvwEBO94R&_nc_oc=Ado5QHqGGzR04ponNiukBiQnBVMfoDZ-lpJcx_b8tt2TBCgMbwOg1zaFPTg5eb7aBRA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kL-LtC0x7vpAS23lECjXCPJWOPLa9WOB3WhmkogslzQ&oe=6A15ADFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOLndE4GQtMQ7kNvwFpfXvm&_nc_oc=Adrmz6ZFXBsG_pdN50u9_iTHQWtQmUmqiWJXUu4tgKjaDG35BhiclSyIJzn7b3Pz-8A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BJkb5PFUGCq1aOsMC-Qc38kqX--Hq__hvRjT0TMQREw&oe=6A159233"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
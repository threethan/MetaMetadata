=00_AQIsPBxaTq-di3Z2OcltUBzOkV1Hvn3IBXLAQHf833w-2Q&oe=6AA3ECB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li3SLHUDp9IQ7kNvwFJqXj8&_nc_oc=AdruddTC3y-lDI6OPV-64MdC993ASohL0B46NqJWbW3KOPCqPhZaw_3FU9myBRAEk-k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyh3WR0MqcL8OxsFeN4GfQi6T2mocGdxCINuVxDlfT3w&oe=6AA40470"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g52W14EYuwQ7kNvwFfKbPz&_nc_oc=Adrz5XxOzsNfLkcPykS8wxnHeqJ_jXwnaZC6hWIcb0MTQWPFmGenXQzQPiZCXzD8fu4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpcvXnfKa9m71csw2riAeoU5349N9SLUZfE5b8-p0p3g&oe=6AA41B1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNeer9X8_ZYQ7kNvwFymCLI&_nc_oc=AdpoVXbK5y7OrgWckmFk5Afa0zIEPF5_-xevOahlU8yhhrAqqxeHUABM9ua90nR9sFw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLItez-AUHmGMAtqDVi0W3KsVOuk5BASmiJI7641wOjyg&oe=6AA3FC77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adAdxTZiX4EQ7kNvwGh1M1G&_nc_oc=Adptp_R26PCiMi101iHiYtdFe2jWeITMbXaDENUNvMKHKcHvOmNMqydBW680X6eFbnY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQwuFGOi3UZOJ5uJE60SHDaBxvPWmAmzki6E7pYOi-4A&oe=6AA40FFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMBJBpdpTIsQ7kNvwFZpqRg&_nc_oc=Adp7FTGif2j8FmZ4-G4AIbE1c_aub8wx0xpjQ7invy8NkseKoIYqqHObVg4QdVctGGM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvNuSGZUUll90GMGyx7ryyJul_zHmmmBgaLV60I0CE0A&oe=6AA3F433"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_L
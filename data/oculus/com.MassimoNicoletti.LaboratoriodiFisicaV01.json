NEL0RkTjelTiqrSe3Ph7o_bBFzgEhaoniSdrbUPQ&oe=6A5A18B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbpy9nbjoPYQ7kNvwGNq8RT&_nc_oc=AdriMBkt-BZPR088PibQCAlyupCliQCjVzG4kXtnfRRdXlJenuYgt-9yyKwvHEsRP0Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDdtAIbM265I6bKaFaxjkma9Aj5og3Cpo-byzAfmavaw&oe=6A5A3070"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGJBH647eb8Q7kNvwGbr51C&_nc_oc=AdoAafWtA1ph9LSTd_37l-XplhUT0bwWfoH1du7xt2L9_5h7KjZ7lccVMNz36EmPUdQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3rCtb5kneVRhS8Z1TzHqRzzYyn3lZseAL7mMwDDzwbQ&oe=6A5A471E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2GOvo63LBEQ7kNvwFOS5_5&_nc_oc=AdrmUNODIX1X9N7EhIhSnKnvBgI4Be7zI_pMLMwARngK74G9KUv-zC6Da-ZuJMSiqgY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ0kOIPXCZgbvF2Hh5t0Grcf3cbRIlxDlun2J0PzURVQ&oe=6A5A2877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtQn4tCKQOoQ7kNvwHoL8Kw&_nc_oc=AdpoNK-GN_18a833RUR6RNtWu5PRUwYZ6kds2sWxbCyk7H8YXgnrIxORyk4snU4D61U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ8hrdxnhUhsoXWttXP43gPfLMIs6L1egiqBWt1S8Tjw&oe=6A5A3BFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-VIIknHL1gQ7kNvwEWBz0X&_nc_oc=AdoJ42XdzgBsFCjVZfXELJfn9V_m-Af0TjoKK6wIP5Ch8OaFaWL_ZtxTVrcSiRWYVW8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPvagaLQNay3ZksCWNEiIB7Z83wkx37E-qLzA_8susQw&oe=6A5A2033"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
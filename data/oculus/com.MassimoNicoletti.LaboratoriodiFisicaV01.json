_5qpYzAxd1NogRhDzwv_7pCYi4m2Rp8y7L-Haplw&oe=6A16DC34"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvH376AsTVAQ7kNvwGESq6c&_nc_oc=AdrN_kM4rBONcBDuZCuLR9xhN-oLV9cMJLQJSsCzlKjHDqq9D7GZE6UmycoCrd3LXNc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ZIbpwcyxDEPQFGJjiZw1x4csVeInxmKonB9IMxgTYw&oe=6A16F3F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCE5pUb3pHMQ7kNvwGBKkhy&_nc_oc=AdoHyZDWwpv0eo1qIZ6aDy8oO9JzjbFn1rX9SYFSxrI93wX-ib9kAP2biltkbxw_soY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4leNh9hAnfFm9i2jJEDAGYu00SrOODw_x13hn1297_1w&oe=6A170A9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNr1KLoZIWsQ7kNvwFMF5pN&_nc_oc=AdrPxmk60w0adKxykJtVgThTO9T5QluqK7qX7DBa4MoOg3gRfoljidAHbdgbID7iMCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67bcsFvE1hALz7P7hfmK9B7t_GMcjLaVC9cZt7-bmURw&oe=6A16EBF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJqaEN4Kjv4Q7kNvwFJKtUh&_nc_oc=AdpxrXuUw3H4WaQr4j9zBpPHfshHZuKG9iJ-5dAWutdQ9iDjRwKvmVUSnihghJxtr3o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wXq8tussgXLIOEHJSUAHEX8nEvn_NiTlVnbp-DaezQA&oe=6A16FF7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOLndE4GQtMQ7kNvwEf1-zV&_nc_oc=AdrDezx7FW9tW5LEsy8E4tnRm6NG_wQ5KkdYyVIPfJB6buEXauR9ZjWO9q__6Exz4rw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68sOtc_aqyFYF9yqLWG-v2P1yMAQUofcTCqJ1alzbgVg&oe=6A16E3B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
content-atl3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9dbzhtQg1kQ7kNvwFQIRMg&_nc_oc=Adpcam-EA5x1_66bVusVYmFEup_Hgu5tWOeQzbZaAMO2VWg5HoSeyLQEYYBli8DK35Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYfQJS7aHgFRmntYBdrQgM1PpuDN3F8hOlkhMQk4VrEw&oe=69CBCE70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYPzGbsY-VYQ7kNvwHzTWLN&_nc_oc=AdqOPCXR4XH4Ly96m7IKFWk62Vw4rXfpqKfcR_akmk39cy8h4OeZEys7HdoYvk7pSpI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPewhEpMow_HN889L8kV-ZWcjzPvhTg9Mz4N4NqfoiLA&oe=69CBACDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUidUwzSt6gQ7kNvwGJgc-2&_nc_oc=AdqCzyJsn9nQ2zre_6ySvJJVnp-HQIpguF2IGZFQ22dUK0BiVxSKuTfhrKWQwN9MVmg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwrw0BJQMJEopYIvnCd7lS4EHIyEecwruS_yZT0s6Gz6Q&oe=69CBC677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLnj5EoQp2wQ7kNvwH1cIjq&_nc_oc=AdqByVefmD2RNVaqMaJxOAcQ1kRZiIw2qVJAXOeiQZsnvEq-PQbfTtTDkbM6sGaWpOY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwphN2XXR2V-0-lPVb1NB2QkFJ6fs1a5ErIbychRLvWg&oe=69CBD9FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJAiOzuGVi0Q7kNvwHnWr_S&_nc_oc=AdrKX2u6BPoeIeP4gKHrcftS2wOaaYEqsk1TnRawdxZZB_0LHO-9B5KbfrL9gKrL7gs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ8zwDJ_jaeTzaOyqfmonuE33gsILCFM4mzMXRRCW-rQ&oe=69CBBE33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
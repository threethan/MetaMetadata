771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KdpvtXdHfkQ7kNvwFXQasb&_nc_oc=AdloWVHVfWAzEq2Th4NFCHraat6dsrfFx6b_L_Z92o9kaJfC1njG5kSj_xyYV-UuOoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqtoudaWVkmWu00mQCGpHqOeCOGvGmRTfFOOZPdBg-mg&oe=69B01EF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-_TH4hOdaYQ7kNvwFUA6PV&_nc_oc=AdlJ_mNc8xtzloNrkhvzyL-yz-jsoPFtm6LIQOrRdbcaIOwOQAP7hqla8uf-xcQ0U34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkAB2YpCNi3_6VliCxOJLXXxUsJerSSKedUffxdUSESQ&oe=69AFFD5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rarX6KhaxcQ7kNvwE4JZdS&_nc_oc=Adnlo-_s_KSoX3EcxvYlQhR7y7FEmxkpYULAx6L7A3qX98bCX2Md8fRMAz6nZW6azOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqnZ3C0P_HMUHDcaJ_lKgqlAWvfog9FaeYFEP__cv8dQ&oe=69B016F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDYwl0S8E_cQ7kNvwGRzUKQ&_nc_oc=Adn2HzfFmhXCoLfw_foO-u3W7AFZUsMnpj6vCeOEd-O2EUTBext1wpVsoMc188FA2rU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqL9_GIJ8F94RDCM9wGX6cW6V7hZsDxQATspIFYGhJLA&oe=69B02A7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlN-8iVTlI4Q7kNvwGoI9lD&_nc_oc=Adk8NU4TwfWdNZtKjADxAv58V3gYVQYWMGCF1XQbzCLLzA_UIPNswBAce9WbJMjpVGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzhv0fmlcIgFnlJXnqOgUh2EUZTX1p1ZfAfseHuLGg9BQ&oe=69B00EB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-QdZLOJFIAQ7kNvwHGRD56&_nc_oc=Ad
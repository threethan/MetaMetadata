U_lN7IGuTFymBkMkjatSdvD8zMNtoDYUaXzbiIww&oe=6AE60FF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgP54sFtdNsQ7kNvwHbWXhJ&_nc_oc=AdqAbfCTnrw9nFSIkQkhBVnuv-2Es1F2_VMNiLfi8kBLzbPhXIkzJOJISLr7ej14VfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGfF_yHaHqdVewnDOH3iNWUIWA06c-xQWE5a_rOt8BcQ&oe=6AE5EF70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThcxSPFMbeEQ7kNvwG0cg9p&_nc_oc=AdqlUhh41Z7FZwzakXd-hx7QjwM8fR7VXJijW1fT58JUY6lmTpSdmqowf4qTVSTprJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOKp5TfG45_v_6p-cw2RCXScGaHkqTBlaoIbR4A_pHyg&oe=6AE6061E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wzlg4lOHvwQ7kNvwGrIwW0&_nc_oc=AdofRAe-lvCDp2AIJ349CqaLD4V8-rsCDOgp6qZgPv0ArgYcg4m4-sG-N2LmQ9a3A7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlfFeHVeYaNwNdAptiih64tOJcb4HcZO5hd2_2_p-2hQ&oe=6AE5E777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuNW9-RwA5IQ7kNvwEdvGmz&_nc_oc=Adrafy5983PdR1cAcDsCP4bWBQFXPsZI7L0Dqw9P8e48IvcF9raU3Hcn-8NdKR4iBdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmN-_UPzwMTH-j_ufH4Aw1vlHedXhV-ItNddA-Njhb6A&oe=6AE5FAFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79m96iQqyCAQ7kNvwEqzvvA&_nc_oc=AdpNSp6OcQcyMzk_udjDAKscwI64aZ3jXl8k8mUp7v5f6_oXSy8JvnXzB6cZBAK_J1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT9YCeQidAn5t_gc-XFldwtAqyk0foAaZKAjlziZj8WQ&oe=6AE61773"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
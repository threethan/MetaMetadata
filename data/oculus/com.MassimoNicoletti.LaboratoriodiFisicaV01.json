3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6UQ6tJ2jjyOZe0lHbzIDGpY1ywyTByi1HqLVgEAI8cA&oe=699C5870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEEGIfy63AAQ7kNvwFKquCs&_nc_oc=AdmaghT7WY6f3hrm0iEzn4_YDkz9NV8D3hvK-qLONXr4EmLC0vhfulH1Z9NjELsoTv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvbiRGS4_D73VOu-_DdSv_2cHshXxRJtpWCTIBFhzV-Dg&oe=699C36DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb9bSXwDG80Q7kNvwGFZU13&_nc_oc=AdluW7e86G-diJQbYnvJDN1FAMBDmEbOxS8Q3O0RJi8iK8cvimWDQZ5DdZlIdAU-NaQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu8d9BniApjoTjstTry_EgF9TsJayCjH2IJoNA88v1ozQ&oe=699C5077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huAcjqlpMUsQ7kNvwFOJIsD&_nc_oc=AdkNewykzBH1qNmTHUt11M9VnTPoloKr7gwhiSoa5zLBU8LXPJmBcW14tNljo58IefI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuK1PDi3-sOS9-wpF8QGtXofZZnDhTrMgmPkwF6uCanWw&oe=699C63FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qWD5r6DVp4Q7kNvwHFrv1x&_nc_oc=Adni2rizowsinO8tVL7zZu5X5zv9vJAxUOVtsLXqUpZd7NE059UxhylKw44AlXY-FF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftKL9TN4_aoZfMJ9nUu20YTk0LrQBjPIhXImdnWmHXF2A&oe=699C4833"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DV8e7Fa_jEQ7kNvwFX8_IH&_nc_oc=AdlVzMe9OIBNibXcRWJi5Xvvkpo2jQNxMocoV62l337HQWQ4pvpp-UZdKZ_zyQn7O3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afup5Heexe1rLHbtew4H1Sk78A8CAOm40VxNG4xBXkeQ3w&oe=699C50B3"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
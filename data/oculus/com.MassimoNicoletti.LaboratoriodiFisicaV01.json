c_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvFkUCDEMQ13AXY6-ADRtsUXBGOAnulNMgAAAZs_ag3BA&oe=69A42645"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2NKdXHmGgMQ7kNvwF51AJt&_nc_oc=Adme_KGO6oOsiHn7EbeU1rdQkQF_lwSQevIHycfPm0-gBOWnrnaF3pGDneRm5Wvdsi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftMuGjG1D-DRyhT5qvUqDd36ULqRLV_JVZoDKQq_QQpCQ&oe=69A44CCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaKHNNfoRbAQ7kNvwHHIId-&_nc_oc=AdkltfeFH1yicWsjN7MxouWRSf3MLeK6mAnkj2wyeCB8hl8ARmDg8mEZm7-O9_SLVaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft8uvb6YIwT2Pk8I9czvedlQc-j1SV3CHmIJIKAWK8yhg&oe=69A4284E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7014635251891409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75326678_684847243460423_1231468598944244579_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcQutZ-af8MQ7kNvwGJQD6f&_nc_oc=Admq47Srd4d2we5HUgoqRVXK0uF9MZbefEx7nXi62ZnxTaQvCMRc9r7_sE6RZwjXIFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsFfxG6n1zltpgRDDiPDDkpyo5Y5AbGcvlFshDzgH-MmA&oe=69A41BC7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Physics Laboratory ", "platform": "AN
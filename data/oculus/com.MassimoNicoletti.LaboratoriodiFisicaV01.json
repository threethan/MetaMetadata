_sid=6e7a0a&_nc_ohc=O_ahpj2qta4Q7kNvwE4nqGd&_nc_oc=AdrriZ8wGhxKKJI6QfULpOgE7tF2D7so4Dybgd_j73q_H7ekThJgG7m759Yffifw3L4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQez3oLptJjsrpyNOX3aB7nNiteoLRw9dxS470vBcsShQ&oe=6B09B15F"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkAMiJSiiU4Q7kNvwG-qLDp&_nc_oc=Adp2smhwq4aZjpVMH5X4lv3yUaTIkqEv5Ha9zX0_SOhoMZAZCtXSiXpe9mO9bb59__o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhA82sH64A4aD8FoBbNlAsM8dU0dcQgb1wk9qnMhwpzA&oe=6B09CB94"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF22dUkBSsAQ7kNvwEm11-V&_nc_oc=Adrw8ma6Oon4VBreTbjnp923iPJ8Axx3Ihxa_RiZbCTenqJN-dKAt3tg5A5pkq53vn0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAJdbuez9kRVVcL87qTDrY5BVT9O7JCoANLr2cNKHYQg&oe=6B09A505"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0qE22WiCWkQ7kNvwGylEeB&_nc_oc=AdqmZoX0BhAsAOKRbSmxSLKN9tpgoT8tZFi0fFBMxn9Psa3Na3kZhlhYpOhkn2LQskY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXahgOPjQ7uiuMcmVFDil0Xto96516zpPHVqHY5ueqdQ&oe=6B09CB8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fYUWql-X50Q7kNvwFEzTy1&_nc_oc=AdqMs3bSNGt2HRCU7htYYdXUHAoJqnkF55soCHmXgQOojA8rl7KMU2Vgh5R_WSipEnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdndYjLlWq0TVIYTWWGJMKW1t-aBC97417LCs9vAiV3A&oe=6B09A70E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
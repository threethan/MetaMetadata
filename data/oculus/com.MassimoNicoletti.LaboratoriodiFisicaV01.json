aEOzlh7IRHoiSbyvV_NAHvvjBmgr96w333uoOVdw&oe=6A86EBB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCVh95Ep1_YQ7kNvwF7NiLd&_nc_oc=AdpgDmHRrXXJXfI2ARKhFQnFV2khqHRoi0KoItrOT77odTazWGYpuyv8bH67PB1shLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIcmllGbkb9INsMmvk0iVbYW9LEzY4FDiIWHMBx4O2Uw&oe=6A870370"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeKvZeKmPlMQ7kNvwG52DpQ&_nc_oc=Adr04F61dosoQrOCp5ZPaMB4YEr0u3LgDfp_o876Cdu_mRK92G6lWnqXhZTlqmBtsgM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHriIhJ97XJkdkgN9QloqYnPoYuI9D__IfSeNgMthqrpQ&oe=6A86E1DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6XPck5rbzoQ7kNvwEso3iW&_nc_oc=AdqiCdsdCEr9SU-bKL35Eup4p8JFUyooj0aQiL7hzxsU84Qzu1jw-yCbUFYFT4tZ_Vg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWldiv0ErS8n_3lIm_7UlT4hXOyKI0EzxJ1aObPg51Sw&oe=6A86FB77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEgU2Ur6ovwQ7kNvwG1dGBt&_nc_oc=AdpGjldlFOOb11CIUQ0arfyzxvnZp4MoXvatpAuHtGJgJwxMREbQN7RL13-XsINXHOk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQNSYvXOpgqCK37BXS4oORW_pdHBNhUsgLnBLHKXNH7w&oe=6A86D6BB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0aOaKa71ioQ7kNvwEKENxd&_nc_oc=AdrNh9_weKFsbIY3MkXPwDhVllNj9zl2jUTDQ0x3w51Asw3IzmpS0bZi1fgqEzId5ds&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzjvCw9S2cvM40DRjOh-uNXpD4MPLEbu8oq1lxfqcnWw&oe=6A86F333"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
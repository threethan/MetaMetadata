c_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswG_MXx4Q4Mt9oDJ2xDjM5ZKRzJRTW2st9Q1_J1l4Rog&oe=69A2D4C5"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2NKdXHmGgMQ7kNvwFWnOLt&_nc_oc=Adlp3hP9SJfItczzHVseO41xY4FJCj1tQFky_IZcke9YE7G9XriUtSnJFzg25ckkQ6c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulwFvUy66yNIXigkLL2VphsmsuqHqLU1cWT6AeTZzB5w&oe=69A2FB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7NZZFbffaUQ7kNvwGi6SSC&_nc_oc=AdmrYJ80JvKNshyp_f1HS9T0bN_Vi7M6Jca2WdtM7GSJDd0D2wT66Gu1xkrEAjWIe80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvaY-IEBPHrju5UJb3WDeiO8GHfQ3vGXZfrl2TFGVLgPQ&oe=69A2D6CE"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7014635251891409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75326678_684847243460423_1231468598944244579_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcQutZ-af8MQ7kNvwEReHUU&_nc_oc=Adm10RpBQg36YrrYd9cKtnEj2W-c1GjjWVT8OOaGu_o_-tRhrTbWK3MUXFsSRWeDNiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuMx9qKmcdrZ04ST8EtSgNSWgVNdSkX4EzREn3sAO2bkQ&oe=69A2CA47"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Physics Laboratory ", "platform": "AN
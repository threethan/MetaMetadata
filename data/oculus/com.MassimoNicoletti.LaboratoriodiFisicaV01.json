pzyFVhuScFXKXoZIl-47Gbpn8AiQJG8VJSkDFdaw&oe=6A64A4B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlr3noUR9KkQ7kNvwHwbdvD&_nc_oc=Adp2pOw3rSoi0US_39Lw9VDVMtLRKsSbXlGrKPQ0V0F0LrQXB130hqpqJz5hcDtLhAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZdAlJ3fWPrws5XLuW6I_WSWa6Ka0E6yVrQE6km0cG4A&oe=6A64BC70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Enb4-mWioXQQ7kNvwE-Xsve&_nc_oc=Adr1yTTTYwXVt-9pFUqgV7BRlsRsAlGArgmJZxvws3CN4iA2olGpX0Ilm_maXGmVeVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr3VCEP4YGCa07rDqeGyLpRPKQhSg-yDs-9a04Z0d8fA&oe=6A64D31E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdn4So0xncgQ7kNvwHIM0sZ&_nc_oc=AdpVqMKpu0diCmHzwdJC40wnWhbxfLsNE8gS2nODkBcW0bKMFOm0dO7L8bwAGKn5W_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVbRQbmZd6hyF2AaT_jll9DetXDSxPtt-_gU1dcCg4Hw&oe=6A64B477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk7x98RJYz8Q7kNvwFcB0_l&_nc_oc=AdoFZ-_in1Rg05MRQxnNEkBYUaSzDYUateBpa6NKP9-6tnaiIwhHq340Ra15nNZjB8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrO0PwiyemgzKeKkBWLwTIQjVMdRxhUTnUCWBoMYPdLw&oe=6A64C7FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQZt-66C1xkQ7kNvwHjQqnK&_nc_oc=AdqZlnG-mWiD7ZtfrugnoqCB_mQe1cOkDzipj0Fw0QxoaFwuvFjphPkxCTZRU_EnILE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAg6q78qbR9blUiuDQmu_efBYfqYP4r-BPSvZot17V4g&oe=6A64AC33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
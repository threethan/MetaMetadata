vVsDNZwzITH8S9zzdyIbpApD0WaI6gxbYS_hXi2A&oe=6A4CE9B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Djj2RNIpVYQ7kNvwGCrlIi&_nc_oc=Ado7qEdwy4C2Z0PAMeT5pkCSAB-lgDi5UYEsYpimJysQ5BsGARKqAKpXtowcURtAfEQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdTOQkKGme-Awby4gpalyftkXbhLuVEwfQpVCX0ClVsQ&oe=6A4D0170"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aznMWYLGqsgQ7kNvwEWO0xr&_nc_oc=AdowUmQvEaLsbfXQQC0x3azXd5DX8w_Wf_wJKyHwWyUvOsUiZ0cMBkfuayhMQzT7D50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8nmQmBvQW_n872_VN2QXOP6YVCSEXxdQ251v4uIk5MQ&oe=6A4D181E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dfz7vyKG4fsQ7kNvwHmoGMI&_nc_oc=AdoDSta-fpkhHVtdZHZ0L9-su4vKykbFZs32Aayk7pp33BBxiN57DW8hnoIJAdDQjvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChDb9rRCiiolz7diRNI5ZkVKLz1IsJ_-HxExuqo8nWLg&oe=6A4CF977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE3aLyrI0GIQ7kNvwHBgVYq&_nc_oc=AdpR3pWwZ71xSyt1E_nrYegl-vCcEVrz3283v_4dKlE416zYDE_nmooX6uQQPJYTx7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7gCIKrA47zOr-kgA9wX50LIfqvBxM8N0f1lKvF2atzw&oe=6A4D0CFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YScRL_IiQYwQ7kNvwGXzUvD&_nc_oc=AdrL7PPvTvDdk1TFWbeccb5VRhydsZhzhHkY4mvlNzGUNTBKNsZD0heSPiqu82QwUjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd8bAJDjlmWh0y44-Tn3qS_48wDqJ3pqVjzBcYxbNaUw&oe=6A4CF133"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
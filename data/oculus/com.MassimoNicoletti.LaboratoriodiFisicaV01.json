content-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T12nc2T9qtcQ7kNvwGO7Mrm&_nc_oc=AdrzM6uPngIpeLxbMCAYNs9ccTxsUjZKaNZCkmFUQVhpA6wColTkWBu0RtCYY0GR2YA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Obk5mP78uRBCJ-RmQD1F1Z0ku0ipvmuXfq_IdpiOmw&oe=69FDE770"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9vZ0qzbKwUQ7kNvwGo3sHv&_nc_oc=Adp_7atYW2C1jJh4fVL1GChHG7-t2uGC-FgoUH4FNcw7sINXUqZzLgaubWUM-NE2Eu4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dbr9w0iZhfIZEYnAv4a8eK8aXN5ERqW0WKwds49YQzA&oe=69FDFE1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mXcfGpR6o0Q7kNvwG1bmmn&_nc_oc=AdpH9aj7fFIa2DiV0_Bdz5avqmWXDw0QsXlc2ee010ASnBbSQ6dFLHUk1YOE9tvhC2k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X3mYR4ihFayOeLmAIkjYH0qORoLwlI4ES56jbCdh6Hg&oe=69FDDF77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1pTEr_xJL8Q7kNvwHZ4716&_nc_oc=Adpuvb2kjUxnxBzngoN6eKl3zWC1MwT0-q0y-VY9b4i3tV9GRF6UPu5ROIQTChbnBas&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gWJn7ctxOcxdT8Owgx0HZVd1VQDZN_ylHdooIMEhkDw&oe=69FDF2FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exAssKDdHe8Q7kNvwGSuPVM&_nc_oc=AdqzOqJIFUydbMpCJq27wTlvJR6DMrdkFmLoUEUEp7lIBeXK0CyvzLkMuNXT78gnh-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QYIuBBXSU3owTSaCbCKW1VfUMLTWVLqRIq9haVxF9pw&oe=69FDD733"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
uL4H3GTT5VtXlZEztagnjjDOgtoCKD5BqWM6UCog&oe=6A2D7DF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOrAbhQeSPAQ7kNvwEpv_xz&_nc_oc=AdokmNCEqVfcZaFWR4-U9bWip1qdswU1fNnZZ9WWiJ6unNKQ0BHVZNTYusMwn1LMnEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3mEu-Rc3D4G2_0dmaxAPCQ66lRYKmBMP3Pg3B11wgcg&oe=6A2D5D70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llPZP93XkPYQ7kNvwGyw489&_nc_oc=AdptIV6pp4cAFqYT6JvbWimHvx48Op7AOtJntcYJ1W8I3mGMdGlOIjdN0exrYsmpyjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P1C7a1L657akahPuZYJf8yPl44WSKXat8MlDTvri_Bw&oe=6A2D741E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qeMsZjC4LoQ7kNvwH4lNdj&_nc_oc=AdrQYf9iZfSVbleGms8Z_xU--jDmZFgquy43zNtW-vL8fl_m4bwrJdNhOVasf9374CQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93nwGYYfMKTZzcXCkLP-uJe5y93VDldTw1rnDzsz0IvA&oe=6A2D5577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxht5b4KTAwQ7kNvwFT5xV8&_nc_oc=AdrqvFOblaRWF4F-6EDGWgbDdtpy8a6M-jaZxi3E0NhQwqI7CNo1dc9Jy9WGdXRHkUE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G1bmXGq4ZW2JxzUFyF6JNsT7Qd4jAJx5rQHZoS7oTxQ&oe=6A2D68FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgOR95VsOFsQ7kNvwF8HE1F&_nc_oc=AdqYi4NBgS1raTIAWWlwpNHQ-prpf0wozlSvhtOfad9nZOyD5DWYBlmf17qW0kNhKwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af882q1ZexbZeDGUlkR-32zXzNS-F5uR0ZZXkljm1uHxaw&oe=6A2D4D33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
chjJjais3JOd7-KZrwfftobRPT9rQJywiRJ0mWwg&oe=6A562434"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PqS4iqlTK8Q7kNvwFwSLZJ&_nc_oc=Adoi9NRvqExYxkvLzZSGOhTL-HZyMRwJdWWWd4uT1mYdhzZUk1njytlCE-m0gwYbhKk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABb0pPW6qH6lMTRn89FQmfFFrlEKWYLZ5VvCu_RECqWQ&oe=6A563BF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvQpJ-SgMq0Q7kNvwEaSoFt&_nc_oc=AdrlTh0jlzpwSJvQe2BSlbX_JBi32YlZPQKYLT2NL67nQsZI29oOLIY2cEHbYK0Yaog&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvBrBDOGyra7pKdD_IGz-l0rtagHEQb9PqqjvU8R6ntg&oe=6A56529E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izfnsp3wPOwQ7kNvwHsoTLQ&_nc_oc=AdrMUbxn0kX_O0Iex27_ikvAni0ZCWf0PsO8fvTqjO3XoMUk4Dp00aamLt0Xz_93GDw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-yxBEU1tdBkx_Xo3tJ-BqRYz_ym_7ThkxaGR9DXHSZw&oe=6A5633F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQX_pqFlDRkQ7kNvwErV3ca&_nc_oc=Adobp8wz7fMj063ezQDW0jezbI5EqkYT2T4scZjbYZ6pOYXF-mnE1DF1VTkVIJ67ZA4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlL4j7v_5KPLCv8zzKG86Xf8nBQWdDQCumBTSysydWVg&oe=6A56477B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUSHXVirDvYQ7kNvwFTFM9N&_nc_oc=AdqOcF9vs4kTgiVjTr4xy-_oPj8w4Gq6To91Jxkpey097cWN3nXztmzIUOK98QxVj8I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF3jJKb-z5o5Q3GVC0Y_L_6Jx8dhoex1QLpzelMHWl1A&oe=6A562BB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
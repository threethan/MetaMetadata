content-fra3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKg57vx8PN8Q7kNvwHx7us3&_nc_oc=AdpXlzM5ILDSTqRxJ-fJ8MWMvttGznk2lMbNrnv45E6pxv75CO-HKSF79aQD46RoYBo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAnMaTeOJqWr2pGc5NSU1SEqRcoB_Y3tOvJFCmDwceOA&oe=69C7D9F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JRZbJv6zrQQ7kNvwFW_seS&_nc_oc=AdrAsoxf1OuXpC5qAJQ7NJ8cQx9iU2_7mC9-AkKm1cwZYf-2qa8qB9nEb5tAoHUj6zw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzC7HUDrZmBb45LwRCxjva0arhxH2ztBOgqGaZx5iQrmg&oe=69C7B85E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIHmnRoGEKoQ7kNvwHc45XT&_nc_oc=Adr3PAXtlmzNPzJIb5SihDG_1yhJg_e27vE9_mvLA3XtsBynFVf3MRTO5xttLnvCRWc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeXGHaQfJE2GCead9w1AlW_qGSsIQcFnQeT7OokbgtWA&oe=69C7D1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc6G3vuKPksQ7kNvwHg9qHB&_nc_oc=AdrNA0ydZSyx2F6_7McraBmPD-q-e_mBNAZX-bFxSfhh85APExKJYeUYT_vFDTTpk8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy63O-36YVAXV7J-C2Y2aXhwG8SsmdQtl8htZ-ttQWblg&oe=69C7E57B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDNkyuLUpoQ7kNvwGYWRCw&_nc_oc=AdrMzBTzbbrMecyXfemNzinR-wEKUyQ9xwJ874rD0I8iJaz4HUtRW-sZTBM5kLD_Nsg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFdaVaTBmUgOt7-dHTLXnNGH-1BcAd9MlVJEpsJLqCyw&oe=69C7C9B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
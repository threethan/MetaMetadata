igOGV9tcD6Wk7dfKCoIFQPblyRS-jrWui1eaLBXQ&oe=6A147174"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvH376AsTVAQ7kNvwHPWeov&_nc_oc=AdrHhLPNic7E65ajjVKCv0Qni4B7-ffOs0slvWfpb3r2iFBsPgrQrAcpbmO5x7L-6uI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vZ1_Wl8f_R6_IfZXNWTyeRYN1Zgc1RItfHB4oW_u3pw&oe=6A1450F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vljBLwryQGsQ7kNvwFsu29F&_nc_oc=AdqF5IuTpWKQmfBOSoRtMh47RGBpqVmBTh6fD67-bT3QZ7oNrO_lF1JIcSbMWv8V7y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GPVriJiHlM8DNsvsaiS6ggSShb65gXoKVeFtv-8ba7w&oe=6A14679E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCOm3IqsBvcQ7kNvwG74rW7&_nc_oc=AdqdPFrbsQftriHawMit1YMjQiN1pgjeAVljGFpbCVkAc7GezCzhwssI323xmQN-hbQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Y1-BbwKCD2V261SLzMFOOlmDNTFoFKJFa61g9MpBMw&oe=6A1448F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQoDLK9hlBMQ7kNvwFRtyF8&_nc_oc=AdoY6YoAymiGU3mHG3C9dK8v8Fnsi28YhFxLtgfj_U_1-6kE_6inpHCbACNZnj1Mqzg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PerlNbxgbgEWtAlro-CsHp6t1xKpXLSuHK-GcQvlaaA&oe=6A145C7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlM6bdmx0-IQ7kNvwGSNVOr&_nc_oc=Adp9nwH-HXfDBAM55OV5Fspf-_Fignkn282Va47prxS0Dn8pSYbI35wp8vBPh7H1qoA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LDeFVr1dUTSeil-HKL_13U9C4d2M4134bK8PTjO61XQ&oe=6A1440B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
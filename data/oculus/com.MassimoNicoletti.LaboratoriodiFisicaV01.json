Gw2j2URVErJXK9zwt0i6FpVQMwn7MmL-h5kxjtnQ&oe=6AEF4A74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWZS36Y4AWIQ7kNvwGZPMNn&_nc_oc=AdqQi0cgu8YUbRVq3xGLXMJVVJl5ijkUB8BjmhcWPyOsVOl4x1dG4bAuGWuTK9_9ubk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF3bW4Qgye35-qvbUgV4Prv02BbzsAgwPANULWDpxVog&oe=6AEF6230"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CICdkDMh6MwQ7kNvwEz2rei&_nc_oc=Adpk0RjEGLOUqchly8lbiMbiH6ABQPi5QfAPoesoavrrln0bNU0Vs-1VRYKLQ5aQwI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2KAS-DDb5Yn5wESjNDTho-GYBZ3QTh9hRKw_rMcUJsw&oe=6AEF409E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yWJZ3Ul4jsQ7kNvwE-Ct3O&_nc_oc=AdpHfgV_6uEiKl4018xqOzfNGPd2sL7DU5wiL1Rk1Xis8I66og4CWCqyGYLleMZFfrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1HMPyrGae8wpRWSr2wgqqgCy9GR4t3Fp8OHD11APAWg&oe=6AEF5A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ksnj3Hr-EMQ7kNvwEarm31&_nc_oc=AdrNFp7fjUad6wxcmSUKAmy32tfctdYjyEXOh_KXccqD4Hfets_sa0Erl9EJ14SH5BE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH4-y9R8VktHTApuDSFmK2KV7Bx7Ns3ynP-UkF6iUfew&oe=6AEF357B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bowM6MBdJMEQ7kNvwFfQam4&_nc_oc=AdqLUS46TxIqzV3TWOXTsIljBtdl_X2JgLV4uug4j2rS1XGJ_fqau1FsZ2KalqAeZ8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU2Qj7ZgePGUTB3Epsq1jKzCSREEWpto9S_TvBNAr8fw&oe=6AEF51F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
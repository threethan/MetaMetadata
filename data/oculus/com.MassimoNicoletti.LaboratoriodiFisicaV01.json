i1RcgSauiiaLsLH40X6x1ywNYW47h6Dkn9oD7phg&oe=6ABA8E74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDENf0fMrVgQ7kNvwFbc5zm&_nc_oc=AdqPejwJOZgShXxFpotKDvmYVTIGsEU0t_Ixw7MLIZg-mTokbITvVbUe1cGGaEJ7vYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg9ZK8iyCIoCixetHzIXENI7PntEnrSdmyLkN72vIwpQ&oe=6ABA6DF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EshsEaBRdcQ7kNvwGLOpS-&_nc_oc=Ado5PorBSYA4FM-waUTZqnabg7zPKHW0ec9UPKzchDjDEucxq-32i9z5m3dbGmWzWUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWI6e2cWXpiWLnxCiLF52wGvTBuRBk2Hg-moMKs_DWA&oe=6ABA849E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYvw1vFTco8Q7kNvwFaPcuS&_nc_oc=AdqNQvWFZ1Unx7-pxxT5UJ06YOykR5iBC40bpnEMVK6UEKd64SzdR36eTWYaIMFxLEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_-DvHYzeLa7x03ufPhcvknkCzckfhpF3yB2pKkyMvRw&oe=6ABA65F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYtCKWUhd2IQ7kNvwEw1qIK&_nc_oc=AdrZ5L6VssHJ-OXYeBBWdBuMtJaWfwPuYxg2RFjzOKKzny3hK99Lw5mXdwvrTv_cMbo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImTvNfx5lIhyt7ZFv81du2VfR7WDuGCyzYJOT5DUYvWg&oe=6ABA797B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfVUmtoP_aAQ7kNvwERMrJu&_nc_oc=AdpGItRaf-lq-o593WmnghVa_fQgcm7H4eyXPln00f_nrLs3EbGJKyYGDABabXtOqAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ70nVtaXz8mg6wegLR9E9DnTplqyEzUXROg4PnLUmgDg&oe=6ABA5DB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
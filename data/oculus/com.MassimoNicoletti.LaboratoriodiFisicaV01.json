sSRT3KU26nVjrDvA8AtrDBvQu3sqCn82kY-EKhHg&oe=6A3D4FF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyYjNXj9h28Q7kNvwF_wLsw&_nc_oc=AdoZdJtAFGED3eu8Qrvk1pwAJ4LywGyIbbhE9qs9dPmMP6NUOAJE1-3awWs8O6RItlA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S_tdNF68h4QvURxZZRtE9vbOICmsJ2VwZ2xKL6nLAkg&oe=6A3D2F70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ_UnJQcvfIQ7kNvwGtX0YB&_nc_oc=Adp4GigW-yqGeZG8-QJO8J8Yzom3JT_tCYqPWWYeLJQ7IYnlCzs44mNs8y36uPqf2jw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3jZrGuOig0eiE4Gaewcaf1GX2Wjxws27m85nYvA-H0g&oe=6A3D461E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM0s9Xs6xxUQ7kNvwEFnMjz&_nc_oc=Adosm9QjQNlJ4cPvf8rtJ-fpbb7AgYARhXCRmDJgJn3Hg40ZCVsr7_87GhTrFleu3N4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WDhhHG6giqOfp5d0n6ItTUj-MZGR0MGgmAFP8nlbF5g&oe=6A3D2777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4zFCL0bT64Q7kNvwG76lj2&_nc_oc=AdoDPYlAxpzut5_m4YXOZw4YA-CUfQsjl4_DFlGze1ckHb655MlQHT3bdet3A77OJWc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KQmSYihB6ZcKdqpRTtdnVklUzEb9kcb_BkMk3oTfTaw&oe=6A3D3AFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttjBFIr0iX4Q7kNvwEJJiTV&_nc_oc=AdrrtzzKLweGgioqIzQ-Je1b3FsDBJOQxd7UwbKZ8YXdcODkDdTIu-M0VtDIBsH9EYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YqudG_mFNnVQx7tBpsnDraZwb3g2U7vfCjbQmkRp43A&oe=6A3D5773"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
ntent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmr0XCsMfujQFBQfRpB-0dLFgUoRSWY2If7EnMag7ZyA&oe=6A9AD554"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzrmUajjqcwQ7kNvwFP29sO&_nc_oc=Adoq_tlKVfpjZHzjovfMgoXSAw58ZhjsvnCxTFHQqa4oGZe70yz_VXnsNaTgegvuC4I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9ovsGlxl-qni4G0TT-zOquSTgKJ52QIIKV5yQJSY76w&oe=6A9AE705"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IGIG5sSUEAQ7kNvwHjUJcI&_nc_oc=AdqXysxgD9MYQoXRlmbiHT9DAJcdEZBBLH9ZGW0gVl9ELsjZV0m52gKUsnGpOiRVCi8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1KaDbS3j9ohfa5sWH1l7S6a6mZsd2DnUNoZ4cA5pL8g&oe=6A9AD54B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHcnfD2rUnkQ7kNvwFg0FcO&_nc_oc=Adr-TuLOIks-By15TJ0pCoCzmdKunHl25UvmNwxR4y2wmdWZngz1bR-P2u5t0EFgNlI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIjy0y7A8Q59Ov1TQUQB7qVAopL1W6ju6pU5S1oyb5Sg&oe=6A9AE90E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7014635251891409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v
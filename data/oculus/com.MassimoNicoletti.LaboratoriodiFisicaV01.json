kxjBCYqTZrAxc5RDx_XItpGxvTyc9xjngu53JHkw&oe=6AA57674"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li3SLHUDp9IQ7kNvwEU3ahn&_nc_oc=Adp7o3ou7zkKKRkucWyBn-2UwyO4x9xoWsUwJPloUTwY56GZ14PsHdWIx9VuC9lzdqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKflbNZRusJECBvO8ssyv99BT_k2l9qDd_Mphr7_uC1zQ&oe=6AA555F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g52W14EYuwQ7kNvwGrfR2i&_nc_oc=AdpeqhUm1XxMshRZShbHY19QDrSB0DG0lzWQegIvdFudQTuuwTRDl0Q1ctspM5Iprv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIogYlkgtFeiAJfzOasNy_SERxhonDU_ZAkiaOkxKQvfQ&oe=6AA56C9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujsN2akKWzYQ7kNvwHuA8vr&_nc_oc=Adq5NgR5RqJInBoSp-hBoq3XVd1hXKTcGlAs8N6Es7DuaBfNuqqnstqZ7EDJCJeS1JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7eD-qIElXreh4GO-mYwjlCZtURRdA30CgB_PZdm9ZIg&oe=6AA54DF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBe4nhZaw-IQ7kNvwFYthAu&_nc_oc=AdoexZaEFupV6UEZ86vVZsMHcTfe0hNGdbs1RYgAEWoqAY9_EO8APQAiZNXf4ut6ipE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9Zk6If9aWpSTO4Qf2APIJ37WFIjp7ILEAtiRe6xB3fQ&oe=6AA5617B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMBJBpdpTIsQ7kNvwHSlgFn&_nc_oc=AdpmNx2BIIkDNqcp8NjH2W3f0B9Iq9TIrjhZjtDoRRcKcorvyYy2i-Z5tMJ2UTowI-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM_JXHm2bPw0LBJnhhEPHCWNxknkfRlojIR-JKkqj8Hg&oe=6AA545B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
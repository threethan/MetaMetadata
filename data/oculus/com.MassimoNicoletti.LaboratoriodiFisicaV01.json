TnzT0pGEZiWkyM2xq-B4ux5_0G7FF0_sM0-XPVqQ&oe=6AA6C7F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLJLdYYooacQ7kNvwGen1DF&_nc_oc=Ado9u5jsp36pTm2QztVwojY_QxIauSmLVbUPBLRX4nwmWDvl46jZEx6GJ6kCibjWLqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5AxHmcbnCxAskQiTKUC4JRJHEwX1i4FzLu04ktMmiKw&oe=6AA6A770"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g52W14EYuwQ7kNvwFyUo--&_nc_oc=AdoLDLk8bQzVNMoP27J2QAa5Fy0DAkXosfmo0G3XB9FT7JzvLPzY-D0SMzDgdubAkDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPDs7I_KXBlypxp8KL25Br8iTa1cYypdzpmBOARgAZEw&oe=6AA6BE1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujsN2akKWzYQ7kNvwGOJ4yG&_nc_oc=AdrZ2LEgXugaCLsJHgL7dW3btULu72NbQODJYdhh9tluxFZsxHP0Rt8RxVJ_MqinxWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVTNMn0oIqEryRAGSMZgh4JwONg4Q3SBvcRJ60iQ6cxQ&oe=6AA69F77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBe4nhZaw-IQ7kNvwEAgV23&_nc_oc=AdpbiDNDCfnr0dmhvnD82Npr51qhamTaGWLhh4VSyWFyBXiiAVPMrooLD6jUH7gCvyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ91NM9zCkxodcyrmHNke6MG1Nyomle00wz3hycz8cHHw&oe=6AA6B2FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMBJBpdpTIsQ7kNvwHRbG5R&_nc_oc=AdrtdNxQHppyFrdhZq11UfRxGsqOv3hHsHxwX34-XNMCrjZ9-C-18isIBtsf452Znsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEwN9QoTkDNiWtb28kC7eVBDKNneowN4mEeJIXFO114Q&oe=6AA69733"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
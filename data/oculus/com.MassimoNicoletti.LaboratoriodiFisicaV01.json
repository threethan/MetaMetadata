=00_Af_Ze-EYoNYvZXS5x-iWJnmxScGQGxCVmVLExXPvi-O-dQ&oe=6A22F1F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jYxBVMVkXYQ7kNvwEHJi-9&_nc_oc=Adrt8CBSSd7Im01-oRI7MfL-5PF4NSBEBSApgG7MusAiqd0NQf-8tKQRe3BrUWndfaI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MGr-kyMcQrpNFk4rhWwB3rPPqcEAUP19PuIaaFwRWFw&oe=6A22D170"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQ3usox9CYgQ7kNvwE64UHb&_nc_oc=AdqCzqZ35QBBq1Q1_5nAQxE0yqcgPEApJpMiE9ZFu805Rsvbu7tSVTRJ7IZnXpJsnfE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8IYRAaFI63NZA5dkWJXMgVg_JIounbq6NX06BUqvPwQ&oe=6A22E81E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG6I00b5MEkQ7kNvwF_bB2F&_nc_oc=Adoh2f5I5nzKR0fe-mZZ6Xo0qXhHzS5GZLsqV2fcK2IcOijcOQ1Cs6NNXeoMKqDfVFM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QOGOnTNvFQ0Ql8MKvU1CMkIzQWmZIElF4N96U0Rebbw&oe=6A22C977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7IHs-RnEfsQ7kNvwHgXRIH&_nc_oc=Adq_kXOULaENhx8_yUJBFBSdyZ_R9X0c6mZj9mZD0UjTDCEHka0nF7frFDn-hvfEPdE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0GbkfG2HwrVIr7OeY8hhDAXRGS9P8m4DMQ5rlr3Vvrw&oe=6A22DCFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb4prSwtzrUQ7kNvwHWQV_X&_nc_oc=AdrUlTEBxp2C1gmfD60Q70fHcIywU3GvHpxudi2nKEdSmX990XcOdFmv-etvSNhQmBg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n7r8j_jcqnO8EMcCnncUNpTmJTo31G3WDX71GTVLppQ&oe=6A22F973"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_L
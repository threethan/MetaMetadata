771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L41tKvwAlYQ7kNvwF-f-f6&_nc_oc=AdnoNWl86cLhUkmlevoz2UA_JhGuAoP5vnXvESKRYTEWxrRpoc9RULmCz17tsH-J_bs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWSQd8nMSiD2gKpCs8JW5eWYGxeysfrRtGwY1TU1UA5w&oe=69BD4DF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjAZJ2Kc4y4Q7kNvwHiVzPn&_nc_oc=AdkM8apV19Hv_mwgNV-SIW9C-faX-ZQXgh9OxWWy4z-wmknElBeHmP9l4-aaHsRNQTE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHCinSVxhqGYqPIwbfZktVvm447EIC4Q7B-dfm07vHYw&oe=69BD2C5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsKbJUpzZxgQ7kNvwG8x2jP&_nc_oc=Adn9tRuhyIPuFQJQe0inBE3gl2UPEecnVUmRirOW8D6QPKe79dT9FAvpKV-wN_QvLhY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrSue8JN9IxeFwlIyM8aP8SG04PhniR3pQQxEDCz60-Q&oe=69BD45F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rf1k0HBoFAQ7kNvwErY97l&_nc_oc=AdlHqawwonysI1EQM8Oo3nPvhsJ-iJ_IALbELntknsSdiR4Y_ioDy5Vsrkv2gxgMKxA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeG9d90S7pMsxf9bGZah7ampK1hpGChkOK50ymAIMQ6A&oe=69BD597B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AJflGAvo94Q7kNvwEQ3Z36&_nc_oc=AdmUrw0BM8BKWlfNJLvLqzVbFXTdLuCcNDWKgrG1HkYbCi3XJShW4Y8f-qffUEdVGRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3aTJKB0n1WaXd02m3SOxSkj7AJX_UI3PP3KyHi3VexA&oe=69BD3DB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjaZtt0d1xMQ7kNvwH6ZnUX&_nc_oc=Ad
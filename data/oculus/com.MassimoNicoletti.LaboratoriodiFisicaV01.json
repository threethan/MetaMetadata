8SEviQhEkYG7wcQvoNEbX5bfSpHPjnBXzTrt6LlA&oe=6AC3C8F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9BCDomhC2oQ7kNvwGl-L2c&_nc_oc=AdqBuUTvj09eoX6soUu-I4COoqlS1fuSeR13KZ3tuNYhQYHh3ymSA-cY0X7Y83aeMSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx1nciGfd1kyoU5urSegEe__aP2xZi_RfKvgiNmmAncQ&oe=6AC3A870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaiAgQkbhGEQ7kNvwH42BqD&_nc_oc=Adq2m9b5YbDVnoRhptNpgbQoD8SQqmBQcaZkEus6MXIfHh6mkb_VrJ7YrIVlzJkxuuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQBlVwW5ctRKe-evKyhOvqKyqdAraEEQHs9SsrhGzmjg&oe=6AC3BF1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGwHKsh-sDoQ7kNvwFFlDK2&_nc_oc=AdpmyaKHGTgoIBt_l-m20gt9FDqVGJlhdZTQLEFw4A3EomxCXRc0K9z6bNVINFVaOq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxyU-quHFb6hkqwStdBhhbaghGFMpka-C3jBydlVdmoQ&oe=6AC3D8B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SJvD6thTb8Q7kNvwGSefXF&_nc_oc=AdqSsUQ5UL_-GuFHVKvQ2c8_eujDhWa7STWtpAQF15e-6YTi-liKQiJqlwsll5i_nRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz-un47rM4IHiJ8aTFeyztftEjLCxGmsLriMSGWXQHlg&oe=6AC3B3FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-JOJ9BJ_fYQ7kNvwEVsIxr&_nc_oc=Adqx5wiPyZd31zv6g8dTFFX7GWx2J35pV_C5k6Wgag8NbUxcqZj5dmfyFAo_fgl3oig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4mJHnJgNhdiM85wL3haRptS6t-nptKFCC3d7h1OG35w&oe=6AC3D073"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
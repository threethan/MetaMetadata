soCdfJ1rDpbOKhn-JVnN6HFrW1oifCoZfwANulhw&oe=6AAABC74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcVQXVZvEVEQ7kNvwGx2fyM&_nc_oc=Adq47c0Z08UIO4YzgQTWE-GLe_AsTcTcSQ9SpCI-KmBEDaPkGeomg03VLs2X87eQLdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5XHsp1utmuAaRhiWp-8aKxxUMYnSViO3DZflilkx16g&oe=6AAA9BF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49HHLnbAPmcQ7kNvwGLptjp&_nc_oc=AdpRYpp8RJZVCO4jeQCBWu4QETG5npla1dMRHxwo77P_YSeZUbpBLrQltNyh-pdTs0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk1B9INVubbM-uWTl5FnYa86MOxgO67UOBzS0xSzQLug&oe=6AAAB29E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZssJZ1mNjUQ7kNvwFXtCaM&_nc_oc=AdoNlvHqgstN_bMVnMPYvroTJoxh63pUJ30zXBGV2s_CtkK6GTr6QOa75fLK1VlmJbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGKcjVBPn4VVnfQAuu_Jjf35Wr5gX55a8qZp8DY8WZmA&oe=6AAA93F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckdh3XPD_i8Q7kNvwH_ERcn&_nc_oc=AdoZBQbtnC4IiqBu7wy4CatTquzK1S7uJ9Ju6lUNIFtm-GKoMWZcCJJOSBcGhNpOenc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3Wd-M7Tz_IIxoE242Ei-e6xr45sRs-vcvClKRc1aVRg&oe=6AAAA77B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NZn-Y4rPgMQ7kNvwFcFW4r&_nc_oc=AdpyrUCxWRsc84K-bUv2BqfNV_3q_1LUs8K_CgJtGjUdI_mUdvpnKNPGlXApI_AchN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPrQFUSpkqF0ZbV6f1itJ1xQbSDBk2Wr2bpXvTNLcLFg&oe=6AAA8BB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
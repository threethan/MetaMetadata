hk4S-nQkYQ5yCcQYTJtBA-YNu2VKzzA5vP68PbDw&oe=6A4BD074"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Djj2RNIpVYQ7kNvwFyCeuK&_nc_oc=Adq_lSUEZcKz7B8BCEP0zt9BK5XsQKm19qp6EQldf5NEmU3EZY32H0YioVBwTfaM0Kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuqxM15GqqJIaWNQ5IXXaT8l9zL2UpBDQJ5lj0iZdLOw&oe=6A4BAFF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hKvlJktzhMQ7kNvwGetWpg&_nc_oc=AdrwvpBAQoJbvMAO328hAcMW1yJRmeKiZNN8FYctePljUMmgH5plZIwdJ-L5DN5SOd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsJ57FUCfaMvXTjX067ravJTNSAf5D4GvP3mWARthWSA&oe=6A4BC69E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dfz7vyKG4fsQ7kNvwFR6P4P&_nc_oc=AdqPNDOc5QS30lBmZUfy2TOdTRfNtuCkMEg1VmeRYQAU53fCJipHaKdk4-HjZcMqw68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaV2IpUgLpXt2G83BKLm4b-JLJfVzBiQoCXl_MiSTqQA&oe=6A4BA7F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE3aLyrI0GIQ7kNvwE1H54L&_nc_oc=AdroIcg5QrS78Z0Q9eD8nE0lkgOYu9hQz22kiJJJ8u3irQZoXeZWaDWATjDHHEKjjWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDImx9WOcMmNKd3-B38oON5_hys5tREj0eGLcxh6BuVYg&oe=6A4BBB7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hENhyZfaZdsQ7kNvwHYuYEH&_nc_oc=Adp6n1EVqjcACH34CDi8fbjqGXSl1VI-KSHESXY2l_WByXicG-JzO7_nk80k8Wde7a4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTeKrqFISfKchLkluoTjBa9Z_pFgNSgzEfNDXexRnL6Q&oe=6A4B9FB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuvHQC9F_kAQ7kNvwEBYxcH&_nc_oc=AdkqbuqMfuqgahmsvRb5HUt4DL-mEhwtZtVNqnpoEKiTWX6nxafysEWSx-IC4JlKza8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxMmwkO-e9nErkiQcrbXe70LHcJgmbNVd-bQH059XS_w&oe=69B41370"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLJs5Ut3Bq8Q7kNvwFVhW8D&_nc_oc=AdnQ2RyviMmy9l5IUyAXonrojbpfO4jp-S0XauRF_g0uP_wsJSUmIqiKh_AeqHiH-ak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLgCsKLv7UQWr_RGLXyoS3aCJ9hmZN6eUDkbJJcX7LvQ&oe=69B3F1DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkE04wVOCLkQ7kNvwEQCOz8&_nc_oc=AdnhMhoJ_3Z1y7KVC9NeJIg0wnKbEjJIHvEk_4k41JPjfKQqLgQmk2C4tWeQ8VM2ez4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzbMYVyk5S9CXRwdMgtInLBvdCCr5_vwDS4V30NxkE22g&oe=69B40B77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2FriG0_ggUQ7kNvwE9KNXP&_nc_oc=AdlmzNTqETuN4EJbZURKC4PtAP-jzd309lr6zexaqaB3b4tczm6skR_fEJr6dAOqjqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxF2HnGEXbfLLSOHNp8YReVA34ZrD5UTW3lVryKAE4skQ&oe=69B41EFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wJAQAUmaOoQ7kNvwEv2qQc&_nc_oc=Adm6BXA2Dj8FKCr5JfzRCX7q6oWjDI1GyrP4VXesnxZV_XoK9ZiSPnskzXIqwWS8w10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJPPBr4tC4a4EXjpl4sY0GeAPsumj2Nf5igUh37AHPog&oe=69B40333"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L5pbekrnYEQ7kNvwFEL_4Y&_nc_oc=Ad
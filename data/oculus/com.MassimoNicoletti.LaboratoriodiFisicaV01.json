771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byOfXRP30egQ7kNvwFPrexm&_nc_oc=AdnU4UTFYo2OLbJSUiZupjDRzCfolEhR4rWxScOOzzxAVUNxJbz2UDtA8ov6pk8LlKw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5ft_qrppVBEkYLf3tyMNy3Bf3k4alDhmBNQ2lDoKqng&oe=69B6B670"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jhuHWPsOyUQ7kNvwHh6wnn&_nc_oc=AdnatgeTQY0qbfS8pow6hueAfHerWpLbstIxBH6e-Xm2aMnPyJoaQlw8Qe_KA1gY5Jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp3c55W94zNuOKbku7wlK205IDSTb5HT2XkQE6sfNEAA&oe=69B694DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkE04wVOCLkQ7kNvwGZAZKk&_nc_oc=AdndC96zsTvTzcMGj8v54Co2TqhGnmNcsWkz-_gXApmNqtLE6-9wOBil3_CD0sluDiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt7lQAv0DgXitDMgiBqSPxTqRoleoWnZnDT9jYTBIrvw&oe=69B6AE77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2FriG0_ggUQ7kNvwFIFblU&_nc_oc=AdnDD-_tLofLBd8PTgYdQs_GfWN2v65ZYxJu-ZHQjNIpxT-74ps3Ka2ENC71EmJIk-w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzgsq4fHD8T7vwHqX4yaI7J8R3K4C0DGv-qXlzkvWQiWA&oe=69B6C1FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eXyVqy_l9gQ7kNvwEnQN7Z&_nc_oc=AdnueyABW1cCvR-ZSzilzgZWZ6HV_4MfZ3-T7687FaaGHUDe5pY-JFV7mz7VU-3GMz8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiWhx5w1NaJX8FMtv176s2M3W9MqzsNpXdsMoAm_HXYg&oe=69B6A633"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L5pbekrnYEQ7kNvwEzBlIm&_nc_oc=Ad
D13V4YFK3F-5jtWPrVKZ8ZjV0uRnkVuXKjmZyYeg&oe=6A689934"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq3LRoDeLAMQ7kNvwEmCdPC&_nc_oc=AdqddgYbvW64s6qF-J1ILgpJXy7YcUg25l2utU2r7611_ncoxCUSXFROTxre7ByQ4GY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPyc22l0CC53xuxS-IO6wdB_JZGjeV2_llvpoL1BWgYw&oe=6A68B0F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0OfLxGWL8IQ7kNvwHotC-Z&_nc_oc=AdpFMnCpYZGDHOSgzIzhaJj6l6T09wz-Fk-gwLTuCEqH7g34JXh9Tqw2dWrAOrUvXVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUqwvLJ5qpysBIu4sw6DoUAbDJtR1sdu3VvK2PoYMqcQ&oe=6A688F5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1s6-k2fnU8Q7kNvwHgs0F4&_nc_oc=AdprCWi0Yy314TCcs76_4oa1pjTmB8RgkqjK00YC5Xwx1iSvLv3sMNBaKjvExIk4mVU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW48bRu74airj3TvzPb2v0HZHMUM7JggDqTByBnC5KEg&oe=6A68A8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwwpws7bP4EQ7kNvwFFS75P&_nc_oc=Adpr8aZrwp4EbAZ3Kwms_y-RO0jGQybxqKl1nQEP5ujHqwiSfye6Sdmikm_RT_z9OrQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8OvTmxYr1XWnt1zdDH9vbGw-hL2u24bkWfTmuDJANag&oe=6A68BC7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGZva5wXjBcQ7kNvwG1R3CE&_nc_oc=Adp7vki1ISvL3E1muyWAGd_l5X7Dwc5YUIPIOP2vatwPfccPcA0WEOVRSPZ94q1jCwc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ64WUZZNS9ZrWYZFJR30F2J9jqPBzZaZdPTLCnZsGDg&oe=6A68A0B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
_sid=6e7a0a&_nc_ohc=gDPNF_f0TPwQ7kNvwHmN3qo&_nc_oc=Adp3CiBuQoeiv_Hcl0hfhw02-FthYXhW82zqOAl41VrV8Q-co2rtWLH6wK-Pl8DdrBQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLDTo6P0MDb9o_Q4SP2TYyM08bfNT8vDqkZm2ym_nO2A&oe=6AFB30DF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJzgUbJkFS0Q7kNvwGqsiU8&_nc_oc=AdpbeBTNstKiSE9tK0IAAYR8iNa8P5Eq8Uib-XrEbKgmM8XauaLaR4Y8XwoniYL6Vrw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy7F1UeS9ogfs1lkEHLN2VYvGS0tsd7H3dRvzYKm5u-A&oe=6AFB4B14"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6IWmpYFdr0Q7kNvwGKpSE8&_nc_oc=AdpTGfLR7zhnthySbWSte7x2eS0irsTgxoA4OCyNj5Zg49e6yZsW91vsiMLbiMqc2Hk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLw3-K-RFO2RZvhItXQZixSTqWKtXs1J6Mf8fDRE-UsQ&oe=6AFB2485"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEW44DsA7LcQ7kNvwGtOR2E&_nc_oc=AdoS14tnlKyQDLMQPGnmxUFg_g8t1Va_fP82Y7M4_lVCYSMqAx513RrxQRvRqKIswCM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxypNcpvBWzpV9inWJxw_kX7478SmLjH5leQXyNsFzqQ&oe=6AFB4B0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHIsoPW0o8wQ7kNvwE4KyBD&_nc_oc=AdriToeRVAzB2cVlfjQ8KHCdz-BlgoxwZM-gkh7qGZbItdoR5RISEXiD8vs5is56fAA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbcdb3O5vADR8NkpB6dgXlfMaFAC5AYOYx2OuhFeGv5g&oe=6AFB268E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
PSrWg3BkDDmDfA_5scuS2_MrgpGNcnV0E0PEmYGg&oe=6A511674"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3U14KeMOmoQ7kNvwEzwOSo&_nc_oc=AdqOZBpETqfCISGFY2J_tG6IYTyjV2rDUJ9UvV9WXkgLXa3NUZk5dA0R3Q7qAzlrDOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaqrcnpJEF05PlWh_tu_so6VcM40YFHMWMrjQSs1F_8w&oe=6A50F5F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5D4Dbr_aHj0Q7kNvwGFDdwU&_nc_oc=Adp3SpoFdK1FvPu-DH-2TEq0zs3M3iCIojBfwiUTgnaaqxOvu-wE_HVWzJ5JIMjIoiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD65KdFWoyKGuF1TxauUwqjjFE0mFGxXjh0xy1X5cXDNA&oe=6A510C9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0sepsPF63sQ7kNvwGpYesI&_nc_oc=AdrUHUip_-pyqSSihvUj-urK0vZ8Y-uu_KPFl7NMS6VT9eeQ_WHqP2n2Hpk7azeEskM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7dYvspZqRq8Td4Zokao7DtJPZm0qlEsL2FHJu2Zye4w&oe=6A50EDF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3eEghe5tAgQ7kNvwGHxDz9&_nc_oc=Adrc00hg99yWiZrnGX6262KGhRifxSt6N4QPJCchTanzGqLj3HZX1o9-EKQWZ5yaQL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClx1Hr471Hr_yFNZyU5kZFI623KgAp46O8-DYwESecyA&oe=6A51017B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KX2C6fHTAgQ7kNvwEDn_Mr&_nc_oc=AdqBR0KPMZzzOViq9iOQ-Ca5dJefjqPk7VuQkK15ieeZhx22zRJNJJEE-SpO2snCxnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7jWKlBCIUJM1z-bECu4ccOiQPfbj7KYKhpwBaSXoTiA&oe=6A50E5B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
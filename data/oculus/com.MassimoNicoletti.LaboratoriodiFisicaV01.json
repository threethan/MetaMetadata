9t4NEISFLf6IfMK5qaMIuPKdnr9jOQ4z25dzbG_w&oe=6AF884F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z7cyA8ExLcQ7kNvwFvbs9J&_nc_oc=AdrBT5pWb-qHcYhFkCyv7Syc7mY8zg7IBx2JRj70LBAnjrz0ezb-MnMIMUMOfU6lXsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeb0AJxBkQaYnh5pMrcLSjO2Sd7VBBfueKG0e-U52_CA&oe=6AF89CB0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp_WsNx-pFcQ7kNvwFFjzjM&_nc_oc=AdrA-eM-Hb1SGTGTXvMnmrwo7x5WwUEaSUv3ZR_ttmILxowW2CP6tU46tVPDyhlZDTU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQXIwoi019e1XXzooDsfvBmnomNaH-siaPxfSu3VJYAw&oe=6AF87B1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW6G3xK3xG8Q7kNvwHTMOKC&_nc_oc=AdokRVP_oDl98pcLjQcwFV6TyPtVcr2hlijWjYGVHEB5pkHrlHSb0fD2aiM8IYEj6Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHtj3wPXupDwALl1AFF7zuaB-MWqSeQMIynncl8QDSaQ&oe=6AF894B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-aZ5T9HVZEQ7kNvwHCVECf&_nc_oc=AdrZyaipgLFNXLgVBlU7_W_DUlI3ImMxE7cn9uy_VW0TmP_nvOg3HHktyZBvTxkbhkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1dU0Y5MqUOjZhrZf3aBcND8Uq0UdFukZMCMNQGztD5w&oe=6AF8A83B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GSUhqd53a4Q7kNvwHBzoop&_nc_oc=AdrMUacXDXs-72zyWvpHOFlNqoX9itDE3iWyyAcS1w3m8gE82csWZwN2uFpM1xrFlCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHaxg531FeTkmiemHK4oXYXQc9fB0TAPcrvyM6xDL2Og&oe=6AF88C73"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
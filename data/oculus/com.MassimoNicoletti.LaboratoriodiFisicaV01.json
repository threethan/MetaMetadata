jcfkgHvzUrMq40dtCquwuFQi8pI-6bV5H966immw&oe=6A1C5A74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf1s8Z-JJM0Q7kNvwGm3orW&_nc_oc=AdoIKs7yy9xenkwmM9p83pCt3LdCusTmoqJFXV3duFFPxOKtRpq82J6W0a7zvprhpq4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l8KtgFpV2jHe5vz321thZWz2QZWLeoBGRh-6equouPw&oe=6A1C39F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quthhxqrGw0Q7kNvwHMVH6s&_nc_oc=Adpa9CvyFJbR2mJ39Au7IVT2LoRpEj-gt01qRoAFVCiV1RFK8uGQsBq9tAx1VqRK4hY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af490Wp_7WlOXijpAe_qqEr4oMjXqqKGI1btEg_l7A3qGg&oe=6A1C509E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQA8UBSmVZEQ7kNvwFkVDP4&_nc_oc=AdpHAkjtOATal4hIwXazEY1qfPuP0VO30ZIM9X2nWjLvxjf0-IxJxWauGLRtSkvz0C0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44hk1VTeT2A-_IPzMXrVMDHxZ6lj1cYsYVz8IeCE1mCA&oe=6A1C31F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcrCNz630n0Q7kNvwGzoiPh&_nc_oc=AdphR4PHko71a6iiMxbWUOcyAQgPTZKcaXREnkN-eVNRhGlHWxEMTnHMrQGZ6ESi2m0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l7UPBKpsCN5DOs6g6XtIqXCunSp28jaS-spaCOVhPGA&oe=6A1C457B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od-PICEzxeEQ7kNvwGW4vxJ&_nc_oc=Adq-JSTDnfoiIdZNd37XS40PkXX3ygbGbw-OSYy__6CFI-v-VMitXxVMHVqIEln9jdc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54LGkYV3DgRvivsmyfVwfXx2H1ItA0Pi_amQMb5d3rKQ&oe=6A1C61F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
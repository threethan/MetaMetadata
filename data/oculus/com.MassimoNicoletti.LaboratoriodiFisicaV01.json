j-RYxDDQ_gsj14FjjghYH8fUXYqIXn-VZJ2-9f_Q&oe=6A298974"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LArRJ3YSASEQ7kNvwFzkg5O&_nc_oc=AdrdIB9tvjUbXy9_iKRof6umIVN8qa-6KqoN-HgC2nUtxOlLQQ6uqRAycGJMgWrxbZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qwjGSVJfTDLjqVFxeiGMisOOQCTUpR7ENiO25Gtc6GA&oe=6A2968F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGj4pBg2UqMQ7kNvwH6myJX&_nc_oc=Adou6JlMbcvxsKZTVshY8yRWemneHQR62tj-KzpfdAKjG3aEj_RHenI9Dojq7tFaIko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aY9SqdUc9k5gBdruM9QmGM3E3e2hOcBwG4EeRPfFEdA&oe=6A297F9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Sy2O2x3_AQ7kNvwE9zDDL&_nc_oc=AdrTN84z34iOZNifAAiaTgDLHm71C6O9w3E-hwp8iA2HrY9EpQVKNEm7j6qhbekMXA4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9reFwCq2wYa9q4wby16mExFrOzb3wz7mGL1xUsQr3ERg&oe=6A2960F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBpJhgle9HIQ7kNvwE6-_f_&_nc_oc=Adpom3PkxcnqrDkmA7VnBYF3woZw3HYjn2Fs3v7IhUcneZwINI2SJikXqkjK9dFjPCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B-s28kgJXx4_octVsruuAYDCgfTR3UT6RkO9Z-2FpJQ&oe=6A29747B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TovM7GLSyyMQ7kNvwG8ykki&_nc_oc=Adrh_RQZHAFbr1PCsDnVO_7Avb--mSCOwylPmzuMiAORU217qePsozWbBtdZFJu2vLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o09LNv6IqQcqlOKCwmsuO8xCYkDxfhsMB9dQrKd265Q&oe=6A2958B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
R3P7wtXgd7V5SZ_8zgi6KVvKam5bqKgZQ6dSTZ3g&oe=6A9C3BF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3_x3ZJzfvkQ7kNvwFIGeUP&_nc_oc=AdpyxQWzGmBsuUx2n4f2m00VAV5wQlPaiptjnKhMBn8r0qvA9PLopu2uAVhmSM4puEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8mb8NZGcGfTsLkAQy-chAsOwhB0OpKl2yOSU-ekejkw&oe=6A9C1B70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFs3JDewGqIQ7kNvwEIZMXF&_nc_oc=Ado_5n3jCmtbATfzavZH-VukVxi9KcpqwS01og-TnKGUhvxHd-9LE9NQeYPf4lMCRKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqkfjYB7xdo6-IJd0x6UvY7Cndoq17Cd0Rlg9wwodW_w&oe=6A9C321E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t2K7SnGZnoQ7kNvwEmTrcq&_nc_oc=Adqdud-CJeViJr-KY3J1oPmm53BcSJohn8W_vrkwi0DoieejMzd3BpCy4pLooVlFCUQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5yTJVNkjnQrTEdVYld_HCalkoIs7uYPL-MnO5OZIuSg&oe=6A9C1377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egxcbCFb0rMQ7kNvwGh5jZf&_nc_oc=AdpIT_CSn8jREkIkFzfkDpmpwAegflQMUfhwS4mDCz-SA2kKoPcMU0PAgiy58L8T6Hc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS4dJLDQ9GOoQzcr4lJZQUI3ck_XSGmY20WR80vFGeKQ&oe=6A9C26FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL5zpqGpNrgQ7kNvwFaeoUA&_nc_oc=AdqOEi09iaPp8UndcwG9u9TO-zCj24eE2iZaRB-QbCVbucvGDbwqWzXqMAWotHGrgwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCAO7UvZ_fI9wvfdOYpaATQBxFBN6iIlJZoIgItu5d-A&oe=6A9C4373"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
iwz0aPVQ7P3TC28BJ3-zzqTmrUnBrD-kxUMtfzvw&oe=6A8448B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ9wGcZifW0Q7kNvwHemlC_&_nc_oc=AdpxQhebu9Eq_XWs0S0N2CogOmZaS8kGIXw6xLghOHfWoYvchayJaGiC8t4liOPSkpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIHD01C0nwbK9ZgI_trmimko9WAcCaJ9sb_d8A4aZUAw&oe=6A846070"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeKvZeKmPlMQ7kNvwEXyG4M&_nc_oc=AdqBk1ds_j-td1kYuEjl1moP_J1zDKepUwhJVCr__a4RzmvR9AY9J92Cy74nr6SxyYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmmjUsysFUXMyl_dS1QwLYyezZwx7XJDrHwIzZP3BlTw&oe=6A843EDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py1-BtOkNxAQ7kNvwGrY-fV&_nc_oc=AdreyRFhMa0UzsFdbM9WaYhCtoWr73huLnbXgOGtH8gYz2VGNQcHxTjACvkX60v1Ap0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXcVE52V32TGePaqd7GbYoDB7uVmmvwBG8ILnkOJHg3Q&oe=6A845877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiJg4_H29Q4Q7kNvwH_3MlW&_nc_oc=Adp65wwyH0nVRaJcIX4DUVbCTsVQpmyZx7X1w6GCg0W9eodl8ukVfi-hPYi1gpYqxEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE4PeJMTazNhE-7BP3XHxJ7Bf4Q95CMY-0WF5V4tUloA&oe=6A8433BB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0aOaKa71ioQ7kNvwEw3ZBf&_nc_oc=AdpPNj5HaqrlX12ZZ77J8OmaWX7px6PfC9_X_Oi5YYwyg1h7BJDjb03RPE68zgzPcV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZl7cCTvSohDPj2vEDXrjbklK9zsKfRicx5Ipc5y-bA&oe=6A845033"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
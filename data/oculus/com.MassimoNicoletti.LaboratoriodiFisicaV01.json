ZFe3im35OfB8va7n-xCs1n2kqSWSPhfJeJy8pMdQ&oe=6A984774"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH-JteWi4esQ7kNvwEnQLze&_nc_oc=Ado-t1RYtJMvbOAMTUGimZLJ3hkO0uqDBXm0d5ie9g4wAFilCc3V_iXKF7pdRjmf354&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe7rdt2ZYUXeGtk7yTIFb9gVDqCKkPFSsZBJ5iNP3SnA&oe=6A985F30"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcrj13xXOrQQ7kNvwEuY0Tr&_nc_oc=AdrqyNnFeGjb3LfXh2M23QYgZPRcWiqbTHvyaZdyTAEDwJehGKoz5hDYtS-jiafrxHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0cDw9pifxsWcd5Dvlszg483HN1m8ofUE2WirSyF3qvw&oe=6A983D9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMTm2zvA-ekQ7kNvwHw7e-c&_nc_oc=Adqu7Dmc1efDNkrDmzpCtyS8iiylUNtYkG9UjxC1FKyFnR1Eni61cZdCaUqbROe41NI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXMkFJAR0C4w11A_YFDMDE-64byUasYBE_BlhHw_u20A&oe=6A985737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESHkq0yBC6EQ7kNvwEpnp6e&_nc_oc=Adr7YP4FSJyAuD1gZp-LmQj89q26G2hCLxDlo1I46mJOIuiQaEmMCCKxdihawzqCuR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4iHbdrlmz_3WToMIsumHxFQsHbGiLeUTNHj76Iwtq6Q&oe=6A986ABB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EL44_2rxdQQ7kNvwFHNDd-&_nc_oc=AdpBezpaEQMaMz_aT8O0shSEjCKQCpFbR7snVHe0Dfb7BS6daE1f0q2kxfVo92IL4QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkZuZyDJs-_5Fq6KgGMkIcr-9gFDPT9SI6PEXDO6tD_A&oe=6A984EF3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
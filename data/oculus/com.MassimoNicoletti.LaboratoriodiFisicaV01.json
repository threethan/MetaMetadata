VL3nrjSQ0qEfQt43ymJ-hwb47lo5AJ9JcyxamPgA&oe=6A4E3B34"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Djj2RNIpVYQ7kNvwGdQSLQ&_nc_oc=AdomQveVvvIkdKv-0_TJHbmpxy8Fomv2KsR9oqdC0k31I1ifFet00s_mnHe2DefqcrM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp5088tlc2xopCNQdQSvALCEvyYNMk05fn5u4ah3exQQ&oe=6A4E52F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aznMWYLGqsgQ7kNvwHihRu5&_nc_oc=AdostYIGD2YFCDznCxUrPzXNd8p5osR5crrKdJ0T2UffmuYKWBy5D625BE7CQTuQi4s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaC45-D8PPRgshrnUuQhCZGJrybObJTlp7A_50XVFg_Q&oe=6A4E699E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0sepsPF63sQ7kNvwFn6qPc&_nc_oc=AdrEz1EijmkUfkhCAlFO_uug1rpVdzU7dPNTEkLPAFt1OPfdtlzYfX1ILnfkxg3RL0w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArmiSIO3ZRHhtKEu9ZGQLlkS4e6LyB9fBgR0oMXVrLaA&oe=6A4E4AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3eEghe5tAgQ7kNvwFXB0UF&_nc_oc=AdpapeURx_5LJA0tAyrZWKlrJK8RRnIAFvpJun8_8OCQY0USDSEFFJz84UkRP-SMrb4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9hmgy3fzeDpNaGzbk_HpB7N5FS7j_-gsbRWNc4Ejitg&oe=6A4E5E7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YScRL_IiQYwQ7kNvwE0Z02F&_nc_oc=AdrlHHRQ3IpuvAGM7SiBZ_QHDevOpXRjzp8xXeWH3tufNLYjwJYbgY6Jx2T2TQyqPDA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZnkOjJxJWwocURseZBCBbey0hQPkwV2u7gGMYLQckxw&oe=6A4E42B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
ozF1HsEG19Jpyef8AnfAGo7B2Bx-YtZBa7eL-TtQ&oe=6AA2D374"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li3SLHUDp9IQ7kNvwGMobFH&_nc_oc=AdqjdrGInKxYadIJFDBK-sJX6afdW9zMDdxhYazweU6z_8RJXzqCLSCelH4yTRXnCBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGdVoGy9Guzm4qx4cDeUkRF_F_qvSMls3ZvgiuKu2TNg&oe=6AA2B2F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jki29twZ-8EQ7kNvwE9yu0B&_nc_oc=AdrUIYgQL4nk3alR44vLSQvc-20nJf1eRapmzf8igr7WcY2lH8s-ktlNaqdbyBu5RLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL67VqXE-IBpigSq9rEUz_YFTGIC1WvFT5qVpwF6vonPg&oe=6AA2C99E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNeer9X8_ZYQ7kNvwHvnzH3&_nc_oc=AdoapQgd_VfmR0EyTXIoDjpTOAJuIE197FPa5tG-r8Sl1WYN0IsKtOC_X7DQgGTTVpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBvMFUr_0F0Sh6Zz7eWITxLVgFx6TqvwxzX2nAwQ5odg&oe=6AA2AAF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adAdxTZiX4EQ7kNvwEWhwK1&_nc_oc=AdrIIGYxt4ekHNvdceTe7qmu4YfEDx92kNYpt0GRgsEP5E3DDpjQAoy6hx8XxFiTqkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8nt9EnG-wW8kUm4BudrMj3tACjnfiaZO29l1XTNZRPg&oe=6AA2BE7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjoCfMKjL98Q7kNvwGzZscG&_nc_oc=AdrhUy2v6iyNrHxkxDWFW_vJnTEJB04MoFmz2kXmIvtoFFZEXmugcXFJNQAm-DYjoaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_OkKBx2WwqzAS86Ia-BHdCGSYtuhLmDSiRglTqiKKhQ&oe=6AA2A2B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
=00_Af__BVskJJcNQvPqKyi0vFS7lIcVvIKwYpJvMdJMuscebQ&oe=6A468A74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxx-P8wkINkQ7kNvwGBam6x&_nc_oc=AdpHkQHCAstu528SIFtcOO61QwYiWnpI9zPiixxgEh8sMwyGHJS3H_4FiYJtgsRMWac&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5hzlbxJcKOJYaSQd4fU0KQXSS__8DCcyaaxUc3Y7uhw&oe=6A4669F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNsd1XKs0xQQ7kNvwHeY67j&_nc_oc=Ado4Aq_Pr8ruvH7p6C8MyddmeQH0bba9G2CIYRAnFXHm8QXHLedebjkLg9q1YfXyc_4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K4CriTndGteq_F9MUKkajvSzjfIdCFemc1RCS87bBqQ&oe=6A46809E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Kc5ej-C5zgQ7kNvwGYT72N&_nc_oc=AdoI5zAU4FZeoFV0FYxRa2cf385NNbr8eKRSMiw_CroXp1HXRRDdxgolJowh2B1we30&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MlmUFHXutbfnTd6lm0pkB_KwfbaUMqEPs10gpx0kYMQ&oe=6A4661F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFUbAtCtmvAQ7kNvwERixSw&_nc_oc=AdpFhEmK_x114p6EO1aAJika_iDFXVFjatLa4BYGOwN4J1YssOUXIFiawfNBwqVdx7Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-l1O47enRNoimfz8by25zEJR-8fC4JS69rz-xBBA6aoA&oe=6A46757B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_135Z3ihfnQQ7kNvwGzC8te&_nc_oc=AdpJ_9wuDHqReMVF1sWnJZa7JKXqqW_UHvhdkK12zEqIQUUypcyYOxx3vWZo7H_lF9M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LtB35TJm5drgVVCSGGvuLIZrKJzW1-WMiNqTWPnQFxg&oe=6A4691F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_L
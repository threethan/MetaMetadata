3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsuLYg4uObR2hyMnx--t7HLhHrmY_EmX1H_Vuclk1fVBQ&oe=699DA9F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEEGIfy63AAQ7kNvwHud2f7&_nc_oc=Adn9k7e7z5nutx5-nEX7iDIGPgnChwYBomDiP3Ogry7u_34B3BgAEZqAKdpiywYLbbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuj-Q-2MYTd1STD5zeStShCK1c4MIP4SmyG0QHSRlAtDA&oe=699D885E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb9bSXwDG80Q7kNvwFYwYUY&_nc_oc=AdkYWecSebYcuMDD2EVf5PLdXqqaYU5dVwipcK8-ZSqXLYUn0keQ96eq1R8Gj99oaBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftkRLtqMFdNHOjOSt80_Pjs2jfRopWLK_t6-ceooh0wGQ&oe=699DA1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huAcjqlpMUsQ7kNvwHTn_uZ&_nc_oc=AdmOKH6WlNZ3BJAltscBW80pNLwjczrCdDytLURW0F70dJHLkF32coT31bp4jMQA82M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuID16MyyZDeO8L1eN3-UA2iUp4nVVU5nyUgx5uowgVNA&oe=699DB57B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qWD5r6DVp4Q7kNvwFQBGJ5&_nc_oc=Adml3E1LC6U8a44dw8wRR2OtCqaZmjwmO5iIlyaDYGM3X4CHf1s_2dPe6Q9W0L1Hg0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucRnUxtcEF47rBhGVYn0QTDSqDT1tuoZ9Cs0MPUz52hg&oe=699D99B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DV8e7Fa_jEQ7kNvwEp6V_g&_nc_oc=Adl07UWov6rbeTez1docczx5z2RofOny8Kw4rx0mhVUfMk9Ifa6YGg6GholsUX8g86U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoAVluvv_3flQT13Fy8EeCqTnL_AsnU0lbvX281E564w&oe=699DA233"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
_sid=6e7a0a&_nc_ohc=xNsbK39kGAsQ7kNvwEwRXXZ&_nc_oc=AdoSpDoKirySk5uGdQNDrvLvaMM7Xg2ROdsAy7cJ54USlnzsz3AVLIFOJtIyT9uduw8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR4QzTD8O-ZByKsPu2xByH7kAAkCvKthMTtutWbx_kEQ&oe=6B01C85F"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZMyEL9fnAMQ7kNvwGvx2WT&_nc_oc=AdrddU5mqPICLaD2nAK4NHfO0eecO3GhPkiS8MXNUlQqPyMJ82kP6wgqjEIt7d7hOmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeQqPVGe8xM3isJc0llj1eQUEVtB5o1CFTkusJN7q5-g&oe=6B01E294"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjNrcyE9desQ7kNvwFmchdW&_nc_oc=AdojBe-1DwhXVvYNJ12CTIQDCB4Pv7q8_LZCaqQwFzKG6OIBMA3utLfhWnG5D-MLOVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdsuQo5qurMUcR22F6r-sHtjv3TOMtDZabNkKm_i_xbA&oe=6B01BC05"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXBOWgIDvvAQ7kNvwG5dxy2&_nc_oc=AdrSiYCcg-TSFsfzxlm12TL71UQwleF4T5vMyyWTanFlwz_l4_JL3XieVR1bzWYIe74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfoMevjSve0x7rJ5Hps6DkffTy9IclJc_ehEhQ_rIamw&oe=6B01E28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_q40BHMpfmUQ7kNvwErqazS&_nc_oc=AdoBq0cNU85K5hYjiF08QmV2qQVHmf_GEZvgk8zH5aqPAejsfoU0PK-0N2gKL6AZzGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQbm8EuMf94ZyYQSDNEF7-vQm0R2TUpwQ4pPOA7KBzaw&oe=6B01BE0E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
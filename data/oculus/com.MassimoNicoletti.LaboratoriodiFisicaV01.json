content-lhr6-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3AA3aI2GyYQ7kNvwFNkFV-&_nc_oc=Adr1BlLf1-rYpUrH-HJ6GpB-6cy3AW3_mN7j-7rbe_Fhh1XGGSAehmlgypcAGFJJsuo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VhQSYl3Q8faRp_bVtWur7htoFpBFe7h1cChll13_ZsA&oe=69E237F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1WtC2mFPhIQ7kNvwEQ_tQ8&_nc_oc=AdrlWIG-g-MzTv-kECUHyxTmyX-A3ctildFOR2eMkW5ApD4QI3_O9WXMguuV0M1Ru-I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2flx5Br2q_GRJPtfKR6vsv7TaXh5NBHdoW1LZmcYf1uw&oe=69E24E9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l09r9sh_0AgQ7kNvwHaqGtY&_nc_oc=AdoNWqaKfguLHvfcgUV-LSE2cBC2p24td1FPyn9I30fjloM3HVlv_z5Mm6E_XE-c6b4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VNdw931Z0vSy0BbnPrb-x7vXw7UElrJMGrXpv-yoQkQ&oe=69E22FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crQmTc-6xGgQ7kNvwGIA8AI&_nc_oc=AdoLIcqO67r3kxndzkYFcS_Mm4krr_Ai0YHYqDhaSDGqIjB18RSwLoGnfPiYXYvQrAY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mGeA_LcPbFMVU_rqt0GzWtheDz24JcONjao8fOox01g&oe=69E2437B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8JnGTgVbFgQ7kNvwGXMu75&_nc_oc=AdrxX02QbAleJ9C0eesAHcFeeLPYBUDTz3Auingw3rq7UvWt8ZTKbaEnMCkZQGJ2emE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1unDM1UZevufO4N5m2fyXu3txkB1vweQl-lsO0ps_X_Q&oe=69E227B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
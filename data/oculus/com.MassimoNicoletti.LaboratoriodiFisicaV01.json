3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuH1ZR_YxskNFFe2viARwS84W9yWlElRlFLlPLZ8UCDaA&oe=699B06F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEEGIfy63AAQ7kNvwFHvYcQ&_nc_oc=AdmDbCPVCj_woXUAVDF4_Dqx9NiJUErXVaA2t8vFuQvVXp7eJzwuFZm-vZi4JP_UR3A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft9uMV3iSSAD7RgLgrB1JYLOdL_pzIQx8gUJRVhXfim6A&oe=699AE55E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18kJfa54_14Q7kNvwEOd6He&_nc_oc=Adk-_U3ISGkPOELoKlnS4eq6lhXs8mGKl2ozhAdH5aJTmtCsgZHxo23Ao3g3fH4Sy9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuT0rHB-nF5GjfZXl4zhIMydXBx9MLPRWU8FbTLgaBENQ&oe=699AFEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfQ1CNO_OsQ7kNvwESjWX_&_nc_oc=AdkqK66uFT4Di7S2w91HHQ1v5_Sv4pkhvuOuIFinmRcMeSSrvxIBl-W8i3ZQxIVcDVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftViMH-yfZ1EqmJLhot2fjQnjYREYNqr6xypb0B2lZwJQ&oe=699B127B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qWD5r6DVp4Q7kNvwFKyzY-&_nc_oc=AdlX-krMIA47sAOuIJQIuVNhH7A9-LLX3eTnTHH8wQBIDgoaJAZpDXJNbZJDPuDq8q0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuMPeF_ri4SEgMW_ROiZ7xBL4KRFL7KbXAIHemsjn-7NA&oe=699AF6B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq-D9BBVnIMQ7kNvwHiUVEr&_nc_oc=AdlcjJgYup5bkeP8Fn79yMpbhzmIPvj7ctkp-cZcrFCciCdDTZp6SohyvAPNaRM795c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9ULgcvhrfuzptiVsS2oVYyoXgy_-IUCKXUvcRPMIX6A&oe=699AFF33"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
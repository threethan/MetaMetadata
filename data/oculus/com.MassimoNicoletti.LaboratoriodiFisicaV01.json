content-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPfclquHuXQQ7kNvwEtFNEy&_nc_oc=Adq7CJDvfYXmXfknud6DtKp8FjxV9eoNbAy7TPFAA35ky293DT6SA4nuraxsog109bQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKZdQRXgaHE41O4d6aBJrt5yoJG4TOOozr3MbxTPg-WA&oe=69C293F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGTdM-9gqdMQ7kNvwEJMyh1&_nc_oc=Adp-ztmaBsdCcabNR54vr3xP_H5aVj47TgKnXBXC666baegfXgHxcbo38UtMVEsmIHw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_85sI2cNj-Wq88NIrHn7vXeJo4tXAWW2vC7PzjfCffw&oe=69C2725E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frxpKeb4x00Q7kNvwEFRqJH&_nc_oc=Adrsv9kdCJfg1REUCcUKBiEB4IEBPSW2A3-_8D7xZW0pkB13wBgNq5ziK_ypqD2HGik&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycTPfReY5LNUUtzNODAZe25oCX5BNI0GAXnikoZnPzRA&oe=69C28BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6cFKtBAsEQQ7kNvwEWSeQ5&_nc_oc=AdqKJQ5xlcVtuKNqNiC5QgyEVcHSSokJHbXeOE_d7wbrVoYgllPHzmitZ2GotUSvWSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQ24_SMuDso_R5PLdyjwBAzXLsPMhkFjtSSLFjMVZypg&oe=69C29F7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ExcG0JoA_4Q7kNvwE4a3xH&_nc_oc=AdrmBc4ur3N_ypjH5v5CzxzVn25mnHWSwd9E7UKhlmfz6pt2ecdfO7iffBfNxSrpF6Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0G3C9V4lORxbt1n2k-52CDWJKUHVHgWXjce8guVgN5A&oe=69C283B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
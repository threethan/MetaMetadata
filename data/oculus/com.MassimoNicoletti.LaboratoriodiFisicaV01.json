6MLQGbtppFTgUFahL65hz2E-i37KK-OVJ0W6D8Xg&oe=6A6C8DB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXNrxo0zCfIQ7kNvwEogRBh&_nc_oc=AdoGCmLRT3ZditYSc0ZokgG_xJTcrpjrmq1fVYl_BdP4jvoEztIJI7B-oUVkpIIWS3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAafc1tClm2W8JjGKtTPKaiAqQj7hjPxym2b90lvlhhFw&oe=6A6CA570"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onF4MhfwKRsQ7kNvwHZZs0k&_nc_oc=Adpn4AkTdOthbz-kFivr75Iv3rCNN33DWzx2bZoeY59OiKRkwsw5s2rKWhhtSph-p7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC47pEOCIvyCzJpj9DYkBJ4DN-YXnUMHZiq6XZcx85i4g&oe=6A6CBC1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjTcazTN77gQ7kNvwF6Eglo&_nc_oc=AdpmR4DIcaVVqIhxwSrw19blAFgQPGifoGwqZ9RpFSVzPPn0PRlDELW_kqW4LPVm0Gg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgod3fMxjuBGNo1ntQlRZTb7nJySTTSMorVfh5EJ08WQ&oe=6A6C9D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qigrUapNcaQQ7kNvwE2E8ic&_nc_oc=AdrqJyJ2VTcaxbB7fL8BJS7aVcV12EVSCovSmq9uhN9wfRWtG_uxhcm1gySSDO6I5ZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrta1dtY0fvlOjGi7i1D356u6cLa0wDE324WwBfTlrWA&oe=6A6CB0FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51VIV0JmyzcQ7kNvwEz6OdT&_nc_oc=Adp1WqGj1ObbGcDKWPiTc-s8djRG3rPsEFKGwmGFC4-ejxfle8luzLiHSweVRwSUxLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYJk6z4LCTs0oJO-UpxEc4rmfaqGI_GrxQRlzCxGAoYA&oe=6A6C9533"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
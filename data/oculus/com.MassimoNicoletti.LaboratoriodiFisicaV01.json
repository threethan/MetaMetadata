t4FsU6f62dIrlV6jnFTmY3uqaQWh48Zed-_cvyig&oe=6AB7EB74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg7ylVzRKOQQ7kNvwEcUWfA&_nc_oc=AdrKwMjI4W6DO2xpFlL9nQPXRV8N6MTcSXGp_jDEX1sdFDioWeDJBUyTTXEqMCgce-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz1kOVRPYnUNS3Jt_fKyTPudqt8cxHQhlLG3zFPLGcSA&oe=6AB7CAF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EshsEaBRdcQ7kNvwHz8cAb&_nc_oc=AdrKVPRFtxgEStWOvGwCH38RBYIkqORXkC2b__gJgYMFBDKuRcU3JEdECCtUjF6wqwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYhpkJA-AQzDUMDw_MmPQMArcLPCUw9M0WtKlAfo_O_w&oe=6AB7E19E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU4IKTQj_wkQ7kNvwEhmTm_&_nc_oc=Adpy4gcq-KccKtDZdXQ1JI8w6jn_Rr3pfQa_3NtA3BDU_oVJyP4rfbMurAJexKLS19o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI705cxO41MdgmnYB8AI6Zhl4X9LgjY2NLCGOdzLH2B-w&oe=6AB7C2F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGaxgfovPlcQ7kNvwFirTbX&_nc_oc=AdpDP-36e3GBZaTXQKP6hSh7a1RVdHpLK9-ryb9tJQ3o8CC39k-HIp3zMZHkbxC4tV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE_STh9eMm3Le-XmGuDh0I81fty-xRhRlcZfAN-mf97A&oe=6AB7D67B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfVUmtoP_aAQ7kNvwGtnUl5&_nc_oc=AdqN3cGBfq08Fb45gjvLsb5eu6CFC8k82dykZx2xnLNX324abmrTXiGjkUXZhzWMV0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk91MNymzR0NrInhNZvJkDzMe3-xP1Xzo-CI-wjAEznA&oe=6AB7BAB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
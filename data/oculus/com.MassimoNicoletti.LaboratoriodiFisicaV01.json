771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgL6dpqsFdIQ7kNvwG_O8vl&_nc_oc=AdkpBJiUvO4oo7uAi3tINebNErp3M5kBSPwphXVNZk_T5e9IlIgmd5u0b_PTIwXKVj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxkdH3HS797qpu8nbMER7Jb9rvb8jMAtImci893TtgjqA&oe=69AC2A70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sISOZ2tcMfQQ7kNvwEUz5sa&_nc_oc=AdnCS8KfSGfCI8BIeQbQxeeo4jmOXptnxXaT1v__apUtzGarEfO-zzFiXWt3zosCfu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyir2_gX1erO7wpLke51Q2haxYdKLTzJqy2JeTitUkY1g&oe=69AC08DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJcxhXB4o4kQ7kNvwHT9nFo&_nc_oc=Adm6_WRPN_Qnz27byJQdBYzkU0pX_E3r58jhANvErijSRPgLMxMl7aVnneIGjUiBDxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwrrr_cGczGEBLc7gSVYXDlwGOzfKhGTHdxoGQTFD5cWQ&oe=69AC2277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhVYGmpl7kYQ7kNvwFPu88M&_nc_oc=Adl-fgwXXRFsewM2TGU0hCLvDAVr8L30WYrBvupkBYmfBsz2vQrD4HuOibRsWg8SDio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGmSzC9Ti39ALHm5jhpLZY2VdtzDLR3yH7zuaEkiIYAQ&oe=69AC35FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcDfcdy_-0cQ7kNvwGQgiMk&_nc_oc=AdlttF6_aBovBLvkwgRyIsnn6tKUUYJP-mnzJS9YhZSdmgF0ZiN1zcyqKA9o1I3eSbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzGDq2K7wgf3klapcD4eys7ec0H48NguQjsnO3HwNRsMQ&oe=69AC1A33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D30PfP9cloUQ7kNvwEbuR8u&_nc_oc=Ad
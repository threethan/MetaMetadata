771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byOfXRP30egQ7kNvwFerk19&_nc_oc=AdkjWt87ikb0c5jztex6hvfWUOo9eCp7SygzVP43yvNB-5QaFuPtQB5HykCX8wlq33s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4zNiSqFlNraMOGlS9NTjtQxJYo2mRIwqjENXmc3k30Q&oe=69B564F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLJs5Ut3Bq8Q7kNvwGEoPHX&_nc_oc=AdnXaOLHSJBixoM1mP6SGknu8p4m7HLI3PWRBVVpzupU-yq3atmlTrCmx8IfwYLetCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTXEf0SOESc8xxvloBctCLV8atvHCvJ4Zg24zjybvKBg&oe=69B5435E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkE04wVOCLkQ7kNvwFgM-iF&_nc_oc=AdliMfdfITxzv2R301M-N5odA76xQ2uLVKx1FqjFqtEmimzdhyuQZlEMT2pQh_x7G5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrD2eZ2od8qMrgTGITlcfTHPdHZsWntHp1J_aBb9Oq6w&oe=69B55CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2FriG0_ggUQ7kNvwGgMdWA&_nc_oc=Adm8WtnA8h5yueXwM02f-zTygMHSs82qhIOf7LnnvfnonbN33h8y-GBIWC6DQWdQiAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpS4gooqA2T0i8Ql_KRZBvXbIzA6dTtiXfyDRUQpya2g&oe=69B5707B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wJAQAUmaOoQ7kNvwEdHt4Q&_nc_oc=Admkkfvd1gytkR_MNt7fUKCByeLmqI9uJO83ppGUOd7_FG6WKg2sGPK3pbtcdi5VKH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmLd-um5N-0jwuDuaBkP_P7ICE8tAVhcPEiIhy_6Y7Gw&oe=69B554B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_L5pbekrnYEQ7kNvwEjHkw5&_nc_oc=Ad
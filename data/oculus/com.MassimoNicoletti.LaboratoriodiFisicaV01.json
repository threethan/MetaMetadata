9lSxSNC6YlR4bE0pZfgW7173dhQneXzej0MGcUEw&oe=6A3EA174"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyYjNXj9h28Q7kNvwFykizw&_nc_oc=Adr5zjXfZNXyM2LkqSU0mn9ZRdqXQGtqffdDhCquUvoIvOAT5exegG_57Kk9ZBSllZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C6oZ3CT7BpwQ9eHuWCYBGpd0i8SOwncXREGEQ2fs-dQ&oe=6A3E80F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ_UnJQcvfIQ7kNvwEElHz0&_nc_oc=Adrv4LNV8iKqoZy4Pnwc3kKuI9hLHsgCA3Hk938k3--QywJ6SMXb74z6MBENHDoyK8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83xMUeRbzwXneOMA1OzB23-2Uiqpr3o5iYSWYgSnmnwA&oe=6A3E979E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8B20KdvZBYQ7kNvwHb9MD8&_nc_oc=AdrwgKgfWpSTFlUIsiFIC2VWs2EO7ek_e9E8lXgsA2e-mT61nD3SLreM4qVxeQGeEO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AfD-BhwPzRmobu2YNmNSKEXOPt_XF6_Dnk7oJv6dJEg&oe=6A3E78F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnM4uRIJfCcQ7kNvwFRqiF7&_nc_oc=Adpe6FvfVZOzGXlHInpIH1pZYjYQt-C_lFUKhGiVXg9xhkIhfiRc-4h__HUuECC6IcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jE6no-8IaDg0BWMQZrp65JVeUFCegQ2TeRrfcKvmX8g&oe=6A3E8C7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttjBFIr0iX4Q7kNvwF5Oasv&_nc_oc=AdrX2fXnPq4AEcmXLiH5oSeEJCYIRcLp6VyRoBv2bZ-VPEVOFRnfgTW8sZPfjSmPlAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FrPatdVGS1L-MqZ3lEFUawncAWVz3oHCBZsRP2C1zWA&oe=6A3EA8F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
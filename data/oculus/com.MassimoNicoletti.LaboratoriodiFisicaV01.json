4sGLPT2HeyHN39skCGDeFZiRbJZtyOxNP_RxWfcg&oe=6AE0C9F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP3o2aB8fWcQ7kNvwE6kFqJ&_nc_oc=AdqaiFMWaKxv43NT3OeQ6t8AlQdUD-amQNF2OBrkJ0HPoRj0G2DsrUyaw-S3MJL1eMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Lga4EgyL-dNzWHfP0RRCbsR1Yjp5jEugiv4fPsJm5A&oe=6AE0A970"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JIqprrKQlUQ7kNvwHe8Zri&_nc_oc=AdperGI7_ig8BiM96_jZGJghZlrhh_B6Fp2LE-vaJX2HJyAVuTc0zz1qopl5fYekHpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzYCX0_TnHrvVekGQSdMfVbv966LE6PuBVvvG-dSdRjQ&oe=6AE0C01E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8YpXadk2ZoQ7kNvwH7Z5WA&_nc_oc=AdrN57COmvH0TSQv4Ao0WFu2g8RyeWtGlLG-waJhBKHHPkLIpuHU0FYqrXin6bQ3Jek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyLvu7R8HqGqGE_y3_lY2qysHaCCG2GMoBQouEAssSMQ&oe=6AE0A177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqD9ILofkikQ7kNvwG3osf1&_nc_oc=AdrdzLd3mXW_oKlaTO0j4m4vleYWRkkBJmjBfcz972X0iaRfZnEDDctweJSDxcSVjpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBf6Eew5vbX8MRAHXScc7vUTLXlYvDB1vlcxdn613aXg&oe=6AE0B4FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFY5Tnn-ooQQ7kNvwHG6KNP&_nc_oc=AdoMZJ6zal1xlbpr_fo4wQ98q7kCWQyjsmwoAytw1Ca2e3geVL2RhpM-PtGqYBsTh_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQL7keP4egibbc6LxRQcPfdQcwGr27QeiIHRhjZnFEkA&oe=6AE09933"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
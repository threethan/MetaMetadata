_sid=6e7a0a&_nc_ohc=r8DSsDrzfAoQ7kNvwEHIPqE&_nc_oc=AdoTL9BPZrQfBw-RQYcYnGqfIIyGNHRRKysrzt9I9CZvNTjzPyRaePtR5f2CMnKLKAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEuvtX875YWMRtdhzjGTV8BUTBmsLbjjIny6BgeHxq2w&oe=6B046B5F"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILwvOpG4nSQQ7kNvwG_kwWt&_nc_oc=AdqHgckItd_HehpIaLTRey_BhBSb7k9z2uiwBu5SjmX6oFHhz79PeSrLi27u6mup4J8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1N8WCr2HQF5ni5m-cBMC0ZIp9Eo0W8-e2V91LAjOBuA&oe=6B048594"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfQlnE4nYmgQ7kNvwH6TDDu&_nc_oc=Adq6LjeG9lUPCZL7SKD7qIV-qO60TB2srVLgmu7LYBx5H-sePklM91VkreJbB464p0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfFq7vSpTzVShhkAYeu2Xi2LQSKnA7RIW7_rqFaSgl8Q&oe=6B045F05"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VtdoJe8_voQ7kNvwF5nO4B&_nc_oc=Adp2GZ70Ikb3Oe50sTB1qwGZsjVYbYC_Z0u2eW2u6khmVHeqj1xEo_zPpMg0xW2t0wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTqwqO5SoC-K4X08gevP8SWf8gKe55j5Gb2wtZ6P7J7g&oe=6B04858B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCc202m36OAQ7kNvwE_-vEV&_nc_oc=AdrAtFVj54bb2ecNbLyJgwbWbU458NqK6bEY01yoXaw7uIKfEUoWAvm_odpRBHRf2TU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTXL_2OeNBj0S3zEGZcl4LUWkiS0fE3hJGSFB6zmoffA&oe=6B04610E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
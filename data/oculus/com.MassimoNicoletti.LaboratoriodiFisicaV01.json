3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aftd45h2LJwpSUUFJ78zMTC5MF3-NrYznOSOVwMkLY56QQ&oe=69A19E70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cudpO7BnzDgQ7kNvwGBvXzn&_nc_oc=AdmQjmNCvm0UvMVY04sI6M5Iqk4CKEQkdGX6mKlTK8EF0GR_8-FltxS_ALDY-PRsLNQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfshcHdnL7ItKHdA4JpB3Z0iqvewimTtosL6DAFGlMXmKQ&oe=69A17CDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5QvYOMS90wQ7kNvwG0ICwI&_nc_oc=Admqu3c96q94Vqadv6JWnJmTgo3u-uryyFiEMGLFvCPwCzNDUKOPOD9OlJsDw465CpU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvT2D19qr7df4VWW04Uyb9kwe752Xkqucf_PMBMELN08A&oe=69A19677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL8XhnIJmCsQ7kNvwHT_E4h&_nc_oc=AdkD6RkZ2KcZ_fNWmA09qISlLg_x4haLIQhhO7Fdf3yb-WhIPOdTD8KJ-q8-qsGEWI4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv05kbim5dZNgZDQldb87vsUO4Gs00JAz7WzudNB01DAQ&oe=69A1A9FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXWRldmogbUQ7kNvwFui1fD&_nc_oc=Adm1XG8phTBuiH3FgCDBrLbUY07y8Cc0mc_nfRfARjiTZPnjLChGo8DjIhv80iiJTRc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsL2qn-zTnWpGu93Nw7DyNy1zgWS91QvnZnYV_KrbXKaw&oe=69A18E33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVx4O2XjIwoQ7kNvwGXXIwQ&_nc_oc=Adl3u7swbHhvnId0GAgqDyCr5giPlqjyADYNUuKAe2PmYLhzJgnsJtXNvswS_YZzxC0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft2n73opfWi1spug8Cg0sJVBa8NghGpUQpei139X7YxMg&oe=69A196B3"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
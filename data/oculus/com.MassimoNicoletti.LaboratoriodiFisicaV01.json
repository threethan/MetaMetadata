sauSbQpxSY4_sDkq6l4qnvQ7YnwTan2y8w2PN8nQ&oe=6AC27774"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9BCDomhC2oQ7kNvwFyi1Sg&_nc_oc=AdpYAl-3jH4cd6hSz06jXwaCD9gJLpTkiw3XNbjUQECe99ZJOmS-YyAb5PFSrISWIns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIgS5kf6ZUqbNbTCLXq4E_VP7UC2O5EFvzXGCCNkxFYQ&oe=6AC256F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKJ3WuE6cWMQ7kNvwF0ZBAT&_nc_oc=Ado0IGpu8GFm4cLitFvYWrMj0KoxUiI-fdM6MUlkn2hrdcyteCqQFqLSuuQ_IrK1aco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvtYznp4pZWabSA4UDI8lUiQl08wV9X19c_4VGcJvP-g&oe=6AC26D9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGwHKsh-sDoQ7kNvwG1djD3&_nc_oc=Adr48C_Yltnd_brbMNUJkQ32d0FwiJ3tNJal6HPXuMaw3-EtlYprZhg2OOQVAQQeGLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNJjKT7Hf-99aSITw6QRYCGmTsP0USEGn_cNUvmgBnzQ&oe=6AC24EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SJvD6thTb8Q7kNvwFDsSXs&_nc_oc=Adrt0w91MXLVK-PG9uknOljUZHOKg9vIIcXGGeiRq8ChgNHsmYgCeV6iH3Ycl9UQ1wE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEgDP-_B4PTHQ6Ycipn21IJ7m--6SCpUVX2jrhCsJ54A&oe=6AC2627B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ral3ahghrnkQ7kNvwEMHH-R&_nc_oc=AdrV1KfosN7R9BYosGUM-NShZnExjvr3OYw9FyrlboKSqLpYToCNO5reHZhhy-2-prY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpTVnMWxjyve5QBZ43z3hKjrpJqbthUsIkcQnfGbY9sA&oe=6AC27EF3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
_sid=6e7a0a&_nc_ohc=O_ahpj2qta4Q7kNvwETsgue&_nc_oc=AdpyX5kaqA9N0Was5JZhRT7thV9CZeLT6QwFqpC9ekgZ9FBs85pZWWZ2KsxFua6Gobs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv9b6OiwL0eNyGfKaPtr-IAYs9zVNKhMofI7RqeLLFmQ&oe=6B085FDF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkAMiJSiiU4Q7kNvwFR7S2Z&_nc_oc=Adr3p_nDmVCehZZt7zq2oUptgJs9zB_mRY0oSd765KhFS3Bk36O84IQ_35yAf50sNpI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6Iz4GatiLDAuEvsDDcZtw0cN0JH3zxD-r5b_0TfHwow&oe=6B0841D4"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF22dUkBSsAQ7kNvwHbLYam&_nc_oc=AdruwH-ncPSklPM85Y-omOVrrg6mAJNpB01sfaB8Py_FFa6z4nV6OAlWilaualxjeBQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvgDCVaz513QLsVq4QgGNk8RSdET4VuJah5NYqIXvr_Q&oe=6B085385"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0qE22WiCWkQ7kNvwFV4wTT&_nc_oc=AdoHm1GjJhqnRRBryO7c2sD_Qoldz-d72m9Jal38JTf0y45m-kvH_-qvXUmEsBSr2YI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ5MCBAujQl6jkS_bi7GX1Dng_hDYu6AjO3chfgksMXw&oe=6B0841CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fYUWql-X50Q7kNvwGxVBTY&_nc_oc=AdqWf52FPnIygm7wGSIaM38tlOEDNqDSjcuCWIdXq6Y5XtWe1U1t2aZqMW8_5BZKcoM&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_eQBGEVmSz4P64PqxaUVBRmcXjCQHgCOmkv0Cj3iLEA&oe=6B08558E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
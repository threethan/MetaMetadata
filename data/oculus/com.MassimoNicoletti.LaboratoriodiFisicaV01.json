XwCtznFYTHNh0Mi-JhkNknvgnEo0m8VLAjt2Y0zg&oe=6A5775B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbpy9nbjoPYQ7kNvwG5pnov&_nc_oc=AdptJFtcQpQ9eRwp9rl9uvJ2rFziWcHJ1kgTq173al3n0cbe-rFn_qAXknPPtTZwi3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCfg3CcutaAJh0UEL9n63Ea_M95aaF6MYq95L4ETkpbA&oe=6A578D70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvQpJ-SgMq0Q7kNvwFt4KJQ&_nc_oc=Adr8DwYoVyUoip7edwVt6GZ_kcF5bpH_UO-gGiNusyypLQM944BWc5FAihJb0wdNdSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAffUvgKQ9N7dsgVHJriDYygi05Ya6i5d7z9eU1u5x3TA&oe=6A576BDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Izfnsp3wPOwQ7kNvwE85Aba&_nc_oc=Adrr9r_j1ib6yHuv3I05Oq1Dob9JLHB2oGUh6YjdhBaPiZai6AzHkQnpI9bx1IGqAPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvXlZ6O8Q8GXHQg9ch44R10hXa5UpzHEleG7K0APXxpA&oe=6A578577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQX_pqFlDRkQ7kNvwFBLRdj&_nc_oc=AdoFQ3bt6xRN2wVSkb2ki7FwBaTk6oyq_nXwEVXgJSviWJW31Xp2xrJU_4yOCCNVldk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1deIEbHk_J9w38GW4yjFVdwxaOVF4jO1mY2t1LR3Isw&oe=6A5798FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUSHXVirDvYQ7kNvwGSzsBW&_nc_oc=Adp3hnAqiHjeZ-Pvx3DV9CXl5WC3NMVLs_5xRiMvvnwOrWZM4ol2794yMs53A6rvZD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ5ns6UWaXVp4x_wlU6Oefq9a-UQDl8eFdvBv_7sr0Ng&oe=6A577D33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
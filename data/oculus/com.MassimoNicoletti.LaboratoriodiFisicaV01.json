kYWmiBdR23ZI6JkrWZs5p0BIiAvuxjDftd7jTLEA&oe=6A1DABF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf1s8Z-JJM0Q7kNvwHIbuoR&_nc_oc=Adph6n0vfsCoP5u5SIJM0T24Scy1WsGv-3g-Zk3hhhBNRll9VclPxSUuq9QI4MIf8Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jnjRBFXAtuv3unE6zoZPSKcDY8p0naNZ2hgq9T78q8w&oe=6A1D8B70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9LOQyMpfosQ7kNvwGdiN_5&_nc_oc=Adr-jTOLMpK5IDRHEem_GlhaGaJmoaDN4kYPiwPBh4oQZdcR0cVG4PDDbtqa4Gz0ZGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oqmx6EmhkVCP42r5XMgPrldv2ikBi_rFEQulo6kHaEw&oe=6A1DA21E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQA8UBSmVZEQ7kNvwHEVj5h&_nc_oc=Adru5Kv0CFyR4zNGow3w-56f0FJ_Ug-bbMzQHwNoZF6ArWwPCJn3V-BYLMV5p_uBJ_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tvQP0dY4Ik7UqTCIvrr6LBbxIyz5YKpHCLhWVnl6B7w&oe=6A1D8377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcrCNz630n0Q7kNvwFIZwBZ&_nc_oc=Ado5q54xyxJmPx-BkXg14h6NCk_-pi4guYUR7Z57fEmiXKwqHrbhVXf5sBUkyqXVca0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7076EEZJCrUPBpYD69-2PLpic4NCmSoE3ezoks-4LN8w&oe=6A1D96FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0896FWHDUcQ7kNvwESkHlJ&_nc_oc=AdoOsFqz8x2vXuSMZXwJJR7ofuSCFl7j6YJ1Ute8ZnOOa_6JmdWEnizU7cuhFz2uyaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ag1Szcv9QAw8-p98ZhDx6g8fcLjuLcmgct7TOpBt6bA&oe=6A1D7B33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
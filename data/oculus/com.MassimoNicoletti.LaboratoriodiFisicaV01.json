834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFbKL9THDO0Q7kNvwGCDxlr&_nc_oc=AdoqXIpK9tkv_5PeZl4V-lPH9QskE3K3yGKvIrRAEQFLpS8-O9Ia6IgflsYaKX7jgnA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3JNboIkVgCK7-y1mB2MjQRXytZfBMBjevxwMuxyGvNxA&oe=69F209F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NtX20osl_oQ7kNvwFqxdts&_nc_oc=Adq1XPYqs19SYTaOJXzJFwJKKolwvLgqEnT5oWePqKc-sttYuVdvlgPfDwSs91bV1zU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0orEITYLaSwzxbp6-9ehBaJgn7GzmqK-g043CluNZ3PA&oe=69F1E85E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-E2zo-ZFHOUQ7kNvwFQidLZ&_nc_oc=AdrNQAF0miW4f8H-MNZ8Xfzm4yCDxdGP7voGiApmQITjXzvsCMr0jWEzNQI3CiEuywQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2cII42UCgc9RV8akA9P-MiO0g9n3PEUZ9pC5DP5pa1MA&oe=69F201F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0dU7IYYFAAQ7kNvwGIv1FB&_nc_oc=Adrky1ZRlomMByVuzjlz1rND7DyCk-EFWGH5b1Cj5fIloTh1-muWTKaGXBOiFCsxKoU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0mn6M-g7C3ew1GvwFK0gp-P3CHXG_r5D6rmop7jy0nkA&oe=69F2157B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsVkWW9hN2EQ7kNvwH6GHsx&_nc_oc=AdpIryhJdJSyeZYGj3RU5VQPOhyeCRsZ4OgXDmxLSvE2TJP3G58NyMsd_F2MxnMY16o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IQWMNTTbuxnxBjjLojkCef9dX-vqN0mVMHVhYX_jVuw&oe=69F1F9B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fa-9W0oZ3XsQ7kNvwHq86p5&_nc_oc=AdqSgcnmU_KtHSSWSOdeE5nXOKJAl26BqC99bNmM8d1EHsDhCv
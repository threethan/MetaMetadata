content-fra3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQKv3ySoaEQQ7kNvwHG_H5e&_nc_oc=AdpYJvjeAHVA9tghnk_qI8gEwcHdquC4_iWBxJ2L1kZtbmTHgJ4iUnbniA_c2i70z3c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cPaipRM5DLwKGg41lKpTWdp5aU3G8j2ZjkG68ksMzLw&oe=69F5FE70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4xdiSSdsFMQ7kNvwGLtJUc&_nc_oc=Adr0cDLZby0E8J1xHp6qK-VB8ElgNvf3nRZ_-inqkG9aABKfuE20jpwsFUqosWYMFWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af39-Eweqehk_QPfGZ6Z-83n22hWZHhcz3ZJov2Q86PtuA&oe=69F6151E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5g21z6XYGYQ7kNvwFVM3dy&_nc_oc=AdpzgrXZeBFdf4ILyeLMWz3MOAX1cfbPYysjcmxbnFPo3WuFARyozU189w3qzLOlhug&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p43zBQ4goQLVLTACU7yrs9lEvSNdg9Vu0W0CAjVVJBg&oe=69F5F677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gqsfKFZidQQ7kNvwE4jz34&_nc_oc=AdpX3IVxbsY0AaxFfNUzSVHjxiAZXM3u9b1rLHqvqdBX_XJKv5AvHQdouYmqsrBf7jE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ivpEDSmN9BGqHAi7UgF7_R_Rjd8iGwUIdrGYsjNEADA&oe=69F609FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEqLieJO4A4Q7kNvwHfjhUe&_nc_oc=AdqaCvgejhVZ5BYhwUgiv4BUiJsh87CDRMCtSN1981fphXIl1Ewq-a1t2NwSTuyKN-Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oohv7ggZPeXghpcpR-Havheu_MX7ZxmsvsstiGZ4f2g&oe=69F5EE33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
mYOzpFFYjCCyvByqvuvR4xsF-J0fkyIT0aZeV9yw&oe=6A317274"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqMm3N7lDSIQ7kNvwEWf67u&_nc_oc=AdozhJjP48_EPiYi_TzKauG8o9fO-24_UKpSmsR1SSa3IjBFgfKIwODQKqrQOP3dPyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tihiYvLk9JDk_KFpQ99-kZ36Kltv_WWTt6MFax0sGsQ&oe=6A3151F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KjqLZZG1yEQ7kNvwEV5D14&_nc_oc=AdrDrNXHplzM2o1YWXsJ1lPraOtBjad7-ZibMeYp9hEZewzuGqo-us7hLgHOlcp9JJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZiBgbhK-6FGLk9ASX_bGc_jfKgq6un5BSho2SPATWVw&oe=6A31689E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoY6sopy0PQQ7kNvwGFgcTQ&_nc_oc=AdoRjPzgmjffmzD05Oe1j1G4tY9EIuYijSwgxaP3EkAmofBT2YxNnHTcO00RVfWafaM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eW4CO0-bxxLLT3yLtxs85rmbHBzvbGah1B9U2j8XU0A&oe=6A3149F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bguamyKuFdIQ7kNvwEUQ3az&_nc_oc=AdpUB32JSaVM7wnAR17teXQEkVA_LnM7vW6kiRcwozOujr_2uDypmh0ygaq0EsCJYWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ap9AUjZlwkM-PzwsukINyHFaZKTfNYfgoPNQkasEDag&oe=6A315D7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BDsUvzYxtQQ7kNvwE1qfyD&_nc_oc=Adq7KecEC9Bfu02o6YGVXP2I0CGKbxOhKm23rBFO-0GbZa9hd3D5Py4UqaYnebZW06Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_V8KBqHD7HsZL3Ge3yZQGiMR-J5YJvmv7iBV3LVlG1w&oe=6A3179F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
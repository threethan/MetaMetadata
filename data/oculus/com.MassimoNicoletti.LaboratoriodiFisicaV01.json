771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAT5SDw0YCQQ7kNvwHMMLvi&_nc_oc=AdknUP8Wl8c8YnoMPjmYZY72LhSseFFFryzNQMx4F9YuAq60rGuyulwYe_ML8__6mNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyS7a-nE2atI8K1iMsJL06uLL4y-PMPDP67jSkVIKBVfA&oe=69BBFC70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjAZJ2Kc4y4Q7kNvwHn53iz&_nc_oc=Adnmpz8MT2sj0y1VZO1AAt5uy8v6UzbKQqFePMqV36nkixfjmUHD6SDH4qDoxJu34cY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSq-546SHDyDVUoQcvkC6D75sa_FY02C6xJKfkCg2jiw&oe=69BBDADE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsKbJUpzZxgQ7kNvwFaIO-q&_nc_oc=AdnTC4mj6gHGB8ROsTCfMqUIY-6hUDbo1yF1sMC837mXKyXM_DNqDB318XMXU71B6xU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFS-CIkgX1EJm8T9spH_XqH36JngwvEz0BL8AEc-ld_w&oe=69BBF477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rf1k0HBoFAQ7kNvwGv5Ylx&_nc_oc=Adl-x9Yivjs_1_Umvn1ssFKoQe4Owa_jogxXUrLTMnj0qp8Yuu_QBWpGmEKNadPwq6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzXroge9fjHlGI3I5eaSFDFG4k2nFvp2yR-vxe66brfxw&oe=69BC07FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AJflGAvo94Q7kNvwHI7ZnO&_nc_oc=AdlM29cv2oPDdxgDPIqxhaxWFyYZpljDYbQdsHS7osOozSWMFkR9f8PXMlpkfsTxVoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlnwKPyf6XafRsF1S4hgRWuVWoVkt3KbB-KPa7uaKCTQ&oe=69BBEC33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjaZtt0d1xMQ7kNvwE0d8il&_nc_oc=Ad
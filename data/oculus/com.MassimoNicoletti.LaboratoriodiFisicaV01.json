25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69QkTPTh9tsQ7kNvwF9W3aS&_nc_oc=AdkZUuiXmZuW0sDNmBdMswUfLLOL6zPn4jb_G0VEjiRHwl2xq79gn_ioqadNnQIHA3k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRWSaYwReFjEzymxDRbVq47Q-HyL2YTahcOvwDv86T5g&oe=69BD32C5"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuN3sj7aOuYQ7kNvwG-4qx7&_nc_oc=AdlTuTeuFaF1bUyDK7Bu9SP7Pnt_qisKHacr492ySl01MlUapqDGhu6AgejosOLSOos&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfVYAJWhbrddYyzf0yUcsFvzLlIEs4xn296uBzcF08AQ&oe=69BD594B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2n-0qY2WkEQ7kNvwHTaLJu&_nc_oc=AdnoPAHRI2WXbIayOczvygVlwldbNw2bm2hgkRhjLBUw6_hV9xqjhRhV63aGKiWzf6s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyED3NIYUWcj81tRcy1nAdPYohzR9Fpw4kRwfapH4b_yA&oe=69BD34CE"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7014635251891409"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75326678_684847243460423_1231468598944244579_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgxOpC0FAPoQ7kNvwGDDaO3&_nc_oc=AdkfW3E0Nv24qG-2KpVR0c8fgZIpdNO7MJf98gBPx894PgZ3Uz-6WeHgzBd1XnO7W8E&_nc_
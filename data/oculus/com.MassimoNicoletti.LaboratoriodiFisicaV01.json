DL4VgU12xOSTxPN9kdtEYxl9n6NMuRPamyPRZEjQ&oe=6A0893F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff7KoY7SLXIQ7kNvwE2D0SN&_nc_oc=AdrxNhrCwRAdvfpYIF_DbtwBgPaQjTikCk7QBwHhrDY40l8zWVK4SNDXcQpedrqhwFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4erRDkw9JnLd9nHmzekFOnhJA4FPhI6i9foFPusCyvog&oe=6A087370"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NujPSNqwpOEQ7kNvwHo4fUj&_nc_oc=AdqBliZZ3Zk6jcJM1RrKHGKkS3xVjVCOhxRBpohR56_O35j7oqn31tGVlu7riPG-1jo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NIGTQ09FTXyKt4Eg1OW1JwoTEhWL7pz02vfoAVm5p-A&oe=6A088A1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ST49bRMpYoQ7kNvwErrdV9&_nc_oc=AdpE-no6G6TIjA8--Hn6RkymB9qDNGGpUFBsetnVRyXgRhjYDxFWWBxV2No9ZpY5WAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dxqDlsJ4B7GoAGkRqgx5Gp6u_esW4zxdWh_El8DD5wA&oe=6A086B77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOFIrBKrZcsQ7kNvwGdZgZ_&_nc_oc=AdpYXic0J3eRjXVO8-5-Lv7qpSPAj0yDDNHI4hZ7Pcj23KGDh24_cEivCX9duMUubCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45d3yYty3THhBL6FMMR91tC2Bclc3PXvuUJ-lyulp8mQ&oe=6A087EFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9X2V9W6wioQ7kNvwEk5RNG&_nc_oc=Adpv8Ityx4jJ0BXL_gwhKMC2Oz-y3kU1-ZQuWz9NlEY5EbFYu7ppRdfPCGvcxHhw7TQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LDRPOVDLNOpq0A-idak5SKtIiX4V2EMG9xHbj4jVGBA&oe=6A086333"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
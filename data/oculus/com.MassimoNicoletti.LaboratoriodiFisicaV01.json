=00_Af5XOWYyS0lIjkuCFu6-abE3f1AFDK92X7aEbeUP8UlD_Q&oe=6A11CE74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImKdkFlPsEMQ7kNvwHyFhDP&_nc_oc=Ado95RoKmJiar2WX3bx0p4831mj5DucHOkOAc2hlSAnNCx5GC4BQm67gMv8iSnuc4d0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LwCbLBJqZRvMDzv_SRu5VhrZibzms0HCtnxvsnjpjgg&oe=6A11ADF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vljBLwryQGsQ7kNvwHOCtRk&_nc_oc=AdrSw9b3GLh8oCRxd3NPWl5j_FqxcHEMGybSDwpPkNJkcSswL2OVnjPfhaobeZJPfxI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BTUrhtfDt9H1VYr9WUuPJEac7b4qgleathKT4izGGvg&oe=6A11C49E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOzqzYHxKAIQ7kNvwHVEw8_&_nc_oc=AdrFmqzLcWqJd5dpZBZdDuei9ug-ZsilByV7oGiza6F1kl937OUZJ4LEdeSwh-qjywY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XBBLegZ_MPTcS7HfSFCae8iyBFRTEetkzHg7ZfMbHXw&oe=6A11A5F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=empBnTWAK3QQ7kNvwEZ18U8&_nc_oc=AdqtAetnuP3LAB-WpTR_tCNI8txpZSN5w_NeUHPQaPt3zF-tRgAvchnwxze0vwpF21s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v3xD70PToi8kThEVKgqd9JNlEOp3q1kWqhZojazE2DA&oe=6A11B97B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlM6bdmx0-IQ7kNvwHEq014&_nc_oc=AdqzQ72fDj1kENrXG3rlA_5Dz2Byx1FjQqPt3WDCyJzISd5ukzZ7qa0x2HSkjWwF2bs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vulfG3N6RecPDsqSDEPk9znxAKHnBE5DKDjnZIMv3pQ&oe=6A119DB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_L
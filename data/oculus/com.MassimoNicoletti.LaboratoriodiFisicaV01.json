_sid=6e7a0a&_nc_ohc=r8DSsDrzfAoQ7kNvwFgSuC3&_nc_oc=AdqxagmqZTSAYgR_5L8eaUuZ6kgx5zCv6UMh0si0rEMZaMSQrRYiqF7tKjvHOMeEICQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0ipokw3g9LnyczsjbNtSXaEuaNnZJz29zWOxjUOp_hA&oe=6B070E5F"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILwvOpG4nSQQ7kNvwHR-NJ4&_nc_oc=AdrktHxvRBve8jp_hpFbRa5Kqd11hswh0ccIJZyPHw4SqK_gs6gYt2TOTd-AFgJ8EKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzbtbN85hwe4Sr9tefK8rI3AOl6Zh4Y2RnpBUuZ9Bz6A&oe=6B072894"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF22dUkBSsAQ7kNvwHuUMZa&_nc_oc=Ado8o61XOUmUx9zatFX5a1WL4MNCf3r9UD4cqFoSldbTnaetDregiEo0A-EGB8fkogo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSddvPl04j8eEyHcPX7UwiLyN9tAwrOtjDFH1NEXD2FIg&oe=6B070205"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0qE22WiCWkQ7kNvwEKx1CE&_nc_oc=Adqm9JJ7kpRE-zB9s_PkZx0P5W41kXql8vZ-AtvhOtmEusJ1AUDV2QwtS9S9wnQX0oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa9f8V5uNiAVrr2qhWRl8E95JzSjLpfmeIabAqxfWWBA&oe=6B07288B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCc202m36OAQ7kNvwHZHtZB&_nc_oc=Adpn1NHP4ii1QDAMx1ZSA4CqbE8FQKExbj82tWSJlwdrxH0b8qnIzGE6h1CfClNzsI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZgSwOeGSRzkDiP-oT7BlLfZRhiEUwSI10BOpd-FeVVA&oe=6B07040E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
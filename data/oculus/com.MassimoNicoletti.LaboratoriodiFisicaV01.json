ph5zUjxuDqVR_wTSmHIrQdJUE1AflFODrw04GMkA&oe=6A5B6A34"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbJsM1Lm5DMQ7kNvwFV4t73&_nc_oc=Ado59MB6PSgm7_pRkMhsQGbX55UrDGcZIhqwHVQQEuxw1Lb-PI_IRQ56kHV_zCPtysc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUcqwl4QoWeMXBOvBb3OGZDph3TqRQVfxGC7krKkOPJw&oe=6A5B81F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGJBH647eb8Q7kNvwHsp0Jl&_nc_oc=Adq_qkKTkos97I8Fg6MReVIihySaZMIy5Qwf2SpN4zGEWIsdBYrQg0Fl3t8pw2sQlos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBDZjderXNk8QBbj6yb6SHw8eJTzf-COcbJyC0FmNAOg&oe=6A5B605E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2GOvo63LBEQ7kNvwEAeFGg&_nc_oc=AdoUBr4nM1WuY21yV7lBIUci001045dcSVCcscfBGYrE20fD58j9ocf4rk76qCML9iA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYU_SrXhDWZC-Q6_9L_ESll-7YzR6BlJ0UxpY2kuFn0A&oe=6A5B79F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtQn4tCKQOoQ7kNvwGIIeV3&_nc_oc=Adr5aMbpXqb1A2yud8Lwq9o9FoYaDUsHdJ7N4RYQrAB5mhC6tM01tTnFuGEEFJcRTZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAJYAJgmGaslPUYyMwE-r376BmcuZfkw9hc8vBi7QYAg&oe=6A5B8D7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-VIIknHL1gQ7kNvwE1M-04&_nc_oc=Ado7TR9vaYXiouNnVvLirysKNYh-m6xHhYIVLzwtZnHKjOXeSDn-HHDZR5bvMbHzySM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCARG0rP7x-rCttEaciqXg4rOAqkJivsYi6RA68-h8omw&oe=6A5B71B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
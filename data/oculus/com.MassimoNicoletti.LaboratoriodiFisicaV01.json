DO64_b-KRAmy39emmvYc5JbQ67C7F82RUiqeKgjQ&oe=6A3BFE74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyYjNXj9h28Q7kNvwFcBQmb&_nc_oc=AdrxSnY_CvSZY1KgytY56MoQaoVBhpfKAkhr4Mzui5ELHd0ljURweXJO5AGhQAJkXK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ihBJHvqNZRaTH4TXx9Qe17Czb5KtLjt0BrfRsE-OSPg&oe=6A3BDDF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29jqYGgHpqEQ7kNvwF5d-v1&_nc_oc=AdoAZ3XrwxI3X2DRLlX2S_WWqn0LXIWPGWRQH7ucxtrZ3KS0yywmhnN9cm8DkDQsFIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fUSJicf6j2UEduZkl3y1TxOY7FDl8bqZjaOKVHIrckg&oe=6A3BF49E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM0s9Xs6xxUQ7kNvwGXHxoJ&_nc_oc=AdqBrhArcq7WE21VOrJZvuC0ZXjcrJPLjkg52GWTBigyCpgQ2yA4jFQHjxTC_EiW0Ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SMZJnY15CQ3qZM8TKiOd3-j8OFf5BkPs7IXaEVzkWbQ&oe=6A3BD5F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4zFCL0bT64Q7kNvwGdNehY&_nc_oc=Adqvv50tAcpkAV6kQvAb8wpeNFa_LGNgsTK0FLC9O_oUgPv5AkVN6vmQfkbFMC1NJHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TkCbhXdZGdkfsKL3yZ98mNvlFzNwjrdy32zBa40Nujw&oe=6A3BE97B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2rT-0BGEq0Q7kNvwHEsgbg&_nc_oc=AdoZTvOEkNWbZ5PjyAkdaTOtssTP7lq5SYG9qoy_duXYE6AGwNeT4kT-qFgQW1L5faI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AnxeZU0fJqxgQGbdDrrixsEPCDQT62k_Ptona8ndKCw&oe=6A3BCDB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
_sid=6e7a0a&_nc_ohc=xNsbK39kGAsQ7kNvwGUFoHH&_nc_oc=Adrwc59mD40MK0Aty-6JeXfyAzwFfF-Kq6QrLpOUQdLM5raNjMvA6gAxu1AU46mkhdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf2g4_vvxd9rgQvQ-sBI33VPU9n92gEpa57KUI3MteTw&oe=6B0319DF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZMyEL9fnAMQ7kNvwHhyar1&_nc_oc=Ado5r8y1oWwVUKShcWaOTG8DWhSsPGPM9SJff_rW4-nYzHJm2Oa3loTBYZHdV8Stpk4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgDGGVw7Wn5Etz1fJrYtrJ10OWAwRrYYwZxbyPfJ_dUg&oe=6B033414"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfQlnE4nYmgQ7kNvwGfTvhA&_nc_oc=AdrTBMWLEdEjaJkVhfYnOFu7MKUspWYKdrUgCm3fd4Zz0ex4IlHpyts2FHyqqljF6uU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7NdTnLpJuNUHWSEsSJtuIGc0bW6vzxnlxoXwVfsCI1A&oe=6B030D85"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VtdoJe8_voQ7kNvwGAwPwH&_nc_oc=AdrPBr60Mb6vKjLUGKrzpFrYL2qlNPw3VAB3613XmvtBk2Lqqcxs4jXV04ahVWhdta0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5lr4IMUkWy5VeF8NC_xFMv0odxUoXbV-d7Ehvh5WieQ&oe=6B03340B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_q40BHMpfmUQ7kNvwEtVAna&_nc_oc=Adr5jQHPnN-oLPSD0BMTvIKItABPc1MwGabES7oxvz9jiZbYQmXX84OMJWjW1cwyb2I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_DbyRFHCjubMJ8NN9xBqkpr6OBHCp1R9v0PcCca-fdg&oe=6B030F8E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2b2-GIo8lV5Qnx2RdYdbajOvpD6dot12RtGBJG68Oew&oe=69A04CF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cudpO7BnzDgQ7kNvwHlrzRy&_nc_oc=Adm8EzEsLq5jr9UYdMmkeNPYDLjkVYthzXjwpf4ljcmz56DCBYL9xSt11mlivckpUic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv9nEMK2DyDzpzkgd6I80Fa7xM_Yl68_rhhdZZ76Jnt5w&oe=69A02B5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5QvYOMS90wQ7kNvwHhkV2f&_nc_oc=AdnqS-GlEaXVp2roiTBGjt_77ahk9Vz_9Cb3jYy3mLvhp_vxekp3g97RTfoHV1QSiIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afse61nkx249xdO0DoKKhEVY9uHYIEeFtpt3tsYKj654ng&oe=69A044F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL8XhnIJmCsQ7kNvwEIGI2I&_nc_oc=AdnEgpAOqMmobcpomtnf48iKStnXojkOuN4jk9nukp1yWzQQdKmSkkJTedkbl5wsduk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftP5BDdcTgFdS9AdI_otmdhXEC9DLeO5NOYclNugBmGrg&oe=69A0587B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXWRldmogbUQ7kNvwFCPzAC&_nc_oc=AdkDyVJgB5HjuEBNSx3NrAcBFw8W69ut7mkOpWUrm3ur2KvrqRcU0mb18PRjRDq4hPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvgE217xCZgKJTi_Xf12XP92REO7K6gc2hQDyArFJGluA&oe=69A03CB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVx4O2XjIwoQ7kNvwHVT-pj&_nc_oc=Adm0MwuYg2IIcKiN-jYIYe0GZWbOpts4L5QDti2WwLYUIBSM5dN9jT4rnQC_QXb_1ZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuB7M9x_EMTl1xH4otMYQYVmIU6jBNFJvRr98n15ekEAw&oe=69A04533"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
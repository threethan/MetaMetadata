pOTC0vIuhCx6QYaitU-blLyJ7rOS2d8kG_Jm9hcg&oe=6A9AEA74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3_x3ZJzfvkQ7kNvwFZno3n&_nc_oc=AdqhWqC8s1NmkNLEEeBhLcty9NZin3erDCflKnmDVxGcwmIhI0iWq5a6mbYtLKIp4dM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQLiOue4Z0FpiVU-ySsRs1PUjuhpbDwD1PI7aHVJhuIg&oe=6A9AC9F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mcrj13xXOrQQ7kNvwGcpHZj&_nc_oc=AdreBEVEsuzDUfPo9eSTayy6rZZBN-uEPvTbcIGihvK5gTa34OI4kIARxqx1AowGMB0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJcIvUzdGS4gzqKU8OjTMphJL5dhNZSur2DNJo_aOPQA&oe=6A9AE09E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t2K7SnGZnoQ7kNvwGG3m78&_nc_oc=AdrK76rhkVuqmjoOZDQwSbZUk2DHrdQ_DLQ90Gu9CqyFrkQBVVl2bBlIrt6KOPH1OOs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxGzxI90nSxiJUxzOkRSUKZ0vK6KkNObP-4eKpWmSXfw&oe=6A9AC1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egxcbCFb0rMQ7kNvwHj8I3R&_nc_oc=AdqMNeYR7DO-lhsBpmqwRimPMCGsydpk-vb6SIN1DCUB_H-DHZV_HgNnxjDIfX_9uyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7rbGzTrBbBJ75A9-psbssgJtQXLUfFgNDllao9HMS6Q&oe=6A9AD57B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EL44_2rxdQQ7kNvwHVqO_b&_nc_oc=AdoG-wp-_RLsLk1QyaIB0NPdkvcPS1HAkTdbx_KzYjmcpXzuRpvjSdQd1WN-k9lQ_cU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcujZT5qsKSwiW-ECzRlyTzcngQFQK7NfsLi7JHvTr4A&oe=6A9AF1F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
244xSRj-nC-gSiQE3rlUbDBntTtgv0KhcQpVAdDw&oe=6A131FF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImKdkFlPsEMQ7kNvwHuGGCo&_nc_oc=Adp7-3-mo8_kVSzg_T-fv9eF-SNvBA9b3SGz-TMXvWcY5pe6oSnu4uJzwwZ5A3WJz5U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af431NjgmifhiHjlHrtSvDU7MCk-tjaOyTIFWEGBqMppbg&oe=6A12FF70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vljBLwryQGsQ7kNvwHh8WLm&_nc_oc=AdppYOwO6sFUFKRp9YY04QPJdL_HNWK_Ov1VmojXSh8VzS1YP_RqXy0T-g1u0koKLNQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43YJLBC1lWGyomAldCqhb_j3szXnXyIJOrRDzRECoRUw&oe=6A13161E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCOm3IqsBvcQ7kNvwFgZmIA&_nc_oc=AdoxMzlq2n34onLDfquBVudb6lcSr-XiuKokpuwkkx2-FoUFttRgGPSsyz2UlKM6N98&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GLm52suGm-_4Yl-tzalekrePmQLOuSNngZG95lkjwAQ&oe=6A12F777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQoDLK9hlBMQ7kNvwFaQPU_&_nc_oc=AdoZYVjB2I7t9GdirCqHP_oAp3fP8tN2LHo5rgNs4SxIdS9x1iYJIsVrltb_1u97IKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52zHYcD3ajvo7UmYr4c2L_y7ULjzDumobaNlbF-77grg&oe=6A130AFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlM6bdmx0-IQ7kNvwHzyWH6&_nc_oc=AdqMvXh105EUcMTBN1KkPKzWC7psbimZ3h5iyr82xt8sv1d_kFv1_4z8XOvtLjBZmdc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wc6EwA4crfGF9tGbOU53jRfx8Xu4LNd7SeFHuT01vNQ&oe=6A12EF33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
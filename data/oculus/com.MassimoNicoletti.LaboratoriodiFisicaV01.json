f0mReAeJVLUcJo3s9kTfmSlikiJmt51A_FHifDFQ&oe=6AF33EF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9QAjzYgE2kQ7kNvwGTHDsi&_nc_oc=AdoeaSjFJiu3nGOxqfGp51VN0-WQjDI-mwHCQGeyvCx2yAo3mXxAiujtuuV-ognC5MQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9D5uIY5ZYpn-APH-o8w80Ynoy6WvjC6rf7XPLhaX6qA&oe=6AF356B0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbkHdcdRcIwQ7kNvwFeIahD&_nc_oc=AdrwqUFU47v9XqO9HAyv64G1eTmQ4CqnRXpELsFu7m8VFUT-xBRbQ-UJef2SLpd4ukM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIFSgqAyUXYbRKuPwOqZHNMLOCV_czWbJkrIRFxJRJAg&oe=6AF3351E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISU9wjdFGEsQ7kNvwGMHaO8&_nc_oc=Ado4DeDmcyxHtFy_gpsCg5Tojomex3b3n6FX6kgI6hM_2zVh3HM2JZq1Nm_o2vW1JOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4y_aXYOQoTj2Sn7Uvpby_GdDzhgYVAvuvacS3uRnVMA&oe=6AF34EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVr66Q-9R2wQ7kNvwGgyo8Z&_nc_oc=AdpWJLBY45Se1MBZaHlfcibjURqge3gzIr_HZ3gLLHE_V5WobZ47hNpKs46NBSBCMQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSU5fBDEQdtI9Xod_XCAOKcCs0vVXOqQYEd6Cn7hDZUQA&oe=6AF329FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLZnV63YxvMQ7kNvwGWlbZc&_nc_oc=AdpGA9eAT9jORa3pZRjJOBMQEfSqn93T16DzcqMd013D-6SA-zI--atdh160x8DjS70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx1XaVGjQ2Idyn6rXoBxQcL8N1aX6qxM4KAaywpr4-7w&oe=6AF34673"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
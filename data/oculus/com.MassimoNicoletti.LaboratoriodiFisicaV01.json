3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvid7jyA6QAcyoR_i2Bd9Y7AXugl1wYVP-S9dhcjblaqw&oe=699EFB70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cudpO7BnzDgQ7kNvwHMGJF-&_nc_oc=Adm-jgUn8CkBydar8F4m1QfkuIKkPbVEZI800UGzAAvCFOPYsVLbd6L02GD6pFs-2cM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftSbHPzXe6QlLvU4Uf5jAI3SYwQ_47LIoCaKpNbUuVI6g&oe=699ED9DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nb9bSXwDG80Q7kNvwFYsEFu&_nc_oc=AdmhXIPy-NDJNgOr5w-tNjEwKeIMhkF17n1T0uQmOqA5eFo2FdUDqi_g9QAjLDi6GtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-tjYpTLMoJvmm39BkLpKdhI6d1PJ0H4yPox1y0USaJQ&oe=699EF377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huAcjqlpMUsQ7kNvwFjw8Es&_nc_oc=AdmpeAALA06UQwaN0fH7TnWPdedRPpjELEjbKHq53iJ18CsXG61pfxvJ2yvmfYVJkWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvFciCdxtl78o0ZKaWRklsz8bv_d-ex-S-F1BWQIR_6fQ&oe=699F06FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXWRldmogbUQ7kNvwHM3PW0&_nc_oc=Adk1QP0XEXEts5JZsJUL3OR-oL3fa4T3LZD5ClGaRxkIfacoQwiRumgUAdZErDH3xS4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsoR0G80gOYVu6-kMWMdkxWFu05mGp5enGkmW1vyPpUXw&oe=699EEB33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DV8e7Fa_jEQ7kNvwHEBPOb&_nc_oc=AdmYh4QPfMzW9M5hTY5CFd65jbJQyM2o8Ep9Kq37RriegH05-5Ml2HSBXBbLhrVnrio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8rDFZk2WFiOwSuU3x-bGccf-DG3gK8weJK5CB0Rmkxw&oe=699EF3B3"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
tL_Kj4xNRwSjEGz-2JMjfS7kUNq4cHDQrZH0AqvA&oe=6A5F5EB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=691TeLH9yuUQ7kNvwFh1MDv&_nc_oc=AdpPdg3pxf51iOkJuYVtjoh5x7ewyEMQOccSbPRZaQLbQ9lCZMTEKqyJa_eb-S7-xck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAghVjDj2vuTQVedeXtHhQGD6gnKroh0xqojNMy9rrGBA&oe=6A5F7670"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln9GB8kvPbsQ7kNvwFQryO8&_nc_oc=AdpF7z2WWrr13bvGfznzv8fZTUmakpxqekd25xd8HKfW61DsnfXpu6m8-jWDwzBdg6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhXIAkNDVNNH9fE4OKjPhfgRrZT8qRzhunACg0e58slw&oe=6A5F54DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie9ZVhVw1w4Q7kNvwFmL5Yo&_nc_oc=AdqQu20HyeKlZOeA5Vmckicg6DFrkZ5nctooKvf_Y_hxuOK9XpbQ1CTXmU96IuBe7TI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmPvo7UPblmcML1I0cYapdUBTc7vTsdP8QD6vaJjw6_w&oe=6A5F6E77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3yTGsBD76UQ7kNvwFaPxDD&_nc_oc=Adr9gtZvk45RYtGDUGUcjM2whe6QN2lyQKcEPiAADTiNjciKso7RKHW5slXgcbiZWMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDODKuOpPJ2JQkFZN6Rl51vd2Hm1u_NGUZGuSnovy88FA&oe=6A5F81FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpsLAkJpbQ0Q7kNvwFVXZ64&_nc_oc=AdpX_c7qNdHh-0mRHr0ya8hQI8coEIgL5WmkMAWuFiR6ltXafC2xU9JzegZBi7xZL60&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt2lItg1JhTh5ZK9gwwgco14_9W80ZQ8Xh11m_Z0D9MQ&oe=6A5F6633"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
zuT22lFWNMYxW5h8otrBSM2nrRiaONXIrKk2jo4w&oe=6A9177B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SVREjlAeD4Q7kNvwFSCMCy&_nc_oc=Adpq5skJZllsKDEU4_5SElIHHbSBkGotGYuYvhZnqi6ATrX07rtYnxma5m8SAJrg4B4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8vip2VsOv911kevTjXvwfW-N8xYMOa6iKStOBE7icNA&oe=6A918F70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vROchZEg2LAQ7kNvwH7U4bS&_nc_oc=Adq3EJPrgD30Z5NKvC5PT02ys2wLE66hTSc4XigNHhQ1bNUkYoE_S0yS9F4nmKIfex8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl93UPRDu3Ob00iiaYmKdS9pv-caVZi8PrcjOOflS5NQ&oe=6A916DDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_WHrVFxO2oQ7kNvwHYKuWQ&_nc_oc=AdrbRO4QPTA0v__NIMDmcF5YwDTsYtweHpcwvSpr18e66g6riasonPBG-ojx4R2cSx4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3H72FtqNu4-9SyYPy2RDYOALanPyNEChAoHz0g_GD6Q&oe=6A918777"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDBhg-eOoFwQ7kNvwHwUPJ-&_nc_oc=AdpiYCx-PX4pDBRVKOBYQ-2lYRmy5qIbWr7j728wCNBdRlGo3SGdsH_taiR6Xe_1Ii8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSA_i8ysdHnHRjZ19xevi5H6ejojaVov2MJjDARqF5gQ&oe=6A9162BB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y62uF-8KoWQQ7kNvwFo5Szz&_nc_oc=Adp5YiUUuEuB-cLeTdvbQbHWg2j78oIW_UevO98oK36ynRkcfOiFAT5bXRFn4k0Jq2E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8H_iayzjwXtKOO5rwkSIBzhWqSA9co_pn9QZkOImFxQ&oe=6A917F33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
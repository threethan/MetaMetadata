HOG8MPIllB_M08jkO1QDKvnzLkd8I-Xm1VAvDGZA&oe=6AB3F6F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQzWuC_xd80Q7kNvwEuU5hN&_nc_oc=AdpTopLzLKV-04TQx2cT0otwdhWkfwZrWf9NIvNIrbsHbi1iWLzM8x8KFDJ2weNXiiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoV0KSzu1af-Zp-uirPuV8vxDXVpCqYE9qXH0KTbSI6w&oe=6AB3D670"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3vf45hoAbsQ7kNvwGb9zhs&_nc_oc=AdrtvOno1pzoW6HdlxEr1QANa8XoM6oy4UtAlWfl1ZcsrXvU_nrrd_irK3KVLtd3xTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuVjYfmZqIfcRTVKw9a5HwsNCEnhKFpS0-NnIOcrqO6g&oe=6AB3ED1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGZH31LEIv8Q7kNvwGRfuHa&_nc_oc=Adq_CE96EeTCGjBm54QxAkZLT2eeHEIbhAE1AnzlA34b96oHyqOS4pIMPtIpyCUtG2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-w7XSTMYFXMEWsJVKbac0HY9xlGREKfWuNVN3fVerDg&oe=6AB3CE77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqNU5_U8x6MQ7kNvwH462AU&_nc_oc=Adp-lGlS5rS3KvGRpfN1pFYhDp3xt14pY76Z9dt9tGTu04Qs3e6ggNWtk-qaUTeqdDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdz6B4OPqFNGH31MHEmMO2d7mJwIgX7vCvUUJZhNvrLw&oe=6AB3E1FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgJR-7G51gkQ7kNvwHGXJzt&_nc_oc=AdpUAiy4h7jpuPxvey2AwXvxELuLkpYjE-jjOfyjaxwkkXVr-qe4r0d5lGKEui8W8Nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwHB3eXryus7LXsJKHENO-2oOVK0JWHfoQB7MvRPk_rg&oe=6AB3C633"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
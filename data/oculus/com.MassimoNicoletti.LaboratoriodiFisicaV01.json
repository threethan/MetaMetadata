p8Ralj0EUgJWtrdiebfH1lQILxZ0q71Mf0CrkMUQ&oe=6A81A5B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqWasyuEReYQ7kNvwHtMnNx&_nc_oc=AdqYCPy4z2HrJtd4g1SS-lmzHbn3qB6AqVfHw5wOGnDm3WIKdh9druNUJVBo7W1Xvtg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUTqqIn7BXTGpCGamalZs_BqV1sYL_JmyqcZJQYzgb8A&oe=6A81BD70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pTxBKxj_i4Q7kNvwFxuwgY&_nc_oc=AdpUDmRgwiqJtAb4SAR5ugEYCLDBFUyEEdbZ8RqeU44ccW4PQytg3YlnJDldG0wvqf8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlihuje8zvBb2f-rJ8bFp55Mg2_LN6J2XubPoCkb9trQ&oe=6A819BDE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py1-BtOkNxAQ7kNvwGDQQHU&_nc_oc=AdpPI0f_vY3aVvVb5Km82zUdZzV9TR_zXw-OU6J8tSz3-AJ93MrG8eVr0ZhieDvPcGY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8LZCg7QGtcMR8xt_UFyZtLqsM1pie2ypyx4kTc8JbvA&oe=6A81B577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiJg4_H29Q4Q7kNvwFHNnHm&_nc_oc=Adph2hg90dJpcXK9lrPpI7GKCncunrF4WddngrmQUqMkGdUCGUFCCRwua3Bux9HOA-I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESPUV52RKLSNoQLfeECHsxEZ7t9ubmKMNElT6r_d7CNQ&oe=6A8190BB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agt47NOZ384Q7kNvwG7OV8l&_nc_oc=AdrQE1DhyBRr-bnBMMPq0lYjIyj_228rfp9jDxDkJn3hPb7J93Qql3hJGz6-Q31-7rI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgd1QI_xXbtjHGIl4J_s8je6uN--Kzm6c3reuDxBRcXw&oe=6A81AD33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
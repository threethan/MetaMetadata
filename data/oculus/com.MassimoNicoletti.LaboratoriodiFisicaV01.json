Q0WOknB-Bp5TJjn2nojJIo4g2zmas12X30IeZtkg&oe=6A0B36F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff7KoY7SLXIQ7kNvwErlDhx&_nc_oc=Adpxzl1jaHjDAg8LI4qzTU8TSHvBwLoFVH_q0ThzEb44LOpv3MJvCGxOD0qxiEOONiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HDN4RX_J-luuZdyKdcEI6ONbTUhg86Lp_gGgnXYrsnQ&oe=6A0B1670"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAzw7dACzgkQ7kNvwHin480&_nc_oc=Adq0D1s9oosVCO7NUgaEkNUk545O3JbJ4AdJpHq592H5P0BvtaNAOibrCIKPFZxpgyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Sg5eI33HAoy9Vhu_jpuf3QW5H8SbW6tBCgP9JdPfvow&oe=6A0B2D1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0uIm7v3DgUQ7kNvwFXE1K-&_nc_oc=AdqP_CceEYZnTt2NMEEjc44Dp2oeAL0luJzE_uUaPOBtlKygQTmJkkS-Gexnuq6XI-s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DAhsHDXgSn5wMEiF-rAyezV18WXAup4inWq8e2MF6ew&oe=6A0B0E77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZewyWWZcvjMQ7kNvwGb5rlG&_nc_oc=AdpzzPWU6xXnnZqeA9fJtK6PnpOG7Pd1Bj2i9Ync9HEHZkC7Oq1QLW_20I8lhNoQS_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l2sziCz7cjav5scNU5sqfp-puNU-P8Pr4FId1r7U_Ew&oe=6A0B21FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXE9KPGvrFUQ7kNvwFetau9&_nc_oc=Adqa0kFLwVN8Sgrgzzz2PNtPxUEx_sVZdH4jq5pnVnQukM9ovZNkx4SZmk9UswAUFCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CsRbue34HDFe14t380rj_buYRqG_CAxhvOgaJOYJnaA&oe=6A0B0633"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
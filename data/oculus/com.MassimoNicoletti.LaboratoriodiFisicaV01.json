GZVCWiGWryE2Jyt8zW6tX5VZ2W2ERdY1ZaZ9i6qw&oe=6A43E774"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fxx-P8wkINkQ7kNvwHs8NED&_nc_oc=AdpSGqcuPxMo03TpU5-VrS5cZjWo97R_ymB3ZecNPQzrD6zt6dezRU9SEKHy7o4f_DY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86qgUObzt_pUd2z-03wj2hiktXz8mDTfJTQlBfyxfB2g&oe=6A43C6F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrWbYhykeuIQ7kNvwHO4oNC&_nc_oc=Adqfqrs-KkxC96zZYxHgwoDwcJdDYfuySdNqG5211dT7AJZLCq6MVvONdloNE6IEuQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VPuKXD2kYXMG-FHHiPNjVaE7wXvmWrAmDPUr1rfKBcg&oe=6A43DD9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eysqsFQwFP4Q7kNvwFMXuv5&_nc_oc=AdolCr7kQdvijkhbaLfjYpmU5oSbEj4MTdhIO3AYaKi8wlAtV5L7VlgEKXCbD9v93Dc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qw1bLGaJEPbSNQ3n8M6JYLHZIhvpKPzlOmXLguJGtig&oe=6A43BEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ggI_mJ3o-UQ7kNvwFp_YiY&_nc_oc=AdrG-MHyQcFqPP8e8SC7SSyvDmqpQdGyNqj-RA88IRTLSY5w21jGp9xtPWHjVHV-Jrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__HZKlFQKrS9EpyVqwm74bNBdGX8Hpu5xsQ_ubebcEmQ&oe=6A43D27B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frvXeqErjCYQ7kNvwGO_0l3&_nc_oc=Adqgz_o39tcjQD-Kgw7G9UDwNlU-gmRIeEXZOWy8HNWa327034BRDi-cK0xwiDqlneU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AZNrarGOpMgLGWlJKWPj7K2QljsIaysXlBciCBtt2Eg&oe=6A43B6B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
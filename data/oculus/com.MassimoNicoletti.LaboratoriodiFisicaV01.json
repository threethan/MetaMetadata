78zXK9BPmZFXWoNB7eGimMeNAgHQTOSPW45jRYow&oe=6AF49074"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9QAjzYgE2kQ7kNvwFFd6K-&_nc_oc=AdoHiHdg8tG2MFCbMK3yOBBA98X2Azeg6Y6a85Is6YQ4id9ne9LppPvbCIPeIqOsa8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPs6q079tsg_XuBh8vr3608zjWhVSnhqivJA1eJE2g2Q&oe=6AF46FF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbkHdcdRcIwQ7kNvwGGHPXk&_nc_oc=AdpPvgVh2JPnprr0J4Z00e2wjBaL0j83Q7NGD0Kd3sKC7dOCP2wvSVffenwsgW-o_7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDmKCQzTypy1wZUctt7HjqnBeVEuVHSBpptMcCW570FQ&oe=6AF4869E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35jNsZGT12AQ7kNvwFm0Q0O&_nc_oc=AdqQtIc8sQ-scCpwTTLryZBPqXGn2Rqg_wd0HfGngnV0XoC4ICePAzu4YWjrPLS4NK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHNBtTYUasE_zw9a5CKdyFMsBC0XLMyw5zR4fhdnH8fQ&oe=6AF4A037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdsajD4KD6EQ7kNvwHYg-VA&_nc_oc=AdqDr1qyFfw7PimfSt2I6G_34x-WaZImib9bcqSPbZsdo3cWC8wNENEcXZ_Vq9rHObA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6BcfdodQt9EcuDxq1AHULkk6IHZHogkQJt5ljo6FcrQ&oe=6AF47B7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLZnV63YxvMQ7kNvwF1LPYI&_nc_oc=AdoeLZ_LgN1ubaxMvDcQB9QuCUZVeIjAeOZyONBiO7lqPegruAjATsc2k2Deqf0CF1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5QKuOGDdQxy7_VVhFoKZyaIHCbAaeThIL7IKIv048kQ&oe=6AF497F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
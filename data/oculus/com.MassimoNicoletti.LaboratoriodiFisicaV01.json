_sid=6e7a0a&_nc_ohc=oFnQTC-tIBgQ7kNvwFnAyRe&_nc_oc=AdqJATNjcWoWXAQBe_pVF-FwIZcHzQpf4hBbEnJY47_1Te5IgYBunk4d59NtnQ7lrbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUruHIWN4FM9IUMIGhQfNqraGUgy_3Su13HB3UUcyQNPg&oe=6B1048DF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYGvKYTiyBMQ7kNvwGfdsFZ&_nc_oc=AdoIDIXoODV5tFxAED-3wZ4KfrY2GF3UG32N3CFkzRSsN17IqcbeDcca3dSxxknGdwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQQSPL55_4pN7OvemPN0rac31K4eGLP0r8rz-Izwyzog&oe=6B106314"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDn2BGGkoEIQ7kNvwGk6zAw&_nc_oc=AdpwZ67A0TexTM84BHjNqT_Ug3bRZCYWXsLaf-JHPbKgmQtv16T2_QTbQtuz-wvcUok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU1tFroliyFC1abek8I1d0JqzzAfDVHd1uiW6089ve4Xw&oe=6B103C85"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x3bNdzTTVoQ7kNvwGswW20&_nc_oc=Adq6Fee9r7xOqiOeJ9IMEhHWYTrfA5IE4vBbvGmqTakgeGBWQOtnzrgZJFkO7alZ8XY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWhuN_hjUws7d8GY6N0S-9vwDmp576w9t15-g9Mreo25A&oe=6B10630B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-lhi6qCFFAQ7kNvwFnxLtc&_nc_oc=Adp0kZ4GC4BDm1kNAO2GzSAC-ts-dryyTCWNsTtN0xG18rmKQKMJmOHIiXkzALj4dHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUv-K3qjktRMDK0fQapIjl5nB0M53UR9OuJ8YXf7VzsIw&oe=6B103E8E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
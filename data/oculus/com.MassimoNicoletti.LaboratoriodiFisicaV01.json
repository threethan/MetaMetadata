content-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQKv3ySoaEQQ7kNvwEr_MZJ&_nc_oc=AdrGAGE3pvG-2lIpTAFne2arD-OjvmESxgUGLm_FFO3gLcbjUgFlwnim_R9F1DD3yWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p1xSJFqBKgLA22t82OzE7Av9ZznBpmEjyqQof57HZVw&oe=69F4ACF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NtX20osl_oQ7kNvwF44UMz&_nc_oc=Adp-hBTl-rK0KK-TiFeSEXMaYiIS97Yv-2XwUdF0hnmPSX1DhHLVewW28sRYEjjZAss&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HOThrozCB1K3AUwLuNAYxuy1m4O58lmRjBa8lgZL2Cg&oe=69F4C39E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5g21z6XYGYQ7kNvwHayZbz&_nc_oc=AdqfFM-2-rP3Nqfp1nqsPHshVyK4tCH81fhhkZH8IhK7SLwvImzviqQJ5k_--4ZMu-s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25KbYmNhfVrPg4by0Hvdem0AupfiTxPVMp3rWOrRfZ3w&oe=69F4A4F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gqsfKFZidQQ7kNvwGTTsLC&_nc_oc=Adqf3exoNInYtGhfHFAuR_vd-gQ18_3E_HEVfHlaUdDvuAp1IqvZrAwJygl6gwSFPDo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1abr0iDpcc8U8yV2PjRlkZxz_WHEQ0Y4BXcX-kVV1KMQ&oe=69F4B87B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsVkWW9hN2EQ7kNvwElRjZq&_nc_oc=Adpf0uLBVyvuPt_tMlPrDbnQFyMLjpeex10JHbqW60ogc0_a2JV1YoYmH-MneWESDBs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ArcvA5SHBO_Se0k1MqppxVzF-zNEfbIJkKQYSBDd9tA&oe=69F49CB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&
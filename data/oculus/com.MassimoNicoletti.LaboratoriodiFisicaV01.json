hhQnG3CHG0swYHss7WKcf5CNyITRevSZY02joVxg&oe=6AE36CF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YgaCXEqBmYQ7kNvwHC8qSz&_nc_oc=AdoM6RnwSyb_BhKllw-aqbme3nogwXRrA_WNZd49hemsND9zwzF1_egaGggEo_OgQns&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdbfiyC7y3om2KHsZKPUslybpD5-hY-G8-rRCnE0fF8Q&oe=6AE34C70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThcxSPFMbeEQ7kNvwHX-LuW&_nc_oc=Adr5dv5fweozKsjwwNUen2AAbJH5b1IBgR6XPoeis2_cz6jhDg2JcEfd-pyUVmfLcts&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_hVAsPXQX6Gh1EGHkvIOWQLQykeEjcw8f5FDmIB38fA&oe=6AE3631E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8YpXadk2ZoQ7kNvwE7527U&_nc_oc=AdomfnAzKjH2-ZXi0Q3B-O7QYtLpD3UBxu7AZ9CFqYcyxs5AlG4qVW7jqNsCgJ8m11s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyyiDNR3o29dFzvsx0n4nHuHH9cgIJ8AJxrEtPmtdgSA&oe=6AE34477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqD9ILofkikQ7kNvwF5KGmf&_nc_oc=AdpykQrBJJjFKS2MkBqJ6oqeoxPxYlqMkn1ixGDeSUIdkOQomPMQzv09BJo_eyf5grg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMklqa1uZMKowEdZBSF54S0N35ThBJykdPWRbloB9v_4Q&oe=6AE357FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79m96iQqyCAQ7kNvwFNlh9i&_nc_oc=AdqhtSB6NlF0AfAuEnXIfsmEYhZLt5lp2z_ERYtE7JZmZdi7gokGe_sDNv_QlhPu69o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu7O-XQ2wqtsfu0olxv8WhAzNP_0kqQkKzfgcf9xA9DA&oe=6AE33C33"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
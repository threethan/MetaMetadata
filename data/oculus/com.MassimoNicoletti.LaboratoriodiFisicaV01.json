f8yy8Bg8UwCY1bNqIlyk7g1VVGDd2YakrXmk9NVQ&oe=6A732534"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaBKEnXWs_IQ7kNvwGKZGEK&_nc_oc=Adqhm96IHNZ-FAR8aJUPp_ZaAqdI8DZgVk6l4eugxEJCPVXhg-QOdffw_u5nkifmkKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIE9chEta6c-ymEbXH2C54BV548cgaw6aAdyN78Z6b6Q&oe=6A733CF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndxMkIqnhLIQ7kNvwEB9L4I&_nc_oc=AdrmAFA0QDEZXgePhQ_znN8E5WZk7srWkCkqqt61DjUUd_OuSg5fcNIfxOXppeXIjwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExatsTUb_ebylXTj5C6ONS2WqyYQD82WhNmvq2Pa4yAw&oe=6A73539E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfVYBqRw-8gQ7kNvwFZCU1s&_nc_oc=AdqVmcb2pag8y5wXAwsiKNRwvL7a3HBNb0xwB_XddEm1sT4KDQcg65O15wAwxaDajkE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtQ6mJJSuc4-zgSefbdm80QebAkICQdUXyI_q_9xMW5A&oe=6A7334F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw8MJoDQ63oQ7kNvwGZ_Pw2&_nc_oc=AdrDY4rwGnBms9X8qP9s4e1h0LBeWfV6HUhFNIkaLGkDWqjPgzZ2nBIhwZkmwQCBCd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKZtm7fxW7NlRGkB-j9U4KMno51YwdksEwQzB6BEKp2g&oe=6A73487B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6bvMsu-_t8Q7kNvwE7KjE4&_nc_oc=Adp6iD6uybH0WpE1qiqx6tzj5JhRVq4ycKzXp7Bd7LCpH26Pgx9sty1_AX2Xyy1oIgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4OGCtClJmh2ZBRFHFjo3ZHZjO3IbRK92toZBT25Xh5A&oe=6A732CB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
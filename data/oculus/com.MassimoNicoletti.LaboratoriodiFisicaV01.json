xwI4fNpudyAnpVUTr1xkAw-CQ4rAyGlYd54lmx5Q&oe=6AC125F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpwvR5yqmrQQ7kNvwH3O8s_&_nc_oc=AdpSCz294yX8i24_0R8FnqOcT4HIms3VCbXzTFIpvlF3osTsC6DwpzBdvMW6NIlL4Zk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwQcxOlzikdV--ytRm3qAw4FQuj-Lsc1hJseq4XV3vuA&oe=6AC10570"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKJ3WuE6cWMQ7kNvwFGCyFV&_nc_oc=AdriOBR6xfWFbk1mBrEtk6xdP1jH_VWYLCnhrKWX_bSw_41Z6hdyjjqpLczgAjQ8EAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcJdIy_FZ7fe7Sv4_15dUGWR-k1CkxMwi-Mraj9uQrGg&oe=6AC11C1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGwHKsh-sDoQ7kNvwEj4ZU5&_nc_oc=AdpZ5S8Rqj2QZanV0k1PXNrbCj6DS-gZenZguImSkPf9gQ-HADTGPRANHFRbTXMEWME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMORRIVmlDxXBNWxV_5DQpizOpvVWU-rI2X69wWUvN8oA&oe=6AC135B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SJvD6thTb8Q7kNvwF4Fcl-&_nc_oc=AdpHgNsHthInIfu9_gKengKS8DASPmSAjHKxM1ZB5bGlDRUdXtlt-4Y3pKDZk-DOaw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPySrPV7Pgxc-X-ouyBPeaQXs5dvgRjOhUFrLAOcXRwjA&oe=6AC110FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ral3ahghrnkQ7kNvwFI2LAq&_nc_oc=Adohzm_qYBkDj5d6_EGADD-5PwuRnzrofz1vc3mIKVS1mGuUlrhEx2odmDOBkr4SBsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTr997aIsM9ibfmUBOY7vJma4xt8qiO0SGOMNQOcQ3Hw&oe=6AC12D73"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
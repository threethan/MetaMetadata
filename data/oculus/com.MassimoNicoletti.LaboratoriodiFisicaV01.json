_sid=6e7a0a&_nc_ohc=bViiDzu-KFwQ7kNvwEtJeok&_nc_oc=AdoMH9mu607NZasU4oJHVvxteHlMJLgVGwrctd0kQyOQFfB-CCRaUI78M1V-WgXSxVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlqrtSf9LB1plig9-UmHL-XWUalNQ3duccBFfVwgLXeg&oe=6B0DA5DF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgWQG3kgUkYQ7kNvwFPlLna&_nc_oc=Adp0CkkwKen2ntxHMpMq3WPc6NQIuEGtxxo_kPEHWAl2zfZpZEQLr7ITLZirN88IpT4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQl9ki_opWnRe9KXID0qZPwkwnucw5FjwD1Lq-2yBM0pA&oe=6B0DC014"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe1zUyr1nwMQ7kNvwGxUmB0&_nc_oc=AdryF5_GRRdbwNpNRWsM1LVqz6o691H7cSllAmBtw5935FM4DynGFiATe2WKdonJkmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRltiMcmJ1q95Vw1U2AO8TD707qYOdsT2BdKnS5WlMxOg&oe=6B0D9985"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b00foknA1G0Q7kNvwEptMpc&_nc_oc=Ado4hwYevnFd4v6hqejLSFl92DPaERAvCP35TX51Ao9lFL7Aosfxb2FkeK30xNvbXdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThdjTN08T14xZiJelBNKTw7CI482HUy8MAFR5yQHTVVA&oe=6B0DC00B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFvPiLj4hFcQ7kNvwEfD7Ce&_nc_oc=AdoZ01_tPQ9LU1hz-Dd30IYNNYdyp6Z4mwx3-elXJoyKfK4dNSUE1rGbDIr9gWXGweo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfj6JgrBFBTgBNz06rLVLFSCbW2ZkffVC3pf40_HQEVA&oe=6B0D9B8E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
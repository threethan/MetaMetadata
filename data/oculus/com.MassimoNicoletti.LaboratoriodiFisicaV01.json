yUJ7Pl9q5C0rt3QAiv-yQuiO8H8nOfbQkT9Rjruw&oe=6AC51A74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9BCDomhC2oQ7kNvwHzyVuX&_nc_oc=Ado2VGfDrLEdKAFxWm6x9_--CaPdUPXq_yeDuzJw-7H62PCYKIjzAvc6oBbDRJ4dOnw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPE5gkvMXsM1IIPUiHnSu63sTF0Kpmyd6P9jooTNPOJfw&oe=6AC4F9F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaiAgQkbhGEQ7kNvwHvYX42&_nc_oc=AdoWqQ1nd9-4l71jaJ3R5EzxpZLH981OevMQ2772fcsuQyPX8WKvsMMkwZGpdXf1ezw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqJJFvI3RbFg8zjUe8M-JLcigFgkY8uoZVOqyM6Uuymg&oe=6AC5109E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PN7FfyQpHX4Q7kNvwHjK60X&_nc_oc=Adr5a1nqpSMSCR_MzDSXUQjxd9vigF7BtkrP8PblXMKBIyYefyFhvKkPFZsZBQFoEdY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTg3YFJTUPeCa1Rl97jkPPmo76p4cyLSaIc-KdRrWQSw&oe=6AC4F1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdCfYwMxftgQ7kNvwGqXmtU&_nc_oc=Adqy-frtnRvhlbNBz50wtpbf9D2SUYU-vnXE1cPPuEEOO6vFq4Ef9AHku2tCRGNqTx4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc5f0m_LUkdRlb0Jiu8Pb3eeK9BZhHSJV9O1f8PjyAJA&oe=6AC5057B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-JOJ9BJ_fYQ7kNvwHV7QnR&_nc_oc=AdqbSWbgOYa_2ggB5bBaxuU-LzDhXYDo7ZMI0MZW1gQoPpUdzoKnqUtBezMWMUL-2wI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL_stJVRy5Qx_lKu3Wnz-PRGXhY_JUDKv1cG3nKaPWNA&oe=6AC521F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
Vr6gYFYPQNEQ6baTn5wXMoDSMu_jeC3jKWxCCmNg&oe=6AE4BE74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YgaCXEqBmYQ7kNvwEsq7Rv&_nc_oc=AdqVKGXtfDlIwVjIHVX2vW47JR482KHfZe4yoTiXGNQBlI3Uw_Fk9gWU6SI4qtd2YCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcqPQ3CZ82mlngFa2RZcxPQARiGeuLqmnaBnr1jqOIIw&oe=6AE49DF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThcxSPFMbeEQ7kNvwFwyDib&_nc_oc=Adog8NpmhVBa9mhsbgrWOIAZ1avVlW2yuKFvc4YauZuCvxZnBTGSrwTEy1AI7-7mexw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzzQwRcLEOzxXHHfPsX2MaVSkj415ovkvEJNDdRjoHMA&oe=6AE4B49E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wzlg4lOHvwQ7kNvwGEB8Cx&_nc_oc=Ado4Kb0Leqpf6rn5FvBAmhobePQLF8N4C1UiFYSgFi2zMQ5UCET7pxsDY0AA6qvcU9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_ECOsWBqZTmOG-BMYOtm-qWgfEr2iimMhVxDXqahRew&oe=6AE495F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuNW9-RwA5IQ7kNvwEgjH3j&_nc_oc=AdpwGmjE87ezAHhgZUcc1rKHzlHrgyt9aoP4NX-ZoKzsVi8J9hD6fFLKiJaI-jmp5f8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSkGqj_5mFXub_a-vyLoGPSW1X0ctc1xIzB2pCBATnKQ&oe=6AE4A97B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79m96iQqyCAQ7kNvwGkOy5z&_nc_oc=AdrLw7bhHSihoBiq6No0vu7H4Eb8oBSWkIGajRpJ2ahgTiRFXKTf0HRADwr28G3fLN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOVnvbUwOspXhV-x9eMBnXwtrhe9buJM_zDxjNB58QFg&oe=6AE48DB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
okQZ3yX6S2Hol4HF8h97JKvgVVnA-BLlzn-6g96g&oe=6AD39AF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3IamooD84IQ7kNvwHMdKbC&_nc_oc=AdqbyIIGBgfjWwYR42aIdXWCAtHbs4hVyHIBgI_7xgpa0nCEVYGYJcicRttdUCElfi0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUYFNT4fPo3y3QoayEknUkuR8Y9iepvLIeQR-8dUpuCw&oe=6AD3B2B0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQk3AaXPnbAQ7kNvwFaEtqG&_nc_oc=Adr39eQyTOZVBbmFmZX7O_ZjRQ2BWpoUFolNH3ceFEImd_5psh0kMYvD-Crs8Ja9SRk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvsp3_F4qixRweo0flXZco0tmxMDy1VPAcLcGG3J1wmA&oe=6AD3911E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SllK9kNSOnIQ7kNvwE53vDC&_nc_oc=Adoz26B3bNW2Cp1FUJrJI1JpiGrN38VW5rMK-rHNGcikSCU8eymRljEYcJIRrqKpvlo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp9r0o2vdYBQLsuGObhXwLx8AyG5GNZ2iFxQT4My2nSw&oe=6AD3AAB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxRu3hJBXXQQ7kNvwEAfI-_&_nc_oc=AdrLoDonEWpMDe6yC1jy_WVfYHzyo7IrI6Dh0qdep4COvyMQl29QH6scwfd6aZOkOlg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhNWedDeFpDt_pAXkt_s_pbIO3obUS5ZyEB6DX9dHkRA&oe=6AD385FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJXOKGhNP0IQ7kNvwGal696&_nc_oc=AdqseaZQHA7BRuQMqpnw89ZeWRGKjK8PhMvhpmB9eweszn8jJKhEyuZVHs8MPzbUUUY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKzORiik1aUAIaIglvqcq57T-N-dkaHRbVogpdOBEPXw&oe=6AD3A273"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
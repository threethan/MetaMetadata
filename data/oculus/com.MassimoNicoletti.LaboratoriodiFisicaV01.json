_sid=6e7a0a&_nc_ohc=--Cb1AsVWvcQ7kNvwFj3rVN&_nc_oc=AdlESRemKqni1yInbdh6_v0p_-vs_XrvGtcf2_YDrqQ7KmPDfTqDnwi_dDJg3b1KxKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft4OB_ZcQxP3HgVGh1nOm1kXgjelFOQIXotQGFAffol-A&oe=69A2EFF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkxKN53VzuQQ7kNvwFWEEC7&_nc_oc=Adm6UTh_96x_frvBK93PLDuRzuezyz_xjvWg-QYCtvnCdL0NC4lVqbL6xcawIxGsVck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKTNznMuLshmK-OvE23cyf729dTWIen3yUcV0wUnwLYA&oe=69A2CE5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5QvYOMS90wQ7kNvwE58RSA&_nc_oc=AdkYc8LNJ0IrdJ1MR8UhIAGYM_Zc0qgQ-MmvLEpRxAVSXP4ZNnMrqUqG4aRBZE84TwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvY_FNYa8ZM-5q2eXW-QTiKDSen41vABB-Fwe1XhxIA1A&oe=69A2E7F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OL8XhnIJmCsQ7kNvwFOcswG&_nc_oc=AdlyJZMLn6OJLNI2kEr4R8aA2We7Y0Mgn0spVBNsb3_R3gNyibP9U0NhQSuqza1-M3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvxBXWdj7fXaojeCpFj7pKEtB_1tsKlUFG5KnR05QpBcQ&oe=69A2FB7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yCU3Imm-wIQ7kNvwGmgJ7A&_nc_oc=Admp9crRJWtcdTsfkTLqcWsza8fQdnsCie30P4TJVfV_IMhOV5UCUn_AWXHd1hcKOYc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAVimACaPxwdvZrTjIMWavR-HUHhTSE0xfuSQFAcTE4A&oe=69A2DFB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVx4O2XjIwoQ7kNvwEAMlxV&_nc_oc=AdnnNZFPSiT4gMX5iia6q7WSaOTLnktboVMkEJW9lmVOXXzZX78-1gRvSzz1nkS6308&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftWjoS_
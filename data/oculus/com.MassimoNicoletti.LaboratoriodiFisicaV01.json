51ZJRd7ZvTHEy_UNYphfdzt1WwHYUgUmCFnMAIgg&oe=6A0F2B74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5p-clSLmpQQ7kNvwEDUuoZ&_nc_oc=Adq4-pSXiC7rbJEGDyq_uw4adt6YD_6zxvwHTsXpqUWnHqv6v1xKVvPa-nZK9-HwlO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kzLfSlIpk01MPn_5qEY9w4AduAoelUf_8CkZJezkeXA&oe=6A0F0AF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngfNJVLeW8QQ7kNvwHSn0_U&_nc_oc=AdrQj1GjNVk4A_hJUBWwwi_bWlt98luxZwFjSk2S2efrSNu1523h-Vpskx0EIVG28vo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af661xivMNi8xxqA6a7LQmibR_Qh4WcrujbwUf7baXXcmQ&oe=6A0F219E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOzqzYHxKAIQ7kNvwF7X0uV&_nc_oc=Adp8tdizcOCknMdUi6Tif_typTH0X4UnksqUIaBcQmdv5DaQbsZtiNE467qLoNmjaec&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UpRF7m_sGdv_iikop6Wovo6nhxWNDFXLgRARm8_IJXQ&oe=6A0F02F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=empBnTWAK3QQ7kNvwG01buf&_nc_oc=AdprYYME5tejONiSSu4N2IV3sYiu4mQ8Kjqkp3T5xpVFypRraqHFECdDBDsJNvVIqiM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kTuRcOwo3HLCOFu0FvMKOud4ad-77QEzYQZ7XKETDKg&oe=6A0F167B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R0M9TXL3kQQ7kNvwECQ1P1&_nc_oc=AdpuVRhkkjDbHfmUNN2mRMLzEE-eANJRMywYcKpSmaV6UaaKgxtiZfYXjlXhKhHngn4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_XPqKtgpalBkaben6c2ATE8AnU0r1-ZnkOlNBK5suYg&oe=6A0EFAB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
_sid=6e7a0a&_nc_ohc=eJxrvYqkPVQQ7kNvwFTcPgO&_nc_oc=Adl-dB8VCDrvkmCyO5rsjMeBQb0dvihsz3gNrHrQ9bpAPFdomkiPJbGlKaw8Yw2jG5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afti8MCxyo_6GRjDdT_cAv5eLgqKighE52Nran8wtCF3xA&oe=69A592F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkxKN53VzuQQ7kNvwE6OBlN&_nc_oc=AdlG3HSwWmlovF3yh1XGkkEXthSW6uvTWkpkpz6GZSRkkFx1O3B8JraBu9ca2ofYwlo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuKmlG50gpNXY_VpQSatwb-rZOGl07UjLqgmanRPpGtxw&oe=69A5715E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APaSNmYRWLIQ7kNvwEC9bKA&_nc_oc=Adn7LM8usOwIZ2hMVAMsJWYsFkcraRlg-IVT90fItz7c9p0CksdGqrTlDjjxljd_hhw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftzDlxpuiKGF52mvtSosWnpEctEtzyURDralFHoQtPYFQ&oe=69A58AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nraRWg4-XlkQ7kNvwF7mI8i&_nc_oc=AdmIlzBfAyWo5yYLOxdrGZpYQXYVPv7CO4ddf6JrKqGluKHt6FFOcG4j7XyNomN2joY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftISi7bIUOggB5QF2Fn2Wpu8Wv2kICgcWV67MFMvmCEcw&oe=69A59E7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yCU3Imm-wIQ7kNvwEdiHQj&_nc_oc=Adn9jJKFC7sbamAocLi6C4fmRO78SvbpXAt1cBjDwmarP7f6XxUQj3FVhZgDmJthvp4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs34drr_BUXifl7wxyUU3SdXdAShk6GaXcjw2cAN4I-6A&oe=69A582B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMTwgC3nOLMQ7kNvwGTrZiN&_nc_oc=Adk8YRAdG7qs9d4iEcSxgpHb5avmNUatDl3zjyDyBNvFoOg3chKs5Vk8T1NIlCoyOgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftcfzHk
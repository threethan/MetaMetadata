_sid=6e7a0a&_nc_ohc=bViiDzu-KFwQ7kNvwEiFib5&_nc_oc=Adp9-fF31YanWT7QiW_Sh6ZIyZ-OeUKRtKfXS6ySuwp9ApnfrzHnicogjm9ngs4pQXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLY6-sULr02EQJDm35UTr4cjy69pA0VXnqA3QocnsG4g&oe=6B0EF75F"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgWQG3kgUkYQ7kNvwFt47LS&_nc_oc=AdrvnJ3ZBBM0h45nV5lnZIbsgn0ao_nkbKqSC5tKKWKOVh_j7z44UK_xAt6R-8I6h6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUajc6wQd397SWxEDsBoz9Q61lUUnEjji21XUzn9OudnA&oe=6B0F1194"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDn2BGGkoEIQ7kNvwGF1EMF&_nc_oc=AdorrkLLOlQ2sKeQk8Gw7hulaUqD_1EAAd7p-VaHm4r94ncGTzCqqlIn4Jc4xOoz5Wc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVa6oNaTEr1qXizzpVZrTau-m9FjG9RAAeE0fPWN1qwWA&oe=6B0F2345"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x3bNdzTTVoQ7kNvwFbaPhf&_nc_oc=AdoyUDjWyorQb3ufjf0Mqfu0MSExaMBT_MnjGSbObC_ZAtCPHIwERsqP-8BQzWVObvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVm_BilpsZSNa59zUJE_wggFhtNscjcSJwpxBK2JIn6Dw&oe=6B0F118B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFvPiLj4hFcQ7kNvwF4AhJr&_nc_oc=Adq8Ro2p6wNJfkOmvg-guzMzSOH8qzxiJTMMtUnF9HdVjp0bI_Rl-IZ6V6nlufMCH4U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxpLcbBWHnTGHBmm3xp3hS5n2X8SKAC212lkkWoPB1XQ&oe=6B0EED0E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
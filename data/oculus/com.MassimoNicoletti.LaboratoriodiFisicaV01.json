qbn5hCucOA3zUZDBtiQ8HtcS90Vat17zEr-Fp0oA&oe=6AE8B2F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgP54sFtdNsQ7kNvwElp4Sf&_nc_oc=Adp0jw0SSNFE7L_s7eUW_2c-CwsiZyKhuFNxJyEI45c5DPt0Y-rGxRVGnw7XPWwUZOU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSacYooNT4Y5JJ7ublTcqiXSOohJQy5gGlP7LUL5OHMSQ&oe=6AE89270"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEaQqfqjsNUQ7kNvwHc8DEo&_nc_oc=AdqOLQhMwG3QFJK3MWarMEtR0Nt4BWIeTdVZNU8E-rvUA9LZJrJ9h6ZkT-V5A-iMKq4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8s4AAibHDyospMauXPedqC0yoZ1rw64rI9_VVt2iTyQ&oe=6AE8A91E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGNXn2hwXfUQ7kNvwHmcP5V&_nc_oc=Adob66bCaQaT3_hcyLrDdaWTKKBPJIF3uLo2MC0vSy55ubT_-uGTZOZfCed9IQTBa8w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSnsmd0dopEkbmeQPsR7iSwrNNQs7zP2QI11AdtKpMGg&oe=6AE8C2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LxLsIMTeNIQ7kNvwG5PFPM&_nc_oc=AdoF3UK89OJr3S_PMI9BEpbAb6wtvMHlN_SjNHBPZc2G1NPl7lt693rw4iQyEDPng_k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUs6bGS66oDmU5ZoZ-7YiiusUyYM8O445kWT7fWApvvg&oe=6AE89DFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td0izQ3keYYQ7kNvwH1Lsxe&_nc_oc=AdqxJ1Cke8gJGX4az6247ZXzlBJMJsLjP2fL_6zRZYDraTUvYCAcozygbI17SotO1dY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjLMjEoKWUHQ9fUH6reScKJ2BFNpssDOI7yjTwt1e0KQ&oe=6AE8BA73"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
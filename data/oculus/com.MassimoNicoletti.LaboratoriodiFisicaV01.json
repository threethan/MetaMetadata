F7BlOoEEmPBYQb3CQZvXFNoUnVH7Q8hNc8z7_Y-g&oe=6AB699F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg7ylVzRKOQQ7kNvwHBfniR&_nc_oc=AdpCHROKOD2ueQ4xFzlzvgbtMCTCoobZapZ_VRf7v4wt7n7rtepHKVIZSBn1CQl4Zl0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxPtlSLt9uliFVajToIYMuvFZCPbaciId1n2wkm2IiMw&oe=6AB67970"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3vf45hoAbsQ7kNvwHq0TLI&_nc_oc=AdpSfYcIONtzQN04Fw3YgFIS-UCCDbB9B8BWOmWhigHSnbUqniV9GPHGMGV1TzdIXLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO8rUVZQOfOgbStEfMVKN6ZjAB4-xTKDeMAZUgajUSHA&oe=6AB6901E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QU4IKTQj_wkQ7kNvwFjd8lz&_nc_oc=AdrTd9nh_RdQeCdRWV5h_99g4VbDX4XvUZcBV7OGwvHL6vDH_8gBLwK8bknAMR14j8w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvhOCY7K1xUpa5mPBnriTFXJidf5fJ8ueAB_DmMFg3oA&oe=6AB67177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGaxgfovPlcQ7kNvwH4TnfR&_nc_oc=AdqPfHeb0UL5cNrTE6hQtiT6tMf223EFb8FoA-TLOimB1xoleO20zbfukZ3_dO3xCbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkeAMX6MdcVJR0M8bs4W2_uCsNsQoaGSrrpZYC814H1A&oe=6AB684FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgJR-7G51gkQ7kNvwHMYT_C&_nc_oc=AdqlRDvbY8nAv3YOYjvA18b_hXjUzLGYn-tmljAoR4l6HuLw-gzQLqZyDNMM6LQTriQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYQlkE4S8cZ6_YVIslHas3KLJjTx1goA0j6uf5-N32RA&oe=6AB66933"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
XEhNjuiWts36-X3i-LwzIjIR5WalQbSY64k1bSXQ&oe=6AF9D674"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN90DEc-GyIQ7kNvwFfX6SR&_nc_oc=Adp5ErEZpFi0NMVeB6YmKDx2xIStsf5CCyUQPDhPKSh6ewXNFB9DsTA-8aMxhG9p6s0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuypO694oflVufRlAUJKO7zV3RelXCsvONlS4taM2uSQ&oe=6AF9B5F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cp_WsNx-pFcQ7kNvwFpWvYE&_nc_oc=AdrWaSr2bsHVtll7urhNdM62ot8OE7DPvRrMwn4v5t-IFXOV31hxJoBluYHSStLZNPE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO3VU8-RQNOlxs_NveorJs26rPSLAzKmEYKHhQ1NdUsQ&oe=6AF9CC9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW6G3xK3xG8Q7kNvwFjcJ3J&_nc_oc=AdrX0pJQ1E11ZKtTD52YzEsv3pCfZ09GUAXuW0_uqCVsQadRUtVvz0H6wsKQ4pMQGjA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz-fjoI46MWn7EY-s2kenDSnDEefulT8RjfLtLfmdSVQ&oe=6AF9E637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-aZ5T9HVZEQ7kNvwHhFMtw&_nc_oc=Adp12HKFkfOhVNiCIPBM8PLGS3Da_P0TiumttQR6IQTZOb9CZMqPXIXWOSVSXNASjBk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYCYkcKWnPghm4n6r2mO00mAVoFpa_E4I3cFNowURxBA&oe=6AF9C17B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GSUhqd53a4Q7kNvwEsTJbz&_nc_oc=AdqU1fO-egusB9wSeE7JgSz0f23lQKwP8nnyAl7SR1KurfBg56_6snhpbMbR4VYT5NQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGsvvx99s8htuccfeTKqiZVJu2cHvoa5gdyB9oTrj_fQ&oe=6AF9DDF3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
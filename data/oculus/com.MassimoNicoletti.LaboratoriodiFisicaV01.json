H2IeFrb_Dnjq-PCGaRhLb4rmWSP6wwdhn7j46AjQ&oe=6A6F30B4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UwPduFwMMQQ7kNvwGywnIN&_nc_oc=Adr7wFCapflFf24lFxQutJ2AKQjePBrZ-86cjXlMO7k0athFHMH7u2mGRx4zwPg9OKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD00__0HNLnlCTkiASPhnrfb7Y8fbXZXGi5vGdIHz6Nig&oe=6A6F4870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onF4MhfwKRsQ7kNvwGRLWL9&_nc_oc=AdpF1Jjr_2XxYMA8-GYmBwR8q3-RRpdTrsivyljBKaYHf2ZRpvI5kGW3fQJmwYLov8g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUInB4W7kP6f94PCST8ek5ZIwOlpnHoq5CsaiqXtpxAA&oe=6A6F5F1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwk--JuBOFYQ7kNvwG-YBEZ&_nc_oc=Adqt9vgUd7T5EJr1-QmVk86DvxxgluO-_SQCAvwd8-nkw7LO50tLum5fGVaP0di2uQE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkc402M0gqYPdM4UQTxZeL8GyQiYLLaSNv8PGQHJsLGA&oe=6A6F4077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7JDLLvngGEQ7kNvwErPavn&_nc_oc=AdqZE3wdYpRUTf6G8CG5IqcChOAS-3c4AG-qCrTEMB3DcjpWoiEwtwWui6YOvNTXyZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzxAOabJeoBNlVFk_Eq-01hDCFA3bckHCeqT1UqBFU6A&oe=6A6F53FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51VIV0JmyzcQ7kNvwGvMdqF&_nc_oc=Adr-ZgrS5OWnqHczk78t4PrF-r4GmAWKbX_wv_h0Toa-2II_-qccOucsO_IQlwMNcSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4NCqaIJ_XDR379GS9GwMScL21rYKnLdhIR6H54i8EVg&oe=6A6F3833"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
vg1UFdJtR3mvtJCAvLQu7Gmhl-JcoA0viSMxMkdA&oe=6A92C934"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdyGtme5E2gQ7kNvwHlIyHF&_nc_oc=AdoImTyGygOJRIEzZWVZDUahs_kbScGlZjmtOa23VBX2NQ5A2H5_dgqOUmf7u36fCvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzIYqVWKZy7_CtKzc5gJYp-vuracO8wJATZVm8W24jBA&oe=6A92A8B0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vROchZEg2LAQ7kNvwEZpt11&_nc_oc=Adodg8xdDjJ8_uyGo6M0vXWYf3gCD-6VcKQSsz9mXLF2_G_dPwOVyVDZPIgERhUEUS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPojkvjrchzPA2WlL9xdYiSuVRBujHD9oUE1VXzxf2TA&oe=6A92BF5E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_WHrVFxO2oQ7kNvwHRgVaM&_nc_oc=AdrJD4XM24jR_oINYPLlJcvvMaNvXBHivBw9ZuJINUMAdKj7ln6IPlUWMlVt7tqGnD0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLAIclun1dIluYYJqKLi5aWHTjCGmuaB448BsI0z1TRg&oe=6A92D8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDBhg-eOoFwQ7kNvwGAmqe-&_nc_oc=Adpfp9Ix8w_zMrYL2dHjRnVizyo0tQzKBwp_zmk8NNgaNEhdJN6_1AyQVjHl9QG4wsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrC8_wr5yE7r6YkE9c9uBb3xTevUDbVPL2xJHK1XKYvw&oe=6A92B43B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y62uF-8KoWQQ7kNvwEC7c-J&_nc_oc=AdqGnjwcXSWfPRh5_QYhV5h0FQi8_-FCQoQTk6iszWYq2E8gCfdqzpVThVIEJz1_HzU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjZhBs_f9fodUh4cw1JIOpOGS6W8E8JyUGgQHxS0-R-A&oe=6A92D0B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
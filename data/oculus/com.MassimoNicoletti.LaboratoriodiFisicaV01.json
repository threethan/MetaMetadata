sQiYAWdko6WaHet9ryZyeCTzTHXgAAfqxhMf6HPg&oe=6ADE26F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NP3o2aB8fWcQ7kNvwHmCmEQ&_nc_oc=AdqJgfI84jGXMhtTWv3u1B1YPtVzNtxtNuMqxJ38U6nosD0s_tTEdTFYnIk7QnpuyIw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_oyBXF5yTQFxus44OvQCgKopjRe5VsFaxTNf8jMo-Jg&oe=6ADE0670"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sunjuabqHjcQ7kNvwEjtpng&_nc_oc=Adouts1vaU2kfG1SZLtVsfq5AaAiP4v13YcO1CIiZKcgHBd2bjIHDhSFClMfmXZ_9zk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCBK4W2rjpFwKmkkOo1qeKa_bAiSCdBTMQTQCMeUzFnQ&oe=6ADE1D1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmXCBu7zyJUQ7kNvwGB7PoS&_nc_oc=AdoKZoRTLrNaIhOGJK_oUzLUf6pE2qTu5i9QUxcdivcrUWBmUAkdTbxu4ZEbiHLQjlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPemaNP6QiIgAJKfCIsTpLVId3ngFvPgCHQk53gpB_CDg&oe=6ADDFE77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtDG7UGVN4EQ7kNvwEO-hHI&_nc_oc=Adrx7uPmaQ7lvyc0rkpT4wwqyajktPF6TjcSgDn0FlW2J_osCXes9-xHGq8HKHr-LmE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa4FXcEIFVp4FKWT50BCUzymELC0Mm0eqfm_P3J9EeEw&oe=6ADE11FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HJojyHq9PUQ7kNvwHP-cRC&_nc_oc=AdrfhVF3eZvduxxnleMfrY8E7-3rEwNhlGCIx73Xng6ipdVb9_jClNt_tCLYrnTpyaM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVW7dE6qzU-iLy4FAK24PkfEDbAHVrmjAhkwqPCAbu9w&oe=6ADDF633"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
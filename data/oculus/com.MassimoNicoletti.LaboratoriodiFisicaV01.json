WB58fSNCBIzJ1NfCCNgPd1Leh2S5oGVYiAMOopfA&oe=6A21A074"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jYxBVMVkXYQ7kNvwGqk_oP&_nc_oc=AdqRLrY0QliOQcA_I4Bqq7qD5UvF0NMQcuF1ewfRHUHfAaMTVut_seu8pue48woeNFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IeIKNcWlR2IhqF6-oZIy5bavho70wyge1X_mWR5IAew&oe=6A217FF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQ3usox9CYgQ7kNvwGh5o3k&_nc_oc=AdpFN561Xt-DRZZCXdT3wGT4n7cXhI93gH0gfg3zsQyHJbTGbTBOi0HpEblK1u8m0A8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ajEaYsc-u1npZNnLV4G4pXJlFuRW_v4UZr1EKH9auZQ&oe=6A21969E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gP9p8YlwsXAQ7kNvwFKcioj&_nc_oc=AdrH7LJelHrZD2OJ9L8X53aYmfyU6e6t1IdHscgLg9g6hNytnQ96E8Tk9hSp5o4JzSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89XN-ASw8LGMZHOB9jVYvUU62IL2zKVkCsuZ9lQust0Q&oe=6A2177F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0st5NXTPZygQ7kNvwEMOjjf&_nc_oc=AdredtDxwbNSjEZzigyLqGyeC61Jm62DLkjsTheuxeuO0wZtAYWLFhqWEJIs4r5logk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oKYGt5rnvXiaLdGfymw2DBYGJid2bt7z4wfm-ifGnqQ&oe=6A218B7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb4prSwtzrUQ7kNvwHoMNk3&_nc_oc=AdrZDf1vGOR6_favHB5y9ERGtwTrJ1WBXrESRKf39CGqrJvXsCCtaZVFohemkpUsLLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6WmiKrv-mwjP8LJufWIxs5_XaXVWLVtsfa-1hFB3j6A&oe=6A21A7F3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
WhgInm5qQ_-xER3D1hd5L_MlVeOhwMrt1BrIUDYg&oe=6A0C8874"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5p-clSLmpQQ7kNvwFHTy_F&_nc_oc=AdobutUOxCFvofvUQiZXEJ4PMT3sbnQZkd8AwdQLUo1erdVx6MiMMkOwEvNDyi4asNk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eqnFgEirkyLKE6rULLb9ChQrMB1rSbSRXBNIhwzyXRg&oe=6A0C67F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAzw7dACzgkQ7kNvwGxU7KB&_nc_oc=Ado15cC0HOXE7Bk3xJTmWK59Oszfz-CuaOSCydCIbIVkNaHEWh_g7-FgcCeqTr5t01k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ohM_yWkDj8RbqFVckt5U6pbJAe9uMrFyW-QFDrhXUBA&oe=6A0C7E9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0uIm7v3DgUQ7kNvwGd-I7E&_nc_oc=Adpn4hyzFzCLnQTSz_tagh5ZzOsClPDjtM2fUmU4y5m65ywkbFaEp9YgLA3tDNCtY7E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af688nuPIM3qFQANpqvzzwe6RPn1mL5MUmfMFIGH8sBaOw&oe=6A0C5FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZewyWWZcvjMQ7kNvwFSmW-0&_nc_oc=AdrIl8q_W8PjjllPYYsggQTFKGMUmukbZIL_S6QtEX_XKClZl83Is51tLZnmQhF-Em8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lD1-aRKVO065wgw2PEP1NwWywAIThZcn87849MlvUaQ&oe=6A0C737B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXE9KPGvrFUQ7kNvwHYrMMY&_nc_oc=AdoZYBMT2QrCV1jViq4imdT_nEqubbKNbNCGX2H_8qWFrB_biV4zdASSA_wxMpfjLtw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qHttBGQiqJBtzoJKxs24QWe9OFZJTj89wYqwhO2EckQ&oe=6A0C57B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
M9980oN78nKmLl3Waao9dzl1mqCbICgg9B2gGK-A&oe=6AEDF8F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWZS36Y4AWIQ7kNvwFNlBxx&_nc_oc=AdqBUEQqyACmPMIj_UZ1RjBFAAo8s59d-Y6CJOt78RGVYmS_X03eFnk5VIlRRPy-C78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHx82HqpGNlS_6wYfeg8sfOU85oobVkvBXvcL7dna_kA&oe=6AEDD870"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjFJ_3lTJToQ7kNvwFlAUdi&_nc_oc=AdqpDFYDfufGSUcL6cX35SuKfk7qicGWie6ceI5uxrNskBSYXvACjBLcCFCitbGVJhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM_d3ZzXMEPq2qn-xJubZKesY6iE0xHDh2PbbcbKtQYg&oe=6AEDEF1E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yWJZ3Ul4jsQ7kNvwGFLdO-&_nc_oc=AdqxbPHBUQdQOpXH8EFb7VFAkdkPGGw_0IEXoqm8xNoDPGzpYEaGK0_oE_p1M1JKPOQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxAPtkNlRzvpIpjEggdcXFxZwItI5mSUgTr5TI3rGBnA&oe=6AEE08B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ksnj3Hr-EMQ7kNvwEIG9ey&_nc_oc=AdqgYMmei5qOldgrP671QEDEWlxkUrjyxvSywABBDGsNckybl9yXs4Caw7FNcTp5f8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs3c0BwLpQlQ9y1bEuXALixvCST_e7mO3PAlCL3BF39Q&oe=6AEDE3FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ovfj40b64egQ7kNvwGlarQy&_nc_oc=Adqg-fDcRkOjOKc3jWtr7rYKIDb3aOZMcG0eYLT1zY0YUaHwpnzyNJmtcfCURCQITFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5G1NpbP2Seu1pszmeo4mF4Atgp3xYZ7heZTZZGOx90g&oe=6AEE0073"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
hfDJXSoKxip4jb6fX89P4LbJmR5uahN2y1HZQpOQ&oe=6A69EAB4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq3LRoDeLAMQ7kNvwE_4p_z&_nc_oc=AdrY2lMeZ2vkAbfXy5Zs4SzTRFh6Jo93UqTn7axr7QEktD0W2wKUADIMye6Em__oDG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPXD-_eaC4U7g4WpP5ufyglVvgxwhNRlMYOH0Vs2i-wg&oe=6A6A0270"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0OfLxGWL8IQ7kNvwEovjJD&_nc_oc=Adp4KmkI0SVJfWNVgAvLw95lh1jBOtQ3hfQhPUStrw0rl_XzV19VFulxpYElDZK5ZmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoGqXDLay58qN96tsjDdAngv8iG1EI4-ncyeMKCG8hcQ&oe=6A69E0DE"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjTcazTN77gQ7kNvwGDadYH&_nc_oc=AdrENzWUdfRcQ_liCQ__mHJ48Jb2qD--yoQ4tGsjFNe6AHHqLoys70Pb8bYUev5faCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0jUhZHJDHdiBmEmeFkPvkboIWFyP2fdZKWZ9WB3cKXw&oe=6A69FA77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qigrUapNcaQQ7kNvwFaD58W&_nc_oc=AdpMTlgSZ_wz39m4zJDHatQeKu-yZgAcl5yuIMNvpcR3uujz_nl024VnsuqIRhpcmqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPG3Gjlux-g3qoiOxWvMkbll1Cu9I09NsrZmKQPhROEg&oe=6A6A0DFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGZva5wXjBcQ7kNvwGt541u&_nc_oc=AdpRNNT50qgcF-LqCixNwgdxYZ6tvxYgZoMOkfs44Y4qPxDoVRdjc3EG-dPcAI8Wsbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq9QXC3TdqbDCieIB1mQaSSON5sZPvnKRK1Vlcs0kCbg&oe=6A69F233"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv5Ze-Px7Hcs-FNUheV8RhKkmW9fMLl29LluHgO0UnSzQ&oe=699863F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7AogGJRjJoQ7kNvwG5e9jy&_nc_oc=AdlU4SKx6FWO7XS0iZxJ9iYWd-XvR6upyVwbdv-UyhRF8u52IRSB5PDxEBw35L9oSxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs5bxImURZXdzNu18k72zrt42--JrO_FS1FgFP67vRuxg&oe=6998425E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18kJfa54_14Q7kNvwE8eMuV&_nc_oc=AdkzIvusq2skNaoAujFIi7NWq5pt8DGhby5dXWNu0ooIS8MTEr-wKCV1SH7SfhgI1yI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfudWoAAIJRBdaEWt-ex6ICvo7aNlvnXrMpRxQ6xOkBBzg&oe=69985BF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBfQ1CNO_OsQ7kNvwGnjpQy&_nc_oc=Adkh6aTcheMKCAjuIAH8fc44styGBZVDe0p7Wxe7H6ui4P4Ard3c-z33z81_6BmOj3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuSUREXYew8RhzcZOjhxVL4V2nhWPfUpnEWay2I8spBjQ&oe=69986F7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJ8TcAjhyNYQ7kNvwHK1GjJ&_nc_oc=Adl8JNqYxgU3Rrc3WiDV3zv9L7lkUb6hfxAisL7gD5fver9urV5MjNDZQtxxdxVGoEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft7-2oxDLvSBGxBPCWYSlU9_4tc9uBnaWVUJn1TOhg83A&oe=699853B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75207237_2349279261917619_1338457594479995501_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kq-D9BBVnIMQ7kNvwEzZASF&_nc_oc=AdnS7YZP_FYqT5Vj3c4f4FLXv_EHgbqzWLa5sGOmSnCezUUx2Jx_ALdspop72GADLxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftRU9D84a3v9SKlFcMiRy7BTz9H-O9X99bryn5Hw1lkNA&oe=69985C33"}, {"file_name": "logo.png", "id": "824023329129718", "image_type": "APP_IM
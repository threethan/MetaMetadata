k9slklKijkAlb7ydLuNrJOqKE2vClqmV2NFDbspA&oe=6A8AE034"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBD9gYo4WisQ7kNvwEcZB5N&_nc_oc=AdrE4ekSATPtNH6LZukGDjtmSRE33wSmok5kA22Hvp4x92mriqZCMYQwGfSbSXG2qFs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyPxUGlFhauC6X4W644b0ecGf_TEOn-y-PJxvGndYIrA&oe=6A8AF7F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nop-UZ7DyGYQ7kNvwGFGRco&_nc_oc=AdrE_YY73etU28LiSff5gop88xbYN6IpJTLEgx52tW16jNp6e0J92azugjwn64J2cfY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdCzl4QbFBXqpIGrvyZIWv_RkPlt3E-gw0vAaVKwGI8w&oe=6A8AD65E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JSOU2S1LskQ7kNvwGGs7ec&_nc_oc=AdoABb-9aRAb0PD6rK-KOyyh1qXv8_9fhh-NxX3i6Kx73O9UbP_E-XVgiU1jWroArYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLJ_5U1gqUuDePhaa3oU2O3JLi0lHnZsJar95sOzgdug&oe=6A8AEFF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydAiEjmVvUoQ7kNvwFnFeJH&_nc_oc=Adr-9zBnI2CTzgVQU3HpaQ2rKfJhlbvFXVNBQ0-KZguGCyawq-pCtm1vzf92xU5QTdE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoEfLj0i-X14n1-2Hu7PKY-jVyp3qUWM_Oy4y7Pj_dNg&oe=6A8ACB3B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V7c2d1tEjAQ7kNvwFthPWB&_nc_oc=Adp85vAvHvTwInHBCzHW_NHW8Dz5eLK9Ct-XjHUTxBBPcaXyGXCqtOMIHNNap43jtUk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNPslGEkQyOokRbyQPnqirhpsbnJ-JgdM4gA9jUGtVQA&oe=6A8AE7B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
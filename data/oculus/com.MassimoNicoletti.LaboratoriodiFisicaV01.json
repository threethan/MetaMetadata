RN2XLX-UqOB9Gz10pQmg3oQ8xG2o2LuhOryyjaBw&oe=6A341574"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM6_06-oOGgQ7kNvwFQj7gO&_nc_oc=Adpc_PKRfUIa-o7AJa6pnnWbs93LCNaIlE5BhzmGKKlKcGJ8BtXqaUVF7O3IVfTvjG4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sf6ZN04QMXQem42z4sVzex8YnI0l82UoppCw-AFOgeg&oe=6A33F4F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KjqLZZG1yEQ7kNvwHwkDz3&_nc_oc=AdpPbx0fQYH6C5MbMtADqmP7vZ_WPhgDhBw0YPbcIifLnh66lnHjkpzk6pURDFmcGWU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lwLTdkkBoPAvYFhUQhRSwfnCfstOmpfLItoZ-XBEX6g&oe=6A340B9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDz3fOnqpRIQ7kNvwF2NTWK&_nc_oc=AdrAgQ_BY9jrcYzv2Agl3MJhvRUsHIuDzuAGXicvN87x2woMPq7BgOD4sXVM3NPfwyM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ega4N33rZH1N_84DwwqYDex-ZbNRI_XEKnLa3f486Ww&oe=6A33ECF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI0pS_-WUPEQ7kNvwHs1Ehv&_nc_oc=Adqs4kw3YFQH7HTsv05AXKm3m9Db9sRUwC5Tc2-hcU7HeOE-Y2P5r22Cx3-b-gJCe9M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rIj5d0avbFI5l-E8zlZbVM_qC_UCtgIBaQ3I3qGyakA&oe=6A34007B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BDsUvzYxtQQ7kNvwFckSQy&_nc_oc=AdoDzPUprn-j70aRX0ujEPkzLqn6DT-nPshHB4An-qRxNDNmUqfZcz99Ms8B_rEW3gk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jrodHo73an403X_6TTBpxOY0_VQPjVr6NMokJ_FkFgQ&oe=6A341CF3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
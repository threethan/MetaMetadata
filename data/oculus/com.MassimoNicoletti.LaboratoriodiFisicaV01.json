qQt1s0myy1pU4lYwqul-dN-LEeH6MLIYpbflkhPw&oe=6ACBB1F4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzRCpvqjiKIQ7kNvwEGHkt7&_nc_oc=AdpoQNnipkYADvIsa-Hg4CUe4vPjRu_40hm5VkHQ0F3R4QRSywtzBvOz-Rbh99vnZto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6YQARjlSg2vp4V-a0Qh1se6p7lc9BXB5miPrDpk_Ncg&oe=6ACB9170"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJSZaSPUGREQ7kNvwGUbSMp&_nc_oc=AdphMJfQxE6wW_44oubdpqnmAEqtFBkNEp-MS6g8VmRsON8F8adYO6kYXorNfS9ax3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQfVK-bMgFkkWeT2mf-zbr_E7X9KqG16SkohtPlYVzhQ&oe=6ACBA81E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRJpMyq-udcQ7kNvwGz86G2&_nc_oc=Adpuv-lR5nKx5FnfUtTtcVDqN-U3fw5FX_MBhaCIIMmgSwRsG1eQExEIEkO0F7_LiJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOAf4Dq2DZXBhIfuoimj1SlJiPgp837yJTOMeAs5lgPg&oe=6ACBC1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa5yIO0eOGQQ7kNvwEXfBez&_nc_oc=AdpuAKysyFCKL-oCcC_OYZJ-6-FAUxRCxzgnDs1tjupzYdcrd6f9S6V1-2CH7hWjo2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTxW4Z9YbnQi3kkrK8Puc8Q3ZZ3ie6Zhf-1JY-gNCP6Q&oe=6ACB9CFB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zld6jb1qdwQ7kNvwGcoHGx&_nc_oc=Adp7lnP-l-lORwYewSJmqPo3qs11KizrqO_0Gu_7at9l8vMNwKd5r-RkZWxCUGgwW5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo03m6pO8gzPCRAFazXgop9xqMnCAMSis9CyFZvKf0Yg&oe=6ACBB973"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
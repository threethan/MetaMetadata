sSqeoPOVaA_flqgIrP2Lux69QX4EOatcutFW0s2A&oe=6A2ECF74"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOrAbhQeSPAQ7kNvwGHVXGk&_nc_oc=Adoq2bqaZSBUJEuJv1KT5Ka9nv8EBuUPJ5HNzjS9lnkuD81iopabRXvhJERbBCjtykk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mqcx2TuzzCY-wSZZLgbc5Td-CK3hVadO3HNdp9wjkBA&oe=6A2EAEF0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llPZP93XkPYQ7kNvwFSUpud&_nc_oc=Adpol4J-GKAaFGVoHRy9qe6Nt5V6tQWaPYJJRqooPavpeJHlCE4OXBcUNZgymhi9nCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8fvuUMy21ucYOKgC3dEu2aBZBunEcaovllmAuyhD4dg&oe=6A2EC59E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoY6sopy0PQQ7kNvwEM3b7s&_nc_oc=AdrdfaSet-dW7PFAKilC2GJ0BclDP3vK1YfcVNfvfPgej-jOlfhQIxu3r1vRct8GsWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UbnDETCPwnDuQ9FvAW_K2W1ocAmg6OJbzOZ4OfJDQzg&oe=6A2EA6F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bguamyKuFdIQ7kNvwEl3rVD&_nc_oc=AdrVOBpc_-D6Xn4RkEhCib7BUL_8-QTmvA1evgAecM8hNdRTjfMMttfK6sZ7qr6NWac&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IYuxcpVJJ8pqxbA_ICtWbAFCNfqqKrYUQ90e0UAA1oA&oe=6A2EBA7B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgOR95VsOFsQ7kNvwEg7LUz&_nc_oc=AdoFG8C0sbpYp-gehN1rNnvBhItz-cQgM3fPDNallAMtko1YE_TB3iDdfJv6ZdP1LiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gG04kMTiejJtZhkez67nmUuYZQAPPQVMVxn9ww0c04g&oe=6A2E9EB3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
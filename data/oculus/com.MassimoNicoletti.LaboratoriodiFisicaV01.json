_sid=6e7a0a&_nc_ohc=r8DSsDrzfAoQ7kNvwFr7gK0&_nc_oc=Adr27SMkD3D4OxcolTunfMLQAL1Pir7fWCoZNrntb1iLmQHpReAJ5ozgkAJl9HgUsC8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVNRvApsv0t7K1mpR5LWMV4g9diDiNKFSOW4NjNA8trg&oe=6B05BCDF"}, {"file_name": "screen3.png", "id": "583484247195241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982675_583484250528574_2622377565358111225_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILwvOpG4nSQQ7kNvwF3AOde&_nc_oc=Adrsdw2TNnzlRNgtvzgisYYdoXeV4dH8VnGo9KU73sP9qukxS4X9TbGs0yRRkRhpC5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNVD7TajUckkC-rnk-glwLuZPuHHeetsUzDSkaqLtSuw&oe=6B05D714"}, {"file_name": "screen4.png", "id": "657930592885186", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982569_657930596218519_7527229484032525779_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfQlnE4nYmgQ7kNvwGd5Yph&_nc_oc=AdpdeEl9gpml8nQmQPLnj2Vq8qX_2IZusZe1Zi91jErNZ-oA71m7xjDXAb17L9Rbz2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGwAoiGqFJCHo3d_SeAqYOpeKUa6sg8wCmNUBcjpJW4g&oe=6B05B085"}, {"file_name": "screen5.png", "id": "308900085033231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974534_308900091699897_2491196977721724389_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VtdoJe8_voQ7kNvwGAaZbK&_nc_oc=AdqUEfFPb4p1wWai9xBDBs2Zdk1holOBxWRwezy8c-OS_0AQTBgz8F48Q_pEVQKeNv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfYzxGipTxEzgK34g3ixm0TIesu2pgMujKQ1jM-qRgjw&oe=6B05D70B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen5.PNG", "id": "809213897423348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572941_809213904090014_5322214095344011056_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCc202m36OAQ7kNvwE7BI_7&_nc_oc=AdoeaosJjdZqcsD8lthbl6jmg4UqvH3Dm7PltHfkjjIG8t41ryIOpvi1E8vZrO4Nya4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9xeWng4Qv1-1rujlTjkxJldvZ5-CbfqM-lh-k2WKa-Q&oe=6B05B28E"}, "display_name": "Physics Laboratory ", "keywords": [], "long_description": "I am pleased to present you the opportunity to integrate the \"Physics Laboratory\" app into school education.\nAs a physics teacher with a passion for educational innovation, I developed this app with the goal of enriching student learning through the use of virtual reality.\n\"Physics Laboratory\" is a virtual reality-based application designed to work with the Meta Quest 2 headset.\nIt offers students an immersive learning experience through simulations and virtual experiments.\nThe app aims to make physical concepts more accessible and tangible, encouraging interactivity and experimentation in a virtual environment.\nEducational Benefits: The app offers several educational benefits, including:\nPractical approach to physics concepts through virtual experiments.\nGreater student involvement and motivation in learning.\nAccess to complex contexts that would otherwise be difficult to replicate in a traditional classroom setting.\nThe app is constantly improving, I'm working on new rooms (new Physics experiments).\nI had my students try this app, it was a great success.\nLanguages: Italian and English.\nThis is a DEMO app.\ncontacts:\nnicoletmassi@gmail.com\nSome videos:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo", "short_description": "You can practice in a physics laboratory."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/11-jjY52JO90bO7UpKBkMe-IzE81NEAJOUPjcq-EUNEI/edit", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://cartellata.altervista.org/mfei/_private/informatica/LaboratorioFisicaVR.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
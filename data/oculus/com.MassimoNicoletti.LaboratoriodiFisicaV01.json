cSN2FjYYKRP5tT5Ulpo4Z2ADu5pw-mTp9EZk3ddw&oe=6ADCD574"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xczBuKOKKGcQ7kNvwE9qM6R&_nc_oc=AdquuF4_RD1U64ulELToxqIa3CjQJZ69K2h03MlPHQFk6IMvl8i1a9PZGQ0aUabcLX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTj3TS9UhSuBg7HkcSMm1Yb8hHLJH_r2BjEVgQ3sM1xw&oe=6ADCB4F0"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sunjuabqHjcQ7kNvwGMpB8Y&_nc_oc=AdqMYHAdk3oNduKvb_iz7k523Yskd7sFMGqjX36P2jfQKwEIZaMv0L_CDjihlTi6ia0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJNYfBHpGV6fyfAHa5q5tr2ZMxGcVjUoupS83M6pxh5A&oe=6ADCCB9E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmXCBu7zyJUQ7kNvwF-_zpz&_nc_oc=Adq1EwLKfOHj0Ym2JtDH0MYdzWV38c7UnEFOVvgIlaHeZtYJRjHWkkCmuxcQQIEEvlE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhiCB6FvTGR344tF-p4SItlvtU80Q-hY2fYJf8XF6Bng&oe=6ADCACF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtDG7UGVN4EQ7kNvwF6gu_p&_nc_oc=AdriUcZ7Sn89RskEj9Ix58i7n-MZ-EXLMw-PLyumIqSOU2_udSjGmOveTdAYmC_kCJg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXXSybErUDRP4Nj3nlfQK6cghkzdbF4XQ060fdE9iCwg&oe=6ADCC07B"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HJojyHq9PUQ7kNvwH6l8hX&_nc_oc=Adpwg-ArtkviXs8FCVWaffYKYhoisVIX8O8lEIB3HXeDLYB6S2SiaDgZM6J8miJY63s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSJOMY8DK-tGxl-_HOribEFFSIMJhCg8eloFxAoJ6M1w&oe=6ADCA4B3"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
wE8VgYbK89fYcCRpUiWwm6fK3rYHCJroNzMDNK0w&oe=6AC90EF4"}, {"file_name": "screen3.png", "id": "834127098095937", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348044_834127101429270_2003475751171480037_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sELqgzARWqUQ7kNvwH4598U&_nc_oc=Adrj2CwltOlxv7qqk2uBgCdftSZCZRRV6cG8Urm3wmcSl_Qpe2uUeD9M3kZ8hyS50Do&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNScGEE2da6jhVdsy4ZczThaBhuAPVMCt7dqTn-vKjqSg&oe=6AC8EE70"}, {"file_name": "screen4.png", "id": "834604664721991", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031510_834604668055324_3622376575732792418_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpFRkfsJXAsQ7kNvwHvBfzz&_nc_oc=AdqwIrllssGP1mpmIyRvAx-RmFp__w7rl8-dgsT5ZzQbdqvYWQCnwgVb-NMAIW059cs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZePBVe3-ANhoZ2FEJNyCEYQ4ueo8-7L_y_lq32Xqd6g&oe=6AC9051E"}, {"file_name": "screen5.png", "id": "299061759445224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75254874_299061762778557_9220846835105549098_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRJpMyq-udcQ7kNvwGFWY2a&_nc_oc=AdpOk-9bqC62I2fbt9M3YFyiYlbwmFQIEDjEdYJIYmFk4l7XnvkIjT8UobusTqFFQIU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1SzCg0avKg4Gkm0RVYw_j4vXEGjtkwvUnI0ZXw697dQ&oe=6AC8E677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen1.png", "id": "3494650234124848", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476597_3494650237458181_136683139161478135_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa5yIO0eOGQQ7kNvwEUCJOp&_nc_oc=AdqJ3-xcO3mZCyUi2peyTQJ75RIUZaL2btnT8-65myrQVUT1MjibQYR9fLaQCYvJExc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfwGF1v4fUQT3nagReOcUVhyieKXJC4g7woAqyshbeOA&oe=6AC8F9FB"}, "display_name": "Laboratorio di Fisica ", "keywords": [], "long_description": "Sono lieto di presentarvi l'opportunit\u00e0 di integrare l'app \"Laboratorio di Fisica\" nell'istruzione scolastica.\nCome insegnante di fisica con la passione per l'innovazione educativa, ho sviluppato questa app con l'obiettivo di arricchire l'apprendimento degli studenti attraverso l'uso della realt\u00e0 virtuale.\n\"Laboratorio di fisica\" \u00e8 un'applicazione basata sulla realt\u00e0 virtuale progettata per funzionare con il visore Meta Quest 2.\nOffre agli studenti un'esperienza di apprendimento coinvolgente attraverso simulazioni ed esperimenti virtuali.\nL'app mira a rendere i concetti fisici pi\u00f9 accessibili e tangibili, incoraggiando l'interattivit\u00e0 e la sperimentazione in un ambiente virtuale.\nVantaggi educativi: l'app offre numerosi vantaggi educativi, tra cui:\nApproccio pratico ai concetti di fisica attraverso esperimenti virtuali.\nMaggiore coinvolgimento e motivazione degli studenti nell\u2019apprendimento.\nAccesso a contesti complessi altrimenti difficilmente replicabili in un contesto scolastico tradizionale.\nL'app \u00e8 in costante miglioramento, sto lavorando a nuove stanze (nuovi esperimenti di fisica).\nHo fatto provare questa app ai miei studenti ed \u00e8 stato un grande successo.\nLingue: italiano e inglese.\ncontatti: \nnicoletmassi@gmail.com\nAlcuni video:\nhttps://drive.google.com/drive/folders/1a9sbj2HDJj8roQFYGmpIDwGGoLZF0hEo\n", "short_description": "Puoi esercitarti in un laboratorio di Fisica.\n"}, {"images": {"nodes": [{"file_name": "screen3copia.png", "id": "3542738229342993", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036602_3542738232676326_2615385384638555061_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M576eegnBs4Q7kNvwGiKEud&_nc_oc=AdqKb3cgqbFaQovSbmeLVBilW-FUF5rcCWZLIJ5Lg42SmmdyakL5-uN9FHZh645DGuY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN47YHVGcYW2JZjbT3lGXN8FLbfSoriVrUn5dgebWFFgA&oe=6AC91673"}, {"file_name": "copertina - Copia2.png", "id": "2349279258584286", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri"
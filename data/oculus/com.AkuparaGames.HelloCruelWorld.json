EmwUnNpifqWoLIXiczU4dfGARAzlVKRmcdCJA&oe=6AF08644"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2JpXKd5QisQ7kNvwH8D5K-&_nc_oc=AdqMcwG5R33BRWcSHRCTyv8ZmoBy_wRnjCZZduACPI8JBk8wIu2YTnk_IFbOPUSBcfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF379ZWhSplmq-8wXch-XeTr01SNbyakuIe13fBxmqjA&oe=6AF0A22D"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdUfAmJuoV8Q7kNvwHFEDka&_nc_oc=AdoDzesGgHYJGncXojCVz1b8kR80LyBOpjvvg7lcNRdwF012mOb41PRQ5tpC6hDlHiw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJqgnsxmQOTGwKlJRpAtE_TVyEuvHo41SwPb7kYAFReQ&oe=6AF0A9F5"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urrLLQH0erMQ7kNvwG4GLk6&_nc_oc=AdqiuZQnehTGoPMAl-9LvYZz2mh6KAejZEG_07b202jNqVkaSszdLQuo6KMOeqdKNeI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiQF7R4FnYqCEixiMAJNEAalQpMT2FozN4XXfgH-DVSg&oe=6AF09224"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1XahK0g4HQQ7kNvwHnuQC-&_nc_oc=AdpQ9ZTsD3tCsjhdCSX7R_iNqODSnbIyhe1k6EAvRkLgeB3d6KMbnZbcm32iX6xajK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtPJP62WP7JD-STnsT17FEq0rMQhVAGiEt-ZpwhY0iIw&oe=6AF08981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlDO3CPz0AIQ7kNvwFufsH6&_nc_oc=AdrUGcyvwbNnpEkzYL1ZnF2avPM7UXPPoAjac8fMzQS9xlVJzuRtAHwp0lgCAxb2tNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLHnGeaPXItucJYhfisiA_0BQd9QBprF9QnWoXQgz8Jg&oe=6AF09066"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8403322066353901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974814_1577160289528121_3945491638916711531_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrcUwDznx1QQ7kNvwENxt1n&_nc_oc=AdqedVoZyooa507dwJSpQEjGx4Rdl6mlWIB1krCrhrBKb9vBWVzWaDxV5yYMaNW9hz8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAmaTj4JL6EHOCSvw-ueDLJGuoj1xTFmDylQue22HkBw&oe=6AF0B26C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hello Cruel World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1722531600, "lastRevision": {"nodes": [{"id": "6505924342760359", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6505924336093693", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false,
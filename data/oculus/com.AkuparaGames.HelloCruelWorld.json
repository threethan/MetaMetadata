com/v/t64.5771-25/75203626_8518222191526630_7433603732564334464_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FojXIaCKQCUQ7kNvwGCpGGN&_nc_oc=AdoBGcP9ytdJLxCEZbWE46E4_Jyr1noWgmE1D5ayvi7d0MC4416dQSI7s87M4skeDkQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_XPkNdR78y-JbknGBeMZGdokumQJ5YkyGbYj4LI2Nhg&oe=6B09CB04"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgVmzSYqLhIQ7kNvwGyW_Wa&_nc_oc=AdqpLUu2sX2wvPAg-N2zZlapVL6GYXjPeRDGul1MlkV8jhXLoa7lRbR6XyrDbdZf0dY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAxieQEgL-YsohAh_aqGaDmHlHfTnkgLW9sdYOU5YKpA&oe=6B09AEAD"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gW2qyOrgGwQ7kNvwGBpE97&_nc_oc=Adow2UYLN8NxMExxZIse8RJJnvT-Ng50VEKXakxe7XqTApcpOtYbXRWNXWH24RBfdnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo6_RmLZ_r4ZAJ_2LLl1ooD4MD3HMgcdcQq3nv9mFyng&oe=6B09B675"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPOqrO_9m7kQ7kNvwF0_Ag0&_nc_oc=Ado8lyMJB7OSj0NvQcxdxuYeXA10rpwnatYgRE3XfhcSqTGL34Bu9dBFGE-BFjpZViE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK9A60zGJAbgZBd6-zoJj78LrG40SUbPcsXdhSettTqA&oe=6B099EA4"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIZv_gGSRpAQ7kNvwFR7Tll&_nc_oc=AdpfIzmmCkyvpkYRB8Sf3d0XUrw55blCR8ee1MQT5IiSn8uO13od_tyhmiGB75i1kmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeiaGsJG0moRwNJOrTrlCBGHENcfLFxlf3h2xBHqMBLw&oe=6B09CE41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd__mu1-JlkQ7kNvwEwMAac&_nc_oc=AdofSupMcuAJRCW62KLacJ17trBj-WezoxRHuKCcPS20-ptfB1-7D6d_WQoaOJ8QVyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOZmzrXv5Tyn6UfjdLfuogKEQkEeaJ_ARfVj_heENLnQ&oe=6B099CE6"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8403322066353901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974814_1577160289528121_3945491638916711531_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BE3XpvWBI74Q7kNvwEML1JO&_nc_oc=AdoLdgZ0nKDePZ7FDqA7td9X3OZnCXuWJWK1KpW_FMKq1Ea4GIzN4fAOCLVXSA-J9q4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzJG6HF9KVs1D1NdU2QJ4y3Kf5_18775eFCm9awF0nw&oe=6B09BEEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hello Cruel World", "platform": "ANDRO
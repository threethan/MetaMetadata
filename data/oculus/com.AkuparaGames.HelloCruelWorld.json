57P26M2Lg&oe=69B96444"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIMuFgs3c-gQ7kNvwFxZctD&_nc_oc=AdngqFerjQKiPu-u4-KGNcgQiId4lenj8qHmYHWBNEmp7_l6p5hvwMAM2VIq5Y41noY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZ-5CcCH2XqaLlZGFybAs72bg6dP-mGbSIhnHm0xuB9w&oe=69B947ED"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmHbfuSE5zAQ7kNvwEQOrjV&_nc_oc=AdnBzdTr7ucTQ0mHnkq4KLw6SDSY5de1RYs0fkEAXaqeb-SxoRxlD4CLobyrjIsPfpo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_zK3isEmGjZxPs0nFziQ7mS6hOZJcIKu0Bp0dDfppvQ&oe=69B94FB5"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEC_zAbQIQoQ7kNvwHUshc5&_nc_oc=AdnPrO2QYzGbttpzYJjqBPEmOEWY2mMfCTMaZThHG6nOE1HB8Jjxa-jtUmQMG7UMKYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuxUlNdLivCkRyU9aYr2CN322B-6PiUlZirPam3FDw_w&oe=69B937E4"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGj9kZ4BRSYQ7kNvwEp4mgG&_nc_oc=AdmXpnOpVlQUJSJk1nWh82nI1gQVf9mQCz5Z8fa1T1inYmrih8z2rjAtvV9ZNMLgRYo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPI9fcV0MCEpgn104KHxnb3BYe__1E7xEkvFnBloNDOQ&oe=69B92F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHbbrMxLOacQ7kNvwGBstvg&_nc_oc=AdkKFvOX17mZgDmLV7n7S8C4iQNReph9AVkxjMujz7JvmGrXdoAFOMAi_KF0nX4eFiA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5VD3YU5vswaF8PwqagQCy4fkkIN2Yg6pkWARk8hDnhw&oe=69B93626"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "186175244247748"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "884344207699438"}, {"status": "PUBLISHED", "id": "3551256568348497"}, {"status": "PUBLISHED", "id": "2990421454493661"}, {"status": "PUBLISHED", "id": "2017690545640719"}, {"status": "PUBLISHED", "id": "1262196418944211"}, {"status": "PUBLISHED", "id": "1734341924095252"}, {"status": "PUBLISHED", "id": "1342017303666049"}, {"status": "PUBLISHED", "id": "1323775735640717"}, {"status": "CANCELLED", "id": "1161468288662310"}, {"status": "PUBLISHED", "id": "468728569004820"}, {"status": "PUBLISHED", "id": "1661951007991407"}, {"status": "PUBLISHED", "id": "1495033688074513"}, {"status": "PUBLISHED", "id": "3656432277944255"}, {"status": "PUBLISHED", "id": "1003452610992296"}]}, "baseline_offer": {"id": "1495033688074513"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "884344207699438"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8640173306002108", "version": "
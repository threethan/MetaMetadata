tVCEG1fOQ64yGuRub_X8CWjZWp0Bz4TPZh_Nw&oe=6ABBCA44"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h94BzyOnG58Q7kNvwHKiH38&_nc_oc=AdpG11ZuVm2BK3O1T86gy7eu-ByGXjNbNwQG8fYkags3vMPaOSFyfsWz2qiz9Cpp0gA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInp2xlelnOshDyIKXPri9BsMX_iqjgUEOQ5Yj2JbL7uA&oe=6ABBE62D"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnptmPiG0lMQ7kNvwEX8pEw&_nc_oc=Adq6o2g6HiYW5EN9RD9EVDGGTTbiAQWuUep_D7dcbbj1ZmvQsbVp9DEGBsnN2k91RY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAv5d6QQ-JzqdaONZ8KVg40URUO2wKk0k6gUZfrdftrw&oe=6ABBB5B5"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdDKA--b-HEQ7kNvwHl7zPT&_nc_oc=AdpT78R3F3Z3K2rasZKrulmY2sHS9KS2cK-h2_JErtymaReAikJ17xTD_0VmUMN3uAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4BomVIVL4hHfbOpbHATFsyUrGmk96NPdwABlbe1EUFQ&oe=6ABBD624"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4VIHHpHCL8Q7kNvwEIX3cj&_nc_oc=AdrcoGct1lo8a10TnGz7gHmAtc3ZNfIHNTb-I1U3dKhg2LVlQ-V9LjLYf-NT2odYVvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtMf4DsSeZYgH4zYRAtG6J8Cf0pv4UxsyIy-tjheEZqw&oe=6ABBCD81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVCCtY0TPDEQ7kNvwFhEpv4&_nc_oc=AdrtxUGt15bVxHqGNq4sdOeJOD_iGMcXn1PdyjNXkBR1GenvntnMsLTh71kp9wXdtyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFRTzjiWQtCP9znV85ekDCHGxNEZXL5zNvlRyDvwhGZg&oe=6ABBD466"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8403322066353901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974814_1577160289528121_3945491638916711531_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RIhjKcR81wQ7kNvwFt2xHG&_nc_oc=Adq1vDNjhee8b86p7HnuDD7wy4x8T2ZGEY8vCHm1oFmDNLRh_KT035EQ1-z2_qoLMx8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKusdgN9Y-kWm_eGWJ2kzO7XxhazI8z10JhG0Wiovowug&oe=6ABBBE2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hello Cruel World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1722531600, "lastRevision": {"nodes": [{"id": "6505924342760359", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6505924336093693", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false,
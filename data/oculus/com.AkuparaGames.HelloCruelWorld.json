4"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Hn19zZLcQQ7kNvwGpQ4va&_nc_oc=AdnSW4ssnHx0zYaoQxO5wsxnuxN0a7Mck1DgwetfXDFJXQCTRjHQ26gr8vt2m-jjqdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwMBjkINA96XBkGYRXxUSKzYulZb6R3a5eHNwfWXjbYA&oe=69B2B06D"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtgjHXGPD_AQ7kNvwGu3ayg&_nc_oc=AdlESZLiBEhxS6KIrpkYFSwFNIOccbFMIvscqGpMHaLaRM2fUAzznwxeUBun6Z2Jl7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhJ5a420ZdCcn3XKXI4RTodzpx-WE5h3KIC3jToN5OFg&oe=69B2B835"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmmfpsv-EoUQ7kNvwHpwL6C&_nc_oc=Adl_BmwiwecaJqRZadBALxNo_1nRwjVgPYQdQqX1Sq9mkg0ks-iMrzLd1HAFBccyoz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyX7wPRKq6Lw9JgW4hy5g_pP_349inbWjMur_Zwn-azeA&oe=69B2A064"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JwTkAhMN3sQ7kNvwEqGbBP&_nc_oc=Admm25-RzPwXpLI0Mg59fyRZtYj9Bc1ZKoJTh3rIsEn-YoM_zxPhNHZjf0ZlREcQklI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQ88hAvj6lwZV8RmFO8NrhuNqzPmWzP7OMsjPkv6r0EA&oe=69B2D001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMCcCBvb9AEQ7kNvwE2Ykfv&_nc_oc=AdksIZ4RqivxJlpkkGrkmtFNWcpg-kcUo4Iw8hvKdzDlF_dL0qYomwV6kOuHeMS9pXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyzq1nz4KrmEV4pDghIK6FbWq7CmhcRNNYsiKBnz6XTrA&oe=69B29EA6"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_pr
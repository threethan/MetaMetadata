com/v/t64.5771-25/75203626_8518222191526630_7433603732564334464_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZsxikBK43EQ7kNvwEJTizG&_nc_oc=AdoYgagdDFtbaRjr0as91sp1Nfs4vBRmSnf6krFpBnuz07rGS9dRIx3HtI_lEHtFI80&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqwKiCdGY7zW5zzTL5Be-6bGVqVA-_okMNeRadfbtFIA&oe=6AFB4A84"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6euNpBdFcVEQ7kNvwE2qdj-&_nc_oc=AdpVaLW4qv89K5Qtq097bDmUwQ6AS1_8wSqcR3Ju4s9nfer0QnoZJvWhnEW-9p1a7wo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDgKn1nSKHZ2av2QZQqCfss-v9-7r6gHw1mnQlUUejYQ&oe=6AFB2E2D"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGLxD5a5YT0Q7kNvwE7GH-W&_nc_oc=AdoXrqfiWQhNhQTNxOMhyq-Cl79ZRcyUmmzGRJn2k-fcPFmiB4-f7v4uKF-lHE0ZWUs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlK3ercga7hYCaW-36aSKjeVQdvQI-gj8b2ZzWW1yPoQ&oe=6AFB35F5"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9mixBfO-oMQ7kNvwE4F2Xc&_nc_oc=AdrvEnZ5Zc49D-NVWQeHilESg6RSsh-3dTzgHYAlz15qbXeszm39LQuPU9af1FiL53M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLLpcqFfHVEtYJ4XkJKmNVtpbLkOIy2zyPoSR8rQV-mQ&oe=6AFB1E24"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R9fQfM1B9kQ7kNvwGEpIiJ&_nc_oc=Adr28GrjnQrWyshSvxwr7CUtgSemu9H4Eek4l1bP-95F7ayKikKpI1isCLsrIJCcAIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn-Gl6Ri888iaHJTzWvE1eXBBW3b106j7ObxFeD0EmXA&oe=6AFB1581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_ei4vjEctkQ7kNvwE18RQF&_nc_oc=AdoBohoTDBTEEzfR0cd_Nu5tMiGzmfkbdqVFUQEyJoOPSQkomIaAJ9QMzyNau1rGRYI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAS9Ne1DVlkWQKbBGSInMsbdwCLDghR84YVFlspCMgvA&oe=6AFB1C66"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8403322066353901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974814_1577160289528121_3945491638916711531_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpR3678S9BMQ7kNvwHE0RBb&_nc_oc=AdoUftm2rdVOQaoLNlXGiOxmLPg-KPR5__RLNNIiwSXd-J-PdqdH6AVl3w3gXceWyeE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4QE1_fqHT4tWPXXX69tHipoU3jT73bntH7a72by2qrg&oe=6AFB3E6C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hello Cruel World", "platform": "ANDRO
g0-l7xMwJ8A1UHrhrBy0og-ZmNL3p8dhb3cjQ&oe=69D7B6C4"}, {"file_name": "HCW_Meta_SS_2.png", "id": "784290813858403", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75604732_784290817191736_4690208635047583134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3uAfTSg0h8Q7kNvwE_RMN4&_nc_oc=AdokGqfh9O9zZAIv9SCPiONioN5ZG65hKLAqYLW7vL8ByjYfsIweJXm8CDoSDAPLAOY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sDrJFtRx8iqjOyAeNP3WSD12nprm0gJOAwcRJLGxOUg&oe=69D79A6D"}, {"file_name": "HCW_Meta_SS_3.png", "id": "1193748911753918", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569446_1193748915087251_4833318691764352708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewXdOqhIn_EQ7kNvwHntdZ4&_nc_oc=AdrL6P3FI6r7Jv1IGk6J02GX3gpRgsqnBFKLtmt83amfgTawk7xzdNt4UxujBQc8NJM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25ERT_5CQCogdrzmhJn1GlKxUqDc2qBxeAyBU8PqFjsQ&oe=69D7A235"}, {"file_name": "HCW_Meta_SS_4.png", "id": "1168458627632642", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031497_1168458630965975_5453400192215918028_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHO2xSU-r5sQ7kNvwF86h4Q&_nc_oc=AdpjuyyqFsG11dJ35MJsZANti-WqxMHIxFWJiKtoC9BS5E8MMzVfbxrF0ZG2GEy4Ar4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17q79FsEu6yaCmBFDv-kc7DcDdzIkqKQ-9JuO1ms1N6A&oe=69D78A64"}, {"file_name": "HCW_Meta_SS_5.png", "id": "431750256399201", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036651_431750259732534_8602884550669209693_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmCIpryJwbcQ7kNvwHAEnS8&_nc_oc=AdpoNlBPRcDuPju6YnCB-mE3fZPzS1VrgLqfTJNtxcmm6NoAO5OwOETowYWpdTuLbcM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cYOtlPudA9531AEih-lHePxbm2vEete05aFW1fiQLkQ&oe=69D7BA01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HCW_CoverLandscape_2560x1440.png", "id": "1014363053384783", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75221322_1014363056718116_6729711944390799286_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BbGCavkh5cQ7kNvwHLzcD6&_nc_oc=AdqByGJlrgUtMlgZXPSVYVWXgoTUlI2l-NB2QOX4ClxwrApljB1WvRXDiklILpV2wZI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20OQ6ONJeTj2Dpft1evI4JJpaTow-0pbUjxttwkO9zLw&oe=69D788A6"}, "display_name": "Hello Cruel World", "keywords": ["HCW"], "long_description": "In this VR horror puzzle game, it's just another day of you, your trusty stream chat, and a young woman trapped in an experimental torture-test to see when she'll break. Can you save her?\n\nIt was supposed to be simple. The Crab 'n Grab, a trashy seafood restaurant a thousand miles from the sea. But your chat kept telling you to take a look. That something more is brewing underneath the surface. That there's something \"\"there\"\" there. And after all, isn't it your job to dive headfirst into danger? Isn't that the thrill?\n\nHow thrilling do you find the skittering of ticker-taps of robotic legs on concrete? What about the voice coming over the loudspeaker? Who's keeping her prisoner? Why are they testing you? They've got livewire electrical shortages in Sector One, the rotten remains of the holding cells in Sector Three, and all those finnicky, experimental gadgets stored in Sector Four. Your chat seems to want you to keep pushing your limits and you'll have to if you want to be a hero. Do you?\n\nHello Cruel World puts your ingenuity to the test. Think fast, think on your feet, and think outside the box. Designed from the ground up to take advantage of VR's interactive capability, Hello Cruel World asks you: just how far are you willing to go to sate the curious thrill spurring you on?", "short_description": "You are an urban explorer and you just hit the motherload. Hidden under the carcass of an abandoned restaurant, a deadly, decrepit laboratory teems with secrets around every corner. Solve puzzles, avoid danger, and uncover the VR mystery of the asylum-- and the voice in your earpiece."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.akuparagames.com/privacy-policy-of-hello-cruel-world/", "developer_terms_of_service_url": null, "publisher_name": "Akupara Games", "support_website_url": null, "website_url": "https://www.akuparagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8403322066353901"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974814_1577160289528121_3945491638916711531_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEgbqzIjoqQQ7kNvwFgc6aQ&_nc_oc=AdrlRWoM1_QxEMK_OE81HRQoL5xSllG538Yv3JeFhbnroc_LprVQq64oTUkQCpQLL60&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IcWMrpgV0JSR8UyvIXgQZsmm2n1uUFaNLKY0luFfWiA&oe=69D7AAAC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hello Cruel World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1722531600, "lastRevision": {"nodes": [{"id": "6505924342760359", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6505924336093693", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false,
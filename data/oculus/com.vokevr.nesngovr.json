72_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmtzW7oe_YEQ7kNvwE3zELY&_nc_oc=Adq01_FJqQcpsTe6XIEneM7YheyAIM9Jy7tGt9b_6MUBPbKrGZVicnSQJqJQgDSRAb0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt0Mx_OCiAnC1ol040p7GIrcTFYHHLYeBoyM-sYn2tcA&oe=6A8D8AC0"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve9fFyhs7I0Q7kNvwHz7R_-&_nc_oc=Adp8lGby4VoK2gSVtb0ZeiKhJpnOyW0bkT1vLqNi8nwbEMZsxQGD1JuNnJFW_I49mHQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhni2XlCQb84OWsq0OZRTU-__o3kH0TkfAtpXCazNejQ&oe=6A8D88B7"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avwitsALfC4Q7kNvwH3Dxvy&_nc_oc=Adqo01EDoA3pWEAGPeiGKfm67ALT59Uz_VdH6NkP2W5jq5bGWuikwYpK9P1BWciKzJA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBx4u5YztZeQCdldtJ3NKTTS6dNeULZtS79mBSrzxzaQ&oe=6A8D7471"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-s
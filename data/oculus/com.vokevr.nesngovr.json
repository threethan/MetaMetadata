g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ixJS5ozXh4Q7kNvwH5vvav&_nc_oc=AdqtHGrwAMiNo1KCxG-0TLGDZeGAyagIK4H5ccYkaOp5myUfmXbZ3vkPWHPhzVYbZe0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73RY3lrfH05axVbrFDKeF7TAfeJJa9tC1NAI8jtUe71Q&oe=6A119DC0"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJffr9GdO4UQ7kNvwGnYGqp&_nc_oc=Adql_6CxytwsRdPnFwkKY3BPNXhl1ri2gS70IoluAqrQ8gZ82maVrZRczRVI_-Jy8wk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4stlbR4edy74mvOLpZmitaZMVzsPNAzhEfbTUita5vmw&oe=6A119BB7"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7GnHF30eeMQ7kNvwGmQdMt&_nc_oc=Adq3y_RUeNj3EVto2tmvOaeBTOkk72pgdmoz62SD_AOu_QVNYgJjWjXfAz8Eyu0bwe0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a2VQujQDy1aaXlZN2kr9H1PlTVxA_aFKHyJe3dWIYWg&oe=6A11BFB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rT1fAZwSsyYQ7kNvwHnrbT2&_nc_oc=AdoHmOgBKVWUTE6zUtawBvjIrvJPwKMiKBqyXDuToXPO5jRKuPWPHPB6ed0GK4QEOjU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KGYqXYIuKVgvYLKWpGuxql-cI6B6PGoNDBLHzlcZ3wQ&oe=6A11A2CA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": fal
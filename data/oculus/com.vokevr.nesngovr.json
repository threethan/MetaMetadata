SNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1ZMHrnHP9sQ7kNvwG--zxJ&_nc_oc=AdmWWn-JXAVYNyqYHxfMNbGQzcJg74AbOoXtZ8rUDE_lf2nUtIyII-tqPuLIZ19CMKY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsuYk4nm19TUrFxZ5kwg94TvtvMVubcIqey7t09CMMYQ&oe=69AACDCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false
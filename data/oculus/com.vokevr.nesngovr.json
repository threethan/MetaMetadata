g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgQoofHROs0Q7kNvwEM2imJ&_nc_oc=AdqWwpMOhaQWyOq8rm4fgo1a-6Mkf_-GrZ5FxJDGJRBmzR4ZMdd_atx8vdz4KZPjcUA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AZ7HEijCNgYhNdWSqiNcKmFszki9YrruUiMhi6vvODw&oe=6A396300"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VsusbtAcfoQ7kNvwEaasnu&_nc_oc=AdoYe817PD4W8Y1TgqgkyE_tZ_VO1o3upx_5RflDrAj6XOz86GW5D3BysgHnITabK6s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BUvlMPMmcaOQtvl7PVE-qIelp3SQ4sZwvzkJoB21fEA&oe=6A3960F7"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQADcbCMoi0Q7kNvwE6bqQJ&_nc_oc=AdqeeKTpq8w7nNTBqwkoM_FFtYel__z-LBY51_S9RT3IwdwzIfXKViM4HITSW3j4TtQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ku0JMa99lRISNh7SRmieMe3swPQQq50mXi62H9FwXTg&oe=6A394CB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftHJpG3EsR8Q7kNvwFmBwmM&_nc_oc=AdpuhX0M2yR9sWuctucthIZF1gRpxaX3IFUFr41aKxU4ONyRBmKaUQJoDbWGmTYM1vk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xF08VpaYtVEkQuRi1uc7B8KlZ2l8hdNhem4VFO-mZlw&oe=6A392FCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": fal
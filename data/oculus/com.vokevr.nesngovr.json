g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jyp1eHVf0IQ7kNvwG_zyvc&_nc_oc=AdrPkkKs0C49jw6fWFeJ4p7AFfFuFptBtO2zbKeUlYhNHLktBAowMiE1bslpFY5QNWk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tCOrfJDLdSAc4-pI2rH0jLA-H__4tHAOlIR0k_ofCNQ&oe=6A22F980"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJJTXR4UC9gQ7kNvwE2vprQ&_nc_oc=Adr3qcdxzsx120QFrOsxWgJBr1z_HxiWZPV4YZcV_6z4SDybA9f22UKwX6blZ_kncOc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h9AxJUEm7d36neN7HbA-qv5KPDl0BuaMiehIDAqXEJg&oe=6A22F777"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWFX2Bwl4scQ7kNvwF4hrO7&_nc_oc=AdrKh-wzN6-UQPvaWCJZmg97e6MPuJGNFQ63nRUtY-7OwzeB1EJyFHCDbctPCP5v0UY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uiIswa4nIaV5UCxyE-5qgJ8FxLCtvFfzWa3U5denJeA&oe=6A22E331"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wQ7V4JuG8MQ7kNvwFHmyK6&_nc_oc=AdoAEMwpB3QyypQlqyIyR1r2gmT0oCDUPxppqfzM5u01G_SdgPYYrEZdKxWvriILzQI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_LlpX6XeDpcP0PNqxq_pSOn2-Mk79Bv1KcC6qUYUYoQ&oe=6A22FE8A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": fal
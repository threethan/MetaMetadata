g?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2chNP_e6DUQ7kNvwHA4ZVL&_nc_oc=Adrbj2Gv6Ioh0xtMBH3RUo486U4M9QZxz3GMe5Ce4kJ4DIexR-LzyyzTw0NzsWQcQD8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eO54RpaU0rNC4OAhRQmyJXmbNYQD8L0inBUmH24KQVg&oe=6A36C000"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPBm4Q0ruiQQ7kNvwGHZkdC&_nc_oc=AdrFarQ4-dcRGzL1KUWcq8zQ-S4h1J7IyrdpyyhrC6CIP5hMkQT4oqPSaqcQPFv_IQk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UPAYCsCaYy1lsG80LMW_dwuFJ-M_pTw6o0n1_1dFlSg&oe=6A36BDF7"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSzw9Pkr-_YQ7kNvwH7dLsZ&_nc_oc=AdpRY_0tb1unTR2QVuU54n0MVwLOzkZBQz2xqF8RCfsmhxP5340XbmFOLUD6enqJcL4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_87P76HsDdY0jpGKswcEQ_FX2BCoZWj_d0-JPEjFcXgA&oe=6A36A9B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GBbB-0Iyq8Q7kNvwELpnFb&_nc_oc=AdoPfuR3OqW6JxrDp35X6KZu-JQYEsQijOJQP1yM9whcLbfx5xy0vkzR6xNNPe8Stl8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zm16DWwlRD2mDkjZeFqY7jVEsaUbhCu_ALr9yOEJiiw&oe=6A36C50A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": fal
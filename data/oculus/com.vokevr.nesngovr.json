?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Osmj4sUaby0Q7kNvwE_1zIU&_nc_oc=Ado6ryQ4u86X1o-bZZEl13FYY4Xc-KDueaHPXR3OeesVM8Sdo6dTgahfpw7QyBHZlrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FIdmB7x7Apyd4Ms_x937moYgsc2FCa5p6KE2IUm5_Jg&oe=69FF28C0"}, {"file_name": "migrated_image.png", "id": "204887840780713", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162718_1858605184456045_7285447664362061824_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTvEBRpb0asQ7kNvwEwSmg3&_nc_oc=AdpB-kV1J9OPFw_vDnu-c180RWMoXgO17FIHKEZ1LGo9j7HFAb5-o2qsqz8PNJEHcCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LkpB6vS03XWOg4ondYU-Hy26oE0fpr1LZNHYWjTi7qw&oe=69FF26B7"}, {"file_name": "migrated_image.png", "id": "1285244518531967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162741_1623769817695649_94762109719543808_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HmDCiTELfEQ7kNvwHOSJyC&_nc_oc=AdoXjyXHtaiBm_s7EFc_ryucjhFbavszjGXevf44Yt8WsFMHnk18Ns85VH0AZW7HeBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79KXKrHK6jfCZzWJqnxxvsjgWXJvItRNqvxjU2L00ufg&oe=69FF4AB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NESNgo VR", "keywords": ["NESNgo", "VR", "RedSox", "MLB", "Boston"], "long_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles, or let the VR cast pick for you. \n\nNote: You\u2019ll need a valid account with your cable provider (or \u201cMVPD\u201d) in order to stream on NESNgo VR.  Currently, we support:\n-          Comcast Xfinity\n-          Metrocast\n-          Cox\n-          RCN\n-          Playstation Vue\n-          Atlantic Broadband\n-          DirecTV\n\nIf you watch NESN via one of the cable providers listed above, download NESNgo VR and start streaming.", "short_description": "Now New Englanders can live-stream NESN\u2019s Red Sox games in Virtual Reality with NESNgo VR.  Fully immerse yourself in the game and pick your favorite viewing angles. \n\nNote: You\u2019ll need a valid account with a supported cable provider in order to stream on NESNgo VR."}]}, "developer_name": null, "developer_privacy_policy_url": "http://nesn.com/privacy-policy/", "developer_terms_of_service_url": "http://nesn.com/terms-of-use/", "publisher_name": "NESN", "support_website_url": null, "website_url": "https://nesngo.nesn.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "SPORTS", "MUSIC_VIDEO", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "455476462948588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162694_227629087760656_6493970034493227008_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqNEXoT-esUQ7kNvwHb4BKj&_nc_oc=AdqQpAkv8-Rj0ca2-QxkMtLGcSXfhrc5Boqj6FRiuNhjTUNX2TvhSrf2EQy33t0y43Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q3R0kD9Lrzf-2OYltcB-M7-HWY_glua5SDyOfUW2tIQ&oe=69FF2DCA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NESNgo VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1504045557, "lastRevision": {"nodes": [{"id": "1948815875399615", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1599951280035164", "is_first_party": false
ailer": null, "video_trailer_thumbnail": {"file_name": "PierheadQuest_TrailerCover.png", "id": "214206684081000", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974672_214206687414333_1771332655465219353_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZN0kiHEUNIQ7kNvwEHSdNc&_nc_oc=AdrketksdtWNQHO2BJZurSwsAqWGUwcPF_530DdNiaS0a7Nigdo9RC2r_U5mrKq91DM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgX9TW39fE2lEzfIEX0KXJxweXor8T0nj3LF2j2KFWrQ&oe=6B103A4C"}, "display_name": "Pierhead Arcade Quest", "keywords": [], "long_description": "Pierhead Arcade 2 is the sequel to the popular indie Virtual Reality arcade simulator.\nRelive your childhood spent at the arcade on the pier but this time with unlimited tokens!\n\nKey Features\n*30+ unique physics driven arcade games spread over several rooms\n*Includes all DLC\n*Single player and Online / LAN multiplayer\n*Spend your hard earned tickets on 30+ toys in the gift shop\n*Customise your avatar in one of 500+ combinations\n\n\n\nTrailer Music by Dj Quads:\nhttps://soundcloud.com/aka-dj-quads", "short_description": "Physics based arcade simulator. Play single player or online with friends. Compete on local and global leader boards. Unlock character customisation and playable toys with tickets you win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "http://www.mechabit.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_gra
w_k40s7o8HU3Ibkj_Z_DM_0Nes7UZRXc4ZU80uXDbr4S0VC4MRU_2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGqPauEsakb4R9wzaHZZ-6a7GbVYhEptx5IQ7lkf95Lw&oe=6A4BCACC"}, "display_name": "Pierhead Arcade Quest", "keywords": [], "long_description": "Pierhead Arcade 2 is the sequel to the popular indie Virtual Reality arcade simulator.\nRelive your childhood spent at the arcade on the pier but this time with unlimited tokens!\n\nKey Features\n*30+ unique physics driven arcade games spread over several rooms\n*Includes all DLC\n*Single player and Online / LAN multiplayer\n*Spend your hard earned tickets on 30+ toys in the gift shop\n*Customise your avatar in one of 500+ combinations\n\n\n\nTrailer Music by Dj Quads:\nhttps://soundcloud.com/aka-dj-quads", "short_description": "Physics based arcade simulator. Play single player or online with friends. Compete on local and global leader boards. Unlock character customisation and playable toys with tickets you win."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mechabit.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Mechabit", "support_website_url": null, "website_url": "http://www.mechabit.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7974321282615964"}, 
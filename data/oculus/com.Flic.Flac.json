wHtgR8X&_nc_oc=AdreNveD44-eWoFYZMQcX0CWVuJeikpF8fz2fKW1OjmrLJJTHGHle_FFm0vCJpiZnTI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQ_s3vy7MNi7nh9ryfWRg2f9-_uqRNWas5QQXF_PWF1w&oe=6B087066"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Flic Flac 2560x1440.png", "id": "972663844578669", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391924_972663847912002_4939968268487434281_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7tEC_NJNQwQ7kNvwHvJNcj&_nc_oc=AdoIP5ILEsxqO8SjEYay87B8siua_LNjn1nFvEht1zKYe9AInsQEeYtgXAssnWMHhrY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnxpMQo3AtE9Gt0LYImMV6Yj4riCk1raY1T8g_A0EeaA&oe=6B084776"}, "display_name": "Flic and Flac", "keywords": ["RhythmGame", "funny", "musicGame", "VRshooter", "shooter"], "long_description": "The seven magic crystals are in danger. The world is under attack by Flic and Flac, two rogue creatures causing chaos and destruction.\nStep into the action in this thrilling VR experience, armed with laser blasters, you'll blast your way through waves of enemies, collect yellow and red stars to rack up points and for the highest scores, hit the green musical notes in sync with the beat.\n\nFlic and Flac is an electrifying blend of action, rhythm, and skill. Are you ready to save the crystals and become the ultimate VR hero?\n", "short_description": "Defend the seven magic crystals in a fast paced VR adventure filled with action, rhythm, and wild enemies."}]}, "developer_name": "Fulko", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr-2/", "developer_terms_of_service_url": null, "publisher_name": "Meta Marketplace", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
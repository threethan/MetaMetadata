wEL7-z_&_nc_oc=AdqWzgzPHFOH3vZnQBauXHzOB_vDmwUKJB3CRc_nbGjHdt6Ha_cmmYaAtdlVXyK2Ets&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNKnDueuEW95ZUpL6tqpZxH-qoYtoxkgilSP8ELZ3gCA&oe=6B0DB666"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Flic Flac 2560x1440.png", "id": "972663844578669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_972663847912002_4939968268487434281_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OLYFNNSxEQQ7kNvwGcPREa&_nc_oc=Adp_YUUU27aFdNLwVXN0jAEWNaCVw1YJ7-rWEB6FF9eDWL1yssveZkY9FcalwH_Y2N4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQXBSaJnfx7oJp3iYjdb1HLZJS0p5qqH8sAnXH0hit9VQ&oe=6B0DC5B6"}, "display_name": "Flic and Flac", "keywords": ["RhythmGame", "funny", "musicGame", "VRshooter", "shooter"], "long_description": "The seven magic crystals are in danger. The world is under attack by Flic and Flac, two rogue creatures causing chaos and destruction.\nStep into the action in this thrilling VR experience, armed with laser blasters, you'll blast your way through waves of enemies, collect yellow and red stars to rack up points and for the highest scores, hit the green musical notes in sync with the beat.\n\nFlic and Flac is an electrifying blend of action, rhythm, and skill. Are you ready to save the crystals and become the ultimate VR hero?\n", "short_description": "Defend the seven magic crystals in a fast paced VR adventure filled with action, rhythm, and wild enemies."}]}, "developer_name": "Fulko", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr-2/", "developer_terms_of_service_url": null, "publisher_name": "Meta Marketplace", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
 and destruction.\nStep into the action in this thrilling VR experience, armed with laser blasters, you'll blast your way through waves of enemies, collect yellow and red stars to rack up points and for the highest scores, hit the green musical notes in sync with the beat.\n\nFlic and Flac is an electrifying blend of action, rhythm, and skill. Are you ready to save the crystals and become the ultimate VR hero?\n", "short_description": "Defend the seven magic crystals in a fast paced VR adventure filled with action, rhythm, and wild enemies."}]}, "developer_name": "Fulko", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr-2/", "developer_terms_of_service_url": null, "publisher_name": "Meta Marketplace", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9546932852022283"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "614590944810938"}]}, "baseline_offer": {"id": "614590944810938"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742331720, "status": "PUBLISHED", "id": "614590944810938"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9546844472031121", "
wHq02z7&_nc_oc=AdqV_MCQgIKTegBQWCanviw-UzRu7PB3BgOnlZnOl4dKkVozpJ6YPSiTNGcOBO-55Lw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfPKf9n9aRQc1Yj7O6gLhF6jFe1YUGu99xU__Lq2wRTQ&oe=6AFDE466"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Flic Flac 2560x1440.png", "id": "972663844578669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_972663847912002_4939968268487434281_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAz_gLGr-aYQ7kNvwHal3oK&_nc_oc=AdrHJnnDfptG0DFaFkncrNrW6StpO6JBFmNAxC90iYzPYS-MhG9XGb6nDeyfJuYCyuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTewJ1BiDREsvV5Jp8TG5IWDhbqT3vMmFc5jUdOUPqgGQ&oe=6AFDBB76"}, "display_name": "Flic and Flac", "keywords": ["RhythmGame", "funny", "musicGame", "VRshooter", "shooter"], "long_description": "The seven magic crystals are in danger. The world is under attack by Flic and Flac, two rogue creatures causing chaos and destruction.\nStep into the action in this thrilling VR experience, armed with laser blasters, you'll blast your way through waves of enemies, collect yellow and red stars to rack up points and for the highest scores, hit the green musical notes in sync with the beat.\n\nFlic and Flac is an electrifying blend of action, rhythm, and skill. Are you ready to save the crystals and become the ultimate VR hero?\n", "short_description": "Defend the seven magic crystals in a fast paced VR adventure filled with action, rhythm, and wild enemies."}]}, "developer_name": "Fulko", "developer_privacy_policy_url": "https://www.vrschoolitalia.it/privacy-policy-app-vr-2/", "developer_terms_of_service_url": null, "publisher_name": "Meta Marketplace", "support_website_url": null, "website_url": "https://www.vrschoolitalia.it/altri-progetti/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id"
91824303_1575501513609192_1747089165479787773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoEKcAnGzjMQ7kNvwENQfBr&_nc_oc=AdqZsz8NKyqBAuYNiJylvfO-wmDaOcRDWWKg1keznRpdBUHBWQ9rDAjzD-oIB1SXQxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6-ZeibNyvCXxmCi4QryROerysPTkYd11CLYWZMfSfsQ&oe=6AF1EF48"}, {"file_name": "Untitled design (7).png", "id": "2097160191133902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823802_2097160194467235_8120788879401296568_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWMMgUxhl2YQ7kNvwEjlQtj&_nc_oc=AdrnEA_KA6-Zp-7ouE9Jv7cdpaJfXV6dLxHLm_-HgmZIvkjxbcxnMARl_I82V55iYZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPc-VPISL45_Quv3_HDad08oDFFmXYAgrkDcNZ8wRTSw&oe=6AF1D5E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dart King \u2013 Ultimate VR Darts Experience", "keywords": ["dart", "sports", "throw"], "long_description": "Dart King is a simple and fun VR darts game made for everyone. Enjoy smooth and realistic throwing physics, multiple game modes, and a variety of halls to play in. Whether you\u2019re practicing your aim or competing with friends, Dart King gives you an easy-to-learn and enjoyable darts experience in VR.\n\nPlay classic modes like \u201801, Count Up, and Cricket, customize your darts, and explore different themed halls. With aim assist options and clean gameplay, Dart King is perfect for both beginners and experienced dart players looking for a relaxed and entertaining VR game.\n\nFeatures\n\u2022 Realistic dart throwing physics\n\u2022 Classic modes: \u201801, Count Up, Cricket\n\u2022 Multiple themed halls to play in\n\u2022 Different dart designs to choose from\n\u2022 Aim assist options for beginners\n\u2022 Simple and clean gameplay\n\u2022 Perfect for casual and competitive players", "short_description": "Dart King is a fun and realistic VR darts game for all skill levels. Play classic modes like \u201801, Count Up, and Cricket with smooth physics and easy controls. Choose from different dart designs, explore multiple themed halls, and improve your aim with helpful assist options. Enjoy a simple, enjoyable, and immersive darts experience in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/noob-gamers/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Examob", "support_website_url": null, "website_url": "https://sites.google.com/view/noob-gamers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25425137357094864"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25773803515561578", "version": "1.3"}, "id": "1261824919317237", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24860505590224713", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25773803515561578"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1261824919317237"}]}, "chan
ame": "Screenshot 2.png", "id": "1347364480472124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_1347364483805457_8638175109747364617_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odRDZV-5I3cQ7kNvwFN-fWD&_nc_oc=AdptufEnbZrxX7QCELka-ps2GeDnjgcrUmQ7TiGZCExFYgUClSrAVMkJG-gWX_WYhmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnScvzGD2ZUFTBzZ7sEVG9h4uPDAB8u9jg5xG2TrPr7w&oe=6AB2A375"}, {"file_name": "Screenshot 5.png", "id": "1062286719877444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1062286723210777_4302095446930516409_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbx_BJnvmHcQ7kNvwGqhvju&_nc_oc=Adrf4FjobMcwQwHdGBesoeujxJ8B_1TK3jmkKyInQliGB5X6cG29wr5ogLpzNIKqSa8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr0oZ1be6uZIBzJGRecQs-a-V4KUTE8BCpu9EF2QrToQ&oe=6AB28F54"}, {"file_name": "Screenshot 1.png", "id": "1009942682074190", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825345_1009942685407523_8095051029184249963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92Y7nprZglwQ7kNvwGl__uD&_nc_oc=AdqfUXLbe84gSUjQ1DmazvvrcAVwyyPc1yaCUJusML6WAFAcu3Vrygzf6xnlAmrWBlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYCjwHToy41HWDVBn3AoqHDqaZALWX9parKYLlDkO1vA&oe=6AB286DB"}, {"file_name": "Screenshot 3.png", "id": "2171374770464664", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_2171374773797997_92154527815960180_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAoKvUMaaroQ7kNvwGBrhz2&_nc_oc=AdqGzVK4SYHUdot10b8FPsHL7ikm36CLNq1Hye5svmW-JlkoJPX2qxc98QPViRs9lVs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn4fPr3HhgnegWyynTmIPlDTip74hAxv2wBscZclYV2A&oe=6AB296FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 4.png", "id": "919714287544120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_919714294210786_2213458437246509242_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYp2ta2pFUAQ7kNvwG5SFFV&_nc_oc=AdrRgHV5JDOVUyW0hpKHHsN7_d8NKp20iske5mfvQ_AI8uSqgtGvGkup2lr5JF_MsVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4kPdhd9j54yvR2dKd_urWxaVLJ_b9haOmqHv3MrfzVA&oe=6AB29B50"}, "display_name": "Viscer Medical III", "keywords": ["Medical", "Simulation", "Nursing", "Education", "Training"], "long_description": "VisceR Medical III is an immersive VR clinical training experience designed to develop practical skills in patient communication, history taking, clinical assessment, decision-making, and patient management.\n\nThe pack includes interactive clinical scenarios across multiple areas of medicine:\n\nPATIENT COMMUNICATION & CLINICAL SKILLS \n\u2022 Building Rapport \n\u2022 Delivering Bad News \n\u2022 End-of-Life Conversations\n\nCARDIOLOGY & GENERAL MEDICINE \n\u2022 Arrhythmia Management \n\u2022 Ischemic Heart Disease \n\u2022 Hypertension Monitoring and Care \n\u2022 Diabetes Nursing Care\n\nNEUROLOGY \n\u2022 Meningeal Disorder Assessment and Care\n\nPAEDIATRICS & NEONATAL CARE \n\u2022 Newborn Jaundice Management \n\u2022 Pediatric Fever and Rash Management\n\nThrough immersive VR scenarios, learners can practice interacting with patients, gathering relevant information, assessing clinical presentations, making appropriate decisions, and managing patient outcomes. \n\nVisceR Medical III complements classroom teaching, case-based learning, clinical demonstrations, and supervised clinical training by allowing learners to learn through active participation rather than passive observation.\n\nVisceR Medical III is part of the wider VisceR healthcare education ecosystem. Additional VisceR packs cover medical specialties, nursing departments, clinical skills, procedural training, anatomy, diagnostics, a", "short_description": "VisceR Medical III is an immersive VR clinical training experience for medical students, residents, and healthcare professionals. Develop practical skills in patient history taking, communication, clinical assessment, decision-making, and patient management across Cardiology, Neurology, Pediatrics, and General Medicine, with scenarios including breaking bad news, arrhythmia management, diabetes care, newborn jaundice, and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "987364320993450"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2102841280390542"}]}, "baseline_offer": {"id": "2102841280390542"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788349140, "status": "PUBLISHED", "id": "2102841280390542"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "987368600993022", "version": "0.1"}, "id": "1841710070146649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "987364314326784", "is_conc
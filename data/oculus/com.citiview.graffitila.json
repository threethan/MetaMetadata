8_1605370507953618_8791101636060611399_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxtAunMQIkQ7kNvwECzbDC&_nc_oc=AdrN1vU_0yp4xAgT3irRW9UrnKCmdI7lavZ5XqqkJ8cYNV071iPxfl7DEH9xESgYAAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPnZwbKWEmnrBhjQs4VbFfUmoyvfHhGWps1ul7XLJWbQ&oe=6AFDB9E3"}, {"file_name": "screenshot_2.png", "id": "2423937671472617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_2423937674805950_8691653352181080878_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bjTygkQQLMQ7kNvwHgVX_T&_nc_oc=Adrb2x-bqUdqz5BE8ROT4ZLsmcuclgvo17l6WKzU1OIEjvmWW5SZlJB1vcVbDyAEZHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4pNV5cRrp5D7WXXr2yzvj6KXL-eigZ-GzJodnL6Zggw&oe=6AFDE168"}, {"file_name": "screenshot_3.png", "id": "2158631718408003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604370996_2158631721741336_6146886964111215675_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyL4KU_xhqQQ7kNvwGmqneu&_nc_oc=Adr4T7Ea2ItLo3Kv_YBaUf_H5PnmL--DlA9wKtsXkNm1gmF-t1hR7owHdv7zLFE8X8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU6Vrv1AdrVLnNE2D2wBptFQx_6BEUF32U_akG0Yaz0w&oe=6AFDC2F1"}, {"file_name": "screenshot_4.png", "id": "1116900040921965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/756589809_1116900044255298_8499546322718665313_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=229v1NYQyXMQ7kNvwE0Jc4H&_nc_oc=AdqtPfkmlZ0RpVXJUQMB6NnMEv8yhyocRjpLu-tZjySAWk-ouJvkP5jp5kG84L0ZwQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRNqujITYwgi0f91LcTV7ItDHJLcwOmZY47Hkn_xVLjA&oe=6AFDB9F4"}, {"file_name": "screenshot_5.png", "id": "1349443200476516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830441_1349443203809849_8301142482663050036_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibnHqOSGm4wQ7kNvwGNHm3R&_nc_oc=Adpfkk0U-gmKzTZvm3DLrpVaRmJOemBtFXSWvs6VpnFP3ScgKg_LbJd8v1QGT3Sz7bg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaobMEv-qQvJppbMsOOtHTIeigMGJcicTpoU2SEPcGkw&oe=6AFDBFB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28782336481421009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_28782336484754342_2154373838220496402_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SO5ANcsZMp0Q7kNvwGFTzu1&_nc_oc=Ado1H_uk3yj6XniV2mGBGYW89HBdlQrEX5YtG4E1_ha0n0h9fqM1NmPR9olv1BbsTCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD2WVru7mEuQ6dsGFnEFjE0QCHwZn379QzeMUx24kYjQ&oe=6AFDAF28"}, "display_name": "Graffiti LA", "keywords": ["graffiti", "losangeles", "painting", "art", "sandbox"], "long_description": "Graffiti LA takes your spray cans to the walls every writer in Los Angeles knows.\n\nFOUR LA PLACES\n- VENICE BEACH: the Venice Art Walls on the sand at sunset. Free-standing concrete slabs covered in years of pieces, palms down the boardwalk, the Pacific breaking behind you, the pier wheel turning far up the coast and a banner plane going by.\n- LA RIVER: down in the concrete channel at blue hour. Paint the giant piers of the 6th Street Viaduct under its glowing white arches, with the downtown towers lit up and a freight train rolling along the bank.\n- ARTS DISTRICT: a warehouse yard on a gold afternoon. Painted brick, a steel roll-up shutter, a cinder-block wall, power lines overhead, a water tank on the roof, a taco truck with a queue and a helicopter circling the skyline.\n- MELROSE AVE: the pink wall and the stucco shop walls off the avenue on a blue morning, palms climbing to the Hollywood Hills, and a lowrider that pulls up and hops.\n\nTHE CITY IS ALIVE\nPeople stroll the boardwalk, queue for tacos, take selfies at the pink wall, sit at cafe tables and stop to photograph your work. Traffic, trains, the surf and the city hum keep LA moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of concrete, stucco, painted brick, cinder block and steel shutter. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Los Angeles. Bomb the Venice Art Walls on the beach at sunset, the piers of the 6th Street Viaduct down in the LA River, the warehouses of the Arts District and the famous pink wall on Melrose. Four real LA places, alive with people walking past."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitila/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitila/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374673065729229"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385279798001889", "version": "1.0.1"}, "id": "1787450999238877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
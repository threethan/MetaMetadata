n.com&_nc_ss=7f20f&oh=00_AQRKbnCoJO3W264rWKpvwHYR0f8w6_WJBYv2cOmlweNwGw&oe=6AFB1CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28782336481421009", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831279_28782336484754342_2154373838220496402_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu2bxVt-9SgQ7kNvwH4imLn&_nc_oc=AdrCMS8moUpw-7YeIA8PjLEe9-d6GAyu7ouT6xk3wb5ylc7fpikMSfOGqEEG6XuHe5A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLHGiPf7sgJiNeVDQhL8z_bLm9f3I6x435ZvJnNTzHtA&oe=6AFB4468"}, "display_name": "Graffiti LA", "keywords": ["graffiti", "losangeles", "painting", "art", "sandbox"], "long_description": "Graffiti LA takes your spray cans to the walls every writer in Los Angeles knows.\n\nFOUR LA PLACES\n- VENICE BEACH: the Venice Art Walls on the sand at sunset. Free-standing concrete slabs covered in years of pieces, palms down the boardwalk, the Pacific breaking behind you, the pier wheel turning far up the coast and a banner plane going by.\n- LA RIVER: down in the concrete channel at blue hour. Paint the giant piers of the 6th Street Viaduct under its glowing white arches, with the downtown towers lit up and a freight train rolling along the bank.\n- ARTS DISTRICT: a warehouse yard on a gold afternoon. Painted brick, a steel roll-up shutter, a cinder-block wall, power lines overhead, a water tank on the roof, a taco truck with a queue and a helicopter circling the skyline.\n- MELROSE AVE: the pink wall and the stucco shop walls off the avenue on a blue morning, palms climbing to the Hollywood Hills, and a lowrider that pulls up and hops.\n\nTHE CITY IS ALIVE\nPeople stroll the boardwalk, queue for tacos, take selfies at the pink wall, sit at cafe tables and stop to photograph your work. Traffic, trains, the surf and the city hum keep LA moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of concrete, stucco, painted brick, cinder block and steel shutter. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Los Angeles. Bomb the Venice Art Walls on the beach at sunset, the piers of the 6th Street Viaduct down in the LA River, the warehouses of the Arts District and the famous pink wall on Melrose. Four real LA places, alive with people walking past."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitila/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitila/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374673065729229"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1027024080343038"}]}, "baseline_offer": {"id": "1027024080343038"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791922080, "status": "PUBLISHED", "id": "1027024080343038"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385279798001889", "version": "1.0.1"}, "id": "1787450999238877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_
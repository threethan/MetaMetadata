8_1605370507953618_8791101636060611399_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Z9wF83SwQQ7kNvwFcjjMH&_nc_oc=AdrHuQY9iY3Rscgk6dGjs45C0BSWDq1ubYxIVdzCgg3D4jjc97lvxCzR9z0_5ligLBU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQc04hn5_HE2btjNpls1xyscGsd3V0EGyjPyRjWha_4aQ&oe=6B0B2123"}, {"file_name": "screenshot_2.png", "id": "2423937671472617", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831299_2423937674805950_8691653352181080878_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Licm6xnVIqEQ7kNvwEpQwm_&_nc_oc=Adq4K4tyFA9uiTS0vHqOBMjgjigTX3amYjpqkGIZ4ZNeF74KxxpVq8zDQBiU0tTUYTc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbMTVEtWXqueDaE-quOaitdo__gLEutPf7jy8aotfX2w&oe=6B0B1068"}, {"file_name": "screenshot_3.png", "id": "2158631718408003", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604370996_2158631721741336_6146886964111215675_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F21luylFCP8Q7kNvwHArXrH&_nc_oc=AdoTXdF_36qubBRG4hWmm_IxDJXLQqnN0c2_Z4GInNbOPip-1mBivRoXhDQ8Ismfk5s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjcHIU41jAWWX85wi8q8V2-_N0jKQJ1pN0iFapIoI1OQ&oe=6B0B2A31"}, {"file_name": "screenshot_4.png", "id": "1116900040921965", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/756589809_1116900044255298_8499546322718665313_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgJRsCRnZ6oQ7kNvwHJTQIt&_nc_oc=AdpOuD4WH1a524yDqJTKx0w4Pnr08mvF6xYYeqkFQQFFOjzAU1G_fhmzHyXHC1cus94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxdoZGRl4OKusjYHO5cIpO0ndMxh1lnFB6WRobY25DNQ&oe=6B0B2134"}, {"file_name": "screenshot_5.png", "id": "1349443200476516", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830441_1349443203809849_8301142482663050036_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_b2GyV57C0Q7kNvwEJSTw8&_nc_oc=AdrxU6jTGIglUkK4zaMLIWB4OvuA7NHuKOELTNnph_vEqS9yhxCgRLMRIOihvqQA6Hw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-ugiwViTpHjQqRRw4VBJzsI8ydvfdzGlVPqpNp1oZLA&oe=6B0B26F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "28782336481421009", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491831279_28782336484754342_2154373838220496402_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1sv4H3NS8AQ7kNvwFtVufh&_nc_oc=Adr1x0U_-r22A9pr3urtuu8qelfFxxK2uWdrNoSYSPUNbtvEhGO04H9NqotkqsIOeKg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTy9TzmPFzs9bvmAQqktKueGfCUEAPKCah_o9NsXNJ26g&oe=6B0B1668"}, "display_name": "Graffiti LA", "keywords": ["graffiti", "losangeles", "painting", "art", "sandbox"], "long_description": "Graffiti LA takes your spray cans to the walls every writer in Los Angeles knows.\n\nFOUR LA PLACES\n- VENICE BEACH: the Venice Art Walls on the sand at sunset. Free-standing concrete slabs covered in years of pieces, palms down the boardwalk, the Pacific breaking behind you, the pier wheel turning far up the coast and a banner plane going by.\n- LA RIVER: down in the concrete channel at blue hour. Paint the giant piers of the 6th Street Viaduct under its glowing white arches, with the downtown towers lit up and a freight train rolling along the bank.\n- ARTS DISTRICT: a warehouse yard on a gold afternoon. Painted brick, a steel roll-up shutter, a cinder-block wall, power lines overhead, a water tank on the roof, a taco truck with a queue and a helicopter circling the skyline.\n- MELROSE AVE: the pink wall and the stucco shop walls off the avenue on a blue morning, palms climbing to the Hollywood Hills, and a lowrider that pulls up and hops.\n\nTHE CITY IS ALIVE\nPeople stroll the boardwalk, queue for tacos, take selfies at the pink wall, sit at cafe tables and stop to photograph your work. Traffic, trains, the surf and the city hum keep LA moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of concrete, stucco, painted brick, cinder block and steel shutter. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of Los Angeles. Bomb the Venice Art Walls on the beach at sunset, the piers of the 6th Street Viaduct down in the LA River, the warehouses of the Arts District and the famous pink wall on Melrose. Four real LA places, alive with people walking past."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitila/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffitila/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374673065729229"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385279798001889", "version": "1.0.1"}, "id": "1787450999238877", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": 
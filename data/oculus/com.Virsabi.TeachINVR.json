zPfpqCrSwm-ES7GFUwVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL4LF2BtPg3I78Ib2l8qPOwwzUMGtzcuzUoVLGygvsTA&oe=6B05ACF2"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb-EV8xlXTsQ7kNvwExY5vR&_nc_oc=AdobgBbiIAtKl7pHCF1qlGZE047QokCRdKkqCHC2-hgo9O7SxULAjO_xH2cjTDiTl-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_nucUejzAZrYsA7JkHZ7A4tgMYUZKr-A5hkN9E91_UQ&oe=6B05B820"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIyBqdHIN_0Q7kNvwELljDQ&_nc_oc=AdrsPfr0A7ZSIYYYmdWvOx0rK-IbBo_albZKf_naLHzSQlZC0jW4E5BHT0oL5KAIhgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1nbviz4iXngBIhD2OeDktkwf8gNgEKNyWLdk6QulGvg&oe=6B05D0A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "de
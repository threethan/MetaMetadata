jmG5uIcQ7kNvwFusb9e&_nc_oc=Adl0Za1fVGxgMGFgCf19NqSaRfafdovRLxw1jYw7ObqA6ZtNUJo4sWxroHEDdcz6rKg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsRheUsKI6xGBfTH_mMtJrQSndtlcHAX7qSC05leSgQww&oe=69A6D0E0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kaNB2lQsdcQ7kNvwH0U5Y3&_nc_oc=Adk6RbEcSGyryI97VGXcUdgSsmG5UNXzgnYZUzYx4JSRXYegQEwQ-glyKV1N5EqSKhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRz2hqGq7hTy3tVahvPFS1roVvh3ekyBBy4mAx2DBbUw&oe=69A6E966"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e858cefd-2078-4b81-be4e-ecce5a5861cb", "developer_terms_of_service_url": "https://virsabi.com/terms-and-conditions/", "publisher_name": "Virsabi ApS", "support_website_url": "https://virsabi.com/contact-us/", "website_url": "https://virsabi.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_categ
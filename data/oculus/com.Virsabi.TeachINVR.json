uscdn.com&oh=00_AftvLuX17ReF_oN4e95ygbgeWoDWnSqAMTcEhh8XIBy1FQ&oe=6999964B"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112433.png", "id": "620378979560050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003270_620378982893383_2197042705114745547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzSAz7r8sRYQ7kNvwFBYusI&_nc_oc=Adnpd4nGZ_OQjI7bYbhl2h7YrAITa6oxUrfZyUZnzIjhufGQBhaQw3pibzgrhCwrQwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuj9KsPwgyQhZmnWHr4ZqBbL50zI4uVWyZhRRV57m1RqA&oe=699996B2"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4FKmPHHMGwQ7kNvwFOh9wc&_nc_oc=Adnn8Jr0MKekwTo_oG6Ln9u_kw1Vx1gf0Zq4r1hooFCKcR5nXHj2Ol6GZoMqhQ2Vo_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftL4gsV-1GNs4IYsCu26ycorUKhxDpwmvunrOJ0Jxp5vw&oe=6999A1E0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3zn-uvaLIEQ7kNvwHMuLi0&_nc_oc=Adm6YVp5e9pqiiLy4tw9LJa9XKDhkIkAwZRe3fM72BsQA92E4qP8hzawKjPutnstCH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv10Mene9LqtUR_8TMstXIuOLTl8X0t6CtFckwjOafrrA&oe=6999BA66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experi
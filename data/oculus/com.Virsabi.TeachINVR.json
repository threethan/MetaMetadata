3-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBDVXYLjB1AQ7kNvwGNtoQA&_nc_oc=AdomsouzgyDMS6Luav-8M7bBCYn6NYwoL7g4a_lKObp4ZWJZWgdzD771LVW3FnNELcQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUyxBrFDf4d5hTvqizP0GopZVM9jkLV13AUs16tc7fDQ&oe=6AECABA0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nn9LM-Cm06MQ7kNvwGHzymJ&_nc_oc=Adr2_K39I0_i-ox23uQeW7j1vcAhENW4hsqAJwbfH0WUVsfOkUNpLuIOS2TBx1SmiGE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1ysb41HgbDaG_j5fI1BMuSB0jsz9Fnq_LEBs4QzFRDQ&oe=6AEC8BE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e858cefd-2078-4b81-be4e-ecce5a5861cb", "developer_terms_of_service_url": "https://virsabi.com/terms-and-conditions/", "publisher_name": "Virsabi ApS", "support_website_url": "https://virsabi.com/contact-us/", "website_url
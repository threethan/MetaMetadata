WOcFJ6hWCS6FPz9bSikU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwO3TiZueChew-hDnIwOme7RIpLSZZ2JgCxAG2M1kpoQ&oe=6AFDC3F2"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSTQ-HzfnG8Q7kNvwFgJzp8&_nc_oc=AdrRr38CKUP0yXUDWsM6cYINfnN5JZTu4v6--q005BveMyJ2KNLyrgvco-OrGsJeJ1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTROZXRnSYscCqwYK6geZHIY5dbMKziivzM4opyusYmBA&oe=6AFDCF20"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G78j_Q0HSToQ7kNvwH7hCMW&_nc_oc=AdpKdq2DcthzuL5S51N3L2W15NhBFFWE-rZW2HvsID19ZqI0Rseb1SLFyNoOHBEYkEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8npXcewu2iyRZoildzE9JRS9R9UyhgH9FmCeCU4qOaw&oe=6AFDAF66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "de
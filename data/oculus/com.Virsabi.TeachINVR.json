3-2.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2eqlnwh8vIQ7kNvwEm6-r5&_nc_oc=Adp7ipk3ov7jTHxXSJUuEdTOAC0TPHBa1JuCBlEKztrCYB2sQSgfTC4yWQ8fcM6oxrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHIyDDY-yB_9Pfr38CDFKsgBa-9OV0bSIG80-iNXZP6g&oe=6A674BE0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0aSXtqOWZ0Q7kNvwEontiC&_nc_oc=Adqzdr7xXlvDTIb071SyUw0fRrbAcaSXpQXHp4YmL4ASacSEdk5P8O7L6nMPgV7bRBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLM9kQsy4UgtPaD2BouIxI5Vg1j4iUctmNeJT2msn2FQ&oe=6A676466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e858cefd-2078-4b81-be4e-ecce5a5861cb", "developer_terms_of_service_url": "https://virsabi.com/terms-and-conditions/", "publisher_name": "Virsabi ApS", "support_website_url": "https://virsabi.com/contact-us/", "website_url
quU3GIzUPd0UQIFh9UgU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_SKmWcusPPNFHJ_CR8GAyEn4zJK78M44iM7EPHYmzoQ&oe=6B1038F2"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KomuFQXhgIcQ7kNvwHlfKSx&_nc_oc=AdqFqkWLTCXhKwBqw2beqaLLVC7ibSa-M-MPxjLuFrQ2EsHVO5-rgxMgbPeJGmhStq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8YTMNM6UcLwrbq-4l_vIeH7x69ye-cfvypGR9sBqH3w&oe=6B104420"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPQU_xh-SKoQ7kNvwHZnLuZ&_nc_oc=AdrfBWMeFYgajjf1tEvP_B3br4Xu_IGEjX4R-DX8URKp1NaJBfAS7LFor3pqcbruxf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnITFmgWjbbRfbHgmwuG7cLPEywxKE2fPyWVi7pSIbrg&oe=6B105CA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "de
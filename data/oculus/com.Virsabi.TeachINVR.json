k58GK0T6_GYeTwICT9tM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXYMCTstimN3eWFKd8SsUMybriHayGgohpbRpYdHbyew&oe=6B06FE72"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb-EV8xlXTsQ7kNvwFoV-lM&_nc_oc=AdqZUnXz8qzkBsa0z1JZxbJlS71zuXH_oUhC60iGRsHQg1UEy3KOj-6he82wlaKTT4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwkc8zJR-BfrHtPI2VdQRsX-5qFitEwYwru1kj_3QUAQ&oe=6B0709A0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIyBqdHIN_0Q7kNvwFdvNco&_nc_oc=AdoBbJmMu_iLak5kMocwCbwinpjo8iEVbfml8ouCXqnq6SwolsQg_BvRwd48Qrg6oTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVh3teNGCCXZNjN1yvVMmvqGvNqLI2hWpIjUhuOVaxTQ&oe=6B072226"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "de
M-30wonieuJstAff9fdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb1v-4bGv8mVNVJjGNe1IGJ0t7NOxCN79ETh7jH-xR3Q&oe=6B09A172"}, {"file_name": "com.Virsabi.TeachINVR-20230419-112257.png", "id": "908898893677521", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Wd47nws_UQQ7kNvwEnbaQi&_nc_oc=AdoM4akNdc4b5mF1xFkgzjGys5h_GMrUQTq3gf-814-xpP-RMKNj5jGM2M7Zg7zGkFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAp_9nAyyYXa2mr3Z6SqHXt5cNP6jfy8ONeS7nOTmscw&oe=6B09ACA0"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoZH2j5mDVwQ7kNvwEdDRMY&_nc_oc=AdqPxE7ROPvqTcCS20t5iw52w_VO1inWZy6F0MUHPyUhv5C6gta2v4yXvYtaGP0hwaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY-A1sTTZl9sVH88ROQc-gbsoFuHWTCa8SSnge3g_CNQ&oe=6B09C526"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "de
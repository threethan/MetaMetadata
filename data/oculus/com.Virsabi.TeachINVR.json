2-1.oculuscdn.com/v/t64.5771-25/75429296_908898897010854_2135883607289212817_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMCkn6h-jBUQ7kNvwHzL2rS&_nc_oc=AdoJQ_QzXdRjKBMOh71PeNAHsSBzMisacbK5EBQXy_Ov4YFoTRpXJPS7fiyP7-qyTIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CfSJW7con401DI-lpnZhNRwW3YLu5AyR8JVZHzon7gw&oe=69DA3B60"}, {"file_name": "com.Virsabi.TeachINVR-20230419-113325.png", "id": "884606759269996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974711_884606762603329_3705987514049385523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CtFz09ImkQQ7kNvwEorZZ0&_nc_oc=AdotmHnczXe1n29dRWDWmP4mMIfF25XpkaDfC2j_7D8Po7n30ho__tXhdPh4TA2IXzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R24XoXwwAwnEckjs3qhGqbkNVMoHVoGzwxJ1bYHdenQ&oe=69DA53E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TeachINVR", "keywords": [], "long_description": "Project TeachINVR is a combination of methodology, guidelines and a \u201cto-do\u201d list that the partnership developed for VET educators or teachers and trainers in general. It contains all the necessary information on how to use Virtual Reality as a teacher.\n\nVR experience is a part of the project as a practice simulator for the teachers.", "short_description": "In TeachINVR, teachers can explore a fully immersive environment and experiment with different teaching methods while interacting with virtual students. It's an exciting opportunity to learn about the potential of VR technology in education and gain practical experience. Get ready to create engaging and effective learning experiences for your students with TeachINVR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/e858cefd-2078-4b81-be4e-ecce5a5861cb", "developer_terms_of_service_url": "https://virsabi.com/terms-and-conditions/", "publisher_name": "Virsabi ApS", "support_website_url": "https://virsabi.com/contact-us/", "website_url
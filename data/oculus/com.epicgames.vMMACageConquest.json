4_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgR0OQuwTT4Q7kNvwHubild&_nc_oc=AdqZPVGS5IPR2JzIZQ7ZI_BCAfwm1qFQ2Q39iQMrqApveIHq5pVONmvQM5b3Afoa2RY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZdNQc5Wua9-cnvbU94yFpc_M6BUM3ReA25ymuwdvLZw&oe=6AB14F5D"}, {"file_name": "Banner_02.png", "id": "448041341462069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_448041344795402_4080917989562232946_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wxMaPximdIQ7kNvwH4jkgM&_nc_oc=Adp6X7cmbM5p2PJIW-BlR9mbsVDbdTUkXwy5qdn6VJwT-RU8sgn-ZcHaBGRLgMlUCrU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX4js7nNj1TmVSOkx0ys6g-Opp3DafpPXruiDVPPVLyA&oe=6AB12C57"}, {"file_name": "Banner_05.png", "id": "1253765072349347", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75416836_1253765075682680_7627978631645109694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bTkFUcqCv0Q7kNvwE4Jh1-&_nc_oc=AdpZ89h0mjeqijabXXtlM8dvQbIYWXBni5c3_2M6fldlfyFNtwfX3qw1PIYTYKvIpO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe2xTtf_5PDaso39eAcYZc1aCRNekAygdWkwuzPIbYhw&oe=6AB14A21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "473392192_2361957164180608_3019403449126027263_n.png", "id": "1285718380242129", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_1285718383575462_7792467359913013696_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MjUohvpkqcQ7kNvwGUK5G8&_nc_oc=AdrbWglg-yz0lZN1AdWepHSZIpwzD59_zaC1026jb4W5vANY3QGrsycwsAMI0HiHKYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhPJUQN79ZQ6sZo8AAH357WlZOoXuJTO1tHjBnxCoBsg&oe=6AB152B9"}, "display_name": "MMA Cage Conquest", "keywords": ["MMA", "Boxing", "fight", "Fitness", "Sports"], "long_description": "Welcome to **MMA Cage Conquest**, where MMA meets VR in a heart-pounding fusion of combat, competition, and total immersion. Step into hyper-realistic arenas where every fight is a thrilling test of skill, strategy, and determination. the Champion's Journey beckons, offering challenges, triumphs, and unforgettable moments.\n\n# **Fitness Zone**\u2013 Enter a dedicated training area with upbeat music, real-time progress tracking, and competitive leaderboards to push your fitness to the next level.\n{3870906369866117}\n\n**Multiplayer Mode** \u2013 Challenge other players in real-time matches, where you can go head-to-head to see who has the strongest punches and best reflexes.\n{749237564215951}\n\n**Single Player Mode** \u2013 Test your skills in the arena as you compete against yourself to improve your punching power, timing, and precision, all while climbing the leaderboard.\n{883325264157478}\n\nGym & Fitness Zone Features:\n{1208638167736963}\n# New Social & Interface Upgrades:\n\nLogin & Friends System \u2013 Create a profile, add friends, and fight together in single-player or multiplayer modes.\n\n**Enhanced UI Flow** \u2013 Access menus and gameplay features quickly and intuitively without navigating through physical in-game locations.\nAre you ready to dominate the gym, conquer the cage, and prove yourself? Your conquest begins now in MMA Cage Conquest.\n\n# Join our discord: https://discord.com/invite/qyNj972zqM", "short_description": "Step into the immersive world of Cage Conquest, where dynamic combat takes center stage in authentic arenas. Embark on the Champion's Journey, honing your skills through strategic training to conquer online championships. Experience the thrill of victory in VR."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/cageconquest-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "
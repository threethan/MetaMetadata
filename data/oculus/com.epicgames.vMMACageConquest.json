vwEzb9Ul&_nc_oc=AdoKPay7ViVB3BM-SnUwdTrBurDwJTNbrq3ULf2weVoxFna9zsrPFM_vZY0ZKVNVZqE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tIgeogvDmluyb23BhGBexb0I6737e6lRHbvtqrvKV0w&oe=6A369937"}, {"file_name": "21.png", "id": "1227909608618750", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974888_1227909611952083_6668526633039098478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFxvq8SlNxkQ7kNvwGRpBVJ&_nc_oc=Adpi1AkIyLx-4wOjVgX8VmAHcN_Ghwf699hdUOspOQc65QMrTyewBPGpQxCzkBrGq-w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dvIiwmCaZU-DnThwTb0-fbQkWdVN7fDe2weFi44GnrA&oe=6A36C2C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-27.png", "id": "1496395737608560", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974841_1496395740941893_1264087118227965873_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sgs6PnqSH0Q7kNvwE8ZMZa&_nc_oc=AdpZlVQ1O2N4hxLj2gcfF_HlaIwXucfL7QYwNXt-ptHpQdjFyi0f9Q16PxOwQG8H4kY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BCXzgiCx0K07mgEJP7sxj3b2f8Vv2t4TLEsl7pSW5Iw&oe=6A36C7A1"}, "display_name": "MMA Cage Conquest", "keywords": [], "long_description": "Welcome to \"MMA Cage Conquest,\" where MMA meets VR in a heart-pounding fusion of combat and immersion. Step into authentic arenas where every fight is a thrilling test of skill, strategy, and determination.\n\nIn \"MMA Cage Conquest,\" you're not just a spectator\u2014you're the star. Whether you're a seasoned veteran or a fresh-faced newcomer, the Champion's Journey beckons, offering challenges, triumphs, and unforgettable moments.\n\nTrain diligently across various fighting styles to outmaneuver your opponents. Then, test your mettle in high-stakes online championships, from intense one-on-one battles to team-based showdowns.\n\nClimb the ranks to unlock new arenas and customize your fighter with a vast array of equipment. Feel every punch, kick, and submission hold with cutting-edge VR technology, immersing you in the raw thrill of combat.\n\nAre you ready to embark on the ultimate conquest, prove yourself as the undisputed champion of \"MMA Cage Conquest,\" and etch your name among the legends of the sport? The choice is yours.", "short_description": "Step into the immersive world of Cage Conquest, where dynamic combat takes center stage in authentic arenas. Embark on the Champion's Journey, honing your skills through strategic training to conquer online championships. Experience the thrill of victory in VR."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/cageconquest-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7240758756033910"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PENDING", "id": "983331861002768"}, {"status": "PUBLISHED", "id": "1731660111166782"}, {"status": "PUBLISHED", "id": "2043767649850653"}, {"status": "PUBLISHED", "id": "1950644855838118"}, {"status": "PUBLISHED", "id": "1413742127086136"}, {"status": "PUBLISHED", "id": "876844661666345"}, {"status": "PUBLISHED", "id": "1546077933074786"}, {"status": "PUBLISHED", "id": "777357641659460"}, {"status": "PUBLISHED", "id": "1305486730961
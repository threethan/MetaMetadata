.com&_nc_ss=7f30f&oh=00_AQTtjr4wFV3OZLCyqqwVt2CCOa2sa1clS9C16jPouIjWhA&oe=6B0DC5C2"}, {"file_name": "Meta_Screen_4 (2).png", "id": "1844334550026871", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822854_1844334553360204_616132822798054946_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueZKWo95Ay4Q7kNvwGGQwzJ&_nc_oc=Ado0NBMwZufpN2R_WSqljwOJVHeuq7MzwNo-XtpRIujsymPMbxdUoIq44ok73F9_Sic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjNzvlcTYIUUGoTeWt0bGDZP9w-I5saAYdoy1-Iqgweg&oe=6B0DAB4A"}, {"file_name": "Meta_Screen_5 (2).png", "id": "1643027137861907", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1643027144528573_8618782593230455906_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml-W2fjLVtwQ7kNvwFlFcjB&_nc_oc=AdpiS3NXE3acOnn6XWle-dEMadxZ4gC4SBD1zSPoODPkWKIQIgiaGw_BPQYfAw9eta8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaoX0kaAbl7GmQ-JJZYoeXoT7VZ-wEUM6D4FApB63zFQ&oe=6B0DA253"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Don't Get Wet!", "keywords": ["survival", "parkour", "monster", "obstacle"], "long_description": "THE WATER IS DANGEROUS. DON'T GET WET!\n\nThink you can survive without touching the water? Enter a thrilling VR survival adventure where every jump matters, every mistake is dangerous, and a hungry monster is waiting for you to fall!\n\nIn Don't Get Wet!, your mission is simple: stay dry, overcome challenging obstacles, and make it to safety. But don't let the simple rules fool you. One wrong step could turn your escape into a nightmare!\n\nSURVIVE THE CHALLENGE\nJump across dangerous paths, navigate tricky obstacles, and test your timing as you fight to stay out of the water.\n\nESCAPE THE MONSTER\nSomething terrifying is lurking beneath the surface. Fall into the water, and you might become its next meal!\n\nTEST YOUR REFLEXES\nEvery obstacle is a new challenge. Stay focused, move carefully, and prove you have what it takes to survive.\n\nEXPERIENCE THE THRILL IN VR\nImmerse yourself in a tense virtual reality adventure where danger is always just one mistake away.\n\nDO YOU HAVE WHAT IT TAKES?\nMaster the obstacles, avoid the deadly water, and escape the monster. Your survival depends on every move!\n\nDon't Get Wet! - Stay dry. Stay alive.", "short_description": "Stay out of the water! Survive deadly obstacles, escape a terrifying monster, and test your reflexes in a thrilling VR survival adventure. One wrong move could be your last!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kaevgames.com/vr/privacy-policy", "developer_terms_of_service_url": "https://kaevgames.com/vr/terms-of-service", "publisher_name": "KAEV Games", "support_website_url": null, "website_url": "https://kaevgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1508601608995041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/793139181_1698730418276653_1500599058056605919_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ellGmXMwR0Q7kNvwHtk9Dp&_nc_oc=Adrdm6pg4VvU79vs5rp3RtAs0Czru8ON6CHnidI0dcuGWWsDGcYpTxhq62meQbOUlwU&_nc_zt=3&_nc_ht=scontent-ord5-2.ocul
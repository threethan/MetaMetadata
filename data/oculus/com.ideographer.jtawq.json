kNvwGCcWsr&_nc_oc=Adqv7fUIxbwfdpux0PgSaBC9TFxzbLUalEO-qsmv7JSt1o5msUIVpLBH4TZE0aoPUlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SwX4B9tJb1EM2tMqcVC7GgNI63GdEFqiwHWFEP9fueg&oe=69E0CCC0"}, {"file_name": "38982573_395025124377224_7913565362724012032_n.png", "id": "3845064792283266", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974866_3845064795616599_5170608189468779082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAJ3mLnOZ0kQ7kNvwGwEodD&_nc_oc=Adrt6aL4XWz8CdSzTKtIpd7msgBX5e1KOz0ksp0KXD_O4by-LnidRDcS9ceE8jLkuRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SH1QxU9XwjFGoshmSU0nsNZ6ftiS66sDeLKfYFpWZuA&oe=69E0D3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974872_853434908334062_4727659262224891904_n.png", "id": "298291051894866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572930_298291055228199_8142593642656323511_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HFCvkMSge8Q7kNvwGJ4rUo&_nc_oc=Adr0wNKg-Wn8o3dFwt_g0QAVqw40jaXd9vliDgdAOR87A8gRqkLmxVfa7IsTFoTmvgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mM7vycHLgsTUfXBfKdckeYEkBEjpRKqWQnDirPIwyIA&oe=69E0D29C"}, "display_name": "Journey to Alien Worlds", "keywords": [], "long_description": "With this virtual reality experience, you don\u2019t need a bulky spacesuit anymore to travel into outer space and land on planets, satellites or comets in our Solar System. Now you can experience how it feels to stand on the surface of these bodies, view the amazing scenery there, and get a better understanding of the differences between these heavenly bodies and the Earth. You can also bear witness to mankind\u2019s great accomplishments in the exploration of outer space and get to know the landers and probes used and their designs. \n\nCurrently you can experience the following sights:\n1) The Moon and the Apollo Lunar Module\n2) Venus and Venera 7\n3) Mars and the Curiosity rover \n4) Mars and the Perseverance rover\n5) Titan and the Huygens probe\n6) 67P Comet, the Rosetta probe and the Philae lander\n7) Saturn and the Cassini orbiter", "short_description": "Now you can experience how it feels to stand on the surface of other planets, moons and comets, and bear witness to mankind\u2019s great accomplishments in the exploration of outer space. Currently you can experience the following sights:\n1) The Moon and the Apollo Lunar Module\n2) Venus and Venera 7\n3) Mars and the Curiosity rover \n4) The Perseverance rover and Ingenuity helicopter\n5) Titan and the Huygens probe\n6) 67P Comet, the Rosetta probe and the Philae lander\n7) Saturn and the Cassini orbiter"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ideographer.com/vr/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Ideographer", "support_website_url": "https://ideographer.com/vr/", "website_url": "https://ideographer.com/vr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPACE_UNIVERSE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "615131496220711"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "2063318817497835"}, {"status": "PUBLISHED", "id": "1518077028534585"}, {"status": "PUBLISHED", "id": "1095322328253447"}]}, "baseline_offer": {"id": "1095322328253447"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, 
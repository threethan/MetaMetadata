50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDshyLnuHzkQ7kNvwH1NQ_f&_nc_oc=AdmVk1k8DZjiMM47eCUoFuaBFlkP1mXrR4cV5osynfECmTQLaKwEy7B8QZRFd0LJ6tw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxved_po1NRM15WU-klknv300eq7Zl0BmmcTA-ZYkCyRw&oe=69B011FB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cchW-YqGB3IQ7kNvwEn3-Gh&_nc_oc=Adk8a3TYueNDLN97usQXiBEd_tsDakewioriAySTDsbGb13kJQif5TSEBV6t7YIwNUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8GBPWaUjxDLRwUGK78sXoTyl5dADMfOrcdtptpI_dWw&oe=69B02A94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEZPzV0IDowQ7kNvwHwZ04x&_nc_oc=AdmzQeRvUZrROKLHgwwOoNK12Kt_hiBrAm0BtBdO906orzCkkpa7GwGDcwlkWd9gFq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybD04BsTLSZ6KHy99EKlAFPpiwV32kFG_FJO11vHDQig&oe=69B01863"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
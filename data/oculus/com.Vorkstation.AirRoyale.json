50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8agOuWTcLjoQ7kNvwFb_GSc&_nc_oc=AdnXUEQZc1mT8KmsgsCw6cYJjiNLvwUuh7SG02iwbPkXJnOCJFB-yH3Ht4E4kYgZbkY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw03PF_QMntelT6YY-Sn7OMdlb9m8OrezN-znXTaEENBg&oe=69AC1D7B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBsN8DubL6IQ7kNvwH-wt1U&_nc_oc=AdlD7EhShLtAtNlQSA5cafl-FCUa8YbdMuRX8-8FQdeqvK56qyJFzfcL2EOUAWEYDIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9viJ8uH9OB9cXGKJGjX3pDBQIzjIRRVbk2tUOfw9ETw&oe=69AC3614"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXAvFu773BEQ7kNvwGfQCJY&_nc_oc=AdliIYHOh4y5OGiyEulosm0lv5EX5g1izId00As0RTv2F8LLHmoNsdRvUmsECQcAYv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRtU9Rl_zyDeXWcNhhlgpwP9HfHFWM0nwZ0NFDfQOKcw&oe=69AC23E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWHNlBFasG0Q7kNvwGAxrd4&_nc_oc=AdnRUYdo97C5WcXNc7uLqJ_GObhp7pKP2G8hKIbDKLeWzI_TSxyvowvunN4Z8gbiW-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzopVsCCFS0gVUp-din9SA0Y0rsMqUdxDUwjpliPTLdAg&oe=69B94C7B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG0_YJVoyd4Q7kNvwGvnEev&_nc_oc=Adly6NvBiCYrsUo5ALGj9yfQb7sSH_Cz-nP68s5G2ZWv2ZxeJKJWKJpgsgrTyFsIyOI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5FhxgPC4Tz_oqsK6x1eFlNWA4XD5kx3NCnZZXo1YgEA&oe=69B96514"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO1GC0ZHQcoQ7kNvwHgUQBR&_nc_oc=AdkpTyMS2PQFJ-_Gd1jtTdlq-cfOrhW1Jf5MRWL_zutWQteBKJMApIXtKvK_cdf-4Pc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhJyDRqhYhcOXcj49-bLAAOeAKoonsZzU7mPqAtiCZ3w&oe=69B952E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
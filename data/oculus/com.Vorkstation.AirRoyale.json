50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGCDGFUXzDkQ7kNvwEQVGyk&_nc_oc=AdlvLAaLGxXagLmqfJ1QF7g_FoGy7Pe5sU2khEvXkBD3KmRHwK5s-KCn-zXKzSetj3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt7lA2_25re_SvNaHN1Bz2XilhHKIT-ZYUilgjcipuWg&oe=69BFE3FB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd_lnt-FMhsQ7kNvwFP-VdU&_nc_oc=AdmsLsaRv5ec0i7AcbEx6z485xAxNfDOcD_8JKm9DQkJ33fTG9yapvKSYhVEm4lJ-Sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxpl-6QedJRevxqk9Ki32LsSt0EAxL-V-oHq6z0C5WkqA&oe=69BFFC94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glC0gTuDtcAQ7kNvwGzrZoS&_nc_oc=Adm053TM_F_Asq-WoCOtIjGJriLkXY34CwBzzbjdqdoM5-dNk5CwPwEeZg3SwapSC5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI3HaPthVNu7-LiJz2XF7VxuO1NgyLDNRQqLEJD4BCwA&oe=69BFEA63"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3KU5y1PSAsQ7kNvwHFo0Lf&_nc_oc=Adl7kX2QMe3MJHJTPZLWDt_c1I0E6LttlBXHvQgWx6qG7sosUlNPr6fkaRPwHan2FGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfudDTgEm1wqZnk1jQ0esi0n80kz7X7Ni4dDqxYfVp4mLw&oe=69A828FB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KykZV5FHAfoQ7kNvwHV6SMP&_nc_oc=AdneVoixn6zAm-OeenKUJBrIEreSdU6rvY8XlHKpOz-6T-RudlPBGE2Vn1RxCNzNfvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs8APYdkYh2k0_SLyl8h_d1cVjgnXg393ksuHzVNW2eHA&oe=69A80954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8IAOEh65eYQ7kNvwHsCLzP&_nc_oc=Adlw4q0ZMKEsxcXH_NIzDxl0D2x4uPU3XenJpsyozoV9AmFZgU08vgECpNJ0ZbSUxgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftJ8tEslVZP3FLo2vI-S92HD1Ds1sJSxMOJkT3EiHyAkA&oe=69A82F63"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
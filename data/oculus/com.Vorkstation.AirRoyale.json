93518_582250721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3KU5y1PSAsQ7kNvwE9FKh0&_nc_oc=Adk56dw9yC4YFMDnmeBq9zOlSOfNf84ZCZUf9yqLS_udv21gB1wW5ji_a3aORGBMAqc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDMJj29Y-O0w_7LUZl29cp7ltM7uLLnTRDB-6L5sz4sw&oe=69AACBFB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBsN8DubL6IQ7kNvwHrSjQV&_nc_oc=AdlMn5CR6SSYdmXTOoK1WqeT6GDgiZQEP8hSwbnxQQF7apdUBJoqGL0QbSnSHtLgM-s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjCwqg-1PWYM0sl6GauiGdNyJv-mM26Co3QtvCyvXyaA&oe=69AAE494"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXAvFu773BEQ7kNvwFuHTnE&_nc_oc=AdnHiBNPa-4raXp0ljmT1Yx7i2375Q7L5MP6f_OFPeqx5uBm3GIdrE27HhDNVLFE728&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfTrJtBCPy0Kmogkiumkxtnsh9B1riBqDHYOTOnyjWKQ&oe=69AAD263"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where player
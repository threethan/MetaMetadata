50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8agOuWTcLjoQ7kNvwEIBIfy&_nc_oc=AdmRVdA7vHAmbIEtRa2fwwCJOshi6Jl53rtYggoXRhNpbmHtPW1ZJH0kIvU1V8QF__Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyT0HeyAm4gJSMt31E7e2BxzbtTyLJm3XTlZpGlx-CviA&oe=69AEC07B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cchW-YqGB3IQ7kNvwFjcOR2&_nc_oc=AdkxF50kwjY13cUKQtp4mKSfSYPM1sb2aVkAwRrpbuJZjs-2H9U8D58Gx5aTlRxMsl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4oCJHtt7iuBYhc_fJ4rziI3628DuQv5y8EeZ8LutTAw&oe=69AED914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEZPzV0IDowQ7kNvwFTzHTl&_nc_oc=AdmA9rCyg4c7vS07kSyXpmkWUnSCh0cfb4ykf9hoeSy0bFptvKcT4KlmzvfUVn6kCQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4AfTMsufSJ-e1IQsyOB-efo2SmrNAO9k02GM1iwss1Q&oe=69AEC6E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
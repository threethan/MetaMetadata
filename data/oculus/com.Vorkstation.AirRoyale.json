50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfpNFIG0QyoQ7kNvwGv75IR&_nc_oc=AdkfQHM-yLdiLFMbqGXZAuGjDuZ8L6YkMidYp8fByZJ5t7VLTUROPgaWlIa_vyFQIEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHB3g36nPHTNlHhs7V2UqdlIhOY5cNP5wlPzO2tJ3k1A&oe=69B557FB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg9oWTXWgqkQ7kNvwEVe1Sg&_nc_oc=AdlaDpD-Q9hWEFR2gKrfN8pErEJoOi-omWu73bzPoKliKK3GaRM729ku_jbiTac2fnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwat18NEUcF60AnmLCSg4qFPZ5YXphJNRSKV1D6nv2B6g&oe=69B57094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVT_6IsWDQ0Q7kNvwFGPD-Y&_nc_oc=AdlYUvvpivYoFEy9gTDvFoBVDNytgWg8MQhQxVOgCuYegtrrbAu0Fg1bZqcJJA0a6Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1pM_M5DL6iqlifPMDIgVB2e7br3fSICaBB2GGSp0bQQ&oe=69B55E63"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
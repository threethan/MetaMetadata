50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDshyLnuHzkQ7kNvwHFHtio&_nc_oc=AdmzlXZzC9Go3gHpJ6TNmAleWmJxUahLjuagC2m2WZ3ngeO_ae9fy9VBYCukmeClPUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHxViJmxDhD7giyYCCY6uDNRhKQJl3Y3viYVH8dOrYaA&oe=69B1637B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cchW-YqGB3IQ7kNvwFcjGLg&_nc_oc=Admfx66LyYPuziHKY37UNgAhSOKjEIurWm9G340lwp7wTrWhp4OGN0--GaJri51jSgQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxku99SNxUGGu-aB8OHE2eT33pn7wRRzzsw6-BmpDdCjA&oe=69B17C14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEZPzV0IDowQ7kNvwGG_dGe&_nc_oc=AdmjCZxlDCSwUub7uCHO54yTyqk5UKQrQc-9t5jm8daWbj75hvaaRaAcmgVujeR5Qqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyKuCg5_WQy0_DvZW4AzXSqvScWplKPVbACR38XtyliQ&oe=69B169E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
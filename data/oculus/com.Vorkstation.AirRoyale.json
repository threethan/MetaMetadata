50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ05iJV95SgQ7kNvwFlgqYx&_nc_oc=AdlX4cWBlJnVzb9PV7LKUqMWauRGXo3uT-dCi85GVH4GKrftX6s72fzA_Jt3kv7PeNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPKmqbutc7aZU4_SsXfRTgGbRWldhKYfxja-g6Qr4dxw&oe=69BE927B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gd_lnt-FMhsQ7kNvwFRSNMO&_nc_oc=AdlgICVIkVbbYd-OG6tBe5T1Jz5Q32iCvjzjZE1cuj5Tv6Ypoi688WlLV7IT_JzZba0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFbCSwyUA9K0B0AuMYE_VmCGXCUOnoeUBvZitMvOPFXg&oe=69BEAB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glC0gTuDtcAQ7kNvwEyLUZ8&_nc_oc=AdkIZforRkpmNFtbxzV9Y08wT438zsMXHqCfWOElU7Sw6uH5KU-TwVxn7ci2_PVenEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxwAmLEMXPW0IJTTxX44TO3xl-LjAlC_rOg_Vm9ZaQJ0g&oe=69BE98E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
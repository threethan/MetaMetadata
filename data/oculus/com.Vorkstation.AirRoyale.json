50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3KU5y1PSAsQ7kNvwEyQcFF&_nc_oc=Adkgnci8sGX_L4JDmRXcapEqMwfJt4mKQliH3nwIlalQ3cCJq4XdDsa4K7Dei7KLUh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWFT93AyyKzZnydW5n25xYuprins-zA9mkcX5j0cUYJA&oe=69A97A7B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KykZV5FHAfoQ7kNvwFlPShz&_nc_oc=Adkjgs2mu0ipx0hmJrfz8R7trZZHNA9FqJRhOy9GDI8flGLykcsR332LHEblhPQOqJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvIqRt2t39LL_qbICNOZeIaLpZLlXuUpca0L0hHx6l45g&oe=69A99314"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8IAOEh65eYQ7kNvwF3Zrrb&_nc_oc=AdlDcqw9gLjr55RwenI0D5G5HZ1r-C8I7-6bA1aAERqIqhdfEcS9mYLpTg2nr5Ujs54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYXrFNd02wlY0G821_YZpLwY_gPilYI0SEl5xQWOfKuw&oe=69A980E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfpNFIG0QyoQ7kNvwEbDZ3q&_nc_oc=AdlOiqADNnUz9YTGCDIhKnO3Kro7JgV3EcxadRfZLdHVvvH2HLyHLehksAu68VyVphs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzEpsCyBWsgqbRFaUxXxaznJXEqcfAzXQ_LfpllEzVUwA&oe=69B4067B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg9oWTXWgqkQ7kNvwG-mJMf&_nc_oc=AdmEQgOSE6S9pWV-h9m3oMkhHz4pL5Vq2_1m5onMWsgYbkVha3GN0dcEN46qh3DMJPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAnCcuxlXZerHLt4eyQ_qcJmkhNXaaDP0EZdMQWpawMQ&oe=69B41F14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVT_6IsWDQ0Q7kNvwHDW-HN&_nc_oc=AdlalMV9keZl99epTJk879xTCZBdSgbUuzvyzTOB0EmUVNflwGtNEaIw0X4tDlmo6SM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXcK3ZBZpmDO4DOcfCRQIZOqIvuc9advySHgV2LZsueA&oe=69B40CE3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
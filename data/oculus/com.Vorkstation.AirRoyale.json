50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfpNFIG0QyoQ7kNvwFmk0HE&_nc_oc=AdmPSlIQ8zbEEveiQL4C8-rLVP9BO5JazM1c3gHw3p3_IL56dj9aG_SmcKlLr2wnrCM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWhOBTRfPzrZ-S3ZMUbo7iXoyPkl6WvHSzP2Hgyj8y4A&oe=69B6A97B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG0_YJVoyd4Q7kNvwGd6dot&_nc_oc=Adk5hpMw8u6dur-RG985koZ2HjD-iubMrCdtYHP_AScbnY7oV6dwlaMRG8B4BLoEIx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbnN7bm_l4zuVvKguOS-AelERZw-bcerZyW1JXFSiMGg&oe=69B6C214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO1GC0ZHQcoQ7kNvwE9etC-&_nc_oc=AdmEhw546NwazcK8hQNsAXpjdVTppstMUr686qeHa7ggi2n5_0E8Rk8Hr3KaTr0SbHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxS_OusFBz_JC2bqYSQDUdJuEUugStSfpKnZ7qe7XLOew&oe=69B6AFE3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
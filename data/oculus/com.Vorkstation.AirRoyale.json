50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ05iJV95SgQ7kNvwGftMjt&_nc_oc=Adk61KzJ_3Lg6QT0S5yYjYRpNT3npxdmdmVPWNPzwNKDpxkJUNXfzksjAJjGdk_cLbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxeUyGAO2xS-79z7AzC4JvlUlvUm8TJ0y2RafLbOixSgg&oe=69BBEF7B"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRYc57lZTwoQ7kNvwGo4HGk&_nc_oc=Adl6ki1yAgw8YhPCoiY1Tc6esfExbdjv1SN5MEr4vUK_E7Xz00s9NFaaWT8IYtCJ3PU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3sHxu5Qbr2LgdvjLRZSqj4k9IUAzH-iJohPt0vB1e3Q&oe=69BC0814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCRludcFdIoQ7kNvwHdTEoG&_nc_oc=AdmlSb9l9Zuso0PFR2NynQDXvDwywOlnFGvS2AI1KlmmQUNryr23jhGsVDeuTh5xnSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjumqzjtpVCkHO-b51IO9AGz1pK0DQyfxGEe_Ce3iI5Q&oe=69BBF5E3"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
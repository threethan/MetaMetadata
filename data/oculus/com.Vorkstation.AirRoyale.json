n fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun shooting each other. Engage and have fun in Air Royale!"}]}, "developer_name": "Vorkstation", "developer_privacy_policy_url": "https://sites.google.com/view/airroyaleprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Vorkstation", "support_website_url": null, "website_url": "https://sites.google.com/view/airroyale/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9777160055729497"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982470_795458955776260_933339524501330589_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NffbOJ00bAQ7kNvwFT2w2R&_nc_oc=AdpY68aomWv1sJjXagnT1C4qSrgixMl8XMRr_trEl93-k65PUyfIQr9bCfjIsuG66H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTrQx6H4GGiuw8V8r0zusJnHx4eFT8XOGsl7-80wP1jVA&oe=6B0C
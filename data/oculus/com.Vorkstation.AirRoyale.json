50721303440_8574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQ05iJV95SgQ7kNvwE1Cej9&_nc_oc=Adn7JDrOLflYjPZ4nMA64mDaIcvEciQEACcP5jNMWH9e751gCjKg9THDevHLObcLZLI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1JvZHXOAda5nOv3T8upJrwUOFIWR2y6QT7mEYccccUA&oe=69BD40FB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRYc57lZTwoQ7kNvwFUwZcH&_nc_oc=AdlrhOdVTRdxVXc2sX1aYU-m6QJoaPBQ67IKcaViR1fABtq7QPfaV7e7cAP5MUb3G5Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfznDCYJD-gDMPetfAGwwu8HgHQRBs7SI9uZMSrwOyl02w&oe=69BD5994"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCRludcFdIoQ7kNvwHmNlh4&_nc_oc=Adk1x5Eoqqfvn-IKlXCxpJluHaIRWi6-JACpxzUGXcjC9n23hiu0QDw5Zh1KV_DXfrc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqK3EJlT2hbeJSNxvXyenFpoFEQtBIaAryWNuLliOXkA&oe=69BD4763"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun
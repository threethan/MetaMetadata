574030010314542971_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5oSLyOo3xEQ7kNvwFwPqEj&_nc_oc=AdqUNfd0U4vxG63B-vrTKhdjOdcUkG4YnFhWWBrNB5WbNsMmp6tsncWt08zw9_cOS4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2Xl40ohAbZyOlOaizGMMUg0FZGTPh8QlBpV4o91bCw3g&oe=69F1FCFB"}, {"file_name": "Battle_Custom..._22.01.2025_14-23-01.png", "id": "622858333452979", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393399_622858336786312_1507184144715843708_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqV78nR2DOwQ7kNvwHAcIba&_nc_oc=AdrbV6icwVg-fdfRUow7Y5Iu8Hnlq6SqPWWzVMeJMIc8h3gic-092l2lUNJouUILFzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ym2jnKCJQcE8iiX70F0Hm3p8ZomRJdSWKDndgp0HAIw&oe=69F21594"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-07-15 at 11.38.32\u202fAM.png", "id": "1005971901065831", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75622012_1005971904399164_7972216345017916565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF8MGAH42H0Q7kNvwGipiyC&_nc_oc=Adra8RvSF2XK3y68Jxlo34D2NVM21As_gTivz0-uqRwfSehjpT8_Cx4sOpgMcEMeoPE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af35iWF_h3y1y8XjTBqipz62uiAsGrPcN7GAYE5PIik40Q&oe=69F20363"}, "display_name": "Air Royale", "keywords": ["Royale", "Fight", "Gorilla", "Monkey", "Air"], "long_description": "Air Royale delivers exhilarating aerial combat, redefining the action genre. Players will soar through an open space, engaging in fast-paced fights that demand both skill and strategy. Intuitive controls and dynamic movement create an accessible yet deep gameplay experience, where mastering flight is just as crucial as aiming. A unique upgrading system adds a strategic layer to the action. Download Air Royale now!\n\n{1899114920663165}", "short_description": "Air Royale is an exhilarating multiplayer game designed for virtual reality. Step into a high-flying, action-packed world where players have fun shooting each other. Engag
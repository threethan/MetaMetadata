"keywords": ["fitness", "adventure", "scifi", "rowing", "exercise"], "long_description": "\ud83c\udf08Welcome to Ready Hero Fit, where fitness meets interstellar adventure! \ud83c\udf0cImmerse yourself in a thrilling VR rowing experience like no other, as you embark on an epic sci-fi journey across the galaxy. \ud83d\udcab\ud83d\udcaa Engage your body and mind in an epic quest for the future of humanity! Collect mushroom samples while rowing through vibrant alien landscapes.\ud83c\udf44 As you move, the story unfolds \u2013 what secrets can be found on these mysterious exoplanets and will you be able to save your crew?\ud83d\udca5Keep rowing to find out!\ud83d\udea3\u200d\u2642\ufe0f\u2728 Don't just exercise\u2014embark on a hero's journey with Ready Hero Fit! Download the free beta now and let the fitness fun begin! \ud83d\ude80", "short_description": "\ud83d\udea3\u200d\u2642\ufe0fEmbark on an epic adventure through alien wonderlands! \ud83c\udf44 Collect colorful plants and mushrooms and discover joyful rowing fitness fun!\ud83c\udf08"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.readyherofit.com/privacy-policy", "developer_terms_of_service_url": "https://www.readyherofit.com/terms-of-service", "publisher_name": "Ready Hero Fit LLC", "support_website_url": null, "website_url": "http://www.readyherofit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER
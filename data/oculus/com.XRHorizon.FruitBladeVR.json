ent-iad3-2.oculuscdn.com/v/t64.5771-25/593832569_1118096590929954_7228431589391707834_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LjJs6-CtdsQ7kNvwFOQAB3&_nc_oc=AdqcvYNYEwkAUb45oABrDFuAujoA1qeZFkrCKepnqrJplJLWHB07KOaUC1AxGUiGZ2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtnPyPPzTW1y2-jdi8ViK5ALMROsoR64bsc2EDdEryFQ&oe=6AF1E25E"}, {"file_name": "screenshot 3.png", "id": "2398547807635157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593767690_2398547810968490_152299537736102959_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T83QpoqHO0oQ7kNvwEzQ8TX&_nc_oc=AdqvV4XPk1cewpbkbN7n0vO2I60eDQbLiCNDs0320MFYgSdjluPW7Gk2_juBVH9eeFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdslYuAaPLrHp7wfTzle_j32clYMXoU7YegG8S62D4ZA&oe=6AF1D168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1178130550890775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1178130554224108_1389218084665156049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AQ-J78bSeUQ7kNvwGVbf73&_nc_oc=Adp1Um2mM1VBrHr0-YylYvAoDBFsf7TMHJWD1N9bO-egLM29oHkIWB-baWvNhPMzbog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuhf74WsEleiTFGF6rVVaBZVc57n1Kv_FRFhI_jV6_CA&oe=6AF1E02B"}, "display_name": "Fruit Blade VR", "keywords": ["vrfruitcut", "bladegame", "fruitslash", "fruitblade", "fruit"], "long_description": "Step into a fast-paced virtual reality world where your reflexes and precision are put to the ultimate test. Armed with dual blades in each hand, you must slice through flying fruits as they soar across your field of vision. Each swing feels immersive and satisfying, giving you the true sensation of being a skilled fruit-slicing master.\nBut it\u2019s not just about cutting fruit\u2014danger lurks in the form of bombs hidden among the waves. A single slice on the wrong target could end your run instantly. Timing and accuracy are just as important as speed, pushing you to stay focused and alert.\nTo keep the challenge exciting, fruits spawn dynamically with randomized movement patterns, making no two rounds the same. Some fruits appear whole and must be cut cleanly, while sliced pieces behave differently, only respawning after they hit the ground\u2014keeping gameplay fluid and unpredictable.\nThe game also introduces a bomb mechanic with object pooling to maintain smooth performance in VR. If a bomb hits the ground, it simply resets and re-enters the pool, while slicing it triggers a spectacular game-over sequence with sound and particle effects\n", "short_description": "Step into VR and unleash your inner ninja! Wield dual blades to slice flying fruits with precision and speed while dodging hidden bombs that can end your run instantly. Dynamic fruit spawns, responsive physics, and immersive haptic feedback make every round unique. With intuitive controls, explosive effects, and endless replay value, this fast-paced Fruit Ninja VR game challenges your reflexes and keeps you coming back for more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/Privacy-Policy---Fruit-Blade-VR/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "
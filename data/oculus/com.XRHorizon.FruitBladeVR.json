_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEXgMrFQoeUFZxqUoUBzYDLDhFlXJdjgmtolCL70tWTA&oe=6AF1EDD5"}, {"file_name": "Screenshot 2025-08-20 161155.png", "id": "1818930292040987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820382_1818930295374320_1012633195612793149_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02aCoymCuQcQ7kNvwF2aanH&_nc_oc=AdrdOOojAAB3i9RGGVzHRRVIOVXuWDrNu0ktM0XxZNg-qa_ZCxJk-pHnO2dPpDOtnv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-7BBfTuOKqFOHyGJFR72M_QoBXP_sZTSFzswcJz5Fyg&oe=6AF1DF4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1178130550890775", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820586_1178130554224108_1389218084665156049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AQ-J78bSeUQ7kNvwGVbf73&_nc_oc=Adp1Um2mM1VBrHr0-YylYvAoDBFsf7TMHJWD1N9bO-egLM29oHkIWB-baWvNhPMzbog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuhf74WsEleiTFGF6rVVaBZVc57n1Kv_FRFhI_jV6_CA&oe=6AF1E02B"}, "display_name": "Fruit Blade VR", "keywords": [], "long_description": "Step into a fast-paced virtual reality world where your reflexes and precision are put to the ultimate test. Armed with dual blades in each hand, you must slice through flying fruits as they soar across your field of vision. Each swing feels immersive and satisfying, giving you the true sensation of being a skilled fruit-slicing master.\nBut it\u2019s not just about cutting fruit\u2014danger lurks in the form of bombs hidden among the waves. A single slice on the wrong target could end your run instantly. Timing and accuracy are just as important as speed, pushing you to stay focused and alert.\nTo keep the challenge exciting, fruits spawn dynamically with randomized movement patterns, making no two rounds the same. Some fruits appear whole and must be cut cleanly, while sliced pieces behave differently, only respawning after they hit the ground\u2014keeping gameplay fluid and unpredictable.\nThe game also introduces a bomb mechanic with object pooling to maintain smooth performance in VR. If a bomb hits the ground, it simply resets and re-enters the pool, while slicing it triggers a spectacular game-over sequence with sound and particle effects\n", "short_description": "Step into VR and unleash your inner ninja! Wield dual blades to slice flying fruits with precision and speed while dodging hidden bombs that can end your run instantly. Dynamic fruit spawns, responsive physics, and immersive haptic feedback make every round unique. With intuitive controls, explosive effects, and endless replay value, this fast-paced Fruit Ninja VR game challenges your reflexes and keeps you coming back for more"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/Privacy-Policy---Fruit-Blade-VR/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24813147795006454"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "652400707647823"}]}, "baseline_offer": {"id": "652400707647823"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760415420, "status": "PUBLISHED", "id": "652400707647823"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28903853089269217", "version": "1.4.1"}, "id": "1382091546871000", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24681582738162961", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28903853089269217"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1382091546871000"}]}, "change_log": "Fixed the event reward popup appearing before the event ends. Queued rewards now wait until the configured event end date, and acknowledged rewards won\u2019t appear again.", "created_date": 1793188428, "id": "28903853089269217", "version": "1.4.1", "version_code": 200010, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28903845062603353"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24681582738162961", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28903853089269217"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1382091546871000"}]}, "change_log": "Enter Reaper\u2019s Realm!\nStep into Reaper\u2019s Realm, a dangerous supernatural arena with a legendary atmosphere. This Halloween, sharpen your blades, slice your way through the darkness, and collect pumpkins in a thrilling seasonal challenge!\n\nWhat\u2019s New\nNew Halloween Map \u2013 Reaper\u2019s Realm: Enter a dark, supernatural arena filled with Halloween atmosphere.\nHalloween Special Event: Take on the limited time pumpkin collecting challenge.\nPumpkin Hunting: Slice pumpkins to increase your event score.\nGlobal Leaderboard: Compete with players and fight your way to the top.\nExclusive Sword Reward \u2013 Pumpkin Reaper: \n\nEarn this special Halloween sword by securing a top-three position on the event leaderboard.\n\nCan you conquer Reaper\u2019s Realm and claim the legendary Pumpkin Reaper?\n\nEnter the realm. Slice the pumpkins. Claim your legend!", "created_date": 1792879154, "id": "28856608570660336", "version": "1.4.0", "version_code": 200009, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24681582738162961", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28903853089269217"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1382091546871000"}]}, "change_log": "Fixed various bugs and improved overall stability.\r\nAdded a new game mode.\r\nUpdated and improved the user interface.\r\nImproved gameplay mechanics and overall experience.\r\nImproved performance and responsiveness.", "created_date": 1789560346, "id": "28342669172054281", "version": "1.3", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24681582738162961", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "289038530892
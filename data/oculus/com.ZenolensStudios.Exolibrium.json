olomyte' as they attempt to hunt down and harvest every last remaining crewmember aboard the vessel.\n\nI hope you're not afraid of the dark...", "short_description": "During an explorational expedition deep within the unknown regions of space, your team has crossed paths with something truly... alien. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zenolens.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zenolens Studios", "support_website_url": null, "website_url": "https://www.zenolens.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "421513376331099"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462957_582700263052404_2394308563741803674_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgRHUIuVwtgQ7kNvwFdhVjC&_nc_oc=AdnRIelRI4d_wPvzw6allknqOHhX58fB3h0epoUMcjhLpBrOYAuAifI6XxjD8Rp-vdo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRyqdZcm_cwe8-CKOV1gp5abpzN7V0O6HQyd2G0ixZ6A&oe=69B80DF4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Exolibrium", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459
 not afraid of the dark...", "short_description": "During an explorational expedition deep within the unknown regions of space, your team has crossed paths with something truly... alien. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.zenolens.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Zenolens Studios", "support_website_url": null, "website_url": "https://www.zenolens.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "421513376331099"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462957_582700263052404_2394308563741803674_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr2XVh7C6ioQ7kNvwGnxiYn&_nc_oc=AdliQH_MOALrgR-9dCE5V1vMQDclHRBV5qQnq8JiIeeLh7PDuKGtGw579bstylXqFI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftHAX-7oDRskmoAPbuiuJBk6Ca5iBFDff1isrFtYBfDUg&oe=69A6EA74"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Exolibrium", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1653493264, "lastRevision": {"nodes": [{
_name": "Untitled design (14).png", "id": "1098502491734001", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974920_1098502495067334_4276716540657119520_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_VHK-CijPMQ7kNvwH1DqPu&_nc_oc=AdonSypcZj_tsOzzngGzTjhyppt9TLSRvAeKoCSyi_OIcKBN2UQihMzXc5t-w_M0HIA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x34mnrfLIdSv14D8_8CXEiXosZy7q_unOfyr5I3YBJA&oe=6A410F27"}, {"file_name": "Untitled design (15).png", "id": "1247843636433087", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974625_1247843646433086_8535649062198233962_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiOv8vfOeRQQ7kNvwHwTY5y&_nc_oc=AdoRVBXOhNid5w7ci3N6EGsL2oSMvpoIBPDHStXqnSA7op9FfEiEHeqGR5GdKu90fcE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UtyAy9JZRdsKSuXSQgo83yZY1sDg_dxucLn608bWsWQ&oe=6A414037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orangutan: Reborn", "keywords": [], "long_description": "Orangutan Runners is making an exciting comeback with a fresh revival that not only honors its predecessor but elevates the experience to an entirely new level. This updated version promises to surpass the original in every way, offering enhanced gameplay, improved graphics, and a host of innovative features designed to keep players engaged. Whether you\u2019re a longtime fan of the classic or a newcomer ready to dive in, the game is set to deliver more fun, more challenges, and more excitement than ever before. With new modes, characters, and customization options on the horizon, Orangutan Runners is poised to become a must-play for both nostalgic gamers and those seeking a thrilling new adventure. Get ready to swing, run, and leap into a vibrant world where the fun never stops!", "short_description": "A revival of an old game known as, Orangutan Runners. This game will one up its predecessor and allow you to have much more fun than you could in the old version, with lots of features to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oranguprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "AC3GT", "support_website_url": null, "website_url": "https://youtube.com/@AC3GT", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8729621203790945"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "581388527711992"}]}, "baseline_offer": {"id": "581388527711992"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732820160, "status": "PUBLISHED", "id": "581388527711992"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8740920912660974", "version": "1.2"}, "id": "1122947169186414", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8723440617742337", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8740920912660974"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1122947169186414"}]}, "change_log": null, "created_date": 1732937163, "id": "8740920912660974", "ver
 with lots of features to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://oranguprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "AC3GT", "support_website_url": null, "website_url": "https://youtube.com/@AC3GT", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1990104051447093"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8729621203790945"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "581388527711992"}]}, "baseline_offer": {"id": "581388527711992"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732820160, "status": "PUBLISHED", "id": "581388527711992"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8740920912660974", "version": "1.2"}, "id": "1122947169186414", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8723440617742337", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8740920912660974"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1122947169186414"}]}, "change_log": null, "created_date": 1732937163, "id": "8740920912660974", "ver
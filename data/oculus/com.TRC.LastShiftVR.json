_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDkFtdMYHuUQ7kNvwErrl3T&_nc_oc=Adr9wVDNUYMbYHg4KDPN2nq0nlfef1axBN1hlWOfj5Q6f5aU63E9LN8M2UYvsjm4gRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZoGZ7tou_6g7_CaCISonH4SAiQiOrFzonsVrYecZLjw&oe=6AFC6141"}, {"file_name": "5-Reloading.png", "id": "583399033964262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348038_583399037297595_8333691937922642386_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9MbYFTBYmEQ7kNvwHFtPea&_nc_oc=AdoT5V6irb4WSt6KmmNXxWcJS0SkjpwCLmGEtfD-9wq4DyNTLG1NTHpF8iqBF8MUuD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR--R3c5pJW4AuhPLiZhLRzFHPdT7cfVkHu8Otg5P7_ow&oe=6AFC66AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FOTLG_KeyArt2_Meta_CoverLandscape_2560x1440.png", "id": "871585267772171", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982639_871585271105504_1768892495394953023_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz_eeBYndCQQ7kNvwGXxLrW&_nc_oc=AdrkrOM7WquuHp1QDLU0xKkoUyb75sybUct8xKuZ5Y2Ml6qOgJBrPfZJxrga1yomF3c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9f6bg4RW23KFDxSxPWGp_dyxxrhskKiw8RydI2N06Lw&oe=6AFC83D7"}, "display_name": "Flock of the Low God", "keywords": [], "long_description": "A festering evil has taken root at the Lanford Police Department\u2026\n\nIt\u2019s been one year since your father died in the line of duty, a sudden and unexplainable death following his arrest of the notoriously vicious cult \u201cThe Flock of the Low God\u201d. In his final days, it seemed an evil had consumed him and driven him mad, a mysterious affliction that has haunted you ever since and driven you to adopt the badge yourself.\n\nIn this thrilling survival horror experience based on the feature film MALUM, step into the shoes of Officer Loren, a rookie cop on her first shift that threatens to become her last. Explore the decommissioned police station, uncover the evidence, and piece together the disturbing history behind your father's death, the notorious cult and its dangerously enigmatic leader: John Malum.\n\nBut be careful\u2026 because John Malum never forgets, and he and his demented followers have their sights set on you.\nCan you stop the Flock before they overrun the police station? Or will you become the final piece in their bloody and twisted ritual?", "short_description": "Enter the world of Malum as you fight to protect the Lanford Police station from the vicious Flock of the Low God. \n\nOver the course of one night, discover the cult\u2019s origin and how your family might be connected to its horrifying plot. \n\nA striking survival horror VR experience, \"Flock of the low God\" puts the player in the middle of an original, narrative single player experience. \n\nGather clues, defend the station and defeat John Malum\u2019s terrifying cult!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flockvr.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Right Corner ", "support_website_url": null, "website_url": "https://www.toprightcorner.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7129667713754973"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PE
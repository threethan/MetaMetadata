nt-dfw5-2.oculuscdn.com/v/t64.5771-25/75348038_583399037297595_8333691937922642386_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBa93beHs1MQ7kNvwGeEwH3&_nc_oc=AdnN1ClUtK5dCmFA2vHQ2OGqh1CIfDdQoYy51y1PRad-WE2oknTeMoJZD7DJCqzX4F8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwi0QuIMVJshXKBAX2wR7JJSXCBy5qTIDYsf74L1nBq5Q&oe=69BD5BAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FOTLG_KeyArt2_Meta_CoverLandscape_2560x1440.png", "id": "871585267772171", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982639_871585271105504_1768892495394953023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2egeV6i6duYQ7kNvwEVk8vd&_nc_oc=AdkCz9O0Anft4RR4qLBmWtnQFg3GPsuv6mxYpoRSef5yMCPm_l27JeNR-4GLPmcoek8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4kxiNU_n9QDE0fDRpr-Vdjg8FMCy0URZPFxI1wuNWZg&oe=69BD4097"}, "display_name": "Flock of the Low God", "keywords": [], "long_description": "A festering evil has taken root at the Lanford Police Department\u2026\n\nIt\u2019s been one year since your father died in the line of duty, a sudden and unexplainable death following his arrest of the notoriously vicious cult \u201cThe Flock of the Low God\u201d. In his final days, it seemed an evil had consumed him and driven him mad, a mysterious affliction that has haunted you ever since and driven you to adopt the badge yourself.\n\nIn this thrilling survival horror experience based on the feature film MALUM, step into the shoes of Officer Loren, a rookie cop on her first shift that threatens to become her last. Explore the decommissioned police station, uncover the evidence, and piece together the disturbing history behind your father's death, the notorious cult and its dangerously enigmatic leader: John Malum.\n\nBut be careful\u2026 because John Malum never forgets, and he and his demented followers have their sights set on you.\nCan you stop the Flock before they overrun the police station? Or will you become the final piece in their bloody and twisted ritual?", "short_description": "Enter the world of Malum as you fight to protect the Lanford Police station from the vicious Flock of the Low God. \n\nOver the course of one night, discover the cult\u2019s origin and how your family might be connected to its horrifying plot. \n\nA striking survival horror VR experience, \"Flock of the low God\" puts the player in the middle of an original, narrative single player experience. \n\nGather clues, defend the station and defeat John Malum\u2019s terrifying cult!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://flockvr.squarespace.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Right Corner ", "support_website_url": null, "website_url": "https://www.toprightcorner.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7129667713754973"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PENDING", "id": "1433712518394137"}, {"status": "PUBLISHED", "id": "1745211086174844"}, {"status": "PUBLISHED", "id": "1501613874227856"}, {"status": "PUBLISHED", "id": "716355787553431"}, {"status": "PUBLISHED", "id": "977610461226504"}, {"status": "PUBLISHED", "id": "501506599552899"}, {"status": "PUBLISHED", "id": "846944773752341"}, {"status": "PUBLISHED", "id": "3582524791988078"}]}, "baseline_offer": {"id": "8469
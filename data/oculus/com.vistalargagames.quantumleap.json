060860767434_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szq1SXQS7dwQ7kNvwENCq3D&_nc_oc=Adr7bbzgqaRorLWwnzSxxLeQpZDbkO9fBSwTpdBC2TgKSZm34GRXFbNY98AxgyG_Ba4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfbwGcNKGCMQz6bmmVLKEAS11odHrmImELTYlQpd2L9w&oe=6B0C5A88"}, {"file_name": "quantum_leap_20.png", "id": "3540508302825718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312422_3540508306159051_2137774190002178334_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co7zXTpYfzAQ7kNvwFUYGFL&_nc_oc=AdrJxXu7duaoKTi8-HU4EMBxva0fv0TyIYKwUGBkcwZ891kMF3sO3nI-e8qwChfwgDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_-S1s5FhmsknbeVLpiXrzMt2fROrmahG6DXnBqlfOBg&oe=6B0C7744"}, {"file_name": "quantum_leap_5.png", "id": "1138577655468807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293803_1138577658802140_4159634861928602253_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eN8BqMn_F18Q7kNvwGTJ_ZY&_nc_oc=AdqgDE2FkFmjFc-FDy89ylWZ1g30ThXXOOenwIN5ujIfK4iGEEGonhevxShDJ3uY6-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzEbOG3AjWXCCd3u9vrUo8AMu8MFTMt1PWX4WhOVC1vQ&oe=6B0C5444"}, {"file_name": "action_tongue_grapple_towers.png", "id": "1703020594887995", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313069_1703020601554661_3679540881497464662_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7hkvnWxuoIQ7kNvwHoxPWi&_nc_oc=AdorfEdBu0woUAioqD523gPHZ67vXyimKkhKjeuSS8t3xCdZeLRsi6Y3iMtByXooCtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwe5R9D21mtT8b1h1nJsbzbDoPR2TZ6ZcAdfQs7dUCrg&oe=6B0C78DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1469782218444348", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499296069_1469782221777681_344916436353304263_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmGSTK6dGJQQ7kNvwGvOuuB&_nc_oc=AdpxeUVMDtLlR7HWUoJCLiZTKUOCQ0Ih8xqo7WOMRl2d2hAXl6d9sBU-h48YQQSs5Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlJd40_pFYELMdPAc7dAs63Auq9UVvUvebsvfuSfMCwA&oe=6B0C5DE3"}, "display_name": "Quantum Leap", "keywords": ["platforming", "action", "shoot", "retro", "fps"], "long_description": "Strap on a quantum headband and LEAP!\n\nQuantum Leap is a first-person 3D platformer built for VR. You are RIBYT, a frog with a glowing quantum headband and a gigantic jump. The Celestial Arbiter's tech is corrupting nature across ten worlds, and only you can hop, soar and swing your way to the top.\n\nJUMP, DOUBLE JUMP, AND LOOK DOWN\nLaunch into the sky and look straight down at the world rolling beneath you. Every jump is an arc through the air, and every landing is a moment of triumph.\n\nTONGUE GRAPPLE\nShoot your tongue to swing from floating anchors, cling to walls and cross gaps. Lock-on assist grabs the anchor you are looking at.\n\nLASER EYES\nZap robot wildlife, security drones and turrets with twin laser beams. Collect power-ups and use them at the right moment.\n\n10 WORLDS, 40 STAGES, 10 BOSSES\nFrom the Neon Marsh to the Zenith frontier! Each world brings its own mechanics: tides, wind, lava, ice, gondolas, monorails, zero gravity and more. Each world ends with a boss fight, including a giant robot crab, a forge colossus and the Celestial Arbiter himself.\n\nA SOUNDTRACK FOR EVERY STAGE\nEvery stage has its own original track, from liquid drum and bass to lo-fi hip-hop, techno, dub, synthwave and chillstep, with a heavy track for each boss.\n\nRETRO LOOK, MODERN COMFORT\nA chunky 90s polygon look with a sharp VR experience. Snap or smooth turning, a comfort vignette, hint voice lines from a friendly robot guide.", "short_description": "Hop, soar and swing as a laser-eyed frog through 10 worlds in a retro first-person VR platformer. Stop the Celestial Arbiter!\n"}]}, "dev
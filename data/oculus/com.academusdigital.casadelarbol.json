tent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS52rkQI4ddw5H4sQiLRQ9HDOT6RTUnxyYoU_41nmHMAA&oe=6AFDD041"}, {"file_name": "captura-contenido-3.png", "id": "1459655009458754", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298930_1459655012792087_8082841925685706989_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwubhL4uJDgQ7kNvwEax0kG&_nc_oc=AdrrstJbf6QuqgBpJRaTSWOm3T5FHIBQ42XaKkVdoqJGr5qG8-fnj0eSUt5FrvA8Bac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4B4SnpkJ_nCc15IEzo_ZNzn2SeClCFAk_SAHNLWtPUA&oe=6AFDD82D"}, {"file_name": "captura-contenido-2.png", "id": "1114982697842883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308026_1114982701176216_3642501472810750148_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyMfaV9Xn1MQ7kNvwGeR3-n&_nc_oc=AdpYUvYFZzYbpIPJ4ek49jjOCKTbfnal_feymmlK7GZqKS3AVPBpp769RaDj9qx28hU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDapditCi4T-CoKSkBRMW8Vf4FvbxO40TqXkfFiZpZ8g&oe=6AFDDCF6"}, {"file_name": "captura-contenido-1.png", "id": "1127496903467964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299051_1127496906801297_7109941014887608773_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlToR74bjbsQ7kNvwFByojQ&_nc_oc=AdrLg42sy2KUvhJ0trN2f-ZcgtAZwriQBUfuQLjM9XWumZ5O2B8bTMtNvsz4vOWeiGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS09jaK3nad-KYnqrlpwajAxv90Htdm_kzaMfdiN4Ja3g&oe=6AFDBEB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La Casa del \u00c1rbol de las Familias", "keywords": [], "long_description": "Welcome to La Casa del \u00c1rbol de las Familias, an educational VR experience from Academus Digital.\n\nVisit three rooms about family diversity, teamwork, and family history and affection. Discover different families, help with everyday tasks, and explore memories through nine illustrated activities. Complete each room to earn a heart and reach the final celebration.\n\nFive videos and 44 spoken prompts in Mexican Spanish accompany the journey. Large buttons, simple words and picture-based guidance help children follow the activities. Keep your headset pointed at an option for 1.8 seconds to select it, or point with a Touch controller and press the trigger. This uses headset direction, not eye tracking.\n\nPause, replay and move backward or forward through videos with an accessible timeline. Play seated or standing, with no artificial locomotion. Progress is saved on the device.\n\nAll videos, voices and 3D rooms are included for offline play after installation. Single-player. No in-app account, chat, advertising, subscriptions or in-app purchases.\n\nAudio and gameplay text: Spanish (Mexico). Designed for Meta Quest 3 and Quest 3S.", "short_description": "Explore a welcoming treehouse and discover the many ways families care for one another. Enjoy three rooms, nine simple activities and five videos, with large buttons and spoken guidance in Mexican Spanish. Select by looking with your headset or using a Touch controller."}, {"images": {"nodes": []}, "id": "2591689384664020", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "La Casa del \u00c1rbol de las Familias", "keywords": [], "long_description": "\u00a1Bienvenido a La Casa del \u00c1rbol de las Familias! Una experiencia educativa en realidad virtual de Academus Digital.\n\nVisita tres salas dedicadas a la diversidad familiar, el trabajo en equipo y la historia y el afecto. Descubre distintas familias, ayuda con tareas cotidianas y explora recuerdos en nueve actividades ilustradas. Completa cada sala, re\u00fane tres corazones y llega a la celebraci\u00f3n final.\n\nCinco videos y 44 indicaciones de voz en espa\u00f1ol mexicano acompa\u00f1an el recorrido. Los botones grandes, las palabras sencillas y las gu\u00edas con im\u00e1genes ayudan a seguir cada actividad. Mant\u00e9n el visor apuntando a una opci\u00f3n durante 1.8 segundos para elegirla, o usa un control Touch y el gatillo. La selecci\u00f3n utiliza la direcci\u00f3n del visor; no requiere seguimiento ocular.\n\nPausa, repite y adelanta o retrocede los videos con una barra accesible. Juega sentado o de pie, sin desplazamiento artificial. El avance se guarda en el dispositivo.\n\nLos videos, voces y entornos est\u00e1n incluidos para jugar sin internet despu\u00e9s de la instalaci\u00f3n. Para un jugador. Sin cuenta dentro del juego, chat, anuncios, suscripciones ni compras integradas.\n\nAudio y textos en espa\u00f1ol de M\u00e9xico. Para Meta Quest 3 y Quest 3S.", "short_description": "Entra a una acogedora casa del \u00e1rbol y descubre c\u00f3mo las familias se cuidan y colaboran. Recorre tres salas, completa nueve actividades y disfruta cinco videos, con botones grandes y ayuda hablada en espa\u00f1ol mexicano. Elige mirando con el visor o usando un control Touch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.academusdigital.com/politica-de-privacidad-apps/", "developer_terms_of_service_url": null, "publisher_name": "Academus Digital", "support_website_url": null, "website_url": "https://www.academusdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1432166589990185"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
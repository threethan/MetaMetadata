.oculuscdn.com/v/t64.5771-25/499305027_1291660722671345_7055468752153329397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ5BnDLTptcQ7kNvwHCpuVi&_nc_oc=AdodXlmhQrlHu4DN9JBgOKhrP8hFYmKBuFGvPhCgaQk-0BwE4KOt-ftFhEjqzPRkWg0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgoBt_8-Kbhuh-8zJjQ21Ok726X1OBdUy24sJYVKhCxg&oe=6AE346D8"}, {"file_name": "Screenshot5 2560x1440px.png", "id": "1483057196482558", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819934_1483057199815891_2554902807419927202_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5t8oL09XUEQ7kNvwE5Loey&_nc_oc=Adq6cpCZeQoVHxWgz_yNXyr2qdaMI9lVKUqqkKfRks9IexoPlKa_Mj-GIy5RgG873WI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkZ2TivRupgQ9eaNBLa91vClnTAbCreGTXpfQudYWgpw&oe=6AE35AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440px.png", "id": "1194455816049689", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823485_1194455819383022_4158282219597927963_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q86OBoSdWMoQ7kNvwHAISJl&_nc_oc=AdohFf-qJ6UdU-PqMJd-nTU5OxeO3fgOpw7AcWD8nWcIvYamXyhr8IbWRIjpMOpvLOg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8EAhYJNW_ifOF5Zy2IBxmSVI1TYzYM0U7NVXBU7uNbw&oe=6AE340D7"}, "display_name": "CAS (Early Access)", "keywords": ["mindfulness", "handtracking", "calming", "reflection", "behavioralhealth"], "long_description": "# \ud83c\udf3f CAS: Conversational Behavioral Health in VR \ud83c\udf3f\n\n**CAS** is a behavioral health support application offering **conversational sessions** for reflection and stress reduction. Built by **mental health professionals working with world-renowned US hospitals**, CAS provides **structured conversations in immersive VR environments** that promote wellbeing.  \n&#8203;\n# \u270b Engage with CAS\nEngage with an **AI assistant trained by clinical specialists** through **hand-tracking interactions**. Choose from **calming environments and avatars**, practice **guided breathing**, and **track progress** through tailored session summaries. Multi-profile support enables **secure data separation** for individuals sharing one headset.  \n&#8203;\n\nUnlike consumer wellness apps, **CAS is a clinic-focused technology** developed with **rigorous scientific methodology**, incorporating **evidence-based techniques** within meticulously crafted environments.  \n&#8203;\n# \ud83c\udf1f Features\n- \ud83d\udcac Engage in immersive reflection about your life and health  \n- \ud83c\udf04 Choose multiple stunning environments and responsive avatars  \n- \ud83e\uddd8 Practice guided breathing for stress reduction  \n- \ud83d\udcca Track progress with HIPAA-compliant summaries  \n- \ud83d\udc65 Support multiple household profiles with data separation  \n&#8203;\n# \ud83d\ude80 Early Access\nFully functional sessions available now, with features expanding based on user feedback.  \n\nFree to use. Optimized for Quest 3/3S. Begin your wellness journey today!\n", "short_description": "Experience immersive conversations for behavioral health support in stunning VR environments. Built by mental health professionals from world-renowned institutions, CAS offers a calm space for breathwork, mindful relaxation and meaningful self-reflection through an interactive dialog with intelligent avatars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.augmend.health/privacy", "developer_terms_of_service_url": null, "publisher_name": "AugMend Health", "support_website_url": null, "website_url": "https://www.augmend.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT"
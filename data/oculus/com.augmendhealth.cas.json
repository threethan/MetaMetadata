w&oe=6B05C346"}, {"file_name": "Screenshot3 2560x1440px.png", "id": "1620918825542973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820382_1620918828876306_5972545285111594701_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s30lq0unFgQ7kNvwFDudBr&_nc_oc=AdrrN9fOWNnEMeL9qlnUEktK7Z7CJKJv6P8f-7sUqAghbCUmrUjoV1EW2C8rIux_TJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJnnr__VSpA5l6QADX2pwMMGzAOqipGiKPp2wQwoyEyA&oe=6B05B4F6"}, {"file_name": "Screenshot4 2560x1440px.png", "id": "1291660716004679", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305027_1291660722671345_7055468752153329397_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpMNbyI8bDoQ7kNvwHIYkRO&_nc_oc=AdrGJx9mmOyt7rQTuPJzhI7izbyOAda_VOlj7HUNSQFx64VjqN5k3rkCMYpGLm_gRAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0LI6rhsPNAN7tkYNb-KrPssjXMnHRCDU4kNILoYSddg&oe=6B05C618"}, {"file_name": "Screenshot5 2560x1440px.png", "id": "1483057196482558", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819934_1483057199815891_2554902807419927202_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxmnnCrJ9c8Q7kNvwGHW8St&_nc_oc=AdqHrgTOAXtpzYSfzMC_Fio2kBmddl6Y2CBRWiz7T-VwUBNOMq7Qh4-nkGRfk_a5ckI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1UAErqJl6A0Auf6Yffzw40rlShBZHpqi7Ssyg3Kj8qQ&oe=6B05A1F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440px.png", "id": "1194455816049689", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823485_1194455819383022_4158282219597927963_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhQwP8c14NgQ7kNvwHIeQQu&_nc_oc=AdpEJINmRij5MKZDmSBgaHTa6_9-6U7Sf9fw5DBUmooCQeru0FEd-DpcMBrnJgV-GpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Ot6N5fWvjnw2GqOkDBjsKpkt4_PY6ZNaYmxEHbWReA&oe=6B05C017"}, "display_name": "CAS (Early Access)", "keywords": ["mindfulness", "handtracking", "calming", "reflection", "behavioralhealth"], "long_description": "# \ud83c\udf3f CAS: Conversational Behavioral Health in VR \ud83c\udf3f\n\n**CAS** is a behavioral health support application offering **conversational sessions** for reflection and stress reduction. Built by **mental health professionals working with world-renowned US hospitals**, CAS provides **structured conversations in immersive VR environments** that promote wellbeing.  \n\n---\n\n## \u270b Engage with CAS\nEngage with an **AI assistant trained by clinical specialists** through **hand-tracking interactions**. Choose from **calming environments and avatars**, practice **guided breathing**, and **track progress** through tailored session summaries. Multi-profile support enables **secure data separation** for individuals sharing one headset.  \n\nUnlike consumer wellness apps, **CAS is a clinic-focused technology** developed with **rigorous scientific methodology**, incorporating **evidence-based techniques** within meticulously crafted environments.  \n\n## \ud83c\udf1f Features\n- \ud83d\udcac Engage in immersive reflection about your life and health  \n- \ud83c\udf04 Choose multiple stunning environments and responsive avatars  \n- \ud83e\uddd8 Practice guided breathing for stress reduction  \n- \ud83d\udcca Track progress with HIPAA-compliant summaries  \n- \ud83d\udc65 Support multiple household profiles with data separation  \n- \ud83d\ude0c Experience low-intensity, comfortable sessions  \n\n## \ud83d\ude80 Early Access\nFully functional sessions available now, with features expanding based on user feedback.  \n\nFree to use. Optimized for Quest 3/3S. Begin your wellness journey today!", "short_description": "Experience immersive conversations for behavioral health support in stunning VR environments. Built by mental health professionals from world-renowned institutions, CAS offers a calm space for breathwork, mindful relaxation and meaningful self-reflection through an interactive dialog with intelligent avatars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.augmend.health/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "AugMend Health", "support_website_url": null, "website_url": "https://www.augmend.health/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25402621332663007"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4003719436570892"}]}, "baseline_offer": {"id": "4003719436570892"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755787680, "status": "PUBLISHED", "id": "4003719436570892"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29122812617310508", "version": "1.0"}, "id": "24222432690753743", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25402621329329674", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122812617310508"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "24222432690753743"}]}, "change_log": null, "created_date": 1793720529,
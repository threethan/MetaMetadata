25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p6ezeZU8i8Q7kNvwEAaIMq&_nc_oc=AdqS1ioXqoAo_puw72LwJ5fgRZdFvIO-zsHuVScCPn6PwDg_cxhM8h1VAAjrrCPMRXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0hvNsK71jDNO-sbZSi-CldQoOfFMMbrgg1blU4RkE_g&oe=6AA2C0EA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3StMBntEMCgQ7kNvwFW-TXu&_nc_oc=AdqFbfGAxVMSgUn54xRfejAtDWQp90Sz4x74erMVdTQL5MNryUNP06dFU2DpX4OxoQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2kwy5ez8-8BS0PvC14Vsqkf8hfayVLJF0AUn8c4CPSw&oe=6AA2CCD3"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o4KDsGzxvcQ7kNvwF8lrTm&_nc_oc=AdrDyLJbDJugsAf3hlRdJ5zHWs2mEj72lsIHXDxg1VLt_p0lPqgIMrw6ZkHEE1uOqp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw5cFwv3K0tI0aI9X2N4nKyahooZprnQR_2VzY06JB5Q&oe=6AA2B6E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0bvug8k10Q7kNvwGIgHxf&_nc_oc=AdoAHlxoiD4Mgt-StREu5MI6cqLfPzw6N04aW72YaWXazoq9bSx_Qs5U2DSW5ZudelQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt5xwvlkQAII_0x9_McSQY5HMRUQg4645REdi_8IaPmA&oe=6AA2B4C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5kR2ztM4nIQ7kNvwGqm3kL&_nc_oc=Adp6ZTy5eoOi8nNNJ-yknZuVeYy_Geb2KWZttQ8nZQxVdN2WTmLTXrIKsInrhpoU7FA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzprYZwxKFxWfeaYFf1CZds2bfZQIfk3wt0zaf1R8YqA&oe=6AA29FFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
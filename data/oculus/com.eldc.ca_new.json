WXrsvNawjVtSEFlfg&oe=6B0DB8A7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG-zhv-PNV4Q7kNvwGr6FLF&_nc_oc=AdqbOMLm0r59QvSAWWAlsqc-lRQghcvfb7OLHaz_UOEd-h4tLr4anbfaXaO-hbC9iwA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR60xtUaD79LCylIeN5ahOpcBKOquYE_U-vnuWOCpJKqQ&oe=6B0DB684"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rezN3E4bltgQ7kNvwFxKkDB&_nc_oc=Adq4-UkDYZnpyTVHk-T8xGDWf6rb17Y3FnNMuKLyeCaKD6-u6HFvOACDCqEHPtO2cU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnJPx3xLPSy1S3MBJ6IoW6tA5Kt3hNcSti7455_f_JjA&oe=6B0DA1BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "793600160509924"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "27592736783720315"}]}, "baseline_offer": {"id": "27592736783720315"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785152760, "status": "PUBLISHED", "id": "27592736783720315"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "793634223839851", "version": "1.1"}, "id": "2241052953391282", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary"
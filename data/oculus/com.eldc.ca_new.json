771-25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPxe-egjybMQ7kNvwH7ThR4&_nc_oc=Ado0lwdvdWPTILSN0Bej9VFKXBLXmqu15yzKmF5NazzXLUfM72EldT9s-91s_TeFH_A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoZBYZTv0fIEprChkMlJwF89Yb42KCI-bQK9j31eX-FA&oe=6AA4126A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5ONU2awCNwQ7kNvwHNuJK8&_nc_oc=AdqA5FjeXyb5tUXr6kui9_2KuJeSbVdZiJMsdGO32czFdlvMpXycCFuLglHl--7BWNg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTFb6h0RSR2ZfeKPKEa8wTWLI7hBYWfELSCgpgMNGouQ&oe=6AA41E53"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o4KDsGzxvcQ7kNvwHJXv7S&_nc_oc=AdrSFLECpHqjy03QdR7volJU_T4xzZsK0evYLH1Nje4Q3VXnx0orkW_1f4kShDu_PsE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpVeT-PvXvgJAC9WXfEON3CLTCuD6sJuJ9mUQVUMAtgw&oe=6AA40867"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0bvug8k10Q7kNvwHyg4Rb&_nc_oc=AdrymivCJFBZBKk1gbG1DutkJReUxWlf5tfTWTz3gRr8lbadnoa4f4WWYSR5SyEU2HE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCt1zyw9LZ0J0EIlyiQtb-vs5a4weG2QhLA2RLoHoxow&oe=6AA40644"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5kR2ztM4nIQ7kNvwHjJzMr&_nc_oc=Adq-jjYWrPhkAXy7T9EOGQVRHjRshA-MWqcy5e0VIOn024FAXKZV8ywzZrrhp97JeJU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6-R0PwlfiRCUm6Uy0usqpZZklg9GvE0brXOSXRcP1nw&oe=6AA3F17B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_c
25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDyZeH7tw1EQ7kNvwE7odGT&_nc_oc=Adoh4H5XxRQ3lKL7xTBlOUakBEhiumuycCKhtqxqwNDiWfjmwDDMWi07J2suq_n9qSo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG02lQcoOjdOkQXJY-ftwf1YhsJDRvoGZkWfOsHpH-qzw&oe=6A86D92A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqIc2t01CmQQ7kNvwE4LUCu&_nc_oc=AdoDb55LtYvtnRGlEA_PBxxk3tm4IO3bw7js1iCcMJRYviXrC3GpYJlA5VUgYR9K6e8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKy1xU9kN535XV9zyGUbwE_39S8QhWjh3jRrvrAmy_pg&oe=6A86E513"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6fNC5yqMM4Q7kNvwE2T8-t&_nc_oc=AdqeSwJKXmH06SvcQbZavUX3xPwwmLCY7AJlkoFlJZXC-uT3ZueuaL1s3SnntZNKNh0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf-LMaXagA-0TC61uX7bm10AtADV-aJmj_l26CLPoejA&oe=6A86CF27"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAtzRldpNUQQ7kNvwE5wue-&_nc_oc=Adq7f_OrGtLBpXoI-GP9y1oan88U1_AQe-7TyIJ5M6ruzdabMlcxOSJykBBtmzo7zeM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpkvlBFyiCAslxl2R-6QM8BpyIPN5GvBqKdKmCZ5jCww&oe=6A86CD04"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65f5rYvjMY4Q7kNvwEPXWgd&_nc_oc=AdpdSVu1itpA9_MHzRQVAxazmzOHyRG9hrkT3XwMveJhL2HpA9CJ64Joo0IX8OLj03s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqaQ2Gw1ZMUnSbzP_qC7k63jGO5pFPB7sR_Da7wbN8fQ&oe=6A86F07B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
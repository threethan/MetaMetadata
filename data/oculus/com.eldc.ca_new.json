25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N59dsNPoxUQ7kNvwFiCTtX&_nc_oc=AdpdEIkblzIq32Ew_5d02ufzRkh6cOqrLTt_bp2NXgv9FUqRE2ymsnn82KbnvCm0A_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxKQ_rMAexgwrbhmQY-ECyFT8qiIP4179sZRPmx_fOSQ&oe=6ACF93EA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LopAxULHWssQ7kNvwFHqhwm&_nc_oc=AdpBmBIyaUeQ89NMU5K9L2-bjEa9336orRk1jLzoqe1VTh6NGbi0N9lU_g7QZgWxmvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNp32QAcDwGFIYI1AvZIssmP4tmjwtKlcq0hoxbX17-w&oe=6ACF9FD3"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l65u1KiMs5AQ7kNvwEC2Ioo&_nc_oc=Adpy_3ucO0LYN1bL1mjdgLR4mj-PvkAXu5D8my371es3R2HaT0zClndMmYDnAe49INE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8Ntox6J6LLiEceqDfSyg3kX6-Rk0Kj1k6gWyaP10PBw&oe=6ACF89E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGXMDN9uKbsQ7kNvwGB5TQ6&_nc_oc=AdoHFVEJZafweJfeoQyFupU0eohE63C_rUBNcHoJiMv1q9tOM_Zv1lg4zMMvCEa3AUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQVLYWnyzBp5MkvrDgCWe3IK1kkZDwxpQt7Xk-Fu8YUQ&oe=6ACF87C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfrKYOSpUFEQ7kNvwGRAzpr&_nc_oc=AdruW_XU3SBgMmY0osXTIL0_C6BKCa-qb_g7shgpT7KgRKaNLjhuXt7mlN9dj_jX0RM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Jb94AtoaitBb49AhPOy2b8TPUn1Y2VtyacmhktM0uA&oe=6ACFAB3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
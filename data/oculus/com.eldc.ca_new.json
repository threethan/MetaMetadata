v/t64.5771-25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6u9QSA5QfwQ7kNvwGYBiNB&_nc_oc=AdpY1LhM5ukuREhfMs7SqW0OSyDWhfGRBGsg2sK4A8Waz61Yh2fR0ZaSkCqtn9rJZQo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsfvaFzzekT0gcMyCsmO33ymgmCsu_r8KztPXlsGxejA&oe=6A8EC22A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaTmooPi6TkQ7kNvwH_-2k9&_nc_oc=Adpwv7cBqcyVU0j0P6I7LqibR5M92t2tLDRGzaVbvwNPKeEuTKq-rQaegeafQm4AsDc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsUa_5-CIcR6Fo4taWbCa-W3qwKhzvEqsWObikm_hkNQ&oe=6A8ECE13"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpBlnqgqtVYQ7kNvwGP15lp&_nc_oc=AdpwCwdSHhwezdYobvwB52mXZkj31a_8R0351a9WUipwi4lz967E99IvTR_f6rrdUIw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6C8X99RWXG4mo0fg2AajwmUsq3dsNdVWsb8e1gpuzTg&oe=6A8EF067"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJqGth_3j4MQ7kNvwHX4R8y&_nc_oc=AdpTyqEmeGL6iHUDR-dHpuJQWIU9W1hr2XsJ_bDwWNIvZobWAYorMXSq-4R1HoK-AVk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEezVP-OPs8w0hk7MjP-Ocp7Ndr3Yw4uoRpbCPo0J2GYw&oe=6A8EEE44"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9wlFBf0ElQQ7kNvwFJdVP7&_nc_oc=AdrvSIoMAy8-xHoZOqYRXRorOsENa94q8Iz-czNOI0dZVcQGVxnKrgRbpYEGk9Z4WII&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETlXnXBOzeNdgEN3Elo0Lqb2Ramqgkjz6CUGUjI7LAwQ&oe=6A8ED97B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "c
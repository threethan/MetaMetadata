25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPxe-egjybMQ7kNvwECis8j&_nc_oc=AdrWNSWfmbCI35AzKTWdwwdLW08XmR_zt3NcXAKwVZVlL24K-HNMdt1Geg4ozs_kBTA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2SoUjpWU9QsmmL5-VjT4XyFM8OMESf-ylXEdOhtPmwg&oe=6AA6B56A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5ONU2awCNwQ7kNvwHBAXl1&_nc_oc=AdpZmli5bf0nRcdBMSw0Jiy32VfflclvnVascAuIN7TbLnrzm6_UV_UZ0kzEbsOotro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaC2c7DKWYcDS1KkE1TZDFrrQsRkC1IDF5GZxW_-Ybag&oe=6AA6C153"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8e6q-IJt74Q7kNvwFemjOT&_nc_oc=AdpqM0sPxsngAAsx43oQ14slgFeOPWgcR48fyZgdySWq6H-2I_pDdsV4rl0nqbz8EmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPYlYYsLaK_hEBIPwczgBamnH9eOFuabqC6wkcSfwDXQ&oe=6AA6AB67"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2qKbkq5CAYQ7kNvwFhOEd4&_nc_oc=Ado2knkcL5nru_GrOtl_DA0VSOClf4RlEjgk99MUdOzMPfI-MbCBEeUq6cEyOecM9hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3WedPQ4oTOynC2RblNqYAx_v0uL39Pr6XivgXcM4DqA&oe=6AA6A944"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eJB4WBxO6kQ7kNvwEXxc8m&_nc_oc=AdqPjZd0rA1gk1z4IwrPMYb88nOCZlmWV-PKWBzftr4Qt8KMxuv6jnlX5reF3kydtWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm0p8gk04CuuIwFaY_Wbomn2S-DqIpEHgdpXLI9tgAXw&oe=6AA6947B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1eMokoD1hMQ7kNvwFoY5Xo&_nc_oc=AdpeURpvva7cAqFIIs-8_a624fXFPC2Ktd8KY1FGKycNlkgsxfK-51EfeJxsoZkyg0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGb1fLzFb6RPc6tcFf8TkIG3v3R8nJ04ooKdo-Yr8vyA&oe=6A7C4D2A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB6vOK3E-LQQ7kNvwE8s5sA&_nc_oc=AdqPlCEjqMaAd32YrJU8b2TFGgVR4dGVBeqvo-AaZo15K6UpODhqjyZF8jys84-t2BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxd5NLdiQHVMNlDMRGmhpbSCPB1EiWEKSXSSWGXQuf7Q&oe=6A7C5913"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXTeKqHHqrIQ7kNvwHCkchF&_nc_oc=Adrgp1MVJ--XH6nyafbjUh41214rkThvibBE3yG68JvtwTbzECvRz0dszhoANGjgBxQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqHqGv9ZGx4j4xQPqpWWaXHGOCPnh1eWZbzSUKGwzGgw&oe=6A7C7B67"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t58QvKasljwQ7kNvwEgzdse&_nc_oc=Ado5QU29OvLW0AtiHhuH_6HMvJ9TNf7cdDV7M2vG4UK9XR50aU1r9kYomhPu35vg_kY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwZkSmnLGtBquMwtgzgoaW6wygA0O9rMqtghT047zp9g&oe=6A7C7944"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga1Xt2bsHyEQ7kNvwGsg_IO&_nc_oc=AdoS9VARQsnJlABP7hit0RWU4O8jlgYhPu34Jb0mJdv5sJLM-Hg8FOKIer_7xfYAGMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwBCtCKN29M20IqlekD9rlrrj2X8_vZ9Eb3ggJbC4M_g&oe=6A7C647B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
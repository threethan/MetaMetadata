25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1eMokoD1hMQ7kNvwEujCY_&_nc_oc=AdrZp2XjYLOWYFF6QkJmvfFbQ5926l6fw5kyYi7pxX1dpbFhywxErYG4LUixPQa5byk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXBz8l3vAoGb2QvB7GwfW1SuJo24iAuXSt5e9IhOebKA&oe=6A7EF02A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-R_KPRO9qcQ7kNvwH_MmF1&_nc_oc=AdoK4q04ZqmTGtfLQ3lZ_KZ4YVdhFk494SXX45OJMPnsd98LnFV51yPkcD5KBHZvuFY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPgPOPGSNYe-AM-wlePfONcONAuV_ZuWm-WymxW1wIlg&oe=6A7EFC13"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUdldUY97HIQ7kNvwE7X7tt&_nc_oc=AdovWuzG01qqK14Rjhi_xxXN2j5z2kzVXofCg7mvS6u5B__1sawXionEzEHl381cIdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFKLwae1VSTRDO_3YO1Bg6vY55LAtNwFu2b_ONX_0MaQ&oe=6A7F1E67"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA5I5BoP5YIQ7kNvwHeogVN&_nc_oc=AdrDYWXVTBal9EPFUoKR_S5ZZ5BhPqVfyRmBKJm7moOotBfh1xVb1o0WiNjWtR85FLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj3KxEQ_kbNOEDTQGyzgyCmfG9B75D-zVjc0Ex73zACA&oe=6A7F1C44"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S_s4UbLjxsQ7kNvwEftKJJ&_nc_oc=AdohsVhvk9CyrcThiP-Zmsh14zkiax6UNaYqpWASa6oXEg9LlYlwH2wHBfcoDu1AdLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnsS9zD4CGDDfP_ajX6KyYREldn6YzHQFG8F5LF7Pa7Q&oe=6A7F077B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
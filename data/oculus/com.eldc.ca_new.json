25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p6ezeZU8i8Q7kNvwFpUtD1&_nc_oc=AdosOGO6rf90Si79u91X_RBO7L63SZmVFAgkQG2tgz4eAOM7iH_XPbeEUBZN2Doycgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzGf29W9VOzns0LVmjlJsLDstUypclZdAFRTGmBVsFyg&oe=6AA01DEA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3StMBntEMCgQ7kNvwGdZkQK&_nc_oc=Adpcu3IAD9UurKIoV2xIRZJWj-sUSQFoCZ0yUUCsqO45s9S_n_Y0oCI44Fh4OrvxcV4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeu7do231KbRtUm_ePK7RIyGOBQoQJT3zdjgJuoGdobA&oe=6AA029D3"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92vhN3JXTrcQ7kNvwHm6Qj3&_nc_oc=Adr0DkKJ4O-_TdWRkaYpoZnGml5HODfHGNwsmjMTNwR0ei1yfzIQMU8ktE6VXLdTJR4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ4Zh0Vd5D8f58nNIUueLGrrHfPklWXTHxF-gfqkE5HQ&oe=6AA013E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0VCeAeNuuoQ7kNvwFGQbW-&_nc_oc=AdqWcf9aKpSTwzsE0WFD1JN9xpfafg2Zo7d-xxLedpg9ndolCGxEX93SOPQb4y2lOjY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBX52aROf5u72N89Kkva7V2S8bgJHk7lXHwBiekqPn3Q&oe=6AA011C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqvkUbzCZUkQ7kNvwEFHpGV&_nc_oc=AdpWYotm-vOhqVleAJOS3PeHaUisODS33bjhMQwfX9jTGOhkkpt1MFs5KnLap2Xy2E4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeWZXgfkol3a3X6s_1lBC96tNuvizUrzI1BWlUoV4IKg&oe=6A9FFCFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ6Mr5x4RgcQ7kNvwG03Oh1&_nc_oc=AdrzPpaazaXz0IlpQOOvHM0-iZzOTdmjFNzx2CmgWptKIOyKd9L372oE3RO8yHG8JgY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpE8xMFY8rZKVWtNaQ5GPwVC9UdgKGavEm5ubPMHbepQ&oe=6A971BAA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMTgIQPvH2IQ7kNvwHzPsF6&_nc_oc=AdpjFihNio76-TzUQQ4wK_Tmv1F0qt8yS8gyERrBtxSvAwkTJa9KOlTDQROjkXv2Qng&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfeYzuPc-NG5Te_Zr59yeS1wxtCd72V3riAr9FVuCCYA&oe=6A972793"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrI-M6yDlWYQ7kNvwHO8hES&_nc_oc=AdpVgIKBOGCT4cNETarvly9OmxYF-jEXxz_dqujxt4YARWngA8G-Bk57zhK_OrgHN54&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCdTo33juX0VlfLFvPCjQ_BjwFtPl51Oqm8KpAELU5vQ&oe=6A9749E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWUKI0HG2d8Q7kNvwH_1YlW&_nc_oc=Ado-Y_zJy29n7uGcnf3CkRM_Opyf1c-2Jp-TWOroMA7_QKNKK-vqcmuRk_AZBBjEEUA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzSb-GwXfkbxIOk2YPCfHIMZIcztXZhSwSCsNGQlupCA&oe=6A9747C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAgrxVIOQwQQ7kNvwEptXr1&_nc_oc=Adq-Ug0-eF2Xdnkfesqe_tZWmZ1DEHA-fhhAvn1aRYZz6psQnztEWI6i7tesg8-o4Ak&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjhQ-7KftSHSk_q3sKptlIdhpxmRaGR-vDmf4enGIs9w&oe=6A9732FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
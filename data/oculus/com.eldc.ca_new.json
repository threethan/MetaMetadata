25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpDwYOrPHmAQ7kNvwGJw61n&_nc_oc=AdpY4NZM3CLbk864oodwFUdcY4SIVp3AGP8NRGXx2MBJZ8BfEK3noJuKxO8JafmHz6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ypXQflAYFIIpVlc0x30dQq7V8BY9rTWuEV9n7q0lGg&oe=6AB292EA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvXHTJoAg0cQ7kNvwHirrCT&_nc_oc=Adrubgpl-4E0BOFnQsN_GjeLreene16Hv13XPEcKC31wQZnxQIJQs5cqpIlPARwagS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWmjFHogNBRglsPrJsuvkVTp6KY7g9SIQkjUUw95Xugw&oe=6AB29ED3"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R808O6ROMv0Q7kNvwGGSwl_&_nc_oc=AdpTRE1KejCy_g4JT8dsLREyNlCitmY9I08DOaYYT5pMdgADjoJ_exDIEVQeE8CBluI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-AABVo3iLM73AlaETo-rvrZSJTrsMnFjB1CRK-1TNrw&oe=6AB288E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmzhyCjplDMQ7kNvwHvblcZ&_nc_oc=AdpYZ5LfI6s3FwMJ_AQVeMhbgzcErvGVOA-YXSQDbdxKa8F4i1KrjAtPGHZHKGEStbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-s39RTEPl2dY9SH7kraogfotsJI50XDeYu3w3dhAuEA&oe=6AB286C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuAoewPkQykQ7kNvwE-hSxl&_nc_oc=Adrjxh0rd2XXETa-MqiRf_WjwQp4iw-YmvSwd5FTjzfk871NPnmgKvmPF94urlnX3-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKvSnqqYROlsNFk2oj_3_OtLvF9lRb0cv2fB-D-8AglA&oe=6AB271FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
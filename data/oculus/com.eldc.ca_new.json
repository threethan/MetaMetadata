25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcKQtwFbdWkQ7kNvwHLR2jP&_nc_oc=Ados9elD08uPBT2p-5wA1skZ--MK5gIUbqCb7XY5QGZZfcDtAxKJ0s5ohLfHFLjzKUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGon3ztPrxJH14U_mpuV4kCmfhzzu8xPC7-xgRFQ90Zw&oe=6A7890EA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrzzNljse20Q7kNvwENY89k&_nc_oc=Adqc1KXYsQATQio97A9n07iiMLKCAPUgYbT0oq2j5ShiXrO4r-v_MjluYHJQ7AsZ1SU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwCPDMTEdyBnyse38Z1LkafjukKW4iOTB3fRfOeXl0zg&oe=6A786493"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is--f6H7GVYQ7kNvwHwb6N2&_nc_oc=AdqXabVr3pSHV8GUv_MzKGdRyhCDjZeHF2ZKm76UYrZqgQxyFyBffoOtZlmmK-SAXH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAaWHWeT0qpNrflGg3ZVBbG-n5zMo6nOlI7kjYLXDADQ&oe=6A7886E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnNwWBpCZGkQ7kNvwGHu8SF&_nc_oc=AdomAYfmNKt8kYbr1IYaFx7n0muRP5lbqrnl3UCUrc5zt7T9IvIbPySX0FSIFkoV1_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuvjJpP0WSSWuDNLIiQ5SGDqGFG_roC45R3vdIUOepIQ&oe=6A7884C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhXHWPzG56AQ7kNvwG2jaub&_nc_oc=AdqmASvPcq_aVnKfm1btYHaOFpzS7y7FvgyCtB7bMkcAZPDTLatvJJKMjXPWDRSH0h4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmO8ur5dp1h_Mm2h-z758ZtFPzLWC9AyInOLDuJHHVXQ&oe=6A786FFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
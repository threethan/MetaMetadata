25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew1P9k7Lca4Q7kNvwEcI-lf&_nc_oc=AdoS0nsZRLFzr8L2DqPuaeVgEjI1Dcue7qRgMvr5d-fzKFi14FaAy_IZ3g2dLQ6QzcQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY54q81HM1eUkZgNVdIah99LPM8KgyMcsDsNMqT12krA&oe=6AAD4CEA"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0rCk08fiOcQ7kNvwH5IX2u&_nc_oc=AdoCZbFCwHo0G6_V9n9EtnRvb7s8CTZ4gaP5dS8x5egf5UBuKUvfW7vzYMmIRJk6O9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbOd4jzSjAyYXKI-KLQUN-uoSjV2Ow8OumW3JeX7QfXA&oe=6AAD58D3"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_wSVoriKZEQ7kNvwHaeUly&_nc_oc=AdqVv23mr2VF2EEGrFTs7KVPcgqteCEjvnWf8F3e0QlA7I1P-vtYx_cuMWEx9yqjeDo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk-9C9roh69ZHhatan_yRXiyMUTEk-rpcSHCRQYgydWg&oe=6AAD42E7"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWJb38EJ7_8Q7kNvwGAstm8&_nc_oc=AdqwlHM8DnfEfiiDP7VHdOzgUGWAw8zeYRy92YF107vs2eoiZGlbNUWzeHVloLbVy54&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5XJYtOTjlBRjZ_X4h9IN1EaH9M6uWszcoAplJnFdM0A&oe=6AAD40C4"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjA3_ZplhEQQ7kNvwETGb3O&_nc_oc=Adpdq0exJdBioPaHYSvCer5jo7Omm0VuE-Eiv6e8A9gTrCx04wC-AQmXgVOn_gmTK_s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyg7VDaqrHcagWx9qP1rY4mHLmfDUPYSSW28hmuSEfFg&oe=6AAD2BFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
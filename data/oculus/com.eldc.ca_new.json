25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LXXmbDujUsQ7kNvwEq_tdk&_nc_oc=Ado7rpGPu5ry1uesKlHJ9xXWQLn6MIY29RgYhAkzrzGTuAYW7zRS_gA9-V1vwbEmx1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjXRKMJjwZXNfEh8LyO0tYxho5B6Yv3AbCxIB2SUOm9Q&oe=6AB3E46A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJowC7VtPucQ7kNvwHmPDZf&_nc_oc=AdqNuPJaoAjZ9X60mi02Zs7ZoJ6rUuH8U_4pYVmgVc-59Y5hmFqpqovC5LspfU3I4I4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0u5t3IXQa9554Sbd4vhz92O3_XJ1EN1Qj-upVlDdhFQ&oe=6AB3F053"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R808O6ROMv0Q7kNvwH4f6q3&_nc_oc=AdoTD6ZCsS5NNTLffj493INL_xv6AgJkbfDuyXFCgc4Ci4SRAW9nhriyc28XBnPE2dY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBJvWq6eAr-SIaQbJyXqM79sea27zLY5QTJRbvuHWowQ&oe=6AB3DA67"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmzhyCjplDMQ7kNvwFw_CIv&_nc_oc=Adr5z0Uzwd7Hb_oObUYu1WoE-AjR_kj2ZMDU5v2g9y13dNagyHvOHjl0O68HyvxDlC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzgF_MDoFQo7R-Und3LREqeC3679zWTgcLRjnZsc2ctw&oe=6AB3D844"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuAoewPkQykQ7kNvwErU8AY&_nc_oc=Adr2HWFZOkKCDE2_hV-82RSjCESWYfGKpKXeWVzfoMeQIZ0f9WUNSnL0W7suYTOAG1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnkCChKp0-7FNpwLTyn4i_gIPmQQu5sdWIgv6tlqwqWw&oe=6AB3C37B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X60FG2Kv3FwQ7kNvwF_U0K-&_nc_oc=AdoRJwAnkNLx3ed9NfX8G7fOqtx7p3akGM8eVjFW-uBhjK4yDvVNgGefq5dcUn3h4Ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsKQJdV1G1K3O9VxpzlFTgSMcoi_bSH56oXTCgnqaAHg&oe=6A99866A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rW9e8cewj4Q7kNvwGOPX4z&_nc_oc=AdoTMU2SHIHQ9IqZIAVz86NssFP3SH4dX9mQTa_gjO80vnjD5WVRcOPE4ZO_pmLi8jE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgO2wdy0RNCUpwp81C8okIramUb1Mn5aoHAgtre8Y7Cg&oe=6A999253"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-n8LWXy1CVkQ7kNvwGsD2gN&_nc_oc=Adrld8Tgmks2D8ip5Oi_nS2229J2FuXotdZIWxEC_2yA2Cs8aGfDqXL3vEixhsEcqxA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbojd0W5rvOVveUbQHL8jbqzliyi6oi5D0hZBTX4lCtg&oe=6A997C67"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mRrBYfQ1NoQ7kNvwExxvyt&_nc_oc=AdpRBqVD18ZsstAZEDlNKPM8HOk3QRVnxLbHEkbqQjkIQJFuONL-SaTsKlqlJLF4w-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOJLcw7blsOaPaXguMZANi-b-qMDeh5mx1y6nDNblUjw&oe=6A997A44"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHq7AAscDxwQ7kNvwGPA91n&_nc_oc=Adr-IJ2Vrn3hHc1mLySVmLfnHhI9cHLprStqgLUJ6bDIPP9GVlgskIQ9zmqF3ly7tVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeraUI5YRCPcJvRRWRb3dXQ7zmuUgCIHGzUwm227PMSQ&oe=6A999DBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
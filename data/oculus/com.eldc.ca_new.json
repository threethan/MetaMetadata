25/499308050_2250389455781364_3527506984655081647_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_p6ezeZU8i8Q7kNvwH77T8J&_nc_oc=AdrnsrRrTrqNJ9r5GcHljYIVPaH10kucSKNFccW5GfKs4Y45gDw_K1gTlXNixJTyf50&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS9gVflMmOrWZhwdcv1r-vcubtcfAyKJHgTciRG6_UOg&oe=6AA16F6A"}, {"file_name": "Screenshot 2026-07-21 173311.png", "id": "1002050909296926", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311597_1002050912630259_536807037259164765_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3StMBntEMCgQ7kNvwGSMXjb&_nc_oc=Adr9vHZ3GKhElDD3ALzEIg-Fo25sehg7jXxmD1EpVJKQ2hcWura7ZgwHJ_G5V8pOwW0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwSNBEUBWHD_xvA0FRQx4iBmbFHj1JX8mvmG7-qYuCVA&oe=6AA17B53"}, {"file_name": "Screenshot 2026-07-21 173349.png", "id": "1725754672069454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825462_1725754678736120_1951455871072306789_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o4KDsGzxvcQ7kNvwH_RUH9&_nc_oc=AdrTchkr82ZM-mia9yBXp5_p6GZKTpApZj0BoizAAnib_vKmpbxoQYOHoqVVksLGMpg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpsaK9L4jPSmsuLyA-6kQVT5LkuXosAxVSYtbjzd4ehw&oe=6AA16567"}, {"file_name": "Screenshot 2026-07-21 173231.png", "id": "1559267212529945", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827960_1559267219196611_1224300126859324514_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx0bvug8k10Q7kNvwFchVio&_nc_oc=Adqi3v2zXj7KAjTscyCQmmQKK_nr1h0eOzVTQlcyg8vyLKTo-3yEbm69pAF7pnDMGjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYLKb3xCZ3XG2FG5TJ7ZqEQmX2DRFK8JF-kVLL0pxFbw&oe=6AA16344"}, {"file_name": "Screenshot 2026-07-21 173420.png", "id": "1650908107040372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312236_1650908110373705_16848492286453936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5kR2ztM4nIQ7kNvwFQrnCd&_nc_oc=AdpUimd1kyVDxBEdiXL7EmYBk4y6DcF8TVzW87n0xpZvMdJ4_f7JHa213cf7QDEv1VE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI496nYdURTNLTQsgfSrpgPxuuqRELyqU7khN6BgtSiSw&oe=6AA14E7B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cardiac Arrest", "keywords": ["Cardiac", "Arrest", "Medvr"], "long_description": "Cardiac Arrest is an interactive virtual reality training simulation designed to help learners develop the knowledge and confidence needed to respond effectively during a cardiac arrest emergency.\nStep into realistic emergency scenarios where you will assess the patient, recognize the signs of cardiac arrest, activate the emergency response process, perform high-quality CPR, and correctly use an Automated External Defibrillator (AED). The simulation provides a safe, immersive environment to practice critical life-saving procedures without real-world risk.\nDesigned for healthcare students, medical professionals, first responders, and anyone seeking hands-on emergency response training, Cardiac Arrest reinforces essential skills through engaging VR-based learning. Improve decision-making, procedural accuracy, and readiness while experiencing realistic interactions that prepare you to act confidently when every second counts.", "short_description": "Cardiac Arrest is an immersive VR medical simulation that trains users to recognize and respond to cardiac arrest emergencies. Practice rapid assessment, high-quality CPR, AED operation, and critical decision-making in realistic scenarios designed to build confidence, improve emergency response skills, and reinforce life-saving protocols."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category"
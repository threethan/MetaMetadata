t=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJEEixsaGIqmvBvGkT2cw3SlBMSxjiYT-y9iJL4L9Gqw&oe=6AFC7CE2"}, {"file_name": "Score Board.png", "id": "2613268659187758", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628108_2613268662521091_6461969359434484195_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4gsrkd-tVsQ7kNvwHBRAOl&_nc_oc=AdorSfVY3IwMeDf7i_18Ws4UXaxYWcHczGZIfp4w2psSrDhm_f8SLh7EdoXDDqtkyqw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSanRlyLN_n_-K139PS5sr21vyBDvOPIJjv8MVspCRU2w&oe=6AFC61DF"}, {"file_name": "Missile Barrage.png", "id": "1734090084318796", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622153_1734090090985462_8238525640095067741_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMUUpt5wGnMQ7kNvwE56_29&_nc_oc=Adp3kJX7JZ2ZWEwcZxoZeRgcYk6FxRZY_wld2wVP3FY6bR-D-ifOSz7kDSkKThKQFn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpseCST57CkCxty1yQwKMuqBmzLk72iUD_gDaBH4TR2A&oe=6AFC89C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Video Chrome Rush Title.png", "id": "1662308295481363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619374_1662308298814696_411559389481720537_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDjrBtLkDuwQ7kNvwEdvLgf&_nc_oc=AdqMLRm15F7wUROch42n8XOFoGSNzS3yfzl0DxgfvNxwX-jezuT1y5_MxWASZu28fHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbwyQVTo1bwjK_ba-lPGr5lUDGWqb_RF13ScD_QI7MKA&oe=6AFC8F74"}, "display_name": "Chrome Rush: Cyberpunk Arena", "keywords": [], "long_description": "# The city has gone silent. You haven't.\n\nARCHON, a city-wide AI, has frozen millions of citizens through their own cyberware. Your air-gapped rig spared you, which makes you friction. And friction gets removed.\n\n**Stay moving. Stay armed. Get out.**\n\n## Features\n\n**Ragdoll physics combat**: Every enemy is physics-driven. Stagger them, blast them across the room, or knock them over the edge.\n\n**A different run every time**: Each loop throws you into randomized arenas, then a shop to gear up before the next push. Survive every loop to reach the final showdown.\n\n**Score with style**: Headshots, trap kills and fall kills earn bonus points, and a combo multiplier rewards staying aggressive. Land the final kill and time slows for a cinematic finish.\n\n**Loot, coins and shops**: Crack crates mid-fight for the best haul. Grab enemy coin drops before they vanish and spend them between loops. Stronger weapons appear the deeper you go.\n\n**Level up**: Every run earns lifetime XP, unlocking special gear like a repulsor rifle, a grenade launcher and permanent max-health boosts.\n\n**Deadly environments**: Laser grids, saw blades and pressure plates hurt your enemies too.\n\n**Global leaderboards**: Chase the high score or race for the fastest full clear.\n\n**Comfort options**: Smooth or teleport movement, snap or smooth turning.\n\n*Millions stand still, optimized into quiet. Be the rounding error.*", "short_description": "The city has frozen. You haven't. A rogue AI has locked millions in place through their own cyberware, and you're the last thing still moving. Blast through randomized neon arenas full of ragdoll-physics robots, chain headshots and combos for huge scores, grab coins to spend in shops between loops, and unlock special gear as you level up. Then climb the global leaderboards for top score or fastest clear in this cyberpunk VR arena shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1erlgi4H70wBQ6tAAt0efr6D-SDKBOUwvcdTNZq2uEk8/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Eyemobi", "support_website_url": null, "website_url": "https://www.eyemobi.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035
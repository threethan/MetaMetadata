6-18.png", "id": "1584237036271350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V15pLMPR1VAQ7kNvwHVze9A&_nc_oc=Adpxwp4CntRjeRdGQHxkFMoOdqrcK_hKlHMyi-F3I9uQ1IOFBad48K4EJmRstFnlJgo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqvAz3e-rGzXZlrIvL1TZ0HZAJ8bbOwDwwwGM24soueg&oe=6A689F1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-esJCKSRFEAQ7kNvwEJrf-I&_nc_oc=Adr1E-FRnDO5YdirfDSLWDtYnEEEknmQIlXK4zVj_cS_Czo05EPQj0Bm7E6FEAMyXvA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqbcsGdNYEB40y8TCkaa05eygJ7M_XHGR39MpnxGwRdQ&oe=6A68B016"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-BQyg_toSEQ7kNvwEE4dQE&_nc_oc=AdqVzXbzWUJqHzRRJNokV0pcXhJkCIzFg5Fzj_KkFM-LuzPOUGRf6JN9hfyoEfyUdxI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV7qq07ZF_g5yEb8RBD0ml0TGxC42-SyHzTqDqGLBFPQ&oe=6A68A76C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79AFRoJzUlAQ7kNvwF5hlGb&_nc_oc=AdpoUz2TwskTWzsrmyR_GcxOmXqq34Qpv8dGtBtYYN072K9_vUJWHUQ7BiVYfhaHWv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nWPTBIWq3SIphF1TIHFfVJWRFDgHIn3Cfo4dp2e5Hcw&oe=69D6489A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH_KxnIS1iEQ7kNvwEa4kLb&_nc_oc=Adpnwe-f6sl5hkIlwp_eVYJd_ztb3p2q_aeDNIY_C8Cne8l2zXOueSdnKrmZqhAPRTs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af193fYpZ4jlr9hX8V4t7HDyZ_RgNTZF8jpNr4p-SlJEXw&oe=69D65996"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4_nsgEUnaYQ7kNvwE-5Qtn&_nc_oc=Adqj6eNS_Z8zdsJnnTxeMpMEuNN4OSFz13viQmUS-E5DhEKGFlt7miRe7bzQJ1G21uE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EusD8Z99gWD2vJXRXtO3j76b89XgtzRInEJVDfYPvRw&oe=69D650EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
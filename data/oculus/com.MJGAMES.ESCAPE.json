6-18.png", "id": "1584237036271350", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9TrGbF13QgQ7kNvwE-tEuM&_nc_oc=AdoJPToot7-XJrasI0ceI9eGe8a3MN1z9L_7L5z5o0s8CNzIhUSaL8YPVdIrFYMfIFY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kjt-Tf3LFmVVxyjbHzn0kK5w3hhQPADUZUaYAegDjzw&oe=6A1C281A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCKdQMfuOw0Q7kNvwGWgnPx&_nc_oc=AdrGCy0pBg9ZgRB_-Mepld7Hsq29H1Mj-Ickjr-B3PKx2jp1YpIQXPtX7HL7dC3tmK4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51BHk06q3j0yWdTP4cKXz4CBF0ssGtwdtFc2jaLxNgig&oe=6A1C3916"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_6xtWQesRQQ7kNvwERuj_w&_nc_oc=AdpKqNf5iSBLoxPeINizTBEs_KLEtXGUNQb0Wre7LSWIJoNjhXyj0Hyp9P9YmcbrfRY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hoV5_uMzn620B4EJ5rYZ2rh_Nab07h62uWDhKroVllg&oe=6A1C306C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
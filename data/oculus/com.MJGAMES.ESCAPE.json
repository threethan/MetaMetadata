6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94KuXMrLFPcQ7kNvwEC_uyQ&_nc_oc=AdpKsVl5ALbfqrhKBgPp4AFBIdvUzKy0X4EPJdu-pZJU9l3wY9mreUMTz4gI6cu4KWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYy5m4W2WOVxdrHzABzBCd4sXGpdBd9w1Jgp699501MA&oe=69CA6B1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1F4i4ZW7b4Q7kNvwEtzWLe&_nc_oc=Adr6kFkyL_KsJ05kSY3qbWcJauSul3MkjvTBVZlE-oT3sW4OF3-4cG9i5g54cTQGUDU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwB5cjpFHgs1N1T6C8a54tht4SSRoCe9Fs8Z7ULJid6mA&oe=69CA7C16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9RPNxyq9uMQ7kNvwGdyk0V&_nc_oc=AdpbKGBSYGy1V8xy9-PCP9QBCYOVB_NICh6GAjL03VMTTtzHxt2QKAyG6uPnx2HKfYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afynurr_YsM-QwQnFy6R9OyVTvFXKBjqculBcZv9FQZDSQ&oe=69CA736C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
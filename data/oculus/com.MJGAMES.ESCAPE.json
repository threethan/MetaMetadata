6-18.png", "id": "1584237036271350", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tadvMWuvohsQ7kNvwE4Zveg&_nc_oc=AdqNJcX2mHyVtc_tB_JNvsgBA_rUhtvh1pck8u05EzhoCBFgsQaWkS76DOduJnelhR8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvYGw7tiaoHxo32VqfOGkxumKwdOdaiCiabj2bq5BQ4g&oe=6A58CD1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsPzKgp-tr4Q7kNvwGPYF35&_nc_oc=AdoA45BP7xcVg1ziASHQYPSDKTOVE9Mn4KY2NDCx_DRv6LBO9WfQlL6xHBGimcnDaOg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuZTKmTIEMAp7ypG92TmYbEc81lSkMQY55lF5r3lh25g&oe=6A58DE16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj1qguOnMnkQ7kNvwF30zFV&_nc_oc=AdpMJgQ9lv1AtQkXhVzwYyvABKiBcFocMaB0Dc0PMV90YxUOniqaft0nfwkuvJK-d2U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVfZ_328sQ6DRBK7dOud0LQrHf-UekjEw777UN8qeZPA&oe=6A58D56C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
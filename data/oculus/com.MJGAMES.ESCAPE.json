6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REF2JRIVdFMQ7kNvwE7fA4g&_nc_oc=Ado4-0mhTpLhPrX2jJOLVPZYHU2RQ83jaiGVVpPY3nBGGxKrRAsmKjK1J1O27572CyY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eLnpFJv9qjr1pskpCO14ZTznd_VTZb03OoCWhD31bew&oe=6A26EC5A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPD6TY6kF_EQ7kNvwFOkcGh&_nc_oc=AdrCoTp1Cr3dyq7Bpd9bOCCzro0uNdU8eLkeJhM02BeJxSQfjAIkbQtQ0CotD4t-fLA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PcN1rbaAmpDf-8h8XqWeJQM8Xs3-tIlg-frDeJVfUJQ&oe=6A26C516"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvZfEjl-fS4Q7kNvwFIWVsE&_nc_oc=Ado133j-U0w7LnjakUBEqtWZh5qqQTvBiTLUqf_YPoXC2WkQz0R6z7a9gowJO3nP0hU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_q0FTcx6GVd3I5KpA44MPZygsoI37ztrJA4QB-EpObUw&oe=6A26BC6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
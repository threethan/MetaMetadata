6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-cRAQiXG1gQ7kNvwHWSkhf&_nc_oc=AdpAq7uEasYkzbbsfhHyzkaMn3Oqeujrh1YxOLJaaeAW6rFYip5JspSMOJgcAa-0YQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sFwlEG5SC6z_9jUq7db4KOsdeutu41GYF61ukYpeRIA&oe=69F49B1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWT4ih1HcLkQ7kNvwGhpaeI&_nc_oc=Adr_8asTtQXxCNm1MxM_pauYJ4M-lgklZ0yvFRlvERRWsZe29ZT8P4s1DwW1M-d6D5I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2u_iMDdNE2Noi_J8jkr-ZsMKdGwvcmHr5jGDYd_1i4kQ&oe=69F4AC16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf6SbCDiCLUQ7kNvwFCGztg&_nc_oc=Adr7Y1XQE5HbmGRZNuNyFt5aIATwsZrRMXliYq_pTJQguICn6fudgrQcuoxDkza546U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j020ansUKq8z1QY4mb3mkLRM4wNoMjYZ7Om3lP0ohEw&oe=69F4A36C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDzftn0o2_UQ7kNvwHxu9sE&_nc_oc=AdqGymOgUTFYWkmOAmtIVA9PaN2qcC_JUW-BCR1kH-bK-Ab7MAppE9hI7PBUJzfG78s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQFYMSPM9FKa0_yaUNPFheiS3zCHUjvaFDGgj-E7Ut0g&oe=6A7C659A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deBxgpzRHSoQ7kNvwHkL4V3&_nc_oc=AdoOeRHjxfwIkQ-ehg7WMKhleULb4LLpi-RvKUpd-98Qh4IzS2FJzVoQBwfuqcYbSa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEil0VWguNEO7qkck9wAKtOKF_UPHp1WfF0kCJ06XHc9w&oe=6A7C7696"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7a-SwliqvAQ7kNvwEHfG6P&_nc_oc=Adp9pl-sU73CdzQvdwlUAhy_IE2jBEYlnqQ-H1JtWtXadckJIYeIT2rntTVaFqsoKKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJs0o-MY-qRQw9a82XAbmrViE6n7qFNWWCaCvfx3TLXw&oe=6A7C6DEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
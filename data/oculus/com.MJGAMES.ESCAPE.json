6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am2n3E_IqMsQ7kNvwGfQvZY&_nc_oc=Adq46zYZDge1zyX79eI18Ttt2NYZQOsfEw-6LJXTkaqqw0_wGZsHvXboD_FxL55QhWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fk1D2CsD3xTMAwDQzMj6fgcj6y_Reqv1TvekFt61VMA&oe=69EF551A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcESLnlDNKcQ7kNvwEhDw-D&_nc_oc=Adrq8vxWEstlfQKneDaNIzyAerAOuklmHcnOL33izR-7MQMwLafbbqptKtUcF-Dvgcg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Z6YBdLQ9YQHwo1SxRIlf1hHxGa06YY1ehQArpFj5KPQ&oe=69EF6616"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8HioQELeLwQ7kNvwE_56pc&_nc_oc=Adrd0mvxs6nNxhviv3egany3QtcJ1QKTQs8wBOt05hwzr7CdrLrQOWF18uc_QOThIjI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YEEcQzYGrZK6WNcxwcorgBrgKWysofTKc7kfXfDM-PQ&oe=69EF5D6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6jzVR0LOUYQ7kNvwE4R56o&_nc_oc=Adps1XytvY9hUNoIpwxjKTXO7OzIEkfl_zUOtCWIh6mCSuKA3M2RysplUmovGFKfB8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD33vUdkd0EJjhLvBF3rVPL5RxnT2wsIXggEiZ37nTznA&oe=6A62079A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lu6xs2q3LWcQ7kNvwGXqCOX&_nc_oc=AdqBywcW9_gzmj7rX_hCgesvEztPLuAnSK1xtNK6_OEN7fkQWAofrhTfptB0bXTbprI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4Bx2pB5bLn9GJRGM_7Gr9gdC4DMxOCdyYSlUCbaYf5w&oe=6A621896"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUwuyyajhwAQ7kNvwF-9ZDP&_nc_oc=Adqoc_twDFPaqVzV5V-WAkfK-F4burHSdE9AvBa4xovvGwOSJaTd98gtm41pgblLgPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwf1CmfVLzhket-Pe6q3hRl6-b8o1tCMNcEPctXFl8qQ&oe=6A620FEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
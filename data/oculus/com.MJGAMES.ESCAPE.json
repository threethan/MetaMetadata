6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU_6uAUzmbEQ7kNvwFBNQH-&_nc_oc=Ado4qOjV6faqaiEmrG8novCwe_TP0MfqHpK42gpHCd_UWVGIIkmkkC4CjKNc5dCMgZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fx9AY06R5qnF2q8dBxYxGcqmKV9rKqb3w1UmkT_eMmQ&oe=69F88F9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_DYyk_W51cQ7kNvwEH-SVo&_nc_oc=AdriSOpMBYYTlegcxOvf9bZD3TMAWDTRJv-Au-M4O21sp4-GOAzD3IZ9lL92OfJ3Dw4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2a33agUwc3oWr0fIygbU8JgRFQjWlHm-lbRI9gfNjX4Q&oe=69F8A096"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQsDQ5PFGTMQ7kNvwE5c9VX&_nc_oc=AdpkRZeWaDSfsNkNojHL7tday9TCOFbkvovn8OA0knZsGqugprB7mItAQ9n91h0AHT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0rKDqs9v3k_QaKNkMed0scWmlBdgeaooqevG-ITztp8Q&oe=69F897EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
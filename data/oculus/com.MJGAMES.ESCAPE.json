6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvyG990neSkQ7kNvwEusSZg&_nc_oc=Adqi6rbjMF-mbxbp3ES-53odWl6FjM_J00QVIePIm5a0mY-bmuUVmqXSGEnKLmHUBrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2B7sXzOBCL9BkMbIG3zFbZXrUzwDSThtAF8f9ECaoig&oe=6A6C939A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwFmB8tG_fUQ7kNvwGmw0Q6&_nc_oc=AdqLOjlrPW6m3tC3CikW9m2x1CuNy4fwVoz-GpGNzGgC5CUNTL0SR3o99Vd2d-LybYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUjYqo71z7ikuwPgEpj5D1uD7dRpVK8r4bvnkJIsc6sw&oe=6A6CA496"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eylGFpoMueAQ7kNvwEDMta2&_nc_oc=AdoNSHlW88B2qSbszjRs3oSnJzTL4DxjNxRpzCdmr_2BvsLEMhY25kEP6PfXfaNcVSA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe3OP-GovFAlzLnbcLthWMocVmkN2RmFi0aGNUvyz--Q&oe=6A6C9BEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
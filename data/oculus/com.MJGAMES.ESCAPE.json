6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvtvS_EF1MYQ7kNvwHmY5a8&_nc_oc=AdpgAETFOA6Por6_6o4XI3fr7UKMOgo_SY_kkOZOaKSuvey136OA1HU9X7uOs-83wlw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I_IPOn-oXxjyHHZSDXGSQKzhKi941oUU_QqY6vNFmcw&oe=6A356CDA"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0ZjiF9fxTsQ7kNvwG9hGSO&_nc_oc=AdqsvdwtMflS0tMXxdSLO3M2LFCHewGaMOugBHqyQT5mdu8NCyKY2wiDXDaugyX3oIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Yok8yODJXvFRiqZbSoHDdmWUxlJTMXcVUjspiUSjF7Q&oe=6A354596"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ErFQ_LEbuIQ7kNvwHo5MpX&_nc_oc=Ado7q0wdAwfNKsBKJbN5vPGxLBQdbAhP4LMPUwmp7jGGxeN6a2KcNwpw1K73hvy7xY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_afq2LoQPXnZTdVl-Ipn1tzP6KwbggrL6LxlDYjFKCOQ&oe=6A35752C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
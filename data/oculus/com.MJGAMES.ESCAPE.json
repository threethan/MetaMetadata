6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEGoxDd4OCkQ7kNvwHGMCol&_nc_oc=AdrhS4SmcFzyLx8bgIpbAMmzVbIJcYfpl9W2Fdq3XC0KvsqZpQl_5ehrvBTbIdJouFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W08O6mnYOrL420Dtof0aEroRB8Xg5j5u7f6-gtwHkfQ&oe=6A143F1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh-cS3G2HWUQ7kNvwF5CsTe&_nc_oc=AdpN62z0or5eaBTUDOpK-6h5rHHsQ1eTnaT2RlomG7UkQ9ooC9ZGReXvcATjEsgeLV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af476-8L6B7ANY4tt8LqxnZUCDfVSGXzPT3zG2KI9EPl-Q&oe=6A145016"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRq-BX7hY6QQ7kNvwEEEWOU&_nc_oc=AdoT_R78E-2ytDRxugJZvuyrLJf7EbxPhbTqGZmJYeWDe1YR309qWMqLeGbTrTRNO0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M2sNNkAeeM5FSpCkfYLa1dD1oLhVbEsXzSoqnryxgLw&oe=6A14476C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
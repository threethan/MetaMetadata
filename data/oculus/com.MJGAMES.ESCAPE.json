6-18.png", "id": "1584237036271350", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvwXhLiIPMsQ7kNvwEJcm4H&_nc_oc=AdrEywsOIbNb1uwW8AEZ_dqTi6z8Kj6tcGWmzISDghDU6afLihNhK0Ru6825JGLw_G4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFWD0JTYsjouqgEiku0CdV_e0acuKAYGYMy10rSjnjug&oe=6A4E411A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMBJCvJQ0aYQ7kNvwEVioxd&_nc_oc=AdphinI2VMzdvfIW1tGq2oOKWG6mGhp5xDI93yoPdWsAMshPS8MiSglw3zV0x7l0u5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZV6RhBgN4VZa4MRFXYgT0P1x3FueTCqF4P2BVzKzJhQ&oe=6A4E5216"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCflS1FrQn4Q7kNvwHiIt1D&_nc_oc=AdpyA5dCCyMWaG3N41JdY2PdWTSZclxxX_sU48vmGrG54_sdNsDDUYbdHpBe_wkVyM8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpwajmS_HfkKWPoTXRK42B5fiWQd3wpwboPmHdmrcaqg&oe=6A4E496C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
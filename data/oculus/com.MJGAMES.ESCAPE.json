6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCAcqvfS6QcQ7kNvwFMxIFT&_nc_oc=AdrmFp8MVkQL3kJMTuvLXmSyHP-83xEsA0hz0-Aamk-1-Q6FgbjGyp5Onx-tMNxV3Yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DSi4Gb-ionJ1IRov1eNAXL5cHqWI9w3iftCvdJ2mmuQ&oe=6A031B9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nombYWPCNgQ7kNvwGYubXq&_nc_oc=AdrHtaFH1WEyaD7lphl3LedBGRKf9J2nqT4rUaUl-X3d-KlComvupo2q1SzToHnPafw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dJpD3mNpqBrsaVMYj7XdpUzU0mRlKUMHl8rGH1y0ISw&oe=6A032C96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmoOKO4c7cQQ7kNvwESwvcZ&_nc_oc=Adqh5X30PBWRuN2eZd7rc-ySq__vZRkdkYoSYCd0ywX4hHBvz1CvizfjuSfhxp32ctE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r38OA69vfF3s5XtkuOFySvwhKpXecviAzEblEpPvFyw&oe=6A0323EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
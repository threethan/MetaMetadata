6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPvcMEfgYN8Q7kNvwGhgxoI&_nc_oc=AdrGJ17IlFN8BZ5d85V0KNQA6Jm9_9PV3wOBAO2hYQn5PnSY8yRwqyk1OZzRzvD-73I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oLwPL-kGKQ-JK1Y7Ac2s2V8QSgEifWWbSNNyhF_OVUA&oe=6A3FC09A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sodvBofDDwQ7kNvwF1Eo85&_nc_oc=AdoQ6XHjEESNVzDQ9ubbESrExkBr6CeQEuG-2pXrlK-dxKFA-C1-lb2cxfke6Mwyh0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--K1sK3flONTKgupl2igy8SMNGOMv1I0KNKEQ9pu83Zg&oe=6A3FD196"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ8hBdsAgD0Q7kNvwHeE35B&_nc_oc=Adov91kymu92ZjbmgtVJnzd-CI_Vkyw5Qs1sLxC-RYALmBht-zhxv27fb81p3HzaI_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9URaJxO82r0EZDSvojREx3mgBJMNy-uTw2tEr9REV7Ow&oe=6A3FC8EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2JRVhFFtDEQ7kNvwFhf1BJ&_nc_oc=Adpm3vC3iG13N4d9P4uZlmD3aHo_8NDqDodmfe5ZKUT3auULAVSqf6CRI2sUVH0f1JA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnRtpXJoyd9PXHQUDEaOBywQIm_Lynn6jReeYi_09o7g&oe=69C2821A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aY6sO6sTiNUQ7kNvwESZEva&_nc_oc=Adq-Yeb6nMnznWc-fsGQuywagFUqwinsu-39zKKMexkPn4r1BB9yGU0pG-o-Z7gRu8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzxNsD8BUeWa4eCHtqryGLDOH_vBheeLxMXE4-e8NcQQ&oe=69C29316"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTTa6EmiiWUQ7kNvwHE_glk&_nc_oc=AdqdT95HeioJdNICep5l-tA9QI--k4Ey93KA1uQ4Z08wz67LgUk7Eiwc3Bbywdytssk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLKZFEL7l1h-XhF_QtWOxcqInzGMCBJfWYnttxdrtutg&oe=69C28A6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
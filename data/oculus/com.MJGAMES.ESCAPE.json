6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDF_IS_PRLsQ7kNvwFgB99Q&_nc_oc=AdqMQBAl7yBW6tkfO3zz3Ic9A_K8hOxH3vIlJhOmlwEoNjFUqyVLpVEtsxhowzMmQdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEEpOQcH6EVBxfPcTBRbSKmwLzPUJIh5WvCZQv5XbWrw&oe=6A844E9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHTuWjaRtBUQ7kNvwGcawiG&_nc_oc=AdpquLX6yvctv7GrEMD0ME-8C9URDChc-XBlvlzHp1u6E8xakdXTDm6qZsPqZSqJSFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOrZEik3Rz5DCFUDXGemnRgIFwtyE9mGqUNQYu13q6xg&oe=6A845F96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXkoHqHC7UoQ7kNvwGldH9Z&_nc_oc=AdpMYhFdGXKkf-NRiZZ2gc-StDJ5OFWODuh0jyXHGCSjfP2vf8JPxOxM-HKmfmRI00Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAjDSb7kkgnS7KPgFBmTxKgPhFqR7rEkAMufBVMLe5og&oe=6A8456EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wRxYZG5_vcQ7kNvwHCV_j3&_nc_oc=AdpHMND9Ta2_AHqA75iRtTnqKlbCZN0wk9a4mAZKAa-9FmSwy5v6uMD5rZbJMCr6gaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87MI67L4rau_O5osPbVEAsIZrh6gaQXU9eU_L4NxjSew&oe=6A2D4B9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toqNHooNyMMQ7kNvwEtGReP&_nc_oc=AdqB_PDkrE7iR_NaUibLKJ5ShisXPbNPDvhfQrK7XDTFr8MfcYf8vAbXsx9TbNTneU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y0P-NScm4C6kkpB_2wOddvlLCe9qz01ALovxwqQyuRQ&oe=6A2D5C96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPRPJHD8GSwQ7kNvwGbYOg6&_nc_oc=Ado9APw0VRIhLb2o9sinnRf5W1cGF0Bw1kNXd5e_CkMDDV4U_GlhlDdRz5Q4C7xusaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z5svKxjGj5Zoa_99JaWQbrFfQsilLP5pwQuTZcrYNYw&oe=6A2D53EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRUldDisokgQ7kNvwFaOVZe&_nc_oc=Adr0myJZ3ob6XP0cAPoWmy93hahiCIzaF-PKg_22GnwIBhVf--xW5i4Mtj0ExJQOV8o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zuiJtIfcgHJgnLdX_4Z9LJDeGA0GeWsoh8JhveAFWkw&oe=6A28059A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMumYsZO3pAQ7kNvwHkKEh-&_nc_oc=AdrENz0yRjJB1--j4ASIBPQ7dya-5kjT65WeHf-k_i3f-U6O_KhHHofKErkgkfge7WA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7pT2bQ8m40WdZywMhZg5_JtOvA-6wFiAf2PAeDGwuhg&oe=6A281696"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23pLQkIoVPMQ7kNvwF6I_af&_nc_oc=AdrkJu28k1ntfgWpFy1F7ThgHKx-lmAwMxmd9pY0YrsqL1oSPIqx1bQDBqirr01qaG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af870nl6uUlPaUPNFSvE9NrXM0ovgEqSqIeerqjZ2TRwyw&oe=6A280DEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
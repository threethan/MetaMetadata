6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvwXhLiIPMsQ7kNvwGl0I0i&_nc_oc=Ado61PehcFgqrfMyAscN8ZD9kl0gdpKjf5ZIR8qasoPc9JzpaAhZLFrjZF1sng75OG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0M-Kte2i9W7fHNsYbwqKQpeoNXRN685n_jUTnsmsymA&oe=6A4CEF9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMBJCvJQ0aYQ7kNvwFFFAIb&_nc_oc=AdplhepZjSAhh7R544ppIL_jlwErUQg8AZn4H0SScnwUiLLQOrfQ-hFmhN8ju5nQSo0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWGmMolPfji-YF-MpyepW5xF_1MMFKmISKnuqhXMsHpQ&oe=6A4D0096"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCflS1FrQn4Q7kNvwE-msb-&_nc_oc=AdoY52zD9pk8YWeuxNOkafYiYLWFZL9_iW_5AhUvhNFTC3btP25hQt1DnIDvh2P6RvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr04UjoaxARhH1WSJktrPF7FQyiFZWArD0lcGzIugqUA&oe=6A4CF7EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
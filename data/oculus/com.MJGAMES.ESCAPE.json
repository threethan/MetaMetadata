6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvyG990neSkQ7kNvwF8izMr&_nc_oc=AdrWYSOPN5SFl-1fZE54hHqjhYLkc3OBDBFGCjzAmtY_VjVVKxMFyU_Dj8lB72QuH9Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQSllOF2AtBATm3sYK1GlfRag90goJRgsjTtbx9oC0iA&oe=6A6B421A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwFmB8tG_fUQ7kNvwEasbTN&_nc_oc=AdqlqF2o2nEURq-aWW7wwS3uSZ2kswtpXIg4kE7-zSqh8xLJDTxjt23r3SsGHjc_uro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeNLz3ujAItp1oq5J6866osf4gZc4Jz_J73o1LoAHCPw&oe=6A6B5316"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eylGFpoMueAQ7kNvwEC9XGx&_nc_oc=AdpK0CELOOBAm26LYHd7BiRr7FB3n99CG6_jAoHaI8LqlhfpHI4PQ8S-ArHcIRBrMGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsGER2nuKXGN1kRrh94ibPw3isw7QCG-80T5TmiVppGw&oe=6A6B4A6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
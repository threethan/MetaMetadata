6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AL0mTxQizcQ7kNvwHT80H1&_nc_oc=Adq7pZrJnKDcZAWNehexQ2TiFj2Ut_wYoKd_iWByTpYWkHjuOcLad_L0hahB7HTtBG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57LNioxrXKl0lzGs92Z7z77WiHiHa085OYHGFKEW5LGA&oe=69FF271A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO4wTkEUFiMQ7kNvwFAqHJp&_nc_oc=Adpt-KqxlJRauWzqGXVNKwE2-yeTuVq2OIOhDwLaEYXS9dkmchWvFqtmrTSwm0gk25c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5msuKN_ZmEOU8ig8J5kIgorQA619zbKr1xph6GIj5vwA&oe=69FF3816"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1M9nZySR2gQ7kNvwE1Nv6L&_nc_oc=Adr6G51tslQ2EnSXeQbDVcu7UhkW1WssBgbEFnQ8f4GVmWVxGIFmC6NfR8UKTwWDJ44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IOfHA1NkKw3FEZD717SQjEfYpqyT1-F8l9ZcaIPbuRw&oe=69FF2F6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKbdyiWPdFwQ7kNvwEqgec8&_nc_oc=AdrOCCUKIubRNPVh-U6ALOAeZWRFHYsqvUgXpfFvf1deAirSKOQkZGDg-L5_1noOGQA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d5DgCvgklNcYyCRhBzlgBX9tqTnVBmTaeK-f8nyf5vw&oe=6A08619A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfampgd2H0UQ7kNvwEnc0Jq&_nc_oc=AdqWhwjV70SBAUPwATCtZ11BVeKp2t2IAJtz1FQrxm515WZ05P9-aHiSslKrpWIKO1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cjq0PEjxBkRFlKZE5t1tbbv4bxFHMrjzApSyZUZWaYg&oe=6A087296"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SelIYr2ioToQ7kNvwFesnax&_nc_oc=AdrFgLIr2H_BVcTvtXiwHU3lUThQtxKtzmpKT8ZSF0bUgFSFn4SU8GB4dwbEpc5WqF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VpC7qdepfLyLvmLIig0DRiXwVm4KiHiycHR8w8GAdeQ&oe=6A0869EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
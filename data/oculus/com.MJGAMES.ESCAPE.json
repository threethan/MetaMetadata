6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sej1A8u_QnAQ7kNvwHQ9aSB&_nc_oc=AdoY2GA5hPLfPSpz6AYOI6w-29a3wb811GL10yb6lFTec1LYPMj25Vn8o6jRRk6wlU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD_4CKauZsiF1nvEVHLCH9RWJz7RsauiG16RK3cUYNOQ&oe=6A732B1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-ofze_grwYQ7kNvwEkvD4q&_nc_oc=AdqdiDmkqc2DtK9nEEIVafd3JuT4LsV2Il578V55oN7GH1ek3mcqFcCCRNHkVh7qbNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtK4e8cH3cgSuU9__2MIeIB0yCn0_mzXlaggt5Ew1Tww&oe=6A733C16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPCsUHQjqTsQ7kNvwHcXAwm&_nc_oc=AdpVlVIitBEXn81YZQ3mIyJapw4JQM6eD6pvO5XhVQ-uzjkePP7al5XNf5jSfVNLpKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkKvK71sE9u-E7ZSKMYWJjGCmAiq4J6tMcpcfRyvCCJA&oe=6A73336C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
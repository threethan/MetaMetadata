6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REF2JRIVdFMQ7kNvwEfrEod&_nc_oc=AdoFqB_AWfggZSyGSxsWRLV78WjTykWNjJ9vOUDaVsj8UmPjO-JhrqO1nftyN6-6NA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EIelPKN27nj1C-Uj3nnf0038ULGAMUb6swONlBRdQYg&oe=6A259ADA"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPD6TY6kF_EQ7kNvwEjlPe6&_nc_oc=AdoZfm_NAEmCgoh6DIPU4MCVzcq14SQwh_q2De0GJlsNK8sa0LeFk3rHsZAjaHUjDKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nURjHF2Ir1xLP4c_tYJl8Ryz7MjT99e8uyj2vOPW_PA&oe=6A257396"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvZfEjl-fS4Q7kNvwFvGlfQ&_nc_oc=AdpOpUwV0auVx7fY_Ss00T9DhPA0ZQFykcda8OyhwardMs7T8pHS7iznyFTgtkocQus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wWMe_5zI2Pb_Luf5ZwZXWH8B_RcLgjqRetKH6vf89qA&oe=6A256AEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
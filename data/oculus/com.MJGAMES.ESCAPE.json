6-18.png", "id": "1584237036271350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5HdleWidYoQ7kNvwHn_mMk&_nc_oc=AdpJZF8ol5JWzRkhWVS5ghNRl7CtkCoEV5sL3GdgFYGALy-vs-7DHSzNFY4Ra_8JHd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr-wZAR2fZlngRUxrV_5X7s1lFPRKJ2sIwR4WjuuTa4Q&oe=6A53871A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MpnvfIubetcQ7kNvwFfMe72&_nc_oc=AdrJpHQqrBL6kHTZ0lmabHOIdax9J3-H9pQHl0XcDyOKmQ3umjQ-oWHBMpBvYB-NECY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXy9TLCMgr-FsFG2VcXOd8jxyxGEvgEB9QVCUsxhcHsA&oe=6A539816"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93JWvZPlWEsQ7kNvwGFFrBP&_nc_oc=Adph9YE3RqG0-f_h2xU8piKQk-6obKWB7LMILrGCxoLb71KAEcAHnSkgYyNQmfcPhRg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDli_2JVf4vGaqDQohZvQ81yhA0mJF5DeJ8UEczwfd3xQ&oe=6A538F6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
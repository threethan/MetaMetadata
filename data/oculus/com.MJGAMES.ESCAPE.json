6-18.png", "id": "1584237036271350", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LSBoY0pdzcQ7kNvwEQPkdV&_nc_oc=Adq4YVOo8gy3LjVpe3-9YjH-1xcId4JWcW4QPTOzprBsq648u8ujiXTIZp7rpuoMJ40&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d10STuOLmyClNVh_U4ejo7lxIjQb_ylmpP5nXVT2Wiw&oe=69E2261A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdgfKr_I4zMQ7kNvwHlcrXJ&_nc_oc=Adr3jf7__DF71SHfv5O3c_YwIxqsFReYOjC7iEI31su1nQeP7cWFVKjKPdehU-WnT2c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fFLER6SEiezowPq5ZM3vr_4pZbMVdukfblIOBU-pEnw&oe=69E23716"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud-rh4qdpgkQ7kNvwHpr5e2&_nc_oc=Ado2sPM8aTpscsY0rmnH_sKRiTjpYpTEqkoQy1gu9eBaV-VcjnrhcyJwrlXY6W6j-zU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nFi1QjWhEUMgiY93Bk0bfl-Bzp8z2h8x6s5SREZfBMw&oe=69E22E6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
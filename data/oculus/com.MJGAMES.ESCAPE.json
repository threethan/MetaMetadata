6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD71Je9NqE8Q7kNvwFmGR1R&_nc_oc=AdpsV8XQtRpo3lyotgpC7Q0l4HbljF8ovRk5x-anGtTWAZuTx7dXo-AOOUR6CpxbvnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Fq0uRkCXNG9TZ3f32Xw3ATaOTIilh0er-tVkj5vhqvg&oe=69DB8E9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6bpmpJZ2A4Q7kNvwGDItc8&_nc_oc=Adq2qDv4gmpSYLo_O-Mry2qxp_0p66-y2WiY0x5iM3oTtssdMxn6YbpuvR-qrTsCYWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3e4Hg-prIkTt_ayB_ZlYzCzaDSm2efwjmWCr0MfvixjQ&oe=69DB9F96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVvnYzW_Kd4Q7kNvwEIWHSW&_nc_oc=AdptDsGDwyJRsRtmYbtCkZADWl-rUBdNTWeABZpyDIKuDxL2TQAuhG3hajbV-c4Mehk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16blNy-50LUP4m1mg7Wv3y0lrOVItouNIE8Cha1GBg8Q&oe=69DB96EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
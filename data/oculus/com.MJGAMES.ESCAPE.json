6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tadvMWuvohsQ7kNvwEPcsn0&_nc_oc=AdpX_gxlGTkdS55va5e1jckCyyUOGficM-Q-PvO0jhmtUF_-C_my8nhk6xgOAitagiQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPdx_hBcnKCCJvMrDyu92dEKI36_mXyXluSqmAMslFMw&oe=6A577B9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsPzKgp-tr4Q7kNvwG2kgC6&_nc_oc=AdpZhNqixpkqUjRp10gWnuSyS3CjyGRAUDJkVmAR7dz0NYAHnsdcfHniiQo5NIH-xSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxJZlMZb0rMbSPKCAHLyxU1Tey_HwtT1utRadITl-YwQ&oe=6A578C96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj1qguOnMnkQ7kNvwF0ff4T&_nc_oc=AdrdcdKkU7aiiJNp-tV7NTivZffJ3aRDv8R7GIY0WMJaFmf6LngcBz0SFT_CyvaWdMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv4aI-bBSr5NiitBI4_sF3UvTMWFFNHyzKoJeieaUe8Q&oe=6A5783EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
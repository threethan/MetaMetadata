6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ6RKKTx2eQQ7kNvwHeysdh&_nc_oc=AdouNGtMNBjrQeHDOoLcobgzqaQ979TxOh1BxnNM1W_rxYtoSy2hhcMR-mKGdUezaBE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zf3ra7gjHZsMueVOj9WU9F_VG6VAGQdz7JgD1xWkIzA&oe=69F3499A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O8wVdOiwtQQ7kNvwHYylLy&_nc_oc=Adppx0wBcJH_IW2D_gT8_x2ThPJvSLIj_V1YhyGM_1urwK2bpCKMSsLIr4TaBlbS0_I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XuHjclvuwmuKTrrYUxFLa0teRGTtn7eJFQ4e_fa2xqQ&oe=69F35A96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NszvzVQgTt0Q7kNvwFDqvXL&_nc_oc=Adq1ZkTUeQGAiiXXL0SF26Vi-Mdo8y7yWpAKcT4ylI0yHFJ5KfBtlBH2HvXkEhUzamc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cOTUuLBinQQ5UcNpYM-YwAKh0AQ0PwAdC_3y7ipv5KA&oe=69F351EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
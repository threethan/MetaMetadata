6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AL0mTxQizcQ7kNvwFLeWG9&_nc_oc=AdqbCRxPhCqTE6MOdwspegedlIe4mg27fSoMOb9Lq358qH6_1NspW9BiinrDpMtXQN8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aIo1SrlhCqnW0jlJtkDZrVy6RwqJjX3cK6BmhOO8MRQ&oe=69FDD59A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO4wTkEUFiMQ7kNvwEMckVR&_nc_oc=Adr1KOwqEUsIGd0ptcDOIPSTtsYaCq8EkQh4DRFYGCNwGDE2CKR07KJYT4FUPxKkjoQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45SbIIoslbYUs9XnAMq61KhkPDJQ9sArl10YTsEZf0qg&oe=69FDE696"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1M9nZySR2gQ7kNvwEuS-QL&_nc_oc=AdpxSa-gFrxAqdwJKA4nXgORqnwN2lPrA_MH4_VCeQhoE0JQexcv404313YUIADuZi4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kyQ4nclxp0D9zvw9MudPz4t1Ir0eA4Cee7puSoj9Q4w&oe=69FDDDEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
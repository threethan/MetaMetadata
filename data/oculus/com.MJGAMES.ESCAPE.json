6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yu3emklVTUQ7kNvwG6u3Fb&_nc_oc=AdqXFILqKVE4SXYhDuyUphPM4EpgEJI4jKqEwIK98vyrZx_hVsrk4DPA31lGrvExdLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS19UvNTyL5fX4OZyCBbmj1O1ZUrGjXSdaOimTdWI9lw&oe=6A64AA9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj2lgLxu_ckQ7kNvwFyXURo&_nc_oc=AdqkLj95H4umS7NwaKD4i8b6OQLmKHfmROxhvIbOfu5abukC7Q8hqw05F7vVuSiD62Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsq4Os8Zwie9FRof3orFvhoYE7iqPTRzTYGqLiU7tGxg&oe=6A64BB96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHzRRXFCUdcQ7kNvwEPuFpU&_nc_oc=AdqxTpvqRqE2zBO1wW7xDBjI0uTtpjWUyn-e_rz6Yf6c96oEa_ZHQGaL-LghPNCmyUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvgbUsJ20tE5muEMmCZwPlECqQSb5lBDiSsZpUXvnUQw&oe=6A64B2EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
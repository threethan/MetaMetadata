6-18.png", "id": "1584237036271350", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rsoLUt06PkQ7kNvwE0oAI4&_nc_oc=AdpLoYfOmrTknrAnvxjxvyb1q8ionwn1XPKjkDggJOT0Lve2dpTvGlGAiI-wmk5fSKs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YtpAqmSbGaOyqgb9mEeS9B4zno_-atbQHkxIX0fbb0A&oe=6A216E1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDhmHyypmv4Q7kNvwGfawiI&_nc_oc=AdoiC-TPNRsj1ZiRj9Uo6vvLLoAvratqMh-lsS1IVu1Ku_FRLQudA8kYKJK0kkrSxUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83yapIvSQfatATRDkzAXYvNxd2NJCcJjXqI8U4gN8zmw&oe=6A217F16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3mJYFO_BuYQ7kNvwFgSLXd&_nc_oc=Adr5WvhcMDdklMXxJMn6718oILeAmqZLGzLQ-g1OidLX1AZwvjQlfwOiNqPMnhSNEAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YpTEmAFekGV6JwRUH0yEjjO35NO5cNVmCRJdPzlDQBw&oe=6A21766C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
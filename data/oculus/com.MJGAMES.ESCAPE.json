6-18.png", "id": "1584237036271350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KU_6uAUzmbEQ7kNvwEw6J8-&_nc_oc=AdoDgvozeF5v2-PyNmJUyw_Qg4whq_KQN9o5KvV_L9ucgVFANKajNXSC6Xwj6ekNoD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bzkjo1HRaReWAoGZ771RAGrhESlKc9JqnqcM2ZfJwjQ&oe=69FB329A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_DYyk_W51cQ7kNvwHpZx9V&_nc_oc=Ado4MUlAkSde8NJspxcsN85ouav3wLANTOtYJ8Pdg8y69_guu5mcQ_tRIPSK7epbXrg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YHfrCnfIyw6g4buw1iFDKBbPdpdbEo9PIA-x4YpcZeg&oe=69FB4396"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQsDQ5PFGTMQ7kNvwE1_kJP&_nc_oc=AdpmrjHVtQh3Np3JiISTwkExNgvToVqx8IAqbYrrK4H6gD9ZpdDF2VPBwHobunt3SYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KB8mGQA40PbOMlm0AdQc5CMsKF9Pl-aQW_KrP7KMokQ&oe=69FB3AEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
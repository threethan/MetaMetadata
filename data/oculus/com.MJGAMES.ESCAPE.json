6-18.png", "id": "1584237036271350", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tadvMWuvohsQ7kNvwELcQOi&_nc_oc=Ado393-wCpYQxRK52TBNCH1X-h2Xo_NtTv8AeDKz4lTafPxjv0zMsYY-Kuj6Cc8kwFc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS10GsSm53QC6fhgaohI06l4AFbObiwTQTGBwPmRhO8Q&oe=6A5A1E9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsPzKgp-tr4Q7kNvwEIrCf1&_nc_oc=AdoVvw_XGCa1q-cMMY50wOfRnCvThDXSffKeWGHOk90ruJ2dcfLFk_Pgb1tfVFC-xO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRECsZ9QtoYu6TnLhmqqEyzKngsWCWgSRhE9AEjj2lVQ&oe=6A5A2F96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj1qguOnMnkQ7kNvwHppyJF&_nc_oc=Adp3IziWwD9uVfNIyCMjFhjDMhbbM4hLV0W_KMXTH9lGJCsvRTkJc6mj5SZBYAztf_M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvB4Zz9uQeGnzBe0TYD5wvT2R0ylpfGodSe7JVtDqGng&oe=6A5A26EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtZ5F5gK-z0Q7kNvwHKkuYb&_nc_oc=AdomEpXdNkwaCo4_LHnPlFJE4MeDtPxvuleUYfbkqtwZOO3vzDNWv_7gCvECX5TNHsQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENRX_jcPcOC9T8eDJm7sqW01ffBfRAdX1atRPzdiCbYA&oe=6A81AB9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjADD-bgSTYQ7kNvwFMpIJW&_nc_oc=AdrctUZdrljm99rUOe4dO0TXe_pvkyTvCPWd2sRxm1CGsbE_RHeBEw1JVJsQ2Nno-tk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmper95hS4EmPdE85KwRYrOTcnS4HADaH6BrnSYWCuAg&oe=6A81BC96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5QuL2WsIxwQ7kNvwFy3Qe8&_nc_oc=AdoAVsot1aX9KEG_5VhljneGc7zulfCzo8v8v47gXjCBjdA_RktQQaJR-cZxVNCoEfs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbAFpDO1kMhjgO7wGZlBE1mT9KyqfMxhCoQ_CxtnlqwQ&oe=6A81B3EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glC2gkz1Dy4Q7kNvwEy7esM&_nc_oc=AdpKu-ebgXCky9IYJ1CMO0fNr6kz8lKbil3QLB9-a6IEe5At2CP1h88T_Iw3Q3d-sdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4As3SDuH6SLorB02iDkbIx_7UNHjTylQpSHf6lkNDYw&oe=6A52359A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlZcijnB_C8Q7kNvwGKyIfL&_nc_oc=AdpSF06V3Rjr9JT6DeFz0zBg-o8Ts1lanBFQp5zrdHPxmP2Q8Z13-j4ahqAGUO5Ole4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5tfQhI1ExqSjoIevBgRvqRNeBc27scgHMaV5JYiCidQ&oe=6A524696"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahBhglbH__YQ7kNvwGG3hv3&_nc_oc=AdqnNBqoTdleC0W1l4YVltKrz1ezcu3cgrr-IMrPqfVC2p-UiREWoe1rxdMeZOUhxSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzs0pk1y5Ldjj6H4QwC1YSU5sK93TFcZ8oAHEzlSP4nA&oe=6A523DEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
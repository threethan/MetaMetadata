6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChFBkEAJPWMQ7kNvwH-NLSP&_nc_oc=Ado8_VyUpqUrz3EN3ZyWeh6zukBsvcbQ-Bs-pIumL6HSlDvWIYbYA815MRjiYYFKK44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-9WoPlODv7u9gxLNKpccJvEGd56ypWYl2StNQNJS_Qg&oe=6A5B701A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmIqdVmqyqcQ7kNvwFWWVQ4&_nc_oc=AdoFxLrU-VlnT2J0JvKRMEcdb30TEYh-lcB_W6krQWcOJmi5iWA-Jk0cLS1guE7VJ-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi9qjMKi0NftvnHLNu_VwMiENV64O3XGr3ZUJW62H4VQ&oe=6A5B8116"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aja_T1kHqPkQ7kNvwFqu5t2&_nc_oc=AdpXKktKiGDZxn2MCaaSlaSGrV4avl2Q7_FTfkd8jdlaY0tPOb9a3dEYrNGUBDWIvZk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9-1B4aslPbUBC5zuluclO-9N21tVXnWjJc_vO2dIwxg&oe=6A5B786C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
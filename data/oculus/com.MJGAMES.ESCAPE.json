6-18.png", "id": "1584237036271350", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDF_IS_PRLsQ7kNvwFoM7zl&_nc_oc=AdoPKV1V9NFbwXhV6DTU101Pf8r14hlQu6aR6IHzSo5eTC-1x5iTf_VX_yP7NU5La1w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-P1B_wF3ABY4UKSpqOMFsox-EoZbW5NY0W9nYPmdxyQ&oe=6A82FD1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHTuWjaRtBUQ7kNvwEiURcP&_nc_oc=AdpQrcX2Pb4HfdIXiqPF6CbBJpVaQXCfBFDANHQL5tn6Y9T7nmCtQLQgHT7VN13ajYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl5rg4lLrFJ4pku2hm0YPIbqPI5vn_QzEZIwpWl4qe9Q&oe=6A830E16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dXkoHqHC7UoQ7kNvwHHOmzQ&_nc_oc=Adpk7TB5qpKi1G46Xjc1urkv8cXwYIJtoyWIJQRZvkznL-YTajrWQm7sYMeNLTgs2EI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYD-8M1JgI-ADsfotl6xx7Yv3qpMKtWiS1VaF_jwLTKg&oe=6A83056C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
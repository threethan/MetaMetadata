6-18.png", "id": "1584237036271350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LSBoY0pdzcQ7kNvwHFWTBb&_nc_oc=AdqH9tiujQlosrsXPkLW_87vXUhinDLxBrmD2src5mY-6g0wBUXO9wzy6eE118Sq9xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af047U9C5AfDUGp4Uh0Qz2R5qtJX364frdPGck3TJToeRQ&oe=69E0D49A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdgfKr_I4zMQ7kNvwGFOnDW&_nc_oc=Adp9ZpXDBqdgG-tR7ydllkUXcreWjdzxedEpxRsqod2SXbaQ1R3fF97x2QJpru4b5aM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30S4NnOBpsoqv7E8Ei6QHEElhQDlcZ4dOEFCwoQZhUKg&oe=69E0E596"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud-rh4qdpgkQ7kNvwG6wsqL&_nc_oc=AdppqAhYXwgEpFWm4R50vFBZ5OP97MF75e-Vg9_XKpGAMUWhPydVHtBfsn8i9TMci5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af136FDJz8JVNcJZ0yO0JtJ1cPRgDj1a2CzG0I5dBkr1jw&oe=69E0DCEC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
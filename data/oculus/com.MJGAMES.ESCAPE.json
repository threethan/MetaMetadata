6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79AFRoJzUlAQ7kNvwGwhWCf&_nc_oc=AdpbBIV_xt8PMB58dFhgh6FjOGP08ep4BfQEWG-n0cvKRD4pvBVuGQDevKub3VgA_GU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27pbxV1khlFn3_yZ6t4mnuH3ZpbiOshRb0f3ZuCTb3WQ&oe=69D4F71A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH_KxnIS1iEQ7kNvwEpYOmo&_nc_oc=AdouUtk2mS_gFo0DCzrdNch9hpKfQFog7geQi0kCUvmub4IfYhGn7sHn9VQqhHHuYCA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3036VyUqF5j7jq9pmhn7lf-v2WptTCFwitwasr3O9BIg&oe=69D50816"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4_nsgEUnaYQ7kNvwGGfyF1&_nc_oc=Adph3UoeeBfLHk6nRsurNAye7A8QfMd4tIfB3zGpOmCCRIHQBJHe7A_lJSRoHo9_4G8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36-gKN-OcRQqWPQCgKwNJHO7QWbR4I3HjAbOQ3sDWfGg&oe=69D4FF6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
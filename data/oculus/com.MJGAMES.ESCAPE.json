6-18.png", "id": "1584237036271350", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glC2gkz1Dy4Q7kNvwHbv3Vn&_nc_oc=AdpCPA-ZB6MjzX8BzJKqZrXYfr4G9QKrjCjbQ94F5sbVWlbBdxLt_ZQbuByYBh1MYDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqo1XcMIDXdyOEPDia6EJC7r1fVVMQJbqjW-xPb8DIuA&oe=6A50E41A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BlZcijnB_C8Q7kNvwFlITop&_nc_oc=AdpDv6A8i0i9K072IVUEh1rH7f6pLw1qBK_yTSyZ41ZaKBl-ctMew091j9Y7bHZ1NOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYv1cINddES8gr0E_TTwKI5qV_Kbe73v-sk_aW8TbBWw&oe=6A50F516"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahBhglbH__YQ7kNvwEhHkRx&_nc_oc=Adpye9C9HHvGZMsefdwHIhuj9lO9qT3Lamr92TiKCfN0KrBQRxN9bRPwK9qORc0skSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9EPI7fEUwY0Oql6VxO7amv16vauWrrUg2TlkdVPqUtw&oe=6A50EC6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
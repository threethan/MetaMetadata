6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDzftn0o2_UQ7kNvwG-qad7&_nc_oc=AdqhujwAyWqMCK2tUgMDdldqgKCqIpbVGBiGkHiWPCthuGSs-vBHz_ar_YEiXdOjFt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu1HDMtTrPNam1LO2YxgoxFujzJgcgGg5GnoO5gW3KtQ&oe=6A7B141A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deBxgpzRHSoQ7kNvwFt9-7K&_nc_oc=Adr2CS7aa8IjTsLyWhsqospfFZ_dyXFiJtX4bBtLYKBrvOaIPAueufoosfiJB0dCIXI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHps8utBS8VnMKq10Ep9weW9Dlae7KXR0wE6Ya6zXxIeQ&oe=6A7B2516"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7a-SwliqvAQ7kNvwEC9RUf&_nc_oc=Adq0ZAaTZr8SO8e_iBWrH1nv3azJP7oqRA8VOq4Spik1apiY3_uAX1K61Mzu4kPccBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe3cIFrWsp53nP9-1WqLbnlIzyabs3lIXfy9eL_z1iiQ&oe=6A7B1C6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXfKfVj33cIQ7kNvwGnqS2G&_nc_oc=AdpsWOVyu7KcdGfszX9_v43x9pJE_0YNfrfI4TYUEseSl5JTvH1viq6cLbSP_goqB20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BHv3UReFaWeo1IzMaHdTr1I_XMn_pv2YWY1NfH2UbPg&oe=69DCE01A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVUR_BTRD10Q7kNvwH2GZW_&_nc_oc=Adr5A-by8fUPSDFJ63hvxQMWLd6vCR1qIN1JIExhFtR2dYVXGNVwZ32iFjrpvmtP82c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34znzmfq6BUsPZeYgEi8Nb8pbknIytMk2oLS8OS4737Q&oe=69DCF116"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0dWmeAm04sQ7kNvwH5sMbv&_nc_oc=AdqbgaV5a7HO8FKdLGv1C8iuR0DticFkaZqw6qgEhBHDuIsLH-4S5t8pRlSXCJ7RgPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21sHdE4PxDWvdOxLrj3q0nogV-LQHEptJ__jdbV2TIiA&oe=69DCE86C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
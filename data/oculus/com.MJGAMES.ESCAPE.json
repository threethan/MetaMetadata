6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gCYthxtwVoQ7kNvwHI05S8&_nc_oc=AdqH5YJw6-pO3LkMBjrHbeRLRQnbrC36APRHRkY9A163WoAlFcec9RQWiafDQlGevRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BdYMybgo1ULp3NmlnC_N4w7XsTYkREvFvWwAhDN9_PA&oe=6A47E1DA"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5jCPe_89nkQ7kNvwHzGhm4&_nc_oc=Adr3SKNLKs9jdDGqa0EF4Bne68E2yQAyhiMpwWxpP6-pCrwlctUpHB5dSaOUM80iqTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RWP-Wkby3Npl_-foCjVF28J7sVdYmmRKrdMC8dHPiTQ&oe=6A47BA96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_QBuRFktp8Q7kNvwG0oKZ6&_nc_oc=AdqlpT8vi4xOw2FR-uvlVYXadhykaXiCiSP3egzupugPg0yP-JguqhmO1ZkxOkvZT4k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rup2wWgxZmNTRqAljbtYmBKod4SjnPglMn1Ud-rT8hQ&oe=6A47B1EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
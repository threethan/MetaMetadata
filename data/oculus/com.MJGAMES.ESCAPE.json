6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeT5taNeapwQ7kNvwEFysAG&_nc_oc=AdoauUxJ6Eo68xSjtHHAc_XCixSLV2zTuHFBlWh5vr6M5ZNlCb4Sx_3oCV1rXJAARQs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LyqS8Bp_eZT4H0VrYJsB8wkhO4a1cg1oVfq-ZvzT1Hw&oe=6A43ED5A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlQ8BUqgGSEQ7kNvwFKtgOy&_nc_oc=AdqOroVg83S6SFp_7ikQi2VVikUjL3zRt98ChQEbeV7_xoH9KeWewTJ9GoF68K8HF64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zr0x2dHfm9iUFlGToUpJLhPMXKyn9vwL9BY_ycI1gDQ&oe=6A43C616"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZA5nmEqe4EQ7kNvwGAy51n&_nc_oc=AdpVNz6d60JFBPUPKNrRi30vdShNqIZAaT2G6OhsWuLNyxxqp80_2mL1JrAERO80DJc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p2QFHk4mRn8WGDNHkVQmT5EjT9qW5geDpI8BV3XJKpA&oe=6A43BD6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
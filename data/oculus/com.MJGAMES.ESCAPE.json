6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OellEvScDOAQ7kNvwGj4Wc6&_nc_oc=AdpMtABe0EelS4uhdh-4zFW5pUivS60p9ErQ_4mt7LUPvjTnwtlH48cx-N86EGJB1KE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19zV41B9GzsZ6-3d6NTc_S2q1n6F-IWx8iTdZnW2CHVw&oe=69E4C91A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA8V7wyzjyUQ7kNvwH5j0Jk&_nc_oc=AdpUkQjxMh7wLJSSQbDk6k4ZXOPEtdRnranVKgxR5ny4oUSKHMJ1f_bC6gbdwlYhB-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xAdH2u6bfdR29tw7Iq5P7EHW29gHvhBq-STI72_4ItA&oe=69E4DA16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnFc7hFpOeQQ7kNvwHVZsYQ&_nc_oc=AdrRKH-Uhu4Vn4kN1EJv3KM0NC32r6VtSJ0-li_msl0yAVVk746vXY3z7K9lYdAgieM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AqLbVyNy8NsTYan6E5-13za1HS0pTOCA1FSD4iBl6eg&oe=69E4D16C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
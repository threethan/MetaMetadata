6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCAcqvfS6QcQ7kNvwGVbXkK&_nc_oc=AdroDxp6crti_g6qtLmRmis1MqZY9R7F0vs-RHSJ-tejOKRpnka1epIF47y7cEtxglY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sm0ecdDlpsN0uBasnsMZTXwZUpndCyLQFJw4Mqcy-wA&oe=6A01CA1A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nombYWPCNgQ7kNvwGzBqFd&_nc_oc=Ado6zlik3glvFR3WRQhvewKVO--hWaLo-KffjN71lFDy_4rUM3wcNRqEfxZId93cn1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41-DkKAJn5eZndoKfJP-938L2LG0JuZ3pgGSZGXtKBhg&oe=6A01DB16"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmoOKO4c7cQQ7kNvwHpAhE3&_nc_oc=AdoCaaPaPAQRgHVvqVe7vRzzlJkO0eTxhqN2lf4QIuPXg9tO96BNMl-JEshsoWCvvnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63gruzH2AJ_hsgra6-SOAVrhoN_TSmGcAy_0YeCu3Faw&oe=6A01D26C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
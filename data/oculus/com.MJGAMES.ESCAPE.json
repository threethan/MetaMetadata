6-18.png", "id": "1584237036271350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V15pLMPR1VAQ7kNvwGogGBs&_nc_oc=AdroRqSY7P1zaz8yflbYwml7Bup2EANZP73FzZVza62GODASMOuG_ev3V6rP_H_bdGU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_vOXLMiaGLIDEamObzvCtJtx_sGZTZhpCLQzx-hMF1g&oe=6A674D9A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-esJCKSRFEAQ7kNvwG0RcVV&_nc_oc=AdquDdECGUB7QuUSeQ0i6eIhV-Go04AqUe-rG8NCX-FKuwGgVFo6phhF_1sX7TNwJEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApPlypdRZRBdTNoMjJA2hdXSeBTBZcffZnMcaSkz6j0Q&oe=6A675E96"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a-BQyg_toSEQ7kNvwFkup0Q&_nc_oc=AdoNnKbF3feJXmRC7SuO7Gh94TukcZRqVP5LKTD_85JAVIXVncWncvi0-UBRc_gSs44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM1ieX6k_S5Vy-gNzqnPfjaorHsNt8c-GtdutkGqQmYg&oe=6A6755EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
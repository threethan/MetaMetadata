6-18.png", "id": "1584237036271350", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEGoxDd4OCkQ7kNvwHgHoRC&_nc_oc=AdqD5x6DUENVCt91LXYYe7y7MNeuGBAvtHMMeqqVVKWUL5FKX21cs0FRq49I4NohRac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rmuKAUAMzIqVrmJAh_niP-gBbI8EXAU_XrCrV0knjow&oe=6A15C8DA"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh-cS3G2HWUQ7kNvwGBmASv&_nc_oc=AdqFdQ-Vt4HJ6jjtSaUvNgxWJd1505y78m8mdJO2hdVzsFtLNJtGQwsFpgx50VA2g8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X2kPfcdT3FwO-PBvPdcjGe9jTmESXUalqpp0KM1DFwA&oe=6A15A196"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRq-BX7hY6QQ7kNvwFUXy2-&_nc_oc=AdqqQsJGomRKGmVfR_dp_wWCjNNsUmpzmxfY5IQmyc-k96J7JcvK4GSEdi3uTIfPWfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OA1eKSbzpfXlmyXZe3fsDuzg3wb2ZbZU7px-ZVbeO3w&oe=6A1598EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
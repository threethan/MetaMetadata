6-18.png", "id": "1584237036271350", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304019_1584237039604683_1922260334023600852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLbhax3NOpAQ7kNvwEik9CO&_nc_oc=Ado7yLjQEIyIbAQ6-Qgfw-j5HMK_MGZ0yhIflWpwAxgLQ_6xyOA1tfkCDg36-BCH5fk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tUeC4LLVtRWTcA4aaHdHYHZ9HAu9fp0LXvaQq107NNQ&oe=6A07101A"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-17.png", "id": "26025950993677436", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_26025951000344102_4389241860984540354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr8tB38gCa4Q7kNvwE4gZ_I&_nc_oc=AdqRMWeRru1wTV3PeixJh4iMd6EnOyuZ2ob_zPqZHkat__nAHsLaYN2s8E7FR4TWtxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af516l_-U7Hsr29xCLfn9I87KX7oGYGTAAFzfcDDCmME0Q&oe=6A072116"}, {"file_name": "GAME_Custom..._12.12.2025_03-00-45.png", "id": "1092402756198673", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619518_1092402759532006_437820512118052043_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iof5z02lofcQ7kNvwE-ROrX&_nc_oc=AdrTHb1uXCY21QNZ2zKXFxY7ljoLt1Pqba6KUTPWUhn6-oqxabpH4GF8Xl9KvoK0xU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fQKNebet_dBklxpjsH_ghDZe46lVCYbHjLRadTaBXMw&oe=6A07186C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE", "keywords": ["horror", "levels", "gtagfangame", "monkey", "scary"], "long_description": "ESCAPE is a level-based VR horror experience where every second counts.\nNavigate through a series of dark, suspenseful environments filled with puzzles that block your path forward. Each level challenges your mind while forcing you to stay alert\u2014because you\u2019re not alone. Terrifying creatures roam the halls, hunting you as you search for clues, keys, and the exit.", "short_description": "ESCAPE is a level-based VR horror game where you solve puzzles while being chas
NFa9zyIQw94fe8O4G_azjHL-OqQTMERwzucDqKATVQs604c_6SRzpdfnwA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFMqY9CZTWwLsrrTeGbWenQ89W-f8OhiQFIrP1awJ5Zg&oe=6A60C168"}, {"file_name": "5.png", "id": "1698235207954662", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1698235211287995_4857749782822547450_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_yitz-ibV8MQ7kNvwFmFdoB&_nc_oc=Adojv5HZSrf9kj6Gh7lv1hSxsaToAMrimcspPLfXtSLzamy7nnCzeNjns0Kzp3M17ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgt-I0z54uUy04WnSNjLzArq0rubbI_bJ0dS3vUaVigg&oe=6A60AF2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Stunt VR Game", "keywords": ["carstunt", "cargame", "cardriving", "crazycarstunt", "carstuntgame"], "long_description": "Experience the thrill of extreme driving in Car Stunt VR Game! Get behind the wheel of powerful sports cars and conquer impossible mega ramps, challenging stunt tracks, and breathtaking jumps in a fully immersive VR environment.\n\nTest your driving skills across a variety of exciting levels filled with loops, obstacles, narrow tracks, and high-speed stunt challenges. Perform daring flips, collect rewards, unlock new vehicles, and become the ultimate stunt driver.\n\nGame Features:\n\u2022 Realistic VR driving experience\n\u2022 Amazing mega ramp stunt tracks\n\u2022 Multiple sports and stunt cars\n\u2022 Smooth and responsive controls\n\u2022 Challenging missions and objectives\n\u2022 High-quality 3D graphics and environments\n\u2022 Exciting jumps, flips, and tricks\n\u2022 Offline gameplay supported\n\u2022 Different camera views for better driving\n\u2022 Free-to-play stunt racing adventure\n\nTake on impossible tracks, master extreme car stunts, and enjoy endless driving fun in Car Stunt VR Game! Download now and start your ultimate VR stunt racing journey.", "short_description": "Drive powerful stunt cars in VR, perform crazy jumps, race on mega ramps, and complete challenging driving missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/orbit-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Orbit Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/orbit-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1208558402340558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312470_878784964816251_4384142659600423402_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcICW7fcx9QQ7kNvwESIMWs&_nc_oc=Ado2OPXmrmaxbsbKrBcz4yx0IXyLvu_9H8NPpX-WPMlMSXSEWN8MBDqsL2xTbouc25g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDpE-BmQ0YTyJXlXJzKnMGI_UhQjxOX0OB58Uoi9iKhw&oe=6A60BF22"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Car Stunt VR Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1782145920, "lastRevision": {"nodes": [{"id": "1173406599189072", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1173406575855741", "is_firs
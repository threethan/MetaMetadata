oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1LP_gq2y_1nqOfHiBTyzG3wL7Cawc6NwLO1CnYfiBBw&oe=6AFDB167"}, {"file_name": "Screenshot_VROO_5.png", "id": "631774279784302", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_631774283117635_5269656821539073314_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q753p4ETM2MQ7kNvwGJpk5V&_nc_oc=AdpesuBuZL1nXfduZ82vKCXemQDtsWYams7a9c0C01VEYGoXol4ZOWOw_N9ZdwEjZ38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq6l11DupDAUW7tIlayInwFBETbxJdjkOKzmpYpvpr3w&oe=6AFDD541"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image.png", "id": "627964563421334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391888_627964566754667_4986837803024784884_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3ndsysW6GYQ7kNvwE2UnF0&_nc_oc=AdqAuP1dMf4YljW-qVt7-UQvfbKX6-qwFeLdbqMdnfCvuRMhs2DoI6T2eMBUuUGUu-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZOKA3yPDmWby8Blp8kAaULEuGEEHOEv3QFSb_9j0j8A&oe=6AFDC8DD"}, "display_name": "VROO", "keywords": [], "long_description": "VROO est une solution cl\u00e9-en-main pour pr\u00e9senter des films 360\u00b0 \u00e0 votre public sur les appareils Meta Quest. Notre agence vous accompagne dans la cr\u00e9ation d\u2019un programme VR parfait pour votre \u00e9v\u00e9nement !\n> S\u00e9lectionnez vos films dans notre catalogue. VROO offre plus de 30 exp\u00e9riences (Fiction, Documentaire, Exp\u00e9rimental, Nature & D\u00e9couverte, Enfants, etc.) ;\n> Lancer l\u2019application et t\u00e9l\u00e9chargez vos films en utilisant un code PIN;\n> Profitez de votre application VROO personnalis\u00e9e : Une interface simple et ergonomique en mode kiosque qui permet \u00e0 vos spectateurs de d\u00e9marrer les films en utilisant leur regard.\n\nPour plus d\u2019informations, contactez notre \u00e9quipe :  hello@diversioncinema.com\n\n\nVROO is a simple solution to showcase 360\u00b0 movies to your audience on Meta Quest devices. Our agency helps you build the perfect VR program for your event!\n> Choose your movies from our catalog. VROO offers more than 30 experiences (Fiction, Documentary, Experimental, Nature & Discovery, Kids, etc.);\n> Launch the application and download your movies using a pin code;\n> Enjoy your personalized VROO app: A simple and ergonomic interface in kiosk mode that allows your spectators to play the movies using their gaze. \nFor more information, contact our team: hello@diversioncinema.com", "short_description": "Pr\u00e9sentez des films 360\u00b0 \u00e0 votre publique en toute simplicit\u00e9 !\nThe easiest way to showcase 360 VR movies to your audience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vroo.io/Legal-Notice", "developer_terms_of_service_url": null, "publisher_name": "Diversion", "support_website_url": null, "website_url": "http://www.diversioncinema.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9491675180878849"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "952344183650585"}]}, "baseline_offer": {"id": "952344183650585"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743072300, "status": "PUBLISHED", "id": "952344183650585"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_
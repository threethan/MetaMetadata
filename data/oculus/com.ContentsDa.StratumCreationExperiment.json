-on experimentation meets cutting-edge technology for an educational adventure like no other.", "short_description": "Explore the world of chemistry in an unprecedented way, where hands-on experimentation meets cutting-edge technology for an educational adventure like no other. This package includes collection of 1 experiment.  This application supports two languages, Korean and English. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24522128254068534"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "729304496039472"}, {"status": "PUBLISHED", "id": "7495770547137160"}, {"status": "PUBLISHED", "id": "2436860006702968"}, {"status": "PUBLISHED", "id": "1171480323811996"}, {"status": "PUBLISHED", "id": "434024912530374"}, {"status": "PUBLISHED", "id": "428586956541858"}, {"status": "PUBLISHED", "id": "391663860206897"}]}, "baseline_offer": {"id": "729304496039472"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1727851560, "status": "PUBLISHED", "id": "729304496039472"}]}, "liveChanne
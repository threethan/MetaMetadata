 "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568673_575512341725330_5709982695986838565_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsnkJvFNCOoQ7kNvwGWYh2x&_nc_oc=Adqb70vB_uqaRJKsAUWoRgZ0Qma6UZ48QEQHWl_LhiJ05cHrmFloGsmckHGvxNctaqg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-7n1i1VU2Y398ySVrVAWj1U_TSssfPsKc1MsvM56cWQ&oe=69C1227E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stratum Creation_Landscape.png", "id": "2483583855157120", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982652_2483583858490453_175171093219864639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OMOYG6lHhoQ7kNvwGr3rMC&_nc_oc=Adpp-etmru-GkonjzyKt0uiTHa9nS4MiQnEld_VhpXN8aSsZblvOvQB6Bat1TOXxSQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe4knwsgPuR0gSlHacyZZXK2mequoODh41pxZ7-nOuAw&oe=69C14A91"}, "display_name": "Stratum Creation Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "stratum", "science", "contentsda"], "long_description": "1. Place the gravel, sand, and soil in the square box in this order, then use a scraper to even out the surface. \n2. Add water to make it more cohesive.\n3. Open the oven door and place one of the two strata models in the oven. \n4. Touch the oven door and bake the strata.\n5. put on the gloves on the oven rack, then remove the model from the oven and place it in a mold\n6. place your hand on the tool handle and turn it.\nAfter activation, turn the handle and observe the earthquake phenomenon.\nLearn that the Earth's interior is in constant motion, releasing enormous amounts of energy to the surface, which causes natural phenomena such as earthquakes and volcanoes to occur on the Earth's surface.", "short_description": "Delve into the geological process of stratum formation. This visually engaging experiment simulates the natural process of layer formation, offering insights into sedimentary rock formation and the history of Earth's layers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27493889500225713"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75441573_355094460717452_3369475753269830971_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2njEmAUwSl4Q7kNvwEnl49r&_nc_oc=AdpbQheUPkiDWFCHZOUh4f2JteIeKV1ujJkx2bPh37jnSe_hEgYn_exuESKUT0qnv5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afyzrt8Mot3drKtNrn1nibb4QBAK0CmkYVAOprrqcD5oag&oe=69C136ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stratum Creation Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1703806481, "lastRevision": {"nodes": [{"id": "24189087377372625", "release_type": "SCHEDULED", "administration_
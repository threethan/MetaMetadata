m", "science", "contentsda"], "long_description": "1. Place the gravel, sand, and soil in the square box in this order, then use a scraper to even out the surface. \n2. Add water to make it more cohesive.\n3. Open the oven door and place one of the two strata models in the oven. \n4. Touch the oven door and bake the strata.\n5. put on the gloves on the oven rack, then remove the model from the oven and place it in a mold\n6. place your hand on the tool handle and turn it.\nAfter activation, turn the handle and observe the earthquake phenomenon.\nLearn that the Earth's interior is in constant motion, releasing enormous amounts of energy to the surface, which causes natural phenomena such as earthquakes and volcanoes to occur on the Earth's surface.", "short_description": "Delve into the geological process of stratum formation. This visually engaging experiment simulates the natural process of layer formation, offering insights into sedimentary rock formation and the history of Earth's layers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
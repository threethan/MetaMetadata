content-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftnv6KvCAEDSJRHAiZjqapNocJrm2PJ-2RsKUSq-QUFHQ&oe=69A835E9"}, {"file_name": "au.com.raoc.horrhosp-20220617-084641.png", "id": "374507058082869", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974829_374507061416202_735054533050890679_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjeC_ugwu7sQ7kNvwGMX_BH&_nc_oc=AdnExC8NB_y5K_PkwBxwyZ4pD_sboxa4edWtdJqOD4fYKkepHqMf6fRZi8DVv0HKEmc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftDT-mUPFNWtoP3-wKtDx5VzXka8gBlHi3bt0bGl91Onw&oe=69A83789"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "au.com.raoc.horrhosp-20220617-084803-l.png", "id": "354598660075738", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_354598663409071_8835915927340157358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWv4dID2p1oQ7kNvwFXP0-c&_nc_oc=AdkZBBhiKwmnjxyRzGRBRMp45A1j6a1JNgxrUOP6e3XUvoG8c7qN1rdfK_TS2_Z8cEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvYt2tuTLTj9Z7yK1GYAOZUMNAcl80it3EkwhkZtu9V6Q&oe=69A82D53"}, "display_name": "Paranormal Inspector", "keywords": [], "long_description": " As Inspector Franklin, a rookie police detective, explore the mystery behind Prichard State Hospital where a team of student researchers of the paranormal have gone missing while studying hauntings at the sanitarium in a small, spooky New England town.\n\nWhat looks like an ordinary missing person case will turn out to be anything but as you look for evidence, explore the haunted hallways and come face-to-face with the ghostly presence haunting the cursed hospital. Can you solve the mystery behind the missing students and uncover the troubled past of the hospital before it\u2019s too late?\n\nThe game is free, but please support me by donating via  https://www.paypal.com/paypalme/dreamchallenger. Thank you.", "short_description": "A story-driven psychological horror game. "}]}, "developer_name": "Dream Challenger ", "developer_privacy
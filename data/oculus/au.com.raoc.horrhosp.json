y8HNikeeW_eRI9H1g&oe=6A69E8B7"}, {"file_name": "au.com.raoc3.png", "id": "1265378725463206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_1265378728796539_4325711946149818944_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWgMH9Yrd1kQ7kNvwE9Qhw5&_nc_oc=AdouzhEG9SG5cmlnvy8M9KRBqRD8zHesKckJozi2V2qR72SyVi0Z4N35ZOhciMcd1AA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARLha40tojoTECLeKswOxJdPeNu6BbneNvvqMsrIjEmg&oe=6A69EBE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "au.com.raoc.horrhosp-20220617-084803-l.png", "id": "354598660075738", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031454_354598663409071_8835915927340157358_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pDDzNEq_ZwQ7kNvwEbYk9z&_nc_oc=AdpZxBC5H-p9prNlf5DVrQPCxkS4z9N11yHVJSXHk-QbxmL3Dobwde8UkqCM0KN9D3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKdbvjhgs0nax-zpOq1pGV_TDXaEwGUNIDXHsgnarnIg&oe=6A69F9D3"}, "display_name": "Paranormal Inspector", "keywords": ["horror", "escape", "solving", "ghost", "haunted"], "long_description": "A story-driven psychological VR horror experience.\nStep into the role of Inspector Franklin, a rookie detective assigned to investigate a series of chilling paranormal cases.\n\nExplore the cursed halls of Prichard State Hospital, survive the oppressive darkness of a haunted prison, and uncover the truth behind the Seven School Mysteries. Each location filled with unsettling encounters, environmental storytelling, and puzzle-driven progression.\n\nBlending escape-room mechanics with an immersive ghost-house experience, the game challenges your courage, perception, and sanity. Every case reveals fragments of a larger mystery\u2026 and more locations are coming.\n\nFree Maps:\n1. Prichard State Hospital\n2. Haunted prison\n3. Seven School Mysteries\n\nLanguage Support:\nEnglish, Chinese, Japanese, French, Spanish", "short_description": "A story-driven psychological VR horror experience where players uncover the dark mysteries of Prichard State Hospital, a cursed school haunted by seven ghostly legends, and a terrifying abandoned prison. Blending escape-room puzzles with immersive ghost-house exploration, the game challenges your courage, logic, and sanity. "}, {"images": {"nodes": []}, "id": "896299843023136", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u8d85\u5e38\u73fe\u8c61\u691c\u67fb\u5b98", "keywords": ["\u30db\u30e9\u30fc", "\u8131\u51fa", "\u89e3\u6c7a", "\u5e7d\u970a", "\u5e7d\u970a\u306b\u60a9\u307e\u3055\u308c\u308b"], "long_description": "\u3042\u306a\u305f\u306f\u65b0\u4eba\u5211\u4e8b\u306e\u30d5\u30e9\u30f3\u30af\u30ea\u30f3\u8b66\u90e8\u3068\u3057\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u8d85\u5e38\u73fe\u8c61\u3092\u89e3\u6c7a\u3059\u308b\u4efb\u52d9\u3092\u4e0e\u3048\u3089\u308c\u307e\u3059\u3002\n\n\u30b1\u30fc\u30b9 1: \u30d7\u30ea\u30c1\u30e3\u30fc\u30c9\u5dde\u7acb\u75c5\u9662\n\u30d7\u30ea\u30c1\u30e3\u30fc\u30c9\u5dde\u7acb\u75c5\u9662\u306e\u80cc\u5f8c\u306b\u3042\u308b\u8b0e\u3092\u63a2\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u3053\u306e\u75c5\u9662\u3067\u306f\u3001\u8d85\u5e38\u73fe\u8c61\u306e\u7814\u7a76\u8005\u5b66\u751f\u30c1\u30fc\u30e0\u304c\u3001\u30cb\u30e5\u30fc\u30a4\u30f3\u30b0\u30e9\u30f3\u30c9\u306e\u5c0f\u3055\u306a\u4e0d\u6c17\u5473\u306a\u753a\u306e\u7642\u990a\u6240\u3067\u5e7d\u970a\u306e\u7814\u7a76\u4e2d\u306b\u884c\u65b9\u4e0d\u660e\u306b\u306a\u308a\u307e\u3057\u305f\u3002\n\n\u666e\u901a\u306e\u5931\u8e2a\u4e8b\u4ef6\u306e\u3088\u3046\u306b\u898b\u3048\u3066\u3082\u3001\u7d50\u5c40\u306f\u4f55\u3067\u3082\u3042\u308a\u3067\u3059\u304c\u3001\u8a3c\u62e0\u3092\u63a2\u3057\u305f\u308a\u3001\u5e7d\u970a\u306e\u51fa\u308b\u5eca\u4e0b\u3092\u63a2\u7d22\u3057\u305f\u308a\u3059\u308b\u3068\u3001\u546a\u308f\u308c\u305f\u75c5\u9662\u306b\u53d6\u308a\u6191\u3044\u3066\u3044\u308b\u5e7d\u970a\u306e\u3088\u3046\u306a\u5b58\
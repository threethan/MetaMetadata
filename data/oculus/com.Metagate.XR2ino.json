7_8473707674809367829_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufMcw-2PtmYQ7kNvwE5eATM&_nc_oc=AdqTg9-bZrAlEG_-Sd6mAdBZWnyT21ravyYmwvokdR5h5Y7lS2PtUz39YKO-0wUgpXk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtkPpXozCZq_SZd-N5G7Dq0IcUrSz-9nawnZody5quYA&oe=6AFF17AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "597991112624916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_597991115958249_7285348385004023158_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYbWL3Lc5dUQ7kNvwH0dubZ&_nc_oc=AdqNV-uzzoBa5_t1APdWgqAPV6_GgKzt8vrWlUGEKDeo-b2_KVZmo-XBwxwF6erf0OA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwSsauazj__wlpvTEKzDIbrtYh5CtFzifiFg1FQisALg&oe=6AFF23BD"}, "display_name": "XR2ino", "keywords": ["Arduino", "Mixed", "IOT", "SmartHome"], "long_description": "XR2ino is a Mixed Reality app, designed to  visualize weather data in real time and to bring your sensor data directly into the headset via Bluetooth connection. Explore a new level of interaction by customizing the app with your preferred sensors and editing the provided Arduino code. Tailor XR2ino to your needs, making every experience unique and engaging.", "short_description": "XR2ino is designed to visualize weather data in real time.\nYou can also connect your Arduino BLE device to costomize your Mixed Reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-xr2ino", "developer_terms_of_service_url": null, "publisher_name": "Meta Dashboard", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}, {"id": "393222478507326"}],
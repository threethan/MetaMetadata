7_8473707674809367829_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvt279yVEegQ7kNvwFVcuAN&_nc_oc=Adozjo4rYkFc8XBY61ERUC13VMUty08cpruSfwDaqMQEK3VgZOs-01CjeCrUIoPixzQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0xSFlIk6qLlV2aDnyWjamMA_8A6oyLxn_cj2A2JGWEg&oe=6B09A3AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "597991112624916", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203626_597991115958249_7285348385004023158_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0X0CuQMXVQQ7kNvwG44EA2&_nc_oc=AdoxsoArxbPaX88pTUQbe_h0ZI59yQn4_fyOXYAtJpu85KFXh-E-utZu_de1o7llqeM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh1k0jo7J0Dxd6sSxsVGlDgesoqGXfvY1CqeXbR3aJWw&oe=6B09AFBD"}, "display_name": "XR2ino", "keywords": ["Arduino", "Mixed", "IOT", "SmartHome"], "long_description": "XR2ino is a Mixed Reality app, designed to  visualize weather data in real time and to bring your sensor data directly into the headset via Bluetooth connection. Explore a new level of interaction by customizing the app with your preferred sensors and editing the provided Arduino code. Tailor XR2ino to your needs, making every experience unique and engaging.", "short_description": "XR2ino is designed to visualize weather data in real time.\nYou can also connect your Arduino BLE device to costomize your Mixed Reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-xr2ino", "developer_terms_of_service_url": null, "publisher_name": "Meta Dashboard", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}, {"id": "393222478507326"}],
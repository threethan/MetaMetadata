7_8473707674809367829_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jvt279yVEegQ7kNvwFdq4Fz&_nc_oc=Adp7EQYy9lkJMKn0HVDt0xvKibrCxOWDBNUuGNIF5Rzc5j1OYtyyIfiCatFMeM7XDEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzIyuJe7Au6BBNgHjIOuX84ZGc91JUAvx3UPpV5cmqOQ&oe=6B0C7EEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "597991112624916", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203626_597991115958249_7285348385004023158_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0X0CuQMXVQQ7kNvwHXj9dE&_nc_oc=AdoupGrl_S1VU4kehq9FNND1ZcpVBQlAhdyx5cEVrJsnQmzaZV01sBZBFN8iualaBXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpfmmT4rl-X5swWv58wXlr-I8l3WNf6QevTzS6LBMzDA&oe=6B0C52BD"}, "display_name": "XR2ino", "keywords": ["Arduino", "Mixed", "IOT", "SmartHome"], "long_description": "XR2ino is a Mixed Reality app, designed to  visualize weather data in real time and to bring your sensor data directly into the headset via Bluetooth connection. Explore a new level of interaction by customizing the app with your preferred sensors and editing the provided Arduino code. Tailor XR2ino to your needs, making every experience unique and engaging.", "short_description": "XR2ino is designed to visualize weather data in real time.\nYou can also connect your Arduino BLE device to costomize your Mixed Reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://discover.themetagate.it/pages/policy-privacy-xr2ino", "developer_terms_of_service_url": null, "publisher_name": "Meta Dashboard", "support_website_url": null, "website_url": "https://discover.themetagate.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}, {"id": "393222478507326"}],
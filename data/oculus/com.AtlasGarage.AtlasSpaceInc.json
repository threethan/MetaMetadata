perience across the platforms.", "short_description": "Atlas Space offers a multiplayer experience in a creative and engaging setting, blending adventure with social interaction across VR, Web, Mobile and Console."}]}, "developer_name": null, "developer_privacy_policy_url": "https://atlas.space/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GarageAtlas", "support_website_url": null, "website_url": "https://atlas.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7672936419385320"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "962103482207028"}]}, "baseline_offer": {"id": "962103482207028"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1710857700, "status": "PUBLISHED", "id": "962103482207028"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9805418842803723", "version": "0.10"}, "id": "423949216760524", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7600607939951502", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9805418842803723"}, "release_status": "RELEASED"}, "binary_release_channels": {"
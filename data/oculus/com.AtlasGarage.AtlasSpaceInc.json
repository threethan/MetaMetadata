ng adventure with social interaction across VR, Web, Mobile and Console.\n\nAtlas Space merges immersive virtual worlds with rich multiplayer experiences by offering players an unparalleled level of customization, community building, and interactive exploration. Atlas Space not only allows players to create and customize their own spaces but also to engage in meaningful social interactions, adventures, and in-game economy culture within a vast, ever-evolving universe.\n\nThe blend of creativity, interaction, and personal expression within a shared digital space is what makes Atlas Space a compelling experience across the platforms.", "short_description": "Atlas Space offers a multiplayer experience in a creative and engaging setting, blending adventure with social interaction across VR, Web, Mobile and Console."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hub.atlas.space/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "GarageAtlas", "support_website_url": null, "website_url": "https://atlas.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9823403247671949"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974863_369360212559267_3546005483947280709_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75umQko4gFQQ7kNvwHePrS
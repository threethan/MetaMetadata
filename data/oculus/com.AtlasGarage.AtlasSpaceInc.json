038966_3130478979094307821_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iY_G2wo_rYgQ7kNvwFMQt6m&_nc_oc=Ado4d-hWxfajz9Ecs2-yutrby4TspWq79yYOOAPWUnuFjGEtvDWfaseCaKfkapE5zeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYds8Y5V093r-OVuCvP2UIHtBH6YHU6aGqNUlo8jBgLQ&oe=6B006CD6"}, "display_name": "Atlas Space", "keywords": ["AtlasSpace", "Atlas", "Metaverse"], "long_description": "Atlas Space offers a multiplayer experience in a creative and engaging setting, blending adventure with social interaction across VR, Web, Mobile and Console.\n\nAtlas Space merges immersive virtual worlds with rich multiplayer experiences by offering players an unparalleled level of customization, community building, and interactive exploration. Atlas Space not only allows players to create and customize their own spaces but also to engage in meaningful social interactions, adventures, and in-game economy culture within a vast, ever-evolving universe.\n\nThe blend of creativity, interaction, and personal expression within a shared digital space is what makes Atlas Space a compelling experience across the platforms.", "short_description": "Atlas Space offers a multiplayer experience in a creative and engaging setting, blending adventure with social interaction across VR, Web, Mobile and Console."}]}, "developer_name": null, "developer_privacy_policy_url": "https://hub.atlas.space/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "GarageAtlas", "support_website_url": null, "website_url": "https://atlas.space/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommend
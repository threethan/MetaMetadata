NvwFwt5zQ&_nc_oc=Adruh2RguAUkyeIjEDx7Ax-qnsO0z45mWTcN3hfgHyC0V9fJ1cRMHv1iEmfYCVK9uGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_4AM5ZjJt1gsoGhISh-N1YYOMTyhtqFpzEg8Y13Y9Ig&oe=6B0F064B"}, {"file_name": "screenshot_05_routes_and_modes_vr_2560x1440.png", "id": "1813034930025446", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1813034933358779_7744138741544969469_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDHdjqoFbkkQ7kNvwGzPHg0&_nc_oc=AdoTdbgRWz0r66GbA1COIg77SriwK3Dm7RN9B4edvC3X6OgKxBSJ6IfCzJ-hB5esayU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVbYxVh8Z2oFngdqP0_6wkNXfXH2GfKjyD-0868h81T7Q&oe=6B0EED21"}, {"file_name": "alt_screenshot_06_timed_challenge_gates_hud_2560x1440.png", "id": "1871563060647192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_1871563063980525_7083841823601757806_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMHyejF0BRAQ7kNvwHfX98d&_nc_oc=Adq3ndIUrpNzAC2n4WZqY1ce6onFXt_vJesPLO9u2SgDdmRLJTOaa5NWZm6QifX2dX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVT-3w2wttiY16t61g8o2MfPaLdIw6shWJyzCUfRBJ2Ag&oe=6B0EF959"}, {"file_name": "alt_screenshot_08_grand_scenic_snow_corridor_2560x1440.png", "id": "1116723867646907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596068480_1116723870980240_3770006312341867799_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sbiQvuuYb8Q7kNvwF9oyPp&_nc_oc=AdpoE2FI-vf8GcwSJm4aO8kMomzjI263ZYpS1VbZvGeMkUEZLnNPNk3nwrM6_3HotRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxZ1v3y_elqXQUJNjmPS2Raj30AFBuxC5VDaUvPm6QGA&oe=6B0F0AAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Forest Drive", "keywords": ["driving", "racing", "sim", "G29", "scenic"], "long_description": "# The road is the destination.\n\nForest Drive brings scenic driving to standalone virtual reality. Step inside a detailed SUV cockpit and experience winding forest roads, dramatic hills, changing weather, and the simple pleasure of driving.\n\n# THREE ENVIRONMENTS INCLUDED\n\nAutumn Forest: Golden foliage, dense woodland, and leaf-covered roads.\n\nForest Circuit: Winding forest roads, rocky hillsides, and elevation changes.\n\nGrand Scenic Route: Mountain scenery, golden skies, and snowy conditions.\n\n# DRIVE YOUR WAY\n\nExplore freely with no timers or objectives.\n\nTake on timed challenges, earn medals, and beat personal records.\n\nExperience responsive vehicle physics, authentic road sounds, rain, fog, and varied surfaces.\n\nLook naturally around the cockpit with VR head tracking.\n\n# STEERING WHEEL SUPPORT\nEnjoy compatible Logitech G29 steering-wheel control on standalone Quest hardware. A compatible wired setup is required; accessories are sold separately.\n\n# ONE PURCHASE. THREE COMPLETE MAPS.\nAll three original environments are included permanently. Additional map expansions may be offered separately.\n\n**Start the engine. Take the scenic route.**", "short_description": "Escape the ordinary road. Explore three beautiful driving environments in standalone VR, from golden autumn forests to winding mountain routes. Experience an immersive SUV cockpit, changing weather, realistic road handling, timed challenges, and Logitech G29 steering-wheel support. Drive at your own pace or chase your personal best."}]}, "developer_name": null, "developer_privacy_policy_url": "https://forest-drive.nohtv.shop/privacy", "developer_terms_of_service_url": "https://forest-drive.nohtv.shop/terms", "publisher_name": "NahomPromotion", "support_website_url": "https://forest-drive.nohtv.shop/support", "website_url": "https://forest-drive.nohtv.shop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription
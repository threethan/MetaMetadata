2013 experiences that focus on an actual person, sharing their story through VR. We also share a selection of our \u2018A Gorilla Travels\u2019 episodes, in which we take viewers all over the globe.", "short_description": "VR Gorilla is an award-winning virtual reality production studio, based in Amsterdam and brings you a selection of their original content from across the globe."}]}, "developer_name": "Headjack", "developer_privacy_policy_url": "https://www.vr-gorilla.com/vr-gorilla-app/", "developer_terms_of_service_url": "https://www.vr-gorilla.com/vr-gorilla-app/", "publisher_name": "VR Gorilla", "support_website_url": "https://www.vr-gorilla.com/vr-gorilla-app/", "website_url": "https://www.vr-gorilla.com/vr-gorilla-app/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1094382544731637"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031443_411846029508016_3800588037352587264_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dG0rZvgUnXcQ7kNvwGvIw8v&_nc_oc=AdmlBPRy0VyEyQeqE4X4Etnx2d43PdslLsTj39Dj7SER6IXZ5EyUdFo7lKigifJVGkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft_8tshfVSd0-f6rereE2B6OTAxZZ-fMPkQRhbBe2a1tQ&oe=699D934B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Gorilla", "platform": "ANDROID", "context_category": null, "context_topics": [
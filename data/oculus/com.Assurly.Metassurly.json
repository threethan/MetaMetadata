_dpd_oozvd7Fk2ZIUvOVgebT1_wX_EBfWNNo8EyWeMQAFQcw5SULVQf-JUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh-4L8uWhzk7BlLEWO3Ag7asbD7iy8HTSusEfxeIMY_A&oe=6AE0AA71"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFTYb1hwruIQ7kNvwHHOe_U&_nc_oc=AdrRXyVPWKujQUD2GQ6ORLqbaGy4Kvl4o2v-eNRt2TLuFtck4j9F9A0rxtD2vqvs3fs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwcnCuvElHEp8fOG9l-JB-mpj-DZSb5D54TCrb9mAZZg&oe=6AE0C3D4"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPIbu_1yxMEQ7kNvwEXqLuA&_nc_oc=AdpHcJVd6A1kLv6CzVC6w__GOz7VjeX6qPbNUQqwhankitSnSA4cRrlBToDhphV2oWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGycvsG1zLZEOwW53F7T-ao2Z4h_YRmw_9KESqXvLI1w&oe=6AE0A39B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJrHzvq84HkQ7kNvwGCZQRP&_nc_oc=AdoyB8PHb-SO1lVXW_jI_nvW6J7TEbXAH2ofBb8l-YzQ5PGwfPDHJiaGLqv7wpGkO9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoTT_oQENDPMcxMbffRvKdrkRUAPa6uZZtETkjlB9LSw&oe=6AE0B537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGU7CauulMIQ7kNvwHebYji&_nc_oc=AdorTV_qT94Ejx-HA4dl_dgTVVGDRNkL_4JMR6AAyUjSxn84vzBWf5CHXq-jBeWWHyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhtYzzVc_o5N8Mb6wjJUuFPhJHNP1NcZXbTaLFxUwYUg&oe=6AE0C143"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
BS1qde_aJ43mQCUSiHRiL2ud9QkOrWxpEFBW4xNgDzouQww5PgQC09kZdBA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMv6IF11-p13ez5mZ_UkZM_blTW-FsmDiLJP_gnyoE3Q&oe=6AE34D71"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFTYb1hwruIQ7kNvwGes51X&_nc_oc=AdopdOi4-buavqvUKsoVr8xfMn9mb-72UJjYIujk9H_kCPV_9aELQ9wmO51NP3ZgT3g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6XGEmT5qri9UsBUQJRCYVXc1kORdsuCtAa5gbli6-Xw&oe=6AE366D4"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPIbu_1yxMEQ7kNvwGeqojY&_nc_oc=Adp2C3pa0rDRjmaLsfUJrLydkJcwG6vNI2aFyHbtjc341w0vq5MgvPg36PgDD3g1W5I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTRJXYNjyHRlpRdlk3ZzVxKLRFD6vWihRB4bW-cRZTCg&oe=6AE3469B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CW5mkl5DE-MQ7kNvwEcZGAU&_nc_oc=AdoW_DsEpQr8nlYXTK98pw9zSfjrVlNbm48lS4sQ4wR-552qGRLZCnQfdTEgnJXxatg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWLwRzAUXpfQow2TRgJZMnN0OONnRJTpXpqQIsMaU7Vg&oe=6AE35837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK1CyW1IU4IQ7kNvwE5aVP6&_nc_oc=AdrSFBRAc-GNUz4FMwT5YfEG6ZNY4hntgeBYlLAkKARyHd-6sgy83uO_t34mXusvKr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0BM2HERcSbEVT5jC6C1sNTsLE1Ga5Ev4qXW_rt-RSmg&oe=6AE36443"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
_noizi8rK3NbWincja-gzPav87z-1EEZhocEbbi1Y9Au0rjrp824QnluX1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZGwFaWAyk14hLxo9v4e-4sTA5IPFAYY9C2NUvOtMqrg&oe=6A6DF7F1"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmRgeUWKCKcQ7kNvwFRn5zt&_nc_oc=AdreZn4UaLvU9OQNweGOMJNg-iC5ZB94DEkJDF95igMteycLEAM1FMSntUAMfGjPZUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHn1yHXMzoFsIbVZeOqTCWQJ8mSisamSvOHUQHosr7uA&oe=6A6DD914"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I-C--B_Sv0Q7kNvwGJXVrH&_nc_oc=Adr4aNquH1vyiY-p_-8W_vZWl7QFhog-Z0Kv8FfcuoGEPrCSv8gVVhcztgOFNNhmUYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9SnBneUVv-n-EM1XI4y1Iuzr25Y-hKqzvk0vOdtYKYg&oe=6A6DF11B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCLBPOKKPzUQ7kNvwEduoVO&_nc_oc=AdrzhiIYOEhI9oxB6MuwLYBPlQSL31v0B2iR7ifjz-WRFXzsZkm7h0DjRFfs-UUbn4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDau1-kQVSsXpNxN9NRy6vQqtmKzdeOSwDX611ay1pcQ&oe=6A6E02B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seDLOSiRco0Q7kNvwHsv36K&_nc_oc=AdraVsv9Y5pq2Qgg2QW7-yVIX_S2frbhPUWr1LlcsLpbarXujDw2VVCT2QSo42DMQLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR5494vVDG3UlnXGQJaepo06aSv_C4E-mqdl37R07aSA&oe=6A6DD683"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
-vTcHG8cus527y2LGUjAT26nhO4oxrIHm_w9uNoKfpcFeYvAB1c72W7G3o4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI8ELheWWc9QjcAvkqoPua-GdO2mJYL2MJPPTVFkB9uw&oe=6AE741F1"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNWuw9Uqej0Q7kNvwGLme0o&_nc_oc=AdpxNDFmEOtErRJ3S3ZjmDTnXEHXIy-9lxfBrshqUPAvYTLpl2gIgVONFYvFyyMtg7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtQFIVd6MdJNmXsLxQIjuK_NgIdNiMzWovK0NO-SO4lw&oe=6AE75B54"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K793Rjb1B6QQ7kNvwHdpBkx&_nc_oc=Adrbe-rOoL3MhgCjToWXySIh7cq8T5cIFu3upUBw4AfzmP4rtTGIVvsElxkGi6Mjsps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5QTxYPEXViwvzexzpI5PUYqO9cm8JwZ9-NXoScB84nQ&oe=6AE73B1B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TukjVusaAJkQ7kNvwGQLh93&_nc_oc=Adp4Wf-cCjmwXe8EVuC5XcQw5Ocr7Y5evhtESraFPl2Nkivrlc2ZTznFZvfcJ5mEEmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdUY9bscawuL6O5sb3t7LAxDWYdmGxJ_AhGEGAIpYgYw&oe=6AE74CB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBSC6he_9XMQ7kNvwHCf0ts&_nc_oc=AdpW-GGWQEK3jNoKklKaLrV3z4rHJIbGow46Tnc2T52bBN1UnKVPqypCPdpl6Q2ep-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYEcwyy5uLjSZ4WIUU98yyhJ8BtvmTpAxCoX4pZoD0bw&oe=6AE758C3"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
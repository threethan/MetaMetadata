y2KFHMsXTBHI1GljzjA7fsEU5lKRdGUIZqw56IsmvBa1EUkoQuwZm70D0O4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Gm5ykcHo_OfqK83jSK3E96dC5dXdBlg99INKGOwt8w&oe=6AF713F1"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7E-0r1SWxR8Q7kNvwFycsVk&_nc_oc=Ado6ZzEh8F2i7LWusrhSdYwtCMUornXgkeBVIfKIWRhdOt2-fLpJQhBwpPWTcnCq6_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx06_dzPrMhei6yhun1RT8S_ctnYjTNT0Usp4ATefFAA&oe=6AF72D54"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdXN3A7Pf0sQ7kNvwHNMVCo&_nc_oc=AdqdbkUwJvngBozemkHHz5EPFhPYYqhhM8-DiooVH0nQNjlsMkpoByJO2L3A32sECKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnm_jj58OnVUltqUr-vR8PLvzHLlCy7_tTX6AVy3coxg&oe=6AF7455B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUsQ5RlFhBAQ7kNvwF07ViU&_nc_oc=Adpbg9xf1CZWshsS3HvlwHRaxiZsURXnP_4YwXJo4O_EB0d8ErTbxx6dBtpjXkOKTy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7zVb-QB-sUIbqphObjIN5ANjpM4rikm7j8o6LBIV13w&oe=6AF71EB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TKj_mqdekEQ7kNvwF3Q0GK&_nc_oc=AdrwuaYkXNFn5dz22VP95d01pTUMJG_40glQRRahPJr3uV8w4O3mQ6H-KSD8jLVFTtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRvBtGkq2gJUUAQS0ulTRUrw4Vh_deH0yfmHzG5WhZOQ&oe=6AF72AC3"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
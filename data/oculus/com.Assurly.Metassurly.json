-Rt5NRetDTmPpfYANANUnEOquhs3lLvd0ST9U4_bWMdMsqzZrA3nSc1e974&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4N3rKkha6TjPQ2yRibMtQRDLIc0QrNj4XraH_cfxXJg&oe=6AE1FBF1"}, {"file_name": "screen_3.png", "id": "286815796806973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031372_286815800140306_4122575416401999738_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFTYb1hwruIQ7kNvwFgMZam&_nc_oc=Adre2XViExGukkSNodkNq4oL-yiHGVYpU8CYI5ACGI0U2oPpinX3h-voic_zIKd_BM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqohKloLQ5ycA85wPbNe--ZghEmCucG9w4COyVUM0Mhg&oe=6AE21554"}, {"file_name": "screen_5.png", "id": "391321312495719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035365_391321315829052_6032633440067567343_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPIbu_1yxMEQ7kNvwEc3yBQ&_nc_oc=Ado0QoPiGZYhNV6Lf80P7VhT8SnGxcQkZ7MJK8cSZN3qEBBhSBPS2lEAAHuVgoOfLrM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe0Zg4uq1Q6oO5xl6wLN1yW4kfMFQceF8-YuZIfOC_-A&oe=6AE1F51B"}, {"file_name": "screen_4.png", "id": "5526308934064469", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982619_5526308937397802_9177602120052446646_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJrHzvq84HkQ7kNvwGb0rpx&_nc_oc=AdqTbQm4B2y7ApVXs9Vl06G3JSOGmUAOa4v5k8QvBaB8RjokpaPOe1IRZ0sUgr2YDww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg8ddZp_i0q_WsuuaxHl010rN3eMcpprQ2JG79YwL3ag&oe=6AE206B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape 2.png", "id": "2648616211948607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031610_2648616215281940_1004102822840751124_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGU7CauulMIQ7kNvwH94MrO&_nc_oc=AdrtT3Wq25ygaNUFY0_GO88-fg56bUyNcfFp-bWHxMIGG1INTuWvz-cZM692jvtKYZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1QYbvkHd7UGr6yx63A_uSi3Nn9s53nZtuM8yClBHD6w&oe=6AE212C3"}, "display_name": "Assurly", "keywords": [], "long_description": "\u2602\ufe0f Soyez mieux couvert\nB\u00e9n\u00e9ficiez d'une couverture sur 100% des garanties d'assurance de pr\u00eat immobilier.\n\n\ud83d\udcb8 Payez moins cher\nSimulez votre devis en quelques minutes gratuitement et sans engagement. Faites des milliers d'euros d'\u00e9conomies de fa\u00e7on rapide sur votre assurance de pr\u00eat immobilier avec une tarification claire et un prix juste.\n\n\u23f0 Gagnez du temps\nNotre app est full-canap\u2019 : Vous souscrivez depuis chez vous et pour le reste, on s'occupe de toutes les d\u00e9marches administratives barbantes pour changer votre assurance. C\u2019est simple et rapide.\n\n\ud83d\udc4b Soyez accompagn\u00e9\nNotre \u00e9quipe est \u00e0 votre disposition pour vous accompagner tout au long du devis et du contrat !\n\n\u2600\ufe0f La transparence\nAvec nous, nos clients ont v\u00e9ritablement toutes les cl\u00e9s de lecture de leur contrat et de leur tarif. Pas de mauvaise surprise, tout est clair.\n\n\ud83d\udd12 La s\u00e9curit\u00e9\nNous avons \u00e0 c\u0153ur de respecter la vie priv\u00e9e de nos (futurs) clients.", "short_description": "Assurly vous permet de reprendre le pouvoir sur votre assurance de pr\u00eat immobilier."}]}, "developer_name": "Assurly", "developer_privacy_policy_url": "http://privacy.assurly.com/", "developer_terms_of_service_url": null, "publisher_name": "Assurly", "support_website_url": "http://helpcenter.assurly.com/", "website_url": "https://assurly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported
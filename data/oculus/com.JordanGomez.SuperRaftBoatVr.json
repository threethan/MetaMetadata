0_4519895238022522_4527552440629370005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYCCX_LwEqgQ7kNvwEQOxMd&_nc_oc=Adp_Vrc5xbrzgdjMS5JYjSi0ol3o8tH1aMtKBm0CR0jZ34tAc05nvE3kpaN2m97eQ54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4iuRc6BlLDf1w8s2G3hJTh1kN48kdbJlaTqYn13A7lg&oe=6B0C647D"}, "display_name": "Super Raft Boat VR", "keywords": [], "long_description": "The world has been flooded, and all you have is your trusty revolver and a small raft. All you can do is sail and hope to survive the onslaught of sea creatures trying to eat you. Traverse Clear Skies to the Sea of the Damned, and try your best to reach the Final Island!\n\nA VR adaptation of Shattered Journal Games' Super Raft Boat.", "short_description": "A VR rogue-lite shooter where you must survive waves of sea creatures while building your Super Raft Boat. Can you reach the Final Island?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://shatteredjournalgames.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Shattered Journal Games", "support_website_url": "https://shatteredjournalgames.com/contact.html", "website_url": "https://shatteredjournalgames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1973854292821810"}, "review_messages": []}]}, "cover_square_image": {"uri
gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9raqDVj0d8Q7kNvwHWCF9i&_nc_oc=Adoxsuoir9HqWMSx6H3qnwD4zZrfsYmm4G2K26deJJMsOeuVftS9VLp987rC0BV7Ya0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQKcP2zPo_lh2Ry0oQPuLi_SQnmpaFKt1o6bVwp_2Kwg&oe=6AFF08FE"}, {"file_name": "05_planet_grid.png", "id": "972617445606509", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623345_972617448939842_1949233914579194807_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeKyP0KgK-IQ7kNvwESh8br&_nc_oc=AdqC_aJN8hk6uRJRM9ZsQXuQ8rQ6cHYMRHm7a2kkwH-zzGqPOEGmzUlRIJ6mUyN6CMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGhj7pK60njT1zGxsrM7jJwJ0BRowC1hM8slUJzPljAg&oe=6AFF1B5A"}, {"file_name": "02_arena_planet_station.png", "id": "1363260129044685", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_1363260132378018_5148788425998146621_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAsvjwrmRyEQ7kNvwGkK6Hr&_nc_oc=AdpYQkgCZbzZN4V64exD_jYLu0JPuZzNNGiv3-yzSmnoICFXLakGJ0TeB_bfIX4PPNw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThu9zL5GgoWu_jBgIi9WPeHw2w8XdT0_b26K41nD8rdw&oe=6AFF1A20"}, {"file_name": "03_arena_combat.png", "id": "1883132379596117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622919_1883132382929450_6502235533208174042_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FirJIFbEoUQ7kNvwG-8koC&_nc_oc=Adqz2Q45RsebYknlR9aXTB2016xwIecrJTWEafX3mZXqE3JaAFtF_8EuDb1ItK40x6I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREvvF08_4e5ycZ5Abqk1Mdg0jBrfZuMcEXQw2Dex2bqw&oe=6AFF0B20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Void Gunner VR", "keywords": ["shooter", "action", "arcade", "survival", "scifi"], "long_description": "VOID GUNNER drops you into a neon starfield arena with a plasma blaster in each hand. One rule: aim, blast, survive.\n\nDrone swarms close in across an endless escalation of waves. Squeeze each trigger independently to fire streaking energy bolts \u2014 dual-wield to cover two lanes, or focus fire to break the heavies. Every hand runs its own HEAT budget: fire too fast and the blaster overheats and locks until it vents, so trigger discipline matters as much as aim.\n\nChain your kills. A tight combo window multiplies your score x2, x4, x8 \u2014 keep the streak alive and it climbs fast. Let a drone breach the line and it drains your energy core; hit zero and the arena goes down.\n\nFEATURES\n- Dual-wield trigger-fire combat \u2014 a blaster on each hand, fully independent\n- Heat / overheat system rewards controlled bursts over spray-and-pray\n- Combo multiplier scoring (x2 / x4 / x8) and a global best-score chase\n- Endless escalating drone waves plus boss waves\n- Three enemy types and three difficulty tiers\n- A neon-starfield arena \u2014 iridescent planet, derelict station, cyan grid platform\n- Coins, upgrades and a shop; climb the leaderboards\n\nStanding or seated, controller-first, comfortable for short or long sessions. Aim. Blast. Survive.", "short_description": "Grip a plasma blaster in each hand and squeeze the trigger \u2014 fire energy bolts at relentless drone swarms across a neon starfield arena. Dual-wield, beat the overheat, chain combos for huge scores, and survive endless escalating waves. Aim. Blast. Survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://void-gunner-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://void-gunner-vr.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
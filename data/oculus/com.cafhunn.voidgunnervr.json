gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9raqDVj0d8Q7kNvwGwubfx&_nc_oc=Adr3NsTN1xy01JFXm_RYXAb5Oq27-zYVdbN17otj0Pk-mKdYw-gz8EZy1Az4zARl1lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvmy19tVYsL09xjblwXgaaihN9mF-n7PA80CGB4QNIoA&oe=6B005A7E"}, {"file_name": "05_planet_grid.png", "id": "972617445606509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623345_972617448939842_1949233914579194807_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK839vSc7EcQ7kNvwGXJvo5&_nc_oc=AdoryX0XxzVQbQsEVrLV4XWPCG9XJUtLOVnzeNdpO6VbM1KAc3Dbj1E-db1G7pA2IXo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY3tZeaBB6hMUefdK5e_81ab3xvok9yx6mrj0Ke9RDLw&oe=6B006CDA"}, {"file_name": "02_arena_planet_station.png", "id": "1363260129044685", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1363260132378018_5148788425998146621_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Peo3Z-3UuSQQ7kNvwEWkTdu&_nc_oc=AdoeFEbHJYep9WJc4QU3A8_j0usXZq3vOSRDyID_myPIY9Z__S262PDrIBUSbArNyEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSRc2d839_W8XmEAJCw9QU0mRzNrrPuy0wTBOHkrpAhA&oe=6B006BA0"}, {"file_name": "03_arena_combat.png", "id": "1883132379596117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622919_1883132382929450_6502235533208174042_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FirJIFbEoUQ7kNvwHpkGzf&_nc_oc=Adom4dq2kGjtG5kyKb6bPCohPETUavb6Oi0A4DahrdC35-v8nkXrfQhYnDtxsmduKEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdm5eAFvcSbsQ7iOAqUu-oz--gw4v12Sht79zv5r4qww&oe=6B005CA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Void Gunner VR", "keywords": ["shooter", "action", "arcade", "survival", "scifi"], "long_description": "VOID GUNNER drops you into a neon starfield arena with a plasma blaster in each hand. One rule: aim, blast, survive.\n\nDrone swarms close in across an endless escalation of waves. Squeeze each trigger independently to fire streaking energy bolts \u2014 dual-wield to cover two lanes, or focus fire to break the heavies. Every hand runs its own HEAT budget: fire too fast and the blaster overheats and locks until it vents, so trigger discipline matters as much as aim.\n\nChain your kills. A tight combo window multiplies your score x2, x4, x8 \u2014 keep the streak alive and it climbs fast. Let a drone breach the line and it drains your energy core; hit zero and the arena goes down.\n\nFEATURES\n- Dual-wield trigger-fire combat \u2014 a blaster on each hand, fully independent\n- Heat / overheat system rewards controlled bursts over spray-and-pray\n- Combo multiplier scoring (x2 / x4 / x8) and a global best-score chase\n- Endless escalating drone waves plus boss waves\n- Three enemy types and three difficulty tiers\n- A neon-starfield arena \u2014 iridescent planet, derelict station, cyan grid platform\n- Coins, upgrades and a shop; climb the leaderboards\n\nStanding or seated, controller-first, comfortable for short or long sessions. Aim. Blast. Survive.", "short_description": "Grip a plasma blaster in each hand and squeeze the trigger \u2014 fire energy bolts at relentless drone swarms across a neon starfield arena. Dual-wield, beat the overheat, chain combos for huge scores, and survive endless escalating waves. Aim. Blast. Survive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://void-gunner-privacy.pages.dev/", "developer_terms_of_service_url": null, "publisher_name": "NVR Labs", "support_website_url": null, "website_url": "https://void-gunner-vr.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
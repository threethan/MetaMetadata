35698_8919935560186581894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR5YevD2UiQQ7kNvwGUVEBR&_nc_oc=AdrBwzBnG8f-mWHxWchzAlIyeCRbtmhpkDmsm41hX5jiS0hLz488y_d6t3VCTwfefQw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hguKIQF2dlaWdGPRPtb88e70UGYio2I_ZOguzbP3paw&oe=6A26C94A"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ECXxqMRP1sQ7kNvwGUT3ys&_nc_oc=AdrpRYFo3QiJiqwnR3lE9sqBRQpBcruDcpDLhWg1fFcWQlGRiSQBzMXMHE3nn-SUPME&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w4YX-oo8gZnuy5YsmCjVAdFdUgaAzx42LvyVerGKWuw&oe=6A26D711"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b14hfSmrp8gQ7kNvwERfL5t&_nc_oc=Adoc2C-lM0pY00XY2EVvjyYkRggWGbQNUJvD24AbMeNEvuGUr_FcmGBlCMD3m_KgGww&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zgmvniINegcbV7xYDxwJ0CL23TX9LX24FnT8LQK5A-A&oe=6A26EC49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440.png", "id": "3555336627953594", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499295901_3555336631286927_7806985747250543600_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1epnSiAuXUQ7kNvwHPV91Y&_nc_oc=AdrGRLKIFBDgkoTlokWTyRWiWay-FJzGajZREvGUYE39m7n5INrB21nCyvv9Xm3p8yc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HBDvcGiG_JIvlMD1ipFqAO8a_nIChPUMl5qoMzyo92Q&oe=6A26B91D"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "**Nightclub Simulator** is a wild VR nightlife sandbox where the party can turn into anything. Run the night your way!\n\nCustomize your avatar in Single Player, explore new Summer Heatwave decorations, and jump into multiplayer modes like Battle Royale and Infection.\n\n\ud83c\udfad Change your look with Mod NPC appearances  \n\ud83d\ude4c Meet players and party with friends  \n\ud83d\udc4f Hype the crowd or stir up trouble  \n\ud83e\udddf Infect survivors in the new Infection Mode  \n\ud83d\udd25 Fight to be the last one standing in Battle Royale  \n\ud83d\uddfa\ufe0f Explore large maps built for nonstop multiplayer action  \n\n{728124267059332}\n{1368060281817723}\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{2187813941673506}\n{1739398800021525}\n{1419888102232233}\n{1749393252644133}", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26936194989369
1894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ON2L96io-sIQ7kNvwHOp1Vi&_nc_oc=Ado1SjiiM_507Qgh-IlRqyoVi4lwcv9H4nRckNDqz1FWweC71HUd72KS9i53BgOhyPM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoAab9PtY7JcCFqvi8IyR8vozsjfzy0ri9zYK1ZQIUIg&oe=69C53A4A"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tthvGRjjyoQ7kNvwFBYf6J&_nc_oc=Adr9dvolKPt5QGdlnr76ZxHA-OYcQ1CGuNRx-6IyOrWS0nFmXSaDPdkZ1ArzvlIDhF8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdltAoW0sCNIxu0s6iRRtD_pcuNFGIMDDtDSeajqPxpA&oe=69C50FD1"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAoRxo8FdqQQ7kNvwFBy6XS&_nc_oc=AdoNFIs0Gh4qk7BfebY-POgxMifQKPTCbEajfais_7L8Rj8mmEs79MrXVEL6gvWEsbQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwX-Y0FKmRBKUiZ3UGt5qMEKWbjxJtPM0BOkA7EsLuYVg&oe=69C52509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440.png", "id": "1445272573886962", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620403_1445272577220295_6528783509036231273_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppXetARL_g0Q7kNvwGP0MFw&_nc_oc=AdpmqgWLbIwMrIhi1ZLaM8Rc1wnPzFLusGLe4CmsOwmnD1pslFr9wfzVJS0jyioZunQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz78-sRn6yJjVPlFcHEuA29ZcyxRLsewbBd_79ERjo6jg&oe=69C52CC4"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "Jump into **Nightclub Simulator** a crazy VR nightclub where you can do whatever you want, either by yourself or with friends!\n\n\ud83d\ude4c Wave to make friends  \n\ud83d\udc4f Clap to hype up dancers  \n\ud83d\ude08 Cause drama and see what happens  \n\ud83d\uddfa\ufe0f Explore fun maps or add your own  \nEvery move you make changes the party. The club is alive, and it\u2019s all up to YOU.\n\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{1347956216311961}\n{2187813941673506}\n{1739398800021525}\n{1419888102232233}\n{1749393252644133}\n\n\n", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25659439310378776"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617782_26514787508111222_3715621436796617083_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIwWNarTz3cQ7kNvwHq9tw2&_nc_oc=Adq-88
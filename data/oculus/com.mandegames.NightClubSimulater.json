_8919935560186581894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c16xAcCS65sQ7kNvwHdaed1&_nc_oc=AdoX22r_RA_3A85QS0UzBBbmHsVSpX3-eabo9pcOFbgEHp7NQzXkj4KKUz_rLMQ4AJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22KeN6JAxXYzh6N6Y7cmrTNUBKmZ-TvK_Fao0o-KmSsw&oe=69D2694A"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDsGK1l3KbUQ7kNvwGl8x3B&_nc_oc=Adr3gY2BdF0M0TRXd531QZ6h1wddGZJ8vwgQWfHXWg_WjqS2ona6ypyhQINUpk_3LGs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UscAZb2FRmlEL8A8YVidXsPKNQFAMphFx24coizXLWw&oe=69D27711"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q3vh-470C0Q7kNvwFBG2vQ&_nc_oc=AdqVMHNTTpvpma4XYfd8_mtpvh13OIYR6s2cQe4vs64fJTqY0A-bKuN5fIqlsxC9BXc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jphfK5-SG0g7KLH6Ai9LqF3jwrRsIcWSVDWCwa8KVZg&oe=69D25409"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440.png", "id": "2015066822728217", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308010_2015066826061550_4778612825961601610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIs5X52_JRsQ7kNvwFLRLvT&_nc_oc=AdqrLfd6xia8_pT6qn4Xw0c2ZXRRIseRffAhSjIbgC5kXzO2ipf-_v_cj62lppwUqek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p9z-89ncoltvEyRV0DIruoP7AvUUGl378BkC2_ll5pQ&oe=69D25336"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "Jump into **Nightclub Simulator**, a wild VR nightclub where you can do whatever you want, either by yourself or with friends!\n\n\ud83d\ude4c Meet new people and make instant party friends  \n \ud83d\udc4f Hype up dancers and control the vibe  \n \ud83d\ude08 Start drama, mess around, and see what happens  \n \ud83c\udfc6 Earn achievements as you explore every corner of the nightlife  \n \ud83d\udcd6 Experience Story Mode in multiplayer for even more chaos together  \n \ud83d\uddfa\ufe0f Explore fun maps or add your own  \n\nEvery move changes the night.\n\nThe club is alive, the crowd reacts, and the party is yours to shape.\n\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{1347956216311961}\n{2187813941673506}\n{1739398800021525}\n{1419888102232233}\n{1749393252644133}\n\n\n", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26259779133678121"}, "review_mes
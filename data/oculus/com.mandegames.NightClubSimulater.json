552784406399158_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsnobxkFiRcQ7kNvwGKwNkm&_nc_oc=AdrS6ZQxEqaNr5jz94-O1--WgfnKF_YMscGIHQsJq_tWJ3eUiR8nliBRPj-AtuLY8lU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPGj9BBnqO509jGWTwQUEWt2yF-oSFYDJ4XVVQIgvN9w&oe=69C52A06"}, {"file_name": "2022-08-07 130919.png", "id": "1090532501854226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982447_1090532505187559_139531054362447348_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu-pTtkuGFYQ7kNvwFVhwY4&_nc_oc=AdoLZI1lBarOmceDg5cmJY7LKplqsYHGiHOazP5cdpu2TOhyjmxGwkhpHLFlr7aZsFM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgCoZILVc7of819c7xn81PLqV4js3tzcOS1pGw_-UOuQ&oe=69C51CF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2022-08-07 1309191.png", "id": "448389313929129", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984471_448389317262462_4742164588630018022_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXeBiZqPtasQ7kNvwHTuWtF&_nc_oc=AdoUzskOqzjqHa9QlqZlBaz8UW9jFDQxrsG--3N_P5xVKAHqCTRddG-_s8472XzebVo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwyvmSQhOHg-rwQk_8N7kQU2rYbbIjAljt7F0PQrcs_Q&oe=69C53B12"}, "display_name": "Night Club Simulator -- DEMO", "keywords": [], "long_description": "Night Club Simulator is a high degree of freedom VR game. use fully physics based animation system to simulate NPC's behaviours and reactions, so you can interact with them like real world. the NPC have realistic AI, they will happy, anger, scare or love. their emotion will change depend on what you do. The goal of this game is open, you can provoke and fight with any people, dance and kiss with girls, but you need be careful her boy friend when you accost a girl.\n\nGuide:\nMove--left Joystick\nTurn--right Joystick\nGrab Objects--left or right Grip button\nOpen/Close Menu--left menu button or X button\n\nthere are several ways you can interact with a girl:\n1, wave your hand\n2, clap hands when a girl is dancing, the palm relative and clap\n3, shake hand, reach out one hand to a girl\n4, dancing, the palm up, reach out one hand to a girl\n5, hug and kiss, open arms, reach out double hands to a girl\n\nThis game still in development, Join Discard: https://discord.gg/rSUKqXcg3u for any suggestion.", "short_description": "seduce girls or get into fights, you can do anythings in virtual night club that you can't do in real life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "mandegames", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "483926886944664"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "886809550888656"}, {"status": "PUBLISHED", "id": "4032934180329948"}, {"status": "PUBLISHED", "id": "1572262620635755"}, {"status": "PUBLISHED", "id": "1401419604970663"}, {"status": "PUBLISHED", "id": "2060076637732170"}, {"status": "PUBLISHED", "id": "759658156402291"}, {"status": "PUBLISHED", "id": "1195131202358923"}, {"status": "PUBLISHED", "id": "1587933022110496"}, {"status": "PUBLISHED", "id": "1104087251231450"}, {"status": "PUBLISHED", "id": "877906477134028"}, {"s
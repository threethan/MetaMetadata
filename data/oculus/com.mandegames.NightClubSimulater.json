927217957835698_8919935560186581894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPFL5lliCIIQ7kNvwESXfwB&_nc_oc=AdryP2UY7yDbAlBiJCuAVjULOQ7JONzWt4_i_I0s_qybct_Q4krGUvE8yypRy97OKgQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmsf5hOWw6bjmvoIedtvThSH5nVMbbGH6zcsG1bXDb6g&oe=6AA407CA"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV0VTmBSOBoQ7kNvwFYFwkf&_nc_oc=AdrizdWdLSuypWDeZRbbuzxk1Cd2UYwDt5Upmg6KSiEQykGXMEJjdQGPZxO6xK4RmpE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmKuy13nLyZT__Zz3lqognk4Tv2gYDMCrZRskSn6GtaA&oe=6AA41591"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6kaZh3WdOQQ7kNvwEzMQiJ&_nc_oc=AdoFw51qKvSf_d_pxRjlkGWAgflbttrcB_V0jeShE_vloKpICElRIq2euzRMQcAWVdg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgyZZxT0lOlWT0jAxDeqQDt11WbH6TyqUvSVr_4-fErQ&oe=6AA3F289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440.png", "id": "1722425225745888", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620860_1722425229079221_3676899647052352736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZvgnaxOXyIQ7kNvwGuLUbs&_nc_oc=AdpKa4B7eN9rW9VNxXxz1hURDKqEwhxtzeFFftGiSc0195jMJHtsUrWiRe7HAPdtOO8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBhX9K_G72LAQrXsPDU8tHB5qiVXybDeu7SciRk_tzOA&oe=6AA3F50C"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "**Nightclub Simulator** is a wild VR nightlife sandbox where the party can turn into anything. Run the night your way!\n\nCustomize your avatar in Single Player, explore new Summer Heatwave decorations, and jump into multiplayer modes like Battle Royale and Infection.\n\n\ud83c\udfad Change your look with Mod NPC appearances  \n\ud83d\ude4c Meet players and party with friends  \n\ud83d\udc4f Hype the crowd or stir up trouble  \n\ud83e\udddf Infect survivors in the new Infection Mode  \n\ud83d\udd25 Fight to be the last one standing in Battle Royale  \n\ud83d\uddfa\ufe0f Explore large maps built for nonstop multiplayer action  \n\n{728124267059332}\n{1368060281817723}\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{2187813941673506}\n{1739398800021525}\n{1419888102232233}\n{1749393252644133}", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27
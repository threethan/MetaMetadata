89780552627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_1640089783885960_6470371422574167281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDZ-zORNuVIQ7kNvwGiXxKA&_nc_oc=AdoNkDj324Zv4cFVyDD1hcfbVH97o6w0QpMMGriEJMBqXUy9osl1ccYkpKHJ-uQ-0X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBX-HHa-U74VfayHau6ZCfHghKvaZz_vpp1OVl7X-0uw&oe=6AE7569D"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k67ulBaUot8Q7kNvwHzhx2b&_nc_oc=AdpBy4U1zXzih_6lqFHRZDzDCjNN0IDduIO43wHDiTJHLkReO1tA99l0MPIBY1KPxeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdAyaLzishJfhXr0_jgk0lLXgnH4IjijGD-EmVJ5v0sw&oe=6AE75211"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TldphgasXn8Q7kNvwEe1NG8&_nc_oc=AdqB9WfKRwz6fe13nLglvn4FWYt2H5pdRJFO5SrFiqkr1Kg2134eYS3YKu_V0VjKrro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRircn_2ZIM6fN865Bjk5ZzbonX-7GXNW5yZ1eYmGdbOw&oe=6AE76749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440_\u6545\u4e8b\u6a21\u5f0f.png", "id": "1385750347040801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307303_1385750350374134_8670844292218435250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjNo10pf8VYQ7kNvwGG6ujp&_nc_oc=Adry1TkLdAQcsALA4L30FIi_ksMAclm92gQjYWwqRNubPhaIrGB5wDj7wvz5nN_6syE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0fy3014iLdbv7phMXQ7OTupTfE66v1O3eMGRi5TxhgA&oe=6AE763F9"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "**Nightclub Simulator VR 1.0 is here!**\n\nThe biggest NCS update yet brings the new **Story Mode**, alongside the sandbox chaos, mods, and unpredictable moments that make every night different.\n\nStep into **Story Mode** and experience a new side of Nightclub Simulator, or jump back into the sandbox and run the night your own way. Customize your look, interact with NPCs, stir up trouble, and see where the night takes you.\n\n\ud83d\udcd6 Experience the new Story Mode  \n\ud83c\udfad Change your look with Mod NPC appearances  \n\ud83d\udc4f Hype the crowd or stir up trouble  \n\ud83d\udee0\ufe0f Explore mods and bring more variety into the club  \n\ud83d\ude4c Play and create chaos with friends  \n\ud83d\uddfa\ufe0f Explore different maps and make the night your own  \n\n**Version 1.0 brings the new Story Mode together with the sandbox chaos, mods, and unpredictable moments that define Nightclub Simulator VR.**\n\nFollow the story, create your own chaos, or just see where the night takes you.\n\n{1576526707585262}\n{1044743178370128}\n{1368060281817723}\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{2187813941673506}\n{1419888102232233}\n{1749393252644133}\n", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_
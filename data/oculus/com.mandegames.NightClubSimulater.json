698_8919935560186581894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ae8cF-_-E-4Q7kNvwG2ek-O&_nc_oc=Adpp1XVoKs9u4jGgA1yIkylWcPKUEynhsw8bOgdnrmhj8SDA-5mMu0iHwrhuNmG1N4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xQc3HuoKdbeTi78LShvd5hRgcUZZ9MR7vDCziA4Wn_g&oe=69F7534A"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzK56h4r6FIQ7kNvwFEZWBc&_nc_oc=AdpjaeSQ2JLjVdIj2n5O-wpd7uXbGsVSyRjciGJeZdJ0JuFQY_xJKoVC7NDqcDErc-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IOxT0AyQ4-_LYFqjggkUdJSgNuwHT9K2w0A4w3spLcw&oe=69F76111"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uel6udck47kQ7kNvwHG5gTI&_nc_oc=AdqqAbxTuxBamvMOt_x7L7_nWG3hQugtSWkkzUTKEj4ihJ5JEJ1TX8IWajCLNH--RS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jBYsnFaYWHQY8oFjGRp9pVJho_gmSt96IyczWGVHfFA&oe=69F73E09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440.png", "id": "899225726501761", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_899225733168427_2998779251537839706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AF7HJ00uFP0Q7kNvwG6jyQW&_nc_oc=Adq2qA7PmbAdmo-YaGRYLkFV_O64vU-BidwQnFYgPDEZAYI6ZAL6rIkJDJ2mq1aILxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lugUBB-y8JHX--gNU7paUxs_6YlVOfuu3RyfLqTX5Sw&oe=69F760BB"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "Jump into **Nightclub Simulator**, a wild VR nightclub where you can do whatever you want \u2014 alone, with friends, or in the brand-new **Battle Royale Mode**!\n\n\ud83d\ude4c Meet new people and make instant party friends  \n\ud83d\udc4f Hype up dancers and control the vibe  \n\ud83d\ude08 Start drama, mess around, and see what happens  \n\ud83c\udfc6 Earn achievements as you explore every corner of the nightlife  \n\ud83d\udcd6 Experience Story Mode in multiplayer for even more chaos together  \n\ud83d\udd25 Drop into the new Battle Royale Mode and fight to be the last one standing  \n\ud83d\uddfa\ufe0f Explore fun maps or add your own  \n\nEvery move changes the night.\n\nThe club is alive, the crowd reacts, and now the fight for survival is part of the party.\n{1243154217981526}\n{1368060281817723}\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{2187813941673506}\n{1739398800021525}\n{1419888102232233}\n{1749393252644133}\n", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_p
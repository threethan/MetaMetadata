89780552627", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622214_1640089783885960_6470371422574167281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXoh8ycBMhwQ7kNvwGSE7gJ&_nc_oc=AdrasnvR0FXQSufNWuExABreBUio-htHokP6LNdYp0Z2_Xp7ULTzG4-gZBEtGL1sf8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVpjpc0LDVtvQCYnLCDL8L-eeUq744543Rf8EBvxUg3g&oe=6AE0BF1D"}, {"file_name": "ready3.png", "id": "561582800333236", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620707_561582803666569_3420584179331295566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUVAt_2IowgQ7kNvwFxIINC&_nc_oc=AdrHqwpcGj30AtlFyTV4oZPkEpD8CAK-gUAzciEPTisHvuljULuRREW_xZ1k_tIIJDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6XogVb2aWBya8KBVT3_5P6QMWb9SAbYkoVHU4mBVCmg&oe=6AE0BA91"}, {"file_name": "cheers.png", "id": "884484154066166", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619808_884484157399499_4686162614772789954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIC3eEdNozoQ7kNvwEPWR5U&_nc_oc=Adrzmc1HrVxTTYPAjPRS-TB8NHVmczE27OYyJQ9HG_sP6K8uheSZDD20XwRBvwWxaW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML9unF2UIMnNZfZqOY7jYNhAdHZeqOHuzMp-_2NP3cwg&oe=6AE09789"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NCS_2560X1440_\u6545\u4e8b\u6a21\u5f0f.png", "id": "1385750347040801", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307303_1385750350374134_8670844292218435250_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTNvJ3jT8OYQ7kNvwFFBwQ8&_nc_oc=Adpb139WLX9GFwvpqlIhJBW1c7ZkWtBmr79ua5TCqERft_c1oxxqrSksTstX5y76j3Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMehGnbN0iExkwVy4rDaoI84yYwi_qeaY06Zk0kZIB_dg&oe=6AE0CC79"}, "display_name": "NightClub Simulator VR", "keywords": ["blade", "drunk", "nightclubsimulater", "nightclubsimulator"], "long_description": "**Nightclub Simulator VR 1.0 is here!**\n\nThe biggest NCS update yet brings the new **Story Mode**, alongside the sandbox chaos, mods, and unpredictable moments that make every night different.\n\nStep into **Story Mode** and experience a new side of Nightclub Simulator, or jump back into the sandbox and run the night your own way. Customize your look, interact with NPCs, stir up trouble, and see where the night takes you.\n\n\ud83d\udcd6 Experience the new Story Mode  \n\ud83c\udfad Change your look with Mod NPC appearances  \n\ud83d\udc4f Hype the crowd or stir up trouble  \n\ud83d\udee0\ufe0f Explore mods and bring more variety into the club  \n\ud83d\ude4c Play and create chaos with friends  \n\ud83d\uddfa\ufe0f Explore different maps and make the night your own  \n\n**Version 1.0 brings the new Story Mode together with the sandbox chaos, mods, and unpredictable moments that define Nightclub Simulator VR.**\n\nFollow the story, create your own chaos, or just see where the night takes you.\n\n{1576526707585262}\n{1044743178370128}\n{1368060281817723}\n{672554845864877}\n{647238115090108}\n{981671617422036}\n{741449622070398}\n{2187813941673506}\n{1419888102232233}\n{1749393252644133}\n", "short_description": "Step into the wild world of Nightclub Simulator VR! Experience an exclusive party where you can dance, mingle, fight, or flirt your way through a chaotic nightclub scene. Interact with lifelike NPCs, build relationships, cause a little mayhem, or just enjoy the music. Your night, your rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Vision Bridge", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_
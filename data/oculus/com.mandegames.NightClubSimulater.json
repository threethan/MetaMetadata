S2JxgkDexrHFfNVgA1kGP7Q9MPObFTIWNtXtnA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCkaaEev-0QtDWMje78R_tTW7vKLj4hXXG7vgEiuT6mg&oe=6B0D9AB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2022-08-07 1309191.png", "id": "448389313929129", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984471_448389317262462_4742164588630018022_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39635Y7ISnMQ7kNvwH6D2VO&_nc_oc=AdoGYIoUe4MH5QXgfXLjx4bNeJ1rSZ3gUPo_crh9J8OmKKpCwh3YhGbX7OZnlGR9ChA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTWFR--GqBvymwWiZcvhQvDNT_vbwHpyCiWZisHIrnn1A&oe=6B0DB8D2"}, "display_name": "Night Club Simulator -- DEMO", "keywords": [], "long_description": "Night Club Simulator is a high degree of freedom VR game. use fully physics based animation system to simulate NPC's behaviours and reactions, so you can interact with them like real world. the NPC have realistic AI, they will happy, anger, scare or love. their emotion will change depend on what you do. The goal of this game is open, you can provoke and fight with any people, dance and kiss with girls, but you need be careful her boy friend when you accost a girl.\n\nGuide:\nMove--left Joystick\nTurn--right Joystick\nGrab Objects--left or right Grip button\nOpen/Close Menu--left menu button or X button\n\nthere are several ways you can interact with a girl:\n1, wave your hand\n2, clap hands when a girl is dancing, the palm relative and clap\n3, shake hand, reach out one hand to a girl\n4, dancing, the palm up, reach out one hand to a girl\n5, hug and kiss, open arms, reach out double hands to a girl\n\nThis game still in development, Join Discard: https://discord.gg/rSUKqXcg3u for any suggestion.", "short_description": "seduce girls or get into fights, you can do anythings in virtual night club that you can't do in real life."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mandegames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "mandegames", "support_website_url": null, "website_url": "https://mandegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "483926886944664"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "2586826771817594"}, {"status": "PUBLISHED", "id": "1752154626059385"}, {"status": "PUBLISHED", "id": "2297643517716259"}, {"status": "PUBLISHED", "id": "1780565279733261"}, {"status": "CANCELLED", "id": "1854935059224509"}, {"status": "PUBLISHED", "id": "1998989154315399"}, {"status": "PUBLISHED", "id": "2054695958754852"}, {"status": "PUBLISHED", "id": "1338184624848640"}, {"status": "PUBLISHED", "id": "1970745800484490"}, {"status": "PUBLISHED", "id": "886809550888656"}, {"status": "PUBLISHED", "id": "4032934180329948"}, {"status": "PUBLISHED", "id": "1572262620635755"}, {"status": "PUBLISHED", "id": "1401419604970663"}, {"status": "PUBLISHED", "id": "2060076637732170"}, {"status": "PUBLISHED", "id": "759658156402291"}, {"status": "PUBLISHED", "id": "1195131202358923"}, {"status": "PUBLISHED", "id": "1587933022110496"}, {"status": "PUBLISHED", "id": "1104087251231450"}, {"status": "PUBLISHED", "id": "877906477134028"}, {"status": "CANCELLED", "id": "513947667884839"}, {"status": "PUBLISHED", "id": "285623280609123"}, {"status": "PUBLISHED", "id": "645497327207564"}, {"status": "PUBLISHED", "id": "145371615079796"}]}, "baseline_offer": {"id": "2297643517716259"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "2586826771817594"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29198964759759529", "version": "1.1.3"}, "id": "579913957109512", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29198964759759529"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "579913957109512"}]}, "change_log": "Version 1.1.3 Update: The Gore Update\nOur most realistic gore system yet.\n1, Full Internal Anatomy: Every NPC now has bones, organs and flesh inside. Look into a deep wound and you'll see what's underneath.\n2, Pull Out the Organs: Reach into an open wound and pull the organs out by hand. They're physical objects you can grab, hold and throw.\n3, Weapon-Specific Damage: Fists and blunt weapons deform faces and expose the skull and brain, guns punch holes through the body, blades slice flesh open or cut off limbs, grenades tear bodies apart, and headshots can burst the head.\n4, Dismemberment: Severed limbs show skin, flesh and bone.\n5, Works on Every NPC: Including mod.io community characters.\n\nContains graphic violence. Player discretion is advised.", "created_date": 1794990547, "id": "29198964759759529", "version": "1.1.3", "version_code": 221, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29198951189760886"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29198964759759529"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794923721, "id": "29187522784237060", "version": "1.1.3", "version_code": 220, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29187501350905870"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29198964759759529"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794836325, "id": "29172174615771877", "version": "1.1.3", "version_code": 219, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29172151942440811"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29198964759759529"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794408080, "id": "29102314716091201", "version": "1.1.3", "version_code": 218, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29102302596092413"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29198964759759529"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "579913957109512"}]}, "change_log": "Version 1.1.2 Update:\n1, Ultra Gore Level: Added a new gore level with more realistic wounds, heads that deform in real time when hit, and flowing blood. Blood stains in the environment have also been improved.\n2, Blood on Hands & Weapons: Blood now splashes onto your hands and weapons, then runs and drips off. Wash it away with any liquid.\n3, Liquid Effects: Drinks poured on NPCs now flow naturally down their bodies and leave a realistic wet look.\n4, Reworked Blade Weapons: Stabbing and slashing feel much better, and dismemberment cut surfaces now have improved materials.", "created_date": 1793357774, "id": "28930116966644311", "version": "1.1.2", "version_code": 217, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28930101566645851"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
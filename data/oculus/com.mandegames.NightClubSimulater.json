_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2bwyg8t3iEQ7kNvwH0t3HH&_nc_oc=Adqvcs7Rgc9DX7ChyWVhhBPLQyuTTCnn2dP_ELys1xh5NysHzDXzpu82-1H0wpdxHh0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz4ILhaigMs5iOTha-Llda6Mak_rhLOd9hcu_RXch20g&oe=6AA968B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2022-08-07 1309191.png", "id": "448389313929129", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984471_448389317262462_4742164588630018022_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM3zQJEvAIgQ7kNvwGHH60A&_nc_oc=AdqxKaCS-ySe6rJcFsi5pvv1s3THcVOL1fegZpfDU23kHgQRZPcKDnitCQl_yRVa8Rs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoC4X9P0pZYhRlaumqbleM8-MlakJcFWzuGK9ET9kG3Q&oe=6AA94E92"}, "display_name": "Night Club Simulator -- DEMO", "keywords": [], "long_description": "Night Club Simulator is a high degree of freedom VR game. use fully physics based animation system to simulate NPC's behaviours and reactions, so you can interact with them like real world. the NPC have realistic AI, they will happy, anger, scare or love. their emotion will change depend on what you do. The goal of this game is open, you can provoke and fight with any people, dance and kiss with girls, but you need be careful her boy friend when you accost a girl.\n\nGuide:\nMove--left Joystick\nTurn--right Joystick\nGrab Objects--left or right Grip button\nOpen/Close Menu--left menu button or X button\n\nthere are several ways you can interact with a girl:\n1, wave your hand\n2, clap hands when a girl is dancing, the palm relative and clap\n3, shake hand, reach out one hand to a girl\n4, dancing, the palm up, reach out one hand to a girl\n5, hug and kiss, open arms, reach out double hands to a girl\n\nThis game still in development, Join Discard: https://discord.gg/rSUKqXcg3u for any suggestion.", "short_description": "seduce girls or get into fights, you can do anythings in virtual night club that you can't do in real life."}]}, "d
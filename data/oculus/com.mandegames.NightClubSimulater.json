": "27032812859708074"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "579913957109512"}]}, "change_log": "some bug fixed", "created_date": 1780202279, "id": "27003215282667832", "version": "0.78.1", "version_code": 185, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27003202326002461"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5332536576829015", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27032812859708074"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "579913957109512"}]}, "change_log": "0.78 Patch Notes:\nSinglePlayer Update:\n1, Added Avatar Mod Support: All NPC mods can now be used as playable character avatars.\n2. Added Ground Attacks: When an opponent is knocked down during an NPC fight, attackers can now follow up with kick and stomp attacks\n3. Improved the NPC alarm system \u2014 NPCs are now more vigilant and significantly more likely to call the police when they witness suspicious or hostile activity\n\nMultiplayer Update:\n1. Added a brand-new map purpose-built for Infection Mode.\n2. Kicks and attacks can now launch other players a distance.\n3. While climbing on objects, players can now push off using reaction force to launch themselves through the air\n4. Added some summer-themed items, Swim Ring, Colorful Beach Volleyball, Cocktail, Sunglasses, Coconut, Flip-Flops, and Surfboard.", "created_date": 1780046326, "id": "26977529591903068", "version": "0.78", "version_code": 184, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26977511858571508"}, "asset_files": {"count": 0}, "debug_symbo
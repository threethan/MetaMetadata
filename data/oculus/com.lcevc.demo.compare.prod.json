60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skbEqcSIJLsQ7kNvwEz2wTo&_nc_oc=AdpiEZXi9UDFP5vpeysZ5UomA3Q0ORwo0pORbOl0c_ytBq1tmWG9lXLrhl3ON1pMOZg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7bo7zPw22bPTibLgL45jkQht1D2kXl1Ljn8gyxWYZSA&oe=6AFC6FD7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLgZk_LWMHoQ7kNvwFl_hr_&_nc_oc=AdojaGgEvdY1A6VoHXm6n5QWg_I7xJ92Ji8dpLcIZmWQFcHmb6xAFsC6F5xf_ztYw9Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOOrrob6LV3Z9Vl_ex_Ppj78hkecykPLIu98NN6wgWEw&oe=6AFC6DCF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exma79pgKdkQ7kNvwEe6ZYx&_nc_oc=AdrbhseRW4cGnewORVCfqPzP4uEiELgBV1-GkGi85Xn57tXVklQEZ4sO63u6au2xftk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-o6HJ_294_FDv_40Od4RlDgNlGKelMUIzvRlXt2FZKw&oe=6AFC800B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT6-yz87Xx0Q7kNvwHcFbTw&_nc_oc=AdoSmXUti0gbi_a-PM225sDId5JcQu56SGVka3u-TqFxMTWQkpNXp0xFSrsDMVg5LD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_ELZbIWkrfGgM2zYBFH-9BzYjTDGb1KNIkEMorbsOgA&oe=6AFC7CD4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FITbZ6wHM4Q7kNvwEtbFgJ&_nc_oc=AdrVqWwN9L0KUB1MVuQh8ewaROfrlBgGPkRqJ_RiypFduwx4X6KB7hUT_kYjvxYoiJA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCqrY9_C995XHftKAfMjifypo3QaSl8apVfk0Edxfaew&oe=6AFC7424"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
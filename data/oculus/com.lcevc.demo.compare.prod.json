nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShYmOWfF8FLMQdYXCRc6BhjTj2qID9ABNzSAOKwv30iQ&oe=6AEF40D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8DQhyzFWZAQ7kNvwHj10Oe&_nc_oc=AdofMNfnMOO535uiiQ2YZdpQgcp7tCeX8-iW4_eqfvoIBWSQWqT9lga6TdUSJRZIq00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQU3ZwQhygh1p81xp1jWsrMiTNAVyy3zDap22pVs5eBw&oe=6AEF3ECF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1l1mnGQCooQ7kNvwFamkuQ&_nc_oc=AdqMeGZwZu5FKZ1b7lps5ei7pDOmqnkOKE1Rm5Iid2hMYUYDXF21ZPp8JpVqk0lMJ20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbr-_mQ-AhU5kwYBwO3nfyV3hyhjzLWmspc85ubBwidg&oe=6AEF510B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGwZCbbpwtIQ7kNvwFnnez9&_nc_oc=AdqmgHmU-s0iQkU7iShamVxx5EzEF2qCI4fSr4CEwTZSXZ7gmUSTuLtGCRK1Gc5LFh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQrJiGGcmbMQN3WSA_4Cxkv0hMG5lzRQJlsYOkMQU7Ug&oe=6AEF4DD4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYuOITFe6X4Q7kNvwEfh8Jy&_nc_oc=AdoGRexnq5HZkSB32X9C9KmCGN1nfGj2sF7HfKJYOX5pLkNbkWDVinJob-xUUUXpzVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCCAVSHSYb_TyrZIG1ZiYDN700CASzALQ7OFH1N56lqA&oe=6AEF4524"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
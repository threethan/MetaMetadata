60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnTqt4-bJT8Q7kNvwHS4jQx&_nc_oc=AdqqNtgsPMl-_P0ejfDpA_lc7yL2XMtHeHYl1x28Kkj5qLSNYsmtlD_02gtBc4Z6f9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo6IRlD3SfMkFPVdij5T7LBkYV06-IQKgyp0QyeoomQQ&oe=6B0458D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GX4NiXgeqIQ7kNvwEHk2Ez&_nc_oc=AdopX60o9uw6EuwqVbiZYJ8rFy7LuSlfMAMclRqZYnGoNPgnmWQBUbQPYOSw-VVxSt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_29eUADXTODo4PzAHLxR-jfa3ZAFEqyM00TeBkoGlng&oe=6B0456CF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CHYjO_2vqoQ7kNvwE5K_YG&_nc_oc=AdoKjEVjEWkclRC4c-ceCcTxijSUwx_Z1eBYv63r-m2TkjvU78TILeo-jp_e2OvmajQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrfNZeigQAHdndS0dgW13yArexKzgocE6VS0LD9Lzh7A&oe=6B04690B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwY1khuYWaYQ7kNvwEjhBpT&_nc_oc=AdoMbLxg0L7-5xcv3hqBnNzVqOxZBYIgAnXG9se_URcD65hZlHfShMImAfBWZd92oxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6UcHW0nV_ta9YZdMFQ-byVzcJLExNFeSSFV3ptdZINA&oe=6B0465D4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDm8ayOiRYIQ7kNvwEHFYeu&_nc_oc=AdpQQHWMnQNphlNgFKOAPwrjJfvyvkAnvw_p_qcT8-maftAKUl-OJp-f23R4UQiTjSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfUu6Do-sd6v_smoWFrKMLMKb9Pa9es-KWC2J41ijFug&oe=6B045D24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
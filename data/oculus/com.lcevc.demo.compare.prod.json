60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbP6NUxMieMQ7kNvwECQwFP&_nc_oc=AdooVoCmBYQBPiQTdf_-IRy3i6T8YQrrfJimcy9XyQiyjNVGt6t1pDVe0blyr8ekpKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE8FIZ5Mdg3TfpNiZpn0PenKST70s7Ka6LYR2KYTjTSw&oe=6B01EE17"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GX4NiXgeqIQ7kNvwFGA9Gr&_nc_oc=Adp36D1KXPXwi9zbI2mIoMkbLiQVcQSlO-0x38ztyzsun5OIeWGszZuCIzQM79b3exc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXCFDFkphCJg2yTRcg153SJe1s2T8CRWS1FmwMwwkyxQ&oe=6B01EC0F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CHYjO_2vqoQ7kNvwFy5LZZ&_nc_oc=Adp9-wllKXwKxsqfLZRIXdQAAl9Iis44TiTOBdk-RRoLb1G0gAi_9ilPXWJ1HRwaSXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRodXI4hpJYIDXKcd75Kfbfmn11TiCJyO-k6vD5II_dLA&oe=6B01C60B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSccqe4CZOgQ7kNvwEyhnlE&_nc_oc=AdrzIgb9W84O_UCyT5tMhzUAoGChZM5RCzGhdx0_4n5YaYwdVdzjV17l9_9U67Jg3L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7xqPAk7Zbxkmm6wbkLvW0rc7OPGmffdu_svvmH2aFag&oe=6B01C2D4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NXEmv_gSWgQ7kNvwFQMz0c&_nc_oc=Ado7f4L3WYnHKGaCC2z4x_KFMWH5fPdM54X5lI4xJoWt8NbrM-Rg3H74YFDfBivXgfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ51YZBtKgiSxRvEh_a4KWVlZk_OBN2Dw_QpErowJxu-g&oe=6B01BA24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
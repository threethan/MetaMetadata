60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skbEqcSIJLsQ7kNvwFa92md&_nc_oc=Adqbqoxdc1kVm_sRAFdH4dYEIcU2sxSH38nxuBJzmHqoFb9tyvg91AQddHLpr50CmJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgugZ2-rMIP7Jir13fjvNZYJwLVFnU6PqU4DnYVbBfgQ&oe=6AFB1E57"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLgZk_LWMHoQ7kNvwHQNqJ6&_nc_oc=AdrUCVF3dgHge_XM1LMBxmuPKM3xAmIg3x0noUkVyWxyxy8AnzXSaf_M-0uYw7cxIiE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFcz_dZrex-FI3Cbke8ixqMM7a4YHL7rdet9KU4_kqjQ&oe=6AFB1C4F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exma79pgKdkQ7kNvwHY_XzR&_nc_oc=AdpWD_K87ZxHdamgyhrXh2r_I-WzZT-T5Jd7u4P2VbUFGhq4F86D5UW1YGRO3OB8Gmw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY2Uc7uvzzjT_toIhP-T_ypjUjllHEHk1p8sMqyIk5cw&oe=6AFB2E8B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLCqj82CHdUQ7kNvwFgjggm&_nc_oc=AdoA05YQj6dhuxEu21MF-ImaQuiCjyq3QB6iFv61WkkDh5tHaihSrj4xLB36Hl8TBU8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLwCtYlrCRWrzh7dW5Ba7fArYEAA8-UqrpsP1VgAV5FA&oe=6AFB2B54"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FITbZ6wHM4Q7kNvwH8iBfW&_nc_oc=Ado5T3PZey-HIisn1Ru6skRGg7711xtOv9IIyxCiLkH14btzuQ2xprLau8nuUugexAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-oNKL5b92TKHxq_E4LuPT1zjCOLV40fEoeqW6BApvew&oe=6AFB22A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQugKvCcuKoHgim-OjWjkAmiCcWBC9Nb6Hjs32BGTFdTw&oe=6AF1E3D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26JsZDRf1RMQ7kNvwEXscwU&_nc_oc=AdrYsGsul2LRzq2PM7j3ukDJzOJTao_c2M-Tirft-JKPSCj0Lf0kqeO16Vy4lmW7z_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl5BOFKv81AiNSmprspIS_NoRfzd4rkA6nWW-f6keshw&oe=6AF1E1CF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=663vTTdco5EQ7kNvwGvyJ2P&_nc_oc=AdrWaVTxrGtQboCSL1CBlWFClgk1cC5_l9phYnQXKvpgJ4b4D20V5ic1v2dcu0h1gMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGV_NM_jsEHuSs8FExUo59CrIDoocBbOZqDXN5zedzAg&oe=6AF1F40B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0DARLo_GhEQ7kNvwE4LUxC&_nc_oc=AdpuB12waypv8BYaI1kM1QtN5wHZ2QpOXhok2hdDtKogWeS_Uw7cS4ASmLiEN6OtoAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNWN8K4iHM_ueEaKl-Ci1gnSIpGYALaiOR2O-n6D81aQ&oe=6AF1F0D4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYuOITFe6X4Q7kNvwEl5F7z&_nc_oc=Adr1t1mDIfHSYVu7uR88-MfIkhD0q8rC6pKHcRe-7UVye9LzpliGFZTL-36x6HLx58I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq3vIihP-nWCgxu3SAT4bvtifLcFbZApcfZGoZl5jqHQ&oe=6AF1E824"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
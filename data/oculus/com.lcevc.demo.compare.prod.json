nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1FBnRLxnxAtAtq7H-F7NlIot8xp04V6-PsNrriQjgKA&oe=6AE757D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Bn-6QlgxtoQ7kNvwGTK_gh&_nc_oc=Adrp1sxxMv8cNhYJgjWJn2YFG-ghF__HUMoAzjyau6xEuiTefXm0YRUWp11rpDWfQoI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQQzVgdT_KsSEIpNWUtugOjbiZAn-SsCMr1-3tiIDkaQ&oe=6AE755CF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It9-OKZ_dAgQ7kNvwGAc045&_nc_oc=AdoEcWhlg9FjNjycfWvGD6WXg5KLo57V_gYohUKlXn1lb1cPXlD18UL64bziwAaPpfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREzbnisMFJPi2rOARpTaNqOljk1YV32PZc1En-b6QSXg&oe=6AE7680B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBcILfvQsFMQ7kNvwG3hAfH&_nc_oc=Adqw7qex6Mohhr5sBFhwd1M6SLO20jFGrh2I2jkFB-BhD2ACq_ZZuX9110sYfJdUF9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyUENS6X3AnkJ8T2Sbpg0pCCfgqeuxmvCKWcSrxa8WyA&oe=6AE764D4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaMXZ7K-rqAQ7kNvwFF8_pp&_nc_oc=AdqmY-ldy6fsIBXv01Oc8200xhlHQs-L9Hh5tmqlguQepFZ4u0-pHiGb-Y9RcU1nOm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPMew2yYZu8YgQIgefauEpfUp6p11Ex7XlM3qjkNNeaA&oe=6AE75C24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
nt-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtDV0VCr9MEN8zucYsivOPg5KMbHUcS7PqtWUZbprAGw&oe=6AF729D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjun87043PkQ7kNvwHsqqXp&_nc_oc=AdoXa8pELweiBLzpzEjAh8-TMtAOqSW714MMuDY0BJuH_0hF-VKcruOtLiyYKQksD2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQC7B6NohCuxeDwkgvQLILsFqn5iIumgdAyVpvUaEnowQ&oe=6AF727CF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwW2iQqCWXwQ7kNvwHp-iGw&_nc_oc=AdrbL9QcnRMJnabzt3RjA9-UmkmmetKg6BCqJmnl2ecfzbhIR09D-dNK6HvpTsiCtOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlBp6p6UBEKCmjIF6gat7zDA9W5Bduo0gvlEE2MBKHlQ&oe=6AF73A0B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPx-iJRyl4oQ7kNvwHEhYXJ&_nc_oc=AdoXSRyNvl-sh89tR9wSD4bx5eVEz6LCU1fHrF2VE3nMfeuVq_5DJrLwIp3d1It6PPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8uZahTSREQr5OgNngNBNvfXl8H0Lt3uMR1z91crwH_Q&oe=6AF736D4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhxQyFQ-RY8Q7kNvwHHcH_m&_nc_oc=Adpwvmgx66urpNtVSXkWf3R-G6WppeWpGR2eJ_XRbrh0wwBRGwlKWzY0zkPUQ7cB5dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEPp5YhlJ73ieFrAWvn-kN5GDQLajuCgIwgkJ5HrZ5qQ&oe=6AF72E24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
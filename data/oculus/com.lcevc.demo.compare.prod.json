ideo_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads"
60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgIAB3nu_rYQ7kNvwFPW-mb&_nc_oc=AdrmWZNHDO4rmcHEoOw7bCBTEoaQ-kvdZHo6eb3aU57aS5nw9DAQ0yDItENvubI7ft4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkuuPNL6Xw5LoWdI76eLrctA8wtBvBwei5qYO54967jw&oe=6B0DCB97"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Duw29j7qztIQ7kNvwE-a0qh&_nc_oc=Adp4oRznUfbELE231qrbzddDk7m4CQFgcKVTa4Zl0PWQAas4IDvXKyZFsSfSuAgTlJc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKttCZGTgt1SKZZEBFAlqO-rWZgLnuUeSlU3k_ly925A&oe=6B0DC98F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBy-V_2HHAQQ7kNvwG6ijb6&_nc_oc=AdrIe68LiUOTseBh2HRE5jISzXybvGStd6FVmkbx4WLEt1-vHAbJucDJ3imUrIiRljw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRB2NFYUQaqxDXNJN3MrLr1kXXKG8TGq4pQwPeVDUfH_w&oe=6B0DA38B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBjVGPpaLPkQ7kNvwGbWL5E&_nc_oc=Adok0AtxTwJc6uMD2wtGdWMoxRVAGqh_4Ph22FmMDEg7uegSSPen_BSg1ZgItbtosZ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7K3WJziz6K3cgy6FKEXtS012lLJmi2SsxDiPmyr6tDA&oe=6B0DA054"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRH1C3ayqb4Q7kNvwEog39X&_nc_oc=AdoP-9BwuuJmqeDPSf2cosRG2vPs7kW6QhyIeaSpj-UYIi3I6brv9d0zn2oZF5K2ZRM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiZTQZeC5GC8u6Yh0mj_OZ0EBYjN3ZP7ScdfaIX8reTQ&oe=6B0DCFE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
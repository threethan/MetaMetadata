60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbP6NUxMieMQ7kNvwGH4Mzx&_nc_oc=AdrpOoo3O-ja8dznSqfdpq4uiLmt8hrKZTfMhHJNux7owveKgET044wefRFVUkJyuo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs5WxoBQqAPev7eEsyFggNZO5zcnu3MKSDEabc88ANiw&oe=6AFF12D7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQUgiqYzxw4Q7kNvwFKeftJ&_nc_oc=Adpo43jEIsb7C4MqVZPsin-DyPdFqtmdbcjjgK5EzDQS8Of8CWDrKAbozI8u_0XeqbU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw4H0Of-jLbKbXLvw2lZbJ5Zb2YAiTp0usLRV3R9XHCw&oe=6AFF10CF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlkVOO8h8X0Q7kNvwHLLciW&_nc_oc=AdrtP0T1pKV_InGiWOwy6kh3dCZIjnpPzi2HbdvrPombPZiTfWSTS11E-hSM7Y2hsyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJD6xLsC-Z53ks8zhJ4cOAoE7T1IC3L4xmRT-xSi-RWw&oe=6AFF230B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT6-yz87Xx0Q7kNvwFisr04&_nc_oc=Adok5wh05bms49nEvlNKMBtsVFNmQAf5QIMokng8A7kMg6WAqSdFfAAkOcXA6RNHOrk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz87tj7ilnCJ_efWOdCwDOpjLfP7NpR2CX6jnU5jUXqA&oe=6AFF1FD4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NXEmv_gSWgQ7kNvwG3Kku8&_nc_oc=AdpuPk72BDuSDwArm_9g-WHDLsBpT1YdNgXR6r73nov3CfOL32MDiXdbOhalQNi1KCg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF0DXV3gr1NHpJjVRjnKsigbWHkHSMhRMA2uFCyT1MYw&oe=6AFF1724"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnTqt4-bJT8Q7kNvwFlVJB0&_nc_oc=AdoNCAKWINHZQYNklxDSgqS427z2VgGBRLmw6u93lLvHMQADb4aMedT-pQ9kCRUuu7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR86thF27FmSgIomV_6OTsPEAEmhOYbmyjJBfFCLdRRJg&oe=6B05AA57"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBjhMcu7Kw0Q7kNvwG7NpMu&_nc_oc=Ado_4ezIxV4iHcXHAUzJ5bowIBRUzYyc3vL0U2Q93Fx_SXk6zpa2eibANPe4Jlwpq3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3yC28esU-5WmMSaYId2TSAWQPdmXPuH0ME5klrhnlIw&oe=6B05A84F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unSB-6DfXBIQ7kNvwFR7Gbh&_nc_oc=AdoDGew0g3J22b0zdeY8bBHFAknxTVGRbqiqXm8UYNYDwRNUEMflp7vW6tUFsYyK0S8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSly107dtdrdl4D-lb0x0DUqgTnc_bAMvnPoJ1OeykT4w&oe=6B05BA8B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwY1khuYWaYQ7kNvwHXTTLN&_nc_oc=AdqxmesL8v9QdHpTOPobF_R3Jl9MRUsSFHflUG_w4bGbBTTkURkavb219m8J3ZjFVnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThYac7vmZ0Ml4W8oitWCs7dUh1fVBoElqf1i-aRC__lg&oe=6B05B754"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDm8ayOiRYIQ7kNvwG6N-QW&_nc_oc=AdoOo-waHodNkcwTJwQBIiKkDkbuNzIJOXR2cqrxMNC4YxFsquVoxFLKlfVOQ2JQkbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa33xoX0LRVfPisIBpQlozmoaLGdIPz3BGIK-D_YrSsg&oe=6B05AEA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
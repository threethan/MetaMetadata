nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-D064eDfETKFfWmKJxgNdA781kSteAha1zPjBNk27Dg&oe=6AF09257"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8DQhyzFWZAQ7kNvwHVM2yP&_nc_oc=AdrRSFD6dRsVzU6OwpVJXQKFWh5agrthTt1nUepsizjh23YBc_9NmGJVSKuxmyHlvmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuwNZowytvX6_c__lq0ycraBdkskPVlEnxqPmLmb6HkQ&oe=6AF0904F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1l1mnGQCooQ7kNvwF8jgsO&_nc_oc=AdohlG0XuiGMVaJNHJTEJ6H1DZdNvFQKLl_mTDBAzphUcSpnNmZF2OCQeJHi7du2r0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrOrKEfVX6d35gIZ5MYkrHIkl2kyQBmTEgiI42f1-gqg&oe=6AF0A28B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0DARLo_GhEQ7kNvwHr3Ol7&_nc_oc=Adp41FpsEOoB3G1R4GREjkbEyXPYXOwyQN3V66_3jRbwWAkeFtDBD_bxOF4yo21Zamo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqX2dImUsEueojUDZg9cMWGGuLk4h_gnUj5qH3lSL-ZQ&oe=6AF09F54"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYuOITFe6X4Q7kNvwE0unNF&_nc_oc=Adpse1p9-_qfAjQPn1gYlLfaNRIi3s-j_lTaz_pGvur7mHJgVtFZCPMZwTXnOlTRYXE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROH3ceRKduApWKw7yQElG2i21UGWy_t7XrPg6_gYzebg&oe=6AF096A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
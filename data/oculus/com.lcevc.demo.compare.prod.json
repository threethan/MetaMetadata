e=6AF3334F"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=663vTTdco5EQ7kNvwHMFn5-&_nc_oc=AdpW9Fhw_5WZHK5MEi20MzCTImkwvPeInXE2FGjBawQN-VuYTv6_-EiqhvobhAzM2yk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI6V1lVwSs3Dlc2TV481fPE7p4Lj94cWXpQXEAhzum2Q&oe=6AF3458B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0DARLo_GhEQ7kNvwGE9-Ak&_nc_oc=Ado-dQSiZMoNclEHy4LXFf3eT93__Ud9HPFlApPAx-x3xrPbSe-LBMzqyzOJ42N0uhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzXZvJOgimrVXd13yvjyY3XcoUTTzTg5NhK7K4x5_gYA&oe=6AF34254"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJyJAeV2fRUQ7kNvwHAN-v5&_nc_oc=AdpKNq2ii0URJ9MRlHw0emtbraNZ2D1cjVV238AbkQGnGeZZgz1COjJQCclwCTFstt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMChfvSdBqnufNEl4uUAhLhF_P0d2FkC69Frci8NE7fg&oe=6AF339A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3187802514790604"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
nt-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6xn1wyMvHqp5c0mPCpUaT_o1Fy-ziBB9EKYOrEiNKdw&oe=6AEC9DD7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdUqthKJfUMQ7kNvwHldxRN&_nc_oc=AdpBf7MJwGRJ5ZqqXYH3lZYGfS-A6lD68yDQKVyuJgnHka0EahN9FTllDIonlVBeBPY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAmo0nAR4MiMZWoEei5Nno3pfaEO5VkkbMFORwzlHFYQ&oe=6AEC9BCF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE9Ao-4psGwQ7kNvwFfy69p&_nc_oc=AdoTXXYCQgb-62fRFjoGJevuXfUKQZhEz6XQyN9bj_wdwBGh-eoLAazm3ngE8Lu6iJA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHwB1YRshWii4XdTyiC9BgYYqX684Wrzx__26NGDKkdA&oe=6AECAE0B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGwZCbbpwtIQ7kNvwEdrqdn&_nc_oc=AdrKWRKNtwXf3xu19hBcUb7ZgwgeAwq7e1ti46AAktLxTn9fCZ8zkEnLaC_FkhxFQ1g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEFKeoTiNFrrV9vnvr7h6hgV1-45F2vtcdCm-8G5QKQQ&oe=6AECAAD4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3F3jXPO-54Q7kNvwFL6lK2&_nc_oc=AdqDGG4YVUBKbbAFOjaM8JXisAgrWCQCopqfappcqCpvawfOiJsixbO8GCO_sldc2ig&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOi3YW1OrMIhc0Qike-Dtu5jHnHs83ReUkQmyZkly30Q&oe=6AECA224"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
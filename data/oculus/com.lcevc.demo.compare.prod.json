60943190182_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt4rK7kWop4Q7kNvwHYUJA0&_nc_oc=AdrqtE-Pcy6d8sLXSd53pxnagPzcYB2LvMB0rrpDGaXOPBeFnX0zEZJe9Hl2Xr3u6Ow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-dVNqxvSMKeS8YxgOgDis74_Z2I-Nz3QDuADn-xLSUw&oe=6B099ED7"}, {"file_name": "Elephants no overlay.png", "id": "4100861189963389", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974666_4100861193296722_8012489599045781025_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXwVtBnsaBAQ7kNvwF_rH9p&_nc_oc=AdqVYcv3j2RoOgkB1MQWwLMUs-rfmA150JEUXR3M3Fy8pM23kFTHyaNOBRm0EL9oeWE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo9hsmgYFBJhwCwN5iXHmVZLghtkpq5IEykgaWg24pyQ&oe=6B099CCF"}, {"file_name": "PresenZ w overlay.png", "id": "538587980879978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035439_538587987546644_6432265009617324989_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4YQvRehqckQ7kNvwE5TLMb&_nc_oc=AdpbyM-mgG70vzGifOEJlXP-DjsoDJ0kK8D-d0U3SIUhqyg_u-f_4iI7rT1zZDVROKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTklEvvVYWTgxc763JDdJOuAJK7Iu8A192VtJ1pr5888w&oe=6B09AF0B"}, {"file_name": "Diamond.png", "id": "288537712970022", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974538_288537716303355_7908058494287485729_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJ8_TeFednYQ7kNvwHMv2wq&_nc_oc=AdqYCR_rGKXXjOzydIhNFg5NiSTlK6up6Hu3UgkfdYgenj0KXD2avktt6JZqi6ihtlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSshR851VOCjlMdzZ-rtwMGLNUOYaGA89Q7BCoFenwIAA&oe=6B09ABD4"}, {"file_name": "Pride.png", "id": "760181001526736", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_760181004860069_8065340105198890479_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofd_gP2QKB8Q7kNvwERRUL5&_nc_oc=Adqv6hJ5v6odF5luWboqJVZxJRSgwSG8ONSz0yxKhSrB7YQnZOUgtwFNHXbjbUs-iQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUZG2iYvETQ8jlma6BkJKV8eyhUzEg4N1E8QobCzyGhg&oe=6B09A324"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LCEVC Demo", "keywords": [], "long_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC. MPEG-5 \"Low Complexity Enhancement Video Coding\" is the latest standard by MPEG and ISO, that extends the compression capability of the base codec (e.g., H.264, HEVC, VP9, AV1) while lowering its encoding and decoding complexity.\n \nEnjoy this experimental application, watching LCEVC-enhanced ultra high resolution content and toggling between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolution (B button). All content must be downloaded before viewing.\n\nThanks to the Facebook Oculus team for collaborating with V-Nova on this experimental VR application of LCEVC and the Diamond Brothers, PresenZ and Blend Media/All Around Project for providing fantastic 8k60 source content for us to use in the comparison.", "short_description": "Experience the superior VR video quality made possible by Hybrid Encoding and Decoding with MPEG-5 LCEVC (Low Complexity Enhanced Video Coding, for more info see lcevc.org).\nWatch LCEVC-enhanced ultra high resolution content and toggle between LCEVC (A button) and equivalent streams that just use native video codecs at typical 4K resolutions (B button). All content must be downloaded before viewing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://platform.v-nova.com/terms/oculus_privacy_statement", "developer_terms_of_service_url": "https://platform.v-nova.com/terms/oculus", "publisher_name": "V-Nova", "support_website_url": null, "website_url": "https://www.v-nova.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {
dH2DUvae9xMZG6a1_xNg4_8fB1WGy-Ut96amUOtx88XGzcFM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGuRehrIYkwiG1qWLeczDH7K5s_eKnApfKCSLQBYlWKA&oe=6A899C7F"}, {"file_name": "ASGDOG_Screens_reaccion02.png", "id": "1501353352021715", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_1501353355355048_4507123351716100156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRChfCuB7bwQ7kNvwFEQBP9&_nc_oc=Adr-sGF-YitzNflTx_UhPES92vY3ZZKqgMWnuZ0WnY3QwJInpEdbVqZpy60RJdzShag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb-Ae1Quuw1Pqst9BeCQrZ2r0ZG-DQHPgELmxsRSAU1w&oe=6A899FD0"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUmgUoltL0EQ7kNvwEher-1&_nc_oc=AdqmESSwpZ6FaRyFip6AvzhAcCdpLf1xVuO_jrvefrcL6C8NmuMfuQt4JceEExOXKvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHImOpvVO2cEh7HIDER8ZeIVsriw3dypvnDDFy0yUKkmg&oe=6A899A8A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg80Un_dw1gQ7kNvwF7vIsZ&_nc_oc=AdoYxvM-mNKnz5WmdoAxDIyE2PZBToOTOXK1QQkjJZSJiEF0Q_eUcEWmdVC8EE1pGsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7Zz4PBepLBbgoR1o21WgibhCwLOAlvKT0Up_QY8OVLQ&oe=6A89A02C"}, {"file_name": "ASGDOG_Screens_reaccion03.png", "id": "1662876504947996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654867655_1662876508281329_2826761936149526650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzjImescVO4Q7kNvwHHUIjX&_nc_oc=AdqBzpKYJeC8-D68dHELDJ8Zo4RHaSFDKKz2bLOpUHal1JK1tr6R0euGqamwuYw9HxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPve5bg0OMJTyL8ITk0g83NSszEfUpxmeIZQiW-5OeLw&oe=6A89A012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "1335909975317859", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604282317_1335909978651192_1108228422463824010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIanOuaG5ggQ7kNvwGDqcHn&_nc_oc=Adrk2l-QQOaaBYn5UNCJyFcEVDBoS6uBWLDmH9nXsqNoBVfNt0OXTsQh3MiaYOyr8ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmjQNrLuToehTAG9mQ8J8Y89WYku3XmnW9bFDyOZjVsQ&oe=6A89814D"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security", "sandbox"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n{1249190233956655}\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n{1896279351757373}\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27260514513634533"
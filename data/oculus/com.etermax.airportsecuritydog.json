.5771-25/499618293_2019588135660130_7422319275595951656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlAenb_S4dkQ7kNvwGPg1kR&_nc_oc=AdoPPGj2IvycKwqgvFH2VS40CLF_eQQTeHBBQLKWA7BHou88lmsIWaVQzZfI30wk5EM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-2WVSABwmr-HoQYAuodrn_vl3io5S-JJ-45QyCsXOlQ&oe=6A0C5DFF"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5KdKdh5SU4Q7kNvwGcW0Bz&_nc_oc=AdoHBb6QWNw2GECvQdjhYBiY6lvShVbG6ve9goyymXlwDneH4jISq6YyYWcrJ3lKlks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HfX1SA8DlD7kY434ZA9VbeG3xbvj-fhIoqsEAl2qBcw&oe=6A0C5C0A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhNpegRuX6gQ7kNvwFrsDOO&_nc_oc=Adpx08_JpD4ex0Fnb9QDa5XTbKZHoSzZpyztU2O_Hb6K3uydItpBkZwW8ocHOxlOlbo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QYqzR24uarYPcHFIO-lfh3Kk8WmhfXiPkRDDSBWZZGg&oe=6A0C61AC"}, {"file_name": "ASGD_SS_06.png", "id": "1685630746208644", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618442_1685630752875310_4811678582335970735_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygLR_SbqUSkQ7kNvwHP0JNP&_nc_oc=Adr9poEt8T8xjXGl9-2mlRRLW2KWhFnwN09-g2s41NMxm6wkNFxYl3_lyj7F7azhPaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70W_qbuHHJLQ8wrv6tgt1mFnNmGUzhfkodMNL8r_CMqA&oe=6A0C59CB"}, {"file_name": "ASGD_SS_03.png", "id": "1760546484930908", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623210_1760546488264241_4948639611190646297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIpLESkgCN0Q7kNvwFn3BNz&_nc_oc=Adpjz1wcwEtZhPmKW_I5LFztGkrEPlFhpDwzw1gB8cFMShigD3xrbR3WrA5AZe0DkbM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BDlTIFdFRqnCB9NlLoWnMXk9E3YvD3h9KXnxm3vaUXA&oe=6A0C86BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "971375615658225", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622214_971375618991558_4618684763871025429_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRJbOOrCqxIQ7kNvwGjXFeo&_nc_oc=Adp8AY-axfeumoTh9IZIIYH4k5VON_l8LV_K0LfzkQ4ptnKs2z5j77m4xbljgiLm84Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l9SCTXjGk2AljbBiJSHgQnAWLmfRxe7HiN9tp4hbQFw&oe=6A0C7B3D"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes":
.5771-25/499618293_2019588135660130_7422319275595951656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8QesE-ERVIQ7kNvwFcPNBn&_nc_oc=Ado6hspa20fgpMgoRW4ebSvYGIyk5-vea4LSceiHdXpgyeNOvtY1j2wWkkDknUHpj-w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HkOnFwaXFnUzWv7djfK7e5sw4WvRhuE2IzEHpO6cOqQ&oe=6A10527F"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzpRzfXGsDwQ7kNvwET5w_6&_nc_oc=AdrE6wYoBePewyVNBV66nryDmcC5Ds1jQ7aClkCio-DNqYnZiXVKJ_iDQ0h5lvWXhtg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jrS81vuhvFGfc6wr3WGtAmVX3OfQXrsDeX5rUozkf1w&oe=6A10508A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuCVEfQEpREQ7kNvwE9ZNN2&_nc_oc=AdonJ3OABug5O07ahAhuQW_JQugiQd8uK9IH-DP5PY_H8m7dZox5gbsaC0uaKLkcGEo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HjL2Ss1W_JdI6vo_Z1SX0QTjgyqPKprreN1kelmX2tQ&oe=6A10562C"}, {"file_name": "ASGD_SS_06.png", "id": "1685630746208644", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618442_1685630752875310_4811678582335970735_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KKPFVVOquMQ7kNvwGg9OMG&_nc_oc=AdoJtPzmKkdmlFaTP5GxyONrSIC04ddQQoKUleUIyC7cvY0b_Qz7o0qiVCaPYRI_usI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K1eFjCPlSBxk9cNI_zWDstDrvIbAXZbYYaQoyanh7hA&oe=6A104E4B"}, {"file_name": "ASGD_SS_03.png", "id": "1760546484930908", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499623210_1760546488264241_4948639611190646297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_cZZBmy8WYQ7kNvwFYcDKV&_nc_oc=AdpaBp30UHIYgvl8-aL3Gq3TDt9nLIJh8zYYmsNvbf4ppGJtQR3_EKB7QtQZh41x1t0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4slQUUTBMgZscsFtRGp1hcwaq0YhGmBwYoGhmJa5NDPQ&oe=6A107B3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "971375615658225", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622214_971375618991558_4618684763871025429_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsyAQTZR07QQ7kNvwFAJfgR&_nc_oc=AdpM7C6wXNwgfdDw7Ad31U0ly0rMj6QtTW2JUIyZpZPA42Ssvam32-dUgoT6cvPEnJc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nsk7JlF1tDhadN65RghHBHx9LGKUKwttd9X5tle78pQ&oe=6A106FBD"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes":
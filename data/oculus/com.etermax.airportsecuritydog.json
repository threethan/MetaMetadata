C-TEMhDFeGhwNaho_aMmhSCJjHA0gAc4i5lm-NU2-QRYw-bw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVb0a_UQ11CAVf4SzJEJGctrMuwK3JhGq6ep-NUnJotg&oe=6ADF4DFF"}, {"file_name": "ASGDOG_Screens_reaccion02.png", "id": "1501353352021715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_1501353355355048_4507123351716100156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0-HLLbGFKUQ7kNvwFVJrtj&_nc_oc=AdqkA0L_x2FaGdGpWqC7BacbkBKFQE9eXOLc8BYYnMksxpe-ZLaB4RjXTf3Uv1ccf2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCnnFspVPbVHi7OfIKo3C6TuL4Bwkg59RQpJLZaUVigQ&oe=6ADF5150"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhDLZj6yTOMQ7kNvwHJ1mgo&_nc_oc=Adpw2087EXLuxVnvipHDXfmZsgsVOOCn9tMaq9v1hFQL-gK944wHWPPNlEWG_VT1eAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhq6Mm6JktwVbghpX1TmWiyKZfDRpr4Rl8QfjyQ3sf5A&oe=6ADF4C0A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PuquA7mYC0Q7kNvwHPU9MP&_nc_oc=AdpstpUlN9c7mQ57-9Xwm_FCdml-T9yRDpIcPl78z8oVVNVkJozoIlNyZMfV6tw2mx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkgDGjsABGhXGbRf0XXbJZTXg7oo_S2GYZC4fees0FfA&oe=6ADF51AC"}, {"file_name": "ASGDOG_Screens_reaccion03.png", "id": "1662876504947996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/654867655_1662876508281329_2826761936149526650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKuvSOyw-VUQ7kNvwFxi5lO&_nc_oc=AdpwMbqrouWt_BHsbhHNVeNFLRzAY1AZXmWlpj6dxugievpkoaJGL89Ht-U9mDloK2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8v4m1NaVDYv26MfxcSHhEWCyWOnGhkhdEfR0LU9jQlw&oe=6ADF5192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "1335909975317859", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604282317_1335909978651192_1108228422463824010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxopmSlXjiAQ7kNvwH7A8sa&_nc_oc=AdrniwHWYKyDDABdnsFSFXRRtKx9AJ6T9CJYI6-LFapN_z677kNTgql9XuHy_v3Bv3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJ6FPMSRktaFnp6hn1CkOfpTAxxlWMrB4OuQtdWI-HfQ&oe=6ADF6B0D"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security", "sandbox"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n{1249190233956655}\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n{1896279351757373}\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27260514513634533"
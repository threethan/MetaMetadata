JXVz9f-vZaqLmvwV1HaDMmtCme63W6NAB93mBgbIVmMKgB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VoPGAqItblji9gpWIDzXchij4FmQ-sGzaOqh1e3aWbg&oe=6A25A2BF"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBOOhCgIM64Q7kNvwG_P35K&_nc_oc=AdpZB2sfsm43p7IHN9Ey28W2c3H70WATXjjmnVPQ0ruHaZInU7kOuu6ycsoCWdJbPhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ysj97UA48-YSK4okm1XT3MW9XMWo1HbHpNt5MXvo39g&oe=6A25A0CA"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87Q08pLjuyAQ7kNvwFyUWE8&_nc_oc=AdrlYYQZ230-jMgp4JzLVO2UecKXtO30bvE66NwXgIjRdcv9bAJdJp_OXZMkCaZsgQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eSWUkJHwOZeWSozAeko93EqCsOPyTf3D7IeWv94OUtg&oe=6A256E2C"}, {"file_name": "ASGD_SS_06.png", "id": "1685630746208644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1685630752875310_4811678582335970735_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru6GoVFfvncQ7kNvwEHG7h1&_nc_oc=Adq77V0m2ID-VxWSmZoYrmU-DmtOBG35Bpzse6c-FqldDV-YG1GVRJYIEmG6n2qNA1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bGimt1wyRw7Jrhx5_6bXgbomjOLCNjqI46jv7NZfV4w&oe=6A259E8B"}, {"file_name": "ASGD_SS_03.png", "id": "1760546484930908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623210_1760546488264241_4948639611190646297_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHbonhtrQ5EQ7kNvwE279lW&_nc_oc=AdrCHbLrv-NGcB5FUH7QfNR5_IXt3ZyvKSu4BtGgHQGTSkna7JmTuf1WvAdFSsq_oEQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5HW_4nU5LLUGSsox_QaIOv02QUP8zORAG8NeY-4YTNw&oe=6A25933D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "1335909975317859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604282317_1335909978651192_1108228422463824010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gFDLh2U9JkQ7kNvwHSt1sx&_nc_oc=AdqdXQhPjAmFRibd5Lp9032EuCgIzXY5sFCQOzgvrZx1krhNtSSovaFb9Im7DmF117s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JewHbUo2J9keWtDpVs--YeagramgakuhaMaq09d-hzQ&oe=6A25878D"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27140483128971006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oc
19588135660130_7422319275595951656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqDx4agPLPwQ7kNvwGuMWb1&_nc_oc=AdowqyAKV8kCz1HjZfC-l9Jm1W0ZD-g6h5vF6NfuVRDfBP6GpacsKF3uB6aa5X1pOCY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcq-TReHDw36cwESVToUIqJsbSGMUWZsVo2wYJpyCd4A&oe=6A8D90FF"}, {"file_name": "ASGDOG_Screens_reaccion02.png", "id": "1501353352021715", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/618758916_1501353355355048_4507123351716100156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYs-qN1YTCoQ7kNvwFzxBlF&_nc_oc=Ado113KFbyi7hm_h9Sc5qoEuAKPyjkkiOq9pg4ySLisZ04L0S4cUOySSHHDVAcugWAo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgAbgjNWmQizf0nXD4U48R7HPAf1FIipYMAbCl-xBbpw&oe=6A8D9450"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NkWczAg3b4Q7kNvwFRBmQ6&_nc_oc=AdplehgzC37v8ZLQysbaAUSIoy1UXni_9WX827eC61T-77B7PZuSgudLqlpj-DAyR18&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhk2gOJqLkOEdWr9lmlKQl4MIFNmwQ_9K9o5BhT1aHZA&oe=6A8D8F0A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZvfzFJqyHEQ7kNvwGXbSrM&_nc_oc=AdrjLo9HH5DFxyKbmEeeuEmV0WhxDvoy8LEnHn9iSWXjcMwlYAwbk9qRacuxMeIAqKw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGF_Lk7vaMr8mcFNBF4QEey5lnrE7dk_MPv9oAnmOoPUg&oe=6A8D94AC"}, {"file_name": "ASGDOG_Screens_reaccion03.png", "id": "1662876504947996", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/654867655_1662876508281329_2826761936149526650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PfUYGdxyccQ7kNvwH8Aq7j&_nc_oc=Adq7nPVkcCiWf0qEGuetrg5yErlo4ieYNEIRFO29daVE0OxWAE_P_MaKD0jUDDfvQpw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqlwPcxR-hxdyR6zLHT8lY71pwK0a-kM5NTT5gI_E9uQ&oe=6A8D9492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "1335909975317859", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/604282317_1335909978651192_1108228422463824010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkV_MwxuU9kQ7kNvwF3mrJE&_nc_oc=AdqlbwUcj39CO12OpsMc_a7w4XaFlTjKE9OjDZsozxuo1l6O84Ut_7bXG5O6OUSXpnc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU7ss4JUXnSkUQyr27kyz6cmmdlEQIdz3WmwTRVlLvqQ&oe=6A8D75CD"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security", "sandbox"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n{1249190233956655}\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n{1896279351757373}\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
60130_7422319275595951656_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIMZiEzu7GsQ7kNvwFx9NSG&_nc_oc=Adr9UL7I7zs9P34YbI1qdJpeFnKsDmMAKhkKlDRpzXCpw6ui-7TURuvx8ZY3Qb9OpNw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJIGutl0MYkzIAg1614XTae4BWRXBgX419C4iYFDfkvA&oe=6A92D6FF"}, {"file_name": "ASGDOG_Screens_reaccion02.png", "id": "1501353352021715", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/618758916_1501353355355048_4507123351716100156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rFyygyRSY4Q7kNvwGBuU2B&_nc_oc=Adr28n-LDQgMHxDfEUi2UjPhT6gI92c50sCRnndrfokSwR1z3bklGHedpgZCyzPw_pw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdNrjL4TDq_WM4SHD-z_apy-xN2Rna1UWnuSoDDOw_yw&oe=6A92DA50"}, {"file_name": "ASGD_SS_01.png", "id": "2499479727155131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618938_2499479730488464_7414905874630896689_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMG_MydN6f0Q7kNvwEhpj6_&_nc_oc=Ado15HfZbXC7X-jpa4UFS6AO3vsUVwRFbvHRwUSQonoZBHzlhSA3kouB3f9mnvo9GrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXXDQxzjTAELvBE5Lwf9uSh7xaJiCc52k3ZUJmC87Urw&oe=6A92D50A"}, {"file_name": "ASGD_SS_05.png", "id": "954258124166067", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618274_954258127499400_5225223580509054699_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPUkGTTqTkgQ7kNvwFiz_0z&_nc_oc=AdptwD0ylKnMWZYeCEojtTjd8KjXQFyCTW63fNpR0ZJug-l0UAoN8FEpVb9jrUHsDnU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpC2Stw1ijAcDGDGp7VXkm1Y-np3V_swIxsu2WKSYAeQ&oe=6A92DAAC"}, {"file_name": "ASGDOG_Screens_reaccion03.png", "id": "1662876504947996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654867655_1662876508281329_2826761936149526650_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-8p3X2-5HcQ7kNvwEXWBZx&_nc_oc=AdoCBZr3Ng_rkOf7VnUwKdm41yUm1RGniv5rn_hNPYPd0HZuDmpohlu34-jfaHM_nzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Bemisk_x1SAx8Tui0w65U-KbR2uNZF1mlpj3H4Q2xw&oe=6A92DA92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "1335909975317859", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/604282317_1335909978651192_1108228422463824010_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbGI-OGmgUUQ7kNvwGb0F3Q&_nc_oc=AdoAIAJcnhy2UD7lPRnU1zrhOYLNd5X0C0ZwtTZG5oBz4cE13Y2SgJhE6asX7Oc1PUo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuKhz7bhFyXAgPA9qnneenWM4ThegRXvygla_4_UbhHQ&oe=6A92BBCD"}, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security", "sandbox"], "long_description": "                                                                                                                                                                             \n                                                                                                                                 \n{2135716083881262}\n# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos. You'll have more than 70 missions to clear (and counting!)\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n{1249190233956655}\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured missions\u2014but sometimes your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n{2140897046685810}\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n{1896279351757373}\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n{4335567873439429}\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\n\nMeet other K-9s and plan your next mischief at **https://discord.gg/yZbJWwRuW**\n\n\n", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. You'll have more than 70 missions to clear with  laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": 
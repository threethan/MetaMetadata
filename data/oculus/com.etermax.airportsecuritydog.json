}, "id": "1290845659519389", "locale": "en_US", "screenshots": [{"file_name": "Screenshot2.png", "id": "4286677671571494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_4286677681571493_8573866427027864337_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_cMRicl8aAQ7kNvwHb_S7t&_nc_oc=Adp-p9yfe8sqsw1DG8eZN6eeuAyruZrVoZN33KutrGJDh1lfcZIdvYmVTtqTMhWcq1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDTzea-8iTCqCvAv_DqGgSW2DEdbYwnGI0WRqOTjWOfw&oe=6A4A523A"}, {"file_name": "Screenshot1.png", "id": "2006971050219961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823837_2006971053553294_7833642825334846305_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om8gythps_gQ7kNvwGi-H47&_nc_oc=Adqncx6JBimbNgAo5xpfvIE0CT1f2fuAifF2_8pmZg5dW02b3kLKgSDATkOAMHAimgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-2kStcH8ddi-harvJJ2W6X7411D5lq3EwAPVCIFHFyQ&oe=6A4A5BEE"}, {"file_name": "Screenshot3.png", "id": "1454110406248404", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1454110409581737_2099388998774910497_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZeO9967Zh8Q7kNvwHY4tiB&_nc_oc=Adr2Mm3DPGi8aE7F6vRs7lVUnT86cBWvCO7NJkl1JKwPC1vCrD0enh_jgZk9sMphzjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwyaUz4Ln4AHllBhRwN_wwio8jb5FPgwK47vtmZATWcw&oe=6A4A6854"}, {"file_name": "Screenshot4.png", "id": "916088247692259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585819904_916088251025592_8812485562588688202_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrIEFMbf1J8Q7kNvwHP7zeb&_nc_oc=AdopcrM-e3mA8xjJ8Noy5GTpHuoGMY6pTTEIqhoMIZcWDK_UBO5OGf1fAmYSYdUO16g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5otPvu3bTY1jM80AP9VlOOwGaVW3utQplK7ezzJDOZw&oe=6A4A6D6E"}, {"file_name": "Screenshot5.png", "id": "926737866650393", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_926737869983726_3409775186099460292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYz1oyIgk3sQ7kNvwFxFNMI&_nc_oc=AdoBkd0wT_W-CJTFJPCofBPyre8M69a0qfUNajlmPCp6n0zeL2_25a5K2w0KdtEEch4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgfW8uXbwbi3jlUigVHrCfobwJV6CPYiuJMWn1gB__qg&oe=6A4A5896"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Airport Security Dog", "keywords": ["airport", "dog", "simulation", "security"], "long_description": "# \ud83d\udc3e THIS AIRPORT HAS RULES. YOU HAVE INSTINCTS. \ud83d\ude08\n\nStep into the paws of a highly trained (mostly) airport security dog in a premium VR experience where order meets absolute chaos.\n\n**\u2708\ufe0f INSPECT. DETECT. GET DISTRACTED.**\n\nEvery mission puts you on duty in a busy airport. Search luggage, sniff out contraband, and identify suspicious passengers\u2026 or get sidetracked by literally everything around you. \ud83c\udf92\ud83d\udc40\n\n**\ud83e\udde0 CLEAR RULES. CHAOTIC OUTCOMES.**\n\nEach level gives you structured objectives\u2014but your instincts have other plans. Chase a scent, knock things over, follow the wrong lead\u2026 success is never straightforward.\n\n**\ud83d\ude02 COMEDY YOU CAN\u2019T CONTROL**\n\nYour movements are the joke. Sniffing, grabbing, bumping, reacting\u2014every action can spiral into unexpected, laugh-out-loud moments. You\u2019re not trying to cause chaos\u2026 but you will. \ud83d\udca5\n\n**\ud83c\udf0d A SERIOUS PLACE, FROM A NOT-SO-SERIOUS POV**\n\nAirports are strict, stressful, and full of rules. Now experience them through curiosity, distraction, and pure dog energy. \ud83d\udc15\u2728\n\n**\ud83d\udd25 EVERY SHIFT IS A DIFFERENT DISASTER**\n\nNo two missions play the same. Mistakes, surprises, and unpredictable behavior turn every run into a story worth sharing.\n\n**\ud83d\udc15 GOOD DOG. BAD TIMING.**\n\nYou\u2019re here to keep the airport safe.\nWhat could possibly go wrong? \ud83d\ude0f\"", "short_description": "This airport has rules. You have instincts. \ud83d\udc3e\ud83d\ude08 Become a security dog in a chaotic VR experience\u2014sniff luggage, chase distractions, and try (and fail) to follow the rules. Clear missions meet unpredictable, laugh-out-loud chaos at every turn. \u2708\ufe0f\ud83c\udf92"}]}, "developer_name": "etermax XR Studio", "developer_privacy_policy_url": "https://www.etermax.com/privacy/", "developer_terms_of_service_url": "https://www.etermax.com/terms/", "publisher_name": "etermax XR Studio", "support_website_url": "https://www.etermax.com/support", "website_url": "https://www.etermax.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25633351753017492"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1653072289141531"}, {"status": "PUBLISHED", "id": "2390090608148761"}, {"status": "CANCELLED", "id": "1497605382106651"}, {"status": "PUBLISHED", "id": "1608688447085066"}]}, "baseline_offer": {"id": "2390090608148761"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1653072289141531"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27574525635566751", "version": "0.7.0"}, "id": "25726043310382195", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isApp
isplay_name": "Jman's Nightmare", "keywords": [], "long_description": "Embark on a chilling journey through Jman's Nightmare, a bone-chilling horror game crafted especially for the beloved YouTuber, Jmancurly. Step into Jman's shoes and brave a world where reality blends with the macabre, where every shadow whispers of lurking horrors. You'll need to confront your deepest fears and unearth the sinister secrets that haunt your subconscious. But be warned, Jmancurly's nightmares won't let you go easily. Each step forward brings you closer to the edge of your sanity. Can you find the courage to face the darkness within, or will you be consumed by Jman's nightmares?", "short_description": "Join us in Jman's Nightmare, a bone-chilling horror game tailor-made for YouTuber Jmancurly. Navigate a place where reality merges with horror confronting deep fears and unraveling sinister secrets. But beware, every step tests your sanity. Will you conquer the darkness or succumb to Jmancurly's nightmares?"}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2880ac1e-186e-496a-8123-15d53db7682c", "developer_terms_of_service_url": null, "publisher_name": "Edivence", "support_website_url": null, "website_url": "https://sites.google.com/view/jmansnightmare", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7201062253309662"}}]}, "scheduled_offer
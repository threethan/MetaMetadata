19_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD4vdBxbBhoQ7kNvwHFBT95&_nc_oc=AdqA94E3HJhbT4h6AwfKdYj_t8vOXwWeLlr07-Xwoy3y1qpADA6nPD5wDS-JEne7-Lg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97brZEycR9QRfmpuf5Phb0B0Cv-5dvAr8EjxPZ9uGMXg&oe=6A36AC76"}, {"file_name": "non distorted.png", "id": "1082018336176370", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035311_1082018339509703_6084011073483846567_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiyNRkc8MloQ7kNvwEYLSDR&_nc_oc=Adpaz2OL5tUhRLjFAQwALtzdJB9bEK52BbEXS-Sf-DrddBNINCdUy2kOl3nXdx20Ru0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AEXQn9G4uyA-boRAjWl4MdGBlV_rGEZuCkr5Cg9JEXw&oe=6A369954"}, {"file_name": "jman final.png", "id": "360146780241200", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982508_360146783574533_7071461946835211305_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kew6zezJ-cQ7kNvwFtXjzF&_nc_oc=AdrX9IWCqf45iJGAEv6eAK2-Mc7OCv_4RzGK4ZXt0RwfAq6GTiB_1ZoN5tMjCoK9dI4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ansG4I0TbncK5R2irdcpZpChV3z7weFAbiOQEbgNlMA&oe=6A36BBBA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jman's Nightmare", "keywords": [], "long_description": "Embark on a chilling journey through Jman's Nightmare, a bone-chilling horror game crafted especially for the beloved YouTuber, Jmancurly. Step into Jman's shoes and brave a world where reality blends with the macabre, where every shadow whispers of lurking horrors. You'll need to confront your deepest fears and unearth the sinister secrets that haunt your subconscious. But be warned, Jmancurly's nightmares won't let you go easily. Each step forward brings you closer to the edge of your sanity. Can you find the courage to face the darkness within, or will you be consumed by Jman's nightmares?", "short_description": "Join us in Jman's Nightmare, a bone-chilling horror game tailor-made for YouTuber Jma
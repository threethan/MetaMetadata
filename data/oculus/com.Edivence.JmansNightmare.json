": "1086189529099555", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75416838_1086189532432888_4870852750785522270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHc8yvKbbjEQ7kNvwE2T-4A&_nc_oc=AdrvTJJG1ytxBtHk0xneynqc6fdNRfIrekc6Wv45V46UFFoJ0OpJo1dR40F7yrYyM9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3kQMd2c09JkFgx79n1tkf7NsrxaivhTa5ERimBJmWFmg&oe=69F0A56E"}, {"file_name": "distorted.png", "id": "398716699476071", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974704_398716702809404_645276047857325819_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKIFsAuUG1IQ7kNvwEatzDh&_nc_oc=AdpI4b62-J7_ulSR00_LSpVmSbm-dSfuNH1jjkxmnfaN3blDP44cjjDpnLSj6rY88Xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af37m9XaS3faSvvarXi__bk_STKbvxBedVLKEQwhKArmXA&oe=69F0CCF6"}, {"file_name": "non distorted.png", "id": "1082018336176370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035311_1082018339509703_6084011073483846567_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J8yQy4ks88Q7kNvwH6fOkF&_nc_oc=AdqVSQuJg0EV7lOVSBeLWlMwawUT7Hg0SSQc7i9i50Hg95Hzm4v9NsCbSodJAhFAvEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3IbGao9FRxQqnD_GsfOSk9VgDvkoCMScxuMtoivauWRA&oe=69F0B9D4"}, {"file_name": "jman final.png", "id": "360146780241200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982508_360146783574533_7071461946835211305_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FiSfRk-5M8Q7kNvwFvZ9dF&_nc_oc=Adq6u8pPilgclJLZsK846VGm_NhI8LIT5_ZnwIjj_j_ERs-ufLpw8qoBDuf066uh5ls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0RDpXOUPNpub9XavWIjsHtvP_F-k__Vsa0cFJP9tom-g&oe=69F0A3FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jman's nightmare.png", "id": "440056005111904", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974682_440056008445237_5795214460738481271_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGzZmDzUf8kQ7kNvwGT5pA-&_nc_oc=AdqaACAAEtw64cJOe9JZg4l6J1no-fcnEmn4DyxFHqPzpwqd5iXpyEsGgTIq9_8yEt0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af13rAqOsqUr7jEvVJnyuAlYBGVsoV29w0G46OmZJ-a6jw&oe=69F0BB4D"}, "display_name": "Jman's Nightmare", "keywords": [], "long_description": "Embark on a chilling journey through Jman's Nightmare, a bone-chilling horror game crafted especially for the beloved YouTuber, Jmancurly. Step into Jman's shoes and brave a world where reality blends with the macabre, where every shadow whispers of lurking horrors. You'll need to confront your deepest fears and unearth the sinister secrets that haunt your subconscious. But be warned, Jmancurly's nightmares won't let you go easily. Each step forward brings you closer to the edge of your sanity. Can you find the courage to face the darkness within, or will you be consumed by Jman's nightmares?", "short_description": "Join us in Jman's Nightmare, a bone-chilling horror game tailor-made for YouTuber Jmancurly. Navigate a place where reality merges with horror confronting deep fears and unraveling sinister secrets. But beware, every step tests your sanity. Will you conquer the darkness or succumb to Jmancurly's nightmares?"}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2880ac1e-186e-496a-8123-15d53db7682c", "developer_terms_of_service_url": null, "publisher_name": "Edivence", "support_website_url": null, "website_url": "http://getagames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"
ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMfNP-O1BOAQ7kNvwHKglAq&_nc_oc=AdrPNrpntaL3UhlmQqB87zgMLMNKR4EA4wEmEl2jrFt7CQifVh3qaPD9xBT2ejaSrDg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjnchZROYcsFVppEJngZpDSgctcTb9miVkOij52YW3yw&oe=6B09ABBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jman's nightmare.png", "id": "440056005111904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974682_440056008445237_5795214460738481271_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LQHgM9twuIQ7kNvwHZ3SL5&_nc_oc=AdpM15Q11OGTeqHbZKdYgbM_vM0x2DnGeThRio_VwjW103-BR2iYrJPzsvPLua3894g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh_y_KJfMOKZByqSQRZiTGTMOw9Oe7-D7Z-Oa_NvFebA&oe=6B09C30D"}, "display_name": "Jman's Nightmare", "keywords": [], "long_description": "Embark on a chilling journey through Jman's Nightmare, a bone-chilling horror game crafted especially for the beloved YouTuber, Jmancurly. Step into Jman's shoes and brave a world where reality blends with the macabre, where every shadow whispers of lurking horrors. You'll need to confront your deepest fears and unearth the sinister secrets that haunt your subconscious. But be warned, Jmancurly's nightmares won't let you go easily. Each step forward brings you closer to the edge of your sanity. Can you find the courage to face the darkness within, or will you be consumed by Jman's nightmares?", "short_description": "Join us in Jman's Nightmare, a bone-chilling horror game tailor-made for YouTuber Jmancurly. Navigate a place where reality merges with horror confronting deep fears and unraveling sinister secrets. But beware, every step tests your sanity. Will you conquer the darkness or succumb to Jmancurly's nightmares?"}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2880ac1e-186e-496a-8123-15d53db7682c", "developer_terms_of_service_url": null, "publisher_name": "Edivence"
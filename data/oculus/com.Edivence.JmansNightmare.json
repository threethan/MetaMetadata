ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OvPrYpeCGkQ7kNvwHaND6h&_nc_oc=Adq7JC1oX6Jb8bT3k8EcALyyq2fjVINJ7FxzVPhVP7-UOM372EhF2JOQFpPo-G_24Fc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTikb8NMm4fsdo2JxHZBgmk-JNYZr0e8s7lt9KzPx4fGA&oe=6B0C4EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "jman's nightmare.png", "id": "440056005111904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974682_440056008445237_5795214460738481271_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwG36xVJmlgQ7kNvwEAt6Cl&_nc_oc=AdrnEOnF0iUGGWH5WcL3tj0lcO025E8UqrgIgorRxYPahk3bHU9EEngLK2nbSJMfeRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYQwWNaSi5Xqti91MXR-mE-JmHixpS1HQk5B1OWFrDng&oe=6B0C660D"}, "display_name": "Jman's Nightmare", "keywords": [], "long_description": "Embark on a chilling journey through Jman's Nightmare, a bone-chilling horror game crafted especially for the beloved YouTuber, Jmancurly. Step into Jman's shoes and brave a world where reality blends with the macabre, where every shadow whispers of lurking horrors. You'll need to confront your deepest fears and unearth the sinister secrets that haunt your subconscious. But be warned, Jmancurly's nightmares won't let you go easily. Each step forward brings you closer to the edge of your sanity. Can you find the courage to face the darkness within, or will you be consumed by Jman's nightmares?", "short_description": "Join us in Jman's Nightmare, a bone-chilling horror game tailor-made for YouTuber Jmancurly. Navigate a place where reality merges with horror confronting deep fears and unraveling sinister secrets. But beware, every step tests your sanity. Will you conquer the darkness or succumb to Jmancurly's nightmares?"}]}, "developer_name": "Edivence", "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2880ac1e-186e-496a-8123-15d53db7682c", "developer_terms_of_service_url": null, "publisher_name": "Edivence"
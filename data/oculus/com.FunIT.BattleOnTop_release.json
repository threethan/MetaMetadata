bbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qK0wYEUomksQ7kNvwFw-IJ0&_nc_oc=AdmdAH16CVTLr3xkwAgD3jHFPL9rSXZ94U-tcOy1tjQuw1B9eB4xojfAXcDaEi314Bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfslxvIT94gZV8CnKBjUmwwcoQtYNXEjNfgkP9jMksdelA&oe=69999F84"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpAg-G1UMhwQ7kNvwFA-lD0&_nc_oc=AdkOLlpCqAEBPR-xW_KGO19W7Foi8xvFRU6q3LJXGddB6ljTnLkr6BhqtKEXoNXAWuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuaAkjThx2B6g_jcZzhLGU7iqVK1ZOa3RvKN9ImtowU1Q&oe=6999ADB5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U_-ADHy5HYQ7kNvwGnCez-&_nc_oc=AdlDZkHWquZ1rEc1iGV6v4qTWtfj2zec3Sz2l2RlcOfQozWf7QEULFRBRDTNOS0oLX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsH8SF9KcziDbTQ-L3yPBZaN9OcwcfCg-jwnDB7i8fuHg&oe=699990A4"}, {"file_name": "3000.png", "id": "1068641280660114", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036605_106864128
uad70\ub300\uc5d0 \ub9de\uc11c\uc138\uc694.\n\uc774 \ud2c8\uc5d0\uc11c \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc9d1\uc911\ub825\uacfc \ub2f9\uc2e0\uc758 \uc2e4\ub825\uc774 \ud544\uc218\uc785\ub2c8\ub2e4.\n\uc801\uad70\uc758 \uc704\ud5d8\uacfc \uacf5\uaca9\uc744 \ucc98\ub9ac\ud558\uace0 \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-uy8U60umoQ7kNvwEalxRM&_nc_oc=AdpEYxj24K5l-1pF-1uAew5IjgSZrwqIo8bRcNwJ05ZPw-m-LoRfZ3IloFAClRpL1O0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0JsxXw0ics1_iuvq2sGReGWt-9DR18GmR4K6rN7E54w&oe=6AFF1E44"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03SU8uuKPagQ7kNvwGI6Npx&_nc_oc=Adp2y4OgB_Mv_rafX5bd4cv869Gh97X0OBetBOaqJjXnsHPXjnWZ3WjhcQx50PQjUxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdtS06ZYcq5ALd1OQmb-dvdHZd2JR3KcRyfseVf8PzJg&oe=6AFF2C75"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_
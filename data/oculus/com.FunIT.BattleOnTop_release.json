c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlmr1nSTUD4Q7kNvwHNNL8R&_nc_oc=Adqdd6sXlwvzhFXg3TUBC15HDkZEv9fVJLt01CqiWvp4KEajnYApIpcDB0vx5yLanFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx72qqD3aHkDJSOV3mtKxuRQjwkWsj7zhqB7yojtcdTMw&oe=69C12C84"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDQK-hpozdEQ7kNvwGVdvQW&_nc_oc=Adq6zMTA4ln9eIdbLKJuMNKSt7SBKe61u4VBzYa67xbr5kwXrs6CNqMVHbXYKG2K1vY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxdig_I3KrEK8H85qwAAOhC0D3-mfV6d0uXdtO7NBW1Og&oe=69C13AB5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU3k2Cfb_2AQ7kNvwFAuwsF&_nc_oc=AdpXGJSXxdhV-GaU0qRiGAX4GrNjtlu3OelNU-MfwdBwLU-FyBoQU4lyY1Xum-J2QIM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1zpP8hlEvE0WSAF_G7FN5tfguISodhNE-ZR5MZfU9Ig&oe=69C11DA4"}, {"file_name": "3000.png",
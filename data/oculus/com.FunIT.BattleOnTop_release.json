bbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hFw6pZ9svUQ7kNvwGfQaoU&_nc_oc=AdnZ0QqILYlpXzNrysy_blLjxtPNaOR1ZYyiIwiqJGeoUjFmV4j8ReO0yqXYxR0ExUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs1qP_P9KMM5ZSKI_Y61DVqg_imTfJtNp8-V3Dzo4m5Ww&oe=699EE584"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyOcA_EkflgQ7kNvwFmD_ut&_nc_oc=Adlg_v1eN51dbkWYNJLc2DcVtS9tAM8n4lELPBr5elPyrRllnp0eNgxAk5a6VaBz2Ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvsNKWjo6kN9oqDoYOpEUYdo_dx4FE1smU5v4uS8IpyNQ&oe=699EF3B5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_DiD70bLYsQ7kNvwH-HB9T&_nc_oc=AdmezS8x4WN_9x6ErYO5_vmixfFvTZEq1URe8nihM8sWK3bYo1-n8gqNPNVZJTjOSDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9EST4cC0z9k5EZTDXP70UnJ9VMRDSaD1cJXI_Xb1yCg&oe=699ED6A4"}, {"file_name": "3000.png", "id": "1068641280660114", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036605_106864128
bbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hFw6pZ9svUQ7kNvwGYz9im&_nc_oc=AdnzxGdu7cT_GcMELAOHZNKnt0-rFYWp23lvYI2oPsxyqBN38TKot6KdlrfeSFy4OLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuJcfC5s66fYYE9dEfx9b9sHwtY7xBS14haKjatPR6Nw&oe=69A03704"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyOcA_EkflgQ7kNvwEMjrin&_nc_oc=AdmT_GrJPaPFMp0wvGoP_1lBqmqqJJDdPbJOFYeTrWWhYs3njgtJD15KaK_jHzsxNBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuycPgx_TdZT3vgrZtaIzx_XGF6LreezCBT3AWY88H5vA&oe=69A04535"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_DiD70bLYsQ7kNvwGpohn4&_nc_oc=Adm8UtzNfD_B4noVyr8V-9KSdHLqMiCXOCdQU-A82T4JxduWSjT89ows3i44Qq_joEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0TJgVETWLl6J6qJzn94K3CxIsDyOgdCJvfNC0Um0MKw&oe=69A02824"}, {"file_name": "3000.png", "id": "1068641280660114", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036605_106864128
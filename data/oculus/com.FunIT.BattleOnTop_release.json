uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hlnFTByQFkQ7kNvwGs3bsd&_nc_oc=AdoNMlrlOrYotFvufLHs82c5oEIgNBQBMOk2MkVPCz-BaE4W5U6YSKxDK0cGkcuFfLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNCbMWnzCZVqetCZ_-uq9KobaOIdr3cfT03v0xQjv7tQ&oe=6A523184"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czRSGV3rCKMQ7kNvwGhQXHa&_nc_oc=Adrr9CL-yZrMVRpOHKvuVClVm4NQuWc8b2MKDKlCpj0JA2fx5rCQG1DTkOPVKiAwsXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPMrry5IDEj2OdPwKQ2pZifAG_7j3gfEP9fkq7T29WPQ&oe=6A523FB5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqXhbVCHJasQ7kNvwGpm1sK&_nc_oc=AdqubWgNsfWJecGdIjPOUI-iIPphocnEMCuB8o8-gpwZR7JyALiOYWqd0cgJoi7A4_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI1dP9XU1Bjp4iMO4Pow4a83r
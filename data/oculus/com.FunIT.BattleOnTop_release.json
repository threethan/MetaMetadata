bbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVQUlU4NgecQ7kNvwFI75OE&_nc_oc=Adk2s9VQKW9eoNxVB73TBQaVOPLv5iSLIcchb-Wk0e62L90hPx5_PdD3pWxWg7einHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscoDgCiBE1t96TgJeXeX4DB3gvKb8058UfjqvYm9nNkQ&oe=699C4284"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpAg-G1UMhwQ7kNvwE9MV1G&_nc_oc=AdljXbZwWYuZwXUYkiOFFcRrpEhtk4NfROkbNVUo9YnnEzFV7mZQXLgJ3nnVljy90eM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvaGr_NSt7f4wkIrJ4RMRAtQXoT0x3RtvhoPAmjth8NrA&oe=699C50B5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biIY5f8DJRcQ7kNvwENZrQr&_nc_oc=AdkjIxzKNcF5vaS_tIa6nbuJyS22cl7h7-Be0b4AAS96Q9ULbECptXr2DPsTClIBX9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftlZt2jDux5fiip3VeV6gdENmdnQ7h0pX_6E60fsFMmVA&oe=699C33A4"}, {"file_name": "3000.png", "id": "1068641280660114", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036605_106864128
uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEi4qM_6xnEQ7kNvwHLMhbA&_nc_oc=Adoco5BbywDTjBEAP9X-rMW08V7_0P2eSVjJuhgUgKswkegAlm-PNO4YqFzAw_wi0D8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tEoDHT4wXandPVZmko15yD3J0IxY7p-PcAoZvld8IDA&oe=69DF7F04"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y51t2Xm0PL8Q7kNvwG4Etmc&_nc_oc=AdrfXZ1yZ1kmjpPrf1R8bYyfhb0VLdiCB5mlVSBAYR9GR9iR2120SBJn93s2NCkRBdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2W5hx6lgw9Kx1T8Ffk81vl-32eubIdrtZxbZ2ivqJMPQ&oe=69DF8D35"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyLrKgEgrB0Q7kNvwGcVZmK&_nc_oc=AdoS9iRiwWdKVrLZYtZqMCMWS2t4OGpLwEhZKerUXSqncaHfPTYCQI-RBl7SC27LYR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37MP3KksAkImQZrj2BJMcZ1nO
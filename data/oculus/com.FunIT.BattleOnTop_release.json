uad70\ub300\uc5d0 \ub9de\uc11c\uc138\uc694.\n\uc774 \ud2c8\uc5d0\uc11c \uc0b4\uc544\ub0a8\uc73c\ub824\uba74 \uc9d1\uc911\ub825\uacfc \ub2f9\uc2e0\uc758 \uc2e4\ub825\uc774 \ud544\uc218\uc785\ub2c8\ub2e4.\n\uc801\uad70\uc758 \uc704\ud5d8\uacfc \uacf5\uaca9\uc744 \ucc98\ub9ac\ud558\uace0 \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ubbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_sa8w_Dr3oQ7kNvwEu1BwQ&_nc_oc=AdoZHTRjsplpzihQpCSmYgCrxV02VUlgw3j4XuAhbmA0YYccB-0Ese2KcNSWINMyuFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbNQz0kI0-bwPwdAHOT-nQyfUCxwyJYCmyrvqkjC0rFQ&oe=6B0EF044"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1A2LthzuD8Q7kNvwH38BVl&_nc_oc=AdpZfZSt7Uz0YN9z0GqjfVk_UwNlb-xOitzFJoGdqQrKeJJhQ2g203HS_rLRLrVYiEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXUoRk_jqNHR0Z_BrR3-2ZECzTM5zbX5BLJPoo6oStjHg&oe=6B0EFE75"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_
bbf8\uc158\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4.", "short_description": "\uacf5\uaca9\uc5d0 \ub9de\uc11c \uc228\uaca8\uc9c4 \ubc31\uc2e0\uc744 \ucc3e\uc544 \ubb34\uc0ac\ud788 \ud0c8\ucd9c\ud558\uc138\uc694.\n\uc2dc\uac04\uc774 \uc5bc\ub9c8 \ub0a8\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc784\ubb34\uc5d0 \ub3c4\uc804\ud574 \uc8fc\uc138\uc694.\n\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4."}, {"images": {"nodes": [{"file_name": "1440.png", "id": "5326826874014845", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974686_5326826877348178_4410480538991530305_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hFw6pZ9svUQ7kNvwHT7GqX&_nc_oc=AdltVbCWtGE5fTeC2q7yv--jLKXlrz6plM101zHAZBM3DbY1KL3iiZgtXqfATksqiTM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aftx7VfWhtNs6ZUaoafEbihGmlnaFxqudyR8DPer73a2FA&oe=69A18884"}, {"file_name": "2500.png", "id": "3354176981483217", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974570_3354176984816550_8804543052629835219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzrxpzcbkEwQ7kNvwF3p-Se&_nc_oc=Adl-WHdBJmjSDokuId8A39YFimzLkUX0LKsIfrhyLjuJa8e2EBmirnhYyIChVaLLiX8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuCzHTqDT2C9PAUFxltMJUgjO-HVIBn15La_hDCuhx0Nw&oe=69A196B5"}, {"file_name": "2560_fix.png", "id": "1088557028600010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031495_1088557031933343_7274856899389536195_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_DiD70bLYsQ7kNvwFwTa5-&_nc_oc=AdlLSGXY0sqiY5f31_IFyVN4fKxg0UXkzeycWmxC7DjkYUnkiJhEChlOu1hj7YPgawY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftZ5wCbBhvkqXrpijVv5dX4THSREkplJLWuBp0u_fw2Mg&oe=69A179A4"}, {"file_name": "3000.png", "id": "1068641280660114", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036605_106864128
name": "screenshot4.png", "id": "26755305220828293", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499311582_26755305224161626_609553034957840678_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vriGZVqIOYwQ7kNvwEAsoi1&_nc_oc=AdpVBn2RNp5StE5WnrdrgdfOWLCA3vXBboVsyVKrzX_MPP-eJUsukVIRp8tUPWKQDBU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y8-ksytdsbpvrzqDO9MUVuvZ6bY2OeA7BkVwCpVtrhA&oe=6A36994D"}, {"file_name": "screenshot2.png", "id": "2169172963648899", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507833663_2169172966982232_8105510437903758144_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mmeSaZlK28Q7kNvwGMAjEn&_nc_oc=Adpj42ykkRmZvpwBWvRkyecu3egaq4C3-y8fK7Ql8YXmLOsq4uHWOKM9rgCkbHIdK8g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nCbj54I6gAPKSMdO1IKix6v21VBg_mp6wIxUkCum_MA&oe=6A36910A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cyber Tag", "keywords": [], "long_description": "Cyber Tag is a fast-paced multiplayer VR game built around Gorilla Locomotion, giving players full control over their movement using only their arms. Run, climb, wall-bounce, and launch yourself across unique maps while chasing opponents or escaping intense tag situations. Every movement is skill-based, rewarding practice, precision, and quick reflexes.\n\nWhether you\u2019re mastering advanced movement mechanics, competing against friends, or exploring creative map designs, Cyber Tag delivers nonstop action and replayability. With smooth physics-driven gameplay, customizable cosmetics, and competitive game modes, every match feels different and pushes players to improve their movement and strategy.\n", "short_description": "Cyber Tag is a fast-paced VR movement game built with Gorilla Locomotion. Swing, climb, and launch yourself through dynamic maps while dodging opponents and mastering advanced movement techniques in intense tag matches. With smooth physics-based controls and competitive gameplay, every round tests your speed, reflexes, and skill.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cyber-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Peanut", "support_website_url": null, "website_url": "https://sites.google.com/view/cyber-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1194790820379830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312236_1915268762460151_987119267085791228_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsoCzlOhix4Q7kNvwE2Sb9V&_nc_oc=AdpVFIl4h5CKXSuTtUwko7nSN7KJuKqEEcPH0_izLT8-C-1uRecXvfGjLrwClSZcZ3Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xMtZPj9IuBK4CL6iO-IimGoDdI7GJ6qQNjuKAnHAzdQ&oe=6A369471"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cyber Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1780009620, "lastRevision": {"nodes": [{"id": "11
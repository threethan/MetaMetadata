me built with Gorilla Locomotion. Swing, climb, and launch yourself through dynamic maps while dodging opponents and mastering advanced movement techniques in intense tag matches. With smooth physics-based controls and competitive gameplay, every round tests your speed, reflexes, and skill.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cyber-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Peanut", "support_website_url": null, "website_url": "https://sites.google.com/view/cyber-tag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1194790820379830"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1203772966148282", "version": "1.1.71"}, "id": "922276134202343", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1194790813713164", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1203772966148282"}, "release_sta
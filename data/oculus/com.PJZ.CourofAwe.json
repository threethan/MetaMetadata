s and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26654313420907759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619697_1369752518310702_7486302244692248749_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2hk3qRZG8oQ7kNvwG5fxj2&_nc_oc=Adrff09aIfKKV4_xS4ePrJO3GUzbw7lg6GqOz9lfx5ZIbDOT28Llpid2het7E9cfMLs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-6qNJNFc3HgTJapNo6s42jNa5t3zS5MtgsoCfG1AX0A&oe=6A131F85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - EA Available Now", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "170
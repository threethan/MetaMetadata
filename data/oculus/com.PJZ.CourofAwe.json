LdEQ7kNvwHn6Z95&_nc_oc=AdnjEfk2_Cw7E_JAVQWj50_H-KBzqaK_3KepmclTFlEp4nScOF6xPKmJClY1WCo1c1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGNsTbLn5fSQEYltaTw3D5Z4ATOvsh_u9Aat2JrvC5eQ&oe=69B15864"}, {"file_name": "20251203-140525.png", "id": "4262720063985848", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619681_4262720067319181_7729292540608897724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWQC4-_cMvIQ7kNvwHDFq-b&_nc_oc=AdkEV0AIsevA_Lcu_KNa4xdbXeW2AK5AsQAclWvWvnu2RgzLhPVMiQBFjxJzlDgzuRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGHbT7wNIbRguyeC6YGUlOjonpJVQVoI0KhYdeK7YHgw&oe=69B16244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-0c8JH6JScQ7kNvwHsIVhB&_nc_oc=Adk9MtxJ3QMLLpHQ34FudBe-xy4C2rE3rOPis9NXgUzY7BrRerRlrcgavqV_GHJMRi4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWPb-LH6Ypepm-MjE5pJGgcYDrfXeUuH31snkvxOT5WA&oe=69B15615"}, "display_name": "Court of Awe - Limited Access", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "The game is currently in **limited access**, and we\u2019re inviting YOU to help shape it. Bring your friends, jump into playtests together, and be part of the chaos from the very beginning. \n# Join our awesome Discord community \n# Discord.gg/coa\nOG testers earn special roles, exclusive rewards, and the chance to collaborate on creator content as we build this thing all the way to its peak.\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n\n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25408533185485795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618264_2695669437457266_6867759330839390570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-30JvdA8_9kQ7kNvwFOv68a&_nc_oc=AdlX7ymd_vo__jj0X1GlfCnyZUYc6yNP7UUhXGY1CjY933Fjwcnp33VXmRGniqj5Nzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhP0ps2pbASHxYhaYmuX5D_ElDMSWSX-kPn_a9bHktrA&oe=69B15A0A"}, "is_concept": fa
m&oh=00_Af3U7W6iytxHMkEF3SL3OBmPTF0N7y7H5-BpJ3vsUyS3Iw&oe=69F0B044"}, {"file_name": "55.png", "id": "1291734042876411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618254_1291734046209744_8402130545196324903_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw6M663AVfUQ7kNvwE5Cqwf&_nc_oc=AdomULyGZn2KHBRlrNv6Ls6CXYaRNfARrGbv58e6x0GUvskdVaHj7xhoIJ8zLJuqZTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0KpcJUNSL7VTt6odWyD0I6mJX00bt7iRAHn_PUJbWA1A&oe=69F0AE95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDvoNeZyFQQQ7kNvwHJKJNg&_nc_oc=Adpr_HezCqWyJPx1HQO9mI8z3MvuoGy43yAkpB-aummfSP2mgPnOF-_rtLTuzRHND6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0WmW-P573Qv4oK8j0vIqD-8UPgDc0P1ViSn5MehN17bw&oe=69F09E15"}, "display_name": "Court of Awe - EA Available Now", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "# Join our awesome Discord community       Discord.gg/coa\nJoin us, share feedback, team up to play, and win exclusive skin rewards!\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26182759998063106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618064_1670140314022998_5970622806508868907_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RItgWHQsQQMQ7kNvwHzyRdl&_nc_oc=AdpCYZ2rqjN0lrMBzq1mkJ1ZX21yjfk6-bvCQ2nV0nfxSkzMpRMzE-gUIqswosNNolE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3UsgGrEuagN6wm4bJEYzY9hBNrgcQaIvnnbNVi43zlJg&oe=69F0AF3B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - EA Available Now", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "rele
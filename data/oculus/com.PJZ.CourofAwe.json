U&_nc_oc=AdoR03KOkjSnass3FIA1A5d8ukYnSKUa8ojT2ggZ-IA6qg3vVZNWrZe1LcwLuAnsveg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM78i2g89XjeFTV5if1wi7hMsStGeNCEcwUuzahiclZg&oe=6A8EE211"}, {"file_name": "05.png", "id": "958874447009844", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618251_958874450343177_247014975836568237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpPgWFDzwGEQ7kNvwGVXQqe&_nc_oc=AdoKkDXN-9M4YH_KlOHLHF6x_tAWHCoMU14jy6zkcvt0ITu8zPc7OT4Js0PbcVXner0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENAFlZeKA2BDeUjHnRQ_SOZJLf232aiGx_Tx6AUjLj_g&oe=6A8EEE98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAXfeKB2ZGsQ7kNvwFqgek_&_nc_oc=AdrmFbrF7xJ_NfJyuAsO1UiabgQCj4JofZFZ58zts3riytu_gKB332qN0SnQOWb5IBU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwxCf0ZtCtFgSoE0iiwwxAgnWEhRQthZkjjM0m5mbrYA&oe=6A8ED215"}, "display_name": "Court of Awe - EA Available Now", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "# Join our awesome Discord to claim FREE SKINS and team up to play!\n# https://discord.gg/DYAUASFUNG\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26654313420907759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618297_1016573554364623_8605333564449683178_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLeyto14ljkQ7kNvwE9CMQU&_nc_oc=AdpX-4ExJDRhVHVZR8Upmf6WMcH_tG6I42ibN2Ftu1mqtcZ0QhKk-Ll4Kyc-HmOzEgs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg5BGwz3_pMEZDLhwxZRQWVsCV8KQJGJDuEQtgvnukow&oe=6A8EC91B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - EA Available Now", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "i
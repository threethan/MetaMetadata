H0i9rnNLI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftTsbAYvQZFVKqPwBz6iKrZno-zezWOSkAC2jCTg5e3aw&oe=69A42964"}, {"file_name": "20251203-140525.png", "id": "4262720063985848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_4262720067319181_7729292540608897724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DDSJVAxUOAQ7kNvwESTeNX&_nc_oc=Adk8c5w4AEjXZr7wEg2bBolq3EiIMi8vaBW27wkxn6HRSpa9IgQbMOC5vvdSlcipBk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfthA4g8ywtf1SURhPZ20QU9qo61VhIZSPHe0kwwjDUWyQ&oe=69A43344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93JhQY1hLp0Q7kNvwG7EENo&_nc_oc=Adn5foUgjhDWd-FgAP3bTMyZpbuZKKIeTYhb0IZi4LgUFPg0wBGmIx-0IAhGcLccCT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv4JGQqsPW05wl8EsbBJaCxg14TQTCmwN__sIKGTn3pkg&oe=69A42715"}, "display_name": "Court of Awe - Limited Access", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "The game is currently in **limited access**, and we\u2019re inviting YOU to help shape it. Bring your friends, jump into playtests together, and be part of the chaos from the very beginning. \n# Join our awesome Discord community \n# Discord.gg/coa\nOG testers earn special roles, exclusive rewards, and the chance to collaborate on creator content as we build this thing all the way to its peak.\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n\n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25408533185485795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1961295694451890_321431168310684115_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiTVVTznI1gQ7kNvwETYnDD&_nc_oc=Adm-TZk-k00XxB2f1moTu8PK_RZgrM1kmzbN6GOrXS4121q9-SpfxiqP9Et92SZXVlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvEb1A4oEPPuic6M-WX_YGkBhHfc4BVZivvAopl8fAzuQ&oe=69A450E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - Limited Access", "platform": "AN
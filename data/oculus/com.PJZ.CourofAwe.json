haos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26468020466203723"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499618297_1016573554364623_8605333564449683178_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAN1xOgBB10Q7kNvwE7JSPh&_nc_oc=Adr1DxRWTCLUCgOb0Md1d4vbOtY3nSi0KgbLoXGfiC0JwtGU_COfmnAQjagYt68d0Ms&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yws5cwpFj-ZwayOOL3KxF9fjrpWv4M3vCYK45qaD1sg&oe=6A09D9DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - EA Available Now", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "
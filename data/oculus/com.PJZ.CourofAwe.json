&_nc_oc=Adoml35GTYN9xDH51kLkfChrPf9zOEc2njzn0mwoRWOmn8P-izdnKtPTfj_PtKhp2tE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0BXdk-mIp3__bkunCZ7DPyRZf8RFLLf3y1UTfasAv-w&oe=6A7DBE91"}, {"file_name": "05.png", "id": "958874447009844", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618251_958874450343177_247014975836568237_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVW78_FWyCkQ7kNvwGV3SG1&_nc_oc=AdomGCQkWpCeJHHxeqIr074-78P09IVWAMa9DUDGE0_LcfJCFisEw0FT7WDiriiqXUQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG4fmslCaJKK5zQYv-DwrHebvMCEcUAoHhram5R4ciGA&oe=6A7DCB18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsoDFF86IpoQ7kNvwEViGo6&_nc_oc=AdqIdZcaoD8EbDrqYW_7SVYTZKRClGkb-hr0uw9hkF2MxLkcJWOVKn0sae5zj8L_67Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf0JYXuDtWuZbfjFX2VeC633gid2dp9702DbhBAQareQ&oe=6A7DAE95"}, "display_name": "Court of Awe - EA Available Now", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "# Join our awesome Discord to claim FREE SKINS and team up to play!\n# https://discord.gg/DYAUASFUNG\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26654313420907759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618297_1016573554364623_8605333564449683178_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GUNyCqJM8oQ7kNvwGK6UMi&_nc_oc=Adr1mpKLLr0aCjvhoHQqZLCMlGoPDKcGr560MCUD7m3TGK6J_8GGe8pF1KFLzLUBW4o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdpypW4CPuoFuNNWWmBj9U0mFwUka-I2itrjvIJ49bHQ&oe=6A7DA59B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Court of Awe - EA Available Now", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id"
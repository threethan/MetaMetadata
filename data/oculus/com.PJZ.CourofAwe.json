xokQ7kNvwEjYjYR&_nc_oc=Admd0GBZb355mx2cOlU-OH6Dn5jIFs5Qjp3ZjUoDVudU06dNUC21Y8mHoM1Kyl4AWMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzb8lHAAL7RwupYMJXAoQWE9E5pyjpV4FCg_UfSnfqcNg&oe=69AC1264"}, {"file_name": "20251203-140525.png", "id": "4262720063985848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_4262720067319181_7729292540608897724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eACxUTdBE6UQ7kNvwHRQjS1&_nc_oc=AdltV7gV_rIz30Gk_xWQgJMuIwMGWo1Itm1rW84bYN8xHnHRR48NE81ylMFPKgBcGL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmTG3ZW7q9Sai0XVTJtKWakPaeTBLx71qTgoa8kjpz8g&oe=69AC1C44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FENGMIAN .png", "id": "2797202207139550", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_2797202210472883_2201989932232736226_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X77kOaCEiiEQ7kNvwGVpDMB&_nc_oc=Adk6F0_HLCexQIO0QPrb99yPaJ2DeqFicyErJf6XHNsdDEkDHWGj_qpIISNmjxXbgF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxa4esyfcFVKDbHgNbFwr5N3B2O9VSCHimfmtO8ja70RQ&oe=69AC1015"}, "display_name": "Court of Awe - Limited Access", "keywords": ["Animal", "Gorilla", "party", "court", "fun"], "long_description": "The game is currently in **limited access**, and we\u2019re inviting YOU to help shape it. Bring your friends, jump into playtests together, and be part of the chaos from the very beginning. \n# Join our awesome Discord community \n# Discord.gg/coa\nOG testers earn special roles, exclusive rewards, and the chance to collaborate on creator content as we build this thing all the way to its peak.\n\nI sentence you to have fun! Enter the most absurd courtroom where you can sue your friends, present absurd evidence, craft the wildest arguments, and deliver the final verdict in this hilariously chaotic online party game. \n\n\n\n{25743203581930475}\nThis is your Better Call Saul moment! Bend the truth with creative arguments.\n\n{710751514924608}\nDraw your case and stick to it!\n\n{2044642826322429}\nPresent the evidence with your finest nonsense.\n\n{1505458757376850}\nListen to both sides of the chaos and make the final call. Justice has never been this silly!", "short_description": "Court of Awe is a 3-7 player party game of judicial chaos and wild arguments. The goal is simple: convince the Judge you're right and the other side is wrong. How you do that... well, that's where things get interesting"}]}, "developer_name": "Boundary Breaker Studio", "developer_privacy_policy_url": "https://privacy.xrbreaker.com/", "developer_terms_of_service_url": null, "publisher_name": "Gallantry Works", "support_website_url": null, "website_url": "https://coa.xrbreaker.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25408533185485795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1961295694451890_321431168310684115_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kg69YqLnDXYQ7kNvwFXVoao&_nc_oc=AdkSsTm5_5XCzmcC5peOm_Ixd32fRhPf8h4n1vd8F_vjUtCod-KEkVgpU0rg7nulsro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwagmWht4wvugoQiw0SNVy1rX5N20edFZtE9mP_FzSgJQ&oe=69AC01A4"}, "is_concept": fal
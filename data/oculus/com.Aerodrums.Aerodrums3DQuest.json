 Aerodrums, you will have the ability to reposition your drum kit pieces in 3D, navigate your music playlist, enable a metronome, record your performances and switch between drum kits.\n\nFor more information, see https://aerodrums.com/3d-update/", "short_description": "This app lets you experience a drum set performance in VR. It also serves as a 3D frontend for the Aerodrums instrument."}]}, "developer_name": "Aerodrums", "developer_privacy_policy_url": "https://aerodrums.com/wp-content/uploads/2020/07/Fictitious-Capital-Limited-trading-as-Aerodrums-Online-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Aerodrums", "support_website_url": "https://aerodrums.com/3d-update/", "website_url": "https://aerodrums.com/3d-update/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "SIMULATION", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "287652900036655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86620687_778364923096073_513047319098338023_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxvLIzHBP6MQ7kNvwGhI__e&_nc_oc=AdmfW3huar_JKVIibh5fPqKwJItTTygelKVI2_pUDG2KTw9F5Qp_u0-3onRQDWgkYng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz0mcPWZrXWJM7nTu88Wkt0zJu1s2N0jNDFLgSu7NW25w&oe=69BC0C7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
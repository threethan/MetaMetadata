360.png", "id": "151698517411282", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031560_151698520744615_8233621077805164480_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80W7fNnIhloQ7kNvwHjJMPe&_nc_oc=AdoT5Te0OF25puCQo12guTk7RkyUxk2GjiQP7JuwxCZgrSiuYWh_HzxKLmgv5cZIedY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ou6m3OSIEiY8bL4FtyLFARFauMm9QAfdEw7XH-k4t6A&oe=69F0D235"}]}, "id": "582427562616217", "locale": "en_US", "screenshots": [{"file_name": "HS_Quest_Sword5.png", "id": "5596848150417812", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036670_5596848153751145_9201424236087737290_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5B9xIyscfnAQ7kNvwEgxWaT&_nc_oc=AdqYCz5yV_p-Pqk962bAtQQWBXxDrpX7p2QT6JtFADM5WjDzezdFqQflK-oYHbXShlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1YvmJIBY1Vmb53V-ice3Qod1kJwBb3la2nKYyrK9bs3g&oe=69F0BDE7"}, {"file_name": "HS_Quest_Mace1.png", "id": "900140971081410", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036670_900140974414743_8121947409357394209_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LivWMCx5e5oQ7kNvwH04HxR&_nc_oc=AdqKOGEXMuGXeMKP2ZHeTrop-F4hJMCNuHMrRfajyPvtP26R1FIUCmnGzeudK3nFcgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0_Y3KYguD2VTSeosmXLP4xCmLmTu6IC5n-WeU2QNOpHw&oe=69F0BAA1"}, {"file_name": "HS_Quest_Hellhound1.png", "id": "802604334410469", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429290_802604337743802_5202483369891568299_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gC21kP2cLrMQ7kNvwGWFMY8&_nc_oc=AdqG47k6ZP377BOV73ycYNvAYufqt5x5CwOpAXJZzWZGq4OuDkq8GCfamJtnAz4J9FA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0APFz0denJv8i_UdORxibdZ-49deJ22U20ehmBu5URFw&oe=69F0CF82"}, {"file_name": "HS_Quest_FireFrost1.png", "id": "221010510781337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422382_221010514114670_5417626890402215327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5icc0ga9RcUQ7kNvwHtq0f5&_nc_oc=AdoFbCAC7EHJW4VRAyNjfioQIrUdq0yXmd8AeDMbSxMq6eaG8mPcExz4p08lXCb9Phs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2eBirDlmXl_I1oIGmJdm4ALoRHnbP7vFVZI8rQoc8_Qg&oe=69F0BF80"}, {"file_name": "HS_Quest_Lightning2.png", "id": "569932288384987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974500_569932291718320_112790462111659770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiEj3C1hbDQQ7kNvwFyzYq_&_nc_oc=Adr1WynqKcuJIgLnzDYyY9vnZVeAHrfXFS7FetAajmZU0vk5A5_qjuMQmiGDPOSdFH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1brrqDyC9YxvsXSLw4zBsC7RMv9UD8OasJjP4NtaVtFw&oe=69F0A2FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_CoverLandscape_2560x1440.png", "id": "3497414057171266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_3497414060504599_1767120571552452621_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYhrAJxsVM0Q7kNvwFzYeCe&_nc_oc=Adq_5Iy8vyUlwjZ__omUGqpktVbqAz6ymHWvPx8UOe5ObLxvZ0oAFQ6SRB_26dO0Vww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25DdSLc9upTI-pMRwksmh_y_Zk83toxL7ejjHhZzd7Nw&oe=69F0A219"}, "display_name": "Hellsweeper VR", "keywords": ["Hell", "Souls", "Roguelike", "Magic", "RPG"], "long_description": "From the makers of Sairento VR comes a first person action-combat game that descends you into hell. In Hellsweeper VR you traverse the demonic dimensions, wield weapons with deadly precision, command the forces of telekinesis and muster mystical powers to wipe out your twisted enemies. Reap your rewards, upgrade your skills, and choose your fate as you experiment with unique combat variations and start to discover what being a Hellsweeper means to you.\n\n\u2022 Intense limitless movement: A daring, no-holes-barred locomotion system that pushes the limits of even the bravest of VR players.\n\u2022 Master your combat style: Summon, wield & master various weapons and magic combinations. \n\u2022 Survive in various ga
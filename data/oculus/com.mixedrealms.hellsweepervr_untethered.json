1337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422382_221010514114670_5417626890402215327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFOChFlozxIQ7kNvwHZe9UG&_nc_oc=AdokUkInWKCdQe4cUv0AepXwEtxiux4nbvb3JOWLx6NsA2YSTuD2Df8ZDiw2kvcJIDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_ajWJ-reBlzFaFAjA_0uGbzHe7DuMPJs8gMKVp33sPw&oe=6AB7D200"}, {"file_name": "HS_Quest_Lightning2.png", "id": "569932288384987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974500_569932291718320_112790462111659770_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm6DBMFJWUQQ7kNvwHX90ey&_nc_oc=AdoWahrt48FsNiuXM9ZvAUPPcq0Li4O2IxlNPEYswCZ8oDFZQUyeO299ScsGLrFO_rw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5yJabnSXb74tLaRrFqzbdnQGBW-3U0PHBX2sirScqZw&oe=6AB7EDBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_CoverLandscape_2560x1440.png", "id": "3497414057171266", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001660_3497414060504599_1767120571552452621_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etlvr2J01dcQ7kNvwGtfDeY&_nc_oc=AdqGUo_v4LKQsmsjyKClhmpickduJqDeDWx2x5xxWJot4IarNCoExRIazgXe7cgdnKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnRQunLNG_MRUZzfzF9sPY5twSxkeGWO3byz_cBMI3Cw&oe=6AB7ECD9"}, "display_name": "Hellsweeper VR", "keywords": ["Hell", "Souls", "Roguelike", "Magic", "RPG"], "long_description": "From the makers of Sairento VR comes a first person action-combat game that descends you into hell. In Hellsweeper VR you traverse the demonic dimensions, wield weapons with deadly precision, command the forces of telekinesis and muster mystical powers to wipe out your twisted enemies. Reap your rewards, upgrade your skills, and choose your fate as you experiment with unique combat variations and start to discover what being a Hellsweeper means to you.\n\n\u2022 Intense limitless movement: A daring, no-holes-barred locomotion system that pushes the limits of even the bravest of VR players.\n\u2022 Master your combat style: Summon, wield & master various weapons and magic combinations. \n\u2022 Survive in various game modes: Various singleplayer and co-op modes. Survive together, Die together. \n\u2022 Content-rich experience with high replayability: Conquer 18 maps, over 10 enemy types with elemental variants and multiple mission types, offering a unique gameplay experience with every run.", "short_description": "Hellsweeper VR is an intense action-combat first person experience. Traverse the underworld, gain mastery of your weapons and elemental magic, or fall to the unrelenting onslaught of hell's twisted souls. Dare to descend into hell."}]}, "developer_name": "Mixed Realms", "developer_privacy_policy_url": "https://www.mixedrealms.com/privacy-policy/", "developer_terms_of_service_url": "https://vertigo-games.com/eula/", "publisher_name": "Vertigo Games", "support_website_url": "https://vertigogames.atlassian.net/servicedesk/customer/portal/2", "website_url": "https://hellsweepervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_TW", "fr", "it", "ja", "ko", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "334468335086067"}}]}, "scheduled_offers": {"count": 27, "nodes": [{"status": "PUBLISHED", "id": "1767092904448927"}, {"status": "PUBLISHED", "id": "26980049288286145"}, {"status": "PUBLISHED",
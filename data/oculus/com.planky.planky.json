7&_nc_sid=6e7a0a&_nc_ohc=X8gNJbgICZIQ7kNvwEmZTa1&_nc_oc=AdojqYgPX1tf60duthfqLw8B1M3wBTiVdAwGtyhN1BqxFUgaxxXXREQLQIb0LndZvY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoE7ULTtPLf3xYj1DUBq51jF2qOoDy95sHwNCGhwvykw&oe=6AFDD1FF"}, {"file_name": "screenshot_02_plank_to_bell_2560x1440.png", "id": "1659451272417399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1659451279084065_7423339788349217278_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2nVsyiP5fEQ7kNvwEB-Ldh&_nc_oc=AdqoAGR7myawosrrvNBPNapIs8mkb7KfNQ36qW36LL6rjf1-eb3CqDbPk6VsvCfcv3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvcbPhBd1kIKaZ9OR4vvm9c34HBY0RB4LvO9ic0I_Nhg&oe=6AFDB61D"}, {"file_name": "screenshot_03_group_play_2560x1440.png", "id": "1115768140885075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1115768144218408_2168654817407302462_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4_eghIY0FAQ7kNvwFSzaol&_nc_oc=AdpaM9192Yai4JjDm_KBSwy8TcGWkK-jACU0jr0fTnxgTIOJwiJ-bHaLWYc09KN-5M0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJtsEJ0Puj-E3V0Cf3NBBtHOx4fvTJhEc8xzwhhlCrVw&oe=6AFDD39C"}, {"file_name": "screenshot_04_your_room_sea_2560x1440.png", "id": "1043066678741152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1043066682074485_5433157955189853543_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vYTKdTpTBcQ7kNvwHG-0qA&_nc_oc=AdqBHzHvRazPER_UppCbjEkx-RhX9_GqwehD7Exu9D4nwTvXoLzx8DRRkZM2RRE-bNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmbGxKICxdbLMFugNYnR4ImjtfOcxuEcWkCJsMiougGA&oe=6AFDBF7A"}, {"file_name": "screenshot_05_oil_rig_storm_2560x1440.png", "id": "29956043513995992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_29956043530662657_2210954922870147349_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3K371ARB88Q7kNvwHqAr4g&_nc_oc=AdqjEvfKiLm09tu8CyNnU6OB5G-h8t_2aKPLXN0jv1EDJC77n93Dkqb7oyf_xYk3mfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRsZhKzSw38Y1DYWywXEfx9CRbyAVRrtN35yHl9wAs5Q&oe=6AFDC44D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Seven Seconds Down", "keywords": ["plank", "vertigo", "heights", "passthrough", "party"], "long_description": "Seven seconds is how long it takes to reach the ground from the eightieth floor. You will find that out.\n\nONE HEADSET, EVERYONE PLAYING\n\nMost of the fun is watching, so the person not wearing the headset gets a job. They hold one controller and run the session: send the rider up, end a turn at any moment, even mid fall, and show them the real room instantly if they lock up. A plate on the elevator wall tells them who is up and what to press, and a scoreboard beside it ranks the night: who went furthest, who rang the bell, who made it back. Cast to a TV and the room sees what the rider sees.\n\nA REAL BOARD, NOT A GUESS\n\nLay any plank, shelf or board on the floor and trace it once. The virtual plank locks onto the real one, so your feet feel two edges that are genuinely there. Every ride starts in your own room: step onto the footprints and the elevator rises out of the floor around you. The board stays put between riders.\n\nPLACES TO FALL FROM\n\nSkyscraper, the classic. Volcano Rim, where the wind gusts, the ground shakes and the plank splits under you. Oil Rig in a storm. And Your Room, where your own floor opens onto the sea.\n\nRing the bell at the far end and walk back. Almost nobody does it first try.\n\nCOMFORT AND CONTROL\n\nA No Fall mode swaps the drop for a gentle reset. Covering your eyes with both hands shows the real room at any moment, no controller needed. Hand tracking works throughout, so the rider never holds anything.\n\nNo account. No network. Nothing collected.", "short_description": "One headset, the whole room playing. One friend steps onto a real board on your floor and looks down an 80 storey drop. Someone else runs the show from a single controller: sends the next rider up, ends a turn from anywhere, even mid fall, and shows them the real room the moment they freeze. A scoreboard keeps who got furthest.\n\nOr ride alone. Lay any board on the floor, trace it once, and the virtual plank locks onto it. Your feet find the edges. Your eyes insist there is nothing below."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevensecondsdown.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Seven Seconds Down", "support_website_url": "https://sevensecondsdown.com/", "website_url": "https://sevensecondsdown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1293760890488522"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1263480559286690"}, {"status": "PUBLISHED", "id": "1943613763678582"}]}, "baseline_offer": {"id": "1943613763678582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793649600, "status": "PUBLISHED", "id": "1263480559286690"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1364001246797819", "version": "1.0"}, "id": "1590307525893535", "channel_name": "LIVE"}]}, "is_for_oculus_k
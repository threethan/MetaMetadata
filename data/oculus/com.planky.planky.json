uGYILBNE_COxOcIfAhaGCkVsV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqnFb5C0wm85vkg-plfDBnuV-vW2bnSyGia4OKVStHaw&oe=6B0DA3FF"}, {"file_name": "screenshot_02_plank_to_bell_2560x1440.png", "id": "1659451272417399", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825305_1659451279084065_7423339788349217278_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hz-A_Bg24nMQ7kNvwE50eeI&_nc_oc=AdpFCHG-W8vUhYH_9b94aqobs4EVBIkgi7746uWk73gn742S5a81gWcGMreWJuPT9OU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSZRUbT3MARC8mD6dXWPoCnElyutNSwdMQNIjp6eQ8sg&oe=6B0DC05D"}, {"file_name": "screenshot_03_group_play_2560x1440.png", "id": "1115768140885075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1115768144218408_2168654817407302462_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwTnolNjFfgQ7kNvwEcN2EC&_nc_oc=AdoZ3ET5tmw7MiAGXex_0DUsCL1MuMR-BQdORCb-L6FYoftHHFGyXCjGDYCN5HRhT2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyaeKTDGO4vd2URvSIxZjIty_3f8Ro2ATmsEc97X_uvQ&oe=6B0DA59C"}, {"file_name": "screenshot_04_your_room_sea_2560x1440.png", "id": "1043066678741152", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1043066682074485_5433157955189853543_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh2ZRYRn3ZMQ7kNvwGiVT1q&_nc_oc=Adr6MdX3J58TiJNeT6vnw4mR9JQMlZoYRHDjbGW0dV5CVor2WMVfBrzyQh7TGs_4O-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSo73BmCQ2v9cYRhzBo6S_dfFbM1w6UnRnIoFySw-MmbQ&oe=6B0DC9BA"}, {"file_name": "screenshot_05_oil_rig_storm_2560x1440.png", "id": "29956043513995992", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_29956043530662657_2210954922870147349_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMJKSxJP04AQ7kNvwEDv3zM&_nc_oc=AdqEmBMxLIbjLovRXGUbL4D6p_VxgybMS7S5582NIa4faX-pEcW-r8pr1X83CdPRoMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTY0UrEFb3NJxBp-sBr8RFeGa-pXnAbyVPZxi2Do82YsA&oe=6B0DCE8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "29511648821793723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908771294_29511648865127052_6108900672997378825_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWoz_9VXp4YQ7kNvwFiU8XB&_nc_oc=AdrfHCLpq4xYbsMG7O6keNZuctcIY-m5B9ult-R0h5kPtD57VgSUDkcsHtXgIzd_6wA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3A5KVm3nFdo-1ZRKWZXshGxTv95zsSaoNv5UGOPEm9w&oe=6B0D9CB7"}, "display_name": "Seven Seconds Down", "keywords": ["plank", "vertigo", "heights", "passthrough", "party"], "long_description": "Seven seconds is how long it takes to reach the ground from the eightieth floor. You will find that out.\n\nONE HEADSET, EVERYONE PLAYING\n\nMost of the fun is watching, so the person not wearing the headset gets a job. They hold one controller and run the session: send the rider up, end a turn at any moment, even mid fall, and show them the real room instantly if they lock up. A plate on the elevator wall tells them who is up and what to press, and a scoreboard beside it ranks the night: who went furthest, who rang the bell, who made it back. Cast to a TV and the room sees what the rider sees.\n\nA REAL BOARD, NOT A GUESS\n\nLay any plank, shelf or board on the floor and trace it once. The virtual plank locks onto the real one, so your feet feel two edges that are genuinely there. Every ride starts in your own room: step onto the footprints and the elevator rises out of the floor around you. The board stays put between riders.\n\nPLACES TO FALL FROM\n\nSkyscraper, the classic. Volcano Rim, where the wind gusts, the ground shakes and the plank splits under you. Oil Rig in a storm. And Your Room, where your own floor opens onto the sea.\n\nRing the bell at the far end and walk back. Almost nobody does it first try.\n\nCOMFORT AND CONTROL\n\nA No Fall mode swaps the drop for a gentle reset. Covering your eyes with both hands shows the real room at any moment, no controller needed. Hand tracking works throughout, so the rider never holds anything.\n\nNo account. No network. Nothing collected.", "short_description": "One headset, the whole room playing. One friend steps onto a real board on your floor and looks down an 80 storey drop. Someone else runs the show from a single controller: sends the next rider up, ends a turn from anywhere, even mid fall, and shows them the real room the moment they freeze. A scoreboard keeps who got furthest.\n\nOr ride alone. Lay any board on the floor, trace it once, and the virtual plank locks onto it. Your feet find the edges. Your eyes insist there is nothing below."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sevensecondsdown.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Seven Seconds Down", "support_website_url": "https://sevensecondsdown.com/", "website_url": "https://sevensecondsdown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1435935696271040"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1834016374612662_1693707197223045414_n.png?stp=dst-png_s360x36
3_7805705934631647353_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDIE4p1kb5AQ7kNvwHyaMQz&_nc_oc=AdpOrO2ovBESPoqolCqiswTPopBWu_AzsjAMmDFZAzg2Jzo656VCxGIJ8_Y2QHQ4Ya0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYNUcJ_EeDqTp_JtPpf3Xxg9En8i02KGdHvCLesDvHVQ&oe=6AA2B29E"}, {"file_name": "Main_Custom..._10.03.2026_10-10-07.png", "id": "1314585670535535", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1314585673868868_5095591396090976076_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9ORUG-eSCgQ7kNvwGwR-cP&_nc_oc=AdqYWeaCCBrswaAGLlY9qERfjA7_badVnqfIu_uHtT3wi46Tmz7MOE9uVpYe2USbkk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3nt6wPJQTsSeRYH4wxOnr3wUUA-Za_A9XsWo_LxAeZA&oe=6AA2B5B4"}, {"file_name": "Main_Custom..._10.03.2026_10-10-27.png", "id": "5062945987300473", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_5062945993967139_3191845456349320077_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJuiY_M7g44Q7kNvwEMaio4&_nc_oc=Adrq7VljijIeJ0DI1Lx7Mv_EH2xkUgWZazqe_gVzeDzhSwwf1QriHOglG9WKmQNKFak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIz7YjDsJ9CoKGNJ76bYhWEzIgC9HC8VLMWrXxzeVdsA&oe=6AA2C109"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KillianVRCoverTrailer.png", "id": "1204373965019102", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499309014_1204373968352435_2027970983891149634_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADrQJRdhlsMQ7kNvwGlxMMk&_nc_oc=AdqqVbFTyxXhHHkwo07vvPgafq-wd9cZTGrfkvtmspuNyBQQgKWSKkJPLJ3vQfcCXBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI46EDIS9vSCB2NqBzHveuuXA2MiBSjzH3UwW13Efh4Ng&oe=6AA2D1AD"}, "display_name": "KillianVR", "keywords": ["killian", "movement", "parkour", "hangout", "adventure"], "long_description": "Become a Killian and walk on walls, shop for cosmetics, explore different maps and much more in KillianVR! \n\n---Things you can do in KillianVR (So Far)---\n\n- Put both hands on a wall and your camera should \"shift\" to that direction \n\n- Go to the shop located in Forest and buy cosmetics with Bamboo \n\n- You can earn Bamboo by breaking breakables in different maps\n\n- You can access the Menu by pressing the \"X\" button on your left controller\n\n- You can chat with other people and socialize \n\n- NOTE: their is so much more coming to the game, so enjoy!", "short_description": "Become a Killian and walk on walls, shop for cosmetics, explore different maps and much more in KillianVR!"}]}, "developer_name": "Killian", "developer_privacy_policy_url": "https://docs.google.com/document/d/1iFFmMZ-ex7_ULHvjocnEnTg9T27wkMnlAtNsatqquts/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1QCWf-Oik9hTnbXQimammHu8JSpttAIU9k048TvoggeY/edit?usp=sharing", "publisher_name": "Killian", "support_website_url": null, "website_url": "https://sites.google.com/view/killianvr/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26439756082327236"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305194_3469412889893521_7012931147052652695_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqHuQgogs1QQ7kNvwGz--Ri&_n
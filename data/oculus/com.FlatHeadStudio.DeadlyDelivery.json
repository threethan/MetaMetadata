kIXUvTk47TFYwVebyUdbmVzzq6Ah8ktD-3A2KWl1-DZE5JJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VQLpoD_yOYVBPU_OjZ8aL-PrPDPkmtvLdE561B3dHZw&oe=69E8CC1B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaSE9DOrQTIQ7kNvwFHM0md&_nc_oc=Adqvm6yZug51xsSoGa9baEcS695wSqZOmqH4JqIYHVujtTsnxEOnDWgvqCh-MkT4GOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01Vhfa0Z-Nc2A3V6b8n4VejkMQYZJaj6pkYaCdgse9VQ&oe=69E8A941"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-IXylAp3bwQ7kNvwGHtX13&_nc_oc=AdrdctFjBGE-qGly_Qc1egJMh6sz6IAnLnucGUlQDw5cWmHcCtvZT_kCDAZEVr1DMUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MZtXmKbBNTMmJWOUYXwcU3TOjI-Lbcxx4UUqCRVFUcA&oe=69E8BD71"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkB58jt9vx4Q7kNvwHHcCYt&_nc_oc=AdpRMctNaZxiadDZiU_BiyEiAhwMca4v-d845Ug1EBetm242MfZUEUObPk4s2uHwrak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FHIQfXCZ5gevWVawPrystwr0h8FodxF-lVuJTBjOPww&oe=69E8CF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "1651767005867775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1651767009201108_7558431504128033477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxIfNn4fgFEQ7kNvwF3dhB0&_nc_oc=Adrw7f-0EgenAoYfmLUztKKqZnmTX3xF5fhoRuPQ8SZbD43Th-LrBt0Lgzwk43f1pAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ffyLMDrvosW5kbZTdqyMoxgZ38l9CuPtxhog2T8R0Aw&oe=69E8DDD2"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "conte
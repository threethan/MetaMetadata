pFKU_7eIgsjrBGvTkDXOZhS0xCcJ1hwmuqjo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4brS4RG7SRr1pvwyRRURGzVj5NdXTVPtNY0zxSY_x7Q&oe=6AD3AF5B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StljiRYKsAUQ7kNvwHNjzEK&_nc_oc=Adp5ODs8KknQLTOee6prauZyXcEJXmEq07Dg0QiaKo7GV-oXYH4aK1YxEkF-Qpw_4Js&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjFThuru2MHcTn1TpVM2zXCoThUzlva_tX66aOmyOXDw&oe=6AD38C81"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbKhH7EoTJIQ7kNvwHnhGgU&_nc_oc=AdoK1WIKzWZhR7EOqpCxYyQx2-Iop9EvhF9Cjp2APeVpXAx2KlUDm2B8-chydaUDASQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsoQKkXTI6DivWsutjYcbMLVRJGkmTlCgTfZMN1lazRQ&oe=6AD3A0B1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F918XkIaMMQ7kNvwGegcAf&_nc_oc=AdoD2eX92elp3lsPVvzclkVDO3fAxMqUoJIwEFWMi8Cgctr23pm34LjDmEhA840wZ3c&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN865iSB32vEXD2fyUesGZI5ALISzcKKT1ZmPDNDnN-3Q&oe=6AD3B243"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1577349427053031", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673780696_1577349430386364_3599158064154897931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FBlaM3RSfIQ7kNvwFCnZR1&_nc_oc=AdpQQKNAYIyi6gHj8GULWhaOjCQb3sCHHQaXpzK6mw9DoK3WevDwrUcKd70McMDk5ug&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNttPSl3PEbvTvY_jmDzeg5SR_HnYUZyEVgid1Xzqq4VA&oe=6AD38986"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "In Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
j1ypQmVidXnaFBC398WVzSU5Id468o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BYT0OO-B7Ra_x-8A1hHNpYuAzjE0vQE-ajG0h7sF3pQ&oe=69D8FA1B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNrYn1gEsmsQ7kNvwEUXXxq&_nc_oc=AdoWGognDfekSujLY1NB8Iv49kzhuRbD_obbcyExbyLJc-QFPKgs58txLkO_uIX64RQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lGvM9IJpftgwu9nMwTrzEf-ZEl4Zn6rX5pnNd3rx1UQ&oe=69D90F81"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxBU5lBbypIQ7kNvwF1m7qO&_nc_oc=AdoTS2GLkdGbjmWU_7UB-l7kosB41ag1CTEG0ENTrgfSFtliJtEJtow8xgecZzvkzCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eWaaA1UFWyYyuys0VaTEyzJaogiG3T6GqXkbmIVMiLw&oe=69D8EB71"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FicqEi03wW0Q7kNvwFDfGGt&_nc_oc=Adp4S5yXJApKsui7tn5r2y0S10JoKwuWiEwyW6NIij7wTPeyC_V7AUKFVzVJSyyE7gI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rD8a15Yds05RZ_ygZd8aJQTRg1DMarY2Ah2V1GDseig&oe=69D8FD03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_07_easter.png", "id": "1269107215400533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1269107218733866_644835111469220646_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFa7-9pvLMMQ7kNvwFpnrL2&_nc_oc=AdoJlVecSsjAHUISvwl_XtsUhZZHS_YKym6CAPnTbjFD-pcXUWtex2GonSuB4m2A0i4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14VUmRTd27LO-DpxRgU3-MR7RJAAu_FQ3JLgSkFRRvuw&oe=69D8E5A8"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27
mDb5zlpy17jmvnN4P6h12_cUdi9x-UkZxAWxFoBd2NpS3DckgsSpE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1haDZkT9zaGj0p3UncD2InSKhR3A6q-jLxWNBjlObRg&oe=6A85AE9B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJnV41dzrgMQ7kNvwGE0yS2&_nc_oc=AdrH1_erc8xEQUHkI6M8w7qoYj9_25uBiVBrUcBPd5By_NPReBPMt_8D2AzN5lUSdmE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYmXS8zG-CazC-jWi218qQN_5DpvkbHJuyQpLp7VZRjQ&oe=6A858BC1"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ5GM_Sc5xgQ7kNvwHIWBSO&_nc_oc=Adq7IwJHmg18iEnzgoI_hh1ubwuUHQXnCcHX-R6Nfd3pcIoxX0nP7XBmhmnBrC3bVbA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvZH1t3xrv5SZos-hzOAeh5b-y0qMEEXgiKRenBaDJHw&oe=6A859FF1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxtscFZHMDkQ7kNvwHfsJ0k&_nc_oc=Adpr3Q7VI8IqjZ597rDf_30Zag2vIkuBHIbZShhoyAn6npkYEk2yRa52ozbyDbFOvi8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGhaDlKK4za80JSPqG3DH3z2HwJnZUIWCaMqD4iTljIg&oe=6A85B183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_08_goldmoon.png", "id": "1508503193997973", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499308307_1508503200664639_4415398320502851739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x46X2AawJ5sQ7kNvwHIlqzC&_nc_oc=Adon4hBTxUha1OW0JIC_l1NRciHziUJXSScdwQ3YYXSam1gpC9ufi8SXdR7ZuhAeMlc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmnL97nAWWRTYKrS-mCSfjYdlKpXaOASlYEJu6Usz8bA&oe=6A859C56"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "# The Goldmoon Update is OUT NOW!\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "c
c6VYjnFw1pUb7dcIKnkuhbjCD41yIsogTzm0YdYaXOYduIA-vOTIE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBL5_Aa_jIVLfpNa7PNOQel9H6gyY2SlPnb3jURSwexQ&oe=69C9281B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwSAUEjmQbUQ7kNvwGrKCrO&_nc_oc=AdpiX8km1hs9-I_9UO8Vn3DvwCgOHN9Yvy_0Hr-V46NeyuEUFhnndEAU8tgjzVuHQ0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7p6iGWSO9cwOKBVD_Clfs8SnVQQCBWeARzaN52UeQ5Q&oe=69C90541"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBVal0pQTbYQ7kNvwErWkxa&_nc_oc=AdpyHnANYNM_6xjf16PI0u6UvoDce-tY3E9tKRI3gDhK8hpST0HH9kTGOwxMqMBKzTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_mTpOE1LekRCoTXBooJT9HmtGYLBXkLHnneKdRR6o6g&oe=69C91971"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krer7wiSZkQQ7kNvwFPLet5&_nc_oc=AdpkppAZG4Gf2bBcO1tEFevRPwZBL4xD2_oOx6yyywaWoYF12c-zr5MIAe4IWN5Yi60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyBY3J2iju_DVQLywtTBhgNY_rRK9uUfZIPb_tv2lbPw&oe=69C92B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "936927565648488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_936927568981821_6562378778726474409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wsTUl4wQJcQ7kNvwGeALfS&_nc_oc=AdpytFnUs0ZMI2J9fmnQLS7u96A3v4rrs1tC69Jweh57Ap3udVFzZMTGU2YMhBWoj5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYNp2tlmLiooZsZJk6TG4N_Gb6CgkPWF8zd4miNolTew&oe=69C90DD6"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
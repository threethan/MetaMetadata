RwHD86tEWMuhewSu_2yrMbT3rglwMmsdG48Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxfdFfnqnXg2vVO48HyCBDO7QayUHq5uNf3uNIQX2tJg&oe=6AB6761B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=310k4se2an0Q7kNvwGCylFk&_nc_oc=Adp8TZKWZJfHq6gj6Z6k1adXIWDA639yy3Qa7goXShzZPatqLppN1I9eSipXA4zVJfg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJej-O0ZPxquHs2n5bfI1h9_cPXSHXgJOlTDmCd8vupw&oe=6AB68B81"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui_4GUpZQU8Q7kNvwF_kg5z&_nc_oc=AdraTqgomcKF8AfCzKKOjT9nAGZ4zJ-rUd7KVqcF80iJvadib1PHH-vDs8JZk11BXZA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLIPvSBoBp2zcp1f-go6NecVN4brIfz-Hf7JDzgJYOag&oe=6AB66771"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZRfVkrkdC8Q7kNvwGK4ycw&_nc_oc=AdpZvPYXD0eVJ-S7JOgzXBwMUkpECuIJXqxsWoaJnX_jXxM7wDrKt8mCXuBcWxCp70U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf6v-Peq357IObFg9jPfNj2mt80gTDV4ZpMVeQKO34Pw&oe=6AB67903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1577349427053031", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673780696_1577349430386364_3599158064154897931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqmmYgKFLzoQ7kNvwHKVVZn&_nc_oc=Adpdn8vR_gi90G5_irfc38ZOkxwwLLQPoG5Qqfz9hFakS75Dgu-r1BX1qr_BHVH1eqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJUBqwRan84RBdtEKzDshS_4qVcxhvnsqlh_6p3KQUdA&oe=6AB68886"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "In Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
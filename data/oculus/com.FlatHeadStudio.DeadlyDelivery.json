l0Tj0w4PytesyiZy7YxAsXxmC9P9K24APr_Uodk65dZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbsVXzdhc8cOZQkPTzIH-Mtno0MvDNWtV6-3YhhdIQXQ&oe=6AA7F59B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dyQmcG5AdUQ7kNvwGRGMPF&_nc_oc=AdqKab_NRYFilwWBGzeKSmGACk7KMc10MhhzMzrrrs3c43U0mmfw_NCKcA2fnb105JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnxeiWt6FEIcKMA4A9QLAAShPnEBiWIM8dTnigenBkNg&oe=6AA80B01"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utJNm2rVpf4Q7kNvwHsmxlX&_nc_oc=AdqyZ_Miuj9Nbox1I_qN9UFMz0i7X8TSE0BLeYnfyV0bV3hLwZadXa3fgX4SDdDQfJM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ_uGQXL6hod-VNcQ3EIGLwQVvmjSRDYtvG1iERB8U5g&oe=6AA7E6F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYiJFIIxG9wQ7kNvwHpCZPy&_nc_oc=Adp4zeDBEjUBVFtpHtPfJvM6jaKFLusmriPB7tRbTiBrc6vSFAOAMEuF0BYl29-YJ4E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoweiTpuT_xWRFeJOTUYrr_dl3Fv3sTWVP9SF0gAeuqA&oe=6AA7F883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_08_goldmoon.png", "id": "1508503193997973", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308307_1508503200664639_4415398320502851739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HPaWSv_T8n4Q7kNvwHxaP-d&_nc_oc=Ados3vP4rHTy4pDvbB-i5kZMbM0ewzGMg6CZPm6rBj7JTQT29Rik8gMfb_nj2vyrym0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDZ7M3YZuaNR5P7r4J_Vhmk4ILjNXy14bmfZIsmniNaQ&oe=6AA81B96"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "# The Goldmoon Update is OUT NOW!\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category"
ng&oe=6B045444"}, {"file_name": "Screenshots_2560x1440_DD_ParcelStacking.png", "id": "553200994506830", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393841_553200997840163_8421225844214804779_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWSETFbLlGIQ7kNvwG3sqv0&_nc_oc=AdpIv8QdrPovn4oZpoFCEkj_QhONfXp-dBrwmtPuXnvQKYdlmquSOgmwWarfv2sMDGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1ZCrm8jzzh6SbULRkSxwI4XrO_rByGW5CYl_slYPnDw&oe=6B0476DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "560042380474257", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_560042383807590_668531239392494770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RDKMKGWdJUQ7kNvwEL0Hmo&_nc_oc=AdrqnbbpJBedZQ-2juIGlPnJF2CP8veWE0LKG1_WFat3wpXZzqbCYXzX_XmGcOxcf20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNlSIDUdNg_wCTfUB_YFoJJerp8VHpIzcfz9r2kjeiQg&oe=6B0464B0"}, "display_name": "Deadly Delivery", "keywords": ["Delivery", "Lethal", "Deadly", "Multiplayer", "Horror"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. Armed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive\u2014or watch your coworkers get picked off one by one.\n\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns \u2014 or feed them your friends.", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP"], "id": "9960794313985275"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1441999663977361"}, {"status": "PUBLISHED", "id": "1053421600819879"}, {"status": "PUBLISHED", "id": "1951770302156089"}, {"status": "PUBLISHED", "id": "1951602925553093"}, {"status": "PUBLISHED", "id": "3291728004339094"}, {"status": "PUBLISHED", "id": "987937930555094"}, {"status": "PUBLISHED", "id": "4358202077759058"}, {"status": "PUBLISHED", "id": "1399465801927836"}, {"status": "PUBLISHED", "id": "1192022925871225"}, {"status": "PUBLISHED", "id": "1169205141948722"}, {"status": "PUBLISHED", "id": "1899806480911772"}, {"status": "PUBLISHED", "id": "16075971
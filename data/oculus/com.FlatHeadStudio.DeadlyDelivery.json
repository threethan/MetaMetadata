0G9W3kHULGTbcaFW54w1KIY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylxnfiQlAFZkBNFeturQ9uR0fWNnASOGXV_lFuVPQ75Q&oe=69BE9C1B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncDAG_KDTMcQ7kNvwGrtAcz&_nc_oc=AdmWOEkC8AUMpc23uO-wzETJmk5c5rKB0DnN61QhTBzljX_z5d_f-4lI4HfxboWVWj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLjMyf5D8tl4mMmMnq5cp4VEhfeTPDkq0RUJ5Z3qRs-Q&oe=69BE7941"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDud_eHDcUwQ7kNvwGOhDjH&_nc_oc=Adlfao68NteJYzVDwBbrcUiQzMXRRmxIB9HGdgUW_H6BYl0gvI3_cg96QHd5J3Iapb4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwR9-9_NQxAqXKhYn2TJwFfqEwlVplQ_8990ZLyj_veqA&oe=69BE8D71"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBcpeA3s48cQ7kNvwGG4QLI&_nc_oc=Adm84LJn4K2-40YuRAtTf90NqGtbM_V1qnz5Y3CIML_U31vwq543IYFunNS1bJZmBoc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyRP6sv8djCwDobNlmDkLx9Znjluh2UWhATMBCgYfWNEg&oe=69BE9F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "936927565648488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_936927568981821_6562378778726474409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQC-WPnkngUQ7kNvwHyL0TW&_nc_oc=Adl3qm5uZt-QVA48lpQhUYT4DEyWaVcMfLxhbT4VyI-YO1aQqx0aVwhk0Kw3obL8kPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycCnuMl9MQjt-PaTfdGT6vMJt9e2MD3HlmyHvIK6OBLw&oe=69BE81D6"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
_nc_ss=7f20f&oh=00_AQBFU94cJaUcuAVPSP8Kp2dl747cmlOkA0FZ3aOoPwICAA&oe=6A5CE581"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqqrD3Nhw2QQ7kNvwHb_jJ4&_nc_oc=AdqwyxXWzbYyh8tN-MN-Wc1inogrt5ewzr2GIOAx0yvfjxU4lDE1zpZw59hZ9Q5JgfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4TTp3zmRCNTbH1YmsPcIFoFUFjCLbb3sdtothaIydKg&oe=6A5CC171"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apl3pkDeoJEQ7kNvwErQwHQ&_nc_oc=AdpHZGxhHkW_4zSUaX1HJbsH_2eLL1FQcSEOo9gmQNqeFJxdKVm-TaVs21YtD3KYFG0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzvlhdHoa5QANF6grhqw203YacCCvkuUncFqNjo1wMXg&oe=6A5CD303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1019924240937629", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618481_1019924244270962_4873784742797214001_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGJtQQrZywkQ7kNvwF8JTZU&_nc_oc=AdppclCcr7qeJPIenesF8KvXX7SEVplv4MwTmoWCu-4URa3-uZZtJxzgBPVvXuaEbtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt-oJKvJhkvQ0kQ8KG7PXy3HXwj-cFJQ-yfxaWyT1gvA&oe=6A5CE471"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "# The Goldmoon Update is OUT NOW!\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING",
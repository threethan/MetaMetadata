eHSfbkYho6wJZQMXEeJUoE97LTmBetpO9Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yydXPmbxhTGgHU4o7kTrLpg5PDb4sWfPuguCcIAgY3Q&oe=69DF919B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Djdae-sInaEQ7kNvwHRMvFB&_nc_oc=Adoire2rXXtwEi-NiI6CZLG_kf-gD-ugVPYpMGkK9ivkfeA-DeMUEPVQXVVqHgB1bzA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W71AkTgOwhFMH38ItCZU6lnsZeSN7zI-aGjFx-i1SRQ&oe=69DF6EC1"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YcfiXryyM4Q7kNvwE3imnV&_nc_oc=Adq4eIKkn8ZjO0lVIVDP4V03B1TSKbRN_yDTqABs7P-Ucb9OqnV6IhfQmBiXT19GnZ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NX0A-6LXXjAjftlsyBUBWM4V8c-Bkv0dIK2IEzQlXYA&oe=69DF82F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h88WsdlYEC4Q7kNvwH_jBP1&_nc_oc=AdrgkndxuR7XnLcimOv29Q0MWEP5OcNh3pfYELO18IOZGXabm8GEE-VQqyF5kPa1sBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rBRt86wmyvdrpqh51KSRZjcKw576CiPO0C5y8v1t-Iw&oe=69DF9483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_07_easter.png", "id": "1269107215400533", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827973_1269107218733866_644835111469220646_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dD-ZRguIHQQ7kNvwEBc2c6&_nc_oc=AdqAwwQXPFj3NWdWkJTBoOJKQ7pQI136DxzqprQULKf1xkGh_6K8aaRjN2wSxXKe3OA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ierXyPJFJ4K1oXtufGlaK6QQps2RaPIF1Ud9sKcCQzQ&oe=69DF7D28"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id":
54GxhWXgbeTuYktnBz5SgBNwbFaUZ0jCW8ZFXPLettg&oe=69F0B51B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33aT9pzey6YQ7kNvwE9cCnx&_nc_oc=Adp2oUDEk93ax7oZ4xfNjN2oPtmXYXE5g_3rEM_NQr53gRLv61NnN9iZ3NcTeCB8VL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af177ntA5VV1Ku5n_5wgU9MjjxWuWIap8TRytLXv1kNkRA&oe=69F0CA81"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry1vSzlisbcQ7kNvwF1uD1b&_nc_oc=AdoKhNShBzX3pEpT6kn1pwB85wfCBJ7OQYHKWnlcyChVZNbQFmqyymcBPCjO4H466Q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0BB6336THUyN1LAJpv719lThvFbj9B89TrvmEHe3DFfA&oe=69F0A671"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Te0ouV1mM0Q7kNvwG2xxr6&_nc_oc=AdpA1SitHAdpzF0QAi0PKkfcaOdfr6h5uy0HwyQtzB9YEV3IB_JfoWLV6dW3-GpnNnw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af206vd_TkekpbkP8x0ReoooHwcwknH2xWWDXGYIOpqm0Q&oe=69F0B803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "1651767005867775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1651767009201108_7558431504128033477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHzuZQdICQQ7kNvwFfGXD5&_nc_oc=AdodMXPalEQ4Er9ijFKzTuZ3m801dwzaTlvZS_sRRHi6xuGFYbUgr7eLFy2F9FgzLUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1J9XvlRxq81o_myV03BOsZk67ubNu-fzHTxlR3PP_NrA&oe=69F0C6D2"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"
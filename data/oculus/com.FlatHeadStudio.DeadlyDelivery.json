m&_nc_ss=7f20f&oh=00_AQCbca5u1K0ToT-q6mrKhLZf1Z0yks48i8Q3HO7e29TZKg&oe=6A60DA01"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4K9I0LRUAMQ7kNvwFXedqu&_nc_oc=Adp2M0vT3BEq97di7oidU2XhAun7iZwr-7LVm6WBYDiogk99muUvk2htZj5QsJPrYRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0inYlfyomVh9Yr45mzdqBjmg2cnMtQ-WwjP9B7OAKDg&oe=6A60B5F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tsd6chWdvO8Q7kNvwELZzQn&_nc_oc=AdqwwKZl0InX-KNAJDQgLur5rMtVjWf7f9VIuwF7EeDGcHQesvFTJ4wKGTDpuLdq4fY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdhAKN4SEV8zj1JNRLM-HET_Y4qJaz1crk2XLjNwaCSA&oe=6A60C783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1019924240937629", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618481_1019924244270962_4873784742797214001_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFE-Jpr-sMUQ7kNvwHz4oUC&_nc_oc=AdqVaWpGFx7WpmlKYD-_gg2uBiuyR4D6eMOAJJEE4BYlS1KwnFFzs0y9C4DGs7y2Glw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfWUGPRm2g814FU7qucCr9asIsB6XHpWtP4Uh8IEdoyw&oe=6A60D8F1"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "# The Goldmoon Update is OUT NOW!\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
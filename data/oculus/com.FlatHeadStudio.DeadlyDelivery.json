7pJEBOFejFjJhc8tSQ6H0zs3hzlstTqBzQhWWWwGYkxf-3XZY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yc7t89uAeFH1VhFFaowlrHNDnTWa6s87LmDhUj2WX3g&oe=6A39379B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPj2h16ltSUQ7kNvwEsTvQ7&_nc_oc=AdoLJP1BiKMXvdKmme7Cb433FmAiHbsrNzPgEEaIYm0qDVERW2p1JA2r_ThZLxd_V7g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YPu_rhC1c01tc-XF0xetvuLuHWBh0ZCEjWVxJVO21eQ&oe=6A394D01"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00K6qhNtVAEQ7kNvwGqLmTj&_nc_oc=Adr6vV9ZY3EaLHhiv6e84V1oimtK4cIM3H4WeL3xhRixg1aUTkSdjJ3E3L5GmvjusJQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--4gl9f8bUdHVhpspVOEQQ9hAuE2S7-sGUI_ijDw5rlQ&oe=6A396131"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KmynW5M1rEQ7kNvwG_-QOl&_nc_oc=AdoxrcyRdBSJVp-UPgYkaycVl2wcURcA3UD5MUz7OeLy2hZZWm3jxG1TfNIVamta1gQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86FWAx5niQoIxpmC-3o1rnozPZUZk4fIA4pJNESLz7ZQ&oe=6A393A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_08_goldmoon.png", "id": "1508503193997973", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308307_1508503200664639_4415398320502851739_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKS9Cm7iM84Q7kNvwHIEAAV&_nc_oc=AdqYHl7u-YWFc0eSqZXOn56T88Za1A8tWuHxsCacMTbIPHgd1PCOt9jymrIwiNp7ufs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ENmRwtaEgCUPBOyuBUWZ-cC59iI_g5-M2e8FmvKqPDg&oe=6A395D96"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "# The Goldmoon Update is OUT NOW!\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "cont
-dNZZs6EFUEabgKSMpr2tDed6fqOq-02WzLrV9UZKaWV_S60w4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cae4upP3PLmIWrZmofhMjs4DqG8ut2STOWfog9PF7Lg&oe=69F89E1B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEo4P5-cT98Q7kNvwEcXr0E&_nc_oc=AdrNgBXkc_f5JEvh0AyhfKsIh1K4zY0kCrnFJYLtLRMn00Is7H1JO5SYO3zEPyaTlgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3tNwOq89PYuo6gElwVF5WMeod1eanEmtdg0TmUu7YQtQ&oe=69F8B381"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzaZVGC2u5QQ7kNvwGWjv-Y&_nc_oc=AdoPgp9pae5mtTbgwB2hoRX5qajWfEcvqN4PX64RN82VQUoBpdA3Ajx3qHZaFiUh38w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Hk37LR4L8lUbyw2QqGr4-RGzjgR1W6NIyumwng3M4zQ&oe=69F88F71"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSKeKpTTCGMQ7kNvwEeCUrZ&_nc_oc=AdrsbB1-2LVDwBwittE7dMmf9JQETIXXWEVuMm9frz_3Xp8NQwYgNuYD5keB79_1Lj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af126TQNMAx5yr27Utr6ziLSAS4ddHedIYfGR2eXncBigg&oe=69F8A103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "1651767005867775", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1651767009201108_7558431504128033477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qStDiD5kWA0Q7kNvwHettFo&_nc_oc=AdozNGqQli3gqCBgwWplkPYZ3P2W6CPGliFPE_jf4UTyc_1gDTRkp7_5CHJLf1MgZEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QSWqCjt-yZLeIypB_WkmW39Izwz4Ich9zKbXSR1FEWw&oe=69F8AFD2"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
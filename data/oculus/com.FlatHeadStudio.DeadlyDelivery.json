iR3G0lLf5kP5Xzk-AFvCnIr7pGCZnjhiaXPdj3ZjBSwEdJaQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0x9mBXc_6xnEHjYZNe_FpC9a24legNUFA9Rg5NEgxREg&oe=69EF639B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5U-02m7VI0Q7kNvwFye2W7&_nc_oc=Adr6CCvQEn_WFozZeXLvxRqW8CVf6ScGXaIjzcmn_y4sQBXGKkrKb-WKRIkpDqy_15o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JeLG-2FMGOftCd4uSc74fHTC2d_THGcfv6RhG2qAHfQ&oe=69EF7901"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ry1vSzlisbcQ7kNvwFBnbFT&_nc_oc=AdptISx-KOa8h2qHxKM0DBjqs3wqhGiHdnMED7WW-m96SiBN7oIsDowhNYB-SW37T8o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mzKl5bOfX2A2V1dtRJePxB9shxwp_ubGia2nykabeKA&oe=69EF54F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx-7Q-rpN3MQ7kNvwGuCWGG&_nc_oc=Adp4TiH-Kud3lhzcG4agGoW028ZorJHLc7NUB53c7zbpnnI42QFLoBRFCMk840_hQ4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cwaGmQe2kiDsBACH5Z5a65Dw0fJEtvjJSRv81cjeYvA&oe=69EF6683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "1651767005867775", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617729_1651767009201108_7558431504128033477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9BGXKfmV9oQ7kNvwFtaZM9&_nc_oc=AdqEnV7-dZTi-ukZJ3xM63bAwSt_6C31gLu06A4c5_NNvAlf-kUK9VOttUUN6uimBRk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F5CXwNXnz_wH-53at62qbcrerGq2vvVT88ML8oC8Ucg&oe=69EF7552"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "conte
ii2Hkq015FJTH8keMkzo2Kpg4BSH9TEIqo4jkxJxbKx30dAoSyLWONU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ur_NYG2VUpy4OGP8MsETGnSv0mdofoIq4vwCo_s5KMQ&oe=69D2629B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e8XqQe3PpcQ7kNvwHEoJ6G&_nc_oc=Adq_ILnwaWq8MohMM5kjX0bwXNacMoHWSELqQu0J2sukShomPdDTOAPSynG2V2Z2KS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39qtTX25EBVuwwLMXlcnq0NrJ69jtVGS-tVvZCJ-xm5w&oe=69D27801"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV7DkUxmmK0Q7kNvwGRi1yc&_nc_oc=AdpwJhnCEjCiz8DG7YvNUmvWRoaqrt0lhG2iBko6R1jr0shS8YkmVhzNp-yYl59nlfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05FM_yB5syRCtc2aQxp9zxlzie2VLI3TsJer5RWhEImw&oe=69D253F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9-0f3sgpXoQ7kNvwFG0IOw&_nc_oc=Adqmcni_HIbV2xAwyayE7PCE1istjzaIgQl3-t7uUpKMLX3b-XVu0lwotlfAyfdR868&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UrUzRwL1pv8SH9E72WunI_jcaK6ubP41JpNpInjesxg&oe=69D26583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "936927565648488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_936927568981821_6562378778726474409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tf05TPFM_wQ7kNvwFTA7ho&_nc_oc=AdoJwWVtsMPBfoOyp4UeF0TEHMRr80XVbFxv1-gwRU38UDdfrUBu1IhrdNqStOpkHxw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IacZVBO9Qjnbe0bvfnFFRxfJ5ZKBiKOUPAITq4fQgxQ&oe=69D24856"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "
uZSi4eVmi5swWwc_kF1VS8JWJKSrnJ4HjOjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjjTqScdbY6VO_-ux00zGQc19dKy9Ew6qyFXpPTHycuA&oe=6ACB8E1B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUa9xxPy2ugQ7kNvwEQXuik&_nc_oc=AdqX5Lh1M7w1IpUQEecb9sLSBHlDEPYSRsT542vx9zz_FetVCgNWY3QQBVBCXGCSwkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEFGuM7MPuO12D58yR90TWcE-OY6-L7DhUABnM8DfGNA&oe=6ACBA381"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKjON799HrcQ7kNvwFJQXyx&_nc_oc=Adq0s6_zNhGGf0JUEimNOYrcjBalp-1FnakZHKqlLVe3x0QXZTNNY6I7DSTvGnk9kTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVWYSclVfxRXxyj1wAYRTPc-TXYWGS6mXa78SufxqmEw&oe=6ACBB7B1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QR2iYDLcNkQ7kNvwEIvVKy&_nc_oc=AdoBPs-WMk-79QcCkM5ra3-swm6NKfDlyYXtFNX8-VwtthyXOzSFXeNUsxsUUXLbHcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtuUJxwWEbBJChs9FFJ1O98xFkc52UiX7cvAgkJ_zEMw&oe=6ACB9103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1577349427053031", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673780696_1577349430386364_3599158064154897931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_63abC6QFPEQ7kNvwE9UMuY&_nc_oc=AdpPSPMl3yAy2FRsRtvYl-IpWVuv-HOyzw-CnnsJaeXX15VtLfNohYuJGqaMGKfrkSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_8QJMRiT2iFthEfg_5wH93L026UnEeWkrVYUlIsuC1w&oe=6ACBA086"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "In Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
-1.oculuscdn.com&oh=00_Af2iCBd8LBhw3u-kW_qK0zdIaJrsDC_lHzXR4MTnR2dRbw&oe=69F2069B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33aT9pzey6YQ7kNvwEq6kmX&_nc_oc=AdoWqWTQ-yvIclD15V5RVeVsbTAebhVnCAeKmwvZvtyyvmQGof_1jRQ-nFUAosC4W94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2k8MPxxV8G6f_Id5lVHEn3JnzeguXuktYQdvMBxmAO3w&oe=69F1E3C1"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofdMWJVyYKwQ7kNvwG8nFUu&_nc_oc=Adqdrfpcnk8LxtYgePKL3Rij12gQG5v8BrFFIB5oeN9rypNdCKq2Jfc2eUBITGex7Ho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2DY6UPKfucVWND0Ndr0YCgVZ0J2KwgOIA8Dtc5Q7SOsg&oe=69F1F7F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Te0ouV1mM0Q7kNvwE6LZ6K&_nc_oc=AdrfGU60F-hNTptn4UAgm6fHOosEDdgI3EV1zYuJ3JuDS_97KrC7WCAXIG0WQUvC248&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2e_lNUF6ORhs-VLXrHVJyttHd3i40LIdupnv7HUFRTyw&oe=69F20983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "1651767005867775", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617729_1651767009201108_7558431504128033477_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCHzuZQdICQQ7kNvwE7xC7K&_nc_oc=Ado_xvKMn205prQIh4vrlQmnAxqedmP8PTiAXjWPMLF1yoZweI1LLFWKge4l6PtkFk8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0P6leuBfDKT9OGYBmcyQdg0wnFbH2BnvCAnTPcCmTJ6A&oe=69F21852"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "4597
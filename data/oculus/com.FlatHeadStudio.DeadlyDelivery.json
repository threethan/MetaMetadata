mMRaUabrbUY1vGYJGiaeD-SdbEWGrNCskQTuIn4LtpRJNAratC8yA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlWSO5NZJtqUVd36mUXWvK8lTmEWitUR9S1S_deVb3Jw&oe=69CA799B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUthdWMxt4kQ7kNvwFnPit2&_nc_oc=Adqh3eMYwbnZI7Y7608izxbl73hty4FO9bbxs-uj29hwoFpNQxvFTcvgyBmHkpMIaMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhwvWK-Id9YA2j2OumF-W1enGAeP5rJHIotOzG7XKNug&oe=69CA56C1"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzeytZmtmvgQ7kNvwEKWV-F&_nc_oc=AdpQHQLVBgjLvdLcb0leFmOUnmnAowCaTo2QYTfurmXMIITFEAwAcFIDjRTRTpzCB1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvI_vXesDQlTxiXMZ1COIC2GTdFNe3WjXKsgyG8HkC_w&oe=69CA6AF1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krer7wiSZkQQ7kNvwGiQa1P&_nc_oc=Ado_qduAKamC43wgBQDh55rvIK55adWQoblGV-XBfrP8NOAyf-manAAW9-U0bnu6Ers&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm4WW0OVn9gp_wB47mbhW9HO1h5d528Q4IZA5hiZlaWA&oe=69CA7C83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_06_parcelEnemy.png", "id": "936927565648488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_936927568981821_6562378778726474409_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlVMjcsBD-IQ7kNvwGJZ6ew&_nc_oc=AdqqYppgAJY6hMudB_-BkF2anzLW53pnMzP7ydAxzxkuBj0A-HGOcktsNl4jjL291Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDegFCFBWfu4Hj9eCxUWwHNQPnpEF6hCFvrGZNNhA7iw&oe=69CA5F56"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "discord", "lethal"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "co
N2275gkfYIDL9JmI2gZ5rWj_g72kq-lMN0Sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY8lG4IRBvPyBN42ZWh9KTqwKuDtMOclmX2BveJfPmvA&oe=6AB7C79B"}, {"file_name": "Screenshots_2560x1440_DD_redlight.png", "id": "885485973918344", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_885485977251677_236459379275901057_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=310k4se2an0Q7kNvwHOqSz4&_nc_oc=AdqlNNodnGiICW-PO5owXn7jcxHnvv3grQPwDTQZatqsmL1u00s-LnIvhfawKfsrfm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIatOkU1-M_xhjS5QmtgQRxuaePtniYT_2ytWpknxHq8A&oe=6AB7DD01"}, {"file_name": "Screenshots_2560x1440_DD_treasurechest.png", "id": "1554385379036074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1554385382369407_6649834865537826538_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mobsxFNsXIQ7kNvwFSYv5L&_nc_oc=AdqbfdNztJ52o7CjG92XC1glb7l2MBnHr0_lFI40DpJkapid9M0B4Sp70qZdZaMRoIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt_SpyiEUM0JZoyLneAekKwLTt-5Qjw6OCL_EDfQ7J_Q&oe=6AB7B8F1"}, {"file_name": "Screenshots_2560x1440_DD_rouletteGun.png", "id": "861787259535773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304162_861787262869106_4083471127808216396_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZRfVkrkdC8Q7kNvwHlwsdq&_nc_oc=Adq30na1ERfbsoBQlwQaic5f96n0PUQcIIlhz3g5b9uPViQ-MvYlOI5xd_7qyDrGJko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaJypgD1Fo75yVPHjjzHu2hWmbWaPvKcie1d0ZuNOAbA&oe=6AB7CA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "1577349427053031", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673780696_1577349430386364_3599158064154897931_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey5SGlRMCNIQ7kNvwG1L3tF&_nc_oc=AdozuwuEv0slrF2dQVZa6JQbpvQBOyWEzq5G2kCeZzZc6wN5X4PRZJ9mlCP0U2de9hY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY1csIlPqX2jxpDdSYApkojJlBzL83yj7Gc37dJpyO1A&oe=6AB7DA06"}, "display_name": "Deadly Delivery", "keywords": ["Multiplayer", "Horror", "Company", "lethal", "coop"], "long_description": "In Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. \nArmed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n{9656622597769756}\n\nJoin our discord to be part of the community and find other goblins to play with! discord.gg/vxaFQr9jqC\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive, or watch your coworkers get picked off one by one.\n{671974505659765}\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n{4124201431128214}\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns, or feed them your friends.\n\n# \u26f0\ufe0f Progression\nLevel up, upgrade your gear, grab a pet, unlock cosmetics!\n", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio, Creature", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
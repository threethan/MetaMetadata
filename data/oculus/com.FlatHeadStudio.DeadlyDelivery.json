ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393909_610206125407966_8943337466549821229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdhwWQG6d5AQ7kNvwGlsoLR&_nc_oc=AdojO4_u-IK0efw2k_8M2vltfuocdpQIs2mEI6I_0wx6YLlJ4GupzicuKQO0AGMh9XI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVm_jVBuabfym1zuq0dRTFwWx6zNKHGHRu1UNBqvav3A&oe=6A636910"}, {"file_name": "Screenshots_2560x1440_DD_DoubleDoor.png", "id": "739262415278358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393444_739262421945024_4016414250370504064_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJy1xyAArmoQ7kNvwEiPou7&_nc_oc=Adrc6uFUBi8XI3BHI_k1DIFJBVLBLai3hNyOo4KPv4O6zYCEw_LTgEU1WMgq-vptwPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGqf7ufxIeOAkrpUz9OEt7ajY8s3cCLImQa6WLAEUi8w&oe=6A637D44"}, {"file_name": "Screenshots_2560x1440_DD_ParcelStacking.png", "id": "553200994506830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393841_553200997840163_8421225844214804779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E18kZKf1SsEQ7kNvwGbtgIV&_nc_oc=AdrWZfcVnRxV8LC2-paBQTmKmsIsSUc2VoImp-nvT9TCJKhbi_xS7qCB66hO3dYYrPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD80wvRbCqddqfzgRnl4gtZ8ExuVf_lO1MKA5QVuifYRg&oe=6A63679B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "560042380474257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_560042383807590_668531239392494770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exebCykCpWEQ7kNvwGoybnU&_nc_oc=Adoif-Js8Bvep5zUDj88YQ7L2h16IoGTpH8HEnbJeDZQIaxsXIMS3WlVFXeiNSWxJM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgPX8VaISvYfMemV-xorgfqa2FsisnAchYg5lM4pYjYw&oe=6A635570"}, "display_name": "Deadly Delivery", "keywords": ["Delivery", "Lethal", "Deadly", "Multiplayer", "Horror"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. Armed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive\u2014or watch your coworkers get picked off one by one.\n\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns \u2014 or feed them your friends.", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAND
uscdn.com/v/t64.5771-25/473393909_610206125407966_8943337466549821229_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE0z9r8EhUgQ7kNvwG8eY5p&_nc_oc=Adl8Xh6PczCVtvcxJO8Ls8c5NDr9il21GhN3V4sYzOlMc0sVAXHmEn5JWKP0ojaY5UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQBLwOgMfun4Eja2nCBQpSlCHE5nYUZPz0I3ycg7MnBg&oe=69AC2890"}, {"file_name": "Screenshots_2560x1440_DD_DoubleDoor.png", "id": "739262415278358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393444_739262421945024_4016414250370504064_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8kedc6J02UQ7kNvwG5Msfz&_nc_oc=AdnVOrHycN2uvdUiR1biPH0jE-C2JKSp4u1On_I4EhvNzJ9xJE9AAdRrGH1Nd28A67M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvanPO2fYZavE0g0G0rBa-jxb9hw1k2rMzkcGPaqQ71A&oe=69AC0484"}, {"file_name": "Screenshots_2560x1440_DD_ParcelStacking.png", "id": "553200994506830", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393841_553200997840163_8421225844214804779_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfvvCY-7LOAQ7kNvwFKQjPE&_nc_oc=AdnvkozVes8SwrCsajb-MRhbbtPYN2F0K1ynveq_Huvl4UhMb-PhNj3NlaMtqVG-VII&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxmq6L1lHJqzDlzwXx__ZeOzoWgaLfUFkMnjziTfx5j5Q&oe=69AC271B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440_DD_01.png", "id": "560042380474257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_560042383807590_668531239392494770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mch8MfPymIQ7kNvwFXooZY&_nc_oc=AdlgqeqYehEEzGKKcLv7SpjkcsjgcaECORvG1h9HEkNJoW9CHs8tX9KdRWYBsCxOtX0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQ8XhBTEZEWtrtZ1N2NA1BHbJrmwZkk5wiMFKDch-iPw&oe=69AC14F0"}, "display_name": "Deadly Delivery", "keywords": ["Delivery", "Lethal", "Deadly", "Multiplayer", "Horror"], "long_description": "# Your shift starts now. Good luck.\n\nIn Deadly Delivery, you and your fellow delivery goblins are tasked with delivering parcels into pitch-black mines full of... things. Armed with questionable equipment, you'll sneak, sprint, and scream your way through procedurally generated tunnels.\n\n\n\n# Features\n# \ud83d\udc80 Deadly Co-op Missions\n Team up with up to 3 other players in online co-op. Coordinate, deliver, and survive\u2014or watch your coworkers get picked off one by one.\n\n\n# \ud83d\udd26 Physics based VR Horror\n Built for VR with a physics based world, spatial audio, and proximity voice chat. \nHaul a variety of parcels, climb on other players or give them a slap of encouragement \n\n\n# \ud83d\udc79 Monsters With Personality\n Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns \u2014 or feed them your friends.", "short_description": "An online VR co-op horror game about delivering parcels into haunted mines. \nAvoid monsters, drop off packages, and pray you reach the quota! \nTeam up with up to 3 other delivery goblins, survive your shift and pay back your student loans."}]}, "developer_name": "Flat Head Studio", "developer_privacy_policy_url": "https://deadlydelivery.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Flat Head Studio", "support_website_url": null, "website_url": "https://deadlydelivery.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_
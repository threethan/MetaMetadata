TY_ICuO_52mtKEAvOY94b3ynA7wdPw&oe=6B046ABD"}, {"file_name": "Screenshot4.png", "id": "1092990405402304", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031629_1092990408735637_980104409844896217_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaQt00ei4mkQ7kNvwExdJwK&_nc_oc=AdrnEV13DOBfVRMpdgRK-vkszr-aOOjhMbVuLkuQQVTS5AgUn07g3LG9pgtCr3d-o5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAZNBF1KE62aAABQATohMZ5xILFKnKL8VgPggubeKiRA&oe=6B047656"}, {"file_name": "Screenshot5.png", "id": "239539688912839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974691_239539692246172_7065911403569284460_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2F28sFfmvsQ7kNvwFLWNcH&_nc_oc=AdosPAT_FVcG5R4IukH_snay6AVjXQLYLRWjDaIf-nNUVUQqLkTmilBCcdrwGdCaYG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRo6g1oETvCnNicUhBsF7oU_rxKoii5VOpsdM1Xlq5zw&oe=6B048AC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Builders VR", "keywords": [], "long_description": "Hey there, fellow gamers! \ud83c\udfae Welcome to the world of Builders VR, a virtual reality game that\u2019s gonna blow your mind! \ud83e\udd2f\n\nImagine this: You\u2019re in a lush, green forest, the leaves rustling above you as you navigate through the undergrowth. \ud83c\udf33 Maybe you\u2019re on a quest, or maybe you\u2019re just exploring. The choice is yours!\n\nBut wait, there\u2019s more! Ever wanted to shop in VR? Well, now you can with our virtual currency! Our game features a fully stocked shop where you can grab whatever you need for your adventures. \ud83d\udecd\ufe0f\n\nAnd if you\u2019re tired of gravity, we\u2019ve got just the thing for you! In our zero-gravity zone, you can float around like an astronaut, defying the laws of physics. \ud83d\ude80\n\nFeeling chilly? Check out our snow map, where you can have snowball fights or build a snowman. It\u2019s a winter wonderland, right at your fingertips! \u2744\ufe0f\u26c4\n\nBut that\u2019s not all! We\u2019ve got a TON more exciting stuff coming your way. New maps, new features, new adventures\u2026you won\u2019t believe what we\u2019ve got in store! \ud83c\udf89\n\nAnd the best part? You move around like a gorilla, using just your hands! \ud83e\udd8d It\u2019s a totally unique way to experience VR, and we can\u2019t wait for you to try it out.\n\nSo, are you ready to swing into action? Stay tuned for more updates, and get ready for the VR adventure of a lifetime! \ud83e\udd29", "short_description": "Hey there, gamers! \ud83c\udfae Get ready for an epic VR adventure in our game, Builders VR! \ud83d\udd79\ufe0f Explore a mystical forest, shop 'til you drop, float around in zero gravity, or chill in a snowy wonderland. \ud83c\udf33\ud83d\udecd\ufe0f\ud83d\ude80\u2744\ufe0f But hold up, that\u2019s not all! We\u2019ve got a TON more coming your way! \ud83c\udf89 The best part? You move like a gorilla, using just your hands! \ud83e\udd8d So, are you ready to swing into action? Stay tuned for more! \ud83e\udd29"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10XT0y1kQQNcXdpo5f-HHxH_CoRJ2QbN-y6X0tqBHHck/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "FarmerGT", "support_website_url": null, "website_url": "https://sites.google.com/view/buildersvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzM7mJ97DKQQ7kNvwGNevIY&_nc_oc=AdqouCVn3TEstwYoh8PKo0hdU36xMMrOHj8HzYti3dQgVYEwiIxjmBfV8MHO87fhXec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9153d-9lbMHksitK60mrv0_E8lh36KpF2EVu__3dKBQ&oe=6AFC8D90"}, {"file_name": "screenshot_4.png", "id": "39049327731380383", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_39049327734713716_8579978904606626526_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcskdqMTrlkQ7kNvwG1A-Wy&_nc_oc=AdpeX7UAvW0Z9-XR3T7YJ41FQ-RPrjCOKFczPvObtZvEY1e8_rC5ttPlvHqDXfBGueQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkah8kmoP-3P78bhXDnvRIApgCv3283t-k8DmOMZgfgg&oe=6AFC94DD"}, {"file_name": "screenshot_5.png", "id": "2269994897184015", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/756589809_2269994900517348_7964667484132364063_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzLrT6XUmywQ7kNvwGCEU-s&_nc_oc=AdqF4GoEZmf_etIcOu0L0l51Yv5pr3xcQVBFLqRxk3ujb297YJQfw91hQmpD93D8FRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfF7NdL24WSldO6vbFgY6CEpVKN-QqBU_9R2GKbh3LcQ&oe=6AFC8EA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1140304245323934", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585799753_1140304251990600_8811626336653089366_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgFIs0fa1uUQ7kNvwE3wDXz&_nc_oc=Adq4tf8f3gUR3p6JHPFaqsnFTxgQVM-kw99fhp7jMQq4EJTe-B56ZhucHQPdw7-szEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxbyNiZtx8MGWGX1DYSnZkmOWAVWWK4q4ftNAJWeS_sw&oe=6AFC8E6A"}, "display_name": "Flight Simulator Amsterdam", "keywords": ["flight", "simulator", "amsterdam", "jet", "pilot"], "long_description": "Flight Simulator Amsterdam puts you in the captain's seat over the real Amsterdam.\n\nTHE REAL AMSTERDAM\nReal satellite, elevation and map data: the canal ring, Centraal Station, the Royal Palace on the Dam, the Westerkerk, the Rijksmuseum, the Magere Brug, the A'DAM Tower, NEMO, the Johan Cruijff ArenA, Muiderslot, IJmuiden's sea locks and Zandvoort. Schiphol with all six runways, and Lelystad.\n\nWINDMILLS AND TULIPS\nHundreds of real windmills and wind turbines, their sails turning. Fly over the striped tulip fields of the Bollenstreek, the dunes and the North Sea beach.\n\nA LIVING CITY\nYellow-and-blue trains on their real tracks, the metro on its viaduct, ferries and canal boats on the IJ, ships off IJmuiden. At night the canals light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, traffic calls and your landing clearance.\n\nENGLISH AND DUTCH\nSwitch every menu between English and Dutch in Settings.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the IJ, the A'DAM Tower out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet with yokes and a twin-engine fighter.\n\nELEVEN MISSIONS\nThe Polderbaan approach, the Amstel and IJ run, through the windmills, tulips and dunes, a fighter scramble, the canals after dark and a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Amsterdam, built from real satellite and map data: the canal ring, Centraal Station, the Rijksmuseum, the Dam, the A'DAM Tower, the windmills of the Zaanse Schans, the tulip fields and the North Sea coast. Start in your own glass hangar on the IJ, talk to air traffic control and land on all six Schiphol runways. English and Dutch menus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatoramsterdam/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages
ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311582_1312188144034251_6662080412466052359_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGzyBBt92bAQ7kNvwFboVMB&_nc_oc=Adqwlyix2HXu2WBMad1tUDuEoA2wL2ZrND_AFw1MFZyGTAFTdsa3Ffdq9BU1qIoTPyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkASJ6YHAjmP7aXkCyROJRCOIvqcITDsNTxPKQnVt8rA&oe=6AE9ED4E"}]}, "id": "1520333326745692", "locale": "en_US", "screenshots": [{"file_name": "letadlo_1.png", "id": "1893657434945945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618730118_1893657438279278_4559368885465255599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyzM8mdWbvoQ7kNvwEn7N5z&_nc_oc=AdrtAWg2MxEWiqqtbCpDYG9HJNahuSg6vq9VPwLaYzlKf6nleA13zHc0qfLQQ8rp3Fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXTl5P5_Ulqo-W608TkenfASpHckNUssb8TvBEKGy-ZA&oe=6AE9E226"}, {"file_name": "letadlo_2.png", "id": "1597744788514691", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825497_1597744791848024_7843318982972101732_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GskVTjV4Th8Q7kNvwEfWkjS&_nc_oc=AdoEWW8ZNbhR3ut2CoBJ0WL-HR-8YMIYJRzPZLPyzVRDG-SiXygI9OhAW0e2-X4ZDjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQchvRgsOALMQI44eKVQaOqJz2xgXhvUKtPbyztQu9fiA&oe=6AE9E0BE"}, {"file_name": "metro_2.png", "id": "2019702302243477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_2019702305576810_7241842415397796897_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=201STMUzZZUQ7kNvwFDJBni&_nc_oc=Adr02j7c7_4CS4se1Pkl4EjKGkcLf-8wr4VEEc9fE3b8vVnP3_ngKnVT0nQ9pG-fyQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ72uDu2SbL1n0dzXPTf8Tjwn98lSyLUMBhByLTwi-kVg&oe=6AE9FD91"}, {"file_name": "metro_6.png", "id": "1591337203001946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1591337206335279_3035929566557085373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbBw7l78hoMQ7kNvwHr5Gwy&_nc_oc=Ado5voR4Nx2vA3wKNHNn56O9Ll2OjRYZ0D3Tle26hiY_TSSs6VqYgf8dXK5nrPFpWBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWGxnJHh7babYuPXHC9au5bxOVHo56i2_eBERTQEpTvA&oe=6AE9E5CD"}, {"file_name": "supermarket_1.png", "id": "1021197777188685", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830467_1021197780522018_1179453740939542189_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eBgf95zYX0Q7kNvwHlFwY0&_nc_oc=Adrzsy-Emdu5oxD3gyvdj17Cgt-q-WMLXjyONTmG7jlPyJMxnfwrJInNG-0_vk44uUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOLyxBGfXozlECCLfQlDs-WaG5nf5ouCVEQQasoeGpNQ&oe=6AE9E7A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Agoriva VR Demo", "keywords": ["VRtherapy", "agoraphobia", "phobia", "aerophobia", "therapy"], "long_description": "This is a self-guided showcase of the full Agoriva platform, which is a clinician-designed VR application that brings exposure therapy into everyday care for agoraphobia, panic disorder, and fear of heights. Therapists guide patients through graded, evidence-aligned scenarios that mirror real triggers while keeping sessions safe, repeatable, and on demand.\n\nScenarios\n\nIncluded in the demo:\n- Airports & Flying: gate, boarding, taxi, take-off, turbulence, landing\n- [Coming soon!] Metro: platform, escalators, inside the carriage, varying crowd levels \n\nNot included:\n- Bus Travel: boarding, seating, stops, passenger density\n- Supermarket & Checkout: aisles, queues, cashier/self-checkout\n- Cinema Seating: seat choice, enclosed rows\n\nBuilt for clinical flow\n\n- Therapist controls: adjust crowd size, queue length, turbulence, timing, and prompts without breaking presence\n- SUDs prompts: lightweight distress check-ins to pace exposure and guide decisions\n- Hand-tracking & 6DoF\n- Session & patient management: session notes, progress review\n\nClinical context\n\nSuccessfully tested in a modern clinical setting at JESSENIA Center for Mental Rehabilitation a.s., Beroun, under leadership of Prof. MUDr. J\u00e1n Pra\u0161ko Pavlov, CSc. and MUDr. Jan P\u00e1sztor.\n\nImportant\n\nAgoriva is not a medical device and does not replace professional care. Comfort: Moderate. Safety tools include a quick Passthrough Safe Zone for grounding.\n\nContact us on info@moreismore.cz if you are interested in the full platform!", "short_description": "Standalone demo \u2014 a self-guided showcase of the full Agoriva platform, which is a clinician-designed VR exposure that fits real care pathways. With Agoriva, patients rehearse airports, turbulence, public transit, crowded squares, and queues on Meta Quest 3, step by step, with SUDs pacing. Built for hospitals and private clinics; Not a medical device.\n\nContact us on info@moreismore.cz if you are interested in the full platform!"}]}, "developer_name": "More.is.More", "developer_privacy_policy_url": "https://agoriva.com/en/privacy-vr/", "developer_terms_of_service_url": null, "publisher_name": "More.is.More", "support_website_url": null, "website_url": "http://moreismore.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1611292287141890"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829165_1807129144056551_7452302136767440128_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7
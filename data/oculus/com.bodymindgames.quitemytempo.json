cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vslc7WpFbi8Q7kNvwE97z-Y&_nc_oc=Adobp-PBfy2WJbTKbsk0BWMF9MWjVkXpmpyInkFSJK2jSyyH90kIcyMeMVB-ai2QB5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh3AwZx4JaDHWMZ0t178GpTPQ_bKtmY0T8sAedkQqMMw&oe=6AE5FFB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quite-my-tempo-video-cover.png", "id": "1478390063291734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829980_1478390066625067_369456204755520288_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUwegvJTgfsQ7kNvwHfzr3a&_nc_oc=Adpdw4adLiETIULe1DcphK91EN0EM1JF9Du3T9c9SBfzlKadbMk0Sk1iAl4Gvkvu-7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR7xKeLzZ3C9MNtaX1yVmSyrKVjqz7zGAN7WJAId8kRw&oe=6AE5EABF"}, "display_name": "Quite My Tempo", "keywords": ["beat", "music", "rhythm", "fitness", "dance"], "long_description": "**EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!**\n\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR).\n\nIt aims to provide **a platform for immersive experiences** rather than being a single game. A platform for music and rhythm-based mini-games, powered by content created by us, the community.\n\nThe game is **highly customizable** to cater to your preferences. This includes the ability to choose the type of gameplay, an environment in which the game takes place, custom models of weapons and destructible objects and more.\n\n**Find Your Rhythm!**", "short_description": "EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.qui
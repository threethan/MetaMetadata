uq17whGTnFZ-UFwqJoojs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXfEJMyI-e0CV30B35wIT9Stw68Dh47jP6cdDZuhUQUw&oe=6A7DA0F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quite-my-tempo-video-cover.png", "id": "1478390063291734", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491829980_1478390066625067_369456204755520288_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzP5l-LHSdMQ7kNvwEqgnQr&_nc_oc=Adr5tEdhdBt_9LjCCSTD-uKeBb_1VKlZZtA0Ax2vECD7hbDHGkOKyXCwf10KkyOdej4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKwaWC96A8ST3bvYUut1tE-048n2n75DTr_WJMN8aH0w&oe=6A7DC43F"}, "display_name": "Quite My Tempo", "keywords": ["beat", "music", "rhythm", "fitness", "dance"], "long_description": "**EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!**\n\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR).\n\nIt aims to provide **a platform for immersive experiences** rather than being a single game. A platform for music and rhythm-based mini-games, powered by content created by us, the community.\n\nThe game is **highly customizable** to cater to your preferences. This includes the ability to choose the type of gameplay, an environment in which the game takes place, custom models of weapons and destructible objects and more.\n\n**Find Your Rhythm!**", "short_description": "EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.quitemytempo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_categor
J5_eE0yrjiwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj-UKOJ0FYucOz_VjXKPagT6b-SG7fx7UF-qWfCTVFBg&oe=6AAFF238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quite-my-tempo-video-cover.png", "id": "1478390063291734", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491829980_1478390066625067_369456204755520288_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrIs6V3LhBsQ7kNvwFMaE0v&_nc_oc=AdoBnM23YaEuFYykExKcGhz9_WFYNpJPRd2Xh6lrmVgD05YfyNi_HQYLn1O2EUSFkVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD5vw4dy_RZfl8rqEmcv2EiC0NmAtCMA3fiU3S8Ayf9g&oe=6AAFDD3F"}, "display_name": "Quite My Tempo", "keywords": ["beat", "music", "rhythm", "fitness", "dance"], "long_description": "**EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!**\n\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR).\n\nIt aims to provide **a platform for immersive experiences** rather than being a single game. A platform for music and rhythm-based mini-games, powered by content created by us, the community.\n\nThe game is **highly customizable** to cater to your preferences. This includes the ability to choose the type of gameplay, an environment in which the game takes place, custom models of weapons and destructible objects and more.\n\n**Find Your Rhythm!**", "short_description": "EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.quitemytempo.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "
cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqmKFRhwV5MQ7kNvwFkWtxr&_nc_oc=AdpaHBhgt3j0WnVGGlQKjnVjL_JcIrrUY7F0cJaThnJu6Z65PIMQvQoTyT_5ZdPcFkM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFRoq142nXWwjbFp-k3OHKjhavZa3p63S1QjzIoxaHqA&oe=6ADCC538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quite-my-tempo-video-cover.png", "id": "1478390063291734", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491829980_1478390066625067_369456204755520288_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIipkA0dBFwQ7kNvwFkqYBF&_nc_oc=AdqO8yiCCBPUXUbvmj6M71JZvyjiZ8eF4UvjOlPhQyUtFeAGt3ZU2HM2SupQadBLtlY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMCEEllJl9zBxQaPv9MAdjR5eAPYtOgiExVZsJJSAuKA&oe=6ADCB03F"}, "display_name": "Quite My Tempo", "keywords": ["beat", "music", "rhythm", "fitness", "dance"], "long_description": "**EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!**\n\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR).\n\nIt aims to provide **a platform for immersive experiences** rather than being a single game. A platform for music and rhythm-based mini-games, powered by content created by us, the community.\n\nThe game is **highly customizable** to cater to your preferences. This includes the ability to choose the type of gameplay, an environment in which the game takes place, custom models of weapons and destructible objects and more.\n\n**Find Your Rhythm!**", "short_description": "EARLY ACCESS - Please be gentle with the ratings :) Let's shape the game together!\nQuite My Tempo is an open and cross-platform sandbox for rhythm games in Virtual and Mixed Reality (VR/MR)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bodymindgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Body Mind Games", "support_website_url": null, "website_url": "https://www.qui
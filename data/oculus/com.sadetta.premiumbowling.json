D"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1782474878, "id": "27322090537446594", "version": "1.32.2", "version_code": 664, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2773034772778845", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27043224861999831"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "858386761325173"}]}, "change_log": "A free 1.32 update for Premium Bowling has arrived!\n\nThe Bowling Balls Update brings fresh style and new lane conditions to your game, with 9 brand-new bowling balls to add to your collection. Whether you want something bold, colorful, classic, or just a ball that stands out on the rack, there are plenty of new looks to roll with.\n\nWe\u2019ve also added 2 new oil patterns, giving players more variety, more challenge, and more ways to test their shots. Adjust your line, fine-tune your speed, and see how your favorite ball performs on the new conditions.\n\nThis update also includes the usual round of bug fixes and improvements.\n\nJump back onto the lanes and try out the new balls today!\n\n1.32.1: \n - Bug fixes and performance improvements.", "created_date": 1780515900, "id": "27043224861999831", "version": "1.32.1", "version_code": 663, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 10}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
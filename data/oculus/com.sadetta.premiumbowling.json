=6e7a0a&_nc_ohc=d8Wq-E9Y86oQ7kNvwHBEWnY&_nc_oc=AdpNZRZQLtZvTGjt-CorDNH_sZcE03AXIZKKXVPPlatJvhz9FnJ-jteIXIORJlaShBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9kdKGJLS1qEP_WQjxy9goAjYQCWSuK35-fJI-XeK7Uw&oe=6A4CEB60"}, {"file_name": "tzefte.png", "id": "543149756620615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75241703_543149763287281_8154518710271344640_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMl_4UUEpAAQ7kNvwGhDIMa&_nc_oc=Adr8-U_KzzlgRul1ECd3US1kO7ruOySKA3MCZt41fih6dupOjH-hKD0nK29AOtiZdgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0L1cidAnhXu2MIXwn4IkD1VMM9RG5oAuBKYI9T1eTkA&oe=6A4D170E"}, {"file_name": "u4UkEv.png", "id": "2420541578237248", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974518_2420541581570581_1836131452849225728_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8K9IfYgVrEQ7kNvwGt5uAb&_nc_oc=Adpyxplz2DLBGm0y7wN14Xc8ZMinekdIlWBHLbrSOpDUZLWY8ydfSdt6xPLQUcNkdFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSjxOSxq3-JNcUnvGWMUTxB7OgFGGBxGWi44I5AUuOqA&oe=6A4CF94F"}, {"file_name": "u2sQMB.png", "id": "612235526304971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984446_612235529638304_4908027629296156672_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsxcOVk6Q58Q7kNvwHR3l0g&_nc_oc=AdqHwJwZIvp_h8f1kuLoac39JMJz31QAqa3IPDNDDqXs-PACB1tZEUveJLBjjLogd8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjCvxBDGASF3gVTNYR89xvdN2hfepeulj9MWt-KdQsqQ&oe=6A4CFA7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/6T9Fbz", "id": "1042220836178576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75280981_1042220839511909_6914967023814443008_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWkKJ2yYJhoQ7kNvwH6dsA5&_nc_oc=Ado2rBUS-D9D3bJ7QhRSBXK36QTxgzJyc-oZkkiqiZs-lQexZLCyt4gbwakRw_ya_rU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQa86svnzCSq4-eHba29JNBZD01fKkIN5vglSszwYxBw&oe=6A4D0ED3"}, "display_name": "Premium Bowling", "keywords": ["bowling"], "long_description": "Premium Bowling is as close to real bowling as you'll get without picking up a physical bowling ball. \n\nStart the game and enjoy ten pin bowling right at home! Play multiplayer competitions, conquer daily and weekly top lists and work your way to the top in player ranking and bowling leagues. \n\nMain Features: \n\n- The best bowling physics simulation\n- Many gorgeous bowling alleys \n- Many balls and a Ball Editor \n- Daily and weekly tops \n- Continuous week-to-week player ranking\n- Weekly and monthly E-Sports style leagues \n- Many oil patterns \n- Oil gets carried and wears out \n- Small daily variations in lane conditions\n- Single player, local multiplayer and online multiplayer support\n- Commentator", "short_description": "Premium Bowling is as close to real bowling as you'll get without picking up a physical bowling ball."}, {"images": {"nodes": []}, "id": "573646729910113", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling"], "long_description": "Premium Bowling ist ein realistisches und einfach zu bedienendes Bowling spiel mit Mehrspieler Modus. \n\nStarte das Spiel und genie\u00dfe das beste Bowling zuhause! Spiele in Echtzeit Mehrspieler-Wettbewerbe, erobere die t\u00e4gliche und w\u00f6chentliche Bestenliste und arbeite an deinem Weg zur Spitze im Spieler-Ranking und in die E-Sports Bowling Szene. \n\nSpielfunktionen: \n- Der Bowling-Simulator mit der besten Physik \n- Viele Bowlingbahnen mit unterschiedlicher Musik \n- Viele Kugeln mit verschiedenen physikalischen Eigenschaften \n- Kugel-Editor um eigene Kugeln zu erstellen \n- T\u00e4gliche und w\u00f6chentliche Bestenlisten \n- Kontinuierliches Woche zu Woche Spieler-Ranking \n- W\u00f6chentliche und monatliche Ligen im E-Sport-Style \n- Viele verschiedene \u00d6l Muster die deine Kugel beeinflussen und sich w\u00e4hrend des Spielens abnutzen \n- Das \u00d6l nutzt sich w\u00e4hrend des spielends ab \n- Kleine t\u00e4glichen Abwandlungen des Zustandes der Bahn", "short_description": "Premium Bowling ist ein realistisches und einfach zu bedienendes Bowling spiel mit Mehrspieler Modus."}, {"images": {"nodes": []}, "id": "526858024871020", "locale": "pt_PT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling", "boliche"], "long_description": "O Premium Bowling \u00e9 um jogo de boliche de dez pinos realista e f\u00e1cil de jogar, com suporte local e online para v\u00e1rios jogadores. \n\nComece o jogo e desfrute do melhor boliche de todos os tempos em sua pr\u00f3pria casa! Jogue competi\u00e7\u00f5es multijogador em tempo real, conquiste listas principais di\u00e1rias e semanais e chegue ao topo nas ligas de classifica\u00e7\u00e3o de jogadores e de boliche no estilo e-sport.\n\nFuncionalidades do jogo: \n- A melhor simula\u00e7\u00e3o de f\u00edsica do boliche \n- Muitas pistas de boliche deslumbrantes com trilhas sonoras personalizadas \n- Muitas bolas com propriedades f\u00edsicas \u00fanicas \n- Editor de bolas para criar suas pr\u00f3prias bolas favoritas \n- Tops di\u00e1rios e semanais para resultados de jogos e resultados de s\u00e9ries \n- Classifica\u00e7\u00e3o cont\u00ednua de jogadores semana a semana \n- Ligas semanais e mensais no estilo E-Sports \n- Muitos padr\u00f5es de \u00f3leo que afetam o gancho \n- O \u00f3leo \u00e9 carregado e desgastado durante o jogo \n- Pequenas varia\u00e7\u00f5es di\u00e1rias nas condi\u00e7\u00f5es da faixa", "short_description": "O Premium Bowling \u00e9 um jogo de boliche de dez pinos realista e f\u00e1cil de jogar, com suporte local e online para v\u00e1rios jogadores."}, {"images": {"nodes": []}, "id": "229658068381478", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling"], "long_description": "Premium Bowling est un jeu de bowling r\u00e9aliste et facile \u00e0 jouer en multijoueur local et en ligne. \n\nCommencez la partie et profitez du meilleur bowling chez vous ! Jouez \u00e0 des comp\u00e9titions multijoueurs en temps r\u00e9el, partez \u00e0 la conqu\u00eate des tops quotidiens et hebdomadaires et atteignez le haut du classement des joueurs et des ligues de bowling fa\u00e7on eSport. \n\nCaract\u00e9ristiques du jeu: \n- La meilleure simulation de la physique du bowling \n- De nombreuses magnifiques pistes de bowling avec des bandes sonores personnalis\u00e9es \n- Beaucoup de balles aux propri\u00e9t\u00e9s physiques uniques \n- \u00c9diteur pour cr\u00e9er vos propres balles \n- Les tops des classements quotidiens et hebdomadaires par score de partie et score de s\u00e9rie \n- Classement continu hebdomadaire des joueurs \n- Ligues fa\u00e7on eSport hebdomadaires et mensuelles \n- De nombreux motifs d'huile qui affectent le crochetage de la balle \n- L'huile part et s'use pendant le jeu \n- Petites variations journali\u00e8res de l'\u00e9tat de la piste", "short_description": "Premium Bowling est un jeu de bowling r\u00e9aliste et facile \u00e0 jouer en multijoueur local et en ligne."}, {"images": {"nodes": []}, "id": "229346445086028", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling", "boliche"], "long_description": "O Premium Bowling \u00e9 um jogo de boliche de dez pinos realista e f\u00e1cil de jogar, com suporte local e online para v\u00e1rios jogadores. \n\nComece o jogo e desfrute do melhor boliche de todos os tempos em sua pr\u00f3pria casa! Jogue competi\u00e7\u00f5es multijogador em tempo real, conquiste listas principais di\u00e1rias e semanais e chegue ao topo nas ligas de classifica\u00e7\u00e3o de jogadores e de boliche no estilo e-sport.\n\nFuncionalidades do jogo: \n- A melhor simula\u00e7\u00e3o de f\u00edsica do boliche \n- Muitas pistas de boliche deslumbrantes com trilhas sonoras personalizadas \n- Muitas bolas com propriedades f\u00edsicas \u00fanicas \n- Editor de bolas para criar suas pr\u00f3prias bolas favoritas \n- Tops di\u00e1rios e semanais para resultados de jogos e resultados de s\u00e9ries \n- Classifica\u00e7\u00e3o cont\u00ednua de jogadores semana a semana \n- Ligas semanais e mensais no estilo E-Sports \n- Muitos padr\u00f5es de \u00f3leo que afetam o gancho \n- O \u00f3leo \u00e9 carregado e desgastado durante o jogo \n- Pequenas varia\u00e7\u00f5es di\u00e1rias nas condi\u00e7\u00f5es da faixa", "short_description": "O Premium Bowling \u00e9 um jogo de boliche de dez pinos realista e f\u00e1cil de jogar, com suporte local e online para v\u00e1rios jogadores."}, {"images": {"nodes": []}, "id": "216227266357864", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling", "keilaus", "keilailu"], "long_description": "Premium Bowling on realistinen ja helppok\u00e4ytt\u00f6inen keilailupeli moninpelill\u00e4. \n\nPeli tarjoaa rennon ymp\u00e4rist\u00f6n ajanvietteeksi kavereiden ja muiden pelaajien kanssa keilaillen. Kilpailullisille pelaajille meill\u00e4 on moninpeli kilpailuita, p\u00e4ivitt\u00e4iset ja viikoittaiset tuloslistat ja pidemm\u00e4n aikav\u00e4lin pelaajarankingit. \n\nPelin ominaisuudet: \n- Paras fysiikan simulointi\n- Monta upeaa keilahallia\n- Paikallinen moninpeli \n- Moninpeli verkossa \n- Useita \u00f6ljykuvioita jotka vaikuttavat pallon rataan ja jotka kuluvat pelin aikana \n- Useita palloja, joissa on erilaiset fyysiset ominaisuudet\n- P\u00e4iv\u00e4n ja viikon parhaat tuloslistaukset\n- Viikottain p\u00e4ivittyv\u00e4t pelaaja-ranking listaukset\n", "short_description": "Premium Bowling on realistinen ja helppok\u00e4ytt\u00f6inen keilailupeli moninpelill\u00e4."}]}, "developer_name":
76542286000603"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1591290033, "lastRevision": {"nodes": [{"id": "986930618374265", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2773034772778845", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "430951557469447"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "3022519701143791", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Premium Bowling", "keywords": ["bowling", "bolos"], "long_description": "Premium Bowling es un juego de bowling realista e intuitivo, con soporte para multijugador.\n\n\u00a1Comienza el juego y disfruta del mejor juego de bolos en tu propia casa! Juega competiciones multijugador en tiempo real, conquista las mejores listas diarias y semanales y sube a lo m\u00e1s alto en la clasificaci\u00f3n de jugadores y las ligas de bolos de estilo e-sport. \n\nCaracter\u00edsticas del juego: \n- Lo mejor simulacion f\u00edsica \n- Muchos hermosos boleras con bandas sonoras personalizadas \n- Muchas bolas con propiedades f\u00edsicas \u00fanicas \n- Editor de bolas para crear tus propias bolas favoritas \n- Listas principales diarias y semanales de juegos y series \n- Una infinidad de bolas con pesos, fricciones, longitudes y desgastes de aceitados diferentes \n- Ligas de estilo e-sport semanales y mensuales \n- Una gran variedad de aceitados que afectan a la reacci\u00f3n de la bola \n- Aceitados desgastan mientras el juego avanza \n- Peque\u00f1as variaciones diarias en las condiciones de pistas", "short_description": "Premium Bowling es un juego de bowling realista e intuitivo, con soporte para multijugador."}, {"images": {"nodes": [{"file_name": "85Vy3v.png", 
39225833981"}, "id": "1601784548360150"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2607274519713785", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2612739225833981"}, "release_status": "RELEASED"}, "id": "2612739225833981", "version": "1.0.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1794070799, "id": "2607274539713783", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "2607274533047117"}, "release_status": "RELEASED", "id": "2607274519713785"}, "id": "2607274533047117", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2607274519713785", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1831953284496635"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1519219870302695", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TITAN BRAWL: Battle Arena VR", "keywords": [], "long_description": "TITAN BRAWL seni g\u00fcrleyen bir robot d\u00f6v\u00fc\u015f\u00fc arenas\u0131n\u0131n s\u00fcr\u00fcc\u00fc kabinine koyuyor. TX-9 vericisini eline al, \u00e7ubu\u011fu gitmek istedi\u011fin y\u00f6ne it ve teti\u011fi \u00e7ek: robotun gerisini kur\u015fun ge\u00e7irmez cam\u0131n ard\u0131nda canl\u0131 olarak yapar.\n\nD\u00d6V\u00dc\u015e\u00c7\u00dcN\u00dc KUR\n\u2022 Garajdaki k\u0131zakta par\u00e7alar\u0131 yerine tak: \u015fasi, s\u00fcr\u00fc\u015f, z\u0131rh, g\u00fc\u00e7 h\u00fccresi, kontrol kart\u0131\n\u2022 14 silah t\u00fcr\u00fc: dikey disk, tambur, f\u0131rlat\u0131c\u0131, ezici, \u00e7eki\u00e7, testere, k\u0131l\u0131\u00e7, Tesla k\u0131skac\u0131 ve daha fazlas\u0131\n\u2022 \u00c7ift silahl\u0131 yap\u0131lar, alev p\u00fcsk\u00fcrt\u00fcc\u00fc, buz ve su toplar\u0131\n\u2022 Boya at\u00f6lyesi: desenler, \u00e7\u0131kartmalar, numara, sprey boya\n\nHER DARBEY\u0130 H\u0130SSET\n\u2022 Z\u0131rh plakalar\u0131 g\u00f6\u00e7er, tekerlekler ve silahlar kopup u\u00e7ar\n\u2022 Bataryalar alev al\u0131r, ya\u011f s\u0131zar ve yanar\n\u2022 A\u011f\u0131r \u00e7ekim nakavtlar ve dev ekranda an\u0131nda tekrarlar\n\nZ\u0130RVEYE D\u00d6V\u00dc\u015eEREK \u00c7IK\n\u2022 13 rakip robota ve s\u00fcr\u00fcc\u00fclerine kar\u015f\u0131 be\u015f kademeli kariyer\n\u2022 \u00c7ukurlar, zemin testereleri, alev bacalar\u0131, eziciler ve Tesla direkleriyle 5 arena\n\u2022 H\u0131zl\u0131 ma\u00e7, g\u00f6revler, dalga modu, 8 ve 16 robotluk turnuvalar\n\u2022 Akademi ve ekrandaki ko\u00e7 kontrolleri ad\u0131m ad\u0131m \u00f6\u011fretir\n\n\u0130STED\u0130\u011e\u0130N G\u0130B\u0130 OYNA\n\u2022 Ayakta ya da oturarak; yapay hareket yok\n\u2022 Kolay, Arcade, Tank ve Pro s\u00fcr\u00fc\u015f d\u00fczenleri, solak d\u00fczeni\n\u2022 Touch kontrolc\u00fcler; el takibi destekli\n\u2022 English, T\u00fcrk\u00e7e, Deutsch, Fran\u00e7ais, Espa\u00f1ol", "short_description": "S\u00fcr\u00fcc\u00fc kabinine gir ve kendi yapt\u0131\u011f\u0131n uzaktan kumandal\u0131 sava\u015f robotuyla d\u00f6v\u00fc\u015f. Tekerlek ve silah kopar, bataryalar\u0131 tutu\u015ftur, rakipleri \u00e7ukura devir; seyirci co\u015farken \u00c7aylak Ligi'nden Titan \u015eampiyonas\u0131'na y\u00fcksel. Cam\u0131n \u00f6n\u00fcnde sabit durursun, elindeki ger\u00e7ek bir vericiyle s\u00fcrersin: yapay hareket yok."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2648808678880319", "image_type": "APP_IMG_LAYERED_ICON_512"
_ss=7f30f&oh=00_AQTHqJVMFze3oqUHiwhIMqFMYZ6GDmyoqbLlkp4Ul79X8g&oe=6B0C6541"}, {"file_name": "screenshot_03_driver_box_2560x1440.png", "id": "28993356633653725", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_28993356640320391_8967486086715680885_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaGvgmGWtgcQ7kNvwH2puAX&_nc_oc=Adr1x6RaPgNXNopBsdAj_CdDscvF-8G5pixckTYUYDNGdWoXvQUTN0mfDHHQizbeluc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4b4SYio4BdhAuDQUO2tdfIsgdjFRKp6ZqxBoSLX-Mow&oe=6B0C7B2D"}, {"file_name": "screenshot_05_garage_2560x1440.png", "id": "1159762416478972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312470_1159762419812305_9147251132373085083_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEamq4HfWPwQ7kNvwHdwDyJ&_nc_oc=Adpxv4EjsJRtUQS9x8mMzQP_Xb4DYimDLn-HeVPbeDxYqa_rzUW1aZBnFPdZeLapOhY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTs4Iy3AqL8iK2A-s6lHApv1s8DDH0m54VslmtSVNCYw&oe=6B0C6474"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TITAN BRAWL: Battle Arena VR", "keywords": ["Robots", "Combat", "Arena", "Building", "Action"], "long_description": "TITAN BRAWL puts you in the driver's box of a roaring robot-combat arena. Pick up the TX-9 transmitter, push the stick where you want to go and pull the trigger: your robot does the rest, live, behind bulletproof glass.\n\nBUILD YOUR FIGHTER\n\u2022 Snap parts on at the garage cradle: chassis, drive, armour, power cell, control board\n\u2022 14 weapon types: vertical discs, drums, flippers, crushers, hammers, saws, swords, a Tesla clamp and more\n\u2022 Twin-weapon builds, flamethrowers, ice and water cannons\n\u2022 Paint shop: patterns, stickers, numbers, spray paint\n\nFEEL EVERY HIT\n\u2022 Armour panels dent, wheels and weapons tear off and fly\n\u2022 Batteries catch fire, oil leaks and burns\n\u2022 Bullet-time knockouts and instant replays on the big screen\n\nFIGHT YOUR WAY TO THE TOP\n\u2022 Career through five tiers against 13 rival robots and their drivers\n\u2022 5 arenas with drop pits, floor saws, flame vents, crushers and Tesla pylons\n\u2022 Quick bouts, challenges, gauntlet waves, 8- and 16-robot tournaments\n\u2022 An academy and an on-screen coach teach the controls step by step\n\nPLAY YOUR WAY\n\u2022 Standing or seated; no artificial locomotion\n\u2022 Easy, Arcade, Tank and Pro drive schemes, left-handed layout\n\u2022 Touch controllers; hand tracking supported\n\u2022 English, T\u00fcrk\u00e7e, Deutsch, Fran\u00e7ais, Espa\u00f1ol", "short_description": "Step into the driver's box and fight with a remote-controlled combat robot you built yourself. Rip off wheels and weapons, set batteries on fire, flip rivals into the pit and climb from the Rookie Circuit to the Titan Championship while the crowd roars. You stand still at the glass and drive with a real transmitter in your hands: no artificial movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/cemgamedev/cemgamedev/blob/main/privacy/titan-brawl-battle-arena-vr.md", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2607274533047117"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303445_1160317023348491_1376797343452829019_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIE-zZejqgYQ7kNvwGCwIXP&_nc_oc=AdqHmcVFtdrrk63cM8a4vYw5Lvhn_c_lhaYT_PifyUE4DDIwNJfmty0wzMIZh1PTvCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSytCfZ49WdD4QLI2IVFimR4hq2X-etUfqSyGJyNPdjZQ&oe=6B0C6B0F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TITAN BRAWL: Battle Arena VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1794850140, "lastRevision": {"nodes": [{"id": "2607274539713783", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2607274519713785", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1831953284496635"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1519219870302695", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TITAN BRAWL: Battle Arena VR", "keywords": [], "long_description": "TITAN BRAWL seni g\u00fcrleyen bir robot d\u00f6v\u00fc\u015f\u00fc arenas\u0131n\u0131n s\u00fcr\u00fcc\u00fc kabinine koyuyor. TX-9 vericisini eline al, \u00e7ubu\u011fu gitmek istedi\u011fin y\u00f6ne it ve teti\u011fi \u00e7ek: robotun gerisini kur\u015fun ge\u00e7irmez cam\u0131n ard\u0131nda canl\u0131 olarak yapar.\n\nD\u00d6V\u00dc\u015e\u00c7\u00dcN\u00dc KUR\n\u2022 Garajdaki k\u0131zakta par\u00e7alar\u0131 yerine tak: \u015fasi, s\u00fcr\u00fc\u015f, z\u0131rh, g\u00fc\u00e7 h\u00fccresi, kontrol kart\u0131\n\u2022 14 silah t\u00fcr\u00fc: dikey disk, tambur, f\u0131rlat\u0131c\u0131, ezici, \u00e7eki\u00e7, testere, k\u0131l\u0131\u00e7, Tesla k\u0131skac\u0131 ve daha fazlas\u0131\n\u2022 \u00c7ift silahl\u0131 yap\u0131lar, alev p\u00fcsk\u00fcrt\u00fcc\u00fc, buz ve su toplar\u0131\n\u2022 Boya at\u00f6lyesi: desenler, \u00e7\u0131kartmalar, numara, sprey boya\n\nHER DARBEY\u0130 H\u0130SSET\n\u2022 Z\u0131rh plakalar\u0131 g\u00f6\u00e7er, tekerlekler ve silahlar kopup u\u00e7ar\n\u2022 Bataryalar alev al\u0131r, ya\u011f s\u0131zar ve yanar\n\u2022 A\u011f\u0131r \u00e7ekim nakavtlar ve dev ekranda an\u0131nda tekrarlar\n\nZ\u0130RVEYE D\u00d6V\u00dc\u015eEREK \u00c7IK\n\u2022 13 rakip robota ve s\u00fcr\u00fcc\u00fclerine kar\u015f\u0131 be\u015f kademeli kariyer\n\u2022 \u00c7ukurlar, zemin testereleri, alev bacalar\u0131, eziciler ve Tesla direkleriyle 5 arena\n\u2022 H\u0131zl\u0131 ma\u00e7, g\u00f6revler, dalga modu, 8 ve 16 robotluk turnuvalar\n\u2022 Akademi ve ekrandaki ko\u00e7 kontrolleri ad\u0131m ad\u0131m \u00f6\u011fretir\n\n\u0130STED\u0130\u011e\u0130N G\u0130B\u0130 OYNA\n\u2022 Ayakta ya da oturarak; yapay hareket yok\n\u2022 Kolay, Arcade, Tank ve Pro s\u00fcr\u00fc\u015f d\u00fczenleri, solak d\u00fczeni\n\u2022 Touch kontrolc\u00fcler; el takibi destekli\n\u2022 English, T\u00fcrk\u00e7e, Deutsch, Fran\u00e7ais, Espa\u00f1ol", "short_description": "S\u00fcr\u00fcc\u00fc kabinine gir ve kendi yapt\u0131\u011f\u0131n uzaktan kumandal\u0131 sava\u015f robotuyla d\u00f6v\u00fc\u015f. Tekerlek ve silah kopar, bataryalar\u0131 tutu\u015ftur, rakipleri \u00e7ukura devir; seyirci co\u015farken \u00c7aylak Ligi'nden Titan \u015eampiyonas\u0131'na y\u00fcksel. Cam\u0131n \u00f6n\u00fcnde sabit durursun, elindeki ger\u
FelX1Z8xZFVg&oe=6A1EDE58"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKVRLRBQnlUQ7kNvwENdek6&_nc_oc=AdoaQcqJjI1z_xePwUpiSWzhobn_nccrMEgTtjcbULhatPjVjRGliJA5AJpV0YiKUn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D5hSa2ZsOga-SCE0wxTSrWHUxBKZ4hXws6GqSfLkP7A&oe=6A1ED40A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uc1qxep1Lv0Q7kNvwGu3VJP&_nc_oc=Adq_K02GsQGXefN_P86F00kDY3bOqoaVTJYaCQZm8Uzk-N4XqPieBA5oIcHlyuW3RAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RCrx5pd9IUpJmUkdzqb0nyxfEJiE945BDqdQ3sub3mg&oe=6A1EF659"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWXrvNLWFFoQ7kNvwHsPbH8&_nc_oc=Adqk7Xqe3zWXmmCVMi1GrEMMTRiw8v-emhjW8KXSh6LaaTMT4fuEfVT-TYVROqNKbps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rg1eR89dScSe3QRAFjzBd2jAHaGdTq2AeeH6k7yp7uA&oe=6A1EC8CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIBk9_Zo2WIQ7kNvwG9TCUY&_nc_oc=Adrl6Kf2LA46GbmNt_62JpyNOYndcrNOrEGJLswbl_GezDGcHCAYvh6HHKwvkNFcThw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_VF-cfXruHZJXbcvkt1lVLZL-mfEcyTfzBH_7BS325g&oe=6A1EDC86"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet
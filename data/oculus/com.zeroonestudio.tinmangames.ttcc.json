tWySnnOuFLkQ&oe=69F9F458"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jc8065mmrwQ7kNvwFkBv9C&_nc_oc=Adr4AzdsRhekv2DJleHnfDZgLJoIv6Q2TFFZAy525e1isc1DDqk5SBZEXqNCtT78caI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45RPKDudews-YDjMa5qpszUuB9W8KrUIz0iPZwH27lBw&oe=69F9EA0A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAZIIhgBm2QQ7kNvwHP1W9U&_nc_oc=Adq_DxIZRu1oyOdkHORuTetPGvQHGwsGOzGDrqYMJFVfA-NXAUiOdsHpcFm1mNOchTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7beXpXANY8QEXi7pczN5eaEeiTIoaUiORZ-ezcKuDAhg&oe=69FA0C59"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkgoq92733wQ7kNvwGxcg_l&_nc_oc=AdolODgDiLXNzfhKoBnoUeGjCEfIMOsQHSouDfDIdMii4O1z__jGjVjuWLRN-iQJcho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hLt5ATmvhWX_15BE5ka6Msx62kM8mPzCIuozsvWmQCQ&oe=69F9DECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkoL80hbDW8Q7kNvwFOAq15&_nc_oc=Adoo8zpvd9NhPAv3PIDTLp445mU7uLMTR1pQ1XGC8jS8G7AwL-bdoTfwbPDvAe_nLLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-pwGSYTHyNg92VxqqZWRwvGO4sTi-Gt9eJiBbZ1ErUA&oe=69F9F286"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7074678069290091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_5692615697421224_3712722582516054466_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfVU4VcOGMQ7kNvwEHaWDi&_nc_oc=AdqyVMvm-l9A5L726jUa5EpEo4fw3PRMxO4_gIG1-AhovAZXRby-vML2lOgExtFPKfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EtvFsN40duOflzKRyfkEJJX9H_DQUKYv26OYCjGQT1Q&oe=69F9F6AC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Table of Tales: The Crooked Crown", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Role Playing", "id": "821934236779161"}], "release_date": 1657818014, "lastRevision": {"nodes": [{"id": "458224415727748", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4714471148644140", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4046779652090318"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "TableOfTales_CoverArt_Square.png", "id": "5692615690754558", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_5692615697421224_3712722582516054466_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkfVU4VcOGMQ7kNvwEHaWDi&_nc_oc=AdqyVMvm-l9A5L726jUa5EpEo4fw3PRMxO4_gIG1
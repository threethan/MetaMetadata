tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yqdc0_p8gMQ7kNvwHe2Art&_nc_oc=Adp235DhjywoOYprD4bqDu53X2PhxcnYQkDq_HybM3bbAzZQLF5TYGo-LJcJiphW1Zg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbO_IoQjdkWYG9KWCN2EDk9b2uzbsaFsD8y3-D3Xtq6w&oe=6B047B98"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXNM7Wh9m60Q7kNvwEKcgBV&_nc_oc=Adp6JTYGHszYpF55LNQzzE6OA3v2obawjbojrWbRmTa-MM9JuYiGzOF916aqHQGkfxo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9YFZsaEOmBdBmhUfrP6MrMPiaBxIyp8RyvqTKY9VwVA&oe=6B04714A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bedEU4me6McQ7kNvwEqM7kr&_nc_oc=AdoQs0C0KYtepLSBE-WyDd7hftT-cZKp_pT8Llt3WQ9o0S9rSR5xZn4fBRE6lZEs8Kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6OHDOcofjotVRDaW612cGy_fMigx7lTPmFuxZNat06w&oe=6B045B59"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUbhmwBC67cQ7kNvwF8TDmN&_nc_oc=Adp0wahKJc_rHxomzfBlqjOhFplAUWELg2AjqMZA5FZY-3uLuKW2PG3l53vBv61vwVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz3WfhkxPEJTJom5eGm4nS7qzzZAAJ7lFm7QQSTR2lbw&oe=6B04660E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCSI6TLqHEgQ7kNvwE9xDFj&_nc_oc=AdqPTjfVHyCsAmcQHbjyHNI__uiUdHyLnq77j17tHZhViqQUPlqMt5FUQtLSIH1HiMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTxm4WeUJUcgMcfmaRxGtBoKJ5CVM-LvqX_Cwm0FwVqg&oe=6B0479C6"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES",
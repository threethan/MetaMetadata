tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3WsZ2z71igQ7kNvwGV_sfe&_nc_oc=AdrKJ1v6lu5IKEeNaoiOcKki5jZkpAFZI058bS5VHWhvX7l-LOCOpRyrasjQ_u2X20I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCKHziNmGaa_isuAwXIJ4w-0HYByezWW8LsUEmeNkjoA&oe=6B087018"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zXDCMYEcC8Q7kNvwHtwsW2&_nc_oc=AdqTNv5nYTEOO5pCgLKRJXWpjwnbaoNY73iLXtdfBig41d1Mog8JQRvNJbcG-SGu5mc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7LjmgUZWMei-87D8-ooCDJqpZOQvdHYi4HbJ7NNAKeQ&oe=6B0865CA"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8hxEsTjhOUQ7kNvwHjDiHF&_nc_oc=Adou_lz0znPBCYQChjZtyUCYGCMKzXPOmHdQdRoWtPZ0XzXrN_GY6f-X91V6e2jK0fs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1YTnQ3JYZPubJF68hzg-sxY7hN1fJeZtPCw0YaOv0QA&oe=6B084FD9"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbF4Rm0Fi1kQ7kNvwFDfRXp&_nc_oc=Adr2PF6ZaaU7B7lepuDkubK4xOJdLH5nbnWsJJRwL8ewzPv795qxyqH2bXxa8eh2KdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4TicTmOR0sjlW87ew1C-2e3v3gay5-TQOWyZiSmx7pw&oe=6B085A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNo1j3wwr_sQ7kNvwEZ3b6a&_nc_oc=AdoXwz7xWLMxni4PT9WTLxgfjaNEMKVWEMwzTcyGSnoo_gdb7HLa2grpEvK9YW5Rfjg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYW7CVOTog9du1qFJoMdOaLLO2ialN_cNs_b6UmiMSgQ&oe=6B086E46"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES",
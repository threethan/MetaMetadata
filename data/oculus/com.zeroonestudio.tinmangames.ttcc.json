RSSCXZovs59YA&oe=6A6F49D8"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyd8jqv0OvUQ7kNvwFHUqOi&_nc_oc=Adpk4tReksTQYCjCxwyqgdAvJi_PHbzmC2vGW9X2ZVdt23fFiOZCSlAGZ1iSjCDQLeU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpSf9LdHLxTslUcuEbawnOLR9CqUPafct2Nae40yZ9NQ&oe=6A6F3F8A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Fb4b5vk-kEQ7kNvwEPFT3T&_nc_oc=AdrBHs8UIc9d3OkeXk9Ma5gUZcUIQC5GSW8HJSnyoiBsCNQCZ_P90lrpgKlEyEyZLuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByZNWGKn2Ld6G2JrfVtzJ5lsxizBEYIxasfl84CrWDJA&oe=6A6F2999"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss_RA_j_8xUQ7kNvwF55Rs2&_nc_oc=Adqko24C3fYJtVNQUIrFCTTyW0TAmPqo0-fkAHNqWYlNJZS0fdH4_v_oqu6xsaG2N58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0cJj0FwNQ8x9prC1NMhAz-S-Jfz3ln673B-jm6HTRJQ&oe=6A6F344E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUYJWQyjvX4Q7kNvwHIaOba&_nc_oc=AdqTwz1iiVSc7ntL3Pz2IRf3Vymqyf3u6uPxnY1vc8SKsbj9VkyRFCgXOMfwhBydCqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDYPsxUPuS37-r9JcwDShNMWyTe9PLEqzobqQPr5Kmmg&oe=6A6F4806"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "interne
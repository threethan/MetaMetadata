ulClgz1fnwhQ&oe=6A2575D8"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4pRlXFQPxwQ7kNvwGaVndV&_nc_oc=Adoov8CpqVV_BLdLZnPTpxiBX1sCiDGydc7Ye1LH9JpzRmJ2zZbfW2aHKptjY634aRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89YA18MamUjLvsNHwZqs2G850I1YiR_42WtqWrInVMaA&oe=6A256B8A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tij5wPWYXTUQ7kNvwHzIZ74&_nc_oc=AdoihI2JRNiGJplsYIxTh2vSI1LhDwLWT4-VOX0k8ntn02ctcfJN-g-vQ0Uv4MooKLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XW91IQwuuhT3Xqpc-DTblxgRDrpOgenQSRZ9VB7I3Bw&oe=6A258DD9"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUxU86noi_wQ7kNvwGvvs4T&_nc_oc=AdoxsptlyulGXi8t2XIdC0ZC5nfD0yp_5KInRIYZLycYUQ0mAXJbwmPgGvlodtaIzAI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wY8IwzwIdDChrsQAdD2BPnto6fUfVv3kfD3L_-DXoeg&oe=6A25988E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj_sHwAGZOYQ7kNvwFbT4xh&_nc_oc=Adq7cayw670cdQoxC-HjGogeaa1q2WtpNVGWdpKwa6AZnQDFZIgR6OUTbIxr4nDei9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8afdFw437z-nNsiXCbYsM0a_vHINOG0Yf20EXmYcdpUA&oe=6A257406"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet
Ck8hNZyE1HzQ&oe=69F8A2D8"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jc8065mmrwQ7kNvwGwXEy-&_nc_oc=AdrFlq4Rc0-SeKaAPVx8vnViYjdvOp38F5fXkCXvhP9CG6Bw5xKCDlruLRB1r79xYpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zEu2xSDRCY5dAT9DD7lYshdmHuZQgcCDS5jCYkBoWNQ&oe=69F8988A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAZIIhgBm2QQ7kNvwHutM6b&_nc_oc=AdqBCsHu77sFDGQOy0hRMnuuEWSNqRRHnUqDrYRq8qqZ2LnFBtng_6twcyzzxj_-pA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NgVI5HkBCYjG7wPFQFrhoUMPictykVADIByVRDGIbag&oe=69F8BAD9"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkgoq92733wQ7kNvwGokfdt&_nc_oc=Adr6MsK1pf6yE10SalFFkwfn3HOnvB4wBFK1NgrkyhYR0_KOKoxuPczOHRZZmI4YtWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Sjj4-CIDNPfh9Yyjq7MP611aKTXLqrGHfv_VNm-xovg&oe=69F88D4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkoL80hbDW8Q7kNvwHRc4j6&_nc_oc=AdqyWcQGivcrU46uZXkIaLuxYU6F5jX9JDfInIY6i8jUSxEr-vYgEIWdilgSQQ0V50w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0V9nsdPRoZaTebXmL5hLxqfNjvoNSocsJq5Az9-QBEqg&oe=69F8A106"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet
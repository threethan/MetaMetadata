lq2AneVrfJQRA&oe=6A4E5458"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gax6uBlU-UYQ7kNvwHNDgJP&_nc_oc=Adr8nUokj9QY92INUrL2lKDNBsxk4S-m96o1mRd2SpmVve6W0tvV2UtqwZ8hB6TA5us&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT10kIF78Moj-GOx0UxvU86Wo8kPeci5_Z1pVCOUDyzg&oe=6A4E4A0A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c75obAXhpcQ7kNvwFt9Q96&_nc_oc=AdoRbtcSfBtV4bkBAOGte6Q_ZBmmx7ti2W8srg-zY-VR47ZNszhcG0mKmioHW6e1UyM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcaJ3RkXipbEOLWEajVj4-lRbOQ_GhfTs8v7j1wzsphA&oe=6A4E6C59"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KNrlcBjz74Q7kNvwFODb6Z&_nc_oc=AdoMeFDp2iIWnFlH-boxySRS97P2WVup-QhntbFvyQFVcmEmD8-i-pixbyUHfs1I-Gc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzKeUb4D-BPnqVn7RAP-3iCnRThtrTg8QlL_6h8bzhsA&oe=6A4E3ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shQJyI7wmYAQ7kNvwHQy3hy&_nc_oc=AdrPSmgXZNgBi3TGbbK_fCS4voioYxiiPpaRoMYQC2DfsPYeFop-Vxf9PjBSqonT5YQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQfIctaZT4L3ztGRcxp00zcMCdxIpZlsGcKP9040qIFA&oe=6A4E5286"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "interne
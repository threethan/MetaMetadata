6QGXTg&oe=6A636C58"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ6aezco078Q7kNvwGsxPAK&_nc_oc=AdqQo_FCtkFPPxZrji9a2tdOQ7DLRmjMmyxsnZ4f5VMJR_EByWd-2CBa92qa64u2gg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPirjn4pBbpf5Xmkrpz3bBqFSiNg3Mvr6bdnztEDO_4Q&oe=6A63620A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOfkgoulg6EQ7kNvwEtv9WC&_nc_oc=Adoem-UjBmZannJ0nAJkIC9V-EJt4xwrivs-eeSjqhiaHDkBBeig7Zux0jDtlFcbxS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDA02kmRR4nUjx_5JDADY9xYjNmFDOpqd40k11VzEUp3A&oe=6A638459"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlXyAJNDCDIQ7kNvwGbn631&_nc_oc=AdoL_2nLurTn1X_7QEklo4tvHexcC-UHa6nyS-eEgAiktiHE8nO-HIft02LxFsF7mxg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc1ne9i2098Q29XpotB36d-e4OX9ScW1ZZre4m1r4FUA&oe=6A6356CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBk6cmpFw4cQ7kNvwF4gW-w&_nc_oc=Adpep9sa3a-ZkRy27alM_d1yPnc60pJ4N4Bzbh2YdmvFRQRfpuvugNeuxPizoVgRXBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxbyOP9eOzKog34ssvgWyeXywKzl9iYNQQEmSw8za1Ng&oe=6A636A86"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": [], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "r
tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c02crbcU7KAQ7kNvwGoDbqW&_nc_oc=AdqasSiROyRtMZc3fZ7jvq24Hrqm9IPWRP7ioyS9Ppdi4aC0VlTipOyXjM9OvcNXAXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRY7AN4VWkMCqD9vohoOLNE5M-hM79aUqGRrgfflJLyHg&oe=6B0B1318"}, {"file_name": "TTTCC_screen_08.png", "id": "3189721951348774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974561_3189721954682107_1522685397824527534_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zXDCMYEcC8Q7kNvwEG0roL&_nc_oc=AdomOoUds0xOKJAl3TonFXnthW5ocHaN2WoLel8bct_WT8HWKbYrayNuNO0YADFtvYQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRX4_STf8n6YHJ3T5bjYkhCTdXZRVdzWj_9LsLR4xJe1w&oe=6B0B410A"}, {"file_name": "TTTCC_screen_09.png", "id": "306628688350057", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974670_306628691683390_52503083219129247_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8hxEsTjhOUQ7kNvwEkJiiQ&_nc_oc=AdoyXbaWzDg4Im5i7PfY2aH15mb_rR4YCiOXMrgBRW-uUFiPlM9Xkmgtl5cBrIhEjx0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_55URR7Af9hcKHUbGFwFf3DWSnd4Iqv_e6A2yI6y-VQ&oe=6B0B2B19"}, {"file_name": "TTTCC_screen_10.png", "id": "774439053965159", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974447_774439057298492_2915913410607392668_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MFFKGxxk_wQ7kNvwGmHXOi&_nc_oc=AdoqfqXgRsvnqoGKv2GUvCgaJMvWRWYg29rhEBY8WbIB_yv5czwAmVo29KbSYNGzFIA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfB6l3KjT-egjiVNQSujJXGOOWivZaMAhHlT4jARoiAA&oe=6B0B35CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TableOfTales_CoverImage_Video.png", "id": "527498059052597", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974522_527498062385930_8535412789414279458_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNo1j3wwr_sQ7kNvwEk91Wo&_nc_oc=AdoplfArNdd6XySZZxGCKfXhpFD3CPqsQOYayR0XJomUWnQ6175S5SL5VrF6aMb3WRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTxA2VFWu8EHeH2n2yJPuquocevQOnLthbJWhpMjQFgaQ&oe=6B0B1146"}, "display_name": "Table of Tales: The Crooked Crown", "keywords": ["RPG", "Board", "Cards", "Mixed", "Reality"], "long_description": "Embark on a single-player narrative-driven campaign featuring a fully-voiced Dungeon Master companion, who appears as a mechanical talking bird called Arbitrix.\n- Guide a party of four scoundrels through a captivating story that is shaped by important world-changing choices!\n- High Replayability. No one playthrough is the same as another based on critical choices you make on the way, including throwing your scoundrels overboard!\n- Use powerful magic, battle, charm or sneak your way through more than 24 enthralling encounters.\n- Tactical turn-based combat and encounters feature dice, cards, skill checks and over 40 different types of enemy.\n- Each scoundrel has their own skill and stat upgrade path. Choose different abilities or magic each time you play.\n- The magical table transforms before your eyes. You need to see it to believe it!\n- Use controllers or your hands to interact with the figurines and cards.\n- Mixed Reality Play Mode.", "short_description": "Table of Tales: The Crooked Crown is a role playing adventure that brings tabletop gaming to life with animated miniatures, dice-rolling, and card-based abilities and magic. Take a seat at the magical table, captain the helm, and lead your party of scoundrels as they venture through a world of swashbuckling and sorcery.\nNow with a Mixed Reality play mode option."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tinmangames.com.au/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tin Man Games Pty. Ltd.", "support_website_url": "http://tinmangames.com.au/blog/?page_id=135", "website_url": "https://tinmangames.com.au/", "category": "GAMES",
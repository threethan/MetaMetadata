LocM6jBPgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LojXbwgF06XMgfFMB_e4Gt6oXWcKm4_XViqunqDPJ1g&oe=69D65FA5"}, {"file_name": "1.png", "id": "1455445265631342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302688_1455445268964675_990086014173713065_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bzBU9H3gnQQ7kNvwGCBxPN&_nc_oc=Adpx-LeaMafftMJ-qtXTsmVvWCeCfrRMU1z-SSASZMJLAHh3DXOAvwp4cDbGAAptCpc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ilQt9nCiYwyWhc_RkoUm0gjME7sKLlmildQZhgJwugQ&oe=69D641B7"}, {"file_name": "4.png", "id": "1389167305697652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308125_1389167309030985_723127171003907458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLVZU2KFPpUQ7kNvwH8u1RI&_nc_oc=AdoNkXjwto64KQRfwp1CXGnljKFD_nE2bZZ0IxCCIrDfhEegfFdKAIBFi3gsHqnLmGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XCWopnZiTXdbExPF0b_WWdr1EbmCRT2qyW6kXMJxopQ&oe=69D65FD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "1890666138169360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303174_1890666141502693_3972468297102493641_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZcaqWUxoxIQ7kNvwELY1RP&_nc_oc=AdoX_9W8dxl6lZeckCm77oSvaT6TKYvD03VDl9ihS8ux8S5M9D53wR-_Hm6cfi5Idm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00KNmdirbSSNlL2EQO77brrxos5wf7Z-eXScibd2UYMg&oe=69D632CD"}, "display_name": "Current Quest VR", "keywords": ["VRelectrician", "electricalVR", "wiresimulator", "safeelectricVR", "VRtradejob"], "long_description": "**CURRENT QUEST VR - ELECTRICAL SKILLS SIMULATOR**\n\n\ud83d\udd27 **JOURNEY TO PROFICIENCY**\n- \u2705 **Hands-on electrical training**: Install switches, troubleshoot electrical problems - all in hyper-realistic VR\n- \u2705 **Safety First Learning**: Practice dangerous situations WITHOUT RISK - experience electric shock without consequences\n- \u2705 **Task-based learning**: Turn theory into a task: Reconnect a broken wire.\n\n\ud83d\udee0\ufe0f **COMPETITIVE TECHNOLOGY**\n- \ud83e\udd7d **Realistic Physics**: Real-time electric current, magnetic field and heat simulation\n- \ud83e\udde4 **VR Tool Interaction**: Realistically handle electrical wires with realistic tools.\n- \ud83d\udcca **Skill Analysis**: Tracking Accuracy, Speed, and Safety\n\n---\n\n### \ud83c\udf1f **SHAP THE FUTURE WITH US!**\n*\"We build Current Quest VR WITH the community - Your feedback will drive our next update!\"*\n**\u2192 TELL US WHAT YOU WANT:**\n1. **What realistic electrical situations should we add?**\n2. **What tools are missing from your virtual toolkit?**\n3. **What dangerous situations need to be simulated?**\n\n\ud83d\udcac **CHAT LIVE WITH OUR DEVELOPMENT TEAM:**\n- Email: joneseivros@gmail.com", "short_description": "\u26a1 BECOME AN ELECTRICIAN AND! Master real electrical repairs through risk-free task practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9171361446299571"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id"
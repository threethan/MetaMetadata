791", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_1825109804735124_5235037831318867283_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODiKhk9sh0sQ7kNvwG3yyg6&_nc_oc=AdqsG22G_VYCfnkkmueuCE5oRdzbhl4RFBNUev3J3qXP_olp0uaztfoJY56lEKcawFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0d8MvI5GQ-rApz07rgAUlK46tBR2QttevvxvbPe32Dw&oe=6A79D9A5"}, {"file_name": "1.png", "id": "1455445265631342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302688_1455445268964675_990086014173713065_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vJAMf7i3UkQ7kNvwFeT3RH&_nc_oc=Adoql7r4Iti0gRIEzMKp2i-a7pzjVdCehsynw8_ctc-06c2VGzbbg4FQiDcls3udIAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN02gKe1dwya70mxFDrdKenDoTe8hn8bQP2r-4R7ME5A&oe=6A79BBB7"}, {"file_name": "4.png", "id": "1389167305697652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308125_1389167309030985_723127171003907458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIbZdyil43MQ7kNvwGvCeU6&_nc_oc=AdoUksWB23w2H6t9AeVAG1RhTuBmfo69Ch5HlVBlR2iqMKxv1m5Rw2ysdKtfb-d5Ll0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFabq5_J4QQsWCSBJQE04QMT-Fj2m45-d5zfKofmAYEgg&oe=6A79D9D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "1890666138169360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303174_1890666141502693_3972468297102493641_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qb0uSnQ4TJ8Q7kNvwH5xi22&_nc_oc=AdpxCe7mMuhLyN0vXVBcWHo4cGWyMaaI5FEspcQk5cCDARt2M0AOVdI62rXeK0aZEEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhSdCwpWwUV2B5KfiIFeFD-RZmpejfZ0A3RWDm886FxA&oe=6A79E50D"}, "display_name": "Current Quest VR", "keywords": ["VRelectrician", "electricalVR", "wiresimulator", "safeelectricVR", "VRtradejob"], "long_description": "**CURRENT QUEST VR - ELECTRICAL SKILLS SIMULATOR**\n\n\ud83d\udd27 **JOURNEY TO PROFICIENCY**\n- \u2705 **Hands-on electrical training**: Install switches, troubleshoot electrical problems - all in hyper-realistic VR\n- \u2705 **Safety First Learning**: Practice dangerous situations WITHOUT RISK - experience electric shock without consequences\n- \u2705 **Task-based learning**: Turn theory into a task: Reconnect a broken wire.\n\n\ud83d\udee0\ufe0f **COMPETITIVE TECHNOLOGY**\n- \ud83e\udd7d **Realistic Physics**: Real-time electric current, magnetic field and heat simulation\n- \ud83e\udde4 **VR Tool Interaction**: Realistically handle electrical wires with realistic tools.\n- \ud83d\udcca **Skill Analysis**: Tracking Accuracy, Speed, and Safety\n\n---\n\n### \ud83c\udf1f **SHAP THE FUTURE WITH US!**\n*\"We build Current Quest VR WITH the community - Your feedback will drive our next update!\"*\n**\u2192 TELL US WHAT YOU WANT:**\n1. **What realistic electrical situations should we add?**\n2. **What tools are missing from your virtual toolkit?**\n3. **What dangerous situations need to be simulated?**\n\n\ud83d\udcac **CHAT LIVE WITH OUR DEVELOPMENT TEAM:**\n- Email: joneseivros@gmail.com", "short_description": "\u26a1 BECOME AN ELECTRICIAN AND! Master real electrical repairs through risk-free task practice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
content-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rNhxz1V2jghYTpoKtDvQWhi4btRr-m2LbHW7XRrUrSQ&oe=6A468E83"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Story of a Restaurant", "keywords": [], "long_description": "The New York Times takes you on an immersive journey through one of New York\u2019s great meals. At the Michelin-starred restaurant Torrisi, Sam Sifton takes us on a tour of three dishes, tracing their culinary influences and origin stories through the streets of New York. The flavors \u2014 Jamaican jerk spices, pickling brine, Cantonese aromatics and more \u2014 tell a tale of a city, its food and its people. Pull up a chair.", "short_description": "The New York Times takes you on an immersive journey through one of New York\u2019s great meals. At the Michelin-starred restaurant Torrisi, Sam Sifton takes us on a tour of three dishes, tracing their culinary influences and origin stories through the streets of New York. The flavors \u2014 Jamaican jerk spices, pickling brine, Cantonese aromatics and more \u2014 tell a tale of a city, its food and its people. Pull up a chair."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nytimes.com/hc/en-us/articles/10940941449492-The-New-York-Times-Company-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "The New York Times Company", "support_website_url": null, "website_url": "https://www.nytimes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "361620458439488"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_
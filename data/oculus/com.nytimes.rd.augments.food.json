9984282689", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982691_553909987616022_5291396860249290080_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUuqyv_iuE0Q7kNvwEkKUw_&_nc_oc=AdqI0BLl7nMHe7J8SSON_bcyuVgqHNQniuomRjdcGpbCF2OVZu3p6l6kakEy718zP40&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqsn36646ntFq3j8FP5Y3eFeN8Pk2RTpzkf0SrcB_HVA&oe=6AFB2C03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Story of a Restaurant", "keywords": [], "long_description": "The New York Times takes you on an immersive journey through one of New York\u2019s great meals. At the Michelin-starred restaurant Torrisi, Sam Sifton takes us on a tour of three dishes, tracing their culinary influences and origin stories through the streets of New York. The flavors \u2014 Jamaican jerk spices, pickling brine, Cantonese aromatics and more \u2014 tell a tale of a city, its food and its people. Pull up a chair.", "short_description": "The New York Times takes you on an immersive journey through one of New York\u2019s great meals. At the Michelin-starred restaurant Torrisi, Sam Sifton takes us on a tour of three dishes, tracing their culinary influences and origin stories through the streets of New York. The flavors \u2014 Jamaican jerk spices, pickling brine, Cantonese aromatics and more \u2014 tell a tale of a city, its food and its people. Pull up a chair."}]}, "developer_name": null, "developer_privacy_policy_url": "https://help.nytimes.com/hc/en-us/articles/10940941449492-The-New-York-Times-Company-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "The New York Times Company", "support_website_url": null, "website_url": "https://www.nytimes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "361620458439488"}, {"id": "434961926215971"}], "exte
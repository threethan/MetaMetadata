cb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CRgn8OrZNAQ7kNvwFPrqKH&_nc_oc=AdrSBY0TlIUa04u7RE9if8Ymz35L9mJ2GHLj9G93Y8QwZk5EXUy3xtoJ1Y8U9ZA6V5A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxbhz0xJ-frB0gflFGwxs34P4rXsSsXtMu_W0YrNb8H0w&oe=69C51130"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1JElQD8vbcQ7kNvwHUlIBy&_nc_oc=AdpqfT0sKO_uKP04GxYJCVfrBhFwWfCmTya84-Mq-ywy1e6kvF8aP3BKkpLWyiK--b8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9V9UpwWTDrNgsqqOlG31M6_JadoRPjxLNUZ9syGqzPQ&oe=69C5209A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=918gWhf2jOMQ7kNvwFqEVFX&_nc_oc=Adraz2YLjDG4fiUsIwgBg0Q2kMQedRNNHaNGSCYa-9q_zC_O04CeEtJKpRjxSPCufQo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCld0u4XWgpY1eHpmhKX7Iv-N7cQa6Au9zACnCNhtGMg&oe=69C5318D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAQBdyZtvRwQ7kNvwFOIMSc&_nc_oc=AdpTCx-9ObZwYA1ekrx64qB-fP3dlxTorb_aAVYcMe3GgrTJIcBFLYR1DuRV49PNc5c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZnpO_gFf2fa_HIe7rSIYuKzowKv90JPrLnwYs-d4IVA&oe=69C52AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7LaRu9mw5MQ7kNvwFqWJbm&_nc_oc=AdrAQPjfO0wCCdIZHZvBP_6gTtgoTvMuOVRSx8z5I5ndBYQ2q8RG3E6zhGmMgt4gm4Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwT1THYmIl08Ycac6s81OgKkpkbHAgz_nqppL_vYSgORw&oe=69C53230"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoqkFFTlJ3oQ7kNvwH0Ndqa&_nc_oc=Adp00FnsL2qSNGtZkpJjR3qQUf1Caw9A19ZckpEmPSyezuGbTfmy8q4j-BAGWeRV8DA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ylg9i8LfoAmEkhXrJL9avcwe450u8hgRgO5vwiYoKiQ&oe=6A47CDF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n354FPAbAQQ7kNvwHa14Jw&_nc_oc=AdqZTZGF_7D4sqGxD7JsWGy9wZX8-AGj5-QlxbG7c8FVxKMzNab_5WNJEJDGXl8WG7o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LHZfwLj9RyEA_YlSJzA-AdUyMZ56cTKrxZjRyju75eg&oe=6A47DD5A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nE7-G7yC-iMQ7kNvwEgd58x&_nc_oc=AdoJUbyyP8gjLD68cp_ZtLUfTOQ-ubFKcb45YM4GHk_irdFncHDCxSj7NM3HPDl5TdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lkc4HBro2IY_lx6GXxBKXNa6dtaYQ6B3bU8BhBeU0OQ&oe=6A47B60D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9oxXJQ3c4oQ7kNvwG3uxYF&_nc_oc=AdoKrF3VkEGvf9pYXawHR6Jk76MPqVMBWqf29LrdSQ-0SzPrBXXBGwaWDZre3beth94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JKx7Rg_wa-hRzIRHcWI9q5JeKeADsHBVs5PgVsYI5HA&oe=6A47AF2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ar6hPz_o4z0Q7kNvwH3MNCr&_nc_oc=AdrBMeb0qIdEX2HDcKmrTLJ5S7dLFf2jK8L5IFDXP3Kr5oVSdjxqy_GuWQZLZ7-iVQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uEs9wKvBluf_7790gWYUOKs-I4IlI9s1_XKtDu4Ayeg&oe=6A47B6B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
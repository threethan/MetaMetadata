uscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-13pVodKvcQ7kNvwEfu9ja&_nc_oc=Adklc_UxCnKjFbsz3vQZsmuYid0JLIjPqYGCb1LZV2ZKsnnlmWppXiGhxjaUwJ99ZJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsna1Y5QJBCK2HcSafkX3exrzdIstwDl0R0XJOTzfH6xA&oe=699C5563"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZu5zdyoMycQ7kNvwGbbKbU&_nc_oc=AdnKL6042Y2ax33nAy0ELf0gYr2d0nE-_8XwIFpFwkZmCO40nH6YYrxopQ7CAIxD9Yw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft21Tb-SF7ZsAYWL1qtaGLDDsXp-gpqLI5hESslren6yg&oe=699C3390"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwyNSq-_Z4Q7kNvwGVsl9R&_nc_oc=AdlzM-0p1-LziP7DQyiofHRlwSzFAVRMCXOjOmhRm1NhFjLrYgK4WRsePWI3vA9aPtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpFKxVQDzxCxeO1er8E8BpAvl_QYBA-5rg5Tn-in--sw&oe=699C4F50"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1YPHM9N0QcQ7kNvwH_7YRk&_nc_oc=AdmcvoZwA_JzHJoojjKJaVFVf8as5ICthZspuhy191xGbaIbC-VsWfhlJNEK_Y2WSuk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv-WTQAezaRqGHOa9AXWFNxk2Y_bIQF64Kx10JiE3zv0w&oe=699C4401"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loh4X4sHxRYQ7kNvwHy_eAi&_nc_oc=Adn6zoiadn_-RGze0i3uW96ez0N-dn85GKaOGmoa7JLqZWv1ZZUdHiR4LtpBbCQ18f4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu76MeDZaRErYNAJ0K5VY9FLEE9EDx3bSM317V43WbiMw&oe=699C4C7C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "A
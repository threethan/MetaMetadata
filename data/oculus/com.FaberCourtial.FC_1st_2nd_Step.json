cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy1bhTKKePkQ7kNvwGhA_NB&_nc_oc=Ado37WtbXvJODRb8JuUPYbQClTLVqbK5GZmBZRbUVETNv0uVQ6tAVnl_x9JmCb-ZNX0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L_af2e4Qc4UlWcLlSNJjZit98EZM0Oh2E7OGNuigrnw&oe=6A413670"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrRHLl7mXMQ7kNvwEwngBQ&_nc_oc=AdoFKxA1hA4BjGBcHB9Wn7U2yJfQlKzfdwmerkaIPCXh_1PPqfcrvuL2B_xdFxFI4iQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yC-o8s0Y3IjmQqPwQOEtd4_gc3f1huOg8o2bTTJyBLg&oe=6A4145DA"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2v3HYrwm2MQ7kNvwGEUXUO&_nc_oc=AdpwbSBrJ_eHfRWQcSPrm1i9oyVNJmsKNJbYDk4Jp8n885pHEvJ732hWztsaEKVn4tk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Iu5B7zV7pgUCRFS_r8wUGkoW7NNzFix450jmYvEPKFg&oe=6A411E8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF7pbnnws0sQ7kNvwF-CYzX&_nc_oc=AdpXFmEQD_Ocq2nYQxwahA23gdZxlw-tK8DStojnyai-HGJKsdp9Jr3WaP_JBHfQJSI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TbZZjehDaZJVdzkWFqIUkTovAympQtC_cujWm3KQlgA&oe=6A4117AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdiJkcaBjJEQ7kNvwHnMTtl&_nc_oc=AdpP5HcP_lYsWwvhml2VESIZbN-L7IgdteoatTfhgPHga-5BsyDr0pzNlCaASOMPrtE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xDr2k5mzn-C8EadrzOZtNl9ifj94luY3R0xm8YjqJtA&oe=6A411F30"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
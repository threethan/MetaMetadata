cb=1-7&_nc_sid=6e7a0a&_nc_ohc=f45o27t9dDgQ7kNvwFniCN5&_nc_oc=AdrfQFldBwPqJVQHfqbQoLOS9oZdkvvr_phmHm4Hf4rTgyZIv82GgV6FiEZLoN4PNzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09ng19v1bIuvqp3_djytP8DsHALZScaWguIvW1rfDF5g&oe=69D90FF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L264Lf71rXgQ7kNvwEtl3nA&_nc_oc=AdrgUg7eGhg-wZ_KDQCN9siraKSMUqdJMm_HFuIzj1yz3ndvxGTtP3hSXim6GoJVbWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_TwJ1sWpn0UAxyqrqE2QzCgK3Ld72K8y3qIJfDmOw6g&oe=69D8E71A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jof7sNw8NRkQ7kNvwEMCkOQ&_nc_oc=AdqoZwtbOjAFVNnzfiRjFiJNZkyZzTRaIa6GM4aFPTabViyeaTmFHylGkCmwKzSRz4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eimdl5_cudrOI8Y2Vt0I20sMsKdzWYUtV9_nzv5TSGA&oe=69D8F80D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KroYF_Di6MwQ7kNvwE9j7L6&_nc_oc=AdooP-Ducv9AFbhSeZwyyI6nUdj9dIVMvwEUD5UuCFqmNg5wzOop6s0ZsJm141I2nhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JQdKAO4qiDEmhkT30WeccWJaZlDwkSk_1Q_EKqlvxgQ&oe=69D8F12E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKTt3-aWHoAQ7kNvwHF5TkQ&_nc_oc=AdqyoX8dlVKbp0a0MNUScwWLRriNS8QLKot_in3bdn8aYbZa7gu74LgjWmi_47zApRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PGtQYWFAPVzlt3u5_o40ohPnG2Q-O8G7-Mo2XPrAvVg&oe=69D8F8B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
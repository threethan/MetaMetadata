lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU3cD3iDsGcQ7kNvwFMU_Bb&_nc_oc=AdpPR9x_tBpapOpZRDItyANGET8ua7fMkfCbD-XSx32WU_nfHtqWe5uB70b1d6q3Zx8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlhBfe-ePxhw2T-tBL_eJ8qIW_t_xke8S6ZKaKqfg74g&oe=6A7C6B2E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPsyOn_ew0MQ7kNvwFJnDqL&_nc_oc=AdrkcjhVhUN5_ILTe0ZiByStxPro-vps2Nls0edl3k2vbpA3uC4yVSSkcvdoAbxKtIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES7-5l6-7Y2VUYDQGI8rcO03Kj6veBMv2Pp5MRVln37g&oe=6A7C720D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUBRndcJLLAQ7kNvwGYblMO&_nc_oc=AdpNBzQRGBzPiL71Jxp1K8MaHwdlM1H27aFDsVJMBtD1wcxXDtDY2M2fLZBNMnbfRlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7DeF6D9o8SGa7B8HilLFCeKMTTYvmtw5Zs4JRAzVFcw&oe=6A7C51B0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjA4j9B2lisQ7kNvwFxj-y1&_nc_oc=AdrMprP3LmMNhVXtItM7QLG8K-H0xJW5SjuPedkMharcOuX3n_NG5EXhYIH5o0Uc9kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLLOz0wx6okVGPoVid7kxI2XJaB65qNDsvOoM9VieIYw&oe=6A7C611A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKaRWUl_NT0Q7kNvwGmB1mA&_nc_oc=Ado1eOJG2LsyNPn3YmcoyGY9iXwWPu11IsFuTamFrCyxbILoJPKDbq5dLO69osmrRmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA-DuFAxU1HPPyj5pHIt4b_MP0MP-nob3aWz2IzIgatw&oe=6A7C72B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
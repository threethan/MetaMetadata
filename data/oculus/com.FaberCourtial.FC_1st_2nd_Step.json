lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAeCxZqanwQ7kNvwEm3wy5&_nc_oc=Adp-OhvyUU3-y5L_d2B7Px8LnVAJLS3HC6QXCreSUVBLrq0DeJIQLnlUrHn_CkuriZ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HP12oDR68l5xPupu1jc9hhSyNKQBkEH7Y2zf_xkeYUg&oe=69F5F22E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzErjdvI9WQQ7kNvwG6yTX2&_nc_oc=AdqNqKNw-IJUsC4Y3ntuYxNSLvVqnNlek4hJMyWFhH9uA-Nk5P4qrv2GKhFMFZUz06E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GNq694Yeuy6EGYxGHlA6Go6O7WJOZczc2CtkkDM2aFA&oe=69F5F90D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD0TXnZzRfQQ7kNvwEp62uj&_nc_oc=Ado0yoskvo6v3iTsQQgzwVopmGzvld_F0KuMIE5GLSnKFPxXiNg6t0drusJ2DgcjEgw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01nhPsveX6ZXzDGNmQCeEk6Tbt1GqYST2JY_Rikyd2ug&oe=69F610F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr693L1J4bQQ7kNvwE5JVRZ&_nc_oc=AdoMXa7GApu-MXSO5UYyeH1tdoPAcF666eJBnQ7phnqzPz8jdHOxT85yyG9N-KPc1_4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1WK5jKjUAW-hpo0XDDRq-C0vakUc4-Dmd3myz9b1j66w&oe=69F5E81A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TReYBlMiQUQ7kNvwGyXofx&_nc_oc=AdpMlJ794800FhaJjhSEcX5M3NADUK_-YolSoYjXyoZ0_APbjU1Puw0_mMKu-9FfJps&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_zU1ZtPZ0AFu-ps8rDDUnP7SOQ-sM4FIjv5dmHAQ2UQ&oe=69F5F9B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
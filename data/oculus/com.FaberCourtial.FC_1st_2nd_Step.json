ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh4HpltOyHIQ7kNvwHv1PmO&_nc_oc=Adqq7K9wBPf5nvuLSuNvLqF29QbOngtKYU-EUax-kDR9z-5ego7kfrg_sgjLp1gJWp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oP7CEw_Rb53AeuiqAqHwZtKJqAgykvxnZMuLRpwkkQg&oe=6A257163"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsdtdl0Vm8UQ7kNvwF0_MgW&_nc_oc=AdpY2_ydkdY7fvjcfyySFW-0pKKxD9okiRy533-h6E8EeZ9bYGxBlxrM9bMDPmuzw6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0zBwzC_zbbKSXb0Krq_2ujaEwODKdC55E4-NfBGzXSg&oe=6A2587D0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpnpYlw8lf0Q7kNvwEoXlHK&_nc_oc=AdoY9jNb1p11debRHuSH6tFuRVtBCHPolkxZIf4QvZ8-iwIN0c2ierYeT4nGySKPvkQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_36zxx6XlubVbKQykdFY2_--x2_PNVEvMiLwHmqG6CrA&oe=6A25A390"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIvS-u6UtHMQ7kNvwH3JXVi&_nc_oc=AdqoMY2k3vl5THjObB-ds-tzfs4ZkjSnfD363qpVSgv-ucvbPG68cYkAFRgxXSL_Cdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P7D3_K_cqMxamm-NbvMrK9N0tSGC_neluKJgF9ccaqQ&oe=6A259841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQy4-Z8fcCoQ7kNvwHARfYZ&_nc_oc=AdrZn4aG4Z7tg591v3XDGlNjUX8AhuQ1INPb1X5zFdxu-eNk4JDISxtz4VF4grgl01Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OgQMhDFEwEDAVGpGl-hRoG-KY-DO7U_WEmtUX0v-3_w&oe=6A25A0BC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
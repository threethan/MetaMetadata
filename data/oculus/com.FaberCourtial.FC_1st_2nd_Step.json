LdkPALLid3h7R4rI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcVQveI5tlM3v4LlCHBkk9ckAZ3iVljKvP-A-K1ER9ow&oe=699DA6E3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZu5zdyoMycQ7kNvwFZf3_I&_nc_oc=Adl2GcQ0ZdEFYIp57Q-QMHU4EIvsaLfhtECLtwkjNIysehBUVzLwP2IZwWSvMCNYZck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-h4FKdS73WANXR-EW5SkNH6V_LBZ-aord85wy-JIaoA&oe=699D8510"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvwyNSq-_Z4Q7kNvwGJu40w&_nc_oc=AdnBsQ92vLTfqfBMjvlieBCjNeFKPjjJENwXG-dsBVU2ZE6bvHZvHL6u7F8Wti7m58g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9XO9K0vDgbgrsu8hyoxjHzUJLbr4OGABsUMTjrjWPBQ&oe=699DA0D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1YPHM9N0QcQ7kNvwEEc63F&_nc_oc=AdnA70D-GwTIk9VZdcofZrTmTlrQ4pnn1b15gtol5OEMueRcr69Pbsk_TfppS6ny6_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuC9U2R6-AGSrjce_ivYp8v3f79THK4CrcODL5ZiFRtcg&oe=699D9581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYv-kjzCbaMQ7kNvwHoiDgF&_nc_oc=AdltAkqKQyR5miroJ3UjBVrDSNymd9ji3PEGYBh3nCNrhAap8gKIa3_-W6ACwYHob6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftn97c_u6r7KtO35wQM4QkCZEXQw4Uy5qLEB8uaWnYLqg&oe=699D9DFC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "
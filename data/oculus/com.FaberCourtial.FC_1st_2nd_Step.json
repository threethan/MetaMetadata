lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAQBdyZtvRwQ7kNvwHYHLCe&_nc_oc=AdoDm3bIxE5teRq-fca-5j0lFj8OOQYy2uAkXnrEbvuT5RiW6a4nZ35NsjZI1m3Bh0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr_sz_ki5iT609niQREt3cyQNmNFJHN4hEVen4v1n37g&oe=69C287AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=918gWhf2jOMQ7kNvwFECqHq&_nc_oc=AdodpC6ok0nurlq4e9eNW-ZDQnZbima2tICdJM2tCxMHTv4vfGS71sJN99C8uRkg4rA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMu0cw5KPZ7YckpyOGOVDurzxfG44SXXJqCF68BzDabg&oe=69C28E8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CRgn8OrZNAQ7kNvwHuxE4F&_nc_oc=AdrjXSLz17GugXLKoo_8Nnj-8mjHdAH_lskzngG_ftV-pKAcqpj8SLV3m_xt6WHOryI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjVLY80VsYds9smpyw-yDBXORvmZ3SvzZymtz2WMNw3Q&oe=69C26E30"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9CThZWo76IQ7kNvwFyHFR0&_nc_oc=AdpqBhaWiCdr46_vSQxp8X5I8JAlAH3IuP7VicNbIyOa2x37dEwoUp9BHt-MraIMWf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTJQnxUCMTj9R6j7kujtrQPzB1beMB0ROvRDuKDSqjfA&oe=69C27D9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7LaRu9mw5MQ7kNvwG3zbt-&_nc_oc=AdoXJbo4vS2UgBUFzi1GReRVxJb77XHpS1xvZ-qne-G09DPMr5Fg7LZfN-dXrN6gSnk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3KnXv_9oJAM2PqGH7SN1WYSmkssBfT770C_4UihiuUg&oe=69C28F30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
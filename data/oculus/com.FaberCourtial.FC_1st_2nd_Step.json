lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TauTMJArh08Q7kNvwEMZMyT&_nc_oc=Ado4CBJOxGv6SAzfyO4LXsA8XdQHb9u8phVlzyCi8fgu_6FfG6r4cxdHxC8niyZ9xys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf9xcfaEbZ3AxSmwzp7yjAkjtXx_XmDH8qWNbwuKNi1Q&oe=6A5CC72E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIyzcKsNI-sQ7kNvwGEa7t1&_nc_oc=AdoG4PiXG0GSKLh4ZU32--_atzDMFabMxwZNlc9AjPTilbF5TgxiXFsB--jbdFF2V1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD07jO_sECGHwgC1Vc0h3MmwMrE4kUigRuY_N1fcIL59Q&oe=6A5CCE0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GscGuIWgT9IQ7kNvwGyTDIg&_nc_oc=Adr0uak8H3jr9vUVQ_SpTjmF2PYGl4UQvGAYRVzz2abXmtyXttzaQke96u-13PD_wFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQDm-f01NjdSI461cqxYgIdy5ckeNWVaSWHkqlAfJyWQ&oe=6A5CADB0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH-cTPPisW8Q7kNvwHWOx30&_nc_oc=AdrSoMfjItuaB2GzUILlPhWW5xVsKW0F4CgPgKNFJsd1cui18vDFJ14wj-ew8RpGtSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1fJ4A0pCAJ37V7K7E0AzSMKHe99WZSGvLC80WPRshlg&oe=6A5CBD1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhJjIBydPLwQ7kNvwF5ZP18&_nc_oc=AdpLxX1qBidlYv8UE1vDeuL7viYfIBHA62pVUedV1QnB3C4h-aYAaq-dkr2Pgty6CnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX0YcVDc0D70dbKjOmP7PtXyk28-V0JCvFyCp21aiXww&oe=6A5CCEB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6cWNaWFQ4gQ7kNvwGC2CY7&_nc_oc=Adnht7nUg1FPLkiiX3ntRkxMEvDTnS29sqsZH8eTmgh8v8xVm4_wbTFMkRib5YCCTdI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsVgOjKwabqHwktVUJcNn--A8hIBgApodrch2Hc4Kg2Ow&oe=69A1881A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFbLgfR1fVkQ7kNvwFzpIqx&_nc_oc=AdmwWheLPESLU6RYQl-6ts4aXXonFdg30EwEzY6id6lDFji3p2oPqkzZ_0tXE0ca_2s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsuQMXvaLaJiUUakRUKdxsoITdV1wd1GjjKE_rEEtShdw&oe=69A1990D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4BoepQxTDgQ7kNvwH-gPnf&_nc_oc=AdkRfyLyhj4kUtmqXklMHlFx31ypvTUAwpS4RYk9S02njYU3R4GNlpPSUkRWZf3pHEY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftLyTu2eBdQfZLoR1ZDNB8Oh3Erw2N0LA0KItpTEjJ2fw&oe=69A1922E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G28W_3GHIBwQ7kNvwFe4Y1e&_nc_oc=Admn8_v9TwU-it7HAWp6IIPCGSB9F4osoL6_qlAdc8T70qvHyvJdR5DYhEmeIYBhE8E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftYGMncpf8JSH0f6ZM75fK47GIcoLlFEYz04tereztz8w&oe=69A199B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_p
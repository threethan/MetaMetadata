cb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR9QjavGmWcQ7kNvwFMV6AR&_nc_oc=Adp29Htsk4u_4030SNo-7NB_ClA3V6ChMGBIJ08xZqUACVRi4ocUD3XrjYWOC8ga8v4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC4jbYrR-Gvja3QJiN-F0-YtUXxPHjtFF89_aYRBzxaA&oe=6A804630"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPXXbu1bdmcQ7kNvwEwfOK1&_nc_oc=AdoG1BoYhhDj0nD2zNT3L7GvxLpGMLWrfJwz1_87XcdMqxgcAqic7ZoeNl0npxaGeko&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpH0lfRcjcX61xgpQH9pVSPGwwKcUvTwn_r8SOJYRa9Q&oe=6A80559A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRL_x4TaAGYQ7kNvwFBJoY-&_nc_oc=AdqHDoWgtda0ZvzLR-kNO1pOajOah_H9NlScAkp0MNDib-xlvJLNwPQPApkzQfxyyLY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl_eaCOwpeN0K9qQ36RHI5xX1qrUqvVBqu0mfYGc8U3A&oe=6A80668D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VK5bp_Deq2AQ7kNvwG6fBIb&_nc_oc=Adp06Tqy4Ov4TiKZIbm7ZsaSxHKSWYoS0DltYvj9uflfoYREcDYJkqAfo_eO-JYZVI8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4ezq9NYhDaQde2CLWwTt4mwEGpTz8WQ5R2o9HkGDV5Q&oe=6A805FAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjoc0EOe0yMQ7kNvwFTLfud&_nc_oc=Adq0nKmgg8dh3A_9Rsnh7KLpIQvH9zGzSvTCyoRZAHW4sk6O72Ns_t70JI_Ej6-p-9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYVAwWMCEAxdz23zYucc7URcr6BqVUDd6hCjj9V3ORPA&oe=6A806730"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
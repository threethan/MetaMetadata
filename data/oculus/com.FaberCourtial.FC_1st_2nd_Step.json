lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4LKfOY0pPoQ7kNvwEmQN5K&_nc_oc=Adr7tPscStZ_tsWQ3A0U5HbKJrT-kHQYhp9cKwcZgx0R2jhsqD1pGCFlCYlOIpj2JTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwgjBgR3iz3ma0z1GHZHejGlzwVnh7yQyOD1j37gA-BA&oe=6A635EAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WILNjRGpHi8Q7kNvwH6-ZSN&_nc_oc=AdoC2yiG9HZcvtH4bKGwha0MEOBSqiunb027-ocGvECjPVOX01NspjGqF-509eZN8Rk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw8XL8fAcfBzs1KxOvC4OlzkYQEyXWGFcI8g2z7mK1uA&oe=6A63658D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9nvKhYbsb8Q7kNvwGYKEjR&_nc_oc=AdpUPYwysfH0S_4jhUvVuMx046oE01K5YifkTLvxTnTr_FuVZiKff9bWG8Gu7CTN_H8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4EKEOZ5nuCWxM5jqEMwJlBJGPYVSAJdJcpvcThYquiw&oe=6A637D70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdn_LmS56Z4Q7kNvwFwY844&_nc_oc=AdpLFEgPI7Gq_89kK0lWZv1u90tmH-_NY-XoyxSYzW3A_HSKW-sjRSwd-48e7G97QB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJTUYd-8htEBxcsjZhI2zqq2VpaFpXAm2_iTS1fxyHdQ&oe=6A63549A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpc_Ls6r9i0Q7kNvwEfXMky&_nc_oc=Adq1TYPsqjDjEe7sP4UvNEGjEVamPEND_8F9BOoxv0e66L2Qk0hsJ53-_4s2ZsZ14Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVAJeJ38hpFdD7vK0RynKbKM7SyKnyH-7Qa3KHitWXFg&oe=6A636630"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
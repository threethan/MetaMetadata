cb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtpKNAoEyAMQ7kNvwFsfR05&_nc_oc=AdrXgyWW3n9Nr741sNG8oXqxNg6Fu6PAGa5bNjvLXPzLbRFFWP8ycfLxtBiaCbtxfd0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fmG0bhv6K4P2S0C09DEgygtgAojPbOrKSDUcFhCMk6Q&oe=69F36DF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr693L1J4bQQ7kNvwEIAhJ2&_nc_oc=AdrJVgA2uBssIlC2ojVzWGkhuNOXJd4hR0uP6aoDb4I8c6qBSPQjnpFfM0GEiYxX4RU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2L85VassfLTe9jVPeriKZPSldwS38lW-xOymJfh4gwDA&oe=69F3451A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vIDh98kw2YQ7kNvwEi8VTE&_nc_oc=Adr-FBkE4eoxSbV-8g_v8lXptBdPNmfKyrNGbGjBK5kJpW4t0NjaGaE4tEBzJxnx70k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WEMX5EFAXjTG-vb6y5AlGl4UEias_3YU_4cCNx4y1QA&oe=69F3560D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GY-L3t8MpUQ7kNvwHJ_gJv&_nc_oc=Adq_Cvri-7PnNXvIsrlERYSuWW7ZXlZ7M8Ulb0ZCj1bfvYPWA7kvtgZK3MaJwMF50j8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Yz3qMyjqRnyyPZCf64SB4CUIgA1_xQZ8hpnCWZ7-eGA&oe=69F34F2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzvrFWfOgnQQ7kNvwGBgTF6&_nc_oc=AdqZPrU7RljdHrYMoWoVww7WPPoNIEGdQ5t1v6Pu5weu3M4tHXH9_Eaz4eUhpF7lxAA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y4Q6C4zIOWBsv-aQWC3KEb0hut49eaIsnUhNgo5Qbuw&oe=69F356B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
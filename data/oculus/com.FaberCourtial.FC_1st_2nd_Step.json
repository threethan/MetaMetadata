ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isr47GxO-qsQ7kNvwE_ZfFa&_nc_oc=AdqhqTIWadAYpdgXH8BD6zW-bSLeP7Uka_ih_PYZXRIacvSMSYO-eSVfya5Lj87UnI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZR0qlPXUra8ZImega5KUR4UD3J6QjleMGTNoS1hRE_A&oe=69E8CC63"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EVW7Ydzh1EQ7kNvwE_VGRe&_nc_oc=AdpHOf_sfmEYeNNeDklOq1KBR1cHWh2ndC7YqMjwLFeEKiCwfgsRovrDdsnXkq6ACwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Kajs5H4vbTt6PSvR1GAahw8IvirVmZlpm1yEwaC9jpg&oe=69E8AA90"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOPWbf_vqOoQ7kNvwEnCtp1&_nc_oc=AdqfM1fD_UYnfP5aaaJUKcZ-EOj0NoiLTuOtt5xStgqvoOi8Gc3rud53Z9IYOxIa11Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NTEfQG1CbR6tyfL2rwNK0J4zYhWSSF3tAx0NMWK_gRg&oe=69E8C650"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd4LIDIglo4Q7kNvwFEYVWK&_nc_oc=Adr_thGcsSS8ORen2WXFthTwg7lWK1QRtjLwjjYlaxgt3b08uv4HipAq-bELOuqsq7I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rFlLAyxLTufN-1A2U2knnFkMgNhxO70GxFH3GcM9BOg&oe=69E8BB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cKenVVik-sQ7kNvwH1HzyW&_nc_oc=AdoF5E5NwI7H1MW7T8iLTBynygFefyTTPVEK147YIuv-A0CEBaMHMY2e459HrFvS_-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LlyJL8kSmHO-zV7tkGR2R9_6P2yHg1CAKenh4A4iydA&oe=69E8C37C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
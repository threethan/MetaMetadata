cb=1-7&_nc_sid=6e7a0a&_nc_ohc=jloAbB-dkyMQ7kNvwEjvYvV&_nc_oc=Adr7Zd5mCaVN7odl_ZE5-Rv3vpmBpU7FG2g8kNUx4E801Rvutc3X0cNBSAZyltRiY10&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS6_6kBxraT2OZ5KUKwtnBO_V8p1oh_rZdswHLD6JJFg&oe=6AF330F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SVVynDdq_UQ7kNvwGLh0BX&_nc_oc=Adp4Kq04hIbtSxQ0KFS2f4qAUXR-rENEGHFC8yikmWXlS14MFqXEULorR923QJB_0HQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwo6AyR-HuxwiYxt1vjgZH2qfg_ogaxTEajmPA11ARiQ&oe=6AF3405A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FiIvx_Td0gQ7kNvwHk_-sQ&_nc_oc=AdrcTIsupIi2NiaumlZLMQUf2MbjGBGpHLRHZfUmtvsjIsgkXupUpaiI9POTjm_UQRo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-C1DV0WxPNdfja-qKpDpSsE7tPeclToLJcfox5X9peA&oe=6AF3514D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67rkvnqDewYQ7kNvwH7uQIo&_nc_oc=AdrDTO_dZGXNQiKGNEGzUda_YIVbwZWqQlvi8ArEyWFaVxcdKUXrsY6fg3tcmJ044O8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVhepnVSBTsHu9vQqG5czlUj7Cd3qr0g3Vvxl-QJIlJg&oe=6AF34A6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtStWhzOS_gQ7kNvwEAOEre&_nc_oc=AdqPbiIdOBHWXvbSLeW_oavG7CLYvSYDPpFzaYk349A5Fq96qI7A6GFYL6efsOgARAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStjDRQvJaE29qQKVtYTGIOiiJrYFAINoXG-RqRiwrkEA&oe=6AF351F0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
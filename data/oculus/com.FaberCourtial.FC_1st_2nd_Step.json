lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE1Ymwbr5ZcQ7kNvwGhfUoH&_nc_oc=AdrPHtO5mYALueOqgUl5gI7qkSp1sU_iqHaL_-R6wvAT8dL45K5LbDrYrF99Vu2OzgI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QUxb2aUW0kT8Q-bV7H1u6OFQBkAsImgMJcWFF1TPnkQ&oe=6A2416AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zucZeFewoCMQ7kNvwHKaA7-&_nc_oc=AdroyzVmq9SRCHEftUNlxdHrx5MJEjUHxcLyZsAWnE7gSXpjJ4oAuLmgtuXxaz_X770&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EsCHtonV-vq7dNBFfbEuvYQH22Y3xJMXhBaOe9oYtYA&oe=6A241D8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdUpz3ICGzYQ7kNvwG5Ofr0&_nc_oc=Adr7jMglBpYcc_F02znOI--89JGE45H3JGhBgonLx5znLVXYJ0xOJevmX2RPxdNre7A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80nJlmCgLjYkM5dpsgNYFuvrwCPPi5c4w7GPa4pMGN1w&oe=6A243570"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwaBwIhL5UkQ7kNvwHQX4hr&_nc_oc=AdrZRdaTtUOijAe-tlciDBVkkYxcl4gTjdaI8QOA7DZVPI4X6eQACuj1wgX85LwLR-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JnpXYIT-hon66-K7SwA_veiYMdNXc6AC-zi1lufWkRA&oe=6A2444DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx3_RxT3UnUQ7kNvwGlGeT3&_nc_oc=Adp54qtsvZaMZS2fgK67bVIc4IizJztfjYQMQsO3cDVqrbQw_E21cSx3_Loqe_bwpQ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GSryHKfml9wjByMzSFtdMIEdAJJ1N_AQFPkS6G7DFZw&oe=6A241E30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
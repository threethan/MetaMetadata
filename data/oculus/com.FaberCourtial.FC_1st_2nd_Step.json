lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79gWsa2HNfkQ7kNvwHJwGSy&_nc_oc=Adq2Sv0r2wcFV8azzHf3J3fYztgZ4Em0yQLp4o4yaKxRezEsFMqiwvzQbkqB9h4LX2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XViBRvGTtQayhzwm0UZ8-EfSOS4dwwCu5jyKmIAU56g&oe=6A3FC62E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF57VJcI_rUQ7kNvwGwQi5z&_nc_oc=AdrUNy5GNxL7Y9XX1NQ8630gw5knknOSAdknm7-CBd6ZQ05eznFvm89IIgjoLV5t3f8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kdjjtWWxkFcJD3DMoTj7sruW9jpx_xknsDlGqDVrbVw&oe=6A3FCD0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhLpj7Vb5HMQ7kNvwF8Qx6l&_nc_oc=AdoNIP2G-bBeG3Wg4sG3sISyCJODLSCcZ7Cb_tgGwSPJO9FmfySfX0Ku2TY3ueh93Pw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91BAWIS33PyktMqok4J69Lc7O5zg5AdHu-d0ZfTjEGJg&oe=6A3FE4F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrRHLl7mXMQ7kNvwGgQvbz&_nc_oc=AdrC5P-vlz1GHKC2ewSszdOvyh5ca0kES1tr1SJ5Qx_47jgD35ELYqhMFmv2TqvZc3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LQ4X2VDqtJ0kNnT4xAcV7LjYVl2o7tiZBJxB_y1BciQ&oe=6A3FF45A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL3z82w3IPkQ7kNvwHo5503&_nc_oc=Adr2bKLu5i4zFKWXz2u-lEj7qPuSUVwPxWvim1d5rpeoBjli8X4yNt_HliASMcK0UdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kxo7LFfx_y-QSxGzUADuxjYtcXmfv-d6JDu1s2qGWsw&oe=6A3FCDB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRrn2l-mFgkQ7kNvwGuelxW&_nc_oc=AdqXv0IWvaijiArLuyCxZY3eThGuYNz_W481QobCLexXaOYKm8C9Yj261euH7kTZ2lU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OVNEeswgbPGAKQumqg-6vW4tvYcHTrN5V9zPlAQ0gHw&oe=6A1C4C70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iHX0WqgmLMQ7kNvwHoLOD4&_nc_oc=AdoHVciamLPpo1ARfs8Qyt9fIoHUwlYp9O4aqjE_aNT2hKBD0jNZbu_V_0Qu1zSSuhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TRHd5loHXNph0d1Hrf8RHhT7W5hVCbNkznxA4vgBvfw&oe=6A1C5BDA"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r-O0CkwBCMQ7kNvwGTKy3D&_nc_oc=AdrnJ8_tNwZ2Lw6ySGFteZhmGi1lfZpcRgD5gsKJMexmf4qV0RlF24dRjQTQGOhSPh4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44AcK8O2F8zr4MpNhL3xWDvqZ3FfrPqpuP4SKCTJFasQ&oe=6A1C348D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4dvSCxi4VIQ7kNvwFYyB7C&_nc_oc=Adpi4rbI2mbcV0QMCAuPWUoLGYOoYFRNB0Gs2yKTtJCeqPLBCA85l3wCh8aicbHIN6E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JM1yt_l4n-PqwB_VMM0xrbJWCFM2dA92bujjgiSSq0Q&oe=6A1C2DAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtpORpT5gt0Q7kNvwGdZkUN&_nc_oc=AdounraQMLENYmT8Dz4_hBE_Ww1coDE3scUwEuibazZF9eMUZ8pDoXIrgaJf54_leZs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w9HQopYTxhb7gaqULh-pKN9bRrvNGP-IXJfF7ISS85A&oe=6A1C3530"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
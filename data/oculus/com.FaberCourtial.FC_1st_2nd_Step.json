cb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMXquvjV724Q7kNvwFUoow6&_nc_oc=AdrLBFAKNlTjF6tPEv1babsD83tBkdZXGKBYlkhXqwNJO1d7CKjIUrN473ldmaETP1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s3hqOwgzeqE8tkYPk4LTUZ1cES6Z8lH-I84Gc97kFzw&oe=6A340770"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDWXFI3L9LoQ7kNvwFoZFUj&_nc_oc=AdpwZ7EuvM8sL6FQ2FcWa7nS4Ly9eMZQa5J37dUp9NsdQ_gMu3F8oFdiJqFOtw0VcCY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h970emg-MUtEHOz8ahAjsdUNOsTV2g_1D6llUuCJGLg&oe=6A3416DA"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRXOpN93VDYQ7kNvwErb6mX&_nc_oc=AdoK0GrQt6KABjcWf7q-KeNO6vhz2U-vCUpP9R74UFfe40gJXkc4vf1SpsqiMWkqOoA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kr59rxJjJ1a6p82tR0ivjgQ-FPjxFnEy27-zxmYFlxw&oe=6A33EF8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok9Px6BdTR4Q7kNvwEgSon7&_nc_oc=AdrB5xS1H_4xV35sRDp_yTUDE7tN9Rv29IBfbZKU7LFjTZCxSraukqCVc_zBYRa5nXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LT7KfnxmuKENOj89TCXNMYmZGTy5Sq7xOsjjRWD57VQ&oe=6A3420EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17AG2ZNZx7IQ7kNvwFOOjA6&_nc_oc=AdpV1JWjND9k_rrgie0xKG7mvBqUoWwY1G3c9U7_S9OIU1sdgIRez3qR7Lr8sc33FBM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wFaQzpUBkXhPZTLkDeyYtTfjvwBEaHQlvu_kNjFWGng&oe=6A33F030"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
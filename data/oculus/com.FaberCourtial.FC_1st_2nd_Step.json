lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF8aSUVbvxAQ7kNvwFqzUzL&_nc_oc=AdqcXlwpF1kcDKWbfOnsARlGskN-etKAYt7tSPt8nwdY2_hVeS2BmVSoDQKAkq9ayrA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9daHqmuPFD7s5KwdNIza5FCPWXJoKpAuXOvOwJlkAUQ&oe=6A77252E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jahI4chFaMQ7kNvwHLDuYe&_nc_oc=AdqietEVLCwG_6MJy2MsImD-5SjlCy_68xvCUbVK6qZUzFp-LOiwPld6dq3s8nsP5BU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG89rclBx7fvZv3e3n1_0Vj_yP7w4DtXP5Qzu4E_K3R_A&oe=6A772C0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUnXoS2clXQQ7kNvwH3R0wY&_nc_oc=AdpJepIq2ICTjO1W8a1_mh_yoAb0fr9fFTIMrtmfDJLhWCtkN6rf35_jWhn4YTM2RTM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLLDsltCMLRZD-lySkr2bd2auXy1nnrcZpZsbDYgKTyA&oe=6A7743F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtD2FSZ2ZeQQ7kNvwFnukmd&_nc_oc=AdrVVdxZCBS8NAoNGtyiztOlEC_mwrX1xesRBEAR-dczj4IZD-PH9XEudA2hkWdgyHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEILkg4OlenpJ8zmHap45MBvpOIqrOj9PkG6jAf2KxRg&oe=6A771B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ppm7Mr0u6AQ7kNvwHyhcJa&_nc_oc=AdpKhtm3iEBH4W6Z4IIU2oXJct_M7-3PEYVPuNoP8BoI47hQkHvKh0QmwSngPaFWuFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhtEJCfxGDT85N7iVVlYM5TE84QNhJw93xycGNtsWRaQ&oe=6A772CB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
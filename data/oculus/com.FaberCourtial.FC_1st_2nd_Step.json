lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S30d4lR_E6YQ7kNvwFQ6gm2&_nc_oc=AdrZxTu5R9ERd9Er2FViqI9_RJIS4s6tRKrdl9_Ixz3eXhzWfoqxVL1DflZJ6-LiI-c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGT39LsktIOyxFBPkl-NNQQg6i5rMny-Rm3IHrLX4kHg&oe=6AD1036E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3ZlN7kLIkcQ7kNvwE-1Pwy&_nc_oc=AdroSWTlqHWex26PsRnNwARjva5Atxw6fA-fsh1ZAZaZj-h6nT-2ob0z-PHN5CFN1b0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFkgnEwdabWzTn7NCmNpXDlcikpKHOSfbKOxnNRvbWSw&oe=6AD0D20D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36WbJQ_0ZSkQ7kNvwH1K8to&_nc_oc=Adr3c9gtTgzywe-fpGIUkVBAZcKHTZ0EEw0QDIbmDOf8DxYEM8gb1RVoZDwcSS8h6dw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFXKxz5L_BZE4m8YHHyR3rUOFAq2j6Rs7WRGIlW1mH6A&oe=6AD0E9F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJhWD1JBtOYQ7kNvwGZw5_W&_nc_oc=AdqJBxhhcf7SQLBdWfstF0LonmxUntwJaYBJTJAvZWiWvjjsS0Ykm7IoEP_0XQ1HbOg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjJ7Rviti0oEdWgOAdKMuWyouSokj_BiiJi_GyEuosdA&oe=6AD0F95A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA5EGGsuvQUQ7kNvwEpJ_vj&_nc_oc=AdqG8F97mk1Y3f_h44JS6fpq06cJWuBVZn-lEhjhWRkKcbviE_GPOC-e2PsTbmqhuRk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBVmW_JXBDehROt6kI38YpfeDibLlW9VguG8acdwvxig&oe=6AD0D2B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moLSI72XWmgQ7kNvwEGX__e&_nc_oc=Adr7uT3ZqGaw3XH33SedrP7tAytulyy81EFnHa_r4TqorXKFhXPcCUylj2fDxjBd4js&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxEOwLenf-WYuwHCTfDnYOpkqGopWWZt3XPam3XviPAw&oe=6AB51BAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFlIszWgPbwQ7kNvwEORss5&_nc_oc=AdpB7dXBbi2JaNy1x0R79_eZAYYLiZuAsJNT1Pcf9EX5sL6HcZD1MsiRSiCgwwviuB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1nnenG3AvVepRa4DLtz3ytm8tYyQo_NQeyqLmGbZffQ&oe=6AB5228D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMU0Wpkv6SAQ7kNvwHQ5Z7Y&_nc_oc=AdrZarAIoVav4L_hix8B_OQkca9oq2_uvy0WtwqK2CaAJxKCwYwfuz-MUD0b-8EUHE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQgWTpEA0jw5w19tm4CZ1cHq3Ja7ojUAd2SJCo4uc_cw&oe=6AB53A70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLHYMXjieh8Q7kNvwFzqMB2&_nc_oc=AdoJZCGcq94pdMnGRdjT-3iw6vtnIKx495oXv27rEXlqxCc4WWXdpgbl9s17erh0N90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQgX8-CZdcEkW635Q2ENRZx7C5hokil40I2LAh_RJDGA&oe=6AB549DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG7IC490m0kQ7kNvwHw3GCH&_nc_oc=Adq-kJdub1qFcv6CwDB3JZ_4-9nIvu5NLnc9SYbRowxK5maZ4dWOZlHqlwcwpVjUXqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPrQy_wvKZNikT3jFgHQhwhRO6n3dGiVcfEJoN3_0kqw&oe=6AB52330"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=uR5Qn6E_EPoQ7kNvwGWcNxV&_nc_oc=AdrWHsWXvLGg8z4X91Dd8lEKtqXAqbvhaSSZIFHMcYm7lnr_eYhQBVa5Irv-mDP34GU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ewnl9dtNRgc9gOs1YuTvS7Lqz0HRPjZrzvW4ret_MA&oe=6A54FCF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cECNxj52UIQ7kNvwEOEyUK&_nc_oc=AdpuzsQthp1stJnDjntxA3zpm3DRPxuccNzSTrYOFPFnKPYwdSCeSgNUyorH8waeGR4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOY9YrZ5KF-PP0VwyBmgwLtag8MyvinCQkR-p900dgCg&oe=6A54D41A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVIhmlXVqPUQ7kNvwFfG-Pm&_nc_oc=Adp-nENvz7ihsbJqyDu-c3rxWm7XuFDGWafV5MziTwDefBJqqLtrkjPUNQTjQePsiXk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6Q6lQeAMnIhk5DANhiSNM6Tj9W2RrQ_nsHum6vjcLOA&oe=6A54E50D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HQLUSyCqAEQ7kNvwHs_dIb&_nc_oc=AdqnsmlnfpRkK7mx27PGxy77MP5s02Vn0vFYd1ptv5TT19yYc43CtALACQNDB8UqCA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm_Vgp7lxHSNR0dYyx1N0EqO68FLJeHcrEoWj4W4eZjg&oe=6A54DE2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZGEE-inGZEQ7kNvwEM-Q0e&_nc_oc=AdqijvSByz0pwd2j_fGW5TSJce4H9yX6t7OMyu6JBA9sTIIlvpJHzaSlvzNSUoDJ7ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgvMGd2k_jM-sN3u-9rdVvqMcK8nMSpyC9AnMarBZ16w&oe=6A54E5B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
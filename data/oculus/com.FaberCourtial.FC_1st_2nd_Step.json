cb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3tycRGq6x4Q7kNvwGkPEGZ&_nc_oc=AdoGhhetL2oADHv7C4QBHzANyEuhWu_qw0LRAyqYhnI64cJj7KroVCNqFUbRmidEYJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTW64oMg1kxRu6G3OajABtZR9Jh7ORojFfqE-vCbC0kw&oe=6A68C370"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg_NoFPIzf4Q7kNvwFEwNhu&_nc_oc=AdoPT6rPdgFZ5ix15SndEPgu-ah3eCDQA2jpewyMgm7wws-TVJVonkpM6YlvAvStsZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcJ3NSvsdsYjQeud6L1rUMUhbvQnv3Pq11Lbs6d5KX1Q&oe=6A689A9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Kcl_zkwZcQ7kNvwFD3OHq&_nc_oc=AdodEnZ21pda7EaOKAdbOeEnZqUtVlpiI0Ar6aXns5Jkx4PGe4FP_tRUaN9MEMlkwCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcnT2WwdpVACprgTwIEIiIXuMlgiCHh7FPKGFyWDHvuQ&oe=6A68AB8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpAItPNub5IQ7kNvwF7FfIz&_nc_oc=Adr4w6fOQK-28awyRpFU27G5pbZSKlsJOtAd0oXQxvUuh78vdjNwLVo-5D2JRFFyzac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ572ihV4dTk4Mh59qCyf0W142vD7nG2woN1Wpun1hFQ&oe=6A68A4AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcCGOZ9tRwoQ7kNvwG6WUvA&_nc_oc=AdqJuHQLDBU9C2sAqvdga2su0mBF6_4guDjFf4blWqEyVZgYdnmS6DMySkztZPqt9Oc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgtZTsKtfBlkPRSTrs7hQ3L3TlPTP4CAeD5Jvacd9PMA&oe=6A68AC30"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
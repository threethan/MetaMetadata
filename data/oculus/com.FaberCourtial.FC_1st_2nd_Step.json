cb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bZwFt8EF2sQ7kNvwG6Xl2i&_nc_oc=AdpWfiB-YpV75PLFGAHSEus-opg9HaOG9Fx0GcEj7baJT6kKuO4qMoaTl_ZUix5pfc8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn_Ov3ML8uJJ6iyNnUjD0HitNKVLiUsn5ZhxXcBKXQAg&oe=6A843AB0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjIDEosmvWoQ7kNvwHbHLia&_nc_oc=AdoK8g5kJ-IJB-KwGD_JK2CBTAqaP2yAQhXisIyh0Var8oSlxdHSBIcRtKLFO8Odkx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-K6rwrQrxwOg3qqs5poSLj1dFe43JGP49ICwJx32-6g&oe=6A844A1A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cwQHh4R-7oQ7kNvwFIc974&_nc_oc=AdpG1mqomFbGCmNRwPzzo9LSudTBbwyu1IEmhJ8YoymVVpuno5LS5ZDo1IsGG01K3Q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpDna7Oc2y8DwNtcfCm3gc4kUdr-vy0f3Pqz2BjhHokw&oe=6A845B0D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HxMtGngNYwQ7kNvwFbJIaH&_nc_oc=AdpN5e_tjepPWU-2I_IRJ-LgAUS-JHXq3wNQ0IkZFdImW55f96nULDfvqFfscIBhoxE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_woLw9o1-TRhZT2oi_f7ib54WFJ-OsOqhmkICjPh9rQ&oe=6A84542E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38vyiI-dp-wQ7kNvwFPYjFE&_nc_oc=AdqiiXfrQSiVSYl1vepO9qZ4YNboirduX0TVQKNMaJXhETG2S6JnfsFMH1MB4HFRO-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsGB0N2vetlafzra09BGZ-yYZiZT9hExBXJIY1NjWc8Q&oe=6A845BB0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
nc_oc=AdrAbph4Se_VzYFUUfg1FbypBJ9fDV02mRmYI13vowoCCjMbx838Vx-NZOTkFkDMKvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7NYkuJn6mK4lhkauWoHC6yJWG361WORGYZOVdKaZ0yQ&oe=6B0465C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdEP02f1DjkQ7kNvwGXTeEF&_nc_oc=AdrAPC6wZns6HM_7ElC1831_ix12TGqhYtt1xKQYjAkBZoQjrr7POFM8KHvTNwBaYoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG6NWAEPUQnmgO0ZabTuT4sRGmkqfU-aDHJpWF6TfOow&oe=6B046E3C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8345873332191434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75196229_661813111135740_4838520177004381426_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMv2baxmk78Q7kNvwFpcfLL&_nc_oc=AdoYcR5MWd9ec8f7hJZWmAmHwccwlfISFX4ZlusfZ6X0d-tr_YDZQE7JP4j-UmwCRGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTNad0QvynFnitFVotJtKfsjefOVvIjzrTiUw0oJszYg&oe=6B0459FB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Into Space - 1st & 2nd Step", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1603990762, "lastRevision": {"nodes": [{"id": "358663070140461
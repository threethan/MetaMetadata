lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb4K_TfQ2JgQ7kNvwGlAHQZ&_nc_oc=AdoCAeBIwBc4BD9YnQDldJUYrFjrUtB5xV6D2bk3X42gOonfgY-U0Ifju9a16861T0w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HzONzFokbj_Xu8zQgY7w4U-JiyJjqQeHO-AFnBHIVoQ&oe=6A2BFFAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D43o4JC91dUQ7kNvwHi12Ln&_nc_oc=Adptv5J0yNhqksWlFlGFpDt_FuQ9CHdrqwfsP2FAiQKPdUG6iDqb5D9pVictd-bFcac&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XWTW3V9BwFmIYzkc-7teYSJkus4k0JUDPvIJeJqY0cQ&oe=6A2C068D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jupq-6zrKiYQ7kNvwH2EBZ0&_nc_oc=AdpCxMQFbO6FXteQqDSwie9TUkl3vLukap15tQK0ZYWqzG2WqcrJtIpTdqjxbuz5n3M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bAvAksFyxVmfIEiXCERc5tDcpBhPUD0_pQRRsy-9jJw&oe=6A2C1E70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJyPE9O9awQQ7kNvwGFumj6&_nc_oc=AdpcjLqIFYn52SaFk-zkz2epatE8UfqN34DKA-yDKjj0gNZX16BjbgjG6hxNDT6epgw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q9YIfbftNeWdarFnlEjhICAOlbaTW_pcRhkkiXodUCA&oe=6A2C2DDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cswf9Pwj-DAQ7kNvwGoHfmx&_nc_oc=AdoaMAG4Uh1fjoNleFRHaQXdcJWI0uocigKhOqTA7BgFu_kqr3Rc--jz94y0__OdqhQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__O_C9w8b-dC2TSbfxJ6YDHHCEf83LakScfsonDR4A1A&oe=6A2C0730"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq4ZKBx9GoMQ7kNvwGQZnTo&_nc_oc=AdraMUNucz7ccyeX-SUe3fseUnclwcIConNTaLuZHBBLiJtK5wW0qH265O8_NWKuYwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AKWecw9iYQ7pCFjw8FSLy6l3dECExCxo-FJ1xGL5B0w&oe=6A1D8863"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21CmIgdA_QkQ7kNvwExQIA0&_nc_oc=AdqiMWUC0DA3eGu5wiudKa6ekupNz4Qq2Z2kfYeMPGpcdG1zUnGesMJ1bp9HwGjPV1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-ToDurJBOu2fVNiAxsMfer2ucF_yW0IH6PZQ3QtHviw&oe=6A1D9ED0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s14fmZ_2a_gQ7kNvwFWjA03&_nc_oc=AdrMWI0IhYOMir5kNrYxi5H_rr1CdTrfq3c_S5tC2yUnMHJnVxgQpT9t5VeFsdfdS1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QXbJcONLhoquSjfZ7-30Hv7bQvpeNxniL7Uh30xKTzw&oe=6A1D8250"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtoHEtPIfRoQ7kNvwGP6Vfr&_nc_oc=Adp1ESdPEc-4AMbG-cgNqTuf77SZb7N_5dCpxIQr8_1nKl8co-UNIIIXx46rS-EDEvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IvsYBCusZIKS0B30vbH57-6Rr-0_24YKJJeCOPFg8vA&oe=6A1DAF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRdReytvCrcQ7kNvwGlg8zK&_nc_oc=AdoGpRyaGcNOAJXdFUKuW86sNBbgW2WQS12pq91J0FZYCmFkimbJEstHXJAK_-p-BgQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CLgnl1RyMFHeem8FYU_mrQGpFlmYXxsw5KZ3ns2d4gw&oe=6A1D7F7C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
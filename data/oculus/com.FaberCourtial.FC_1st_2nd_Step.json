ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQO_YSc7gkUQ7kNvwGYaFj-&_nc_oc=AdoIAEc8Ps4AOlKXw_AHhSG0caeiQff5yd6xKf0OL66wT-CmJo7Fbj8guamIr9-3L2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MWZeVIPXeFa-24PSMpPNdce0T-Vk_teteZMTjNBf7bQ&oe=6A43C3E3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxrsVa7wVAQQ7kNvwEbx_tM&_nc_oc=AdqStaS94s1atVvR1_hss35o2M-8tlVDyRTWgckWg0AgbZlnt10rsNryfOV9rUDcP48&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-wSq59tG_w3KBmoLxrh9rmNGCoDNBy_yST_Lc4qIrQg&oe=6A43DA50"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mnjo4ogY-AQ7kNvwHRatMs&_nc_oc=AdqU8RdETN9g1lMk8aB0HPiuuS3u71v9oTHPwXYFqYGV9xeh0GQ3gBxif020_ydFoCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eY9j8EJOrx1YvuAxeyTYpwRTyFwCG3SukZ4xgif0AiQ&oe=6A43BDD0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvljoAo4-5AQ7kNvwGc7MBJ&_nc_oc=Adr9mEKuzhEfXOcGL6dHF5p3_N7cBKgvwtMrkcggeV49RlZky_Cg-AAXwIWvdNBtoNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x22trC6ule8ghFeFgWXVR9r3bHS7gZ-r_ehvnDAIpdw&oe=6A43EAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVwYL-SCagoQ7kNvwGd3WQK&_nc_oc=AdrST5ZfBhqXRNtC-cqIY9wtcZtgc7JvW1MA568TGARsP7d8s94Umv29-rM3omtfahE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RtOlZkY63PJkl-Io-tmXvGG06vvniIO5L8YBV8YAqaA&oe=6A43BAFC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
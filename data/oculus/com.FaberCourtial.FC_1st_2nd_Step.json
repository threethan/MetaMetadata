lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpAItPNub5IQ7kNvwEuAl30&_nc_oc=AdrhgIVkjlGQpWogdO6_0nu4DivnpT4GDbVjtFSyuMYu3soAF1hVvoczS2TlzMLU6Yo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVBEf0PCWdjiqEyhuqJpoDNIlMRpP-fW4B3PojfgHXPw&oe=6A6B47AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Kcl_zkwZcQ7kNvwEVo8ly&_nc_oc=AdqfjeVZPsCwR-3oEftAbiSXiO2lIL9-GnlFCnROHijjE2lOJuq3hKxK1MUdsLcQbdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkJuFeZT5FvaQrKhah7T1YuPHIrFHwKsBKOKnvJg-baw&oe=6A6B4E8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3tycRGq6x4Q7kNvwEx799V&_nc_oc=Adp2KS70FK-G7GJD3tZ_M7Ejn9QZ4yznsfBwm_N_KVY3zUryVIKXQ44YmCb2t1i8jh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJkZRKcF3Sh2xBVuDGhoQUxfhTiPlgmJEfqp1E_4HBkA&oe=6A6B6670"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3Gtdn2zvUAQ7kNvwHflG-P&_nc_oc=AdrvfbE4As4qBApgaa4g97k-W8u6fXlsBa3ULVvZiXnRgEWfEBKlnJRjvDS6oOF5u9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxqrhhCF6sYT8HYBrgPSpARa8R4uHtzhLfkk3kjuQ0wg&oe=6A6B3D9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcCGOZ9tRwoQ7kNvwFcL00l&_nc_oc=AdoAecL-haPQDc5u4Z00smq2UmZoVPdZwTS3xganpOJvZ6pEYZ-wTur7k43okzUIcpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDzB9UdFgMn9afr2QemGSdWZXBIN_QsFW2sn06p9Kuhg&oe=6A6B4F30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
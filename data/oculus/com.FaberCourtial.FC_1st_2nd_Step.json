dn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0k_pd7RYD4Q7kNvwG3DKvL&_nc_oc=Adn7uEpKw4ALhEUg5dOZRqgQbc75ehHoysKywhf8QOKb1BpqHlfaSJ1Qho8Gyq-rZzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMT-_r-pmDAcfJSnnaftIoihNfdcnyJvecVuxXpV8jwQ&oe=69BBF963"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YGrCO5PJq0Q7kNvwGEa_CI&_nc_oc=Adl00AjTw7CARNb1v6yvfS_nArCoTNqfWiF1TfFvobtNcDyp3OjYwns1gANefxMlw9c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1YzGmv2-rB-txxBuiyP4XafxWIGkCQ4aFQwe_uqmksQ&oe=69BC0FD0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA4K-iugQDwQ7kNvwG75ye9&_nc_oc=AdlcIhiQrzdMpjpUEnSCMKBaJ4FXOpgiXZFw4FepA2-nx4a7tMaKBsLA84NV02wq444&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCBvmSFZVeAqMiiZMbLTo_FuRr4mTQ08Hhr4-sc3VvSg&oe=69BBF350"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d5J9RZSeaogQ7kNvwHGZAzc&_nc_oc=AdlqgzqTAcd0OSM3tkGz83vL1sGngu1BDVHoFjUshT1tYirJuPjsAdityz4OR3wiTwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzulwx7n3THoNXpRvsvYkQVeEITIr3gVMMKsqlDyGotZQ&oe=69BBE801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZG5ATvy67MQ7kNvwEU_bNx&_nc_oc=AdkeebQ915V0ewxd9vG0YsU1_dcEPoDzswiIfYBPhkTDdURbzxEY45u4E6_jNM2ZVSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqns0zTya2iq-296Wx1YEhDNndpw9yuzJvG7ycKp3mvA&oe=69BBF07C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, 
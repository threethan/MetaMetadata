cb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-h4VQNE1BoQ7kNvwFISN48&_nc_oc=Adq5q2duVVDTI5XOor8Y0wKVyyGo35XppUyR1W-2RlUnDf5uwDwfUo1E9KvO4kptnwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSf5HboLdZM56BvoMWgVJeEkUEDUAt4F-f6gW-ikhKwQ&oe=6AF72570"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLsI2S9htFwQ7kNvwF8Kd6r&_nc_oc=Adq9-KM36iBoV3C-w2d2l9GLiuP26WnphoZF9JEyTANfQpxe_zR1Bs1R9RyjbEP95GA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-Z9F127lufPqDpiAjTaBLXXf2zXGGU_PdSQTVDACtQQ&oe=6AF734DA"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qvk_eYubgMQ7kNvwHBAUXz&_nc_oc=Adrpn3IvJrNPPvUz_pVmxvpkOa__y6BS7q92pbgB6JM_l4Zqz4UUfHigxHjzjQDfRwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0J6KH7IWTswFXtI6JnGrbQMK9qfcJhbnSgUKfSZw4kA&oe=6AF745CD"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRE7e_-jm0EQ7kNvwGh19Rx&_nc_oc=Ado_tmsqiys6lKJ8yC5ROF0g2PeePF8tvRmUfm2zAeYo_LErtt02f8cZdrrLcYybn4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiYhBkryaDWwNuARRrgptddJQrCwEIPIvFd7l96nn1dg&oe=6AF73EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GqBJPkepaEQ7kNvwGNNqK8&_nc_oc=AdpTIazw4j5ljW4iCLyblhboA_MFmbrGVXw-EiWoKK0dcxKy316-vP4bBHcfs-igbmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJjdBWV-je85a8Q5hYbxWW_FOoLeKWQZH0JDyOH4dwwg&oe=6AF74670"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
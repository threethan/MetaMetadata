lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaB0S_74GuwQ7kNvwE2-zdT&_nc_oc=Adq3NCPsRTEMtPWcLaI7FyBMCQMHW-_QvynWsPfJiqL5CBlFV_jz5wrIjjo0YUyvkqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHfXPSnmWjOkrfO7mTqeWNFFOnCGeuazFWh5So0ITagA&oe=6A996C2E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZRF-eRfnoEQ7kNvwHUY4-W&_nc_oc=Ado96gRcS0t5XvFv7IbKEwwQtMuB203wbeYcOuZchWX1dkuRYZL5R3_BOStCjz0Jauw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItzWpt3iVq7b04FoiIbNYxBv29nBcCN34F0Q9q5QIG8g&oe=6A99730D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_N6ZQQwgE8Q7kNvwEat6-D&_nc_oc=AdpGKL_XLDek7-7FcoZnTJuNBi3Ni6OaPFpdOmdnCGWsJV3qPS4XkdrQ1x43UO7ERN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQtsI-y57PVDM30xoeao3SVgTh4rkYAIIz0HpVoFk5ag&oe=6A998AF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8b7tSC15jcQ7kNvwFXUbwy&_nc_oc=AdqiiQg00OLTLgpxnzjvmj5jRbrSI62KpdNh9XZbaz9HALyeRrtqlpCvlFAr4fpS5k8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY9AtV1l5GG1gc8fksNDKMOFoArBWG7MHefVg--5f1lQ&oe=6A999A5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr8FAr7hT58Q7kNvwE1fRNG&_nc_oc=AdoTDHUWudOLtWP2v5p366IWKmXQFQhqhBuYI4aa7XbKxcSKg-gPeMvzWZ8zG0dWNV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgoyWWoQA2g0RILi6Cu7P5VIay-sd-fEtvkgrmPu7CXw&oe=6A9973B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
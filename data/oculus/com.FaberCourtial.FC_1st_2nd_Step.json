lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vbu0BoLnneUQ7kNvwFE6ikv&_nc_oc=AdrI4MFev41Tx4nwhjfHSMqcTn5mDEg6mqy92EFJvr0efkUYFDTdCxyDvddh6YtV_6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0YhfkZ5qbEybQd_Kt0QWydxtjBWxleqQFbSwOno6Jmw&oe=6ABD04AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWH55JVK9WsQ7kNvwH6Y4TV&_nc_oc=AdpKfd78a9PFiGcqlPwGU9MSzlK1gKBkKbeccbiYrBRK8f5Mp4UN8LTk1BX-hAyz58M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEgcsKzmHlM8DlHtWiBdutBZmkDrQEBQCkL9hy1AfUgA&oe=6ABD0B8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfEUImWCa1IQ7kNvwEZG7TO&_nc_oc=Adq1SedRpFrElwYAiqDfwl1X7vlSprd9Xash1M5ONFYelTK94zYkPdsKi79WHlSPcyA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKojsm_o4aWfB-GBA8JYB-26BTVpTETyT6j915cv4Z94A&oe=6ABD2370"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyLbQeQWlF0Q7kNvwH7KyTi&_nc_oc=AdrpXb0rln7zHpw9hciVtcxMN6EX0uUBYSxxCii_hCEoQnwKG8nIU0eoDCSOypObV9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK77Pfhor6Q0XJaSx5e4aAFfLfuOnl8YMEnuDhLhPSL3g&oe=6ABD32DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F0yMlRtCVQQ7kNvwE3R1ZG&_nc_oc=AdpwOoCEF023cJMXjhuDdNy7WDzgfrWgTG-gK7A7LHPWW55amYLwPb3bPp0eG2FGpwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjzkHhFL3D6RCgnORBaOPo0LwYrpoH_GUp6GMy1-IwBg&oe=6ABD0C30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
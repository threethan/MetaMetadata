cb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ33eADQ_pEQ7kNvwGHUdJz&_nc_oc=AdoYlCTgDpXfepqjghCzhWw0YdqIXVgrjQmIHYxkPacGVPbHuEX56qM6n_7SMLclVV0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxU4l1AFypyqFhamerefk_W2i23nAZDUrXrJwHkFMsOw&oe=6A882F30"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nCriVUB5KcQ7kNvwGbB7iK&_nc_oc=Adpq_azXmdqmBZSwhK1OwAfdJj5256Fxj96n-V_nA111UOAvogftDr7VNOXs2dM3z5A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1JOH8VosTnSgwWnjHUmNgHBtf-uyxkXDFPBvYU_R1TQ&oe=6A883E9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MahiY-ULLW0Q7kNvwGQW_88&_nc_oc=AdqTXeuCalX0w1QdvZCDnlMwj-T4xL-PHj2kS-d2UBi5CDQS8i6bvY7CPdh5JKRJJmE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrZbbBgEHqmLa06Kaj4py9cBdU5mWpnmr81maaSnzrJw&oe=6A884F8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIRyAJhrvoQQ7kNvwF9N0C8&_nc_oc=Adqiha9H4oDJX3Mt5d5K0HliP1gu6H8OLR68yWAbHxC0SIduVMNWBusAeb-2oK-3MWc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb8UEsruCM-J1Sik3jfV8cDygNWl_h1p5o9QAprQ3DMA&oe=6A8848AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzeWDdclsK0Q7kNvwEZVyW8&_nc_oc=AdpfXS6GIWicACyC2KxkMnPt00-ZGUGzTuAnHpi3A7bOCR1AZH8NJ9c5yLqJJ5_5Mvk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwWBRMZhRbijta0ZxPrd2YLZGqF0-Y1V7US0REHmJxhg&oe=6A885030"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
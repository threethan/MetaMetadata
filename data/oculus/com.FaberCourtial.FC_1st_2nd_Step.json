cb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1vMDbq2Tr0Q7kNvwHE31_1&_nc_oc=AdrCYVVVpzo7FdIVREgiE6P2HOaMrHHsIDTTNKJdYvpooeuvWtUWlBezT2mLzjB_4nY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxV2j1ooAqh8ryR3PEbzNskzE4lZE7oG_aDDgaCeDCow&oe=6A9C2DF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8b7tSC15jcQ7kNvwHnMMQa&_nc_oc=AdrSnywJrkLWxJ654fa9V1iVpo8EU-Jcqin3qbDj0ot8LfPpioHfbbH76lWX3jRyy94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZMe5ghyYHhTBx2AaAXRNYwSzja_xjR6b_msxP12brsg&oe=6A9C3D5A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0WnDlDVLX4Q7kNvwGAjM1Q&_nc_oc=Adq_VlhbIq4SY7MR1gk4m-YLxnJdCf42K0b8LLU--PeWUnnlWfEyfIYtpOXaxKPyI_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj4aeIrnSKWcB7RYVmS1v5yzq3b-WAYbKw9MmTXtMZLQ&oe=6A9C160D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6dDB5yJc1cQ7kNvwFNcuHr&_nc_oc=Adq5ngBUraOkfiQC05eMWYGZz7MnJxSv0gkCxV67IgDPDAbB-PxEECy84XN9AChQzpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT16E2AaeBGu6dvYHfN3OOBbxCf6w06mTmrQlyrU9weQ&oe=6A9C0F2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsMCeUpXqcQQ7kNvwFDc59z&_nc_oc=AdqczP0hZVzzr-_ulN3fceeY3aPb8bQWnxOS6vye28k_2yhuMmPq_vRqmZpW5_TGNEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuTFIUvbUidO_xjh7sSN3KUN5DeRYgZ7wGs23lNJY-Cw&oe=6A9C16B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
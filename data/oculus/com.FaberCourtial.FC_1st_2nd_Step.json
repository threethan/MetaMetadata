lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veqlcEn_pOIQ7kNvwGQMErP&_nc_oc=AdrMW_WyeNJ6dwuqkUScv9tZfBndNlNiL7-xlnlr2uzclN94_KtsZHk5JdP0UDUCKkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AUxoeQsUevSHLRcDELZutgYWt5iYoLDEl6COKKPmnxQ&oe=69DA42AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvFDg1gSMfEQ7kNvwGe2axh&_nc_oc=AdrvPJ1C2Gj24D_vQce1B-82uo6P9ElA6wk-J-FwNahUn3FRdWvt-NdIDNXHO3DEqB0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dhnNeoJ8w2PhjmjXVlVtOvAfJvETFviMZUGtJHXYi9g&oe=69DA498D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4fvTuu7OEQ7kNvwEDhvH2&_nc_oc=Adrwkzz2bvAEJA6etsFBsPndJjtR5hR7XXHiDixXSm5pskcpyFCyzgHNqf6Fo4DkrwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19c0DlPymCeyOsCiTHrd4xDHugpu6uGfLHM-F6pE2npg&oe=69DA6170"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L264Lf71rXgQ7kNvwHc6pT5&_nc_oc=AdoVYDO8FGv0wC6T552R_mTIIQ1nrXUdka-quJUdRffxqfpgUj1-ZnGpoKets0cjic4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K3FEq7hXXARjCmGaEDJbQL1M75gxTQsrxvsbuZV9XAQ&oe=69DA389A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFPLkTHC0EcQ7kNvwFGFK9N&_nc_oc=AdpkhIurlN7szqVEthBin4AzbVJgX6R1sf3-Sin-193gbRnpZms0xL3RaP3U-Y2d9ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vq_UIMkU58pMpzeINU1YoWhz-70X5hpHr3LH0LOax9A&oe=69DA4A30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
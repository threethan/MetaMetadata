cb=1-7&_nc_sid=6e7a0a&_nc_ohc=35NtkBEFSfMQ7kNvwEsfzmY&_nc_oc=AdqTQjJglDrjU3jeAZHLr0ttTL8TWcCgTobDFtJ5RnSV7krg9QoUx32tjPeCAjOooaY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fa0EFVa4Ij87jeS6nxw7YqQcGCB3KRsQOFvQKEwZHXQ&oe=6A170670"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiISQ7BG-jQQ7kNvwF2bjB-&_nc_oc=AdpkM8VHILk26cbQYjEjzWXKqccuwbdqVFfUe7SvKzCHtCYoo6PDFO3VW3LFOHbNJn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dTPKnjamHAOoXHMzmjvMjGvPfaOBrwf6AMlTeKuSmBQ&oe=6A16DD9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uSY9fe3uVgQ7kNvwEFHdQN&_nc_oc=AdpvVhinaio9TYiU6sf9g5r8SEZQNKBdbYQxPts-Vhk2P3fLUzH1L-KHOe5adMNe3gg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NixF1J5iK4ZbraOZifoQkjr3u_1Rbrk2POM7RV800-Q&oe=6A16EE8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN9Z0y5UANcQ7kNvwHKgfTS&_nc_oc=AdrcGIsd5QL9FbEuoGS_3djoZpq4Y0vfit5c0i1ufScKhhTJ4kazwKdqsLS9AiaSxvk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fMozcT52AnrYE6mjaDYf4jxkbpymnYagqNx0dpQnNAA&oe=6A16E7AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=179FYjPX2OMQ7kNvwGHzkcj&_nc_oc=Adrdh2O8fn_Eg-s5-VEZ7Z8eT_9olz3V-bXgh2kOCqjALg0NG40HDSH0PL2_9JTEvbc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zb_nQa5j0q90QOD6XhYOepglTPbdqYV9gCLpaqfraSQ&oe=6A16EF30"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
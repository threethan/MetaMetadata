cb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWaBvtBPQssQ7kNvwFy00Bo&_nc_oc=AdpjpM3DdbNWB-XXkQddK-r7r7vL3lrsZSgxVj32xVZtf_ShsDIfYG-g_WVt-yRwcSY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZlLXuJ9V_EEp9jWzKbTDfqBzWqaMQBKUSIhb3hpD40w&oe=6ACE46F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfsSwkW7BeIQ7kNvwGIqSyg&_nc_oc=Adr4luvJk2ojspPfY7zZagfiXdfH4JQRa9D1MzDNv5nWx-uAFHPPaHqIutzfuBojSac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnQKhp-nXKwYJnszAL8N8HJPEiQZWIHIqelShJ6oyEZQ&oe=6ACE565A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJBQGiDaUrsQ7kNvwGNLm_y&_nc_oc=AdobHRV5rgyRjxw73IvjYutvdmpG9T4IQYWijSLECM3uvw4aLFrU-2qEA9Y1Ts4IHk8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAz3PWq-w7omiDIwqXdqy80uHdXMOhYJwrrLTrPgvUTA&oe=6ACE674D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9mt_yO6NX0Q7kNvwFHGm8t&_nc_oc=AdpGvHucfaFm0pybdqsGdXbEEsFZwCe9moWOyebHy8lSrVVa2EVetTq5ru6OHU9kQoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6drcGyYO2hcMg2kD1Wm-4_YydxcVQeUMxj3yfC6fILw&oe=6ACE606E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5EjWlhZ0mUQ7kNvwFZeZrt&_nc_oc=AdpQcFv24jnFKtYkog-BLilHP1WltREKr90oCkjIXSUEG9rV6QtCZhCp-rPSj10oQ4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTDAYpxXe0GFfwUDNz5DIvibQXxM0o7QceONhIFkbdZw&oe=6ACE67F0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
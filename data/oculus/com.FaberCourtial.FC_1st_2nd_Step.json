lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vbu0BoLnneUQ7kNvwHF5K4H&_nc_oc=AdpiFVxnci6kz4y0smKbNymcHSVdLsELA7cqZmxT7CXXrpA-5ED1oOtAH4ePeWSnktc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCXcIXsQjpgWdNCQiwsE4lryQc6-mqVL7XOa0o0zU72g&oe=6ABBB32E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWH55JVK9WsQ7kNvwGPzT3K&_nc_oc=Adq0SJF8uzuGZ_c6t00KJ_YopDz-ejePQqNfeS-yMqGw9Qky-PDtXKy7O2kFXd7wTaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1VVfahlYnbwCuSVmEQaaxOf0NEAEJ5JzAQeoFmHv74w&oe=6ABBBA0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfEUImWCa1IQ7kNvwGONbRe&_nc_oc=AdrEf2FfE7GPv9vQ_o6DWauq3_ThFUgZZnknLEpioWh5nOJMXOXZcCb4m9Mp3iqSkOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFIpKFWSP6HplzS2NkOdpFLmbmpQu9YiWyeiD-oDN0Tg&oe=6ABBD1F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXKQdBSB9r0Q7kNvwEifG7f&_nc_oc=AdoaH-PKzTY3qMUgPVwBKknIWWEnyKcKPo6ol8HnND76t1l_Bdt5jTFzlqher8jXhdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI2KA-J0LA1ib41PeO8Jo1SKgpPR-NpoxXFi5M98hjhA&oe=6ABBE15A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F0yMlRtCVQQ7kNvwFeh1tm&_nc_oc=AdqG47t-Se2_HufV4FymwtidflInY2HDmQ2QtyxYKiaoUlXc9NgWwYqEmegpwvlyu_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8NcWZBdgcWoxFdCJyL5PboqR7QE14PfnHKmuGkICoAg&oe=6ABBBAB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
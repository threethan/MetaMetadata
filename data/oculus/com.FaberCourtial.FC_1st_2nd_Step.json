cb=1-7&_nc_sid=6e7a0a&_nc_ohc=SigHrmpZCW4Q7kNvwE0Gfje&_nc_oc=Adqrj99ELQ2xOwqntFMFuORA-2CtwWlEXt_gZ1qh4jmbto4WNaWWbtnFWg-cu_yVUvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz6Ky8ioQJQWk3QjsUHzWMfS0mvULSA3BQuQsddJ0nEA&oe=6A734F70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbsQK7-87S8Q7kNvwGljl7f&_nc_oc=AdoXm3U4hMcGiwayBtbQogml_6xnjRMKHYISTE6lRfUKj8QAMKJ5RrwUA5QTdzTv2HU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESZJyfbKLL2RWOQjKENwbVHBO_Iux7i8KNavaINAQ0Fg&oe=6A73269A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClJGs6MSc70Q7kNvwGJyI7a&_nc_oc=AdpD5OQSXO9RvrTpC1X_7sps7XDVDk7HYtPZNNX8Gi2-cxoANO7lY-ASUeLKvmQtJPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELg_Ofkfrqdrfvx6EuP44ejVYclLBSrEsEJOxWa-n_0g&oe=6A73378D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRtAEpP_Cc8Q7kNvwGEJ1Mq&_nc_oc=AdpKpSGDuaKPbpr9Ndv03YcX3BVcev0Yb6ui3bfBUgjEag4So_ERSp4WOrgxCzfLfC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjkoDrh0Sa6msAvSqZ-Sqc69eCoK2wSWujQlX5rrysjQ&oe=6A7330AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx8NnQI6bWEQ7kNvwHQ1uaq&_nc_oc=AdoKKBuT9Q75UeMd0vsssBJawDmfp6pOV2b9cMO-3t54kN2nUp0_4srVwfNPU2FLatM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2HGLQ-YvCvoZ_CK4zCQhxYJxRSG40Mv2mrKfnkLrclA&oe=6A733830"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
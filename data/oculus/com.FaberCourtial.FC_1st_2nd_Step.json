ollo_Promo_CM_Interior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsQDDAx3l9MQ7kNvwGL9Tkj&_nc_oc=AdoBsM1QNGC4T5w42gWB2sR3bGTyrieREQ7tVFe6U4NkqvFAUwjIHNxgEC_UihkqQeE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Av0Wd-Mw6mlW0QxPuDRDwyQrHc65SDiKSbaSGU-J5fQ&oe=6A0B1363"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcpb6PJ6HtYQ7kNvwHXu_YJ&_nc_oc=AdqKb5331Ba3Ovfj1JdWDhBSor18j5flmqY2e_p0VuslW4L4ZjQdgdof8lCvztkd4PU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NYmUZvPtyPr3vnsaRA5hg6r9Be987F9bq5bUH9oJloA&oe=6A0B29D0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGAUCvOh6RIQ7kNvwFGuMpu&_nc_oc=Adr78944xOt8OSLT8Zi8afvbnM3dR8qraDoqqMfiaybtQZmo5OCG7oDojzBkupmX3Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-qDA7-80rA8v6XDrDcY9gEgu1EF4nrLllIp7nlgXrng&oe=6A0B0D50"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTabPncBY9QQ7kNvwEmkyXG&_nc_oc=Adpcv6qfIjzDJPEuYHDAVZYXsXhO-xwvQu2QV6KYJ6rbvmb0wWU85fYsVSZ8dvShVQY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-QxNA15XCiFraCTS8nWjRR04pucSPQeqU05qJTpTBwQ&oe=6A0B0201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-pj_GpJ-k0Q7kNvwEeAgP1&_nc_oc=AdqpIaM30qneOr_q-of20FSdFFiVpPLU-gY3ZqvNqb0Y0XLL5t8qbWVZpH8ki7fq2bc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BUp-_c_q8Y3WSwneTQRyyMa8JR6-jZPhliv1igeeyAQ&oe=6A0B0A7C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8345873332191434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75196229_661813111135740_4838520177004381426_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqG3S4Qe_UIQ7kNvwGhWDkR&_nc_oc=Adq9n5IASliC3OS-1WtfU9dQJL-H_6LoSIXBD1PQp62tSaVKUSQvZxSfKtVJxs888xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_uE1xS3q_MweRf4CPpjIIxlEklNFsbuQV3_CWkcsUqw&oe=6A0B2E7B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Into Space - 1st & 2nd Step", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1603990762, "lastRevision": {"nodes": [{"id": "3586630701404619", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "2714882785290545", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "594490541260511"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images
0.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN_D-w18HJwQ7kNvwFRTJUc&_nc_oc=AdktbCtHuIByd4HMb9gZCI7A_OoTMD7Nr2C5V8zlS_tYAREpB6fAmWuP3VrbnU92POQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGJUw1nWXRjlJiHwx92nbXoGPXUwEQAhw1Z9BW1QsWIQ&oe=69B1642E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx4TKmbRhqoQ7kNvwFd-gFR&_nc_oc=AdkAdPM7DCDYX1pMa3qrVkh-y-WA9A-snrmh4bqHskxPyTiGwLMMWTx0FoITcz237lg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEcJpmHnL6nzxcnacyNvOe3e6BYlTWk6Qixd9HBtybVA&oe=69B16B0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqb82rkVQWsQ7kNvwGukv9S&_nc_oc=AdlL6eUTAtVHYoGfxTHNfuhyvuGGO_XvfHZlPNZNrcuV_HKNabfpBJrArKR_5JhCGF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyn3gdZIVoq801LB6u0XFBFTqyCDQrm80Nh4aA_x1LyYA&oe=69B14AB0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFJ_Oqax2QEQ7kNvwG3gRzR&_nc_oc=Adldk7wErpV4K8rYilmywfNFBw65kC89JbuUak4GyLQW446zdZcBRTy-ViD0zUQWD9k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1P3JuiM_COEzTW6GRH-8QdyXjp_fdgRVmHiNRPMVU7Q&oe=69B15A1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-3O2qHjoDEQ7kNvwGssNRD&_nc_oc=Adn1mkHg8OoNPHj9X66L0jIdiZfh15JfyucWenJMUxhRTJYj4pGcMOr_EYKfgwLeyZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTzrn16k5kRbznAA4jNKMujqqceUg1U4RXy1-EnIIIBg&oe=69B16BB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=q80L-EYmayMQ7kNvwF3buu1&_nc_oc=AdrUYh6dw71scJ0ntx9rq50TB81K6u-TV5sNLdbIU21rIBz-4NMRryp3aaI_tLo1piU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CL8UrmkHc6_11ycPec09y0M0xqsqnarb900RFKIVUQg&oe=6A0885F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twX0SlHdHP8Q7kNvwENb0P4&_nc_oc=AdqnAcdLyVQu7dkIWt5RdR1LnuPUlAl5Go-Av6cRvfSoq0h6iYMfW1XpqtMy096aQq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VlmMs1o8qRDBLQ4hmP1Cd3fk_Fe57PXrrhesgS6rqGw&oe=6A08955A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pa3MncqgBAQ7kNvwEkZqQO&_nc_oc=AdoX6qB55P0tltgKmOhKwz1zPEwJhVOcy8i6z1EToAaCSIJ_jJgTqaT0z2uD4jRbTXo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rk97cOoFYwXAek2G66JIMox0LH3TTIrmfw33-SDkYtw&oe=6A086E0D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_OeZr2cZOMQ7kNvwHrMh5J&_nc_oc=AdqG5yMCjNHE_pI9AzMgnTubloxUY7NUQpBdpvpYT_MccnBY7R630mOpIovMhmE3LHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZmolBoTL-ncDIAc7VJA-3XsPXfafa9RVWP0S6zIlUvg&oe=6A08672E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN3t7-LcQFwQ7kNvwHjWSIQ&_nc_oc=AdrKyxdPuA7eEo8dKdvLdcuoVaImmpkjRavNqwy9ZW6dUFx6Ylo2H5pZVHhUI2gUGw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hXZ3FdN_GRDK_fnqSlZuroWILWKA2tiqQayPS65vSAw&oe=6A086EB0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
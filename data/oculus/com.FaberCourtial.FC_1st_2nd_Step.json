ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTQ6XHaDp4UQ7kNvwFsOc9l&_nc_oc=Adp2wIu9bf4EcE_q6Jwf0PF3Tekxrc8gw6NDkOYupPWtE4g2GcaFUeAF5nldsW0LRMY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-wDn-YI3Mbf44fswzzg38PrFDN103l3b5GAY7A-1KSQ&oe=6A748B63"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocLfErAvVyIQ7kNvwFDNtxs&_nc_oc=Adou6uj6BuEgV9Ve6Fx3qVpHer1zcI7YNkwiHiexjGAJUb02YqWxDjhRxTVoWC0OYR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdqkWAu_Z0AtgkCnfPiQWUPimNb-OSOx7p9-1pBw1brQ&oe=6A74A1D0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlp73EYoQs8Q7kNvwEbhAg0&_nc_oc=AdrVBAhz96YXGKWZ8LmD8BGKUIow0bFi0cOTHNYuBxmoBUC5LXWq_MTjuiw6Os1tqL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGty_lKNQsn42_ebCArI-c7wXnIyg-uvZW0jGtjD7Qo0A&oe=6A748550"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-Lvmi_Do4UQ7kNvwGm9-JT&_nc_oc=AdprWVuXumCJBDg0gMDgxj61ucLMCR071tu5xgtC4ovN54imRJ9Hx0q24sHYxtA7dOo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf_8GINgruVJiIv_JJn03yrHFKG-pVlOZO2ckudHgCYA&oe=6A747A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fjZjTxPakgQ7kNvwFRm1uA&_nc_oc=Adrcu8ytHjvxmaydY7wf2SJmLm_gOvCo3ppWg8UG0jKkjNrXKEcD0wDNHEEC8kIIwQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBVU9v1e2ULeQC1V8lUeNbehrDizjkIAztU38aTBzx4w&oe=6A74827C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4LKfOY0pPoQ7kNvwEgmf0j&_nc_oc=AdqoeuEr_6xfav30HmmCqX863Q3ZVFZxn6xcfmRafIXu6ot3ChcLPWytCDe_nAImejE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCN6Ljih9hTh2JC1I4B7mN4Tq80xUxmAYGqwXvKU0MiQ&oe=6A620D2E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WILNjRGpHi8Q7kNvwFKErHX&_nc_oc=AdpcagyPym_sEwjLBUwTZDFPAs1cItos2NyoXqVjECQ4VhOSHcK-jShYa771iJg2feU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACE00JPjHr4K0OJ40X1Bdxzn1keR14PgMdR5wdZgjeQw&oe=6A62140D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9nvKhYbsb8Q7kNvwGiJREk&_nc_oc=AdqMTw_1wJwrjIoVa4Q6hYGWFleMh7wKcbvmKZDvUwbdS6WFAPyh5MRn-yIoGA8uUqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH3ojd3T8ESlKluFf_zcqDZfQr-0HRsPUVDZPV5CSisQ&oe=6A622BF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdn_LmS56Z4Q7kNvwGIX8LN&_nc_oc=Adqp_b-DgWVAvoEN5juEaGbWYzz6omFuI2W9p59vq2ZLsccN0A09N0kz7_sfkiypi1o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ8GDGledKGKWHa_aTHlfJAn53EG6J0S57LYUk94ZUlQ&oe=6A62031A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kpc_Ls6r9i0Q7kNvwEk1jhW&_nc_oc=AdoYFbyh08Og85sDaKHDeY9K5b0-io0x1B0NVrhyW4OPRb5gejV4i8iZyKrzcACMp5Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK8pRrFET_S5xiJzJF-RKnyNk0OSYtJyWSWqKLQVAw2Q&oe=6A6214B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
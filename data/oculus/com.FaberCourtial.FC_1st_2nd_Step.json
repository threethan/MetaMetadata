cb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wIYigkan8cQ7kNvwEBDsyk&_nc_oc=AdqkxEZrO7xl9qtYo00kpjGPHB8vz3KK_zIUu94_6SURm-CYErs90q1jwhgwlKfOXW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UoQvrIfeD_es9omtOAmp6CVetwI25O4Ko84myv7OiFA&oe=6A0DCBF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxeG944_LIsQ7kNvwF-X7lL&_nc_oc=Adp0MLpjDVVxBcx-IimEBXLu3UjD6YGF6pvtCNWB2pMvJsnFoX5AoL0OJZxNvwYV5gY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qnn9qL3ArsC309EmxN4sAgMKnp8dkPyZn6g7pg1eFtA&oe=6A0DA31A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh-iJFvprYoQ7kNvwGXZgTA&_nc_oc=AdrSvSUYkxcEN0HeBnj0n_WTASRdlxqlaFHKw4JWrzU4v97GItJoupsafpB_1PfB-EI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60Eo-ozbIRzUBDXKP52xTDLofQHT3kJYIC5CXRMHuVbw&oe=6A0DB40D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYhKWX9eojcQ7kNvwFA6liL&_nc_oc=Adr9HdLKex_TfAnEH9D01X5TF5t9fv6cpbqZhMlw0hXcGoqfTYcN9fGSxbd23j3-YZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CtZP9-VFb_C_2-BqNSpwLF-t4NMupHBkjr0j3ZCxqjw&oe=6A0DAD2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3lyjk9N8dQQ7kNvwHiDKTU&_nc_oc=Adps3HtoPeUFOooZcakeX0iSa5yyw-Qr5OylWonp9cV3aSuChSTpgWtjuUQvA3pojsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wf7CsVvtJm6VNHiCmCY8UjXm1QnzRZy5s-S98VpKjTQ&oe=6A0DB4B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
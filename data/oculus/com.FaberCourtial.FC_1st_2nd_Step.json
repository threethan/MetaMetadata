lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ClZYCC8Iw4Q7kNvwHmyF1u&_nc_oc=AdoprOcAtJbmtQnlbU7ZRxhfkidN21lJX-tok0Xl0W1G8QU0sEc_vSmZYtILJ6Rh_4g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUKcXkdbeXkLttIjRfaGegob_pEqnCk7JMyrSROWWRUQ&oe=69CFB6AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho-yKbvzQ2UQ7kNvwGR0qKy&_nc_oc=Adq0uHPHOBW1v2EeIxsCurBvqXQzzD3k7yM7q0LQEEuHamhY660j8yZbYEcFHCIVcJY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqssRP9fmHKkzIMny-nea6JA91QJ6x2K78PDQmbm9j5w&oe=69CFBD8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Iz_37MpG0EQ7kNvwGfWWrB&_nc_oc=AdrO805AjtqKGeZSoG8HRp13uVSeIyl2_dhZs3ofPLPjoa2TcZqD1t8gyUgDXE_V3W4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHChoBuq2vWAT74mRAYo3_wwRGmW0FUvTVPCv_xP72oA&oe=69CFD570"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPQbuzfa4UAQ7kNvwFqXVnV&_nc_oc=Ado6d9KbwoyonSaxniY8kJ8Z9I-vGM8L5EhxnQCUlsX-LSz0Ud5wlbjeKQR9xh7lLXE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUmFgxybZ2BeTjN7Df5omojB4XyACi6iuiIV9TJOY6GA&oe=69CFAC9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_k6axen5TcQ7kNvwF0aOaZ&_nc_oc=Adq00wfWn1PQRpFMCcVhSHZv-CbFz73PtyC2tOPqWdeK1BEJmVE_jWOwDNJmDn9ZBqY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5wuswrWHhrefDzQoxIQNralowIYUhsLGT3_P3zs_Ceg&oe=69CFBE30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
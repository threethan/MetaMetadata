ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr6y1154B-oQ7kNvwFinMZJ&_nc_oc=AdoIiRqCOjeHEaYJhz2GE02E6KG7C7JUNb5LMIDEYgq0HUhxl-Mn1uUXtcuHHwSrLn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nhp1z5YXq2HY6Q3f-3HXg_n8qciuOhS7LRlwMrlzBUQ&oe=6A2965E3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKh_KEO_pvQQ7kNvwFqbEVD&_nc_oc=Adp93gDSLlrCkoN-3-7Il_imRMNNpIAxwS0EATHmX7cbYwzUpJcWPbO6Pfsig6KGk5w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DAGmF5jBFaOfMsrCMF9qibMoFnyc1GJ8z_C5ZjwKEtQ&oe=6A297C50"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H-w0B6EZ14Q7kNvwFYupUH&_nc_oc=AdrsPYXSBhrAKRlmmWsBqYo3yc8PO-g9V_knBzPKDtLh3-e0vd1einMGw5H3fi8iCnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e_bfo-lwU9Y54Bn0RV4qeAyU5CDA0aJzMFuc1zSlyFg&oe=6A295FD0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoK2QZO1pA8Q7kNvwF8lgxl&_nc_oc=Adqpo2Wht0l2QprXUlTL7CL5LJuUz0jAZQKdkNxd4LZCVZcYfuDiT827bdIcxg45S_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KQWahEA_VTSHiOSS5VaZvPdxEuQvRLv_AnAv9y1wAfw&oe=6A295481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLnD515wguwQ7kNvwGXa3ta&_nc_oc=Adqz1A5CVs3W_UUZCoSfbAYcqj109z0isNMoBh959LPHPBwoJ7nnOlqiPqbynKj6aZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JCjrlttzYYHT_MtZIre16_w5hzsVvAhQgbvSnJ1mo7w&oe=6A295CFC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "933296257322239"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "267945664609715"}]}, "baseline_offer": {"id": "267945664609715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1603990822, "status": "PUBLISHED", "id": "267945664609715"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3138820322896787", "version": "0.902"}, "id": "637513726832035", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2714882785290545", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3138820322896787"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "637513726832035"}]}, "change_log": null, "created_date": 1602611129, "id": "3138820322896787", "version": "0.902", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
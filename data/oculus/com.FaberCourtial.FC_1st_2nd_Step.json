cb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFX6GNwNd98Q7kNvwHwQUYs&_nc_oc=AdpcWyd03u7lqhGlN5rJf10ivrlwZ0jgm-vqLDVO5Q5lC0xPGIA7reAkObi_-aFkMbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzYddiW0ywirJSaUkFLwxv3bv5jDdZpvay50NLvZvM1g&oe=6AA80B70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcqIzbqdn58Q7kNvwEsst75&_nc_oc=AdoHq9OWulqBB8eB3E0j1qmtHPgFLWHYMLXh4sVLt7hfhcDXfrvsex49o1HOu3DYMR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAiMiSOty9V6L2Anpt3Ai6XXLQT2QzBava7ZjC91qC2A&oe=6AA81ADA"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PviasN7Y2XUQ7kNvwFT-Y3q&_nc_oc=AdoapY0C87F1H8kswyKVPnT6rsQxPN4Pr2Tszb4bb2HBV1wtNtLLk8wEIB9Fj6qDQ_s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHOwo7gAfwtDwYgVA3Scn_J3_R3VGnawGmI2MvpvGAYQ&oe=6AA7F38D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UMpIyRu-HAQ7kNvwEymMlB&_nc_oc=AdpLoXZlQO-JslJG53lWmv0lRcw8AqzT7u6XyIEYYaJAYbIXRfgY_Od_Nzolf-JIR3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7y-bvpPo-zAD4z0YYqV5qeQsIKcHOrdeJrzO1rUMfhQ&oe=6AA7ECAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IHoHEBVyB8Q7kNvwEwwIZc&_nc_oc=AdpBh2r8Ph8qLMsiPF_eiFdh6TykKeMiVbl4lvvp-UZB9cjNiIzZKX2wQd2o1EoV_bI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOLP5saXHOuYbzNAh2TEEKHrCqrLB4s9sfvKmjnG_XFg&oe=6AA7F430"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
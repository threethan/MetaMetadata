cb=1-7&_nc_sid=6e7a0a&_nc_ohc=meM0iSSNhTcQ7kNvwHp3k4R&_nc_oc=AdooItNM2v_49VZEsQGLYskDxuMDyv7b_o2Ej-ZtWTmSS7X5ose8IbaGjTMMT52nhI4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DU8h3M0I9our2b2oihLgjSBZtOsYpcBmxUIXakLkf_g&oe=6A09D770"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twX0SlHdHP8Q7kNvwH3dUKu&_nc_oc=AdqVSshAAb88h9k-hq02tQLQ2i_hHm75gLnfE-8oMOIhpHLeObWUxSabhXflXzIfjYk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ARXMJ5iW7qQq_fFjQWK-EEMcP1kl3KMGmvq23XNv-GQ&oe=6A09AE9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37IwNbTPzosQ7kNvwGK09bm&_nc_oc=AdqXELpMDZX5wcPt4LQ-SUmynMYwkkCkjEk30cj-ea7c2lNm3zUJ3BJFJh5fksnpGLA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62cg5DN91jZeHjXRNZp8GbMX65OkLFcNGvMgB6i-XCNA&oe=6A09BF8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4IFM8TnlwUQ7kNvwHhSyTq&_nc_oc=Adp4SqKUGEiQX40w5i6F9xni-M5U_FofeUh-s_fpBQi2xQeUXjz3c05FspMVbwW1gUI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s4HzvGMaMSgqaakVgarOPtwLom7n545x0k4M1B8egkA&oe=6A09B8AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACg1_0twoXUQ7kNvwGduHwv&_nc_oc=AdqnxwPTqBZDO71anAdBBIOMLPRh-qffUyUtx3jOQu_2AM37Qrdq6uZRI7av30IwEIg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L0a_INOSLRQ_ARiYXIt_l2kzr3ZylTIE-bO4kPaFQug&oe=6A09C030"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
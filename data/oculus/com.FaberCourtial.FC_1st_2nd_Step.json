cb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIQp96_a_c0Q7kNvwGuuhH_&_nc_oc=AdqySjiNn5UG-IJTwMnqCrbpvxaYug87Ml2-vnqQgH9DRAZ7EVeZVfNCmW9bsXp4Zdo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2dZFv_r6vMb4Oz-1UTBx5FFZLhTVA17wFrB8Sz30sXg&oe=6A5A42F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TH-cTPPisW8Q7kNvwEzdIwm&_nc_oc=AdqhmjFh6KCVkg4rLzXZ4kuk1mrwd1UG84Mq6HY9J4A4-NwPcEPO7x7TZ_YRDCCV8-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC8aVC0cc3CSq27sbITuBMktJOnBmUjE-9LGlefiywoA&oe=6A5A1A1A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyA07kHgTjgQ7kNvwFxPOnN&_nc_oc=Adovr8u0YPA0iPQqntTGxGPec0g4dv_fHKDXELr1ZR4PT2z0Xg5qSMvb620z0vJdNzc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCngEODk0o-tgBn0dglVdI_8pvp_VlPPS938iREj6NlrA&oe=6A5A2B0D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bj-QcnCleoQ7kNvwESd2fw&_nc_oc=AdrSk8aVJldOVaaUQY2NgmkAfXKSw7_4cZ3jZBsCIxuR-yctkFxzdtyZ1EHozD3Iizg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAekopgnsNGx7wx1QTYCw81896yPu7j0VQctyNu-DPOUA&oe=6A5A242E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsD1z66ZTMYQ7kNvwGV15oe&_nc_oc=AdoBVz5usmerZTbVg1IiSheNQBjAwtbvHSNvMoGnjA6d1-dtqGMQA4SuAb-6aPSmS3I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMpXK82w9dhZs33pJu4V2u2jPwrspk6CCs2_xRzDsqCg&oe=6A5A2BB0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HzIwvDL0RgQQ7kNvwFhsVgi&_nc_oc=AdolgveqeIZowIueCDdyR9saTxulGe_pMPMoyr04nTJznobUBMuYfOeeLkZpn1Wv4yY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzcj-GhQbgt3NENRmENlGWO8bQkQuJCl1n7KYsoCHJqA&oe=6A4E46AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZEmBkPv0EQ7kNvwHKKz3M&_nc_oc=AdoHWat-4rq5TMMxkdgACDPsyEWizacp7hjsmvVjDdEAAvTDYuoYvj348uKE3vVUenk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhRg9mIj9OrHbq-6ZAx0nHhqcShzpkw-M9qLNzgRnvzA&oe=6A4E4D8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2h74o7XSWoQ7kNvwHF8cZP&_nc_oc=AdpLzP5fM7ni6o8fDoS-2nJz3Hp7oXsxZv9wwFdAwnc9M3bLSiItx_UZjBtVc328oPg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArKIoG5d3fZPLHYTfiBxHocACS9a5pNXRK-LCFRQ82eA&oe=6A4E6570"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6vh_GyXXuMQ7kNvwGkyj9R&_nc_oc=AdqPoCMI-vyeu01mSg7lG7Z2lgynJ5dMnSwyQm_QWqADkoxxe6VVF8vwqSGhA6oCwEg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBD2c9SvKdjlU6L1E350pq5RiVBPaiiMmITIX3Fw0-MQ&oe=6A4E3C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwCPwN4Et-kQ7kNvwHse7h5&_nc_oc=AdoGRtdwL3VpNdlwgTihKLDO55zPsjAv84TjGApOsQQitMaSdywFziE6UmKH0gXvnIg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSZWK9ttpnPS08YJG8fehQ2V8V3Wt_F-Cg4i-bSgDnqA&oe=6A4E4E30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AmCPToLG8IQ7kNvwGOPS_T&_nc_oc=Adp8cHKbevK04yWnULapqsm2mGnYYBmjpH4610RUPgTa4QFftYphIWLKMN_11DgFfg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ug6UDe5nXwqrSRP-HxkWhHZ3eQPmvRBlCkLR97fIu6w&oe=69E4CEAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUO3IDR0z2EQ7kNvwH8QDfC&_nc_oc=AdpRMrNjmoIsMIOw9H9wleqyIZZkE1q0GbcnaDb7WaHkPmJ-DO92TxksMzUQmlE_jtI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BCc3JXQkg6FMkm3JcpOtVc7LLiBOLlbKcv77v-Q5AMQ&oe=69E4D58D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpfQQs36u_cQ7kNvwHGWzww&_nc_oc=AdpA-zf5pVuhn7dVTBH4bOBRrOMiPKGgBLlw9V-KoG3ZnxlUCYpE2MEOaTlrt-hKca8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cXGQjP68CylgrQ4SHuxiJFlFM7H_ZORTNdPsjg5eIhA&oe=69E4ED70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztMrA33kts4Q7kNvwE46F7h&_nc_oc=Adq127xgSVrE1dEZvemcutoIa_ItV0Udz6Wqbjpr87WeFkdVk4cJ4IUOcf1mVWafGoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11KRo-WtK70mkGjRKVJ69vvZ1K23Bm-Tjse2B9ik99ug&oe=69E4C49A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FquVEkHkCJkQ7kNvwGuqeh1&_nc_oc=Adr9sC8GeYFa_Ay9vZjZbHKNIwipXOysE_P5smKGOw8S1Ye4AALCRM4rIbjr0UxofCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29AllIbSnA4l_7UfWOBCcsp5gvF5iIhknbL25DPcKbkg&oe=69E4D630"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
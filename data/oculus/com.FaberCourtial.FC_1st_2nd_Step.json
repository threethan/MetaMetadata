lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBOiwG1mUvAQ7kNvwF3-I_E&_nc_oc=AdoYBvakeP2KdKHggTGzzHuKFhqkavURN7ryCPF3au36ro6QEOdecYqBCnINvC5UEv4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaNUUtRGhEZz6bfG9iO-9_4UbcfgLJiyB9rS7oQrzzbQ&oe=6A538CAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf6RormmYowQ7kNvwGN3cvZ&_nc_oc=AdqKZ1ZMpQusTqrCuQlkVtTgMCVWh97bbWBfIoZ-pAn97-3LNstW6PmOiILNSZHkoVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC62id8bEZFTqYvVqgoI9LEJaPHjCHGJv_ujOy-G8bInQ&oe=6A53938D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oyp7HfCxRgMQ7kNvwHH30QS&_nc_oc=AdphVrqABpsD3g79Oe4ilvnPPpDyL2u-B_aLQrZzsfLoE1gPRKOKWcCqmrqdSEt54qw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDegFmQyKZItioIzaKuz6K-orgnVzpzdfC8P4pYJGW_3Q&oe=6A53AB70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cECNxj52UIQ7kNvwECGdiV&_nc_oc=Adq8HD97MwxiuuZH6X2_uVwdT2AKW8iBZ7tqPLyOHnOCvt7E8Ha_vsxpGEIL9c2TXTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8IB4ZQE9__n44yRjMwVIFKfmtdD-p8RuHaJaSx-0Acg&oe=6A53829A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4L1ZEQxfkoQ7kNvwGNS7Tc&_nc_oc=Adpb7cKPTQ_HYFBgZbfS_2wdGv4NRXyupO_0ae1ryLvZoDwXyYRJ9amSbcvE_7eOxco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANXgBUHuMINWs9HrpPI5fX-MPaXqcIJcfIMh4IWk2IgA&oe=6A539430"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
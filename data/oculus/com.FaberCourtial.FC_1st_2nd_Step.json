cb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRrn2l-mFgkQ7kNvwHyB-KZ&_nc_oc=AdqXqlTd56rPAB2RmW5E8kTMvHIh0W5qC729j0NcZssaUdmIRo8SwuqyGpylFudEsRc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tMl1IWRAiN2JF1mBnSTknXd1dKTyZvNHS7ZvorP8mLQ&oe=6A1AFAF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iHX0WqgmLMQ7kNvwHbBpYt&_nc_oc=AdqJHCyirSPHweHEsIJ5i7TuGBV3_dJMtSMsKivaSWlcaW4CWK1JVb0tixEFKfpqzo8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q8vOVVpDy4pfhGKp-Cbdq-hP1B7hD1BAgd3b9OfVvhw&oe=6A1B0A5A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r-O0CkwBCMQ7kNvwGEleaq&_nc_oc=AdoKYhaGXH2a6UUPFO9o2EeeCqGQA6AIndP96ks3lZQUhNWSdfUqaEXAxP2zQU5fWuY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iterIyd6M9ilzgJQCYcCqgZhR60_m4GduUjJPnrd-EA&oe=6A1AE30D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4dvSCxi4VIQ7kNvwGuk91Y&_nc_oc=AdoY-PmDsfX1anJbXgp9FIWChCUoQyaeaOXdIXLxbU0c5hiGaUb6b5ndTLAg5byuvPw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7epStOlH5kUmtI4rZVREZnWItaHZUZ4_hMV7DungIlGw&oe=6A1ADC2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtpORpT5gt0Q7kNvwFEZBC5&_nc_oc=Adqr-aK0MSgF-pPDhrETl1w_TGwg9ySP2WDNhEJJrrXTDwPeYmiR-gSCWe34SJxrHp0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AyMMTLqCkm2OGZzKXv_bmeCcyE2rMVO4lE-uK5QUxVg&oe=6A1AE3B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
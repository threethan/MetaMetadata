lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaB0S_74GuwQ7kNvwHyBtPg&_nc_oc=Ado8IM6kQg67zgNmYvyDU0XWNizZXsjlfHLq_UNHajBWkpRNrEBSn0NTlHbZuspPYm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhMJXBvYi6_efYNBmtsS6wzeWwd-uLac4VgefS5yuTnA&oe=6A9852EE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZRF-eRfnoEQ7kNvwGR56Vp&_nc_oc=AdorsBuCu5xkSpRRApqerrwARqpki-JiVhGxeJuedTdQKWpg7n-RjVN_xVjbDiHW_qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1g0rHoe9xVA8q_lZp161LAPyFZURe3oQ9SQzYcEyCFg&oe=6A9859CD"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_N6ZQQwgE8Q7kNvwEnd7l-&_nc_oc=AdoGUzOrxmw3pXgP_0ixupyh3OO1FDv_0GOJwTKyTHoIChHP6Ijq_XJaxYJDXRlfjF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJT8RvnMdYwJzxO5zUXY3prJkoWmcJoycSM0YWyFdNwg&oe=6A983970"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqiDLv9oRPYQ7kNvwEi5LVz&_nc_oc=AdrDnF2KeIpgWl85Oh6c4aU0nAEaXx50_YsR536o3UqJWEwV0DRhi7jLLGAMg02LxA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFRJCHU6UEVHm4QjfycXfHxxBRqriYe5TYejEAGD2JPQ&oe=6A9848DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr8FAr7hT58Q7kNvwG5w8Mz&_nc_oc=AdrFyxLiy7QGogY6eYko_OheIzCTNermz4MTBEDkYfet--8_dUlAhiEGlmlxlJ7E7tQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZgrQK3OfIP6nrScaaBF_4u_Drawxw3-lwy5Fj7Hzfxg&oe=6A985A70"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
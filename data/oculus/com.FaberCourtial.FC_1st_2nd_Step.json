lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veqlcEn_pOIQ7kNvwHSp8wP&_nc_oc=AdraNpBIKHMmCMcDjNL_ruCZHLtbpXtEhwIt1bHvbyyewTI69w8PCZi5cL-Z40NtPsM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VTXLIlVfOEjwLuUcDQC98NcwNnpvnSpe_CH7p2Mpy4A&oe=69DB942E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvFDg1gSMfEQ7kNvwGTle_1&_nc_oc=AdoC4niKgov9DLilmE5zJVN5jUqrKHPHJT3I4HHalOQlLJOK9HM2b2J5BM3xAR-JcBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R5QZvRS_pHYSKWNQ42B6RVqHZuWM6LZzqbTyJjNdPLQ&oe=69DB9B0D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4fvTuu7OEQ7kNvwEEB2_Q&_nc_oc=Adpi6CQRTgkRLj_AYWmRB63DuTLxekYsaripJpi1eHXXSrTf3EgagRd65wj69fAi_cI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MmwnWXZPvXg_4-rvnemmRSwgMac4WQujk_75_O4f3hw&oe=69DB7AB0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd_S6ePTff8Q7kNvwGAgZNc&_nc_oc=AdpP_vmTZHd9SGUQjt5eoio-9NN644rGeq3-BO29yv7QniSWk703PaH3chor5UInX9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17epBPAOW7PU7id-fmVAv-8CPt3aqEQU-AL5_7_GYbEg&oe=69DB8A1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFPLkTHC0EcQ7kNvwHyHLWs&_nc_oc=Adr7poKY4rpbRILbRfNCKvt92qQSF6oHaKUFVvuCoY1XdQyX1mcb_gJehXhikB7_bU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DfV8kY1diSpA4VbxyXNBfKbSvgtzsD2OdzzF5JochLQ&oe=69DB9BB0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
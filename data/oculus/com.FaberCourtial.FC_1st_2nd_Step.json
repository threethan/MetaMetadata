lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79gWsa2HNfkQ7kNvwGm_wIJ&_nc_oc=AdpaKLNMoGaEidaoM6Tz2rMWpP2YaB4OgVqZvZAev5hIK3RWq43-0cUqjchsPP5-aow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_uf4IXXyCxxS4UvtlhucHsRNUOtkOjE05iAw8ct9Pww&oe=6A3EACEE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF57VJcI_rUQ7kNvwFE-nvO&_nc_oc=AdrmPdUaTaYnhDO58ka4oj58XrV_LPQfiiwecWWvN5lEN-JakPPRHnrDfNcZcwoCzMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4E9dinYnn1cxae2xn3J0uz8GUyCu6eGZe6Cf_X9gBYw&oe=6A3E7B8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhLpj7Vb5HMQ7kNvwFVxH3E&_nc_oc=AdrlSIcJ1ldlHApE0ReUrrp-reEKZPKk7OXOyNLmvg1Icw83QZ6DSxWAUZoqsHwPB5E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CxBKSFcmOKPug_44J9gVUwZe-1-fH0VEh1bS2sK6UBw&oe=6A3E9370"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVrRHLl7mXMQ7kNvwGxzaX1&_nc_oc=AdrCrgsw65orb6fA2HL3X0ujmyWh2jTY5McxPQuh2VkoNx2jvrbKjPNLQWp6DZU518Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95R5XsRFpiGBXgv--kVZikd8p5UbsXS9D4_C6nd0AMrw&oe=6A3EA2DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL3z82w3IPkQ7kNvwGaX6aQ&_nc_oc=AdpLhHXjMC4r5761AMSMS4MbwMesSpW6X8ga2X777G_5jn9RDIUUD1HMq8W9DZ5LUP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--EUkm-SzevBq0x08uE-CB2mvx0nMR5aWL4d_Rm2r4uw&oe=6A3E7C30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
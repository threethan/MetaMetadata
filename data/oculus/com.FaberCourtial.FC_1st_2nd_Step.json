ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OzOZkXloeYQ7kNvwHgUoR9&_nc_oc=Adq9UUV9lDID4OqZnN9zBJ7xng495TVoIE3ReT4CPOm6oVaSSlimfksal8anV49zaF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM33gSBaFpgugH4k3tvVVNWdAAaS9ZW0YK2o7ThcG3Q_w&oe=6AC10263"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC4IdTN8KvwQ7kNvwFSAqq1&_nc_oc=AdrsW4u3pXFbBQvPp3BwQK-CA9VKg5T1y9X2Mt0I9AqYhtJs5JTAeomiawJOI4FowrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpsIUsbEHY6H_HSOEi66vtML5Ae5IcsC5uBOfmjZleNg&oe=6AC118D0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPfw3mV2CZ8Q7kNvwHhlnW3&_nc_oc=AdqWlTQoWUP_dW3InKUrbDD0DfNvq3jRt_G5xcjRZQv08JC307lqxM9jd2c_mH748vw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaGHyHAgxInhLWSG_sgmIc7rfC_oQEFOX0qmySkH4f4w&oe=6AC13490"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZw3TS44igoQ7kNvwG3uU5b&_nc_oc=AdqKTUrH7RX0EYIn5czYUjuSnVHwY1v_MLi1ZqJHHlP7eFzYqdtp3qkvZ42qTKSy8EU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi8cRjtLZ1ev000CuPiVAB3xCEBB3fYROILgTnDeQ5Tg&oe=6AC12941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMlW4RdSXE4Q7kNvwEmDBi9&_nc_oc=Adq1g56op2fXo6ECo8xMACnO7PDdDbWurJoDH7berTU9vHK4_-f4RnOQOH4vc-tSKmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Wyn--tVSouiXqlWjsM--dvZsIgLjhDEnJ2GgczdR0w&oe=6AC131BC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
60x1440.png", "id": "2637953463188764", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZSKB5fReaoQ7kNvwER7Hu0&_nc_oc=Adms3nxj9W8-zkwYCH3BWysZ4fjwXEjsKCURmxkb7W0Lq9ntHCwXWZfi4HDG0c2NmDQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwA6TfgBUC_89615vCnIw_bK-bN52XrNWXsl28-wD_elA&oe=69AAD5E3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auAKFHGWFDoQ7kNvwEL9EH5&_nc_oc=AdlOqGLrqo9q2huFbjAIcl7pzWeyuNyouIBgdTKW0xHHUVE-BnALvYURDeJcp35WpPg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afxb1hTXpmJBqsc3x0uMWPGtxk3ReY7peQtetVA1CTuTzg&oe=69AAB410"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFESZ_tfPM8Q7kNvwH1w8-M&_nc_oc=Adk3hSIIPFMQNc5lsa4KwXFgM8O34DpYUxOYvjiBHnRKAYMV3neBfmVgXeMI6MAQhQo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUkBmbVU0UgbQBh0nGPuSNu1vv6WQx9QSCOn4TcNdJGw&oe=69AACFD0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA0w8b8POm8Q7kNvwGd9cJx&_nc_oc=AdlNprWCAFl7KE4HcObWH6QDcPMAfjUN9sX1ti3FSbDf_MiHR2w2m7NefT7byEQgt8Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-bmwwXH7HR4_9TcQJErszAlPkB9uUzta665g60T75-A&oe=69AAC481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJWR22ZZIPcQ7kNvwGLKZo-&_nc_oc=Adk36sWke_qwNJoXSQGKnqktxzHOVw2zHKop8DSlQ2XQhYUPZbeVsc4iSrAbD6fAPeQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc40nwpebdPsKCw4qDY78ARxlPozlt2nq5rWt5qDsjUg&oe=69AACCFC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfor
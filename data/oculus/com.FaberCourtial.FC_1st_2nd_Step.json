lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN6VH7Uj2qYQ7kNvwHdUrWH&_nc_oc=AdrGOLAkmq2TDckZNfhGjflMuy_WUtOyN8hKz9P0UUaB87q0hLXXNKLtYzBZUUkEX7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YnBub6DERn2K4Js3S5M_No8osnBQG0WUnekmKj4IqkA&oe=69EA14AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqfkR9Mo7i0Q7kNvwHUo4S7&_nc_oc=AdpKs5kSG_EP8OLEUMRkMTZDAbMdAZxF9Eic3yhdqlHZZDBkAxlRE0KSVZeIwUAddko&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-eAZJzC5ApSa6pykudKA8EpJKNPvCxoJrRFVgbdioyw&oe=69EA1B8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBwB2ZdilaoQ7kNvwGtAonL&_nc_oc=AdpiAHaa8NOSHkl1IdV67qWCUpQC6fyYFrAVR3YGf6XLS3LuacS9BV7d3bfBJgX7T68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dKi8rx9xsBbX632cbhW33iCiXswxMcWohI4D7hg71rg&oe=69EA3370"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV9JSutDRKIQ7kNvwEEddrP&_nc_oc=AdoFInzCnf9K4VmR2xkZUhwYUfZywSqv8BEc_RaRntVsjUjhyjw2zhKBx8Z6y2jm_rQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zw6n8HxHyD_5zHSuJ8Qp3P2kJTr2Ujem_Kyp06aDtGw&oe=69EA0A9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJTM2Mlkwh0Q7kNvwF2Awqt&_nc_oc=Adp8sC_eZfowoCxpuUH9wth397_3Zo26xOsqdgrVddZccmo3blEEbGlERg1263s9SwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NRePAJ-1BZ63aO3SA799t1TE0XzMexMvm7oQpY9oQBA&oe=69EA1C30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
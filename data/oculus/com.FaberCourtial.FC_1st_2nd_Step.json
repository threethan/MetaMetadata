ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8MRdykhC6EQ7kNvwEo998h&_nc_oc=AdoNufLqydKYgoo60z_glhZ7XWH3BqoimAK0mcANquXdB2Qx-gsCy-ugNJSIZuRm9Xc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IuLCSVr56vfqtmYZMw6WLE_TX9BlDXoiSZ5l_LWODWQ&oe=6A217CE3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwTOHsUIyqsQ7kNvwHvp8TS&_nc_oc=Adqc7FMQ8-_sHuQt-g6h9QvlIPfomf67tcUyJiAAe3deVzBImTWjiZ9KUwJhakajRGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_C0xeK1lKq3id2p8Jw72udSgZh-TjEFcx3lwxM4DXdA&oe=6A219350"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjRu9pwPqFUQ7kNvwHBEu45&_nc_oc=AdrdjZ7AHoI_IzNLQPPIDyCeDAf9sdJFEoOgalRanH25kC5qsoPODOtRDso3SFCs6Cc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YNhbdb1UpM7rRD9lXqmXrURMpNXcP_KU1SVIwse-wzw&oe=6A2176D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhiP1GSVjLwQ7kNvwEWAF7w&_nc_oc=AdprjJD7aO-vvHgPYsNYliOQFI2HzUryaCmJriqg4QV1sXtMKk2axQAcajjt5IhfsvY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aBeipxX_tbMz8DUZ-OVgWCMXAdOQjLC643FlRIH6jeg&oe=6A21A3C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUT0lTenZrAQ7kNvwHryLw2&_nc_oc=AdoTkZWZ_pHiDTe28U8kBA3B8RplCQ1Bdqvnfzyb5oTOOkE3dxHEFDcFLzDNUmshjmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ebCuFsRKQSvPF7As1wNAl59SMbR8I9HncHaIg2rf1xQ&oe=6A2173FC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "933296257322239"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "267945664609715"}]}, "baseline_offer": {"id": "267945664609715"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1603990822, "status": "PUBLISHED", "id": "267945664609715"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3138820322896787", "version": "0.902"}, "id": "637513726832035", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2714882785290545", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3138820322896787"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "637513726832035"}]}, "change_log": null, "created_date": 1602611129, "id": "3138820322896787", "version": "0.902", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appli
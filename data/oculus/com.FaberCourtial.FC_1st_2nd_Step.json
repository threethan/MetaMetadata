ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFy-jjEB8MgQ7kNvwFETz-o&_nc_oc=Ado-9OGu1oXH-tbSqSOzTI2p_qNFy2QmtHnzv8_sUQjjMISg2tmNj_pnlNLtUORZ2iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TlYqXf3W8ppruNu6mmwqGQYD0B0HnnwvfsgBeSB5YmA&oe=6A2EABE3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf42T3BBpJkQ7kNvwH91-ou&_nc_oc=Adojs5albWPbxsi_qZipUr6e5VPMcQ8IQsX6YZSs6ZvL8g6uTAAzj8zXq72JUia1JtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sdLhmA6rQjV69JfTfHEavfQQFm95LOsU-Fxfz8diPew&oe=6A2EC250"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyfxO7uYHQMQ7kNvwHFW13Z&_nc_oc=AdqNRaDGcobYgV5W5ge2qptJMzidpHZKzM2isx0cPhuldErrtoj30FceMqYbFKaAjxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IrlJ0DmaEf_84FSf06tp89ThSKkNcNLWA7HNGY06kSA&oe=6A2EA5D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je7PdrNnQFMQ7kNvwHeRs_m&_nc_oc=AdoM8sa20BzGJG9M7DGU1Ih_U35HK69Pj41j_eYEUZYhR8fS4KL2FtLcGJO7wP8wRR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2aJJFIlIksHhVaL--eMZo4Vp8ACYYGNjy6MC5qGUSDA&oe=6A2ED2C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtvHLr5tOVQQ7kNvwF1CPS_&_nc_oc=Adoey-1FHB2VmmDwCMkBVJmRwYnmd5KMsQJDcC650D6NEphzkR-k8_pqY21KNVx9kfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oa7YSCuZMTbfHDnSPztvXTrCwzf3vnRnQ4Gizw39DRA&oe=6A2EA2FC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=XreZJ_IBfWsQ7kNvwHlF0Ow&_nc_oc=Ado6IOe9El2wH42WLyqCaqlMPCSAWoJrHfh28VS6Kq2bicMGiHfKTxTwIcH9mDLG7wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s0KU0sDFmyY35UyoGzXbgcETip3HwwcWFylfQ1Qy-lg&oe=6A2040F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKP1LYHrV20Q7kNvwEC7NKx&_nc_oc=Adoq2efIFW6SY1Frgt-9MlETDnzOKobRfR7lqPrGHqaoD8DqsI-c255TljNYroX6eC8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44tSFPIte2YVGqSsNIGdt20pT6GHRMUBT_cYWJgISAkg&oe=6A20505A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMWuGurvRfEQ7kNvwH83HEP&_nc_oc=AdoF3wfwbQsKYFwE2UqHUEHA8swHOFezcHXM-4crjyTYS1x5MKABJVUldK7pXZFiTrM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42zMuUgVa-i19dk7E6bNsYuwZXL_bnJQ_ZQ1775sPNfg&oe=6A20290D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nVcbIgC39MQ7kNvwFbTe_O&_nc_oc=Adphv-oUnL0Bkc2wCcYP_4u2n71DPhY3nYC_0GsKYdIK-qohh2rWdcnMrK2my52JuBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F8r_2buWh52PBJ79xv3zUgo0jEOzM4Sf_9sKw69jwHQ&oe=6A20222E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqB8L3b7HWAQ7kNvwFRzEit&_nc_oc=Adow6F_UJfhWU-c4w4eaR-6vKba2USVZS1Afwv5eO7k_E2MPVdKnsjC9oKua7_BGJ7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YmWSlymYiBs8Mk9MYnNDUVj81bk_9hl9mt9hCp8iFdA&oe=6A2029B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFy-jjEB8MgQ7kNvwFGGzRK&_nc_oc=Adp-o03dMcHFeTzj7jCH1_uwPPxtqrr4EUssscDlNcOcEOsZ8iumPJD9qDbJaBR8Kt8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E1w6y8frkf-xGt8xlRGmhb3VoZkSXm5Z42OQNkF-e2A&oe=6A2FFD63"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf42T3BBpJkQ7kNvwFG-G79&_nc_oc=AdqJCrt2bIUfXs0T3Ub3wYSEZpbAvJPeXhnXg-gcXsehg-zioOiq19Q4Wa-5w5yKpos&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_470guKG92qPkdhtFwdU83GE20EgobebB2RHq98qZHSg&oe=6A3013D0"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyfxO7uYHQMQ7kNvwGkXQny&_nc_oc=Adr2-zDlPVp5qPi2NDbNlZSUUJz1dsZzp9TmwvDvAT9lTfOYp3FM4XSLNjHpl9Adq9U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vY98Xwl_WnrBxTbuG1HOv1byVorTQoiJZLjyr-al7vg&oe=6A2FF750"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je7PdrNnQFMQ7kNvwEVJ1uJ&_nc_oc=AdoGz7jmurPJe06bnmGRulGOpUoGvVOBkQoMDUhfWQnF-Vlj3D78DPpeNBZoyB88yh0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y1VoEUB8SqBNlwSs1Gy_I7PxyFBSTerSvrQzOa0_cnw&oe=6A302441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-W1klMaI2oQ7kNvwEhy647&_nc_oc=Ado5YSquxstnRcDh3eq4VeuGPcDBqlRbYSKC9i64cgfMyPsFMBtdtm9MLnSkLY9pbA4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CvNWtVsDRgj-fjFsLOw9w3hVnj_e2yIo6LOHy2v8Pag&oe=6A2FF47C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
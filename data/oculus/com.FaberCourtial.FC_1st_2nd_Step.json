lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ingf2NUASjgQ7kNvwH4eEUT&_nc_oc=AdqSgspJECD_B8C4M6Wk_nDZrO-qA_pTmbFyIkaa_Qa0bYov7w6fjHJLPEy7sQfHfsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSceLah5LHnzA_OQC528FUqBCCv4jEND1tOUEAqrAGJfg&oe=6AEF55EE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gG2LBl106G8Q7kNvwGr45t2&_nc_oc=Adr7aRfNxwiBJ7OzFHSXmpPfdQ-VCYarFQAmPrTGyukrdr0gGwvGaHHJjmppQfkUy58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwjk7i7e2A4JF7ycBZ1F4nsGn8LtxKNmLrpP01YR44Bg&oe=6AEF5CCD"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wj-OxW9Kj3UQ7kNvwHH0rHZ&_nc_oc=AdpqzNg6_5bhJPw8sZdunp_X9pusmsfM-G8Jg04rylQC6AZtN_E87YsZHnSkVO5kKb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBRVcteJD8ulUXZvK0ATwMyGIqkIQCUxzwdjWYArtr6w&oe=6AEF3C70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pz-queSJ6w0Q7kNvwEyRCLo&_nc_oc=AdqIclrCgae48f5MdgEVWrR2-Tomkq6rz1syE0URTGPzmbE7f2p4BLCDNf0L4hXP96s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuLv1n0daA7cci17DaRibXg1hQf88ufBGeL8aKDJCqPA&oe=6AEF4BDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTlADcBJ0zEQ7kNvwELF4Bz&_nc_oc=Adr9w71bXa8qzcQbm_nxrVp6dWrV5H4JBe-jM2TCWRsVPyZh5Bt1jWGx84kNYACbhp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk2YD90ASaiXB68YORcyAE1_KHnNA6fngn78_AeMC42A&oe=6AEF5D70"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
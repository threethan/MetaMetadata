7Yu_39JoyO8phpz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft-4WCmO0tsPV7EGExrtOA1Omgao0O8KjnlOtHSkAqb0Q&oe=6999B263"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSwzJaa8cn4Q7kNvwEObkAm&_nc_oc=AdlKgFvmmMjRxvahI_iGEsyJmjWatdl5rEGjkNw7-NyNsW8qPjdfrnZ7d7WFHsdqhZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjI8rkgInkRBfxeytuyBWvLVDHMTqkR6uc4GLbeZMS-g&oe=69999090"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyZ4SiZw--EQ7kNvwGPTkOm&_nc_oc=AdkunmR5HzuRFP5RKTd35J0INspawXP2x8F2hZpzDayqkTsr8h_9RK43Xq1CUXKFmNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKv8uANZB2QxV1-HlpcJnq4zcEIb4_z30PmXVzBQ-e2w&oe=6999AC50"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FX6YlqstQmYQ7kNvwHobS-C&_nc_oc=AdnY5xuv2YlSBcuwAj4aSMG1hWoy4Kzdznaqj9HNXRlq-zlW5m1rxihzn0h8mDPH2Qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmbkuGyFEywWP9_ghV6ZUv4TnbV0aIcKu4L41WFK6Nlw&oe=6999A101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loh4X4sHxRYQ7kNvwF1PSdP&_nc_oc=Adlg8Miz_9wdKCOAMHWvQcVxRyT_VuXGCiDvwc1DMHx8FV4t0FlXKTgb8mgAmIPdINw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afspa7zQwUjDAZlrVP0BQMuJa87MpKXBI86taZWbuNQqeQ&oe=6999A97C"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "
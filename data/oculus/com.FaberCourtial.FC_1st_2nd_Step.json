cb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4nlw2AvQ-wQ7kNvwGqbnhq&_nc_oc=AdonOPdyZUEYDJDMOoBYPk5mHqXdew8LYOh2wdywnXYL3INShLI49YBt8R5gwDL96EI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F95yVUS3KJq-fCOCWuyFXo25LytandPlGSsNqQLjQ_A&oe=69FA0570"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS3q4IpLmegQ7kNvwHacUpj&_nc_oc=AdolHjiGH3qOXi7d84PX2bm4-FUSUygCSOpRWKmLtCpdjqmzSFnpVsvae-qFuYntcn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5os03QwgqpmLwQ3vbUaEb2kHJaO1_Wg7iSqxzDDGeIiQ&oe=69F9DC9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ2uFAm5ti8Q7kNvwFKIMAh&_nc_oc=AdrQhx0tUR9q4LlsneG1_DlrTUCS1hRlK84MbMV6liwNzokSs4e6E4D2vErKSe1pYrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jVXBuok-g_qSvrgh0okujoMnsQpHUipVQyYkuvrfxhQ&oe=69F9ED8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pZqE8-bGBQQ7kNvwEg32RL&_nc_oc=AdqUAdPOES99tzeF6zHFb3SghWPZM-k0dzJZ_6PT3msmFjauWQOJRu5Na-3rilWms8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mk6CHytqRe6bF27e72-139ZjssJ3baO2vWwLRPT79QQ&oe=69F9E6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1JhCbNYmU0Q7kNvwFL1C3p&_nc_oc=AdqOxhDhsI4MjAg6x1VCOXbolP7yDSixymuDGLV5e02iRGwq4XKzs7Sndytt_cUPpi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af721GjgrOY1x9quhPuBe6SzdonpIycjGJoB4d29GFYVww&oe=69F9EE30"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
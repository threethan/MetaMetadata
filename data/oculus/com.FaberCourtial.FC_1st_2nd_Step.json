lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmBj4vEE9PgQ7kNvwFgTQKf&_nc_oc=Adpg3PhCj3cJl4xknfFhLMJLVq0Ebmwd4RLdChYzV9e12EkmbZap1E_3uMusNGAkzL0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI14WmWApfOI-TL3W6INb7eCCJYgyGtpYqEnmadlNnH9w&oe=6AA003AE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA2kUbUN2ygQ7kNvwFtNUZT&_nc_oc=AdrpSxJAU9dU5xXUsWd-xkPFiTOJ3E1DA5ou7wUPgmNbPd1gmLsOuKPTk3WIzCP08rE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjEZrMGxK63Pis01-eTfaSlsxse5yFx-MRxPaLBWU8aA&oe=6AA00A8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzHo1y0QvqAQ7kNvwEn28Jr&_nc_oc=Adpdm5n47ZtqsddZT68IeS__Wc5uB4tWp6quWB-v8xmrFKkJkFNu6O8jSdshH5IEdAg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLNyUNMEHf2knJry8-4_E0byYFuSbqd_zAU8cT0WoY4w&oe=6AA02270"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMKxLFT5gm8Q7kNvwGy2i_D&_nc_oc=AdoVyFZJUHXIvryXEVx8gKYGD_KSyQQF4rL23D0m8P6bqX_1KOwn2MiyKZBxTM2QV_4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3-ILMXJDCXN6ON4VY_oMRNYzVoKm1hqIh187Che9BxA&oe=6A9FF99A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAw4wXfziw4Q7kNvwHqnxRn&_nc_oc=Adro1tz2nUKrzdo6ZA0EMcIC2ulQ0zejKFNTHToo2tvSGfdEh_KP80Knu8Nuf9oy-7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrJu_55P0KcPmbaVcbcbHjbK9T_nu9SOtyac5L9Ze2uA&oe=6AA00B30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpfQQs36u_cQ7kNvwGuMMuk&_nc_oc=AdoBCgoXwi_Cp0LDp-mv6tOeft5dTIWVyylfjNoHmwWtK1sJmzPWEIV7He2aX3E4yqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32AidLvEHVE9a574bgASZqhaKKkA58JeaRTEZw6h1tRA&oe=69E39BF0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztMrA33kts4Q7kNvwGV0eIP&_nc_oc=AdrlLKo02VgsegOrimE8nNn31HWCymyGZ2tsK-qp68jLbMqJ9C7weOjH3Wy9sRMbsQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BA2uSfK61v-zEN0uTOZxlaiMXJRedSYAskYzDgl4itg&oe=69E3731A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUO3IDR0z2EQ7kNvwHPTJQt&_nc_oc=AdqQqCXgRwA6xyk68JDQ818u2z5-P5SmSo4CYEqdoxmiGV7NoRgFQ0JzR5yk1tZWBF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C-NxUjT9kknFqwruyEq4vukTVCL66sMbsAXSGMK9Rog&oe=69E3840D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AmCPToLG8IQ7kNvwEKzioN&_nc_oc=Ado0cMxICUzOMz7S9sx-TDgwLT9sAJT-1cR7I2Ba0QwCdl1fDnOVyKG2Thvoxp-tQBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3khYoilNzPcUUNFpD04N2ChVrs6rIm4cSBHc95RaCzAg&oe=69E37D2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FquVEkHkCJkQ7kNvwFjPSBH&_nc_oc=Ado-n9QxU_N4bIIS-Ui18eR2X6idNs7dk8_OBT37ce-IFEU3u60HziL1_bHNCLhAni0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oy7UFPBlc2bXJrJChqsQRSVbuIdMJi0d_p8G-WT5n7w&oe=69E384B0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
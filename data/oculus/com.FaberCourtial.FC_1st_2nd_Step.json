cb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxB6Kah5IXIQ7kNvwE_SMoC&_nc_oc=Adp--UmJTNRoumrufJbuc974PleZDRWcYR_b-WBH3zDeVQGOUCK_7i_mUjilh31MwKU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgQvY0xmoCpJ_GXgkta1DpUSYs0GdkTyqjsHAIjJp2Ew&oe=6A9169B0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiisRFqSSsYQ7kNvwGYHzp9&_nc_oc=Adrs_i3ZD8mXCj5bAUn3Om_m0blsthGkJbOI-tWDSHNk2eYNXtbSFncaviSAs5s2JOY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0PC9Q70-szVdIvuOEQSxhdI1eZNDefP3jWnG3Eret0A&oe=6A91791A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2L9T-DydVgQ7kNvwFL0DPn&_nc_oc=AdpHCLFsx_uN8EaWfpW6KYKtYzQR-R4RHt8Ijdh52oiiLwq83jqrJBm9BKdXAG0mh1M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrsTLNwi7bSJprCP6oxuDH-j57yC9wFUD7S7DUFEItKQ&oe=6A918A0D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY1kVBiKSmYQ7kNvwGhTzC_&_nc_oc=AdrmJdJCkKuCzkjQ-KBd-egNalanBAkPzsjNC2Ys08BxlAewsC_0rOvp9yJOgJeilMM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHhH13okhMnAH3w-ED4DQbKZnjabys-6BnBEkoiKwLhQ&oe=6A91832E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk7S3wkY8sUQ7kNvwF1ty_T&_nc_oc=AdrrxaeuFEllmSBpiw3HKVhb0MiSYuzmzP5v1SOQ80GHyf5W1gUgNNfx04kiy2sCM74&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-uPK19lE_yGQxx8Je5912ZF3BIY74sF2zznyrOAUS-Q&oe=6A918AB0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
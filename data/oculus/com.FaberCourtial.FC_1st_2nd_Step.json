ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NTx_65F2vsQ7kNvwF3w5Z9&_nc_oc=AdrkvPq5qgUJ_8hHnIZUQ0Udva1eph9tl-uHxBmOlq8vEVUtSWDcQpiBA6AXGh6WhOU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxgPmzoHIKgC70JhqGgIvv3OXIlHwl8GFi0RJz0efnDw&oe=6A58DBE3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuzwF3oKWdgQ7kNvwHn9CoC&_nc_oc=Adqv13plY5ppO85LlRg_BQS9OxGUKM7VxFzXTiJFFOGnvdqUDb60XOdajtPv2nvMXP8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7DaYPKlScS5SmwiA6d0UdNPLabQCeUWtr5zKD1FDZpg&oe=6A58F250"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1_LocoSCmsQ7kNvwFyMOVz&_nc_oc=Adr_X9OM2MxgtC40gXYnPYR9O7zCzsUtzpXvUHuTNRFNr8HKxy4R3O2cBDXNrhaBzW0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKdFiu3CziMpVhVBdE9ytyCE0RZ7I1uwabht_R4O1QdA&oe=6A58D5D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CgEbOdDLc4Q7kNvwHaR4IW&_nc_oc=AdoBmDKkdx6ie5t8EVsqHMO1caBHZzaRQIUz6jjQjk4lZLzknlhygX5PXG9dqLxm8s4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATWV1YZwN-CEmbu7GvIs_W1ZM2kIfntAspgNzObvQ-Rw&oe=6A58CA81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWHA_TZ6z6MQ7kNvwHxusjK&_nc_oc=Ado_vf21UcSvj9gUsf4FImEdsZNUJ1X5NYqbVX_fuOMRO4xhya4Y3Z6cAxCiiNOWy7Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMFjEzIYidxkzzxcKNKlKGAbUrJpBB3NaWVxuow7Dd8Q&oe=6A58D2FC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
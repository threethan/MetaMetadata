lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF7pbnnws0sQ7kNvwEl9NPP&_nc_oc=AdolI8_WC1Dq_SZuEDstTqVJKXFwJfiS78sPXxo-Zd-NhH3yqTHycAwaXu4OVbetrXQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_GlF60e7vVZljUIMBbSKCT95yuTXNH4kQSNy4aicnOw&oe=6A42692E"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2v3HYrwm2MQ7kNvwHgSAwC&_nc_oc=AdoM8XDrufthkp0RLoHb0FbGEjSH5MrX2ZoGqyyQs6tvcWXQNWty2m9gsugvTgKwtn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cL6oO5Gx7PfykdosB5aAc7KBk2e7Zn15WMyaIlMxIZQ&oe=6A42700D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy1bhTKKePkQ7kNvwFPZISK&_nc_oc=Ado8v4Lu-hw84aILFobfgXr3n5gNHUxiCvLJx9m8tVh4wYkCl9RHZhHcs-_MeJ3_bjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YKKF9FbeQAcwCPfQc_SgxflxFNhcrIoSONIH4cBOuEQ&oe=6A4287F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG4eZ2g2wiMQ7kNvwFvT7yM&_nc_oc=AdoJZxL6B8FvtXgZFCyieCr-K4EsOgEAyj6Ufr-UQKl9R7AtPQkMxtmJMu764LMM9D4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BJtURZQPzhVHN-b01rfug9On32iwATAvh43OUQYr3CA&oe=6A42975A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdiJkcaBjJEQ7kNvwGIq94G&_nc_oc=AdqpIzd-_Tlv4lUVxkVW8I-wyKCzEVnDkYG2uZoH8rEhPERMCDx2_SIbbDHQ74U5bVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87vnaiMkEkVLvsnxVg1NVuPnwkLVqw_JXVZqKU702P_A&oe=6A4270B0"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
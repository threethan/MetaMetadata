ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj5tnaezxUgQ7kNvwE1JCjh&_nc_oc=Ado7WIFnQJayBLb5pxtPjR1mRttCj55Bc01My65c0jgTBHJwDAbJ3Vt0j4PitaucTsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKfA7usUl5wwZO4X22-P2Cjfffsx-JpmUxjRCsJLXNeQ&oe=6AE49AE3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__ycJMtITiEQ7kNvwHpslve&_nc_oc=AdpgX2Wc32ggJDWpAWAsqGHGeG2bRUehzYGHAXvM93gXGUH_NbLT3iLg0yjoLdVsRfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq_L45ICqLVKuwOU0aKBoZKoKTefFdOlnNsELFCzc7MQ&oe=6AE4B150"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJmJkX-w3V0Q7kNvwE3-4Vc&_nc_oc=AdqrgZbrDadPFpRcGqZuA6eFGNtwPQ_XQTNPhOouRPiPhuJ-PyG-csZr-eyCfVSbBa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJF7R22TgPvGj8mWlBSGvuqlzCx-sXg-oIAnPo5Og5Nw&oe=6AE494D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NULjFx4NSM0Q7kNvwE2mjgZ&_nc_oc=AdrSf3gq_-8wpGDFi2u5Ky8EPu2UTkGcwKdLY_9CeZs9hpfEm7UnFpz9uoPqQoY9KYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfTVr0zZE_krvukavv0BpQIK4CPksUaScnwVuLbd6pbQ&oe=6AE48981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1ZFxEjAcK0Q7kNvwGJ9P-n&_nc_oc=AdqAqBD5jaNHSnr6fqakN9I4LaBIY9CgwYeC8u43hPCcrVHCaWnWyZTjawl3XuyZoQE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnSbBW5fZoTsNykB15hXqiygEuNHywSQhdu4vE0Dgntw&oe=6AE491FC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
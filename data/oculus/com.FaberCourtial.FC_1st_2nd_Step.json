cb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhLpj7Vb5HMQ7kNvwG-8sr-&_nc_oc=AdqZdPWWFHj7Db2Da--10uLdGd-5gVmwaVQQfCKrYZUq2Ni2eCwPLFVWJcwpXFH0DVc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q4AUWZzvu1aCQWVk9mt2OtDAoetpQYLpdZtMEVoJEaQ&oe=6A3D41F0"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCvYf4Ohp2kQ7kNvwE0pAym&_nc_oc=AdrDRxLEDeOqCaOAFWoVZ9_YDn_yIY8NSdeTVFGKyhR6OqytIt5kJ8isEvXnFdJDR9Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83swX1G6Ka8sQ4TvgZ10He3ESqjAUhjLrBEbDTxN-r7A&oe=6A3D515A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wF57VJcI_rUQ7kNvwHaU1AI&_nc_oc=AdqoHSrlsGOD1n3UVrQQiS7sV4Gj6jwhEcCUonKb4BCGpXmp2gRl5m2obaQRJz63Lgk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95WHpdJWeuVkrSJfZ_abWn5Vt_1ZMlL5XcjJyKkidroA&oe=6A3D2A0D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79gWsa2HNfkQ7kNvwFhY0vW&_nc_oc=AdoeGgoCENn4cRRoevWmiGUhOGp5WTVODH-vnbGWL9uFxQjsPD7cvs1ZVjp50wc-Dnc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80yLI8C_m_OIOs-WncuJZ7MUjPh2sf2TdhBM_UlnZTIg&oe=6A3D5B6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL3z82w3IPkQ7kNvwFyvpN4&_nc_oc=AdooxVbFBm67iRPLyUMeDugtFR9vRyVxU2Q-TGQ_PqNC_S2vlLOaN5ZYIrwzsjNHdFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dYOixcCL8Ha6lbrPVhAs29fh4ZU4-KCG0UGeYsOt8fQ&oe=6A3D2AB0"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
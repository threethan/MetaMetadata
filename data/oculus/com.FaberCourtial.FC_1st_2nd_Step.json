ior_01_2560x1440.png", "id": "2637953463188764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036698_2637953466522097_1190158610162116126_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_iZKCUR2EIQ7kNvwGjMOQw&_nc_oc=Ado24g6gK3jB8Gy1MC1k6YJFcD-T6437eqo_thD9UJOqRmp2uRITt9nOdckHNUCnP9Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Ssri42Ip6T8HrzAp7nJgUhB7zWbPCeARg5jM0DsQwQ&oe=6AA2AFE3"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "876849269504437", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974676_876849272837770_6858699724405912159_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkF50rAroiwQ7kNvwHxXoz8&_nc_oc=AdqGV5UCZAAh-zbld2vLanrHVvfw_u3YihG2zA2wdfzM9gKTJV7b8F-tvLBwDZZnRLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf99IZzyICIeDOXI0bzZ033CCq97rQwgdKcR_6gdVa1g&oe=6AA2C650"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "624167718213756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75639797_624167721547089_4224131242915003402_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LauMK-3lcpcQ7kNvwFO4Ndw&_nc_oc=AdrtMZ0_9DMgCuFPWjKW0YjPNf9dZoxG-HPugDW-yYGFA51MvQYR5rPu4auHKspLKl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtpfXvl0LY-cr27tCAv5YZxweHYZP4oOP3MdWKFFugww&oe=6AA2A9D0"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "300268201336028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_300268208002694_7298819983547960928_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZtlyr7VWQgQ7kNvwGdZ6Po&_nc_oc=AdqWgazk694nT7BPyeE_6ucf5DXZ9GCLuc4YtjlwkRB2VOVWQ4JlR_LWPnvNfzr6jck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb8QbvtNxkkysetb646roPjqfC39lAY9uljQHT_oxiNA&oe=6AA29E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "700298200614212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001685_700298210614211_8491394750732500714_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX2ErRQsYb4Q7kNvwGLkiXj&_nc_oc=AdrYC25BYwyzqtGRw-0khJ3et4FKje4zx34HXPDXOY0qitpxBYc_d3LeTaCAIXg_m2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjuHrprcCEdqoXP0JffVhH3GIiM1h2NoffAFKYoWMbxQ&oe=6AA2A6FC"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": ["Space", "Moon", "Mars", "Apollo", "Astronaut"], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": "Faber Courtial", "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category
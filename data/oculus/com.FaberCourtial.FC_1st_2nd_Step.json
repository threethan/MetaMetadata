lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjCHoX4cm5wQ7kNvwEZ6kCy&_nc_oc=Adq5dCnK5etXsQgtSP_dVnR76_u63AL28cC_CoNbmJYRiSLY4BWR-sI9zUt8c4vlCKk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGie1PoHsE0AdykP8HRk4PiF5oTT77yTSsQMgU0sANkA&oe=6AE76CEE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3eI6MhuyekQ7kNvwGONwjw&_nc_oc=AdoA96Hee9I2UbrcsXcLRmqtwa6Ir_2aWKHqgBleivpaH3LphgqC7AW7_IQX5wh_zQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA6HDOqpl5AgUG3QEiLmBCSq_GAsdLCn_GfQ9ILAeF5A&oe=6AE73B8D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP3iaOc00wQQ7kNvwHvjJ_V&_nc_oc=AdqdwEkM3k2HLon4WvqWBVnO8t_KGZS-ZW1tU7FA39qM4ifffek5oAYhdQMteur7D6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDPBEoUFaRkHiAiU9SEnLM4arvnVfl1Z98vQHvWKGaIQ&oe=6AE75370"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOVgwjc4QvYQ7kNvwFcFD4C&_nc_oc=Adpzx3EczTbOpqWCoBBVQGEuV0W02c5elGJZ2jLl4u8LdVqZl0rXR9iDM_nqghgOTN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRObln19izR0sEe5zIuRcYQLrtLYD_kcpuPZUlFHP_PaA&oe=6AE762DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RL2Nnio6P4Q7kNvwFc3IPL&_nc_oc=AdoiUvQb8NyQGWPRDcGa1KWfdJuou_QtSB7_0ZJM7iFIZoQyIFzdrbof3w-rUbspGCY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSW8qRFqjPQb44b4I6kr4oyYZnBGE6stkDFEXZCUjHmUA&oe=6AE73C30"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBwB2ZdilaoQ7kNvwGxHcU3&_nc_oc=AdpfU2dmVE20KSfRmCbuOHrd-03ANMQRizYnAq_jij1TVcEZR-wHYuy_6qI_ookaH1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37qAhUV4JcaxHpvpztmyapWr1jAMoMqLA2deThm3qu7w&oe=69ECD670"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HTiPHGpNZkQ7kNvwHKv8RI&_nc_oc=AdpWjgXRl2gCdU15JeVIye9muXFJaPlYB8gV_ugH7jFHC6XkkN-VWJY_MG7efVBWi7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tuDjxI3xGNO1RiKv5NdA6BvzDgOr4mw13bkZTub4cMg&oe=69ECAD9A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqfkR9Mo7i0Q7kNvwGTx-XJ&_nc_oc=AdrR7riTpKFbGPWi46uSlswqzdPc4grvM8bAx1j-fXVLRWaFsm2dM4W0aUWtkE9SMbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-7OnX2giJo4uP6VRihFwTyiA9F_o8pWYGkhyJRefbXg&oe=69ECBE8D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN6VH7Uj2qYQ7kNvwHJf_Hd&_nc_oc=AdqZ3VpAXCAc8Rz-M3siomGV99tl4sQkRQ2tBJROZYyj-UnrwvluTY3kMJxhGC_XD2c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NxspycdQr5Kqmf0fJSmAB4uTJ6EISIYa4X9goETl1Kw&oe=69ECB7AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJTM2Mlkwh0Q7kNvwF0MXQ9&_nc_oc=Adpn899Ymd315sjre8Y78zSHrRGLYENdu6UjXaIh579EYC_IAqeiuepeN6eTz1DoES8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af185Ce-zMk29pRNPqNSjTUIkQbcwLJTWzk4B7mVJhjOrw&oe=69ECBF30"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
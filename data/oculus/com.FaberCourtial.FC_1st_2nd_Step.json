lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mbSz8waafAQ7kNvwHKaIiP&_nc_oc=Adq5dhTsYb1qvNCICKLfse8gWbAW3FDbNZUJonw-mVmDp9fW8CUSChky4kcMwX3-Pcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd-nlsM3ZoMF-aK92-FTbXz2O9ZKfvsrN7TE6_2Ne-SQ&oe=6ACA6BEE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCU-dVnYNlAQ7kNvwHpokfl&_nc_oc=AdrCqhT1y_0W6_IrGzrF8p3BCVS1QmnUBVy1WwDk_GXoLDH9duGFWRu2bzfh-JQd5mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMWxQ8GLDzknmzElzlnpnvmVnK1iWvZj-tdfW1WXPDUQ&oe=6ACA72CD"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y7UUIESZ77cQ7kNvwFZQ1qB&_nc_oc=AdpVZ_rUXLEW0RDaP8idvFpq-JWl02KEJC-X3RoHL3bWGSDt0e2BGVymoW-wXtFAOnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL47C7Fl6PEHX3sQMiR2ztv1wF5ryp_oIfTCw9A8Gw4Q&oe=6ACA5270"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSg6kdmrhYkQ7kNvwG7jCwf&_nc_oc=Adp_OgbluCCiQerh3dHFQ0SiYW3WoBWc_XdRNp1gXQfnZ7KkicVLcT9frgjPxkKTTQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgmpq0BaAo8MLe8WuhYChgvHf-wrnEK_zLyvBfktUwuA&oe=6ACA61DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esdiHYE1670Q7kNvwGqz4RN&_nc_oc=AdoZVgq6ZnmlD3u_8BA-nQcMQ2IPA5gsIGUL5xzojL-v7n2fGCqRIrms_uEr7mwJuPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEAymzNMU3trbVaNbGCJbwz_HyK4_uiVfDbwT6xi_xhg&oe=6ACA7370"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpfQQs36u_cQ7kNvwES6nvV&_nc_oc=AdqW-wJEyhYoKYcmnpyR-HkNvJyZA0u-SHZ8wlWGF27K-_UEgoqQ9baWyMMAww4NkB4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qx9V4wzQB8ezs2iEpXbmvIEdQkEkCk0Ork4AFAO4m4g&oe=69E24A70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bR8zpNZBJ8Q7kNvwHsD9Oh&_nc_oc=AdpFpSrpiCoOIVlg9WW37nElMQ8UIp1LDOoEFaTfMg2DLDIUKKkVCTQPKhRusXK7zYY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39K_5wiMmBdD3Yd5wVYFAT1jHARhmV4jAtuB_ZUz9Rpw&oe=69E2219A"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUO3IDR0z2EQ7kNvwHW0WKf&_nc_oc=AdoYOXKy_m3U3hV4o5dry3GdkBApOp4quWpqZXK_ph-FZZGiXcAnh6_QvMemoa5yogI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_ytmn2Ygib3tpbzbocJ4n3Rwe_x5GkjRP7jq7SBG7vQ&oe=69E2328D"}, {"file_name": "FaberCourtial_Apollo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AmCPToLG8IQ7kNvwGyRk99&_nc_oc=AdrSqc7XxXTrxrNakJ7RfBQubNg0eAYj1VT5-6N7LMKE7syB4Xw16GFtLttcnZRQ5DI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qVQkJajXVd4T_WoK51X_0A3LO7yztL3KAqtAObGoL3w&oe=69E22BAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FquVEkHkCJkQ7kNvwH_G8nk&_nc_oc=AdpgFaOAvfPQWPQ3FAX1z3SPlu_fHS5la9jUaSolKwWusstjTN2bCCqfjJm32JsHTqA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_oxvKx8PMHCGUrQs57Tr06vULx8Lnpq7myEa0QorNQQ&oe=69E23330"}, "display_name": "Into Space - 1st & 2nd Step", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013  Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/fabercourtial/impressum/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
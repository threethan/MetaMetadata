lo_Promo_CM_Interior_01_2560x1440.png", "id": "263417515385731", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_263417518719064_2486399022759755721_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4IFM8TnlwUQ7kNvwHhFtKX&_nc_oc=Adq7ZZSPjdNOXFFFdLPqdFuv9YdYXmyM1jlvqEGymMdxCiiO5QHrvuKIgamBWL5naFI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5avZApOmqui1XwyZgNPue1SsgIc2DlCGdHtILzG6PrYA&oe=6A0C5BAE"}, {"file_name": "08_3210_Mars_VallesMarineris_Schlucht_FishEye_2560x1440.png", "id": "441882586923766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974450_441882590257099_8343030732761085234_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37IwNbTPzosQ7kNvwEjxY6O&_nc_oc=Adpj9MKO3AhP4FeHE_nkW2UzNaKB_YmlGm91Iqj_LEkRj0Td2YXKlN7wzYrbozbbMr0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pn1eaMeh06ry93_CKn_KT0QrykOblTsrpgETse-QsOw&oe=6A0C628D"}, {"file_name": "04_2110_Mond_LandefaehreInnen_FishEye_2560x1440.png", "id": "503085057348446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003281_503085060681779_2934098704824180242_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meM0iSSNhTcQ7kNvwEAG1HT&_nc_oc=AdoO14-Teaoo0BD1dCwqYFepzsNqsalP3z15skbdaaa_iGoynu37pFsIgTlL_nZBTFc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AvC3ki-o1edD3jE85X7qftCtX0CF5I8hd5qyaLcBIFw&oe=6A0C7A70"}, {"file_name": "FaberCourtial_1stStep_Promo_A17_ShortyCrater_01_2560x1440.png", "id": "463566714855749", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974827_463566718189082_7623050580809691308_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxeG944_LIsQ7kNvwFHBq_1&_nc_oc=AdpluTkIFuh1wKSUQF3qOpSRBmsEAYTtGEEg4IRU6QE35tCqi53IByw5SPKmnbPNW9o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m82JnRqCWsIHH80gGMPCpXLC0EVs6AEUJ20FnxJWw8Q&oe=6A0C89DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1st2ndStep_Landscape.png", "id": "271328411176636", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984476_271328414509969_2710087866171132859_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACg1_0twoXUQ7kNvwGnyy0M&_nc_oc=Adrzk5kZStgikxjYVLiYZV17Krc1e_R3O-yZ4j87Z8ZzXZ5BGgqAkeQbF7Q8c_cUz1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OwQKCZETT7C70seoZo1Tpn8-CR7zCFilAGziiwPCfEQ&oe=6A0C6330"}, "display_name": "Into Space", "keywords": [], "long_description": "In 2 intriguing Virtual Reality films, viewers set off for fascinating VR expeditions into space. They explore unknown worlds by visiting settings of extraordinary richness of detail and authenticity - perfectly reconstructed in 3D on basis of  original data from NASA and ESA \u2013 that convey a realistic sensation of how it must feel to actually be out in the open cosmos. \n\n1st Step tells the magical story of the Apollo missions - from the rocket launch up to their return on earth. For the first time, viewers experience this thrilling adventure in a completely new way in VR as they get the chance to perceive the extreme dimensions of the missions in an unprecedented spatial quality through the eyes of the astronauts, e.g. the unbelievable narrowness of the command capsule, but also the surprising topography of the lunar landscape. \n\nWith \u201c2nd Step\", they take a step further by joining space pilots on a future mission to prospective destinations on the Moon and Mars.", "short_description": "From the Apollo Missions to the future of aerospace \u2013 Two thrilling VR journeys to the Moon and beyond, following in the tracks of the Apollo missions and future expeditions deeper into space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faber-courtial.de/privacy-policy-app/", "developer_terms_of_service_url": null, "publisher_name": "Faber Courtial", "support_website_url": null, "website_url": "https://faber-courtial.de/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags":
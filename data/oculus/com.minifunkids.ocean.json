0x1440.png", "id": "2365184070687168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604347072_2365184074020501_4083181890861281961_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swofBo6bQokQ7kNvwGY82gg&_nc_oc=AdrsxJEtW7UE3S_EM9UahDsxYC1RfY7qBJZPF7eT_wrkuxzQYorVqOKoFHTzp9K9D_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmuK-5iyzJ9fDI3IqYDW851q3KtAiUfG8zxMxLcUpTwA&oe=6AF89565"}, {"file_name": "03_Blue_Fish_Direction_2560x1440.png", "id": "1362253689022516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_1362253692355849_4058830935966079977_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHOHS47gkb8Q7kNvwEKXK6V&_nc_oc=AdqZrAbI_LA6Mymx0_bHCrJ6XGwqTnaRywISMqH4sOnItb4MDKL4-jzgCBk4gDjx18Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCa-2_ddFQDUY0ZmcoTtXVkqYXGY3JkTBOl-SLZ3Abwg&oe=6AF8AA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_2560x1440.png", "id": "1081384011453377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1081384014786710_2227318126994700039_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwWquTaiDmgQ7kNvwGxNmiM&_nc_oc=AdqAaEU5cLhn-8HPdo1eIR8XZrcDzdz1XwuKHVLgcedFavXKs8M6NkXzKIp3OGgrnIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8BP7c6x4MUA4f8ccxBc49AC9Mw433rwV-a7bELullwA&oe=6AF87753"}, "display_name": "Minifunkids Immersive Ocean", "keywords": ["neurodiversity", "autism", "sensory", "education", "ADHD"], "long_description": "Explore a calm underwater world created for learning through gentle, low-pressure play.\nMinifunkids Immersive Ocean includes four ocean-themed VR activities that encourage attention, visual matching, direction recognition and object classification. Clear instructions, simple interactions and a peaceful visual environment make the experience easy to understand and comfortable to explore.\nThe app is designed for mixed-age audiences aged 10 and over and was created with neurodivergent learners and users with special educational needs in mind. It can be enjoyed at home or used as a supportive educational resource by families, educators and professionals.\nKey features:\nFour guided VR activities\nCalm underwater environment\nSimple and intuitive interactions\nNo chat or advertising\nNo in-app purchases\nNo external account required\nMinifunkids Immersive Ocean is an educational VR experience. It is not a medical device and does not provide diagnosis, medical treatment or therapy.\nMinifunkids Immersive Ocean is not directed to children under 10 years of age.", "short_description": "A calm, ocean-themed VR learning experience with four simple activities designed for mixed-age audiences. Minifunkids Immersive Ocean supports attention, visual matching, direction recognition and object classification through gentle, low-pressure play. Designed with neurodivergent learners and special educational needs in mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minifunkids.com/immersive-ocean-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MINIFUNKIDS", "support_website_url": null, "website_url": "https://minifunkids.com/immersive-ocean/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1329391830259673"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISH
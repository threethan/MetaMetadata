, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PraAKZ_7vwEQ7kNvwEqnz0w&_nc_oc=AdohzHc7Nb-DP9rvinw-qUzl47RqP4QgxT3WG8euSoHYZiyfJeR72moolUyb9wAfhkU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAOoX2vUfT0eJyYxgvcqqIQwImnhxateHwupyeDIiZxw&oe=6AB91588"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFuOkejVGTEQ7kNvwGjAgdh&_nc_oc=Ado36dIigbu6GWqybnGn9PYo4wkQsG_YVZAGQmtaaJLNXLkUVYvgKKx56LrLt_kxWiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpo7p1i3DfQ1pz1eGD3ypOJEy0CLYJJcSiXainMDvpPA&oe=6AB93763"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKkYrqeyo3kQ7kNvwGQuaBx&_nc_oc=AdpVOtXQKwGqjraKh2cElIphQYksbo5WEN647kE2JH_ua4XqqJI4qqG9XEuBvfybnyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZvRp2Y2nMSx7B-Ye5i0EFR3krd7MAFj_5nowwOKtgQw&oe=6AB93AED"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DoDH-q_AusQ7kNvwF2eHI9&_nc_oc=AdqF9zR6aSj4Dz45qO2voyQetHmNdtmM7sv9Nqo49IvHyGqr3qDgdPpcxRuQp3O4NsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIbJm7a4aaC0n_2TDi-gBxHk1nNzXx9JznK4xlF-7pvA&oe=6AB93F27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIafHrT3UbQQ7kNvwHr4J_m&_nc_oc=AdqaOYBLtSUul0h9Zesg0JGKcwCaZoknVrxvwKkgxOToMOCU5lVVHlnXhhXVifv1qio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWuuzn726ALjgWyVheWJAkReZyvtYIrk6248YJaNebdQ&oe=6AB913D9"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEGasmpggAAQ7kNvwHk1vT7&_nc_oc=AdrRIpHC8wRnSVwmMREc1Rrmksklz1fxcrIMiM-uPSCmauE66nu9dflt39r6z2wSArM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zK-GsxydHaSSUseBabHZJFunrWJ7tUmSYfhxvujEB6g&oe=69EF6008"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MI_XA1hbXwQ7kNvwH27dpj&_nc_oc=AdosqIoiGZLAgAEhEzUk5H2mWG8761qLTYngCsaJe97Sal7ODQhIq36p-pfunbA983Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_VjJ6V4MMnoXdUNlZKCDZr6OkqpuUiKXtxVJCC5hcAA&oe=69EF49A3"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIPj96UVGLkQ7kNvwGYaskJ&_nc_oc=Ado1iH3VESR5yEKNSAyzeBKwL94IEObrrS7WfXfh_vXFkOhVEzrANuFcDnmaMX2o4kA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-aJjrLYCGbldq3RVgtzK9ncy9Ks6MQy53Ine0Dl_NFg&oe=69EF4D2D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_6abXPoUwgQ7kNvwER5UjU&_nc_oc=AdrHVVzm2SFSWUjdPuNP2zqIOrDSVL30YRboraBBpKuwmlmDkQXRjmcw9SfLHQdR6fo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sqo7iT_d5CFyvAc6cuco9CO9cyhVUyCpbE865Iz3GnA&oe=69EF5167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo4RiQVDwO8Q7kNvwEsJuo9&_nc_oc=AdrZnHwNb0pAMwctwGbSgtNdAIFhgowLshi-SQrn2SrLFkNjj4NLL2V0tdkxcb8QBrQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Iny0hrxpfBAaGlAKfH4FPnvVmmRbKDRCMJPQtdzc9LA&oe=69EF5E59"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
R6QXkHRCVxzl7OstO4AhKVSk_g9GRFfhfk6DsO_dLLBw&oe=6AF882ED"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79rGcKPvSNgQ7kNvwFLT1AH&_nc_oc=Adp8iu79xtxBo692eoKnHzC6B7ryWydGHx8v7fv2-U53nwEjnU4JPrtRDjOouMyTbWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpH6_xoj9CeAqxUpOyCBssQg7l1hQaCB3EV23QjhlAKg&oe=6AF88727"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PibgrxhL9ewQ7kNvwG3IH5w&_nc_oc=Adp8SZ6Fmp0x6dtHVBwM5JhgxHOPwKfHcM7yE4HD-o8OyiainsE1mQvZag7l1wP3UGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJW4aLpi90tVuFFYpKJ3c4goSxKaC7srWGCmPUp_HDeA&oe=6AF89419"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer
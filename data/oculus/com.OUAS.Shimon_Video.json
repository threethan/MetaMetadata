, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BTiA9F2Fd4Q7kNvwFutnJm&_nc_oc=AdqUHFNQsomHIRMHAtJcds4mmknM20_sg9M5PQlpl0Nm99uRzxGLrc01GYHkb0PZBB8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F3r-ozxE3BLvMN-RlR89DCUHQoFVToHeqGaA8zv81Lw&oe=69FDE088"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4zL54WOEc8Q7kNvwFS3nKk&_nc_oc=AdoWoEk7SwE1hb7CBdw4lFWvSJV3PH9hTBHo5gK4t5aq2nSm3VrtZagLM4vyFnGoHe4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ltBuPmU2znaZ8QHkLD36Qn_X5NU8iut8-TGICwTbKTg&oe=69FE0263"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpBtTHIMzS8Q7kNvwF_n9ow&_nc_oc=AdoxgQoBwv--Y4gadkDbCO64c6g7iUzDtYj0y7bE_d2Yi5iTtU8S4-lUHps5jRHcHpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bi40RZSY7rcolEwxMPYEbCNnadzMYUH9K4zyQoCXaIA&oe=69FDCDAD"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Z8s-Y0rAYcQ7kNvwEJeuGp&_nc_oc=AdpUJ3Axp22H1wAS0ArhZb86DMWRB-EBsFvxAdEcv5JPRGvvV5IbEmUrmnoHOXNuwgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fw_vIxY-U26EGSkPjYcsHB70DVD_f8myo5WR1XmvEvQ&oe=69FDD1E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1ANJ0kgFaIQ7kNvwEnBubV&_nc_oc=AdozbgFHQYqkD_Er1n8uvRVkxqtwxiFdYApznbeTjsWLsQSzLZiYDK3JHJOXk3VCXj8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CGtu8aerwUtKpbJN2M7d5-6n4Ypp8CaLZu4CaLEkJHw&oe=69FDDED9"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
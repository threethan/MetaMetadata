k9Xai9jn0Q7kNvwFyBAec&_nc_oc=Adm72_XVFwDMddDbndhFt8VWR7dFn6U1ROKSN71fhek1axpP47MfuGEm1UVh38T2OYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsrDOSToXSjFiygU8BYIdK_APnFS64joMkRgnCsMgzJpA&oe=69A03767"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmLEvkfXGfEQ7kNvwFay8lh&_nc_oc=Admi1zHpKR36JLZ-8mt2vDoASBm_OSOwqVRGGhilyrOvPYClCXqWDxJ4mGA2PO5_zQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsgpw9DC1vUT-QZ7ekRzNSwstI2_lFeEF7tUnFVR9zahA&oe=69A04459"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/wel
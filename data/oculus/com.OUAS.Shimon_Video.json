7S5W2CQrLUgWkwpWpWY5tl3qjE5Aptgl02S0C8JWLz-Q&oe=6A19B56D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGkBtGd1aLMQ7kNvwGbkM7r&_nc_oc=Adr6kqr-mbjQlRMFyq4dZ9ZAXNdrhxySr-faH-5cYkGVm3sZrwwzFy95RGzD72hAL50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EmHerLRx44pKU-VLE9UR1wCVWuo2YMJNq-JSsLkGQ8A&oe=6A19B9A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOXMAZOZnfUQ7kNvwEE0qKu&_nc_oc=AdrUq7M-w2-_5xLEymOV9dMymWYR0hcZ-ySeZwUqvTj_-oqFGXv0EoFZcp_aeemG5gU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PP9gs_i6qLpx6bVbestGL6r86TWbXbn8q5R8sDDzL9w&oe=6A198E59"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476233047407103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974613_1618094888527989_1872741332558645297_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zp83iosF2TQQ7kNvwGEviSl&_nc_oc=AdosLnvQPVPn9kmtswXaK1L6fsSOkFS3SdxNSJi67WvjSPTxA7TMijnUINhDZR2IHGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gD_zsNw9N-nULflCjWPrCsjUQla7ngXJWz8gieDFfeA&oe=6A198CC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1644619705, "lastRevision": {"nodes": [{"id": "666396301029837", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applic
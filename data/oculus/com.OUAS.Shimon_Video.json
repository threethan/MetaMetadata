7E8OzvByOMbLl0ve7Jwloan53AKfzhwCG234fK618EWw&oe=6A17126D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIK3rEzd3rUQ7kNvwGGt7Du&_nc_oc=Adohy21lHQ4bRRLSXfMJdfOB2E6RebQifvugujIPLL9oL6L0U2URaqfHhn25DpwjNzE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71phOyghcewLKmoLY86xBjfwJgafZTCAZ_S_yRhyXMzA&oe=6A16DE67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcSlNGlS6zIQ7kNvwGGae6i&_nc_oc=AdqDIBpb9gSkdXVy5SyiYBC1c-vHoPa-MgFJx4sht2Yx94moDzXsxsn-9Ygsek7j0-E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FAlOWWr0-uJezDJh8akCN2NtXIA4yKo0FBx7V3hglsA&oe=6A16EB59"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer
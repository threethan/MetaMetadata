, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfYOjCoQS8gQ7kNvwG5wpal&_nc_oc=Adp8dCsQpM24mmuDnl7m6whGByXhOWBk5OFRGvwoxgvqI8yss3DP0bZdDshzIDcGFjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwrhMaXNAMWZofAFcYRCTyYSAu1JeadlRFFoI9VZRA_g&oe=6A75D908"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aJE_paLhOsQ7kNvwFGaf2w&_nc_oc=AdodOVGKBaPZ8MetgiWApRqNqQx6BzzSHIAwd3xusSzzydC9XiXTyGFSO6j2z5iid-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPGcsvJ-Ea-5v2Wt4TjRpZ8vzzTYY93Aw7IvlpBeB9bA&oe=6A75C2A3"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JjVHkqMIkJQQ7kNvwG0Qc2t&_nc_oc=AdoyLJ0BKeKvXv77VsS4-QfJS_pXJxrXS8QLjsIwnsdIad3Ytr4q8dgUl3HIJDqA-ak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz_3k9JZaVjZ5DucRMlBr4u8SOy8wGWa5TbsLfVL6WZg&oe=6A75C62D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yGHUroTJb8Q7kNvwGV2Y2s&_nc_oc=Adp0PH_1LLAi03o1LN3ntbSogF4ovo2_Z1xTXNWYlTr40c9_p-FJLIMYQgmKz1KzI3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqYdHHha_cPGhjTRl8oEbhvFazbkb6Mn8kfstN_7F_8g&oe=6A75CA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edp69Rr5NLcQ7kNvwH6bn6y&_nc_oc=AdouGFm2H6KQRU9Mn6NVKXtF8YqgVvEC3Ft44FslbelZs2QbXLPBXhD-sYFFwzI2Df0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH58me6Isqb0b3G0kmYS1FzZGUWQL3Y-6-hODEibjmMwQ&oe=6A75D759"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
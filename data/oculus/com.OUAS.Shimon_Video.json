xqyKzcz9ZKNDESPDZgvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvH1w-E-LWbBVEZA1K4QuTEp8dfO6BvZtPTxg3TfY9yIQ&oe=699C5188"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLigvEMxj4gQ7kNvwEBGg-j&_nc_oc=Adk-sXmiiliNYkg0nQ34MOokIewZMBorDO1PJSRQPzrKxvq597XLLi9qMNUHWspFoo0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXgxbggYcsISH60r5w4vUko8I2QL2JtAHmuPoNAVyV3A&oe=699C3B23"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jY6xxtXReXQQ7kNvwGQ7_u0&_nc_oc=AdnP1Ve69bTFVxu5S8ConYxF0sjOEtC9X4W-BVRR6EaiEA1CePD2gVSePFp-bB0UCk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujCFVjngP_AX5CtgJHZN7gtb7RyELRNff-rMwJCHTxsw&oe=699C3EAD"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phNdVJyzhwMQ7kNvwGpd8hG&_nc_oc=AdnP9VykR1-X0jo3eGKD-eMbJwwKdOL4RbWg8N86ia0YCUMWnK2F39QwHyzrXuMJScw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftLUGLQmy2JfMfVHelTWSOefwxZEpUs4QknGQcej7TPWA&oe=699C42E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=541sGZFXGf8Q7kNvwGC25nK&_nc_oc=AdmCOSij-gMFuwz2P_t6O_ONajlh87d2X2nF3htkyHVu3u0UCmxfTeXbxxZr64CiOR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfveXzdaW20jYovko_Zl-cfPVH3des51mbB6f8-AjlIwwg&oe=699C4FD9"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476233047407103"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "
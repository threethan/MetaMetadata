, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRoxNi_69HEQ7kNvwFM1vzu&_nc_oc=AdrMnXyvcQyEKgoLkTK3r53266l_c9u5_1Y4DHWLyh2By1ZKi3j1sZfh3u9MMCl5sow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaEYSXv2dCA8l6PH7Mre8bsKIo8hJ5RJ3qXYzaFGMJ6g&oe=6A985848"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BUv2279VOUQ7kNvwFaulyh&_nc_oc=AdrjlW2XY6_8qRvAVEHzg_j1HdPke4C63RKOv8uZ40vHpMerBuMbbuq9S2p7JeA_Bqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpgbrI6ajvmSiD41UmeeAb-5yqGbGXlTojsu-PSn9uSA&oe=6A9841E3"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7p5CsswWFUQ7kNvwFOJXuB&_nc_oc=AdrDpG9DmlkUXBzIlHp7QKrQ2qCAdGmfKTOonbLiDdwTX9y9murdfm1XePXU3KUtlaY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzS4MpxojEUO7Y52dla4pJNxOP4wvByFXIg21JxAXWkg&oe=6A98456D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwDrYVghmzsQ7kNvwFuGVvz&_nc_oc=AdrwZeb2p7ekyc69PZ8KdOrc_F9wIAsZgpqcxx6r3CmCC84YQTvBUCct7v8Rou7xG-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVYtYEwYMj-PDNXnzDtOZf6xxp2uOc-xu6cL6uhJymwg&oe=6A9849A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsp-bNsLO5oQ7kNvwEJ-ISg&_nc_oc=AdohLHvw6w3dkhrg4MhWMbtFBVSjnh22173d_Mu5uwuKC8U6wCFTIz-1gjDp6bsT5s0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw8W4Xwo9VKT-iGGSKMXzYgabXqE02pjvLObLPb6hD3g&oe=6A985699"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
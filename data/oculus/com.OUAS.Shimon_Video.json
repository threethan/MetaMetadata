75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWNr8UfyAy0Q7kNvwGBoA-j&_nc_oc=AdorWjBoLAMCtsS7ey-u0UjTuMz-dFy0zqQHlTj_dfOABsGcUP8vuS6VuwxLI5EXvEY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0ezXiy7sKN-Mdo-p8D8tWslg4Bm_vwOK34hw_WWYFvg&oe=6AFB25ED"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMwwrrFn4cMQ7kNvwHJDZmc&_nc_oc=AdoKo3TnsdlHF4d7kT8o-LpV0jruIaIE-8xzJQBQDlj2bfw71VrjKLJXT1VRLaYEjew&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ3NQd2bqpJKjjIJw5Dq8Eswk1_lq-MlZVXvUhARNDyA&oe=6AFB2A27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PibgrxhL9ewQ7kNvwEDcwbB&_nc_oc=AdqDpIMZ1Wcv_8bM5Io18HnoRaaSehlR7v9srkHSH_oLxybl_8EmXt1jERXicZ7ktQU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE1f3WZEOgVbytMTZjLZXif7-OkKPoM0lWqj19o8-2hA&oe=6AFB3719"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476233047407103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974613_1618094888527989_1872741332558645297_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny6OiEj-3-oQ7kNvwE_9BDG&_nc_oc=AdqWN_QJfGwmwY2dOGJvWeMQichgqz4owhDhOyU-fT6ucEGQCMniC9mtLeipqE79t6k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbkf9ui86sMqM3H6j-UC9LhCoTsPMJe-vs0hx_nNGTFQ&oe=6AFB3583"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Once Upon a Sea - Shimon Shukron - The Last
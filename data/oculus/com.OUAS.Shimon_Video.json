, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eua0Ue0yqDEQ7kNvwEHGbXt&_nc_oc=AdosY_GR7NSV8gJ_Lzwmgd8ohXThL53wLMcG2kgvwtim2g8J2NPlFfdUQ6kGclDYzFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb6u0XKYMf-HkELPqkSMbtDW-74BzDn2hyW5dBdceLrA&oe=6A9C1488"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_StQJDS7LcQ7kNvwHt-zEQ&_nc_oc=AdpgfEnDHSuP1KYAbp3sVIB-nKzzN7F7Kaqs4j-YBBZ5vMU68fA0f-k6NkIuug4pmz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRtq-E0gNWJZgla6utWA3oUO16yy7M7ot6yQbSsd_iWw&oe=6A9C3663"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvSYmSRHubsQ7kNvwFiPwwA&_nc_oc=AdoxsvdVQe9GfAGelswP52BR_lfA9ORnlUBY8ZLv8268HiR-8Ih0lX_T8_D_8HzyL0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXierDTI7L28TgYs7pjPK9TJdQRGronGXkgoehzN0PrQ&oe=6A9C39ED"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwSoZ_Sde2QQ7kNvwE9mf-y&_nc_oc=AdoJwi4j6EvlQkWJ1kFcBKSioEzeVNVnQF30c0hZWYa9r0sfyz051K61Tme-uZryEFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdHl-cwpL1wxCpmq0D6PdQCgah7j-9y5QF_9_zFYoklw&oe=6A9C3E27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xon1e7gCsp8Q7kNvwEFUlnc&_nc_oc=AdqlGwtlPQHq-qOMF_vAJElCgSy6sN6rxa2NyypFwKvgI_ujzzG2CGeE8C4Mvs6nHB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJvUlJloU5ezIfxM1Nq7B9Tgws_oeAeo2SgWvR2bmhPg&oe=6A9C12D9"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
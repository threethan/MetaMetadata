, {"file_name": "Shot2.png", "id": "865405340801204", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210889_865405344134537_5544642708525408985_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psAhPvuhl-8Q7kNvwEok4Hr&_nc_oc=AdpJUcrZ17N-rRXEu_oL9SdfwS92ZlbgnPz1I9TEadUf5h-XZmmIPRM7L6p8lDx-XGk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHegXZe1Kqllohpuj4GPE6GT0Zef_RYZCxPoEoRpI051w&oe=6A8AF108"}, {"file_name": "Shot3.png", "id": "279469687559098", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031629_279469697559097_8584576383001980473_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRgYYEWb5G4Q7kNvwEMvPJo&_nc_oc=AdrB4ujTIWM8h0IiH200WbjYsDiej9mGsk29Cr050p6iVIUkTnrq_BnPEDJgF23b52M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6kUu9EbNx5Yu4ssAGkApQ-Le_PlIt5QEZgwpk37pHxA&oe=6A8ADAA3"}, {"file_name": "Shot4.png", "id": "273800928137307", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75207234_273800931470640_2603566706085727327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsSWbBu5jq8Q7kNvwFkRMAN&_nc_oc=AdpHMTXFH9itdObA0jJj67WnYIgLi44DXKBgYu3La6v7sgOGVfLcEfEqUF3Ue1D-RcI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd0Y4NKflZVGjsfuzZ35iF9XzbzolohjPs_NlHc32Fyw&oe=6A8ADE2D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD8tkeqSFyAQ7kNvwH0lR1G&_nc_oc=AdqrHJIlwUix4eL9X7opReZA-siIsWlgxOslEwk68afe60dwZIffq6Vj_CJ5VUgHAEw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPOsiZk2dz55gLpVlbhBGIIhY69yF3howX-lmFwI_9BQ&oe=6A8AE267"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOSWJgN8B94Q7kNvwFJVDzZ&_nc_oc=AdoANNw4aIMPRJ9n7ukFGGE0csS7N3xhmEYukfLeoc5wGrHZlqRcEP02sRhfWkCV0GI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHNFKFDtzymyvkLNXl01eIqpzGvDsMjVPYutDDjQOstA&oe=6A8AEF59"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
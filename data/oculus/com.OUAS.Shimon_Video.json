D6KyQAGVyBjbPiF3McyFUV3AV7iJZ29BYe9dPxX2pmaA&oe=6A5E0B2D"}, {"file_name": "Shot5.png", "id": "213141630982328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75439593_213141637648994_3188695562402402270_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TrAi6bpBUEQ7kNvwGlE8I7&_nc_oc=AdoQO6AMfVUab_CN0rAL0dZK_gckbuuZTLbVqExdD3GtQEN2X_1uCFB6kU5BiDP_QpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5x1otqyxgIIPgH0jvhWvBcU6rZPjmRDUKPns27Zk2ZQ&oe=6A5E0F67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "235496792032420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572957_235496795365753_4287613132046459954_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNE2g10TzmgQ7kNvwEtWc_W&_nc_oc=AdrpmIyItRWwgt-D-A_SXElRdXF8is1fwVmJUlCIGWQ3JtGPBwO4-nnctOxEmCb5omA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrJZOX7K8XJl0cFz3WRy6B34z1f4zE5nKPM8Ea1HhkBQ&oe=6A5E1C59"}, "display_name": "Once Upon a Sea - Shimon Shukron - The Last Man Standing", "keywords": [], "long_description": "For 50 years, Shimon Shukron worked as a beach ranger at Ein Gedi Beach and lived in a hut at the foot of the sea. Following the appearance of a huge sinkhole and the closure of the busy Route 90, the beach was also closed, and overnight Shimon's home became a ghost area. People stopped coming to the area and after the council finished dismantling the beach and parking lot from its amenities, Simon was left alone, refusing to leave his home and the orchard he had been cultivating all his life. Even at the cost of risking his life", "short_description": "So what happened . Humans Happened. Water politics paralyze the region while issues remain unresolved, the sea\u2019s water levels continue to disappear rapidly, 35 meters in 35 years. As this ecological disaster leaves in its wake a fragile landscape, it also dramatically reshapes people\u2019s lives."}]}, "developer_name": null, "developer
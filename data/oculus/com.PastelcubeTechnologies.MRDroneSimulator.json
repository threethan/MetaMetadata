f&oh=00_AQJV3RuX3ENfJUfi3TAEj9rB1_E8u1loTLLymLwyN-SU4A&oe=6AA3EDCB"}, {"file_name": "360-360.png", "id": "704294215463566", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499329560_704294218796899_2425956724793145237_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iieeL2BzDsIQ7kNvwG5pGTs&_nc_oc=Adqafu3p8vV5jkj2InFfIUnV8C3QsA6dY0LnWASME-XDGCaIx-vHjtOWc_LHBZw6yew&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhCWYCUZGOwoZssGcR289QBPzpoz6hd_FM7DlwNIZkgw&oe=6AA3F6D6"}, {"file_name": "1008-1440.png", "id": "672915438943483", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499318027_672915448943482_3698525716452413697_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g26rUdgKjkQ7kNvwGKUqr0&_nc_oc=Adr4wPsnxAHDUt0uvrVJHPj1heAy1juYM3Hkxa6jC7c9peNQUN2RQOsty3mqRPoKdTo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRbYfYHZL4M7BDVvaX9R8fYOfDZR2k_-EGwSz9xGWNXg&oe=6AA4144C"}]}, "id": "725611480066341", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1064825388868321", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499321676_1064825392201654_6371974496955604379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajEYopfNAuQQ7kNvwE8y9tc&_nc_oc=AdoHihKA40XvlzIwOoH8MPV6NN5jCqY2ac_q_9dwrkxt9agftxDimty5My32JRE56LM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnJaq_t3qqqKMgufIcMnnnLrov1wzlia80jwLJK3gaYg&oe=6AA4072F"}, {"file_name": "1.png", "id": "711830767969379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394216_711830771302712_918634532842897408_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0KtLs5O5XYQ7kNvwHR8k-c&_nc_oc=Adqendn9XR1L7L5q3vIc_8bb_wX6LBhdleGf8ubs7wu-YVTbpfDAD7LIQuxWUs-mvGA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI42CPyhnkSgq0eHVYF1uL0n0Bq5qZ0VX1W-iyIxW4CAA&oe=6AA3F623"}, {"file_name": "3.png", "id": "1339693023997811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfZpU-v7GMwQ7kNvwH6K7ax&_nc_oc=AdqNcBgwBxl23Up-HcHcyAgcMIWgJX_7IU-YGACRRr0pxHbO6Ed0Nx1qr7NxfcAVcU0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6GDD_rK-Xgg1HWFyr_UNAr1a1nni6Uc98SePDkz_Mug&oe=6AA423F3"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJS3zTp5bHMQ7kNvwEznFX6&_nc_oc=Adoq8CvGNgYxE4qNqARy7PhBEf4O72EQ-zncLL-l-Gra128iaV6x1t2gAmV6_oPus7c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOCMe25y4GCyAjlhenqYWcUPSyrI6JBNikksmss9ETTA&oe=6AA415AB"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrCTvoFjew4Q7kNvwGTr3s3&_nc_oc=AdqF6F2gxDuMLNsF_o7OK89uK3i5NEdVtOrKPcN1zPzU5mlhop2lcwHKsZ3Ii_G_lzY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmRQ9tcYNoqjC5RCKVKCnYBN7R2mM1yOHuxO01KQJesg&oe=6AA4240E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXVL1qY4F8cQ7kNvwHAZ4HR&_nc_oc=AdpT6iXihx7NMNV-CJO0AdGTAt1l_IpKi10WTakJ8dkb0jRHhr7WAsHsToXHVfBadfA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqS6tuGXUiquK_Tgss7gHA1thjVyK95-edrY4JYGaZ5g&oe=6AA3EDCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MR Drone Simulator", "platform": "ANDROID_6DOF", "context_category
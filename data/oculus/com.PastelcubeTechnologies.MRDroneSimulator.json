-Ja6G2XoJ06IgCPV1NVCY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShK6-Fai3X0ga_dTWPAr--Iz0AVqJ_2okeIJ4_h1tkUg&oe=6B0DA663"}, {"file_name": "3.png", "id": "1339693023997811", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpXPDg1SufwQ7kNvwHcp53v&_nc_oc=AdruhtbKb_PlRBqrfiElUkBcPmsTk8sqx7L5hEA8LzUTPczslm84SEGXpNFm0p8iSnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToul8g94xHNOPDisWIw4wtj04Ll7PSczEjFspo0038Bw&oe=6B0D9BF3"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuzxEu7Gg1QQ7kNvwEtHPgV&_nc_oc=AdpXh8zcD3w8fkBkoRo7khPdMUvprXt4eG4TBB9rdlMN5aQdkueU837OMX3s4ga-TnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTIhSzOFbvB1A0YNW5C4S0cYcICKY5tuhtqeElJ_iHSQ&oe=6B0DC5EB"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njPwDlXZvQ8Q7kNvwFV8mRC&_nc_oc=AdqOAvKgU3E7A60yNzuHY8-X3HMWMfH_sYiJl4e96-UQ-22tGP4WtRUdV_5KwGnJ9EQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQRV5Zwlfeb0vajPj42LFdeIboXpvb7igvy5opwifa0A&oe=6B0D9C0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI9laKRXnzMQ7kNvwFZJEsZ&_nc_oc=AdoE-Bgs67vSk4dPB8su-Z6k9-e_dhXF87dhiHdNooAYsc
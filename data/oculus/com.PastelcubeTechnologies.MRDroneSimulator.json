tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9ns-BfF-MAQ7kNvwHDnH95&_nc_oc=AdrofgvMGs0_BQ0TD0B4sJnPlshg_0HYihhIgGo35QuJ6La3Ki8e6rKIMu_i616fcrk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS9keXixQcGchPxvgR2AMeJf0Wf880K6XTo_yR0v8qHw&oe=6A71D2B3"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wisXXnnpR8Q7kNvwEJEbzv&_nc_oc=AdpMi_vWAbcBouu8Qg-pJosTszBBJ_SsoRVBpVP8PJquOrKERTac5q6tM29bGkDvYbM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFbz5jijUVuPrvfS0rf-_tuI_Miv_TGKD3b4gI6MwkMA&oe=6A71FCAB"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CINVZeqCOA0Q7kNvwGUXAMB&_nc_oc=Adp1RvLjzvrOsBizVEErG7U9J8RSnSrLrNDMNpxJj2BmDk8E2zGBTSQeXDO4nPJNhNc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtrHxcQDHK55zUKWVTrY-l8ZSp5jwLyNObQuWT6SDnAA&oe=6A71D2CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsSOkuTSahwQ7kNvwF5_VFe&_nc_oc=AdquRn1vx3TKymJlOJnVK7M-LHbQFE5Mrr6tVMN81nTGay0QOwBPSKyB9OP79364gi4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH19Wq17oreYqTLswoJmO7iJdmCq-r0MNnu4b1cbZlcLQ&oe=6A71D4CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MR Drone Simulator", "platform": "ANDROID_6DOF", "context_category": {"conte
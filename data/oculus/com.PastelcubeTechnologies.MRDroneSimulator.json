QzypBsSXDl8K31TmQHd2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfJUot0ij6OBFk-cybrPm6uGA69TesVyVQpqHvkWbpXg&oe=6B09B1E3"}, {"file_name": "3.png", "id": "1339693023997811", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-UChW4Kh_MQ7kNvwGFJe-o&_nc_oc=AdrXwbxLYvsQctk7NLIf6FOk3_1Y_2ZBtQ1DSnbIabCwBEHO6ZOxjkcUjr29WVSrxaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2qpgz-QvQoBE6Ww4GG0sLop8fuMz8kFnqLCMMeIplKA&oe=6B09A773"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p96KHcfAKfMQ7kNvwGLJcNS&_nc_oc=AdqdqS5utgwD9jJsRnSCEqwNyG3l1C_R_N2NySNPFpkotzf9JYQCEhLWtCF2_9CvpAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-QKREGllDZ-gO2G7KPu488aN473uCxS2Ev7CYTY-_Zg&oe=6B09992B"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=igRZgbBNv04Q7kNvwGe5xo2&_nc_oc=Adpkf5bZaYk05G314pmWmuQ6_YV7Nxxo0PDjUcBdLVZpXAZ9eUB4IwYnplSFZXjHRfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaj86Bq8JrVfwFnCPoBhvId8rB0HZ5qGDCu2xaZ3QHLA&oe=6B09A78E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oOV-86jhLAQ7kNvwGPrREy&_nc_oc=AdrIY710c8Dk_igPwfH3gJMGkuNVrsyIrzD3KdJaDXOVQJ
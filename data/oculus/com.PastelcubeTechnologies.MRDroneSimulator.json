f&oh=00_Af8V0bzMUnnSaLQRaEvEK1ll2qniVKaPEw2gFWQ70ZH3uw&oe=6A36B98B"}, {"file_name": "360-360.png", "id": "704294215463566", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499329560_704294218796899_2425956724793145237_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpo30InSIBIQ7kNvwGVl5qK&_nc_oc=Adr2HuHL1hRMWtL4vT89Jlpc2xmoWuaQEL6HsVVc7MkENcwpetbGD4BksaBiFMSVXR4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-36kPGXzDQO_4yVPkeK2zUg0lDKQ3KzBxy8HV027kpVA&oe=6A36C296"}, {"file_name": "1008-1440.png", "id": "672915438943483", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499318027_672915448943482_3698525716452413697_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXmJaX7kPQQQ7kNvwGccMDL&_nc_oc=AdpvkzAt4dxuoOqS3nAoH5h0hWl21n31HOC5kPhq8Run_3GQ7UqPJdGUhQqYFMgMplc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iUAJjCiqrgJqou2GOFt-TUoSbV9Br0aLQjw5tBZkznQ&oe=6A36A7CC"}]}, "id": "725611480066341", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "1064825388868321", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499321676_1064825392201654_6371974496955604379_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScVk2KxnlfEQ7kNvwF-5cUT&_nc_oc=Adq7czOZOFbSkW3bhfQja5WWwukh_CdFVj8jxjuPl2S3pj_KoQsxtP-72xMxTqeAZJ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IqPRV_l_C1rVOFd11dW3UL5Wo-lMVQTqKSWVPACHf5A&oe=6A369AAF"}, {"file_name": "1.png", "id": "711830767969379", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473394216_711830771302712_918634532842897408_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyI77__5vqkQ7kNvwEGNI1y&_nc_oc=Ado1pElL1OLqDrnPxRmzgEFsFNyS5i8b7GOp99VO2FMJcZBfQixVxm_7gO9WOeLl_-g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82BwB2r-pjzAvEb89jQ6psPDqmwF1fQshvCuKDqolRsA&oe=6A36C1E3"}, {"file_name": "3.png", "id": "1339693023997811", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0B1YuJvPOEQ7kNvwF2jxc6&_nc_oc=AdoDTUViDzsZfsD68ypxxWXMOJKQSG6B5dUnJKqp8uaJBw-_aUACe4-0Q9chsnSr_Pk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dm41vVGyFcDpHJW-poQKH_AOAXN_afVrkQ94xZ7SacQ&oe=6A36B773"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4czyAy5cLQQ7kNvwEqH7AF&_nc_oc=Adrpdps_xFPkl8qQk-W6BFkXGo3hnkL6jVseMR_auFxt1BTLzD2gubY5_FyBXPcTzP8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HqaAAVeEoNypbuln0XaxWufKy-iKAuL6EpL71uicQYg&oe=6A36A92B"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYSDfzvlHZQQ7kNvwEFiWi5&_nc_oc=AdpyILTqmwK6qfNAVKxo1DcBoeH_VW7lQdhW2VZNNVc6TFFNQvFN4SEkmy5b0yuRkZI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nkzU7ZDXED4xyEmzCIlWaUmWCtPYUiP6vnMm1qYGR4A&oe=6A36B78E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kH9l8xOxYwQ7kNvwEW48ta&_nc_oc=Adowwj2ic4Qwj8X2FqLMcHVFwF91pltU_Fnt3ef8ojsGUS22ibG60EQLmdAwEQQ_oqM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gyyOCShziEYPuY2SasfAtVIlbNoFGhFx_hLvUlNMihQ&oe=6A36B98B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MR Drone Simulator", "platform": "ANDROID_6DOF", "context_category
tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499333339_1339693027331144_2310756583631798255_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_uSajZZo3oQ7kNvwFRNlFe&_nc_oc=AdoRrABnMD1cuSgJE5FHE2XPnHCibAajEFm5muRHIYDWA6hBzL_Iry_7HBBkpDqgnmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfx-Ea6kcIg9P0HwMjUb82qvQBDgfB7UpavL2mTZ6XAQ&oe=6AB2A473"}, {"file_name": "4.png", "id": "1935798270289847", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XblMhamHNo8Q7kNvwGnrBeE&_nc_oc=Adr15uvQjPX0nyGVrXmj52u96NPVXaO7jgJv0_EIQ7FItSL5pbSkiVnDzjtl1dh6al0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEILIbWiu7XAAZKBeqGh805DWC4I8qtAgaPakcYFbNFg&oe=6AB2962B"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYtjGFlCsOIQ7kNvwFgynLn&_nc_oc=AdoSKTCfJTNSHwJ2wtebS08SVAY8Z2bIWcNGBTV0XNs6o5S2f6_iqnk-OsIfmZ78gT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIASKJt7XUV4ILcct58rt4qaxi7VMAuJch7uxnlR6OO-g&oe=6AB2A48E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24253444177583425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499316562_1032913965602416_143566906200884240_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ssv8d1-7oD4Q7kNvwEy_2bb&_nc_oc=Adr__TyBsNRBDoW4A312LbhCb8vuCE_nViyNfH8hJ_yUz__dZ1-0LrgjdBUXpXVDSv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXwlwHvSKZbtz1WLu27YyhgTFlJIQCN6Ev1hd9KV2-jQ&oe=6AB2A68B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MR Drone Simulator", "platform": "ANDROID_6DOF", "context_category": {"conte
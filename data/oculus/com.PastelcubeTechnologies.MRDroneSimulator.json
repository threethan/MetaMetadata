1-25/491823994_1935798273623180_9023901920183873423_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9Uu2Jdl5jgQ7kNvwHqYnfN&_nc_oc=AdoWKM65OeTrooST4n_XXOF0wMtxSI8IqhErHAja4pVXegWct8jpBjOfl_Tn4NTq6OA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7pglf_DGEfElq6y3bimokYi1vdKy1Lr-T1U48yhvRwg&oe=6B04532B"}, {"file_name": "5.png", "id": "1412724262945032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499318074_1412724266278365_4253179642551190540_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kyJ4HzOw-IQ7kNvwFBmc3l&_nc_oc=AdrjGNUZBuN4dWYPlNxM8VmK1xCboq4Zr2RbNQCgag4EbJbM9Cfaub5NFwyzFJOSNqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpkOh3sXmeFarTrzZ4Y1T8W-SKu6rucV3FAJ4uzEZxAQ&oe=6B04618E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MR Drone Simulator", "keywords": [], "long_description": "Master drone flying in minutes\u2014no crashes, no consequences.\nMR Drone Simulator: Learn to Fly is a beginner-friendly mixed reality simulator built for Meta Quest. It blends your real-world surroundings with immersive training missions, teaching you how to fly a virtual drone safely and confidently.\nWhether you're a new drone owner, a student, or just curious about drone tech, this is the perfect starting point.\n Key Features:\nMixed Reality Training: Fly a virtual drone in your own space using passthrough\n\n\nStep-by-Step Lessons: Start with takeoff, hovering, and safe landings\n\n\nRealistic Controls: Master pitch, roll, yaw, and throttle with intuitive inputs\n\n\nImmersive Practice Environments: Overlay your room with training zones, targets, and obstacles\n\n\nProgress Tracking: Earn badges and advance through beginner levels\n\n\nThis is your risk-free, crash-proof launchpad to the skies.\n", "short_description": "Learn drone flying basics with mixed reality training in your real space.\n"}]}, "developer_name": null, "developer_p
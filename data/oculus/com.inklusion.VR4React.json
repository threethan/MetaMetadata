ile_name": "com.inklusion.VR4React-20250128-171754.png", "id": "930544592162282", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391773_930544595495615_487725259895727875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNUoaSO4iDYQ7kNvwEhlnwy&_nc_oc=AdoqOTU_Uy7c3dlskiqv5kDrRfIk3EKYTEawbJHTcyn1fPk6fHMeafetFCps9pFoCCY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO0FYWk_i1csIki9r0_y6xVYOceSKrQz7wU_gNMVFYjg&oe=6A8D8561"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig-soRnMEm8Q7kNvwEOBrg8&_nc_oc=AdqXtsCx18nEgj3qwSlkEiI1GmLA9aNigMdfffEz-_inc1OGVs1igbAcYWIERiVw0b8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeJCSqWqdfKnCU7rDH1n7201F8kGaJFFkUzBVDlhk_2g&oe=6A8D749B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0Jw4tk2phwQ7kNvwEJzABz&_nc_oc=Adr7Eb-6xtGtdiYC1chkZ9bLjHXy28ctoQi61E53gGj9S2IbLmtnV44fAROz124ebyo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7fC_T_OLWu0s8evBGCelZfSet9ixcof53jBln9BRoqw&oe=6A8D83CE"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPljoNj0lkYQ7kNvwE6qIPy&_nc_oc=AdraRhCU5g4G9FBTvJe4IzGsZVWsmQbaZNWNRrZuZCGNgzHfblb2kzLV4XnLXgy6tdY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdYuDw8GUsqgS7_WNwZwnkjL7Pdh7LMAMRS41Y5pROUA&oe=6A8D6DDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type":
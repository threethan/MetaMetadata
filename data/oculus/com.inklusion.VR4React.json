ile_name": "com.inklusion.VR4React-20250128-171754.png", "id": "930544592162282", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391773_930544595495615_487725259895727875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=betofFUCh2AQ7kNvwF-JQFs&_nc_oc=AdqjIltfNb1pvRG1TitF7DjZnEb1OqeNlpbeQb0fClnthF4fQVMrkLxC8KCu_nXHcUM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_lsrinX4tpcYr5SFnlsCfY1qPL81a_zRDJ3BjkoOysA&oe=6A859C61"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFCYsPFDO68Q7kNvwHwyigI&_nc_oc=Adp4mVR7_-wUPLoX0ARoOAvnOgGGqwS9bna9eniKL_aIFFbPjCBK9LcYp2-pVHpCUzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGARq2EkOu_QHoTl54Grv7_WGqQ6Zss2UteHj3dbBSDmg&oe=6A858B9B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gA4h8tN7W4AQ7kNvwGDUrBE&_nc_oc=AdqvA6P4z1GNa3zFxDZYogjCyT4BUXNgq4qlstml1XhSkKS6yz9OhESZ1xE7Ia9sads&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwbfsmBqIyS0a6PevVFJ7ot7RSoEWa6KVyLHcTfDS4dA&oe=6A859ACE"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgt4_4tImPIQ7kNvwFGZqXg&_nc_oc=AdqGeo67to6Pe-RhijLcDlLKUxgJcqoIMUBPKXwAot20N59mqOxHWDhN5lZTnUN2ECA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5XuHLScm2ISGM9Z8FDow4ZevKcj08vo5G-kCIaoSF6Q&oe=6A8584DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type":
png", "id": "1153907989759054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlw0NvmgeX0Q7kNvwGL-kYt&_nc_oc=Adn950couvQeYeklD8eaDtFfiCbm8WKWG0ZZii0W_Y_QZ4xKBUrOTREL8tAcbpkIDFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfulQo63KnGRBliscIDjf1dcYpZaXofqUdBwK_A2ZJxEkA&oe=69A80F9B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fEKLueeFM0Q7kNvwH-9Hqy&_nc_oc=AdlBHD6pYFGu5WM4sh6FoCCfdNkPwdJ2bWKZtNIBNZfd79M8e2qjPfZdboZ5yFNo4pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuV8dbzwrHXNF8VjLOoF3lyNlv4LRLa3EljFo-zMaYjSw&oe=69A81ECE"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t-YmM4ddgIQ7kNvwHmDZ8N&_nc_oc=AdmxFc7r5f2BM3ZtE-1ZN-pAtmoiCDayPmg90djVbkJz6gErJPmd4A_dw-Y6QtGibpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu6MAESGHaEaumrdMfJ_BiETDljEWwZB_L7JhvZoZFEqw&oe=69A808DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9197119590347847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "
MQ7kNvwEhbwpV&_nc_oc=Adk3KOXHJJDr50vWv8-bzfM9n2WRP4agOO0fuGNrRwY5ArlBCtsY6r32FkO5hkYNG78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrBLg0NYVcKxfw1n1IrGu5W0oAnP3S5omNKSddN4Q-NA&oe=69A0269B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPTXXA79WMIQ7kNvwG4Dj7c&_nc_oc=Adn_Mu1Qq28xuzC6ZxfOpe7HWNf0Gq_pvxGXKu2UsoQnZubuYL8GKka5MweQOaQIoU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afttr2c-SxMnc6c6es90VX3coacEsgftgMw3JEUXnqs-KA&oe=69A035CE"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YONkHX6GTUcQ7kNvwFR8Jv5&_nc_oc=AdkAmnysn11HVBasCsyngjU-uD48JLQ0w23LCFGIkuEIDtggMQ_OBDusmBFTDjy8GQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWZnhCngCrMVdSRRsD_GqwjycO5iCeHXC7mC6lFf8J1Q&oe=69A0581F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9197119590347847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2393049891047373"}]}, "baseline_offer": {"id": "2393049891047373"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738593540, "status": "PUBLISHED", "id": "2393049891047373"}]}, "liveChannel": {"nodes": [
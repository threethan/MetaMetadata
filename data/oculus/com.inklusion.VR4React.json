EQ7kNvwFoQOCy&_nc_oc=AdllR3NgUjAWSjxEwR3dlTEc9uwHPSfwaisEjSY8AkjrHxyHCVQxQtZCfIFJaaVp6P8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft63YePq6IrnIIeWeFbihyfRpEqWlyLvSE1ztvt9V6tjw&oe=69A41B1B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9qGaS8tb0oQ7kNvwGD4x-G&_nc_oc=AdmpvE98lF1DUCNmMDl81LqKmp8DQJK9ZHqJzn0ICpmqGd59BW6yC7eG0ygH6C7jMkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsKxbE_Z2-rOi7IXL7KVIFrQ6y0Bqacc9c9ZsLGdiP0zg&oe=69A42A4E"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzYlz3WfvrsQ7kNvwFV2Md-&_nc_oc=AdmQAeuSNnC8XxpcK4xGNZjwWcAkx38dAin5slmXbkVA0p4X5hPoxNbQGhzActz6RnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNk7tfBCv5fxOYkGryczCeYuYP2AaULjuFZX3OWM536g&oe=69A44C9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9197119590347847"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2393049891047373"}]}, "baseline_offer": {"id": "2393049891047373"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1738593540, "status": "PUBLISHED", "id": "2393049891047373"}]}, "liveChannel": {"nodes": [
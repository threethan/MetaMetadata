2MTNZx5JYAIJ1QAYB8aoMNa51A&oe=6A468CA1"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngiagovczF0Q7kNvwHH5yp6&_nc_oc=Adr4DrkF-nxeXX8D8rYzpRgxWAdImuaX2eirCEgw41OO8WUQ87c1A6k32F6TAAcZzd4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RagfSCKTm5zZHV0Dg6iWhYf-2gScNFN--NYdAgZu98A&oe=6A467BDB"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPiJ480e3s0Q7kNvwFuaiJH&_nc_oc=AdqSyr1nNcwMFVn3XjNyMsSp8-rOSbmt1ZDRoiWG1T4rNc2fMBqfpOlWp8r-r-nM3gw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yFZsMBbdroHmAEWeC6FkdNAyf8U8p_E3V1y9u5W7AGQ&oe=6A468B0E"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48yPIeddhxwQ7kNvwHseOuM&_nc_oc=Adq1duT4PubWtlCfBwNt1yyGiM-ZyEdIQllWWEWPm7qQSRK7QHZDZSnQzjnruH8mBro&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v6hNcSthvf5mZcJkYq4Kk0jq-s26aHtu_R6y3cJAdbg&oe=6A46751F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGL
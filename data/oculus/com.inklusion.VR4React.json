8-171754.png", "id": "930544592162282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391773_930544595495615_487725259895727875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIbI1z6OHAgQ7kNvwHlBm33&_nc_oc=AdltDLRvMhYfUthxapgSadZYfFl12JmfE-z5yHPOc22xFyxFmAPYrHXj46t2VO90shQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvcktdIbL4IpLTr189jZkHKTmO154SasZBqEO-uPh6uA&oe=69AEB7E1"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXwrKvVcS44Q7kNvwGPBwVH&_nc_oc=AdllThF0PL5DXout_DDbjNponHmIQeIsIZY2fMz5aUQOPP5dO1rzNEwQn20M27EUIe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF23Zm_fZPha39qoPRiXRmULIiwSJmUFy25UJZkhWOQA&oe=69AEA71B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3N98MxiDMjYQ7kNvwHsONHJ&_nc_oc=AdkAnxDuNZ_mCIEsN0KLNgk-JJpVeYNy9YQgdQcKJ8xInVzGv_TY82woEZrfuviDs_o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS-dyY-OJOXkhv_CD0ZdDLgSLVANPdxru2QttUqcofvA&oe=69AEB64E"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HVBsf0Kp8IQ7kNvwFALV5Z&_nc_oc=AdmdusBzhWwQAN30b3SkISeOuBkVnoCjTBMhLpJ1SSvYvNwI5DSiyGlaQ_U-Uh4QXIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt1Rr2jmyCzT33FG48fBUQc0ugNPDRY8SgjMPC45VNfg&oe=69AED89F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
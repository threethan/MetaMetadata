ile_name": "com.inklusion.VR4React-20250128-171754.png", "id": "930544592162282", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391773_930544595495615_487725259895727875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNUoaSO4iDYQ7kNvwEAkQiT&_nc_oc=AdrtCK7BT3wWWJQxsMUvScNVIw5WsPtls4Di8_eIylrqApyZjsBkWOvSihRiN4lbAok&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiAyKpmXPpxFNizsSpp_wonohTzcwMrdxygmu1tp6gog&oe=6A8ED6E1"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig-soRnMEm8Q7kNvwGIyg1c&_nc_oc=AdqF1TAqCyNfjHlx_-aJrYVkQo08TEeQL7CWr0UoJS8A3nYTuW7Nh9MascWqq_1ro_M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHahjAG0W-CLiOlpxvmbqruGwCZ8RbRGHtIGTMpE0xGag&oe=6A8EC61B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0Jw4tk2phwQ7kNvwEKbCUE&_nc_oc=AdpQhIP1RKuc2cqPrG3zaKsCyvD3XczRM8QIMnddePuIFqmig3mN9m9Oyatu6OqCuyE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJlbW1ndk5jiTzARJNkW9p-vcSXmgu6ZvY4NkcXoW9Gg&oe=6A8ED54E"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyp9b4RWDeoQ7kNvwFKVdq5&_nc_oc=AdpNU6Ej-3zxjPqYIxVF2z_YCD1cnPCOBdQMkTQsRdav9VB_IZfceGr02wmUjCSJPvY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQ9HF5SYcLTnSwrDQEk3M43ItNeQ2amkeoY0uEevlGxw&oe=6A8EBF5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type":
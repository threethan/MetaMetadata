8-171754.png", "id": "930544592162282", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391773_930544595495615_487725259895727875_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPRwS02_26wQ7kNvwHy2vlG&_nc_oc=AdkJkO2Go1cNaEcdr0sDg0meWkJWgt_VjC4JHYtyfDC13euNnLWwm8hzMvtltaiKaXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWBy01rrWnScmgh-UaYnl1qumwO2uScctcOUYqzGbrEQ&oe=69B7F261"}, {"file_name": "com.inklusion.VR4React-20250128-171956.png", "id": "1153907989759054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391814_1153907993092387_8146514770825871490_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7tBdP4wsEAQ7kNvwE6wWxh&_nc_oc=AdkYfvxyVLI1-kg_HdbtYcN9IkMlNbyvujWDwyFbgIX6jlMes9xYwi2MwQZqlbmK8E8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyBqs01oPsNyAHNBg6lYMN_FFVXy6f-zfXYe-fB9FSHjA&oe=69B7E19B"}, {"file_name": "com.inklusion.VR4React-20250128-171836.png", "id": "508314261823374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_508314268490040_5974003882122489845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2vZ_JTrJKAQ7kNvwGFYuuK&_nc_oc=AdlWrI_C0nMvTHvBmB4IT0_dMpEiF4SD4v5ESz5Sr12IDRxqRtzVCTky7kwC6rCCuYg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3FisMNMHzBtL0-zBkD3hUorjydoh0FlT6FXGVmlgm_A&oe=69B7F0CE"}, {"file_name": "com.inklusion.VR4React-20250128-171913.png", "id": "980504290640648", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391840_980504293973981_8396053206098735586_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv_zOjcu84sQ7kNvwGWavpv&_nc_oc=Adn0yLu827yP5_DFs4kem5LWSMnAfK4oxmqkPcHyonTtyGx82DgYlpZcv-I8rKGV0Ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYb7LxIGEZQFQR56u5icZRHob67_xbkTl5ktIG7PUJgw&oe=69B8131F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR4REACT", "keywords": [], "long_description": "# \u200bA Two-Folded Intervention Program \n# \u200bUtilising VR and E-Learning\n\u200bConsidering both **inmates\u2019 rehabilitation needs** (i.e., address reactive aggression-related behaviours) and **prison officers\u2019 training requirements** (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an **innovative two-folded intervention programme solution** utilising VR and e-learning as the main tools. The primary objectives of this programme are:\n1. Supporting reactive aggressive inmates in engaging in more prosocial and adaptive behaviours\n2. Creating a comprehensive training curriculum to equip prison officers with the skills and knowledge necessary to handle and address reactive aggressive behaviours in inmates\n\nThe combination of VR technology and e-learning in this intervention programme offers a multidimensional approach to enhancing rehabilitation outcomes and creating a safer prison environment\n", "short_description": "A Two-Folded Intervention Program Utilising VR and E-Learning.\n\n\u200bConsidering both inmates\u2019 rehabilitation needs (i.e., address reactive aggression-related behaviours) and prison officers\u2019 training requirements (i.e., to better deal with and address inmates\u2019 reactive aggressive behaviours), the VR4React project proposes an innovative two-folded intervention programme solution utilising VR and e-learning as the main tools. "}]}, "developer_name": "IPS - Innovative Prison Systems", "developer_privacy_policy_url": "https://www.vr4react-project.com/vr4react-app.html", "developer_terms_of_service_url": null, "publisher_name": "IPS - Innovative Prison Systems", "support_website_url": null, "website_url": "https://www.vr4react-project.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "intern
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=076R46X-rsUQ7kNvwGzgytR&_nc_oc=AdoEoNgVWkQOY__ZwiSmq2uETB_ch7N087LqwYW5xhUF1nAXHP9bu1lYHWGuHyxYFLs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c2mR0Z8dOhZTeXGhsxEdvVahbGKGm_GUhRKv82jf19w&oe=69FA11AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoYdICsm704Q7kNvwHgvQ_S&_nc_oc=AdoXlUI_NmD3oJRycfEvaldhB7ZxcNtPBDftfpCTv2M-cRpQZTMs459QCrZqSHyFISA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63Sxd8CMddfQLaYzhuGAyMCXI83BcFiUgKI8bkuAXLWg&oe=69F9EAC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Z4IxsakBQQ7kNvwGGxE4Q&_nc_oc=Ador_ZrqgO085m1L0kANonHV1n5poNsIZlDuXAv0ynDR_IUBGq4FecArmKoahsPGkEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4W_vWUdTDk7oUCcqUnt70iyCZjcSH9mIynqsRZTk8w2g&oe=69FA0DBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjqpR2yXnmgQ7kNvwHWxxyG&_nc_oc=AdqdYjvOozHEeyqJdCWuI-TOLwIg3Hg0ftgn3NUCgYu7B_DKr4sCI2NWj2gzWXgkg-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VfZKV8EINllW73ld31ahOuNw33OmB5lRY5UD3DzRzlg&oe=69F9E652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQg3kYtrSs8Q7kNvwHJkOfi&_nc_oc=AdqkB39k6iB26J9B1ob_kpWKFKzRrV3OTgrJamB5EKn_HAM2OKRtQI_AcC2PmQo4w8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VBH6Psfq7vq2bfDxBqenyoZ9KkiA6T_RBfRrjGIif9w&oe=69F9E418"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8mYPz0vKFUQ7kNvwFFKm7s&_nc_oc=Adp5puBPeaiehxmgqVuSMxDdKTwPSAcAtrkDqB4x1qwAm5kFYHXlVZhurIBFBGMGiSw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HUMjYwkoRTDCFf574mHoiOOFkU8Vf8sjyWyGOd7Lb9Q&oe=6A2C2AAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5ExHVggfasQ7kNvwH8yReC&_nc_oc=AdqzoRmFxsBEi2UznhjDGU6BjBq50ivqKjm3tw7yTkCrxLsjOGgmK0fCKppyvXunIwc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Uk6rIVxNZ7i5Fu9VAZT2fyQAkLhFOh6X3blNGKPUsdw&oe=6A2C03C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhqsPsns2PIQ7kNvwFOzrUZ&_nc_oc=AdqeYwMwUEWG8-nM9VMoukziXvDlPExpqAMVC3hXCi_gSs1UY7H06trh1ytPFGiWuF4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99bleSp77Ft_qnT5dpPv0rsQWCXH7avO4WkK-RZHsuNA&oe=6A2C26BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbOUF4NJLpMQ7kNvwEnM8zP&_nc_oc=Adrd3V49tTUfziep0SHHwuQziVPmQQx4nww2oBgpX7GMxECR_QSnVuZ4YJx0NcLsg3Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gnR4NhLT722mhzjdiO_Kr5Vt6W2Axm9o5FF-TEGsnpQ&oe=6A2BFF52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k8QphQ1EFcQ7kNvwGuvgld&_nc_oc=Adqsk208j5sOq08j6KLdQImNhq-PSwvX2NMfnumohEVM8iHPEd6bZpMGxIbbH028FrY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_geq0AuWYXUTocuVEU2sqzi_H9cN3ZWF0oLwTkbbTI7Q&oe=6A2C3558"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
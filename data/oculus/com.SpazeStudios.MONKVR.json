302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZYicFMal0kQ7kNvwEAv3SC&_nc_oc=Adq8tEQw9ITETTRTLIqXzuz3SW-ItITTkGF4UudkQi58S63rEFurhsQqCHSFcdZIv3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX_1SNcPMHCl183l_qTFowvFViov2NVURsj-wqxbu25Q&oe=6AEF48AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTRgnVaz8IEQ7kNvwF5b16B&_nc_oc=AdoPL0BBXGS1IBkEovJtOpvFEh1zqcNuD6fk5vS4lk9bVkHXd6KK3nML3T2nlJG2oTI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmfBSRHp35IpUq4K7HyaSe8OBwifw7nyeVbLnVonf-Gw&oe=6AEF5A04"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stJHawKCfRMQ7kNvwH3ZyvY&_nc_oc=AdqLBz_MuLanI2UqTKrichfb_OqmnUUSoeFVQC2sy450Tg9aSErNXnU4tQlW7c_N2j8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuBgyaceD4No5rXOD4SLAymYBf4aJGLwHNgYqrL6DDaw&oe=6AEF44BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04oY7fBYnfAQ7kNvwH9kWof&_nc_oc=AdoHB3Zdz716uV1y3Hhdeka-6oApJE0me1WHzCmzCmx5MJual_f3nNsIbcWG8THi2CI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX-hH0JpEPzocBv5-mk7LAv36k25sWrAR3T3-OdqEwLw&oe=6AEF5592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPArnMSS3rMQ7kNvwEFW1xl&_nc_oc=AdoqQ_fVhX2KVNmTIVJhpm4hjyj0uWCx7WEsJIjDoW1Ae_YBkG4xYjsz8BVHBubRvEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZpVVWWnKkorIwvHqFe0UBz4yOJfFPM9La4f6xPEVLsQ&oe=6AEF5358"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
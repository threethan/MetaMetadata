302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4bFcqV8Y_UQ7kNvwGwAZtj&_nc_oc=Ado2jwAUN-vjeeVVlHM0jPRiauAByVTO3g_8K5ozmRl6DWw-cJ-O_Ubj5ahfCl8LSMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrSuZ214E_jkrhembq5cWPM9vzETzDtjBq6rOxT_uYdw&oe=6A90246D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvr6ilpiZ78Q7kNvwH8_sBU&_nc_oc=Adrj3Hbd8HMDVwaTCuofPWRl-yQKE8wehFWM15i46rztzvl-DRaOqZsPODqAcl-QSCY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9daxtrs6z23lxMMyMcBqnzP5Ii2ogi9Rq6Dfb0vmx-w&oe=6A9035C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VvqddFKVwQQ7kNvwG7ANxc&_nc_oc=AdodAvnRYqE0zM2ajE94cNaRlXaalmiyNfXBCVC3o0WMftsg7d-iPvSKJZyK5NNZS-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJOxmOXPQecLY5gYhhK2bb3GkQIFDT88A0wEs5tEjKtQ&oe=6A90207F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLIQ2D2KngQ7kNvwE2rVRe&_nc_oc=AdpzQXb8iUL8Gh7j_-gL_vnWJo3_CXkBkdUjSBV04JgKjB6hs3s8ypIQ7LwFFuh6WvQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELusBaMPb_ZLqCSis8fKwl7X9PvSrvVJVYSZOWbyLf1g&oe=6A903152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc9g9sM89mcQ7kNvwHCb9Ez&_nc_oc=Adp3SdqQT-djJ_SastMXS4tELKuFM12ECGmPmi5dH3gcVCvyF6ou2ELPUVUxa-rTTUU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5YPRelGgJD-UYpJTLyIehwHn3Pnw52hWvje3JwJ1d6w&oe=6A902F18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
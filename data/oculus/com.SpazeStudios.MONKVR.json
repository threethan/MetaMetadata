302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akasO9KiqTUQ7kNvwEst4gB&_nc_oc=AdopRL2KDuvbCUZlDoWtCccfT9nCViRbDKyjKrvMhf0ounqeH9UKBUzgEJDGeMPCevE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SOwMaNVe0-tmtFzbdp4KINzE6JfnZtO2nQCzGdgUYxw&oe=6A47DA2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km_yd7aQU5EQ7kNvwHuIet1&_nc_oc=AdoLgxWA67G_j_U3xOY82sBsXUu-PWnOpi6HTU7r6r9cIN3zgCfUVgw9a8CdiJVvqBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92sL8ORW6IMdaQ3-GyW2nn-rN_b_7Q-skOibC-GNRUbA&oe=6A47B344"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJIgQfn17oEQ7kNvwHueqZy&_nc_oc=Adr0XaEl_aIdFdJMTj7ZVVArT_sGbzIwSWguEpxjJ-DMNo8pxyi7aaRAPHSvFOZ5o94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PEL2Pv1QhDQXp5kpJu0ZuN8y905UX9MDJduwCq0qlaA&oe=6A47D63F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrGTvSvMySMQ7kNvwHPbmGV&_nc_oc=AdqeJsvWPeh35RoXz9w6utEdqMZKe--G6rRbBeYcDONT8DucUcgZthbh6r2voH1Bw5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jU8xCtpB8frmZfiNCDruGJFe70pP7Io9Rqu9lAWyqTw&oe=6A47AED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5d2trpmOUIQ7kNvwHdiHcS&_nc_oc=AdrelgN3qNnCDGEoMtSpzUKg0NE-pQSzToxaSvCYxmnailXp4mkWJndXHKtlXKo18gI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pbXcDrddVyT00L5gRf5OewGk4n9NzbufutZLqECRTVA&oe=6A47AC98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcH8PimBpUIQ7kNvwEekjCa&_nc_oc=Adr-q_EgONbFBMq4IbreTnhV8flcJTfu06qPCM7qHZA766YB8L4MBipzvc8lGtpo-9Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2d0EppEug-gAiTzDjRNWKjY3sI7Nz-eCzaSSxTVJDF1g&oe=69F341ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-B1POJcK5YQ7kNvwGEYVAe&_nc_oc=Adrn55Bh4R8EZNbsc8h2R4E8IjSBfEwO22yqMsEx_i-T7Eouo4V7HfGgIP189JcoHK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10KJ7RvLwyZBIeXvHUZUA6_O2DkJX8uiqI2jk7cvmV6Q&oe=69F35344"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB8qWhxTOa4Q7kNvwGtnERl&_nc_oc=Adqa1Z26HZ7cV3eOh2W9ApAxtRnHbXN4l8JvkVKkaTIWuF3ynmFuCT9yrYEpPMf5nBU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0BrbaEVs2aF7AiOn_w_ewCKECb7f_tTjxYwgcFR_uP8g&oe=69F3763F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FC4_XRPHhMQ7kNvwG7rBML&_nc_oc=AdoOX4dYdREjPNAVyCqSKxr79cGDmVobwOvDklPOSgBBMwNCjuWKLgNv0JIxiKlJKwE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2uYlluAEBJZBO3firgaxDi7IcSHHm26n4szKkK1BuzcQ&oe=69F34ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIYnJcmtUXIQ7kNvwHcr10t&_nc_oc=AdrVXn5_oGotBOKuCh1mf9n9GPwCySMUUlDh8fRJh6dHPzokop7RxiBg9zBx6F8uffM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26ndJtvoAwtMdSj-7D9HgYkgIJmq5m0U07PqwmC_lzOw&oe=69F34C98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
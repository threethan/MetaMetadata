302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHtIm6CnfBEQ7kNvwGKlO3l&_nc_oc=AdqMt7HRS1oZYmt0iWYnnYraqfzbAzWeMmkP3Q-7f_BeS7LTZX94mLoCRgcR8F-ocLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQMupq_QrxPniQyRgD-nO8llIVsSsOmGL8hsK54ATWjQ&oe=6A9C3A2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXsjZYme1jMQ7kNvwHVciF0&_nc_oc=AdqUGCNqnYuoer8ARiyO9QTrHokzGGAUwUtivYYzbMvQ9DiKcivrtEYwFUa-mnylzXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqtqnc3JfpJgB6k8hhlB0kM9MlYqmZgV4YHw_CvSxz9w&oe=6A9C1344"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnIJEfZri8AQ7kNvwH3lFS0&_nc_oc=AdrBydG4QylTSED-lnDD5nSExws-bFyEpt8QNUVWB5NDVdKE9cbLROqfJ_8yLQZcrZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrolLYhiEUmBOkavoBy_n9j2rDORlfcFq3NN3EBcUw9Q&oe=6A9C363F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQgQVw059LgQ7kNvwEyPJdO&_nc_oc=AdrM06Q2mY65Lyrf8Rps22-UqWEo_UpNhG9UjwOc10lazfn_Ysw64P__HoX19sVrigk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3kKiD7I8gdPzPMwI8rRY2cWeD5w_OixMyYKj4NpE4jQ&oe=6A9C0ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sns56FeRTG8Q7kNvwG7HlM8&_nc_oc=AdriU8gj1Hz86q7VNT-qnjTCYmjzjXH6dRcjFFv4JXmBvtszQhiPDHKmX9q5AaCb7jM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO-TQqZRyoVNTtuf1LlGgYxSvK_sxt2aJW2fB9ZOy5ag&oe=6A9C0C98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
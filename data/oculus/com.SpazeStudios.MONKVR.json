302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MLXOQ9cEt8Q7kNvwENR43y&_nc_oc=Adp2seUN6xuG_F2CR5gQBVyN0FhDo_ESGCDYMSTlZyH8aIoEYeTjCx2DDMupO-2aITI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM21YKKpIz9Ku7gOYJVrKVIY8ra7aLKEZlVo8xeE5Lrg&oe=69C66EED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fSJDTrnWl4Q7kNvwEy1q3P&_nc_oc=Adpu_xU8xoc_vMaxb4sH2i9F4_CHkVTmnZPtJ6gO84gzPleSveuKjkJSpn2vsVQZtj0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw49Wjo3u04dw9CQ8AZpkRJFBxZzHG16BWQMkQLlIc1Rg&oe=69C68044"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWStE4KKht4Q7kNvwE-pAcs&_nc_oc=AdpbfKHQV3lVtU-6_aqcqL46uf9FQ0RNYiRHmrw6eocuPWlZmCJx4BbDjztkgx_0l04&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgMI5PgPBmqN493UugAav4s5gzU5oDUWapiv5gj6CzrA&oe=69C66AFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JWFYLZkRGgQ7kNvwFHaNR5&_nc_oc=AdqJk2S5RpiZWtR0UBZrUVO-mpDx1Hf_mgVZAMyasZ75OASIFbFtGRH4BCwAdOGpXmc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGw-Eb3NiHiHHcRLy9FQUkHqXbBUVq6eRf-q_3LKJW4w&oe=69C67BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9A2Pw21a8kQ7kNvwFx9ua4&_nc_oc=Adr4hUzJfRZqM-n8lDFE1Z6FHSAf9MkVtw3ddFKpPObh1o_vs60dpKcXbYRkI_wJrzU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjNQj_S-DCITZVdzTa4C1MM4sWAque_-h9ZQrPU_Jo-Q&oe=69C67998"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
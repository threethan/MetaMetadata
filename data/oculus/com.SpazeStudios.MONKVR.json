g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqDlfUaiBFcQ7kNvwHC2sLl&_nc_oc=AdldkHNN_jajsp30Wd52Vdyf3LgcHFGyh2WrEJwrTjprTAVlPfcZB9cjEjrAd87EnKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV-_qgxoBEMdnqIr94lfSs0ECPDEVNW_yNu1Gf0hBkvQ&oe=69BE85ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9P8N-dN0iUQ7kNvwHsS1LT&_nc_oc=AdmmQZ3ZAkg0MmDQR9ZT75rYkis5I8uq8mDHsA6euYm9UK1ut-ISNd2T7ePQQnByibI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUTMV5LoWpxdHY9Sn8xtLYmZXiSraqRKITnvfnCMAYqg&oe=69BE9744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsZlHqv42qEQ7kNvwHsirQD&_nc_oc=AdmWpHz8k5ex30kzXi3r6pF6LEBkI2DktRAK0D_r1ZQk-6X7Bz7I5WQXTA7C3Y-OLXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6pkc-p7lmJ2Dj6Gs_HtFBqK1ksf1eo3C1kQQgV544lQ&oe=69BE81FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YKUcuzJIS8Q7kNvwHtP0iC&_nc_oc=AdlCBx9-x257nFUQmXlaYKsC_5czVv0URTvSDgCQTbuEm1B0ge1OM92KF0_Vhm2bJ28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymRT1Eur4mD-GaCyqRxGMtBFyg9fMD-a5B1vgXtFuDtg&oe=69BE92D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcm7gSRzF74Q7kNvwEpqL1c&_nc_oc=AdkT-YvoE-Tb1VWHDBLjN81VVMJEgOthSOdjG98ABd2OgHTrEmhYjDMuZ4HvkeuMvsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYU0Bdp0YqoDk1ycXZpZ_eUA18WgxQ3I70sGK95kpGfQ&oe=69BE9098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
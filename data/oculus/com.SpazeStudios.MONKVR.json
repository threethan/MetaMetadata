302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmlfBq8OZ-EQ7kNvwEj6DF1&_nc_oc=Adol-dqMS-3Nv0l91Fu9uW1twu2VgZpO9mnc_tw1UN9NrFVmFJRkj8PF9-TUAMtodsE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nfnh3ulVKhc-K9JIQpnlMMF9ebWPXt0UvYiya1Q7dBA&oe=69EA076D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DQfJhk9mNUQ7kNvwGT0TXF&_nc_oc=AdqSzUOiplo36z7cXZPHXbLADnn6YNIevoj8m-QeXe5gZTSS7ZW0gxd0d46QSDYGWGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ElTH4hI00g3fwd9DJJUByx6hWkV9bsclmM0NAss0cmA&oe=69EA18C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhtb9pXn0Q8Q7kNvwFgwsG7&_nc_oc=AdpDR-qf7-ysgtsve7RAkq2SZoBO_5oGMld28YxRKQ4MemCY-n_SsNYKPLWCIFeuOes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FCj4q4uM8d0tli6LpWUPgkli7Ix-zMD_7JjmBZ6Bk-w&oe=69EA037F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWYQBF957ywQ7kNvwGCRkW0&_nc_oc=Adp3h9YdDDS3uDsUKrNr2lt2GLabHzYLxiTqZsBO6nb8y-m57L_dCtjXkvrF-kR83mk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wyRQdeBjGL-9hv0Mp0W70ZPjwF1OxBPpPgC8Swn1UsQ&oe=69EA1452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsy8kd_uafQQ7kNvwFKxWW8&_nc_oc=Adrh71OlWE5UZBKjSOJHIfmkkqapYcmJ4MORBGrNIkwjE4UIsL1TqClt1kcmWKPD9V0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KtRcoChrQRio-iemXMrHU6k9EtvbDw5jn6g44lZdzzQ&oe=69EA1218"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
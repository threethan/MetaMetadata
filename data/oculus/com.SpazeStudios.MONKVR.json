302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZKrjpj6NO4Q7kNvwEYRc3P&_nc_oc=Adp3NLvizQFEVHAElTty4JcaMZVeKuiOX7M6P3yaZIabV_GrpZ0jzzq73RCqokl80yA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmFINc7QsiY1NRXdWXdUtwmd_5jm-BFcFunYnQE2z_xQ&oe=6AD247AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vtc4hGi_vUcQ7kNvwH4NEPP&_nc_oc=Adpj2nF-1NCPGV7jOwdEPECEdTCOcethDBo3WbNB3qQ5ke-Kl87GnClTfj_p_Qc5GrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrnWKGM8YoqGoRAPAdrVa1buLm-0gijEIF_tnIINlj0A&oe=6AD25904"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey1-4cWKm0gQ7kNvwGv24cU&_nc_oc=Adr4lxeQYIcPnnwN4FtvuRV4Dq-w7CZVr2IEV1RxIwIBxgt2NuDjkquWnLtMn-aKC7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP09Y0Id4oYhsY-lAfxPpw8yey2l7S8shlB0IuLMK12Vg&oe=6AD243BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28EpEgPxvhwQ7kNvwGbjN37&_nc_oc=AdrAZioSrI3lLEecjZhAlKrxYmrmNzHhY0S2NJqrBKfeCLdTvBsj9QCIpjTcHNxfY58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdVjxZzrZohckoePnJCVbPjz02paUjlr2f9MWbu0TskQ&oe=6AD25492"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVjc7d6dZCEQ7kNvwHzyPSj&_nc_oc=AdpCC0Xdws1gScyl98BIaAtDOrnndFGFWJjNxSf9ogR7Jkl7dvrvYERIh5KzCiwyQ_4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKKB9kSDJHDs0sftvuilXDoDx6DvTCzyO9eGCQFcPC9w&oe=6AD25258"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
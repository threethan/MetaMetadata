302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmlfBq8OZ-EQ7kNvwE45pFv&_nc_oc=AdoTUx70aeF_NHSfWB7mDwUGOQx-8SxrrPwlnD-RmCW5CmsJ9i-ZY5A9Gk8_zSWMTCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38Tkzi2eILPqmxUaHP4DTbHARSmY0txSCNNlWxf-crxg&oe=69E8B5ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DQfJhk9mNUQ7kNvwELrx8C&_nc_oc=Adop70O6mMsUULveUlpOZvqcHNDu15ILXHs-ZRwRtjBxMfIaw3G07qWlwbQvBVfPlHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QNAKWjcCnmNdbvSfwn-X3zsUMKvBfWwo6xnGJPEj83Q&oe=69E8C744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhtb9pXn0Q8Q7kNvwEH1WHB&_nc_oc=Ado50p7JudMPpibfTHNPKyuQ58ZmFknHOl9BzhLT6gunXBidNavbTeoZqTQ2r0rCU9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34dQHeiStXbqwjOfp_uC0uSrGag6FFc89G1Qcig5lXPA&oe=69E8B1FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJjXr0l_tRUQ7kNvwHz-JrO&_nc_oc=AdoXMtT4Iu4ydIDS9ZM6VYXpYybZ2KedYu0QL_Kqjxf5H89R8fwJXnP-yf_lvJ5Lb9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j92QHmA-PyFqVuqtbBL0hFK_jl09NcYvy_BvbtkePWg&oe=69E8C2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsy8kd_uafQQ7kNvwE4-iyF&_nc_oc=AdqkfqCpVS2bT8vZF_L3RrwxIfhAHZkfVJRzhxS-Ep5A7bqwFzI1CDOfF1T6Y9dNdm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q6hlbqSr6VM5qOIioSJKuxa5x4SlEd-4QaKNGe4wovA&oe=69E8C098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
1-25/499302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akasO9KiqTUQ7kNvwHcZnzP&_nc_oc=AdpZ76_eRoQfriPnHYnqImb7AMU31YNoJuen1Edd5dLQ0gMdF8nerkR_6CteBoOdAcU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Af74nDleJFuuNw0LzI1_uCpZGSczzBQYC2B_aB2gmdg&oe=6A4688AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCTt_W8dYjEQ7kNvwHfVXBF&_nc_oc=AdopQrHazOoMaqpSYMTXf5Ek_WPTawWTKy7AMReKVwPqAX6TgYT5DB26iN9QDcKY-OQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GVLdNANxhZPBsS9zZzpihu0vd5FWRqdeUR1TBd1_T3w&oe=6A4661C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhdG1YZQY-8Q7kNvwENz-Dx&_nc_oc=Adpf0qr44noQDheOM-qNcfzqSPTizlCUWNM6RNSpo0BjZrmCnl1BLQqJXUQ7aJlmt7U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XmbLf-m9tVvGzKmg59LCiGWeSEjXaJ3uylcA906hlMg&oe=6A4684BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrGTvSvMySMQ7kNvwG9HH82&_nc_oc=AdpwNVZ8PMx_HBn0dSg9tbbtAeogxcgwnaGo27fj2lTpVuAsOmHmkpRMooZzyqeVpTc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NU9AyMW1k1OCHa_0kSAQP0pOGhbrW3pf_YADWJ_GpFA&oe=6A465D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5d2trpmOUIQ7kNvwE46MEs&_nc_oc=Adp6voSexextk58vwvj0HnpCzudYtyfcz0VQqsBMYzlYowFLK90tZWR7XTIuGPyqlso&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Od2yZS_bTLqu4NjLw1aJNnPiCV8lS-hCQfXNniW42NQ&oe=6A465B18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {
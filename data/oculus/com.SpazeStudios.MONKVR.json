302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcH8PimBpUIQ7kNvwFhcWQI&_nc_oc=Adr8UY9Ue3cnrpvlqLPt-uv9muxfXKKx9mOC0wHKhFOJgIcGM2Dt05d17uOOSd6FMy4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ejmvQLBN3P0E3GzjlDZAKkCpMaTUsoAS4YjGGQce_Sw&oe=69F4936D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybLhwkmtukQ7kNvwHhkKRd&_nc_oc=AdonlPuWGRFfbXzZDLeGio5v98oavtjyh0GnHIdAfStYPf_ozLKiYV7Tf876xKty2ps&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ak4m7IZSEHyWZbAN0D9nu2hQAtQ8ZDuyvmeRjkH0QqQ&oe=69F4A4C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA9T2EWbpI8Q7kNvwEeAcW7&_nc_oc=AdrzbSoCCj38Dx5KD276wdzb_jTOh1ujEaLeMidV6-7i5ANtpAv1erXBtbc6LZylfaE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2SvBqOWikWNxMxF0XE_GcEkVuvojzNBebKXP76Eam0tA&oe=69F4C7BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FC4_XRPHhMQ7kNvwEfM4jV&_nc_oc=AdqIKHjRbQ1N4XrViqkePoviRA0HJapU6XCAKYWXMRTkzBBo37J2YixO_fJY7uHUyR8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38O0KumZK_3s7PvPXpDK2HcW0ioHKjr47GRtIhDs_EmA&oe=69F4A052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIYnJcmtUXIQ7kNvwHBPNeW&_nc_oc=AdqQxsflnJ2rK3pu3Cb1Sb0TalyT01iEn2xiUCSIfSq3kQUet0n-XISjOnq6-xKbE_8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_03sst5_eiCOWhKWWH3TjEIe4OoWQC95DYOL5t0dUwQ&oe=69F49E18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5mncl8cao0Q7kNvwFgRkN3&_nc_oc=AdoAcr_oIN2n1hrXY7f5KW8O39kQ8usIVGAgtMcAtoAEjqdPmwJOjjCvik-oRSH7dsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DKh55ZQcF2qztp-RJRz8gbYKLTQRUfzAZpemFD7GdIA&oe=6A0F29AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBheqZ--UE8Q7kNvwE6y28C&_nc_oc=AdqVwS6v5POcXeshbWaHDlA-WyDshJO6ElOK0q0gaOSouvM84e1CGM0V4SxCDzSrTCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CF8nunz6cS0Qt5ldaxpBiYwYVfOPDdeLuQ1Q1pCzKmQ&oe=6A0F02C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOOO-5nkCeQQ7kNvwFfZRqd&_nc_oc=Adp03hz5-21382aCWinig-DYhY6m0X5ucX5ljuPjjyLMFNTic_rPHmAHG96H3AsXHgI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55N3fkxSmqrK-sB3ZxrPurIkQlWmiQ_k4Snmi6_6eyvA&oe=6A0F25BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t4i9bvJZNwQ7kNvwH_DSIo&_nc_oc=Adpvsl89B2EDr5qYqSFCHs-nEX-WMD2dfuSQgZeAt4YYH1mUqeJ7NMe6PdKT8c82cIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63v3MlzFa9i1w1tWATWKCKr65Z7RmzlTUXKNolM3lBJQ&oe=6A0EFE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUuOTgfi6YkQ7kNvwGNikzl&_nc_oc=Ado_zNNzdnu6iQaLA8nfLm_o9gMr4pZ6kw3Xukh-fpdTSsZvN80gAeZjQLDw2lYvXBA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mHNBAfp8vGTNLwcATvupCAlkzW9Y_FGfXbI3cIFwagg&oe=6A0EFC18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
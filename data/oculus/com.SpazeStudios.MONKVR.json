302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnp7hTk1bFgQ7kNvwG6MWA5&_nc_oc=Adp0qAUUas1MU9Eo8KCMv2vwdrkkYfAv-kLhEn2B0CCoR8mvljN1WemxekPYGB0N_Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43jS9UpzgRXrM_C-zCG72Q0qchj9SEvgW9W8izj3IcJw&oe=69FB2AED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoYdICsm704Q7kNvwG50yaC&_nc_oc=AdrOxgMtEf334N1gRccMDF3YtBjKaJTymVFxPF6cY-4oibrHOOfM8neb4036twMMCeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QJg0-PdZgB_6v8m6ABnoyKSa7Rirbbi3t-9KrfvCz7Q&oe=69FB3C44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Z4IxsakBQQ7kNvwEppWwT&_nc_oc=AdrTiDpJatWUkqqjC1sP11zFLI2Ki8gvMQwaZccnnaCjkYqhtRkucktWQol4xkINtfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wqcOPyuuDncnihtS1hKyGnN3yRq9-5gULezJjKuO-Tw&oe=69FB26FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjqpR2yXnmgQ7kNvwHIVmEW&_nc_oc=AdqIeuj3kpyxKaFsdzdAGTKfmz_37GF_Cl_sxeXu6Z4FR-DYBamR1G7HkGd3YBv7c68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oXI55gCo9Qd-WUzOJm4m4Eudk2g4gWEGjOvdOWpC31Q&oe=69FB37D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP7Ks_GcJr0Q7kNvwFuIzZN&_nc_oc=Adp5e9NWxija8jWvc7FFHf1nDQ-KxMkGzEigHdG3mCoMHC3BqHncgJA9JablGp9U04E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7THhnvjOnFitXo1Y56UyghstHFin4ac7-r7uieAxrxvQ&oe=69FB3598"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
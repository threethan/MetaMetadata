1-25/499302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPIATmOvhwAQ7kNvwHBU3VK&_nc_oc=AdoRhH7JuHzjnRiNVqHbHTQMFdvLK6RtK8K9WMbxSYDQp2N-1xqDC99LrqLRmuVGmMg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrWofEWK-NoBeAmZO5JuROceEf_bCqxAr_lrkT0QYBZg&oe=6AA9692D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfFLrTz8EVoQ7kNvwFfZOfw&_nc_oc=AdoGTyCatASw5tHWkPf6DiC0gwenIDkJvx1YBV-wjANaxuZuyF-2qylkIhaYHrFHgKc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIavaybzJZn0zNoKI_nHBC6icTRvc3_UYz4TUF-c-bA8Q&oe=6AA94244"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVZqrMqEdtAQ7kNvwG1wmJI&_nc_oc=AdoEEqZSbw6Tqi0VLEqj7A8jp6iCvp6OlxuT3RIyZQiUDYXmQz6dv8k1SArw0keISjE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItYLPorpx-NfI7TniASQBAUSAMprKZcwrr3GtUBZDUXQ&oe=6AA9653F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL7GPIHhsDsQ7kNvwFPZttx&_nc_oc=Adrwr6rKXWsrfnVSBTR0ZQwGFr1Fl6sHPR-xd8v2rJNejkamON-vRZYJoH8uCeQ5_1w&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1OJ3pRjCpf30YR6if1JaKhk8h-aIp-ddcIxik17keLA&oe=6AA93DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zooOn4tMe8wQ7kNvwFAebZ9&_nc_oc=AdpZl3TpWcbHJT37Q3LVYYgimONH8n0E-doSx-XaEsJK8Rmla0k7TJpn5p-yg4SKpX0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuy__pbJxnyRQK24R0945g40hExodxL1uyz6vp7zHogg&oe=6AA93B98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {
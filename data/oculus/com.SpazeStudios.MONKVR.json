302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndDYnOUzFD8Q7kNvwEcVmu3&_nc_oc=AdoZt4SxSEUXHPuAeGREzhPQl6fE8Q2psV85PqJXiargA_wcZDv2D1_UeWRE_46rCnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MKKEaNUIv12Q141uNPs3cKx09i1L53XcS_H80KUe4SQ&oe=69E4C16D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX-8Ig0MGw0Q7kNvwGKXg6d&_nc_oc=AdrNuvIv_Jk9XlXpeJU2IhpXGdjRySpcFQRN5_Fp5NfJ1sSAmnuLXjz7-zKlOMOzeIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0drfJPo_4NnDF0N2f2wwa7fGOeJlb-eGnPQ0jkSfxFFg&oe=69E4D2C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLc1v_AO5iwQ7kNvwHyj_3L&_nc_oc=AdrCboofN_CKqf-GoTaduN58aDnGfCVGCEurDApXnWU5t7KJ-N_oajYFUZpoIE8-n6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RK4QeJtVQwJsdclRgb3kHN2UVO8zHrMufeE7G9IJtYA&oe=69E4BD7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWYarVmXc0Q7kNvwGOq_GS&_nc_oc=AdqKeX5zEm1erHzo8_2bLIshMI5Ya6hj4mqlxduxoeTW4KLuB55YBRUtIfIDm6KT3i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zxH6bbIsZlpjICjVx8LvOP5JQZu8KEOSykMZFmb7rgQ&oe=69E4CE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiUAUyt2hHIQ7kNvwHuj0hS&_nc_oc=AdqfUN-o7kEeRKLKf9vjiteJg7FVLMhqlSJP-3-CitNzE_ukKCpZLZG4QVomIXCUkzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06rbJBFerDNAX0pN6ovB2u8hJ29ChvWbunB44XoAvrDA&oe=69E4CC18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BydRJwbjuIQ7kNvwFuuaDX&_nc_oc=AdpPGYr_DxGYEF0Mw3zYhTpM_ZZYeQomxdegGE41QFCjwbO_y46tcSNEMVA7JqlJL6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdbAD3OvaNIVOo1W0HyAWbg2wCWnajfvVl1MIIGE59KQ&oe=6ACD01AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbxsXa5mi9kQ7kNvwE7iKF1&_nc_oc=AdrXcmHapxGxxfbuNyrrI1IfujGgcqrFz7BEoDCNm3NM6gx6NynViaM7MjLPyDreRh0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdIqT3-jQWgXdNzJGcXXwl70TDhNQAjWCf4oAwx1DGHA&oe=6ACD1304"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMBVUyGixVkQ7kNvwGYy7H7&_nc_oc=AdoKVQYcSoPQFCzdyzhCuebyI6u1gW6qmpyLo_7gelxKiL6JzMU5gOoGHAsGOzlQNYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUa5OEM36dWGoKjblDhOYpumnQ6ICX1PVUeaM5XUUdGA&oe=6ACCFDBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqOJr8NyHOMQ7kNvwH90X8I&_nc_oc=AdrIknAEZCxiiNF90UlDlr_CC6oeh04B3C_LaHQ51stl5FC4kHH8G8kPfvFpcfc073Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv47v_a-eCSaYn_dfi4r5KQHzNyEaXLD4D8bwCntuWpA&oe=6ACD0E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H75Ym6-Xpm4Q7kNvwFDb8Ee&_nc_oc=AdqMrMJc7f3RKXF41NVqfxShAUYmHs_YW6jkc4qmRojWihuOitetBKRqqy-mSZmkhFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOihZs3rTUyS7S5wNX_fgsJfjj7h7BwdonHBBpysMqkmA&oe=6ACD0C58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
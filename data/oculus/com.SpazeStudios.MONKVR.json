302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck3dMN9SBygQ7kNvwF8-w5Q&_nc_oc=AdoaiUna4mj2Ejpv-LztzQHa7vqu63MtN25_EINgPW-EpGa9IIWiJwkrP27JvwMCC14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62GsnZ5m42nSw9xedYXKjfDE4F5-Mp87LbQZYjm2NjbA&oe=6A0D9FED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBheqZ--UE8Q7kNvwG2v_8T&_nc_oc=AdrgGKxLM7AKTxZNZaE82vsU6lJ88iL0-t1NHL1yzUxn97vjqfvYSxN0aAU3ehP_Cl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eEX45ruhGqsSNW_lWVYI_1a6uvui6qalK_xln-ykEcg&oe=6A0DB144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOOO-5nkCeQQ7kNvwGrEJmA&_nc_oc=AdoJ60OCfZsOE5LyhDWsqH_JGV7a1kk0R14HhIOEnX7NflejxFfbgwXTqx3G7n1tboA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cUFu2wcRfjjbN-0-A1Dgm289jyNYoAgFcJeRTbsO15g&oe=6A0DD43F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t4i9bvJZNwQ7kNvwEl1yYP&_nc_oc=AdpL_KR2t3m1IR727PWcbCpwZoWcPPbDntgz_-cYLPjV8IQoe0hOeymCYJEVs7tu2P4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mgPV1SUekUpaPJ-dg84dZuXJ2fV3BvmvbzfHm9-rTow&oe=6A0DACD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rN0MegBtOcQ7kNvwF7hOGG&_nc_oc=AdqVSQMg4KBr2Xgp_KjBhuiyK5Mz0PiRvvKZw5CrM1-UtSzI2jKpG7OQkS2OmDktAoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72bQSfoidU_j1e8wZaiOxAfqMA44OJEtao9EBu1ofiBw&oe=6A0DAA98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
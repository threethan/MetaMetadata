302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5En3l-D7yM0Q7kNvwFHL3LD&_nc_oc=AdoK0D7q5A-tplLdQOOeSVulmZNllg0LEGfp8S74qsDVs1aadbl9-a75bV7WH68zduQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFwAi639ydpzRenOdnfJgvzjCcYQz6hPxVMopr9VvOVA&oe=6A5114AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZkp5ZbVEu0Q7kNvwENv3C2&_nc_oc=AdrawaToU5oW6oiUzE17ZO5GzkdrYaQjFi4g7v0lej8OcCTLdYqNa1hFFB8th4dHrPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuVDpb4hoL3Y18xW9Rf5ofQXW8qNI4unGmC1NPGzmCgw&oe=6A50EDC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSGq_B5CpHYQ7kNvwGkZq-4&_nc_oc=AdqO-xbBi9efIQHBFdOyUdOhiDH1TqKg-v4rrl644yMleMeX4KvnwCk193eriC8mlkE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwkSn0rmkOyAjlWWORaMU5xTLwxp1vDhd-GdA_V1q8Ow&oe=6A5110BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zln3tE2XWAkQ7kNvwGW1Cpg&_nc_oc=Adpuui74kUTPHdntS1GqG7IArKhRbA4ZfZu1dkgwfzOQpKKsqYkRGme-yGx2SVkHupw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjiRfajitYCWgEKNy7pljvo7EwH7UFI8pAycSmEeT2VA&oe=6A50E952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Ew91faoqcQ7kNvwELIRPz&_nc_oc=Adp7IW8uZoqOaj61S6bTMRS1q-kCHeraJLIAQNbqmgFbz5lXdIvgiOsgXoDCH5dH6nI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB218i-WlsZ6YXqrmVwOsPgtnKgWmeRXxIbCLwdKs--nQ&oe=6A50E718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0VefLlt8tQQ7kNvwEoSdq6&_nc_oc=Adk7mteqUdwyUzLNKzWz2dHwPgpCykvXchj4zLPqUEKHotsFOnz8-TiOw18M7p3OVp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0f47zQP7mgCqzJWf4VYpvCjkY_xo9wYn5vs6-aJyzLg&oe=69B3F9ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE51omPvn2kQ7kNvwHP5eyo&_nc_oc=AdkLXvKzsBwY8R5cYippUQ-XEdU2G1dDaw77V3jmYZJdDszX4dChyXyDaqUUTv--U8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJHR06hkxHg7Ig1z0IHDsgO6ji__NnApAFlY0yRXV_tQ&oe=69B40B44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCezB9k7Fb8Q7kNvwEAwimU&_nc_oc=AdmWyUJ12maK9PThrOMbev4ilxXdxANUMQ7zDXHJlsB-0y8eBmfe3hMyuAX8hYYzTPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3WsCfCoaVh1Pnvy-P6dWLChgEN0wGZElXjA1v2viKiQ&oe=69B3F5FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HYIpdSP9aQQ7kNvwHAQ4QH&_nc_oc=AdlGBkoMh0eC25kd9NyiIhyMHA6u49kcQQYw7GFAIjxt9b2JsZoYkSo3xtFRpzUNmKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyIhf9i_3oVhVT6SKarjWnLlSIf_RZGOwJp-oohAjkliA&oe=69B406D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ZtHJ7qbkUQ7kNvwEXlxMs&_nc_oc=AdknwdUKSesOAr7rS8N3CqpEHJqvSDUOKNmFcHly-0sDRe-qymUcGZhCdMga-jABZnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaKrV6ufoatqvTTDK3XgUJYZNVMN7W9KJ6R-1sh6mLVA&oe=69B40498"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
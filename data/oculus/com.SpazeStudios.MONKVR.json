302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ6pDJwZ328Q7kNvwEOREZK&_nc_oc=AdpEFwsCqVUO5jPg2XuG3-dFpnvItsI1HfFu_sCZWYo66yG4WDnjVdsBd6PIu6C-2Ik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPlsFvksXkm5jUwDjJGssL0npS7MoVEB_5tbXdLi1Cyg&oe=6A75C66D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsTbn2jPE1sQ7kNvwHp4eWA&_nc_oc=AdrZZYUJm2tht4ihnN2BXM3hDpAJL82DRMksCm0U29jz0vvwKLlP03VYyZVO963nyRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQMwxNMa7Ys3dWXwjgZfoxu6wPti_Aymf1DBh0wgJ9dA&oe=6A75D7C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp7yoxxFzTIQ7kNvwHTt_-q&_nc_oc=Adp_-K81mM4yHxIT2uJyGLRrlUEGSY32fAnVvOdAEGXTUecd2CkGrL4dKcuiEZsI_F8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE51O2siRVUW5JwcwBmTkcS4j1UWTIchKrmHvZQURS5Bw&oe=6A75FABF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WEO5yC-nOYQ7kNvwFbFBhT&_nc_oc=AdqucvoA2KCak8-7sCuZ50CVq2z_lwR4lc0hMm0_JBE3jNLBAsnw3n6cmW3O9ofrT-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0mneyO7IY2lshLKzxiBBxh9No7chZg_HSvlmRpyUEGw&oe=6A75D352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Oo3DJbkmUQ7kNvwHtARto&_nc_oc=Adq3azrAv7nwRwX-NI6TuPrnL1v9fgHUuO5zY2y40gpmvxfs3CJmLC6VqktLfXygGSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCiT8h7u7KmTm_3Vi1iq_ZPpk_N0s9ISYCitkZnGyXMg&oe=6A75D118"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ydj1LqeDXDUQ7kNvwEg5NUm&_nc_oc=AdkRiKtTS-iHkMfVvhsPHYTU0YSHw9nlnUBFvUzNCtt6OLPFrIOhCZ84HquWpfBUKBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzdqGtRhq-gQseyyxdLjLOHcrU5-CtzKF5H8qpaKjleg&oe=69B2A86D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE51omPvn2kQ7kNvwGtSntK&_nc_oc=AdmP6NyZWNEhja9yHJyS84LptJqA97OJhJB1fnnKoJHcgQjF9HbiZd0WFCwhG4v4wss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxBw68p1sRwdc0KGWm39EtFQIPbm-CZvI9B2nyEgumIYA&oe=69B2B9C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCezB9k7Fb8Q7kNvwEoOIRK&_nc_oc=Adk5zwFY6DIODCFgpPIwakJHsqg2elgKTmUwu0y_MObATDJtZ16Wog23ZwrZrF2FLuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8xyfMI8h7eNj7l2HydgLTHq6YYLKML-XAbhySAGDiCQ&oe=69B2A47F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HYIpdSP9aQQ7kNvwG7MwCU&_nc_oc=AdlLb-k4ldGRNHiqnQgEZSu7cqQC4ZsZ2W4yICfgCG3zJkjQL0oGQADKfpW7gDllo4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-cn_0pBQ08P1elf-oGVVm7HfCWMSF0tHy4u_sVnDQQA&oe=69B2B552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d71Xponqf88Q7kNvwHFW-0S&_nc_oc=Adm7lgPSGsLj7dJShivMHRrgpWxOF4TnpKvbbd8JpXM9IuA6pgjI0zzH_AeqnKW_fiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIsFe_JLcOBW0HQtv8y78WBFCHboHez5VkE4uOJ-wQ1g&oe=69B2B318"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
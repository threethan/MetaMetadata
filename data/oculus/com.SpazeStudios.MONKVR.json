302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_qKQUiyAnEQ7kNvwEzGF7Q&_nc_oc=Adoj3v20NUf_FoZoEVSj-F3DAT2RC3MWTxcbAp7r6UEl_Pe_fWZIkgGUvrO_YQK6g3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM8WpFkpyo9IOUOsBM-bHrXBqd0dvl1X3jb8C8_6X1bg&oe=6A5773ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gonwgm8oePUQ7kNvwGohzdO&_nc_oc=Ado6CCOGnIiCp21HN_O_auxQrkU2off_tmB5eS4G66g6HPnaY8O1OaDm_pN_KiYpL64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYwG5KRXZ1YxOOcVwG73wfbN-hL9HQtDES54GrDFqHVw&oe=6A578544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpvwSEp0lOkQ7kNvwGvDHzt&_nc_oc=AdrP6JZXcvLvWK5TNhjCdW86tg6gEmYoKppI9VbRUqEYY-FDjlvRFSPp_nZYWkbrOaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBijufvQAQ0IxvkScwZrm5BUDgb9ln8aHD7jhfXahq6lg&oe=6A576FFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXTIZfCY2Q8Q7kNvwFSzVPw&_nc_oc=Ados3MT2PTeovmkt26dg4xAlyBjzqqtJ3GByNjYRu9FC-22b-wFF_maJ7hwASYeDwHI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUZciW0bLLLgaGdq-jqyUeXrzU8w6Lv-GYjlmgD_3vOQ&oe=6A5780D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIzOr-xnHKMQ7kNvwFaRNTV&_nc_oc=AdqvHHfp71jnaaK-Gui5LLuDkb2ixuTgYygY3AiNByd4Bl6N-RwAs3VOhKVnciOCs-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkcjbRv7bx0nWasYyFCFGSqTonle9A3gpQsSyuuTWVmA&oe=6A577E98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
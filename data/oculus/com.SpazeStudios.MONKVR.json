302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BydRJwbjuIQ7kNvwE0ixTY&_nc_oc=Adq24IWI-aO6YhRzwoclE2_b-t0nUcSca1Jgk_es3P0mDFGh6J3ei8AcGZgn1dvazLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxbaSSH9BRpO-09aycM8_s_gbGLwKFRpoJbCvhE_wU3A&oe=6ACFA4AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Snx9WdBsc1IQ7kNvwFFqiUl&_nc_oc=AdrCymQ3QFaMxJFHw3VZR3Nktl1I21hJmfNvH961APYWoeKqdRVH08Tp3r6fLWmE2Ug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFkdhw0Biq4l20HjY8L0vpICoR0jNuyhfIj05MfWn7ww&oe=6ACFB604"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kW5N8tCvZoQ7kNvwFxc28f&_nc_oc=AdreABADnUhwI-i9YHe3Axg6pkOhkmODjrN60tVLY0mOaC1Jh72zODQaczQB95BHLW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNELcWgZwt0hMzO14h4rVBTfdb4Kjfig3d1KsiN3mn-cg&oe=6ACFA0BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28EpEgPxvhwQ7kNvwFItaXB&_nc_oc=Adps3wzwrAagN1uryehmMXf3DPVODJavvHM4WXUVkdpxIzcZzNiQ5htCnEu1uQXrBEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6CecRsOFjpr8z735zfCeYB9xF_phF1FB505I9ltIF6Q&oe=6ACFB192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H75Ym6-Xpm4Q7kNvwGMMrga&_nc_oc=AdqxGXRyNWCvDRnr44mLRuhupGqpteQlvqdDxOATIognHLXa5Mzuu0HiP84etRigH_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZD7zRja3tCstRlcVEa18TLVRPEKy8W7BdDQFR1b_YcQ&oe=6ACFAF58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
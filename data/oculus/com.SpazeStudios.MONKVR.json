302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG109C0PuCkQ7kNvwE6nDcj&_nc_oc=AdrPhCDiB_HbJejOwe9232HvxXXEH9ucAOlwbt-FkrF_pZZZ_Z3zQGRnOD7SOlC-MoM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xZh5TUWW7mMzSLMfCngfPA8RZj8UdYYTEMw5apPPwQw&oe=6A1B072D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_8i5PD_VFoQ7kNvwF4tAd5&_nc_oc=AdrprIeCAVBAJz9pbgg-Si2KB5hus2OQ_PSzqt3xJl-XDJoF0DqIvHFW6g8FWb21enA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PWtS9qhJv_YEmlKLefQXOvXO4IdAu_OImEB02K5geuw&oe=6A1AE044"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QVoEsc7r5YQ7kNvwEWkCgG&_nc_oc=Adrggj3ES8RakuJ7Y4FZ1TVITcU9ziWZgW07GZ11tvWyJFSyElZNJ-L1OdWeGgmrbYI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NGecyryPihI4qg_VwM7a6knnvdb4L035KQadlREct_Q&oe=6A1B033F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxkDQxw5f1gQ7kNvwEnF34q&_nc_oc=AdpfcflIkeR8D4QdTWcHPMmhzeZVmiNn2ft_933RTX7Ckj_hqW6cg3VWW_PzoMM6Lwc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rTNFU35N31F928ZSbXn_cRTTRH6btd6StDq3oW0vgbA&oe=6A1ADBD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ambVuahTmXEQ7kNvwHymogC&_nc_oc=AdqJ7SEwMaRmnjE3nuYqkArTlTcWxhvm1GBmnhsYez85ZHQcpeowvU2dZg4Cgi6JCAQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-zDtcZRHPVm-ZN-n60Y_kIUgKoM7sT5wUxXhEjJM44A&oe=6A1AD998"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
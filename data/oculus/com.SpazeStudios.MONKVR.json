302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJZX5njZV1kQ7kNvwEGM0n2&_nc_oc=AdrXCa-0vIU2U97WPOAiL38uUC2vbttRpvImcCfw5QScmdIuvsVNXxFy8ahW40FhQ9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S9xhgN7xDmsTbJI8ebS-LGxZ4kZfpnJcJk9DnK9S0zw&oe=6A15C12D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hKbYRZgDh8Q7kNvwF4BxzD&_nc_oc=AdpX-4P7IQTiMq56KyPemaTL_T1X6p-5t0lOEfmSkAMi5NlaT5EzoxazxEwcy-KRZ2I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r5RWtrq5FQ5g2YroaFs0nR9YgfPDp0BceJizsEfe6qg&oe=6A159A44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evPfF1WvTfwQ7kNvwFo_sOf&_nc_oc=AdphKtF9VjLFMjH960l7KBc9a1YJU3o9dhtl_4zYVI-yfwv9jV_qgsfhzXtMEfdi5-w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xeNkw7yye63TRMb1yk2GDXhyBOV9EZOwhTnnx2biNzw&oe=6A15BD3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4e0fytYRMcQ7kNvwERzSWP&_nc_oc=Ado21GzHilxAn8nrxidDLyTDLPyeFNLZm7B39IfsygL9TM9THw0BiI2p7-APv2GRQYY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4URWwC7ZQSdK69-zbC8pooXDNY-nBXK8fSx5g-4rKLZw&oe=6A1595D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQiZS9dsy3gQ7kNvwEBHZ7i&_nc_oc=AdrY6vgVN40hAdaPc6UIVmkfJ9OUS-D2saQsTeMpfs5rcKukNnppKYhludH8cgUKn2k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TTuP_2nuwW-VCQ4p8KKjRk2GCkDKieAS5a7-b9F_9ww&oe=6A159398"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
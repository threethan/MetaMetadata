1-25/499302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAxrx6IO-RQQ7kNvwHlrK9r&_nc_oc=AdqawWxNN40JTkizXm8ZiA_M83GELe-cb3DySiKCkr-r5A9zlOMVCJa53ISTfPDEfCI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEiQSnTgThkewaS5AEcEZEjfAebg-xVriEKyFRB4NBJw&oe=6AA4232D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGa4-rcAvugQ7kNvwG8Fikd&_nc_oc=Adqflamw5eN0rxhZwI2ysTOwN9ywERQYeQRz2-1T-Lz2CHdLB2g356FvxwjlNdzPVM8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyTTqVvR71ILvYOAvHjWUnFBsHGr-mNTqRwk1Z0VEEZA&oe=6AA3FC44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9aB6jVXzXUQ7kNvwEd9-YJ&_nc_oc=AdqPq7EzD7Y-niT-u-hwC4E8boRG5kc0MphI36lNMqPkJpdtUcVbaVz2Rcn6UZMsC7s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5b4MaXsesm4NryTuxtAZ022PCpBt0AXLlW3Z8cu0RHQ&oe=6AA41F3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtmoEX_K0f4Q7kNvwGqIyJ5&_nc_oc=Adq3F92gNWiooPF1ktqBmXAeHD71jRutXOew3STeiKLKFfJjdhKh-Wsv0J0kWp6CS6U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5PXs4p4vHj8uUorrg4OURfJhMOqfMjLowBp9QtGW5RA&oe=6AA3F7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSkan4Yg590Q7kNvwEr66up&_nc_oc=AdrsyEFaMbQNdyImt22ApZmkYHKFgDEX2_xVxR1R0ny5hmxxuBOeccJSnl1kGl3shMk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkhwvAvs22iZKzCwObDGayro_GbtxfXUQu4hbK4cUXmQ&oe=6AA3F598"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {
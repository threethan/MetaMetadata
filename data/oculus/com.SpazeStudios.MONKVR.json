302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzvNAoVVkjEQ7kNvwEP5xmW&_nc_oc=AdrmStySUQZWmttE00Ubfg84lw3qYGwlXcSXLvBQPwyZOSksFbKsH54N88EMp3Auzv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1T_g8JRD1IUbiZdLy4jYxmNjqmJr5lCIswWwZHWQFjw&oe=6AC275AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szZ3l2Mk7vcQ7kNvwFcRlmz&_nc_oc=Adq0Kmr2zCr5fShuukchZGEphqCGMLi7FqeacaKbgm25LNgekHCyc2WZcEgVTi7F92Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFVfUr6iKp30V-QgVOIA_TgFDrUHU43SK2AhYorjGbig&oe=6AC28704"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld0jdUA-8SIQ7kNvwGuVA0p&_nc_oc=Adp25RF00XYxnjbvWaXN5Wxcfug710HmnVQt69Jw8-NaGWwVAR1V38XJXbzd5Hv9kWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqhz8AhUlUgfOQ6mgIIEEEOwcryV0fFLFypFipa4z8Mw&oe=6AC271BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-xWbXD10IkQ7kNvwHtccVN&_nc_oc=AdoDn7TSjEQaXTGbu5sD7mah1wWqnzzg9YvGS3nt0WqplISvK929GWhzj7gTg83XaQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPNAQz2P0vm-g-ccBKrcqd664io-zEEYJ3rdyu9__nRQ&oe=6AC28292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHnZauoKMjkQ7kNvwGSfi9A&_nc_oc=Adpu7jWA8Rj3CfnEro-mf9H60XUDjcS63ZmDotmidatj12p1vd65yk2g_6DICPIn5GI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP75DSnihSJzrs1k9lsbCl738ohBILFffx8k-yrk-4g8w&oe=6AC28058"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
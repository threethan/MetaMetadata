302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf_9KxOGpPUQ7kNvwE5Yz-J&_nc_oc=Adrc_QbUZK-edLSOTGnoTOFe57N2Qr_tTbRIZynihnnnF_deDBLN8wMb4TiCgF18taw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPb0ipEGW6W8CfIm27xcTMhc49rA2h1GsOiCTQ7Qf1vg&oe=6A8C2FED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocb_s3hov1oQ7kNvwHOkVTz&_nc_oc=AdpKLdUrNkpFPPyrwNihs8V2rQdpH8uAKw6AcX1Y7PQC7I0grRdsG7yM_o4-akvKNhw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3YSbRIDzA-K9SZSuKpvMyRaN6J7pV189Px2f89_qLew&oe=6A8C4144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbZddGXV00cQ7kNvwHTQlMw&_nc_oc=AdrHkaFmmeCLZO9u5shtneS5SnamHBO6PyX3OcQa0NX49LNEKC9R6hr7GL97D7QAnl8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECDJ47g4gTeMxMx08bAQyaJp9oKGljCFj8dPFxl3SSsQ&oe=6A8C2BFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVngG6Tpjf4Q7kNvwE6qhtj&_nc_oc=AdrIwcJf0_2xc9-89YJxRoyyli-lhIlY1JrgU7i_AONqys6_n-8zLP9GPHlCJO7psDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn6J9Khg7R8YzAjDDQnbFK4zMzF2WBjjlaEBF5zxKhTA&oe=6A8C3CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1615e8iUGnUQ7kNvwHoActb&_nc_oc=AdoVgMC_TQKRc4JoaTFVOZoirOSTMHfFLlLabIQTrsdBx4BuEWsgDiABucNRYBbPcW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx1_gkCNXL4wnxlsswhNFab3UC0mKg0rDIT13Yc9TnZA&oe=6A8C3A98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
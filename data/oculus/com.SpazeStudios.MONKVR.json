302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tvyLdK8vOgQ7kNvwGvHvJf&_nc_oc=AdrC6Wql4vySC-O1htpKt5es9OG080FZqiPjTWi7e8GkbAGAyHWjbuOZaotkbtur6mQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ardt3zYvSftYyBxDU4d-UYdZgzh6NjNpGxRPTj7hQPw&oe=6A301F2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os8MpB8kUUsQ7kNvwEIaTIi&_nc_oc=AdqSdk2SkMxqYxzan_X6O2V9A2K9-mYSvDXNnwgzTcKQjGvEL808xtsC9ClEFpTQDxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u-ss-7kKUfyKPNYSepximZ2r7uDvEyRfY0AZfbzt-Hw&oe=6A2FF844"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3oPqbxdjsQ7kNvwHg6BoU&_nc_oc=AdoPnh60tfWxESj-SrT72KO28XcUOS-oUPQMGPHwfvRLzl3Dm3t58qEo03QxnbfsDrM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Da1Imj6P1FUXY0v3QdsKyo1uVQmgViR5YQw3ncwj7Gg&oe=6A301B3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Xn3M6REDYQ7kNvwEBiByc&_nc_oc=AdreM8AucfiwJ0uuFcn_CQpdZR_Meb21eyt_YuZe94SRDw5xgZLinb1LqA-nZsuzQMA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yN-xnxmjVMeg9qiOQzjALuRo_z_byZgaOWPODu-xngw&oe=6A2FF3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XE7qTP098YQ7kNvwG7aX1z&_nc_oc=Adof3ISnPhwWgFoRNWtdT3yNcr0ojdUvUjUd74FFSuQ2KE95qsrxQgHn5wWqTpH5SZo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tYnV2oMSvWJzLXvlO55OHv25V7pxe4D_pTPyn7Ym-vg&oe=6A2FF198"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
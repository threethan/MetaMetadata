302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndDYnOUzFD8Q7kNvwFfA3om&_nc_oc=AdqmYea57SJ5w42l1BdFxucW7fF7nyUTNZ3RlQKMkSRuuYU9YueIyWf2OQwlb6xy8Ts&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lVW5APRlArDCQ-nlGxqPYznR1S7bC56EKHSYbykdrDw&oe=69E612ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX-8Ig0MGw0Q7kNvwFHtToC&_nc_oc=Ados-gxrCP0UjTriw-L8YqlzeWXeGonGYMVaJzdigXeaf8gwG6a8VhUryfdAjiwKfLs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UZbn8BbeyOjIiFqpUnOKPgMLzW7ULmSF_4tCFFiIlxg&oe=69E62444"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLc1v_AO5iwQ7kNvwEiYW7-&_nc_oc=Adp8oH593FmvgnWndXSNxuokuSxaRNp4JvVJdKiY3T4Z6iiUr6zHftK_-U850OdmNMM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pup3f0FNN80PtZUdXEzB5NICGgvClxhkSKIFlIEB4GQ&oe=69E6473F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJjXr0l_tRUQ7kNvwGCuf9T&_nc_oc=AdrO3_BMDSW4T8L4gk7PS7WIjTQWnV7sA4WHKdykPQYmiSXGIZlrFw-qW5OBCkpZ9_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af058S9TOkbD4JKatCqAYaV2Lj8OrpRrO1vSKGdmsjaJHA&oe=69E61FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiUAUyt2hHIQ7kNvwHhltBs&_nc_oc=Adq-R-4BzBlnDwEsSUM3ft22Qk6SvJPhLijvGaYEHBJmn4uwW5jv5Wn8-w7H4UWDNZ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mKs3H_lEGy3LrpoyGvFp4Cvym13udeyCb8IMvzUYzhw&oe=69E61D98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgNt3gDHdiYQ7kNvwEc8y5L&_nc_oc=Ado7SQYIKnq6mO6EojK6SMUaGv5LluTx8taBu4AmNeTukKT1OOoAvhuob_0rexW0UPw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsxMzAft2A11X9kMUQB5mQ3nkXe1qJYKYBGNHGrSgFMw&oe=6A9EDD2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvHyKCvJBA4Q7kNvwFS7fb4&_nc_oc=AdpCGkn6RAqQznPGHGi7GCHUpmvkAy_xp3SdAEq4jHO5sKMsx-TCCfhbBV3o9mw7TvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHbw5a7nMHjvuXlmPcRvq3I-hkepVl98JpO1MS22ev4Q&oe=6A9EB644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgRsOBCFG3oQ7kNvwHQj-Sq&_nc_oc=AdpyiSl5ASNHp-7iS1j7OAQGj9xowwzZVwIMvFH87K98kCpBx9gVMnhWTubNKCbSlH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3ejmRRDBdNxNk5lSM5VUjjuLahn47udVOdT_UPjWCXQ&oe=6A9ED93F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQgQVw059LgQ7kNvwFdB9mJ&_nc_oc=AdqD-olONG6WSm7nKSKodqVyILOG5Dk6_3SFRoVd5FGmZ96kvqKLK1_y7wTFjZY7inQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrnk4M32-O02XguBjd40Aljjphi8ybLCbeNq92PTnXOw&oe=6A9EB1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc3VOLzh8HAQ7kNvwEzDFR3&_nc_oc=Adp-jzIIJzzVYQRLG1qiPSgpvCnfZ17On3Iq7SiyiFyq0KcPHmK_mYMH3_CJBbTy5zU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3tHVcfYW9E3_H7bPAIAUOxvfd8AH0Bxrxc_Iiw72UdQ&oe=6A9EAF98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
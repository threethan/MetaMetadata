302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzO_OUyWNSYQ7kNvwF87y3G&_nc_oc=AdqV2BjZDrQMsTbIpLJK_SY_pIW6DE83XiRNHi3iPTJur5evkfP7j7Qz02LC3_tTPTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZM0O-bNTb6WxFrREF0Ve40h_eWWSX7e-4SepvewKDAQ&oe=6AE219AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYICM7lj8e0Q7kNvwE41JV_&_nc_oc=AdpU5Dg2z71BMnqRDehk1YF4hez4JQvtEz_QpUAS_MMhBAPhHGGjCdzY7i_-RKEkBLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8GZq6qcSG-Xmg0EWtTIWiYjIWZvQV9n_f-DDN73Hq2g&oe=6AE1F2C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIonwNv2zx8Q7kNvwHZCMtM&_nc_oc=AdptEe_zm8zDNMloaEXZvfiOijhYjloKFW0x0LtBvxwPXGMit2RvTGmvWPLyx3p0R3w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsfX3lW07eVeBjLbP_TvhW62V4qR5VnyCqavtX_O1Gag&oe=6AE215BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L8JfxzpKHoQ7kNvwFIRvMS&_nc_oc=Adq9MBKlZSacWyuEnuINsGTtLmalFuMDnAe6U4vAjzNi5i5hZsjSLg271DK1IAZK0-8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0fM5esyR6YtHgqp5pxqOKKBBkMlGGJeVUs7CrYG_iNQ&oe=6AE1EE52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8-iVWYCr_EQ7kNvwH8QHPc&_nc_oc=AdrSiBZEOhUglL2Fz-3GVu4sMdxhQWpENcDik7-B1WHnsxunIEDLqnR6jaQerh9oM4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQqQmQIsOG_oAaMb6bNRg6yPhut5f38ukO-MOOeNP4-g&oe=6AE1EC18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
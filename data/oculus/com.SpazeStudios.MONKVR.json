302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ6pDJwZ328Q7kNvwG9apN-&_nc_oc=AdpRi6JO4K5sPwHMVeVShs1k4UVqELViHzHC0C0clA--X1glw4wBEED25cBYw5ONs1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuyQHp7_2fDL4YlQrcE5XX-Ri5UnZpfxZW0H4WEiuUhA&oe=6A78696D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4juB4TvDKwQ7kNvwF0yMmG&_nc_oc=Adrsg6Tk76Qh-ZXfQ3TXN5mAp6ibIqp_f1RpzJ1U_kx34pNleCFNDz3HIPdWiJFvIAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5PLBQOOhN35HjjOPk9qK-A3tpfa47h43EMedyqoYlYA&oe=6A787AC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iinboYTGLEMQ7kNvwGV9sB9&_nc_oc=AdpVkoxmb-2z2KEczMkF4UoXeeQE2yGbe1qlvR7mRCdZH3NERqCCA9-h93KDjsVKtMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTV7CCmnbEJNO-30wEr9U6mcipY8eRoAgjMnGNd96fyg&oe=6A78657F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysP9Sd37ZQwQ7kNvwFFM1_R&_nc_oc=AdprZrIIvb9JC-Dx-aelZI9a7xLQkrd7-9409wuQ_6Mna75fySpGc_AB-tHyILLnFoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpolBE3xWIuTfsK4ssNPQqMH_cbdYrUDadRM3JzofV7A&oe=6A787652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Oo3DJbkmUQ7kNvwEfvc7-&_nc_oc=AdpJhE70LsFE4ii1_fZKWS022Finx53cbuHa8UME-FOniz7OyPkGaMImIUI8yaTIu2M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJW-CVKaASl_kgEBbv5XHEmzIJrdW4MikVONPiXjA2OQ&oe=6A787418"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
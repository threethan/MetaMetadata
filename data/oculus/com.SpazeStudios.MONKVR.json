302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=076R46X-rsUQ7kNvwGrZdfm&_nc_oc=AdrnQL_AUtSGD5qB2oUdG0WQjbCkhqa4KrbIo5qx3gwD3bUT9nAvKb57VxwOvW_FfjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02lN2Xm3YvFAT6Le-ONgedmENwUQLIlxkEBtcMywEJ0w&oe=69F76EAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybLhwkmtukQ7kNvwGa5eAc&_nc_oc=AdooeCpaTVLUL-9_aM5v3x7fkb1kb6OQscbZA9UUaUfokVR6jW4u-o7fyk2ik197VzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CmxyKlgR_0VERJSZ09hp0z7fiJllNHV58603L5pgegQ&oe=69F747C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA9T2EWbpI8Q7kNvwEA_IR5&_nc_oc=Adp_H9RaqkC0CtQ_hC3sJ7TGlqnT44z_T8nEFMAqnIEZln_HRlA0jHfcCU6enBxSPck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bUQp71TVsgNN9dDtf4Z944WSEl_fFWgvCr08ViNuwng&oe=69F76ABF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO67vj4JfFwQ7kNvwG-TUBH&_nc_oc=AdqQL6g-Y_lEDOn-aGfr9UMPq9XOrTEKQYlb6jeaQVmOt1KOi0M3B47TPPcpwdy7t4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af304pavBA2tkV47uHNTwmZA53L19ww5FmYoFfTO9icXHw&oe=69F74352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQg3kYtrSs8Q7kNvwF1Xul4&_nc_oc=AdoQM6StajzG9crYKVBQglOPD2A0meCVmnvEgAfM-ayU0r1T8f849aQtYbId2LgPMO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EpyNLgPWXhhZSGb_574a1_JH80uayWkDvdSPF3MSoBQ&oe=69F74118"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
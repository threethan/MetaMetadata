302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agVOFhOQ00oQ7kNvwE7EASH&_nc_oc=AdpZvE9HsnWwv-Oh69Xvpl0a1hxtpSihk3tjjLWR1_AsdqvBnHCLBu-zYSQBNMUq9V8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw7IV7kjKjJfVyBv6oK1_DebRtigk0-rYhticVn-fHWw&oe=69CFA96D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjHaM1C4zwMQ7kNvwEdrTRu&_nc_oc=AdoWE4OihTggx1MmCIDgJBkQH3mtO5awhtcax5KwOEahDJNqYCRU-gWhJ8aETtSGync&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYujV8yDjUp-8-uicp3wSIFse0_Ixh2KM1ReSpi1HNSw&oe=69CFBAC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxsb_8kTp5oQ7kNvwHck_Lz&_nc_oc=AdqKNOhSNZA3UmXPtSPZisfY1Cw5ze4xs2leUu8jE9a6euV_5Coxiu1zrR3xV3nlkPc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzer2uiIJtPAAI54BLZ_c-5la2XCm9nX8-QSCVFHBP3pw&oe=69CFA57F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O79F4TLV_0Q7kNvwFB7d3u&_nc_oc=AdpwZfNpNeWbVEAQwz79dp8gnAT0uiwvyxnmwnanM76mrNoR7R3rvUztoH3vNY-1Gfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBHGGIUVqze5KqZg-vtUieigxPLbsEKljBA3yPQ4z5lw&oe=69CFB652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6mospV0wJwQ7kNvwFd0HnE&_nc_oc=AdpcPC32wC_iGmMfoXYEZwynI_-hFei1h2Crei87ml5bJvyAi8EyeTZv7tI1FQI7mpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxk1CN4XNFTCunQeHKwe8I3TcDQz_3Bsh1EeTpD_6LVEw&oe=69CFB418"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
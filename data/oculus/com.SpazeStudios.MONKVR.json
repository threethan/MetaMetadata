302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co9kROGLTG4Q7kNvwGdm1IP&_nc_oc=AdoY5Mu9LLMxnWw5DCtnaG2WZH5RxBli09C0ed-PMQ5D3eX1aSXLHFNcfic29Y60vk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw6i4JfOXmAjc6IBGDTMD6VSBmjz-gbe1ZnmMfS_jqfw&oe=6AB93B2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uBRVabt6vwQ7kNvwElXFiL&_nc_oc=Ado8fWa_VRXC9rR21eMAYewHlhtEunYsjmQofWLXGA2c7Qv5S0XhXvCy9ZZZajWP2aQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK-uVNylfNaoFix9k1TZONczGF8F6BJ77SfV56rlnNHw&oe=6AB91444"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2n1Kh0op4MQ7kNvwHMnyaq&_nc_oc=AdrVyP2uGDucqHz-El-kHdpzMDgWUp5BdfpU0si_KlrVnqp5x0EPQMf3ipk49Xd3bck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-oSFpXJsg5W9t2uyJEhXGgh1p0IkpqB6ouYh1TafMkw&oe=6AB9373F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob9sda6dmPAQ7kNvwHvbeg_&_nc_oc=Adr84W2DxG57xRzPcJ-PyiAX4xx9QoTRs77goiK4_-q_LxsUa3tEkhUVyW2qRjLx_K0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNdTAfo1EACvwPIcBheYhHMcBjOIHQwL9_LWWxYjst4A&oe=6AB90FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zcgpfGKwx4Q7kNvwHYt_pF&_nc_oc=Adq5tCeqsJFH-YdHLCMTf2dfMnMYRmOoNE-nUj4mT1OLoUnzlmrNyUsfwaS2apEYRnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCOJ23d-dIc15uFiv3cEDsXIFwOk4WOobAWcpJ1idgBg&oe=6AB90D98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
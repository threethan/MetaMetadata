302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpAxlHx_rFoQ7kNvwF7XMTg&_nc_oc=AdrLcU6ZryecujydLSnIzwQO9H_ikl4-HRjV3YpXJLorkHB_yQ4NrjQBeTlwyOApOsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mw42RywHKLnDBSF6NqwFA4RDvTTX7Zc7vyTqZ0OKDcQ&oe=6A3E9FAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv_UQ9QZP0IQ7kNvwGxVhot&_nc_oc=Ado2pv3HOoEs_lu5-QQ9n2Wa8Xqi9hOYamXXljTQEWiG0OmKh6kLksETJiwp41rZQ7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G2yPxUb6BPL9WWr5F6500P-rDIIMZKa65INAzTQyN4g&oe=6A3E78C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rkpry2Cm37sQ7kNvwEAvkXN&_nc_oc=AdrhULEnymFvsgT7b22rxqM4VkYSoC78BxPIfAKn7TvEK1XqUfyerfX0a_FNNqfPBRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u5ZCK12w6MaEIp57Y-97oeZClsIEL9hhCqZIsii06qw&oe=6A3E9BBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qGwxjJVfSgQ7kNvwGUOaY4&_nc_oc=AdrK3i9XiR17QlSwWYCnEuaqvVxhN7JG_SMrvrlhybRKM6MTTl6TPWzIhAzHjAq3mIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MpuATzayZOO8Ai9cAN9yDhfy-RltFe17buHuTb7G00g&oe=6A3EAC92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLM24TDTZ4YQ7kNvwGBkM78&_nc_oc=AdqrwYKnfxlxVvIfRGam4umJv1LmSckkyQTP6dfFzwJk4LFuYmF7o1lgs1bIOl0tVc4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-A_8DA5UC89QWj76Bmn0RwQoGvYPOTwKQUhEHrdE10hg&oe=6A3EAA58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzO_OUyWNSYQ7kNvwGru3Us&_nc_oc=AdqLmcgu4CtZIDMHsjinioYvGgnuE2a_kWjPqMDHu88GglPb0PjIcNUWt7A12Mui4jQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOau_UeWpgTtoLdMOvW1C-xi5Gd94macifx8vkAU9O-dw&oe=6AE0C82D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H37GtUwM8EcQ7kNvwGYf3RD&_nc_oc=AdonWy4qtPxeIODa4k65YU_-CwNfY1va1zGr7dn5GXczgmM9ZhOGTIbRANhC92quK6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlrX4JZiF_7QLhIOyHMC0zC-twB5bo_XOjLfi3e70dzw&oe=6AE0A144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDy2v8tz-0Q7kNvwHVaSuT&_nc_oc=Adq0A6gvAL2T-gfDfy5vK1LPa_C645-Pmln_ErV2ZSMSFagB8mmzGikBk8nosY3pfQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXaZl3FM984szc0kA-Md7F3ga9gZB2SviNR0jDW8gD1Q&oe=6AE0C43F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4L8JfxzpKHoQ7kNvwGUvlSI&_nc_oc=Adobgg4fSRsIQCrMFtyHoQAErlzDEPykaKfB4_FewuyvSWo_vFYySKpx4qNgbMc-b4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOs3X_NzLLilQTkNCdn9DUBTQeLRCTnudYZYXbLjVtuXg&oe=6AE09CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8-iVWYCr_EQ7kNvwEyUV__&_nc_oc=Adpll96fwSkmRnKX2SKseN1CWNyiIwRgfwc_LuzdDuZzXNyplMRjKk1Lo6-EWPT05js&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxtTpbArIKUHFIJQ64nPnQjDxd9RsV-5yi1cxsDZP1bw&oe=6AE09A98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
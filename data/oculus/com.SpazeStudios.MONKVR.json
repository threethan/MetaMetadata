g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqDlfUaiBFcQ7kNvwG4_Zuf&_nc_oc=AdmledkK51FxmPHJwC41Jv9ZM0H6TboTG4_QQxHn-xJgxAXxvF6zHLv4JC5wx9z07vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5cAGQ6g9nAv0S8-X0GiogzVq3CFYIHfRXgPemJAlACw&oe=69BBE2ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuPwswGwIyMQ7kNvwEy-A15&_nc_oc=AdlNL2nQ7x4fJahs4XqWJvNabBWkId2F3eNH1BKS4sc4q_xEeYv6UTPKsD295eoDGe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyV3C6Nrifvj3kGLcGDvzKoT5Qlt3AWYp65Q_RaU_C-mw&oe=69BBF444"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HL63MaLhPAQ7kNvwG1uVi9&_nc_oc=Adlt16_UOJ6x9PmAC1KjLksUqfXpJGYDSbXyYXxeW7O_oAIl5GyBTxTwr7p-X5SNDYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8X9GK4pVcK9mrbgjllALpNsbG6_3ZbrLgeHX0OPaAJg&oe=69BBDEFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSg5fpc_S2MQ7kNvwGXCGZN&_nc_oc=AdkCp1QYq31IiBwrqvS76HlErtIYyc9vpmaXJ_bw3DATnLyC4n4VAKqq0tkOM-1c-WI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxxVp6wD8IAACsn4R98lL3aLwPDwWia4V6TeNUwxKydTg&oe=69BBEFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcm7gSRzF74Q7kNvwF4VXx1&_nc_oc=AdmkPEMI-16cQmboiyM0lCSIP_rv-Kg-3wxalEY521PBirRDs_rGw3Gw3THWslHyibY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxguL_KJsG40k5DyvPGROUcUfWTLt-ZzqzcbK3eN9k7w&oe=69BBED98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
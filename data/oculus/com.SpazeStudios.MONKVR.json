302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAjOfhhz9jwQ7kNvwHSyF_7&_nc_oc=AdqDOHBBsue2CpRK2dlHqYM1Jywsy5u4V2qBOO9wugM0BE6PW6SWwL9-70WvMUiTO1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi_Y7Sr0eetYKI0MJt-YXX-wW0ebIAFSuVeGux_SyTfQ&oe=6AF48EAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDOJE9g9m2UQ7kNvwHPNU2x&_nc_oc=Adp2i9Jg81uWGkQmioU7F19ppL_ySR8o52D4qYWdEF5wuPsOzb-rnIvK6dNHYHYmtg0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3ATcTnNxunynmU6fao1c8CGP7RVNsGdS3be0XOeLe9A&oe=6AF4A004"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCLpqEOCD78Q7kNvwHtdRj5&_nc_oc=Adr54vXJubSNJlghgy3kfJt_asnfQVt-d62JjUekrbCLEagEo3VjR7AIsW9zkB8IQX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzETYDUMMmr2rv8sDikD6gP5vBamtLfaHvxOni9l0G7Q&oe=6AF48ABF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtWBzFPr4-UQ7kNvwEp4Idj&_nc_oc=Adq3hFqFKe5mhfX4hE-6T8zVNZIUanVSs-W0z21vyPhN1pCpXrqHetPyc6xD6H5c8ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMJAVmN8PPEpscXqRy6p4Z9ts9dywD091hk2D1WEzx_w&oe=6AF49B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt2OA0M_KVkQ7kNvwGogFjp&_nc_oc=AdpIqM4ywcFyMFEbKkIGKPovQ1Z4dL_vVTXeYA1Um_RgooNIVY7j7r1qcKcWWA3Y_pg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjn74D1dw0LW_TxEdW2GxXzIm0BTwHzq23vcG5b5dRMw&oe=6AF49958"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIeVtkzj6OoQ7kNvwHonbXE&_nc_oc=AdqYkswWKOA7a6BppyAcmlbrvftlsU5kkCLlcW4btSbg5Rf3k5QEiSorSCjgbloLTR0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32k__ngRg32OnaeLG2GWX1c5JHmn__8bi7ez2K8oNyEA&oe=69EF4D6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTzdLR55ODIQ7kNvwGSeBgf&_nc_oc=Adp56gUUshOpnVmL55uUyz1q3yIeBV_0KWig9Z1l66MSDQ64IjHwZx3nr-ioe0QozVI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dNkpDk9kA_GAtfZhcOYqh8ESxx0ZYD3rj5_mixhmyrw&oe=69EF5EC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCOXgr5wCoQ7kNvwGZHMbk&_nc_oc=AdpeBDsbgk9Xrhpmj1I7n6CikpLfPij9E-pmDJmRyEDAEYod_wIPcIZbk5eCOGbOa1k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20Uqgz8XjgxTEXC25zs4f_6qeBdzGYfcD28Vo_lyZN9A&oe=69EF81BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud8JDgqPF7UQ7kNvwFegpcj&_nc_oc=AdqGErYo29W2WjCWLtQGHrLlldf1llWdXVlvDwAGwj2X8uf8IF1tR6F5MbsOBdo5Zts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XUtuDcT4tPdb5uvoM6PqkKdMc9v2xV515TOUUTBRYTQ&oe=69EF5A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adlmL137oYIQ7kNvwErD2eK&_nc_oc=AdotQ6rOGwxdVmHOO6Mk9b3R5kLiqeW00yvcosNgRtndVJdEB1pphBJh1ViF-ZIOvjg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jlyFgtWPYfG6X6PeMDvJ1FsMCIjFa1Iu9-NtofTH1HQ&oe=69EF5818"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
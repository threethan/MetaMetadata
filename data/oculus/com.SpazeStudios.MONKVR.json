g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-5qWa2RHO0Q7kNvwFJuc-S&_nc_oc=AdmFkYLvS3JRH_3BdX-XYimXDyL8wqoywzFSRv1Kw_hSyB3K4Z9ovvfv6qjawk8e1cU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpyaAMLIhaN5S1faJ9bBxDEF12_Z6bvLVHHEl7qB-X_A&oe=69BA916D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuPwswGwIyMQ7kNvwH95A0q&_nc_oc=Adnv2Sz_lGr1SG9DlrbHjHZIdQXaGejF-Y5Ws1ZhCUii7tG_jzAt7ogbGJ_s5cQYBUE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-ya_aEP-Z1-J78iLzosepqR5zaSOKc1g5cCX0oAQx2g&oe=69BAA2C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HL63MaLhPAQ7kNvwHs18t3&_nc_oc=Adkxug-yF9vDWH3YQBXopZkNApH5KFWJoICfmWJSc1Fwq6UD831emJHFUAEuCIEFYC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHoxn92n75WHi0KzfG2UNuZlqdWpycbA7IzTARAgR3QQ&oe=69BA8D7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSg5fpc_S2MQ7kNvwHFufWK&_nc_oc=AdmdAxggYh3hxHj_OQwnjn0nZIhpQPEa90cshXz6WbQBIzC5LKyCgtUqj9gT2GXWpq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMPO5nTmrBnejzjPnUgooM-iB0l4Xf9RgIJvb1V6_xfw&oe=69BA9E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FHhKioHdB0Q7kNvwFBK7be&_nc_oc=AdmVr_5AgC2hz5hsKeBlDSKfPm-ZiL4-2d7xkkI44w7GJNASJNM4u5XD5yQIYiNJEqs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzkFR3XMwumJll6p0tpBNFelqTTy5GB_Jqjt9N1M41Tnw&oe=69BA9C18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
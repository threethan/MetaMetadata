302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tvyLdK8vOgQ7kNvwHfm05E&_nc_oc=Adq18DwgI-0vNJuXEI3LgWH5ATwXE29jC0rgzc80KvwO7jYkLxIjvDPVs5UQ_85pwc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NsHsN13k58o0OzMUwlZcrdnvWTcaFRI7_qPnRH2U1ng&oe=6A2ECDAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5ExHVggfasQ7kNvwE8bmV6&_nc_oc=AdrLLMK_UnmpKm54y_GRW0hdmQANQmoCL09b-1aNnUQ1M-fr1VOp0luwI-buBA_vkIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9amH2xXyORsYN-7l3r927mTCvNQLwXz60S3ztRKymU2A&oe=6A2EA6C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhqsPsns2PIQ7kNvwEp3ec4&_nc_oc=AdqxvTS5lwYK_TIhw5EsN8zBoHW8NWi__qdWXAUIU8KKT4kEvH8CJPRkY-Q0NtjBqoo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2s_znziPHVVTiQWjK41bAcXrU-yJdcPVinrM8dZjl0A&oe=6A2EC9BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Xn3M6REDYQ7kNvwHrCDZC&_nc_oc=AdqGam1YdUJMpQ2Ma_64D7UO2NsWt4St-wU5odrWHfNmpqEFZHFFcxCOcyEijBUU--w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mft-JggZ7SP-ToKE8NS5Mf6A5-StfmN3lP1gPQhcm-Q&oe=6A2EA252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XE7qTP098YQ7kNvwEG0tHf&_nc_oc=AdrdGHSxJazdb--xkS5PTFg1MB2cVNQ96w8ktcvCPRSS1fa7BwSZDxL27BZPjxnBXcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TZD0q9EiENhpFcwWNQJvTHpJuGttolrMJbXXLYo0NQQ&oe=6A2EA018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fCaeNqOS-4Q7kNvwH9JXJ8&_nc_oc=Ado351jfxzd6eMjX3NvSFHX4bP1JJ7AP-kqXYUWz1nDOhhyIY4iJCIL9ROiDl_BKwBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuKKWjHW0jE2CarmCrBgR5w5mfMK0nqD8fTcz_U1Blnw&oe=6A63516D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SugiJQ6FBokQ7kNvwFFl4jj&_nc_oc=Adolv9sKLBDb8Y5HIoauiuUdF7nASss5P6KtL1rZ1fHh04Smk8639WxLtRqof_HKCQE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7ju6glYscmQX6pu1XQkWVxrZ4u9Nprw4qorfXnOi97A&oe=6A6362C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qijUQ4EAPUQ7kNvwEqQ_Wo&_nc_oc=AdpfCIXbVlHuS25VI3LARL6W9RhdrRMpEiuRqRd4NQIrAfiXAPYVvyDF6ejscLLvvpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf_MtZUCDgTlHKY0G0zv9C_Z9yiQ9KEMnlh-LFalpOtg&oe=6A6385BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oir6mlKEsU0Q7kNvwHh2UhB&_nc_oc=AdqbFWRGBHaiVj6Zu6jpsG9I1Dv8HWwYJFarfWjEz0sXji5V316n1e_m7vZXMbHk-4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACO9h-_I_BHHUcgdwKEE-jI1k0xYZoYrj1NP2WGIBU1Q&oe=6A635E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LHjuz4hWIgQ7kNvwHCuCYh&_nc_oc=Adoz059vBBnUKW-vpj8mHqdB5H3-kHjdKTwHcehtoLKSfcfDYA26KqyK4xyzqDfh1B0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK-FocExEX4sT9_lgR0xmIkD5ugy43NnzkU5xn8_6Cbg&oe=6A635C18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
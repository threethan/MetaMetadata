302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf_9KxOGpPUQ7kNvwFII6ik&_nc_oc=AdoRj9be2yELv8to44fPGyl5B75ZUGDebT-KMOqalRdA-FGnsPnah7w0qp24-w7He_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcHD8RYR5RPvUi6tjIvCH56CgsVXpJxrT2a94ygkhLAA&oe=6A8ADE6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocb_s3hov1oQ7kNvwGwpMVW&_nc_oc=AdrNlnbJub--Z-WNcvoKG62wtjl8WEkE1DoQ0v2X-MZ8z5Lta1mHAWK8inc9KE4KoVI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHseSXnj-lKqBoFf5p7zTaA8RgzbKkKZdlG6jHvc2QtQ&oe=6A8AEFC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbZddGXV00cQ7kNvwEWabX0&_nc_oc=AdrUgho14Xhv9NRE4GdTjcOwdvLR5CbOd-qAu2_Bc0O2MRK0dtfDWZlkPX7JBY9PyNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWlFoC7pX-IoJK_eCGbp_PS-PQBqCtlkNn-zYL2-5g5A&oe=6A8ADA7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZp3HpoXvAUQ7kNvwEu2ajB&_nc_oc=Adq7Oz1F6ShQfNbc8pxKPxiRX3aKRuAdrIcszutBJTSp7V9VBXdoNFbpmQH7q4ZsqAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGweGD3db9Opecn0tFtqN3CyM-USAEC_V4YghX_VzFuRg&oe=6A8AEB52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1615e8iUGnUQ7kNvwHA5Tq-&_nc_oc=AdqQmY5C0JqW5JMzpTF-4C3lAgCVbRupE_G9OnfOdJFeIcSmulmNCj2mC1zJkeTZpiQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1MKl3Q8FobT8kAtcWLsJd2S_aTIAM67Wa8fnQnWkeUA&oe=6A8AE918"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ydj1LqeDXDUQ7kNvwHLvdl3&_nc_oc=Admmfh6yfC1FYUrmgRt378zagJHEbzScTwonb9aNsZ_hnw83PDLM3-I2MxmeCRGDH9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyy8biZpOTcZx7KM1EjnziI1ytQw9V9QgyG8lVvvT2ERA&oe=69B156ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jE51omPvn2kQ7kNvwF_IxC9&_nc_oc=AdlV-wQxo11_zQQ_hixg_7H8Ckb2ZEpZ7p6D6aO0hx9j09eBTkrRt_KWP1IwlEcLEDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLneK3JMxnfOsFzAp8-IW3H-0rkhxCLs0MvRzviAh4hw&oe=69B16844"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCezB9k7Fb8Q7kNvwEn1vcL&_nc_oc=AdmCUuf31EFK6KHNwnxFZTWCgcTowbYzgkyRA25fS5t2By10mnlGHFRZe2KEBh4JxYE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyejWk0WQv-VPEWyz89y2Gr480KSQfrnUqDG0igOYPmWA&oe=69B152FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpWGdNYAFLUQ7kNvwFH9waA&_nc_oc=AdnrpiLBEoJ0d0watVlm5udmOXEQoS2v_k2HrHnSsj7yg2ZnaYN4FwbDbaHeHu2wKYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3IC0bUaqP5wc1BV104Snl0CUGawW0VXW2U49Ja6oQYg&oe=69B163D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d71Xponqf88Q7kNvwHmRf3Y&_nc_oc=AdkYjXSSmTF_FpLKldBrGPmIOBaXcvMgZOaU2ZpFGO3XluN7ETFbfgPYBl7ZXJsn5QY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5jov6y4kKA0cAb_h6jAAzex_Y1pxQA4anWHFN0k5qgA&oe=69B16198"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmdl0kQusnoQ7kNvwF8dwD0&_nc_oc=AdoTtCyweZLPuhq2uN0GRmIWLF0Gg4fEW7KhB5RdxkdaD2GVtUJrb499hgcejZWWbAc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRodZaLM1GK8fvCzgEfGBpToa9Q_kIcqhFji9SMZQR_iA&oe=6AE8B12D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv7c1KfDAvoQ7kNvwH18faj&_nc_oc=AdpG53YWg23YCuDzbSd2m2ucJUPfq-DUXLhPPIPrOpWDbNrKpZYFNMy4e9ipvWdIF1I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJQyg8luo0UO5A0BQWZhzu_I5HEr6Z7UVz7bpqjgd9ag&oe=6AE8C284"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChxvZ4q8LIQ7kNvwFn5VGv&_nc_oc=AdrZHflmJFziu151nMneQQVEESFM0pehW4sjFlhMgXDgujBqZKO3SSl0KE3MaktVKn8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvHe8kNWD7KqeYdlpeNMu4lGxQEBDBWXIYh01dovNGoA&oe=6AE8AD3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZJ4akuCLUkQ7kNvwH7Y_Bj&_nc_oc=AdphRUzBsJJqnCdtAzwD8wzGb8FG2ZTprmcQHYMW0SmgLZ0LiXICKDuzmCyc5BgGB98&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT03j4a1bo2y7faxuVIoCUeKvkKW63DqGzRZIBnic0ORw&oe=6AE8BE12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT5DuHB5GAEQ7kNvwH642m9&_nc_oc=AdpWwvGbpWLOBxgUupm025MmkfrW-Onc3hT6sd3DdbInsJgX_s1vP-On6TOdQlldtO0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXTkkEhZINxWVzVTbVqxOY8Nk_34rvsLw1BoHLIETnYg&oe=6AE8BBD8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
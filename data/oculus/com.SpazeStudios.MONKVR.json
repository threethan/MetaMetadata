302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0IhuepZOrQQ7kNvwHoQYf1&_nc_oc=AdrsywQg6pwFW-ipsuO9L4PWIwoKjWnmArw7vTrW8lkIA78vk1s1vQs2DY-vFNuPHwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9dRYXtXfPKT-NhSt8E10F154tH8YgQZtC9b_baCR1xw&oe=6A35652D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Or_2AmUk3EQ7kNvwGj_C1a&_nc_oc=Ado77p2vxOvgj6w4VicF0xCiDfo2SdsCtChZATzuJZdho67mVvJ5g0AXJeXEn3PUdV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y_R87vmGLopoooDRq_oFXbVIJw0zpBuxQd_agDj8enw&oe=6A353E44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk1fLJx-lbcQ7kNvwG0FZxC&_nc_oc=AdrWdXcE5Us9ldO-4ynVQlFKbkZySnewd4aQv-L0ksiOu14QDixgBF6txrzBjUV5LOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bnVPLxxS5Tj0nX_Bs6DUjkGkcYsZUc_jAMaN4z8acgg&oe=6A35613F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BeUCdLosbsQ7kNvwEuRM0-&_nc_oc=AdoMOekTTP7D-TRN7nLm8KfjSSvCtJkev99nloUqkdDOm1MFq3xV8uj9zckhRNWSDoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oxJ4O_FpCZooEniDlrj5lfouSubiBQzDNVm5z1myEjg&oe=6A357212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIr_2Eayy54Q7kNvwFef6K5&_nc_oc=AdrpRQMOjRYA9uoTm7QM6779VE-wLFbObCDpWLTfVz9Op6_h5_HvcTSHX_qaMlWRYJ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uwPVjO1COXDhcnJbw7WdSvZCtsqNkFGr_XnEg-3rlGQ&oe=6A356FD8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8mYPz0vKFUQ7kNvwGMrG8h&_nc_oc=Adps9iI-TRyPQy2qjE7CG63t3yJTUM6UFIlZAIo2GXiAXcuvGU0_DJnlXbhr2RUg8KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99gphBc5GRHzNEYrzO5uiTDRCcM85mUHrscdOxa3SFvg&oe=6A2D7C2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5ExHVggfasQ7kNvwEwXaJr&_nc_oc=Adoe0oiRRRLCHmaT8Jv8cfDIf35Hs_vZl55l6eRsetv-hOmtscr5SpGkNHjPo70EmAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jKRQm0brvNEWMmYSFRYrqgPgANckTPa-hTEQC_OdZDA&oe=6A2D5544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhqsPsns2PIQ7kNvwFN83KG&_nc_oc=AdrIqzwD8J2Quu5yaMPY6dEfNkvnQDNaxfauI-Zjf7ezToP4g_wxTiPdhj4kArpy1BA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JCaDAYz3t57O0diRZ8pWENCF5wmhnAFilM2Kz_Xei6w&oe=6A2D783F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Xn3M6REDYQ7kNvwHl9UB1&_nc_oc=AdqV5woWYKXTH_dMjxZ5q7IqX3M3fSzOpEB6i4yRzC6hq7FP-EsI-PSjos1b6WRPagw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86rTFLCik3x2qXewqrXDnioJTQ3VJ2DymVNIZdBlFr3Q&oe=6A2D50D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k8QphQ1EFcQ7kNvwFF8Qb3&_nc_oc=Adqe-rlUyT8j1-2-2lkasYt16sJtN8u751uIqrlwGwet4awxI243Kd2Okgu4SeWWwJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s1eY1OzLLSQ3BidKKSkMr3SzUvzc9esLRN-UskgmftQ&oe=6A2D4E98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
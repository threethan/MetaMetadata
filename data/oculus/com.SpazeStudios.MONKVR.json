302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anHpYEeXwL8Q7kNvwFZejB3&_nc_oc=AdoxNuBMLRtT4PYYrmt64bisP_SppLPOzpO0HKZaciCzCz9VhInxiDjNe8t1IGOPkSQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjrqUp8LmZv2GRNgcaMeokQy56KO9z0m7mZtddJDBYfw&oe=6A80526D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKKuO83TbxgQ7kNvwFM0Inf&_nc_oc=AdrLNkkBdGbuoKZA4sQjJPXWgm34RafqmlRkDOKzKoWiA5Ewwkh20q5iP7DEgmLjn5M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkWkYGacjHx_96opWOS9dxskgsGyohCk_kXr-8-alL7Q&oe=6A8063C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZQmZ1wmCa8Q7kNvwHyzVkg&_nc_oc=Adp3hDtO1xuvI5E38PfaPX0oqVx-HC3yIr2b4cSazdb7I21tQ3VW4N-5Hx09hUHNtI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzlnwXHSz5JvyTz4b9zGkpxwHj_YYle5DOCfU4C_Ztew&oe=6A804E7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxYkoYQwyiYQ7kNvwHKuMWN&_nc_oc=AdpbVRNI8slORvEYXvV2i18JON4M0aFJEq4wEZpKxo_NS5cudjCO3fAYWJwDLGlAFVo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbZf0hRNZ7Md0O3tsszkP5s7EUCOI7vlG97MtQ9BTFTw&oe=6A805F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL9_TAnJ4MwQ7kNvwEIT_mH&_nc_oc=AdovWo90rjkw223XuEmIMtK7RLxoTnQxI2pzalUmpCFYrElpovryRqyhusO1Og_SXCg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtXBhVR9DBZ8VFnSiMoF-44dYMlaf_DN6hMCfr8m-8Mg&oe=6A805D18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
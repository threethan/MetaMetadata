302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a39WBfab37cQ7kNvwGMsea9&_nc_oc=AdriSORaMaRtX-w9VTfvGLUWGUuaVxqPfW27Dy2ngcUvWL9X4Vn3maNoQ_bJnjZQRTc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-5jLPaO6tE-2t2nUcuZv7jrSyKJ6IoPjsKe3xFC2kmQ&oe=6AC518AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szZ3l2Mk7vcQ7kNvwEPXV9e&_nc_oc=AdrbIiQvDUk1lypK8EJ6O1FmUrLRGNu2upV5tfGunaeXXyRX4KlgzwMH42C-SypDRz4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3pG8aviD8h4b6ITwf5ULZEoXkjs7r6JF3Fx8stREz0w&oe=6AC4F1C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ld0jdUA-8SIQ7kNvwGy06sl&_nc_oc=AdpdvBO2ZCC88IK_S8kq5HhAkmj7yuTXH1R84KQ-UNfL0i_59PigzTk7nlATQSsw-bQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY-KNeLN7p7OFgadDS8-RHSseRiKo1rgJLYU95AfvnjA&oe=6AC514BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNqYauJe3HEQ7kNvwHYt4aD&_nc_oc=AdqdMcOUg9oBD8MkI2tSzAFTZmR8AvOuLyUaiasfbCSPMVL2IP1pJdz8fpldJU2C6m4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmZSv9HvCWL_B4ccI9gAYdCe5edAjLT-zPh0dBijhYAg&oe=6AC52592"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OdrvGH5rBQQ7kNvwERFVKu&_nc_oc=Adou9BYhjOwKW1lC6cbtyfDXg8alcfeQN4EkL1okeOrPfIn3InzzypHojsjUaVk0tss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8abGWBKJ89-c2GYvK8Jzvy4YeeTCPum7n_YEaZRlxkg&oe=6AC52358"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4NKFYXHSHkQ7kNvwHy4Hz3&_nc_oc=AdpdsI0kOZnpU1yPQYOrDwSGg4OxjjzEkBTwX7AyEFzVCOyPfGxx4fFlFI-w0_vojB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jCLRaj-zCSKLUjE3wOyCzYpIZCOCt-RsBKruu14Laaw&oe=69DF7B6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxMU5HNNy8cQ7kNvwG5tw9k&_nc_oc=Adp6LFI-VghgSRcV3y-HELpJ6ZwHSMyxIjTGK5Q9XGAAPCKkqQDNwtBPTunAi0GS63g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sON1OH9-s6pAQQ9xEh6w4EB_UeMPZmKPZMq2eXDCG-Q&oe=69DF8CC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NYZPXA9okcQ7kNvwEg9gC4&_nc_oc=AdquN27QuMzjzQN6pk4rwOI6Y3KIVGxhYmcNp8ue8Dz2C7ZJrq8mFj4jxRNB0YqMT-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VffUjvgc_4DcUlmSuB3xAA4ZAENmBA102E9tboev-oQ&oe=69DF777F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_V3CmzkHeAQ7kNvwEx63QC&_nc_oc=AdpE_M0izGFwDL3M8U0l7jmLcBsuqi48dXbrbFpBENt5pRCuArD2vrgrSkcGqhwgPVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XR3tZxA-hZS_bQfEtLtSJtoCL6ahX9ntX8hHyTMOZyw&oe=69DF8852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXDKurk3bzQQ7kNvwG1ADfs&_nc_oc=AdoG3Fib9nZYHsB3GGmLb2afZKS6cToeVagmWSSMVgRKYpj5P-BkuN1cyt3TzPtHEuo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vpUQV5pdUtySOA4ogvIdVZLqx49566HdMKkQoMbSdOw&oe=69DF8618"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8cFs-ju_dMQ7kNvwF6uqI8&_nc_oc=Adqzh8dBS3jeB_kwWneUoBVNwmlgzzADJmaMGvk0I6MGJN6oS_dN55TDCPwrOOk9ajc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-vnTd6eip3H_7egrdYjKyHj8exapel2JUYDZwJyuBoQ&oe=6A73236D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsTbn2jPE1sQ7kNvwGEjsTF&_nc_oc=AdqSm035SKjX-CnNp0IJSvDN_g1JTh_6zIHwI3DVABxd73ckvWBmB7AFFS_VDgR6kDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYU2Jxdd7qzmJjeJZdskTYeIQ6WEFi4_-7Ebl7MzeyyA&oe=6A7334C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp7yoxxFzTIQ7kNvwEZCjXE&_nc_oc=AdrBxPPWGRVc0cExXz5xXjpmd9QPSHufBecYskvFodnGyG4bNf0PGDEz871LLETiHUQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD1nzOKbZjr7oSL5WPXcwc-wc56_Va_G4OEtqcikuMsQ&oe=6A731F7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRTOFOYWeDAQ7kNvwFFEz_9&_nc_oc=AdoJopqZRvZt18D_1HwGDw7d-uPw0EgXnklIA5iZ0QfmnRNtbJLpF_s_9vvIupS-4A8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqcgFOVIzoJbwa0GGzr3gYotZHq5rQHLkJ4cE34jzDSg&oe=6A733052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXA1UYZSHj4Q7kNvwELv11e&_nc_oc=AdoZGhzUNlcO98AfHvfzeMLepxvRGDKpQp0P57g6e7_rDrDuh1H27ZeoRguFoCodaEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVaofiXcEMGpvEEogECCzjb-Yq26IsqCG_wHccLHZWMQ&oe=6A732E18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
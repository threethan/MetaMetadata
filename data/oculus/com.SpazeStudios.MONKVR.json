302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAjOfhhz9jwQ7kNvwE6FEaw&_nc_oc=Adr6WHfZKV3XCu04K1QECAwoQmyifDuuF0vOt057Ou0rq_rJ8GpPj3ZZk1sm_xfocz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL3A-wxcIVdfTsbdb2e0v-3XBpMxIBe8QFGjSI5tBSuQ&oe=6AF731AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxpKUijjQ5gQ7kNvwHT8cRU&_nc_oc=AdqwVGQqeJ3EkSoXaLySwyGaReC9YqVOWTJS-QOo4yKczTCdH8DHfq_5W7quEH0nKsI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFME5Td_NI4nmgdew-A0ENUXdmqQvnG3mXxuGTaEJt7g&oe=6AF74304"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7AeQDAsgfQQ7kNvwHv-1Rq&_nc_oc=Adpi6_y9JR6sXAhKrDvaxU5MpMEoKVi_SBc1fTcPmnAM1vQkNpARrOdFOo_3ZlIHn-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhEbOgLX4Drqm_95-1GALWiYJOKaKPWMashtEn7MmQTA&oe=6AF72DBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2oJpdmOfrwQ7kNvwH8OSdv&_nc_oc=AdpvUC15p1Q9U2_0yqXfieEWSM9OM72TRWsLXwNObut3iB5R4sxC346a97hIJpxMPKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbp2WWdj8QAD99plDRieNVIQfccyyoKIxhc1sRtJCjxg&oe=6AF73E92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt2OA0M_KVkQ7kNvwHlVh5Q&_nc_oc=AdoVglYG4ErR1h3HiVNWwCAZU8-UJ3xcL0HkLFkeyQtk5VyeHi7teKotFKKt1USvW7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQugxjRrv5CakUaVoaANyte4WKU2qLvwsmjtaLhXPy5sw&oe=6AF73C58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
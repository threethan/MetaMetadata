302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgMWY2fSwpAQ7kNvwH4XHc5&_nc_oc=Adq52fe5Pf_K-NuNbaBqM5eJK6uEjKcTFhJXGmQWvXbWAdUwB4DqFW5ZFahwldGf7Xo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afysq8LOb6L6LALTD6uAmUlWD6Q3VTmb5ir3-KP_WPzFow&oe=69CBB4ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC8EZiJ-uloQ7kNvwFh864O&_nc_oc=AdrYVGb6r94subXfstZfOtpHyfBOZw5-ucYvQa_87ANYVAaj5WCNMGr3UvICJwIdu1s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylMoPI2iuKegzf6V5zm8R7cAB-_MscK7RC3iqGuhgY8g&oe=69CBC644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvPqyebKyp8Q7kNvwHI9qgM&_nc_oc=AdqRCbjeUc9Q7Z9buQwIxZ1lYImCbMNsiI1-sHxiDxHGjfVWowiPOdhG3G8lWk7F6Z0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgrYLmVo_OMW9fI4vbM9Zz4R1H_ozmdtf7pCoiXk5evA&oe=69CBB0FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQUATiAqvpMQ7kNvwEv8IQO&_nc_oc=AdqNo9C9OjswO_Ig3NyzZBdhrt8J237n0WWmV3VewflceuZ97HBCl-LTgo85daV1faA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6hqiHHAMGeecaYnZfiIl5MzJesaIteYOUeV3-AyPnBg&oe=69CBC1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KG9_aFXSjUQ7kNvwGfnWlV&_nc_oc=Adr0AadmQWZn0SgelVZ0EhxlFeZVKAWu6ihPlaCSz860cEZdHjLiB4vXTF9Ed4kFoqw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgiRkR__OzaBJsIoWzyYP-6z49GQcehWUa8umSLr_iYQ&oe=69CBBF98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
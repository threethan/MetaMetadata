302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac9uxGCCZIsQ7kNvwFSI8Wz&_nc_oc=Adoo3E6A_iK8oY7inmA_CgbWViJlId9fwD4Oln60te1zz28pE-I9DXS6AWiIPKGC-Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtk-lbkw5fj8XO7KxQeSRvvXSgN0-3FVaTAgNZoQvXvA&oe=6A6B3A6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZKX0deugSAQ7kNvwEwjWBP&_nc_oc=Adom0nN6f3bbwA7Yt_BB1RmY4nGwBS-LvUgDWuEDB1LsZmCngq2Tk-oBjNvmQ8KA--Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYdk30EO2BXze-CnnHwMK_rUX4SRWmkmJTv4YFWFdXow&oe=6A6B4BC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac1QHDCD8r8Q7kNvwHuvzxN&_nc_oc=Adq-8-FtqZH_w1aZvBw9ez1OKMhYqrfDwyYdnYK1oXfUQ0ddPhwcplfn51O83F4Hong&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRuCldq7xfcCI2uR22gcUBjGH7sd0GRkxWtl0O_13w7Q&oe=6A6B6EBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGEX44QhAgsQ7kNvwFrWchS&_nc_oc=AdqMgOAYt_a0dcjyEC7C5APUi0vtouGrSfgcQMI6PHYKBuDbyxdmMLW1AC5sfo3_FbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU0MbLIyi1LmIkZy6blm-uo6qxZB0-NrjykH6kJuhrMQ&oe=6A6B4752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCXAWXIhzNkQ7kNvwG32Eyf&_nc_oc=AdpLUQSXPFyVqoJXFcd3Ah_NhZL0CGUSqseC9oD_OekcMrP8MkX-nN3YBD2q674mOBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKq_yA0LB9R9Bi216JWPo3MViSqg08bfhBo1uvs5NgzQ&oe=6A6B4518"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdydWlrQhBcQ7kNvwGDvv4B&_nc_oc=AdoAtIUX5f9LvFZSpyelbnfY96awHAtXthf1JZjKiS5V5_vZLWM7bPIO0WHNixbLRbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFMuJMLlRZgOCUbEpkRQ3m2Gf_4ceCLJbJh2rfJcIhIw&oe=6A82F56D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38_RxRyV20MQ7kNvwGkeB3F&_nc_oc=AdqYQwZqEfPUqjXtb3VX22Z7Ki5l_Hohe3qE9EMk6qCCFmkan_YHbD528wUUHOYRuSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHifMeX32ncpCPbBdJgrVFSyyMUjzoKX_9OCkmMPVboyA&oe=6A8306C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqghVPOUGe0Q7kNvwH85VGY&_nc_oc=AdqPv989sXXL94P58nWM0Ydbf8UTYli5n1itjP1PGBjuzMpM1TaCdF_c8sJyeGs-iUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER8HSpdT7ggjTKuFtcoYDv09u1o7lSObtLqM3CQSvdeg&oe=6A82F17F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxYkoYQwyiYQ7kNvwG1jBpN&_nc_oc=Adpumfb4wMA4XZ_CeI-LrMeTsJgvrv2S_iP4GDoh-6zN3ovJc7B-AUA0-Ot0VJkPHfs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFofjfUiB7xKnTcDfptBEot3_yuYYZZ1336_zGBrXNk5w&oe=6A830252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V06sv0yFu_UQ7kNvwEpRbXw&_nc_oc=AdrJN0ODjLhNUcs-ujQ1oqTrCOJw7cHXDl2Z8eNJKt2ovlz7NMVu75lmpDEkzvxqL8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-IuLYkjWx1ls3f17aacFk7a0Q9O9VTPdL4Pua0klP7Q&oe=6A830018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
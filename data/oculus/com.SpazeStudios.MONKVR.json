302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmdl0kQusnoQ7kNvwHRAC0I&_nc_oc=AdpTae9jKRzXEVH3Kaw3RxzsPrqekbNWy9cGlHn_uxOPs7UwwBMDg4j5Am94OtN_x5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3ygnKXKrMdCBX-9qlMAv2s6c6L8lKl8J9_vm1PHREpQ&oe=6AEB542D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFp29L7EtCgQ7kNvwFPY08N&_nc_oc=AdpLyvYGXYJxi4A_JULnC-LAK4OUfdzvT31BWMrZI0M6Xg418IOe1bqYJxaynHj6lW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRA2ezgytphktVtpXbjI86fFt_6pizgqmhy-O0G7cHeQQ&oe=6AEB2D44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB9ETEGzs7MQ7kNvwFiuu2X&_nc_oc=AdoiRWQm3WxsMFusOTwNQZ91A_nHjalF103LLcg71CvJdOoQz9CpcQqYOwlcS3mDeEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKRSedu1S50_vED_cz7dZmTxNC0R3a-xadCK2o336D8g&oe=6AEB503F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPpBILbGoN0Q7kNvwE3Ps_M&_nc_oc=Adq3wo58pyhPBpf_fjo2nWFP5vCVoMDJJiy7ONesD4KaMOOe4nGrxiRORNjNRb03oWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1EwCQF4PQuWFTRR3hhfCXoSPoH1OXpAiydynQcZZ6UQ&oe=6AEB6112"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT5DuHB5GAEQ7kNvwEA4iZn&_nc_oc=AdqNJjBngJ1ogSKv5IrLtYMqaxG7XwXDb6Lz15QTDCqGMk1GSIszX9lURIP8t3AoF3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWb6EzbtD4c_NOUSfdPTqXDZkcXnEI-UQhv8Qq5cHZsA&oe=6AEB5ED8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KloLgDt6BEkQ7kNvwEF06C5&_nc_oc=AdrPkxMbsi4u0ztH5mIXVgbU8ZozSFSDO-G5y40NfG5Zu6oaCkPeEtJZVrl9TaZfoeI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s0-ZPSRMfHF5Fr38zdsQHvw4hbxCiNhKVcPxkI1pUdg&oe=6A25932D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1acj5yxE8iQQ7kNvwGdTDoh&_nc_oc=AdpbWX_ZbTCiE1Qg1BsRTz12FIn2j8jVZ9Nv8fLR7F5irp-iyRA6DRxbDQWtNtx2WZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m6Tqp1C2Ofh94Tiya76nNoSjGWY1PVzh2Xj6CzRTfmg&oe=6A256C44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eReaBaRYAwUQ7kNvwG49XuR&_nc_oc=Adp1-SVJvf2ZqGlM2rgz6TsJYf5Gxp0AXNGMrYU11p8pGyMhvMha7qLnSooKz5BtAiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bE-GjSDRNK4jtXXaJZCm9xoYu6IIF23mJ94o0EV76hg&oe=6A258F3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYtbt0X41hgQ7kNvwFGoT7k&_nc_oc=AdpQ5q5Nk71HPN_7G2bC5jLXnvKn164Jjj5mg9zTcDXLF3wQ97-gegQWSqxuk8wz0Ww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cS4ZMpvaj-j5RBc1l6E9w3VZ0i2GkbW1r2dNW2AduJg&oe=6A25A012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHf_s-vp8oMQ7kNvwFxA2l-&_nc_oc=AdrrlbfKIsCmLVDKdGi4B0PKTmMYfsYqmDzGv5ZNT6IQeMEACQcuKLPoSk_p5KEug3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af857S8QkVw587XA4TY91CvNmGUwfukmxAuBhkP58AJH4g&oe=6A259DD8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
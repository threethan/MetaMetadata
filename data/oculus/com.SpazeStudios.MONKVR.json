302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDmDU1gN6_kQ7kNvwEZ1HVt&_nc_oc=Adru2TePJKiniWWiZHnMr14tVMRZGdJgibrtHJNfKr8gUkylgFumcMaHto_2zBpdOJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6COEzq0RNgBtkS7-uSi3H2nd26-lz4DtDWu_MEK850g&oe=6A5A16ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gonwgm8oePUQ7kNvwHB5juL&_nc_oc=AdqtRXfHGycyTAXlpuvfImxPCk8-svMGw2zn-B56wdwITSHiOWoycy2mjgDUFI7fUW8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXqb7JRYiw1jW2nJX3UANtE9IlrDPvbQvwi_y7VJ_G2Q&oe=6A5A2844"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpvwSEp0lOkQ7kNvwFQ1Xfr&_nc_oc=Adp89zcswbAWNHgodx9ozSheqfDjTuKQnEJ2RUBYAJDBnkZlgTDgJJJiO9iJL9Nm7ig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1A7KETDQOoufvjEh2sGo-Lagp36bfx1KbgaDHgbpbig&oe=6A5A4B3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up9PzHihlecQ7kNvwHxm-vj&_nc_oc=Adra8W7jGlPzpXg2PFOJbiTsPYQ8YpkY85YwGMaxyN2arIZcvhHtQQg-iL5Jx6fI940&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYWI7v_KplfULT-9sS5QQ8iJNit9ec0_eQAMQVZLZMyw&oe=6A5A23D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTHpT20nsLYQ7kNvwH6qAq5&_nc_oc=AdpMuG8n3QTHnV5_YK9cvZplW1PxIFDccHCwhoOhQOcxNt0lA4hPduC-0Kw_bdoKqKM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXpeUyx-MVbP7DBWF80vF6ApuwggHWB5dNFAfxEKIsZA&oe=6A5A2198"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAXnFDXxehMQ7kNvwGxP0Lh&_nc_oc=AdkQLhOnPYPlltQC7KR8UyC8WLLSTSqLu1pBrUKEI2Eu9A9_wXgRx-RBPFSGDIJSYkY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjNGHxrYzpqk0L2oRfX2hYW56YvI8LTa2D8USBPnR28Q&oe=69AABF6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48utSUB-CxUQ7kNvwHGiCe0&_nc_oc=Adk5nzON7rZxF5gOGHiuNPZNE7aOmj-EEKT9VB69aEHsaHrBYMDt9VlTO3l6S6p7O-s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjKGGnSYrhGZeylCAmqEmwHtthdw4Jgpde95GsSmu2qg&oe=69AAD0C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QbenJ3jjUkQ7kNvwEsyO5Z&_nc_oc=AdnTE9ZYGhlhBOrImCMipP8KDk6MKDRqiHXeRTy13Vfd4xlYlNZD8BTnWTWz0fqDNqQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDkDQ2fdpJ0-u9ADUTOnau4lbSQHNUS9FKfwCjGfZm4Q&oe=69AABB7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqpNme8vXAYQ7kNvwGjqcua&_nc_oc=Adkttt9sSTI5pl7dG0540DyI5ysODY2sPiPf-nlRIJOMcnR8b9vFXLmlqqNu9-mvqmk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsS1hdFGP5C18oKZSB7WUQI2kHPT9_IvVfeLny6kxYOQ&oe=69AACC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6um5RH4N-voQ7kNvwGD_9w9&_nc_oc=AdnNeIVZfMsZ4VCX3vSV_UJBdWL_sN2GmztvnVuI2s2vXoBDl5xzxExTC3n0lllb-oc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxY3N_Dhy6zWBRuGibroLbRqqKWQOB2SKxHY_PKbCD1XA&oe=69AACA18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_top
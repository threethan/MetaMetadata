302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6FazAbWOksQ7kNvwFRVHuQ&_nc_oc=AdrKyQKMg78vZke6SlHXtYNteiXc_ezD20MTwdWTj2CJkMzYaes9cNw1p-fNKdmKX54&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51z404OGX_rCKwDdd9GRcrxM3TEfkXGuSxNemD1q9Bmw&oe=6A09E3AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5YDgK4IuL4Q7kNvwFV6NJ2&_nc_oc=AdpHwjILNPdf5boKj2x4vReXNKkFNjrERkXKA6akNrJBQsLWhtyk1n-oaG8YU6pOTj4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JWFB1ykn_ctMRQvQyMDiRU355x5CyxCGgarRg4C-eoA&oe=6A09BCC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryfuFcwD3dMQ7kNvwG8RnKB&_nc_oc=AdqvD7dRcYkk9pb99Go8gxh0VG5m2fC-6D-4hLETX_asckpVGtiLdZDIXYzohGmNarI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43INLeFL1P4Xq9hwiN1yTJ6RsVVJHsnfmC1-dsZ1fkIg&oe=6A09DFBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UBXkR419UQ7kNvwFAgx94&_nc_oc=AdpDx_JZZ1hKxiB2is38-30sgbiyD7VXvKJtLPVOXi3-QLGWh10ONYrp1Lh6h2ldD-c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nJEWIIW8Tpu9NgBUvB7Sf92vaUSjpTk0u9KRAN9njXw&oe=6A09B852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUjp76Xl9REQ7kNvwFvVhkO&_nc_oc=AdrCqdKT2pyLhIVZngiyVMfDcjZB0q57b4WlhGgKnDH8qHO_BywnEMMvM7S2_0ezNYc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u8iNPjdCZEgc0atly0GzpTKLJrRVR9P1jS9JROt1TKQ&oe=6A09B618"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
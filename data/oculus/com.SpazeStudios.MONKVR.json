302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK0qW-1w48UQ7kNvwHGSsBT&_nc_oc=Adoxh_USOgUjm4UoMj3BpAKA6qaapVCG0Rv0f1fiYveNhnSaGyhH5V7A-6vRR-jIFbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dBHVFfiwvIfh-JinxNtuwDViowGVtK-yALYVpMQruTw&oe=6A28362D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-KA0aMQCP0Q7kNvwGDKIaf&_nc_oc=Adr12PuR-jWr7mjHX7VQEs82plNi0fA1f8Diz8lo2cPH_BSEdJEMnjEPc-fg2SUghRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LnDDhybiuc0XcIJEonK-XnXGgN53twu3WEnwx5TiJlA&oe=6A280F44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPEQaGWNwzcQ7kNvwHnA4IA&_nc_oc=Adq2mgNzf80IrEcODy0jOWMQ1LYScicshCDergOQG-4UKQmw_2Yp3SVvx7rxAnKNkz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uI6_tRPV61w4OBJ-xL5wc1061WJxJPdX3KSy1k99QIA&oe=6A28323F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYtbt0X41hgQ7kNvwGCWCqY&_nc_oc=AdqKEHe3ySu4RbELxzv3gC8eVhoDpJRtwEGIljbuLHyNFFyylLgCSJiVsjWIEOEmgLA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JZ1GWJlKyCu7YLO7w-Za3rDJOYJZq4bCwOsowJq0Cxg&oe=6A280AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5l0oDpN19gQ7kNvwGu9XYR&_nc_oc=AdpaFsNX_VshAFO52-fTXn-rQq0Qnd700jKsd3nWFRDYqjsYqyR5v6ugQmWlpsiXyWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lryNdMCBA7WmVJ8hKRoHokcWnhsNCKk8ViE0kz-O0vA&oe=6A280898"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S71RnewKLboQ7kNvwHsvMe2&_nc_oc=AdreVoDtKz_Cn8O788NMkrhXydZb6gZxCjkZLZXhoemUDnC5KSEtt-oz3Lzj-0zbJY4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-ruCWSHWjROIrt4YHgOg30Yx2bjYUHM7rD4uib4zUXQ&oe=6ADCD3AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rrGIiCZwOkQ7kNvwFKld5-&_nc_oc=AdrL4LfwQyROKpPHxI6YfZ6MleRl8BuY7x77o8FZuMODktqntH9zAzWiYjbvRFDoldk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXcORT3bnKF1pqA0RdrPfddmX6XrHqv323unejJyg0Sg&oe=6ADCACC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcLGA9nFvygQ7kNvwEigsBz&_nc_oc=AdrGbi9myJSLu9RlSgNAufsTU_I0ZJPbFqGxz7W6sIjiXEcarzU0JgOHAEgQIc9HMtQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTWzFMjxLsm8SPR8sylWXTtCMjOJiQbnj25UyTh6uC2A&oe=6ADCCFBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DdIzQ3Hx04Q7kNvwFP6s_e&_nc_oc=AdomGcp9gvbUD9516Iv1ghlTqMI970rD_WUmEI5GJ-ScK--BN0o_1mWwwMOaV_a8hzc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_1Rg8de5pZmypd9vhCdXI0JnYXdbjJTbOf3JWVbYYyg&oe=6ADCA852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUm4tku-3VcQ7kNvwEi7a1q&_nc_oc=AdpFxiBqqDnTxF8XnGjk8Ea46T_f37mVTw2lUiLijrP_OQQADSt-EUSr-hGF0T3s8Kk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFEun2Eqdak5XtbJg2Q2GGE7yTqet66GyoVerDW322Tg&oe=6ADCA618"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMu-FG1tDUEQ7kNvwHu4v3M&_nc_oc=AdqOtEmG73pn8zziWD2mp2wOihnc539eVoxL7fiClw-JYXRi6DPD5hew7vKG0BBsgjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9Ja7rQOKJWFkE3voSIUU_N3hpkXnjVG_SvwmdBJV8ug&oe=6AE60E2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv7c1KfDAvoQ7kNvwEnFmF5&_nc_oc=Adpft3MA6E4sijbvX1IAH7sxnXrkt1i6kMo3SazHHUmNQa6QI4VlmCBByS0e3DFGYqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOImsI4Hpxi8IFEz-MYg7hw_zYqaL3pUzPY1xryPO24CQ&oe=6AE5E744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChxvZ4q8LIQ7kNvwGcTCaC&_nc_oc=AdoISyptCnvGDatOWNeCPcW-viQAlvd5riUs9_qyqixR5DfdvTzH7kL5Q3cyCr1VOUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZmxcs2C-uWAGvd1ZUg1WOSFPVcA2OYAQk443KwD_g3g&oe=6AE60A3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9TU1Ux-hTsQ7kNvwE0MDB5&_nc_oc=AdqEVdw-fOdjgvqu8Y_udojqe6pEZ6NHGtrhnE0w9ms2GsN4bu3YQ5PRd7uDgslTA1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMh-_p1dcoIbeLPvFGZdpk31EAjSgHT0f-N3kuJEdoEfA&oe=6AE5E2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yhNrauk2FAQ7kNvwHq8AJ5&_nc_oc=AdpvWHppa4RVVkdvcvkqWIjIDucy6eb_R2-JoYeG6B08DiooU0-jod-_4dS1S-rC6NI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUbU0hKW_4xrWNs8Tu7nms7V35Br_xPOvsXq9qJbh7IA&oe=6AE5E098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
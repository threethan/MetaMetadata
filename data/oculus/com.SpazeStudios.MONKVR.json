302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MLXOQ9cEt8Q7kNvwF6zep2&_nc_oc=AdqKKkYktbWvRG_UM0TFqj0dYwkNBMq8xM6hOVB1yd7mECvb4g0s0Qu8odP2Z7FDnfQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyweS6m8sxe-UDotVlEzMnLjl6ea-tPlTbXdE2-Ldm3Ig&oe=69C3CBED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9fWEpLeCbAQ7kNvwFYnJhH&_nc_oc=AdrHK0CBFBopqAh4QWMn5NmGLDcbZb4P6ztMOz3Yudl4MdHacn5uww7xLgvmOXGoNco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj0O8FjKzyRF7QJV1uLo5pzFpymnUu6JUuSCb7B0lHBg&oe=69C3DD44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vi85C37MpMQ7kNvwHOg_nj&_nc_oc=AdpKT2Jjuq61aqXa1_jqErqjELz-zZfHs1xxECkcPxeNsUI4nMdXckTcBQYl1Iaytvc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFMXXJC6zsj5fsRkodp5oMZ8Pqr0n0Yf_T6VYex9INEw&oe=69C3C7FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCzMnl1RPuAQ7kNvwFcR8jx&_nc_oc=AdoTrLV9XyI6sMSAsnmP4Ibtosk3R4Wp4TdEEcATUXZfc0LhGXkuiCWLlXX9IeMLqNw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzX2gqq5GsLLno4wVJplZ8L52q_0FWjSTIG_CWfXkYjCw&oe=69C3D8D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9A2Pw21a8kQ7kNvwFD_LCT&_nc_oc=AdqdJ4GiixadP8p8rrNnpsNAc_xeHYbMI4cORNPiLAm-Cv2r328z4zJZh7XRRDE_F2A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE317X7-NoOxn-w_jMeXILp0utv6XOKuWlCtyu-I2hXw&oe=69C3D698"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
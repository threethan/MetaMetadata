302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tvyLdK8vOgQ7kNvwGyV00M&_nc_oc=AdooLdH_5rH22psXSMET1l6506gS300H7RLFy02Bz-S-8KiRpPYkdKo3UnKnUhgp0no&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SycYO3E8SkhXfNjl0j27M781LXfM5qdvMnOMocoPHow&oe=6A3170AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Os8MpB8kUUsQ7kNvwFOfgLi&_nc_oc=AdrcLDNyhAyMMHqelHUxAQixKPZkzCjAguVpD95f1jpEy0aonxjYW1ZB2_e22kQK3Mg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rlOTFEwe_t6Zy8xG_Fhb5O7JfwSU0qdB5Bdt6sktouQ&oe=6A3149C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA3oPqbxdjsQ7kNvwEOIlcf&_nc_oc=Adq3KOdb0KhWxNGv_w-SX_t5URYnw92h8YD4EHrRmFuEu-_dV0psu8Uf8KzGe-c8ODQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ky4Sy1JxlDMqoMU1rB-VLaesVNM74fGGYZnCM5uCVvQ&oe=6A316CBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oz5_5F5OLt0Q7kNvwFLO32b&_nc_oc=AdqrG893_Wfm3MvuTDgQUHTdhRagkaqUVJ967kEsb507oybuGhAnvzB2R0dOEbUcLZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WS1VjylHxOFTwEKO60kGqontCtpnFoBIHlzHWzq4TgA&oe=6A314552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XE7qTP098YQ7kNvwF5b_Id&_nc_oc=AdoeGPRiw-YWZ-N0U7RZJCe_B1Y7FW4W2BMqtgRLrPibHPQLhrmbs4B9fYQnpNtI3fI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YAnfwcRL7fDWWhflLOtmwu3DwtXO86DHBq9Y4s5srYw&oe=6A314318"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
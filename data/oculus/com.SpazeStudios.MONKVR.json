302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck3dMN9SBygQ7kNvwHd_7YC&_nc_oc=AdqRS4yYKkapg-Tt2gWP9poXaJUY6VCwnrzk3F_l6uRixkGv42eRCPpZbJkdUrvUwns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nRZ9pgFtUcOKOOdd4f7rcjrCs2KnWB1uxZhwRzwzT2w&oe=6A0B352D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5YDgK4IuL4Q7kNvwHiF3VH&_nc_oc=AdpBfSBwroY626JFhvIiDBNQXZ1OaPzEDaTmR--3OqJ4k2F8GATQlGP7yrsvk8f9aAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sDnCj9Ee4eIxgAQ21lsvITfZwsIbZ4eXE79j9cAtn-Q&oe=6A0B0E44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryfuFcwD3dMQ7kNvwEIZRr6&_nc_oc=Adq4RCfNGjaIHISJY-l2T72PryKo9guGH9CiBzA324O5xI1Tk2KONF0ND0uafG-4SwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vj4nfY96qDqOqpBMiNiiSmuYikjbeMpdTcwD88rbS4g&oe=6A0B313F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9UBXkR419UQ7kNvwEM6JUa&_nc_oc=AdoyOLf5iRM6dgHwFglUXwc4lox7XGlz4LKfRbx7URIPABp_zBqA-zrPDSL1aOKk7eM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50Tuk1kLVx2PkfCugPj8ZJMs-B_XIN2Vr3uomBQNoTQg&oe=6A0B09D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rN0MegBtOcQ7kNvwE_3aBd&_nc_oc=Adr0Wh0-mvPCCBLza6px1X8e7KCHMgob5MCAEY9ErzMg-yHfRYp9Kf6kRrRDz3MjEL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lYFh4sMGL6uimeILKCNey9KHTrEOtcp64o8CY5WLkUA&oe=6A0B0798"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYbHZkgxeXEQ7kNvwFvH7tS&_nc_oc=Adp4ireTE9E1TgxjIBG3teKbp262XOHvqNcL0YaYmGJmlcZbU9x5KJdCXQizyACeRvU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7cnRmAt4c__lg_UqcMZW7MRT3gHiR5BZwg_Vjaheomw&oe=6A9418ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywfb--t_pUIQ7kNvwF6VKai&_nc_oc=AdoWEXJ28uhPzwifCzUqncp0HCbt9arwXGOyX_NDJ4c6EgwVE_PDocxtWibLj-gw3XA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKB8OUsBg4h_7_q2Z29J_3zAIpYxpYXkTVaLjbGbN1Kw&oe=6A942A44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYfR25MIb2kQ7kNvwGrosQ_&_nc_oc=AdrJQyFtNGPX7SzL1gIIo3wob3WnUcOOsA_MgSMgMmN6-dVcwinYMrfShEr-hgLU73w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_LIbRBb4zJDmcA94_W68E1E0SKSGhIS2sJApvZwn2OA&oe=6A9414FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRHPsBJbLagQ7kNvwFjyGoY&_nc_oc=AdpphQt2Vg7NA_tOttoqsSy5rguhB4Bm6nZp0G-MoeZkZgFODVUHFzzc5frmrBC-AOM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwXsYXMv9Ae4GNqThIgNUvd8cS6vlZTacVtfTfoyoOTg&oe=6A9425D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNr85GgmyvsQ7kNvwHRIiK0&_nc_oc=AdraKqCmzBAvCkcf2wgpUssA9STH5Fl2Vum3GaMiE2YjkJXzg2rsDQAgrPIzeoqHwbU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmRJsEEPy5fhsDeFrNOxEbDZYUeLAL7msBeB9vXjLz_g&oe=6A942398"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
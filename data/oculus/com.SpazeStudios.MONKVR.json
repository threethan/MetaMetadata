302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RPkabat_PkQ7kNvwEv9JqB&_nc_oc=AdrYkhKdp93XRYJpm-u3IdRjR-1KVb8eGddQcOh4NAaa1sDOOyoUjgMTpN8Irlp-gMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VxUi_g3PatD-988yOy8z-zZx5jI3TGXagnhCIqY8e9Q&oe=6A1EFBAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0OXQvfpzPAQ7kNvwFY8a4W&_nc_oc=Adq2VAsPl8njcYkBQbatdMgqNkipXoGdsFbZdPnQJGTOu0wpDvbpNgu3Suu67HgOhSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rtb-bO4Ws4JP4VqP9wgPsMId4ydQ15rvoub_G0VTzdg&oe=6A1ED4C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6TXXfIrzwQ7kNvwG9V7H8&_nc_oc=Ado9JmoeaCHg9mdgUQSaZkBXSvn-RuD57TCjRI7K6vhFsE0J0BypKqG-6Z_hMBkWXMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78c5x5FPtyNoUbbsTaJZ_57x46-2VxlSmkm22ocm1Wag&oe=6A1EF7BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxNoQU2c4kQ7kNvwFyN6Xy&_nc_oc=Adoi6jh95vat5bH3bRsWGadhcdRfzRpo32j5m9jmXHp6aTYYbzo-hWCriKcJ9d-PkS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sELDXF-b-LffFrXgxcvDaiNlwMh140k4DFxMvZKVbLA&oe=6A1ED052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbEU4Cl6SNcQ7kNvwFfdKWR&_nc_oc=AdoV5wVPcct3z2YelsIGnnZFGEHNCP-Ov9RSCMLJbUiyB7W6aJv-20U1cgoKeckKUCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RSr_-FTfYHX9S5gA-1C6LwbGmDvafsWGwWJcFBoSZLg&oe=6A1ECE18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
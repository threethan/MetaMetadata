302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-IXQvnMPXkQ7kNvwHYV9iI&_nc_oc=AdqUMYLBqPkYzObdhFqABjO3PriG7h5jdhzneOhayOMhyp8OrTzXbW5uXZNJV7Hi3sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu9Ab5Cv2Koc3a_z3ero9OLnUh0cJsCbIm40GZ70iLPQ&oe=6A79BAED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4juB4TvDKwQ7kNvwG8UeaD&_nc_oc=AdoqnFzcLd5TSeGSBkCNJvEDcyXFZKhj2T6pNB8GrpCqeYkksGAeHHnp4GEby1eeNEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr5ohVRzO94NLzrzL1jl97bKxOgQd9ycNT5z-Q5bS4CA&oe=6A79CC44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iinboYTGLEMQ7kNvwE2lWwM&_nc_oc=AdrYAfdIP8IYNw5ZOmZnN9WDzS2a6p2E9FS7KG-pkxVrRiK3Qnlkvcc7IweBdFaD8HM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgVCEFVTIr_vv1Q-9N4vhJUnXBz7NW6TB5C7iephh0Dg&oe=6A79B6FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysP9Sd37ZQwQ7kNvwGtlJQj&_nc_oc=Adot_7Xrm7_ugYv9MKxhOo620Xpe5s-Hw80y-q8XFjcx7OBOEiSDTmDJGiJ_fd8TDfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDAHIMC0Gq9MgpgUQIb5D5aLCdSpNm70LYicDLbllbbA&oe=6A79C7D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f0xB1m14f8Q7kNvwHp78pS&_nc_oc=AdqT9UfftPqGGKrOd7v-JSqDjL9GMm_KtAta3GEDNSAOkO0D94eBPbP29IIaOzHsMi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdYtnD9KNWkDDqb2sGbR1ROLgH31Xq0zob-wJDu9gxfA&oe=6A79C598"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
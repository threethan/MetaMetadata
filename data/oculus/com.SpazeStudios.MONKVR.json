g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ArPvFA0toQ7kNvwFcFPtl&_nc_oc=Adl7XYqs_QqIaoci1-5BQ4DK_PeG2W3jSep-dnP5SuFdPqAKwscwFya28wtbOsWj3Kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYQK1TuP_YIqP0ucjktbgoyMvGofbvpiQ2Op4_KeuoPw&oe=69AC10ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48utSUB-CxUQ7kNvwHULiFU&_nc_oc=AdlEJUKt8sCBoiFUPZcbc_wBULgnxVSYz9fEYTZN-wiEGY8gHfqHtTexSKsU5CYHDpQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzhyp10ApXqRIiYRH4dU8C9Hrk4J_DdSp-DWwmuiHvmZg&oe=69AC2244"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QbenJ3jjUkQ7kNvwFRifcM&_nc_oc=AdlT2zjfuusI_ZTVut1mL9kuwYZ1TPFN84hvSk90yD20jfJvwdTg6tmGszf7t1WbmtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNpn8ro0fHqock0S_bLF9Q43ZHmqkmVeVbB4thDwjhCQ&oe=69AC0CFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqpNme8vXAYQ7kNvwGhNevt&_nc_oc=AdnkFWQl7iCqwEh1BFQRTm4w280JZTMizB-cRFPQqoB0WhDAJgARAQ_eGjL2NNigzEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwL9sehWw0hyHx33RNiUIS_ZRCNjpWFlkPfh_gT2WEu4Q&oe=69AC1DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ATRZvQ_ms8Q7kNvwGnnpem&_nc_oc=Adkhl_O7n7NJP4NbIVpf3QZebYmm77Ky2OW1wSauv1CyL0DcNfft7yk2mzhyoQN80Cg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxelPhj4f67lZgmFt8yh0xRyGFxgwrTD6JtoD_VjPqFSA&oe=69AC1B98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
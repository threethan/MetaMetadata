302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=076R46X-rsUQ7kNvwHxCTFf&_nc_oc=AdoscolzAh0ptC6f1pRhXe1M4Fw4sXYMY7cYANCnHFcyUYImAHpBPnCgfJ56-bb9cNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dLO5VW8N4oJqAC7UPd_8aDxjwjS-YJPnbnQ3ktQVL9A&oe=69F8C02D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoYdICsm704Q7kNvwGOlHp0&_nc_oc=AdrLAk2vvztG9UhnQb_tKs36J7VUO-cdpeJTWZv5sK5u-BUeCNtOq2mN9yaZ-TyJdXI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GNTqUtJpSigEoM5khDXeLpoMr5TYbsl_RC8QIxyDoJw&oe=69F89944"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8Z4IxsakBQQ7kNvwF5vUHN&_nc_oc=AdqvXOEx2iOdPNV7EvnJzXIZEXrLnVCgsQ-zXqtUAkfYsV2gvzOXIeCoB-PN6Gw6CZ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dFnuvJGuHCITq_xseIwXsOgvSkIqE0i6BtniH40feEA&oe=69F8BC3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO67vj4JfFwQ7kNvwGd9yAk&_nc_oc=Adr8PvQdLfoiLtLmSThho_qPi4qz0KlZ7c5qbYmRzvnC7sVTmR0StlXAnDWFJIWcNFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mYQzXvKgQUum-nUJn0ynMKooKiyz9Prqar2_hsUZebQ&oe=69F894D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQg3kYtrSs8Q7kNvwHCG3Pq&_nc_oc=AdodZby6ZpaJUpzKrK8UqTuJXqo0f038OUgd_u7mhKb0vXNcT_BXZwhUyZw_FtOEmR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Tjm1S6d8Bj1GFsguq1wzSlzHGHBcXr2lxI5kZKdUJAg&oe=69F89298"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
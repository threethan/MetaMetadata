302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sf_9KxOGpPUQ7kNvwFOmsPI&_nc_oc=AdqE04X3P86KBDAR0u3KF0typp2jCWC0A1McVy_PqXjwE4zMIRBD5Tk9bwY39rbaQNM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRCErmqp2l9g8qLIm0rEGqvkszFZb-lz1ijjUcr1Bvxg&oe=6A898CED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSS3nyzMZrYQ7kNvwEIAAEF&_nc_oc=AdoU9HaYxINxNsKKqwP7PPCszv8882uJNkoC2Yz8gw_ejx60Tm4WjsIn5yP5WDzjOaE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGXzdTeLXNURAWb_fU22WfqvQxh-f1AYVli8n72splVQ&oe=6A899E44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeK8XvwZD18Q7kNvwHTzuVh&_nc_oc=AdrUdYoGsTF3yjiW44rqD2riKwDBuX-aguE1hm9KchgfQyfQacMJFEO98gFkhEsI_7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_ePq1KakkES3O9Qi1a3kJsn482FlEBD7LNAIDYeQZHg&oe=6A8988FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZp3HpoXvAUQ7kNvwFsOFcE&_nc_oc=AdoOpEOr2WGDo-QmuHFufPMjjWzflhDh_3Vk1I3sgjdEAVIp1que_P_FOs-X4Qb5Fw8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeKS-QdKNflUB_4GUsPmUCi9fEEoct0GNeeoUumyi_8Q&oe=6A8999D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1615e8iUGnUQ7kNvwHIWnX9&_nc_oc=AdrfDQMwrB6ah4CJ8aoMy6OhY5QQNnlUmx8pOp_FK49K1hr0NxfD5WcTFRv7WPwYCao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB4lpcsHUfANYbfsuJZV9qpWsSXJYqZyPXuRLnHXySyQ&oe=6A899798"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
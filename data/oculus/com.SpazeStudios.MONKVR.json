302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNK59wW5t54Q7kNvwF-ZpJo&_nc_oc=AdqNBQGOnErXutmFuJZaSaI-N205hXBt_aCXXqmull-VZjzkK9kNKubLC9ot4DTLRKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Af18yWI6YXdRD1L1AAlPdAG3GgDI3pWpUSC8Ztmx_AA&oe=69D640ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkgCLGO3-0IQ7kNvwF8EInP&_nc_oc=AdqNkX1ctaWRO3BoGk6_U3vdd3JS4eEt_xB_P6GgtJ2Cr0my0Czxu7QczKxaEYTkN6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pB9zQc5q0sY35FL6S66_ix060wPXU2vixTv2zVVnRpQ&oe=69D65244"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbEAP8xpvj8Q7kNvwFPXmdQ&_nc_oc=AdqbTx-JbvSzh4d0dZw_rd1yr0o00FZCxuLaJ0WQF8u_xxGyiEC-vs_nZayNVO2rcZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2muVuoWyrUyz6ASHW0WfH_zBAt0c5vU-OeidYFLokf_A&oe=69D63CFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOOHFGXiri8Q7kNvwF91kXX&_nc_oc=AdppQL_Lf_WvY1ZWUZkbN7lOCcZ7-sWZdhNMuHNfIzyp6kZ_qie4ECRhnG6j5u2fv0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lW0isnLSoHOyVLF8uztUHx8MfukDVgnRNfQ7qmuAW5g&oe=69D64DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFuLtjcB0EMQ7kNvwGtLWf8&_nc_oc=Adpqcnc1Grn7Mfhj64PaF0Lu9fvBOb8GmW3qgJcbOsLZH0C4ktv_VXIMgClAzuEBZ1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nHtC3Bd6-5J3UblNVYArnrbeeiI29Qha_x_wkc8Q1sw&oe=69D64B98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
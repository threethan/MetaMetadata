302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr2C8fmd3GQQ7kNvwEAWO_b&_nc_oc=AdpYYY-iE4iMUKLo-1lLeKNK622PSbY8T77pxN4LWiiITYanwrVA_XypJ3O-zSNZuVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFv6HnN14TRSeutV3mmByUIyCsi3K6KF-wsyudIUu-JQ&oe=6AA6C62D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfFLrTz8EVoQ7kNvwHBKCmq&_nc_oc=AdqQclVkZxKAmtb1khDwYbf3tQPiFw5kM7L2CxPZqwrU7tHUc-BR0zaZbgSZ0biMYwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLznXR_Yknm0d6qRlu4u7MaqnwsalT6bzKnVoZR3JKXtQ&oe=6AA69F44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVZqrMqEdtAQ7kNvwE_DMo-&_nc_oc=Adq7wk5fZG9ROIcR-s6EBPXjOJqvMkwdfibohKYv8K6TSMAdOmCKC0ZURTq4HGnlSLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiehFN6Umbuzo3WFvyNTRf8UOzgRxEHT4jhz-hJUf02Q&oe=6AA6C23F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtmoEX_K0f4Q7kNvwGpvOJJ&_nc_oc=AdpCdb3ffiDhFMq9KGCxnfpmYG2MfIcnz62sTZqoRj1cTixXQe9TLG6EdaGmJESTFds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY3-pOLiPEIy7_Q3smI2g5b3SJglT1bt4_LIBAPP60tw&oe=6AA69AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoV5VmHtuvkQ7kNvwHNRXkK&_nc_oc=Adrfz8lo8uRIg-zpqhdDjWhrDXH_NjwGxVfZsKCIv7CRR_voh5D-4XnTYn3PBz3i3EM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJre96e59JUKPZLyUkTm8J0zCqrVYdRWvoGl2D07U70jw&oe=6AA69898"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAtS1dIWXTMQ7kNvwGtJros&_nc_oc=AdrxJlYoFyXeH8lLbZfz7pwZoLDxv9OmWg3fC8wrn_OehjuBU-2JRWlup_mG_WPwYjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v2ZqAvuNzESR7JvZSvDq0rZLUP2rgM8XWfXqr44Qhwg&oe=6A05EF2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2mOouSBhI0Q7kNvwEftUxX&_nc_oc=AdpXzgaUi8JGSGUi5DDao3ICwiBPLZti5DcP2SNmQMfclfgCEvkFz5a41X0xx16nUK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VZsB_sAZWxtVFLRSVJcJFP9v6a9NLZ-kFb7ABrYXzuQ&oe=6A05C844"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl2bZ_N2bIEQ7kNvwHvwpqp&_nc_oc=AdpPoREXasJqp1f_T6f9SY11nX_Mb46Cu_FMMu5XM9qfyZJfkiOgMGG0AhA0dmzS5rQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aXmmkm8cYnZQjc_Q0E4CfHEOy070TOnKIuMhwwAG5Cg&oe=6A05EB3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us439KNHUKUQ7kNvwFgAsrj&_nc_oc=AdolT2Ens6RgnHM7H-OcHN-08iJZyIkYdL1CKnqR9pqhljeqq5_cYewaz_A1Mf-8MIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W2uifuHPg-5sdEd40O7MtWgNQLZk7ySfDfRYXK2kSvg&oe=6A05C3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqokQXIcsZ4Q7kNvwFKX4aw&_nc_oc=AdorlAg3SvnMBbChf2_oyD06WRtueRmDv0sbOIYcP7KuLp2VitbJg2fi6MalhbKo4oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MYNkaufsrmPt0pCWqDfQUmkrPLcPskiKMSu_H5XIttw&oe=6A05C198"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
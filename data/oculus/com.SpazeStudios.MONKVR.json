302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsbDz3kHWXUQ7kNvwHzTTIG&_nc_oc=AdpwY1gOEskKKw12gAtDlktotM4NYidp8PPQ1o9Rh7ga_TcaennGBFY-MH17vGsnm5c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwAIFRlIYxQayNlQ_lFu_LroKAGFkFhRdijn4QXdvoXw&oe=6AF09A2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTRgnVaz8IEQ7kNvwEEEeOF&_nc_oc=AdrW8DAMqpH7ldKsAmXyJYoIsBdc6w2ahnKH2EsdCrQ0bq2TNdFmlkEDj7_nnwIJ25Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKbGV68YZJ-tE00FcB0RY7xhRqg5frqn9mQAsIJXhyUw&oe=6AF0AB84"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stJHawKCfRMQ7kNvwGdK2Oe&_nc_oc=AdrRdM8rUj6Kbi6xQM-AFMqnP-3NRjXKSqelPzuRs_8-QZDjbz8bwL_7Xa2DZxucKFg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHpkUf6zdau91k-ZWZ1fC8opyQMt_OeumKa150DmkNXA&oe=6AF0963F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04oY7fBYnfAQ7kNvwFHyUFq&_nc_oc=Adr8f5AwTcnY9nvdBCmDU1wz-EKPWsblpSm02PG7odO5lNwj4c4XQyFJqSAA7H-h6h0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP6oJRoYKofEA4zsOF-yYB4WFcLcpE0AXDpkIsWdvDvg&oe=6AF0A712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbXksaf55AUQ7kNvwGOROVx&_nc_oc=AdoDw83sdpoc5fYyfbh6lxiWezf4AyhgeKZtxiwuRJD8j-qrRNwnZZEpHBg8L5ArTm4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkaVTsSwCtd8RTd3dh8sfXWTyb4oP88oInmyPHu-GhPg&oe=6AF0A4D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqB1xIwN7uEQ7kNvwGsqBw7&_nc_oc=AdrETF0qC5koEkxPbaUlFki-K2BsObKOj8HTmGFMHvqOkiNgCG21xYjpe5I2WcB9ckE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELwa_T_ZG44Udi7YCAV7J6xsDNzCf5V8AdbK4iK13eeg&oe=6A972C6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue-GZ00QWjEQ7kNvwENHwJP&_nc_oc=Adq_b2G4Gsuy4gxXO9O1yXlOjNeqP2eF6OYQd_vu4cOw808mGO8hwFB-B6UiIRvcQcc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSEhW0O6XLRCp6Z9KdnlUKICVUGTj0LA15r8pUgXFiow&oe=6A973DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esYjMfrbpqgQ7kNvwGB45lF&_nc_oc=Ado9CubY2fF45z-mJvn5OLxgryPE0aR2-3bCXpSLxlxkz5PCqtkFSntFCq-rP8I7C5A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNPMYx-UoiRcijvgbH4yQbg-L7S9HI8FuSAnP5oZhvCw&oe=6A97287F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRHPsBJbLagQ7kNvwGRt2TW&_nc_oc=Ado1NSAqb0xqkJPpZff-rMrT3eRpYt4Kr190t4eFwley9N_kvnns8D5T69hwp1Jf7x0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvTigTMETSS5NO7klywWAmaZV4Y9dO2D5aGEtAIL9s_A&oe=6A973952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHVmc_H1Go4Q7kNvwFS8hSX&_nc_oc=AdrsDUYlEYI2SvbN7jn_v-Np4T8lcnc2GEaxRZ4LoVug4uhpO7u8Qaia22iBVt-mE9k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb0aW_whaN208ZqhEDLD7DKwD2mKzMiPl_9ApX5BAjOA&oe=6A973718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
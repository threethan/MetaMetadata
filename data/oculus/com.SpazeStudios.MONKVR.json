302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUeRkSa_kWcQ7kNvwEpCU8b&_nc_oc=Adq4xgHxDBbUsimQC85yjlAorirkjXM7NvkEJdQEcCA74GGCGpwYo6PcXxa0iZMgMes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2q2MogMoa3kQxxoFuIyTS2Fh44DePqv4ERGHmreMm2g&oe=6AAD5DAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2IAzSmtRmQQ7kNvwE-jHBt&_nc_oc=Adppg8gu7ZsXnlwRDmct0froZV9W5gUojaYsk2GVfz8_tRp8JazQ0RX0VJ42r7v9zAc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6AT2aslYLycdwnBYP30defJcB_yMUDNG_1K78SNsZwQ&oe=6AAD36C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B4r0xPVMcoQ7kNvwGgou5y&_nc_oc=AdqJXu0gtGY0jkfGMv6wlr0vo9ZQnjCha4XPBnG2eFmecr6gI9sqrvUkICtnELmXi0I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6_dOB_gfclHAW8PXKydnBPEHQxMriOLs5ePyGNgolbA&oe=6AAD59BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txp_G8zB6TgQ7kNvwERwl7t&_nc_oc=AdoEzl_uuZqeFYRY2s0Kebt7lUSnYYb_5T7KqKKNkez9MLQ8Yu8_WQ9FLP-sDrVvCJQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd3v1zWtG2uT6xUKkADA37GgLs6LBJ1QjUSubbBtfNTg&oe=6AAD3252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cb8xXM_aKicQ7kNvwHZLUC2&_nc_oc=AdorAkhp_eAXFAKYwT0-DlbEI8ulDsmhhbdicMxyn9En7xqga-oGNV50ziiWsi2YYT4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLwVCWgeu2-EDb1fCOehFCfbkRBG5pbfUFf8jKzQ72MA&oe=6AAD3018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
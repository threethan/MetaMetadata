302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ6pDJwZ328Q7kNvwGp8xTD&_nc_oc=AdqR5qPeZfjpoDjIOy9J1i2s5qM4NPlMa_Ok_Elk5zWI6fEy4VhyMQQeh4hkFrX2sz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG48-9U3U0mcZV4cJG0E_nIJWrHAYvunYA2AxqXX_Alqw&oe=6A7717ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4juB4TvDKwQ7kNvwElPomc&_nc_oc=AdpTyjnM6UKOQI07e3919vF5I-_cG7sroT7Lm9tzEmi0puuyvvIZGblVlcH4N6zgzLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqZshFY3UGrHZcl4KXxtkw81PO6-0wHawqgNSxXlkBeQ&oe=6A772944"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iinboYTGLEMQ7kNvwH8m6iX&_nc_oc=AdpHax6zqxPCFjK6DUHCpZM0QtXYtx3AQ2SD_s3hHxYQKhaOeONFLx3RvHmCngMV6jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBn1Q31J6hpJIK4QaoiHqVwsI6lvGnT4kSY1a_wx1SFA&oe=6A7713FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WEO5yC-nOYQ7kNvwFebNjT&_nc_oc=AdoY4ko7UyWAMk9hqi-vx1w8886ojsPyOp_8QrZmOZ84dvi_tIQhEu9UHaeIVEvwKRo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8C2ezzeNZcqYHjJNwPiYp3N71u-snxgInTSkjZaJclQ&oe=6A7724D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-Oo3DJbkmUQ7kNvwFfktpD&_nc_oc=Adodov9SXOf_3HL7y6SqAkB6dw1iEq1EhPq5CyQCpXXMzeGf-2QoSSM0LBvnQIsFQJU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHhlt03KcmdBD104rSwiS1lUF3gQWiDF9X8nwBT0ZawA&oe=6A772298"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
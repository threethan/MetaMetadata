302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcH8PimBpUIQ7kNvwF6QKo5&_nc_oc=Adou6cCt2kdaMjOcdtUQF_vDAxEKoywOnfGm6ZZMTgrCa9JlLYVSuAuguCrCVTFSGoM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2H7kdfr4ZKT1LPOD5zevtQctrmdIdA19NWHMO0iP08JQ&oe=69F5E4ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qybLhwkmtukQ7kNvwFDrQNi&_nc_oc=Ado-wDFFFRpYbOquVcvL1GyOgVUjqLHevySNf20h6ukaVT1wkL6bc5bB9yrEf3hdrq0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35bFkXRUBpYb5cRlBufhowbTBjR3XCAakd-xakEBi-hQ&oe=69F5F644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA9T2EWbpI8Q7kNvwEwybt2&_nc_oc=Adowf5ICDPCgQ9B5HxdBTeDAfMzYqEUk30H6fGS7MKC1wXQwO4r27Onyb6YRU3PTqQw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pSGOHT-jepcfa07kdVT-2hlH5eSfDnh-X6UuzUimqCQ&oe=69F6193F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO67vj4JfFwQ7kNvwFvGKGt&_nc_oc=AdrgInNXP2QHH-o-p1hiHAUJBUTrJvtOY5H1-dhgB5x6hUbyDjUchywo577-7gKI2OU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17j1cIBx2DlLuJn9ejLUpN8BgMR-6Ob5rdxJE5g3GkmQ&oe=69F5F1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIYnJcmtUXIQ7kNvwHqN8tU&_nc_oc=Ado5V8OKWoCOUq2HoLmxDaU8SIw9RIYb0uOE6XBkxgrXwkio6iCsMRhpLrKSLmlklQg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_KuKkP6FHO5vGGdteq78SDRZiSFOlS7jUJKKrYq5aFg&oe=69F5EF98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
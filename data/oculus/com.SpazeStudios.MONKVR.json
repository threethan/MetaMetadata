302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvQTqsWykNYQ7kNvwGVwi1P&_nc_oc=Adri_MSsrKxV6MA74OZYkYjRlxQhy79_okdclCzyQ9vvN-_cQodlAjBgyg8AG-eKz4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p9jIp-yWUB19GfgMi4e7JqcfoWOyzN2qUmZ-0LPSxiQ&oe=69DB86ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpFaklCeLH4Q7kNvwHHWeb5&_nc_oc=AdqwIywxALHvwDwCoi2Rad1ad1inKoxa1PKx3O2yjplXf9sfcnPLjTy68_COeyv8k-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OzWoIzoLLzpvg1yYljpvMxNdg3Uikijpg5PbddfSlsg&oe=69DB9844"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TRpfVAqqFYQ7kNvwGOB7VT&_nc_oc=AdrB167tV-TlVW_TY0Le-5GBjxTaZ7wevzTLwXrw0LeR6b2z9Yw-bl6QMksgTKWFbLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mppNgqPP57WeITmyLCgpOHjgHS3bGWgZLqTPCG8zCzQ&oe=69DB82FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EtOds92MHUQ7kNvwHHyQ2d&_nc_oc=AdrMwVYuhTNgINaA80TZ1qchypKtgH3c7ywMG706EDanOoPEwJf77l4QvW1MA0E_lL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11hfSktXHWNzC2Xlt9l1R_iFJwy7NXZvgGIdDtsW9Z7Q&oe=69DB93D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3CCgjTNreUQ7kNvwFDU5np&_nc_oc=AdrRKhRZwfiTQDgdVWVh-aK6gWz6en7NSqSgljMfIiQ1wg5DL2lzeNl4bLOc3fhFsL4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ju3zW5vAjHIzVz3lxco1TNIeq4xTmDacdcESAidVI-w&oe=69DB9198"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
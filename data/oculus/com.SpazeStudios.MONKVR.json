302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK0qW-1w48UQ7kNvwF7u3G2&_nc_oc=AdoOxUUzLrBP49pryMBLpoPlOhHgUq6TM8P4Lu3m97VucLpMam5QS7GQarYRZC9_jKs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gKb6DVtu49OQcF48JICzSOu7O8tZX6N2EQoULKBzNhg&oe=6A2987AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-KA0aMQCP0Q7kNvwG3ZZJO&_nc_oc=Adqg29qFD-ygxv1fGDL_MQH-rBsw59oQHhK4dlnuKm5z8tMzvZwzp_FtM45GoYy8r5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OWO0xnuBDwAQNFDLPZoFVc_Rr5ow-toQ3HY6LsHRtOA&oe=6A2960C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPEQaGWNwzcQ7kNvwHq34oK&_nc_oc=AdpU5WSOZfFDS-P3UvNmZKCv54JuGh_yJX5tqL-7tHansjSjYl6Ef1J2PPS7aSKMgsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zXhgSGtFnc7juyllEdP1XdaRV4kZMC6aDFwrMxjMPfw&oe=6A2983BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbOUF4NJLpMQ7kNvwEE8c5K&_nc_oc=AdoU9XgO3xczktdi1-YUz1VlbxH8xGfcpbcqKGE3PIl03vx4tB_ydu7bCeZbuCZfHBc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XB6wSQkFTmDhjsWKJy1lMA_JNrmYyJ1G8k7UoYjPrqg&oe=6A295C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5l0oDpN19gQ7kNvwHX7HxJ&_nc_oc=Adojs-QQj2AQrYGEyrRQO_f2kqLF29MNkcxMqyQnq_d4vXuJztJXvY6HabYfFt6JAyE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vsUd1GjNxLdTOnuF-gpMor5FkwRQv2kUyUZxCOE01rQ&oe=6A295A18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
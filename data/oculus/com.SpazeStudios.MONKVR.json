302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsbDz3kHWXUQ7kNvwF0sHgI&_nc_oc=AdoTjcxByVLV1rMk5c0ACTXFA8BcZEO7h0A4UqRorSCr2njrKQYvNVdB3jrGhZapRmc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZfICH-pI7vJuit3fAVomZBKvjXX0HE0UzquaskBty1Q&oe=6AF33D2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDOJE9g9m2UQ7kNvwHix6qh&_nc_oc=AdpPtpg02BgKKwBKx-j9yBRcQH2kXaRi6TuIN4RWMPLxDdf3RMLuo3o_DBmmFg40co0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFTfl_0oejvmlVt0jGfbqWKliX-ESIuEdIA45Meet4TA&oe=6AF34E84"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCLpqEOCD78Q7kNvwGvzafw&_nc_oc=AdpOnhGeahq4OGxtVG-cWq_Cb9LKkQllC8Ivb3_yuSbNEud4RHAu_wVk1ImRE8qvWi0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQktRyM3dXGd54QApARJHze5Dqx_j5bUWjAQhwIIcbvFw&oe=6AF3393F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtWBzFPr4-UQ7kNvwHSCkbE&_nc_oc=AdqNXC2rEIL-rm6xlVQeWMALXKhbMrfYWLSilS3dV5GeyFFyAT9r9-Rrwwa8xD5IQaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjzPaFW77ktJJoptOJOSuRZLU_Nznb9UjkcuBLhTH5ZQ&oe=6AF34A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbXksaf55AUQ7kNvwG49rp4&_nc_oc=AdqgGV0_ydeinaTl2Zjt_ejkprFLVMtSMujxocxIgPz7Er5e9oQxcwsCr4yULNkj8PQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHy3FuW0H2f4JSUkAKrlp7aBIKkp6R_-rU5OFU7qbJfA&oe=6AF347D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
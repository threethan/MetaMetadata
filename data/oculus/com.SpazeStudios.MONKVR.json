302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe-uOqDm9DcQ7kNvwEzJ0UJ&_nc_oc=AdqhnVHL6R4lNBOnwD2bE12FM-BAU7GAnzjfqRu_BcDBIgq8RfNTyh1uE7CqGAzzvbE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1LuRC6_mruWmkTg3iVYqNhL5jP_zW4pN3AyIDCzk8HA&oe=6AC90D2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH9y2dDE4DUQ7kNvwH1a7tG&_nc_oc=AdrYG0pLjS05pCVAgnCnSPx5xoK0fRM0KGu6s_SStjJCCkBAUkEoH4PxCVj6jznK7rE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFLMbyk6PY5jrNtAXs3Ybbh6RCOm2CzOu7RxVYsdSPzA&oe=6AC8E644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFXcSjaBuuoQ7kNvwE4_nvr&_nc_oc=Adoc3-Ipvd53q0XbJDJ1Q8yukF5R9abLzKKXIm75FlPrGWu_Cgl8L5BRlaOlqmBQuTM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnebr3JV-m9viv3rIUgGqUi1Hu5uU9ksBajaVHxAiQdw&oe=6AC9093F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLH_1PdbLWAQ7kNvwGFBXUQ&_nc_oc=AdrUjf6hYxBjR0ZCJd6vvcFKBCwWzYvyTerJDMo4cgLgq0wnXtrMlxwgIZwfBlMO4YQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI6NBfrWz5J1sbQKKWTl0nfZkybDVvK4roQuTHjL6pkA&oe=6AC91A12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZav4z-KqgoQ7kNvwF9-2aP&_nc_oc=AdoG2sJmZM3PfhwihLeYqYx6f0wFKOtvtFs6x3e5YTLP-GdArD1N96W0STK-qDXpkVQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZKUSw0eN84Kbj-wUNS8bwYe87w8bvIyk2mu6dw5Eueg&oe=6AC917D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
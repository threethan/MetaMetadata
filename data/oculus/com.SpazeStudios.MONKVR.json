302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RPkabat_PkQ7kNvwFBlcGM&_nc_oc=AdroAwp9XLpmwLCirnzppk-aqcl15X56CasdEQ1dBHOX59ZGQ-byHokrye_O7cohLMU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eyj3YQDBrcIiuDdMbQQ_bpMZNGI9Y3oe1s21bQujHrg&oe=6A219EAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4CNB7WXzFEoQ7kNvwGvFo8h&_nc_oc=Ado2aM0iPJUtMhKTKXID21I0PkhjzsMRUHOd-XwCgGHF3WHWpFq4Aj0X8zK8yeGVvM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aUNl9v7J8eaZBrnXKkz9c86DaiXHzeFbhBT7rAH99vw&oe=6A2177C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFAPUllwTekQ7kNvwHXMBLM&_nc_oc=Adqp9GzddvWqKRmOMPnFY7oC2q11NTD7ZkNb-TAacFubr5ODdDXb1RVsPskHdHanaiA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EGX6gYsTXm3Mlq25ukT-HuloLVTv1ooUWAGUpzRhynA&oe=6A219ABF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9cCA1_iOyQQ7kNvwGtFL7R&_nc_oc=AdqEJA_RoqL-_UGBoWPuPVnrdG6sKBzFlFHLuf4k6O1n4IdDdwEhp7PXvQQOB8vMAiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ecg8qtlEKR01zc2wp0PYUg4NqJylZSQ8nrP7LQhwxqg&oe=6A217352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbEU4Cl6SNcQ7kNvwGuftzv&_nc_oc=Adq2KTYNrCer628Vgbt6_cnrTnCTeTymbp7SSgi6rnPlc3FPR-c1Kk_gopECZhYB-wM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oztrCOdZAGCQMU3BnOKgnY2qH1lAlbdlyZG93n2UbDA&oe=6A217118"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
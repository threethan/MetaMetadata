302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAtS1dIWXTMQ7kNvwGz9Id8&_nc_oc=Adp503RqHkI3VAs8HRqi-gDRIBvdanWtkS-z1jQ_UrTsVNynd7fFOXaFhoJZVdaoqTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q1lL9tOfurXZ9UiIdMH8atJLoFuhY7M1CQcuUWyaRYA&oe=6A04656D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2mOouSBhI0Q7kNvwGCiXa7&_nc_oc=AdpHWwwEs_VndDoCOotkTC1_AbMeOpEnXT_4vVfn5FqwllRmMF053DZ2batBmgIlPTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gYm4VQy6QZuNrNX3G72FvDl1iSwnD1d7ODhA4VOo-Mg&oe=6A0476C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl2bZ_N2bIEQ7kNvwEzvtKd&_nc_oc=AdrJgn4yWy1uYKDhRZYaxua5lvjTJ22jxI6Yjf9Jkgzg8caGNvjue6UomC3U_pbpwPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ltZ8Qa_eG8xSt9ixHswpNJrwrSCRn7Vn1hsrfExE7cg&oe=6A0499BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fit7p8C9SjAQ7kNvwG4bMiu&_nc_oc=Adp3BZ-KWjck6jEZ0HYswW5TBzOthhep0BCD2l_o7Td-Ul4v6kOhwdgEE-FKnuVV2o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4erF1aUk5oArGMAtPfDEsAOXa3H8P4LS4cvvjAf00yzw&oe=6A047252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqokQXIcsZ4Q7kNvwEox558&_nc_oc=AdqXO0Gsu1mEtrn7qQP1L9qzjaC2TIFQ8oDdweAltLDWdhC8zUoiDNpRW1hLUyO9cLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j54-3oBGH624f1uPX8wy2RYYvZ4WFYMND9zrAfaXk7A&oe=6A047018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
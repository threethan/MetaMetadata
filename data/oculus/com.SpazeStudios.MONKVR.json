302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYbHZkgxeXEQ7kNvwEQSot0&_nc_oc=Adr6pteVZrmJCEIWcJ8_W33E6pjV3xKc2MJDzrf7ek71EaX77TbJtycP1WPG_Rbm-0A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGktDaLoV3TLF3o6c-Yf9IdBR5UkO7Io6OetdbTZCZOng&oe=6A92C76D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywfb--t_pUIQ7kNvwHF63pz&_nc_oc=Adomrh9OCo_GlZMTyx7vd6ZR0IGgZaxFDXa9btjCZSiHg8uwVUZL_GhsTRkvpfDC6Ss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkPGpbyUtoWoOgke8oBTu2yokWGe9OalwXCvygPz4mEQ&oe=6A92D8C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYfR25MIb2kQ7kNvwGNWmZs&_nc_oc=AdrnHGqcnvrd-rr-3cjcMRsJwTBdwCgLmLYxhqfdOhcUsmY9PxHiqqcX3VxMuQYyYGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF4Fxdb7pdowKU-O8F5cxVA3tUJGcekAnzNiqjpH7m1w&oe=6A92C37F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLIQ2D2KngQ7kNvwEn55pi&_nc_oc=AdoUKZXk3Oqmt6rlfx22VYFEWxTpZ9v8iu5P7iuSnzHm_so5lKraS51lCf-mG5fFUbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPp1cWwrocIXd4Y3Hs3fS8hVvQ2fEsvsOkGEeMyY2wpQ&oe=6A92D452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNr85GgmyvsQ7kNvwFP_NHB&_nc_oc=AdqsnYHlE1ib-5oSh9lzI0N3zrMXpTi2d071sc7JcYKrKBo0a227nLv-OiWB4NnXYBU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRKvsxNbCWc9fxlAjZzWWJSYLSQrTcvDsXTgYBU3tIgA&oe=6A92D218"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
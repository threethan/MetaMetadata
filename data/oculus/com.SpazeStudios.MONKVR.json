302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agVOFhOQ00oQ7kNvwGa-7LF&_nc_oc=AdpL2LiH_C5M2Lrk-qtE0j6Wg6t00Q8Hhqc2sHMg-FRl5nhl8frMIEWFiAaF3-PcfzA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2BHxPSz-aM9-2Z86VL312XmNc-b71CHA7B51N9S9w1w&oe=69D0FAED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1nLg5YhdiQQ7kNvwFtFRr7&_nc_oc=Adqj2hAowRG8h3hNDxCFDou5rrsuVSjFKPb5QW-xyR_TaoSIqHhGm161-XAZiVwfYWM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwO0w_ZXfHqLKHSRxTENJqln3_bMotZFN9qiG66SRqng&oe=69D10C44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFo07hHNpyoQ7kNvwEdS0IK&_nc_oc=Adrk0dmwIE1Gm63o9rIoCNsVFrdHo2brjFeYwcGymUxOQw3uRim-88HdKFp7KP5rxmE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRVL6oO2C2Pk8PfRwrVRagtYO1lq9iomepRVYGPG6BqQ&oe=69D0F6FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O79F4TLV_0Q7kNvwFizzhq&_nc_oc=Adoa8C1PVLnNsAxyhJTT0lyhTjgXBPWqSc6g9CiTqnK9I8y4YZPmcVT-mTolavvdWWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzpo9SZO4pQ2WklGXgU0kNWlXjQWJN_gmuGZLU5xkrD4A&oe=69D107D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6mospV0wJwQ7kNvwF3XOw8&_nc_oc=Adr4j88DJifsTBp6CeNId8JD3txRisIIVkirCTrf7KOQrLbY5MYjpdAZXO01OoF82MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyBPLGsVXj6d_BFBwKj-lCq-b5_bmTJzi5Ql172JUUeg&oe=69D10598"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-5qWa2RHO0Q7kNvwFo6fkF&_nc_oc=Admzh5E0RaVRNw2s_mBak01h9ahLPNYPGxBuHo0udxTrQPDXBZqhGwlr_HAn0w5HTII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLIVlnGEhsTP_Hg3wChhqotusmtsZpn8unu--mHIt5nQ&oe=69B93FED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuPwswGwIyMQ7kNvwEX0ZS-&_nc_oc=AdlWFNbCNzgCiACQ5hJuQoJqt37L8DXKzDgiyJdth8OcmG6Nv0ygNtZzuEGvIEsmthk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyCgOQZSaZTe7W0BOKXh9YXMtzBlfsltjFtJPKsl_AZUg&oe=69B95144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HL63MaLhPAQ7kNvwGv331M&_nc_oc=AdljZT1Inl28QHUtRdKvZNn2aVhO0URgIeTNcRU4lsP7eMDBHE5t6xMgmaNBDgZTfEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlN3P_C9FUeJUf_UePVOX8w5nEvtgxYp3apJ5v8TkqKQ&oe=69B93BFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv_AEJX00jUQ7kNvwHvmai3&_nc_oc=Adnc23UYmwlzYzNaue4d1YYsW93bLRiW-059UFT6uIUq9ssfGV0Pj4s2vYyzJwEzaUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUvgVfHQIe9bfd0S4-kGpP3oCRhcJq_irmE9cvNchvxg&oe=69B94CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FHhKioHdB0Q7kNvwGrpyQG&_nc_oc=AdmlEfhaA0y9HE7EI23Rx2DelX81LtPkwVsg2P241LTrGrd746aBtoPruOFAVtPmBds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMzJ7QD8tw3qbgt8WzpsLkIkNH92fUK89-XogiFDZD2w&oe=69B94A98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
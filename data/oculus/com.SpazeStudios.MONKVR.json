g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAXnFDXxehMQ7kNvwET0UIW&_nc_oc=AdljqTadTdgrSaulBSvwKeF8Ko8REU2Z9O2p0tfPDsOnshZ03ErWJ3Wc7VD54EXYuAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuh74a5Di4bwxN0kq1a3FJfj3Eq3tXQMRV8GpRtTOHzHw&oe=69A81C6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOVg_Y20-BkQ7kNvwGox5Lk&_nc_oc=AdmDIu6cn8G9FXnhK4TuH6RBlo4DfTsEqbMi1tm3bC-IaB8h65glWNtDDFK_OaBA4tc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfthFLer78aY4xvoybKp1HsEaVgG1HliPyBzZKng40LX4A&oe=69A82DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02JH1Y1QI1sQ7kNvwFLNJSl&_nc_oc=AdnpLLrxPAyBZQ1pKHhjbcEANEDd27Z2MKbwKAN6Jhh98-_uYmnajpP2mZgu6KhEPNM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvdvfytyF2F-5CpTjzf4ja3xZiXuWeiZrCqSmPaVMIJXQ&oe=69A8187F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6khvtuHbZsQ7kNvwE_2BwF&_nc_oc=AdmZqYrmGQKd5iNNTVz2DDPDjhWGMwrKM38RCkAejDyeq4t6x2lAGCLN2fWE3bsrnwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNWX25neArrruVfOI85sTNvRxCL050B0NtQf4sny8oXQ&oe=69A82952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6um5RH4N-voQ7kNvwGsyWTc&_nc_oc=Adm3tjja6Y0vpls82T9-XHlBbtQM0PkXOcD1rnJCju842nFPpRthrgxSg7zU3nYC4zY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvdA2cisHgZ-hlDyH2r8lY5m7v8cVTEL2DVT_7a5rBjSQ&oe=69A82718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
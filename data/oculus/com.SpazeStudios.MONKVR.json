302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdV5pooyeYQ7kNvwFQK_j5&_nc_oc=AdoaLK2oW0o_tqOBdiKrS2TBgQHQvkI7eSVv5I5gL-CT8lAUwp5-kIh32c0S_E_TXqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FAgDOX08nfJOiEIbFkbIyAqm6aWLNx-nJNZb4cf_qQw&oe=6A0070ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tSe5lR1kF0Q7kNvwEodcia&_nc_oc=Adqz-le_eisP9sLiJAGXi8KbTmrHWqyJzVBd_vneJNEF98f7HamOlMXKLM4YbRDn2zI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iePV-lAvDBIoWXGME34TSD7MuX1iAsl6ajeJPVt_8bA&oe=6A008244"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H5aBdzPShwQ7kNvwG8pxPM&_nc_oc=AdpJ7QMbqrERytwXex4Un2IpFeToj8TBu1okMa2gDhuVdiD5umxwyfROnqe9lmNeDv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7au9ouN_0fRrhO9Q4wqgF3ckJ6R2VzdJgG9uAqHeyHCQ&oe=6A00A53F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yACpWHyGAR0Q7kNvwEYUr39&_nc_oc=AdqOKGCYEaywgwfdsNOfbhZoy0VkoO7mVs0atVH0OaeVr1mulZdS0cz-iSxMLbChifo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gYNuRoqRywh6rL22SYYJijeA5G_VyybpxauXNQ0dk5w&oe=6A007DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Txg9JM_kMQ7kNvwFNSEZW&_nc_oc=Ado8O6twFhUh4sZhSRXCL23q_NINows61CSIRLH0-RSHxBCFZy1y6KBMgK2PuV6fhmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zgy-VTWBwOxiYACNvvlWrsxxnCOrtWvhy0JVNRYyJ-g&oe=6A007B98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
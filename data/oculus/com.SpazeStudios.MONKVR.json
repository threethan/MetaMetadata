302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juTbcDXAT4AQ7kNvwE9zfAm&_nc_oc=AdriBah1V2TjOcWbVaVxCCnJm91las8pAyUJZtw0KTByXwE6z489hjETmTPT61PpL_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82N3If47Bhem8Q08sVzF3bms1vx8FHIxwx2MHrzlluJg&oe=6A3D4E2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iv_UQ9QZP0IQ7kNvwGXrr5c&_nc_oc=AdoeDKrQigNbLKRbd1w29ZNTbfC_8HFRSHKRcwHwkK70w_eGPbBLuvwY1RkjRLYE2Cs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cksMTjrfCbSKxEe_FBPL6-Hx3PG-hw5bN-P5p2VP_WQ&oe=6A3D5F84"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rkpry2Cm37sQ7kNvwFvT2XX&_nc_oc=AdoMf4Hfyd-NmXRtrvpII3mbdE_zYoA2VOA-YmkPQ38i3ECk9arNKjcacUaciWLJP9g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XGQ07AAkpm-1_lay5PQNq1R7l6O5JEf-An69g5UISYA&oe=6A3D4A3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qGwxjJVfSgQ7kNvwE-6P2D&_nc_oc=AdosWuP3jH_qrspF_ky8K0NMcEW75F3m1KECDNIEQEHc1iEwE9k9IS6vRXngmdEv2Hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p4wnWmL3SMrwv3irYlAKuMnCOEWQNyPT2Wt2J9JYF6g&oe=6A3D5B12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eDKmkq-SfEQ7kNvwF4vx2K&_nc_oc=AdpZyVDu8oHthw_lm_8QJX3SYhSjHnNcPn9hC5D_Cnn9xLZayj-9z82XyPi0YHYGa0U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FG6_D5yksxsNt_JtTrxAFbuSNPJ0a0ueMT3aThJjOlw&oe=6A3D58D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bam1-drYC0AQ7kNvwHqT8mu&_nc_oc=Adq05nEzxBlAQ3K-mn_G34D7mYnZT2SGxuPi5qPgCtobi0HROG_EwAmgzAon85xs_aU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASS0n0K35aK2cLRuxqqzWRGraFt-T4v7UAI3B-9Hz5HQ&oe=6A537F6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBvbKyGbMCAQ7kNvwHpAo_T&_nc_oc=AdrW9liuqzEfM38j1ajOdC0xw4U9YnNOB9tgJL7t5W5MXnPJVt9GW6-xA1zlIcg_QBw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWAIqW6whH-SabzXaxe5HS6Lw7crwq4K7s6Ql5eB8IfA&oe=6A5390C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QYPOpvG2o4Q7kNvwEC0yTu&_nc_oc=AdpS4racnINz1-Hqwi9M5jLqXq2PaHpMSXcU6CcsWdgi2WXo2Wndt_SVUt-BcvZv_bk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBATBblCdVfh5RrdROwJe8YHxVNNHEjvxEF_fuwxmNHDQ&oe=6A537B7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zln3tE2XWAkQ7kNvwFRizA_&_nc_oc=Adols99MWMUweFZzbg98Sm18b2cg6OnPXTVkRVMhCyjMrpWmNAXB49GWiYrfkLwHS1I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA7nhcIDqZGnbfbc3igW_N2HEKHOCf_QJxDktdmoCCbw&oe=6A538C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_eGx0W7NCUQ7kNvwELts7w&_nc_oc=Adroo-MZtjpU5cKOFObEeIRVbq7vA9dAJ_qnj3fOJqMSrSlkhbA_iw0rqeQ0a3Xo-gU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWLQDjn84mqBnzYNYHzor93VABQ1D4BBlsfqet8gMZgA&oe=6A538A18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
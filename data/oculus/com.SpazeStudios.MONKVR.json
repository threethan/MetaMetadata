302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYbHZkgxeXEQ7kNvwF__mzZ&_nc_oc=AdrAXPNSGGYNyjNcpGzwKYTPjeaYceSamYU4rTK2jRRUxiNCPxJLcm9h6VEgEYbR9JU&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1I-9q6-F9DxHdBITnFyGrr2uSASH9lmv5mrZUu3RJoQ&oe=6A9175ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvr6ilpiZ78Q7kNvwED3xzv&_nc_oc=AdpOkD692cweoqOPMjlGc_q8cie29VtDCA44P2_h59wqKK7HEO3Ne16sLdIONlp11jw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx1Lzvw9x851_Xh7nc75tKeUiN6zusmt6a5__QM2qVkQ&oe=6A918744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VvqddFKVwQQ7kNvwHc-Dhh&_nc_oc=AdoTpkhVUDnq7Ffm4Os8MD8UxCmhvn3W8bBCYxgTigKU-nzfjAZY1NwaaZrcnJ0pWEA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-NpO7Iz3_iSprGdwXoXeRmu1ni9Hy388lZgoQgKsU8A&oe=6A9171FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFLIQ2D2KngQ7kNvwFMmHTr&_nc_oc=AdqVmouEDY89iMT5fkQ4reFbbMh9xLG1u6L8e2ISmEQ-Wx5pxlONwOOqGrPAUkG8Y-c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSS3hfOaPgP5_PUq-3OiRKc6fPSdGanAWRc8noiM9hcQ&oe=6A9182D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNr85GgmyvsQ7kNvwF6tVvS&_nc_oc=AdqAHQrjg9M0_i-4kp1-mBylLNZVqt4IfZ2q0FitRhNpbZkbE82D24Tbg5ddX1OzKFA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgBmeCQOTO0iac6rzpz6vweajBVhOFw0XQLGG0n8aaPg&oe=6A918098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on0RSZdfoHwQ7kNvwFPH5vn&_nc_oc=AdqU1SlwK2VVEnEa2z9yV_fCwOJBt9NZMqSUH3NfUKdd2uQ9MeY2ZFkmd9NBaP6dlrc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIQy-wMyVus3w7Q2sHfSeHIoYEPoo8SKXa0PkEV7oBIA&oe=6A4A7D2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km_yd7aQU5EQ7kNvwEZ_qrO&_nc_oc=AdqFvsoo4687dkmJ9MjFPiuO_AzoA_OvSCVmXPMaTRJ96O4gZ6ddFkGKMoVZpjGV4WU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvFPxiEBfeRTqYABGRkS20nue8dvThXTSln51QlA8GOQ&oe=6A4A5644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJIgQfn17oEQ7kNvwHjnamk&_nc_oc=AdoZdJLigLN2C6gJcd839Vn0P50B-lKV2tzz2q20NZURJPO8GWbEhMOvwE1sc1VmWtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVMqHPTK_kOLtjQrjAez07EmeNPWheYBi0hfX6k1Gfaw&oe=6A4A793F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjzQjo9TA6wQ7kNvwHhhkca&_nc_oc=AdrG8K6agd7M63onw1cChXVO55iXZaZZECVo-0hsdu8rcHX9TQbLV9WuWPwshKmg1O0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDOfLN7U-tpJ3tPgwp7ytN4TnfWjTj2VM90WA18aoT7w&oe=6A4A51D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zihsfywTt7gQ7kNvwGANdWu&_nc_oc=AdrJ1nmnPyliKQxwGaNzty9uhBCspQbEMEu3h__Pt-yxwAz6ZbYZSuOi0DSzTL8lyeY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3RWeJN9ZpSXaPX1GCjkE7DViuycr8LRn0n5ZmByL7Bw&oe=6A4A4F98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
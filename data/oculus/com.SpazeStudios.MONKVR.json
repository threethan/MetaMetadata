302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OcVMiCWeXMQ7kNvwG1BQ3H&_nc_oc=Adr1Zf5t12KkvP0n4TeEjqfDkeIw90ED_o5sRZNAUI6PruZMECajzbBgpXsYZ5nZBf8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAFjirhX10lLSimQ1klkNPvF6Wo9zdkZZH4h-qtR4ucA&oe=6A6745ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCqgEcECosgQ7kNvwFWYNil&_nc_oc=AdpXWR-M0MhtTFqX80wl-87BC6uqZ1hvxWN1mDIg1PZEb7vvP-sgYy_ulJGS6duF2MM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANefuMMLszvtrZ4WH5okcSh3CcngtmUWlyKgOSWtyL_w&oe=6A675744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTV4wh-SrsYQ7kNvwEty2su&_nc_oc=AdolDd6k5-S8nkWErPTAC80iukuMwvOZ0B7qHfRKUCWmwjol0zWKDELZt8f-waFAJnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARPPQIIDjjBuapvCEg2jVoDiOimTWc-lpR9Go7sQEsZA&oe=6A6741FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyOgqjsV_MYQ7kNvwFgTchO&_nc_oc=Adr2rZkTJAWmSKUbaBKSd73qiNIt350e_J1tu9Q6ndL9kkWA2tlVmw6-WYAm8tD7cRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDltq02pbUq0HdfREo6DqYq0LlOgrAjG0H_teisQT0bKg&oe=6A6752D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFd2v4QjBpwQ7kNvwFvYQte&_nc_oc=AdpFDoGVkQjOfJNwN4nhd-OxQOtEoEkm5mu6UVHYZbZ4_Ew3QNwDhDn4gtWFYKd6InI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmEAFAax-ftfHkN5WW8ENHTnDQQ512SlesZvc3uTwQFw&oe=6A675098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0VefLlt8tQQ7kNvwH3seIE&_nc_oc=AdlrMR5F4czSNBZRxlK5eToJ4XK6kQ1Hop4nXwyihVjsr3CPBrYQVeO62atQw15gszA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDHbe3Hy9gp-M5RvDE3Vl1ZMryQ9YvEP-S3nMOHtINJw&oe=69B54B6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfMkShIo5d8Q7kNvwGTUVnc&_nc_oc=Adm42RnsPrtZCRQVGgNSXItHaY_zG5dPXKof-vTNCXlYO27NP7uVuTa5BZTwK-omeFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3FzIYpwX0_7WSjFDoM8sHr8bRMvgbYXGXTP-5uwGgKg&oe=69B55CC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG-oR9VkCzAQ7kNvwFBmp-4&_nc_oc=AdkoPrElcugxFFi3bPaClMIq6ce9TxuulyjPzjvmrtWMyUHKNxXGQ5sL8GYbYt6swtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2ZHAB-Up-q5BDNSPvtT-ZZqehifdPOszcxJ0UyvJp0Q&oe=69B5477F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HYIpdSP9aQQ7kNvwHkWAv2&_nc_oc=AdnsynTMK-t5hsg12DMamZOn92leidI10d69R0uhPJ3bzDYjAlclBkxVzGw0IIkOUoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdKiRUpsf05hQDmGhm7XVgFEkEfUHT8LeEwwVLcqqw6g&oe=69B55852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6ZtHJ7qbkUQ7kNvwF_8jOx&_nc_oc=AdkwHreSJ3ry8-zdjefC2goO9OT0J8Ys7vIWAa-McU0GJJqRsJzf5CvuKTx3Z1VIZUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybeLJG6T_WJJG0ophNryJyf2nroO99poh_MstUuf6Jbw&oe=69B55618"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
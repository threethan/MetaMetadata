302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S71RnewKLboQ7kNvwHwa29T&_nc_oc=AdrDniG3In8wJ-vYwDHpvdZasdU1gEF8TX98eQ0ClcJUt92jWGMgWnz6A3L5GTfeofQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFQQd3sjYRJ83rkqmCm6yf2B92d9klAAUKU9e47fi-bg&oe=6ADE252D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H37GtUwM8EcQ7kNvwFi_41l&_nc_oc=AdrCYbaCvGpj5WClGJtes14tv8uzFzKJ5cxafjfiX5j9-Gji6GaMIO96Z59aq_Myts4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd0x0ZEbYu-RO2j5vWRp-pTXVpJmgoyym0LakTeOXKvw&oe=6ADDFE44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxDy2v8tz-0Q7kNvwG53t5C&_nc_oc=AdoRC1ycuGBewf86dD3jkhAVwru8ivKNt57NDHEwVLhVtD01OuPLswVrZTCnPvyQVVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFgtr-UgJ4iISow3Tr21dc7jvU9_as4TqsdPfHdmvhtg&oe=6ADE213F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DdIzQ3Hx04Q7kNvwGGzt1i&_nc_oc=AdpOh71DMP9LB0evnqM2PtUF97KheagFuuGPDozwyvPjZSu_2Ypi5aIZvWzxxWazwBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWb5BtXZY4VxSUXv1Jmb7zLsIC2LtHu5WpeVD4iGbeJA&oe=6ADDF9D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUm4tku-3VcQ7kNvwEIWBxH&_nc_oc=AdqsbNM9k1W88ZjXCy81KxgP1VPxWXj2ggeuD-e_ozZZv-6HyqBd56IGgPWvC0dtjMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLRDuijNPS73fHSAQ1yCqfkJN1IN4qp4MmXDYLym1raQ&oe=6ADDF798"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
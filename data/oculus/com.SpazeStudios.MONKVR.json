302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNK59wW5t54Q7kNvwGLcTQU&_nc_oc=Ado1eumdUljgLwGWriV6aCnNCluvmLOdrDOURIKtim9iSSd8oepGPvx94TgPmt4lIc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pOGNi6Rmk9gbac73OanMA9BDD95yP75m077IlFYV7nA&oe=69D39DED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1nLg5YhdiQQ7kNvwHqajs6&_nc_oc=Adr0AL0diN3z-jEngarSBn6IR0aFFNngOIsyVY0_oPOBWxXOAIu3cgPyoi-VLM78JNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IpDYBH7162rxUzI9SDC4XCE3nqqDSwtba6pyL6OfxEg&oe=69D3AF44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFo07hHNpyoQ7kNvwGIV7Ll&_nc_oc=Adr9TiOC8XepSBgcG8b-EqvqqJi-LnU8a9D30bIGr-uZIKwdtJh02oCLM3ZeqnYVRxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y7_2jPVZyxGX2MNSRkzJGE-ABLGtJIdsojqq0uE48Xg&oe=69D399FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSClL2tH96EQ7kNvwFG2sy5&_nc_oc=Adrwxh4T9eVRshoLxZ5VTlsebCr0Ks2FjSnT4Sf_CZ2GibEkfRhs41WubsjpBxWdbnk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nnJ0MXCo8znzHjULw9cfO1emV5HGk94vpGVt4Yvj6jw&oe=69D3AAD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFuLtjcB0EMQ7kNvwHt9pV4&_nc_oc=Adokk1bhzYWK75mSSlc5sj00a2R6CpMpnl0UihVsu_gYq7j8FqSSrDQi6KenSPc32Og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Zm8EQSb1TD4KSvq9Je-HhrzegpHTTiSoBFFUgJwKiBw&oe=69D3A898"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
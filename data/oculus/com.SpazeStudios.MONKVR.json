302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5mncl8cao0Q7kNvwGszMmw&_nc_oc=AdrcJNo9zcC3ev1jLC8mbTVpTHdZsBloa9f15lvb8jwYjvcLE-roSbkzfvT--cUkfRc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ifKEVMUyNefmbHwdd3klDt5FCzCw6tO_oi2C8qflTMw&oe=6A107B2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L155oQlLEYIQ7kNvwFwmLG2&_nc_oc=AdoAH4TyIvBfTOnCFLOZYeB-2sb8V0HIGuCR3USKltz8VuRE5LnNRTnFClj_beWthQw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VNrRSIL-YIWnKJEKpP9FwHJGB0hPT1sNX-Rrn513pzA&oe=6A105444"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6W5vMLE3PgQ7kNvwHHeCYS&_nc_oc=AdrGk6UGTPOwdg4t8YA2CKaW7xDwc6jSLPvjEDANZOw-89jqwztNjaSs-KbiBnuT-a4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BZ-G2IGbNGoDt9Ew0CuxLdqWJvJUG11MzPuxP-Nx5Rw&oe=6A10773F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t4i9bvJZNwQ7kNvwHOwWkC&_nc_oc=Adr4cXWe4jUF3QKHg16QhLeYX9gCOYFt7pjPYmvMJ6qZsKvtQE89soSTyT0q895GKZw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D7T4Nlpz1W8kvrcWiNsMIiyIK4N5JgRBCnjiS3KTHlw&oe=6A104FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUuOTgfi6YkQ7kNvwHUdA4v&_nc_oc=AdpDyN5LRQhu0LFox_TDdYRt0aRj94fjOJaFs8cSRaOeQJSzirm3JGBvwPrfu1VIoeo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OJcrmYqw1_y8XnXyb2vfQrSjOUbIXsW2eAQpCaQRzFw&oe=6A104D98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
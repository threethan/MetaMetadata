302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe-uOqDm9DcQ7kNvwFDh7_6&_nc_oc=AdpaESnoviwPXyobEeDRikFdPinMXidAPCf8cxlF2LWB9yAJQT-UDwLJ2Tbi50oFUG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdzNRPQfBQC3SOmsIwexVh6J1Y_PtLdh5_vPnAVSrMRw&oe=6ACA5EAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbxsXa5mi9kQ7kNvwHuaak1&_nc_oc=Adqu4TKHCa4cdNl4ZyeCiGu8UwlH3mtk8taBVHMeEllxTl6GmV1R56KHSFGDVW8cEj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM93HJfTgLq-Efm4-41sqCBYwJWFBc-5uURvKR5RLmLlQ&oe=6ACA7004"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMBVUyGixVkQ7kNvwG2UtRI&_nc_oc=AdraZ40nh_x74VNYUDf3paiCWzergn_wA1TKlfmRZorzgqcWZdgEzP_LwjDk7D97k2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3OAB5I7HtZbzTQix0Wc_zofJfN6eAhOpySgqVbniyww&oe=6ACA5ABF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLH_1PdbLWAQ7kNvwFdovJ_&_nc_oc=Adr1KkxLDQxRwz5zdLHV_cEqNYgaAvrQWl_SHvb_4evEs7OTC6qdSPTbv-oDM-iIsS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcaeOCkauexZ3FYhgT1Kv_sTblEmN2OhYs639Q_G1REg&oe=6ACA6B92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZav4z-KqgoQ7kNvwF1_oVo&_nc_oc=AdqNgEHiiow-KQbIbJRrUl5qHIqupNhV6VLUITmgxisDja_mNhoFr5SmNOsorUhWpTw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxVI0qIlqdP6xhxHuJVuY4RUCYaG8nWeX0hnRatPGqOA&oe=6ACA6958"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
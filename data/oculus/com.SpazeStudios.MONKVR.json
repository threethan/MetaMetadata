302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_qKQUiyAnEQ7kNvwGFJTMD&_nc_oc=AdodL5b_3aWNLIUbIiV4PmeneOHBEtTys_aJFhKqGdXrHCYb6ZrX_A5EnZa48MP2SVE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXhyvqzl9bYz8Qweds_0QExN8M90iea76wfR2vPN56Hw&oe=6A58C56D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gonwgm8oePUQ7kNvwHLXZ2U&_nc_oc=AdobpCa1FRtrWGZXQQWvh1kHDKoc8Cbf_MpqBLhE1bYrrTA-cPQwkoxvsVkl8j7ogOE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEUHmcXogT7W9POSbLMLKBFSL7e-mD6Qra6uXbBGCrFQ&oe=6A58D6C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpvwSEp0lOkQ7kNvwHbMUo6&_nc_oc=Adp9pdW4uqQ3tz4Vw5syU03CqximFnI1uosTm1IkUizJjc_HQsvA_W8eVTeKkMj4ulI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoR_IYH_VSZ-m-mI8oMOGauYdrUflOa-uizkxXFuF7Pg&oe=6A58C17F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=up9PzHihlecQ7kNvwFJAr7r&_nc_oc=Adp_U1ajObet1vWQCQFNAzpfWdSToo_4Ci1FsxL9jEYcPjV87C59AiPzntz0vtuo2X4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBijFbV2Rak9m6X1LYhBSQwE04I5ZUbkhAMMztkYBYbrQ&oe=6A58D252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIzOr-xnHKMQ7kNvwEpK6PM&_nc_oc=AdqJt3Qe4Kbfxiu7HzVbF-s_s1s-0oxfjw-Hn_uiZfzzVVYQYpI7FBDgX4adhnmJfoo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8_nN31jx9ddzhme7wMdfZRIC6NQ6V1g7UWvJifQ0lpQ&oe=6A58D018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ydj1LqeDXDUQ7kNvwFl6ykN&_nc_oc=AdlCjKSOcZYMihJPYOt3U75HhHiIrzNCYah1c5NrLWRVjDdHo5qe5FuTTBmtBIXe5O4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9jKZgiOhsrvmh-fhKjsgzmv6ExZbXFH9C-2-OaR-sMw&oe=69B0056D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REsvadLqhi8Q7kNvwHbWSY4&_nc_oc=AdmlKwqmN-_WnzXHAgBag6cafX4_my961FbsS_vYR0W6Ef_PKApV2tMLoCEj5IF1sRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7bvqKZQLwwRduLGHU186s5qAce8ZBy1CfN20dsoTkXw&oe=69B016C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AunTQ4bNk1kQ7kNvwEJyhe6&_nc_oc=Adk3LObJQwFdvOpjipBImY2J5HLCphJy15JQ_2_zQHcF_J447pjx0fhMVj7knTXnj9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyiq4uYCKfVPJRYr3WD7oo-f6knt1Nc7IBTyXDaKZsW-w&oe=69B0017F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpWGdNYAFLUQ7kNvwE4JpBv&_nc_oc=AdmQVy5jdHO0U0tNnb6yigdj-CC8mbKplCV7r1u1wByXD3CTKnVwlA-rJd6xvltKNfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6oByRzX2cwbTJN9OMvehrhvdbV_8YUZVTTJpj1j-5OQ&oe=69B01252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d71Xponqf88Q7kNvwEiWIgb&_nc_oc=AdkpFf7WJn6FCSTEXof8qPZQR4e7fqjA8DHah4cPFH340nmB7C0UIWRqeJ9UHZ0TM2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwqjw3l7BD1NPvqy2xrozPMODt0mHWt0VqH1nf15JpGvQ&oe=69B01018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
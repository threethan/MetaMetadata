302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX3hgymYxbMQ7kNvwGla592&_nc_oc=AdpTdaQMce0ecp_ZgpTogG3QuwtkMembSUrovGzEdM8tMhABklaO8VjplPRSNL52aUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af980AL9Y_UJsWpuskhnw33TuPElK6D4gy1elQyk2s9Vxg&oe=6A42942D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wqn0wYdoD8Q7kNvwFrg8WJ&_nc_oc=AdpweQbnTpQFF3VP1jZ537Q38aEUasJ-Mb3alv6H1fkEruUidlvHQSq9C6zAIWdHO-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qvlAOdhxv5-0En-G4etA4V1Ks3vYzBHyGCq9DskJj9w&oe=6A426D44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG9uvvApLXIQ7kNvwFHKkvu&_nc_oc=AdpWaJYUn2cxeFUyzvVhYtH_PZgYL4tPZI5LTAvUoHbLVd4GsCWC5u7AHvu5qxbiwn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i4XsQfvcWS9y3mmy_uqn-ylB9-FcYkM3pQILvn4-T0w&oe=6A42903F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpsFG3aVlvEQ7kNvwG0l1az&_nc_oc=Adr2HW4JRI066YUBP8KXiQMskwut_WylXeltmRZoa8XgAz21c64LipwGk06IcPnsv_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PlGdvM_XWkJB1derAvB_0MxLocDKJ0pU8OGLyk6utDg&oe=6A4268D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt_l7IfDLR8Q7kNvwFARjk-&_nc_oc=AdplVQegEQb3cNMeiND9AYORLSoZKTTTBgx3URPP77YpDA3f3T0eiRNDkak0izTPvj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sDrmtEQEoE5dZU_wtG3ePfjPi6HFnmvfQnv65BIY8ZQ&oe=6A426698"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
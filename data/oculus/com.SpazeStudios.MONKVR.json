g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAXnFDXxehMQ7kNvwGrleDk&_nc_oc=Adl1D467vrYZC51UMZ-lvUjCzNAXkV3TKyQnMOE4OMEaVp8Y5Dmt6gmycrH3KAx7FuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuIAmTbNT43QiibaT7bsbxV6k08Bscchbmw6h5EMfUSSA&oe=69A96DED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48utSUB-CxUQ7kNvwE78mUZ&_nc_oc=Adkzhexs1eMnhtoSzqmjPed8zv633PPoPAIY1q9rqXnrFBy2tgBkzAefu2spXu4ymH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afstu5Gt7YyeJxLt0NK4NU68GWEdxTKWXl3AX06tPLNAMA&oe=69A97F44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QbenJ3jjUkQ7kNvwHdiHbD&_nc_oc=AdmXGpfYDWlGTsB8zqUUTrvuntKkNGBIEzOnveFkf3Y1-g62_ZPhtzQz13cGMeLoYjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsxuRyTpQGRKKCnN6TBzJvLzwVhPcm7OMlnYFAxttahog&oe=69A969FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6khvtuHbZsQ7kNvwGGBjw-&_nc_oc=Adn43M56XN911g_xmHhKjUND_pIo4kQac1Xo80CdGz9VE67KLfMSfpBoHQ_jnwLFWyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aftlx7NozUZK9SIJT8h7oCGVTUtmQnEuI7_l24Az6u-Bdw&oe=69A97AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6um5RH4N-voQ7kNvwHa_e8-&_nc_oc=AdmUSot_WPLzAYyEmQ4Savd2iKi2Yv3N1lypRhFgp_P0q1weTPdNYr97FqB0kaLg9Rs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu3w_1VO_AE7JYVtsHfXxXULYL7jOF200-Glk2FZZFqVg&oe=69A97898"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac9uxGCCZIsQ7kNvwH7lZaK&_nc_oc=Adpw5JjqZY-gaNez2vTGgCAuLtFQInFk31N6-xKSR8f4lkavQgoH-8zwTGc1c-0t8o8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0pzYJjiTPvnN_YLvfaRPQeiL7VM3xWLqS1DeFWGdTmw&oe=6A69E8ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCqgEcECosgQ7kNvwFMrJhd&_nc_oc=Adr0IYU8AB_dLqKq-qMATxDy-pzjwbP6AwkeU1PXAg8s754y0dcPLtWL76erfIn6-BE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACyegMxfMSfnC3IVh77ktprBbqbSE2zW0suXZzwz1_Vw&oe=6A69FA44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTV4wh-SrsYQ7kNvwEN3H11&_nc_oc=AdqZ3f-n00e9mhuRh72S15-ZwS0viu3JfHcoO7q2g2nO0EE0KrEBNnFGvKUixFmeYXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqLi8m65WvEdKOnI7xZh1Nr53MyHhcM1pCZF2Q008SzQ&oe=6A69E4FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGEX44QhAgsQ7kNvwF01w5Z&_nc_oc=AdrN03JHZWmUTYQnQ3kLbyGm3Uk0CQFce3c9EkxU8759nA27kVdF8q1FI1JkGD82O60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnnqL7aAzOytmqI-YkTonRVLRCU0FKv6h_tzQJyw34qw&oe=6A69F5D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCXAWXIhzNkQ7kNvwH3bm6y&_nc_oc=AdqwzJhc3IK4v3PSGDNFL5a84X020GfDNIfQ3R3SDnWQui_gQaHdn1ne6ODJTxarDcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9_hkSgkLhsUmjUsQa1KuSZq8W1Cn6qtp8WJP56Ri9eg&oe=6A69F398"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
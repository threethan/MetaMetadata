302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnp7hTk1bFgQ7kNvwFQXX6C&_nc_oc=AdoxrQ-eg8Z8LBSuoqr0Tqy1ZRg70JdFi_kUL9tB7PwAXpK9SwDmYnK0f1yQzjuc_TE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e_7J0OUI0-jJijt-9CYd6HyvNPTkBcQo2HdFtK5iL8g&oe=69FCB4AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhvX54M-9rcQ7kNvwGdXefc&_nc_oc=AdpWYH2zRNxd-u9uCNhai58pnl3lhv_dmEx6Vg4o7TnqE6pEUdbv4Kenb9Vxy9mSdPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44aPjCg1Pd3BCMazOW4_sgVkTQNEQcNwFsEPFDwyYrrw&oe=69FC8DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c35QZlFdRyEQ7kNvwFs3V9K&_nc_oc=AdqqOpZvyUmgqHOrIYS5KWUKZPFp_SV3lkggkgrtO-HF7hDszkwUwa9S5xXG8Cv_-L0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bve9HqdzqRFwFbFi_Tj3QBzJWxCo904GDWw4HTKfxlQ&oe=69FCB0BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjqpR2yXnmgQ7kNvwHz7vJY&_nc_oc=AdoFoB0Kb6wsffX3cSn1YGbFSA7wvlXCpBAtUCYzgAuMxK1vQ0UI0Ye8fVgGdEh31SA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HoJo-U9olnsqa7c4W4ol8oHqWftOZxHKbrKLKWFCIsw&oe=69FC8952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP7Ks_GcJr0Q7kNvwHsHTfB&_nc_oc=AdqKCGSxrd9HeprV5A26ZFEOJ3MY_ycbAU8E8zxLFkdBCFMUIf-ekufRranZThENrmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59o7aPEjH2SXO7lNYILajE7DycN1Xbp9uFbHNrAHw6Fg&oe=69FC8718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
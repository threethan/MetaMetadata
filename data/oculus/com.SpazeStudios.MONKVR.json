302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co9kROGLTG4Q7kNvwGqWGZs&_nc_oc=Ado5ZWFoF_8RBB-u0ICs69El3ekvLzABaoUL3N6aeA0_usU1OOo3FLPXBbKww6yPm68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdD44Z_0PzgVBL25KC3HY0EN6aflJO7EWTFDGh2Yg02g&oe=6ABBDE2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC5iwiBBJQ4Q7kNvwEuE2LG&_nc_oc=Adqq_yHx8UjXacOK3hui81fKuOx4_ZfrVStQD4MchPMXZZ5zaxzsCV6huJAzp6jcpKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKZDuXaz_jasZIgu6gaIOOmdKsKuVwWzICH8qlQEHTEA&oe=6ABBB744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7qgLbeznLIQ7kNvwFf13WQ&_nc_oc=AdpRRNolRyJSrpMUupRSmu9LvHjFp21GJY2G35vJjz8pS-XejtHLAFuuKQcLncjT43w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1_xabkNeG89JyepCmGbfW7zXcu-i3LTAVDYu5OQV3ZA&oe=6ABBDA3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzvuk3sUwI8Q7kNvwHqoCPd&_nc_oc=AdqBa9nn4Mhw1G5s-LfsTjq0Xmr1Eoob9YUz44uJbhTtl2QU-qAQMWYhzMjLDVewtYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi-1e0EQZSpJcQY2Qcipe_HUaMP397j-OH2JUtgxtKFQ&oe=6ABBB2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zcgpfGKwx4Q7kNvwFpPqXq&_nc_oc=AdryxqEVUJGCL4lQOORBhndbWRdRSlUegtN9gcsJHYjruWiuyCEkSMbpT4J3lamwns0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKupwMAM2K4U3_4StO6G_MiDNT01RXIFe7G1KE-lQPVCQ&oe=6ABBB098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
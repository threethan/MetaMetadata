302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpAxlHx_rFoQ7kNvwFwmzBF&_nc_oc=Adr40A6QU7hzfBKt902_Yfx6vnrIppoZo15BQbLTzMbyKhoC4xaMEj2vdMpXL1ckEJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T0LeHnTchuRfWue_pJUSG5F0Ccrva5B_vlD3wpoXfiw&oe=6A4142AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wqn0wYdoD8Q7kNvwGd_2-u&_nc_oc=AdolgN1H0s00KiLY4G9a1fkHdNaKUxbcVS4YPN6PCmDXn6sHeT_-GAAQp_CXOE_Y3dw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TVSRX-kP0kAGhcoNAjalSQd8H8XZ0cb4_W7LpMv3WPg&oe=6A411BC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG9uvvApLXIQ7kNvwF0TW6j&_nc_oc=AdqJ2PXVPpJYjekkZ5YmyR8erXX4vZkRiOdpy7Kw13E9-m5PpXe3H0yvDFlhhRTVJwc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pexmbC0YOvjusz73pEkhKKxP2YlnVfbo7dguPeDhYNw&oe=6A413EBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpsFG3aVlvEQ7kNvwHGrvpA&_nc_oc=Adp-dfXBZzCnmtaBohNIKuaU6SMIGthYqkyTZ4DuhcnaFQT9LD0Gj8Os8vFw0Y-VFdA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R6IfNU-lqjmhL7_1WgQbdxtby_I_ScMN188OCd0GeVA&oe=6A411752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLM24TDTZ4YQ7kNvwErJzQG&_nc_oc=AdrFtWa48Z50vozfYLym_h6Xeq0dO-IyG5wuCwJKyjpotisyFEuEceCwh-s2RKV-EF4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-fdGjKbWU6A3ySMkPuYvKvDxRI5fcovSWB2z1yJYhUg&oe=6A411518"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
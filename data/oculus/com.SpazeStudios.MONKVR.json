302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJZX5njZV1kQ7kNvwGYxQCG&_nc_oc=AdpP62gv4NGE6QajOn2MvIUUtadmHvX4owkoSF-ZRUHb5n9kCxnEntFbWSBES8WkYf0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mAk4YKg_ZgunmcTPAmDs0pVFY7BhX70T2-E5h5Ib8sg&oe=6A131E2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L155oQlLEYIQ7kNvwHZbcnO&_nc_oc=AdoswUNLHHzqDZur1XAdy76D_vKgg6WKdbM72rriyzADgRHcoyVbvuScLph_EyCThJE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af785oBt3r9GPW7K1PD7bx-DLVUNYqefm0arTYPsCoWQ-Q&oe=6A12F744"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6W5vMLE3PgQ7kNvwGK4rVf&_nc_oc=AdpywEDKCFCKuz8dUSZaDHgA3hj4bkVOuHsxNezNnAlvk-vKd0u6bZoKN2UO9_1fUWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52fvmTcsIbMVTSi_WsF6l0V5iRc5oLU977HFjh5zL8SA&oe=6A131A3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vs-z9C3ic0UQ7kNvwGy-yaY&_nc_oc=AdqgsoWUvpsFS9qCpwIWSfNkvzn1quJNKkPBGzADmLM5nb1T4jqkIiofK2edRlr-34s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HR1F0rYLw6e9ZqvbUWppHSWe1zoZRn_QJOdxfrcILfQ&oe=6A12F2D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQiZS9dsy3gQ7kNvwHVT6NZ&_nc_oc=AdpwzUUVZ8iC4dhXflMzDHNCEJxmWAIWOD6QysoveZGvUd2nKwcLV7_gROmGkjQrizQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s17Iz8gV_a4IaHd9iKEK1KUFEI-SgX40Qo5c68ijxvg&oe=6A12F098"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
7SoBlNR9U1OtTqtL-Vy_6yC_gbl7Ykkvdes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuaVbGzo5mOLwUp9l8UiuxUt9QexmK9VgeW_TZfWpfTqA&oe=699C3EED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3url03vwfkQ7kNvwFPrxlQ&_nc_oc=Adnis-08VNoTucpxJTaAuA3T6YGNBEgf0T5bdARurIqC6g1AM9IuGcJY0JdloHy4kLs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftHy9rNShq9gqa-XHEsmiraaFTsAzkuSiwXOj1Upm2TgA&oe=699C5044"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkTexadq8c8Q7kNvwFfZDKa&_nc_oc=AdkHt4SftfqlezwWQCVEnAHqszNUSYQD_Gnbel2DCdiFPoZ09D2q4cI4FWjDKiZnZIc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs8exj7EXLBK-JQizOjfYwnxEIxPKD1q7qs35QtmzVLPA&oe=699C3AFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Nuib8NwzZgQ7kNvwEwIdFQ&_nc_oc=AdlSsvg9hSvbxSEQFlbHjXAo2hf6TVpw6ciqJMHmkRz9nPgIta6pRkwaPLzznLh64Z4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afta5_I2d2SrT6sf12wBB1d3AU-oD-Q9hsyB-hNi8oTMGA&oe=699C4BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nti09iptsMAQ7kNvwGIcVvr&_nc_oc=AdneJXqQbdEJk7xXDgg9Kx6rLdT7C2qw1Xa4WxLllxKOnalk_mWSaq_pMG_m1B1ElNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftSlWSmD-Hg-lnlG1NOk67Uh0eSOB3AUuhZUv9cffKz2Q&oe=699C4998"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED",
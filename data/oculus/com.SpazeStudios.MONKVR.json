302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAjOfhhz9jwQ7kNvwGoBVKx&_nc_oc=AdpAQ6lQdUFlFE9AdPxmOgf-H7_QLOEB_L06_6mfGdIh72arsLPh0BmzFaxonwRsNyg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6AXTt9uW9ogZ0dH8P33glw1zAalmom9f9AtP-leFQ4w&oe=6AF5E02D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxpKUijjQ5gQ7kNvwGLmlLu&_nc_oc=AdrcdZJ3HKs9IObY2kO2XyGb4_q20oPGxoCkw6DIz24Q840QKTvdPvtV973sXpYllw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxuOrYk5oeVBFREIpZ1s6LZPmCU3_5UbkfR607W9mPTg&oe=6AF5F184"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7AeQDAsgfQQ7kNvwFpIhPS&_nc_oc=Adoh5zzBuxpUgMJTB7uRdrI0cd5pO65z_Cin9bMULXbTlyAoqi78DIebYI3VRvUcJGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDeSN3w7t-VL5Vve05TlxGz9YfkDklg5j33nMPXMjsxQ&oe=6AF5DC3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtWBzFPr4-UQ7kNvwGAHMXo&_nc_oc=Ado2uodR9HwdZHifrl3qMb1w7zjTciBRWzUHzI4E29EGGlrOWbz_5en47X5zIm2mvUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5LEwg0Pgyuc9phiqhYID6LxbNoyta8gj2f3jmPGD0vQ&oe=6AF5ED12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt2OA0M_KVkQ7kNvwEYlE8d&_nc_oc=AdrNaVxfJAd43bYmPfENjm46IcdzW88lUO4bMWtdVSMN5cnd1IexPMnwtUdgUDDVaRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc1VEeP8yerpy1MXTbJx70Oe-BN7wZCPhGliIhjPGPiw&oe=6AF5EAD8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
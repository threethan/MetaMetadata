302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akasO9KiqTUQ7kNvwFRIwpk&_nc_oc=AdrMkjrlXcNctQcflK8-u-XSS6oC6U54752tw65cH4sJPbPALswo8p4_o3wy_AbNgWk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADCzd6u2AKNOJ1AwNAfKxLlwBT-srzgIP8FuuMlAz5ig&oe=6A492BAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km_yd7aQU5EQ7kNvwELJR25&_nc_oc=AdoUMCDxX_H1P3WwiwxU2JdM4VW8yhHalcmLspnbMP223ho2gZu08duUYxI5as0rF6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiY30dfdnMRVL6djI2hc7y2QE8ZoszrG7ATn3R_vBq6Q&oe=6A4904C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJIgQfn17oEQ7kNvwGg95ok&_nc_oc=Adr1Qa-8fwspd2iwVIDgIWNlSD7QZA34gndM_G2eCd8oYyvRkARrYQgZg8uyWGs44Bw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFaY0Xh1UNIQfOigaPX_URujJwoyj1SpZbahdg7MqCJQ&oe=6A4927BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjzQjo9TA6wQ7kNvwHIjMGM&_nc_oc=AdooGMSipnv8MjOzHNigaw3KYBDISWkQxTc2Qk8yhgr6xSLMmwVC4YqwW-lY2VZsSMk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmVnGWxklG0F8Y7uQDfj1o035RAtPor3wzm0chN00ckg&oe=6A490052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5d2trpmOUIQ7kNvwEsI_YL&_nc_oc=Adron9NwokrhxYqv4nCDx3EALiutOC4DmiOyU6Mz7u_NfuC8GT-Pcf78PjnToOyuArk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB43KcnpVl76Uj0s5bPpAWcq2avgJAHvHICp6yAcq_hMA&oe=6A48FE18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
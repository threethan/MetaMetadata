302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-IXQvnMPXkQ7kNvwGn4fQ4&_nc_oc=AdrYAPdQ9GP2gIsiRKaAwZlRX-seVTS7CRudjtpMsbbu811C-1DG-XWup-rQj3Q_QW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCAxVFf7soYuVOJ6oCw6cUh78_ZQMI_3OzDW9EAA2faQ&oe=6A7B0C6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3LdFuS9iYoQ7kNvwHkXCNm&_nc_oc=Adpi-oRCw3-H8JebAMhTHZikMMeMkI2hT8EWQ570Gvlaf5t3ANUvCbyFSvppTOaqCDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkLpcfAAIUz8nbTP-dzIeZTCPdsBVoU7xqqNGMzx-6tQ&oe=6A7B1DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzLhKWg8mPsQ7kNvwEH1J55&_nc_oc=AdovfuEA4uexKc3icrApFbC_TYjI0r8PbeM1eyaTSGEO_22TYXVkI5qSb9gslae_V3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG42Z4PLbBlI0HLbL3z4bfaJlQD2TDWAbBlny5nmRAH-g&oe=6A7B087F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysP9Sd37ZQwQ7kNvwEU6Cm5&_nc_oc=AdqalucU_UEeagGsqKybcqatANpL5BwO9sR79jR0olUhOZ1-vkITGkxS45kkqeAWb_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4V-Czkn59qr4rodtM3TBtPnnJZm9MOydOdrVses461Q&oe=6A7B1952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f0xB1m14f8Q7kNvwEk0HMj&_nc_oc=AdpynluZCOOjMJzknucLJ-RkrR26N8MDkColksgRraVwvywhI4YnEwxOv05xcLU9p3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm9jxoIXzTyqKOaagiLNiC4jlbICdCEj0A34cnettHEw&oe=6A7B1718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
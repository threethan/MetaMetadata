302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGF1e2dPKk0Q7kNvwH6KVst&_nc_oc=AdqGtei3YqYFuq9ylLiWyujHKTys-ceB_jq1Es9ZnK74MMS4-YBby3QKYGfItx4Gc7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiYhrBOWbjPR4JedrtDlM50p2JACB24OIj9ymDVXZ_8Q&oe=6AB1522D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRkroAuWLHQQ7kNvwHmhwNT&_nc_oc=AdoBLJnYGuXNpiT8LdU1_HEkg33DlZi8J_gaENQ7D1d8BRJVN23dt2_9CsfjqkF1RvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRJ0UXYwp8jVM1eCEHTZ3M11V0pWLO7_zoe4ha-Yhe8Q&oe=6AB12B44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuN4JCVuLicQ7kNvwH5ovud&_nc_oc=Adqj3elwAazN1F2F4Z8_x699ZV7zTtFT7ffyEAQdh4vT5mCxDFLSWWhcH7zAjjf0lIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK92MhSw4a15Q1WwFAB0tvtOmEP4ekCJBEgu2q9Np_9EQ&oe=6AB14E3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVuywyNx2gwQ7kNvwGKF_dJ&_nc_oc=AdprG1PulHm3UEQR4C1vwhi6EQ-Unf2T-3ghd3JWDCVcrVpq8xd3UWk9CiIZQTbvS4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBveAIi5PfwWhqqRRn89c4IHxm--mX2Gl0K3io5KLItA&oe=6AB126D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uz-jZ8Qqrn4Q7kNvwGPH6Nl&_nc_oc=Adq70nNF5FhRtlFgwdoMzjCmsD2Caxfxegm1yI68_R86qnMoWsMdqAH0xg0AzdAss8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeg6I11wgKFIvbkyxjyKJ-Bu_qWizX8ben3JainjaBrg&oe=6AB12498"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
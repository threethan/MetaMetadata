g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqDlfUaiBFcQ7kNvwHgmrBj&_nc_oc=AdmaB0-5hzwsrLUOP952yiZo4J5MZJoTOntgyg_BoPaGDq6JhB7XvLzqEhFWE5dnfRw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsUzd89LV9uopQIUo69ApwffhdHozK5OR2tgXClikvGA&oe=69BD346D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9P8N-dN0iUQ7kNvwF2-IEV&_nc_oc=Adkeji9g-XtvhIdIMom82snTCu7pwuMIAyjnAWENHlf6OFJaTR7x88qKE6GjdXj4-SY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwM_vkRnZnjI_e57J8EZcRHdvAcjcbl1ih9X6ze8yibGw&oe=69BD45C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsZlHqv42qEQ7kNvwEiJPFl&_nc_oc=Admzj0rR57_3DifxDEJwD8WKXFTD-UjF9flbqNvMprBEAxbYOhZjkQJI3IugTThKQCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afza4Q18LOk0f8PM9DhGVMt3HNtVz6IGFoPBl9pmweElvg&oe=69BD307F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSg5fpc_S2MQ7kNvwHwIy9m&_nc_oc=AdnliP-5TI4E2eyYCR6vnnDrYzsbQSXEDdybAIq4hrKedtSeCg10D5m55vp5VSnrVZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyg3SN_Q0ttD5Q6yuG1DqO1hn5TKd66m04ubbTVqeiEjw&oe=69BD4152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcm7gSRzF74Q7kNvwHLTxCq&_nc_oc=AdkB-Q7Vd9skl0q2Ir3CHKfswiVs5BjFy8WhDj-9o8TuhYI2lY25JwlU9qvq_-paUlQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz98nwoQ1MGfg-MKwqcfSo9Agm1aQ-gBrGC079xR3GYAg&oe=69BD3F18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
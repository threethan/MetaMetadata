302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG109C0PuCkQ7kNvwEGg72N&_nc_oc=AdqnkYLmPQbqRH4k3_8oc71y9uzhDXO38fwpxIIMJzA59LbMGsWnREh8EAhmG95npcQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qmmNuLCECbhMGUgzk_YVIv_sUzhMCFAH_SgDk9Pr7PA&oe=6A1C58AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0OXQvfpzPAQ7kNvwEA76FQ&_nc_oc=Adqc3WhHXr0xCCSLqFjGJ_xQMx2n70IKKG_kdPdOZB5Gbdm1bbo7YqrpuzDMcGDd0-A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ls62ClI2sErar45hTHoKjfbqjNpT45KX4BX55_IXQ1g&oe=6A1C31C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6TXXfIrzwQ7kNvwGTzESr&_nc_oc=AdoXIIvxiqwofpjAONYNI7O-_f37UB7zz9BijAiibL5UcUvUo38C6-yTnKoqUKK6jlo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cCY8dLTAieDD673X2yaL6hTWgJMg5uBCJXcMkaS1y0A&oe=6A1C54BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxkDQxw5f1gQ7kNvwG2ha2o&_nc_oc=AdrLaSAmDNjiJ9R4NH4D242l0iEt_qgTKAPo6BayJ8_N8ofPXaCZdKQOFwr6JebRAiI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-4IHmF3ddL-Vi4qvGcqwCxJN46FZdU7IPaJG-sucwDw&oe=6A1C2D52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ambVuahTmXEQ7kNvwFOPmvJ&_nc_oc=AdocsQKpZyw52xlt4grq5Rrn2gQAtXRgJPakx9cZO_L1IljaegCe0VLimC_3r99eDSI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IiIDSlvl9yb-RYNH5zqkJoSRc1qrK1iyWL4r3X8T4_g&oe=6A1C2B18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5Jiy4nykFQQ7kNvwGflnGK&_nc_oc=AdrvGwnEImpAJ51zd-5CSTjdan1lvIbqxUAuhxowC6lOqVfg-E2uRJq4V-NTcxPowKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2uXlQFH5DjpUhDHZH9p5p7hesp9m-6F_4r1UDlf_BpA&oe=6A38082D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewgkLDCiPVEQ7kNvwGU-r4N&_nc_oc=AdqYk1zyrLJq4K6vnMmvh27hwEPijbpDwXKreT6qR2bxOBt4y8hgy11b5PeronI8Q-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GbTm7_6DnNLv7RSrQK9AEizP5Z9ALRJgkiXBhsVko8Q&oe=6A37E144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_OO1fXv5uYQ7kNvwEp2XiP&_nc_oc=Adp3JvxLWoQjqbpef2pic3uapQbF47WLDuwRw7ZHAvCfiql2pXjn15dLZVdDLo3Ql7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MoZrkOzHgCtR87LE8hGRYAkN0oorN_H6cnigMmXsR3Q&oe=6A38043F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BeUCdLosbsQ7kNvwFRLVCh&_nc_oc=AdpUL04mbecsQ6bTrpDD6bhpgttnuPv_YnSxuvd4wFULX-EYZXykwN9_PMc3Vi3MvOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ON9pbSE5nMPXeYh-raMlojUJ8BUxCT8jx4t-AbwCwJA&oe=6A381512"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz0l7Z6T-5IQ7kNvwEWLy1b&_nc_oc=Adqk0yRLtz61ylBLpg3mkjsK5j7PLa9ToQRhjXw_7ZakaL_HB_nB-tVNVhEDpMXkFog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r8rSYRuHCX5J57_9xl1o15cY2LmNq3yhl84PtP8KMPw&oe=6A3812D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
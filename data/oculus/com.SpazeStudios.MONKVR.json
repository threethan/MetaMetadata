302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5En3l-D7yM0Q7kNvwELV4vj&_nc_oc=Adq5vKvb7pkNDlMn_9tRW0LOhVi_y-swd8Ht7CfyVkNPeSNlf17dQ2mYpDiq3dwut5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMSg_4tG95lsJX2XezSkGu8Ri5iUMCAqIttwhoKu5CYQ&oe=6A4FC32D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZkp5ZbVEu0Q7kNvwHYRrs3&_nc_oc=Adr_DQjkm_DVZP2hJtytrck5E7UMmb6SOc3gV8ABh6yO4M6_97uLWtqbvBfkcd_Gtes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUE9FEszv7mK6cJg98ATZybebaIbGdV8gg4ZHo8Dbu7g&oe=6A4F9C44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSGq_B5CpHYQ7kNvwE1lz00&_nc_oc=Adqr2HuBGLhOdHCdvqG2zrHyhb9NF_UuoY8nvI_zceg06qgDBO9CsXsH1NSZ0aG8Mk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCh6CHJvBrYh6XHWTeQBCKviIZYbLBAflnGyhtShS9_Q&oe=6A4FBF3F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvUpSyacsKoQ7kNvwGaG7lt&_nc_oc=AdqG57f2tRJ39sMQgejFa_Z1ci2J-2bkG8C-hW5mruSioAI6ghLSf47v_OcNisr5KXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqjRIczrmRaLCe6AckzWC1lXLuvNsSeuo4FUr5LCdAvQ&oe=6A4F97D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Ew91faoqcQ7kNvwFORelN&_nc_oc=AdoMEexJIgISoSXQKgkp2v6gKjzLQadFW6IFJiU9cBFN2svQLUfw1_TAA-kn6wrU6TM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSCroJXhyr6n8NbX2iTjNZnye95a-Q083uEDC8O0NyMQ&oe=6A4F9598"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHtIm6CnfBEQ7kNvwFG4rCz&_nc_oc=AdrayVi0DLbjSP7ZUupSmD8ekB51c84k37NPHfBlMjrmUPzljIZXEP11VfuVp-syMXQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPusOfJJnn8_nr7PeMbRTU0eW8rlPs8R91pxT8aHV-zw&oe=6A99972D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue-GZ00QWjEQ7kNvwGC1kQ1&_nc_oc=Adqxyi8FWVjcInvRiCp0csEPyEcbG1x4fnULdTBH7VjrdudULsgeB41vVPNUC3Kego4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsUtDjf9Bpvtsmg0A_M5kNqAscoHkP6IoyoIHig8t9lQ&oe=6A997044"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esYjMfrbpqgQ7kNvwHbzjXx&_nc_oc=AdrqeUrDiZaMvhGIfTvkuNfGNyl9SGnV1azQ0LR-3eWmrKUwTx0b647V2tpHks3R9ts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQag1NxednSNS6RkcL1WA0rO52tXWsUbX-VjQ1AZr_uw&oe=6A99933F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDQb19Y4MaAQ7kNvwG4YegR&_nc_oc=AdrlSdwl-12PRoursyBNtNXYwawBsoL_TRQUGbKPRhpZUnX-kDRYJnGM4mJ8U13igcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo5ENO2vo6NSVxzCptuJNeA-S5wdRhZOY9TGkJXN4gFA&oe=6A99A412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sns56FeRTG8Q7kNvwE2qG-C&_nc_oc=AdoFyF4abDjFTFXWzNWlM5mBViAmBuNGpBu-ckbe30Wgh6K9xI9HSTArVtHRF8Vqcp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBeVrKP_sx-q0IevlTBI6ycw_CVO2wNNwAY_sJb80TLw&oe=6A99A1D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
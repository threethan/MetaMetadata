302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr2C8fmd3GQQ7kNvwEBtPvL&_nc_oc=AdqAO_ljI7mJpAfOqNsRfJSGyE1GMgeUlZ8Zh1wcWLDJk_2MFIsTZvaXkeDyMiTaYwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_jVCqPKFXKvVb3beX3M6ZaTRxHAdO37PcFodbzfSI5A&oe=6AA817AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfFLrTz8EVoQ7kNvwHqQ67h&_nc_oc=AdqvP4iBeCAmg5jbdInE6oVnJJfOrut6nkUljWZqkOvpe0LiyIRU-KUViIGBd4OVxTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnMXJFSprVmQGMDXPUCM5TqqUhA5VzdrxFDQiW11EOzw&oe=6AA7F0C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVZqrMqEdtAQ7kNvwEiyOzp&_nc_oc=AdrJF9PTbKcJa8ZDFCV7-gCIDgIMslESZFVAifS_ouaXLwGgDvVU3RziG0486fcX-zs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhhmfnYuC2ztk9evztFKYkx0XMD5zvw3mg_lM0bDmygA&oe=6AA813BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL7GPIHhsDsQ7kNvwGJOA1h&_nc_oc=AdpOB-Fpc6x-2qcG5CJ8K_TarFqqc1btsbmSFrn44XqWmTvMBPcuzkV0qDen5jUZhSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT_QWrXExK8GvS-7u4LdvVu9hKNOXDXyeIvYWzg9zKmw&oe=6AA7EC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoV5VmHtuvkQ7kNvwEfbdlC&_nc_oc=AdrABm7B6XnCozA3E__4DAC9GmagKhEHZDagD-UW093sbcXldwoFzRffTidfbQq5RT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjKu2S7Y0-gunaJmk2MUAJFlq-Wtg6n-RkHvwGDVTxyQ&oe=6AA7EA18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
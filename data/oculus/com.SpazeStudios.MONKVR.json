dCUpSmFBRDv8zI1ok4KRv-H8Fe66PTiQph8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuiQTIdKsJfmiNiziCmD2KXCcJmNW94fTqHkdjsjWBY4g&oe=69A0336D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQTxuNlVBG4Q7kNvwH7rKNJ&_nc_oc=AdnqQUfSus3CukXvSWm1Pm3mPNqkYUfhkce9_yvGkX5W6HCR2RDfTdQZJHryTEr51zc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfskPj6n9T3NpTtc2C13shB0uWkCHVbKtoQucmrFcELtuw&oe=69A044C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH3sSzA4eGAQ7kNvwEa9ta6&_nc_oc=Adk4W1OJEA3fyxEiOTyVcI9LGKP_uGszQI6Ze_RU3S3xezWeqNeAzk1CGZviHbi3nrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5xvmcL9CwLtKofJs2xxLIjd5ZnDzY31Ke0eqI-n0PDg&oe=69A02F7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETVV0B4W-2gQ7kNvwHKpGx6&_nc_oc=AdkphIaru-1foXVYk_F4VVGqpnHJcHa4CTV8pO5803Qrx2k33wNvTj-JlgQjpcQujDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftpYs6uID77LSfAo38m_YxkPe3MmI_xAKX8wwp2Z2CM2g&oe=69A04052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciesTMj4chMQ7kNvwECEu4a&_nc_oc=AdlCdYc-1EFaiXxBlwAfkMBoHowEUsBEaKeLKM1y9j_iBak4qeqOMAPFEO1DQeKI2Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDK83wB2Wsd8BxYnAKiFqp2G0O5DWjXSsHuZ83QfklYg&oe=69A03E18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED",
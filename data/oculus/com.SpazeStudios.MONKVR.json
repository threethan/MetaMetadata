302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6FazAbWOksQ7kNvwHC_hSS&_nc_oc=AdrETN94-4gBdd91r8lJgombu6LJV_bichWHH3GIv3ghr5QCXPOPuPHZ8WCR6yPwQoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dzIC7YCdpOxf70qy7Qog9F0xFKrhApiHRT-4aUXl-sQ&oe=6A0740AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2mOouSBhI0Q7kNvwHTzmnW&_nc_oc=Ado07LXNgBqosyLFClmLoTQFSK_0v387nDrOdQvZLxtysINsrRgQ29xOhpoqwP0-9-8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IQiw50qkIOQsVEg2W6j-90goQZgcCPqn6fLzKREh5sQ&oe=6A0719C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fl2bZ_N2bIEQ7kNvwEp1YsL&_nc_oc=AdpaMLB5BB_XI7OuNcaIYbnPZ6qzVpuqUfQZbFDfz5DAOUjG7nAskVXqCp-84GzBGbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yxG8_DuWvWfGjN_2hSlTASBHI23ii_e8ErR7HDk6VJQ&oe=6A073CBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us439KNHUKUQ7kNvwEFvSCP&_nc_oc=AdpppESeVhkvYEXmg8wt4hwqlYo3GY3q67ZB9nWPKQ50yaQFkrWptaDTcWWcGgfFnjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yT3alFzZQxEKSnQ216ODzkJniKGPnWwxpmYGuUYKUtA&oe=6A071552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUjp76Xl9REQ7kNvwEV1727&_nc_oc=AdoF_M-6xqye_7gTD2c22CD-63dgO7UQZbNrc9GWc1A2q7tBxUncMJuiNfsraIfjRIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MxJ9__uzpw4cWtY_PjAu94qWhNDOlGmlwtOe8EmszSQ&oe=6A071318"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
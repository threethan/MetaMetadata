g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ArPvFA0toQ7kNvwGFav5D&_nc_oc=AdlcPxylEXp16cj5nrmC_cMU1CzdroU-BsoJc1Is0LZywBuLH6V1_ydZoj8XJG4qug4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLIhKbjOfBTFiQgSKLn3BHEuze5w1Fk1sIsMtOYfbuzg&oe=69AD626D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REsvadLqhi8Q7kNvwHg5Bj9&_nc_oc=AdlOu399AZ7v7kGZMaHZ02w__46oE18CtiKgmqfHrTlJEbFHnFFgIcVJmt6HyvpQtww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwq71jzZ2vg40M5vvYJx10KCH9OE2W9aAunmKK8Mt0uBA&oe=69AD73C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AunTQ4bNk1kQ7kNvwG-OXvm&_nc_oc=AdlFMAMIcwt-jplvx5rcZc3siIPi_z461_4SlR6eMMOccQeZzt8KPPaY3Rg1aNLd8kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAIa23jerFuhVDQbg8Y99AXINAtHYV-wwQgnPadijMKQ&oe=69AD5E7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqpNme8vXAYQ7kNvwHmJLbb&_nc_oc=AdnyT1owml4q2x-VIbTHSHbOs89kFOJPei6Vci8lm_xRSisIk_AizhCRCOZ02flXuIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfZ07bGKoD1sM120gVQt2Qh5x1tpbPJ6PR_fWa9wAbkA&oe=69AD6F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ATRZvQ_ms8Q7kNvwGxxMyH&_nc_oc=Adk-ZSy1urejoCY37GKGiJhwZcTpmcL3mF6dgVrVK0AnlBU07ezpyL1BClcNimPJLBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy59SdLZ6bkStjaGAdXmSDrIeXDk4kkbb7RTNfqv8mqqQ&oe=69AD6D18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
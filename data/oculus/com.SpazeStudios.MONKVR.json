302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awN5ziJ1zccQ7kNvwEfNkXw&_nc_oc=Adp_kYl-J0pBLFpS4NYdp-nC5R1aZJZWNkG209X1tBZJXRKDpeqEmGObCPKRdSx7hNg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M4pirGO3SfOHx8uXS-wUVZuQxAdTnpNgLT0ksfySI1g&oe=69D7926D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkgCLGO3-0IQ7kNvwHkY7Nz&_nc_oc=Adpzt7TMfMKn8MvjCtuUhpJGOJ_7bH2ATaU3eJLfhWxd3MhWbUIwGQVG-ShFoW5lC_k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27OK9R2fyK6YnhvDTL3i4wqZX9rlgNFAJWM2bhGh6mgA&oe=69D7A3C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbEAP8xpvj8Q7kNvwFe9Cby&_nc_oc=AdpAqQbA4JoyNKv_VZ4f6Da-SOpjYDXWqeeQ6-tlgDtH3PTYA7meQIRoLtYKPw4p9xU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QI_6LX9n7NAB-t4Sngo8a-Jz4C5_pLKGS-NdmyHx-AA&oe=69D78E7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOOHFGXiri8Q7kNvwFaET_9&_nc_oc=AdrXU8m8agaEDv7wdZ7YfKNHVi2urduxTZJt9ES3bcsMr6QA4GqKZ88ZzpNDLIBJuZQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ewxxqgZ1epiLAQbuyaESc0Zux6FIRCYlVh9vsDpE1tw&oe=69D79F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq3t__bFnIQQ7kNvwF4nN8H&_nc_oc=Adp8Re1QpRVFRG_lVTQHgR_UFUduA69duniRS5PazsgabdcsdVTN-Sr33kOMGBPWPoU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wqLlqCatixvJTnEqRNY68NQ2w4XPZC44PocBEhAysHQ&oe=69D79D18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
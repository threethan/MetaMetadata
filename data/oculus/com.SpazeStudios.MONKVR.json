302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac9uxGCCZIsQ7kNvwFxKcu8&_nc_oc=AdqsIBNYVSkUIz5elCJiqbaNQ4j3oq1TNre7qduaZncw2zacEJFhBS5x0ZkHFAs1KN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT4cmt4WrCMJdfBmGKbOyvjnl0uMBVkwzBnkAfGv_p0w&oe=6A6C8BED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZKX0deugSAQ7kNvwHx0CYA&_nc_oc=AdrbMaFma-fKfYERBJXZ_eReY-GIR4ATeqhkQ2SLprq48ZU6wn3nPs3vgGfycfaBBYg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOTwHSs2Nc5h_nZF-79Hk7r5I5U8i0lIWBkn7u1iPSQg&oe=6A6C9D44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac1QHDCD8r8Q7kNvwGm1ugg&_nc_oc=AdpGelaUMTrwjzStRV_ziYm7OSG2AdMaUFwYxxl1ELxduJYCNALlPZqGQkhYECjeyaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjrssIpJQl8jgoQp458pBVNQX-Q5bbT6bzI_bqDR6WMQ&oe=6A6CC03F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWJ6ueE7IK8Q7kNvwHSWHZd&_nc_oc=AdqZFGF8UWZvjKrf5FV1YbQHlVgcnb5xx8xBZ1L7Ylcjbuk-BbBnyYDp8aYjOyxWqTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoD9ZKRz0WUiVEIDa9mJWxiU3DWWU51q6IK3QbydLcmQ&oe=6A6C98D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCXAWXIhzNkQ7kNvwGAPYoo&_nc_oc=Adpnkkw4exEtVzx_SN8W5s2zJB7glLzTi_Nao4_p8-n3KKo3VFZUVQ_Ald_PTanPeDw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgbC095p84LBUACPlSxKT9VQdGJneFgd9YlhKOk5_1Vw&oe=6A6C9698"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
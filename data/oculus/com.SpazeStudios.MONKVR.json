302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr2C8fmd3GQQ7kNvwF_Nxcy&_nc_oc=Adqaa1hoJ59orHEjzN42v5EM8L8NsQ4whGL8fjcmP1lKjdsu5QjWIeAAasZvsGxTeRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUBu89dSF7N3BOrWM9WGaPumtE2sp8_bsE93vdaJjiBw&oe=6AA574AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGa4-rcAvugQ7kNvwEYWjrF&_nc_oc=AdoMZvopTrBsWNY4pZO4fzXEceowB2OzbAPYGGKVU6q9ercv8LWcLWxehAdWaCvep3c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIyuNtSN4CcCUCZ3C2JNmZo-rcpylruf0TrFnalM0PKA&oe=6AA54DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9aB6jVXzXUQ7kNvwGq28eR&_nc_oc=AdqTNpx0N9Qr27hfao6R0duUWHFxJ7PYDh0AJ7YfHnNbzF_7hHkt53UB2ILFRZbxueM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlE5TJN7QzyhSlBWfKcI0EXgkAQDBQr43d_CRCN7FaiQ&oe=6AA570BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtmoEX_K0f4Q7kNvwE5dk2U&_nc_oc=AdqQUqtmAfOD1XzgQX94DiwhP70qZX8gzis-Chg8ntzNwvxd7rLmqvqNxiomw7dcKTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItQdynav_ZxWgvpPZ0SUo0L03mgUMqopg3fndoYD06hA&oe=6AA54952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QoV5VmHtuvkQ7kNvwHzvzKZ&_nc_oc=Ado3HgRogg1cNL1MIiyl0eiGJeMx6U569dd8gsB56lCqSNzHUu3t4x1_qekpN6d0DsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqzT8JyUzSEivF3VJGG3F4dorUpsRG_wPphjyqqR4cew&oe=6AA54718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
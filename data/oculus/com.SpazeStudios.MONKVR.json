302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZKrjpj6NO4Q7kNvwENGOwB&_nc_oc=Ado879zzSCz1NZSUIL8V_6DCQTcsywdh93e4WVk57AXWyzRo9Vw9NxNBswDfNGD_oWI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPURl-e6rk2ocG18rUgj6MFwWPvAJmw0rX3kVYyd5FGrw&oe=6AD0F62D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Snx9WdBsc1IQ7kNvwH5NEOq&_nc_oc=AdooezOopYG4KV0Opu1Z_gCOoOrBaT2hvcnM6kO3QTzCwaxU4dxYlVPkb7xU0O6WuzY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3S-_Hl_XFsfy9b-KHw2yPswXt_HlEP4Fa-atq3Xeveg&oe=6AD0CF44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kW5N8tCvZoQ7kNvwExLl3H&_nc_oc=Adq4EA4hPtBucS8_op0XBuse0u6aADdULQPyJTxu8eTr9fCT-ZrobAwgUB52XEb4xK8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCeWTmw7ODo6yrXN9iBTV6KbbA_pKcopjLNdr6Noo_3A&oe=6AD0F23F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28EpEgPxvhwQ7kNvwFwJG1G&_nc_oc=Adow3UaSOwuq31hC62sXB48_DPNU2hY6x5Y-9hogmoFwN16nIuUl0RVIW_trQsEjFD4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBWTYDWGYK33QOPysg6C-f23jU-oUjW6yDVVnUyEYV4w&oe=6AD10312"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVjc7d6dZCEQ7kNvwE9GEcf&_nc_oc=AdoNpqL9ZT-u7rIfHg3DbPVmrzYGvngmx7a_Ca8A-FKZFp2jpScmNHjFEeVlaIX-VDA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm-a1WkXVm5dzz-uquU1nHO05Krd7sGCmZaP2O16oFag&oe=6AD100D8"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
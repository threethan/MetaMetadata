302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZYicFMal0kQ7kNvwFPDf-2&_nc_oc=AdrMO17K86lcJAbawoVOWGz0Kyjx_dPD60E-B1oPXXyNOOK7ssuhiTrrDIfbKeYQLJM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHg5XC5qGEOeofLXhZ99j4njU4qGrWo4fcX0GeryWhsw&oe=6AECA5AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFp29L7EtCgQ7kNvwGneT_4&_nc_oc=AdpFEOLpVyAOK3VCc1s7IHtAUzgGG5OV7V5GpKmfCHB0a7tBV-wgQ9t0eRxCOq2ML2c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnikERnh0Y9cTguu0VnjhbGG7CUBVAob6OcTc7bbYokw&oe=6AECB704"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB9ETEGzs7MQ7kNvwGzEVdj&_nc_oc=AdoGPlQGhtNOVrSrqlZidEREf0NFfpCHl6SKZQ2DAoUYVYkPZckC8TRF9vjt4YY3N3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5_Lplb2L4c9kMUN0WFx69AFjV-6HhXLMFqj1sT7Mq2g&oe=6AECA1BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPpBILbGoN0Q7kNvwF8kUEQ&_nc_oc=AdpT7QIbjDvyQ-aMUr-mPDFdGeQ5djP5Vj3kunei3wAr6LelzJNLizdpE5FGQ1vZ4JI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdAv5DLhzwkk7R5WDwqVgXdXWo62h5ZNLeveAbGuh2sQ&oe=6AECB292"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPArnMSS3rMQ7kNvwGA4bhc&_nc_oc=AdpfQy9cGqBzGaYkXzDlQl1bBND9bI082BSFmt0NhQ58ya470sJi1y3wFVW29PtRYWs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROSQjRc-Opnmn4tq4h2-uV3Yiu6EnVMmM1gOoau4YE8w&oe=6AECB058"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
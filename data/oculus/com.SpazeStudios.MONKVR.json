302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgNt3gDHdiYQ7kNvwEUSZdJ&_nc_oc=Adq-Bz2tFzkf6y0OWt363ItKRkv9Tm44ARGl1SkvobrnmOwnfgtfZeq6LhNr9ra_230&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWQkpLmRETHXd8IJ5b26jgZCM5Ah9lQ1xzA__D0NQ7dA&oe=6A9D8BAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXsjZYme1jMQ7kNvwENE3b9&_nc_oc=AdruSkeFsr5zg0_HxPwWT-ACEr56JyaReFvhv5cPSIY_C6Y81tyLSVJMU-BZi70t3ss&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwVqDPpkoXlHhAOnCia285_s5mCrogxGd_R5wfFZUo8A&oe=6A9D64C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnIJEfZri8AQ7kNvwGrd99A&_nc_oc=AdplEi9eK3nPBhgYQiJkWTIEpguHj4YxDtF9Yo9XI1_fzDRan--7t_s4Ti2hzzKbBE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOdQvOxn752qdfVbjvgiXu-IAxb3-Au02IvouDMI56GQ&oe=6A9D87BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQgQVw059LgQ7kNvwEEWHe7&_nc_oc=Ados_sN2tf3kXYULRjElPW2l23e3_jWEXR3lp0IZ01-YRrZrsLa_Y25ka2NwlBgFR7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1NzlzJlIbVcAVgaz_5qgHU2w9rs6KkJ1kqFUzgCjQBA&oe=6A9D6052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc3VOLzh8HAQ7kNvwEBBJss&_nc_oc=AdoHR8mqLkVwCYDWKPFK9Z-kND6XJcZUoZn6v_N1F99WhdIFphOEgGtd1A6nY_ZoXmA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ2c2SFDbN7q_ODofyrkTjc3U8KOsF9-9W_kS0MJ6glA&oe=6A9D5E18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
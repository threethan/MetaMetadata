302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMu-FG1tDUEQ7kNvwHK5pwJ&_nc_oc=AdoUhSdRjKMt9Jkqar2XlhI1AbsxzMnOaxUaQFKNVjjyDUGBlMAyMJ7bQML_LmLn7RQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHQX-mYbj_6ufxUWxWGbys5UopgdWO2eL6JKzqnPAH5A&oe=6AE75FAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mv7c1KfDAvoQ7kNvwEfp3V7&_nc_oc=AdrzWHQ5B4wQm0fAyRt9LFDPKxMrV04gE2w3XNvdE1Cbz4kK42NG-42aTqz0RuvaeLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWhLJ1PHWFioP1VBRAgKcN87mznPS3ptEny_pX1KEJLA&oe=6AE77104"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChxvZ4q8LIQ7kNvwF5gdO1&_nc_oc=AdodhmbVTPsKbSqNK5iKuo8MfCse2-R6dX3848MHWYoEK0vFcmSSHuKqffZmic1nUkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY48AuhhSUDq5woPiDCefn-gZZ3erzwVjeKTcqEhIOLw&oe=6AE75BBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZJ4akuCLUkQ7kNvwHqe4l6&_nc_oc=AdqrWn_-XCQKCj-GO58KWMNkqEpZRFfyy-RrJeWrXwlUSVr8RDkVHpBH7aWjav6riiY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmSlVlF0m-XEw6XBiqIAR1xHcLkd4JSPKyxXvR9J8oTg&oe=6AE76C92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yhNrauk2FAQ7kNvwGq_a18&_nc_oc=AdpedAo13U2x73PFi2tcWxkrnOacS2bujSgtad3x4iVLt8syJqPkpPjqmjCiHnhRbO0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBLhYkmyP_zTAlTnVcXTqXyWbmrRvuGv6oekGIvnTdmQ&oe=6AE76A58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
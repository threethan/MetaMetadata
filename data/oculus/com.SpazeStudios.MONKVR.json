302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmlfBq8OZ-EQ7kNvwFM1Ldb&_nc_oc=Adq-3wlA6F_y9eH6MtvUfx5RpBmiWSvA5Q63SZXw0XTBECA4fRRBYea9ZNl50nv3-uU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25RLgkEqWr21ko2u4ICCMQU1ounfL4Gj9SmeTEjg42tw&oe=69E7646D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bX-8Ig0MGw0Q7kNvwHBbp-c&_nc_oc=AdqyBTXpYxSWbwjXeQfM-OLo-9Mufl6K_XdIcxQAIhOD_J9UUMy4sfbG5RcHWDxnzIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26PN1qoEUNEpgc2Z6WboLRcJMeAG6HieNxmFoEeK1SQQ&oe=69E775C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLc1v_AO5iwQ7kNvwH1VB5b&_nc_oc=Ado-RIGtrE2WfkpLQz5vJ1PHdGXJ-GswLk2Raawa9u5nnGQH2IJPMHCWtPxV9NpqkiM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IQUga69QwWAqpLneKhW0TzRFzemDvFWnLk9E35NRilQ&oe=69E7607F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJjXr0l_tRUQ7kNvwFG0Fw5&_nc_oc=Ado61vrzKFKhJPnhO4W5dfszgEP1PaPl3iEb48xSQhC33dVqtRRla1h2dTmFovvZza4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16PiBlIK6mEKjom66TtTefgq2AOCIGpBIBk1y-yRM63w&oe=69E77152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsy8kd_uafQQ7kNvwHdAG9E&_nc_oc=AdpyJHw8oelHEsZYsracx-tQ4K4T3_OaI1g8uMKanV8CvdoHlsZIHKZcntF8-7Y1pME&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hBzhPkC_S89RZMo1mzVBJ8GN2kp-TIPXG1lc9dym4rQ&oe=69E76F18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
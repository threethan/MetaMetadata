302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndDYnOUzFD8Q7kNvwFWqQ9F&_nc_oc=AdrPmzBQiOjrer_vhMbvCV1mTUBo1KtO85tokG3QcFAOasaAtu2vrAeF90sWwYatrD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oDPL985B5u8v9ELgOp4HkPtTik42JfnXS9zvFyWU2kg&oe=69E36FED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5sj_JwxzyYQ7kNvwG_OCno&_nc_oc=AdpqfNpBr4Nk4iOA7NPt3vyrV5MBM0mjmkyJmoPKgXPjqcddZTBAOJzdwPar_COTATU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36MVSE44ANW26fFfKK3JudMfLShYVBXtQFtGb-snIsbw&oe=69E38144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaqKdfuKyooQ7kNvwHMKTNa&_nc_oc=AdqOXEyjH4NQwDsj0U7q4i0_8FWrsYUYziIg6zH0ADGKTmWazVojkyeiRkzhFB97l4A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yPxY35L7Q9wxI6apUPnd2enLSok8m8CiJoZU6_8wrxw&oe=69E36BFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWYarVmXc0Q7kNvwHR0J9q&_nc_oc=AdohZb3OnAmtTBqrMbdxaf-0vRyUR3Bs2iV1s6ns8xoKDlj64-gEyCWoXWYuTGKrf20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aaQIxIvPX1kOG-5hvk4Js9dmDTxapoV6o-Cf6gAy1Bg&oe=69E37CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiUAUyt2hHIQ7kNvwF2Ipap&_nc_oc=Adr_flIYvzD3vdF2Ie6Puta1yLZyDZaBsfitAWcQBb59h3eZGQsTuMAXIobiuX2gGKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EqsvcS5IdINWKm529rQNqSathRJSV5dUOOhB_jCCRSw&oe=69E37A98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
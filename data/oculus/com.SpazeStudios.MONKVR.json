g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgxhWXfvdYsQ7kNvwGkx1ly&_nc_oc=AdqKlyW-h2FwFQwYwmGMTX7wvxFqAST581_NsW8mde_j5-fcFkRoalhP39v5B2lkkKM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOU7WmxISe4BVUCNzsmuPNnSbhRrZPFy7XUbB3MbGYcQ&oe=69C128ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9fWEpLeCbAQ7kNvwHfGUUL&_nc_oc=AdrdAU9P-tNVr59cO4H5ROy9mH4b4iea1V77C-181pUX4a9E5EkM44KL0exSIgksVyU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzqlKPdMUHd6NIxMVemKH7tUom_UAfeSUpp-nXOH8qIyA&oe=69C13A44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vi85C37MpMQ7kNvwHSWF0q&_nc_oc=Adq0hcJAoAONVpBb6m63Qm3uPePP00oTGcFVv_nUcRnrP2A33cKlKvuUI-ZYujQvA-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwjd4TXQFDKSULRk2oL9tsBicqYWUfVkAyTk9EApEokHg&oe=69C124FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YKUcuzJIS8Q7kNvwFqHt7w&_nc_oc=Adpg8Y9y94JWhi-9RBpsu8ehWycemXSnkr5fgvhnvXQEpisDByYKTxsRnEkCrEAffuU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2K-if6DWFtLY5ae8RcjYLETpGTjxnidEm95ArIG7YlA&oe=69C135D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ7NboJJzAsQ7kNvwFf-gnP&_nc_oc=AdrBuRiOvuptl9p6Th1rLYgYqzHiG6MFb3zy3tqXnTVNKaWrG8QvxBQMvBx0_boPi0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXejI7t2EFd0406WdCRRn84l04NOuh1fn0hzT5IiOihg&oe=69C13398"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
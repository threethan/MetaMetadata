302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkdV5pooyeYQ7kNvwGmHODi&_nc_oc=AdrE4kMPqEnHFntBWIPBP_zTsH7OGJE44EzRY4ZFM2-kZ6KxgwDHtc0vcfxjUKzlgm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZbjAqWc4XS7G7B36sJTlJrPaDgnxqMJHltD5v-yb9UQ&oe=69FF1F6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhvX54M-9rcQ7kNvwHC8vP1&_nc_oc=AdoP4X6t6FzTe4dwtMmThGiedL-I9y9m2BXanPmkLeIbfeNazfiK5r8oL7tRDH5n57E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IaIJhSNwaYqXonjIX34XC4YYz2nq11phAlVq00KcHjA&oe=69FF30C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c35QZlFdRyEQ7kNvwFbyaSC&_nc_oc=Ado7gftdt96hrcTHpyABlGshQZbkZ-yyacoe2Gjm94Al6DYTce1v7b8t1NV2Fdfkt3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oJHb4DBZekyHRssrc6p7AFLNEffqZupdAXsnzE6GWug&oe=69FF53BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yACpWHyGAR0Q7kNvwFde3W7&_nc_oc=AdquMFTTdM-HMytt5seR6fuNixXeE7-8umtVNjQGYDGllh75fNd7MksaC0MGFwvi_fc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73o3xLswSi-B0s_bIP6q3eN8ljGDjovAAqvVjlDknkBg&oe=69FF2C52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Txg9JM_kMQ7kNvwFLJ0er&_nc_oc=Adov4Ix-mv2mIxkxAkNJCf7VEUoD13Pj-qHl6a51F0bkwCc0182fcLtMe-D5SfrYZvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i4cxxST3iFEiz5nufRFI8pXjeSapAV84D50occQJ9nQ&oe=69FF2A18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
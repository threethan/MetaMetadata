302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK0qW-1w48UQ7kNvwGTiRSV&_nc_oc=Adp2vMGneqgQ2ea2f1gpdJIuxLlKu3klcyU2uvDlwW4ybXtW_ZNRw4El0VBitHn0hF8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rYqO5HLVDJFXpjKnSzQIR6cRKzuEDZKsDKaJrMIegPw&oe=6A26E4AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1acj5yxE8iQQ7kNvwE1Qxsw&_nc_oc=Adq2WqCoZ3hnz8qLdCVLCghpxeaDbF-QwZmgCTXNYc-Adg9ZVvU3LHlGIIChwdBSqrM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m6SlBfCpqLpDHArLN-328g2a5235uc5n2uqcSlR5k9Q&oe=6A26BDC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eReaBaRYAwUQ7kNvwEhBTjf&_nc_oc=AdoZbNAQL8sazHOPVaHmb03jNn-oJeCV9BWbqxVr9D1LPm5NXpP-DCEsYkqYFoPxltg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m9D9CRR01yYHibZfD1bKSCyOzp-yTWOTx_zNg0orEVg&oe=6A26E0BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYtbt0X41hgQ7kNvwHIOPJ3&_nc_oc=AdqSuMgBH9gS-v3lVEsLRlHV_oN8qujyXQzzATmI1KsTH71EEpCSB36MwwvBP4or7bU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R3OOTWRllDy03A2cUnoWwQrPkwU4CzIqxjSwYJqw8eA&oe=6A26B952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5l0oDpN19gQ7kNvwGbbiQc&_nc_oc=AdpUc4JZpYwJKN-W79s-uGdxow_Gl8z-aNRcbYYQRhoNs9q8QoB7BeK6NzKoMN1FGDU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--nL2U2C-8LIqh1LZeTgw8YfnzSOfBkeXtQxgPoUx_tw&oe=6A26EF58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
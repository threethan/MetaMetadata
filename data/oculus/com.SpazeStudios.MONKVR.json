pT96DS2_pJh-vDrPRdPCu4A4u1At_lHEchI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvGB5aARIWHnkhbGsQTPPGNFptrmvahLTnVPpmuu14y9A&oe=699AED6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s3url03vwfkQ7kNvwFNbDH5&_nc_oc=Adkuv9ZUMZ-GgbKFE3umqxHH8taFnRqGjsZKkCPb7MmFZ6WYY0wH6FRK0WesNEVGHFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2MDcYJz9SSUll8DkMSJgYfaBVNfUEK9SiCZBuq2OerQ&oe=699AFEC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkTexadq8c8Q7kNvwHklDyf&_nc_oc=AdnAMsVeAnCYQNp3oD2nivelk3eqBmu33WQVqSHZwfzzMX8kHHrNndvNLcmNuM5bQ8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftF2HBuJSUvjTum0UlpxFG8Krshz_0TkVeemboHiKLRdw&oe=699AE97F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Nuib8NwzZgQ7kNvwHbx0Ug&_nc_oc=AdkG_Dc2Shkqg_yKFPIopt5d7L6_Rg3oPWoyOnlgF3RoU-Z8CLvRbtVSs0AxOe4JSrs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsICW6hLhDodiqwc_HXNblcOfweVbP5zInHDEtyP97t0w&oe=699AFA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEV7o55AyqgQ7kNvwFDs8bj&_nc_oc=AdlyPXsFnPSM64-y-BtOt6bybeo-tiEKK4eUZDV6bCwASH7LenKzq29WbpYN6Fmaqss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvcfPUZkRJAhIdEK_D_ztpSzxkrhOP4z6xWYGKMsvUflQ&oe=699AF818"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED",
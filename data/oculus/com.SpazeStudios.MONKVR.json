302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgMWY2fSwpAQ7kNvwGloiD2&_nc_oc=AdoQlBCsQvUSt3V0n_zOVaXWqdZxtovjvgCdJV1MGkvjSvHXXBqU5YztHggj1LmOo_Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypyyE1qKNVxxtLWsWWks6w3J9fJF5qxOuwN9cUcR_VaQ&oe=69CD066D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjHaM1C4zwMQ7kNvwHpDrlY&_nc_oc=AdrgnssOTPNooLY1fwXaQZn2LOq1ZhQA7BTz1D6kSqNEh2R-vtXBNGsbRVh6zT8pOcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyQb9mJ8F1OWVvyA_R4LZeK1wvZ0Ezwt1FGykmly5P3A&oe=69CD17C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxsb_8kTp5oQ7kNvwHuD_qQ&_nc_oc=AdpLT8hdogV8PzftdTBaJ9X6w7KCd64fINpGFGCynLYglYABZboimzHt15pECL4by4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4XX6IJ-ctN3DgY3Jh9g9nb1qNQ4YVs0ENITe7krgfZw&oe=69CD027F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQUATiAqvpMQ7kNvwEU23Ia&_nc_oc=AdreGvDb9li6w-RokNObn2lLvbBhOp-GAyVuBArYiizWzI9Oz3ZZE9mUpV_BjL9pQgc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyoePP-G0YJJfZGQ0oXPDuNtTeLgcuPJWD1fDwzmBR-w&oe=69CD1352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KG9_aFXSjUQ7kNvwFJFl0j&_nc_oc=AdpbuaR1_yI5teulMvmrBHbjTx0gNqguAQjwNjjLaVDZJ42uwempzYW8BwDI4yl8csA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBlABI0yOqp_rnbpKXoEFxAA7WquJW1Z2Hq-IGzX541w&oe=69CD1118"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
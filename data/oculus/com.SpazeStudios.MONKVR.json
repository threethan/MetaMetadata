302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIvkoSxxATQQ7kNvwFjrbTL&_nc_oc=AdpQWqb2M8O901lQXlT8aAA5KLhKA5qTePRebAw07BOMfIYF2QM31uTXs-1ux9oSSqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18yjH93D2n01U4pqqQTgoESNNoA0tkAxpAs8Y-8Ine0g&oe=69EB58ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DQfJhk9mNUQ7kNvwGZRAgT&_nc_oc=AdpUOmHqlqpvGcrLKgTfk7_K3-Y21mCT1xrn12cTV9vQmyuqUuhmB09foUhjTQmzMfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LtdaAFulGsS_Xxo-eNKcBUuUSbLs-7MDQdI3yPzV59Q&oe=69EB6A44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhtb9pXn0Q8Q7kNvwGm2UDZ&_nc_oc=AdrHyg35SK28aApur7wy3_WUu3X7W5SjKJCBtQWLD2z2cVILVz9yuW1it6p3e3BZoQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I7fmVmhAD0tTJk24nSlZTUAJc7obVuklmessA5wtppA&oe=69EB54FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWYQBF957ywQ7kNvwF2PucR&_nc_oc=AdplcfQY70nWylVxE8iqwYZf0CW8Ak_J8JU0VAewscuI_1ZAFB_JWk-CdZwCCmyS0ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jThg57X8exVudNpMTX75twFJknaJPz1DxATe1s_zZsw&oe=69EB65D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MVNwolDVhkQ7kNvwGlyuE_&_nc_oc=Adq91QZmNVK-Xscsy_zK_3PkxHiyDGlOr9TLpr_iDgP0UTy-O1kWiHYxmou9yaiwqjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v-uk_HWFbZfmhv_eMySk-irAayO0LURKP19JgBiSEUA&oe=69EB6398"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
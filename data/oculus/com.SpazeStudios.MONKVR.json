302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agVOFhOQ00oQ7kNvwFBxpc_&_nc_oc=Adp97nvQt3c_-7GJsHODA2twQwsZ6Uwgv1qkULqXKeTt8uyEfAkK-_OanDywVewO2JE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1upd79WTkAgd05lOAU8Etp3dWID2cFAk_mO2wQFgPNqg&oe=69D24C6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1nLg5YhdiQQ7kNvwF4EHK3&_nc_oc=AdpUNH1Emb26GNKsn5TRbV7E0-V2_Iq7aVkWmYi-g-lWH9AJaHaljtLvqcZd-HnZInQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C9nSlJehgE4fn-5vOwsi4MeKlzKmm83LAoVpB-c8o6Q&oe=69D25DC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFo07hHNpyoQ7kNvwGZTka0&_nc_oc=AdpPEwE41CKUL_ZdS4bEkg66JvYQjLtk9SaWerVxjGo1tmRTHqaKgJSWBI-nDmVklBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xfdJYExnKORrtrhRU8nYwOuqoAe24OEKw76nbnbbsEg&oe=69D2487F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSClL2tH96EQ7kNvwEsd5-S&_nc_oc=AdqHTt0D3R0iPuPUtequzqR1fmrAZ10jR9jIlfBzeYsOwI_IE0jYkiz_vNMCgPdA4j4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uhUvyfHHkGwNzfG1pHkSOlUdkSvI4L_pnGbeXjn_gSQ&oe=69D25952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6mospV0wJwQ7kNvwFC_V_8&_nc_oc=Adpj97i4xh9pNZueuNT03Klwo_SDS_Q2m0g6bUXnayC494iZnTRLR9WESsCCLjSK9vE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IOvKxG6QaWQrdYMYUZhKdicWEF9MVud4vvU3grviJ_Q&oe=69D25718"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
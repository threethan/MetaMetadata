302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG109C0PuCkQ7kNvwG0ZoeR&_nc_oc=AdqfgpgFklvA67uVf32rEsrUmiRGmjW-n5DSFn9ip2S1a-W9im-gpDNnIAIic24OIfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LNlmbTOJEnxvvBpYvos0yggs_68WxrxFy3xbOiYjPLw&oe=6A1DAA2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0OXQvfpzPAQ7kNvwFeF_Gz&_nc_oc=Adp8NDBCYLKZxF2gUXcKuw5MkB6zK3aGf4HR-xygX1hFBjce8RaBMikyciadGTa4gOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tsPZNdTytaAHvaFRayfg8nsnOW7twxiJv9a-USjL56A&oe=6A1D8344"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6TXXfIrzwQ7kNvwGj-m-B&_nc_oc=AdqTQSBBVquPoo9EHqygAbF0n8AcbW9gIxvrYPwgLpoOgD3IztpDubC20wg5WJZm_MY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wp-z-9xfX6LLVTyjOG-MDFGhrbdKvDFsCd0gosBeaZA&oe=6A1DA63F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jxNoQU2c4kQ7kNvwE8sAHn&_nc_oc=AdoSuUgtiEdz7SErVvopVhGpnvmlTt-78As_9a9Uj0Ggn1iG80fZvAZNYEGm_kzsJkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TmLvrc_EvKb1IVgyM5lR3BleXk_TQ1WCT4mDC08FzWg&oe=6A1D7ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ambVuahTmXEQ7kNvwEc11Tx&_nc_oc=AdodGhkPg85_mCLim9fda92wJiKkz9TYu1s1mxnmb6QWztEJfWX-YMkbNYvmKXhn7os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PHgonPG10MyWE9Di5sjJYmt55fdUjKndxW-OmUFAkKg&oe=6A1D7C98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
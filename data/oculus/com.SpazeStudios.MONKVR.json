302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHfP5vtbbLUQ7kNvwHG9FCi&_nc_oc=Adrffkvp00u_GBiDSr0K75yhI1jYvWXbyqkjmHpDz_bemaylZdzCVvix3wuD1nEqZ-Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyO60XgQomqLSNkS5fFc33_268o_CYB6bOmWmimsd8WA&oe=6AF9D4AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHUowP95N80Q7kNvwGAZikE&_nc_oc=AdokRG0L5CyAgK2mfrn4mb6H7UNTq6qYizIDUogmr7uLyCjLq6m72s8yyInn-Zg_YYM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ26RX3TiUC4TV7OJagusEwgk4LmnkPIeO_9rMp1HdJUQ&oe=6AF9E604"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fTvaApY1vYQ7kNvwH-3TWC&_nc_oc=AdrQQJsf65MsnNYuB1jFk8iahOPiSkKJYoSnt_yj8NB6D9ujwZmDH6LFTx6MwU9o0wk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBBYbsAdrorriojn3jzmV_PwVpLbtgabryCs7KrsZsww&oe=6AF9D0BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2oJpdmOfrwQ7kNvwEfsEWc&_nc_oc=AdpDtwtIyLDHSwS__IoLuDIKf85_Pn8BeXsrom_qM8gCVy-NNrydOD2bBpKs8J6bie0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5l8n21Q1ePeNF-0wQiRzmj6ysfv3HTtw7n1wfUQlXdw&oe=6AF9E192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WDNc_KB3UQ7kNvwE0w58J&_nc_oc=Ado66-EYoTt9f1-FrndSPCTeg2P17ZBNP-FGBGuW3MNdB-iPGHyZGmJSCp5oxYzO_i4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnWdKO0KdeFJyjPwBqiouKVNRUIjKX5SyJzm78YntsKA&oe=6AF9DF58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
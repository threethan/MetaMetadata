302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awN5ziJ1zccQ7kNvwG_fK-y&_nc_oc=Adp8VcBeY0BojI5cXvyPHBWugCbdFTz_Wfy9HO-TamB21kMLNgJRlYi3G8kmTIq43dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MLbSqo-CMygtR5c_dmDqlTqVr2O79dCXAK3A47NCNCQ&oe=69D8E3ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpFaklCeLH4Q7kNvwFT7dBl&_nc_oc=AdpP42G_rKQi5If4CZyvR7UKrkwLYFR9qdnQAwkvA8s1e94n_A2gQ0pCLkX8YQ-Yal4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FsJIs03SyhL9v0hHxJlA2pyf6Qx3rd_hzF9TkisK0PQ&oe=69D8F544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TRpfVAqqFYQ7kNvwEZ-TvZ&_nc_oc=Adr45VJGayzAH0sq3ADLMGWY9XmMXrL1EHS5RMnl56EXWmUOGD1RPpu7qynW4aYxjt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vI83v8YVkMSHNJ5B6SVCTUotSU1xjKYW5JkfcvgLyhA&oe=69D8DFFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOOHFGXiri8Q7kNvwFkG86N&_nc_oc=Adqs8W0p_XvHhRM5QQvRDOGeFNVLHtDS7htApbw1it5Eb0HV8PLaeoX1I6liVcqcnag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L-FHHgY4wRMpLhcME5VnywkYL9IId5ypqJzXbKXvQYw&oe=69D8F0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq3t__bFnIQQ7kNvwFzc8ab&_nc_oc=AdpBU95UTFb6QlJ-uoJbJVFWM_zf72htX_SQRGzmLZkczrsE3C4Jcvol-wMdy7JRxyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E_1AiPD-PcgGPGcDX7QEqgUkAZ9toJD3C60RhoP1Ssw&oe=69D8EE98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
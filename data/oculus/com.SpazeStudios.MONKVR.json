302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OcVMiCWeXMQ7kNvwG1J2-J&_nc_oc=Adq1p8WjjStmZ8wx7pWC7CcrmMcp4jCtvecszHKVaM2ly56bf8oiRyprjgf9RhQz41A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbegy2A-olNbvN5rqqOmbGKPyOQb82R4E3IS8p0WW9Nw&oe=6A65F46D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SugiJQ6FBokQ7kNvwGD57C8&_nc_oc=AdoWqEKf6b8wE8aQcncVr26BcWjcicqI8o9zFbfod9QhJDMHVeddbSzfpkI8J8ggto4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_IFhqFaOYODQ-Gz5sVre5c3TBHCZL_53TfC9i3-5sPg&oe=6A6605C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qijUQ4EAPUQ7kNvwGYfoEJ&_nc_oc=Adr65WO9lPwSdVZ3Il2CjYlgKjZbnC_g77vBvHXutaNg1IZk8x8gDxTcCQR88DJ0WRk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5eY1QoAxmAj8V09HzB9qj1fPxIJS5veSw3UOMcUlNIA&oe=6A65F07F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyOgqjsV_MYQ7kNvwHH1EDd&_nc_oc=Ado2ImvEKtR8GWfu4K42p3QhTqbnstcOP1KXZOz_iR2BAcmzJUJujfChN21vtogNQn0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQVq2u0DpuATQtXl2lr-UNdOpBCuZX1WuOo6m0sykYcA&oe=6A660152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFd2v4QjBpwQ7kNvwHAHhAR&_nc_oc=AdrsdcQNewMh5npa49Hi1NB7SS5o1O-3wy-H6Ac6KgGWs5MKys97W1h3YyfKfn20CdQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6p0tlngWBwywl7uv0nKJ9JDAQGvPb-z7NhiaUYfl4Iw&oe=6A65FF18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
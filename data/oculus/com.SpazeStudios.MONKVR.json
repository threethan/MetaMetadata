m/v/t64.5771-25/499302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWNxZvrjkdwQ7kNvwHy0cvx&_nc_oc=AdqPgUhzb7V2AjzBcsMOtkeSpGwRJsAUNva6fLRsgezEyVVLFt_4lTMTrxzp6cF2MyE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0y1gcgIIm3ViuUA3990rbS9dqHZPGUvya-okAoK9tew&oe=6A85986D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38_RxRyV20MQ7kNvwECGHdU&_nc_oc=Adp6h5j-THA74dpmpPBBTqK6axiwt7IHoKEdCdVK1KkzAh5fMnJLYo4kgXYAcVR-edY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUUt5Y7i6xNSaobqfCvElTy93kgvIQ_UVxlcIo1U4eOQ&oe=6A85A9C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqghVPOUGe0Q7kNvwHQyBya&_nc_oc=AdpXGS1md5KKEUEsikCEXFtwZi2T-wTUuQS-7J4Y7t5LfDXoh-8VyEHAcUX6uzGAnAM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUghrGZzdwlE6nvngqrF4tGBze5ra2-Hjo7TOWBQzORA&oe=6A85947F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38X1MJP90QwQ7kNvwGFFFjn&_nc_oc=AdoySvn1HyOmCkaEXCcQrfGTQLVyzw6eCUVcnAgxKNs_UVW_CvtSDFhbR6uBhImFAvs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERbndUrrd6--sY0LZ3UaF9ZkJsmnizhNTh4mtHbHqMHw&oe=6A85A552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofhi2Cvi2IIQ7kNvwE43ygN&_nc_oc=Adph90Of4Y-UmeZcwGZepiKHc-pptNDXlHTeTto2ywoRBMq2GxlhG_IU0uZl3_Cn-gw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDRYZQK6aQKYdrRj2MEoPIJz63gDEjBnhNITGoK2HL8Q&oe=6A85A318"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
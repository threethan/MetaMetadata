302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzO_OUyWNSYQ7kNvwF0TfP9&_nc_oc=AdrLMr4kE7_KxNF1yrRmMIpstlZLVUlS2K_be_OXGwx6xdprmCozzDWpLQfd2QwhBkQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvhAXh0J3y_npJCeWiY9ktuSArqXPofUpNHue4RiaBIw&oe=6AE36B2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYICM7lj8e0Q7kNvwGqUYhF&_nc_oc=AdosH0KyeB0eoDJeaCv876QQSjXHEuIqSaBZWsmOD7WGdeU7Y-P-39wEcX7h62OMAQI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi8ntaN_EbUBaQa5hiEWUVNlOYnIocHrBk8kgvfxOOJQ&oe=6AE34444"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIonwNv2zx8Q7kNvwFU5x5_&_nc_oc=AdoyKNgXBU0ur93j-j3KxXz6GiWeN3cG-0ojj3Wn6E2APl23kYwRwFKsFqBboQLs9Is&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ43U3n8K76c69C45z4RLBru943cRknKoPLPJ4ZVHzyg&oe=6AE3673F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9TU1Ux-hTsQ7kNvwGaHqG0&_nc_oc=Ado9gnTX8sSFHZwA0hIdJUkQQVZH5HKsTphgrfviPTfops3lZ5_2cUBifxuCc0Uw0RY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4AyQkQwN6d71EjaLLdRBzJwAMpF67VeCH0f4KjKP3Mw&oe=6AE33FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8-iVWYCr_EQ7kNvwGlpUgd&_nc_oc=Adrg1BQW7fNJL6oTMK-NnpYINIUJC4e1Fp2PDHvCqTmBQxDAuIFnjkA2G4QWYwIGRbc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr2Yj6GxOfwJj--qeKqF9kg-IiBE1Fl-nGyGb_7uydAg&oe=6AE33D98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
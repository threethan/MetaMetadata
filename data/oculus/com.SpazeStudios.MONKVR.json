302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7VxJehMjTAQ7kNvwF704I8&_nc_oc=Ado-zS-t7N2_m9YePYvqDRzrX9HiBQakPqjG24qyvymVdUf8xBW-37HUc4z0iNAy61M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbFdZLlKk1dnA-wCbQqFbNdXoZBL4VqFrkOEY6wePx4g&oe=6A6DDD6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZKX0deugSAQ7kNvwF0NPE5&_nc_oc=AdqvZajFO8Z-AhjdrqswFjKmVPWBVOjxs39mbnI6KfEEPmARb5tU6LHAmK2u6QC_JRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcJqgZLj7JLaRLu2p0yiSHZW_6gLJFxZygtOOU-X5wSg&oe=6A6DEEC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac1QHDCD8r8Q7kNvwF1EfK_&_nc_oc=AdpN5MaLXJrHe3eZIsSKnKoqM7oG9yKHqOwuG73mWYXu7c26pTU8XdIrTkGj_ORXLtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9sURSbrbBXP5DBUPX6svUNmLFfz8SzDoviN_MyJo24g&oe=6A6DD97F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWJ6ueE7IK8Q7kNvwH3PL50&_nc_oc=AdpRali9NuWmTqO-TAxBgmm7pdbu94i7E5mpUOeprJFmpXl-I3YGNfU1t0PnEGQ8g30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf5QpEtmR_AzFrhsP_jO4m6UxfWSfdOSQ0zFMqpCbHdg&oe=6A6DEA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otBsh6pTOYQQ7kNvwEs3Hmx&_nc_oc=AdrKIShtz27osxT4HQx7Kl2W3RHD-Lnn3fnhhXZFanCkKUNHGEkiqoxwnfpbK3rTEPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcODUNTcQPnH--7O-sD6t9LPg_OIkuxfstik1uhswf9A&oe=6A6DE818"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MLXOQ9cEt8Q7kNvwF4JR_4&_nc_oc=Adraxx2Q9f0NQu-ZT7pAkABPWaG_oXfySLpK-xPz4aN0s8V6CrA5nYP0Wfq6IpSOqTo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7bWadsmXN7n3lLS_9thZAXt31Wi8-OKOZ3tVvnpINTA&oe=69C51D6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fSJDTrnWl4Q7kNvwF1EAL0&_nc_oc=AdqcnVbtbMHBcO7mky3pVRdwiCgzTmCv6dJfUhVssq3wFIKc_twgN_PObBQERSOLQcY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCP8H07ZR2aztDsFi33oyISKbRESbNN0vpcWLn1b_SjQ&oe=69C52EC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWStE4KKht4Q7kNvwGQRptw&_nc_oc=AdpdqN1iWpljfs2htR3bvyakHoYOjlycuX4bWbhNEJDyMJkX9-96iVh50b0iW7ivKIU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw9z1OWYS-TTusPTC2ZTzcNH9cBgMY5q1PJ9ABY7KH8Kw&oe=69C5197F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCzMnl1RPuAQ7kNvwHRDWLJ&_nc_oc=AdpLAZ5P4mmpSSdBhh8OzV7TqrXFZPLR8gOwO2_ShTSa7pfve_TaHCZPeZFzkkwgfhQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwqh7NQWhuyPpOfBCXXOLVP7_-mk6NrgwCZ8wkDsJuMyQ&oe=69C52A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9A2Pw21a8kQ7kNvwGbICHS&_nc_oc=AdpnswyNomrjJdoNpXIJUdmMcPBpkXn8FVwy4TWSPbYj4KyaQ4-3F4KKMbeDnN-ka1o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJTBBPsHzebgDNezOIimQJWpalxPl5XHT1ywG47C1axw&oe=69C52818"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
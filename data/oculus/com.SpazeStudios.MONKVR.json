302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NX3hgymYxbMQ7kNvwFXZc7L&_nc_oc=AdpZ2HlDZ4xMsoh5Qu9QvFw8rDzPfS7bqlPIHDWOieglpvGyOCzRjpycNTFRW8gj_Ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fo21Z4n4ka3ddC3jO1Hk6uj9-D-jgJAXwJf67sueO4A&oe=6A45372D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCTt_W8dYjEQ7kNvwEGC_OE&_nc_oc=Adqyq7xhAXJt6t1FZz2EU4m4-lbNp0u-yYfNfWxIiuFKJPsfaO3xcsYIEsxy-hHTFlQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88oT5MMQSGpjn_wpskS1sS-Sd2ia0dPJSRWdbdqz39Tg&oe=6A451044"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhdG1YZQY-8Q7kNvwE4oJ0A&_nc_oc=AdqQ0Q2CAJZA3IKrhdOFKB2kfQ9jMrgckG19atVsmylrhZt9yoQ1RqHcUlJZUN6hgKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rINA4xtk_pQnryGZ-XcfgxtXoGWRtBxEJS2dI1nV4OQ&oe=6A45333F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrGTvSvMySMQ7kNvwGckyck&_nc_oc=AdpNV-S3FJGBRsnWrip4D_0r1JSCx4ZdZD0CWtlgZ8mztmlbkGa3VFxgSaZTsViRoyk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_28VlXwqPapTrflmXq0Vhz_nO4VgUFoXlXInXFuD313g&oe=6A450BD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt_l7IfDLR8Q7kNvwGjq40v&_nc_oc=AdrILlgmRNWmClVAYLwUlMWDBypuApSkvFBRx64eccfhVgyvgoxaYhsD_SCeL2YV5Qs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af911tQx8YQ8gK16FOT8n-mqXGnno4q_SnvwtUDUbAqIjQ&oe=6A450998"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
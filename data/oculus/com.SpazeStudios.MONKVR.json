302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8cFs-ju_dMQ7kNvwH7Q-Ed&_nc_oc=AdrT_QVreTnG15-o8fbu3W51jBvgeaxmiohPwJqQH69n4PtOJYoptDNOqEe0S-LtVzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnZk1sUkkztbJVO4YDOJUg665LqMISSwZN2a8U-1UTBg&oe=6A7474ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsTbn2jPE1sQ7kNvwFteF9z&_nc_oc=AdpTEv02CM_fAHJGtvIZJDAiFHg86eg9Lg8sguO0foJXn0lJRTSlfIlwneSW5wYrXC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ5xMS4feXsYvd5vWM9K5f2zkAoKJq_lZR5T1znNJW-w&oe=6A748644"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wp7yoxxFzTIQ7kNvwGpZfrM&_nc_oc=Ado-QpS28rEjMZSmrBRs2PebRdWRSpQ0xvfhwWYnCtmTckrZS3a1t-tFb17HZv29VaA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxiEAmWjFJPyuj9AfH-4xyIUtm2LhmH84gTAMyw05fyw&oe=6A74A93F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WEO5yC-nOYQ7kNvwEHlsuk&_nc_oc=AdqKciXAmhLBAFnFhxnuhT_XJ3d7GtLlWSxBc-xv-pD2eSzs46Evo_E4hn_BkiK5unw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG91_sf1PSGt_8tm84zzp_J4SVDf3nhWMCoWVt45kw4mA&oe=6A7481D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXA1UYZSHj4Q7kNvwHyU_di&_nc_oc=Adr9UGz8APtRtAzbWw3WSAomSSKgmxEQYIJuLkYgfXJ7-dnv4hUKpWFlVD-5_vBjRfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpFBArGglOk4f8DxEmNrII5orq1VvTtaFkzvGwzrfvJw&oe=6A747F98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
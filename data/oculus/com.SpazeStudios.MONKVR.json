302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PdydWlrQhBcQ7kNvwGbaNhC&_nc_oc=AdrVXbJsOsrE2uT_0G-m6aAfGCYD0U6QfhfLTWfl6s0UpH_4UblupVBawGxcMBDxvag&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgmq9hhy2QUUoWaOS6PXfloIUY9WJu3ER1SpURnt1fNA&oe=6A81A3ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKKuO83TbxgQ7kNvwF5XmBn&_nc_oc=AdrxkB8IxyQjBXxAQq1RA6IDRbKiHFCyAmFfSGffXkg4p0sOeMXfMmIk7EmqpyxB4aA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBMo_Vh8wHPJ2d0fV9pmYLKKi3VPJ9mcJYJ1jg1KZpBw&oe=6A81B544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZQmZ1wmCa8Q7kNvwEkD7lj&_nc_oc=AdqiLrPrO_3HIXQhAYAKdob5cR833yh_Gy7WiNFJEfeMzAtD_BKoAaxh5nQ89ozroFI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD7bnrQGD8g6Sox82g9WhW7xvDcNBmxx7i14qXUHGO4A&oe=6A819FFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxYkoYQwyiYQ7kNvwF9Qj2_&_nc_oc=AdoX2NKg_-WnXFg3erluFkRyzpN-ebnNezdYdlRbFSTfJUmR4sghSIh0DfcPVHwlC1w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Jo6UvEzEw3q-zp5nXHGOApywyqqOBUAg7itEZVtQOQ&oe=6A81B0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V06sv0yFu_UQ7kNvwFG-3_T&_nc_oc=AdrlpHRrySizYrw06_NBS2019kBkUBwRmCUI3f7-EUlldFCPuTpVBlXduJcpTQYNaAo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1WrW4YxP5tOaL_15zRvFWk_obZcPaTGnihKS9OkSnnQ&oe=6A81AE98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvQTqsWykNYQ7kNvwFiJSH9&_nc_oc=AdocHv1jnC2JJ3nzST5rJK8DPdroilZoOmKUf-imthDCmMjg4XK1tS7ldI8LXCC_qWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Is1JuNqYhn5ak2x56nT7wWSupkcch37GCDXZV-P719Q&oe=69DCD86D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxMU5HNNy8cQ7kNvwG12Iy1&_nc_oc=AdrZ_YC1N5p-hJfMgwcfxQkk-S51vQnNt5rnq_Mg4-8QO4KJ9Tukk4HwtqA1cGSxwRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rC5Ws6ge0YtMrfBtrq4lRilIc2gcO0mnDyE_bqXkggQ&oe=69DCE9C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NYZPXA9okcQ7kNvwHodjXn&_nc_oc=AdrpaFEyIv2V2xxEvYk5BxGFrTeFjZfSg9Py_l1hB7KfzE9GFW5gMYfdSLxZpRLC2G0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bbdaFoCDQS1CE4L-ZDIwHoHxKkt97T3gvJ2jU0L0CkQ&oe=69DCD47F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EtOds92MHUQ7kNvwHCsDtK&_nc_oc=AdrKagnzzXHKPDW_JsJQj7FpGoLUalrQtiMV3q7xMbCZvA4Baoky_KfLx4hdYReb-VU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FcWAVGMqTLKpwJUTKZfE6GpXs-7_M9xpL3dh1QJIWfg&oe=69DCE552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3CCgjTNreUQ7kNvwGSAa84&_nc_oc=Adr94DeH41wW7OQ-p-JsdefiMb_vKhAgf6rosvDN5gAaqzaXyG28Br17O7JbYIqBVFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D8hzxvRK03ZRPLOk8o6FU-1ogdUPZOGkES21EbqyLQg&oe=69DCE318"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIvkoSxxATQQ7kNvwHRsZ3l&_nc_oc=AdoXegAloGDATCntIA2FggKW2A70DEX8cxYVv7c2CLFAERWH1U3UigjudmIFkAgWb3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_42poIBxRUmO2TjluH_kP081Mzm-GUFJ0MTDpSmj-2g&oe=69ECAA6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTzdLR55ODIQ7kNvwFEQTxO&_nc_oc=AdqSZBPLWPYG8NiNTeAlwYJACdd8pVCdXTzkJqlDUzVGkaUDIsRmI4bjW9Xd3jIm1JU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cdCN1xErVI14pwlu5EKSoxs8vNnVT8oesnKFXpGOfpw&oe=69ECBBC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZCOXgr5wCoQ7kNvwGoVJrz&_nc_oc=AdoyKE9gY3jksEFhOfupub2SdT3FQI3WcXOccPUnPahN2cffJzkLTJ7PmvL4xJHroDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38cqCef2CCWcnI-cxtqHMNOyYsi3X0ge_GGJyS_QA-PQ&oe=69ECA67F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWYQBF957ywQ7kNvwGcixZq&_nc_oc=Adq8CRmVdpzHiYzltf9y8lfICvgPNQXKN2rZIQ9p7GoQ_bTMQZiE-_hDVmyKTKodjRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mi_wDGaB_KhtfoxX0cm7DXqEhHPYfSXJyBRezOzpWTA&oe=69ECB752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MVNwolDVhkQ7kNvwE19RsT&_nc_oc=AdrVq0RDBCiL197pO32U0f6oe-XtZwt-Qm2fqg-c9FlijnJ5ARS4D7hi4AAOEFo8JHg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04VyzyWvvMKHixyqOJHF8TIgJP8EI_7Vpjso2d4gE0Sw&oe=69ECB518"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
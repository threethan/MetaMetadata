302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fCaeNqOS-4Q7kNvwEECdAm&_nc_oc=AdpO9yI994fT7uu47PYVRWyxKA0wR8yR3d3UMNv4KpZJ9ULhI-ZyoU5E1RRzxAUZklI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjGkbYHgcd2ld18owjgAGY3uAu9fN_6ppXH73REdeetQ&oe=6A61FFED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rLkkaA28P8Q7kNvwFa2pRs&_nc_oc=AdpddN3por6vLSYKYcmlOMBHzTtLsaalwaYG6M8qiWj846rETaqzezAflYypNVJ4Uwk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX9cSXNxVWsPFU-jn0_bAUtGJAJQQnvbHvGD4l1gzYSg&oe=6A621144"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03Erye2rVloQ7kNvwHngfZG&_nc_oc=Adqc4k7wkmzxI0nJdHbvVtzget9gXWbXngnJnPrdshUAm3SAxaNjRZVWlVc_kPH8NRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJYlwm7KneIQDI_MBCi-P8raeVZ-8nptEciTiEGRkmFA&oe=6A62343F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oir6mlKEsU0Q7kNvwEoBtg9&_nc_oc=AdoZDrtZP9_xL6vYMirFMwPO-s3gD1bKnZ4Bi8WqCrHnsXa2qYnfmCYWe3iyLuHvLXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc4QSmQxYBHmhhBh0tHCAyyodYp-oOOwME2KND9U_C-A&oe=6A620CD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LHjuz4hWIgQ7kNvwGGqrwF&_nc_oc=AdpTTa18K_2Mg__tpanS9ROlQXylzhBLuzX7GDIdl2aEeVp7OsZp92Zhu7ggSQ8G_pk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFaP4lRDlFYPWeTopvcQ8JDYSGsX58asgw7LDjUfPqLA&oe=6A620A98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
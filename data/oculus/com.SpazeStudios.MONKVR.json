302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4NKFYXHSHkQ7kNvwEgWx9c&_nc_oc=AdozrI8U3asCH2RAjAXWa_ESMlUvQTR9RhVAYZrlUKsiWXTqKsSZPCsyA-lgsndOoOo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nOpLl6W1NW8VkdVXlzyfaGFVOm3l4WRtV_X2mHezCRw&oe=69E21E6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5sj_JwxzyYQ7kNvwEgGTcl&_nc_oc=AdrQR9N2uuVvyCQdygDYjL9v7SqO3Yly9WmmIkCZSC6CfjtpZrAj-Eiw7cnJ_PYAZYU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nboQVuPle29fgE-PJCdrFqb7kLm7uMOQMVsl_QVUqsg&oe=69E22FC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gaqKdfuKyooQ7kNvwH_jdbL&_nc_oc=AdrvoGknm5lo4Ib_mmAMfkA9DqnK6PIW5LYby1kXp3m3XhvAQaNTxJDUs704qOlBCFo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E7iZof1XURoXVseuX28hZd8RsrEIYRc7CAe86yV1NFA&oe=69E21A7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZWYarVmXc0Q7kNvwEL2e5_&_nc_oc=Adop3tPP6BhfkgfnybgX4XfT_9qTFjwIgtHsJlWBHQwniwFbCEPccwS-dAtbZ2djPiQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nF5QXh12zlx1WghPbquw_KOXx3_RA_S2ctbSbY7gM3Q&oe=69E22B52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXDKurk3bzQQ7kNvwFQNMiM&_nc_oc=Adp5xV9zdMfTslQmKakGsQ6Z0UGbTAycWO465_L0v2YJe08meUfHRLPL5FYj7seALBw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uNAICRPvbGD3CNpkv-c-1JNP8ArqII3om1cLx8P9rew&oe=69E22918"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
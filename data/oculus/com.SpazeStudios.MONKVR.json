302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMu-FG1tDUEQ7kNvwFIP7_r&_nc_oc=AdpGf-PRfHDVZPK0A4pEmNzYia2Q14TZF_DWrvAEhL0zNuxhwi7IczL0RJTZfYcE8lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnwT15U3fJYwqzCHq8o4OuVQbsP673IzXXp25hfz0i_Q&oe=6AE4BCAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYICM7lj8e0Q7kNvwFyJ6Yk&_nc_oc=AdptXTemhsHJXmO5e51AY5BVx1m1Y5Tljk3ep1HlkCWkwpZP_zm6jE8Me3EWZwNoCUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmkbJKQEXjyTVYm-1I51WNruAPkxyTpQbNZtV9K0Wvbw&oe=6AE495C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIonwNv2zx8Q7kNvwHKQ20n&_nc_oc=AdozOzYdxnqDWwbNQkpHMNLW_l3DBpxbYxxq5lomtUG4nXYFtHozxngaOJ5-iV59QNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcKLiKTuEBuv31ZrKTfsxLnZpqA5D8CdFdljP_plPSuA&oe=6AE4B8BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9TU1Ux-hTsQ7kNvwG6D7TE&_nc_oc=AdrN5Z9HP77bm2E4E7bmWHq-t7jgRlHMxcf3uNGVRSMewFLSHhJRLkIIGNwMAPzA3es&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPATe21rfQcB2n12ncpZrmdauPt2o-nvS06YKd9B7SWXg&oe=6AE49152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yhNrauk2FAQ7kNvwG_IdZw&_nc_oc=AdrCEs7ndEGMeodVtTtb0Y9VMZanI4hGuy6kzNhjx9dQRu7s1VOKsRCQXA_txf0Em1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRJP0oPGGAnU29DiU9oy9f6GxmdEwM13QpBj-E4rqrdg&oe=6AE48F18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmdl0kQusnoQ7kNvwHg-jDE&_nc_oc=Adqb71vADnrr24tBdI7_uV31ScKXKaejj5FhnM2Xn-LCH8x71nlPpscSoPNP2I841uU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQdc3Ka7kmX358E5fhBxxY0klqTcg1sUX3OHO8M5YHjg&oe=6AEA02AD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFp29L7EtCgQ7kNvwF2CFey&_nc_oc=AdqIrVi3YD3j_WQqTR9W3f1gJqViBFWat0MMfE8dK2zwTA5PNKVYGntBSfYTfu4l_gU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTl6elcut8YbwZamcta4zZVDo2_zke27t4GuzXogyBt7A&oe=6AEA1404"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EB9ETEGzs7MQ7kNvwHXNnsJ&_nc_oc=AdpsfVdhV45VqKq5Uj1AUuJW8IPWaOlsgydaJ-zeblFXPjN2nLULbhbLcduG2zvEbBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf-_FpJ0xTv6ksSYiOpc3SnBk01uJcjcxh5pNL-HKl-A&oe=6AE9FEBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZJ4akuCLUkQ7kNvwGcjEqu&_nc_oc=AdoNlt13eBysYqiC4Oa_oVK4gg_8HsovkGSHRzn7XhtsS6ljrSjTEmC3HL7eTA1JylI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_Ni8mvE2Zf0TYJrfd16HN3eVy6ZUkUImdE5TSL1Lt-w&oe=6AEA0F92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PT5DuHB5GAEQ7kNvwHoJvGV&_nc_oc=Adrfyyep3lU8tMkpPQ4ONLr1Wf9c839t0EHBA53_Fr3RvsRvKwdQO-B0TX-Lb9DfqhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZaxa_cnsuCkDLaQACwJKpBRwujpZsR3BH1nIFeKxiOA&oe=6AEA0D58"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
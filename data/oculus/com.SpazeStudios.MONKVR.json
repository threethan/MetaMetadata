302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TjHB8qW1w8Q7kNvwHuUmOt&_nc_oc=Adpmgcw5yr3O1X5yjJYS1uz5U-yuCjfVE1MCWhkSJDzfl9mCpWVaoOAzmDC_UF1_Clg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7pcOIktg2Hh6M2DiiCGRAXOwMyMNGxU47U7CfsUV-Rg&oe=6ABD2FAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC5iwiBBJQ4Q7kNvwGU7T-d&_nc_oc=AdqHKiOpqTAm8eIHJA0L2t5mFof_N7FrupwSr1AYv1ZK_UZM12XaVcG1qw63gx3D_VM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI66RijsuhhzojF05TLsEX3_C1Np3EJEz6jNY131Vhbng&oe=6ABD08C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7qgLbeznLIQ7kNvwGnfbq_&_nc_oc=Ado-UzAFKCPFe4GCMS2gevmqCBtskEvwA2D7vBBs6x32uvxuijVvOoRxV9MphGx_lhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCkfRvwa4uyayhvNUcKL110AgFbrwDHtvQZwe0yb0k-Q&oe=6ABD2BBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzvuk3sUwI8Q7kNvwGoyJRB&_nc_oc=AdpxJMjjUNx0GzS5scAgr77VfJmfJK2nVhUwN57KJEL-P0UcYMzT4aE-n900tH2D68w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRlrGyzOuI00oOvfakKwcTdFWuwSWmP8XanDhhEf7ecA&oe=6ABD0452"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJhuViG-erkQ7kNvwF8YWa_&_nc_oc=AdodSHH-fwTZ8azlEo9zobNPQ-tzBjKUiC6xWEhP6k7N7e04fX4dJN-YJ8ioVhQ8jVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBtgt6FNpaNb4fAdfP0E_EekqtY83bxNWIqMQmWUuHuA&oe=6ABD0218"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
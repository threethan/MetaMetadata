g?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ArPvFA0toQ7kNvwGT0Wq2&_nc_oc=AdmmP1CecRaPHGZxzW2sYUxOs3kPZgk2peYxSVx3UNFWzNY6VJI2esCSfbMxcepafyM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwROU9p21P98lx4LhQZ3VlYexTXGiWjAdLlgTy6fnXz1g&oe=69AEB3ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REsvadLqhi8Q7kNvwGTTnZr&_nc_oc=AdkitT6oM0Cwfgf4mOVlnoQg_ikjgxpHHr4pWMGZmRqPr6plC_x1vPWheqMuCedsBXk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCzWnvgtGEbfc_tljYDhq8-FHQ7ypA7nxNU60ZDHhd0g&oe=69AEC544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AunTQ4bNk1kQ7kNvwH73jAQ&_nc_oc=Adm4vptAN9gFogQpbO26cYP88q_DGal_eMrOFL8LxFR8MN9DJFsq9yU5OzXLOeu-5eA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv1Jh2x0rSn9A4eLrLeGZ5qJKmyQs_uDziSSsgWSLDLw&oe=69AEAFFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpWGdNYAFLUQ7kNvwFfwEzy&_nc_oc=AdlUCK1lS78-ilxBupgIL-fbSwGHQ2Y-_65ah5esoV2_9B0MeE9oqDNE9A2UiQKqkSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRSf8DWJiGSK6FTbG-JlEdz3zfCetUKIIfQisxU2z1GQ&oe=69AEC0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ATRZvQ_ms8Q7kNvwE1LD9a&_nc_oc=AdkkZ6KrQGnKUcJQMtOP8MJrros7-ECcoi-GlfEO2dT3M13ENON8wHKLaPGKSWE0vD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxsqECPEk8Cv6XDZAtsLvUBkBJUVzemClGl33FbYeLmQ&oe=69AEBE98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
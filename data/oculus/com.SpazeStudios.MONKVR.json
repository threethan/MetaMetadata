302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5En3l-D7yM0Q7kNvwE3TjYu&_nc_oc=Ado5nOJHghbrS691in3aUHAqxd_liLirYSzFoSIzPgkMFkQz7TXl5D4eUXIbD3qjmfg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF4S-FUYeldxnkHZw-V11dLo4OvJGlePEvOWrcpW0Apg&oe=6A4E396D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5boZcOb9ibcQ7kNvwGGgD5y&_nc_oc=Ado70aiVVu-cJyJEnxdD05z-ez9pWw2Z2t0UIIg9etSsvb-8sf3EUxDANShvzHsacws&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvhzQP3nv8qjX2QTApKmBs9aVVFRt_yvd2Cq5e-obB3Q&oe=6A4E4AC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSZ1qKUjJ7wQ7kNvwGoMktj&_nc_oc=AdoYXLXYas_LXQwdxPyr_xvNYQQBN5ZoJ5-_vP9bZKY1JxKfpu49K9mCIUNYemJLqrI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfM0osG7Rds7ohFrw0THkUKDuAJhjHTnGWka_K2wWDqw&oe=6A4E6DBF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvUpSyacsKoQ7kNvwFbj6US&_nc_oc=AdpJmHNJhAI0azCmLxd4zuVqdhTfGhhIOmRjhTVjLOJwGnMugy13kS2Lygp-4iDT0R4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOEb6myIcvWbws-2QRbHgyNdQIt1LH-cXqkfDbDV7W1w&oe=6A4E4652"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l1Ew91faoqcQ7kNvwEShx3A&_nc_oc=AdrDGMqY1NDw4EXZNSkuuH3yxUh45kMfIcgXhVcDgdYdCiL7j41JuNG_v82cph03RUA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPaRICXnEXABKsSCBGbiEzQaE9SBtnmWsYWvzKFDYWFw&oe=6A4E4418"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJPd0CKxGZ8Q7kNvwHlq4ul&_nc_oc=AdqIVdpmau4NNSq3FHHefXYR91h940sK958os1ensqtBYUcm5l44xufxtQ-7ZO2KrxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXzNFbM5zgVXd_XOKdFo8WMiFwWFMA5ZEyAJ9vUa7h8g&oe=69CA636D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wC8EZiJ-uloQ7kNvwF_SJpA&_nc_oc=Adq-3ddkb9zGm6Z2eaAAZHqhaSusnE0A4p-fCxFZI4EeBTO-cczQzUNnurXhCm6zjMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSJrqNhCF3_JXpMLeN8ypmtYp6_bFTTmkW0z_Fyo7gZg&oe=69CA74C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvPqyebKyp8Q7kNvwG_kxxY&_nc_oc=AdoE28ct-3JQ0jRjD-_olB2mrM7u7-Pa9DPyn__GivkMOHJHPYKY1yrJh5o4G_41zXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEjcw2v1hMh2UMSoqfDf7FflMbcVFwnhp7vqIL9HbUZA&oe=69CA5F7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQUATiAqvpMQ7kNvwH2lsvn&_nc_oc=AdrpawGYMfL77gZmH6Qj6ayQSUGKm2T8BH5aMsuJWSvda-ymp-sG8u-oLWnzjxOdzmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAUq7MNELJfAzSbxLTVdPEu9puvAvJ3-B8v5WS4fabhA&oe=69CA7052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXHXEKtKxM0Q7kNvwE9WNWg&_nc_oc=Ado0Mt1OcPgw5Fb9h-ls1j6wovPE-nDWUTMLhK8AA7y0kgDoeN__VqsDCVHV0I34MlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoQU9uDvm7h7lvF7wrR9oRXO3vSqxnBAQ0jLtHmMwB8g&oe=69CA6E18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
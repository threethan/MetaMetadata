302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=co9kROGLTG4Q7kNvwFWnfX1&_nc_oc=Adq_-OeFEFeRo5umFgPIa0G3ot9qQ8OrT1L9RHcomw5qkr2wS18AdC5ImsMuWVP-39o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuU6aQw-0w184qWGop1CXIRrk-o2IhhYDlhW2tPcw0AA&oe=6ABA8CAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JC5iwiBBJQ4Q7kNvwGC-OYc&_nc_oc=Adr3aVEgGt7Ps3ECJbR3y6w6gB2hccgSXx6DYvicUSlO5_nty4cNHP7PIgoBDZQWuE0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMcuGKklc7gIbGKVDBsDKVQ-1wSWqySJAOX_Olv-6Yqg&oe=6ABA65C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7qgLbeznLIQ7kNvwHRPLNs&_nc_oc=Adp0zhicbXko54f9vVd-KYzQ76MuHeQPelmJ-REszkAmiichSmNO4LRkwAe--OdI9R8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8tNcO0vYhcznMYY4Rqkxc29iSWCy9TJiVf4HqfcQD6Q&oe=6ABA88BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ob9sda6dmPAQ7kNvwHoS7AD&_nc_oc=AdovyyCvWGCUsa8oll9-u99zvxO77AkdLZFtWtmKvwjJrdV0CQ-OFBOS1Q76n2qr52U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5Ou2NbmAmwDkS1aweTE5_SirXNOB0ZPpXEgetX4ERTg&oe=6ABA6152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zcgpfGKwx4Q7kNvwFaMLOp&_nc_oc=AdpAEaaCQhSj_ju9Mw9trQIaECDt28WJK_czWbNp6gHeRObZw64VbzM71CIzT1ZP8rY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzfiUmBEPRaq2xLCaidL_N656jjomJf5n6OynbGRrsYA&oe=6ABA5F18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
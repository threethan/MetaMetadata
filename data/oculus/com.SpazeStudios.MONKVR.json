302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a39WBfab37cQ7kNvwFvuR5J&_nc_oc=AdocaJxvM8HsafIZEeeTS0JTFBnOl3P5RwT9aLSoxGHNNTfvyfWc3U7ku8imZiwAcro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzKQVSLoOnPs5yLfqv5DstLoaa_60w57BOXLJeekI_hw&oe=6AC7BBAD"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH9y2dDE4DUQ7kNvwHodNan&_nc_oc=AdpSmJyIFPzjk-YiPkADO27pWggVKHmBSA5HOUSbcq_voAc4J_EnIhvRYppCWZQbZKs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd9UfWDCHrIpDnDo81iLSkIxeiYOkxSNWZHm84Z2oGWw&oe=6AC7CD04"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFXcSjaBuuoQ7kNvwHCPyKg&_nc_oc=AdoL1iz88983WyP036ITd7YseUq9B_qPWURlSm3bOkmyAw-so2Fvk3ywUcE6VPCWoNM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUHv8cVg2piJnTYfMXeht3eQ-cg-b5tTmuMyj-dOzDJw&oe=6AC7B7BF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLH_1PdbLWAQ7kNvwG5ynNz&_nc_oc=AdpwdGQUkE4w8Yw_qlfhLLECYWFuccYlOqlhMN4Tt_nm-8f5EAuiDFmGYHKr3o7Y2tQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIJ-ZaP_qlsiq5OGncNmwYHcm19vedeWGUVZm1nUYpeQ&oe=6AC7C892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OdrvGH5rBQQ7kNvwF4EpIa&_nc_oc=AdpB8k9s7X3DyqpQcykHTda1ZW_6OZW5P6ZPHxNgwefmv6OMDlL_aiXQG-QuaxOSfFA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPITFudgmR9SHbTalNaI3eJIsRC72G6XlpPkIpxHM-XNw&oe=6AC7C658"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
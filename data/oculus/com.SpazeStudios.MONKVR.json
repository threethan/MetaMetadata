302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPIATmOvhwAQ7kNvwEmjrQt&_nc_oc=AdoPU5jCopTnc1-RWv17CroWyDJd-mu3mq6HoFRmYF_Vl7tODOYCtB1aCOvpm02wmYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnaSbaULoT3alIXbvVAIOb-NEme5gPrRCp0gvjdzuUnw&oe=6AAC0C2D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2IAzSmtRmQQ7kNvwFWzk7L&_nc_oc=Adq9q9bw7UQE4OiUc1zGz8AzlRO1uWjoNAgCc8--9A1FkfqUfdDrAthfDT8Niyd8d4o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdXlWqBmCtJ_dm-3CQCRwAgemHhKVid-Tu20j6YR_8Tw&oe=6AABE544"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B4r0xPVMcoQ7kNvwGGETJC&_nc_oc=AdquOM68QS0cTDEE3UNOrq0zBc4oFJvTLOuuFnpo0AMgJp7XCdcmFvsHCZuZx-dUwrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3cPJB9jWpUe9CJaREGj7NaRv-YlxpDobjd8nHTjGWLA&oe=6AAC083F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txp_G8zB6TgQ7kNvwGHztq9&_nc_oc=AdphAxFzl5xEo721HDdxe0SGPjiBMlE64auZFbd7n-zI9-zMNUBYY8_HwPbru0YAljk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAGZPwfTYYw_YvWucRD9CkIcgeRdidvIcSjSKik9ntMQ&oe=6AABE0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zooOn4tMe8wQ7kNvwF6NZdI&_nc_oc=Adoy6FjzwiGPJc4IQFVRTcz0XBfwYIMZQRz0plPwjd-7LOliqRjcPGAdElYeSEv0RpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLShWfFUG8C-zZ-WcGQb6-PjuPqZgHlxUikU237vp_Y7Q&oe=6AABDE98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
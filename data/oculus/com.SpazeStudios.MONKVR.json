m/v/t64.5771-25/499302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4bFcqV8Y_UQ7kNvwE8LXAM&_nc_oc=AdpjBCe6HnTjnIgt4Quzo9DNbwSrWj3gCxWg5cLw4Feu3W7iOcXBEV7EYLl63Kyg6Hw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFzQdD43mL-uT7WqhQ6htZYMwXuDYYLsYr2Z_4XH2lzA&oe=6A8D816D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocb_s3hov1oQ7kNvwG85qRQ&_nc_oc=AdqubhxD6gtWMx5gBtfUBFXgggMSWMrmhjxkYpJolh30v9QqQM0MWPFRg1d20wwucK0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4fl0T8N3VIjq8Bmbt9Tf-LWBUt62KQJ54JakSa5DtWg&oe=6A8D92C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbZddGXV00cQ7kNvwECYtAm&_nc_oc=AdrwuNNFI7izf0APyZLMldwpoLFwdZmqoAE_Ioj_dGFGn55cxMdKdrUr7vGuULYRIew&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH12SL-AlSbpK489GUbuRgG236H6JzSwOIao9ShR9h0tA&oe=6A8D7D7F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVngG6Tpjf4Q7kNvwEz8ZG2&_nc_oc=AdpVCYFL-uLDbJDF9UQCdvjjLcEnkmbUKi8W06oZZ1bIxutFXfHllGziTW5sWIqOsUU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEc4l4F9P_ooODfzw6MaKFNg7H8hpV0XCC4vFVcPdMvHA&oe=6A8D8E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cc9g9sM89mcQ7kNvwGSN0JF&_nc_oc=AdqHXWeatYbO6rbAoUVZ5HtYCKp_D94bqiPPg15iG6504tVf0S1toKiQpvPTc3SMa_Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEREMppuXX9o1zNRBsH8qGI8GSxeeJ0A03EM1OzkuPdZw&oe=6A8D8C18"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "cont
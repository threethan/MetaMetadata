302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWNxZvrjkdwQ7kNvwFI3Sq1&_nc_oc=AdpigcXpEHU5rCJZPbOn3JhvALmycWiQ8Y1Aqe5pVhbktPStYk5ikWVAARXGgSC2D_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaGPxf23GuHmsyIavVbVwtaAMvOUpeHcjfYPtWnKzp8w&oe=6A86E9ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSS3nyzMZrYQ7kNvwHHGrM8&_nc_oc=AdqT-Alxnf6GucDC9SLoo40mbB9reSDK3IEuVij5-UZ_LWyuPI8qYe8tEmMyU2NyZmA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxuY5GmwO5G-f32pyDQHcIsbUir__yQ6YaslDQypWhAg&oe=6A86FB44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeK8XvwZD18Q7kNvwFPZ-eT&_nc_oc=Adrtacg0RmSqaYMzCZE2_Y6KqVYHdMRWX8BslyumL6LXF67VBCQyr2mPoCOhYYnz5Qg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJZIkuyoX7qimmICt39P9XbdfnpJkzXNtBAURc-rc75A&oe=6A86E5FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38X1MJP90QwQ7kNvwFEV20i&_nc_oc=AdqJXL3to_zC_X1wKuAshSSxAgksHlNMoomfPzsRVHWDQ2SG2IBKm-qWLCbxwtgXVrA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXZfDk0ptbB7LRo6yKPAlRuW4NhKtnIh4N9du0Aj-5Hg&oe=6A86F6D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ofhi2Cvi2IIQ7kNvwETHZdm&_nc_oc=AdqW5PfqI2cq_OVuhMyqjq4WYD5UhHykXnnpEVHBhRuTfbc2VikV3bRr3qpUe3T3eak&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmzKRaeV3VXSXYJZScbfAQRj42Y2sYFckmkRH2mjm27Q&oe=6A86F498"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
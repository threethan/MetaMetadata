e030_t0amgOCnGQJoRNrDIOReUxmPLF9tFY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvlG52GW5iO-3SqsS1qGm71C7nFMifyhLr6myLbyf8Agw&oe=699EE1ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQTxuNlVBG4Q7kNvwFj3a2W&_nc_oc=Adnt8GU-MAae_xEzdtrIFzZsG4homt2SEtA7jMqGa6Izz4X3GUih_N-AB5svdfqpAUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZSeuSxKcVEab22N6MJH9oDGYhZRSG_mnB73yt9xTPdA&oe=699EF344"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH3sSzA4eGAQ7kNvwHPSf1o&_nc_oc=Adm_WWB3A-hgXGJDP9i9114fySNxDYOI7Lf4WXnUL74yrNMKnF_PjHwZEL1Llf4K1e4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvFBvmMmq2hQyZQX48Mrc6s_E8Qs3y9ngmukt3c8L6pVg&oe=699EDDFF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETVV0B4W-2gQ7kNvwEQSaSK&_nc_oc=AdnHaVre1NUiQD3t1wewBUiLBRlGW8JKTtyvJDGBHtOf-KJ90iqsojqOVu2i8cS7jEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQGa9FaStJVccY1tZMJ08N6YjZukeFdUc2P0w7WciMmw&oe=699EEED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nti09iptsMAQ7kNvwH9ifnY&_nc_oc=Adk1uwF9bs7WPkhMjSGcq-zZanWt-93V0lUKr7itbSTI5RKPOs2Dgbp7OgkqFeXBqCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZpvmV6WvSXLJj7an3gdtqFc2TrZKINH92MWPp7tAFrg&oe=699EEC98"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED",
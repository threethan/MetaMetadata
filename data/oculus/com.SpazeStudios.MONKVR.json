302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDmDU1gN6_kQ7kNvwH7joG4&_nc_oc=AdppTQv8HXKfm81ZdaQIaEVDfsH1dPy4bCl5ZGIMT5le7Nq9tW9fm3E-_K3WzPh5Bwg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Rd1Bp1F314eNYjPQxnmuog65XRsckrKME8d9rTxNoA&oe=6A5CB9ED"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIG24w5H31gQ7kNvwHcNvIx&_nc_oc=Adro4acE0hsQjJWc6ovCtS0gK6x4EU5ELSGpBb7uOrX0bceuOPZtN-TKE9McAtjuF70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsOaITSwnd8gyyc2LxiusVc3cHr3l3lHCexxYbDqIvbA&oe=6A5CCB44"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-qLgdCYcCAQ7kNvwEa9oF-&_nc_oc=AdojB7VS7fQE4j-qOl91u9mS0iA9UrM5yA4pBnzOd0UNJolUC5pu1_5sCrNhArciwOQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUuCcoYQxNFbTVp0t6UxU4WRMjWNl-wtctgVr4c_MUxA&oe=6A5CB5FF"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdZfUyinECoQ7kNvwEw7s9j&_nc_oc=Adpo97MgwnA4XJeLhAPkSHYvxhguG1fa0RLSdeYLxj3k56vUCuPyMHrhGHc1Pn0pRnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPYQcDahXulU7YILnVjYwqkJYWtz26yEErubL307a15g&oe=6A5CC6D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTHpT20nsLYQ7kNvwEAPaV3&_nc_oc=Adrdhf-gJX94DgTYKHo8f_wGi1_aynOT2WAPhHKY_ffuibuE0SYRk6pY_UVVQaYtho0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxsgSQzBzHbX2eE0J2Vjr85nw7PIKW6gvg2qPmavbxCw&oe=6A5CC498"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awN5ziJ1zccQ7kNvwHu7yUN&_nc_oc=Adqz6oCHx6ZLfGZrdgCs-1tL5uZKaI4wU8eZbarJov4aW7CknuuOHnBM8M8WHsMc-bU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0psD5Vop6Vbmc5LrqpZ6EmdIwRBZejRlIp9U_cIQIxLQ&oe=69DA356D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpFaklCeLH4Q7kNvwGKwpHc&_nc_oc=Adp1ywleKyWvcjmIAbTF-x02FujmWR-mqqU_U1kIhxdYukAOgbgL4ZNN5ZTkmEWv3SU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e_pWgojCllHC0o1gKXDyvNomitink1V1npxvDLcrbOg&oe=69DA46C4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TRpfVAqqFYQ7kNvwHY1Dht&_nc_oc=AdpX-ni2P1F5lBhB_lPdO1TR1BncjSR5jN7Ik3AlDoUjLKwVHTF1cgGIdA6s_RtJgKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gtsK-iGpp5suno5jJ4OAyf32UOUeXBXyVrByssTI9-w&oe=69DA317F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EtOds92MHUQ7kNvwGQVUN1&_nc_oc=Adq6qbLa7J_eRVcFiIkYgXN95jAWhhIUSGXl-94rk_x121DUzJmTd2oUE4GEtsghrmc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZwOzs6DF2_zOFwE-ECaBDajSQhICrn4WjB5b7cP4k3g&oe=69DA4252"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq3t__bFnIQQ7kNvwEoi_eU&_nc_oc=AdrtAT3A1X6_UgunKf90RN0RpUhLeeOUVgFT3n2aXiRGe5mxmTyEEWS3n2uEZA5qPhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TvxJd7-hxeEknfsS0EGYm03GUBKzarue9tDObfn1kSg&oe=69DA4018"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
302483_1433869641225555_4674985905868677341_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgxhWXfvdYsQ7kNvwEh4aGK&_nc_oc=AdoPqN8uYXDOmMt_vIneri83r8bdQ7ZMp1CCLHtHufXS0S9sNRf_bl1A0GubpBT9zKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7Ay8M907v3s8Xmg39gAucxrW3MkSjUE3RdHtdiHgWjQ&oe=69C27A6D"}, {"file_name": "Photo_20250906_010403.png", "id": "24280478501633793", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822883_24280478508300459_6487186676158491684_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9fWEpLeCbAQ7kNvwEGyPy7&_nc_oc=AdpvIM9H1VakrWTiacRd9A6P30G-XucJluGjVdUD4ZZe9ihXlR_FtJ5dWMigstAnTJA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6qY6L4cIFQjCgvfhhWbCDsCxNsRVEQfXqkRZlGmdSzA&oe=69C28BC4"}, {"file_name": "Photo_20250906_010816.png", "id": "3186985151467533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_3186985154800866_1175961672557875332_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-vi85C37MpMQ7kNvwEwcjMX&_nc_oc=AdoSmeD_3rsU5yAOYx84DktdkgK21_OYhQwAVh32qciU26HrefPX-SNEN-dxfk0C7gk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvoINYuMUsdmhWsN0SByDWmj55KIzKnHZO-r3Sfc6CAA&oe=69C2767F"}, {"file_name": "Photo_20250906_010504.png", "id": "1325369985639183", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822034_1325369988972516_48392718364597137_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCzMnl1RPuAQ7kNvwGfBkKK&_nc_oc=AdpDt-dSzdze_FNrpwoTHvhn4zzm8QypLgzeDlPx0lX-cGsmT3JhyWz5CL1hOc2y7NY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwpeyzu6Fx5tMz3u6bgrw-QNTxXhg32tBE5FwaaEQHa8w&oe=69C28752"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photo_20250906_010911.png", "id": "1492042341790599", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499302770_1492042345123932_1864960257010022379_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ7NboJJzAsQ7kNvwEeBLIZ&_nc_oc=AdrvqmhccIRHgDvDRSVyrFmUfZPulm6ycfWBe3fEtf3L7tuYMEKsujDooQ2-8rWbfcM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwL4K_cCXQP9UyaeC_gY0tBqmwUzgKw0w3-D7RUCX_YA&oe=69C28518"}, "display_name": "MONK", "keywords": [], "long_description": "Welcome to Monk! Monk is an open world VR game where you are a MONK, aka a monkey of no kind, created by scientists as test subjects but you soon seen you are something with much deeper meaning, but after the labs closed off, there's nothing you can do.\n\n**What can you do in MONK?**\n- Monk is a great game for many things, if you like exploration we have many maps to explore and uncover (yes we have lots of secrets), if you like to hangout with your friends, you are able to connect with them at the computer and have a good time with whoever you want, if you are more of a action and gameplay guy, all maps are getting transformed into gameplay points with our favorite being beach, you can ride jet skis, swim fast as light, play on the inflatables and more! Alongside of that we have game modes, not many right now but more to come! And finally, if you are a fashion person or just love to dress up, we have many cosmetics to experiment with, just make sure not to miss any limited time ones! They are the best!\n\n{1488515975512457}\n\n**SpazeWorlds LLC note:**\n\nWe hope everyone has a great experience! \n\nThanks to all the players for the support!\n", "short_description": "Become a Monk! Monk is a game where you are a monkey of no kind, with various maps to explore and various games to play. Long Description for more detail."}]}, "developer_name": "SpazeWorldz LLC", "developer_privacy_policy_url": "https://sites.google.com/view/monk-vr/home/information", "developer_terms_of_service_url": null, "publisher_name": "SpazeWorldz LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/monk-vr/home/information", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "274
798415", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12448870_1715082115409168_1877334602_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSdL_hcaeZ0Q7kNvwFBqrxS&_nc_oc=AdqKW08kDsy9ghTyws0_eI5Yd9BeL2bDHBZREoGqzcLWD6WIDe8iyd595Lsm7tpVCcE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkkLheHgd3FuEN147Dx7lp-ZiFTPH4SWdMkJKDoXlssw&oe=6AFC741D"}, {"file_name": "migrated_image.png", "id": "206430953759609", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427681_542373992636328_93326826_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLVjgeyQHUkQ7kNvwF1Vm-8&_nc_oc=Adov_NT0GeqwABI0TGA-rQ5P5-nbZCEeSZlX8JJTAzG2kXdHZ9CTSkm4EaSe81NJL3U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC1m9BabGq63MuaJuIoX6DgijiDj9QT_C3P1o2FUrQjw&oe=6AFC707B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "405 Road Rage", "keywords": ["Racing", "Free", "Endless", "Runner", "Cars"], "long_description": "405 Road Rage is a endless traffic racer taking place on the world famous California 405 Freeway. Experience driving in traffic like never before! Bump, side-swipe and and ram your way through traffic in this ultra realistic (cough) simulation of California driving.\n\nEnjoy a variety of game-play with unlock-able vehicles, upgrades and weaponry that is sure to make your virtual commute a breeze.\n\nFeatures:\n-6 Player Vehicles \n-Over 20 Different Traffic Vehicles\n-3 Game-play Modes including Bomb Bus Mini-game\n-Missile Launcher Upgrade\n-Cowcatcher Upgrade", "short_description": "405 Road Rage is a endless traffic racer taking place on the world famous California 405 Freeway. Experience driving in traffic like never before! Bump, side-swipe and and ram your way through traffic in this ultra realistic (cough) simulation of California driving.\n\nEnjoy a variety of game-play with unlock-able vehicles, upgrades and weaponry that is sure to make your virtual commute a breeze."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/7759324", "developer_terms_of_service_url": "http://lucidsight.com/tos.html", "publisher_name": "Lucid Sight, Inc.", "support_website_url": null, "website_url": "http://www.lucidsight.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "CASUAL", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "613071052998604"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12331114_236648753394638_1992976919_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SThTHwuks9YQ7kNvwHwbj3n&_nc_oc=AdqmwWExWK6voHFOrsRVKQQjGXyHeRPfRepBnd8tbQxbgrsMVZBB8UFfaWedFBmsx88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJQUPvNIacp6p2vShjO7ETVdcuDLIqWHjsMZMGB2pzEg&oe=6AFC6E15"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "405 Road Rage", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1468393200, "lastRevision": {"nodes": [{"id": "1766235896955649", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1175172312522689", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name"
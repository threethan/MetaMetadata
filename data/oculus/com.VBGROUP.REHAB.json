ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlYqqp-5NSEQ7kNvwH41iaf&_nc_oc=AdplAn3_EJwa6wlxOqe8NB0eaDTkXc8ExRZvrZdwwb6dxTVMsvM-1reiUeJTvCibIB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOH7HVNeW934rB4cEqEMENyfA2Fp-SeljLtNeztigOUg&oe=6B0EEC4B"}, "display_name": "REHAB", "keywords": [], "long_description": "Dive into an immersive virtual reality world where each environment offers a unique challenge designed to enhance interaction, coordination, and spatial thinking. From grasping objects with natural hand gestures to engaging in playful, fast-paced reaction tasks, the experience keeps evolving with every level.\n\nNavigate through a dynamic path filled with obstacles, interact with floating elements that react to your touch, and move objects fluidly through complex virtual spaces. Each scenario is carefully crafted to deliver intuitive, hands-on engagement, making full use of VR's interactive capabilities.", "short_description": "Step into a fully immersive VR experience that blends fun, focus, and intuitive interaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24053464127610859"}}]}, "scheduled
5771-25/38974564_481164379617863_2177852516936128682_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-M4nPY_ECH8Q7kNvwHaokfC&_nc_oc=AdocHE7P04Te5YFW5EC1lGsSFjlklFMkTZnhOAhBUtxkW98KO_3UhJyEJGcjT9neZuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXuejrKzGQY6RMT5Thqt-wpSmkakJ5N3i4L0jyw5Ox-g&oe=6AF5C30D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1401049716948090", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974750_1401049720281423_2130201519532884349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjFvScggCZ0Q7kNvwH2JeMJ&_nc_oc=AdqfhDFMd2G1le9qh4iuEorbm6b-bQJI7pdteJ4BEA4e_4Qh9wwRmVI7Fry8-ZUFMds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRezqHTPx3rCtolUIQm9-Dk6rDewkM1d5lloyXLbTUfFw&oe=6AF5EE8B"}, "display_name": "Interplay Learning Player", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nAN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with Interplay Learning, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "315994800495227"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1623036202243222"}, {"status": "PUBLISHED", "id": "4553261601359595"}]}, "baseline_offer": {"id": "1623036202243222"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774987020, "status": "PUBLISHED", "id": "1623036202243222"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29486080730996830", "version": "87"}, "id": "299572061836324", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "43259013
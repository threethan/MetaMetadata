=AdmEc9aP8CKHtlqrvMWx1Yxlu-7Tbyz6SydpGFqJqa5sUxSOvmgwpuGLbLfxfadx9IA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftzJfgOs_StodriQicUINTjWH3pJb9ox2BHg9ctB3IOXw&oe=69A19D11"}, {"file_name": "img5.png", "id": "1017528903570801", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392031_1017528910237467_8009556448900897281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCZLdfv9gYoQ7kNvwFj1vNA&_nc_oc=AdlyKLDm4e-ltTyy9WzVpuQOnqfG4n3_1m3LMhPy3E8Mqq_77DlhMA8C1Lt86Im73QI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuY-o5tiUzgbrpRKCVFQbbHEipJ3AD4OBHGqVhX7CJJmg&oe=69A17989"}, {"file_name": "img1.png", "id": "1373327470768596", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393355_1373327477435262_7371547513083935223_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x1UNFIMoy4Q7kNvwEMYuPg&_nc_oc=Adl4yoshjb1Bti1ByjRHZX_FbAa5qvxnlLEPX_Sd_oZRIoQuVrH4XsOs_GH7Gkb4uKQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftBMY1zPq1PuzLeKcEDZ_r17S2sku0Zdn-5kbjuzsa85Q&oe=69A1A364"}, {"file_name": "img3.png", "id": "1826105548165494", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391955_1826105551498827_7120339046151415042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoUI2meNqGMQ7kNvwFqmWZI&_nc_oc=AdkksUPwdJRmU3Ebqq2apcJHdc1okbuSmHUUp3fjK6HwhJVBNiE9bb4Y3sOUM6R44xo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsfz70waxMYkMSR6rRmui_qpeHuVk0ygzXcdezMhs8YWw&oe=69A186FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeroLarge.png", "id": "1992711624551775", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393469_1992711627885108_101803068195319789_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snKYZsR7ncEQ7kNvwEliRKZ&_nc_oc=AdnOfNa0I6wrzc9sDgTwVCnTVfm_-bx9XrFlpdyUu9JCn_vTVPF0UkBG7nP7i9rEX9s&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuxSFqOQzBT83k9ZAx6JT5zDBe5vb4AUtmMn6CDlWvwdg&oe=69A19B08"}, "display_name": "Cave Runners", "keywords": [], "long_description": "Dash through vast, dark caves, leaping over chasms and overcoming obstacles, all the while, exploring new exciting areas. Your goal: head to the Crystal Castle by collecting shimmering crystals and hidden keys to unlock ancient gates, each one leading to more challenging and mysterious areas of the cave system. By unlocking hidden areas and finding objects that lay throughout these maps, this will allow you to customize your avatar, making your look unique to other players. Use your AI assistant, Kira, who'll show you the way if things get tricky or if you find yourself in an area that's difficult to leave. It's an exciting game of race against other players and into the unknown!\n{1593488284696838}\n{2060651384448897}", "short_description": "Join your friends in this multiplayer game of exploration. Run through cave systems, collect keys, and unlock hidden areas that allow you to customize your avatar. Meet with Kira, your AI helper who'll show you the way when things get tricky. Make your way all the way to the Crystal Castle to start the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afterlifegames.co/privacy", "developer_terms_of_service_url": "https://afterlifegames.co/terms-%26-conditions", "publisher_name": "Afterlife Games", "support_website_url": "https://afterlifegames.co/support", "website_url": "https://afterlifegames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAND
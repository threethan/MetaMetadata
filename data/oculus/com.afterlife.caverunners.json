=AdlWr8_37_fMoDNa1ngwac4oUJ3n_A1i_JS2a5JEjcmU0Gk7QA1V5Q3QJfYrJD2pefE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqBwC1gj8MvjnZgZ5QGAxXFAQVkimWt3Tore7hd_HCRw&oe=699DA891"}, {"file_name": "img5.png", "id": "1017528903570801", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392031_1017528910237467_8009556448900897281_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ha7QIJxk1qAQ7kNvwENKNuz&_nc_oc=AdmQG4YOrEf2zM8nF1RCrNi_wKeYyzPIpyxgV2Ox2Pvp0VJnZXZuui0bmXKQatWCkvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvuxvrWswIMpR206EELAf1-F634eiUzG2KDBC_Fq8niwA&oe=699D8509"}, {"file_name": "img1.png", "id": "1373327470768596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393355_1373327477435262_7371547513083935223_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR4xSHop1mQQ7kNvwHiEgOj&_nc_oc=AdkgOHWV5mdzRdouaLO6-BsSviu3IVmDELauLFAXT0Ejd4n0diBI6HeoZ_M7h5qQnjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvFPfA3FwJbuBcrZgLGw9LQEztJhqzORSUdsqFb0izpWg&oe=699DAEE4"}, {"file_name": "img3.png", "id": "1826105548165494", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_1826105551498827_7120339046151415042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ioCUy1PgQ8Q7kNvwG8Vqpo&_nc_oc=AdnI0txY0LygkwMHodHiDB6WoFSUtgwfMFqYZHKGCs7nhLHFjrTgJciSXL4QdntS6J8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsldc3C47N6Kw_nsaEzb8Iba_9ZZo4ucLIm2bsebs22mA&oe=699D927E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HeroLarge.png", "id": "1992711624551775", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393469_1992711627885108_101803068195319789_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTS4eZYEqeIQ7kNvwGnSHsV&_nc_oc=AdmAzskl4EGsVCogtfb02hxOhUl687RAHpsEvkqdMx0_Xv-XeMUqsQkTF6IPyNWZLsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv4cA2yAo6_1Ur_aAZrFY5TPCh6ptONSO5dbduS521oZw&oe=699DA688"}, "display_name": "Cave Runners", "keywords": [], "long_description": "Dash through vast, dark caves, leaping over chasms and overcoming obstacles, all the while, exploring new exciting areas. Your goal: head to the Crystal Castle by collecting shimmering crystals and hidden keys to unlock ancient gates, each one leading to more challenging and mysterious areas of the cave system. By unlocking hidden areas and finding objects that lay throughout these maps, this will allow you to customize your avatar, making your look unique to other players. Use your AI assistant, Kira, who'll show you the way if things get tricky or if you find yourself in an area that's difficult to leave. It's an exciting game of race against other players and into the unknown!\n{1593488284696838}\n{2060651384448897}", "short_description": "Join your friends in this multiplayer game of exploration. Run through cave systems, collect keys, and unlock hidden areas that allow you to customize your avatar. Meet with Kira, your AI helper who'll show you the way when things get tricky. Make your way all the way to the Crystal Castle to start the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afterlifegames.co/privacy", "developer_terms_of_service_url": "https://afterlifegames.co/terms-%26-conditions", "publisher_name": "Afterlife Games", "support_website_url": "https://afterlifegames.co/support", "website_url": "https://afterlifegames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STAND
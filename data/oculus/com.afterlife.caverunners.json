nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThQG2dYDWPUQ7kNvwFiWJlH&_nc_oc=AdodC8BYH4JM8GSkB_ar-7bYzhBt2qzVdMF4uUS7TUvetxVE6Pb8RFLLGGBz0Q8zVGM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_zs_5aoFNXdOjs7x7kBhAiXM-9eoYk-JM9jnOShjxaw&oe=6AA15E08"}, "display_name": "Cave Runners", "keywords": [], "long_description": "Dash through vast, dark caves, leaping over chasms and overcoming obstacles, all the while, exploring new exciting areas. Your goal: head to the Crystal Castle by collecting shimmering crystals and hidden keys to unlock ancient gates, each one leading to more challenging and mysterious areas of the cave system. By unlocking hidden areas and finding objects that lay throughout these maps, this will allow you to customize your avatar, making your look unique to other players. Use your AI assistant, Kira, who'll show you the way if things get tricky or if you find yourself in an area that's difficult to leave. It's an exciting game of race against other players and into the unknown!\n{1593488284696838}\n{2060651384448897}", "short_description": "Join your friends in this multiplayer game of exploration. Run through cave systems, collect keys, and unlock hidden areas that allow you to customize your avatar. Meet with Kira, your AI helper who'll show you the way when things get tricky. Make your way all the way to the Crystal Castle to start the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.afterlifegames.co/privacy", "developer_terms_of_service_url": "https://afterlifegames.co/terms-%26-conditions", "publisher_name": "Afterlife Games", "support_website_url": "https://afterlifegames.co/support", "website_url": "https://afterlifegames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "exter
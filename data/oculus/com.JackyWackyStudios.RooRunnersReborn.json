lIQmd08sWryZopUhlXUaPPvOAcSN3-fpghbFnM_9w&oe=69ECA1AE"}, {"file_name": "MAIN_1080p_09.04.2026_07-04-05.png", "id": "1195891045791996", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620429_1195891049125329_6329246901185705472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxXBD0zUx5cQ7kNvwF6h87p&_nc_oc=Adoeyu-QngnwJWyz8Wfz27LPq3WG9Dh0HiwxVKuff9jKEpqPrHfknVN6foZZ9BqzmrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jpaS-l0tDJ9036HgRw8QqAIzuIn2xRUftOgidOx6jkA&oe=69ECACD4"}, {"file_name": "MAIN_1080p_09.04.2026_07-03-51.png", "id": "976511211390512", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620444_976511214723845_3631283808053911926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnIVXCZjMMAQ7kNvwHWLO5V&_nc_oc=AdrO3TX0Np1HaYXo1jPFfynC0ISrqximlcb3Tqn-FOmh4kdDTFed09KpDfnoPBlDs0Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32l-3wc7M6FEnKVrcxv1yHpRWqdOWweGiwq3--ACUwzg&oe=69ECA6B8"}, {"file_name": "MAIN_1080p_09.04.2026_06-59-19.png", "id": "2433953177074222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_2433953180407555_6399951980724409193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMm5U3Bj4fsQ7kNvwFCPodh&_nc_oc=Adrm38JKS7tb4Hndr-1Q9MFgnUuhm0P46SsHQJQDAdpr7h0n0O1xLvz2TkRLvbvL2ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PX2R5STVj3xCHibXEtMWIxsZMwVzfLVpFnUfJiiltfA&oe=69ECB235"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roo Runners: Reborn", "keywords": [], "long_description": "RRVR is a chaotic, fun-filled game all about messing around, exploring, and just having a great time with others!\n\nCustomize your doggo however you want \u2014 with tons of cosmetics, your style is completely up to you.\n\nBe sure to check out the game modes available right now, along with some exciting ones coming soon! (Not all game modes are available at launch.)\n\nDon\u2019t forget to read the rules and code of conduct so you know what\u2019s allowed and what isn\u2019t \u2014 stay cool and avoid consequences!\n\nThis game has been built from the ground up, and we couldn\u2019t have done it without some amazing people:\n\nThatguyfr \u2014 Been here since the very beginning of RRVR!\nSolkean \u2014 Created the model and is just an awesome person to be around.\nAxolotily \u2014 Brought the music and maps to life \u2014 huge thanks!\n\nAnd shoutout to our players and moderators:\nJacko, Poptart, and Floyd \u2014 we see you :)\n\nThank you for being part of this journey.\nWe hope you have an amazing time playing ", "short_description": "Roo Runners: Reborn is a fun game made fore having fun causing chaos and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wackystudiosroorunners/piracy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wackystudiosroorunners/terms-of-service", "publisher_name": "Jackylikessharks", "support_website_url": null, "website_url": "https://sites.google.com/view/wackystudiosroorunners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26452275391100762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618254_937615442342558_5318926491831852084_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
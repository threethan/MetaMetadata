kykngrrn6fNyTJIC42Dezd4mvgRYdGD3eisWZaESQ&oe=69EF7CEE"}, {"file_name": "MAIN_1080p_09.04.2026_07-04-05.png", "id": "1195891045791996", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620429_1195891049125329_6329246901185705472_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB2_NBD9ftAQ7kNvwHL_FWs&_nc_oc=AdopdWJR4d_6XweitbyVB4n_3KqSFVVltUMsxzBzGylQGLKqDjW-X71r9KyshJcIqDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PXFCRZXBH2pYYB3wruuZB5f_rfuqsBnYsNjKM9YweMA&oe=69EF4FD4"}, {"file_name": "MAIN_1080p_09.04.2026_07-03-51.png", "id": "976511211390512", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620444_976511214723845_3631283808053911926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKf6_3dN8HIQ7kNvwFJabgG&_nc_oc=Adq99bvMWwjjPRnxh8dzXT6AUAIvAfkH9HR55DtY_IcxyG37TVETJRTZ4BnuogNaRyI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af081KgTF9laBOLbJO3VckmwmBeO3wpIPgw5jYCx5cEPKA&oe=69EF49B8"}, {"file_name": "MAIN_1080p_09.04.2026_06-59-19.png", "id": "2433953177074222", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620860_2433953180407555_6399951980724409193_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJrq54bQ9qUQ7kNvwGPT86_&_nc_oc=AdrYorGv2UpIUniUIXCrSl8-OUIdYtUEMJzihpHIcaeb6OvI75ISsiqkw1B5uF6OKd8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21Cvxoh79wXcrudtBhNfzuz_BZB49NG_MS0UN_bgMhtA&oe=69EF5535"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roo Runners: Reborn", "keywords": [], "long_description": "RRVR is a chaotic, fun-filled game all about messing around, exploring, and just having a great time with others!\n\nCustomize your doggo however you want \u2014 with tons of cosmetics, your style is completely up to you.\n\nBe sure to check out the game modes available right now, along with some exciting ones coming soon! (Not all game modes are available at launch.)\n\nDon\u2019t forget to read the rules and code of conduct so you know what\u2019s allowed and what isn\u2019t \u2014 stay cool and avoid consequences!\n\nThis game has been built from the ground up, and we couldn\u2019t have done it without some amazing people:\n\nThatguyfr \u2014 Been here since the very beginning of RRVR!\nSolkean \u2014 Created the model and is just an awesome person to be around.\nAxolotily \u2014 Brought the music and maps to life \u2014 huge thanks!\n\nAnd shoutout to our players and moderators:\nJacko, Poptart, and Floyd \u2014 we see you :)\n\nThank you for being part of this journey.\nWe hope you have an amazing time playing ", "short_description": "Roo Runners: Reborn is a fun game made fore having fun causing chaos and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wackystudiosroorunners/piracy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wackystudiosroorunners/terms-of-service", "publisher_name": "Jackylikessharks", "support_website_url": null, "website_url": "https://sites.google.com/view/wackystudiosroorunners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26452275391100762"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618254_937615442342558_5318926491831852084_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_oh
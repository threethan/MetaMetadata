_trailer_thumbnail": null, "display_name": "Roo Runners: Reborn", "keywords": [], "long_description": "RRVR is a chaotic, fun-filled game all about messing around, exploring, and just having a great time with others!\n\nCustomize your doggo however you want \u2014 with tons of cosmetics, your style is completely up to you.\n\nBe sure to check out the game modes available right now, along with some exciting ones coming soon! (Not all game modes are available at launch.)\n\nDon\u2019t forget to read the rules and code of conduct so you know what\u2019s allowed and what isn\u2019t \u2014 stay cool and avoid consequences!\n\nThis game has been built from the ground up, and we couldn\u2019t have done it without some amazing people:\n\nThatguyfr \u2014 Been here since the very beginning of RRVR!\nSolkean \u2014 Created the model and is just an awesome person to be around.\nAxolotily \u2014 Brought the music and maps to life \u2014 huge thanks!\n\nAnd shoutout to our players and moderators:\nJacko, Poptart, and Floyd \u2014 we see you :)\n\nThank you for being part of this journey.\nWe hope you have an amazing time playing ", "short_description": "Roo Runners: Reborn is a fun game made fore having fun causing chaos and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wackystudiosroorunners/piracy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/wackystudiosroorunners/terms-of-service", "publisher_name": "Jackylikessharks", "support_website_url": null, "website_url": "https://sites.google.com/view/wackystudiosroorunners/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
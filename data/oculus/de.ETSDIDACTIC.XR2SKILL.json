iker/in\nTechniker/in f\u00fcr Maschinenbau\nTechniker/in f\u00fcr Elektrotechnik", "short_description": "Die Lernanwendung VRTALENTS ist ein digitaler Assistent zur didaktischen Unterst\u00fctzung im Bereich der beruflichen Bildung. Die Lerninhalte sind auf das Produktportfolio der ETS DIDACTIC GMBH ausgerichtet. Avatar und Stimmen wurden mit Hilfe von K\u00fcnstlicher Intelligenz generiert."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ets-didactic.de/de-de/datenschutz", "developer_terms_of_service_url": null, "publisher_name": "ETS Didactic GMBH", "support_website_url": "https://ets-didactic.de/", "website_url": "https://ets-didactic.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28826763980359075"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825563_1780987042542822_5687644394859945743_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5anRL_y3q8Q7kNvwGvU18S&_nc_oc=Adppn2YECvosFRj_Qyjm0UevVM83h2sSfCcX19zeFCTRPOOTGjTPrnEpiBV2QG3X-fo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnZ8rq9vqZLRS-IpGzgq7epJM6bNW6ig50EHho1CwxNw&oe=6AFB4676"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRTALENTS", "platform": "ANDROID_6DOF", "context_category": {"conte
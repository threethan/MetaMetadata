ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rs4_J4iT4ucQ7kNvwEfFV9v&_nc_oc=AdoRBp7In7PemRWGe6n_fL6GBGB8u-gSeWvg4s0fD9TqCDDHTWUgcgWQxpdUbEPPULE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHZJTuND8jBXRdjeIevNoXSgfngVtTsA-I4BejADV-Ug&oe=6AF7486D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLi9R_Ui1yUQ7kNvwHNuf0H&_nc_oc=AdrerNMjdZXC7cY_dIoW-5QuFSyW0aUeFQCS1c1x3WALd07RldBXSi5-qOLZuJj7ZSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMTiKxWq9FR1IyE87s7kFVmTToYOsT5gc0C9OTir4a7g&oe=6AF72DA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=374-7urwus4Q7kNvwFvAyrU&_nc_oc=AdrZkd7PskhdaFdu8b9sT7U8QJdADYjp1s6QJsZ95Ah4p6AOZV2LXN02dM3GDvmd9Ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKB7H-lJv0JqjUhzFmx2nHT14TcKftslACF_Hvec06FQ&oe=6AF7148C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va5iOmLhKTAQ7kNvwGpLcNg&_nc_oc=AdqHT3jXmMa5bMp5bH0N56byUwuTvJ7cpTTVzkLuxd_Es7HoOJnFU5I6aWVUzxFdqbE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Ku2iJqPQcgFsoKTAKOqyXpywMeqcOniK7aGaGyrldg&oe=6AF71D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l25fI4R3j_4Q7kNvwEw5PYD&_nc_oc=AdqKX3yk6gQxrrIqrG2107OcBWogmaFzmH9hIPc081mljJDzBT24x4kn20daIUiZVBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlPq4g8cXDYfGSIBZFJwO8EHdUaRQvJlhBsD1_6ajlKw&oe=6AF72864"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
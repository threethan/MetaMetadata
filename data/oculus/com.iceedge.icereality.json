ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiMRlaynYsoQ7kNvwFAul8X&_nc_oc=Adrkj-0FaEMNliGi6yDJBBUiqCCoMCQMEvIDVyAmK0LV40Ub74khwVxON5HMzXCEbfs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rrefzKAhi0Z9dYrII-p8SiTzr8qF70p0Pl3RM-PfrGQ&oe=6A26C32D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmhJR2PsDFMQ7kNvwF2Ai8h&_nc_oc=AdpeH0UVVphCLXyPMSuLmPmAh0Um7gxD4I4-GId9GQq_ByYnaRclU2MqCj2I0VZsKx0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hPKGW2_n4NLuDJlgKiG9sBw-wBqd0EYtvZQ9KoYW11A&oe=6A26E0A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edmDb2L71EoQ7kNvwH58VSd&_nc_oc=AdqoZvJL_q6DxeGqDgj9_0F17kM_nHoh4a4m3LIBnO_1CvqsQFBiYSs746BLRgH8t5g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MXimVhtKCwILc5XUPyyhjVlKN2ME_Xhx2HgChTmDw7A&oe=6A26C78C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niD3TFTcsvcQ7kNvwGMYAbi&_nc_oc=AdpZyUO4kk30BxuGgP1rX-7XFy_OI-2OCJgk36n3jufxW_5bMYMlMuKwJQDhALtEMCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aVjDUnQyJ6ApPmSuaCGt1R6sMuHR3Q2MYUrd4I3JeoQ&oe=6A26D002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVhjTquXQfgQ7kNvwEC8LX1&_nc_oc=Ado_EjC7aAPLME3h0-mKqHI1XYBidQ6VcFG7pa4A0xAiVcwsoV2cJdiYfQWCZZOsU-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3oJgNnJ8mmquTB-93WWUDwTtvQRsKiCLOx1WO5DKFkA&oe=6A26DB64"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
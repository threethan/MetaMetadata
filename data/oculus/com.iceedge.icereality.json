ps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bYz_4y28k8Q7kNvwEnMgLD&_nc_oc=AdpLsDVTEZ2UfnaceXScbcppOs3Z213PbSqGzXkqzy0cBidfywBcaqJlhZnR8oX0rnY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwomFbIvbUFvdv-1h1rTd9P6ECWpLEkhjmyFiFryDrzg&oe=6A88522D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb0WXOUYRvgQ7kNvwEeuTlZ&_nc_oc=AdrtAqvGDw9thA0EFYTmY8JfhHyCab5n7LFqGJpx-CM-j99J9jrD1dSYzyPMvX5KQ88&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEzIa-0RxoJi9eHfOBLBrnXOB_tFVT9r7eZ5kDCk8Ryg&oe=6A883760"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jixwrYr0mM8Q7kNvwGEhP9c&_nc_oc=Adr6wDa7xzrEPoD2yO6-MJES0ORR9mDtnN7viG2rRR8o5IWn30lm7mQ2uSAV1JEihps&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA6jh_h79GsjU8vg2WwCRYDnaQcbuGcL9h9P7gOoauZA&oe=6A881E4C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS4mCcxLxJUQ7kNvwHzAXIB&_nc_oc=AdrP9lcrQj0Q0NtLx4f4VpKhooTiVbgeY1nVZt8nhZrUvtfoVpmCr0H0EZ4MCtHRksw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9fOpyR8MR0dnsXn-g5F0xY85vnEpuFw7AQYLe0bWiuQ&oe=6A8826C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il88nvIzuvwQ7kNvwFHySaa&_nc_oc=AdpE3M8HDkp004ty__UhyRVpZXNsTFuEX4j4a3MKh92iJM0VDF1YBt6u6vO8GS600rU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8az3LOVlJVJ-TGeFdfetYmgPZbD6x25FcQ7foZdm6Q&oe=6A883224"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
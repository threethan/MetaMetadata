ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM2UHCXf54cQ7kNvwEmuor8&_nc_oc=AdrgOsLuPtMzgF3Ds7txyvzM-hXeh89M9ayBArCLN9PwQ_1HdhxpurUvryCv0qkIx5o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Nd8UcPZYxcjI-JZHS5x7GYlsFDe-v4o-c_a88sKG9LA&oe=69F89EAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFrLOCkKDAsQ7kNvwE_l9R7&_nc_oc=AdrSyKltSSWhGh-ImwKeZR2jo3UzGGvLfWfla-0csFqZ8gxngOa-n8hRVXR3p0odEeA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jLecScu60awb_MTAqPYNBwaNy6shggN1e5Ja2k0SOOw&oe=69F8BC20"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vBFCQa3-VgQ7kNvwEsEsjt&_nc_oc=Adqx-e0nqbRmGytnoeGEMp0ChbGmMu7kuOfgaWSga-FDdqWHeWnTeq-sgU2ZleQbTP8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZTj1hp6rsoZiRWDuKK3EV32d18Bfvvs36Y6ikxl6n_w&oe=69F8A30C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fX8C0YIluH4Q7kNvwFWqabo&_nc_oc=AdotY538WZhC8biJbrrM8F8klMmm8zv3_1rWuHqnyVfvCkToiig0938z0ULJsjMyPbc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WmWumG_D2k8hCYrGPCIDrdbMmX0K1Vml2u32jfgLqcQ&oe=69F8AB82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSmLnpAIbN8Q7kNvwHsseTW&_nc_oc=AdpNCOTBt1jb5XpKP-SjG5RF098AMlZ_m2rCXwdi1bD1ZAejeP2riVdwArtaItEyUnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ct_cmWNkWADWwjTwDzbIDRLzVrvARyoPvEKRp6k4Y0Q&oe=69F8B6E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
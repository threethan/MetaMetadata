ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_1tXcMZ9zwQ7kNvwFy5KCF&_nc_oc=AdoEInR8XxnVzxlkc-V0FOXQ43gt9qkr-tt3ZOXVMRCAZQTHwRqZtRZDGW8zRJfBPWg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-shyjfgTqJo3o4VHKdgteaF6SowbrHBBTx1W-m1-IkMg&oe=6A2FFDAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD59m4P1Ci4Q7kNvwFd7nRP&_nc_oc=Adq3rL2quholMiThMqGccUBioLlMNykvdtWNIZBJY6UfjWC6y4F7ItyJaKAU7JtLrig&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w3QLEGTIWSMhaHnmvG3bujf265-gMLZYSFPbySPnxwg&oe=6A301B20"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4i0JemwwqQQ7kNvwFKjKu3&_nc_oc=AdpjA7V5w0LIPju0OipUmvlXIe1bAuWMQuSIv4A-aMqcl7S9aIz_HaO-kbW6uF9BNVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WFBFqCSxlVNK_PctkBlKhZFzSgJsw1TCWhh1w_WRV4A&oe=6A30020C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4i9LOchb0IQ7kNvwEuzfl_&_nc_oc=AdohnR67NyxILcLWMDsnqItO7F_IxtTZVr8Vn-px94voq2DVYq8SjBvr7e6_FPcp0AI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NqMN75TzYqM9AJ4DQjr3orqcmE-DdsKqw82B3mzymkg&oe=6A300A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ft-OknBKfEwQ7kNvwHJHY7J&_nc_oc=AdrkM6vn9wt8Z2_KXtgA-Cu_Lm9V5o0bl8JXaJBC4_6VzbG3t2Ui49wn6BMzW77JxFg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o_w2yb4NmKnM0nNhBXCk8rBvUenZf6Bb9NhALa9ZOhw&oe=6A3015E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwp9d_F3-5AQ7kNvwGF1Q3I&_nc_oc=AdpigLD4X7bELMKVgqlWyamX-M9bBgLvdyBM2jeLYizK4RU9khNdP2UB-On02gAXxxM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUX7y6cvbv2pUeEFmkuLmRMdlCXZIN1hCV17O0g_GVNg&oe=69CD1D2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYcP5dQKcb0Q7kNvwEnzcF2&_nc_oc=Adq7eT-kj6tZ0IzYgcePXhW5Kw61BhjbRzb5HXxUceAvFWKC9uMv0A5hu281-GC0KrM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8E8Pftq-h64t03euPKuQWbGyGvDEGc31N2Os8dsyDJQ&oe=69CD0260"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opq0OBZuKvgQ7kNvwESjpyZ&_nc_oc=AdqsB3b1QzfhRdAIFPWRqdZ19Q6Y1EJxWV9WwVtWzJxzdAPqquFYqgY6JyVeYPbWG_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfVDA04BmsOiRwlnIdTswmK1KA93ofcbBAxp-XjY0uJQ&oe=69CD218C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KKpha0xaS0Q7kNvwExmJOi&_nc_oc=Adr0SMOfuftnNPTUdRfKqs8iPigNouz01ciLNnPidyH7MkS-5yvq6a_8eZULKpKBXpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_Qvt0Cx1PjLzhGCqDQPFR97pBI0yWoMJLT7Xc7ofozA&oe=69CD2A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWhToVslwvcQ7kNvwElQmVU&_nc_oc=AdoRxl_R6HinyaRJ0GriJr95vkSjzxCfwGa7pGMcG3LlrxkJJ-NkvAskiYwxuzQTn-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9sXgftgVHFzSYZaoaz2kBoyzm17ykp6YBjIeNFTSE0Q&oe=69CCFD24"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CNMMvvFRBQQ7kNvwEUxvTB&_nc_oc=Adr9172vMLHId-2BiPlnhGOROQ3QrE_k4awyeaFXHGFHB-jZBLAWVFs1ylSV7ECWa2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuSgX11uvuNi3RU3Iqgbr03r940tCBtDZKSAYyzjFtGg&oe=6AA00D2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZhHplrhVvAQ7kNvwGile_F&_nc_oc=Adq8IQ-anCcFEQIst77w7gjXi6uF6n0e2ecq3KYx51Zetd924YQZpuj3KLfCetIc5s8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISIEmoAYYU71-qQ67OR_kC7vsoHHGnjBYM-sS_yZRErQ&oe=6AA02AA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHDUfegKRlcQ7kNvwEO_I0O&_nc_oc=Adrx6rFRgAX1D6bc6MkSH6nCEgssChjeN1132DPGU-tBv2FDRIrtiN0aUQ8R6ALzgjk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWJ04ZcRZVzfeSh2ZulRho4tOw1RxDXcjMx8oYe7OmBg&oe=6AA0118C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wRTDqRXYdAQ7kNvwE-o6nn&_nc_oc=AdrdGyQXutUoWL-MiidmaHidg9h5wMP6xMlkdjMxPWm0i-sdmBflvsbVX-1l2mOGzbw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6Osz75oFakQ_jRk1uzMGAAzNCDK3BJo83EA7md5HIAg&oe=6AA01A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_OmSGrKX1IQ7kNvwHeuJ3a&_nc_oc=AdqTlxJQw03F2ZlMwTKVv1UJLi4rdbZH6P84bh1nf9w9Ow3TTCGVi6Mc-UUJn_760TA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI__3TT1iL5TqZRC5VOMtdVTFXWeAgEZuMgT-BfE0FUTg&oe=6AA02564"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
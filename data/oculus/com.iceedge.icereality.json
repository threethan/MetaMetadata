ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TAkAkY-HTgQ7kNvwGJkQh6&_nc_oc=AdpZKOSPdX-diGtptBKdor7pCMtTTrobE6P_Lm9pS9Cl47TB3DSqGZGPA6r1g726Qbw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6xQGAW8GeLhLm4oe2hzX1DM1PcJGJiXBAdm-HeSSE7Q&oe=6A8C46AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVqxZ4F5logQ7kNvwHi36Fg&_nc_oc=AdqJRPYwJXUWEUp1rxIxZzJdLEX6O5uVslzdily6XYGy1WMVj-t6ZMlS8sFzjvCLTAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0nft9-B8aub3QM6Hvh-gr0ITLtljHE9Ckgcd_0kPTqQ&oe=6A8C2BE0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFrc1u0eYwsQ7kNvwE3ufH6&_nc_oc=AdpOiKAViHm0mte81oTwvK2zIhcKnJ0m6GfvklAQydcyRhsiI4_9VFpxRJUpyVis7Jw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDyFSc3nzXEp2pcOOQIGxMccOMQETYGIJWvcR8k82m2A&oe=6A8C12CC"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4sfTyiAvSMQ7kNvwHeOo0E&_nc_oc=AdohOKRsnAIFaDNIZiwubPADHKsvlvl6tgYHyrPpfvjNIO2l695qCgFXXiV2rWU7ILE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIObbDroaa9LO9U8PL1tqnAlkW2o2um0iFyVE19mBlFg&oe=6A8C1B42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5ZEc1ZwWwcQ7kNvwHT3Mrs&_nc_oc=Adqu4kctUgSUEc8FouXxctse18lgq22UX2C102ykt2bD0j2t5af48juRddiCZr56zbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgDaQn8sWyNRnEZ79qV-lWgUyAp9X5FsxjYL8CLSYLHg&oe=6A8C26A4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
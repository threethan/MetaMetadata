ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffla0Z0Y2-gQ7kNvwGfYwCg&_nc_oc=Adq0T1Iw88lRMpToD0p3KEQvx6OtqKh3UVVJBXlDNd9ogMv3OxFNkmST48MtbnARSQw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15BUeEkiiQpHD1Zh2HfUQw-AOL5k_BCBxcrKkH0eln6g&oe=69EF642D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXgfcMG0AykQ7kNvwEW-p4V&_nc_oc=AdqpywsclqjgaWbRuBD-BYwzokmZeLLAXe3cbBJ2XJyEgbbuSNo_C9Kv3fF_hMCGuAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af236w0RDnpEsPnMgA63St6tDH4vRsMLymCDPm_HQY2Uvg&oe=69EF81A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FA2WbIT73wQ7kNvwHlRMLY&_nc_oc=AdqUuk4N7wl4GpgTtsPCf1IHNams0y2fPWeJ812eXpvUzGvioY3aKmC9ZPYAYFfOQm0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af318RZQ-0E3TGg03nm1nR8g7dpeMR1tWzYBfi-I31Llow&oe=69EF688C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HEcFD3lWScQ7kNvwE9qTg7&_nc_oc=Adq8jMLYIyilOfS2oaNssWFp1pfNod0dljfrnU9cQHi7MfIqMYHHQdTax8fn_U-tPFg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wac6H6rAlFmq_ZutImRfeCrso2ehv3DPaisG1nEG18Q&oe=69EF7102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nsF7X2mzMoQ7kNvwFKZeVw&_nc_oc=Adrx3t3C0dBxvglyZwvUVJgVHFM9UfFzDTrtYaPiw1MA52bb3m3b5Dru7fTHMaCW1H8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wIYGuOxmzw_wPW5ctXcigJxNMFrxlf7M2sPMsmyJTCA&oe=69EF7C64"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TIRcwuBrt8Q7kNvwEw1zEH&_nc_oc=AdprzGAtTBksocWKoUqfL_AsMkRGljz7z-xY4rVr_7PdfJkUkwRsrwuCsm9lWKda4h8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBoPfX6SZfTxNzwVRp1xcl06TP97B9V1EzSdeKp-DOIA&oe=6A830C2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzL4dX20lYIQ7kNvwGO8Bag&_nc_oc=AdrAB3a-POh9Kdcjy6urCoq8LkLk2ojuxWGcpHgwROP5aKvliNM5e8ksyKQl2wPAu98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcuLDYRWL6f8YGekGo3dt6v5Sf6Xh27NQPCfFP--IoyQ&oe=6A82F160"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwcNsOPPjJYQ7kNvwFO7kBy&_nc_oc=AdqDH63t2IHg5ucppcWgfTvhN9wvDVfiST1Z_cAk_o_bL75qybYTQ9EUvquPWS4NVO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB_eOHQg6Rwt0cBbeEBaZtuquz_Y1n-PNJJWZLJqH7Dg&oe=6A83108C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfOmVvRnp98Q7kNvwHmWGPx&_nc_oc=Adpq-eUd5SipFouDqkw3B9zd-krUHQQUgbbpb5xGCekmr9h3m7_uRGl1d2ILMzxJzrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElKoQ5d2U14OEyda9ufwD8w-0A6BFtGkFyiUGQ5MNz_A&oe=6A831902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GU2iv9peXAUQ7kNvwGT1Tds&_nc_oc=Adp7Wn8A9p9wtJIPe7KCPg8nogjnsGEMwtgi5pCvdhCfMigUK-GFSVMZZSxbD8MBZW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0s0uIV1jXd-SmjIyRFFrmgqhyZkf7rZlSPgWcn911eA&oe=6A82EC24"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
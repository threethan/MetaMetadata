ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvUGB2qUy7YQ7kNvwFEHUv1&_nc_oc=AdpmPmhD3UpEEuiEwsWDP3NSCRZYgFG3cyecF7RZIbsKpdDl6HZVu4fTM49bPMO5bSQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITDpaNWGsUZrHjxFeeLmbP1Ghuzw3SSbNh3TjRHLfnbg&oe=6ABD0E2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cquBwQ4SNwQ7kNvwHmgdKc&_nc_oc=AdrTpzNrnaND5OJpRNi7tp9FJdwcjGxKZDks6fV1b7MtCPxQVg8iYWhFYGUXnVnxjHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMQ-BRE7oFrcHly3OCmzKAWHgHcTWJEcoBGOc61EZYKA&oe=6ABD2BA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzVG1vwFlXkQ7kNvwEgNTzR&_nc_oc=AdpdfTxYf4mpxgwRpoe3sdyoCcTCWmD2fZNoh5pKYtf7Jigdbdd3cRLNjtw4eKsaJ1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtaiWlLrthdJTEZKZbeIHzHIxu7TaWxpgJLCmeKTlnRw&oe=6ABD128C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI_NATSBHKkQ7kNvwG6fuTN&_nc_oc=AdruW0xj4lqKsT0IGRWgHy7ge0SSVQE-4s_3EBG234dFXwCxLWDimBk17fH22JyDFNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL0O3_k43WZCUgFg1wnM1piG3KHo1oohuHvG7V1puTgQ&oe=6ABD1B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjvx9kFAeKwQ7kNvwFvHnLF&_nc_oc=AdrQ0jjMInffAEl9RjwisC-V3Y8SXaZ45s_99y05pf1q-FQpn69wQqypiZLLRHYn2A8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO0gv-1_vMhtYqIcPLSH_ViVir1KoMM5L3NKlMq1M-zQ&oe=6ABD2664"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTlOZMgEr28Q7kNvwH8ghAu&_nc_oc=AdptTwJdx2k1tYrqkO-0taD2Y0R4gtCMYExz9sUYe6z-I_jN4fVq4PVcNAY87EaH-mQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2POsleU2Po0F4MPB3u2hpk6AFh7dJmRSuNwfmmzFGCVA&oe=69E629AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYfjYPgaQu0Q7kNvwHaFe5K&_nc_oc=AdpqGqXv5N_xuRLYabtwK7jhE-Oco2OyT31-q5g4MSUSJlIU3yZKBX6jT5Yv5NB-0H0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28jXV1jiMxtiigEkIQrVAQFhFCpGSeu2kC2uDaxeeMgQ&oe=69E64720"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMA9UPGjXJYQ7kNvwHohw16&_nc_oc=AdqLuagLelB1YoH3_N6PmU-B9EmHXDUINF8yYxyIKBKNLNbzeZySBw3JUvoAdicUFCk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28OAmycalLLhbhApnBmjWQ-PkGTaEhvGeyZ1WNJSuB0g&oe=69E62E0C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcasWrQbKVIQ7kNvwHUmXXu&_nc_oc=AdrmtP6QziKLYv3upIUgxD_wA1zGwPv4Wjw7IpeGCeipX-ABkuIHet7hxtaRVonme_M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BnFl0aHwZcXEK2r1Ig6d0IF1Xalgnqwif35HvjrxoTw&oe=69E63682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQjhHnxK9eIQ7kNvwEyGLDD&_nc_oc=Adp4wae6-eEXaymGO-2WFUu-tfRl6ALAwzeUcb_fX6YFmA9GSamXGCN3T8aAX-KQiTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yOnMF3mVul0yzts4CsPkDwJ5eax89NJ0A35NMS33KKg&oe=69E641E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
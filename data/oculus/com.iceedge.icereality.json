ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmeZW6HkpB8Q7kNvwGZcJld&_nc_oc=Ados96RwQWJMm27dLu9i1xsvceseRszWFokPFp95PxO7KRNoITxlu7FyNFNMcMC3wfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EPF8b4hVGQrcNa4BeP7ZFcOa2Ue3Iyqsu8C1q8408gA&oe=6A37E6AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MvLq5EiSFcQ7kNvwH1YgOu&_nc_oc=AdrkcrC8xnDhRWD8RPcfkVtsmymGTIkkEr0ImbFegk7EEXfyibXCbVJZHvHJ3T0uaE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KlXBd55QsfT3dGGyXZhzldZnkQ3GQcoAxqfhaNnvl1g&oe=6A380420"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMtPYNQPmFwQ7kNvwEMc0-9&_nc_oc=Ado6qvZ3UNrIAS4w3iCAuo66e0y5hTxxp5Iqy7etlMdQR2cW-gvHluwO4NjQN2sEqmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xyp2X2Q3XHrtcGnj-WkeMVCgoZVV4_hgJaRlUtu_F5Q&oe=6A37EB0C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImsxSJc4KtsQ7kNvwEwtE-O&_nc_oc=AdrZMTanom97mXspvxD7Q8etbnZgH2su_U3i9f0xWRbXCVTvFoOgC1zpKV7GXY2CvYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZStV044nfDdN0xnycHzsKx2Gie8DgROjiYiUHKRc-qQ&oe=6A37F382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UE-ubu7-d6sQ7kNvwFLTy3V&_nc_oc=AdoSIVIoNDOKiBMUBrE2NFaeU1frR3jog8u0UBYlknb2oM6gnwL_XVi60WbNQqZmpHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wU-ym82ygPWo8xvDDRtxDCDL_ErUW97KArAYVc0JpWg&oe=6A37FEE4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
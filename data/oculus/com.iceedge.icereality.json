scdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqeS6jIlTAsQ7kNvwGTuHt1&_nc_oc=AdmoIKYUY8iRyqeo6ZqJlEAT7QBYP8Y1yuqba_4GF7pn8IGShm-XZlX_ADd9VTQLI7M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ95CVtTeFGxk1MPzN9bUA5MfgfDqAK4fx04e5JTgYFA&oe=69AAD62D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4ayLlzXk7MQ7kNvwEG-5oq&_nc_oc=AdmwLZ8_GZryJkJlq29xsNby6SSqbMqp3fFHkbqafAqUcCs-atjWDkMSi1tUWj7m2Zo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-BtvTXYuuV4CQ9sIAB9rFgxVcpXmor7-GDyiYO6LEug&oe=69AABB60"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liTEvvLemPoQ7kNvwFVBj7C&_nc_oc=AdlT_6n-FgnuuwmrbFcs3vb2vJeNXBOiQXiTMuz6JPj_9kRCEIO7qwQaQYa-mDJN0RY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyCyu-rSO3rWaXHlOIoX-sTSs-Woi6fTQnUw1B4mQGIA&oe=69AADA8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YOENI4-eOQQ7kNvwFGeMxh&_nc_oc=AdmyyGmMhNVX2oI6X3lJZTxgq0vAzqJF_uqKvXjKpey5FNqKk8SUQc7FmzxbwlHU7L8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPJHcaGwLtZG8M8HqHN5IchsCxTnUaAtNLH7IAjQCyig&oe=69AAE302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9rTFe8gYygQ7kNvwGSMSid&_nc_oc=AdnAAebyP5LQ1F9zTosR2DzX13BDKSs_56vEWZ0WJrjTdqtjoIDFYoO8_W__9GnpJyA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afyr4s9p4wzySMa6P7Mi_4itHUA4_gmtfCvZceVbmFZ_hQ&oe=69AAB624"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
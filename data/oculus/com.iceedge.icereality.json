ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUVj74ubOmUQ7kNvwF1XphB&_nc_oc=Adpxl3qOG5wjEgr_XF8O8d3ZUPoaUlwkYC3z709knkfL_PTxVvEHYLpGp-1mwlvhLbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1HBjMzb21cDgX_BZbMQVIDR5xadPxYkL49ibvm8VaQA&oe=6A79D1AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4aa6CmZtEwQ7kNvwFkETaD&_nc_oc=Adr6DL3TXn9jL-CQjTimwkQ-RVyfYkTAAp28FtFB1ddc44L6JLlZyd-Jk2WnwMMOX9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIxqOntLde_h_K-Hw-JRjdLqZ8EIzt_oFHwxZAWIUw9g&oe=6A79B6E0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL53Ryb04loQ7kNvwG_ZkOH&_nc_oc=Adr1NrMWGZrDqp5ge0ode0xFRQh9rFGNw-x4Ez0ao1ITVmfFiJwYx59eaWVo0q7f_20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF16lyy8aKl75LG3X8BxZu_s2LssKBcqwwEhk4AtyNAg&oe=6A79D60C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKDq6JXDvJoQ7kNvwEhEjM9&_nc_oc=AdpOLg-LfzvzIBV2HvZvvJJBVWCouzY69enH_cde7IsKPaNlbzImgwrE-f6Dh2JaswU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZVZaicwytUX5IoJbMG8o9FZFXvvoqnzoY67CqW1fO_A&oe=6A79DE82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nJxidLhclgQ7kNvwHlafw3&_nc_oc=AdrAd_7VFSQ1P2VXRuOgmYXwQ1e58ZhgFP3oINtcFUidxR4bvQHzL_2JO7PC4mWQyx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6rT7GBMHRmVp2RBgnxt1zHBu2fH9768KXw3D3gledAQ&oe=6A79B1A4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
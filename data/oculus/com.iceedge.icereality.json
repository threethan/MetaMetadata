ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tG7dfHl_OcQ7kNvwE6C-UF&_nc_oc=AdpzZCuN1IFied5gqKNVFCOBDHyrKh9IL3F1THb5CRlLu_MGqOnGvL-AUd_g_X8xoFE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IuABSqXqnnrNT69EOqqSu0BBYX1MgRHkkwoZqCxznwg&oe=6A032AAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdCmkuQixGoQ7kNvwHo5So4&_nc_oc=AdodIYv8v4slLtM7NuNV9x4OKsbTaqCpu-d0dVOjauzIQy-JvfjMx7lsMKfQioZnDwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ymaTcXTZ2d-pirdFxYXPLvzkDV0YaWvF04jTI7SyUAg&oe=6A034820"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzNyHZLQeccQ7kNvwG-VkqC&_nc_oc=AdpdMAqjSBVSg1v6y-vWiKx_jEbNwCzvmSoCipGXigxicupeyAA7lkiiVBEzkPoEd6E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rw1fg4d2u93wxS3-OMq149HCT_CMC-YtZSAOeFVcZ9Q&oe=6A032F0C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD_QB4IiIGUQ7kNvwEzypcP&_nc_oc=AdonoAdDZ0Z0xnleWfyBPEX-0svWfPRk4J0KZGJduky-AqGFpZ2PLhD5i2FHlvQKS-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UQzAdKczDdM2x85QcRQ7KAwTJ4i156HhBflOiLcyiyg&oe=6A033782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6imgf6PWjsQ7kNvwFvRO2W&_nc_oc=Adq09S2heb0yTTJqQTf2IzYupZ_BmNeKn3gUDVogfdfFInwHLZ7DLq-S4cqqhgIODDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rj45eWQZeatDGmLME3FqvNEvimDU3c54SM_5nWe9INg&oe=6A0342E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
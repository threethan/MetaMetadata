ps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOxgTP-QQ1MQ7kNvwEJrfBc&_nc_oc=AdrReiF275eEUAEtyCoKIzbl-0-rJ25PfjDERKAuWs7jO7BfuJHhURSdEsD-6vmrIzQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGMh3WIZise_Waf8ggKClxDdpS9b-RF0H1dObiL2Q2sA&oe=69C7D72D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cmowcEDGv0Q7kNvwGUtfaa&_nc_oc=AdrauLNTa9UORB1YoMoFTf70hZjq3_HSMkA01dg5YaB3jLBWWiQU2Q1pwKL2IctKxM4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOAmONBdjxz1NEtf7NtG4QptHxsqT2xrKG2ygs06pDoQ&oe=69C7BC60"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sS75vv93aoEQ7kNvwEmz6A5&_nc_oc=Ado2zBqVAlapSRwwsZATDQLMiRlzrPVGh6M-c7XuvDpg6e2N9NXWTfBDr7HY_mSWBSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBJwy_4QbK2Z_FzaA6zn4QtA2ee2LXLC4fAsVJ2fbbxQ&oe=69C7DB8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57MSRt2YbsgQ7kNvwHv0QuR&_nc_oc=AdrphefNd1RPHwYKc7CCE07X78OD7MfOcHA3nF0FeT1iLR0tZQOT2nJHPZbFP5Jf_ZA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmUiWXM5cd7aMZQu3pxu0DjHWiShYcoeZJDfcwt6pTQA&oe=69C7E402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBN-5QLxw2IQ7kNvwFQGgen&_nc_oc=AdokuzQFrmm8YSeH6LWoObSMpGYhmIFW2mC33NU1O83d-xXd8jz4n6ASedC3MKlu8eE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzT5w2vFrP1GVj51e8f8z3DLFBYRq0kfpz7qDY9AXznYQ&oe=69C7B724"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
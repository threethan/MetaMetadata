ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CNMMvvFRBQQ7kNvwFm9WXf&_nc_oc=AdqHFCWJbnV37HbFXhlISbORdju53Ri_vp-kFoND7FeG7IsUgc0Ov_P3mzGK7dhKJh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyQOiiwbMdmHztJC8-xauzg3aqvdo0Dluz04l_AXSfiw&oe=6AA2B02D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BRGKzOc8zkQ7kNvwGQwA3p&_nc_oc=AdrdpU1fJaSAtmmXYQnhcf6GM0zIunEWvXUElXVfyDTJ8896-sHtO57nmD97YE_2I3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxb4IJST-b_mAJjpeptGj9pXNYSP_StBlhQd20mAMnkg&oe=6AA2CDA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ml-zMWeyakQ7kNvwF4snat&_nc_oc=AdrDeeGtfhPK2iw-A6SLPvxhymfr3xPkYHNxtt1gp3ICKwB75bf_kGHA1JuMT4QqW6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL73HaB8LtCpbwjEk-6SWBWzbBDHHE6oP5O4UiVM5PR1Q&oe=6AA2B48C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBmaCzh4m9MQ7kNvwFJz-Pr&_nc_oc=Adow252DcP64YtLPgeiC0f3eCtzYv92tbyX4aBjknVaoWdUBacuRxooaUnUFpWRI8DE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA1v1mV17Jot_vhuqWewHLxdPv4WTzGXsSB0zognaFrA&oe=6AA2BD02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdoPjsn2fpIQ7kNvwHGp44C&_nc_oc=AdpdgUIajjaBXYZ17sYueU_GFQQdbtOR8JHcHOAQlqtwYRal1Tk8z-bPn473-CbxX3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW7J_wYUdFDS0ho-0kyKIadbWjfKscaslWHBXDxYS-Hg&oe=6AA2C864"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bLKDt0c1NkQ7kNvwEcB3BE&_nc_oc=AdrIfbhjcGuCDmOOYvlEn16lD_PHQPQexmK9e8THJuXooFFNYp0UPId0qx3VKc5xMZY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOZBjJan-yCMzrluhJGP9-xf3sfjBiiEgP0Y0u-Bjgbw&oe=6ADCB22D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r47jVH1fIMsQ7kNvwG9B9uB&_nc_oc=AdoAAMZ4MpPu4c20W9lboOxYe_Eq3fXB9kInncOGSs2JUF0PVyJWWY5MmZT8d3ewn4U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO-HL0ADShtmel7aVscK37zzq4NLyXrFCjSmq02dMAHQ&oe=6ADCCFA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_UqhohZwsQQ7kNvwGLymml&_nc_oc=Adr1RV7zVbjfvfpOqtKhqSoKdHP8bTDNXbiphA_qhiQuj1dlqq8QUvA4kOFmT7Kjzbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeMoLvju4wOhXOSPrATYmv0yu2jra3sVKdl7FezqodvA&oe=6ADCB68C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rxu16_7zC4Q7kNvwEi4kC7&_nc_oc=AdrAqoukCDT94JW6XDGOTp4HB4TW4C1rAJnvWgrIrbEE5pkRxrMWp-SxhLIm06lcP8E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeAkM7kF1p7OP38wp6hQq_f339ooblpKc_djYTkfdfJQ&oe=6ADCBF02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yglwoj-hEkUQ7kNvwHwJ_Wg&_nc_oc=Adr6jQ-S1UzS-XxWUIDfZPIa2VoLPe7hJF7zcAd-kHtCnLRHoNGExRHJd0Hah3mMMeA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8jLitSxKCUG58MkOlMpipJxGy8sQjfGPWpm8VITidoQ&oe=6ADCCA64"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
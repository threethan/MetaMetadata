ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsaNYgN_yWsQ7kNvwGMTj_p&_nc_oc=AdpCwQd8tdUz14ctSWW3WA-ZkaMzB9erDDi3i7fjMwpitg_a8h1D7Y8eE5c5ZcO4o1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeATADjedGzDgAE2Js3iEE-Y424o-Vgk6gwo_rYXABHQ&oe=6AB7C82D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvTc0shcMegQ7kNvwHf9zPP&_nc_oc=AdrvOiloEkUUcgpDKrKRDy8A3eXn8Rx8boBdEC6avBLYLO6JSmPA_CtT3PUh3JaYhxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjvll-q0yVlrslwsZddEi_2WVPyi6Jepee5opUrXkxPw&oe=6AB7E5A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQDZ-5I8aXwQ7kNvwHKWkZV&_nc_oc=AdpDyZk_KcoM0ndaireRHuYdP8OhmesaTHj6pwmgrTytpfJyWRs2RpCiSSeQOt3Zn-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9pvswiDozAPKs-ltHr0M6IrgmwWzKv8D7hCtYHnt1lg&oe=6AB7CC8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOXG7bajh5kQ7kNvwFAIU7_&_nc_oc=AdoyCs3B_RXt8CvrT6mQ588cn44k7H4cJkec6VZ0X5V9ZRlZAgbEwGWECh6UIR6MI8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8OuojzUY6YgjdvCNm-Ph5lH3cNSjCc7F2wybalCnnWw&oe=6AB7D502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGy8RnwKb3cQ7kNvwGS2FyF&_nc_oc=Adq9cSOiM32-NtpllU-Ld4Gp4JAYtpxEOzBej2bR3RygtYoN4r3W5qoxBbk-WqIPHYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB3KrDX7dVz5iyC_P5qt3vx2yVjJkv9elXLrtikCBU5g&oe=6AB7E064"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
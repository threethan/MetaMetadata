ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sejM9LK7gU8Q7kNvwH6aIQp&_nc_oc=AdqCVlfGYW3jJhG7q7puHr-7qcPj_7j03GUXnu6BJUzPLGEErJrSvDuSt_Uhj4sQgIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIq5qYLJayJul6Pm6r3KsZ0Asv084SzVQ4TZbDqeylUw&oe=6A5244AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZln7Ytg_JoQ7kNvwFxgmGv&_nc_oc=AdrbCySG4YmxgUUYPhm6X0IUo9oXB14QyRRcjMqaTYoQXiG4ZpEdGcxaRedAFVZwbnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvrYq5_gPOOKuRHI_QBMCOZt56tm2tR0uBQoYdnxVehA&oe=6A526220"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM8V7mivpmkQ7kNvwEVH0dM&_nc_oc=AdrFPWl2hEmnPUiK817IvlfBdxdQg6v84reFAIP664vqD-yVRnjyjET7a7zmdrg7ncg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg4k32uZx3ad1YPv2GL43nJdcQ-jGadeRJi3eiVFKnSw&oe=6A52490C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8AgPMue_pIQ7kNvwH39Yeu&_nc_oc=AdpCqlg2-gibVCePytdcks4l3d2HljTCzGLyz9r1w0w5Qj4bbQgvJTw_5kY5YccGdVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTo9vjDoA-De8AwCsFYg2epztwo7Ob53YcVVw8aE90fA&oe=6A525182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqH9TGDL7gIQ7kNvwHUX3R2&_nc_oc=AdqUkiuYEa6UCqhT1Mombqpm12X6E81tsNz33Ve7M0DW4heTszMaIJEafwfFWTCvBzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASRyTZ6YO4xcWaUB7wlDD4Xyw9mYIPxTqiCNRwjgubdA&oe=6A525CE4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaFuoJvlIRIQ7kNvwE7k807&_nc_oc=Adpa4sCpXqWtIVcbEv20fe0q5HExGCc1xbJuxiwkrwI4XEye-iFXL5iijBZEXcNfHQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2GV-9riQhT0pemGi6K5Ah-Sld44dJvz3bjIJWNZl07w&oe=6ACD186D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BczarUqR-oEQ7kNvwFaeLa-&_nc_oc=Adqecb_3CIZGMYKsQXdqwmBHHGWMQ6PSFPUhvRQQC04lZ3KA_xzHRlQlfEH_FMrqk9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcMieH_YOERgh2Ad5UNwPGzqiv6I0-HxMJegNPzxsT-g&oe=6ACCFDA0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k7x19QB1LEQ7kNvwE6wCcm&_nc_oc=AdohfX2ip_pyyovC8kNHMSeQRqjNnxESVu2vftVtBMraSstSlithWb7N6emWLyclxp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKvQPYqy5au0tDXObtHzYOzaKo3pR7mXYHFtiRIQRMHg&oe=6ACCE48C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03pH7hY-qEcQ7kNvwEXHWQc&_nc_oc=AdoFMn47LhRSkvHihzfU4r1dpBKZy5OEbaRnCpuC4eDVh2Y6LyKi3AiNOfXN8m5AICM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1H4lsEcp6C2q9fTvly69RvHX6OiIgVE_fzTH1yZ7pgw&oe=6ACCED02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQsQ_P3EFLQQ7kNvwEz4ntM&_nc_oc=AdomKH3kJuaFFZEnaYS-NK_Z4CvkqIMpwMdc15OsO5Hj_wL1AzJSHoSakXeUnBQtmpQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQMo7sTxX9NbQ5wG5dYR4DePLrcQAK23eeSiUV5fo3vQ&oe=6ACCF864"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
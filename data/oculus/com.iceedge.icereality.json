ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_1tXcMZ9zwQ7kNvwHpKWWG&_nc_oc=Adpeg7t8TqRKOttkVXJCBermzQEkZKKHq-wAQvtxx7A3mVOY-CBWKoUTkMnVlMwFg5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97SdbWCA0hi1jVJBz0icsz4AezRcjtv1MfruWf32GJYQ&oe=6A2EAC2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD59m4P1Ci4Q7kNvwFdz-uA&_nc_oc=AdrSqfT-GYxogfl9ulZLARgHI_5OF-5S4XnkqnJHVpxg_nv207NOeZpyOg_wWFmgsKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wzxQCOhUS4vpwOb7jx0U3n2hBL3o9dez2s9yy2j2qqA&oe=6A2EC9A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1F6WxATmLNQQ7kNvwEGfAJA&_nc_oc=Adpe2FKDRB-ugnDeoMZLkewuNDSxQR6TTGJDdEZfg_Y14zn_DYQfODpoppDCkfWaWlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6jnMsc7SHtCzlfsdgxhlO8l3Fyzc6zAJ8WUAs5C85eg&oe=6A2EB08C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5iMXv0vcWUkQ7kNvwFikFcK&_nc_oc=Adpsg4j6B1PIFZJIECO_lZ0cgIjJK7Cj-_ASr1t362tjbbyAfJtGrQ6qd56umyMVGPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91GTQR5EjvVs3fx4eXAaSgj0vrCV86nl8TINOtuliL-A&oe=6A2EB902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKhA4nO9Zc8Q7kNvwELgMWw&_nc_oc=Ado6Jo6bcXI63C4BnDDjhySR4CovyjM3aLd7v2YZ_baIkWRaooGjW99ZBn7AL-K7zvI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w1L_sgYpTjNHpPW20enGuUyJGFQUIMBzNuDPM3_Xgdg&oe=6A2EC464"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBW1JR1-vTMQ7kNvwFIkEZY&_nc_oc=AdpOtZqvKNUVQQF29iEsatXrSwM0hGQ8WPqM-iNS6A6rukxUTCguZRbjy3fQpPg3ir4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00fpgYdr7yd-_IIZfsyvX9QnLCh_yeACdyQcEOx-vNwg&oe=69D5062D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56aXZ5hv_V8Q7kNvwEhH0JV&_nc_oc=AdqnCfkDVG58zen8iA3v_UQAJQdHt8i7ZAUdsGzCtv4cx4IdkhzxkiVm4bRgkL9pBXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06s6fR4hDPZRpT1XESGWYsuDus4G7KlW3s79ZAuPqv3A&oe=69D4EB60"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2AZvfI2oNkQ7kNvwFLM1Hg&_nc_oc=Ado7ab7oducDVuj794Bu0jnV7B03ox51GSV3F25QF9XlilAeYJi_Dyb8WK_YKimCv58&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FbUtCpIW7UEYD-hI4Ylcza3QDYuSjmLAB2euBkuVmBg&oe=69D50A8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyZl1IECS6IQ7kNvwHw2tC_&_nc_oc=AdrdrZuVPVKRR5WmVu1vzUPqBoNMeK30FKCzi3ph0Nbs4iy4hwk2eu_8z1hjlyOCHMo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27ocTXi1iQPx6UvUL364DqjVrVJBdh8_QB4gA-vmZO0g&oe=69D51302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB5JCJWxwqwQ7kNvwHRMkM4&_nc_oc=Adr6Dna-fk9G6heznyM0hgQIpEHzozUM5WX-6GgmnDKs8p_VpNY5F1JbrXb2yJpRJeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qu9NhQ4VVZxo8FUkrHujm31MEmr5MeUR17cjlci5bcg&oe=69D4E624"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
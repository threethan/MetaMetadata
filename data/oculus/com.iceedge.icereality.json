ps://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUXiK3gmPgMQ7kNvwEl9zBR&_nc_oc=Adp-mBLNiMP9KCbwatAW-ivDAjN2Hcp9fzkVOl9Q4WbajloVZJ9SRnjOyewAd1X_VuQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xfBXEdLa6cjTOWWmk-dVui71gZndXd49we-_KTxPmrA&oe=69EB6FAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VdaMfTbm1IQ7kNvwF8eWUS&_nc_oc=AdqemUaNQGwyarPVJfXre9bZCCqwh2TDeKckU61l3qY606cDSkxK3ZQh1Kjm7b4YzCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DQPOYs87zCiJcn-uIw2EXKm_fUo1SbPCwhrTpgcd0nA&oe=69EB54E0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMvWwvHMCk4Q7kNvwGTDYtM&_nc_oc=AdpGyu3wWIAYkOa7exwBYKbK2Mvoh-Yy5GfJpGFIDHed66ythhwdRnOwyLVH5BFRtbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eJBRmJIkA4VMyadIbgHIwRIL-SFAt1w78E8edkkEd0A&oe=69EB740C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlLca0gwetcQ7kNvwFfXPKe&_nc_oc=AdpTC2F9Zrda-WHWkPfCkd9zeyhxPJyLCXREy-FrRwZenAEiSaaviB2RxsQMjSA6SsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08yc5Crc8FfggC5OI_2R_hwm8g16HCL2VKsWHaTiae5A&oe=69EB7C82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87vi7NgQMHgQ7kNvwHVexfO&_nc_oc=Adru7inkzukAKZy0vCB1fgoZx6ZHDc3WmuPwkOfQkiVD86ic9uiHOOElkB30rga-awU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dr2PlsZyhRA38ZIV6XkDL93K0pK7hG1AGUPGre90xPQ&oe=69EB87E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
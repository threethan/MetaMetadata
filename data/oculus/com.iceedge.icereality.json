ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OJ5cKuAq3UQ7kNvwGNloyf&_nc_oc=AdqNE0ZxVZ2YsPp-_yvDG5Y9zInXdF_VhCvDWD2sJ3Wbfi6A1I2dw3psDvG0dbxdsmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAhVEVjgM2bAxvdwfxXjO7GUNIDSKezbKlGe7M3Tf9mA&oe=6A748BAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_FpovIxrYQ7kNvwGr-OQe&_nc_oc=Adrax676gAoUAWndVk0XxxeU-rrtGxkRd0P7XiopcfT30c4s8sZB91F_pRggna9LZ4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWLkfqfvzNbejeuH4FEhQsT5ErxRWN2ys-PAYZR3v9rQ&oe=6A74A920"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF8s0Jpf1PUQ7kNvwGZ_6va&_nc_oc=Adrr_tretz0P8fye6-31QEJbsJUJGBTFGyVHgKv_x8WLv2G4uM4a-0-cnahVj1J8PEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERjyUvktUQxgRDJE4grStVIKimfFnCvgoNxw2E64yGRA&oe=6A74900C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2U5x4Ayd0AQ7kNvwHtrz5f&_nc_oc=Adr7Ke63ZY4hBWzs9zUUp3hrTa404FxXHEl3YmWALGb1-JMOUltXUBnyi5Tiz3QWbCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEY2yW7T0cCtYddF9EFTu9sS6Q9y16iiHPl7ntpCBEMzQ&oe=6A749882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFOW9xBS7KsQ7kNvwG_XQpc&_nc_oc=AdrM9zINiUkwlaSUo0AfYJUrWGWwFx8UoTb9hSnqlSHY3lsC8CrI4G_Sq-1R4imDe34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTXUbLWGjDNqo2SN4558TIVWBTuLj-c4V1KGybBRi97Q&oe=6A74A3E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
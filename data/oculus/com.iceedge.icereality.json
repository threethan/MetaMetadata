ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6z74iyD1fwQ7kNvwGkrUz0&_nc_oc=Adouad1NccIf3tk3Ja1A-nGW7X1cbEsQGXHLBMVSQt0NmVz50LbxvCl5NL1zECzMHZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeY8XeysecMUn0vMxFSCTm7MNrdp3Mu0cPaQJz_HreqA&oe=6A5E222D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3prjX2H4vU8Q7kNvwGNY23d&_nc_oc=Ado9lXEqExBcXTce0xmK-BV7AmE9DpM90w7vhC_fvDrUZ59WLex1c4e1Inh1ioahgsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABj5lklw8gWUv2iaSs5N501GrJQpayTulSyKXthn_kwQ&oe=6A5E0760"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHKCKixQoV8Q7kNvwH02rmi&_nc_oc=Adqu99W3o-b1v5vQuH92kpouqmv88B8xL6DXExXt39Pu6OpNgrDK3Ogal5ZeMloINEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZTQPCuinyngGO-vIpqqBVFvotw4ZQ077xyQou8OoxYA&oe=6A5E268C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZrCPxD_rWsQ7kNvwGlPOfC&_nc_oc=Adosi_FOcDRlKVyVvXrrHNuAP-paCra9nYBLU3TRS38L8MkoYh0vG-TUYgKKmjYo1g8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLUH-RF6r_LBas5eBANf0BdvY2EL9YrZGOjtFSLzLeow&oe=6A5E2F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnoxZcahJJsQ7kNvwHezkP1&_nc_oc=Ado6kXmkc4OM1OYqR_bvdCG24amJJYnwSq3jsclJucm_ZEfYbPDPW3aKvpc1cIgRClQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrS2yEcWt7y0wG3gw6gFXdn1DGJRnzO1N5tUIUaz6L8A&oe=6A5E0224"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPzv0AcMKJUQ7kNvwGVPC3H&_nc_oc=Adoc_kfCXqhrQhkKeKNgyfoVftXc0cyev5mb9iAzzSWavskBv_zzbQMCIBTsnZhLzDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_0y0oruiKA4XlapRXzhAh5ecGl-uZUaBcTW-ffjhQ3w&oe=6AC102AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93DLWSajER8Q7kNvwGtbJu8&_nc_oc=AdpPk6cbhTbS5GSFbmXTxN9oDDVABkds9PrVbYRQi9VW9mr7qJGKySacTuocWoFEVxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDQDplfrtJshiSkogh1L_drgSYfrDS-af58AHZnlFlsA&oe=6AC12020"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byq8sGJ3eEwQ7kNvwEPT8dG&_nc_oc=AdoGlzkb1i_FX-aveYTi2UYSRB2mMWk2wJ97uBatZucn5wqYQ-7SkSZqgX1jBHbWjp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGt7IWfJpdWO1k0Ia7EQTVUGhoraPRcKhaZJuaxQQ0Rg&oe=6AC1070C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yj2JFbs90MQ7kNvwG4KIZN&_nc_oc=AdrvdU-Oy9q4ZRbw69FokHD3Wtmozka__9pByi5hkq3koeeDQiuJ1Vl-RlHeqihrjhc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW0Kz9n1vga2O6rn0SOfigjFWiF3CG8SetG9P51fY3cA&oe=6AC10F82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgkNP2cW8HQQ7kNvwGIPH2J&_nc_oc=AdosftO0OV6w2IK41-EZ2rhKf0DzXH1SKFgfRjNnT0JVy0yuh16IWIINI8fx8g-y0Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Fo68Lg7-pwVl0P0CcTDjW_U6_18FKzS5iZbVV6vEDQ&oe=6AC11AE4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvXsuqwRTn4Q7kNvwF90gQQ&_nc_oc=AdqNqfbHsh1CWRphvBmz-Wil-GvsNyxS-dZEFLFnYMUqGRCb2Cdjt0-0T055mqxC-IE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aEycW3_yBJFcmykIn9tXEMpPiqz_U73Vvph-fc0O2AA&oe=69F4AA2D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCry0Dd5YgMQ7kNvwFnbvQm&_nc_oc=AdrBWXG_Odw03oECya4sILb2izs9y0CjnmqVMgJnGK2rWM_-JmAug7eYOqi3_q14Efc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08_cvIvWekebKkrGxXFINNIiqLFaa5xiO-kJ9w1HsZPQ&oe=69F4C7A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGv4aGiIUf8Q7kNvwFCryEa&_nc_oc=AdpXefUqbR-ECyo0ck8t3YVjJ6K6KE2uhYOB9vee2BqSGJrSLYt5hlR87O6EJiR670Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Mwtcseg_g91qqfP_K4-fzBeXyVQTUgXb8ck0_A813vg&oe=69F4AE8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSc8nporPCcQ7kNvwFBe7CN&_nc_oc=Adr3nDD5gN-QFeoBNsf_KT_Uw67GoKKaXdnnJx3bpTQChqGdhEV_AfsgV7fh4TKbvfU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yZbXJznydRoSIm724OfpUHST_8gTldH_SmtLXXhbSRg&oe=69F4B702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7tOCHDGn_sQ7kNvwH7daze&_nc_oc=AdqLqJexztFG0S89kPr9kZS45q5oa5D7jGj8cxxSOZizswfpgcJAXLbaL0cpegCPK6k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DsXIcEdhenxvJfOyBfbgJVi5RkBACsxlPYbLmLbJ0Xw&oe=69F4C264"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
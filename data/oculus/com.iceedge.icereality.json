ps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8DEcT231ekQ7kNvwFo-tzC&_nc_oc=Ado-CgVsIDcxf2mnlDxPPhoqhzh2PdskUpADQNS8F-kU7kcpWEWT_CdqRCj3VFUXpSg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBG6VcBbcPh8hxi66xQvAxL93fGSBy6pRePM3VWUnM0Qg&oe=6A56392D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RnMwtXWm1oQ7kNvwG_d4H4&_nc_oc=Adr8UbsTClTLDBdfEsK4Jr6ZHOEZBpAyg7O0Gky9ze2ps8_WGlG74Z3aqHuk_hjECjk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8X0NkFIp4seh8sA-tzpg5uX3cDDzCjXSuALcRyPENvg&oe=6A5656A0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RR4ZJ64tvX8Q7kNvwGOEVjW&_nc_oc=AdpzUCdEhzLQCgxyYxk-AiKYaCra6nQSezgMeVVyTtqELLLFJ59LUYG99fymMHHe9lM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwg1ENWYc6K25geb7pDgFAFV0TgSnGQ0ygxu2xqoUBrA&oe=6A563D8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEd97HC7D78Q7kNvwHL3-Pb&_nc_oc=AdpVcdBAUDCxOqfiF2yREtbNVvLzz5flcMiRun4hIVQdARrTltlmSSdB6gTjl5N8WPc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmTsom-PkqzoAZ4IH9U_Q-hkUoA1Z-DViSby7ul3uJzQ&oe=6A564602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jVYGBBMXSIQ7kNvwHs1h5-&_nc_oc=AdorL86u898fcnjba1QERNYwqUWGji-Xxs1ZK-fsyLpvwp2O_fnnfEweo68o9PqebNM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuMoDdBsgp5WIs74rQxKq6IEfljtD94E9g1pB2fZQjEQ&oe=6A565164"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
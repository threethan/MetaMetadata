ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJGgaZsUqoMQ7kNvwGV6bJg&_nc_oc=AdqEmQFB-VuR6i0mdewouA7h2heU3UU6RFV1eNSz0cnJtB7pAafbxdW1WylZuygBNjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B3pG3H-Z8aDfR6ETdxQdy0X9TC20i5wO01Pr4KXoPZA&oe=69E4D82D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYfjYPgaQu0Q7kNvwGL-6jM&_nc_oc=Ado9v3iAg-_q_j_W376L3b4tZGBTMrB-3qj3A_8R1qELwNAoUbBnW3hMToT5IaYO6K8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wXlUa_mN_64HqkosKWgPrODNiSIz-p7fZfH0MefIS4A&oe=69E4BD60"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMA9UPGjXJYQ7kNvwFTVZtu&_nc_oc=AdrAUFYm0aDs40KQ_jS563gEx64klOyoW2uS92mAyjLPDzPaXa6sXsV4qRhmlTidnXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ai63qWGzIRXK1em7DsjdoRMXOLdTfS6MnG0a3d1Ul5g&oe=69E4DC8C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcasWrQbKVIQ7kNvwG7aX5d&_nc_oc=AdokzUXGJIIYgAEfR61oG5qvqX3uxSo5a7XulC3jlMMaPRdt9RfBHfQd4XdJdwUjN64&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00uH8bDEvRq-UXxdfdHD-gGZCB8BJ3bC-rRJX0OUbrXQ&oe=69E4E502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQjhHnxK9eIQ7kNvwEF0nGU&_nc_oc=AdrWhcp4N8S6RyfEUQ9F7SvOqtqkTIVaQRvIho7uHnGLjCrkP7Givzk-vqY1yfAANf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W7cPdTNMXP9xNmlV7ROvKfC6heVkZ2ZWzdNMHE-LNSg&oe=69E4B824"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
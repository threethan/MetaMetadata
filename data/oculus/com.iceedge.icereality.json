ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUVj74ubOmUQ7kNvwGh-SXq&_nc_oc=Adq1iwKMotg5PhEnjAmk2q_MbChol4E5lP0YhPJF1baWBGxqSUpWLsIGMqSWb_Q1JCw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqBW2ZgPxRkyUsB-WGTsY65z9P7Dk01HPf_DkRySGEqw&oe=6A7B232D"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4aa6CmZtEwQ7kNvwFkmEVT&_nc_oc=Ado3mwnXQx2TeLQ9VoaxEAyB31E23j3GLKZVSMiwOM24IgN5nTO4fT_2e5C9H6Dw9qQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdtBabuVpafc5hB2NxHjWXUl09Ny3YPlHPOsHKhBY1uA&oe=6A7B0860"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpBKqteeNYkQ7kNvwGZCizY&_nc_oc=AdpN0EWPQR9Ptmbu5tIpcOVSHQTyXldmUgUzYTu4s1QOMZjSkzFTszbZGV6OB2_wT-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-RwuP1ULUHbThFbmT6SJeyRnK0vh9wMp3ypisvpZGtA&oe=6A7B278C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yB-7zqvssLUQ7kNvwHSHAZI&_nc_oc=Adq8_1ArMiQhyMH1_OiTqbaTQEcauzZOrzmA9DP3c4xKiJtG8jDweJTznAuAaMll98o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxGXaCw2GfiIJqDYhNIL0IFktfFPX_m75JQWB1yvtXPg&oe=6A7B3002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-RamQcoOfAQ7kNvwHPI0PA&_nc_oc=AdpI2QKwaB2kXLrwDKc-jcgfPXXk9Uvnyh2vLhDv5eS-ebv0FpowopsSCoErVhHYMaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKEMYHk-FgNaB3Nh5SkDtMj-_90858ptrtKzIa6pRYHg&oe=6A7B0324"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
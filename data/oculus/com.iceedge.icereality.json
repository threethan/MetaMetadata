ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyHsLd0VviwQ7kNvwEmdLRz&_nc_oc=AdrVuw4znyrwojYCSOUS5VloWSfnoCMl-HbgV-L7zn_qBiAsQWzlLame-R2D4JbTWW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hdCPhyKcm19fwhdsMFcMsQP_JPn2jO4E4Lvq0TbnzRA&oe=6A202BAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RITO7GomFj8Q7kNvwGoSwLC&_nc_oc=AdpeSON9gxk7_0eF6rTjmjCy-aKMcjB297EvoQ9-cYXNmkW0v3NOXoJTOCWGlpajQco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ptR33zVbfI1YcxUa0pwpbVJJHGsb6Sar3ap5AOlrxA&oe=6A204920"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jjg1WKcuFUQ7kNvwEO-4l7&_nc_oc=Adp4K50xd8n6spUJ8L1auhyx6K9TMZ2KWxLH4g3GAnUFPOY5QNbthW0FTz38gyu2Ryg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af442u8mzMrLSU9fy0jjv31f66ZdPSM1EgHT97Z3B3V0rg&oe=6A20300C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41apgivcDlAQ7kNvwEVRWxq&_nc_oc=Adoh6LRKBIf957YCt0fDHOn3r6GAjrYBpmIexmkL6SRuuPLcO_UxYD86gAyvwotPjqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EF1i2YP3RncrwpMvGIYJKtIKf9cXBmnt0dx0RgjfoVg&oe=6A203882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jHY-6UsYb4Q7kNvwGe1fng&_nc_oc=Ado9dNlh3sBB4KwCnMrlcgEvGT1Xpz7O3a6Ffl-oJ4fdz1DBdYTE5ffo21Tr8Eh9UzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zvqfbVjI0RnWBtiSg0A9_PgSM7srAaCQnwANVUWt1Fg&oe=6A2043E4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
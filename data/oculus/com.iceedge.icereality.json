ps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OJ5cKuAq3UQ7kNvwFCCIXJ&_nc_oc=Adon6nXUo8vGKeDUU4lquyYw6V39edDQvjkzkwQM1WuCHEdqIfCRgnZlo_Jy_HH_xkI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc57PO4N7M0xqOY2JnsF7ZqLQKEYVul_U1_m26ChTrwA&oe=6A772EAD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oL1xuP_hQkAQ7kNvwFdKrCU&_nc_oc=AdoOHOsnVBJPE9BpwiXqE5bYFE4RjDYbdzAKX5SdowcG8AmSRbDK3CEpKJFTo2geGaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1cMulQhjP01sq-hC2OwW_SJ6Fh9g-q3IyDrYe34tpJQ&oe=6A7713E0"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mL53Ryb04loQ7kNvwHztiXu&_nc_oc=Adr9MXpzGA2YSOdZUTydDzzta-wH7pwCfOm5FxSOBcWrGE00k1sYFcQg4IIct-uNa5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkbyD8aV-63x9WxO_Ida3ePK2VCh4mvbHbagqO7Rdpkw&oe=6A77330C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKDq6JXDvJoQ7kNvwHQwcv4&_nc_oc=Adqr-YqthCGIj6f01_xf249iXyHAopKKWEFjI-NMm4284-2lblxzJ43Io4RzLpciwOU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZefvxtYt5Jt76jXG2CCNpPHs5tXqZyAM5ODVzOXO6Ag&oe=6A773B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nJxidLhclgQ7kNvwFM-Ir2&_nc_oc=Adp2qulhxaEZA--BN6ebekTSmXrfv-5KNRkX0SSDW7wKFmipQkbh-IxC2uy-1WG7VNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGld4Oly_DKuJqDSe6FyxPIxdJXXyEOy8oKlufEgQU7zA&oe=6A770EA4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
ps://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974506_714482473118365_5961164861266742877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyMEhJNQS-4Q7kNvwHn1RDT&_nc_oc=AdqJBn2BGAcuFhLzCB83GLjMmHLQh7esSLNdx1y7xVIgo9NEmODdtcjRBdEK6SX9BTg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ox90UZKIpYTmt0zQNiuIyro_xBl8aH0Yhgu5zkdQcww&oe=6A1AE5AD"}, {"file_name": "oculus-icereality-screenshot-4.png", "id": "705265344077844", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974493_705265347411177_221677001366983630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOScFuoscMsQ7kNvwH8R0Aj&_nc_oc=Adr7GSmlt-jSf-xSvMqf6DQSa1QWQhQuMm5GS3DeSDC7A4ffffjlXRXyNFDaB3P2dog&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oQxYRrxcecsq-45xmnZtNrYtzEctLSNusSMhwhiuMVw&oe=6A1B0320"}, {"file_name": "oculus-icereality-screenshot-5.png", "id": "761127835070795", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001698_761127838404128_6858205614999401876_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndzuXkvgPM4Q7kNvwEf-HwJ&_nc_oc=AdoyeTHVBCJC-L6mjFxfxX614QF-fOzq-rPkJg4g1_Ufjpsi5flEn63_ONhuHtzrQKw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64-9kiujS19jIRPzg7RZ66Dfp_ymgBm3BbY-G0ingvAA&oe=6A1AEA0C"}, {"file_name": "oculus-icereality-screenshot-6.png", "id": "311453824519627", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974472_311453827852960_44226490093506883_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJigeLmpTi8Q7kNvwEW710S&_nc_oc=AdrpTfY4aolB1pCcxy9goIS3H_IKV4JX02uptU_bc_I0a_C7hDKS8A3ogou13WUui-Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67gppztrwX4P5zXvUFgWs3NEQbf-IyON9fl0kO90OjqQ&oe=6A1AF282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-icereality-cover-landscape.png", "id": "427106799269362", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001698_427106805936028_1476768101843271675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcYiQQRXuuMQ7kNvwF0KZY2&_nc_oc=AdolacWAJVvj3kyRA3_1IHSr5NTsBPZmEDyr6RhYfUJCNVKstzoDpZHMYyaIictWNeY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fdtaCJ9bHXGW9-p4anTfAcLbQBwif1dD6KSoWAPFm0Q&oe=6A1AFDE4"}, "display_name": "ICEreality Connect", "keywords": [], "long_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device.\n\nShare your thoughts and ideas for your 3D designed space as you and your associates walk through it together in a unique experience that will let you see and hear each other while you explore the file.\n\nWhether one person works as the host or everyone is free to roam as needed, ICEreality Connect can help participants move about the whole space and experience all parts of your 3D design.  \n\nOpen doors and interact with objects, measure distances, and talk in real time with other participants about your space. Use AR mode to see how your layout fits in a real world environment.  Use Scale Model to get a bird's eye perspective of your entire layout at once.", "short_description": "Explore a virtual 3D design with your friends and colleagues from your Meta Oculus device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ice-edge.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ice Edge Business Solutions LTD", "support_website_url": "https://www.ice-edge.com/contact-us", "website_url": "https://www.ice-edge.com/icereality", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
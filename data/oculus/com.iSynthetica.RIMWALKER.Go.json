-BDoBZg9RAsKCWq1dH1ElL0GpMO4uFyL8b6u02gQ&oe=69BFCCD3"}, {"file_name": "migrated_image.png", "id": "292306481735238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572918_734049700431775_637191151782199296_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5rfFt1fKNwQ7kNvwHI7tjU&_nc_oc=AdnIaMUmyenMZwtih-PJfxxcuhM650zesvsHuxQ8Un75cbYq6owfmh2LX-9wvPuy-cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy26-2Tp7gvPuUFjyiG5luQKTgRodDWLLh1TE9aw65SUA&oe=69C00220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/tBQG4r", "id": "2527145410738347", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982508_2527145414071680_5289827037677092864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVBBs_asxYoQ7kNvwFmZbYD&_nc_oc=Adl9K4LjdsDoD386mxTYXwPAqRwly0uDixwmZro40XXk5CiyzVp10varE-TT8hc0Gzc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhsTbu39iixl_jg8uN0_vAjA93Neu7ybZl5dBdptXD2A&oe=69BFE38A"}, "display_name": "RIMWALKER", "keywords": ["Action", "Shooter", "Intense"], "long_description": "Ride the rim of a spherical arena in this fast paced third-person shooter. Use your skimmer to protect the sphere's rim from the ball and destroy and defeat everything else with your weapons to proceed to the next level.\n\n30 episodes of mayhem split between three seasons: RUNE, DEAD SPACE, and FROST.\n\nEquip yourself with Gunner, Blaster, Launcher power-ups and more.\n\nDestroy Runestones, Debris, Gels, and Crystals.\n\nBattle Spiders, Gas-Tank Murphy's, Golems, Medusae, and more.\n\nCheckpoint-based game: Complete a level to proceed to the next.\n\nSupports Microsoft Xbox One S/X Controller.", "short_description": "Ride the rim of a spherical arena in this fast paced third-person shooter. Use your skimmer to protect the sphere's rim from the ball and destroy and defeat everything else with your weapons to proceed to the next level."}]}, "developer_name": "iSynthetica, LLC", "developer_privacy_policy_url": "https
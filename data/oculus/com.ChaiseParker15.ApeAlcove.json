cdn.com&_nc_ss=7a30f&oh=00_Afw9EuNgXDv5z9-jiQYSpc2mx11FQGnBqbUnr2JlWkHtzQ&oe=69D1210E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T52WvD7YpDgQ7kNvwEOX3Ay&_nc_oc=AdqCPIuUXddNiD5JTamzS7GqOHlYWfdVhP6KBEtVaHVi4KAfFg2AsDA_au2AYrdOvX0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3D0-VvSTU7Q5fm7E0hfPwDuVIBo3UGjpPyfaMZbafzw&oe=69D11955"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsu61ecoeT8Q7kNvwEB5SJ6&_nc_oc=AdovJqnlcFLDGFMz9AtAp3EXPTixyySiWonanUYu-V8wzP--5qIz0t7LuqzkJzFM844&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7Q7SSshHC1v4UaVpqvNE1dk3u4zkfplrNRU2qTHLKqg&oe=69D11733"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
cdn.com&_nc_ss=7f20f&oh=00_Af4nW_E_HzEoEH9qKPewnF0e23s0UEyR0UyipByu0EJqTQ&oe=6A17008E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=083BnhXEvrwQ7kNvwFNAfGC&_nc_oc=AdqeVnabCDaj5RRqf4A4VYP7Ryn3LwsFi0HBp5kpX5i9owIHLcziNjaIhUZUTgs2ckc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yZpzJh9vgRrHOwNeAVR66uLny_4KszIhgID6nx4RXAw&oe=6A16F8D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSFs1RR_I4MQ7kNvwFz6jW6&_nc_oc=AdpsSo-0KJ5-1SqkhjHUwj4U6DkFLJnQP5dctzSMJUSBkbjbfTAWC_rgN1hyp9IlIzA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4arjtna8m9QvIC_j6_jYLbOer-deZCkmow9FxxiZK5Jw&oe=6A16F6B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
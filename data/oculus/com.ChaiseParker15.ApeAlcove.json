cdn.com&_nc_ss=7f20f&oh=00_AQKdmpUKpvJb8ns3uo0zn9AP0KFelPrSbPd0aC7y4eQNYQ&oe=6AA8058E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C80OHczdwVEQ7kNvwGLNbDi&_nc_oc=Adp2mnTKPuwzfkmPLlkmGdeqX2P3O3kZNwJxwROkjmiqghOAjYv9IKLaqrt536TCHMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyVkTH9ADM3XkCAfZ0j8lI777e6ZNlNQREXjKbACKiTw&oe=6AA7FDD5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33GwE7TjYt0Q7kNvwGhHLAw&_nc_oc=AdpgtFpWrToj3ZqCzGR3oiTKA7WFkhEvLAZrLhzXWg66KNBHRaDVEtMLbGqLD_Su2wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKJIlB8kZeEApVnGdFA3Ttbb-tK3b5_DGw-TuMtA4HmQ&oe=6AA7FBB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
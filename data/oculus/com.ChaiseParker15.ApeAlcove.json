cdn.com&_nc_ss=7f20f&oh=00_AQInmbmbl_NWmajL0g82co7hrIHAqxYztsapsVKJJcxAlA&oe=6AA16E0E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TN7l_woHdMMQ7kNvwHPvb__&_nc_oc=AdryFIw9xbWCRip35ufZ-lFf8yxcMqeUM2OKIpPvbMWJU4-IeKVDPzWuxv3wpTVSbKg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRLj5JWtHgkAnmiahqcBardSqPwPgryGUX9YOLLeCVtQ&oe=6AA16655"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gx4jdZWfC-oQ7kNvwFSFRQ7&_nc_oc=Adqbxgb5Ck1LGZoAipAw7Bju4_h9qCabNSCg0ChHOG0l_Mj2IpxfV43RcZZc9i3TAPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmTKQblYr1YRbP-NuuZ5olMDOhM9XhC01325SG7S-Skw&oe=6AA16433"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
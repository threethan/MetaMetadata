cdn.com&_nc_ss=7f20f&oh=00_AQGhOru4ltZ_oY00DADqYS65_adbUzqonSjqQPdoz65JLw&oe=6A8191CE"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkbYcOEXGRgQ7kNvwFBtphL&_nc_oc=Ado-e86Z07_kWdkYZ7EpdRci-KdqW6TtLfTmN-1ysaBTVjvI1eeO_ZeNDXah5xYBpQE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExQ2Ocj3zq4WG8na6qd41Hqt3FrpJ967npJ7cKM_Y3fg&oe=6A81C255"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adLBDyWoTy4Q7kNvwGLLuT8&_nc_oc=AdpZZyJUJzgLqLhN7aVscC49q2d5UuuuAhimzTdkOXuWLdqO5V4jyT9m6pJd8tJrk1A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXZt_QZ-wklVl6FelJfgG0wVD5APBqu5ZA7nm9nG8csw&oe=6A81C033"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
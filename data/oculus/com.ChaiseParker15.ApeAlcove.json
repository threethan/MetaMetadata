cdn.com&_nc_ss=7f20f&oh=00_Af467OJcoJJB53VkxSuZ6zEQtAuHrVrV6VMsQKGyMCsiZw&oe=6A1D980E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hgt8OGdc5lEQ7kNvwGzbwbD&_nc_oc=Adr82Ik3OSb7VyjqITycSKkQjWQZ__rsab8a3AZI6J4uJSeUlHcenJ7zsTHi-KbygqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SqBDfpTSSkYybwOZ8oYJ223rO9nWvcRoRT8ghi_2Hbw&oe=6A1D9055"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCvf1L3u9W0Q7kNvwG-X1fD&_nc_oc=Adq2KpD2o3UK0s-sVPYMI1LsYQ3V0AsPlBwl-Ib_kjeVxZdHfCoOOD8tnNQD5Ul4gQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_4Z3nl7hFxZssmdSU_UbztX4clUypckFjmzsV3b94LQ&oe=6A1D8E33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
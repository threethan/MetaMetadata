cdn.com&_nc_ss=7f20f&oh=00_AQFQLQaAFvjHJUXeUiHvV01AMPjjKnjo9oyNAJaCIIjvBA&oe=6A75EC8E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4Ya1-IQ4_QQ7kNvwEgCIFp&_nc_oc=AdqsBpMnXCXQBU5xnwYw1ciWHX3SE0V0Q2FZw3Bbi4nVxB8iAssPTUwATbBkDEK-jMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBLTT3c-yUyzdd8DmMHq0bgJ3ETCGT3bRPTS-Ccy7Lwg&oe=6A75E4D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z-Y_mxLLJ4Q7kNvwFWgBpn&_nc_oc=Adqn8ENEopqVYPnjuUravdRcPTpz8GsDrhUt33u2xsfNhbKGVDF1rmKuD8ks2_APO8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuT1elNb1ZiSVK02z_jBgobQicwjOdN0KNAHSl0UBHnA&oe=6A75E2B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
cdn.com&_nc_ss=7f20f&oh=00_Af_eZ_EvHGqh5-1l97mghTvgKDXOXEt1aOkNr3CERX8NLw&oe=6A37F60E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md1i7-epd-QQ7kNvwHm028B&_nc_oc=AdoxmyT4TOiDh2XCw0rMvG4I9u7Lcx2yuNG2C6AJ_q4CI4CeGefhmaqZcFAawfq9Haw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tN5Y5d2WG5siOcPgG4Oxfn_GBpqj5rgyqhvNxezy-gA&oe=6A37EE55"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9t32OKzKkIQ7kNvwF_7Tea&_nc_oc=Adrzl32BmWUYU6PhS2BDMoagdROE9-WT5Cz7Ev_qctM3PDIa1pSWFB1bSMsBakR63nQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XuYj_Uf7Cwfhp_Ym4T_49qG6K3yK8KL3WX07ZMxj1iQ&oe=6A37EC33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
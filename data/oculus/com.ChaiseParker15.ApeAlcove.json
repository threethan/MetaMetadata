cdn.com&_nc_ss=7a30f&oh=00_AfzXZGoHbBp8GGHw5Ukgsp79UOfLBN533UaB6WH_jNDFGA&oe=69C2A08E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWn96sUw_2kQ7kNvwGGy_1_&_nc_oc=AdrlqHAWZc3BJ9Xsz3E590do_3I8cr2DdEpuOX4RG_y-6UqT_Zlhet2btmb5GC7j20Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKfEaaP7G-p6bJCFQRYOumSZcU9byzMMpXlmuKo7qJnw&oe=69C298D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk4mmSoB0hIQ7kNvwHmjTnK&_nc_oc=AdqBcpCAfIrbROzj0dZFlYqiOFV-rChGvs7fS7V0qQMj_dE2yCdK_e_uR6qFee1nPd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzue07bRYzJLQGcBQkv05j1FehKBCTVqvKVZJ4gnb7qVg&oe=69C296B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
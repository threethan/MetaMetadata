cdn.com&_nc_ss=7a30f&oh=00_Af2QqeygXvJkl-QjhnNAaqFT1xcLf3MKehHu29gqmqrXJw&oe=69E0F30E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4hjI4_OqZ0Q7kNvwGEWrSA&_nc_oc=AdoaXoWl5rF_NjvMQz6DHy-0vrDyr9tQHIAqSsM1LfCbPmAhObvm0oNGqrDwLqLn1g8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-donm_O5YGAt2vmnz0IjrHo4jJ6GxLQCT9mZpG8zMGw&oe=69E0EB55"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dXjJ352X9wQ7kNvwGtY0aQ&_nc_oc=AdpsLPM66siE4ppq1XKHMoF1wgGGXZn2Iv_rjT31uQjBtc1LfH6z3bys7fgW6f63wXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xn4yiaqOBCX0a3KmFfH8ePrfECeeJsQ5CBmnw-E36Yg&oe=69E0E933"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
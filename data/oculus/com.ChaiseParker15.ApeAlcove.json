cdn.com&_nc_ss=7a30f&oh=00_Af1DF1Fj7XB7H_jFKIl0LrLZ_7fkuXN_dgAsj2m2xlZKiw&oe=69EA2D8E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jS0vRyJiUAQ7kNvwHbLKmE&_nc_oc=AdrYxnUSUIb_YyaJSXNG21k5Ta1GLO2wqBEzjiS_f1rVXeSy2JwpJWbWpcmdQVF9CT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fEg6wSl1eNL642RPFjyn0Cd1k17SMU4vyDCaXa0Zu0g&oe=69EA25D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7DVPUoctE4Q7kNvwFwENM7&_nc_oc=AdqdGezRon851x_J_SpxWZE3T6yy4ZMJWCYoOKMpupj9njDsVHwR5lz1nwn77KooQvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01s-g5rrBM2DYYHEiNY7wfA6crHN_L10uMQwjqEXAxrA&oe=69EA23B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
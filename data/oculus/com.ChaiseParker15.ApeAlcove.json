cdn.com&_nc_ss=7f20f&oh=00_AQA9jHiK5x4QByLp2OD2kYH9bLfUtKOLtAJZANxE_5Sxnw&oe=6A56488E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s43dIrnIDxkQ7kNvwGdoUbg&_nc_oc=Adr0vn_1gqS1GYePkUY186iS5KBwk2puDzMdao34kZWjE7hLeVJaz_hLTZ2q0wyYmyA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQGwbT9MrUmduJr17Rh-2kERFnz4lEX9IfoWV78VOcTw&oe=6A5640D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMBDnZ_t5rAQ7kNvwEhNqZu&_nc_oc=AdolSv5YssAjvbRDa8XAU8M1zGUAfYPDOdwKOFn_QqvjSLU4Fp3KLU326izAT8iE-0o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN0QLOl08GCiI6d3hMyPET4YS9OGQ-X_ahWJFQ0HQpUg&oe=6A563EB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
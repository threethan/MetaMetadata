cdn.com&_nc_ss=7f20f&oh=00_Af8PfZ1EBl38ClsjYCoew9y7QDJly_9n6nSXJ5d2_-aCNQ&oe=6A34018E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckLv6kIG_pUQ7kNvwEzzqoT&_nc_oc=AdrEWk-wL2ae5uOuOBdFmhGvMpSbQPe4e2C_Cl3cKaqM4KXcdyvMQPR7wXAnBlfjjlQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rv26rDe8vdBRdfypHiVKHe9s4SKNL8RTxExPkgBO5JQ&oe=6A33F9D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj9bdItwzxkQ7kNvwFInaRl&_nc_oc=Adqm0ZUJrN__sbzqZPX2M0Oz3FsAn0XwcaHXN_YtHyOxwt3f1G0eoqaJ_ZAggppAf7Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qmfXSFp1mhvK5WhLHMdyf7QMYrQMkUx7yGYTPjKuIhw&oe=6A33F7B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
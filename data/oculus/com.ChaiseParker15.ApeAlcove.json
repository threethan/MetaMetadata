cdn.com&_nc_ss=7f20f&oh=00_AQEtOWdqovEsET9x5TjfCulQSM6xB5X21C3g3yMLpu2L7g&oe=6A9406CE"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDcRu6pAU14Q7kNvwGDVkZI&_nc_oc=Adp1Ael3-UPmt3hHJ4bR2-k1gkg93pHUg9cI2ueHpvVxJa1QRTrI8xgzl8kdzGFPjyc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf6iOdbTXgwsqglgQtm2460m50efrdulI6YcqaQwIa4A&oe=6A93FF15"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hwnkD6PI58Q7kNvwHouvYt&_nc_oc=AdoI6s3vY-gjYPNdEmztpN5viBdky7bStMoeSDME4LnlMbGZfvfAFyZU1ARR82JSNlY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU8qlQmcMAWJVLdbIY5Sq2lC3fn99ZgMlvcmkLEPWozg&oe=6A93FCF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
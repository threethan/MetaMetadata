cdn.com&_nc_ss=7f20f&oh=00_AQNMwwMkkbcHFU9njzUblG1bwUbN9s9wCs6lJY8PUjckKA&oe=6ACF928E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LK3KR8mK5UQ7kNvwHPFl_V&_nc_oc=AdrDxvmRNsyZnH95yUs2rPx7du9v-0CfrM4SpQz7Ue-VMwoNksBDeBWrwkXChp0axEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMap3NpaZYhOmssXXBcbONjFWbKQYa_CfMzYHWW0Z2Gyw&oe=6ACF8AD5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eb6--MlSZLoQ7kNvwHnJ_cL&_nc_oc=Adoeyr8IzomXZoawOBMiQudZl2wrO4C_q8mFV6v1QXEx4n5h-IQBKP45dnmBYXCH1R0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDSwndbuuUk74KzNCZaCu688V2vgYpJpek69s54Ui3lg&oe=6ACF88B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
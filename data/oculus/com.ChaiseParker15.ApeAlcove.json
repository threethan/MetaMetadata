cdn.com&_nc_ss=7a30f&oh=00_AfyiIjgZXpZ4imUmqs0M7dNjnUE8_DKj19my4sribonZRg&oe=69C7E68E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uwq1-hODzwQ7kNvwEw9gf4&_nc_oc=AdrxpHHZP3Z2deqiIRy2gejmSQTcguZSwWBHJZfRVtmZoTCsdrYT4_d8rMy7N7oJW4U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYRnm6gyWPHtLtEqqwdV-TgFcV1O6TYvVgQd9GfP8sdg&oe=69C7DED5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFeffRhI-9QQ7kNvwFutQl-&_nc_oc=AdrwjC1uOPdi8nUmitXir899PXZSVnZD_lKxhb_6Am0mJ-SrTL_gisEleHirExQFZI4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjwVQTexrVpzUbmVgt5ivPKelx5RLkt-mUbiaGiNdAyQ&oe=69C7DCB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
cdn.com&_nc_ss=7f20f&oh=00_Af6LXO7LwE04Lu1UDvqXQIEsm9KtCIqldibPnbKuoxXW6w&oe=6A145D8E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=083BnhXEvrwQ7kNvwGsZ6Nq&_nc_oc=AdrfqxnPiyiz2md75SqqQzAYumBET16jwkdI7MgvRRENoSae5404JMgHivNpds48AjA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aoXJGdE2j4af77Y9GrrD08ep7Oz7fZGd2QdUq96Kq-g&oe=6A1455D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSFs1RR_I4MQ7kNvwEZHyYp&_nc_oc=AdoEz0kx3T6f4FzykuBwDifzTGLkCOSXe8e7LFXAMvkPGr1tFqZXAL4g4y-Rb3-ZhMo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lXtdGGW1pDaZJrwLsxfy8dsQbv5j-Y5CfVGYlCuKoiQ&oe=6A1453B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
cdn.com&_nc_ss=7a30f&oh=00_Af3ZguipH9CAatNkjGpt9StrBdXUtaeRTuGopvecSH4mRA&oe=69D3C40E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T52WvD7YpDgQ7kNvwEQKHe4&_nc_oc=Adrvduw-aBOEavuo4YouU8VBV6lkwSqutOP8MGqkoehiq2Bzr1T2ZIhwhMjVKOaL9Rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zIe0uRAYXoCY0nH61AOxarLtcqoXP6191ZjWCCqYfvQ&oe=69D3BC55"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YKcSWiQCTwQ7kNvwEkvBfE&_nc_oc=AdojtpbMxV-_80raWFJ4eFDE8mTB9ySViAebv9Xk56z6IJK-y-lvi7bzFDmMb9aJ5Dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uAgUvtVgT4SRQGlCMFmeDKA7d-mgMZVULO5ujOGyXQg&oe=69D3BA33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
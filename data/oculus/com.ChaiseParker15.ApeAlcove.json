cdn.com&_nc_ss=7f20f&oh=00_Af0GL3HvoM1QxZjzACL59Jg6hjEWZa9qBUMhnpt_hYIFEA&oe=69F75C8E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XE3vd2adH8Q7kNvwHX3Dov&_nc_oc=Adrc5iiO1kr6-VKContVDv4_8RRcCKYZamaaVNKAMW4atyr1ma6hBSmjXaMJ88eZi6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Cnyhywgm9HU48Dnz0fWbuMj3PpKNmQswJLY4fe13igA&oe=69F754D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCdEj5h4u_AQ7kNvwGpYail&_nc_oc=AdpSab-v5FVOpgaBj1d6VglfVzUFIOVLPcLscxRQ7EkZOLmtzVn2616L-nqnI6FDhVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3XBbU5UyNWVBBYz7ru6t0BQ3jg1luTyp4T-7S2JkBFYQ&oe=69F752B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
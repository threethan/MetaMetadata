cdn.com&_nc_ss=7a30f&oh=00_Af3QZBLKhwV44US4HoDm07jIk5Qa7SNKS2np_iHagtH-cA&oe=69E2448E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4hjI4_OqZ0Q7kNvwHIgmVk&_nc_oc=AdqKzS7kyymzDNEPxGLS8rAhpW0RUtzzT1MM96NprdwUvdVDCmrC92th6X2588BLgcA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gHznPQpGfCJuZZUuejXoov8HWJ5_nZpZicmsbJmGpoA&oe=69E23CD5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dXjJ352X9wQ7kNvwGs-Nwm&_nc_oc=Adqwje3lCKcA-pZBDJpGom8SFIUybkOLsUVBf1Zh5qJuPBXb99LL8RN77fiMA6DO-fw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WLCWjn_hdzVBNJSeQ_X_gKKeWeMkAt11aUoDVYdzSPA&oe=69E23AB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
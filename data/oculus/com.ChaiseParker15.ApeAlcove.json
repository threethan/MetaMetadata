cdn.com&_nc_ss=7f20f&oh=00_AQFI7C99yG0ivGjHNnbJ1HhKxjfzyaoKPuuKeGQNGzVDUQ&oe=6A749B0E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4Ya1-IQ4_QQ7kNvwFO3prC&_nc_oc=AdpoGHvfX_JiW7rDQtAJu8jXWT2_Ppopa1okPGiJPuAIQm5kvYmhMxV6z9P_svK8dpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGerL-Ckcr1-lBiUkKSZQ83vL9FB4cS0d1SXvbdisG8yA&oe=6A749355"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z-Y_mxLLJ4Q7kNvwHNI5Gj&_nc_oc=AdqFdbEbU7f0B_7k6QLA-qdMJXGHgTmuGulrhxIeRhmE9s78efAs0MhCncrFeyMpLLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTdtV42RpM1txJT4RCFponwlbMqS6GjpP5Nzh8wSnI8Q&oe=6A749133"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
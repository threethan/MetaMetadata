cdn.com&_nc_ss=7a30f&oh=00_Af3nn9urnuUEXLFBoUTKDZ25FAVzwQ7OVhNQIOyqKil5Uw&oe=69DFA18E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-l-1aLs9j4Q7kNvwGlcjCX&_nc_oc=AdqyKAp7v4WnE7IVUwxsoRt5_qKsey_qhz2ECBA93EbuvanpJxsiab3LYO66wJ-Y1f4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PIWKgWYbhfv6VSPaBtqaZCYIpp2Q3YegwSTEAfsmVJA&oe=69DF99D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tuj4pc0T6SsQ7kNvwFYCv6N&_nc_oc=AdrXG8Mu4P5jaUuHqn87Lv97pgwOw19hqRiur5pMitsrcxgSr_sKfYPCAukJb_bYySk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FixW6j71EDK1ZbNYhQS2cj2Q9tCwbW0eB9icEBkPmgQ&oe=69DF97B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
cdn.com&_nc_ss=7a30f&oh=00_Af1YO3tagj-f5d4yJ57a9iLd2UcNdZ3jJQgqzOuzkiIrUA&oe=69DA5B8E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlOdgUOHKQQQ7kNvwElnVFI&_nc_oc=AdraLpWmRoo4qYu6eEHaQUPNn02WoPG3zo4lcHd9JKXRUHkC7AgQ4Klf5wvfR-dp9M4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Oems4GcW7cI2PmIqUvEZe--V7ViQHUmbQKhpfQoUqng&oe=69DA53D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhvmHICQHzEQ7kNvwHqxWn_&_nc_oc=Adp7osSuL468hgk4WLV8u6j5vPZFMOmf3qM70csLdFsgXbslq1wR-afuvjqH7fIfTbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1893xZRBq-M-FfIG7Wc78VuMtwaxa0y_Y1WBCuicQ3PA&oe=69DA51B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
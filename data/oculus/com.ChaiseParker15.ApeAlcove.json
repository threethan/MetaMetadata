cdn.com&_nc_ss=7f20f&oh=00_AQIdjwEcRNXDwLOk7P5ZGgT_Timd8sGRdcDqsdbvbPDOcQ&oe=6A9D798E"}, {"file_name": "Ape Alcove ss 4 SCALED.png", "id": "2555756801286024", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86810875_2555756804619357_3463954231086294760_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2Z7uvpE6SoQ7kNvwEFP3yC&_nc_oc=Adox88SDl3WN03pyha3HcznPH-1-DGa1h1SS9BhZ9WNumCVwmzufEurh4g9jpLrJG0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb1VciIQ7bVPyl0QTEeLD4IpwbjKkDG7qtdNzLRoDaFw&oe=6A9D71D5"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFjamPHQ1tAQ7kNvwFP6IRd&_nc_oc=Adpy8h4qikSdEpGJ9O3sasMeYwi48taX2zLiikTk4geG33NSImJ83PwOSUCCOgThddg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPWiK5M1lCydp5oAE2yyQoeBKmHnl4SMV0ED2nWC_xpA&oe=6A9D6FB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support
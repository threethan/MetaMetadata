8TAvLDnoasFkA&oe=6B0F0B15"}, {"file_name": "Ape Alcove ss 5 SCALED.png", "id": "794712889183922", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75416835_794712892517255_7183747208565214202_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7UxbBLrquYQ7kNvwEwyG35&_nc_oc=AdpC9jNshbXNloY_ZiaU3bz-xc4BoUADRTajz7PLER93e2sQ5icShiwubdlROlR5mFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpUjcRMqKHpVi4DZPk5L7Lyn5IY8BxRY45Tyn_AGga-Q&oe=6B0F08F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Alcove", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses your hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps and game modes to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or random people you meet while playing, You can explore the wide variety of maps and more, If you are looking for a fun game to play you should consider this one."}]}, "developer_name": "Chaise Parker", "developer_privacy_policy_url": "https://sites.google.com/view/apealcoveprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1V8rC1w_JHi3wyCmIklchWrDqzo6690fYn-1WyC5DZe4/edit?usp=sharing", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recomme
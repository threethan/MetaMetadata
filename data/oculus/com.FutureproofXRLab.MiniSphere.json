uluscdn.com/v/t64.5771-25/673751957_1789886732042116_4727511059856443096_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLNMjAmq20MQ7kNvwF3mydc&_nc_oc=AdoTbHSfFZ2sBlCUbDUJo9pONBMeIJpRukYc84Hs7t7YViZT2X43ZJCK8l-irwvx-wY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuMfxHSUF7jUQ9G1XsvyB0s7eqJioE_FPhCoGsquV4Ng&oe=6AEC9DB8"}, {"file_name": "Main Sequence - trial 2.00_00_41_13.Still010.png", "id": "1013591185028433", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831964_1013591188361766_5171347203891177437_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Jd73nzWWDYQ7kNvwFgdcrd&_nc_oc=AdoKDaPdkXl67mhkUCZzZYhcv47UdzvHVEJ_1Nh36hYqEY-WfYkQh4-3lcOpCHLRmQQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR89RdhAaB6Tulbo6VGguF8a8imPcPB6UGqs1xsa4nySw&oe=6AEC8B1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoPreview_2560x1440_v2.png", "id": "951309774028294", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673645340_951309777361627_7758813051711564787_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QADZPO5dXwQQ7kNvwHYWJW0&_nc_oc=AdofMq_vaGTvS-aXgDAyJfQD8SbQ7581G5tLz_lMYLxm2oXw4PrHJknenlhJ6I_RQVc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLfrzHyDCP5tUcFuUMomd2SaB6mRpo9yWmeL9Z_pgGUg&oe=6AECAF81"}, "display_name": "MiniSphere: Panoramic Image Viewer", "keywords": ["PanoramaViewer", "VRImageViewer", "360ImageViewer"], "long_description": "\u2022 Designed for intuitive 360\u00b0 panoramic image viewing presentations, including first-time headset users\n\n\u2022 Local image loading from the Download (Quest 3 > Internal shared storage > Download) folder \u2014 images can be downloaded directly through the Quest browser or transferred via USB connection \n\n\u2022 Supports up to 7 panoramic images.\n\n\u2022 Filename-based image sorting \u2014 rename your images to create your preferred viewing sequence. Recommended format: 01_Filename, 02_Filename, 03_Filename.\n\n\u2022 Controller-free navigation using hand tracking\n A. Turn VR mode on and off using press-and-hold buttons\n B. Navigate to previous and next scenes using left and right hand-interactable buttons\n", "short_description": "A simple panoramic image viewer that accesses the local Download folder (Quest 3 > Internal shared storage > Download) and loads compatible images. Users can turn VR mode on and off and move to the next or previous scene using hand-interactable buttons, completely controller-free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1dnDtgne-BjqunxM_eIRLX1_YxkPAcCDCv-1N-6mCooM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Futureproof XR Lab", "support_website_url": null, "website_url": "https://www.yongwoopark.com/minisphere", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1336734776188347"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673573223_1105935032188098_3016212915728447508_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iivzzj-13sQ7kNvwEAzzqd&_nc_oc=AdqMVLDkEy8db-MYl8omkgsNmoGvxUX-nREGbkDDWPzCnkkjETZgfW_jiycMaC2zNMQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb8UBjIYoZmN99x8zqqntkNmhyvjVfHjcyLhPyBnnOkQ&oe=6AEC91F0"}, "is_concept": false, "is_t
content-iad3-2.oculuscdn.com/v/t64.5771-25/654922264_1104627462383335_4955348831047361482_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoHELVpkMSEQ7kNvwEblZJd&_nc_oc=Adp6jjvV-cP6UVOLaZsKm8T_qjdo7zgv9gJI30IyNu-eoaef9Tv8eE6899d_Q9EzPJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWx-fhAGFzydACCpzD1mA-Gk758X3fJASWxSvdEgumFnA&oe=6B0EF9D2"}, {"file_name": "5_no text.png", "id": "1460298722724868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585727769_1460298726058201_3059296232187713365_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmqbV9hq9M4Q7kNvwGIJl2q&_nc_oc=AdoIWE_knN6cVJfCxi7jVi1B2t4M1px59dIoNztwfwF3onhP1OPoTfUmpCooatfHGrw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9SM6Cm_yP4Wk3oKkBCO56ZjnMIpLd_VhcQlXcIJkdcw&oe=6B0F12FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape.png", "id": "1157130916997559", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312267_1157130926997558_6053387109710062602_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Ky3076PSasQ7kNvwGlKM_e&_nc_oc=AdoToxaqZDYZue-s4M4ts6vQHKp0fe7ogVm-eluwAJmq0ntJhs0TIa8mjhsdCbGzkIM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVLQYqHHkJAYcIY0oZ8d-akgRGa2C1jYQ0nfNn-yWDcpA&oe=6B0F0A59"}, "display_name": "MiniSphere: 360\u00b0 Presentation Creator", "keywords": ["PanoramaViewer", "VRImageViewer", "360ImageViewer", "PresentationCreator", "3DModel"], "long_description": "**MiniSphere** is a **coding-free immersive design presentation creator** that **combines 360\u00b0 panoramic images, interactable 3D models, and audio storytelling.** Simply save project files to your **Meta Quest's local storage** to create customized immersive presentation sequences. Explore them with **intuitive hand controls, completely controller-free.** Try it at your next client meeting or community engagement event.\n##\n**Getting Started**\n\n-  Explore the built-in Preview Project and guided tutorial.\n- To create your own presentation, create a folder `Download/MiniSphere`, save your files there, and grant folder access when prompted.\n\n##\n**1. 360\u00b0 Panoramic Images**\n- Scenes play in filename order: `01_Entrance.jpg`, `02_Plaza.jpg`\n- Filenames appear as scene titles above the 3D model.\n##\n**2. 3D Model (Optional)**\n- Save a `.glb` model.\n- Use lightweight massing geometry, centered at `(0,0,0)`, about 20\u201330 cm in diameter.\n- Add small spheres with materials named `Camera 1`, `Camera 2`, etc., to mark scene viewpoints.\n##\n**3. Audio (Optional)**\n- Add `.mp3` narration by scene number, e.g. `01_Narration.mp3`, `02_Narration.mp3`.\n\n## \n**Key Features**\n- **360\u00b0 Viewing:** \n- **Mixed Reality to VR:** Gradual transition from passthrough.\n- **Hand Controls:** Hold Power to enter/exit VR; press buttons to switch scenes; adjust UI heights.\n- **3D Interactive Model:** Pinch, rotate, and scale the model to explore viewpoints.\n- **Scene Indicator:** Current and total scenes.\n- **Guided Tutorial:** Learn hand controls before presenting.", "short_description": "MiniSphere is a coding-free immersive design presentation creator that combines 360\u00b0 panoramic images, interactable 3D models, and audio storytelling. Simply save project files to your Meta Quest's local storage to create customized immersive presentation sequences. Explore them with intuitive hand controls, completely controller-free. Try it at your next client meeting or community engagement event."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1dnDtgne-BjqunxM_eIRLX1_YxkPAcCDCv-1N-6mCooM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Futureproof XR Lab", "support_website_url": null, "website_url": "https://www.yongwoopark.com/minisphere", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags"
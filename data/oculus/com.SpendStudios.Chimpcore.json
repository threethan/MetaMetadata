r": null, "video_trailer_thumbnail": null, "display_name": "Chimp Core", "keywords": ["Horror", "Gorilla", "Chimp", "Backrooms", "Monkey"], "long_description": "Dive into a terrifying Backrooms experience built around intense gorilla-style locomotion that makes every movement feel physical and immersive. Run, climb, and launch yourself through endless, liminal spaces where the silence is heavy\u2026 and something is always watching.\n\nExplore multiple handcrafted levels, each with its own atmosphere, mechanics, and hidden lore. From buzzing fluorescent hallways to dark, abandoned zones that feel way too quiet, every area holds secrets waiting to be discovered. Some secrets unlock new paths. Others\u2026 you might regret finding.\n\nYou\u2019ll need skill, awareness, and nerves of steel to survive. The movement system gives you total freedom but it also means there\u2019s nothing stopping what\u2019s chasing you.\n\nThe Backrooms aren\u2019t just endless.\nThey\u2019re alive.\n\nAnd they know you\u2019re here.", "short_description": "A fast paced Backrooms horror experience with gorilla-style locomotion. Explore massive, eerie levels, uncover hidden secrets, and survive the unknown. Every corner feels wrong\u2026 and you\u2019re never alone."}]}, "developer_name": "Spend Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-core-website/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/chimp-core-website/terms-of-service?authuser=0", "publisher_name": "Spendgt", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-core-website/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "i
ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKiwZeE623OYPBK8gTL1HPQwyCV1ZmslnOqxaivycotg&oe=6A6B40B7"}, {"file_name": "MainV2_Custom..._11.06.2026_18-49-34.png", "id": "3190690461263022", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314659_3190690464596355_1160253792076996857_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6I26KGXpm8Q7kNvwFXwTIl&_nc_oc=AdoMDgVV3yJpzwmmmtcIxnCXCx_Hmem1l7r2aqLFZ-bmBDqOZW8epe8Up8KHM8y0QQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA01ZI5JQhVsTDtTGXYLSBT1jTV1a58yH1AyWtxCNfJRQ&oe=6A6B3C38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Core", "keywords": ["Horror", "Gorilla", "Chimp", "Backrooms", "Monkey"], "long_description": "Dive into a terrifying Backrooms experience built around intense gorilla-style locomotion that makes every movement feel physical and immersive. Run, climb, and launch yourself through endless, liminal spaces where the silence is heavy\u2026 and something is always watching.\n\nExplore multiple handcrafted levels, each with its own atmosphere, mechanics, and hidden lore. From buzzing fluorescent hallways to dark, abandoned zones that feel way too quiet, every area holds secrets waiting to be discovered. Some secrets unlock new paths. Others\u2026 you might regret finding.\n\nYou\u2019ll need skill, awareness, and nerves of steel to survive. The movement system gives you total freedom but it also means there\u2019s nothing stopping what\u2019s chasing you.\n\nThe Backrooms aren\u2019t just endless.\nThey\u2019re alive.\n\nAnd they know you\u2019re here.", "short_description": "A fast paced Backrooms horror experience with gorilla-style locomotion. Explore massive, eerie levels, uncover hidden secrets, and survive the unknown. Every corner feels wrong\u2026 and you\u2019re never alone."}]}, "developer_name": "Spend Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-core-official/privacy-policy", "dev
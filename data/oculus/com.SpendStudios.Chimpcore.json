NjCh0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZlgPoJugFPrsL8LOT_LlwwK_X2TP8Z-l58TkwhcC0vg&oe=6A5E0A31"}, {"file_name": "Main_1140p_16.03.2026_16-20-19.png", "id": "1494491338971247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303672_1494491342304580_4623099514908198163_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20tE-nyCUsgQ7kNvwHGr4X3&_nc_oc=Adq2o9iFcShheMty-CZ2RQocqQ6LFf32xRxR_nGOcN-DSYN8n-KSPw0RunvrUIFJD6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBicOaQUkKRIUq7bZ_zyiGleiEieT9f6ckluqBhQ5TGCw&oe=6A5E2215"}, {"file_name": "Main_1140p_16.03.2026_16-30-41.png", "id": "1417620736184070", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308045_1417620739517403_5191759762300187809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc8hc5AJX-0Q7kNvwGAIzSm&_nc_oc=AdpU5bT0ej55YvsMllNTeFZCxljT3fLYoHii88P6C0dPmzzFJP0ZL5ZnNjIzHx8zNPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA05vz2O0CTHEPu3yB7cdyFev3pAhtCF-X1lGYyGr9gBw&oe=6A5E3748"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Core", "keywords": ["Horror", "Gorilla", "Chimp", "Backrooms", "Monkey"], "long_description": "Dive into a terrifying Backrooms experience built around intense gorilla-style locomotion that makes every movement feel physical and immersive. Run, climb, and launch yourself through endless, liminal spaces where the silence is heavy\u2026 and something is always watching.\n\nExplore multiple handcrafted levels, each with its own atmosphere, mechanics, and hidden lore. From buzzing fluorescent hallways to dark, abandoned zones that feel way too quiet, every area holds secrets waiting to be discovered. Some secrets unlock new paths. Others\u2026 you might regret finding.\n\nYou\u2019ll need skill, awareness, and nerves of steel to survive. The movement system gives you total freedom but it also means there\u2019s nothing stopping what\u2019s chasing you.\n\nThe Backrooms aren\u2019t just endless.\nThey\u2019re alive.\n\nAnd they know you\u2019re here.", "short_description": "A fast paced Backrooms horror experience with gorilla-style locomotion. Explore massive, eerie levels, uncover hidden secrets, and survive the unknown. Every corner feels wrong\u2026 and you\u2019re never alone."}]}, "developer_name": "Spend Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-core-website/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/chimp-core-website/terms-of-service?authuser=0", "publisher_name": "Spendgt", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-core-website/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "34263602853285793"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1405828281276227"}]}, "baseline_offer": {"id": "1405828281276227"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773962940, "status": "PUBLISHED", "id": "1405828281276227"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34325014547144623", "version": "6"}, "id": "1449185330160987", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_b
gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRlEx7Dc_Z0Q7kNvwHrnDKy&_nc_oc=Adppz9uST8T9HR5Cfx2QSg39NBkbXUl0GiHbrX2BgJDxYcn7IIEL4MUTnrphUSZP5pM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz7tBngNi5hpRdR4SEMyajtWUiCZ0WMo-6t1HCcplG1Q&oe=6AFDBCC8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Core", "keywords": ["Horror", "Gorilla", "Chimp", "Backrooms", "Monkey"], "long_description": "Dive into a terrifying Backrooms experience built around intense gorilla-style locomotion that makes every movement feel physical and immersive. Run, climb, and launch yourself through endless, liminal spaces where the silence is heavy\u2026 and something is always watching.\n\nExplore multiple handcrafted levels, each with its own atmosphere, mechanics, and hidden lore. From buzzing fluorescent hallways to dark, abandoned zones that feel way too quiet, every area holds secrets waiting to be discovered. Some secrets unlock new paths. Others\u2026 you might regret finding.\n\nYou\u2019ll need skill, awareness, and nerves of steel to survive. The movement system gives you total freedom but it also means there\u2019s nothing stopping what\u2019s chasing you.\n\nThe Backrooms aren\u2019t just endless.\nThey\u2019re alive.\n\nAnd they know you\u2019re here.", "short_description": "A fast paced Backrooms horror experience with gorilla-style locomotion. Explore massive, eerie levels, uncover hidden secrets, and survive the unknown. Every corner feels wrong\u2026 and you\u2019re never alone."}]}, "developer_name": "Spend Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-core-website/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/chimp-core-website/terms-of-service?authuser=0", "publisher_name": "Spendgt", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-core-website/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW",
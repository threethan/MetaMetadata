h gorilla-style locomotion. Explore massive, eerie levels, uncover hidden secrets, and survive the unknown. Every corner feels wrong\u2026 and you\u2019re never alone."}]}, "developer_name": "Spend Studios", "developer_privacy_policy_url": "https://sites.google.com/view/chimp-core-website/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/chimp-core-website/terms-of-service?authuser=0", "publisher_name": "Spendgt", "support_website_url": null, "website_url": "https://sites.google.com/view/chimp-core-website/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "34263602853285793"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1405828281276227"}]}, "baseline_offer": {"id": "1405828281276227"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773962940, "status": "PUBLISHED", "id": "1405828281276227"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34325014547144623", "version": "6"}, "id": "1449185330160987", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "338146070515187
yhom9J99vbfG-4oAyABUYLb1ZfmHjV7FuxdGWa5uPX2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9FEH0eahavTyr13l7CpIYJNrmRcYjASKRvvyND17rPQ&oe=69BE86B5"}, "display_name": "CreaMe", "keywords": [], "long_description": "Application for Oculus Quest intended for the execution of training and education experiences carried out through the Creame platform.\n\nTool for generating immersive environments and virtual experiences. Rapid development of immersive virtual environments and experiences.\nIt provides flexibility and dynamism to the system, facilitating as much as possible, in terms of time and knowledge, the creation of immersive experiences in virtual reality.", "short_description": "Quick-to-deploy immersive experiences\nTraining and education with immersive experiences\n"}, {"images": {"nodes": []}, "id": "709339981326795", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CreaMe", "keywords": [], "long_description": "Aplicaci\u00f3n para Oculus Quest destinada a la ejecuci\u00f3n de experiencias de capacitaci\u00f3n y formaci\u00f3n realizadas a trav\u00e9s de la plataforma Creame.\n\nHerramienta de generaci\u00f3n de entornos inmersivos y experiencias virtuales. Desarrollo r\u00e1pido de entornos y experiencias virtuales inmersivas.\nProporciona flexibilidad y dinamismo al sistema, facilitando lo m\u00e1ximo posible, en tiempo y conocimiento, la creaci\u00f3n de experiencias inmersivas en realidad virtual.", "short_description": "Experiencias inmersivas de r\u00e1pida implantaci\u00f3n\nCapacitaci\u00f3n y formaci\u00f3n con experiencias inmersivas"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.openingenius.com/creame-privacy-policy/", "developer_terms_of_service_url": "https://www.openingenius.com/aviso-legal/", "publisher_name": "Open Ingenius", "support_website_url": "https://www.openingenius.com/contacto/", "website_url": "https://www.openingenius.com/", "ca
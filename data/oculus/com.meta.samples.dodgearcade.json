DjMkuaTuYwY3XwlVxzkww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pM2Ufk-nJSbxwQO6r9ucG--4mgUPoKi1dINaz-RwIAQ&oe=6A218399"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o89JnUtq7ZwQ7kNvwH4QDwr&_nc_oc=Adop4zM0vvSwuWOJEUgDbDGt3YtPB7GlT--HN2rpDiLLdzLYLC5pXADYWFX5QVvg7yo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94U3BgD8FbzQIUjbv25IkbXGr8zWdqnZRcdTUb0CD-1A&oe=6A218D0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYAk0tBGhUAQ7kNvwG2XdMo&_nc_oc=AdoaCrzgVmFhT4g37oraEV05pVCFW-rxD-rejpyQF-Zi_lJEwo5A2hkb8DEcGszAiZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SvYPjoLi1BEMMfNGRbrTFuBJmBS6rQAkbaDtpRzwxNg&oe=6A21A695"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
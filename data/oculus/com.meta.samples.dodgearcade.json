pnynQM9Ax9CFY55GvqAoE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFywyb9JWnUIWfIYJaulPBEs5nRZ2CwNrL54YZl9pS1RQ&oe=6A71EF19"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHT_9tzpthwQ7kNvwFDw6id&_nc_oc=Adq3SyySVybv_VI2aic26RjLJTebt7DOwpiAgE9VlGI1XwlKMLnxRkQBMsyJrQBNpxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_Ttcti7AZHn7MXUIRsWOLbIDLd1SlBHgpmsiv70UuYQ&oe=6A71F88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFbU_RMw0CsQ7kNvwFEf0Hr&_nc_oc=AdoNvRaYkwpYdl1L7zB8NlgD1tI0qovSXi4H7qOLIh-rcPx55Dxfbrw-KVka86YC8Rs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLZa58GDu4SZbIUbSzYVKzojDLxCzPnRJI-yV9af5QRQ&oe=6A71D9D5"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
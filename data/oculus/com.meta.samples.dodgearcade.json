IqPFbEM7ueWZ9vmf_cyYM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9juWqaNsQntqzCz_donBeHe3ca0Ff0VdPdIv4TNrnkUQ&oe=6A296C99"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQ2S44B7TUQ7kNvwFuStLe&_nc_oc=AdqROo-TAnq5ToW0CBCUkm6gCs27bb342DTyVlWB73b6GEOJFjj3PeEZU139Avref8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bVsGo04xtq5X9AzeX-b_VQ_V2y1ju_bjFQxxM2FopjQ&oe=6A29760B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpCMttkFqMEQ7kNvwFsCo-t&_nc_oc=Adq-xGYuCSoyXKrT7rUFsyLx6jokMIW10KOZsm9vhKHsm25A5-G7393hi9imQEW463I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S2EuqUXRe0DZMEj92NFwLIe0Ons5n8cm8OiSsLufVIw&oe=6A295755"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
MdI2mNiB6bp4rWwKbmupU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1jMIx5qkBhWsWZMxxXwrI_u8r9WjI_g3Jetqlyi1IrJA&oe=69F35F19"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzVqFuv98ScQ7kNvwHD-SOz&_nc_oc=AdrahLVvhfzE7sgktN5peTtJC9W_zgoplLgmXpMcITGyF0Y1Wl9jP-EDQtYzfzOupQg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3sp29EsDmheDJ17ihryxykYaHUHwnkHjsZ-j_r53gEjw&oe=69F3688B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haB1_ztI7B0Q7kNvwHvW6u7&_nc_oc=Adq0X-QT3Xo6ydobhoaLY5zXFmaR1AFwOZSNeEWH4bDb3p2Uq806Iv-zvr0YUcPV8ug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UShlziCTtnWftYvpbBow4Gip5sQHsX32sSBA3hJGNGg&oe=69F349D5"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
pIB5gUw9gOrzOj3uyf3zg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwqnTA6tu7drYXVCHV1ni5cazzQk_HSBTrSKFEivvfEg&oe=69C92F19"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-keDWcO4ftEQ7kNvwEESXmC&_nc_oc=AdoYCg40h5KSjbkefhkMTOe7pOuuFwSJbMx1GgNglQkvxHVZMqQis6Fc4o9I8yzoO3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygU3_9VBnM05miXPf26-abN4tymyW85tXnk5018QrRjQ&oe=69C9388B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4IcJINNpNQQ7kNvwHfPVEG&_nc_oc=AdpHvxailipv_XAAEwmGkoBUp8JgqRDau8za9kU2oNAvaUZbEpRLOPKyIENCXoaZ54Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMBg1zPnGwn0kta9mL_uOtPdrcISKoAi4fuyCiYdJFvA&oe=69C919D5"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
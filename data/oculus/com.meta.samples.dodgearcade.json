ontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzr1Vo-3qO8ImdN1guqRdJtfhhtRCuH0E8U96OFfSzJjA&oe=69B2C599"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRqA8ekSDlIQ7kNvwHNTcOy&_nc_oc=Adl2w1DK6FfUokbKNpwrX2KBdgYwuSW8Uz1PYy7HhtDUi-LPxIWr8Ka7zq3BTvN2YkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxm8XUIRl_u37Mk43_m9caR3tL4QHyHd_c5Fb5aqs00gg&oe=69B2CF0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKud2luvUysQ7kNvwEYZsx9&_nc_oc=AdmnQYP0NJg1YwBh4PGyn3B_5WArZzW7Pf5U6Tgx6Vf5VQjWADGY5GwM7VquwCx1YZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydmsGKBLSXvBaNpkSZh1LcqL6Ww-TTm8qrte1t5GP30w&oe=69B2B055"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the basis for this application is available for download at: https://github.com/oculus-samples/", "short_description": "This app allows game developers to experience the capabilities of Meta Quest's full body tracking, embodied in a sports character. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen."}]}, "developer_name": "Meta Quest Samples", "developer_privacy_policy_url": "https://www.meta.com/legal/quest/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/terms-of-service/", "publisher_name": "Meta", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPORTS", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6511679582269559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334055_871190971048804_4077027651878035231_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TzqWKD9VZIQ7kNvwHxHTw6&_nc_oc=AdlHyOLp_ehZ6ReTKAFwtPiFVc-kH0OSPlKKZrbYd3-BWB4TOWSSQauFd8VLoL9tGRk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx19CQQt85iOa8VwpqHlCbkmkPxM887YkAHuUT_ZVuTSA&oe=69B2A239"}, "is_concept"
fY2KKXkucw2MjbyqBwxTI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs29WUmYbQCqHlve_-3XI_UeCp0cCuQTfS79grcRbHag&oe=6AB52B99"}, {"file_name": "DA_Screenshot5.png", "id": "1060070388776314", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031573_1060070392109647_6465335994644117459_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU58jGWQxpAQ7kNvwGS02u-&_nc_oc=Adqn9zO9YWWki3hWnNhSaQXWvJ-gaqW--zs1rNeLE6IWnyHLRM7yVaxJ0OVM0hod2Co&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-LB3cv9oc6DjGCKxsz-JSzpaCGxPs318uypKmqdOODQ&oe=6AB5350B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DA_TrailerCover.png", "id": "348593917778997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974473_348593921112330_4300391382142147546_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vThFCAtBHPQQ7kNvwFajzNW&_nc_oc=Adqf1nRHdHj2rWvTvljxZSa94XVOCXL_M5v8LWL8Tc2XM8ysIihBv09bVEyVmndkU5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJH4DguJU67xWB_WIysTGs13_fOFdJNs1kqlaX0fIGEw&oe=6AB54E95"}, "display_name": "Dodge Arcade", "keywords": [], "long_description": "Dodge Arcade is an interactive demo app that allows game developers to experience the capabilities of Meta Quest's full body tracking. You use body movement to dodge incoming fireballs and block soccer balls. You can squat, lean, and jump to avoid the balls, and your movement will be reflected both by the character on the field in front of you and in replays on the overhead arena replay screen.\n\nThe third-person view of the embodied character gives artists and game developers the ability to see what is possible with this technology, allowing them to create more immersive and realistic gaming experiences.\n\nThis application is an implementation of the Presence Platform\u2019s Movement SDK which is provided by Meta to allow all developers access to the Eye Tracking, Face Tracking, and Body Tracking capabilities. The code that is the 
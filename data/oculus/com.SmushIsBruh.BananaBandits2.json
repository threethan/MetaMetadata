d3-2.oculuscdn.com&oh=00_AfsAOc3hwuPLCxUqaXlTCRWAj1u0CvrCME-gqqzSpQdFBw&oe=6999AD80"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzNpzONn_xIQ7kNvwEhgRsm&_nc_oc=AdmHrOaSoE-0GwlWLN4ztmjOKGXGjvWVJHinszfQ8LUNcr4FuE93RhyWgUQ-SgB6_H4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuibV5b8LLe_nE6r8XqMWogz8gyp-umUR755J2o8DYKug&oe=69998BDC"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZRJ0N8NdYEQ7kNvwGwPBoo&_nc_oc=AdmRe6EPMDCBXlxBxFgoOMdrC9FAuW3-hwybZuXBgCjMrQPTAoVOP-E_ILRiMbqQnDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs1fo5Ozgt_WHxnwUs6MlZ7IRhId6CjLZNjeaJ_zNAw8Q&oe=69999690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aiw9uXvcckQQ7kNvwGJSCy4&_nc_oc=Adn9PVewByQB6SSCnzNZrwXjS7SEqDfYc2wm3c6hT0j_7YJ4-0KGdciy0VZXqDGFOco&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuy7tZfd9J1Hdjmp_VLlLc_R1myUMDteiAMPZsNAXZTBQ&oe=69999E3C"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvmhG4MuWWIQ7kNvwGDLpN4&_nc_oc=AdldZHpeV-3UrwAh1usbKL3tZPjKPpNZ3adx-Sdyyt9R5mDLG5XPptPumtyeC5OUOHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6V6zcGhZbQp38je2o5JNJnErIXGS4Dhs8EeSDWRh1pQ&oe=6999A083"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1688849100, "las
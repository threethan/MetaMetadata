zYQ7kNvwHas7lY&_nc_oc=AdoiBWsBCG6xL7i-8ZT_jo7fjFCVJfdEtoasqVJ6tQmDyf6ayXBpF8KrJN4HV8qBbYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af092oDjTpgDCED90e81JYtN0ikXcelQWsXaosVSzuTktA&oe=69DE3B80"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaQln-ufdJYQ7kNvwFM8xVM&_nc_oc=Adotzvzr4RcnZVB-fM4oEtd8X-paVu4U3HP4DgGROrw1-WRvgi7Jo9LI9PwImAR-eWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25EX5WnxggNRWn37Hd5ay-8WHDkJUQ9derrlHHnficmQ&oe=69DE521C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GewazzryypUQ7kNvwFqMjpZ&_nc_oc=Adoi4dPTWeUizD1wCDsgHpgO7AlISJIPSm7VVMJAUwONpivTOboTZh2bhkGjo9MJfRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j8hhcuJf7JgVuWQWMzWpsCbQYkIWPg9ZTSCnhU-1K3g&oe=69DE2490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63LNTiS60cAQ7kNvwFBrsrV&_nc_oc=AdpcLYq70FKNQScEv4mZLEcVi1OSDIKEa8SFf54N1mbjFmD86SS_ytLqEfl9XTmECOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1284ocy5BolFvsK2BcjAG-MVWcnUcqncKlRZsibgQMQg&oe=69DE2C3C"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCfujgpuSpwQ7kNvwHIIP8c&_nc_oc=AdqloZnbiOmXuPkzhAnot0ymy70T58vrnqjPo3lMkfEFMlauOxvqYvDp2-nbFDq46dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af157FCD4F7wJTtQ3q6o5fxhS2ef9aKz_ijxTlvrmy1V0g&oe=69DE2E83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF"
d5-3.oculuscdn.com&oh=00_AfsCg-FUPXs5EHKeFF2dC95894oxyxBk6lPXJsESQscDLw&oe=69A43980"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ4Atodt8wwQ7kNvwH1hXE_&_nc_oc=AdnzPkffm7tzdEm0LQ6r_XYXJdYAmq7JFb2xifaTAseHwMYw1Vb78FYh_IsLmvuJG60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftGIjX9HWo2D6r5r-X04HDPp5J843Z7X1z5vVokNup8hg&oe=69A4501C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgSNFAUJhF8Q7kNvwGgOLpm&_nc_oc=AdmEMpLQDILk_HaNOHmn1_xCi866cswTudvEeiYusAmqzp8-JdJZ7M3Jc4nfkCMwwTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsrSnFA8kJROIorpsreBs9XWw1YzFDUe8ivQjYddQFAiQ&oe=69A42290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6sV59OSlnYQ7kNvwFu73lW&_nc_oc=Adlwj2-0t_UB8s_zo8AJdxSZMX13J7A170HNB39EEGz8EcnHY6PGxBVMqnTsJZOgUsA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu-Kiq70l5MIuLe4owN8fwGoJAurqtZ7voRk2Iidam7Qw&oe=69A42A3C"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ6ejJqhhZgQ7kNvwH-OX72&_nc_oc=Admgo7HgJmgDFVxp8OlghQmurOCYFdi9jUF4ogOitZmoI1Li11-74zEYc_Pd75PqaYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvciFZSKtYlLIlcN0WNED8ExzlWY88TKzIEN6FoE2lJvg&oe=69A42C83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1688849100, "las
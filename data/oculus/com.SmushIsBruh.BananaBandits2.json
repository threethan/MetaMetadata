JYQ7kNvwHfE7Fc&_nc_oc=Adpc3s_Q130opjIw7yRFRPwpPHwGm_loz_v4fCAG0V75clS9sDvlfvtuDywclVseuo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAZrRyWVZry79TaobASZBbLSu-eMhIBo-FZZFv9LruEg&oe=6ABFAC00"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSJ4s2_Ut4kQ7kNvwGhS5wL&_nc_oc=Adp4BpUVC6E1emvRPkIYyK5z5U3GQLPrUg8NE7ciIuVrZv6g-DtKywFMliKmIxttqao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSfRjCD_aZPRi8FggASvdUB9O9PoeqV1oabg3FSBBFyw&oe=6ABFC29C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcScBPcUJQ8Q7kNvwFhQaAI&_nc_oc=Adp7QO2ZYbwDJWTfiDgai8wXv0j5ve-ciKrZxtyGMvvRGHdB389ZrrwDGpfEx0pCWFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7kUpt8FH91GSkEB4_g5OKiRl8JcA6JGLoXZPMFaHpmQ&oe=6ABFCD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IV9TyDSXzZwQ7kNvwGVohp4&_nc_oc=AdpvVgOiX3f320yfIqAnkb4jjEPQyYKfv8Q_oz8sYYJ3ptKcC7xcu9c4ANqBwehNEwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFsJ_0NKSUFGip-8CuFZuQqbR6c1VpQ7ueY8rU4_P_cw&oe=6ABFD4FC"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1E__--u1ZMQ7kNvwF1BKq6&_nc_oc=Adr2jsSFEwW5OQIwZKAPsf3T01RUfdzoJrmDeiG3uewHb6F3N3ZtPea0EIxmI8HUzmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9vpwx_ZXDZeKRYy-uBoBKJJ6Fk5kzOuD1QDphEYwO6g&oe=6ABFD743"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF"
J0Q7kNvwEIsvCF&_nc_oc=Ado7FhcSU51bU3nYAGyn20EaHQi9WVau2mOsApyRQhZ8tS1AHGPpXCQLGpsvFrwql54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf1cqpKrJPi4y4Z754h7mOwz28n-7F6wX3Op8t1KRMKg&oe=6A69FA80"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naz-QS2A0DYQ7kNvwFdX1Et&_nc_oc=AdrgZ189bRZtEibZQpM7s8CP7lEC8pEeSHLKoDhMY6oF67Y5VfP4Wb5ym8N2NruJkT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbh4v3BIhgUpqqlTMdFcLDmuimAmUqLTgDxoC14C_T4w&oe=6A6A111C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4rWYxJjLXEQ7kNvwHxdADp&_nc_oc=AdosNquPDaVAuLwlqMK_qMO6aSHkrcqgdgORmCFCLk4vzoX4buItrFNgO13HtRLmN84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYtlHI5wCvddvBrT7QJuuHc9KU5nXviLKha8u4cLrvSw&oe=6A69E390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ai9XHOs1EqoQ7kNvwFlkxJS&_nc_oc=Ado8gaJF_O2SnpfTAWSn2cf3ZBQyGiKY7oksBkjQ_c6pHEm8dz0hAI2tFPTQDHnNS3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCyORyHZpzHxdb-UBqimC8vc_mddWYpT_tCmi8IwAxZg&oe=6A69EB3C"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrO0yi1DLeoQ7kNvwExUnoR&_nc_oc=AdpFS7t5P2_0_eGTh8Tn3UZEVJBgXWaKhp1W6QWGRCVNmvixoIGDqWEztxrSa47VW9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAF1vIw_mzLIAlzHNrAQIWmPRvG3R4R9v105c5PyyasA&oe=6A69ED83"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF"
f-8-bCOvT0I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af052LX4ZzhZdNwBPnVRz6tw5CZzblWhxpxir019Hxo4CA&oe=69F20200"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b42Gc9I1EIQ7kNvwGKpcLZ&_nc_oc=Adrm5LqA92LRwEo1WOS-A6_0C2bz4i7wuc-VAVpXlK7qaGVmIncIbgZE9fqv-yTDiR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Zauh6Dz3fOZw3shhlR2Hcu9xTbRtmEaX4hc2bJ7m8ww&oe=69F2189C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMBmqz1IxPsQ7kNvwFy2lGe&_nc_oc=AdrVDdGiJ0RDJMI6C5b5dPGJo1SKYWeQJS02lX3MjpFrvytBflLppWzL0nxvtmM4IPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1Q57dm1yrBJQbBsePpLO6alH6GoagDwYOe8LNEAIb1WQ&oe=69F1EB10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTl0mnuB3TIQ7kNvwGymZn0&_nc_oc=Ado7IbAfzXOWsom_CWLhtTc34_B5Tz5Faw1xGhjyZ7TYI8CT0Dxrbes_Km9wLseI5xc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af12aaGBkRh-mH-XUnMuYfGqadQhNhoUQrSoXoM6Ya_xxw&oe=69F1F2BC"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1An9C7EfSMcQ7kNvwFiaZ7y&_nc_oc=Adp1azaWB-pWk0QHKN-SDPZqJjFq3B1JYSpGvOh3QO1de_sSV2MbE7Ng3jiT96BtWrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2dKSxl0XaK6gAO8ZLsTrQAUKveia9O9R_zkjN6X9ysKw&oe=69F1F503"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Act
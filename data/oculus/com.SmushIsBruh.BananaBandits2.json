s, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvmhG4MuWWIQ7kNvwHPr-uF&_nc_oc=AdlFwHSiLX_Ek5HFhmYz4kGRb_m_-xM4TQ-y3bT161gK46YoqexvOK16TiDyXkTjgVk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftV_t9lkjJ2GyAFoIBWFQlpEPMdFiKjQWZqx7y6mdXmkw&oe=69984F03"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1688849100, "las
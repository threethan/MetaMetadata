": "fun.png", "id": "136968019401561", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_136968022734894_1028304814703375494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2WA2pzZQa8Q7kNvwH9NX0P&_nc_oc=AdrBVCOItaTzyL3NdKc-4L915XipwaY2LqNYqsTc7ivB7xcwciK3w9llsVJFAbv4OBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15YsPYi3bhoCuNxdFU9zQpGgrA8jLVtmp22MeNgt4LGg&oe=69D507C0"}, {"file_name": "temp.png", "id": "957707955372905", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982575_957707958706238_5938069967316008619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U_TZ32ZvjQQ7kNvwGZScuU&_nc_oc=Adp8-YI2XhgGsOWuDKvWuSqf_wl6VX0U7A233rZb2MFtuQM126h5E-EX5M2tKyubzdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rzchpxcX41ISzIcnVVYdtSfLDpom6mTSkiMJuazXVFA&oe=69D502D7"}, {"file_name": "lava.png", "id": "182154571184427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931335_182154574517760_1137497544566365008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlup_tL6lbYQ7kNvwFUG2Cr&_nc_oc=AdrIAAGT-JqIg50WUZRvOM0P9jE4goZBxXeD17Kcd5SeewVwqB27d_YAbjHmseOjopI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YN4b2Q0acpl8lK-MZDNDqH25UOpp0P_AoETD8eSNIDA&oe=69D4F070"}, {"file_name": "moon.png", "id": "178530471583006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422375_178530474916339_5284833994792554760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8_g5RsLvKsQ7kNvwFRy8wY&_nc_oc=AdrDvaWDIujSSGbcaUvcOZOzEhFhBARec3wzb3R6M1c44ON7qoIJLS07zdk5zKAC50o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PWmPoyqw4X2GIDHTd6xypT-y6vLwWTJGleGiTI17YEQ&oe=69D4F3E7"}, {"file_name": "Shops.png", "id": "736486361813385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572922_736486365146718_1965092028504960248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Aoq_g44FtAQ7kNvwH55R_N&_nc_oc=AdprDwokSVZk8OJBKXbmGrXEX5u86g9BDY3--LTa_o6Lri8rhwEztRQZqTnOl-I8LPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tpEDH1IlMo0uOFiAHMf3NB4F02EBTWCjMZ-czuMQqMg&oe=69D50275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banancover.png", "id": "980517493131990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314846_980517509798655_1403956792952814767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm8rpDcyNd8Q7kNvwEy1cyY&_nc_oc=Adr_I7FTrLvsFAJlRZk3G9Yo4eh3MnlxK4y9KfuMal1MQicgxyp7yBObRxiK3aCeOYE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XzSxRS19hvU7-abRePxaNLrhJGYpz7i17F6cZhqL3TA&oe=69D4F8F8"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere. But as you delve deeper into this paradise, an unexpected twist awaits, sending shivers down your spine. Just when you think you've conquered the island, a mysterious and eerie presence descends upon Banana Island. The once cheerful environment turns sinister, and the friends you trusted become sources of fear and uncertainty. Bizarre phenomena and unexplained occurrences keep you on edge, testing your courage and wit. The idyllic setting transforms into a nightmare, and you must navigate through chilling encounters, solve perplexing puzzles, and confront your deepest fears to survive the night. Banana Bandits transcends its carefree beginnings, thrusting you into heart-pounding horror.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabandits/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabandits/homepage", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "698351605389652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8045835755527756", "version": "9.1"}, "id": "1070946560550025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6030714157039936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8045835755527756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1070946560550025"}]}, "change_log": "BIG UPDATE",
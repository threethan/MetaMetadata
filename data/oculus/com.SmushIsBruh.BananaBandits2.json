": "fun.png", "id": "136968019401561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001681_136968022734894_1028304814703375494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2WA2pzZQa8Q7kNvwEqtTkT&_nc_oc=Ado1iT1Rg3YVY53urmt-unFrxmLqH0w4fNI5kB2v2W7hYvyfRbk9mGfsRH07HmIRUIk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WFqtg44V1sq6eOCO-btLoWHy5NOoS8BmDDfXxsDbwAQ&oe=69D65940"}, {"file_name": "temp.png", "id": "957707955372905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982575_957707958706238_5938069967316008619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U_TZ32ZvjQQ7kNvwEotE71&_nc_oc=AdpjpZSJgtxZuDzV_n7Kiij0Bcekrc_D6_G_j2NpfR1F3sYv-qMb9Hk4Aw5KwsQ9mkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TTOxOkG5NYfj2ziJGbqh6cVc6Y9a6DGG9y-FAyHzRqw&oe=69D65457"}, {"file_name": "lava.png", "id": "182154571184427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/43931335_182154574517760_1137497544566365008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlup_tL6lbYQ7kNvwFeulx7&_nc_oc=Adp9AZA63aXb4SNkvG5hIm6-Wly3XCpPHPnwjsqTwF2zVxP0FzQy87-sWiCWvRhYTdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bMqst5KwCHwSTuIcMxX5hX34VFgWzqwms0pnnsYmk8g&oe=69D641F0"}, {"file_name": "moon.png", "id": "178530471583006", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422375_178530474916339_5284833994792554760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8_g5RsLvKsQ7kNvwEWPIKh&_nc_oc=Ado2jX-hlJMFdeMoi-wqB6-CKw0Ms3Oxuh6HR-BChijn95WOfW1dYyzcFvxU4iFF4UM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TSvoGbAMiB6Mtot4NrA_SCRNfzhct0behPA-1UevoZQ&oe=69D64567"}, {"file_name": "Shops.png", "id": "736486361813385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572922_736486365146718_1965092028504960248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Aoq_g44FtAQ7kNvwE_uJIZ&_nc_oc=AdrYssB9yYkc0S0_D0dzpgOKGZbJJnRY9nEDWFB8fG2qE2Z35fVO3RGrrSlVeDK17hQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UXjM4J_0T4o5Xpxtaaks7DDvl1ic1e4I2V6Rat-D4bQ&oe=69D653F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banancover.png", "id": "980517493131990", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314846_980517509798655_1403956792952814767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnKvyBTD-_MQ7kNvwGz62pO&_nc_oc=AdpJi7TOJqoMVxDfKpaZ_MOKY9ClSd6tOpuA15bjC88uU_3AgXwJ-RbQj0tzzKd1BGs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nvRssQdse1KeXZEmDThAJ9thNMk61REM42z46h8OzHw&oe=69D64A78"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere. But as you delve deeper into this paradise, an unexpected twist awaits, sending shivers down your spine. Just when you think you've conquered the island, a mysterious and eerie presence descends upon Banana Island. The once cheerful environment turns sinister, and the friends you trusted become sources of fear and uncertainty. Bizarre phenomena and unexplained occurrences keep you on edge, testing your courage and wit. The idyllic setting transforms into a nightmare, and you must navigate through chilling encounters, solve perplexing puzzles, and confront your deepest fears to survive the night. Banana Bandits transcends its carefree beginnings, thrusting you into heart-pounding horror.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabandits/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabandits/homepage", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "698351605389652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8045835755527756", "version": "9.1"}, "id": "1070946560550025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6030714157039936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8045835755527756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1070946560550025"}]}, "change_log": "BIG UPDATE",
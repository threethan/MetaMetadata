": "fun.png", "id": "136968019401561", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001681_136968022734894_1028304814703375494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-dTFsydf70Q7kNvwFjNG3C&_nc_oc=AdrjPERT-7zfkwBsgvKbhVjO1sYMhwWcf5312YbBF7XcJBhchHzhAb78K3d0CJXuTEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3zvKdlgrOOnn7jRExNdfM7iVwsnFo2bfCTezqXUv7TQ&oe=6A6369C0"}, {"file_name": "temp.png", "id": "957707955372905", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982575_957707958706238_5938069967316008619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_oaw2-3-qMQ7kNvwHCT8wy&_nc_oc=AdrBraBh8AMJ5U2aVhSqpAEKM_nUFIRdOXQj8wZXuOLYJIwkWgxcY2VlfUEC60mU-X4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1cjnxOtE0mDCXLG2qSBJfulK9hMxhOAN7jzb5uSRptA&oe=6A6364D7"}, {"file_name": "lava.png", "id": "182154571184427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43931335_182154574517760_1137497544566365008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG_5lkrY8WcQ7kNvwH-cuv8&_nc_oc=Adreu_GMvEKTjS9B9HKoDUxgE3jE_yQrGaHRUjUQ-D0DKp3ldAFm9-PMTAQe7XsyYG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb7pcAK9IGemG1Lf2No7EEUSTB-ohyNjaZAI8o5ask0Q&oe=6A635270"}, {"file_name": "moon.png", "id": "178530471583006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422375_178530474916339_5284833994792554760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVrJOYeeuvsQ7kNvwGKWVJB&_nc_oc=AdqNXCB7Wcv8bPpypafF1YCpIKdQ91A1zDaeuequc2grAtZaom3ssDSb526YwasLc4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4IfCpbvZO8KLY0v5ZKa4IvQ15p2OUzRfgMxrO8SejA&oe=6A6355E7"}, {"file_name": "Shops.png", "id": "736486361813385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572922_736486365146718_1965092028504960248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9KuNd68v-kQ7kNvwEa5GoX&_nc_oc=AdpgkKCsRWRZf6lLEp5GmDxmc_Gr2qhV94m4OzTXtATROq_jh3mX9DNyyJNOHgqZGvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAX1B51bLWR_HtNMpeWCKMWP0HC41fRclg-IETNJOAmlQ&oe=6A636475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banancover.png", "id": "980517493131990", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75314846_980517509798655_1403956792952814767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dR-rOY7DvhQQ7kNvwFehiCM&_nc_oc=AdqL9d5M9IIAdeFCAoxioCfeDtGtyjm6t5i2WjqG6iBRvaU3ZuIF5XIdKhDtbFkvYSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlkAZxkGMePCYRQh1qXKEsgANH4ihPjpkv1q_Gv-GYMQ&oe=6A635AF8"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere. But as you delve deeper into this paradise, an unexpected twist awaits, sending shivers down your spine. Just when you think you've conquered the island, a mysterious and eerie presence descends upon Banana Island. The once cheerful environment turns sinister, and the friends you trusted become sources of fear and uncertainty. Bizarre phenomena and unexplained occurrences keep you on edge, testing your courage and wit. The idyllic setting transforms into a nightmare, and you must navigate through chilling encounters, solve perplexing puzzles, and confront your deepest fears to survive the night. Banana Bandits transcends its carefree beginnings, thrusting you into heart-pounding horror.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabandits/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabandits/homepage", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "698351605389652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8045835755527756", "version": "9.1"}, "id": "1070946560550025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6030714157039936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8045835755527756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1070946560550025"}]}, "change_log": "BIG UPDATE",
d6-1.oculuscdn.com&oh=00_Af1xo_-L5hsFWDldPO3kmCFWr2tF_PvdMSVXPvVhj4JL9A&oe=69F0B080"}, {"file_name": "mainmap.png", "id": "1439990199968053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223483_1439990203301386_8370248129068737201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3b42Gc9I1EIQ7kNvwGJUrBd&_nc_oc=Adr-jeexZ0PMm3BTF0S_Q1miQztbxlan7sLAm3g_tgDo4T9Uha7XWDRVELg5XOErWcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3MwzZjrTGkx6y4cx42taOiuozM5oxjXv8gZEOd_mh6-A&oe=69F0C71C"}, {"file_name": "phase1.png", "id": "831244695285632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75240097_831244698618965_223591266736454257_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCCPwQH_mEAQ7kNvwE4j2Gl&_nc_oc=Adqzn0isDUSYfutNsosxEJHzHUsBSC6v9kXUC0vaBIzAZ_Ips9njgOQkl5HoFBcAFcI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1gh6a-wzuHf3Yw8rqN9-FZUnVs2EDkAuw-G-FV71wJVA&oe=69F0D1D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BBV4HQ.png", "id": "1109541873447174", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75286673_1109541876780507_3130610501696226855_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTl0mnuB3TIQ7kNvwEeFN7L&_nc_oc=AdrzGiKFjNwQYRdzK9x-I03HCqx7mlipa_WzPretdCsQgc3YI_6HA6wZaZ4ZhRC1DGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1QdXXAEZce9-ju0LlgcvxUuiTuZEtbThSO9XCwKOe6Ag&oe=69F0A13C"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabanditsvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabanditsvr/homepage", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7498642530247084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003240_1178173769986762_6006335579391615288_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1An9C7EfSMcQ7kNvwFtlJG-&_nc_oc=AdpTNLoWyC9q_SRI6CjGMr-9ilEBQBxh6CKkI1oO8UVqPIpi_atJ-gkasYjrX6Px-Bs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0kfewy9rthOR1Js_Je5iGTSaP0qn0sq0GmdD9dZWx_Ww&oe=69F0A383"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banana Bandits", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1688849100, "las
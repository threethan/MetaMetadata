": "fun.png", "id": "136968019401561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001681_136968022734894_1028304814703375494_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7q8BtwwK6oQ7kNvwF4d-hh&_nc_oc=AdrHpiOSkFIup6XqzcQv7HlaS4eb0B-zKmvVe5bENRnj00KTSgaKkodv3h2XieuhU_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C_XzGEJF1vmrEgt8JkGtcqRNRMiSN1U2oLfmTe8EN8w&oe=6A3A8B40"}, {"file_name": "temp.png", "id": "957707955372905", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982575_957707958706238_5938069967316008619_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lreVM2IlO3EQ7kNvwGxEH0x&_nc_oc=AdoDI7PVyQnA84FzAwoTeukzdjhUIxF5CwAi1N325R2nU5JDPlfNzEadbKqTKzP4980&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eHVjdT93xwvlvRwq-vXbNfyuTVOSN6KEQwHiGK2aXbA&oe=6A3A8657"}, {"file_name": "lava.png", "id": "182154571184427", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/43931335_182154574517760_1137497544566365008_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UgohGa0FK4Q7kNvwGLfAmE&_nc_oc=Adon9p0jglL9-SKY19_LZz4rhisKDEfg58IdRyCwzxW192wnms0haocq604KG_PB6wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qx6YW0K2ESZRTCeXQxQukBG364J6S7O4Bggn7GGi6ig&oe=6A3AAC30"}, {"file_name": "moon.png", "id": "178530471583006", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422375_178530474916339_5284833994792554760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXyL_2ji2CEQ7kNvwGi-tZL&_nc_oc=AdrNvZ6SuGcnYRY2Yy1eY2NpSVzTv-5AuHofMKKb__KYveYvDIKZ-EFCIlTVrbj8OVg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jIHaXInyzXxRSSDE3RMIuZaayo1wQsfR4ExjeUQ_cDw&oe=6A3AAFA7"}, {"file_name": "Shops.png", "id": "736486361813385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572922_736486365146718_1965092028504960248_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEflAamL1sgQ7kNvwGX_BOu&_nc_oc=Adpbd4gUxptRlLyomuGAk4vlmmKFRd2HaJwIINw99d5iQAyVyVK_jw_lBxif7zfOdcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-54Lze2xX0lWNcmZ8kZo4iaMbLxWWS0zWlIufbH4Vq9A&oe=6A3A85F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banancover.png", "id": "980517493131990", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314846_980517509798655_1403956792952814767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Re_-MbOTqMQ7kNvwEA09Gj&_nc_oc=Adqre2tRCX4dy0V-pYujP2NrkIkX15CL6LblPqDp4nUGQzCJn9xc_Drqrqeh9Ta__aA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zDUierOvelN5VmMmgqSyZOpaoG0j_QwtGRDAcx1z5JQ&oe=6A3AB4B8"}, "display_name": "Banana Bandits", "keywords": [], "long_description": "Welcome to Banana Bandits, a captivating exploration game where you'll have the time of your life hanging out on the picturesque Banana Island. Dive into an immersive adventure filled with laughter, camaraderie, and delightful surprises. The vibrant landscapes of Banana Island will leave you in awe as you traverse its lush terrain, encountering a kaleidoscope of colorful flora and fauna. In Banana Bandits, your main goal is simple: have a blast with your bandit buddies. Swing from trees, participate in thrilling mini-games, and revel in the island's tranquil atmosphere. But as you delve deeper into this paradise, an unexpected twist awaits, sending shivers down your spine. Just when you think you've conquered the island, a mysterious and eerie presence descends upon Banana Island. The once cheerful environment turns sinister, and the friends you trusted become sources of fear and uncertainty. Bizarre phenomena and unexplained occurrences keep you on edge, testing your courage and wit. The idyllic setting transforms into a nightmare, and you must navigate through chilling encounters, solve perplexing puzzles, and confront your deepest fears to survive the night. Banana Bandits transcends its carefree beginnings, thrusting you into heart-pounding horror.", "short_description": "Banana Bandits is a game of exploration more than anything else. Explore the world of Banana Bandits and hang out with friends to have a good time. Who knows, maybe you'll find something lurking in the shadows..."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bananabandits/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "SmushIsBruh", "support_website_url": null, "website_url": "https://sites.google.com/view/bananabandits/homepage", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "698351605389652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8045835755527756", "version": "9.1"}, "id": "1070946560550025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6030714157039936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8045835755527756"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1070946560550025"}]}, "change_log": "BIG UPDATE",
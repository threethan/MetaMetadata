c=AdoKvhrYyvj6dEpp_zLKCPmmNflPVNoROw-57fSxGzUfhJaczgRUdskzaFa1aCquJPM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LGOTtdGf-nl5vsHuy-yG9NM6gRFmutVM7jCF7unD1ew&oe=6A4291C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "992425905834110", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984445_992425909167443_5510192887569671041_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL59OJmwZzcQ7kNvwHYxq64&_nc_oc=AdrwagBWHr7BbTdnqotsSo6aPn6ddRRGWFIJFqRKIQTJmreFjXynX8MinroOcZ2SY_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hRtkNKVo4UOZGa9YQkpd0winQ4xqoLUvR9mmma4UG0Q&oe=6A42684D"}, "display_name": "The Vacant", "keywords": [], "long_description": "Step into a world where a walled city, designed for controlled military containment during times of war, becomes the epicenter of an uncontrollable zombie outbreak. In The Vacant, you take on the role of a lone soldier on a mission to infiltrate the quarantined city and uncover the source of an unprecedented infection. What begins as a reconnaissance mission soon evolves into a desperate struggle for survival and truth.\n\nNavigate through the desolate city. Gather resources, scavenge for weapons, and uncover clues to piece together the events that led to this catastrophic outbreak. \n\nAre You Ready?\n\nThe city is calling, and its secrets are waiting to be uncovered. Will you be able to navigate the dangers and reveal the truth behind the outbreak? In The Vacant, every step you take brings you closer to the heart of darkness\u2014but the real question is, will you make it out alive?", "short_description": "Step into a world where a walled city, designed for controlled military containment during times of war, becomes the epicenter of an uncontrollable zombie outbreak. In The Vacant, you take on the role of a lone soldier on a mission to infiltrate the quarantined city and uncover the source of an unprecedented infection. What begins as a reconnaissance mission soon evolves into a desperate struggle for survival and truth."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/copy-of-brite-light", "developer_terms_of_service_url": null, "publisher_name": "Gaggle Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7802997159751916"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1211327387637739"}, {"status": "PUBLISHED", "id": "1684508245593367"}, {"status": "PUBLISHED", "id": "1278664593621523"}, {"status": "PUBLISHED", "id": "1895011601272274"}, {"status": "PUBLISHED", "id": "1801262640606954"}, {"status": "PUBLISHED", "id": "1446017406557105"}, {"status": "PUBLISHED", "id": "1115014706425198"}]}, "baseline_offer": {"id": "1801262640606954"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1211327387637739"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9850923918292553", "version": "20"}, "id": "1910523562715439", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7792992
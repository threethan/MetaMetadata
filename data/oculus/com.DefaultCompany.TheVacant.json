sperate struggle for survival and truth."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/copy-of-brite-light", "developer_terms_of_service_url": null, "publisher_name": "Gaggle Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7802997159751916"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1211327387637739"}, {"status": "PUBLISHED", "id": "1684508245593367"}, {"status": "PUBLISHED", "id": "1278664593621523"}, {"status": "PUBLISHED", "id": "1895011601272274"}, {"status": "PUBLISHED", "id": "1801262640606954"}, {"status": "PUBLISHED", "id": "1446017406557105"}, {"status": "PUBLISHED", "id": "1115014706425198"}]}, "baseline_offer": {"id": "1801262640606954"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "1211327387637739"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9850923918292553", "version": "20"}, "id": "1910523562715439", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7792992690752363", "is_concept": false, "latest_released_binary
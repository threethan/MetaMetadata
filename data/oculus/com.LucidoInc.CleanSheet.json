culuscdn.com&_nc_ss=7f20f&oh=00_AQT7dxq87w8R3qsNCCLawOhQ4SEvMx4ZqUkosMccv_IkoQ&oe=6AEDE25D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l26dqQZ64qUQ7kNvwEIgquO&_nc_oc=Adq622PscF8OCFo1dVBHwzzNsoyLDEPULfd195jDDXgk_BYb6JE7egTH31obT0kr_YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFLm5E22G0r14THhCx87fzQLzUbPwQhAiA-EhXNDABhg&oe=6AEDEC2C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiFL4QBKI3MQ7kNvwHmF3Zj&_nc_oc=AdrOqurMTdHydw4t93mA1xA0ajAxwS5RaV-sw3vlYS-zfTZge_pEot3M2-ynOawJb-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn_JH6qXrqskv4Rhh1-xDRKcObGnj0Z4Aj_sENNjEHBg&oe=6AEDE7DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
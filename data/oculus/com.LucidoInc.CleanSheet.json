culuscdn.com&_nc_ss=7f20f&oh=00_AQQORVGf79VlerGEA0yLLLpEQxKCC5i_WvdAoNb_baVpaw&oe=6AE74ADD"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hlqGlWOaI0Q7kNvwGCdK2Q&_nc_oc=Adqw2ZYHdJmOSvbLgX6tlhDfUfgh7h8KFMNWBl8pc0dPxqt9BBXU1dEaWfWGOQzawT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeSyrigqfr4rjiml2e99s7Ox8oUdWvFQF-_bKabr5OlQ&oe=6AE754AC"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnnT08M8MYQQ7kNvwEwt_5k&_nc_oc=AdpQ6y_UvElIDpAIp984_0S53O1C2Un08e4eOCAVb5LXwRuC8UKLiqjFOfYqwel87RM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCK-noIDVYKU6ocGSBPmY2hM5OD6X36eRqlW3GWHb5Sw&oe=6AE7505F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/KeeperQuest/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9960576720728392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499335562_725382193328624_6987853052210114276_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzgQri8pD_IQ7kNvwEzEzB7&_nc_oc=AdphR2HMIh1HIAhyrlKVigl9zR0ZeSdR5ajDLy6wMNeuzDPmPXZQK_b6Idn1sVjkMfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcXxbv1equVCECMbXO4A2JUgZ28tej3ZXo-Q-BknnMYw&oe=6AE73F95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keeper Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1749844320, "lastRevision": {"nodes": [{"id": "9750642671721799", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9750642625055137", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": 
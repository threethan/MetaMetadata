71-25/499316597_1278628206962303_1496773030488369343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUAP2_ZLZ7QQ7kNvwH0DXaF&_nc_oc=AdoubK0brGcDoIbapWbLKznZuU9_tSI8HgrLYJ9njA7K_UjULntzIMPPlQ45FPiFYMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsgtbwu0x_IC0m8QfCzBSZhIz8FVAHsRGUaA4PqWIrvg&oe=6B03329D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLqK2DTntgYQ7kNvwHwqBBe&_nc_oc=AdrplG60WdFM12qNvn5BZGw4CCGQEWlBhOXHirI3o1pbbFa0q3HDaHrukdMkf-8wuD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShZ15TKO-r0qJk2qB3jM5U_ntaE9S92LZ0YCVyh758uA&oe=6B03042C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slnY3u3VjY4Q7kNvwFweTlA&_nc_oc=AdowmsqW5GwR3vmq8d7Khj0SljkAloN4sfE7Oqzcn4Gjtmh8PCfbzmjW1zZtaepsMkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuUoVqKlHicCFJFRC-uWVanwV_AEVn37uyNz1mbMoh8A&oe=6B03381F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/KeeperQuest/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9960576720728392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499335562_725382193328624_6987853052210114276_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQpS2WgUs8UQ7kNvwFzO4KJ&_nc_oc=AdogMiHXyxqhHr-_A5w3qkfYm4PpcjWrHq_4177VluWTHxI7AgX0sTMrms_C5RWgSzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREYcvuOONo1aaIxuwcWPq55smPBHkmREHKdW5dgdSrTg&oe=6B032755"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keeper Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date
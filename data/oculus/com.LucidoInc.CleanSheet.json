71-25/499316597_1278628206962303_1496773030488369343_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJ1ndTg42U8Q7kNvwHbbKMb&_nc_oc=AdombUqCxsjmx3_oSjFoxBuZNijyJ8Vzf8xOkIahfchKqCQIfGK7e22ngQ6fh3de3VY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRye_UjfW1r9Sr4Xmte9skQbsrKX3iDYLKphI_2aQmChw&oe=6B0B1B9D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2qHHq09R60Q7kNvwF2mMoR&_nc_oc=Ado_hSGyRuNyrNKgjuk7DSWwWvjyn_G69Fcnw4-lii0VedJgQ6nbXj17OlvpdCb7rPk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9IYdh-gGKG1YGytSM-hvWH0O9D3NCN2VYSTfbPEBMPA&oe=6B0B256C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnBWAcHy4ecQ7kNvwFFrq3k&_nc_oc=Ado5Gvh_31oP2Ev33BveTl0cWj_FmoozouOZ7ek1SSTQXzNoH0zXeIItqv85Frz1jg0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7Q0fkK2EdwK4jc6EMZ6nbh6Nncaqug47By-w43M_fDA&oe=6B0B211F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/KeeperQuest/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9960576720728392"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499335562_725382193328624_6987853052210114276_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zB42ljUdtHsQ7kNvwF71R6i&_nc_oc=Adp01jaTFPTTUmc11BbxJWZ4Uy6k7mPJAxnHbNccn304Gp0cc2VqLApIMd6CPvPP7cA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNMD_KD5rFaqKkNR1Nw-FQm7tiU7qW-_ow8LLqt958Yg&oe=6B0B1055"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Keeper Quest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date
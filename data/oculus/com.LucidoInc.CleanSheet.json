culuscdn.com&_nc_ss=7f20f&oh=00_AQT2w9Q3EvAd328gDSlvXHQjdt6TRf58bQaLzU5o4no4FA&oe=6AE89C5D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hlqGlWOaI0Q7kNvwEPSo87&_nc_oc=Adp9ai2GwITDUB9vTMsY4o7OZiGltLhIFOZ-aJphhFrOuld5WJN11FPg1Ri8T0B7YmI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyxTfBFdD36R-9zHkbXmOsyKytPlOpUNlUOZ0bINEE6Q&oe=6AE8A62C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_YhL8Ww3hoQ7kNvwHb1f6Y&_nc_oc=AdqfHiVzN4n2WxjxVhjA7yWu--yky9juDYSyA_Mj-pLQM5tqLeltO5gqtqVNiwoUFU8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi63E-WiKLNc7EvcPEkWSycTtHjhhk_iKoKihgbxauJw&oe=6AE8A1DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
culuscdn.com&_nc_ss=7f20f&oh=00_AQMdzLCIi2JSs3yO3CBK6jv1Z_vAORylU5gtdqRnYdFfIw&oe=6AD3845D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjgWGIrAB1sQ7kNvwFIYr5y&_nc_oc=Adoemy3zZa5SfiqKSuRArz34pmaFc6gIOFIHFjJzqPiegYweCiOlPdqTauJgG0tPBZk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0GNxV-03NpaIP4c3lBMHYbpRssOsMq2NQXHoHOgZpPw&oe=6AD38E2C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTrRkIbCbT4Q7kNvwEi7Fij&_nc_oc=AdqUshank4YfkMadhdKilBoBR5DPMMmOKdArF4Os8ymsH_lnEFG9RIA_K_E2hRG_hK4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNuWLchZy06_UG4XN62jnWgXeXGBHoEc1rbN_gmDQL7A&oe=6AD389DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
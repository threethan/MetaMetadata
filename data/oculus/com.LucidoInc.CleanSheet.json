map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slnY3u3VjY4Q7kNvwFweTlA&_nc_oc=AdowmsqW5GwR3vmq8d7Khj0SljkAloN4sfE7Oqzcn4Gjtmh8PCfbzmjW1zZtaepsMkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuUoVqKlHicCFJFRC-uWVanwV_AEVn37uyNz1mbMoh8A&oe=6B03381F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/KeeperQuest/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
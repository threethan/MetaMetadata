culuscdn.com&_nc_ss=7f20f&oh=00_AQIvRR6moLNb5f6ezX3vhxpHXljHX5wY6CFqQf6gUrXbVQ&oe=6AABF75D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJUWvp_pnuYQ7kNvwFOp7dr&_nc_oc=AdrUd2XutSOZeJ_BddREFEWv6IZbQKE9Cr_ydCFobE_kqED_-5Wtveua3rXC3NhjqHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIfmYZ9HDnL2gOEHs63AXMzPKy9cF-nqxT-4QURRaqTg&oe=6AAC012C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThlpYf00ug0Q7kNvwEZv-TG&_nc_oc=AdqZaBnUORKvko-W_qbveFtU9198br_UlCum9MnY5poyCX3_RwsQ37m6yb35CxRsbB4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh4YlRRPkhL_4C7MM7OiRB8y_yLUMivA_D81Xpqx1BDg&oe=6AABFCDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
culuscdn.com&_nc_ss=7f20f&oh=00_AQKF9BwQLTmhKDgWP-LR172HJq_M0TDUfqn0vPdwgGnkbA&oe=6ABE6C5D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7I75_NsjmE4Q7kNvwFQroX0&_nc_oc=Adox1l2_r82Vwl0JOJ8ASXyTtGo3DlFkKCNigNKTSPK9K-FEQICNNKUM6DqW1l_SxSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxvlvV1nOVcR05R46jVd2lfPkr2kfEo1RPV5PJNP660w&oe=6ABE762C"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FufW6lKsky8Q7kNvwG2qmcX&_nc_oc=AdoQBgfKOlNnAX-Ommo6vYPhW9daFk1G9akJ1wyxsTX-Izn6DWagrian7ms8o8fLENs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDJi6iEWgBSfG0xoSxAGPn4nRA450r2k5UFxq7KjI39A&oe=6ABE71DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
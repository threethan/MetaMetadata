culuscdn.com&_nc_ss=7f20f&oh=00_AQHW8fkiUfkuI_qTFDWUSg9gXZbr7IKqHtVKNJqEjWC_lQ&oe=6A95C61D"}, {"file_name": "7.png", "id": "1674946497238193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499331248_1674946500571526_6332660065823078284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMjFS67M-soQ7kNvwHUS7Rc&_nc_oc=AdrC8ucOy5pdPEvhGTtzPj5wWPCaKRXv6UuGIjSkBNNNP2gUrFIQJ-lkMGfv45-pHSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUxJcjOZH504ovMBdYXHEU-NUWcLZvGUj_Rz053DYNvg&oe=6A95CFEC"}, {"file_name": "7 (1).png", "id": "1118065447015645", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499332380_1118065450348978_7104769340704766357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvmyU62vYJEQ7kNvwEqs8d6&_nc_oc=Adq2KPGhEh-ulG5Zk41h9yUqwAJk0b-1AJOXRh9wH9AJjE-WUNCAgaYz4qUJIjLbJis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnfq03af9jjZUm2A1mkBkscq7hB7DPCSbhte5tUYXJpQ&oe=6A95CB9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Keeper Quest", "keywords": [], "long_description": "Become the ultimate goalkeeper in this immersive VR penalty shootout challenge! Step into the goal and test your reflexes as you face a wave of penalty kicks from increasingly skilled opponents. Track the ball, dive in the right direction, and block as many shots as you can to rack up your high score. With realistic ball physics, immersive stadium sounds, and intuitive VR controls, this game puts you right in the heart of the action. Whether you're training your reaction time or just looking for some fast-paced fun, this goalkeeper experience will keep you on your toes. Are you ready to defend your goal and become a legend?", "short_description": "Step into the goal and become the ultimate VR goalkeeper! Face a series of penalty shots and use your reflexes to block as many as you can. Are you quick enough to stop them all?"}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.lif
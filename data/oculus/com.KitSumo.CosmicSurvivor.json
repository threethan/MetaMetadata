296279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj391hbbhiAQ7kNvwGY5_FJ&_nc_oc=AdrV-cqkHCdRxr4p5B290-0WtpSARmQhxX_2Vqyphjt4c0UqdV2NNp0vElPB2shokrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1FYi957wX-b-pz3RScA7ib6De49i-aCx27d1gYsJ5fQg&oe=69F1F121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CosmicSurvivorGlimpse1080_Moment.png", "id": "1174756509926194", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031425_1174756513259527_6009818579401571909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-i6Z1jAmKJgQ7kNvwHN8pGf&_nc_oc=Ado6u8O_1MrYZpqXP-_WKAVPYo7UX3Bv-bnURyfOE14wPzNauMHm5oa0TJ6OLg40eF0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af14GBt8vMm5kcKfDZpG82lszA2n4aYm8CplWgADZtW3RA&oe=69F1F569"}, "display_name": "Cosmic Survivor", "keywords": [], "long_description": "It's a classic arcade game but built for VR. Simple thumbstick movement controls your ship. Auto-fire by default, the trigger and grip perform specials.\n\nHorde like gameplay where the enemy becomes more challenging over time. Collect power-ups to stay ahead. Target game length is five minutes but infinite play possible.\n\nThis is a concept demo. It's envisioned a final game would have unlockable ships, roguelike upgrades, regional high-scores, music and an art pass. ", "short_description": "Retro horde/survival arcade game set in SPACE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kitsumogames.com/home/privacy-policy-cosmic-survivor", "developer_terms_of_service_url": null, "publisher_name": "Kit Sumo", "support_website_url": null, "website_url": "https://www.kitsumogames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"]
971083", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974676_2388387951304416_5160720026736296279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhdaPA7oSZ8Q7kNvwEEpN3d&_nc_oc=Adk4dPRvZ9cTTznAX27f0W0pc4swmJy1Z54-pDM5gTpcXAFhVv2yYc22IJddUKipW7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzy_M_psm_slyzP7bFbGP8K_0ZZWyIXyQYeLSguTmOxhA&oe=69B7EF21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CosmicSurvivorGlimpse1080_Moment.png", "id": "1174756509926194", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031425_1174756513259527_6009818579401571909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb3ojUQYREUQ7kNvwFLmyVz&_nc_oc=AdkEPeJ4ASE1YVoUhvcE8dTgnMv0cofzMRHijAMuWEilUGaKVvRevvRQRXgC_kP094I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzC-kNqeGcvTXGehV6YIDS2hkriquMkHTWTO9D9uK2pFw&oe=69B7F369"}, "display_name": "Cosmic Survivor", "keywords": [], "long_description": "It's a classic arcade game but built for VR. Simple thumbstick movement controls your ship. Auto-fire by default, the trigger and grip perform specials.\n\nHorde like gameplay where the enemy becomes more challenging over time. Collect power-ups to stay ahead. Target game length is five minutes but infinite play possible.\n\nThis is a concept demo. It's envisioned a final game would have unlockable ships, roguelike upgrades, regional high-scores, music and an art pass. ", "short_description": "Retro horde/survival arcade game set in SPACE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kitsumogames.com/home/privacy-policy-cosmic-survivor", "developer_terms_of_service_url": null, "publisher_name": "Kit Sumo", "support_website_url": null, "website_url": "https://www.kitsumogames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974
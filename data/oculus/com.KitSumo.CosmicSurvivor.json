971083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_2388387951304416_5160720026736296279_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MeDtxykDoMQ7kNvwEEyIG5&_nc_oc=AdnQkkK5KiAtRGfdURLUOGzRNlQORxI8ODOBsEcAufKK6qd6504zUDs4ObPTKONrPJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDc2khMx6AtnCWWwzXuaZr4qxqdck1NXtn86R0wmJ4NA&oe=69BE86A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CosmicSurvivorGlimpse1080_Moment.png", "id": "1174756509926194", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031425_1174756513259527_6009818579401571909_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv2x3W_Y3JwQ7kNvwHGcwET&_nc_oc=AdmmPNs-RrMlII21aVPPA4FObVSHSz-Mayg30sdH2ncasfqcWdPvgPsRycef7M5Fkfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy20YGYI09dXfMQnxATD7aMCYXLfX0ZHeAXNwwmJiZyfg&oe=69BE8AE9"}, "display_name": "Cosmic Survivor", "keywords": [], "long_description": "It's a classic arcade game but built for VR. Simple thumbstick movement controls your ship. Auto-fire by default, the trigger and grip perform specials.\n\nHorde like gameplay where the enemy becomes more challenging over time. Collect power-ups to stay ahead. Target game length is five minutes but infinite play possible.\n\nThis is a concept demo. It's envisioned a final game would have unlockable ships, roguelike upgrades, regional high-scores, music and an art pass. ", "short_description": "Retro horde/survival arcade game set in SPACE"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kitsumogames.com/home/privacy-policy-cosmic-survivor", "developer_terms_of_service_url": null, "publisher_name": "Kit Sumo", "support_website_url": null, "website_url": "https://www.kitsumogames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974
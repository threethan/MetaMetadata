uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvjTe0BF0P4Q7kNvwGKcZQ8&_nc_oc=Adr8qG5ifusyo9T8VnmjaV-CV8knxctbXag6-3XOwrpEikaf3iKQecK_C1U-BpGO_bM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrtfcyNYDZXqBpBcIvp2ag5-8wLYJ8NL6_PzB6mSSm9A&oe=6AA3F9FF"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEFwyaqmJxUQ7kNvwGe-1eP&_nc_oc=AdrrJMtmd547a7EByZ6YK4XGMXPQuOqHCmnWyQ2sKYPqeIFrOGN6aaGxWEt1euMUEzk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEbXpsapFN-MPbbY0xBLYherLldTD0tBcnnRbDBqGNcw&oe=6AA3F981"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz0KWxW8YDkQ7kNvwEM6AJn&_nc_oc=AdrVnqLM_FCWj3anFpNgUxGrXWwh45zLivW2RiejxX5vTvOU43gD4JH_uoAUl6plNPg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrIIvNFezwjkWynRsP8q2NhDipWoFSpiMlr39MjDioaA&oe=6AA3FDD3"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fhGmbp2y9YQ7kNvwGFaE_g&_nc_oc=Adqi8pUimiN66_str5P2rphRh_L9w_259nHgBvpkOzLtzvUEJZy9f9Awj4Trb62OMu0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfO0iBqEi8d3-NWIn6_-3P6Tpq5fLcQ5qPs5Vnhde2og&oe=6AA421BE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=We1-7MGF4qMQ7kNvwE1kF2O&_nc_oc=Adrx5Bu2g4KXSFJ9nGE54X6usCAhGp9YFktZMKGDlV_c1LiT_1LZnGqcjQY0sHO-owE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC2lNtpmvwGyExhF8Vw21jagEdNGbRWG4p_UBQOKj6DQ&oe=6AA40E14"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6w8iXCBKQsQ7kNvwG4TObz&_nc_oc=AdqJTYOwIjWbwFdB6fgC3UE4rzupsZbkLpUXkdjq1qOyGg_huXyuD9q0v1P3i8P7Bqg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1bYjyLz3TpecuNBRoRAVK93Qol56vK1FvHab_hRDswA&oe=6AA42429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RBJh5ivxZcQ7kNvwFvoUQy&_nc_oc=AdpOQLokdcP1sjOj17xigYAZrXwB2C5RVYOLikCcZhvds5MsCKJdqrEBkbPm3VI23Y8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZASY8DCxQ3_58sOSrkdhtLmZN_KewhXCygZIUXQS0hA&oe=6AA3EF3C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "su
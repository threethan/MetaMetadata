=00_AQOxOtE4PPp4wOBJWiPO_6Ayh_qEpiKgwEUf1cQqGRRVVg&oe=6AC13713"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-HWB7KpIKoQ7kNvwE1U5dO&_nc_oc=AdqpDAUeh2uHZZzVkGSxMLxACgOK9I49Wh1HJHBl2_PmCqhPuuNeWYQQvKrp5na_NNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKD3Xrd3ytDzt8pJCFWrMp4r50a3b0u84SsmIsuhbHww&oe=6AC122BE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqxo9d26ExUQ7kNvwFIGbqw&_nc_oc=AdoVlo3M_vYGTz-3t7cAhZYJrx6rgCDd15hWD8-7xxflrklSGKVOm5awHyKooAUwicM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZbLw_UPbE8AN7ox6Rvewt9b6eK-l6h2yOjuDC6ZfjKQ&oe=6AC10F14"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMv5JQITg6wQ7kNvwETrdjl&_nc_oc=AdrhT-QaFVTu5vpfCvhL6WwuIUJIFu1Mb0py123DcqGgXjpUS3sfZvdNmZtrZQrhaBQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyt7GzTypTdHPfI3NSjO34NfC7tI8dMZYnDOOGVZngTg&oe=6AC12529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrQgwcJ747AQ7kNvwGRTU_k&_nc_oc=Adp2-FKgwGgkfqeVSt2Dm14878nZ5ICYb3l9PmFRNFUzrwlcWUkBT4G4wvMmDMG94XY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlBu7jq2Jie5kjl8Gx1-1rTOOpuuLG625Qp51Nu-lZtA&oe=6AC1287C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https:
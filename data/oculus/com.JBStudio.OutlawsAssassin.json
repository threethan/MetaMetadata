20f&oh=00_AQH9YI3rCEFU1Da3OikNXS4842-vRMoSiITsdjbHKsUNkg&oe=6A9160D4"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrB3pF7d2SgQ7kNvwG7lEpC&_nc_oc=AdqrPSrqaFqtXSe139B0fFyt4dMdBtjbGayQ9lgCUQa2G96u50JJSHDgP1QEPbRhMuI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG93Rbv7u5zamQXJtmHQkWe4aLc133iUE2goGrYvXW8Vg&oe=6A9176E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGNWwmDps1cQ7kNvwGJroTz&_nc_oc=AdrR6cbJBI4R_ald-6fMIq5Qh7jp_zhi4zvWUFzPOgi6RnKtRlCUSFqFIFfW1pNF74U&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExLkYX51ktQXKBJ-St23qu5nThRyeml4waJbxL68y5Ig&oe=6A917A3C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": 
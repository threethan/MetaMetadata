tent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_850142477592448_3047983245491594332_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tkc_eIDG-O8Q7kNvwH2_hiX&_nc_oc=AdrIMzwgRbz5dFyO8LNZc4XzOcPPhYrRasgxsfjP27UoMzu5SykqpCYkIlX2Gzq_tTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO43CnSswizlkY1uyxnh27DWgYDD371WnKmJ4OPsJbjGA&oe=6ADF5E57"}, {"file_name": "ScreenShot 4.png", "id": "1632763717928190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_1632763721261523_7956449221636368690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OU4yyq5NYIQ7kNvwHlIftT&_nc_oc=AdpXUGf94mdMM-67WFzVG9APT4Q84so7TshCf3mh6QNdza1CiMVOomqh07AeiLW1Sgc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPtncUum9c31kXej_pv8RZphNsVj0ALZhDWRkLScsmhw&oe=6ADF74AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "964039069392569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618938_964039072725902_1950645181060360650_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xr7TVpGppV8Q7kNvwHGcmVL&_nc_oc=AdqFU3faZ1X-PLp2ZvLcq8X4t8DI0yJizY69QSdsVPKhHly0MWXjIJ-xBlvexI7Zh0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyGRkJzDSTYxR_rRb-UCPSBkRKCqyu5zQ6Sze4qDHPcA&oe=6ADF733E"}, "display_name": "Outlaws Assassin: Western Justice", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\n{1022958117424495}\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "A Wild West VR shooter where you use a magic mirror to peek around corners and outsmart outlaws. 36 levels of gunfights, hostage rescues, sniper missions, and boss battles across desert towns and saloons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39310584811919086"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619832_2250778888664282_7975519266909651246_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUZOfpyft8QQ7kNvwGAdO7W&_nc_oc=AdrzAMJWY3cfj4Q3WWezuxG2qK-kc3T6pfiYo
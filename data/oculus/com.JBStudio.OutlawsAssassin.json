 "977891954756284", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618442_977891958089617_4489337211493644513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDJZLn_PRZQQ7kNvwHK7E4d&_nc_oc=Adqx4d9FUJ4RV6vKX-8nCzolkXQxQhKJ8x4IEzbMxc49y5afLQFdh_SHP892w0FqrIY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgnPuVxM5ACZEwB9f7kF1hAJKb4Gl1Fhxwe917fZXcDg&oe=6B09BD9E"}, {"file_name": "ScreenShot 4 (2).png", "id": "850142474259115", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620856_850142477592448_3047983245491594332_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Sk7F1YRGwQ7kNvwGc9pA3&_nc_oc=AdoXmqC_9ODKekfLu3pMPZFX4B1EDZiKlz5jmzJI2-BP08gnA_8GB4Bo3hwZ8ggbB4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkDGT_SoDqWdohbX_Ex8mDtM9S-kh3feqiBvkrmQlmlA&oe=6B09C697"}, {"file_name": "ScreenShot 4.png", "id": "1632763717928190", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619808_1632763721261523_7956449221636368690_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wFH7TQ_KpUQ7kNvwEc2NMh&_nc_oc=AdoA3nTbjbQ4rFbTAHM5f0bku3thIbRfdl0vmlCH-2wiTDZKLH_IjM4me6BfNcVZPmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqN73oVwePIJC-jAjR0fpOy9SDEwrbkpW6TIh6rXY3Q&oe=6B09A4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "964039069392569", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618938_964039072725902_1950645181060360650_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W-YsmMHjMUQ7kNvwETTivi&_nc_oc=Ado260zbkfaE_3arpYZl1fRjFLSAbdE5Idm7bKLwBTwkxWp_4djv6PoObPm9W7DWki4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU-_hcIAW7_izuMzDDYblIIdz0yZGDqhAyntRF3wIaYw&oe=6B09A33E"}, "display_name": "Outlaws Assassin: Western Justice", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\n{1022958117424495}\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "A Wild West VR shooter where you use a magic mirror to peek around corners and outsmart outlaws. 36 levels of gunfights, hostage rescues, sniper missions, and boss battles across desert towns and saloons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
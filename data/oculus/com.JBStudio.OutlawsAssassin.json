-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRojuekwoJwwU62I6hvqRFr3d6UQXgUdG61t3VnAZVRsA&oe=6B03024E"}, {"file_name": "Screen 1.png", "id": "583495764558424", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391859_583495767891757_6719325596440377949_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QQ5xjBJB7MQ7kNvwFko9PB&_nc_oc=Adrv8vD9J8d_ck-tKA3UigWmIsPownhnozttx9FzpwceO4k5BuDoz49cVWnBULdCxpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZoEWypb12kE-QtfZkbuCNLNTZMjGP5Wfa_YtAAp4A9w&oe=6B0333D3"}, {"file_name": "text.png", "id": "571453952603934", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPxKkS5iu3MQ7kNvwEYJV_V&_nc_oc=AdoYBxrvtG8ZmT-v26GJzCvTq_rU0eAvCl_w3b1z3os7aUy7BF5H0SDYhmfoxNT--9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNZ-bzMnlqsCLKA_xhNHSTCMWllVCZ6YTz9SxHIyDsyA&oe=6B031E3F"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeinKZwRwQUQ7kNvwEBDbnE&_nc_oc=Adqbx3wKNOxDO5awV-lP1_YxZlL1fPw7I4jhzjVrUN83MvlpBXCcibdxmr0sC-Gok38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbpVvjmnaY1sNkRKeh2nUwajZbpGPylugZXDOW2Uo5MQ&oe=6B031DC1"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSiz0hRbCYYQ7kNvwG5AVzV&_nc_oc=Ado569uXKVpFSAGHNuirRKemlD0p6O1YphB4dInMnku3tzV9WzNQ38QzbNy4eZUdzoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQKe_awZ7ARpI4Vm6zeTUDwWG7SghtWRBEt4davLvj1w&oe=6B032213"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4RESontaZwQ7kNvwFOxypc&_nc_oc=AdqW7a3l0WepgkYuDo80-7QY0tHP1QvdcgDDFc99wLCUwwr0DsIlQsSUPNv4EXVoAHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0Acp4-rsDL5EaeCYUHG5LvPWc4zBnT2Y_bVGW3GSB2Q&oe=6B030DBE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC6Wmzd4foIQ7kNvwHqr7XD&_nc_oc=AdqqIIcVmMvhab1JjTh8uoREHEIzOIt25YyJGoEJk1jaeUU7W4RDr64XVgEhJY9ohFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5WT4mcvIGDaG-muVyeK2gwYhPP9Q-NzUl5ESlCWsaHg&oe=6B033254"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysANMAaGAKcQ7kNvwHW362g&_nc_oc=AdoBkXe35SVN_kRfySzINt3_wjwZ_xYzo8KHP-6i3H54sFUKJKniMDKihM4-eUerYhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7MvlXlTY4-MHuhasonW4QpgTfXrCdL8N4odYRmewk-Q&oe=6B031029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvN3fVVBoFwQ7kNvwHfrEnp&_nc_oc=AdrjFJxihp7aHrb-Nfi5Flz8thzOgTjVJIG6FVOKE-9F4ISNQII6QaBPirEnf4LncHM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIrbe9zzFXhV9vYB_XQ9HRFSFCREgCyifq3404frmjcQ&oe=6B03137C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28326306200347057"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1646399237229378"}, {"status": "PUBLISHED", "id": "1061889056671331"}, {"status": "PUBLISHED", "id": "1103647328980825"}, {"status": "PUBLISHED", "id": "904266325850894"}, {"status": "PUBLISHED", "id": "992525797136684"}, {"status": "PUBLISHED", "id": "914927581617573"}, {"status": "PUBLISHED", "id": "1491093855998088"}, {"status": "PUBLISHED", "id": "1160946736124971"}, {"status": "PUBLISHED", "id": "1531584268575473"}, {"status": "PUBLISHED", "id": "905246289041595"}, {"status": "PUBLISHED", "id": "1480337673517902"}, {"status": "PUBLISHED", "id": "923928096719476"}, {"status": "CANCELLED", "id": "1393647272505005"}, {"status": "PUBLISHED", "id": "761496053383113"}, {"status": "PUBLISHED", "id": "4106014019620872"}, {"status": "PUBLISHED", "id": "2135564013558561"}, {"status": "PUBLISHED", "id": "679314364716084"}, {"statu
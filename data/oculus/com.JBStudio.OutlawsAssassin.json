=1-7&_nc_sid=6e7a0a&_nc_ohc=F6jYuSUUFpIQ7kNvwGZ9hpg&_nc_oc=AdrZBkW-uZJTaUZfyGSy_7yMjatDHGvReT1KrTzhQhudlHLmzTvQ-E4fzCj2lUQSojQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIN-JHXVuyBl-QdpDrqnb_JNdSwN-TAIVKGL5OycXz-w&oe=6AC90BBE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgX6Lz216AsQ7kNvwHjk1hO&_nc_oc=AdpHIOKpIleTHPNg-OtY3FLjzPFtrR7lIdxLTSmnCzoUGBaDIs1bMPr5iapU1tdRlS0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNncPIkGk37CgEeMl-JHrlsv5emmBseK2UWr6IYUN6yhg&oe=6AC8F814"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6UyuhlEuHIQ7kNvwELJ2Ph&_nc_oc=AdqzAL0TgnFy7SlKE8hfV0YZBxw-tPDzKec9HdK2Z4rPIObiyRmg1XAK9lHcsCdYY0o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI3DWtx7-05SEfftQ0xw8Pdh8jK6D37p0GPV2tGkFU8w&oe=6AC90E29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ue0VYxRe9DIQ7kNvwEyibZn&_nc_oc=AdrdvhF-1P1uduZoqco3Iv02bjBPuR5564eHfVDEq4d-iNE-vDCZDmerr3qzVXGeRs4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEQemEDADbpdD_tcDQ7b8LgJKEf5H57aOZiBeVnmqTgg&oe=6AC9117C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOM
.com&_nc_ss=7f20f&oh=00_AQR2ahQx2xdZoIpu12gK1_CrcoCkLLfDQkfQ_gjf1G2JsA&oe=6AF8A7D3"}, {"file_name": "text.png", "id": "571453952603934", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwyLsjoTZB4Q7kNvwHqycHk&_nc_oc=AdrYAlBuaPvWcPGjFbyGcpOBYoa9TgWmTSXvZUTZhBO_1HojhqlZ7AeD9RlMhJ65M0M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjtRKHZukBXCTl51UxCLrFoTUjRQ1Y8H2_Ac8hYEwD9Q&oe=6AF8923F"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXQPrv9KX3sQ7kNvwEeUAmj&_nc_oc=AdpG-JGgPuSThJ4rRiSjsuACsDeJ9nalS_6CwDARVrPc2rIRB2IzU9z3_TV5z_3rH-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoIdbH41cQvaKwENB4A7jrkYwmIR76Z00YLzS0cdbyfA&oe=6AF891C1"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uWj33AkSvIQ7kNvwEY2xw-&_nc_oc=Adob6cZ6A0sj245rxpWFZN-gG6GleP0RMJ9QeXW070K9tMA9AiQGyOw23f0K0A_ASdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3XHAeyBKQpdcKozx_xurqCoWCIO06wKw-6XBsKJAp6g&oe=6AF89613"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv0VTGeXXV0Q7kNvwE17QaC&_nc_oc=AdodFbkwgr4DqMwmU4XQ8JfHnt0nw2rcvSji42xppvS19TR5HTwdBff_by8W-MhHqxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-zRQvKbO3LjP4J3HwTM7bQttbnh_2BO16hK3pvAKUZA&oe=6AF881BE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qw7_m7sATHoQ7kNvwGMl6xK&_nc_oc=AdowIyowYtskb0AyadVYourOqnfqfe1vhUXYrume8FGxRyjKDaHrM7ywwLCRodmnoS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3muli2dSY0afONR0tCpXNC01qlEJYr8IM7aBCA9LqKQ&oe=6AF8A654"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDkHmPlsOacQ7kNvwEzuu5j&_nc_oc=Adqh14iuwMoglu8kSVW8vALopds81oRXINAeG4-yolN2qbrZQMhiY3HUmCq59onVmUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh-15waFCwBWoLZ_4dY6oPv3377L3rwyERgYLff4U1BA&oe=6AF88429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxeYgXgGCRQQ7kNvwFXaqU3&_nc_oc=AdpEZtER04WZvAJwTLRxgiKcZnFPwMRg4l5bqL2ON0v17rzy5mheoGzOBTUniFntxqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxq2rFGG1HncNrpx_UdERhu59JloYKW0rg_g4k6fF_ew&oe=6AF8877C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
.com&_nc_ss=7f20f&oh=00_AQRYriGTOMzxVRb1j5vaA5NJxpmNbS98mVU49Q8cFchVQg&oe=6AF47B13"}, {"file_name": "text.png", "id": "571453952603934", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPxVjIrcYwcQ7kNvwG9XxEx&_nc_oc=AdpdXa6B5yBJLzf_5qyVkVWHnUmiMn60q3HuhbEVYC47Xrel9iWJoRkB0DT7ZXWyjzE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBZj9sFVgLwvH-z4TbwhA7b-X3X70LcsPEjdJIbCii_g&oe=6AF49DBF"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lln1Qd2Gv9QQ7kNvwHcJYqw&_nc_oc=AdpUHDTye__Mxe77R9RbSncjrP9ODYGhC9Ps3Hrvlua1mCp4WWvG357ZtZV2ZoZJH64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkIp1HX-FSMMvwl-QvD71QgCf5y6F2TgWgKIqQfBEZJQ&oe=6AF49D41"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Oaw4XafViwQ7kNvwFqHNhE&_nc_oc=AdppRJ7JRCfDPzNRAy_kL2UisLhclOp8AhlkQnnwRQWQFp8FC-rteVN7XyW4f3alcrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIwyDzEMjEwV0GfryaH_fobQkmRG1Ue5Igv96AOwliRg&oe=6AF4A193"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4LpfD0r5mkQ7kNvwHNPWnF&_nc_oc=AdqU_jwBwd11zf6gXQ4s4UXoNwSp1XAuLEL2hSqBlsbCZZfqG_NaWqcJDYb4n6CwFhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOMWwPfwvjqZyCxyrQEcFeKop5UQKg21XPlRetoFnU3g&oe=6AF48D3E"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78YBT71WuoEQ7kNvwHOUiF7&_nc_oc=AdpvaUEoo17DvTsdEtGj6zsY1n6cU5PRgb1oiJPuejalekUGU0qf96CE-H7jYa5eFCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCAc9isHpat1PjBQsgjWOAWIQllSGscLhi8aWprf9hmw&oe=6AF47994"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6LJPWZmy2YQ7kNvwGdwoUp&_nc_oc=AdpWqB_-JUv6IflMqL9wcP5dajxs3I36vma9OaJN6y4A2KuaaxDqSLl_a45gP7oUbkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyh2WijK_zNS7ApJ2w1KHwJQFAE_u-S4GiGlQ4_1uPFg&oe=6AF48FA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOMIaweOywkQ7kNvwELB7uO&_nc_oc=AdrfEvFEi24ClqsSyL73mvVX2zKbcbv-qkxVxVnXh7lMcDo2DrtDbPKaqQ3nm3ZSJ_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmv6XzcJ0eeHXlRRdx4r3w7V2xo5lUCAeE6nHB7w76pw&oe=6AF492FC"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
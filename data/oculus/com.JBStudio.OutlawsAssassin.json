 "977891954756284", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618442_977891958089617_4489337211493644513_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OatMtewiDPoQ7kNvwGs0QSW&_nc_oc=AdrVrEV-dTcQ_NWOtQWc3mouRPVi1WQu_XcNqnhCu3nPCGrIV4bRYZIMmhUa68H4xiU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbaEtl7NBG5H_Pstm4clbTCgkqtWspl118zb1ae2gt9g&oe=6B0DB21E"}, {"file_name": "ScreenShot 4 (2).png", "id": "850142474259115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620856_850142477592448_3047983245491594332_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LnN3JAeJ00Q7kNvwHVpOcR&_nc_oc=Ado5vtdXeQM3-aGo_R4dRP-nmOQ8svKcaa0JOdP7BDthfr-nXg2qj2ykIaptJEw9W4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBZr9XHfLpsmdEOWG4URfWGiAnJUNUZ2uUUP2OldBnQQ&oe=6B0DBB17"}, {"file_name": "ScreenShot 4.png", "id": "1632763717928190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1632763721261523_7956449221636368690_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vft1LVPyKHAQ7kNvwGM2XUt&_nc_oc=AdpzR639a1j2wjCdcREshgPUYF2Tiu6a1A3xiIogGO8o8OTa_h7hcsKcdBT_3rx7mSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYBER-t0_HwDj_Gz7Adxi20nl_7HC2Wt4UQ-1EEAyTzA&oe=6B0D992B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (1).png", "id": "964039069392569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618938_964039072725902_1950645181060360650_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3njmZwY1F3QQ7kNvwEzXL4S&_nc_oc=Adq5GScQyTN5uiGR-UuQk5jVHS9i6MNQSywuRSNFLaZwwKSCQEvN3L5VySPjdwIJHwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKdA2S55N5gmox6UUAO5WzNTcRdptJsL-4MfPQO-jZWA&oe=6B0DCFFE"}, "display_name": "Outlaws Assassin: Western Justice", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\n{1022958117424495}\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "A Wild West VR shooter where you use a magic mirror to peek around corners and outsmart outlaws. 36 levels of gunfights, hostage rescues, sniper missions, and boss battles across desert towns and saloons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
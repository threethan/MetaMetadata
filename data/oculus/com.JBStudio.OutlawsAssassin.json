.com&_nc_ss=7f20f&oh=00_AQTTb2lGB1DURuhACI102njN1Rmv3wcxk2JUPnsMrL8ORA&oe=6AF5CC93"}, {"file_name": "text.png", "id": "571453952603934", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPxVjIrcYwcQ7kNvwEdMTmu&_nc_oc=AdqTZu90RxIGWIprsu0U_k1QPu4b8vvDwK0HkTUrVkaMeK44pwLzthipQ5aNJsO4rms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpCemJeTFpgW5l4E1O5stGiUBhmf2mJv4Zrie22HpsHw&oe=6AF5EF3F"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lln1Qd2Gv9QQ7kNvwGyJKnl&_nc_oc=AdqQPqdF9-_FyECbNv6F7iE43RlLDLztlq1IfiThe1P9xiXgylx6CUc9EJTsbwZn8Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRrtprto6sNiZe-8sDsVFcE_1GaTYWlSF3M-MYacG1Tg&oe=6AF5EEC1"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uWj33AkSvIQ7kNvwENm0m0&_nc_oc=AdrW7M8O2Dg55F0BZWnLNvr1hCQte_HO2IetO7sFUddvMvb19F8S12Zz1iRtHlyQAOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZiZAn_yRhuM_bCNOtRPUYC6j0g20YiiSqlHhLnDu5qA&oe=6AF5F313"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4LpfD0r5mkQ7kNvwEIjkW1&_nc_oc=AdrDUK6W0X-mY4uQLgFQcwkvU2Ofp0HvUsZRayO5ChWMukS0JuIAlmxFX5-3DzSKMyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYGSTuehbP2ea8CiJSRA4ln7NUm0ykefHg_iHfxApDUw&oe=6AF5DEBE"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78YBT71WuoEQ7kNvwGUKpX3&_nc_oc=AdqOgdTiwM4pPzcQxDFdvlH9eu1qdWXavhcevHCpc-9QYS2Tc5fQnAdcxUp6dM_BFdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR112rrgfSCBELeOI3ZPSPNKl7VVXcCkE2NVIm50qi52w&oe=6AF5CB14"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDkHmPlsOacQ7kNvwHReAmR&_nc_oc=Ado-oZZBT3nHpk-TawAh0ymcPllVCVLVh4cj7zt8z451O2EIeb8eYRdvPQW2xt0ZUg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2gdkfZ_Y4HNy7WW6XAZpAhUjtPrjscFJt4gS1P_LCNg&oe=6AF5E129"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxeYgXgGCRQQ7kNvwEAQrwD&_nc_oc=Adrh_-F9TNfwjfAKln2BlpROI0_ZuTuEDlRnnEXORKnQ3OP1RfoB6VEUmn-q-MOHm7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAwf6X6GkcmT4QidvulYa3JGeM-OMaaC1cvRCGnDwiGw&oe=6AF5E47C"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
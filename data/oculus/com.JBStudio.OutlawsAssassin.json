952603934", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392282_571453955937267_6910802317762906424_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6kQa5mfy4EQ7kNvwGUCGWn&_nc_oc=Adrdyn6tdW4FyylRj12OyCMRaDtrsIp1j5XYaLQz_saInTrTsAKhIPSuI0tN0ZDxTIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVSKTMiXcYQjsq9psF0qW6g0GS7kcGQZ1PPptEtqlXZw&oe=6AE76EBF"}]}, "id": "1015127297104346", "locale": "en_US", "screenshots": [{"file_name": "Screen 2 (3).png", "id": "1970902310057739", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391731_1970902313391072_4094209501938059485_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANDOeGjzBn0Q7kNvwF7JVkC&_nc_oc=Adru4dD55AC8AhaYFrJax4gOek6gRMBU6ieBU1tn-pKSvV7Xf6L1YYNf85UghZBAPMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFQ59vOMS05glPYcYnzGcTLcsZGnIfnv8w93gWXQmYTg&oe=6AE76E41"}, {"file_name": "Screen 1.png", "id": "544963905235069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391836_544963908568402_5226616072266208612_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUD9akqujTMQ7kNvwEHZN84&_nc_oc=AdqIo8PB0xTkVAV9FNOo5Is2saWiEwd6RI3isGQPFCHsRAfaAbcWCYPuXx4G0v7YJh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr8tVRDvtXOUZiuygBmsgSPIDEG8YaEA1HMHCBevCA5A&oe=6AE73A53"}, {"file_name": "Screen 3 (2).png", "id": "628763589627684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391814_628763592961017_2678717433244547098_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKc68IR6NaAQ7kNvwF9C5lm&_nc_oc=AdqpRrRRBwnyM2rG85HJyFqOGxMt267-NOxnR6Y91qfTI7UwMy2ew1O1rG0TnscZPUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYHUU-F7GeDnw4w0KpFiZ9c4JYcL_dlKIjnXZ2iMzUjw&oe=6AE75E3E"}, {"file_name": "Screen 4 (2).png", "id": "981527416639455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_981527423306121_6786867054221543512_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCpIeRRMAyAQ7kNvwH7U016&_nc_oc=Adpmjmh3LUYDcpvN_bX5nRwr1-FL7FQw9-rylDE1cxTZGeEJusKyo5Hsmvh-CaG0SME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCSZDYfMbgjL5JzL-W5lvGGjC9t8v59tOcvPYxM-0qNQ&oe=6AE74A94"}, {"file_name": "Screen 3.png", "id": "2067423583700834", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393566_2067423587034167_2350253306932821137_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykuvhOihYr8Q7kNvwHDBDc4&_nc_oc=AdqsBs15LU-wyorCiiRQ17CC2H7L1hYZUJ83RMlbQeTErMNmhjIvh2kSDoYOEjq8JfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-bl6Wp_LrI8l2bbeiKQPIpMF3gHVl2qdUxPIklOJU3Q&oe=6AE760A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screen 1.png", "id": "1686521835605649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1686521842272315_3861199546548220150_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTO9uJRHgqAQ7kNvwEN88Ai&_nc_oc=Adpfin05JAu4L8u-OFna-hH6C19XJS60TktRRHgM_TZbYb72yrXEerdjsyo4iiUOJBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWzOZR5HU72xnanWq-Sc_pYs_pxEin9-IpaX1JmPKfIA&oe=6AE763FC"}, "display_name": "Outlaws Assassin", "keywords": [], "long_description": "\nOutlaw Assassin is a thrilling VR shooter game that puts you in the heart of the action as a skilled sharpshooter tasked with taking down dangerous outlaws. Set in a gritty, western-inspired world, the game combines strategy, precision, and quick reflexes to deliver an immersive experience like no other.\n\nIn Outlaw Assassin, you\u2019ll have access to a wide range of weapons, from classic colt to powerful rifles, each offering unique advantages for different scenarios. But it\u2019s not just about pulling the trigger\u2014success relies on your ability to stay hidden, assess the situation, and strike at just the right moment. Timing and positioning are everything.\n\nEvery level introduces a new mission and scenario, challenging you to think on your feet as you navigate through enemy-filled environments. Whether it\u2019s clearing out a saloon overrun with bandits or defending a vital supply route, each mission brings its own unique twists and objectives to keep things fresh and exciting.\n\nThe game\u2019s standout feature is the clever use of a mirror, which allows you to see around corners or track enemies without exposing yourself. This adds a whole new layer of strategy to the gameplay, making every encounter feel dynamic and rewarding. By using mirrors to outsmart your foes, you can turn the tide of even the toughest situations.\n\nWhether you\u2019re a fan of westerns, sniping games, or VR shooters, Outlaw Assassin is designed to immerse you in a tense, action-packed world where every decision counts. ", "short_description": "Outlaw Assassin is a VR shooter where you take on the role of a sharpshooter hunting down outlaws. With a variety of weapons to choose from, you\u2019ll need to hide, wait for the right moment, and take your shot to complete each mission. Every level has its own challenges and objectives to keep you on your toes. The coolest part? You can use mirrors to spot enemies around corners and take them down without being seen."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "275629210202852"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
ucj-xl5hhaDs519nlnmmpAkxtLJ-hI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yi35BE2x3hFgGhOC-nkGPPkc3ZHDOuRNJTWth70CHEA&oe=6A15A448"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (1).png", "id": "119712334459449", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75302219_119712347792781_8012676570988914354_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2yeo4u2IbMQ7kNvwEHeSLJ&_nc_oc=AdqJuV_EwouTCL6pjcelTdQa7-j7neg_eNtZP7zu-wgI02qrAEeRl01xO48FfE1cZJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FgyRfeX2nlRN8BUQskAlTYDnbho4jo75BjH1w_aOAUA&oe=6A15AFE9"}, "display_name": "Bulletstorm VR", "keywords": ["BS", "BSVR", "Bullet", "Bulletstorm", "Skillshot"], "long_description": "Step into the boots of Grayson Hunt after a crash landing on an abandoned resort planet forces him to make a hard choice: survival or revenge. An exiled member of the elite assassin group Dead Echo, Grayson\u2019s blind desire for vengeance finds his crew stranded on Stygia where he can finally confront the commander behind his betrayal\u2014or get his team off the planet alive.\n\nBattle your way through throngs of Stygia\u2019s mutated inhabitants, performing masterful kills throughout the single-player campaign\u2014now with unique content made specifically for VR.\nUtilize Bulletstorm VR's unique \u201cSkillshot\u201d system that rewards you for executing the most creative and deadly kills imaginable.\n\nImmerse yourself into the world of Bulletstorm VR!", "short_description": "Step into the boots of Grayson Hunt after a crash landing on an old resort planet forces him to make a hard choice: survival or revenge. Execute masterful kills with Bulletstorm VR's unique combat system that rewards you for performing the most creative and deadly kills imaginable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://peoplecanfly.com/privacy-policy/", "developer_terms_of_service_url": null, "pu
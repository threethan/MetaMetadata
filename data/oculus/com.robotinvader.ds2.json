ot02.png", "id": "1517851225387915", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001718_1517851228721248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVUETAueAcwQ7kNvwHXs0V5&_nc_oc=Adom45Izn5nJ28uq2MzDJP9frK2YLgVe7gAgy8qVKaYVRvH_Q9za-mR_BOm4kPNhxYM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO_CMqrlWkgBjy3KpAjPnzQUrZq73fJrOHwNZ54qaKRA&oe=6AA421DF"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-x-7htsJ-qAQ7kNvwG794qe&_nc_oc=AdroHHUp3pl8epx5vdfFlTnRSy19edIJDrxZHR4LCqszeLzqXEltS45DY--Y9uSD2yM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq330uYjD7aHBO9LX4tfYpcQOkDYwjy3KVl1wo6nVu1Q&oe=6AA40EF9"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqsOe2zavAkQ7kNvwHrgI6j&_nc_oc=AdqWzlyt1y0d_nnvuD3b6X6VxHBoGb8-MS2zesfKwAkHF1xmThqtCzIbyNeDguseJq0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF-pnH0Riod2MJT8dMvQN_kLawAhZ-pcs8ZcvdrfdVuA&oe=6AA40D7B"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2wcWquEs-8Q7kNvwFwIFq-&_nc_oc=AdoVByBxowRrIlT7jkHviMr__8wPHI6ETGnaw_6vO_cmggkToIVbEaZFZYcexlyBXJg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJycsda7qGdcdUS86b9xW-MuqRh1mE-r87LubXfxgk39A&oe=6AA3EF2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcvlb9YSnyoQ7kNvwGz8dUX&_nc_oc=Adq4lQlTTt5-RBXdXR2vAUlpQF85NQ1hSeRxHGuJAhH2Y6OM7980j3wJQgwbyrjUtBc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2LIgzymAxnD89hFJ777pQA8H3le_nKcyMaryGb7OKZw&oe=6AA42526"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_w
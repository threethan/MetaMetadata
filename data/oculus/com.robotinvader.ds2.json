85444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY1Xx6vXdhYQ7kNvwGJ0KrQ&_nc_oc=AdnsDjutDfMo8GWii8JnyusFZ9Hxw0Z7jxiPAV8-BmDX17Cl-RriMxztMuHwM2B-z3E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1qCvmdhA4QrJaBOo0NtehLcr6HHbv8TGerONzs9EsuQ&oe=69BD331F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDGkgRigOa0Q7kNvwEZ9l1g&_nc_oc=AdnzIu1nnwet2eN8mvLnBZ59MyLC0cGeqnrNprwRizkciOmJI3AI_cE4Ln1PAVAFYcc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqGpLkv9w3ovQLb31aln4eY_Ma8faytx71gme2nZwbFA&oe=69BD5879"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybwlV78kUFEQ7kNvwHxSlzb&_nc_oc=AdmLPv4xQQ9ahFsC-ZhAUSqBF_QexAQ7FGQuOpf7rLetEKupFaF8rs7kTYf60VvvxVs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7gVdXHW5eD-lUmx7hSMSsOe_wbrO7h4WqGOxIe0S3XA&oe=69BD56FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdAxteAabZsQ7kNvwErd8gk&_nc_oc=AdlvChpjvp0zmY6rAvqIxV2wkorPUQeGMX3VOE8pFees0wPC-ntvcfP2EjbQBYJsNDM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeC71zc2mA4i9krv5PN_AT4gXUuFIX6jfkzh-c0LSYBw&oe=69BD38AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOtVTFhdadAQ7kNvwGc1J2T&_nc_oc=Adlo6ewHBGxNRKtO1wqMhh0zdA966tU4wDEgB5dMpb4FjGbm7r58euj0IJhy-1pGVRk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd4jLFyWOUj7fsNyXVw2jMX4unlWtmC36oqgok6buIKg&oe=69BD3666"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTAB
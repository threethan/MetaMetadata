09F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzKVMvj_IYUQ7kNvwEDCUFq&_nc_oc=Adloo1SsWuRJr-BCjBDZA1BvGiX-clh5lX8puHGo_1XhAjwofBqXRsndqla1sGXqfRQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvrFnOSwlXTksx7BKU4WgR2qNgnLuKg-wD3KXq1FnHFSw&oe=699F05F9"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yJGD7iBF9EQ7kNvwHcKuh8&_nc_oc=AdlDimvG7JHimlv91qZnUx2JdRUgTLCayiyjsl4RIl58FH1p2h5KqQYAtXidmooCMK8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsaRAvc-U2_gpLrje-UE4qQux-5zv2bKOZ9TgZEd3wJVQ&oe=699F047B"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSEE2YTNYpsQ7kNvwHP8FgX&_nc_oc=AdlALpYQa8fQzsQTx-GKq8F0J6NhRCeoixFHV-Bb3Z2b0pv9D5nM8UVMGmaaYezno6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsHOMhzKtGBsKPfKEvOd4Z1pH56akVbbyeXiMP_eo5gkQ&oe=699EE62A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJgsjsJbfuYQ7kNvwGnzYi5&_nc_oc=AdkCcJfsWQndNv2F3tM4nRKa_Z3_9uxp4N6QsZ6uO8-RWsE2BOKPO1ylMfc2sPgxG3Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuIZnLlA7njcA2Cf0Pk1Ox5GpJQzGRB7PO-QvcLMpIPFQ&oe=699EE3E6"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_c
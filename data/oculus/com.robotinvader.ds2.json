1248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gfKNjI_EpMQ7kNvwGN7cv3&_nc_oc=Adk6_jCm0a8p48xl32ZWN4HakRdJEfYkvDYAbBSqGLzmQZLLz5zdqJm6bspfamnHCb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsi0pBTmXvLbvPNXvYceLof09WoeNcFpX7pIVD295lExQ&oe=69A0321F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzKVMvj_IYUQ7kNvwHkixzZ&_nc_oc=AdmSbGZ7ZqkK9U8KBVDsnLSwugz03nYlA5Hv5kiJ-ZQ59nN5R665xpkgPY5lIvLlCVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfunTYznVAnkdBdUlzE6UePsnbAm7epo-znEG6KnSjYuTg&oe=69A05779"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42i_LMR5SeUQ7kNvwF30wT1&_nc_oc=Admf7Cj2FegB9n3xVnTGqwOBQPajAHkaUdVoZOx8TkYlbqktX_KzwlpImQVTPrd9X6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvfQLEQQ4g1liWiWKXAKqLDwjhvP-1_OUIz2Doh3BuvQ&oe=69A055FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSEE2YTNYpsQ7kNvwGP_8GS&_nc_oc=AdnHAybt7qa79Ad1tjhCUjC0D4w4Ei5_q0Wx58Lbr9thUo10jHY2TElWfptU1SXlHMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuX9Zyo1xNjdxkV_I2TNQXs5KM774vlUW58tT5wCNWmVQ&oe=69A037AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC_hero_2560x1440.png", "id": "232394662789127", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982620_232394666122460_458714567412315643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CaSI4e4g5T4Q7kNvwECktfx&_nc_oc=AdnoMLTEcBs0TpLLNGB9eNPWgjWL4QGzn3VDhSyHxqxxL455AMzooKw4UquIZuxtEF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftOwNHwcjl9n9Ndsu44bGZPREspVsefKtYdgAhJWGqFzw&oe=69A04099"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [
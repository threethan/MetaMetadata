vwGjoCDI&_nc_oc=AdpX26qRPVkS_Z9syh9EQgJJl4Tj5bMQwORwFVstahXAI15V61zuO0zDlsSkVYBMr2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDG_jd7oU7vsvuABB9uBpq_kWnP0XhU52VYTtaPc3Dlg&oe=6B0D9F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC_hero_2560x1440.png", "id": "232394662789127", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982620_232394666122460_458714567412315643_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKi9E1jfvQcQ7kNvwFa0jLk&_nc_oc=AdpNhkqSXVcgZGk9Lp9Bn1M4pZbucloHJ3Iiq4y6zuSzv5JTHuooJz6rplC3FYWuX4o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5hoMz0ceiZNFymEXtNk2MQOz4ypJj0aP6y4a07uunVw&oe=6B0DA859"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6607785462675634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031589_3695699264084330_258213134566560091_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiRgCRJ0YHwQ7kNvwEnujTW&_nc_oc=Adq_OtC7845pciXNJoc43tPe_i5b-miyDZe9X0zPhegdYL-nY7epwbjN1CHjAobF25k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2zBt5_MlSRZy7BtOEN_lkN-K6IDSbN-CiKRf23D4ICw&oe=6B0DA04D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dead Secret Circle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
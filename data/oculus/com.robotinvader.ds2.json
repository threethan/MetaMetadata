ot02.png", "id": "1517851225387915", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001718_1517851228721248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfmE-ss9kw8Q7kNvwGS6mtt&_nc_oc=AdrRNvvNnN8_LSegOwQyKf6tXDDdfVZDqXDCN3X-gUzcrJP7xx9f6K53eDVr8yN6isY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_Hm0fgu_wo6LWBz0zMsk7ygYK5t0vrCYUZJSVkoIaEw&oe=6A46875F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFkNPfeOFRQQ7kNvwFcZgUk&_nc_oc=AdofbDPhQdDWSIxmc_rHsPFBQ7GqHG-jYkYesMCxEbwCNqrDvrhjIdztkucIwFTY1Mg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V-UATakdwh4FGwoCEahFD9mYUzvCSOvhEPA038UtDSg&oe=6A467479"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpCG9cHqadQQ7kNvwFjrsXu&_nc_oc=AdoIyLmM_sy5Z7O-ywXl3dFM1b_hNDW9xDqCLAVkvvokepf9kHKipoq6kGzM99IXQJA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MAvmV5c7-9Ndb70VnAqV9nfdXSfpOOTcTwE55EpmD6g&oe=6A4672FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ja4tMRaFT0Q7kNvwHMQdud&_nc_oc=AdorhdNs9wZou4HKU1dkBLLBTyHocYYvyGMRJRR_dEj2ZfWzhR9X0KgRcLKFHizStwE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e5kxP8RNVWbiiyzZT9NS7JbUjjin5BJhu0ETWsJrvFw&oe=6A468CEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5M0GqyIHXsQ7kNvwH0NxWL&_nc_oc=AdpW8LLB3KOzoKnQxXIQC8-qGnsnGuicOiBvi4vlXrtYn0tm5nnBrFSYzcfkgllqapE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ead8Bxzi0q8BgzG3kMnlyf4RnLQKqWwQFSi2L3FKXkQ&oe=6A468AA6"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_w
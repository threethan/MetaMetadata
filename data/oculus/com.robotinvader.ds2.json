85444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thPFDyNyvlkQ7kNvwGTxX_v&_nc_oc=Admk8TN0YCNqtWFpa19QNtxma89AIi3DnzG5zbagF0YxSCMXJKuTSfh57rH9CuQh6T8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv9WAt2vNTh3FJeKBazFdHNnrbjTY3kuNHz713WM7rSw&oe=69B7ED1F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYrM3lITpkcQ7kNvwG3dsXs&_nc_oc=AdluH013wR_nJRCxDXmOJuwDbNGiLGm4SnA8yu0GAErlC_U9LJzdM7uwj5NkWLB4sho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_OLi_TJzodQOoMngushldit5DE3YM0zXrE1MVZF3h8Q&oe=69B81279"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-beDXjps_QQ7kNvwEMvJZ_&_nc_oc=Adn54sstc_7ttC0d1VXLsPSO-YmZw_eiOWNxIkD_s3bIqg9oEZ5DRZyniHWlKzYuy0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzywDgvc5YnrkHMUmC1RxczyFGT8p3DmhnvfFGi0AahfA&oe=69B810FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LwVIObcsdMQ7kNvwGavmzY&_nc_oc=AdlPeZPjLJFCtQhHYcEJWISQ-_naXAxtiKyGfMjfVPdNbvKmIYaEFYjuMiIRg80vs50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7fArVzuGs1mG3R7CnLcc8Qfb4SGWmT_rqgiRtMxL37w&oe=69B7F2AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMb-GOr0WOYQ7kNvwGx22Vw&_nc_oc=AdmFVgSefxGMZzVKO-NQraP5StN5Y3-srDCJkSrdo0Dtnf9dgNF0GWN65pelJzH__K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_rIODkF28QCFY8W78kjBHdGaqg6sB71HmI7OoM259Cg&oe=69B7F066"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTAB
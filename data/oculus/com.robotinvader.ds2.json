48_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B84ho6NIGQMQ7kNvwFyeeqn&_nc_oc=Adkok5pceIV0J-AmjfEDnGjFmXwbw6EfcY6xMmiZtft3dMNsEcT1a78ABiQZRBRCc9c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxzfNvbr8PISrVtlNv9u10nqPsGfypzqGolnucsfFV_g&oe=69AABE1F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcFIrmtat0EQ7kNvwHaL9xw&_nc_oc=AdlDguho09SILSaZPnYYIEielB4Yn1Fei93_oWOYoE-DSxHsrL5NSGeV1QhfYuuGLio&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcXtxNd_IZr7n2IQ8JGQMB8wt30WQuirRJXB3Wdcm2EQ&oe=69AAE379"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm-sVbhm2r8Q7kNvwFQaZ5x&_nc_oc=AdknluuLJ6D68Mw4-JTZkGWdpQd9xwF0CW4OAk4X8W86VYNFXsIbooIghZgn9Gaffaw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfVeptBX4Z7jcu3kFKUsufdjSFcxaHVUVCopO9jHq1tg&oe=69AAE1FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH9w10RGWrwQ7kNvwGVLuUu&_nc_oc=AdlEYXIbHtUzFUC5MhOvAuzyZo4HjU4r2dzg80JkP7BWOBelKcVVGyqcp4LkHLRxXOQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEqnht6C-GKDGgjHxUbUCuX1h5_JEd2QDd7nveeZDeDQ&oe=69AAC3AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXhV5Llh8S8Q7kNvwH73aw8&_nc_oc=Adlwn_Mud2njzyE6j4akpDCWAV-6GH-QQ21ruFPKmaTNwD1oRt2GDtBsIsK0x3039Bw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNyxq017QBahHqdWAY_J-qHkJjnP_kOXqVumIt_i-ImA&oe=69AAC166"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "C
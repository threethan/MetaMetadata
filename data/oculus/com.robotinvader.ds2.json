ot02.png", "id": "1517851225387915", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001718_1517851228721248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Uem_565VigQ7kNvwF_gC8N&_nc_oc=Adr7iZdEg0ZkJ6wEanvCxT7OgTTegLQtsWtNbu7lA3r3kqWygSGcb_9FZ631Bl3Ded4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qt0xZw9VOi70tT5-1LxTiU6zZ_fPQpS4dQS18UI65bw&oe=6A36B55F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAqqNxb_eKQQ7kNvwF9nKcp&_nc_oc=AdqjicgB9KZUAnKwQZ2eY4Vq3v1i-TY8cDYZVPUSWfuSGl7kChA70dKp1VoZiczWfv8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_98-PAuI94PyAf2KsvLvbZJLR0gl6Ibbo5-QqP1zvKQ&oe=6A36A279"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13du8YDxGaAQ7kNvwEWF8DJ&_nc_oc=AdpFv1pXk70ofo2Z689WrLUecovBJoHHAoCb6aCPA1Ly-EP-d8kuBxw0Xyj2lTY51H8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98rx8UOWDc424ZcRGiXfs0b-SqDh4TkTje9tfH5v7okA&oe=6A36A0FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHWHV-wlpPoQ7kNvwFQdLkJ&_nc_oc=Adq_Tl2bCotXgG7pOEvL8MzUcWKxRINLA-6pk_WUUubH2rkn-3pRiCYMjkJneoWoaWU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rjMN3CmgoF4AfGPdgQTzk0y_scWtJ8q6PyXf5TVbxdQ&oe=6A36BAEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gQCqeGw8KIQ7kNvwGeAd8_&_nc_oc=AdqBWN8IhzMKbwNPO61PD9K64iIe_i8VrtaetdDJ98OLY4rnGzzeyHBKvFZZB8LE2qc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84we0nDiH37o2eo9ZRxANVPCf6eKyEHvfRiXNOI_NeAA&oe=6A36B8A6"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_w
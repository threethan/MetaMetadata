vwGFGO5o&_nc_oc=AdrZDaNKilijGhWbTwxs6PxNRnmvge6tTFQQ_3EDnVP0SeWrJaGvmt9eBAq6U1P8lSk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS88wCJJdKmJuELxtIwAw9_v8bKJel9zQbt78QsvewdDw&oe=6B00706A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC_hero_2560x1440.png", "id": "232394662789127", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982620_232394666122460_458714567412315643_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7S4uoucSaQQ7kNvwH9Tm5d&_nc_oc=AdpDa5r9C_PurUPyi3gm9-j81ANWf5vkeNP2ZFFY4ZzKxhpFC-S3FVvdn52onjF1QpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDtWXWMtzfJnUYyTzilGE__QbhoTFW8OPi1XknqWqhog&oe=6B007959"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6607785462675634"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031589_3695699264084330_258213134566560091_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5MpiFUd1ZcQ7kNvwFpUJXy&_nc_oc=Adpoauxq9hPvpgCg62yupqV0OwIhs-lYEwO3jcX_8TpAYErLYqHSKDCAk91gP8Lt5J4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk0OvgqIUZtSTBjjwJgrXEAHR4cjo1fhG__In37OBgVg&oe=6B00714D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dead Secret Circle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAME
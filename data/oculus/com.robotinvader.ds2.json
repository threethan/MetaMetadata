85444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pstlcBsPs4Q7kNvwEdCy85&_nc_oc=Adnwy2ctJQpTe4-r0NGm_7rOaiRtqZvZf6iXYwxeXurvDtLLDBpHSUOXQYqgDunFSwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5ro512YOV96vD9d1wnXFSfQ1bVnsylqgz_d4RLLy_dQ&oe=69BFD61F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR1uiCunC3oQ7kNvwFLyLk5&_nc_oc=Adm-xhGyIkZsFk4aU3innXkbTcU02gm9oOKFctLe7eo4hLMkSkAGWzDe38oujamKZe8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyu5iwWyMhyK8yEaoriIpSq37N3InCyXwanOSWydjf8zw&oe=69BFFB79"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwgDAeNY9WwQ7kNvwHjl1r4&_nc_oc=AdkXx_pysOHbdTi-4xoUxCrTyy-9kscXSkpuCY-C_LsCd5uo20FU4soseU38pPFXRIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJG4dquVzbr7CB5MHmG-wAjoFr3gRSPqXevW8_u71BOg&oe=69BFF9FB"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AJL4kGye7oQ7kNvwGTPnTr&_nc_oc=AdmwmJ_gC4v1yIDyFf1hCF4I6r2FWcpmTf2xQNq0ZrRwiwgyrQt91sRqD_I3Vdt4VAU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhYJuH_Uduol9h9rtWy3i0SYt9QF2QqC5FgCiRbWJKvw&oe=69BFDBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSCQ_Landscape.png", "id": "304609207308443", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568673_304609210641776_604721398602139627_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rweaUQDXA7QQ7kNvwFu1bIA&_nc_oc=AdlgkVH8l-Z8iiHe0imIuJfE0CRY_55fBlA9s2Sfix7bdpXZnsvI_i_2TAYkfm70Rzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz34Q5UUxdMShtjiH80XHSKcNzX8WPwuudO1_e4Gb3YLQ&oe=69BFD966"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTAB
1248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t0BpiK6hlcQ7kNvwFWACkU&_nc_oc=Adpno5d7gTfWvLUdBJVkErVf13ZYX4Vuz45tj1tEkIw3w0vIYjxmSjwnVh9MoucjXkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af343UMJacS6bJ1y8EBWXPJb3iv4AdvycNcmXWRdSR7G4w&oe=69F09D9F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVerv_M6_QoQ7kNvwHUlhnf&_nc_oc=AdoGxEcVms6Nj9HXAZEvKq-05Zbik78aRXD9eWAooiAvVmnHCRWXQdsY9IL5kHLiuvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af30av7rHjXN5aEN8arqMwVOKfMkICFauhPOGUSp0svV3w&oe=69F0C2F9"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILRShTG3oBwQ7kNvwF8ZGtY&_nc_oc=Adr9R4-hc1d9g8AAjoFQiFeLX4YJU0JFhBdKf_eTZNXH0BjrWjDWbHNkNQPHHYEsEUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1IXwvavZyrRSw6TYeXCFe4Sr1nnj65FrT8JCYMr2rTtQ&oe=69F0C17B"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRtmBfDKlJ0Q7kNvwHoR9PM&_nc_oc=Adp5jrojSU8LkYVgKk9ZhhcWgrsi_dnz1Kb_TuPbV2cAiFEEHjETv_9xevSz42031Mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3tXzs-BJm_X19AolVKJWlaRMSWq_MplRdU--n_jScmoQ&oe=69F0A32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC_hero_2560x1440.png", "id": "232394662789127", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982620_232394666122460_458714567412315643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW9OsImzS4EQ7kNvwFlknUI&_nc_oc=AdqZnIIGJaui97_-GjWqtSv680bJPW4VbN-5cyUewzqJOvFVGvIv0B1FLQ0f6GN6VQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2kwFrsO_qeFJbRnVB9Arpymd3OMEeCSftYbtlQKJOnMw&oe=69F0AC19"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [
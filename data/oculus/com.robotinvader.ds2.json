1248_3308485444994427398_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4NbJI-QNmgQ7kNvwEnKFBw&_nc_oc=AdmJfOUvScsCseH3YofjqFUvb1QatDT82wtU4rZwUdfeQbCfz26VvnWWHU54QxTzFl0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv1vb6VSLGirGOxQTHZ47AuKO6hFlxp-wxO1tYFH1WzvA&oe=699C3D9F"}, {"file_name": "3_dsc_screenshot03.png", "id": "890413418797585", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974774_890413422130918_3747700643689559919_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUqvfrIyhB0Q7kNvwGcG0HW&_nc_oc=AdmDMhWfDZ02R6an-QDH82oNpddwhSUVBIwg3fKERt6MoG6oOfghgF58CXBo_wXcRck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftycDgPoTv_DBVISb_MetnKtyHLx2vqxeEDioHfyINgeA&oe=699C62F9"}, {"file_name": "4_dsc_screenshot04.png", "id": "1770251713344459", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_1770251716677792_6485192478243397785_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yJGD7iBF9EQ7kNvwE315BB&_nc_oc=AdmHBmlthtfhVSCjFeuv3N4PhzO6RH9n0YtFbI-SM1TcJnrIo6eNAAllTlkvJSkdxXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu1VHHA298L5IKwfOiwaqX0LTAigtTuL0I1wCtZmiR-Aw&oe=699C617B"}, {"file_name": "5_dsc_screenshot05.png", "id": "2978901982416999", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984475_2978901985750332_7534346427684312053_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2onT23MX1oQ7kNvwENCNtn&_nc_oc=AdlXjZPaR1YLSrwmjC5Je6_UWxVom3SsWmbYiN4s0fTRVCw5ykZCmmq7bGAEeLi6eHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftwlS-yZvaELn3npO9ueV4cdWGeMCxrvkhwQUKp4Ftl2A&oe=699C432A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DSC_hero_2560x1440.png", "id": "232394662789127", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982620_232394666122460_458714567412315643_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8MX9Nlwx4IQ7kNvwHatB4a&_nc_oc=AdkU3324HeCkQ1iDjpMiRnhYHBIxd1iFHq0IQP0pDBxWaDnrUrx2VXi-wBqerwxiQy8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvOFd0UP6e2JIPN8KVdTOsJRJEQfzW5zo6RjniI_0gQWA&oe=699C4C19"}, "display_name": "Dead Secret Circle", "keywords": ["horror", "mystery", "adventure", "scary", "zombie"], "long_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade.\n\nSlow-burn psychological horror. Nothing is as it seems.\n\nIn DEAD SECRET CIRCLE you can freely explore every nook and cranny of the highly detailed environment with full locomotion. Solve devious puzzles in classic Adventure format. Collect items, review the clues, and unlock the secrets of this strange building. You can run, you can hide, but you cannot fight The Laughing Man. Your only weapon is your wits. Find alternate endings, a huge collection of hidden items and documents, and branching dialog paths.\n\nHaunting original score by Ben Prunty (FTL, Darkside Detective, Into the Breach).", "short_description": "Five years after the events of DEAD SECRET, a razor-wielding maniac with a penchant for circles is prowling the wintry streets of Chicago. Follow the clues to a dilapidated apartment building and its down-and-out tenants, each with something to hide. Investigate their apartments, collect evidence, and pay attention to your dreams to solve the riddle of The Laughing Man before you meet his blade."}]}, "developer_name": "Robot Invader", "developer_privacy_policy_url": "http://robotinvader.com/blog/?page_id=299", "developer_terms_of_service_url": null, "publisher_name": "Robot Invader", "support_website_url": "http://robotinvader.com/blog/?page_id=144", "website_url": "http://deadsecret.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [
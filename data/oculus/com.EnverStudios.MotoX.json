6758299", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982657_458340890091632_5373690084641654034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puwjNi4a4TsQ7kNvwHa7Tsv&_nc_oc=AdmHiEq1y80-eP5PmVoseIQ7Ihds0dCdG7SGvfiZRKFpzxHIhMRaQYOc4uJnHWh8M8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv0bQeTIOhFDePfILpCeqC9XwjWhRacixUyRbANojIIAw&oe=69A58834"}, {"file_name": "Stadium (1).png", "id": "452052337284170", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974741_452052340617503_7910107192848161615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOZP0fC_HMMQ7kNvwFfSDzV&_nc_oc=AdmQmjTVYBxBqZtnLmwPUagQRGhtNYWhlrzbwHabnGyv2dbUvxM9WJ9B6Fb6mhjIYRI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvh_-bOxCtio22pJVsQNTr_ouJlVhsj8fYBIXweKnmQNw&oe=69A5699B"}, {"file_name": "grassland (2).png", "id": "3695364917401126", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974691_3695364924067792_5816533097485206779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKB-4Z3q8bAQ7kNvwE2UmkB&_nc_oc=Adm2norKmoaugLZWP981pIKr6yLMgPfSYaJe9LxKIaLyQwqK4fYhPLqwAalbk_D3W9w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuTlzJ2GAylA5FxkhYWEwS_Oe1QaHkWUSuXu5LKC9uF2A&oe=69A592CA"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2H70qNSRgYMQ7kNvwHfHOXr&_nc_oc=AdmmrgQ6zhZptEFb6_BWRPPFilErHftmO8Wb8-8j5fM0MGmBEwv6AqDMKq6ajAUXir0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVAn1ARSYMKILohBcsWQI5atYNReqOF6k-g6clsG_pnA&oe=69A57624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440 (1).png", "id": "912981801430240", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819859_912981808096906_8511339949265425011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00hOpzcOQIAQ7kNvwGNJHUE&_nc_oc=AdnXXrCnH8dafTJSYCFK_oXgJF38BaqwXNv37JMjH7nUCQVLasmZTgK_7iLFvJWw7Mg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsFwbLbkEANMdcXmSoT9LuR0yBMq3ycXRKCvkehDcgvFA&oe=69A56A4B"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is a fast paced, adrenaline packed VR motocross experience that throws you right into the action. With more than 20 unique tracks and a massive selection of bikes, including several fan favorites, every ride feels fresh, intense, and full of possibilities.\n\n{2136410710218739}\n\n\ud83c\udfc1 Multiplayer and Voice Chat\nRace players from around the world in real time multiplayer and communicate with teammates or rivals using built in voice chat. Every close call and every crash hits hard when you are in the rider\u2019s seat.\n\n\ud83d\udd25 Game Modes\nTest your skills in Time Trials, challenge others in classic racing, or dive into chaotic party modes like Infected. Master a full range of freestyle tricks including flips, whips, wheelies, stoppies, supermans, and plenty more.\n\n\ud83c\udfa8 Customization\nMake your rider and bikes your own. Personalize your gear, colors, and style so you stand out on the track no matter where you race.\n\n\ud83c\udf0d Tracks and Environments\nRide through over 20 dynamic tracks featuring jumps, hazards, and environments designed to push your control and creativity. With new tracks added regularly, there is always something new to conquer.\n\n\ud83d\udd04 Monthly Updates\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n\n{801104719410318}", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://www.enverstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33522973200683995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820141_1955936218686059_6829571066642858684_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2fp7fcqLCQQ7kNvwFCBxmO&_nc_oc=AdmbeUiYi2pQkdTaEnIrdl1zkqyLd_oiNwYwezPDS8EYQpIZRcgvFzhZFwMA2wlnEvw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu4ImbLRMhKyg901fbBZXEHIIfgD8HSYqTt5WmKqeHQiA&oe=69A57420"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotoX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing"
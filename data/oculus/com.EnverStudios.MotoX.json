44165158", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491826562_2695261747498491_3826068153359001121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEHInUyuyi4Q7kNvwE5AGEz&_nc_oc=Adr9Bzii4GS5Bp1YRfXCcYfnzUg1pAeYi5Ym7Ik9gw4k0ZbW1T5BDcAnTcuZNNiIyiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe2Z-WJBfCWC-cYECYKVbNcO-fo2FLB6-TpCEH2_7H4A&oe=6A50F672"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NLgPoglcOAQ7kNvwG-1Hdj&_nc_oc=AdoOiOFtFYjUGT7E4ggLpioeHOD-AKN8tJTiDc7dDqWZW-EuTa4AtpsMeFGHT_UScvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAB__NX3FrjMrHn--pGLwnQQun4WYlJDw2Z4NGmn7bIQ&oe=6A511164"}, {"file_name": "Garage00086421.png", "id": "2448573822248239", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299772_2448573825581572_6680320897279576694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8qs2W8rO-oQ7kNvwGzqVmV&_nc_oc=AdqF4Ho0qMVMA2s-WyAFDY23GvTF4mRTy1Ma0KhWEiHIpoAJiAZhCSaQszTgOTnkTCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHXBCOM2whTIyMGZGfWVK8DNuYMwB9GxKti9n9TRCpXA&oe=6A50EB5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440.png", "id": "2154494368613333", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313107_2154494371946666_1649477589140065797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW7p_I77dX0Q7kNvwHlmlRZ&_nc_oc=AdqSE7IQrxrj2SJ7CZXJ8DcsPoqCbqrSHAFkHDPoJwYmqFsj2SSFLpmIIRdmCYEKnoM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC78t0mai9SKXqYhBHdqz8Y8XR1VitMgLhBdXZgEZKZ3A&oe=6A50FF82"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is the ULTIMATE Motorcycle, Motocross, & Bike Life Game! \n\n- Send MASSIVE Jumps with your friends! \n- TEAR UP the mud in Supercross arena Races!\n- RIP WHEELIES through the streets while running from the Cops!!\n{2047376359444712}\n\n\n\ud83c\udfc1 **Multiplayer and Voice Chat**\n- Proximity Chat\n- Real time Multiplayer\n- Races and Free ride\n\n{796380436165732}\n\n\n\ud83d\udd25 **Game Modes & Tricks**\n- freestyle tricks including flips, whips, wheelies, stoppies, supermans,\n- Time trials to set your best hot lap \n- race against other riders world wide\n- cops and Robbers infection tag!\n\n{2136410710218739}\n\n\ud83c\udfa8 **Customization**\n-\n- Personalize your bike with colors, motor, & brand\n- customize your player with street clothes or Motocross gear\n- Ride different bikes from E-bikes to Street bikes to 450cc dirtbikes!\n\n{926362450079869}\n\ud83c\udf0d **Tracks and Environments**\n- over 20 dynamic tracks \n- Supercross tracks for dynamic Racing!\n- freestyle tracks with massive jumps and features!\n- bike life tracks for popping wheelies down the street & swerving cars!\n\n\ud83d\udd04 **Monthly Updates**\n-\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "publish
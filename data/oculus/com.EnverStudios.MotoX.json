ot4.png", "id": "137680308470668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974517_137680311804001_2482552843683822870_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lkhSLz6_FwQ7kNvwGBKyAN&_nc_oc=Adp-KVJKXhEPfSbdah8kSJ572CQ9ZmUCsFQs3rN6_l6_2pIf65YUKmpbDk3DTYBQ3rY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oblSg-DQWOtBbEswQqJIDArpwf240mKiEDG-2t4MnYA&oe=6A296753"}, {"file_name": "bike-assets_screenshot5.png", "id": "2997003700575618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031533_2997003703908951_990586037920946501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bh45uPwWkoQ7kNvwH0jIty&_nc_oc=AdqQjIlQTu8SxDrwytb6qsiV8k6i1BqzOkldgj1JsJv8NGDCKehibF2LEfpoW3ErNlc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZgKoJnVFTXY2cZsgVQjVtpjY0iNi27JDWD1UMkTXRUA&oe=6A296E6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MotoX", "keywords": [], "long_description": "(MotoX is currently under development and testing for oculus quest and quest 2.)\n\nKEY FEATURES:\n\n- Explore unique and interesting Environments\n- High-speed racing against opponents\n- Clear Death-defying stunts\n- Dodge Obstacles\n- Unique music themed for each location\n- Collect coins to unlock new Bikes\n- Progress through new and exciting worlds\n- Comfort controls\n\nCOMING SOON:\n\n- New worlds and levels\n- Character customization\n- Leaderboards\n- Target shooting\n", "short_description": "MotoX is an immersive motocross/motorcycle racing game where players can experience the speed, danger, and adrenaline of a virtual Motocross experience. Ride through 7 unique worlds that you can explore on your own or compete against other racers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.enverstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Enver Studio", "support_website_url": null, "website_url": "http://www.enverstudio.com/", "cat
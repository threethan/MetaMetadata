5158", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491826562_2695261747498491_3826068153359001121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUagIq96i3sQ7kNvwET9KPH&_nc_oc=AdqiOL-Wxx2Ey-TShG3bVqN7NlKwNdU-9Cd4aYo4S7TxU-0e8vxXCIl0OlfhtRju1Zc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BosSlT6VYidUvbJquuF0BQqCCIK88J09_JBdZ6McP1Q&oe=6A3D2FF2"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnLB4LE0Hn0Q7kNvwGXWqoh&_nc_oc=AdrtXF75a3-orx-2tVaIa8bQpwEBAg2OIPZOeAwS3QP5UKz_Ru4u6Z7F6ZjzDo1S9dA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MqgD47K6vIhJn1RTn1FCMDPoys2CwtJkdBJ4nXzkzKw&oe=6A3D4AE4"}, {"file_name": "Garage00086421.png", "id": "2448573822248239", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499299772_2448573825581572_6680320897279576694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE5rb9MOrr0Q7kNvwEy3RcA&_nc_oc=AdrHhlWYO7iHCrYMASa7r8mi9MHbOsFfIcDyX4ZsBJvv2zi57prvyYU2tjM5XmZX5SA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YmSPQmZrqEtuVqFBkg4l4UVPLZ6N_mylBUTN_0-Rnzw&oe=6A3D24DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440.png", "id": "1309298747339245", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499312338_1309298750672578_4977952955232936745_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGCOEKyIQT8Q7kNvwGY3HDH&_nc_oc=AdpFBvvDg0oi5o4vKQ6Xt0kU2MqVnRHMpgp9ssrQSS6-lGnAUzC781dGD1-UpmRkxdc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zXNMV5YOR2yC5L-7DKNijmEtvLL_opwPq2ckXIlIGnw&oe=6A3D254E"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is the ULTIMATE Motorcycle, Motocross, & Bike Life Game! \n\n- Send MASSIVE Jumps with your friends! \n- TEAR UP the mud in Supercross arena Races!\n- RIP WHEELIES through the streets while running from the Cops!!\n{2047376359444712}\n\n\n\ud83c\udfc1 **Multiplayer and Voice Chat**\n- Proximity Chat\n- Real time Multiplayer\n- Races and Free ride\n\n{796380436165732}\n\n\n\ud83d\udd25 **Game Modes & Tricks**\n- freestyle tricks including flips, whips, wheelies, stoppies, supermans,\n- Time trials to set your best hot lap \n- race against other riders world wide\n- cops and Robbers infection tag!\n\n{2136410710218739}\n\n\ud83c\udfa8 **Customization**\n-\n- Personalize your bike with colors, motor, & brand\n- customize your player with street clothes or Motocross gear\n- Ride different bikes from E-bikes to Street bikes to 450cc dirtbikes!\n\n{926362450079869}\n\ud83c\udf0d **Tracks and Environments**\n- over 20 dynamic tracks \n- Supercross tracks for dynamic Racing!\n- freestyle tracks with massive jumps and features!\n- bike life tracks for popping wheelies down the street & swerving cars!\n\n\ud83d\udd04 **Monthly Updates**\n-\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "publisher_n
261744165158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_2695261747498491_3826068153359001121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cazi0LDf6kUQ7kNvwEOHVym&_nc_oc=AdoQunWw4inJ_DBdl5kaxURxM0z2fr2W96YJ5zrYuq5EukB8_9nnswzirq64nsbYImo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmEisDPXUznBvKh4CXUBiWAtUQ4CEHH6Oq92e2aHLWww&oe=6A675FF2"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeZyGqkHzQwQ7kNvwH8WAeI&_nc_oc=AdoGGAYKjMH3BgMZlbEfRK6-o2UnUQdchl4eEWmQUDzWj4svxvn9vucY-t9iLadFsnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHVQZcu1nIkPp2Chp1Ythdkp7kLBTQgp21MQ8L7wIRuA&oe=6A677AE4"}, {"file_name": "Garage00086421.png", "id": "2448573822248239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299772_2448573825581572_6680320897279576694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WhO2rLk8gIQ7kNvwGM58D3&_nc_oc=AdqWJFeMXalkzY20FiwLZ7uvJ9yaFBQSE98RnBZYsohUPwUV8-tV0Q094z8ClxUPQ1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdlGj6yNgLgYRAYC5IGkf_-rdrIypAS7I2vYDZZsCyjg&oe=6A6754DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440.png", "id": "2154494368613333", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313107_2154494371946666_1649477589140065797_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS3feOZJ_pEQ7kNvwHDxuYv&_nc_oc=AdqIputybDqQgRZKpU-4YHRpujyVhnuN0xP76eXG7tqaavGcNucy2TLk1u0mPzD0AuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqFlg7WDVjbBguU8CErKxmUANJ35rhgGdNrFLHuSbElw&oe=6A676902"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is the ULTIMATE Motorcycle, Motocross, & Bike Life Game! \n\n- Send MASSIVE Jumps with your friends! \n- TEAR UP the mud in Supercross arena Races!\n- RIP WHEELIES through the streets while running from the Cops!!\n{2047376359444712}\n\n\n\ud83c\udfc1 **Multiplayer and Voice Chat**\n- Proximity Chat\n- Real time Multiplayer\n- Races and Free ride\n\n{796380436165732}\n\n\n\ud83d\udd25 **Game Modes & Tricks**\n- freestyle tricks including flips, whips, wheelies, stoppies, supermans,\n- Time trials to set your best hot lap \n- race against other riders world wide\n- cops and Robbers infection tag!\n\n{2136410710218739}\n\n\ud83c\udfa8 **Customization**\n-\n- Personalize your bike with colors, motor, & brand\n- customize your player with street clothes or Motocross gear\n- Ride different bikes from E-bikes to Street bikes to 450cc dirtbikes!\n\n{926362450079869}\n\ud83c\udf0d **Tracks and Environments**\n- over 20 dynamic tracks \n- Supercross tracks for dynamic Racing!\n- freestyle tracks with massive jumps and features!\n- bike life tracks for popping wheelies down the street & swerving cars!\n\n\ud83d\udd04 **Monthly Updates**\n-\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "pub
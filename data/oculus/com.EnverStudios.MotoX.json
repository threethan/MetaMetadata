sid=6e7a0a&_nc_ohc=M98KciEkt1cQ7kNvwFeXU9R&_nc_oc=AdpUeUwj7wPb-RNKq3vTSGg9pe9EBlYjxaecrPNmH8xMk1VSf1h-5DFEC4YXJkiGkNQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7aLidZhY_NVFRTEysHvO9BHUcjYozvmn3Be7ucejnhg&oe=6AFF1207"}, {"file_name": "canopy_clash 13.png", "id": "2695261744165158", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491826562_2695261747498491_3826068153359001121_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFIaWpHN2NAQ7kNvwGkzdMy&_nc_oc=AdqT3l3jZH2upfYI1yGJuSWYcQMid6Nwi4WbKBkzH2vJDF89PJoJupYxFa8n-AqmXIU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKoTQdkpVHyo22X1AGE1SucR24GpwLuAVSPTN930kldQ&oe=6AFF34B2"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3OIz2jYvl8Q7kNvwGq-F8K&_nc_oc=AdoMWlWdR3j-5dZs3wJdPWtFjQdgcwtMFFcqHywqC_bfByIqYgUu63EjvLnk1BHiBsA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_twTsJb9bSmR_aHfokekHm9-m4ffUOODROBhrcfZfag&oe=6AFF1764"}, {"file_name": "Garage00086421.png", "id": "2448573822248239", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499299772_2448573825581572_6680320897279576694_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6BCkT0kAM8Q7kNvwHkSCgh&_nc_oc=AdpLPuSGtO9KA-Cl4_1YkVJ-abq9-uVxmaqEuRoryKKIB95etsU_COuNQbGek2faaUc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgwKiVviIPJ3sQxaA1OQvFjkvTEMuZ5Id_rEkZoc_QKg&oe=6AFF299B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440.png", "id": "1830130571365933", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823790_1830130578032599_7299530168500268957_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6405uuUc2X8Q7kNvwH8cw32&_nc_oc=AdqIlz1ZCJQNXnJXEiFtdZf9UfqlF_RDzO6bdy6YV6KKHosTHonZMbwIlhoE_G9NgZw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF04FGM4IRYnan3pVXKO1CPewb9cdwq78ely2-GbFPsQ&oe=6AFF0390"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is the ULTIMATE Motorcycle, Motocross, & Bike Life Game! \n\n- Send MASSIVE Jumps with your friends! \n- TEAR UP the mud in Supercross arena Races!\n- RIP WHEELIES through the streets while running from the Cops!!\n{2047376359444712}\n\n\n\ud83c\udfc1 **Multiplayer and Voice Chat**\n- Proximity Chat\n- Real time Multiplayer\n- Races and Free ride\n\n{796380436165732}\n\n\n\ud83d\udd25 **Game Modes & Tricks**\n- freestyle tricks including flips, whips, wheelies, stoppies, supermans,\n- Time trials to set your best hot lap \n- race against other riders world wide\n- cops and Robbers infection tag!\n\n{2136410710218739}\n\n\ud83c\udfa8 **Customization**\n-\n- Personalize your bike with colors, motor, & brand\n- customize your player with street clothes or Motocross gear\n- Ride different bikes from E-bikes to Street bikes to 450cc dirtbikes!\n\n{926362450079869}\n\ud83c\udf0d **Tracks and Environments**\n- over 20 dynamic tracks \n- Supercross tracks for dynamic Racing!\n- freestyle tracks with massive jumps and features!\n- bike life tracks for popping wheelies down the street & swerving cars!\n\n\ud83d\udd04 **Monthly Updates**\n-\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://www.enverstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "39752457561068830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1813961123133599_1993700844228988976_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0krJfwmdKYQ7kNvwFynQYy&_nc_oc=AdrKJE4rA0znFHz9gImxMo82Iue-EXZmIBMP4ve3RsBzTzESIL8ICMq4dpxzwoMGofQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzIHgT_FZtNM9E6EiZeY5t7GGQJuateGo0pGasr1u-xQ&oe=6AFF0297"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotoX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, 
03700575618", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031533_2997003703908951_990586037920946501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC2mtW21syMQ7kNvwHFeXUR&_nc_oc=AdqQ9_Zz6uAyQotltcxpBPO1ITnNwncpQKFVsJXEZ4Loy8XR059fdFwHBGKuVZkBY_s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k9RaQFO7wLDB7IoI9Ep6pzazVsfWS7f0DTXkADDEa6Q&oe=6A0332EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MotoX", "keywords": [], "long_description": "(MotoX is currently under development and testing for oculus quest and quest 2.)\n\nKEY FEATURES:\n\n- Explore unique and interesting Environments\n- High-speed racing against opponents\n- Clear Death-defying stunts\n- Dodge Obstacles\n- Unique music themed for each location\n- Collect coins to unlock new Bikes\n- Progress through new and exciting worlds\n- Comfort controls\n\nCOMING SOON:\n\n- New worlds and levels\n- Character customization\n- Leaderboards\n- Target shooting\n", "short_description": "MotoX is an immersive motocross/motorcycle racing game where players can experience the speed, danger, and adrenaline of a virtual Motocross experience. Ride through 7 unique worlds that you can explore on your own or compete against other racers."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.enverstudio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Enver Studio", "support_website_url": null, "website_url": "http://www.enverstudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
58299", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982657_458340890091632_5373690084641654034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxfLsKT1B4kQ7kNvwGcD_uk&_nc_oc=AdmM0xRZjePgF9-kf_FCEhNOvWdZ0QCjKgfO-jf_d7dQwQ1toZMQAD88wtVYe2lK9j8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdxxJ5fKL3s-9-dlOYiq4Rl3v6mQ5d57nV2nbQu6IbhQ&oe=69A2E534"}, {"file_name": "Stadium (1).png", "id": "452052337284170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974741_452052340617503_7910107192848161615_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJf-1G_3TMQ7kNvwHNz-UQ&_nc_oc=Adl1biqsc8MTQKM53d4eV--Z6M3dcQxYfdRuf-3ggz7AgWpefpuTOTvwk8yuDTQLbCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuB3Qo5Qz4biYne7dATWAkhYH-cJ8JkbJUO9QaONPxO9w&oe=69A2C69B"}, {"file_name": "grassland (2).png", "id": "3695364917401126", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974691_3695364924067792_5816533097485206779_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKB-4Z3q8bAQ7kNvwGXXPeS&_nc_oc=AdmRQFY6X20pmc03OG_7Tf1YmF-6wVb68IRPGdrUxBfwo4QD_-W2u4Pkb1ezhFc4CS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0wsXeDz7kFuCY1-JjjqgbBoeBFohHxcHrbqrj4KivxA&oe=69A2EFCA"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUyWLpF-gAkQ7kNvwE4f5aJ&_nc_oc=Admoagv86DvK7O9pEsk-LpobBTvrXr07GplxIpPdJ3IGtFmAZiM8S7utMFv58LF6tXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsG0p0n6Mv0wa3kpncQyNXXpPegdgsaPzqqCny84uUVOg&oe=69A2D324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440 (1).png", "id": "912981801430240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_912981808096906_8511339949265425011_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52fKB1qYC4QQ7kNvwG-4Iby&_nc_oc=AdlWcemTRfwwdAOj-C7QufeRuE7G8PI-OWh-xWteqfmdWm4vT7HmWMPeOGW2jUjM5lM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuY8JcSaWrRsRKE7njzTMlPSlsepTrbAowSWR_Pg0rghg&oe=69A2C74B"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is a fast paced, adrenaline packed VR motocross experience that throws you right into the action. With more than 20 unique tracks and a massive selection of bikes, including several fan favorites, every ride feels fresh, intense, and full of possibilities.\n\n{2136410710218739}\n\n\ud83c\udfc1 Multiplayer and Voice Chat\nRace players from around the world in real time multiplayer and communicate with teammates or rivals using built in voice chat. Every close call and every crash hits hard when you are in the rider\u2019s seat.\n\n\ud83d\udd25 Game Modes\nTest your skills in Time Trials, challenge others in classic racing, or dive into chaotic party modes like Infected. Master a full range of freestyle tricks including flips, whips, wheelies, stoppies, supermans, and plenty more.\n\n\ud83c\udfa8 Customization\nMake your rider and bikes your own. Personalize your gear, colors, and style so you stand out on the track no matter where you race.\n\n\ud83c\udf0d Tracks and Environments\nRide through over 20 dynamic tracks featuring jumps, hazards, and environments designed to push your control and creativity. With new tracks added regularly, there is always something new to conquer.\n\n\ud83d\udd04 Monthly Updates\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n\n{801104719410318}", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.enverstudio.com/terms", "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://www.enverstudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "33522973200683995"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820141_1955936218686059_6829571066642858684_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4DTy4YQepEQ7kNvwHZwlDu&_nc_oc=AdmdKZ6LSDXppG35HAypiiUuGixgT9RWUgAiTU4G2XWKMhULpD88xf7cWPLV_h8SB-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMWGAR3-mIWKxW6QH53DGA0vyG2pLyLaVb0HAJYycbqw&oe=69A2D120"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MotoX", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", 
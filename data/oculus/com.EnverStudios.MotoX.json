 13.png", "id": "2695261744165158", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491826562_2695261747498491_3826068153359001121_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nv4U3Wf3ulQQ7kNvwG9Uw6Z&_nc_oc=AdrEAeXRSktEexCBbHAAaKp9ulR2AXdwQo-vwuh9Y_aUHsMkwHUoyHx0HtdYcjWShqI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx-2W2_DlKfRcfyM6FUnG3W3uhbz01BC2P654Fg1Vj4w&oe=6A8EECF2"}, {"file_name": "sx (2).png", "id": "995797291970221", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75234368_995797295303554_2860031137539452861_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnG-NcmdyOUQ7kNvwGsCLpp&_nc_oc=AdrsOBV9HEdT32nrCLv_v16cRct1h15vEaneTvi-5-bHaESFEnaqYr_8S9lDmngKlcE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9KTFKfO5g1u00onugk0WFGm2M4rTPvGcz1N-GoC4Xig&oe=6A8ECFA4"}, {"file_name": "Garage00086421.png", "id": "2448573822248239", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499299772_2448573825581572_6680320897279576694_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmzT5nQvvcIQ7kNvwFk3He6&_nc_oc=AdrtcC5xc69OE8-u5Gcn9SLvIiboomNhZkmbwOxKtc6xMb-3pEJag4yiRURt038yk2U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF92qFrUa6RjzET_O5oB5cTirdHJtFBSHiLxiwx2xz2BA&oe=6A8EE1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "motox_2560x1440.png", "id": "1054409517344614", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821796_1054409520677947_7275085818676504977_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-7tPIHOB84Q7kNvwGV-wVn&_nc_oc=AdqQciCC4z1_oyuzHwfqL8BjDSIYqRd5P1vD2mWylQiZM4mljDWR82LqCWWpirxPg1I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoj1Du3oZCwqatCgDwwmcYQmon9cJcqbCnyxGK0OP9QQ&oe=6A8ED420"}, "display_name": "MotoX", "keywords": ["motorcycle", "bike", "dirtbike", "racing", "Hangout"], "long_description": "MotoX is the ULTIMATE Motorcycle, Motocross, & Bike Life Game! \n\n- Send MASSIVE Jumps with your friends! \n- TEAR UP the mud in Supercross arena Races!\n- RIP WHEELIES through the streets while running from the Cops!!\n{2047376359444712}\n\n\n\ud83c\udfc1 **Multiplayer and Voice Chat**\n- Proximity Chat\n- Real time Multiplayer\n- Races and Free ride\n\n{796380436165732}\n\n\n\ud83d\udd25 **Game Modes & Tricks**\n- freestyle tricks including flips, whips, wheelies, stoppies, supermans,\n- Time trials to set your best hot lap \n- race against other riders world wide\n- cops and Robbers infection tag!\n\n{2136410710218739}\n\n\ud83c\udfa8 **Customization**\n-\n- Personalize your bike with colors, motor, & brand\n- customize your player with street clothes or Motocross gear\n- Ride different bikes from E-bikes to Street bikes to 450cc dirtbikes!\n\n{926362450079869}\n\ud83c\udf0d **Tracks and Environments**\n- over 20 dynamic tracks \n- Supercross tracks for dynamic Racing!\n- freestyle tracks with massive jumps and features!\n- bike life tracks for popping wheelies down the street & swerving cars!\n\n\ud83d\udd04 **Monthly Updates**\n-\nMotoX grows constantly with new features, content, customization options, bikes, power ups, and gameplay improvements to keep the experience exciting.\n\nStrap on your headset, fire up your engine, and throw yourself into high speed racing, big air tricks, and nonstop VR motocross action.\n", "short_description": "The ultimate VR motocross experience! \ud83c\udfcd\ufe0f\ud83d\udca8 Ride across 20+ thrilling tracks and explore a huge variety of fan-favorite bikes. Race online with multiplayer and voice chat \ud83c\udfa4, pull off tricks like flips, whips, supermans, stoppies, and more, and compete in modes like Infected and Time Trial. Customize your rider and bikes, grab power ups, and push your limits. Monthly updates keep the action fresh. Jump in and ride! \ud83c\udfc1\ud83d\udd25"}]}, "developer_name": null, "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": "https://www.e
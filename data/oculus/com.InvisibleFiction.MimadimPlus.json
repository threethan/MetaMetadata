54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_qywH3f7zgQ7kNvwGYVYLG&_nc_oc=AdqeMog1rItMkD7_YxfIgNbIw8E062MofGx8zomwfkBTTVhZyn40M6ExiEYxoKoOaQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNbbq18VIyU8Ge7dfg6TOZqgx1xv_a_W4gkd7cs11MKw&oe=6A708BB0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1xILDkYS-QQ7kNvwGtDmlv&_nc_oc=AdoJ41OmrdAiMvvEpy2ajybzakNxR6d2MtQFfVeZ_OIfGMnudBHR1Csn19F6cA8idg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYLWlLFMQ2uv7VuaPG24oqwACU_D8gL7P_xNrtyTSXpQ&oe=6A70803D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlTuqS9kF2UQ7kNvwGmhgIK&_nc_oc=Adr-WobZhbeeU327FgjduJt5RxRfuOkhQmDfFgJHH1CysY7Y8DPZKWcTgOSi_9nKUC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZt6LToceLAuOHFnU8bHvf292bDhSMEJTCrz4t7Z-j4g&oe=6A70A28B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWpzQOThycMQ7kNvwHRej3D&_nc_oc=AdpTDFPjFvaexv6PjAubdkqltdyFLdcr0QTp07-bynpsTuxb5cUv12kHL6qpbrfZRo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmrnpZ48OIehl9U7MNf5fPq89hmqXASKjwT27slOZROQ&oe=6A707775"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfx4wkuiZWYQ7kNvwE4ugm8&_nc_oc=AdqfHhqUr-EQwfO9ZIUGVyBm8W4vKBoBEofsJ0VV8DGq8KbJs3lJ42HOWBSEa8b8vu8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9hUlUWEEj62G9kDdqcI-wpGVT0Z-9R-I88MVA2-seNQ&oe=6A70A7AE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
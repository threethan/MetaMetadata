54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndw3_skDwY8Q7kNvwGK3C0b&_nc_oc=AdpVQtPvKu4Ht_4nWfDF67EF2KI1M4DG55OtsBZyKrJPFOXlDWCKIl9eZ3K7tLYa830&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq_V4abUS7jhn35DTQPK1WdmqYcgajLLz0XLbhJYgQBA&oe=6ACA69F0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lweKiWE0qAQ7kNvwGGfSMV&_nc_oc=AdqKlU7h0_TDeke6BGSzo_UtsMx-ah36pZVBXoC1mIHGiaWVAT_RjxXTmbdl7rWpvFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRLPeQ-Cn1BwFi4GCYIxyp2lXBk3_vc_krwagejmPjEQ&oe=6ACA5E7D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0o4yNyTp3ZEQ7kNvwGYeHYX&_nc_oc=AdpixjcuhvhICEqFP5tNI8zt43evTFHqVAITnFEOadLfd2v5SEbbDqXTZ5Mm18NZH-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfzVqTcAG8s6KgNJyY79pFL0gjikhezWpzC6exChP_yA&oe=6ACA488B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM5nlK_HlOcQ7kNvwG1Sl_d&_nc_oc=Ado7pvUJ_BZ-ro6hUZYtOKYU_5Tyo6ZZZdNbD6SOVbagsEoh8F4-Ztr4IHZ0YQ1O8-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO-c2O9f49Mmoh37H6lKhFsT8KPv3hX4W0QkFMj7Is_Q&oe=6ACA55B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQLBkk4PtbsQ7kNvwEm526K&_nc_oc=Adp6AAUQeChSYzI5Lty-x7qeN-kBg44cpGZc-MHmml1xgN7BX0AFtKYDGZZ_TGwmKdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIjIHQP4OA9q70ozHCTPtBFCbgzZ0zZ6HmBLRNe-Emqw&oe=6ACA4DAE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
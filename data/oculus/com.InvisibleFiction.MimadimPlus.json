54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsRwMa0iBTAQ7kNvwG9Unc2&_nc_oc=AdoUndSeZX1rzMqDL6p7ThModZOmoGtrmSVgb8YE0zVd37t6qWoiRoDmLi5BXOd8ajA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo3xnFg53vG59x4zOQBEGtDzfP8aSo47CEOj7TEqjKLg&oe=6AE76AF0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wO0AtCWKMAQ7kNvwGy78_g&_nc_oc=AdqhsR8won3XnmFQrryiWlezOBKh65VIIn5BFSB5va-_d5Njxk91TQFRemuE6EEgReY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNRfH6ix9VAe4DKWnzGdFcoWV3Mn06hIJdyMz5RfWrCA&oe=6AE75F7D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KObyCxWRcHsQ7kNvwGev3c8&_nc_oc=AdoKBrmLw_3d1WKhDp_S1QrNNINcQKA3dALJFOybj8nEZ7FOTuCf1DMFgqHwMcy-XvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfsIX7URuZ0JokeecJIaX5rY3UvI-9pwy-KmCTTfzYdg&oe=6AE7498B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzoSTZ7u5jEQ7kNvwFtYyUD&_nc_oc=AdrdPbHRa4Mu1NCe_0zxL_dEgzoC8dA-a41ljNhIPD6mAS8SwA8Nhh2594lUOlirFwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAQZsFdaeYQ2Wpd-b8O7fHpcAqgZ5pIhi1wsxVdkDkGA&oe=6AE756B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b9GK96N_cYQ7kNvwGl1Z7D&_nc_oc=AdrrN0XUVDFQXwCv5xR7Vl2A4WFfCxJmy4SsqSMeBzzZ_NGVNz0k1GbbPo2xNzyl8SA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROeCztU3x8oJn63oR5gKyR_9l4p6GoboaQqQeaCIUJqA&oe=6AE74EAE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
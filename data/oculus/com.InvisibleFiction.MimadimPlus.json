54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIUDSKRZD2UQ7kNvwG52MM-&_nc_oc=AdrkPkPexQNUYIzuUM_GbEQFQVdweaLBSHE_tBrbSTxEZy9MiXuJkGN8isQ8CNxLeao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuxfHoIqgseKnczmp4MDTwxh7QNRB0AIZY2uV0EnPkEw&oe=6A577F30"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0eZ5fn5vcgQ7kNvwEUXU9J&_nc_oc=Adozo_Of-diogNG3q-f7x-Vt2Hhfp8L1RiPC-usWoy2PX-sqJoooL3C4PT7EMgYU4P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1OKTSN4JRzYVPh-TgmZCuryLBQ2gFk2W13TmkraUFeQ&oe=6A5773BD"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6vIM8m3o2wQ7kNvwFRNXx9&_nc_oc=AdoNFDPlYDXBX7-ei7nujuc5CMnAXsAG3zgNxRs_bAvOGNIaqMxFAYCxZCYbzcmp4HA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDW102d-MDKEcrrb5EhjuwwdHzt05E1WGApWfnhiXTbA&oe=6A57960B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPnAhtKr9F8Q7kNvwGKiCOh&_nc_oc=Adrt0ISAfdAzdG94tw9tqvSKpjkFY3xTuyJ38mqTBoDD-IJIAXatHOjSTVxzqfZUXZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_OLxuXblGFEF0HycEqZjgtgqXTtU8nGROmHGDSNud_g&oe=6A576AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6h4egXY7jcQ7kNvwFnyP9_&_nc_oc=Adrl3NVlppSJ8Hlms6cQeVwLZ8HokqETqVnSckK1GSDBtH66YX_ICrrOXZnl3JnxyVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrviHwbNaSahVvjIX_6JYSOVlziKgOOQB3g0DzvFh65Q&oe=6A579B2E"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
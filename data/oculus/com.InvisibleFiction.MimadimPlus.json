54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlFHckvHs9cQ7kNvwEp4B1e&_nc_oc=AdqfR3t247VzybjXjlnVDpn9nHE-b5a9zrC0aNdM-hKlLorsXT55QaKWyPrdS0FOn7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9i5AEFvL-Y1cJf0_77JCjPRYYPTIzC_E8ZG5bxHMPkA&oe=6AA547B0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py3uegX3PmoQ7kNvwGYt9wo&_nc_oc=AdprFWGu3491FhaQLm2KsTkjF1vx4qSr-7RoWtGyXX06MZYniVad-wPuLQVh5j0E1Uc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKqoiLfGUU8Gcbuk4MxluW0KaMBICqIoic-VmdPiqY1w&oe=6AA5747D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKaTvIadZyQQ7kNvwEEvP1R&_nc_oc=AdqQ_PvwfjFONbTMgVQ05JJaATkmTG0aIl_voUM3el3j2IjzrZVPOGjGXwuxk9_5f2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIP29NraJa3cVC10voYowuTTlQSftSxwTtQfLOm3sTg7A&oe=6AA55E8B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVqH1zMdvfAQ7kNvwEW00Of&_nc_oc=Adoks2YgxfZFiwMBqVS71cs9tsBikqpdCsQXh91ZLZiqBq3s25SjN0mxlJ860FJQOoc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEG041NXQbRcLMpmgYDwSdfEhQwLpi6grw6jRc7JhICg&oe=6AA56BB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-7JGEmdSiUQ7kNvwHF52Tf&_nc_oc=Ado9OxE4p63Ye7747akNfmNK9DZGeSW9N1O1ZmYyGknw6W4pJ1vDNJHeSyVMRLhd2rw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1mTCcw6zkExO3YYpyAnkfR7Q_PzHj33dZuHRumZmX9A&oe=6AA563AE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
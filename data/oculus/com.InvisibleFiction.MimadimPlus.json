54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0cAuR6B2vcQ7kNvwGmw-MD&_nc_oc=AdqaxrSIRkC7GXBQzJs2MXvmqQJs2H9D8fHEwSCNrhqJd61mnWAJWo_ju3p4HEc_OnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2iDBmGWbEgk3J_uSn2IouvxVG1QqaWpK5KEAvroh-Jg&oe=6A60B9B0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2UTpKTjdGMQ7kNvwEtYX7f&_nc_oc=AdqrlWIcWno2xjtHp0y0_B01qsgek5pKDesswByqzmK6G3AgMuyVCWwyJRwT_A9YGic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQbKpw0PVvaP2aZXAZWCsoEjfIt2M519ylZzUIMh4XOA&oe=6A60AE3D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyUWMN5RbkIQ7kNvwE9SW1c&_nc_oc=AdqAryKkaZSjPPGeMPXzg1P162ftGK9hMkOm5DPbpsFOLekkbQ2qP6vygRFrLk11P9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN6E1mPiuQWoKcVrWDvqybeBuUlYULiDhmXFlDasIYSQ&oe=6A60D08B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCBfi5hyzoAQ7kNvwFB3lBB&_nc_oc=Adp54aMiRU7EBihfV_ZJ7NMLgFI02U-MgMnxLQwmn53BfPMl4P4zfB-bk4y5KGuhcX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_aw-F1dkp5N1DabC7pmMBvC5fHbDk_of9DIjoTPSZ0w&oe=6A60A575"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSXXFYwLNsoQ7kNvwGMBBJc&_nc_oc=AdqS-p-JlifvsgephDIiuJTRxzNMAyrtzCQUG2FbWmCfPvtZ4pOai0ycyH1Vmp2PHAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9RBJVBjRU1B0Is2odqmQ3mPy3n7U9HVx6Hw5GOPtWRg&oe=6A60D5AE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
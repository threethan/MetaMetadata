54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuwdjW--hFwQ7kNvwEyH93Y&_nc_oc=AdpkTRg4aNjLdpvKBTkHU-QPEeU7DjDFqxk1m1SxYiQDBdzZ3egySit-fGoHycNVrHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxvmyYW2e8I1wr7LUBZ002Q5Mcf2B3jZ4HCOxRnSCpgg&oe=6A635CB0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFJGxEy9H4cQ7kNvwHVpb04&_nc_oc=AdpyWcuMtn41p9prcolPXwYseX-LI7xBhpHFBJmwkC7sGXfquFoNNUw5Bd5BI2PIp08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZJH-uBU_YhxK7-MIt7uL4sHKI21IYmL52n7xAWZ85rA&oe=6A63513D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJRHjSKcav0Q7kNvwH_yq8K&_nc_oc=AdpcAJ2SVvc4Vo5xyqel0QBMh-ZzK6rMgxyqu_SqjWbCYN-cxC8pIY8vblMYJHQvFik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfner7FqH5FPjfIBo8IMsvYmfAEzwmEYjpgYbxkJEkHg&oe=6A63738B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCBfi5hyzoAQ7kNvwG_CYN4&_nc_oc=AdqrKHHzOuJsK4t7xGlP9TtghzExjqC2yWCebgV8tm1naG9orMpAJvNp55BanbpXeyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUMJy5g6rMmvvFv72UT3p76EtMusZrFaEAFlbo9wkxkg&oe=6A6380B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSXXFYwLNsoQ7kNvwEV3ywb&_nc_oc=AdqzWeLo7pJuCC7KH40ExRpBGKbxzD-X9nWmR-yRg-Ww2knsWSnXbPnC8VMDCbxHvUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrHNvzfRKezAkTQXjHJCcUcIVQzC593zhNFGtMeTUoqA&oe=6A6378AE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o06CjEclPhAQ7kNvwG0AZpZ&_nc_oc=AdrTw8YYR2771-MwEFgcckK93aOwPaN4vP1MrFTDgRp-d1KKEtkMzzVHpCNKOKhFoN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5zAFR9SpPpFVHiYi0ZyeOdtn4G4nO3FYkmFFvdL5hHw&oe=6A48FEB0"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPf-kBXXVkMQ7kNvwGtpE_m&_nc_oc=AdpL3voTjQtN4g60bbPcv59jAO3Lyh8_VwihVxfAY1AEJOVYHcIO_nnxVrKXsmVQtHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh457mxczfQKqMJHvCr_w3eEc3RORuXzlscm78gbEV8A&oe=6A492B7D"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIpFgmTVJukQ7kNvwES7Ejl&_nc_oc=AdruQyhQsp_85hQD4RRK2uoYnOQJm2CseBhb_am2AlnEdmoXH-gIhOoyCQHRlFWgS5c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnAyax806tgL5FpTJamv00tCBkP3gAuLfmFO1viaKhFg&oe=6A49158B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHvBA98xSdYQ7kNvwFwm5vY&_nc_oc=Adra4DOZZfk5YORvoF4aID75_Xlt8ADd-sLxZDgVSnkYSe5um6pEHPVQLCtEzyIzxCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUt0dDKwC9yCToQYZvEVt6lFXLMkvDYac-7rZxp_4EQA&oe=6A4922B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h51ahvtdWbEQ7kNvwEYQt1t&_nc_oc=AdoLZagqfxPC2vx86MVDgsPSFexiyBaOsTGhqhmKS2oFwCYh0W4_-8oUplS1M8jU04o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRZNnhisrUKv0ShT7oOSdhuKhc6gsKYzR5X_JE-yYX2g&oe=6A491AAE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lah-WdUMD0kQ7kNvwHpqXP5&_nc_oc=AdpX1jC6IVtRqDBi4-2zZrXPAp3Tr95nmSWmiuUYJR3agiXwrg1vusSUy0t5hpqkWTE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQpi9wjk69ZMutaTiQqvpe1iDaY8O1JMwS-MiRNbzazw&oe=6AB3C830"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEgmDFUhIRoQ7kNvwEUp6Gc&_nc_oc=AdqZc1jg7BJ0cTtacSWyKa3BBpnUbvzv9GyngJP9IYSxpasF3euPmWpZJb6e8Gi0eBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3QKWFc09IUTuEMH4Nyir2PScMsajbCMP6t9yCsB6qYA&oe=6AB3F4FD"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETIlOc1FLY8Q7kNvwG-edhS&_nc_oc=AdrQ4o609HTUpgBqB-EQD0aRtRUkJ6gXzgYl_GYH4wHlwbEmoRQRXk4cZKNbJEwNVh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLd0yYxwmaOn2qer9k7OAmlrAhz0KnEBJoWAsjBXJdIQ&oe=6AB3DF0B"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u14ACQoJPh8Q7kNvwE6RkZF&_nc_oc=AdpfPhhK8AUuvIqXkl7IcveDRseUAZanK2p_eySQduGP9RC9JkyIQWyur3TlmBeOAdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkpi2F5FxQ7bUogc1wi00w6YOQq80O02-k8AdfDQicDw&oe=6AB3EC35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlyVQ5oPm5EQ7kNvwHj2qTf&_nc_oc=AdqT4Ek83j1Wcxeykx7r-9SsMZ8AUDetD00pHulpWv6Aa5bynUul_sIMTezVIdX6dq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7ggRgMb_lcl8LFhMfMOMuCokQ5khTZj2xs9pLPfLh2A&oe=6AB3E42E"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
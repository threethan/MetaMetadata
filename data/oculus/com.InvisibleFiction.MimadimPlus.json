s://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgQtd2A5h-gQ7kNvwHYWf1O&_nc_oc=AdqcS6YWJLMJcZpQokIW_wTyg3xKxxiqEtPuq8EICuq9pm-KyQ3G7KJtoirlVK2euFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0tY3zfi3fBnmr7RfTI2oykwIA2b5r6tsEje33RlLAJA&oe=6AFC66AE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "he"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26915609481379554"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1985314345718669"}]}, "baseline_offer": {"id": "1985314345718669"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779507240, "status": "PUBLISHED", "id": "1985314345718669"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28170794345861055", "version": "1.5"}, "id": "892099030314432", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26845670888373414", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28170794345861055"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "892099030314432"}]}, "change_log": null, "created_date
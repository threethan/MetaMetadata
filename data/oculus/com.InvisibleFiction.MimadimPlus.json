54835475080_6072759644487257316_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDn1p6U7S1AQ7kNvwEPabeU&_nc_oc=AdqiuUG2za-7A9soa8TKxI2o0WzSQhdmgriz8N3MQLfDN67onmf2oN9nUNkKQJUJLps&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1I9jn7igWqMe4K6PIkK5qz6KViKEZXi5tHt3gi32Dsw&oe=6A942430"}, {"file_name": "M5.png", "id": "1567288334354408", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823341_1567288337687741_4010631852157023653_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYadHnz08qoQ7kNvwHbnV32&_nc_oc=AdoViggItqg_MfTVBBWxFc-Xb0_GnUEV22M2CYf_2l37hPHqZtuDYjJAddBhgurPx3Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGncIMkNY5zgGUuDUJrzSul9StZH2ftzyhEIDd9eFS-8A&oe=6A9418BD"}, {"file_name": "M3.png", "id": "863233860036029", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825415_863233866702695_7594996010894924049_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FAs12OKfJMQ7kNvwFU_dYJ&_nc_oc=AdpZKaSH17GkWRLyowwK9Sx7BFnwykupZJ6KlinQHMweRXGgJNcye9br51fAt-vDBGE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESeElzG1gq2F2efOzCNczjhnTqbeL5FPAYy7UsAIW-uQ&oe=6A9402CB"}, {"file_name": "M4.png", "id": "1256458843294367", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491825481_1256458849961033_5510060665010740543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de5hMLWID3IQ7kNvwEd056P&_nc_oc=AdqgtEr7IKYsRvDMZdDVEvapxBWawKEtzhWvnOw3ZfLfIwTju-FOKIbKISQrAk2cdLw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlRLgb-acT7yHOM31GZVGdZ8jflYR2_ywIqTRGrJ7UKQ&oe=6A940FF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "L.png", "id": "26178720025095428", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824292_26178720041762093_7455414685665113387_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRQ6z5hjeZMQ7kNvwHY96IN&_nc_oc=Ado2nQUpdeJdEd3YxbXUK4z-KrDhj2dUDAsjQic-NleTm9wv077oSweEOIJONm4Rdcs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGp3B2hn6wTdLRpvGzY43quO02Ei9bEShMTjXjTciRyQ&oe=6A9407EE"}, "display_name": "MimadimPlus", "keywords": [], "long_description": "Mimadim Visualize is an advanced visualization software that helps you see how ceramic and home tiles will look on your walls through stunning and realistic 3D rendering. With a wide variety of colors, textures, patterns, and designs available, you can effortlessly explore different tile combinations and discover the perfect style for your space before making a final decision.\n\nWhether you are designing a home, planning an interior project, or showcasing tile collections, Mimadim Plus Visualize provides an interactive and intuitive way to bring your ideas to life.\n\nProduct Features\n\nUser-Friendly Interface \u2013 Designed for easy navigation and smooth design exploration.\n\nExtensive Tile Library \u2013 Choose from a large collection of ceramic and home tiles.\n\nRealistic 3D Visualization \u2013 Experience true-to-life rendering of tiles on walls and surfaces.\n\nFlexible Design Customization \u2013 Adjust tile layouts, patterns, and arrangements according to your preferences.\n\nIdeal for Professionals and Homeowners \u2013 Perfect for interior designers, architects, tile manufacturers, and homeowners.\n\nConfident Design Decisions \u2013 Preview your space before installation and choose the best tile combination with confidence.\n\nTransform Your Design Experience \u2013 Explore and visualize your space in a completely new and interactive way with Mimadim Plus Visualize.", "short_description": "Mimadim Visualize is an advanced software solution that enables users to view ceramic and house tiles on their walls in realistic 3D visualization."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mimadim-plus.co.il/PrivacyPolicy.asp", "developer_terms_of_service_url": null, "publisher_name": "Mimadim Plus - Tiran Naor", "support_website_url": null, "website_url": "https://mimadim-plus.co.il/", 
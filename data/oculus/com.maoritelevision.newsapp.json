nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr3FvItkr37-zwIhQNyJ42UqOwnAxFYqBth_ZhPnVsgw&oe=6ADCABE9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "M\u0100ORI+", "keywords": ["Movies", "TV", "Streaming", "Maori", "Aotearoa"], "long_description": "M\u0100ORI+ - Nau mai, haere mai to our world of content.\n\nDiscover a world of M\u0101ori stories, culture and entertainment, all in one place. Watch your favourite programmes on demand, stream live channels and events, and enjoy content made for the whole wh\u0101nau - anytime, anywhere.\n\nWith the M\u0100ORI+ app, you can:\n- Stream M\u0100ORI+ shows whenever it suits you\n- Save your favourites shows to My List and watch them later\n- Pick up where you left off across your devices\n- Create dedicated profiles for each of your wh\u0101nau members\n- Browse content across easy-to-navigate categories\n- Watch LIVE channels, programmes and special events", "short_description": "M\u0100ORI+ - Nau mai, haere mai to our world of content.\n\nDiscover a world of M\u0101ori stories, culture and entertainment, all in one place. Watch your favourite programmes on demand, stream live channels and events, and enjoy content made for the whole wh\u0101nau - anytime, anywhere."}]}, "developer_name": "Whakaata M\u0101ori", "developer_privacy_policy_url": "https://www.maoriplus.co.nz/privacy-policy", "developer_terms_of_service_url": "https://www.maoriplus.co.nz/terms-of-use", "publisher_name": "Whakaata M\u0101ori", "support_website_url": "https://help.maoriplus.co.nz/", "website_url": "https://www.maoriplus.co.nz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
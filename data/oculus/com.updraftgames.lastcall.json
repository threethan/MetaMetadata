-25/499620504_1164115306783906_797520033635006948_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77mPxR7-ZqIQ7kNvwEqpewh&_nc_oc=AdpScCIUwa0loErvzmi-xSkyQ0JPxNr4ECY57UXGYlj4fPTZ1Kc3_xARtQtdKYAtGtQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdDHgSUySEjrVZp6LHh6kwKDBL0n7EuZ4ghh1pKuH38w&oe=6A884613"}, {"file_name": "square2.png", "id": "849825518182048", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499623443_849825521515381_6675906803831097607_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeX8M34uLXIQ7kNvwHL4j8s&_nc_oc=AdqXlZ5H0JT-H1b5m-FGcJxot4rRRMq8SFseb_vi7AT7W4cB83gkZoql5kkQJmnvcnw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8finQITVkCmIrPgnocZcw4ZpvQpIRpWIO16phYGZy0g&oe=6A8826BF"}]}, "id": "1670359984167435", "locale": "en_US", "screenshots": [{"file_name": "com.updraftgames.lastcall-20260603-191818.jpg.png", "id": "1543672887100027", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/654944867_1543672890433360_7774108365226316791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NnA5G0uiTsQ7kNvwEqsL0N&_nc_oc=Adr79GPb-X_6xsBO99fNP-BKMPSXPPhWtX1jHjOqcQtMihFI1_zhXjmfxktnxOChL50&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVeZ5SnckWk7-UTFQHl0ccuOPqbNg53lCCoxwSzGhJEg&oe=6A882B84"}, {"file_name": "com.updraftgames.lastcall-20260603-191911.jpg.png", "id": "2117981405814415", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622325_2117981409147748_3989751554669073772_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3r8eKVZQosQ7kNvwEZLTSE&_nc_oc=AdrFgk8YuEvqYW7rlrUV9Cdxc0e9bAYrHm14GEEH5FjQ0yVi2d2Fzd5zgYBzu2MA_zk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwfgxSVKcCxCjlbgwXGZstypli_x_GxJQIN_hKSbkAcQ&oe=6A883996"}, {"file_name": "com.updraftgames.lastcall-20260603-191922.jpg.png", "id": "1653998232551638", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619836_1653998235884971_4483168006517200688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2jMK06sbHwQ7kNvwElp6F_&_nc_oc=Adq2kMnJp2qTJ81zeSFPIo9BrC_o0-Wz7CEL9NXW4j1BQxBgQ846qkak6mWZ3_Nc2DA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUqtGqIMeLfNQrevsBhS1dUJkwmg-Of4mPYnqsjlwEnQ&oe=6A881D3A"}, {"file_name": "bar.png", "id": "922744327484629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/604282317_922744334151295_1715531775011910378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvwY0TFxwuYQ7kNvwG8P5e-&_nc_oc=AdqtxcBTft_VATrgSDDjsP2Cq0EpZ5YLVrmjZhgXO_tOxoJmr0hlywgeLieFkTrFzgA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhqrFz14hL2zDungn6Qn8K4CuhQM2Qn7YuZTxO8GWPzg&oe=6A8846A7"}, {"file_name": "darts.png", "id": "1368510661762989", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619808_1368510665096322_7740642905468906128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UA8noNPo_kEQ7kNvwFXtl-w&_nc_oc=AdqFZErcu27Ggjl-S2MPkMVg0-ycgOjQ_niBYTXblCgetAf1ibD7cfC-Qq-3Nwou7yc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvKX1WUfxuKMz0XI2v5P4U6DutPvSqqzs73n_ri-Y4fw&oe=6A884B5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Call", "keywords": ["Tavern", "Bartending", "Sim", "Barkeep", "Darts"], "long_description": "Step behind the bar in Last Call, a cozy VR tavern sim for Meta Quest 3. You're the barkeep for the evening.  Customers arrive with orders and it's up to you to pour the right drinks, mix in the right syrups, and serve them before the night is over.\nNail the perfect pour to earn maximum coins. Too little and you'll disappoint. Too much and you've wasted a good drink. Get it just right and the coins fly.\n\nCustomers call out their orders in voices and react to your service. Pour a perfect drink and they're delighted. Mess it up and they'll let you know.\n\nWhen the bar quiets down, step over to the dartboard. Physics-based throwing mechanics let you line up and throw for coin rewards between orders.\n\nFeatures:\nMultiple drink and syrup combinations\nAI customer voices with dynamic reactions\nPhysics-based dart throwing\nWarm stylized tavern environment\nCoin economy with per-shift scoring\nBuilt for Meta Quest 3", "short_description": "Step behind the bar in this cozy VR tavern sim for Quest 3. Mix and pour drinks for customers, add syrups, serve and earn coins as tips. Then step up to the dartboard and throw for extra coins with real physics-based throwing mechanics. Features AI customer voices, satisfying sound effects, and a warm stylized tavern atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Art", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1109167722285287"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971254972183605"}]}, "baseline_offer": {"id": "971254972183605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781074800, "status": "PUBLISHED", "id": "971254972183605"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1109165062285553", "version": "1.0.1"}, "id": "2070247607705209", "channel_name": "LIVE"
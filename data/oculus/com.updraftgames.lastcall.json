5&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jL9XYLQOakQ7kNvwHH2_g9&_nc_oc=AdpGpKAbFLXDRt1UYgNvNlwR72xftfR_AdM2Tmdk_1H-GQWxIL0FG2gXIRw5Aku6r4k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCT4-Ic-nRk7RmCWCS2eF1vmWIvJaEwgv3mRH0gpGhiw&oe=6A58D55F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499620965_1520417306160873_2373533964063016548_n.png", "id": "2262913774538508", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622315_2262913777871841_4623763310539038282_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPEzW_O06O8Q7kNvwFYAqqm&_nc_oc=AdrVY127D2rnLPsc7vMlXDKNQbj7mg-of1qMeNwPBsvoBX63Se2S5FvUNmi0gV4vKx8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsVXH8yNfXGIvDeL4nXKiaRwyKhcP8Fyju76BCHX-emQ&oe=6A58DAE9"}, "display_name": "Last Call", "keywords": ["Tavern", "Bartending", "Sim", "Barkeep", "Darts"], "long_description": "Run the bar in Last Call, a cozy VR tavern sim for Meta Quest 3.\n\nPour drinks, mix syrups, serve customers, earn coins, and throw darts after your shift. Customers call out orders and react to your service, so accuracy matters: pour too little, pour too much, or get it just right for the best reward.\n\nFeatures:\n\u2022 VR drink pouring\n\u2022 Syrup mixing\n\u2022 Customer orders and voice reactions\n\u2022 Fill-level scoring\n\u2022 Coin rewards\n\u2022 Physics dartboard mini-game\n\u2022 Cozy stylized tavern", "short_description": "Step behind the bar in this cozy VR tavern sim for Quest 3. Mix and pour drinks for customers, add syrups, serve and earn coins as tips. Then step up to the dartboard and throw for extra coins with real physics-based throwing mechanics. Features AI customer voices, satisfying sound effects, and a warm stylized tavern atmosphere."}]}, "developer_name": "UpDraft Games", "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Art", "support_website_url": null, "website_url": "
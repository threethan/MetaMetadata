oTebXrp-FSPCQSJLd4THBZzGJ-1GP7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFcJxKaENs6gvKkXpE1ikXUelR3LHlBO_lUtta0idozA&oe=6A58D0A7"}, {"file_name": "darts.png", "id": "1368510661762989", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619808_1368510665096322_7740642905468906128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jL9XYLQOakQ7kNvwHH2_g9&_nc_oc=AdpGpKAbFLXDRt1UYgNvNlwR72xftfR_AdM2Tmdk_1H-GQWxIL0FG2gXIRw5Aku6r4k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCT4-Ic-nRk7RmCWCS2eF1vmWIvJaEwgv3mRH0gpGhiw&oe=6A58D55F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Call", "keywords": ["Tavern", "Bartending", "Sim", "Barkeep", "Darts"], "long_description": "Step behind the bar in Last Call, a cozy VR tavern sim for Meta Quest 3. You're the barkeep for the evening.  Customers arrive with orders and it's up to you to pour the right drinks, mix in the right syrups, and serve them before the night is over.\nNail the perfect pour to earn maximum coins. Too little and you'll disappoint. Too much and you've wasted a good drink. Get it just right and the coins fly.\n\nCustomers call out their orders in voices and react to your service. Pour a perfect drink and they're delighted. Mess it up and they'll let you know.\n\nWhen the bar quiets down, step over to the dartboard. Physics-based throwing mechanics let you line up and throw for coin rewards between orders.\n\nFeatures:\nMultiple drink and syrup combinations\nAI customer voices with dynamic reactions\nPhysics-based dart throwing\nWarm stylized tavern environment\nCoin economy with per-shift scoring\nBuilt for Meta Quest 3", "short_description": "Step behind the bar in this cozy VR tavern sim for Quest 3. Mix and pour drinks for customers, add syrups, serve and earn coins as tips. Then step up to the dartboard and throw for extra coins with real physics-based throwing mechanics. Features AI customer voices, satisfying sound effects, and a warm stylized tavern atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Art", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1109167722285287"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "971254972183605"}]}, "baseline_offer": {"id": "971254972183605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781074800, "status": "PUBLISHED", "id": "971254972183605"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1109165062285553", "version": "1.0.1"}, "id": "2070247607705209", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1102883009580425", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1109165062285553"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2070247607705209"}]}, "change_log": null, "created_date": 1780687131, "id": "1109165062285553", "version": "1.0.1", "version_code": 2, "r
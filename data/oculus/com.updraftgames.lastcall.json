KEA&oe=6B103C56"}, {"file_name": "com.updraftgames.lastcall-20260603-191922.jpg.png", "id": "1653998232551638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619836_1653998235884971_4483168006517200688_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vX52x8romoQ7kNvwEEsNX0&_nc_oc=Ado2ml90LuYbafRDY_KIDGU0m16YstA9RhP3yyfgkA90oUcgH4kxlRUc96G7G7yeK1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXD74sweXvsEjzUjS5__xnaSWwA2iqsORRIW6bac17iDA&oe=6B10583A"}, {"file_name": "bar.png", "id": "922744327484629", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604282317_922744334151295_1715531775011910378_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ya7En2ApYIQ7kNvwGscrGZ&_nc_oc=Adoo-NzxlbCPwCWSDoUT6SsdZp9a167A4SXb3KnJ-97dmRiqwBryzJed7SDQVHA_ssg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsvulvzAbFQMAICY39VaNA-0kQXLV5H4oaucwt8WdwiQ&oe=6B104967"}, {"file_name": "darts.png", "id": "1368510661762989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619808_1368510665096322_7740642905468906128_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqly4Au8ryUQ7kNvwGebAew&_nc_oc=AdpK2sWJdF8IwIYV6MvBPkbbUX_WxxYG6QE00XM68br67dpvCFNQmrU2A0nsuljFrU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU-Uag_Zrifdg5itKk8X0bifgVtITG8dH0xoaMWtKPD9Q&oe=6B104E1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Call", "keywords": ["Tavern", "Bartending", "Sim", "Barkeep", "Darts"], "long_description": "Step behind the bar in Last Call, a cozy VR tavern sim for Meta Quest 3. You're the barkeep for the evening.  Customers arrive with orders and it's up to you to pour the right drinks, mix in the right syrups, and serve them before the night is over.\nNail the perfect pour to earn maximum coins. Too little and you'll disappoint. Too much and you've wasted a good drink. Get it just right and the coins fly.\n\nCustomers call out their orders in voices and react to your service. Pour a perfect drink and they're delighted. Mess it up and they'll let you know.\n\nWhen the bar quiets down, step over to the dartboard. Physics-based throwing mechanics let you line up and throw for coin rewards between orders.\n\nFeatures:\nMultiple drink and syrup combinations\nAI customer voices with dynamic reactions\nPhysics-based dart throwing\nWarm stylized tavern environment\nCoin economy with per-shift scoring\nBuilt for Meta Quest 3", "short_description": "Step behind the bar in this cozy VR tavern sim for Quest 3. Mix and pour drinks for customers, add syrups, serve and earn coins as tips. Then step up to the dartboard and throw for extra coins with real physics-based throwing mechanics. Features AI customer voices, satisfying sound effects, and a warm stylized tavern atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://updraft.art/#privacy", "developer_terms_of_service_url": null, "publisher_name": "UpDraft Art", "support_website_url": null, "website_url": "https://updraft.art/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1109167722285287"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Androi
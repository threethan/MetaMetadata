on movement system."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/80eccaa3-578a-4e66-9c7c-a132dd9affb7", "developer_terms_of_service_url": null, "publisher_name": "Snow", "support_website_url": "https://discord.gg/c85TKEHmBG", "website_url": "https://sites.google.com/view/cubebouncersvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27714021208281934"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303088_2188604255018571_3410194762931000333_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX-EbYy_nW0Q7kNvwHI51Sv&_nc_oc=AdoWcLc11WqCtlqO0sLIQHx58tpoAVeR1dwKOm6Pp_5G5JMoAHS_mgzEQVOilXi2CLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLKXyunLNU85Fx8-ShAZggn9xo2XCYwTkrbkCmUlN9yg&oe=6AFDD6BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cube Bouncers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout", "id": "1023770785722696"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1764975540, "lastRevision": 
021_1227437425788816_5133817210678233628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR2aVM3wzTEQ7kNvwGS6hlU&_nc_oc=Adkxlpf7pTGEPJayRGU9CFBW6qL_Gl17aIzfogxfoyKLx0inBRNDnqVZnTY_-L0IF6c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftmktz3CkyFlnY3_uElDw_Ad_L6bI8czv-Pdy5TOvjrAQ&oe=6999B707"}, {"file_name": "\u548c\u8c10\u724804.png", "id": "1221179489502688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499321663_1221179492836021_5493627379067059806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iJp4F6x8swQ7kNvwGLaLh8&_nc_oc=AdkHNCsykJADL_LAyMYNOhGmiTahiXvNHFJpQC4vFqJAKvpWrVKcb0VkDs8KimOHgiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv1rWtV3-amr2TW9dP7m39OAl3egsdtzT1-CNs6pv62jw&oe=699993E3"}, {"file_name": "\u548c\u8c10\u724805.png", "id": "566120309906573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499333080_566120313239906_5650787227111496157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCTi6DE_dAQQ7kNvwHH8-PQ&_nc_oc=Admgim_PUu75e4hHDyEZWM5wdyip-KfXr6UTYtqhoNsh2PhpZz_gdZihhlerNYOw9Jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftO1d4KLAeFCC5gBjweahrTor-tn_VtbOY_PSArIQAHtg&oe=6999BFCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "\ud83d\udca5**Afraid of Ghosts? It's Okay!** In **Scary Free**, even **the timid** can become **ghost-busting heroes!** Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!\n\n\ud83d\udc7b**Play with up to 3 Friends**: Look for clues, hide from spooky ghosts, and solve puzzles. It's **scary**...but also super fun.\n\n\ud83c\udfae**Use Cool, Real-Feelings Tools**: Pick up ringing phones, throw water, pull switches, and listen to creepy seashells. Every move feels **real and intense**. \n\n\ud83e\udddf\u200d\u2642\ufe0f**Watch for Ghost Signs**: Ghostly screams, shaking walls, bleeding pipes, phones ringing by themselves\u2026 **spooky stuff** is everywhere.\n\n\ud83c\udfad**Unlock Outfits and Power-Ups**: wear a Freddy mask, take a pill to look like a ghost. Each level-up brings **new tools** and **deeper gameplay**.\n\n\ud83c\udf10**Join the Community**: Make your own **ghost-fighting style**, and share it with others in our Discord.\n\n", "short_description": "Afraid of Ghosts? It's Okay! In Scary Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "30716760334577911"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4029455684000723"}]}, "baseline_offer": {"id": "4029455684000723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749179760, "status": "PUBLISHED", "id": "4029455684000723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
11-1.oculuscdn.com/v/t64.5771-25/499618264_2944016102470392_9184905461873341867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9kT6yYYvqsQ7kNvwHqTeeQ&_nc_oc=AdogVT-xe3AlVehHqGQeIQLqxBRyzHvNKT8YH_mYub2LWEYCV-zaPg7G3NFEOCyVxB4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1gs1MMS8mi0VqgUV5uJ3Un3xGjHqDmiKPAbLDXAnKkQ&oe=6A85891F"}, {"file_name": "\u622a\u56fe05.png", "id": "848878710821240", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823351_848878717487906_3040436976973346928_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1etAtmMU7yYQ7kNvwFsvwMt&_nc_oc=AdqWL3kJFhf-Vg4KpOSKvoVu1Pi6L7px-Q6yyN1OQn0xjnLLzQs3vxeNbOCZU5LjWZs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn_Fvi1Mu4YX9j0mc0YlaUO1Ns_Cl90O9DuDTWc_NI1w&oe=6A857C12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Escape Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "Jump into the action with Scary Escape Free, the ultimate ghost-hunting where you solve puzzles and outrun scary demons! Check out our latest update with 4-player co-op and massive 10-person lobbies to take on the haunt with your whole squad. Whether you're decoding clues or sprinting away from screams, get ready for an epic mix of scares and high-energy fun! \ud83e\udddf\u200d\u2642\ufe0f", "short_description": "Afraid of Ghosts? It's Okay! In Scary Escape Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": "SUPLIFE", "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
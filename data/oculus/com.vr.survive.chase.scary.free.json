11-1.oculuscdn.com/v/t64.5771-25/499618264_2944016102470392_9184905461873341867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4RNhthT8xYQ7kNvwFkTCYu&_nc_oc=Adqf_4NkD2TSot4XlmymejlW14rHtTv49mMiI38iGHgrugoMHjOwOkwR6TmcQA6Ezqc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7fFDWtKO4HjQryvNuOGLAPqwlEvwtqJat-TInnfR97Q&oe=6A8D721F"}, {"file_name": "\u622a\u56fe05.png", "id": "848878710821240", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823351_848878717487906_3040436976973346928_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZRQaxld2BwQ7kNvwHK2s0P&_nc_oc=Adpsl7_gUPgyouVpQKc9dn9FmkkUcS72NQHaSKoPinWmHxULNPT_fLgGvpc3wd8L0jI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5AXUKZrjnk8p4gcgOp-sLqf2n5WFlDNqeVWNZoWnWsg&oe=6A8D9D52"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Escape Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "Jump into the action with Scary Escape Free, the ultimate ghost-hunting where you solve puzzles and outrun scary demons! Check out our latest update with 4-player co-op and massive 10-person lobbies to take on the haunt with your whole squad. Whether you're decoding clues or sprinting away from screams, get ready for an epic mix of scares and high-energy fun! \ud83e\udddf\u200d\u2642\ufe0f", "short_description": "Afraid of Ghosts? It's Okay! In Scary Escape Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": "SUPLIFE", "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
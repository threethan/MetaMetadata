021_1227437425788816_5133817210678233628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JgtacZ0NmMQ7kNvwE2Ukp3&_nc_oc=AdnxqiOXRiWUa1w2F2ofjgpMYlqNgVC4zHeLxf-nv74IyZVyO4AmtYufTY5tGeyH06g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuezelS565LVEjn6aWcFGgKkj7EUWTIBskG2sreAFj_6g&oe=69A59487"}, {"file_name": "\u548c\u8c10\u724804.png", "id": "1221179489502688", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499321663_1221179492836021_5493627379067059806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieTC1v0G2noQ7kNvwHkDv8B&_nc_oc=Adng54_4kvFiMJ9x-puFFMUEKzhUYwZtPNXTtAhmPmlv_GBDajsawPkyK7Hwm6enRzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft0esrHDDTwjvQC714tO1f4gYdLZXQQxNVv8DTuMEI10g&oe=69A57163"}, {"file_name": "\u548c\u8c10\u724805.png", "id": "566120309906573", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499333080_566120313239906_5650787227111496157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZajzowoUOkQ7kNvwGRIjRH&_nc_oc=AdmjpWI6b0Btj3jAdatsLCjB1X9SvoaGAprwY-xTmw-5LePWqt2nAhbCf1ViW15n1cs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuBlnkYnzFzCz7IiZI_miX5jXAqZQFBHXr-Is23Kq2biA&oe=69A59D4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "\ud83d\udca5**Afraid of Ghosts? It's Okay!** In **Scary Free**, even **the timid** can become **ghost-busting heroes!** Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!\n\n\ud83d\udc7b**Play with up to 3 Friends**: Look for clues, hide from spooky ghosts, and solve puzzles. It's **scary**...but also super fun.\n\n\ud83c\udfae**Use Cool, Real-Feelings Tools**: Pick up ringing phones, throw water, pull switches, and listen to creepy seashells. Every move feels **real and intense**. \n\n\ud83e\udddf\u200d\u2642\ufe0f**Watch for Ghost Signs**: Ghostly screams, shaking walls, bleeding pipes, phones ringing by themselves\u2026 **spooky stuff** is everywhere.\n\n\ud83c\udfad**Unlock Outfits and Power-Ups**: wear a Freddy mask, take a pill to look like a ghost. Each level-up brings **new tools** and **deeper gameplay**.\n\n\ud83c\udf10**Join the Community**: Make your own **ghost-fighting style**, and share it with others in our Discord.\n\n", "short_description": "Afraid of Ghosts? It's Okay! In Scary Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "30716760334577911"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4029455684000723"}]}, "baseline_offer": {"id": "4029455684000723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749179760, "status": "PUBLISHED", "id": "4029455684000723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
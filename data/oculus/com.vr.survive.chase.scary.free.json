cdn.com/v/t64.5771-25/499618264_2944016102470392_9184905461873341867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQJEYBWETPQQ7kNvwGGqeK0&_nc_oc=Ado54pgwcxIq5u13C7gVQ7cyvFyMkOEFkP5ZxF07PnSTmlFdeucS2Wx59wF4xwf5K9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBOxl1TiOrOMsdhzGfSpWj2mKe3I9hrqZ1N2FzrmqGNw&oe=6A7740DF"}, {"file_name": "\u622a\u56fe05.png", "id": "848878710821240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_848878717487906_3040436976973346928_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXYpqeMA_ngQ7kNvwEJ9YH0&_nc_oc=AdqOaYdizceXtU-ea0f_DkTYrfZT4grJU8qYe1iAPdzeenLGRrAvEFYEYa0LC64k6kc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyziz8PPwxX7-kGYaauCYpiGV5HDwacDb1Qt2m3jN9_Q&oe=6A7733D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Escape Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "Jump into the action with Scary Escape Free, the ultimate ghost-hunting where you solve puzzles and outrun scary demons! Check out our latest update with 4-player co-op and massive 10-person lobbies to take on the haunt with your whole squad. Whether you're decoding clues or sprinting away from screams, get ready for an epic mix of scares and high-energy fun! \ud83e\udddf\u200d\u2642\ufe0f", "short_description": "Afraid of Ghosts? It's Okay! In Scary Escape Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": "SUPLIFE", "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
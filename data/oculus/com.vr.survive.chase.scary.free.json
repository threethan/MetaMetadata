IPqHIzclX5A8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tuNGo9inJvtAzDUXSDv8E3VdVTEUPRODXiR7mDq-7Cg&oe=6A36A5A2"}, {"file_name": "\u548c\u8c10\u7248010.png", "id": "1227437422455483", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830021_1227437425788816_5133817210678233628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzfyZJ_1FZ8Q7kNvwGss2MS&_nc_oc=AdqdqfrAxC41B3kFdM0Xy2RscrsGDgN8WbwRlUN9emajB7CDxFvV4wL1JUIJsryzB6A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_arD3gctlCoRcTN5FoLdqzIrJxarnnzjoK_tDy7ysQ0g&oe=6A369987"}, {"file_name": "\u548c\u8c10\u724804.png", "id": "1221179489502688", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499321663_1221179492836021_5493627379067059806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FWTbMcqyPQQ7kNvwFBdsF0&_nc_oc=Ado38VZcBMOGDedGBGyU2ZiCmRFPIBkAvIculG3LKvc4J4XeHjQXBXf3TrBqb8EZdus&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sb7lapHfL2N0visQYYRSSlpOZJQ0_flQOpuMZunzQFA&oe=6A36AEA3"}, {"file_name": "\u548c\u8c10\u724805.png", "id": "566120309906573", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499333080_566120313239906_5650787227111496157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGLKRRi40PcQ7kNvwFC3J_m&_nc_oc=AdoGrv81jOQkj8cXkyzfiE7X-yHWlDiSUviLO4JpOEx1Cxp2w7H_NYuar8cbAlqtJJk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mEXvERCPfXovR1AVh2KqR0FDGiTKsNaXfkgORlufa-g&oe=6A36A24C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "\ud83d\udca5**Afraid of Ghosts? It's Okay!** In **Scary Free**, even **the timid** can become **ghost-busting heroes!** Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!\n\n\ud83d\udc7b**Play with up to 3 Friends**: Look for clues, hide from spooky ghosts, and solve puzzles. It's **scary**...but also super fun.\n\n\ud83c\udfae**Use Cool, Real-Feelings Tools**: Pick up ringing phones, throw water, pull switches, and listen to creepy seashells. Every move feels **real and intense**. \n\n\ud83e\udddf\u200d\u2642\ufe0f**Watch for Ghost Signs**: Ghostly screams, shaking walls, bleeding pipes, phones ringing by themselves\u2026 **spooky stuff** is everywhere.\n\n\ud83c\udfad**Unlock Outfits and Power-Ups**: wear a Freddy mask, take a pill to look like a ghost. Each level-up brings **new tools** and **deeper gameplay**.\n\n\ud83c\udf10**Join the Community**: Make your own **ghost-fighting style**, and share it with others in our Discord.\n\n", "short_description": "Afraid of Ghosts? It's Okay! In Scary Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "30716760334577911"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUB
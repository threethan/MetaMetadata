5958256056492_4302914553516712637_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgsdUKBthecQ7kNvwFTPFYf&_nc_oc=AdnRv0fGfbn_A2cn4KcLNY98pXIlwejC2GvysOttpJzMzxXrm-L8xrfPgELFxMY-bc4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdQuINO7-PWNzfuxIrqVuHxnuEDjzLottMtAkNsQvygQ&oe=69AAD6C4"}, {"file_name": "\u622a\u56fe06.png", "id": "2944016099137059", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618264_2944016102470392_9184905461873341867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oDm_8f6KV4Q7kNvwGnSiTN&_nc_oc=AdkLG6OtrfCNHdSfk8jMcvOSY6VMZGfdLFQMg2psrRoey-HaI52qC71NbRVvf3gu0mE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwqFUhmkg1nGph9ZjxzT_f0HxW2ks24M68xwRzqeIGzYg&oe=69AAB01F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Escape Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "Jump into the action with Scary Escape Free, the ultimate ghost-hunting where you solve puzzles and outrun scary demons! Check out our latest update with 4-player co-op and massive 10-person lobbies to take on the haunt with your whole squad. Whether you're decoding clues or sprinting away from screams, get ready for an epic mix of scares and high-energy fun! \ud83e\udddf\u200d\u2642\ufe0f", "short_description": "Afraid of Ghosts? It's Okay! In Scary Escape Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": "SUPLIFE", "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "4597815049684
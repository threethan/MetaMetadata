cdn.com/v/t64.5771-25/499618264_2944016102470392_9184905461873341867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHHemdRDFVMQ7kNvwEDk8__&_nc_oc=AdrOgqTdHEhracRgzS5yt1P4hbf2PuetS75QgZvpDT0vKs5kYNmpwRiYcrqcBfHk0yM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMPlR71ZluSMVoncgc91wlvfCi5WR26TQWayczUOGqXg&oe=6A82E61F"}, {"file_name": "\u622a\u56fe05.png", "id": "848878710821240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_848878717487906_3040436976973346928_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTNXBHUZcnUQ7kNvwGvsSQd&_nc_oc=AdrXHxsBCxQZhhcp-MnyILrArKEaa1kEHnm2SG-oILYcH6d55V3_k0DotwManGC5lWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExE19KAi48PYJHs2kJnET0BJzFOGjOMmkcQe2lbplCcA&oe=6A831152"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Escape Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "Jump into the action with Scary Escape Free, the ultimate ghost-hunting where you solve puzzles and outrun scary demons! Check out our latest update with 4-player co-op and massive 10-person lobbies to take on the haunt with your whole squad. Whether you're decoding clues or sprinting away from screams, get ready for an epic mix of scares and high-energy fun! \ud83e\udddf\u200d\u2642\ufe0f", "short_description": "Afraid of Ghosts? It's Okay! In Scary Escape Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": "SUPLIFE", "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
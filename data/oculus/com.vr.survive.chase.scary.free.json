021_1227437425788816_5133817210678233628_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYoR__T8JM8Q7kNvwEkbWaf&_nc_oc=AdnfQo1sRDMAVWQ9dt6piZZd45iWX-inBAU9rlcffyjNzOQ9NU2TCXfRdKWQpdewRTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvNyV9PpDPgHAlM_T8cfyOrMLcwk0xvhZaNJqD1nOuYKQ&oe=699DAB87"}, {"file_name": "\u548c\u8c10\u724804.png", "id": "1221179489502688", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499321663_1221179492836021_5493627379067059806_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ7QdSPbPmsQ7kNvwFq6rZI&_nc_oc=AdlUe8xaY1ygSeuVMwY7_g32zSaX82BUypKy16uRKG9wOazirIhyGlWhZlNb4I-umu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_M9Rbncs_PHXxo7rkXkJzcLxno5RFPHHsDiCsjbIdLw&oe=699D8863"}, {"file_name": "\u548c\u8c10\u724805.png", "id": "566120309906573", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499333080_566120313239906_5650787227111496157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68yOFpWX15UQ7kNvwFgoZdj&_nc_oc=AdlLXOo7sMSv3fy3x3_fvb1jPUaZ0zuknUdxlwY_YVie7PM36vaP5ccl3jlsjdA0gRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8iObx6GL5Vussk8uoTc1405Dr122b-tGOBAjMKE8zRQ&oe=699DB44C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Free", "keywords": ["horror", "survival", "escape", "multiplayer", "sandbox"], "long_description": "\ud83d\udca5**Afraid of Ghosts? It's Okay!** In **Scary Free**, even **the timid** can become **ghost-busting heroes!** Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!\n\n\ud83d\udc7b**Play with up to 3 Friends**: Look for clues, hide from spooky ghosts, and solve puzzles. It's **scary**...but also super fun.\n\n\ud83c\udfae**Use Cool, Real-Feelings Tools**: Pick up ringing phones, throw water, pull switches, and listen to creepy seashells. Every move feels **real and intense**. \n\n\ud83e\udddf\u200d\u2642\ufe0f**Watch for Ghost Signs**: Ghostly screams, shaking walls, bleeding pipes, phones ringing by themselves\u2026 **spooky stuff** is everywhere.\n\n\ud83c\udfad**Unlock Outfits and Power-Ups**: wear a Freddy mask, take a pill to look like a ghost. Each level-up brings **new tools** and **deeper gameplay**.\n\n\ud83c\udf10**Join the Community**: Make your own **ghost-fighting style**, and share it with others in our Discord.\n\n", "short_description": "Afraid of Ghosts? It's Okay! In Scary Free, even the timid can become ghost-busting heroes! Your job is super simple: find the ghost, figure out what's going on, and lock it away before it gets you!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://scaryfree.com/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Joy Inventor", "support_website_url": null, "website_url": "http://scaryfree.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "de", "fr", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "30716760334577911"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4029455684000723"}]}, "baseline_offer": {"id": "4029455684000723"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749179760, "status": "PUBLISHED", "id": "4029455684000723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_result
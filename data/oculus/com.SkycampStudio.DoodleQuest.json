392329_596250796345485_7155958431525776084_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjqIOth334EQ7kNvwGPjhL7&_nc_oc=Adodjfl0f8IFjfElRUzl4nvAyuKYvo59sCClDUUtUC9Q_idmDoVCUz0lGyuc7AkxfDU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlqqHPulvxz48-fbBHlIQw7mjhKcBHtnNgbmWTsLnjVA&oe=6AFC643C"}, {"file_name": "sc4_\u526f\u672c.png", "id": "1182286913231689", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393713_1182286916565022_3467417463365716654_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfuMh3xgnlIQ7kNvwEagDGe&_nc_oc=AdpPl5nFzv3dGRrgoZmfJoxjz2ANgJ4c3DTLJJdIrXmcn0duz7yTx9uvE_nrtsmct00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6qZ6lOE6Hi02r2pLrFA-HmyyQhhbgoe6zcwA3XAMrWw&oe=6AFC8B9F"}, {"file_name": "sc1.png", "id": "635195785754498", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473397310_635195789087831_2872700257742315684_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtVWDieU7ioQ7kNvwGZoTmn&_nc_oc=AdoYo5cNyGpyobnYiSGRHfM-9sON-zQzGkBoVITLTQKlSEKQrd_dNQJHg42_wBxC_EA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFk5jeDEuYReIJz9qxk1nj2-lhGgFeG_b_QCaif1SGlw&oe=6AFC7F8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560-1440.png", "id": "564762389887347", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393858_564762393220680_6455501503047205453_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHUTkXJ_OoEQ7kNvwF98PVd&_nc_oc=AdpD4VQga-dME847t4dMI5Fjqr8ccHmwE3W3OlXbUynZdPXB58gtQn8OnXXZD5rVR0c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeoLEj_7G7bV79YRC6rtCS1Yian0Aak2zEzUYNW_Z1sA&oe=6AFC8C69"}, "display_name": "Doodle Quest", "keywords": ["puzzle", "sandbox", "draw", "MR", "physics"], "long_description": "Doodle Quest revolutionizes the classic \"Draw a line\" mobile game by bringing it into a 3D realm. This innovative mixed reality game offers intellectually stimulating \"Draw-to-Win\" puzzle challenges, seamlessly blends the familiar drawing mechanic with immersive 3D environments, creating a gaming experience that's both refreshingly new and engagingly challenging. In Doodle Quest, you will\n\n- Act as a mischievous magic artist, use magic brush to create physic-based magical touches to solve seemingly impossible challenges, with a simple yet captivating gameplay mechanics.\n\n- Solve a wide variety of levels and challenges, including 200+ exquisitely designed levels, 20+ distinctive composition modules, 3 types of drawing materials of different physics properties.\n\n- Immerse yourself in an effortlessly learnable and delightfully playable experience with a charming art style and soothing music. Supports MR see through and hand-tracking game control.\n\n- (COMING SOON) Use level editor to create countless possibilities for community-created levels.\n", "short_description": "Bringing your favorite \"Draw a line\" mobile game experience into 3D, Doodle Quest is an innovative mixed reality game featuring intellectually stimulating \"Draw-to-Win\" spatial puzzle challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Doodle-Quest/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Doodle-Quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
f&oh=00_AQJaPvbKNp_TQ_bMnNr5kLyu8Ma1ewHUUA9Jj1asBcJ8XQ&oe=6AB155C2"}, {"file_name": "\u622a\u5c4f2025-11-29 21.50.31.png", "id": "4379285525633978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_4379285535633977_6341818233281765046_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tlo5IRU4_GcQ7kNvwHrzEa2&_nc_oc=AdqwYWEcZx9OimM4xWvCGhGwWDBlwZ6Wsxh5Ka4u9kHnMBJoLWl3ddtaTvMLylWPLfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt__AQtfSfqtQuF1Z0fznUo5zxSbFx-yNvx7EsrsnNdQ&oe=6AB1446B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6d77\u62a53.png", "id": "1548616852949898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618284_1548616856283231_8698897750005280112_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0QUWXL3yDcQ7kNvwFFj4bO&_nc_oc=Adok3eGJe_HGsROjhzDcZK3ndlCmUpHFPsc_euFPA9yHCIf8R3STcfmqfrlVZfOxJCo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjvBj6QuKXsCS1-xf6v1NFtjOsabPLnW13KruVsdT_KA&oe=6AB12AE1"}, "display_name": "Draw The Line", "keywords": ["puzzle", "sandbox", "draw", "physics", "MR"], "long_description": "Draw The Line revolutionizes the classic \"Draw a line\" mobile game by bringing it into a 3D realm. This innovative mixed reality game offers intellectually stimulating \"Draw-to-Win\" puzzle challenges, seamlessly blends the familiar drawing mechanic with immersive 3D environments, creating a gaming experience that's both refreshingly new and engagingly challenging. In Draw The Line, you will\n\n- Act as a mischievous magic artist, use magic brush to create physic-based magical touches to solve seemingly impossible challenges, with a simple yet captivating gameplay mechanics.\n\n- Solve a wide variety of levels and challenges, including 200+ exquisitely designed levels, 10+ distinctive composition modules, different types of drawing materials with unique physics properties.\n\n- Immerse yourself in an effortlessly learnable and delightfully playable experience with a charming art style and soothing music. Supports MR see through and hand-tracking game control.\n\nCan you draw the magic line and solve the puzzles?", "short_description": "Bringing your favorite \"Draw a line\" mobile game experience into 3D, Draw The Line is an innovative mixed reality game featuring intellectually stimulating \"Draw-to-Win\" spatial puzzle challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/doodle-quest/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "ja", "fr", "fr_CA", "fr_BE", "de", "de_CH", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "ru", "ru_UA", "ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25642569485378076"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_831146442962733_1707378784120520231_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeuVGlzVvIMQ7kNvwEYD_Xb&_nc_oc=AdrjgqlKfVKpJhIO1Aal8NfdtO-YmGHIqUmhAA2uY1un
1Bvh&_nc_oc=AdqIGJWZGLb2Q7Lt0i16qaYyjPxA5Zb4adYYqusK1phWCWgGYy4vzO55_6BE-fr_K0I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8D1U4jGVj_hzDAP0ATZ01aCg0sPjn5C97vjNHg68-Rg&oe=6AAE8ADF"}, {"file_name": "sc1.png", "id": "635195785754498", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473397310_635195789087831_2872700257742315684_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brAFbo4aZXkQ7kNvwGnWg2l&_nc_oc=AdpVEl0_krp2U5o6Fdr9_fDrYXGGGaVL3xR6bcxJbdl2S8AXlIGpoV0AWSX3Mrd8JiY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6x7ZVntU-_tdgbSlNuNYIAfdzMw5M5l7eGgmiDnRQAQ&oe=6AAE7ECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560-1440.png", "id": "564762389887347", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393858_564762393220680_6455501503047205453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhS1hz-5CIEQ7kNvwGlH1Z8&_nc_oc=AdpkM_XtH65HKrZWyG51pTQhdS0ZUK2F25ieNW46GixILGbjGtVwfPq2i0D0sVTHaRY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXMOY9aS_7AfFOkC_FK761Khx5WN_bu34hENlgLrEasA&oe=6AAE8BA9"}, "display_name": "Doodle Quest", "keywords": ["puzzle", "sandbox", "draw", "MR", "physics"], "long_description": "Doodle Quest revolutionizes the classic \"Draw a line\" mobile game by bringing it into a 3D realm. This innovative mixed reality game offers intellectually stimulating \"Draw-to-Win\" puzzle challenges, seamlessly blends the familiar drawing mechanic with immersive 3D environments, creating a gaming experience that's both refreshingly new and engagingly challenging. In Doodle Quest, you will\n\n- Act as a mischievous magic artist, use magic brush to create physic-based magical touches to solve seemingly impossible challenges, with a simple yet captivating gameplay mechanics.\n\n- Solve a wide variety of levels and challenges, including 200+ exquisitely designed levels, 20+ distinctive composition modules, 3 types of drawing materials of different physics properties.\n\n- Immerse yourself in an effortlessly learnable and delightfully playable experience with a charming art style and soothing music. Supports MR see through and hand-tracking game control.\n\n- (COMING SOON) Use level editor to create countless possibilities for community-created levels.\n", "short_description": "Bringing your favorite \"Draw a line\" mobile game experience into 3D, Doodle Quest is an innovative mixed reality game featuring intellectually stimulating \"Draw-to-Win\" spatial puzzle challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Doodle-Quest/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Doodle-Quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9420984821296467"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1469501901396258"}, {"status": "PUBLISHED", "id": "1239831504760164"}, {"status": "PUBLISHED", "id": "684862971224434"}, {"status": "PUBLISHED", "id": "1519754189653312"}, {"status": "PUBLISHED", "id": "1822199338359678"}, {"status": "PUBLISHED", "id": "1431567447857610"}, {"status": "PUBLISHED", "id"
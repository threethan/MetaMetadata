l3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzjmNe2MoYog5zRvTXNdpTiAXhnlrNHkSiqEQ5lcaFi9w&oe=69C13CDF"}, {"file_name": "sc1.png", "id": "635195785754498", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473397310_635195789087831_2872700257742315684_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk_RDC7S3hIQ7kNvwFps2iX&_nc_oc=AdqqW_zkvtx1S63kyhWInU1RND921gJ3pFth4nw7I_mXw7UX1fN5Nfr0S61YXe1y_AQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1LkXriHNkGMxhaOU8esmeuvkUCvxIhyivLnPKGrp8Pg&oe=69C130CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560-1440.png", "id": "564762389887347", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393858_564762393220680_6455501503047205453_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ocu2qOhORPIQ7kNvwHL88gZ&_nc_oc=AdrCOZBeU7r1lHOREBBW8Gh8lfDjE9l8Bjv1sF8dIbslHWUEaCRCY0E_1iEB85Ra4ks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxWRyZ1i61bIHdV_xGsm22Fk_F45m4qnk7d0YKv0Hsn7Q&oe=69C13DA9"}, "display_name": "Doodle Quest", "keywords": ["puzzle", "sandbox", "draw", "MR", "physics"], "long_description": "Doodle Quest revolutionizes the classic \"Draw a line\" mobile game by bringing it into a 3D realm. This innovative mixed reality game offers intellectually stimulating \"Draw-to-Win\" puzzle challenges, seamlessly blends the familiar drawing mechanic with immersive 3D environments, creating a gaming experience that's both refreshingly new and engagingly challenging. In Doodle Quest, you will\n\n- Act as a mischievous magic artist, use magic brush to create physic-based magical touches to solve seemingly impossible challenges, with a simple yet captivating gameplay mechanics.\n\n- Solve a wide variety of levels and challenges, including 200+ exquisitely designed levels, 20+ distinctive composition modules, 3 types of drawing materials of different physics properties.\n\n- Immerse yourself in an effortlessly learnable and delightfully playable experience with a charming art style and soothing music. Supports MR see through and hand-tracking game control.\n\n- (COMING SOON) Use level editor to create countless possibilities for community-created levels.\n", "short_description": "Bringing your favorite \"Draw a line\" mobile game experience into 3D, Doodle Quest is an innovative mixed reality game featuring intellectually stimulating \"Draw-to-Win\" spatial puzzle challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Doodle-Quest/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Doodle-Quest/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9420984821296467"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1469501901396258"}, {"status": "PUBLISHED", "id": "1239831504760164"}, {"status": "PUBLISHED", "id": "684862971224434"}, {"status": "PUBLISHED", "id": "1519754189653312"}, {"status": "PUBLISHED", "id": "1822199338359678"}, {"status": "PUBLISHED", "id": "1431567447857610"}, {"status": "PUBLISHED", "id": "1172785074265974"}]}, "baseline_offer": {"id": "1519754189653312"}, "is_approved": true, "firstOffer": {"nodes": [{"s
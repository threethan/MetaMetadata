m&_nc_ss=7f20f&oh=00_AQJru5sRq10YiEk5qxvfJP8DJNZE1ODnPADl_DcEKDKI8A&oe=6AA813AB"}, {"file_name": "Defibrillator Training Simulator_Screenshot_05.png", "id": "1505167720183970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75295895_1505167723517303_4557724993818798121_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcNjjVcZV-AQ7kNvwGIUAI4&_nc_oc=Ado6pi06oAgyd7XohjvqrexPFOB9uNWCDe8-R9p4txX3JAFBEAm2m5uMRa0cZwIjaQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlyrpr6xhGCNfeBCl9Tran1oOOn1zoU6OtyZWvAkJZMA&oe=6AA7ED96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "976052050716313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036680_976052054049646_1867050495588397375_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLAHHwhPrHgQ7kNvwHO6i2V&_nc_oc=AdpbuipYNE8Me6jpN34cLEhdO5SYFLTRARBYzVDflhj92Oo7yMBF05iyfrOZUpsQcqY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAfmu3U3tG64mce_BUnnCngLObK1q_lfginGOfgF3kfg&oe=6AA7E74D"}, "display_name": "Manual Defibrillator Simulator", "keywords": [], "long_description": "The Manual Defibrillator Simulator app immerses Certified Nursing Assistant (CNA) trainees in a virtual environment where they can practice and master the use of a manual defibrillator during cardiac emergencies. This application guides users through the correct setup, electrode placement, and operation of the defibrillator, including recognizing and responding to various cardiac rhythms. \n# Learning Objectives:  \n- Remembering the steps and safety protocols for using a manual defibrillator \n- Understanding the principles behind defibrillation and the significance of different cardiac rhythms \n- Applying the correct technique for electrode placement and delivering shocks \n- Analyzing the patient's cardiac rhythm to determine the appropriate response \n- Evaluating the effectiveness of the defibrillation attempt and making necessary adjustments \n- Creating a comprehensive response plan for cardiac emergencies \n\nThis comprehensive simulation ensures that certified nursing assistants or anyone interested in the healthcare field are prepared to use manual defibrillators confidently and competently in life-threatening situations. ", "short_description": "Designed to train CNAs in the proper use of a manual defibrillator to respond to cardiac emergencies effectively. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7860325327344863"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "9786965501380285"}, {"status": "PUBLISHED", "id": "1431569011056099"}]}, "baseline_offer": {"id": "9786965501380285"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749743880, "status": "PUBLISHED", "id": "9786965501380285"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24369997825951019", "version": "2.2"}, "id": "709879164510689", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
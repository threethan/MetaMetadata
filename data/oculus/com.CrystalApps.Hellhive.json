cb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSuSww7q2qoQ7kNvwF95QY4&_nc_oc=AdplVxOKqIoMNNLgeRfe1tUBU9lGEU-ipQJXsT21Gd5zqYLKcmLfmXX_Ah5AVxjsrVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaCGvZJTybiIBvkhg5i5Sv9xUoxJbRxZGwMcEObKbIBA&oe=6A7491D0"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNHQDX6oJJoQ7kNvwHOzrrj&_nc_oc=AdpDQtF12oSgNcmlVKEu9K7Oo3BDtzZS-u3Lm4bUNYGU_5-uE4YpUiwAEcoWtebDHBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi57kbAVXKHjlZWYYYGMvytCn-aQv7Eb4rplbd71RVSw&oe=6A749A50"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHiZC7drOLwQ7kNvwHslI-S&_nc_oc=Adomzdi26LdL4kjFwxr2lq1uWIAjsnJqypPodxNc6XlyJzoN_FNjaWq_IPH7T9j9P0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwcu6l_0vcYh-Plh2EENSkZKw_mbcdyVOCFuXlUWdbFQ&oe=6A74829F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZeJh_rIooEQ7kNvwG3sb47&_nc_oc=Adq8nXJTXwP9lY1eddaDgjNkmUx3K0pPihuUNIqsRJRQ7eePMMipT9g_PTc_WPd4FOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYeeuRIQ0xmYEB0_iqvzITtLgUlvMX1q0Wl7W5b6trDg&oe=6A74991A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter: Hardcore Mech Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
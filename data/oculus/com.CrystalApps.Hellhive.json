cb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQA-_IB39aEQ7kNvwHWYJd9&_nc_oc=AdowjKpEC8t2XeeR8Jp4oY4OhngHA0wflytK65MFv8wmjyKnMhmjghvJESV8Hd-LjJo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNP-1ZdTBoHc7noenafWgg5FS9rdPauYEOswDLi9xJwA&oe=6A6F4BD0"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzpiqJRU360Q7kNvwGEjmRe&_nc_oc=AdqB1iRl7j6ruSmAV1FYbonccIe-3DrEEfmxno3qJ90bbkbzMaFtWNj9HeIUciXYBKQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7gUb91xiHd_cBTMtiM_575srzW4_bl151EIW4qEtXJg&oe=6A6F5450"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE9rNM0pP2AQ7kNvwEUPqgh&_nc_oc=Adqu7I4oDdgFKA3E0a6Y5PEAcF4UoxxzLW5_I3sB7G-7RruOE2U2y-3n-_2uoEheFf4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9VyeETrCmXZpGVhXLhtluP38NbxvwBS9lnKDD6DP5uQ&oe=6A6F3C9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdGTwFuIaxMQ7kNvwFFK-Kv&_nc_oc=AdpmVOrp4VAO-YPqmxBsPxXtG1t26OhoOT3i5m8-Q7wKvHehRDnh2a2KOlEYRbidKvo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCHQk1qo-Gkq1VaafLJtHvE7p5qDsVI5iAVmveg1libg&oe=6A6F531A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter: Hardcore Mech Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_n
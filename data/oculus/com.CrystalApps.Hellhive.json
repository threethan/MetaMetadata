25/39031378_683508290620027_6500692475802302844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX79A6uKf3AQ7kNvwHkOf4V&_nc_oc=AdpGg57dBM8z0rGjctvCTyQfbBRk4WZJjO_VBsOIMxrbLxuHefViPkV_ESQ_9ppS3Yg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rmh3DBRaxju_M6oCuuNp-oRT0_kZ5tTcdT01PQKMdWQ&oe=6A4668D5"}, {"file_name": "hell_3.png", "id": "527107099988954", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6HIjDmW_PEQ7kNvwFOTz_s&_nc_oc=AdpGJ6V85fpnwZD_yAzpnRcJrJhNVJ6D9hOpJ8TTvTv7qpF3sSwgsJdYh9tZR39fI-Y&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dot9YiBElIGuA-N4WYPdu7kchxN-H2fgbzOuMo2eLWg&oe=6A466D50"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIp4Lk4z0lMQ7kNvwGNl9om&_nc_oc=AdriJUHTzGxMD7Eo2dkUyiw3hiaR2D9aF49bDdAmPb8jR9vSvVo3buV35dpDC4Iof1s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bWBKurAHWLz7FPNO48Rse2gxUF1BF-KV3NytMcOivEw&oe=6A4675D0"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAXycBWV1LkQ7kNvwGpfQrr&_nc_oc=AdpjA3zq7BtvYC6sevXXevhGJ0Mjj4qqaWz9kruB4BWJ_GJdnSm_Hw_-iOCv3RHG-6c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8su08nSMP_WPscQJ4RF-dHIbshcUPE3P5CRLak16EKgA&oe=6A465E1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e
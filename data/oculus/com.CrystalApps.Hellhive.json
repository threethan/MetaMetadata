bilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkUJeRuvobcQ7kNvwERQXyd&_nc_oc=AdrAP5emaTdIZJrNsY-Yxmegc9KHy42dW5F6mOuNPfCrd29lrpjCVKi6iPLq6A-v7jE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZYEhLpulTE5FvABmVLHr48GqU6rn9ekrsK2gNWfECXA&oe=6A6A0D1A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alien Shooter: Hardcore Mech Simulator", "platform
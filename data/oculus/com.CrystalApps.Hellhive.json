MoQ7kNvwEqmYns&_nc_oc=AdpC1XFvV9ZtbERTW0bP1DFWSMx7E7iVUuRqq8irf8yZt1CNMAxR2VSYussnkHx653U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af643V3wnPxuEenWsnJWuIROoEwC_IXx6bfz3qTi5wHdGA&oe=69FF1DF8"}, {"file_name": "hellhive_5.png", "id": "1596340274477862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221315_1596340281144528_2265025337098068758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrNxQQtcL8gQ7kNvwFYkGS9&_nc_oc=AdrTlqRYnosI0AlMZM806ref-YLdYO55ECn8Tq_mjt3HuGhUWHzyqtldciw5WaL4oZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XjD7TVPj1LmWl6NNj06zPkqURQyu6RmfBaitznj_9aA&oe=69FF4245"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellhive", "keywords": [], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "websi
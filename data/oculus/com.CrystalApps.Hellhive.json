.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baN8VMEbvdEQ7kNvwHIVXvn&_nc_oc=Ado4NSA25lwAXa3la1M_0uroFxfQs7i8ZYCrXkpFadnoVUJCB5k2amvmROq7cquLrU0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzrUyBa8HNSYGx8Ny4uLmsvVTaD_XsqZqMFwfqDgJDBA&oe=6B0B1510"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN4nz58qqvQQ7kNvwGUPGJy&_nc_oc=Adpcupqkf810fgGFe28oGuC3UgNrjmfy1pwzUN32oOMwJmjEDwqOwBUebT4RUvgG5FE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTm2DVcOH__r4Ru9JTVSV00V_dEKNHakcBPpJPDZSgrhg&oe=6B0B1D90"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc0vIHL_2MEQ7kNvwEmzxp9&_nc_oc=AdpNflVkOzcvwMa6zxFshrO1HA2eRHuh75U9TvKFtAe7xkw-i1Hdv9qDHrgX3G292wA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpv63pSZEJnTmo7Xdxe6P0vf6g89bGvfhkjfUmkQgQOg&oe=6B0B3E1F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bszEzWJyMmwQ7kNvwE2I8tb&_nc_oc=AdoLnpIQbPLbmcWDRa0NPoZn564M89ivJeO9HAaor5eI69OGseXtcO3quUXCw9MQZP8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwz-Y_a8QaUvWogmTgDAGN8AmRMb3p_Uo6Ftjbv8_Q_w&oe=6B0B1C5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
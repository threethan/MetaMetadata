/39031378_683508290620027_6500692475802302844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBm2TqAKzHUQ7kNvwHd5hEt&_nc_oc=AdpJub6zkb7ug9CSCGD_Yjv60AWiNP67_EOB1_JfRhYCF7qo8Urd_pxZ-WMdn_9t1Dw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7OHvk5SFZV_5G3_HkxQ1k_iUqOopnPvLp5duE0nLmkQ&oe=6A58DDD5"}, {"file_name": "hell_3.png", "id": "527107099988954", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hddT59nbZ0gQ7kNvwH3pPOn&_nc_oc=AdpWKH2D3DgPZj1IrNY53NQqnvmKNMNPI2yfO2Lhem9b__onR1z6phZEiClIbHq2VLA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK9EeNDfLngFCrGQemQ3TdoBeJrbEbEmr4LF-KRNE0QA&oe=6A58E250"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o0XVmAx-nEQ7kNvwHE1Hyt&_nc_oc=AdpzPSNm9r8nwPrdBmP7DIgxB_bUGcQZ-VxTWhAyQHTJRMfcfgSmfqdKtA1xRom8OpQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD86wxJLx1wX7fuE7qdpdhjqWKCm7h5P1xyIWcGCYTI1g&oe=6A58EAD0"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJx67vToWxYQ7kNvwH251jt&_nc_oc=AdqUqU0SwA8bpV4uiopcO30G3guJwy3oFucxalRzeot6815BcEFuUvQYHjnw4_ciwOQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1EedczOo0EgOn4MSuPuSqgS6Va3IxwJH-MTv3FMvdjg&oe=6A58D31F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a
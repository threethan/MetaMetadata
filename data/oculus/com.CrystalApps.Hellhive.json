5cQ7kNvwEJEGtK&_nc_oc=Adqdj6CHs8gVJMHdxpTERqmE_sGz47i8SZEaswZc_XPAAc_A9K5CMjiDutaFQ7daxv8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26i8rgbCKvHGcaDVuTlD8lV8APGZBdTewUqU4ogJGxpA&oe=69F491F8"}, {"file_name": "hellhive_5.png", "id": "1596340274477862", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75221315_1596340281144528_2265025337098068758_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DZVMXlxa9oQ7kNvwFMujSn&_nc_oc=AdoathRzRIOhc0Qo5NooicF_DeZBOtvOvYyIG9XjvuuDsMMIpyffPI6QkT8PFRO4nDM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OLvfy0Iny17-SHHrHfBONKol9G01Vk-dDjtAJPob7Ng&oe=69F4B645"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hellhive", "keywords": [], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "websi
.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7l_XXXOwNUQ7kNvwHYqNBR&_nc_oc=AdoTPla7BS21omhCmNSRJ7SyeQYBm7t-_LJ0W7amBzkzBNT8F1HRmiTsxSjzKXT2d6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi025f3HOU5HbYefT7qQbfvaLAEqw5ad7b4lahNeuT9g&oe=6B087210"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl1mjZSUn0QQ7kNvwEDtSxa&_nc_oc=Adp5rBgmzJoU85-TZefaZNXCrCm4DSZ6SR2K-jtgbG_mq_RI9gCqXJH6rK9I8kC-BHY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFOjbhlI2nfIcBfitpseNl2Vh-6S_ekEQU9bXm-jISkQ&oe=6B084250"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOF2ZpL6yBIQ7kNvwF45Y8x&_nc_oc=AdrrJEFfRzTicVP8Tmb2LYmDPM5ECsp804hriTY0pgsurPPaSFuTW3FDxuamOC69EI8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmsTfZYzYjA3ID0AOwGQ1-C0CXS1NiHymr1TS6PpexJA&oe=6B0862DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMIwQZwJf8cQ7kNvwGH3d10&_nc_oc=Adp41xDCio2N7EnBABbI2WB1_3K2d0HE6q0Tj-yx0Mydl_YNKxuJykppKoTK1pEoDM8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTFg3A8kLFyS_VjOgpoZ2izKIn1DUM34_SGzsWVJdijQ&oe=6B08411A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
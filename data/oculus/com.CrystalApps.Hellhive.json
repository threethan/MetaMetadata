25/39031378_683508290620027_6500692475802302844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTeYohsBqJsQ7kNvwFpf_X5&_nc_oc=Adpf_cirZvCvOVNJcF0M3e3bzZkkn5ZjgvP5eVqQfGoo9rwjHt7b3cozaP_MRXLdD7Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sPuPBmCkO8PkH3F6UdtmCYsv-axDNm7wEH4mlT2SIMQ&oe=6A22D055"}, {"file_name": "hell_3.png", "id": "527107099988954", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akUVFF6hSw0Q7kNvwFPtqKz&_nc_oc=Adqt67kQyT0owkdpdL7RPlTbuFat-Dsi975bCmA-Nb1Mw-GfsrI8jhdqPcqVf0ecQLU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MtZrL-b_5xOv3Tq2ILwS2N7bD86Rjx3OzcNNPZ_EleQ&oe=6A22D4D0"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aztXsk2b-CEQ7kNvwFJuYqQ&_nc_oc=Adr7rOfawQD75d8yykwtwu1zkNX5wCb3Rg_Mhjc1zQnx-7S-S5s0I9tTju4vqCJSRwg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8b654XGjTREWNePI5c-beP7H6_qHHaNMgTaweanrXXng&oe=6A22DD50"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrAHVYL5BPcQ7kNvwF6nOy_&_nc_oc=AdrFCjr4unsh6PH185UD2kvLPduRfDvn0D73oJn-MwyzhdzqhsJ7h3HmwuUSXJYlRa0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L_CTHjtfhe2435p0oQhYBMbmMS-za6rqe5j1uJ7GfDQ&oe=6A22FDDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e
25/39031378_683508290620027_6500692475802302844_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEftx837aksQ7kNvwGQvGAN&_nc_oc=AdpJMHfr3Sgeewqc0vKxjtPdymDaolbYlhGYVr84q82J1m-DjWEHQnJAQY5eLOk-ivc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q3UYwS2Uz1e7_TapdxKYlsTZAVgIzYYnE7NUbYz5bFA&oe=6A11ACD5"}, {"file_name": "hell_3.png", "id": "527107099988954", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974497_527107106655620_4200246658958473222_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67i_H47IEncQ7kNvwFJqFfg&_nc_oc=AdqGj7CsipHp1YFMOq_yvXiFd8-WbrAdbg0UTDoXhiNDG0cqA57ZZHa8OfnqTW2evZg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XbVdsErBeg-BsTkC4o0QNkRPEyBW_eWyVXJsQ-TyO9g&oe=6A11B150"}, {"file_name": "hell_4.png", "id": "463885353042026", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031363_463885356375359_6626004550317987718_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhDQQlcFYL8Q7kNvwE-cBJQ&_nc_oc=AdriHGfzhnY6yWxcgeNS7kCn9e3VCfmXMiXuVui97EVS7ax-5-Pk9aLH1WJ_fyK4QD0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qGb_-PqXQ8uapHJGbsY4PHVLIiADrL8G3QsvUCrxNLw&oe=6A11B9D0"}, {"file_name": "hell_5.png", "id": "795267439315897", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036639_795267445982563_5805523994380029549_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlSI0xd-OoQQ7kNvwEZKlxt&_nc_oc=AdrAs7LyUzxTf7NYkR0iN4pxhZi2ANK1wTyBAfkzIu5PBwG7TB90l1F3s8UfsIcy3AY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oHmb5lY3SM6ixcsI7pSdK7aJqs2_WK2TWCiEVKs0-7w&oe=6A11A21F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alien Shooter: Hardcore Mech Simulator", "keywords": ["guns", "shooting", "fps", "mech", "fight"], "long_description": "Prepare yourself for the ultimate VR defense experience with Hellhive: Insect Invasion! Armed with a high-powered turret, you'll face wave after wave of monstrous insects straight from the depths of hell. Each enemy presents a unique challenge that will test your skills and strategy.\n\nIntense Turret Defense Gameplay: Defend your position against relentless insect swarms using your weapons and upgrades.\n\nUpgrade and Customize: Collect resources and choose from various upgrades during intervals to enhance your turret's firepower, defense, and special abilities.\n\nImmersive VR Experience: Dive into a terrifyingly immersive world with detailed environments and spine-chilling soundscapes that bring the horror of the Hellhive to life.", "short_description": "Battle through waves in this intense VR shooter, available in Early Access. Upgrade your arsenal, master strategic defenses, and survive the hellish onslaught. Can you withstand the inferno and protect humanity? Join the fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crystalapps.eu/hellhive-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Crystal Apps S.C.", "support_website_url": null, "website_url": "https://crystalapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25529633309962424"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473393572_10087397634628902_8577692160106483122_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e
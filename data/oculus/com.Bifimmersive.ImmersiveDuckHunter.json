g?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtfvokI1M5wQ7kNvwE6aiRx&_nc_oc=Adp31BPNZMNOulxb-dN2piBGK9Gp-PE78cNyTKUONZjj_rGXeKSXhDwSkIvoq_rmlCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsQKjhF296WbdLRMTS9KHJkQu_CUU6ivJX8blZdGvmbw&oe=6ACCE7AD"}, {"file_name": "Screenshot2026.png", "id": "1298639965472274", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823270_1298639968805607_6246871637589342756_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa-7aA_DFYYQ7kNvwEno3WP&_nc_oc=Adq6ZaOA5cOn4SRM_S25gz6gr13aM3I4WuIYxN6cjhSJN_7NQxH5joHm5u1jvEVUza0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxmejAzm_-D4x7Oa6Ah3SNevTy43Qltz3ixtXxU82R2A&oe=6ACCF416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage_251218.png", "id": "658654480666188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_658654487332854_3165294653786020218_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7GkWmI8vGzEQ7kNvwHh4LH4&_nc_oc=AdoRKsNPCetrIcCa_R7i8ZwId0SbWTx6O7GIZfKu_nibAsQ34QtdCG4kVroyxnAMkK8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ1w0qyiw5Xs0hCI7PaFylRL3duaSJN8HN-Ee7wK6Q5A&oe=6ACCE941"}, "display_name": "Virtual Duck Hunt", "keywords": [], "long_description": "A modern VR tribute to a legendary classic\n\nVirtual Duck Hunt brings the iconic arcade duck shooting experience into virtual reality, fully reimagined for Meta Quest. Step into an immersive world where fast-paced action, precision shooting, and playful humor meet modern VR design.\n\nGrab your rifle, track ducks in true 3D space, and test your reflexes through increasingly challenging rounds. Easy to pick up, hard to master \u2014 the game is built for quick sessions, addictive gameplay, and competitive high scores.\n\nKey Features\n\n\ud83e\udd86 Arcade-Style VR Shooting\nA faithful yet modern take on classic duck hunting. Aim naturally, shoot with precision, and react quickly as ducks cross your field of view.\n\n\ud83c\udfaf Skill-Based Gameplay\nReflexes, timing, and accuracy are key. Increasing speed and evolving patterns keep every round fresh and challenging.\n\n\ud83c\udf0d Fully Immersive VR\nDesigned specifically for Meta Quest, with smooth performance and clean visuals that keep you focused on the action.\n\n\ud83c\udfc6 Global Leaderboards\nCompete against players worldwide and climb the rankings. Every shot counts.\n\n\ud83c\udfb5 Dynamic Soundtrack\nInspired by classic arcade shooters, with a modern twist and a few surprises along the way.\n\n\ud83d\udc36 Your Unpredictable Companion\nThe dog is no longer just a spectator\u2026\nHe reacts, helps, and sometimes surprises you in ways you won\u2019t expect.\nA little old, a little wild \u2014 but potentially your best ally.\n\nNo real hunting. Just pure arcade fun.\n\nJump in and play.\n\n", "short_description": "Immerse Yourself in Nostalgia with Virtual Duck Hunt!\n\nRelive the retro excitement of the legendary 1984 Duck Hunt in an entirely new way through virtual reality. "}]}, "developer_name": "Fr\u00e9d\u00e9ric Peeters", "developer_privacy_policy_url": "https://sites.google.com/view/bifimmersive/accueil/duck-hunt-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bifimmersive Games", "support_website_url": null, "website_url": "https://sites.google.com/view/bifimmersive", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes
zKl2GT0ZpAauMZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhVOGXtHSRBIgbLM3YzX_mMP5MCiC2OPxlOEANCndvqA&oe=6ACCEDB5"}, {"file_name": "Screenshot4.png", "id": "905589457499249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974780_905589460832582_6130027779617320049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lwafsau7TQQ7kNvwExxQqM&_nc_oc=Adro1UbdYdxEpJaNqItBSvJ-VpHlZF0xU85_qyV1vaSEzhf57s-cRr_hz9lEEJWbSTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpeYsKq1nLEBWK9e0PIfRMcP2CMHk8-OSv3DVlnt_57A&oe=6ACD161D"}, {"file_name": "Screenshot5.png", "id": "249968624781202", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_249968628114535_9072172207420643207_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ygRIiLQFVwQ7kNvwErI79D&_nc_oc=AdqRPoPipHAIMy5Lph9PcMElncPJTRc-vvgRx8ogVn9m_5JHefteRfjvAd1NRiB5w98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKAldH3EFh67WJ0Pb8am9LbkOLR9C95wBiKBJiBvxY5A&oe=6ACCEA28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "741490427881556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982705_741490431214889_2929165475552190295_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1K5JsX-QoAQ7kNvwHiyxkM&_nc_oc=Ado7w0Cr4oiEDp01TpLOxEBkXqrRLTZJU-WBHLPGhHjw290-hDn3DEpRlXFKy1cQ9t0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlWm5EccThS816t0mYnMB59vM3QGDUYFkxERNPpBOSog&oe=6ACD0B82"}, "display_name": "Virtual Duck Hunt", "keywords": [], "long_description": "Immerse Yourself in Nostalgia with Virtual Duck Hunt!\n\nRelive the retro excitement of the legendary 1984 Duck Hunt in an entirely new way through virtual reality. This version of the classic transports you into an immersive world where ducks soar through the sky with breathtaking vitality.\n\nKey Features:\n\n\ud83e\udd86 Virtual Hunting: Armed with your rifle, aim precisely and shoot at ducks flying across a stunning landscape, offering an unparalleled experience.\n\n\ud83c\udf1f Modern Graphics: High-resolution graphics plunge you into an updated version of the classic game while preserving the retro magic that captivated players for decades.\n\n\ud83d\udd79\ufe0f Remastered Retro Controls: Dive into nostalgia with the iconic classic console rifle remastered in virtual reality. Use virtual reality controllers for a natural and responsive gaming experience that faithfully reproduces the sensation of holding the authentic accessory from that era in your hands.\n\nNote: No ducks were harmed in the making of this game! In fact, they're thrilled to be back and are playing along. Rest assured, these ducks are just pretending\u2014they don't actually meet their feathery end in the game. It's all in good fun and nostalgia!\n\nHow to Play:\n\nPut on your VR headset, grab your rifle, and get ready to dive into a duck hunting adventure that redefines retro fun. The challenge is set, the hunt is on \u2013 are you ready to become the master of virtual hunting?", "short_description": "Immerse Yourself in Nostalgia with Virtual Duck Hunt!\n\nRelive the retro excitement of the legendary 1984 Duck Hunt in an entirely new way through virtual reality. "}]}, "developer_name": "Fr\u00e9d\u00e9ric Peeters", "developer_privacy_policy_url": "https://sites.google.com/view/bifimmersive/accueil/duck-hunt-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Bifimmersive Games", "support_website_url": null, "website_url": "https://sites.google.com/view/bifimmersive", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
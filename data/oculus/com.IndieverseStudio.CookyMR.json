cooky2.png", "id": "934752894676802", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974521_934752898010135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_vVFckqIooQ7kNvwGi9qJj&_nc_oc=Adpol--t5T656DbF7mPnj5BUrFgwtUEtkYxUy01rdhD8feK9av5yOezMEJt7sprMtMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjUkryHac6zR5GjGqjmCI_HbfQ3vSDhEKZ-RPPB2SDng&oe=6A95BA62"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0HCv2PeSxwQ7kNvwEMm1LY&_nc_oc=AdraG1fTFCYn0lIb2eYh9Y11PR_jhY1FdLSKFD17P0dMGN8pUUMH1bEia3yaRPd-EOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGufd8hFvFmXhFDUdVMarA8kJGPkurEdGu5Ih1sRAVaXQ&oe=6A95B8D7"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljipZ3QWsccQ7kNvwHUVQmB&_nc_oc=Adob2_AH_YZf6dejS3DaoDre1MCDT2PQWuHYx1cUfZDsZhRwC5tzzvWkklrtYzs0G8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtF20OP2XbnqYSW0LUfUQ34knrOyR4FE9fUyTHJFXlIQ&oe=6A95BD36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypVg28DO7m4Q7kNvwEG1C22&_nc_oc=Adofn219szFiaWg8eOx8rnF6WzigQRBBLGdaZZDi2jg-PHyMtCJvFQvexZ9BLdtJn2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrVO4KVv8_KMhh6B_aDdo7D2wWT6-i-niS_xyJ3JTtCg&oe=6A95B750"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri":
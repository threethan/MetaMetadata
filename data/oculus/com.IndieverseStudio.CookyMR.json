cooky2.png", "id": "934752894676802", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974521_934752898010135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYafuQRKAY4Q7kNvwGbLZpm&_nc_oc=Adqrf2D1HEAGaHQ9w3XZ6798HqWfP0rV7qp40esszYGhQFDNxmknaqn6dUWiep4i5d8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJALLVCX_VmBDqj2Uzva4d-P8lDT3gfm8GScanWoB0IA&oe=6ADCB322"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWlHZuyO5pUQ7kNvwGrGh7Y&_nc_oc=Adqks37j58XrmWVxjHWu_qamjCCa09T4B2xoxyZ6QGOConJtVKXizl03NmDkTYP1_Y8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0bngNF66i_u9xY5KYsOnBZ5IM9_2Y9puN9G84ffL-GQ&oe=6ADCB197"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPEz40DmOYQQ7kNvwEqCfs4&_nc_oc=Adqw3wwkcW630p3R11dytSVQhXJvje2nlhcgfjBnJzip41O_EL1auuZZS2Z7tNSNNcs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjPVV2zRP07Tsk337v7vwz1FdW9SE1EasdlrDkJRHVQA&oe=6ADCB5F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFFvPwoS8d0Q7kNvwFXjH9I&_nc_oc=AdrzU9Hyn3BqoS-qpu-JXj1Oh_kTUFRKx1_C7lHMAEHq4Qi6Rkjs-GUv78nyUGF47go&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsRw4BKFXYTxd3LprRq3XQQe1Fbr-t_flP0R8_RGb9Zg&oe=6ADCB010"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri":
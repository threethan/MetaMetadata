yPA-EEye1TfmznkjnJQ&oe=699865AA"}, {"file_name": "5.png", "id": "434035262954817", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572933_434035266288150_659112195802918355_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwlB_VwKcCkQ7kNvwFhFoo5&_nc_oc=AdkbHrFcEVfyscnjry4-4sPr1Rr5aC9A05LJN5IWmrlNrWyi2ooh83-xNPgFLFdVdbQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftOlIh76-uWnxrB9FLKAvS__XZJ0sSufv5HksF3GbCB-A&oe=69986925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIMiF8V4uYQ7kNvwFBITE3&_nc_oc=AdlLaif4MdCeUF_QiwHgwlqI3H0d1j1oqbxJSRnBTWLSb63tifcjJnUpO8PPjy57RuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftE0S3N4BwPc9YPGIBDlEBTs8MapzV5wUmgTSjcCHEDdQ&oe=69985F10"}, "display_name": "CookyMR", "keywords": [], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to be
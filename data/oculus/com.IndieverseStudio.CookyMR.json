hK5oYIQPgzAkKX9T6jw&oe=699EFD2A"}, {"file_name": "5.png", "id": "434035262954817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572933_434035266288150_659112195802918355_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nsy0SE55bOAQ7kNvwEYwNqf&_nc_oc=AdnbHdxJY4rtpmiezsdgahl9DWBTDIFl_cmZDxI622zeQRsYLzs74NMy0O3n4_0-wLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv4jOzscBIDts0Y37plzOs0Vv7AIqud8gB0nRO_Hnxo3g&oe=699F00A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNalZGOCrYIQ7kNvwHXBJm8&_nc_oc=AdmW2IHJzcICJ1XD2rIr-7aD5bL5UYA69F2DBHrjkd9SW92NVlAk2l6y99c4rGA_afM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu49UCDCt7HCpYp79tlQeSjD0tvyQ0U8HKuOHv5M3Yeow&oe=699EF690"}, "display_name": "CookyMR", "keywords": [], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to be
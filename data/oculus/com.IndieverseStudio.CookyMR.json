mXH_WNzFA9WdDUvuL4g&oe=699B08AA"}, {"file_name": "5.png", "id": "434035262954817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572933_434035266288150_659112195802918355_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDR9lWimWQUQ7kNvwH_BV6J&_nc_oc=AdmxIj1lCRYX2XQFs0VqKfMDbLfFfgyxhSBJPy-QSBXU_ZltPtpD6EEDW8V8DK1cn20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs9tHvRcqaQ_r_399Ng5M3qAvRI3dReT2KLKNSGxwKkQA&oe=699B0C25"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIMiF8V4uYQ7kNvwF7iL_X&_nc_oc=AdnrHbsYPaCAIE-JfVUD68qC1rsCUpcnhNdP41Gr_gOmS0sgcguMOzwJEIZk_nDwcek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-d2G3rAR6oRUn9hZfAGZq3n7AuDpqRfSO6X6eS_vf6g&oe=699B0210"}, "display_name": "CookyMR", "keywords": [], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to be
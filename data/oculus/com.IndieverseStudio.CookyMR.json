10135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScZZrxYmUUsQ7kNvwFgrxlP&_nc_oc=AdlI88lgfi--Xru5uGBf_KaxfyB-Cr_3Zf5t2k4WKkCW37dkRK8_h8RMrbCrqaa3uzs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftYICqTDpeepIsTVaAQAtn9zU9waOFRd_VLPjH7LBa0BA&oe=699EF9A2"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNxEzXFeyu0Q7kNvwH5MDMn&_nc_oc=Admf7rYKZktP_OmBieGBc_od_TRO58mSOTeEtkBxzll4rWGlgUy4PtMzMS8MOXhdOmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu_s93me8_EMFxPSYUs11TQx7m2CxnGJrJ-X-deLeiYzA&oe=699EF817"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj1X4NWkmVEQ7kNvwGMgDK-&_nc_oc=AdmH2w_rCsbe7_PBa-GGMYvtD0_SbQogL3ViGCezv-NceRYKGPGXamnZnoZrnlSBdIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvN6qGdLGdz1xuZF0TxkT49tuGBfLtysUdXvgu8lQxuSg&oe=699EFC76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNalZGOCrYIQ7kNvwHXBJm8&_nc_oc=AdmW2IHJzcICJ1XD2rIr-7aD5bL5UYA69F2DBHrjkd9SW92NVlAk2l6y99c4rGA_afM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu49UCDCt7HCpYp79tlQeSjD0tvyQ0U8HKuOHv5M3Yeow&oe=699EF690"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974567_3877774485869261_6284259534700258884_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
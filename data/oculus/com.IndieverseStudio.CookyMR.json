10135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrmpepgErBoQ7kNvwEEGTQM&_nc_oc=AdmbUXkhjP0uwNK-oeB_i2g0hJI8YlB0DW56y0xsthFaw5zRtaBhtVRsG7YststUmyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvV-kF9XCPL0MIP-_esiq1hWVXmF1_31eX9-Z9LQ0IQ4A&oe=699B0522"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YMYPs29fEAQ7kNvwHGbihy&_nc_oc=AdklSrj_JyrPbA9s8NeSh31FEK8W9RViRdxtPkrqVSxojqbjKKNBUouIht1yZgTZ8Fg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftjI8uQhD9v15okij_txGlvvusAvBmVHPszjD_E_RPJfA&oe=699B0397"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdG79rb4DMkQ7kNvwEnSml9&_nc_oc=AdlI-zvY7zaixxrMt1whwe7IMIGXFZe4_wcICtWhvn851DZWRPQxLph9WO3emigF-wY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftbn1moZbmAg9F8KMtQ9q_1vbw0whUiz75e0GYdLSBAbQ&oe=699B07F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VIMiF8V4uYQ7kNvwF7iL_X&_nc_oc=AdnrHbsYPaCAIE-JfVUD68qC1rsCUpcnhNdP41Gr_gOmS0sgcguMOzwJEIZk_nDwcek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu-d2G3rAR6oRUn9hZfAGZq3n7AuDpqRfSO6X6eS_vf6g&oe=699B0210"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974567_3877774485869261_6284259534700258884_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
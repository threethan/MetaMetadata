2zeZO-9McXrxzFIZ-1A&oe=69A2F1AA"}, {"file_name": "5.png", "id": "434035262954817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572933_434035266288150_659112195802918355_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPA1AET4wugQ7kNvwEB9pn6&_nc_oc=AdkFOeZwfGdNqu94mQo6bz7XNm1n-gjp2CVODeL29PCMZpZOYAlAUE1TuRvInij1VcE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu9bhW-GSGE7Zg4eu7Pq8EZFRHEhUwC2P1OoNkaz6yV1g&oe=69A2F525"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed5zzW8VkdUQ7kNvwGn8Z0g&_nc_oc=AdkjnDnj-4WoTgTYVloMpotnpSi-2UYTV1NOeAJGLdiRaJoRYfsjAH9PvHfCmRJCb5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqCiekvztVBXs8DQM4JE_QcLg-lXNGJ2EDZUUDj2bFhg&oe=69A2EB10"}, "display_name": "CookyMR", "keywords": [], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to be
cooky2.png", "id": "934752894676802", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974521_934752898010135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIQ1ACcQZTgQ7kNvwHRo5hJ&_nc_oc=Adqm_zybYR_MG50g47UKI_-vxh53B260NZRn0zaNlqtOyBy6147eyBfoEx2BRMnaJYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMIQn2O1qhSDzKKosTTffstoFWyafa59fQ5jznXx_Yfg&oe=6AEDD6A2"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eyi7AVajTy8Q7kNvwHvE-0T&_nc_oc=AdoA4Pf-2WzMpv2zNjWHhHqJd7qq_efmjc1em6hID0ema2HhB257CWgKR-QgCfNwa6w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ__ICdjbC9A76PwjaFuqUjkJi0KnQ3W2Kf9qpiBTT7AQ&oe=6AEE0D57"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptWQejl3jK4Q7kNvwErrxVy&_nc_oc=AdozxkH7r9SUXsUEJWYlgUkjpatxRUhNXgJMR5srXI2N9IxmMDu8-B8ilc4jZFGpaUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfE0xPcBz4cMPitA2EgX5j3GBt18xgknGYi51czyzhxA&oe=6AEDD976"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev9RhLhcM1cQ7kNvwEPUpgK&_nc_oc=AdoLJmzezoS9CDw4-sEB7MXiARBFPrSyEE-sXBE1LgML-IVkHL1edxmX8MEwt4r3KYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0u-WoQCWAV2yQJAfkjxmpC3UwJw9YJ2F8Z5xJTUBibA&oe=6AEE0BD0"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri":
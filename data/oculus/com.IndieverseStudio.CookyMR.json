cooky2.png", "id": "934752894676802", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974521_934752898010135_8218220669990420936_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJ7gjGDQKU0Q7kNvwEZW-7A&_nc_oc=AdqYHR9QJu6r6n0fncI4xpG0oOwRhfHp6GtRFM2ICmv3VMGO8pbjFMnQoc0iYJF5USc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe3xVsuvy2uxsQn7tvhQHK5QLGMBqlPmUV6XuZ7frrOg&oe=6A660C22"}, {"file_name": "cooky4.png", "id": "1628209834434974", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572929_1628209837768307_5418941957335601265_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsH1xOXE61IQ7kNvwGUE8iJ&_nc_oc=AdpYpE6Z5oSamOwaR34MWAtgFCh3cd_6X-hJKouRhYRBxaxje_HmMkeDceEOAD9WGao&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrDnagCJziq_aQQfjUbG-wFMtK3rEdJ0LA2MGi_RX_xw&oe=6A660A97"}, {"file_name": "cooky3.png", "id": "578349898177047", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468784352_578349904843713_6657113734322811588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qib1WNJpzJQQ7kNvwGVMx_x&_nc_oc=AdpndduzbUhrnb6MDqLxPBogpaamI0V6QoskSXjaebSDYqBCa9XXhQh94LQcMw2bSNI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkFuZAHHiLxiXBAwyA58IN7c1tL86u28r6xQwJcfxkRA&oe=6A660EF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cooky MR Banner Art (2560x1440).png", "id": "1206811570749903", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57568684_1206811574083236_555128594483862489_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQUQ5PtpUd0Q7kNvwGzolvL&_nc_oc=AdoVK3sDP_34gUk5EWoPwIY39P9l1qp_ztXwsThkTmGO4JDu03GqX4oTDxROAHvEgDQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq4egpx18ioFusFx1O4aRt-Ff5D1hVmN6yKczYbCEdoA&oe=6A660910"}, "display_name": "CookyMR", "keywords": ["cook", "cooking", "cooky", "cookymr", "casual"], "long_description": "Welcome to Cooky MR, a mixed-reality experience where your room transforms into a bustling takeaway restaurant kitchen! As the owner, you'll set up your virtual space with cool equipment like pizza ovens and juice dispensers. Fulfil orders, earn Cooky coins, compete with nearby restaurants and sabotage competitors to become the best chef in town. Ready to strategize and expand your virtual food empire?\n\nThe game is in the early development phase and we would be truly grateful if you could join our Discord community (https://discord.gg/RvwDbFuhh3) and help us make CookyMR not just good, but great!\n \nYou can also win Discord Nitro for a month. To know more, visit our discord channel (https://discord.gg/RvwDbFuhh3) and checkout #playtest. ", "short_description": "Dive into a thrilling mixed-reality adventure, juggling a bustling takeaway restaurant, sprucing up your virtual kitchen, whipping up delicious orders, earning shiny coins, and sabotaging competing restaurants to become the ultimate culinary tycoon!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://indieverse-studio.notion.site/Privacy-Policy-for-CookyMR-ce209a244fcc4369a4712528cc522c4e", "developer_terms_of_service_url": null, "publisher_name": "Indieverse Labs", "support_website_url": null, "website_url": "https://www.indieverse.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28875796735352540"}, "review_messages": []}]}, "cover_square_image": {"uri":
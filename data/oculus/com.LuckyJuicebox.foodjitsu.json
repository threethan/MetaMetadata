, "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031634_1331331311141021_7331253255684338740_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sb3Kmp_VuQQ7kNvwHasEEW&_nc_oc=Adpkeem9bvZCcYPaXFLn_7DEhZi6hCNLRQ848DysPNMVqbBE-emeyFkwons_6UT72WE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhmIDxjUPE9KX5Zj7z6gJqWTPR2NP0gE3S5A1hOnf2Dg&oe=6B0313F4"}, {"file_name": "play.png", "id": "604970705393386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003232_604970708726719_758395721391521835_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qirW7hjClB4Q7kNvwEHkMYH&_nc_oc=AdrWyTVXXv_QnjkeBaZeh2UN0IJysBzWT_neQz-pJGOPOGvDjYEwjiwTDdlKKMWHGew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjlUO7HGY2ooROog_iYyo_JHpIN-DCI0btE8WVaJoWpw&oe=6B03113C"}, {"file_name": "sandbox.png", "id": "964703208883932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/428883494_964703212217265_5810470788009935409_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHlo0EjMJgoQ7kNvwHfytTe&_nc_oc=Adq-8uMNqO2WtpGMnrJdEM4JQ1DBU4bU1qyJdU9lWGw18fEETMEtIGUzzCVV6ObDyIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs4xA4pjVifydoIBqla0XAvHJB_IFAR3Rx5i9-RgDy3w&oe=6B032359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_coverart_2560x1440 (1).png", "id": "586189597446042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476754_586189600779375_4181291276431346407_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ucx3knb3HFAQ7kNvwFQIVA9&_nc_oc=Adp6f7wYKfd-XQUdvD4yzS6vkB8j1qJFnVLVeFBZ4F7R21kq5SlMoqDjP7GN4Dhglyg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxVP1MOCPhwzCY0hQ-gbDMpGQT1lOlHMDFk8LiRgqy0Q&oe=6B031640"}, "display_name": "Food Jitsu", "keywords": ["food", "cute", "fun", "hand", "family"], "long_description": "In the bustling land of Kitchenia, food isn\u2019t just for eating\u2014it\u2019s alive, adorable, and deeply divided. For generations, the Sweetlings (cookies, cupcakes, milkshakes, and their sugary kin) have been locked in a bitter feud with the Savories (hamburgers, french fries, pizza slices and their salty brethren). What started as a petty squabble over shelf space has spiraled into an all-out kitchen war.\n\nThe battlefield? Your house. The weapons? Cannons loaded with selfless soldiers ready to delightfully fly through the air. The ultimate goal? As a commander, you\u2019ll guide your cute-but-combative culinary troops through the chaos of battle. \n\nStrategically load your food fighters into the cannons and aim for weak spots in the enemy\u2019s tower. Bring down more towers than your enemy and you win!\n\nChoose your faction, ready your troops, and let the cutest food fight in history begin!", "short_description": "Get ready for a food fight without any of the cleanup! \n\nUse your hands to pickup delightful treats and launch them at enemy towers by using your canons. Or risk it all and throw your sugary soldiers yourself. The player with the most towers knocked down wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKI
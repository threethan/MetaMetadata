TAQJK1oHzQ9XxCWz3UJM19tBSDHhQ&oe=69F1F534"}, {"file_name": "play.png", "id": "604970705393386", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003232_604970708726719_758395721391521835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8MPVZuuOQ8Q7kNvwEHjx_6&_nc_oc=Ado7cxhgkK6Qf5-GjYhUCIm905eipFaZSLXBzxba55wT_pBTM3rhGCUY0X7ZN2XyRLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wlYYatuxEIAbRAR0s7QLbm-L8bEz5L5aWl4NNp7Zu5w&oe=69F1F27C"}, {"file_name": "sandbox.png", "id": "964703208883932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/428883494_964703212217265_5810470788009935409_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hD0Q4L0AawQ7kNvwG2Jk-O&_nc_oc=AdoIFMh7ByD9JFy2ZYOa0X1s03x27w5pD34nGlaC6E5kWXw8fzrMOSDEmUni4p-8aAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SfFM5DyxsqUIEes-cSu43kb0Wt65VcbSV578uzPSITg&oe=69F20499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_coverart_2560x1440 (1).png", "id": "586189597446042", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476754_586189600779375_4181291276431346407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Uum5GA78w4Q7kNvwEV3HM_&_nc_oc=Adq69Im2a--ZRCYJHoUt6EbGMcKIWLZg7zPAE7Kzo0jdIGMn1UYYawanLHywEWfl_uc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1Pg26hV3joY57RGKQFZ6Z8YWbo27QZXaPUOks1Y7abSw&oe=69F1F780"}, "display_name": "Food Jitsu", "keywords": ["food", "cute", "fun", "hand", "family"], "long_description": "In the bustling land of Kitchenia, food isn\u2019t just for eating\u2014it\u2019s alive, adorable, and deeply divided. For generations, the Sweetlings (cookies, cupcakes, milkshakes, and their sugary kin) have been locked in a bitter feud with the Savories (hamburgers, french fries, pizza slices and their salty brethren). What started as a petty squabble over shelf space has spiraled into an all-out kitchen war.\n\nThe battlefield? Your house. The weapons? Cannons loaded with selfless soldiers ready to delightfully fly through the air. The ultimate goal? As a commander, you\u2019ll guide your cute-but-combative culinary troops through the chaos of battle. \n\nStrategically load your food fighters into the cannons and aim for weak spots in the enemy\u2019s tower. Bring down more towers than your enemy and you win!\n\nChoose your faction, ready your troops, and let the cutest food fight in history begin!", "short_description": "Get ready for a food fight without any of the cleanup! \n\nUse your hands to pickup delightful treats and launch them at enemy towers by using your canons. Or risk it all and throw your sugary soldiers yourself. The player with the most towers knocked down wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8937452286292339"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1299833714436921"}, {"status": "PUBLISHED", "id": "1664479980771186"}, {"status": "PUBLISHED", "id": "601938222247132"}]}, "baseline_offer": {"id": "601938222247132"}, "is_approved": true, "firstOffer": {"nodes": [{"sta
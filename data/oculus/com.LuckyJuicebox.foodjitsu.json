zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AEDfZuVFxpqjOSuYVmLweVZLUWfmmK-N8Wnv6hdlyAQ&oe=69DE2EB4"}, {"file_name": "play.png", "id": "604970705393386", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003232_604970708726719_758395721391521835_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKZdcExU8Y4Q7kNvwHwLcVd&_nc_oc=AdrrLSya4ErwgHHyL2-dgb-VdLiRikGJ8xnysELyvG2It9r5xfkJjOkP90usYfYqte0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iaYiaV7nVu3S1gviNnTwZn0VT0dE4skrgddYwqA1JXw&oe=69DE2BFC"}, {"file_name": "sandbox.png", "id": "964703208883932", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/428883494_964703212217265_5810470788009935409_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir10DMIWi7UQ7kNvwHbLGKn&_nc_oc=AdptUr_tqDW63gZELbamjMgw8gi7R487Ejom3e-_BVc3HjQxfve5MbsUGgXGSD7Zq6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18TKAFYRxXiFRONj_AaUD-WuayJJqXaTdEZhV4ldkPYw&oe=69DE3E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_coverart_2560x1440 (1).png", "id": "586189597446042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476754_586189600779375_4181291276431346407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW-oMoP6X2sQ7kNvwEJE-Gq&_nc_oc=AdoF9HraHtOSidhyBf7Q1K17SkwRwttHHN9zc7_rHFAXqKPTPvt3RXSZr3NGPtwP3Ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36S1ihmX7KTQvQMzevucOTuY7NVRQ0OdWpz-1v8Udyjg&oe=69DE3100"}, "display_name": "Food Jitsu", "keywords": ["food", "cute", "fun", "hand", "family"], "long_description": "In the bustling land of Kitchenia, food isn\u2019t just for eating\u2014it\u2019s alive, adorable, and deeply divided. For generations, the Sweetlings (cookies, cupcakes, milkshakes, and their sugary kin) have been locked in a bitter feud with the Savories (hamburgers, french fries, pizza slices and their salty brethren). What started as a petty squabble over shelf space has spiraled into an all-out kitchen war.\n\nThe battlefield? Your house. The weapons? Cannons loaded with selfless soldiers ready to delightfully fly through the air. The ultimate goal? As a commander, you\u2019ll guide your cute-but-combative culinary troops through the chaos of battle. \n\nStrategically load your food fighters into the cannons and aim for weak spots in the enemy\u2019s tower. Bring down more towers than your enemy and you win!\n\nChoose your faction, ready your troops, and let the cutest food fight in history begin!", "short_description": "Get ready for a food fight without any of the cleanup! \n\nUse your hands to pickup delightful treats and launch them at enemy towers by using your canons. Or risk it all and throw your sugary soldiers yourself. The player with the most towers knocked down wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8937452286292339"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1299833714436921"}, {"status": "PUBLISHED", "id": "1664479980771186"}, {"status": "PUBLISHED", "id": "601938222247132"}]}, "base
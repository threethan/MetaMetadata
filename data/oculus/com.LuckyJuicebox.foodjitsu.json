, "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031634_1331331311141021_7331253255684338740_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOO5A8jlkFMQ7kNvwFhqJXr&_nc_oc=Adp9ny8UOvhKNakEmEVAbDVLvK9ohV6detaPk7iSQqVIk8xS7YSiaMz8Nxq2TmhcNt0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXNydjWQv_BPeUEYFIW-6rwVceCl_T_ZtBY185YjwP7w&oe=6AFB2AF4"}, {"file_name": "play.png", "id": "604970705393386", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003232_604970708726719_758395721391521835_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhFsCFnCAHYQ7kNvwFW5sJ1&_nc_oc=AdqhQShmFyq3pyi79ISR44nprGcjaTu2B_IxYX08PPq6SbZRPikUQtxrR2Iw8zvsrF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuOU9096-XfDWboDpN87Z_FCZmSgM9ckL1FFCSN1W5HA&oe=6AFB283C"}, {"file_name": "sandbox.png", "id": "964703208883932", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/428883494_964703212217265_5810470788009935409_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYG0WDcKzI8Q7kNvwHuT7dq&_nc_oc=Adqj98ulSMdC_OLIOlcS_oCfDeQyNWgcRmDliKv5r2BOVf0VP2cXm6BfPdq4XwA39VA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBKjbiiMBPZIN7jb0ivRtB5n-RB3liMiSd9nTELwfCFw&oe=6AFB3A59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_coverart_2560x1440 (1).png", "id": "586189597446042", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75476754_586189600779375_4181291276431346407_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oPXbLxLyUYQ7kNvwGjXn0v&_nc_oc=AdrAZ73C2-1Aub9gJ8bNwq_HDi0ewE5A9XmFaeY6vh1rS-JMLPWYyg9m0TDU4cVRxno&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3DGpK83IuWYSM76HSJARYON0hQBAIicje7ZeHc3wXhA&oe=6AFB2D40"}, "display_name": "Food Jitsu", "keywords": ["food", "cute", "fun", "hand", "family"], "long_description": "In the bustling land of Kitchenia, food isn\u2019t just for eating\u2014it\u2019s alive, adorable, and deeply divided. For generations, the Sweetlings (cookies, cupcakes, milkshakes, and their sugary kin) have been locked in a bitter feud with the Savories (hamburgers, french fries, pizza slices and their salty brethren). What started as a petty squabble over shelf space has spiraled into an all-out kitchen war.\n\nThe battlefield? Your house. The weapons? Cannons loaded with selfless soldiers ready to delightfully fly through the air. The ultimate goal? As a commander, you\u2019ll guide your cute-but-combative culinary troops through the chaos of battle. \n\nStrategically load your food fighters into the cannons and aim for weak spots in the enemy\u2019s tower. Bring down more towers than your enemy and you win!\n\nChoose your faction, ready your troops, and let the cutest food fight in history begin!", "short_description": "Get ready for a food fight without any of the cleanup! \n\nUse your hands to pickup delightful treats and launch them at enemy towers by using your canons. Or risk it all and throw your sugary soldiers yourself. The player with the most towers knocked down wins!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://luckyjuicebox.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Lucky Juicebox", "support_website_url": null, "website_url": "https://www.luckyjuicebox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKI
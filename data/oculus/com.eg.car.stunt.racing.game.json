0_Afz7OsF4YdA8J81bBocgQqDC2RJmrhc2dqY-dt0lD0lW2g&oe=69BBFC34"}, {"file_name": "New Project.png", "id": "1666828793900992", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391911_1666828797234325_1390172348470153985_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzhrN_USK6IQ7kNvwEeURM_&_nc_oc=Adn5orpef-CxvkLyoSwnXo3Dfe7xG0jrQkyWmSjhSV4WJ115vHS24omr59ymcGWvp_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5z5WeCSAVyyAUz8nm11rGFazDoAYFST4HCGQWfEMN2Q&oe=69BBFE83"}, {"file_name": "New Project (2).png", "id": "917681977195626", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393328_917681980528959_7587697732326265437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJD6kdafq08Q7kNvwGA5fZJ&_nc_oc=AdnyobmyGDPmLLR4nYap58THDlalzmrX8niy-P4vQ7ipbDqh_KC3P65ww9JUMNfKSXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwQ-Tbo79ySbnGOF46KGZ7dqRKm9ZuT2BxNXmdI3ZnDGw&oe=69BBE382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Stunt Extreme - Car Racing Games", "keywords": ["car", "racing", "stunt", "ramp", "driving"], "long_description": "Dive into the electrifying realm of high-octane stunts with Examob Games' car game\u2014an adrenaline-packed mega ramp car adventure. Brace yourself for the ultimate driving challenge as precision and skill become your trusted companions, navigating through intricate tracks that redefine the boundaries of excitement.\n\nAre you ready to master extreme stunts? Take on the mega ramp car stunt game and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine.\n\nKey Features of Mega Ramp Car Game:\n- Diverse selection of luxury racing stunt cars\n- Multiple HD graphics car racing tracks\n- Realistic and smooth controls for the mega ramp car game\n- Authentic sound effects enhancing the racing car game experience\n- Exciting car games simulator challenges with a focus on thrilling stunts\n- Perform daring stunts in the mega ramp racing game\n- Engaging and challenging levels", "short_description": "Dive into the electrifying realm of high-octane stunts with Examob Games' car sunt extreme an adrenaline-packed mega ramp car adventure. Brace yourself for the ultimate driving challenge as precision and skill become your trusted companions, navigating through intricate tracks that redefine the boundaries of excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/noob-gamers/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Examob", "support_website_url": null, "website_url": "https://sites.google.com/view/noob-gamers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2691890164460465"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28035021339478915"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1239868288254687"}, {"status": "PUBLISHED", "id": "1446613507096555"}, {"status": "PUBLISHED", "id": "1718730692433562"}, {"status": "PUBLISHED", "id": "825917447103027"}, {"status": "PUBLISHED", "id": "500916853116483"}, {"status": "PUBLISHED", "id": "1269857294623040"}, {"status": "PUBLISHED", "id": "2576769142664451"}, {"status": "PUBLISHED
_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3cWrYjIfcjOrBOA1CKyKadhSP77Pwda0nywxN8srdsA&oe=6A8D9AB4"}, {"file_name": "New Project.png", "id": "1666828793900992", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391911_1666828797234325_1390172348470153985_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtjGatapmDEQ7kNvwE1vy_3&_nc_oc=AdpeUVY0QWxky5uWZVTIZRLhwiRQibVC6IqEp9jJXcIv0bQmhA9sRXm5vJ4D2dTrkOA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWKkWAfp1Ky9lxYpbCquGb0_x8Fsstbo5fUCcCDKAlXg&oe=6A8D9D03"}, {"file_name": "New Project (2).png", "id": "917681977195626", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393328_917681980528959_7587697732326265437_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkosJY4u7GgQ7kNvwHE0dUr&_nc_oc=AdrOAkJ_Ga0Mujr9sEDOBXj2pFXe7DIHiBcvLiUyoDB-iRY8VUpiQE5_DdjwG6mYAwM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOayxYiJYQkBpkEOGMgUiQI1FfBgGNvrna38Zch0GzhQ&oe=6A8D8202"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Stunt Extreme - Car Racing Games", "keywords": ["car", "racing", "stunt", "ramp", "driving"], "long_description": "Dive into the electrifying realm of high-octane stunts with Examob Games' car game\u2014an adrenaline-packed mega ramp car adventure. Brace yourself for the ultimate driving challenge as precision and skill become your trusted companions, navigating through intricate tracks that redefine the boundaries of excitement.\n\nAre you ready to master extreme stunts? Take on the mega ramp car stunt game and embark on an adventure like no other. Gear up, rev your engines, and prepare for a high-flying, heart-stopping experience. The mega ramp car stunt game beckons\u2014the ramps are calling, and the stage is set for you to shine.\n\nKey Features of Mega Ramp Car Game:\n- Diverse selection of luxury racing stunt cars\n- Multiple HD graphics car racing tracks\n- Realistic and smooth controls for the mega ramp car game\n- Authentic sound effects enhancing the racing car game experience\n- Exciting car games simulator challenges with a focus on thrilling stunts\n- Perform daring stunts in the mega ramp racing game\n- Engaging and challenging levels", "short_description": "Dive into the electrifying realm of high-octane stunts with Examob Games' car sunt extreme an adrenaline-packed mega ramp car adventure. Brace yourself for the ultimate driving challenge as precision and skill become your trusted companions, navigating through intricate tracks that redefine the boundaries of excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/noob-gamers/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Examob", "support_website_url": null, "website_url": "https://sites.google.com/view/noob-gamers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2691890164460465"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28035021339478915"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1577298943888918"}, {"status": "PUBLISHED", "id": "1014594561216718"}, {"status": "PUBLISHED", "id": "970379698809321"}, {"status": "PUBLISHED", "id": "1239868288254687"}, {"status": "PUBLISHED", "id": "1446613507096555"}, {"status": "PUBLISHED", "id": "1718730692433562"},
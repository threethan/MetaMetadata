88313_3773097134111601397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7y1hnfcmZQQ7kNvwGNyvBV&_nc_oc=Adl6HAl8xXh6DzKPLZVB1v2EfArfsPfHB--WGS9vN9zdD4BzCSD8QLQejsv9GU4sCBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy11eZkfoVaSjlCdwZHIz-LgFc-md1oZ2j0z31cGtzV0g&oe=69B559EC"}, {"file_name": "2560x1440-screenshot.png (11).png", "id": "661116931416902", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86594844_661116934750235_549000293297218471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7drv-9sZ8rgQ7kNvwFveMcV&_nc_oc=AdnkCeMydeGxOEiVLtszbu3Va-D8agOwAxI8WPCpKKpfzWukC6spccJ5TXsqGKBRAUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGSIm69SUgo-lyryK6gCKCSQTU86A-0YHxOKXdBC1JbA&oe=69B567E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto Pit to Port", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world.", "short_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "https://www.viewport.com.au/privac
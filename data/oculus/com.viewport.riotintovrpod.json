88313_3773097134111601397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrib8sRIqP0Q7kNvwFEo8Zr&_nc_oc=AdkL3rMgckMbOl70t60FhTmEyYlQE0tY4k26rELIEB5obyMADu5CDu9IU0xp-gMjgdw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7hUTTWfm7rsSenkVVQAPdnzrGDYFSekrNiAQ1vnDOXw&oe=69BD42EC"}, {"file_name": "2560x1440-screenshot.png (11).png", "id": "661116931416902", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86594844_661116934750235_549000293297218471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEmV7-6J_80Q7kNvwGleTaD&_nc_oc=AdlbieKTMFkJZbf4wVMH_Qpsu_33QB4bmAZP9ckYhCkhET0XguVfsfpSeBfU4uF92HY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwQl0u1gMiC-6C37uE1w7CqzWPu-FvJgz5lsIBQuAV7VQ&oe=69BD50E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto Pit to Port", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world.", "short_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "https://www.viewport.com.au/privac
"video_trailer_thumbnail": null, "display_name": "Rio Tinto Pit to Port", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world.", "short_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "https://www.viewport.com.au/privacy/RioTinoPitToPortPrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Viewport", "support_website_url": "https://viewport.com.au/", "website_url": "https://www.riotinto.com/en/careers", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_
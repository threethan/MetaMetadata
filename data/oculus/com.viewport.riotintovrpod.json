88313_3773097134111601397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yNLITBK470Q7kNvwFU164K&_nc_oc=AdmnyVz9qNZRIooEXBkR6wsiiB0sNu2_ey2dCfGEWaniOj17nwzvFlIX6K7q7V2NpgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxhuev5dTWDoUTxijDaOL7ahnhHnH4WujTIi2VMKCU3AQ&oe=69AC1F6C"}, {"file_name": "2560x1440-screenshot.png (11).png", "id": "661116931416902", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86594844_661116934750235_549000293297218471_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5nB_iX1fXYQ7kNvwEdaDhO&_nc_oc=AdmX4__psNDks6zXCsrqCyVDUn3K9mQ2D4dyAfn2MtL-mhJbwiHkv8sTVm4NX9zontw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGrWImmDP6EXO_qSPLwSFEzZ1ZECnbmrPWN59MUTsm6Q&oe=69AC2D66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rio Tinto Pit to Port", "keywords": ["Rio", "Tinto", "Mining", "Iron", "Australia"], "long_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world.", "short_description": "Where does the world\u2019s highest quality iron ore come from? Take a peek into Rio Tinto\u2019s Pilbara operations by travelling with giant haul trucks, and flying over crushers, reclaimers, trains and stockpiles - an exciting and immersive journey from Pit to Port. From the safety of your Industrial Mining Drone, you travel across the landscape of Western Australia in a 360 stereoscopic experience that showcases some of the largest iron ore operations in the world."}]}, "developer_name": "Viewport", "developer_privacy_policy_url": "https://www.viewport.com.au/privac
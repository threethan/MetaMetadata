f6uCNOT44u4tCIVnI1mspYy8_myFNgxcyhSTNu8DH7XhkyQiH3CA6cLo9Q7fQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5nH7ug438WTyxgtPn8_3I0EI-Ba-errOkOcrcWig7pA&oe=6AEDEA50"}, {"file_name": "e2mS1d.png", "id": "220029102688790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982597_220029106022123_7356633195355308032_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpnKzLtOulsQ7kNvwH8ePkp&_nc_oc=AdpJbnmIMmp-cfXFS9hIU-9FwytsOrFH65xgV2V0iDlwRKGqBHOKj5Ii7RWFtHinJZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4wk4nOnLNBasFcyFhHXVR5xXZl6kFszln6OYwWpKcnQ&oe=6AEDF106"}, {"file_name": "UFHKsK.png", "id": "215901876152108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982701_215901879485441_2653951431404421120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaVBbAyEh38Q7kNvwHQpy5E&_nc_oc=Ado_ItATqNYdcHAsDTfgJJMpNj62QoCN_bt-wcVKDeUFT-84jagLsa_cwamSLqVWVKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzgSaBM7qlF3oc8KX0pk01mD-qEgW6uHq3rPKNB1Vt7A&oe=6AEDD728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/9KAP8n", "id": "2894866053894422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982601_2894866057227755_8227658228045971456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B-5BBBFUNIQ7kNvwEmbth3&_nc_oc=AdoAlp5QaxuS_DGwzUbATT3AgvkkjL-mISKeF9PauK2qQE1lyqQ2QdhVQIOu7kVDMy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHKzSmbw2rnRuF6cSafy5UVt8ZliqOgfA3gVM2HFwINw&oe=6AEE0652"}, "display_name": "The Reaper 3D", "keywords": ["action", "fantasy", "reaper", "gang", "underworld"], "long_description": "In a not-so-distant future, criminal organizations are uprising forms of economic power and serve as governing factors. Niko is a 35-year-old veteran in one of these gangs. But when his boss, Salomon The Conjuror, makes a deal with the established government to seek greater power, he betrays Niko and his crew. After a brutal psychological defeat that ends in his death, Niko must travel to the underworld and meet with The Grim Reaper to gain a chance at revenge. With the consequences of his own wrongdoings in mind, Niko is driven beyond vengeance to save his wife and son from the hand of Salomon. But The Grim Reaper is not benevolent and Niko must pay a high price for the powers she grants him. He may never again be with his family... in this life or the afterlife. \n\nEnjoy it in 3D for a more immersive experience.", "short_description": "Follow a noble criminal to his death and watch him rise as a super anti-hero who serves Death herself. With a curandera as his guide and the lives of his family at stake, Niko is driven to slay in a hell on earth. He is The Reaper\u2026 an instrument of Death. Enjoy the 3D Experience and learn more about the characters of this pilot episode."}]}, "developer_name": "Craft and Conjure", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Craft and Conjure", "support_website_url": null, "website_url": "https://www.craftconjure.com/thereaper", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es", "es_CO", "es_PR"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712182640168312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570313_206906653987006_1270566070503079936_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_si
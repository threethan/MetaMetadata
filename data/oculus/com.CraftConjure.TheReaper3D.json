i2Rz3u-ZIga_EyUiIIl6Thm1GsD-BwtWdKeRYEEVfpaGwE9hHPiCWAL0_9u8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GLpRxX793G1LJZNQ7J7PkgFyJaZaIJW0Le-Wk49V09A&oe=6A3A9E50"}, {"file_name": "e2mS1d.png", "id": "220029102688790", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982597_220029106022123_7356633195355308032_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1GVT8-3jmoQ7kNvwFr-JZ4&_nc_oc=Adp1ZBjlg2RU1kzEd-Q4m9unI4iK9j6ZiCgHfwNZIfmXHzmVkQem7xCke8-kJMBZelY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92rLTOcb5uthSsia8rlx9rQTMq5x-V_g2eoZCWKPzNZA&oe=6A3AA506"}, {"file_name": "UFHKsK.png", "id": "215901876152108", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982701_215901879485441_2653951431404421120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEBuy5wYAk4Q7kNvwFUXzbP&_nc_oc=AdpEkWg5gWUp0sWB8hMi_qJz6Zm5eQryTANQXI_JgvGz0vPi1z3GP6eqi6UQMRqQqGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92F222cL-LrTTYRhUnfVoqz0K-qJYSCryNt5hceLghgA&oe=6A3A8B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/9KAP8n", "id": "2894866053894422", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982601_2894866057227755_8227658228045971456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ehH494ukOwQ7kNvwEMgxr3&_nc_oc=AdrnXwf2rVdSnDFgV0tN6-l7g9-Q-Z4dkVizJ5KBHrhUQxKBnpl50ERCIX5RNdEb1Sg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_hFt_opkpwY6iXbUzP3iascOdP-ehXmOSMxY09TucLQ&oe=6A3ABA52"}, "display_name": "The Reaper 3D", "keywords": ["action", "fantasy", "reaper", "gang", "underworld"], "long_description": "In a not-so-distant future, criminal organizations are uprising forms of economic power and serve as governing factors. Niko is a 35-year-old veteran in one of these gangs. But when his boss, Salomon The Conjuror, makes a deal with the established government to seek greater power, he betrays Niko and his crew. After a brutal psychological defeat that ends in his death, Niko must travel to the underworld and meet with The Grim Reaper to gain a chance at revenge. With the consequences of his own wrongdoings in mind, Niko is driven beyond vengeance to save his wife and son from the hand of Salomon. But The Grim Reaper is not benevolent and Niko must pay a high price for the powers she grants him. He may never again be with his family... in this life or the afterlife. \n\nEnjoy it in 3D for a more immersive experience.", "short_description": "Follow a noble criminal to his death and watch him rise as a super anti-hero who serves Death herself. With a curandera as his guide and the lives of his family at stake, Niko is driven to slay in a hell on earth. He is The Reaper\u2026 an instrument of Death. Enjoy the 3D Experience and learn more about the characters of this pilot episode."}]}, "developer_name": "Craft and Conjure", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Craft and Conjure", "support_website_url": null, "website_url": "https://www.craftconjure.com/thereaper", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es", "es_CO", "es_PR"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712182640168312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570313_206906653987006_1270566070503079936_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_si
4NmHCBe5sKR5ZimiLJ15onppxwYWL1FTTmjPqNV7QlA&oe=69998F10"}, {"file_name": "e2mS1d.png", "id": "220029102688790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982597_220029106022123_7356633195355308032_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NV108DO5RsQ7kNvwGrtbRn&_nc_oc=AdlVJ1Pv7IKIZyKCDrtsnNaGWJ6U4uUC6jLou9-fSP_naM7tAzSxXTMG4hgBC4yj8l4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjZzJsUbGPNwhYTYm0ELALcq6GAX7jO0RC84mtsudzHw&oe=699995C6"}, {"file_name": "UFHKsK.png", "id": "215901876152108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982701_215901879485441_2653951431404421120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jzSurzLGHQQ7kNvwG6zLgN&_nc_oc=Adm4oiTz0gnm6VbaJyKsz1sV9-Dwpmhm5Vbxy0hcVu80rJ-H46Ow8yhLkiuJsXxuWNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbzBGGNgilHHKRz4mxeCvKpHLqkVyffHB1_bc7Wz3DhA&oe=6999B428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/9KAP8n", "id": "2894866053894422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982601_2894866057227755_8227658228045971456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XTOnWUJxTIQ7kNvwHPs_Ep&_nc_oc=AdnEQZfMiIgLIWOZBlZw6sI6x6bn2G1KQcKcM8WmsBeWWlyMMzWLSNfdgxnD3Mk4J8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSD_HBQIUA3cewDuxkWYm_II-QRXOp80-53c9NIvn3Pw&oe=6999AB12"}, "display_name": "The Reaper 3D", "keywords": ["action", "fantasy", "reaper", "gang", "underworld"], "long_description": "In a not-so-distant future, criminal organizations are uprising forms of economic power and serve as governing factors. Niko is a 35-year-old veteran in one of these gangs. But when his boss, Salomon The Conjuror, makes a deal with the established government to seek greater power, he betrays Niko and his crew. After a brutal psychological defeat that ends in his death, Niko must travel to the underworld and meet with The Grim Reaper to gain a chance at revenge. With the consequences of his own wrongdoings in mind, Niko is driven beyond vengeance to save his wife and son from the hand of Salomon. But The Grim Reaper is not benevolent and Niko must pay a high price for the powers she grants him. He may never again be with his family... in this life or the afterlife. \n\nEnjoy it in 3D for a more immersive experience.", "short_description": "Follow a noble criminal to his death and watch him rise as a super anti-hero who serves Death herself. With a curandera as his guide and the lives of his family at stake, Niko is driven to slay in a hell on earth. He is The Reaper\u2026 an instrument of Death. Enjoy the 3D Experience and learn more about the characters of this pilot episode."}]}, "developer_name": "Craft and Conjure", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Craft and Conjure", "support_website_url": null, "website_url": "https://www.craftconjure.com/thereaper", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es", "es_CO", "es_PR"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712182640168312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570313_206906653987006_1270566070503079936_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noe7US7uMkkQ7kNvwH7asTj&_nc_oc=Adl7OKEy-3ddrg5vWrMx4DWDnTb9SxG1sRYZ-YRDzG7Ke2p6n4SmhYG81NVlchufVyE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_A
80xL0Dm1WLTwz1uKU9VEPA9p7sDCOTJLh6wHLzZaqBnoVbavGArGs5pIiLTA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DkoS0C9fm4DRxeBBKl05XvDf-eiSALK3DfhrrmW45tg&oe=69E39B50"}, {"file_name": "e2mS1d.png", "id": "220029102688790", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982597_220029106022123_7356633195355308032_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz6SLnvnF3oQ7kNvwGNAN1y&_nc_oc=Adr4YGegFBVtuuf5SooqsRyDekOCu1G8eFo4iOxGuLTlw_yeTn4rfFv36kL7kEGtCfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z79AR6P8gwUvgAx8RZeVYX6dFDFXsN5RD2aS5UjSbyw&oe=69E369C6"}, {"file_name": "UFHKsK.png", "id": "215901876152108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982701_215901879485441_2653951431404421120_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX_qshtCCG8Q7kNvwENrHTH&_nc_oc=Adp9ZnMk9WzskFajlEra5WuwiwqEMQzRDRcmqLdxAJfvaCdMpCQgGs7NNBMnuXQOhCc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Iy_91W_vw3tF_IonWuwD9HWrZSERG20EYrf_7xYHcqQ&oe=69E38828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/9KAP8n", "id": "2894866053894422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982601_2894866057227755_8227658228045971456_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCt_IRVXi_cQ7kNvwFCB6fC&_nc_oc=AdqDZlZx9GrXsWEkCGAGvzFKnbqTHlN1-Ih9kG8V_qGVfvdiG9mB5uTEtggbmHyX6h0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yQNeSAG2lJrjd5XIC1rao71z8XYBdCclou5FPQ_JTHg&oe=69E37F12"}, "display_name": "The Reaper 3D", "keywords": ["action", "fantasy", "reaper", "gang", "underworld"], "long_description": "In a not-so-distant future, criminal organizations are uprising forms of economic power and serve as governing factors. Niko is a 35-year-old veteran in one of these gangs. But when his boss, Salomon The Conjuror, makes a deal with the established government to seek greater power, he betrays Niko and his crew. After a brutal psychological defeat that ends in his death, Niko must travel to the underworld and meet with The Grim Reaper to gain a chance at revenge. With the consequences of his own wrongdoings in mind, Niko is driven beyond vengeance to save his wife and son from the hand of Salomon. But The Grim Reaper is not benevolent and Niko must pay a high price for the powers she grants him. He may never again be with his family... in this life or the afterlife. \n\nEnjoy it in 3D for a more immersive experience.", "short_description": "Follow a noble criminal to his death and watch him rise as a super anti-hero who serves Death herself. With a curandera as his guide and the lives of his family at stake, Niko is driven to slay in a hell on earth. He is The Reaper\u2026 an instrument of Death. Enjoy the 3D Experience and learn more about the characters of this pilot episode."}]}, "developer_name": "Craft and Conjure", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Craft and Conjure", "support_website_url": null, "website_url": "https://www.craftconjure.com/thereaper", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX", "es", "es_CO", "es_PR"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "712182640168312"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570313_206906653987006_1270566070503079936_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_si
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1FKp9K6aAQ7kNvwEw337f&_nc_oc=AdqxWshR5uw-1i1Abu-LYy1KwsYXpP2UirgGd3IXLHyI2vdhReL9I4s7oFICU63SiFU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTMmt4qi8qAwY-eK5G4m_j1tnP9xaVcf9x6gu65c7jdg&oe=69CFC1EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB2eJip2MRUQ7kNvwGmrDqA&_nc_oc=AdpHvBxiVy3k0a6rqkMPMBm9tK6H0isDpmGD8D7viH8d498yEHcbRsDpRGBcJZvQNQo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTtsWZzmk9ooyTiIIzuJInWWMSDdNCSfyVdBeVFIFI1g&oe=69CFD41E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
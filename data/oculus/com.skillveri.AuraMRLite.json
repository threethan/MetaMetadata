t-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJoh469V41Qgj88302Tlnsex0C0SixgkazcCmNcjgVQ&oe=6B03048E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SmWU7RkYVQQ7kNvwEYyLOG&_nc_oc=AdpSc3xcT1yPfjQYvJZWSNx4fDrWa8CSTSZL98nUDcXmEO80LC_-zIc0xhE3EbCgFfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKFSFsPWpPKQ21VxTeVqIbWG8B4oPDXvNx3-nDs4aqpA&oe=6B03209E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHNWR-cziWkQ7kNvwHIE_1P&_nc_oc=AdptZgrVLbqnTubv1GMgFmjhr-aQ5zB2JsBhzPSLCzBhXNAlTaaBZGJFy4bY14NkUxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThjSe8k6OAS7qcyD3x5T4gWK5SzUB2ped9jPLzFrBNkw&oe=6B030CA2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21UyLuX6snEQ7kNvwHVXr74&_nc_oc=AdrEhxDNTxiEPZDn-E1a47ip20tCYwG4vNBwKFBJ47wrMWrdj_2FPwa_YSemq_8prvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXRwiRHg5iieB5Ybh6cmbFtAzyBhPR6p7nQdhZ1Zhwjw&oe=6B031D1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6E_u4NwBpwQ7kNvwEaN46s&_nc_oc=Adrf_c6FHpUFhgRI7AbLbDH1-ex-OzEzJS_LOPvynnRo-3Ki3OqXPlRnEVTya8q-6AM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbJR5x4XkhHXuyPgq50GhnYi9-KPWustM1KIQ92gSRsQ&oe=6B0307C9"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
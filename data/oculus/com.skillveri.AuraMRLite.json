&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GALkzjs7WEQ7kNvwGy84tY&_nc_oc=AdoamjShn57LtH7J0Izhw2O9pKYCMWKLKim-xXGsIe1pyFQ_XTc4yVGREsBEg-WUmJI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykD7qronaxXk615RMdBngwZW3gYGD871u-a3R36OHitg&oe=69C7D8EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAyt414hDIQ7kNvwEDwDjQ&_nc_oc=AdrcVlm1E27wBqSsi1VEHQbeIRqeCvbSMugQwFBcNmmmp0OcaDOMnxDrXLlZOd3qgE0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMqb14_9MAlQaaYp0sbbFxQGipMopTFW7aPwjLZ9-Vaw&oe=69C7B2DE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
t-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxvOhW-EAES0dxJvEebyeFVYKBGp-S64q-5HXjNf0oCQ&oe=6B0DC8CE"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNfzz_aUU54Q7kNvwHSO8V0&_nc_oc=AdqI3KuwikjjOGkm_qIiHaCaVQi4PybezxQQ3x-WqKs4M8RtelRFDZXeFR9xdE-aSO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyTlLOevZxEfzexXNVsiTQQW74GCMaloMDK22kFZFcCQ&oe=6B0DAC9E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk979Kf1mxQQ7kNvwGEQLyv&_nc_oc=Adoc-TTUOGxlmvvyZ7rBdAq6hf75dOAj5FdCTfe2wkM0OuD6QwHZJOMYyZN1stmr_as&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUYU8yDUZLT6zbLzfVapYL67EpHEkhgNrr02No_GJ8dg&oe=6B0DD0E2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZoV_TQLmoQ7kNvwHWaLed&_nc_oc=Adqfxxy6MamYZ5gK-5dmZtrsK0Anbu1uhNrmWFFCTYPDyIqZiTeNeOcXOdcV24iMdSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShXHEpEn9rXQo2EC6xveUIelXP99Di6MSveyByCk_yiw&oe=6B0DA91A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1Kjw9eCVcsQ7kNvwHCcxaC&_nc_oc=Adpf2xyp10KAM-dkAbSTiRaPAz486TnTTFF4tXL7LfMbe3ZG34Ekbo3U2tjbmaDCYc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5jkxIYSrbw4xXkVpC9Y2rBYBr7E1U760NR9rmYAJCJQ&oe=6B0DCC09"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd7S3UQ9u0-nWcnJjtqUqVQFgMTHIk8L7o81iyGKp6FQ&oe=6AFB1B8E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTstwuA2mNQQ7kNvwEt6alL&_nc_oc=AdoIa1ADt9HfHAHr9gdDATa-EpCZ0Yuzv5MtA_I8RJrr4u1IKRKZDA9SJMnAtNwEJZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB922prn-e3h-njoj9rPNmMgmSZK-GImS7_XK8_sVYtQ&oe=6AFB379E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8JRB48BE_4Q7kNvwHEUIwo&_nc_oc=AdrPuD80jKezgcuxS1TPDXU_G57z8DTkQzoTPRBz0Xi9Je1pEZj6GgegiPdW6DHTdS8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgymkrha9vksvnHXIZQnRU1HJbBXTiLkB2FtNaKhZjsA&oe=6AFB23A2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMXl0zPN0JYQ7kNvwEs-nEd&_nc_oc=Adpi0NPDDE6gzXOVXXXVddqJDu5gIrzIwMscOqhlLeiRq-Di5BoEedEvNCe1ntX1gNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWuLiwOmSbzzRZaV2l3o2O_5vzY79BbdLLynym-yMelA&oe=6AFB341A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL13i8FKNAcQ7kNvwFmdLeX&_nc_oc=Adqy86w3lp5o5ofmD8y8CX4P6SX0SEzI2XJJAcao3hA8XghcHQF-ameCDEsFyeAYf2Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW6Xf5ViKWKBv8o_L1WN2WDZ9CI7to-vyaNshuBR20Bw&oe=6AFB1EC9"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
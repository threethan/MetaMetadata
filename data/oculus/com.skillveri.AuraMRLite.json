t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlH_xvppJq7YtjlD6q2QU9X0Iyc8qiqaOL4wCWD4_7QQ&oe=6AFDBE8E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxqYEgmFuFIQ7kNvwEK6P8M&_nc_oc=Adp9zGiXsDLOE-ERqiUgGYSNWQISKjQ1MYdXVKInJgeFPGnUQ0la7cdUJMEg4LzYids&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt9h7FvpR4zeHKFLARTib-s8cnkMwgk9E8exbitY8mPg&oe=6AFDDA9E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8JRB48BE_4Q7kNvwEc7bca&_nc_oc=Adpqu6uYIBVtU52hUv-sHo2HEK71g78VmBTDSEkde7bJ2HvPyKrL-LEkprTfc4hmBiI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN-JVgt6Cu2d5tBHt0g_U5vBgWcC9qeklyxKiVKsr6bQ&oe=6AFDC6A2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMXl0zPN0JYQ7kNvwG0UYO0&_nc_oc=AdrUpmfdJOdlDQ4vhmcEre1RJWfB8ALcZl4lBrEyISNwKXI91_R2FoIgCI86xANeU1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyzGomYAHUJYeAjJeb9EFsFy6V8dmqcrLEZQDWe_9yYw&oe=6AFDD71A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laqtv-FaRNQQ7kNvwHtnVjc&_nc_oc=AdoDvSHwSbBMacixCqPKpKnwPTOXbM2JF_2FQNddE1SoYnq86AcMsMfiGe7_1FE-k8U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4eBg9uzVZZ41ARsekH7oqqEVYZ9s2EluQFjizd1iH4Q&oe=6AFDC1C9"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
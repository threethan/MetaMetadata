&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1bgupmxXpkQ7kNvwEyDYtT&_nc_oc=Adq4_KuuO1Hs3LBbW_K4wOCAL_5x78Aj4VwynF1bCcP7Moarmfl9CziWsf70h6zqgvw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04Icqe8ymFeybfIMTML72nr9GblukDyRkr5Z0MidsVbw&oe=69F4ABEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDSkYpUAkaYQ7kNvwFZzC0j&_nc_oc=Adp7WoksPYPpRhDCciCHHvaFSftbG5Z4WY_Ph0bopY37X9IuJ2LL3iOviQumZm_kB5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09YS6nA0TT5MNPNvhi6vX53eTX7kR0Mv20qnQRQkkW9g&oe=69F4BE1E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
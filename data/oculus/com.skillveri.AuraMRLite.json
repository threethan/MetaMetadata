&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9fA2xKWofwQ7kNvwEkSPSp&_nc_oc=Ado6JM6au7Y1v1030eu0dUEiykXE9Zlv3Swxd2XW8P7tLtxC7iYdCzCw4l_nZlJi8X8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLJPPixGbukUCroEs6HKAE9aKguBl93mxqa7xiPGsoNg&oe=69C292EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9zFqu8NaCEQ7kNvwGyo9ls&_nc_oc=Adov9nC6s4ykHGdWhpJtNUefNkOr8v7g2QBg51Es69S4_-Jjffc7F3NP_Sm9ERpIOUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuZ402rWPfp--fa0HsARUAMFvXZKd4tXyZDimjZjIykw&oe=69C26CDE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
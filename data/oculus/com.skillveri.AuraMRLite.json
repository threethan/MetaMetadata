7kNvwG1Tv8N&_nc_oc=AdnAgxN9hFpXcnNRRFry1w3QnaQ1shh9jclSXlnzHwSwQ6y-8oSTJlEmzkvXgFMkIpA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzERhImJF4kQcn8k1aQ7n2kaVRgsjbxBJf0o_Y24reYQ&oe=69B563EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeOjYKIphCcQ7kNvwHIoZ4n&_nc_oc=AdmCFBmAxqo7biq5K_oDt685L3p79W2KXXbRH36GEZRgXkplFlbBbtepW5ZtNzJqi_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN3UzYLkgdRs2p5lMKAedLJy82bsF2sBT-uooq6hmH6g&oe=69B53DDE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillver
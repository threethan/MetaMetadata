7kNvwGds9WI&_nc_oc=AdmuaszAMqkxjNiXhYGklnHdh8Ygd9K918iYaBxYzVMt-6MJEjxnS-JSLLWVaoHkq-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_z4wJWXueO8RYFSO6jK1LwoFI66e5soYWbyaOx6JgHQ&oe=69A834EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIFnkfrW4oIQ7kNvwE2p-PA&_nc_oc=AdnmtKOk859NVWqE0VPFTtPbYjKA3quiI4zOHHnB03S0bZrEMlGfvIJE-kiFxMZA24g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvURkPc8c1u5Dc72bKFqExM-CTiizxUVOM9s_1Rlsuo3A&oe=69A80EDE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillver
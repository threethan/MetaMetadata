&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcdsQVHeLF4Q7kNvwF1x8ky&_nc_oc=AdoFag1PP6Ud47vFCUBoBQqpefIGi6utBCgVW2EwAgimv2PAHqSeE4b1SqKEU1RoTl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYAOHGwPHXDTz-K2eVqZ2Bu2QydtLpI56SWC9lrZk-wA&oe=69CA7BEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRAyt414hDIQ7kNvwGkIolC&_nc_oc=AdoU6AZQZiT5U8LWczEX1YG_PxAR-JnZ_8128ON_pK3gOnOqJuG7gZiZrfHo_qBYGtE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx02Sgi0c6L9GgqagIbVH2mgLzyYFU7Dz8_O2dFq1RFA&oe=69CA8E1E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
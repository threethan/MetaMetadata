t-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfG65LZXWdsbmC_6qfIUTD_6xPcr2ldA67-YiuotEiFQ&oe=6B0C774E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNfzz_aUU54Q7kNvwEZGq5h&_nc_oc=Ado0b7eCwXDwVxhnsFQGaYwyefC2HgPcSw9kDzmJqikGQv9LmXnnmLyA_ntqg0TYyXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlQgCBGQzg0H8UXuH3NgBYcOzIsmr-VsLlglSRDNurqw&oe=6B0C5B1E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk979Kf1mxQQ7kNvwGdI0sU&_nc_oc=AdqqFjqliuuDRUgzswCqCZPhPrUDnI7PFyou1kc9VwDrKqglvoZkApFyxQKC_f4u_f8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT6ZTxyMp-V02fk0oDNZ0hxESebV0odNBFWB0do93FYUw&oe=6B0C7F62"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZoV_TQLmoQ7kNvwEGhzxE&_nc_oc=Adpl7DUBYLEUi3Yc-USFkXDjVDYxEF4giUTe7-fqDlMYabmU4u92qLDiQ4ZBwCK-v4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCvb6VYYCmSHVik3PFwnXZ2ureO81yNq9V8rxE4T5jiw&oe=6B0C579A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1Kjw9eCVcsQ7kNvwE1fT3m&_nc_oc=Adrcxoz0oxHcppa0aRME3PmKNO1CMFs7zkXdRVAM-xw1Zmlxs_azIECGzmZWCPEuZkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHIDzKSTQoX5CjY6WxsreSnpRKhQwL2ajJfaL3FNwzug&oe=6B0C7A89"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
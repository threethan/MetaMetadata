&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh1FKp9K6aAQ7kNvwFFiAyk&_nc_oc=AdpC8tW5yDK_I3nTJ86PqBtVySojx1KdCjifhh-4CFL-jFfgmq7XcQf3YGxg33yAL9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws9xY25JYwKWk8uF8WSD0aeV-_LIs8fCH1BBy7hxjYQQ&oe=69D1136A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB2eJip2MRUQ7kNvwGSo4my&_nc_oc=Adqlh0rwIhHnVCLpk1EDTNlZRGE9rZR6vflBeNLUrTBEZSJCDjlHeQN3Rzq0yuhbwMU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIPr_VGnKOmgsXL_kL6R20zoCjnU6qMmNzJ6zLA_S2XA&oe=69D1259E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
t-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9NfNQZB0WjSfh3IZQJ_VYNf3LfQKPcnq0y1ZvrgtsGg&oe=6AFF100E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxqYEgmFuFIQ7kNvwEfEGG-&_nc_oc=Adqlhc4CmBPAYPb2Bm6QopYKxspSkp-MTyuYRiirfO2e9Xk97wgRyYVTae-LegFxJuo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCcxdlFxXW1KKcC1yBWQmixl6vC8f_9eHx4NkpPz4naA&oe=6AFF2C1E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHTI0Lb35mIQ7kNvwG2FP09&_nc_oc=Adrwxt2OmNeW0N-pw0D-8VfxOz9FNaQw9P2cvMMfGwDI9BhhU1RTUtFmlIf2260GjOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeXypOxbCMoBGSaXTKf8ehv67rYjNXrThS_shZALrgXg&oe=6AFF1822"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efieD74gwGsQ7kNvwG_zamq&_nc_oc=AdoR01bsAfRtvIGpvcaNA12HiMAA-Z8aVPIxGxZ_5z2a_qsdxTz2nzP6VRl4TDuFW34&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRELRGrI1JGyMADOncy20CSCMnROX6-9QQd_T5AkxSqKg&oe=6AFF289A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=laqtv-FaRNQQ7kNvwFC6rtB&_nc_oc=AdqUJJX1uSmmTsWyH-_pGfGUlq_FhdWWS6mDkU8RwZhrWW95aITleF92U8NPuoc5nl0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4T0oCf2UoxiHhisTOAXjNnchrrO5HMYuPX6UvEQ4HTQ&oe=6AFF1349"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
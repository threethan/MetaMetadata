&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voiSL7_H_BUQ7kNvwEqBAXT&_nc_oc=AdpwuN4pk1dNItdMsLXK-FKCXexpABxTpzZsmCGJphcOG9sv0JEHdOF70-I6X1p4B3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gbzyEY_02Qq14UcIAHzbxE4-OOVJpIKkyMvUWnFBphQ&oe=69DE426A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kElHMdE5QpgQ7kNvwEXIwvZ&_nc_oc=AdoWlbeWzXTKW0ntONJswWglZQH_3_t4rZY14Ehu8zE8-5jqypElyom0Z8BDgdAQsYk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wWVE8Q45v34N8B5cpdohYQmlGHsOPooJt8lyclhVUtw&oe=69DE549E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
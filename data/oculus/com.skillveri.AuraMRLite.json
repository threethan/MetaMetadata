t-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6HBf-1dd0V7nkMxa1XBjd2deSr5hiWZCNaknzdqtvDw&oe=6AFC6D0E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTstwuA2mNQQ7kNvwHqKL4G&_nc_oc=AdoDL7Vqv5h5hDm4C1XY_8glg_6c-s2Bi-AStzJDFIniJJwx50LuNw6_-vWY3Q5JvpY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjvxPxyOrCcyD-NJxdhM2UyB9x47jRQDvZyeelP6FH4w&oe=6AFC891E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8JRB48BE_4Q7kNvwFyJfMP&_nc_oc=AdphQPKZmSZb0hDnWvj1esTQvqXoLUWO3lvds1K6SXKvJMtLh6zz_1qMsrIakBunOvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLUFz00ra4R-hbl_f36-xYnaoyLqQPfKUozUVJyVOCAA&oe=6AFC7522"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMXl0zPN0JYQ7kNvwFVXjyw&_nc_oc=Adr-I2DTXRFzzCOPAAdMCokLNj27CY5ESyXRvkz4FI_DhrJHXa33iTJn9_-CdU9pgD8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEZU1sumNxV3oyhjY33Lj_CgJBj9aNcRVoY8oiIi4ZqQ&oe=6AFC859A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL13i8FKNAcQ7kNvwELZxFR&_nc_oc=AdqaOa8mRrsnHgTliiqajP0UVhgKyf8SeR3SiHh4IoNWYAcl4AlPG5cxlr23RuJjALg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3A5OSogafXr9gXLwb6jofXg79ZMZu1-qu17y4D0zKUg&oe=6AFC7049"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
t-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGQrz2T5M_i7oPgdXHWabJPv_vjGzam9tSq2P3nnrCwA&oe=6B04560E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDNkdPo6wEQ7kNvwEZPOVd&_nc_oc=AdpXH5JEhb8N_yQsrvZP28fA58HTN0OJ7RB7KECv09JTXFPzCQPFAsprdyhchzc9Y5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqaR0l2DjtrPnwshXs2l-_3E4vOlHrHFPFtJ3_MRn5iA&oe=6B04721E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHNWR-cziWkQ7kNvwEa9DVM&_nc_oc=AdoHhIlo1yO2_m6-eC-PZDvWtOunfA63tnh1Uf101SFdZovdd2b3j57pHLliUx6N4Ik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2J8Uh4Frs3tz08CkYkqLJ_KZ9AnaI2pvRTjSwyFYnIw&oe=6B045E22"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21UyLuX6snEQ7kNvwG2q8Bw&_nc_oc=Adr5xVX0zaYw9hXVHf4a8sm6ixSE5Tfat10UrAOAE2rA2NSZNfHMokstaDHCzOR-yEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVDYXRkrs9MlFiThUw524h6bl-WC_-ipt_5W2ZmDttPw&oe=6B046E9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6E_u4NwBpwQ7kNvwGN73kg&_nc_oc=AdpEAwrXz2MZQmAi0EEkWPxfARJSVrhZrPU_u_89WnkMWuCBzmCxrO4Yp50rBktAF4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSjcoM_mFHp975I_e-JiRdccR4dBLBwdUmfG_DKOL9UA&oe=6B045949"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
7kNvwEfDnP8&_nc_oc=AdlQX7LvBbQ0__34znpH7k7WqECVUgXFEEW8LKaa8DRXDZY2bQlhOYxgakNsuRpK98k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxIYd8IfRsWhxw4jGJXnQVUJexr_gRSGWefAEgyrLee3Q&oe=69B806EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_9sVIvmoMQQ7kNvwEHzm5F&_nc_oc=AdmMq308jdCCJzwOZcFDRxUCqeIP9j9afXRv3IlKyWtO0De0Y2MvB1jFFkVH-GUYca0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy1P2yEByTGtNKOQVLtkl36SF9-uipKET-ZuiTUvwuciQ&oe=69B7E0DE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillver
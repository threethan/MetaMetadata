&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyfq3140Q5wQ7kNvwFJdYYx&_nc_oc=AdptBzi-lKJ_6u9FPQ4kfIt5aFY2OSHidXbIjesxO-kC8SPFVRvsHh1vQn3fT7CGQa0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EM78yo1moAG7vWt0ee2dadRIH15k3jCSq04daJLQjzg&oe=69E62B6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOrMjUfnEKIQ7kNvwG1Zyr5&_nc_oc=Adply_vO6MbrxnjzL-eO5AGLIom9cNkL4MukWpj16pBYH8blN5Sm_ozOlC4g6a0Z4Zo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0APcryHliLxYiBGTXtWd9WDiy2LI8-C_XwfRJI-Wjk_w&oe=69E63D9E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
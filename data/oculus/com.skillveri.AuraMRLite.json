&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GALkzjs7WEQ7kNvwHuYzrR&_nc_oc=Adp39NDV-i4Ry7n2BUXHmG0ErY_ofbLTe4EX_OeHcE7N_Q0LPZs5SoU1xp7Tam7-Pbk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw06vwt44wsbhuQRmn2v4Xlv8Z91heq7YLbxjkHzmuWsQ&oe=69C6876A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=424eu3TJywQQ7kNvwGqg2QY&_nc_oc=AdoL5lXKaRzB6og5HiDEDDdrNMw6X1_sg_dHWMc9YoxWpTEL_XeQHmB5ncKuJ1Mowv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_f8towAonqD8uUBqHu1Z1vRqluAqVu_GkbGyUZ7ZRaA&oe=69C6999E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
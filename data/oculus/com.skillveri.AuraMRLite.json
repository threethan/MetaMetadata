&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIjJKTOXguwQ7kNvwHMgb05&_nc_oc=AdrZwJBtMfmQRYLyzzGse8b8o-uUibA1cuJbElHzKYChZewlQFjLEYRUSHPwsRnIxVs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3khCcAVesmxS_2Yhc6YM5cwfOzgdLmT7Ie0Rq9AB5aWA&oe=69DA4DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6jopMhqHWsQ7kNvwEaOojm&_nc_oc=AdraMmevdg6GqG4xcw4EsqDjUnzBwoAYPftNErOQG-n4J9v_tI2wuTZhvZkVwr6OIhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QTS82jTF8NPG4gftOW2GqXIZZ1EFDNVxc8UHu1hDZqA&oe=69DA601E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
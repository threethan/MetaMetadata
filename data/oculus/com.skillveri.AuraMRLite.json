&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMrUmLZBN-AQ7kNvwEq14Ba&_nc_oc=AdpZF4jPzSLWdu0SCr2WOfOT6KusoZCU0II1QpP9uphVFH3mLZOEV-tWLAFFmsisv3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3p0VoFxfF5LvDLs5UiIxsQaFbJsPxqbV8bZNJ5VSkR3w&oe=69D8FC6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6jopMhqHWsQ7kNvwEMAoY5&_nc_oc=Adq5mRK0PsE56rH7v3-2RbalhHrsjkHLLMbw2U0UnaHEMfkh_OWeJlVcruloFsRQqaE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16kdk6Dpd99e76HZSC-UMHtDgkmILdUQcDCIG0IKB6Nw&oe=69D90E9E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
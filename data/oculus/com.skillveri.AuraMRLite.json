&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQ_rFjDnfYQ7kNvwHIPpoW&_nc_oc=AdpRjkf-lSvGFHtNP3SJa1PHuIDX1D96mCCJQlF2cGSeVPiW70xi4chTkYJKzyyNVXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EjDaNZwmyZMHrT89Zh4bLcS7hjYP3SkqIcFLK2y5N9A&oe=69E4D9EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOrMjUfnEKIQ7kNvwFxSiVm&_nc_oc=AdoeabSK5rl3YPFj3dhmEpsLHz5cWAhfRvn3MA3KOAdDsqz9sQ1jamGtOnr3lvNI8gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tIUBQGVtK4BZqc96tvK2Rg-TQwR37lP9cjzQmB-ovaQ&oe=69E4EC1E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
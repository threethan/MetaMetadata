l": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR_J1Q4oJIcQ7kNvwF8B6Tz&_nc_oc=AdrUgAFif5RWtAKbA6u5H5tEpR0Yv6D3WEGXhugNQPNoyvsIgmNEq4nnv7Qj-E3z6PY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6Qlptm7vO4CImK9dddJrtgAO7qnfcKI8Z9sF67aqchg&oe=6A25859E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": [], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_sub
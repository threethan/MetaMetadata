&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oAxUvVBPWYQ7kNvwFmPf99&_nc_oc=AdqvJxqIm2mroMHqiPwdOkL9ubjC_skUG4phx_OE9Syh31Do6lwwejY7a7ykalN-FK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LA81SEsgM_AlPvDcCYA8Hk4Zo3SCIV39fcCC-D0EJSg&oe=69D507EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGhiFbtI3BYQ7kNvwH68LVV&_nc_oc=Adqu8SpJBHkjGBtfA_L9r7icTJnKZ2w7S9KQMbpEywCpzKuTSTulWwcRtdYTH5_P63c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-7yHN-D5Aj83IBdb3vrn7ImuHLGEDdYiX_GL-5ZaFLQ&oe=69D4E1DE"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
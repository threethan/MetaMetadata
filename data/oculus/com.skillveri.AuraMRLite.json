&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBQp5u7JdKsQ7kNvwHQx9_l&_nc_oc=AdqWrD3hOz_hcQMPFqUiEmGr_4oyW-5rycWjBVi3FRplZqntKu5UOH4PMhDiw5ApYYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vDSsJdt0OuTCr89EUz83Y_dDW-1b4na-Jq7LAtIb_Lw&oe=69EB716A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdweH6lhhScQ7kNvwFkQBm-&_nc_oc=Adr5CIi6ydvWU36nuO-wmwaRDfZd5wLh03ou3iQp4sn3sfUPwbIY33HQX_2yvjQIxqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BDF4JIUhPpyfkLLOkkRvKAk-nRX2MaCGL6JGNUlG2BA&oe=69EB839E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
t-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbiTMoJAuLGVuWklJbn-xMEde5HKXyUlkOMMwG2Ph_Kw&oe=6B084A8E"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDNkdPo6wEQ7kNvwEFA3-6&_nc_oc=AdoAdLpEbgSdUMr1LDpk9_S_2kYK1RjOYxYm6Sk_iXLSBicEnRUkT9jXbsO1D-4k2Rg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuruAJhiFl8OpFYh60brkqatJ2gMpVhM7Qkk5GSLrFgA&oe=6B08669E"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPz94T8edokQ7kNvwExSnDj&_nc_oc=AdoNcZqH95marUC24x3WSrTyqtNYZDTrpxmZisED_bEBR1WUObvOlaekjWB_6Mdu510&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgB9_Lk1pZQut7H2SlNjymWdxKWAorgsZLfz7FtXaIdw&oe=6B0852A2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEd-u6bC6AIQ7kNvwEfkXp4&_nc_oc=AdpX0eo7_xRiSySF2BGWJsxvEE8PDnqkCOozgjpFeoUk90_i3O0egg7KFe9G-hQ_K2c&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL1B0nTDa0TOB7Vxo8fvnq8fEdH0aYSGMOiya5UUwQOg&oe=6B08631A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdBANWL0pHoQ7kNvwEOXTF7&_nc_oc=Adqy-NftDhhvI2VJ2d0vvLvUYV9kjLrvU_Jv4gIEGC6ys9BYjd1Qc7hGQ6JpcD5HZtA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuDLjrVSNwgLZeCKkOGgWtX8Tcf-LjOOvf8RwRo_1NJQ&oe=6B084DC9"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
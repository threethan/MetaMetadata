&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqQ_rFjDnfYQ7kNvwF0JBM4&_nc_oc=AdqaMcXofWQUVca-jYsyR1PkjW-1FGvmHHULIKPt6A3zJQogPfEHcaAd-w-EDto9vA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AYPb8fwB8R_Uxm5WUCwr6I62QrR_dGix7pZT8Cb1K7Q&oe=69E3886A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOrMjUfnEKIQ7kNvwGQPNgT&_nc_oc=AdqoGfH-8GqCvXCc24EyYo15BU6UJJGo5KrVUhR87j5QPZvVlfB0XHRxbfS7mEtzMjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0np_rd7DF3Jroq5eDxVPuy-kJ2jCKQcoEC7Sqa0j1TBg&oe=69E39A9E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
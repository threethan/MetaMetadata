t-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTMdzbFGbG-3WQuf_6aKzzrN-b0zInSVFvg-oX6FbZMwg&oe=6B0B25CE"}, {"file_name": "pers 3.png", "id": "913651887773077", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623295_913651891106410_5857985654676811479_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5ViM1PWUEMQ7kNvwEgwPyN&_nc_oc=Adr8ZOex1o4kbhr1hRpWHcOScUa_bc4Pgri0TGkjTP5ETvBlLQEHaApv7KVXmK4Cxgo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSa2jw90UC5fzy_QgJq062ThilGH9W_Bq3QkgzFBYZDFQ&oe=6B0B41DE"}, {"file_name": "aura lite 2g weld plate.png", "id": "2520724365082647", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499625099_2520724368415980_4234263253734256654_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk979Kf1mxQQ7kNvwEMz1sc&_nc_oc=Adp6QlpdIoQmMeu4ItPF0aS8VxVX0EB2rviLoByPV7l_oFQKaFdbOEpPDtp_yNP7cCE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTICwGH-xPLdhKl5GRnXwT7iaNHcXq4HB7UKOqrEE8QbQ&oe=6B0B2DE2"}, {"file_name": "aura lite but and 2g.png", "id": "2064865947571184", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619187_2064865950904517_6077889872201537118_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XZoV_TQLmoQ7kNvwFftRBY&_nc_oc=AdpZESpp8EphT0c8Ndan7EA90fjC4KjTUHwlNefsWVIIV1ywYd0XAtry9vYqVeePeZ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4i5zz6rNgz_ZpVFOHfLeayzoXVu0SKUgmBYUDnXqlcg&oe=6B0B3E5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "welding personal thumbnail.png", "id": "1052863647103241", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619113_1052863650436574_689909000938282082_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmnbNAI1C8IQ7kNvwF2KJ5v&_nc_oc=Ado8gijIIcx0y4z0ap1eowrFg6A-eH8sv_n53u-lo5yLx8EHU37DiMUd_4uqJhqYEQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3ZyVQ_wGcQW8Axgx7-PW8x8EuWa9uQxczeDhgqursnQ&oe=6B0B2909"}, "display_name": "Skillveri Welding Simulator-Personal Use", "keywords": ["Welding", "Skillveri", "Simulator", "VR", "CTE"], "long_description": "The welding simulator trusted by global industries, schools, and colleges is now yours to try at home!\n\nPractice GMAW/MIG welding safely with highly realistic sounds and sparks. Visual on-screen feedback guides you to correct your speed, distance and angle.\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nWeld as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri simulators are used across 100+ schools and colleges across the USA in their CTE programs.", "short_description": "Master MIG Welding in immersive VR with no risk, no wastage. The welding simulator trusted by industries and institutions globally is now yours to try!\n\nThis Personal Use Edition contains GMAW/MIG Welding with:\n- Butt joint in 2G\n- T joint in 2F\n- Mild steel\n- 3.2mm thickness\n- Multiple difficulty levels\n- Performance analysis with Detailed scorecard\n\nFor our fully-loaded Enterprise version, perfect for schools, training institutions, and industries, write to usa@skillveri.com."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
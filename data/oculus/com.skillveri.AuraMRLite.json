&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcdsQVHeLF4Q7kNvwHn6SBz&_nc_oc=AdoPHctH9NCwsD7kKjGDpQDVWxy59F47gDmmOoyBiXNynpultaDjY1OA7JBB7gOTAIs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg_rOtz7TpIFJNDcwYeKa1n726vRDfDJQNVpaJlz2R1Q&oe=69CBCD6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lite.png", "id": "488641690876402", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974570_488641694209735_5817461652717182570_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZX_qmaEm0QQ7kNvwGMFJEd&_nc_oc=Adrlw2AP2hoYaGWIPc6ico2XLnGoEiPCKuLTZZEA5ecjZBsjMbEaWw6BogMa4sg-jXk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9wg56PD7nKqMbNl6LNIOIEjj_NFG3j3CMcNSZ6UaeNA&oe=69CBDF9E"}, "display_name": "Skillveri Aura MR Lite Welding Simulator", "keywords": ["Aura", "MR", "Lite", "Welding", "Skillveri"], "long_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 1/8 inches thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com ", "short_description": "The welding simulator trusted by industries, schools, and colleges is now yours to try ! Perform GMAW welding with Butt joint in 2G & T joint in 2F, on mild steel at 3.2mm thickness. Progress through multiple difficulty levels and get your performance analysed with a \tdetailed scorecard. Please note that this is the Lite version of our simulator. If you want your school or organization to buy our fully loaded, feature-rich Pro version, write to us at sales@skillveri.com"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/aura-lite-privacy-policy", "developer_term
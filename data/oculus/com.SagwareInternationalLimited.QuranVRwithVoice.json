/v/t64.5771-25/38982453_3658692497709321_4891685768215867093_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdVfW6Pj5osQ7kNvwHPjmJM&_nc_oc=AdoeCFMgcLM4cH_KVLlIpw2Hl-Ddsi7H1wgbV2dISgp23JqM9Hugdr25OlMiE5RQP9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU1MW1fQ1vIdo1txo12PvA5rpyGD5qyMvGUQ_uD9I-bg&oe=6AFDB379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "904464704380159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974777_904464711046825_8047630676978903032_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWtMMv_nQ9UQ7kNvwE98Lot&_nc_oc=Adq2axE99jPYyxiprwetLRt9lLujj62zE1xM6jdT4nBkP2_G6A7uG_8JdxJTz3no5FI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Ek8zTLwkb7G73MhWbdqTex66aMuXYvRgq5Td9UZkwQ&oe=6AFDBD25"}, "display_name": "Quran in VR with Audio Reading", "keywords": [], "long_description": "Step into a groundbreaking Quranic experience with our VR app on Oculus! Embrace the timeless ritual of page-flipping, seamlessly navigate Surahs, physical-like paging, and bookmark pages for a personalized journey. Tailor your exploration with number-based page navigation and zoom features. Connect intimately with the text using hand-tracking and intelligent face following. Enjoy adjustable screens and user-friendly navigation suitable for learners and experts. Immerse yourself further with a mixed-reality tea table, creating a serene backdrop for your spiritual quest. Elevate your Holy Quran exploration today, uniting tradition with cutting-edge technology. Download now on Oculus for an immersive and accessible experience.", "short_description": "Immerse yourself in the divine with our Quran VR app on Oculus! Experience the charm of flipping pages, physical-like Quran, navigate chapters effortlessly, and bookmark pages. With intuitive features like number-based page navigation, zoom, hand-tracking, and intelligent face following, our app caters to learners and experts. Enjoy an adjustable screen, user-friendly navigation, and a unique mixed-reality tea table experience. Elevate your Quranic journey today!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1uiqAos4XAVJvlZD6rnZGk8BLKvNqdp8OYZEzLMnHfJU/edit?usp=drive_link", "developer_terms_of_service_url": null, "publisher_name": "Sagware International Limited", "support_website_url": "https://forms.gle/T2idxmX1QeQRRh8y7", "website_url": "https://sagwarestore.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "arq"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7254569071275783"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2155071481560864"}, {"status": "PUBLISHED", "id": "3377083235916851"}]}, "baseline_offer": {"id": "2155071481560864"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729944480, "status": "PUBLISHED", "id": "2155071481560864"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7254561737943183", "version": "0.3"}, "id": "757012569605914", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
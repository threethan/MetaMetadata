=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2wC0vFKLORwJhkoQ2OSp5g5RnJ8ah6_EJsJYD8PeAPQ&oe=6AE1F92F"}, {"file_name": "migrated_image.png", "id": "218373562608627", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001722_386935278552194_88665407937839104_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skdxyFEhSVQQ7kNvwEICb-u&_nc_oc=AdrGOqvIacgBGD2aJyIPSTSrBs69o5azWljnkP2rw9a3-VnpWjJ4SstGYj_VLm-Uz7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGNtAWW1GwwI3aEuFowjswVMIv6uFZYZEbBMKrAPRr8g&oe=6AE2070E"}, {"file_name": "migrated_image.png", "id": "158529695311092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974664_291927611485707_8703178087728152576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUMB0N-50dwQ7kNvwGopZl_&_nc_oc=AdrpbczeKJJrthy10Q50S6dpUvD4iGS8VX5r005Mh0N6eSzk2aaggF6VrbdkumEpDRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwfJ7AFsxIIwcKSSYoUsOSVWDLmnBBiKhGGpOtKmaX3w&oe=6AE1F330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/n8EZl3", "id": "261451988136010", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_261451991469343_7252665102409662464_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD9aaRrVgcgQ7kNvwFcW-Rt&_nc_oc=AdqFc2bS3Dald_gGDaMUjb1zbvUL_vzzV6LxSLwncareppBjO2W5sUKNCfMCcei-BPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkK9CYg1xZhDDMIb1NWLXSwWDFhSUytHGpkoAPtbgaGg&oe=6AE1EF7E"}, "display_name": "Pirate Monkey Run!", "keywords": ["runner", "infinite", "monkeys", "bananas"], "long_description": "Help Jake and Jade, everyone's favorite Pirate Monkeys, collect Bananas and Coconuts. Race along the path grabbing valuable bananas while avoiding obstacles. Jump over flower pots and skulls. Roll under flower stands and boat stands. Avoid charging pigs and bouncing beach balls. Watch out for crate stacks, rocks, and more.\n\nFind power-ups along the way. Grab a tasty pineapple for invincibility! A Banana Magnet attracts Bananas from any lane. Score multipliers increase your score quickly for a high score.\n\n* Go nuts with Missions to collect extra Coconuts.\n\n* Jake and Jade for the first time in 3D!\n\n* Use Bananas and Coconuts to unlock the Beach and Jungle areas.\n\n* Get a High Score in each area.\n\n* Stand or Sit to play. No walking or turning required.", "short_description": "Help Jake and Jade to collect bananas and coconuts."}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "http://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "http://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", "website_url": "http://vr.sgngames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1064943334067462"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2939797599394377", "version": "1.0"}, "id": "367063180794570", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2912001178840686", "is_concept": false, "latest_released_binary": {"__typename"
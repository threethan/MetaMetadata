4iHLpsz-M8Q7kNvwHN41Uh&_nc_oc=Adrd0LOG26oocfnEoNsGQvBvg5dIqIORPxvFE8DdYCJVc-LK1j9Wj_QzV7Dqg2dhJOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTanS0sQxftI8kWl-gSNdqZUEohAkPoaaZxdSVbxbeZQ&oe=6B05C3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/n8EZl3", "id": "261451988136010", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974798_261451991469343_7252665102409662464_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UqSpriEVz4Q7kNvwFnZgun&_nc_oc=AdpHDvYkXjk8JCLrmqRgEDl5ZA3AfTF8OYpwg7hku1ntuld5tMobho2Q4KWV_V_ftgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9jp2PTjBTjdWE2UDnx0ltQgAMO89cJcJWYPR6G1skPA&oe=6B05C03E"}, "display_name": "Pirate Monkey Run!", "keywords": ["runner", "infinite", "monkeys", "bananas"], "long_description": "Help Jake and Jade, everyone's favorite Pirate Monkeys, collect Bananas and Coconuts. Race along the path grabbing valuable bananas while avoiding obstacles. Jump over flower pots and skulls. Roll under flower stands and boat stands. Avoid charging pigs and bouncing beach balls. Watch out for crate stacks, rocks, and more.\n\nFind power-ups along the way. Grab a tasty pineapple for invincibility! A Banana Magnet attracts Bananas from any lane. Score multipliers increase your score quickly for a high score.\n\n* Go nuts with Missions to collect extra Coconuts.\n\n* Jake and Jade for the first time in 3D!\n\n* Use Bananas and Coconuts to unlock the Beach and Jungle areas.\n\n* Get a High Score in each area.\n\n* Stand or Sit to play. No walking or turning required.", "short_description": "Help Jake and Jade to collect bananas and coconuts."}]}, "developer_name": "Star Gaming Network", "developer_privacy_policy_url": "http://sgngames.com/privacypolicy.php", "developer_terms_of_service_url": "http://sgngames.com/termsofservice.php", "publisher_name": "Star Gaming Network", "support_website_url": "https://sgngames.com/contactus.php", 
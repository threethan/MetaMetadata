Md7bwBQgP_SdxcXVhFCOhAA&oe=6A73432E"}, {"file_name": "SC_4_English.png", "id": "2165048281095658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619681_2165048287762324_3348894881252724550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=On_CTgzX1UAQ7kNvwGR0UL_&_nc_oc=Adr3_xX7JHI_awtuZds9jXImtr1m-cps6kSRbkA9IDeC9Wvg9zs73DmqvsI98jfK3ds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Q9bMbQuLwhTKvMLf6HdXQgCUc4F8QFNUpnmwKH3EsA&oe=6A7348EB"}, {"file_name": "SC_5_English.png", "id": "1024967623357160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619836_1024967626690493_3385358542487582225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcwZ9oJBe2UQ7kNvwHubcjy&_nc_oc=AdrC1nwrlI26NnblK-88EuqdgLrqzpr0w4cveI25NRSm7pfaK8UzAFVbfz5Xikx3ttI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNTBqW_RCPCup_4U-eO61Y_F_cNaXiSzvCFPVAgrzlMg&oe=6A734AE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iLauncher", "keywords": [], "long_description": "iLauncher is a simple VR app launcher that provides a dedicated 3D launch environment for browsing and opening installed apps.\n\nUsers can view all installed apps in one place, and iLauncher can also create a dedicated company app page based on user-provided company information. This makes it useful for enterprise showcases, education, training, medical demonstrations, exhibitions, and multi-app VR projects.\n\nThe current version supports app browsing, app launching, a company app page, app uninstalling, and system time adjustment. iLauncher is focused on providing a clean, stable, and easy-to-use entry point for VR content.\n\nKey Features\n\n\ud83c\udf10 Immersive 3D Launcher Space\nBrowse and launch apps inside a dedicated 3D environment.\n\n\ud83d\udcf1 All Installed Apps in One Place\nView all installed apps in one organized place.\n\n\ud83c\udfe2 Company App Page\nCreate a dedicated page for company-related apps based on user-provided company information.\n\n\ud83e\udde9 App Management\nUninstall apps directly from the launcher interface.\n\n\ud83d\udd52 System Time Adjustment\nAdjust system time for managed devices, offline demos, training setups, or fixed-use environments.", "short_description": "iLauncher is a simple VR app launcher that provides an immersive 3D launch space, displays installed apps, and creates a dedicated company app page based on user-provided company information. It is designed for demos, education, training, enterprise showcases, and organized VR content access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/iLauncher_privacy__for_meta", "developer_terms_of_service_url": null, "publisher_name": "Suzhou Dejevis Digital Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.dejevis.com/filedownload/3032172", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1127814500423510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1911700103542361_4466092605481042163_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AVOZfi9_9IQ7kNvwH_2VxY&_nc_oc=Adoah-m6bDu_CYlMf63uIEmKTPWdhkktkjQ5VtRrkSXQsvgcGMBvXnNP5PXueHYIQJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHq_kZw1Es03
: "SC_3_English.png", "id": "1051545537319247", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499625099_1051545540652580_4736013000252741929_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7pdFzap6k0Q7kNvwGdM3cD&_nc_oc=AdpIl6SyklzrlFU5sBQoU0O2YyHQZmLShtOk3QHh3KOXwx7pzDO_9s4phCThQlA6OuE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-awd9pA2k3iIY3m834OyG-1HZZzAtEPmOpqNcbV1zLpA&oe=6A3A92AE"}, {"file_name": "SC_4_English.png", "id": "2165048281095658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619681_2165048287762324_3348894881252724550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyHrkZcGwEIQ7kNvwFHP0Y7&_nc_oc=AdrKEikbEuRWGNBWGDmcld8D24tjmbYWOOtc1Ev1wwgMUbFjNeWFa0mE5a8xuHm5hJo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AvNR5djFVXY8jeQxmCtl11e5gdyV7zCc1Sh7Tlnb1Ig&oe=6A3A986B"}, {"file_name": "SC_5_English.png", "id": "1024967623357160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619836_1024967626690493_3385358542487582225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf5qXkW3xLYQ7kNvwFklrxp&_nc_oc=AdqYNhlkl25XQu637ng5ETLKNr4sZpH6V4FnPNUKuZxx9ljj4SXswLJjQn4xTNW2K3o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--4sXuHpKbRqnhHlxyw_hkg_C5t1vDTD9b3QDAB4VUGg&oe=6A3A9A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iLauncher", "keywords": [], "long_description": "iLauncher is a simple VR app launcher that provides a dedicated 3D launch environment for browsing and opening installed apps.\n\nUsers can view all installed apps in one place, and iLauncher can also create a dedicated company app page based on user-provided company information. This makes it useful for enterprise showcases, education, training, medical demonstrations, exhibitions, and multi-app VR projects.\n\nThe current version supports app browsing, app launching, a company app page, app uninstalling, and system time adjustment. iLauncher is focused on providing a clean, stable, and easy-to-use entry point for VR content.\n\nKey Features\n\n\ud83c\udf10 Immersive 3D Launcher Space\nBrowse and launch apps inside a dedicated 3D environment.\n\n\ud83d\udcf1 All Installed Apps in One Place\nView all installed apps in one organized place.\n\n\ud83c\udfe2 Company App Page\nCreate a dedicated page for company-related apps based on user-provided company information.\n\n\ud83e\udde9 App Management\nUninstall apps directly from the launcher interface.\n\n\ud83d\udd52 System Time Adjustment\nAdjust system time for managed devices, offline demos, training setups, or fixed-use environments.", "short_description": "iLauncher is a simple VR app launcher that provides an immersive 3D launch space, displays installed apps, and creates a dedicated company app page based on user-provided company information. It is designed for demos, education, training, enterprise showcases, and organized VR content access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/iLauncher_privacy__for_meta", "developer_terms_of_service_url": null, "publisher_name": "Suzhou Dejevis Digital Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.dejevis.com/filedownload/3032172", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1093222273882733"}, "review_mess
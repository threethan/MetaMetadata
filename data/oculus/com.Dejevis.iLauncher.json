{"file_name": "SC_3_English.png", "id": "1051545537319247", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499625099_1051545540652580_4736013000252741929_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMMq_eIgbKAQ7kNvwGbtDPQ&_nc_oc=Adpy4LDV4agmI2oC3xgK91F-xgjC0Rom7ar7xRRX6f_bB5IqsS-BLuOINFu0ZFpm4Zg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VbS8wDoUAvY4nYM4CazYI6vE65787uGhpmOexhBsZtA&oe=6A46702E"}, {"file_name": "SC_4_English.png", "id": "2165048281095658", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619681_2165048287762324_3348894881252724550_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcSnpnoi3fgQ7kNvwEO1l0S&_nc_oc=AdpC_qsCb9Myzk5PoGE4vacAfOTpU__TwteTxUAipwr7cqFIXkvzEK30YDHUsuoYLV8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VBvhQ837GtMKY21MhZ7cQcP75IJZ1e63wlCefRe3J7Q&oe=6A4675EB"}, {"file_name": "SC_5_English.png", "id": "1024967623357160", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619836_1024967626690493_3385358542487582225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7EJhJv4SqMQ7kNvwHJ00HI&_nc_oc=AdqvE--48Xt_sZtXA-9e3fQjqTtyCUktY5I-lwx7GyUCR1lhBZWPNA4h7XlViXLrfkA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ctnhePeHACGCBdWiT1SWTXuEAdrFMan0rtOVXApFYXw&oe=6A4677E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iLauncher", "keywords": [], "long_description": "iLauncher is a simple VR app launcher that provides a dedicated 3D launch environment for browsing and opening installed apps.\n\nUsers can view all installed apps in one place, and iLauncher can also create a dedicated company app page based on user-provided company information. This makes it useful for enterprise showcases, education, training, medical demonstrations, exhibitions, and multi-app VR projects.\n\nThe current version supports app browsing, app launching, a company app page, app uninstalling, and system time adjustment. iLauncher is focused on providing a clean, stable, and easy-to-use entry point for VR content.\n\nKey Features\n\n\ud83c\udf10 Immersive 3D Launcher Space\nBrowse and launch apps inside a dedicated 3D environment.\n\n\ud83d\udcf1 All Installed Apps in One Place\nView all installed apps in one organized place.\n\n\ud83c\udfe2 Company App Page\nCreate a dedicated page for company-related apps based on user-provided company information.\n\n\ud83e\udde9 App Management\nUninstall apps directly from the launcher interface.\n\n\ud83d\udd52 System Time Adjustment\nAdjust system time for managed devices, offline demos, training setups, or fixed-use environments.", "short_description": "iLauncher is a simple VR app launcher that provides an immersive 3D launch space, displays installed apps, and creates a dedicated company app page based on user-provided company information. It is designed for demos, education, training, enterprise showcases, and organized VR content access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/iLauncher_privacy__for_meta", "developer_terms_of_service_url": null, "publisher_name": "Suzhou Dejevis Digital Technology Co., Ltd.", "support_website_url": null, "website_url": "https://www.dejevis.com/filedownload/3032172", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1093222273882733"}
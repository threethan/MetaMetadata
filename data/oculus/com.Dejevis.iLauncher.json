&_nc_oc=Adr6RynDgpNUuUsLwDmyrogsY9ODPCw7Z2j6wqDmAogqnHs5IfiSiMR-nbTD4uflE_A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOgDVt8uQCdkAEV5W8RicrBEwULHmQBjWTty--kNSpKg&oe=6AA416A7"}, {"file_name": "SC_4_Chinese.png", "id": "1221468633303035", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619677_1221468636636368_2171555271229200968_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0T9wJzKmSkQ7kNvwEbqQcj&_nc_oc=Adrmbsr6iN-KDJWryFszfBt1tJAxl5F84Sgv6YIDFs7-IpLqw1nBTbrXpufrKjagVOo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLicGKoFKOIE0pkHoVIbqT10yFMmCIh-u6nZ24RKis09Q&oe=6AA40A39"}, {"file_name": "SC_5_Chinese.png", "id": "997235706335205", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499623345_997235709668538_546587710896310883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wj69m6F-ac4Q7kNvwFA6ccF&_nc_oc=AdoqwxZhxwzlj3rz2pLgbDCY9fN6y_Omjpq2QsmfJF6fO7nxvmdW-_HcevbL9FshDyw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZR3GjDwH0Ar6PlUIw5cCTUav9ETqXb9XgfvN5bvx1_A&oe=6AA4140D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iLauncher", "keywords": [], "long_description": "iLauncher \u4e3a VR \u7528\u6237\u63d0\u4f9b\u4e00\u4e2a\u7b80\u6d01\u3001\u76f4\u89c2\u7684 3D \u5e94\u7528\u542f\u52a8\u7a7a\u95f4\u3002\u8fdb\u5165 iLauncher \u540e\uff0c\u7528\u6237\u53ef\u4ee5\u5728\u4e13\u5c5e 3D \u573a\u666f\u4e2d\u6d4f\u89c8\u672c\u673a\u5df2\u5b89\u88c5\u7684\u5e94\u7528\uff0c\u5e76\u5feb\u901f\u542f\u52a8\u6240\u9700\u5185\u5bb9\u3002\n\n\u9664\u4e86\u901a\u7528\u5e94\u7528\u5217\u8868\uff0ciLauncher \u8fd8\u652f\u6301\u6839\u636e\u7528\u6237\u8f93\u5165\u7684\u516c\u53f8\u4fe1\u606f\uff0c\u751f\u6210\u4e13\u5c5e\u7684\u516c\u53f8\u5e94\u7528\u9875\u9762\uff0c\u7528\u4e8e\u96c6\u4e2d\u5c55\u793a\u672c\u516c\u53f8\u76f8\u5173\u5e94\u7528\u3002\u5bf9\u4e8e\u4f01\u4e1a\u5c55\u793a\u3001\u6559\u80b2\u79d1\u666e\u3001\u533b\u7597\u6f14\u793a\u3001\u57f9\u8bad\u7cfb\u7edf\u6216\u5c55\u4f1a\u73b0\u573a\u7b49\u573a\u666f\uff0c\u8fd9\u53ef\u4ee5\u8ba9\u7528\u6237\u66f4\u5feb\u627e\u5230\u76ee\u6807\u5185\u5bb9\uff0c\u51cf\u5c11\u64cd\u4f5c\u6b65\u9aa4\uff0c\u8ba9\u4f53\u9a8c\u66f4\u52a0\u6e05\u6670\u3002\n\n\u5f53\u524d\u7248\u672c\u4e13\u6ce8\u4e8e\u57fa\u7840\u4f46\u5b9e\u7528\u7684\u542f\u52a8\u4e0e\u7ba1\u7406\u529f\u80fd\uff0c\u5305\u62ec\u5e94\u7528\u663e\u793a\u3001\u5e94\u7528\u542f\u52a8\u3001\u516c\u53f8\u5e94\u7528\u9875\u3001\u5e94\u7528\u5378\u8f7d\u4ee5\u53ca\u7cfb\u7edf\u65f6\u95f4\u8c03\u6574\u3002\n\n\u6838\u5fc3\u529f\u80fd\n\ud83c\udf10\u6c89\u6d78\u5f0f 3D \u542f\u52a8\u7a7a\u95f4\n\n\u8fdb\u5165 iLauncher \u540e\uff0c\u7528\u6237\u4f1a\u770b\u5230\u4e00\u4e2a\u72ec\u7acb\u7684 3D \u542f\u52a8\u573a\u666f\uff0c\u5728\u6c89\u6d78\u5f0f\u7a7a\u95f4\u4e2d\u6d4f\u89c8\u548c\u542f\u52a8\u5e94\u7528\u3002\n\n\u2728\u672c\u673a\u5e94\u7528\u96c6\u4e2d\u663e\u793a\n\n\u81ea\u52a8\u663e\u793a\u672c\u673a\u5df2\u5b89\u88c5\u7684\u6240\u6709\u5e94\u7528\uff0c\u65b9\u4fbf\u7528\u6237\u96c6\u4e2d\u67e5\u770b\u548c\u5feb\u901f\u542f\u52a8\u3002\n\n\ud83c\udfe2 \u516c\u53f8\u4e13\u5c5e\u5e94\u7528\u9875\n\n\u6839\u636e\u7528\u6237\u8f93\u5165\u7684\u516c\u53f8\u4fe1\u606f\uff0ciLauncher \u53ef\u63d0\u4f9b\u4e13\u95e8\u7684\u516c\u53f8\u5e94\u7528\u9875\u9762\uff0c\u96c6\u4e2d\u663e\u793a\u672c\u516c\u53f8\u7684\u5e94\u7528\u5185\u5bb9\u3002\u9002\u5408\u4f01\u4e1a\u5c55\u793a\u3001\u6559\u80b2\u57f9\u8bad\u3001\u533b\u9662\u79d1\u666e\u3001\u4ea7\u54c1\u6f14\u793a\u548c\u5c55\u4f1a\u4f7f\u7528\u3002\n\n\ud83e\udde9 \u5e94\u7528\u7ba1\u7406\n\n\u652f\u6301\u5728\u5e94\u7528\u5217\u8868\u4e2d\u8fdb\u884c\u57fa\u7840\u7ba1\u7406\u64cd\u4f5c\uff0c\u5305\u62ec\u5378\u8f7d\u5e94\u7528\u3002\n\n\ud83d\udd52 \u7cfb\u7edf\u65f6\u95f4\u8c03\u6574\n\n\u652f\u6301\u8c03\u6574\u7cfb\u7edf\u65f6\u95f4\uff0c\u9002\u5408\u90e8\u5206\u79bb\u7ebf\u5c55\u793a\u3001\u6295\u5c4f\u57f9\u8bad\u6216\u56fa\u5b9a\u573a\u666f\u8bbe\u5907\u7ba1\u7406\u9700\u6c42\u3002\n\n\u9002\u7528\u573a\u666f\n\niLauncher \u9002\u7528\u4e8e\uff1a\n\n\u4f01\u4e1a VR \u5185\u5bb9\u5c55\u793a\n\u6559\u80b2\u548c\u57f9\u8bad\u5e94\u7528\u5165\u53e3\n\u533b\u7597\u79d1\u666e\u548c\u533b\u9662\u6f14\u793a\n\u5c55\u4f1a\u3001\u4f53\u9a8c\u533a\u548c\u95e8\u5e97\u5c55\u793a\n\u591a\u5e94\u7528 VR \u9879\u76ee\u7ba1\u7406\n\u56fa\u5b9a\u5185\u5bb9\u4f53\u9a8c\u8bbe\u5907\n\n\niLauncher \u4e0d\u8ffd\u6c42\u590d\u6742\u529f\u80fd\uff0c\u800c\u662f\u4e13\u6ce8\u4e8e\u63d0\u4f9b\u4e00\u4e2a\u6e05\u6670\u3001\u7a33\u5b9a\u3001\u6613\u7528\u7684 VR \u5e94\u7528\u5165\u53e3\u3002\u5bf9\u4e8e\u9700\u8981\u96c6\u4e2d\u5c55\u793a\u591a\u6b3e VR \u5e94\u7528\u7684\u573a\u666f\uff0c\u5b83\u53ef\u4ee5\u8ba9\u7528\u6237\u66f4\u5feb\u8fdb\u5165\u5185\u5bb9\uff0c\u8ba9\u7ba1\u7406\u8005\u66f4\u5bb9\u6613\u7ec4\u7ec7\u5e94\u7528\u3002", "short_description": "iLauncher \u662f\u4e00\u6b3e\u7b80\u6d01\u7684 VR \u5e94\u7528\u542f\u52a8\u5668\uff0c\u4e3a\u7528\u6237\u63d0\u4f9b\u72ec\u7acb\u7684 3D \u542f\u52a8\u573a\u666f\uff0c\u53ef\u663e\u793a\u672c\u673a\u5df2\u5b89\u88c5\u5e94\u7528\uff0c\u5e76\u652f\u6301\u6839\u636e\u516c\u53f8\u4fe1\u606f\u751f\u6210\u4e13\u5c5e\u4f01\u4e1a\u5e94\u7528\u9875\uff0c\u65b9\u4fbf\u4f01\u4e1a\u5c55\u793a\u3001\u6559\u80b2\u57f9\u8bad\u3001\u5c55\u4f1a\u4f53\u9a8c\u548c\u591a\u5e94\u7528\u5185\u5bb9\u7ba1\u7406\u3002"}, {"images": {"nodes": [{"file_name": "iLauncher_start2_2k_cube.png", "id": "1911700100209028", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619588_1911700103542361_4466092605481042163_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4c86Ghyd9MQ7kNvwHniLJO&_nc_oc=AdqHstA4U1ZwiOg5VwjT6GXJ_Fir9rlDvNAw0rvcIEWHQxDK5p665Zhs-9kUwWGJLys&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8uI3O1Z1GU5Y0u9bskVUyZBM0kMAL3f-JAkAvHb9hew&oe=6AA3F4A3"}, {"file_name": "iLauncher_start2_2k_hm.png", "id": "1896569134364126", "image_type": "APP_IMG
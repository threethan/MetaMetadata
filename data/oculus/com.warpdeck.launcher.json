n.com&_nc_ss=7f20f&oh=00_AQS0GFrAQDVvFlGlkUk4BDrDTC5QJ8fnf3ZrqKotVB7B1A&oe=6B09BB6D"}, {"file_name": "warpdeck-houseai-4-allapps-2560x1440.png", "id": "1672924884479299", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622195_1672924887812632_8831628545091624664_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=golb9rvF9TkQ7kNvwEaXe77&_nc_oc=AdrDWWJRt8bNTekxE04kuMKPOxMps3cnj0-Gwa8huEO5zCN-zBkIqlgE217837THZz4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR89S02K7RqO51HtgkTQ939EwiZzF7HuV8JFO4dTmLXNg&oe=6B09B1A0"}, {"file_name": "warpdeck-houseai-3-settings-2560x1440.png", "id": "3040960909570737", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624619_3040960916237403_8477294977916546807_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzHeM-roMoMQ7kNvwHWq6G9&_nc_oc=AdorLOOguHOdAw2aDBlL9sLb0dM_CF8UgCvMGX8pxS_3fVMmnPsXaNc_8fHh8WxaaXc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNOHg1K1o0-UkyIfwnWMAoyrzgU-AnxVZBCUR5dJ68XA&oe=6B09A98A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WarpDeck", "keywords": ["bootlauncher", "fastlaunch", "quicklaunch", "boot", "autolaunch"], "long_description": "WarpDeck gets you into VR faster.\n\nPut the headset on after a reboot and WarpDeck is already there. A clean countdown ticks down to your favorite game or app. Do nothing and you launch straight in. Changed your mind? Tap Cancel and pick something else from your Quick Launch panel. No library scrolling. No menu hunting. Boot. Countdown. You are in.\n\nWarpDeck is a lightweight 2D panel utility for Meta Quest / Horizon OS. It also works on any Android-based headset. It is about 2 MB. There are no accounts. No ads. No tracking. No network access. Your settings never leave the headset. You pay once. You own it.\n\nHow it works:\n\n\u2022 Pick one boot app. Any installed game or app.\n\u2022 Reboot the headset. WarpDeck waits a short boot delay so system services can settle.\n\u2022 The countdown appears only when you are wearing the headset and can see the panel. If Guardian or system screens are still up, it waits.\n\u2022 Do nothing and your app launches. Tap Cancel, Pause, or Launch now to take control.\n\u2022 Prefer no auto-launch? Use Favourites-panel-only mode. Want nothing at boot? Turn boot action off. You can still open WarpDeck anytime from the Library.\n\nFeatures:\n  \n\u2022 Cancellable boot countdown. Pick one app, reboot, and auto-launch it. Cancel, Pause, or Launch now anytime.\n\u2022 3 boot modes: Countdown, Favorites panel only, Off.\n\u2022 Quick Launch panel with Top 5 favorites. Big tiles, one-tap launch, reorder support.\n\u2022 Boot delay 0-60s plus countdown 0-30s. Ticks only when you are wearing the head\n\n\n", "short_description": " WarpDeck gets you into your favourite VR app FASTER. Pick a boot app, restart your headset, and after a short countdown it launches automatically \u2014 or cancel and pick from your Quick Launch favourites panel. No accounts, no ads, nothing leaves your device."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sparsha1211.github.io/warpdeck/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bearcat Inc", "support_website_url": null, "website_url": "https://satisfyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE
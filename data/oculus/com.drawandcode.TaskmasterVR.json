eo_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "1293509128018260", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_1293509131351593_1906963968364817964_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLSX1SXOM-MQ7kNvwFX2QWI&_nc_oc=Adm_Xs0wJ9bWwdK82lVNMS8Xb0los9d0ykqIG3EfuIyhuaRzG4FgzhokM5rxSsYR9ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunU39OdqMiso4DtOhUJI2h44QARTRUuqgl5gFYM5p-gw&oe=69A03D5D"}, "display_name": "Taskmaster VR", "keywords": [], "long_description": "Submit to the judgement of The Taskmaster in glorious virtual reality! The hit TV show comes to VR and YOU are the contestant. Step into the world of Taskmaster, endeavour to complete a menagerie of weird and wonderful tasks and get creative in how you solve them! \nThe premise of Taskmaster VR is simple - complete tasks and impress The Taskmaster. Sounds easy? Well, it never, ever is. There are many ways to succeed and even more ways to fail.\n\n\nYOU VS THE TASK\nMastering tasks requires skill, patience, precision and grace. And if that fails, just throw things around and hope for the best! Grab, smash, balance, magnetise, fry, pierce - do whatever you need to do.\n\nWIELD HEAPS OF ODDBALL OBJECTS\nTaskmaster VR features more weird items than you can shake a rubber duck at. Eggs will be cracked, melons smashed and toy swords brandished. Don\u2019t worry about making a mess, Alex will clear it up.\n\nEXPLORE THE TASKMASTER HOUSE\nStep into the Taskmaster House and studio where many talented comedians have wilted; will you be praised or patronised?\n\nFEATURING THE TASKMASTER AND HIS ASSISTANT\nThe Taskmaster himself, Greg Davies, and his long suffering assistant Alex Horne will have more than a few things to say about your efforts in a fully voice acted performance from the deadpan duo.\n\nWIN THE TROPHY, LOSE YOUR DIGNITY\nBecome the series champion and be bestowed with a tremendous trophy depicting The Taskmaster in a fetching shade of not-quite-gold. Losers get nothing - not even pity.\n", "short_description": "Submit yourself to the judgement of The Taskmaster in glorious virtual reality! The hit TV game show comes to VR and YOU are the contestant. Step into the world of Taskmaster, endeavour to complete a menagerie of weird and wonderful physics-based tasks and get creative in how you solve them! "}]}, "developer_name": "Scallywag Arcade", "developer_privacy_policy_url": "https://drawandcode.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Draw & Code", "support_website_url": null, "website_url": "https://scallywagarcade.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6997166970305739"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1173328874750852"}, {"status": "PUBLISHED", "id": "1264214835089574"}, {"status": "PUBLISHED", "id": "1030218279081934"}, {"status": "CANCELLED", "id": "1197406162092416"}, {"status": "PUBLISHED", "id": "499337653009867"}, {"status": "PUBLISHED", "id": "612490361574571"}, {"status": "CANCELLED", "id": "1917859145408338"}, {"status": "PUBLISHED", "id": "1230629828174270"}, {"status": "PUBLISHED", "id": "882068427271398"}, {"status": "PUBLISHED", "id": "1669766980512447"}, {"status": "PUBLISHED", "id": "980675930295800"}, {"status": "PUBLISH
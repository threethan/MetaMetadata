ontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974513_247406035020886_77299577456988657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24HwGzK47yIQ7kNvwGYg1WQ&_nc_oc=Ado-vHugaxHhH6vhPgd04jT6n5mw6ryOlK5QdK-x4LE7Ccsf83evHwMbnzAa8Mi3XTs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Ey8lGF9BcGl73UXeKy9wDOZQWhTy7WfZxBLSoD9VOxg&oe=69F1FA38"}, {"file_name": "Gameplay_META_LivingRoom_02.png", "id": "1501957233915355", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982609_1501957237248688_5817973044711084925_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N-m3e4N4toQ7kNvwFaIF8a&_nc_oc=AdqHnNxQvZX9n2w8-i56TbU9Kqr676Xb0pehQmYdiVCfBniHxwfTwMGqDwA3aP9qKqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2k_zk9WL5TMo5i70eH_bSF26JTXvigFrddt7EFfSBwlQ&oe=69F1FDC9"}, {"file_name": "Gameplay_META_Caravan_02.png", "id": "652642313734474", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036702_652642317067807_1765505680425404507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1d-UPoCox8Q7kNvwGESJjv&_nc_oc=Adrs4GZhv5naJ198M9w3Gj4VaNPzkmimV9b4Kp693NIJ8Vh7yHpI-Cr-YjWPAekCMjU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0BL7gitYBWZDXBLEij38sS3CF4MpvjyQNjMKzEWaGXdA&oe=69F1E89D"}, {"file_name": "Gameplay_META_Lab_02.png", "id": "233739876268165", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974499_233739879601498_8650799063942384670_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXSUiPqCQU0Q7kNvwFAS6Oi&_nc_oc=AdqPbtPa679rIl72K7y_FEoDOI9UT2Hc3TBnSLn8TRT6_7cgZXzxux4WygEJjelEc28&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1VMjKNtZ8FFXCo9UCxeuRo4CMCnl5HUpVsRy59KRtUJA&oe=69F214CE"}, {"file_name": "Gameplay_META_Shed_02.png", "id": "1046836919771903", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566690_1046836923105236_2934846127604306607_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59kpItTF9pIQ7kNvwESlNeZ&_nc_oc=AdqW8Wpe-fsQLEc4kh1zX3jyin23khX8PFBSBF7_lqqQAZiDfYw87LSP8UseUm5ZN1o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1WzW4kaJK4y7B_GtLz1LwqxS0vL6vOsVhxiUnp_8pLdg&oe=69F1FD2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "1293509128018260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982626_1293509131351593_1906963968364817964_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqbNTqV_dsAQ7kNvwGKi5Md&_nc_oc=AdqdGnf0V32i0YSz6NPqysXmbtChFHLIRL3rs9x48Ls581kCcBWbMraj3T13abgR62Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3exCWUn3iGh6Gx_WWe4ALuiQpZGEsCQg6bQb1g3GY4ZA&oe=69F1FA5D"}, "display_name": "Taskmaster VR", "keywords": [], "long_description": "Submit to the judgement of The Taskmaster in glorious virtual reality! The hit TV show comes to VR and YOU are the contestant. Step into the world of Taskmaster, endeavour to complete a menagerie of weird and wonderful tasks and get creative in how you solve them! \nThe premise of Taskmaster VR is simple - complete tasks and impress The Taskmaster. Sounds easy? Well, it never, ever is. There are many ways to succeed and even more ways to fail.\n\n\nYOU VS THE TASK\nMastering tasks requires skill, patience, precision and grace. And if that fails, just throw things around and hope for the best! Grab, smash, balance, magnetise, fry, pierce - do whatever you need to do.\n\nWIELD HEAPS OF ODDBALL OBJECTS\nTaskmaster VR features more weird items than you can shake a rubber duck at. Eggs will be cracked, melons smashed and toy swords brandished. Don\u2019t worry about making a mess, Alex will clear it up.\n\nEXPLORE THE TASKMASTER HOUSE\nStep into the Taskmaster House and studio where many talented comedians have wilted; will you be praised or patronised?\n\nFEATURING THE TASKMASTER AND HIS ASSISTANT\nThe Taskmaster himself, Greg Davies, and his long suffering assistant Alex Horne will have more than a few things to say about your efforts in a fully voice acted performance from the deadpan duo.\n\nWIN THE TROPHY, LOSE YOUR DIGNITY\nBecome the series champion and be bestowed with a tremendous trophy depicting The Taskmaster in a fetching shade of not-quite-gold. Losers get nothing - not even pity.\n", "short_description": "Submit yourself to the judgement of The Taskmaster in glorious virtual reality! The hit TV game show comes to VR and YOU are the contestant. Step into the world of Taskmaster, endeavour to complete a menagerie of weird and wonderful physics-based tasks and get creative in how you solve them! "}]}, "developer_name": "Scallywag Arcade", "developer_privacy_policy_url": "https://drawandcode.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Draw & Code", "support_website_url": null, "website_url": "https://scallywagarcade.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "es", "fr", "it", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6997166970305739"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1173328874750852"}, {"status": "PUBLISHED", "id": "1264214835089574"}, {"status": "PUBLISHED", "id": "1030218279081934"}, {"status": "CANCELLED", "id": "1197406162092416"}, {"status": "PUBLISHED", "id": "499337653009867"}, {"status": "PUBLISHED", "id": "612490361574571"}, {"status": "CANCELLED", "id": "1917859145408338"}, {"status": "PUBLISHED", "id": "1230629828174270"}, {"status": "PUBLISHED", "id": "882068427271398"}, {"s
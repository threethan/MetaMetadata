c_ohc=6UR2YR4k4l8Q7kNvwHu1pkb&_nc_oc=AdqQ0CTSlqPrGb2rZ6hv4ciLxGtNg18YHKddzaJxmPmEvpnj-mhIFg7cSzgmUxQcF4k&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33Ju5QUefVA52VxjBBVQn7XsLbLSnOe1DxBvPfAVDBAQ&oe=69F5F083"}, {"file_name": "shot6.png", "id": "2125495244947060", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499294601_2125495248280393_5327250173659505170_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyH_eKijOwEQ7kNvwEIhIXx&_nc_oc=AdrKcR6DunGQO1t0HseaxF4ht30oP97GOr3wRZ3JNTHVxsjEpx7KBZCrJYIJKavqX7o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3i84WL9JJcdl7Lu6NIBWwp4z-e-IXaG3fSVcd6bila8w&oe=69F610D6"}, {"file_name": "shot5.png", "id": "4199188353636788", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499310817_4199188356970121_7527469587437860735_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c3jbnc66hoQ7kNvwEJQ-Lo&_nc_oc=Adr7XJ5YCpxrl7VE9VU0P_cyd61AUx2OCJi7JaAckbGLY4E1_YNIyw7U5oi4rgiMMsU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wVhyR3O-YFqLcvhFJQVBd-le4DMslXH5tnxJrYhoH3A&oe=69F5E85C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highmark SSH", "keywords": [], "long_description": "## A Real SSH Terminal for Meta Quest\n\nHighmark SSH is a native SSH terminal emulator built for Meta Quest. Connect to your Linux servers, cloud instances, or home lab \u2014 right from your headset.\n\n### Why Highmark SSH?\n\n- **Full terminal emulation** \u2014 VT-100 compatible, powered by the Termux terminal engine. Run htop, vim, tmux, and everything else you'd expect.\n- **Multi-tab sessions** \u2014 Open multiple SSH connections simultaneously and switch between them instantly.\n- **Secure by default** \u2014 Passwords encrypted with AES-256-GCM via hardware-backed Android Keystore. Host key verification with Trust-on-First-Use (TOFU) and MITM warnings.\n- **Works your way** \u2014 Use Quest controllers with the virtual keyboard, or plug in a physical Bluetooth keyboard for a full typing experience.\n- **Quick connect** \u2014 Paste `user@host:port` to auto-fill. Save favorites for one-tap reconnection.\n\n### Privacy First\n\nNo accounts. No analytics. No telemetry. No third-party servers. Highmark SSH connects directly to your SSH hosts and nothing else. All data stays on your device.\n\n### Open Source\n\nHighmark SSH is open source under MIT/GPL v3. View the code, report issues, or contribute at github.com/rabbitHoleSolutions/highmark-ssh.\n\n### Supported Devices\n\nQuest 2, Quest Pro, Quest 3, Quest 3S\n", "short_description": "Highmark SSH brings a full-featured SSH terminal to your Meta Quest headset. Connect to remote servers, run commands, and manage systems \u2014 all from VR. Features multi-tab sessions, encrypted password storage (AES-256-GCM), connection history with favorites, and Trust-on-First-Use host key verification. Works with Quest controllers or a physical keyboard. No accounts, no tracking, no telemetry \u2014 just a fast, secure terminal that connects directly to your servers. Open source on GitHub.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/TERMS.md", "publisher_name": "Rabbit Hole Solutions Inc.", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devi
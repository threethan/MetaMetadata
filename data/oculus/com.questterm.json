=1-7&_nc_sid=6e7a0a&_nc_ohc=x4ULd61VuMUQ7kNvwFC87KZ&_nc_oc=AdrduLi6aK-GZ4y8DpQWBcWKuZPhVCWAfang_NgnVGBPbOHn--bAtO9QDBuJGOVNfAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9dXkxNAzxk5JytZ4YXDpIn5w0BCjla6FPYdlDXb4bSg&oe=6AFDDEDD"}, {"file_name": "shot8.png", "id": "1078876354402150", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831792_1078876361068816_7320177253397831895_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFaZOOuyh8kQ7kNvwGSMZ4k&_nc_oc=AdoZzCFx0wWZATm1jcAaJfGMDpR_3aWPIUyJcd6OS60b1vXDZb6G1oYzsPiR4S91pjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMwh5Qt3oSckVnt4r8G0fKOGUxXXthtb8_aS0opn5pEQ&oe=6AFDD4C3"}, {"file_name": "shot6.png", "id": "2125495244947060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294601_2125495248280393_5327250173659505170_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKXIN8hoSecQ7kNvwHKnCnE&_nc_oc=AdoP6538sa5PbEkuAe7eIrtfA73-eMWkLkm2XlU2LQFontSWsE71Zyy33LSGoyRgYFQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwbEMFnEeIWThsPS08papKBw_is0aHtV-is3-mtZQIAw&oe=6AFDBCD6"}, {"file_name": "shot5.png", "id": "4199188353636788", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_4199188356970121_7527469587437860735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDfK7Ac8NmoQ7kNvwFP7FTf&_nc_oc=AdqAeNoTr60vvZks2BMCzTGF4Xjde9DMyFeJhx9zBavELJltw51Q76gVGXBfbrGuVJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEEOCdtp3QTN2HcbamirgjlpWpd5c-guZ-spAu7XEr4w&oe=6AFDCC9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highmark SSH", "keywords": [], "long_description": "## A Real SSH Terminal for Meta Quest\n\nHighmark SSH is a native SSH terminal emulator built for Meta Quest. Connect to your Linux servers, cloud instances, or home lab \u2014 right from your headset.\n\n### Why Highmark SSH?\n\n- **Full terminal emulation** \u2014 VT-100 compatible, powered by the Termux terminal engine. Run htop, vim, tmux, and everything else you'd expect.\n- **Multi-tab sessions** \u2014 Open multiple SSH connections simultaneously and switch between them instantly.\n- **Secure by default** \u2014 Passwords encrypted with AES-256-GCM via hardware-backed Android Keystore. Host key verification with Trust-on-First-Use (TOFU) and MITM warnings.\n- **Works your way** \u2014 Use Quest controllers with the virtual keyboard, or plug in a physical Bluetooth keyboard for a full typing experience.\n- **Quick connect** \u2014 Paste `user@host:port` to auto-fill. Save favorites for one-tap reconnection.\n\n### Privacy First\n\nNo accounts. No analytics. No telemetry. No third-party servers. Highmark SSH connects directly to your SSH hosts and nothing else. All data stays on your device.\n\n### Open Source\n\nHighmark SSH is open source under MIT/GPL v3. View the code, report issues, or contribute at github.com/rabbitHoleSolutions/highmark-ssh.\n\n### Supported Devices\n\nQuest 2, Quest Pro, Quest 3, Quest 3S\n", "short_description": "Highmark SSH brings a full-featured SSH terminal to your Meta Quest headset. Connect to remote servers, run commands, and manage systems \u2014 all from VR. Features multi-tab sessions, encrypted password storage (AES-256-GCM), connection history with favorites, and Trust-on-First-Use host key verification. Works with Quest controllers or a physical keyboard. No accounts, no tracking, no telemetry \u2014 just a fast, secure terminal that connects directly to your servers. Open source on GitHub.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/TERMS.md", "publisher_name": "Rabbit Hole Solutions Inc.", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25896162369994080"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620875_793353177142567_658962116234582359_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDxaJSy-AxUQ7kNvwF0qFfx&_nc_oc=AdrHWnvR9vUSutDCmAZcPOjXa0UsiyI4fNtmUELmiJhEkCQiAKBm3iUP56dm7TVrmvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrNWYv78pXWbUwuKYQnRea-aGP8VKw6Tzmu2j_5ohgsQ&oe=6AFDC094"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Highmark SSH", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Computer Link", "id": "1055187466124150"}], "release_date": 1773068940, "lastRevision": {"nodes": [{"id": "25701722452771407", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25701722399438079", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1418883609646732"}, "iarc_email": null, "msrp": null, "transl
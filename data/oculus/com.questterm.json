3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbfhvwYAe-sRCLPPnuOphdBNEye_Joki52SJnHs1Gx-A&oe=6B0F025D"}, {"file_name": "shot8.png", "id": "1078876354402150", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831792_1078876361068816_7320177253397831895_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf6B8gdjR8YQ7kNvwHaPuix&_nc_oc=AdrAqzf-ZUS1gTEIDocRSRehN4_70O0ZN2vc32tjhuh-KhzPX6dtjl-QBwKvnPHIYEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpckm_3DI36oHvfsdtET5vMwRGpvwHN9ouFedLHIiyGw&oe=6B0EF843"}, {"file_name": "shot6.png", "id": "2125495244947060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499294601_2125495248280393_5327250173659505170_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8R4VUDw9OYQ7kNvwEJ6vr4&_nc_oc=Ado1W72mdotK2TLxIfrulArHn_7lCn4t2mntrOfwNshuAxNcQxHRvzWTmY4a_nPSRJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-n-DLAJ9D5S20G08uADVv-IKsCkFHNwq-TBuGSKEU4w&oe=6B0F1896"}, {"file_name": "shot5.png", "id": "4199188353636788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_4199188356970121_7527469587437860735_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2dCUrFaJ58Q7kNvwFMZ9tH&_nc_oc=AdqHmU_pWcMbaubH9luMkw-PDqpY8V44ASDlq81T0BzTWzDUXl1MBFr1n_SJfGV6vqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrc4Rb8xlguGAc7rZptQFNa4gHlWlmLKnf1Fb1c_Q2Cg&oe=6B0EF01C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Highmark SSH", "keywords": [], "long_description": "## A Real SSH Terminal for Meta Quest\n\nHighmark SSH is a native SSH terminal emulator built for Meta Quest. Connect to your Linux servers, cloud instances, or home lab \u2014 right from your headset.\n\n### Why Highmark SSH?\n\n- **Full terminal emulation** \u2014 VT-100 compatible, powered by the Termux terminal engine. Run htop, vim, tmux, and everything else you'd expect.\n- **Multi-tab sessions** \u2014 Open multiple SSH connections simultaneously and switch between them instantly.\n- **Secure by default** \u2014 Passwords encrypted with AES-256-GCM via hardware-backed Android Keystore. Host key verification with Trust-on-First-Use (TOFU) and MITM warnings.\n- **Works your way** \u2014 Use Quest controllers with the virtual keyboard, or plug in a physical Bluetooth keyboard for a full typing experience.\n- **Quick connect** \u2014 Paste `user@host:port` to auto-fill. Save favorites for one-tap reconnection.\n\n### Privacy First\n\nNo accounts. No analytics. No telemetry. No third-party servers. Highmark SSH connects directly to your SSH hosts and nothing else. All data stays on your device.\n\n### Open Source\n\nHighmark SSH is open source under MIT/GPL v3. View the code, report issues, or contribute at github.com/rabbitHoleSolutions/highmark-ssh.\n\n### Supported Devices\n\nQuest 2, Quest Pro, Quest 3, Quest 3S\n", "short_description": "Highmark SSH brings a full-featured SSH terminal to your Meta Quest headset. Connect to remote servers, run commands, and manage systems \u2014 all from VR. Features multi-tab sessions, encrypted password storage (AES-256-GCM), connection history with favorites, and Trust-on-First-Use host key verification. Works with Quest controllers or a physical keyboard. No accounts, no tracking, no telemetry \u2014 just a fast, secure terminal that connects directly to your servers. Open source on GitHub.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/rabbitHoleSolutions/highmark-ssh/blob/main/TERMS.md", "publisher_name": "Rabbit Hole Solutions Inc.", "support_website_url": null, "website_url": "https://rabbitholesolutions.ca/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25896162369994080"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2382912008839644"}]}, "baseline_offer": {"id": "2382912008839644"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773068940, "status": "PUBLISHED", "id": "2382912008839644"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29015415204735432", "version": "1.0.4"}, "id": "925807116460910", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25701722399438079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29015415204735432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "925807116460910"}]}, "change_log": "What's new in 1.0.4\r\n\r\n- Pop-out windows: with two or more tabs open, tap \ufffd on a tab to move it into its own window. The session stays connected.\r\n- USB keyboards: plugging in or unplugging a keyboard no longer interrupts typing.\r\n- Clearer saved connections: each one shows whether it has a saved key, a saved password, or both. The key panel also says whether it's showing your saved key or a new one.\r\n- Better error messages: if a connection fails, the error is always visible and says what to check.\r\n- Fix: the demo connection no longer forgets its password after you first connect.\r\n\r\nThanks to community contributor j333c for the pop-out windows and new tests.", "created_date": 1794677322, "id": "29015415204735432", "version": "1.0.4", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25701722399438079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29015415204735432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "925807116460910"}]}, "change_log": "Fixes on screen keyboard, adds key support, copy/paste fixed.", "created_date": 1790116972, "id": "28290347677242192", "version": "1.0.3", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25701722399438079", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29015415204735432"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "925807116460910"}]}, "change_log": "Added font size scaling.", "created_date": 1782839833, "id": "27256354517308185", "version": "1.0.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count"
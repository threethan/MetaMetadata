&_nc_oc=AdpmRpLg7mW4HJZIHDD2pa6bb-nnGSBM0fkm0YaQQG9Kaeua1nkX04nrLgSnbJ-IWLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzNVfC6C6bGoAy71f9MUuO_FJMgbpfPoCCFKZ6fqJcIg&oe=6B0DB924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "2622247788281257", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908850569_2622247791614590_1862295694017525660_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89jmjerZw3UQ7kNvwHPzyyK&_nc_oc=Ado7N7VzvQh3WR3RrYBz8AZvNPdFNslarH5zqBFngNQDjM9nM5DKsKv7FPg7dXEZna0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRR5TBFMsr3ZZ0j-KlvrorOD5VQgU6DZqkYjsrQ2xYjQ&oe=6B0DD07C"}, "display_name": "Quick Hands Hockey VR", "keywords": ["hockey", "stickhandling", "goalie", "shootout", "training"], "long_description": "Turn your room into a hockey playground with Quick Hands Hockey VR. Real Puck Tracking follows your physical puck or ball and uses its movement to control mixed-reality games.\n\n\u2022 Stickhandle through Rapid Targets, Gear Dodge, Blizzard Dash, Goat Mode, Cosmic Breakaway, and more.\n\u2022 Find your rhythm in Puck Rhythm, where puck movements hit the falling arrows.\n\u2022 Switch between mixed reality and immersive environments.\n\u2022 Use Touch controllers for VR shooting drills and goalie training, with adjustable difficulty and player sizing.\n\u2022 Earn rewards and personalize your equipment as you play.\n\nReal Puck Tracking requires a compatible Quest 3 or Quest 3S, camera permission, a physical puck or ball, and a clear play area. A brightly colored puck is recommended. Black pucks require a plain, light floor; a white hockey shooting sheet works best. Camera frames are processed locally on your headset and are not recorded or uploaded by the app.\n\nChoose a quick challenge or settle in for more reps with your real stick and puck.", "short_description": "Your real puck. Your real stick. A new way to play hockey in mixed reality, with immersive shooting, goalie training, and arcade challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://athnexa.com/privacy-policy-quickhandshockeyvr/", "developer_terms_of_service_url": null, "publisher_name": "Athnexa", "support_website_url": "https://athnexa.com/support/", "website_url": "https://athnexa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29119012221058652"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1666505848204233"}]}, "baseline_offer": {"id": "1666505848204233"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795468620, "status": "PUBLISHED", "id": "1666505848204233"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29152776757682198", "version": "1.0.0"}, "id": "4235162520109120", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "29119012151058659", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29152776757682198"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4235162520109120"}]}, "change_log
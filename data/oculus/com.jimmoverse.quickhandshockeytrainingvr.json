vwEyZlPP&_nc_oc=AdoncVewau5claJOCT_d80V4DCWwQc7OpbzjzCDZs7by0ZmvdRD0GNGRJgCJ1_msowQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrQGZa7L-NiTL37s62IuTvpOmWcABbWoa743buWbi3tg&oe=6B0DCE61"}, {"file_name": "01-Real-Puck-Gear-Dodge.png", "id": "1021952237604569", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842271_1021952240937902_9048921186853653718_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7rVlUOVvaUQ7kNvwFOA8Oe&_nc_oc=Adoxjat35zE0i5vNTQWr0-NsrC0kSn8DF1sG2ztH031vkOUK9DmfyLOhAURFdMeU92M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyAuQhEBaaWp5V8XyYl5u42DLrrGJZHI3c93pQXhLUbw&oe=6B0DA879"}, {"file_name": "02-Rapid-Targets.png", "id": "2057350918306849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908850585_2057350921640182_1314362379286646037_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-o7ByKcPdcQ7kNvwFnD3rB&_nc_oc=AdpmRpLg7mW4HJZIHDD2pa6bb-nnGSBM0fkm0YaQQG9Kaeua1nkX04nrLgSnbJ-IWLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQzNVfC6C6bGoAy71f9MUuO_FJMgbpfPoCCFKZ6fqJcIg&oe=6B0DB924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "2622247788281257", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908850569_2622247791614590_1862295694017525660_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89jmjerZw3UQ7kNvwHPzyyK&_nc_oc=Ado7N7VzvQh3WR3RrYBz8AZvNPdFNslarH5zqBFngNQDjM9nM5DKsKv7FPg7dXEZna0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRR5TBFMsr3ZZ0j-KlvrorOD5VQgU6DZqkYjsrQ2xYjQ&oe=6B0DD07C"}, "display_name": "Quick Hands Hockey VR", "keywords": ["hockey", "stickhandling", "goalie", "shootout", "training"], "long_description": "Turn your room into a hockey playground with Quick Hands Hockey VR. Real Puck Tracking follows your physical puck or ball and uses its movement to control mixed-reality games.\n\n\u2022 Stickhandle through Rapid Targets, Gear Dodge, Blizzard Dash, Goat Mode, Cosmic Breakaway, and more.\n\u2022 Find your rhythm in Puck Rhythm, where puck movements hit the falling arrows.\n\u2022 Switch between mixed reality and immersive environments.\n\u2022 Use Touch controllers for VR shooting drills and goalie training, with adjustable difficulty and player sizing.\n\u2022 Earn rewards and personalize your equipment as you play.\n\nReal Puck Tracking requires a compatible Quest 3 or Quest 3S, camera permission, a physical puck or ball, and a clear play area. A brightly colored puck is recommended. Black pucks require a plain, light floor; a white hockey shooting sheet works best. Camera frames are processed locally on your headset and are not recorded or uploaded by the app.\n\nChoose a quick challenge or settle in for more reps with your real stick and puck.", "short_description": "Your real puck. Your real stick. A new way to play hockey in mixed reality, with immersive shooting, goalie training, and arcade challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://athnexa.com/privacy-policy-quickhandshockeyvr/", "developer_terms_of_service_url": null, "publisher_name": "Athnexa", "support_website_url": "https://athnexa.com/support/", "website_url": "https://athnexa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29119012
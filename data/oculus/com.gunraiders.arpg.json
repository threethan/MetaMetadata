.oculuscdn.com/v/t64.5771-25/499623115_4591191821137969_3173543398114077608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc01MYupoYkQ7kNvwG1diA8&_nc_oc=AdqM-0crOXPyL1TmbfZmsoyKYDquMflgtMALtsPe0r6ftLKhFOw5PBKSy2gXltHLtHs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMC3mfuYpd6AmY-2l8H0G-iQZ2gfH6QW-qvLV-FXLj0g&oe=6AE34F2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Raider_Legends_Banner_2560x1440.png", "id": "28377686408524418", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593869844_28377686415191084_359688696420049568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACT9eA7Wr88Q7kNvwGYoZWm&_nc_oc=AdoaQ2Akt6AIN34hui5SJRBN5kL4eMxrhqvW8Z76PXKTkmrbFK3eRtaBeibaHFVGq5E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN98Oun8XbaNxT7mjwHg-4wC2MFEpqHFc3PnDa3H0L9jA&oe=6AE36171"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-
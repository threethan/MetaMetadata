.oculuscdn.com/v/t64.5771-25/499623115_4591191821137969_3173543398114077608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ORk41xg0aQQ7kNvwGsPyBs&_nc_oc=Adr-o3RfOTquESSaifJjTzQCJh7quMw7W-vaQj4Xw3absCOKXt4scNdJOGTlap25qks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkjHFVhA92A6eZDHwc0HT5quGSlZ-FhOIKPNGgEfDa6g&oe=6AD3B56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Raider_Legends_Banner_2560x1440.png", "id": "28377686408524418", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593869844_28377686415191084_359688696420049568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23EolZ9DYmkQ7kNvwEeuSE7&_nc_oc=Adq8uqcd7eoLZNqjUfC14HLFNlqUN1uPEREnBvVkk1SbIANBN_cw1z-y1xvmmzA_7y8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyEDFDzmMa2UKUcW6SM39AINmpfUyihN7ElXrFS4s-Lw&oe=6AD38F71"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-
.oculuscdn.com/v/t64.5771-25/499623115_4591191821137969_3173543398114077608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXJMsifUqBQQ7kNvwGOrcRx&_nc_oc=AdpwhbkbfiMckyC1eJqpU0QXNuvm7xhvGDIxgqLiBoew-NTQRJdNWX3x4JwKoqmR4Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlTXtYaHY7o2pzAFGGakhH30QoDz9atE2uwYSLU_lh4A&oe=6AE9E6AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Raider_Legends_Banner_2560x1440.png", "id": "28377686408524418", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593869844_28377686415191084_359688696420049568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfF1dQk8xXcQ7kNvwEOlfCL&_nc_oc=Adr4I26NuceXB6Xyd5dycNBdQ8cz2T42Zwlq437UTaeJygNFzSGtPwQIiEVplPPbTao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP7NktVOeHkkAfj4zLU0j0BcZwcZOU_apQAUA9CLksHg&oe=6AE9F8F1"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-
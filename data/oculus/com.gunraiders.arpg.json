e7a0a&_nc_ohc=tIv5gKr0xdgQ7kNvwHe3VYE&_nc_oc=AdrpgjRRvendtG9bksdQmW4FZ6oWrmQp7-c2UqYfCNpLGhK9ppBeV0Gxe2Xw8OBK_Qo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9Jem9g9hrfuDJYtgThHuxmyR0vNCHjcgX23Y3aYt4yg&oe=6ABA5A3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape1.png", "id": "2437183346774056", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_2437183350107389_575708754879884824_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LRnW7NnDSoQ7kNvwFfMUzx&_nc_oc=AdrZMNIQetcsdAns0bP6gZ9StFGk1n3Gz818jemQucgxQ6tRQSytVbJlmPK_xV4Hv0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbaZuqMc2tg2jUZCqQ0pHunhWU7aI67YK5jif6UxiS5Q&oe=6ABA5C7B"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc/en-u
cP8ACdVjAJ9DZsG4583b1KgVdm2rZsynp72ODHW6UbQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWijyGaEobx2SGAVVtgfsILo02KF2pQgc2rFo9VqR4Ctg&oe=6B10568C"}, {"file_name": "4_ai.png", "id": "2194117788146377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_2194117794813043_4604109805244325452_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOSWTxUODygQ7kNvwGwuf5y&_nc_oc=AdrNsRIQmdhJZiZ-5lzSO51rtNl8UWIttd3nHnq1hiwGSXn26YoVVyBmn4Ok9yPBi0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUvMy8bhglJbpjluEC4O6rA66Z23vsKIj7iFMaRrqnS-g&oe=6B106896"}, {"file_name": "5_ai.png", "id": "4591191817804636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623115_4591191821137969_3173543398114077608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fimCwb2kMkQ7kNvwFFesO6&_nc_oc=Adq5jj3L3mwo84iyT4DzvvR1EHjmFujd26iY5eWMxwIRnt_LfUEsfZhSCSzWotBO_jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVneI4lFudZbKtYEgBdlthlGrYO7oi2TBAsVEbf6KXu5g&oe=6B105A6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Raider_Legends_Banner_2560x1440.png", "id": "28377686408524418", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593869844_28377686415191084_359688696420049568_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6rmH8PytUQQ7kNvwHcVHym&_nc_oc=Adr6OC7P4PUuXr7_rv1KFk5PknQUqNxrzMtGbJWZJ617x2_aiNPQ0zwM4mjpjJJPfPM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWRH3Ut6ekrjXr6Bpe_TgqQyUF-KSFMPVauXfXcXggRvg&oe=6B106CB1"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\n
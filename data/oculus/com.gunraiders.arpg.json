hc=T3ZaZ4IHffkQ7kNvwFAn8mq&_nc_oc=AdofY0E7m_i2Py-Dl5ksziZwclAw0SRPfmdpZr7EiU1NS_QIBpZLVd6BDZZwKPl2q6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO5SvF9LbFzZIYSt3HjY_dwhOze4R0kdVAXIYjZiIX7g&oe=6AA29F3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape1.png", "id": "2437183346774056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622276_2437183350107389_575708754879884824_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jud-3HfuwKcQ7kNvwFT20ZM&_nc_oc=Adp1X59QCluaDrmi-R8Yag-p473BnqsCEgy0yhFW8xxj1Mpng4xiwE30_w0nqEq2py4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlMgZv-t6XK9L8p90gNcE1TbCc0P3YAgMi-PFmxGKRKw&oe=6AA2A17B"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc/en-us", "websit
-1.oculuscdn.com/v/t64.5771-25/499622325_1534988854743817_6819396982770592559_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08nf1sExqyAQ7kNvwEtOL21&_nc_oc=AdppUS5pm5bcUNy0Oy3woZg5CVgSJZ5fo0NOCDButIGp9omxpHIlsP7QGgtPpcOCnIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNRep8U5LBQAwqCyQwBr5AJFK-hzA4-Nl-9A1eLrBGag&oe=6A8C14FE"}, {"file_name": "5.png", "id": "796768080167234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619805_796768083500567_2437208910508634136_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyNjm5KHjN4Q7kNvwEcp-fM&_nc_oc=AdrDq2MngtFkrPpPcO26vYwdyZi7OQk5VU6nfpkK1R3Y4w3eCGuoi6pkxCnYCtV_olM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXyZC2aP7-ANt9f1VVaG3W8FPwSPun96kf_Goiwh2T8A&oe=6A8C35BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape1.png", "id": "2437183346774056", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622276_2437183350107389_575708754879884824_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SSVNVjBQD8Q7kNvwHHxpV6&_nc_oc=AdpDZins_qmY0Wpar77GOzgg8vMezUVMTZcLSxxfOKoZGWubsIPANm3Ph-Igj3Q6xgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA0t9Ss10Px-cU8bZU4REO4NCbOVW1nh99yElLNh9B8A&oe=6A8C37FB"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://raiderlegendsvr.com/discord**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Battle, loot, and level up with friends in ever-changing Rifts packed with monsters, bosses, and surprises. Every run makes you stronger."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://raiderlegendsvr.com/privacy-policy", "developer_terms_of_service_url": "https://raiderlegendsvr.com/terms-of-service", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc/en-us", "website_url": "https://raiderlegendsvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28149280581358532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623512_2067454994191671_2385512966420266544_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8CXZPqbXW0Q7kNvwHcOZRy&_nc_oc=AdpRqJz3IdaQP9s_ouXyIxmhjlOv6a_B97aL7CJB1FbyKLITlFoizZ1qFoFo7TmuuLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKUHA1xNJlEKffZkEwR844Fm5Bajn4XZTIFhW3cW5xJQ&oe=6A8C3868"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raider Legends", "platform": "ANDROID_6DOF", "context_ca
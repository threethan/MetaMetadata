cdn.com&_nc_ss=7f30f&oh=00_AQR0NdxgXcL1nAznwC7d0LH6awYdb8TnXCNEjcDT2a59xg&oe=6B0B157E"}, {"file_name": "5.png", "id": "796768080167234", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619805_796768083500567_2437208910508634136_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3LldAck_zUQ7kNvwF6GFPT&_nc_oc=AdqmDLUPw-9vl3Ly3_UJNjXpARHq3rZ2l_x4XlhesIhM3XLjxEuUfRE2eDRG3Mj-CrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-CRLHFm-q0bL6hIlCecxll7MaLm3KbW6SSpqITgUg5Q&oe=6B0B363C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageLandscape1.png", "id": "2437183346774056", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622276_2437183350107389_575708754879884824_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdAvX0QN-SIQ7kNvwHtBpbv&_nc_oc=Adr0Yog2wRh4swtS9LSn9dVvTqcnN0k7uvWJA0KBU1-eVVPz9XvjKhoKgtZCvmRQWjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTV2sWpNIUlDlc-lI5ZaNdQBiqUxaXq9c2gmPhW0WdbdQ&oe=6B0B387B"}, "display_name": "Raider Legends", "keywords": ["cooperative", "fantasy", "multiplayer", "gorilla", "loot"], "long_description": "**Welcome to Camp**\n\nYou've arrived just in time.\n\nAround here, there's always another Rift on the horizon.\n\nStep inside, conquer the challenge, bring home better loot, become stronger... then do it all again.\n\n{2505685783194274}\n\nRest while you can.\n\nIt won't be long before you're heading back out.\n\n{2931613547335456}\n\nOne last thing...\n\nEvery week brings something new.\n\nNew places.\n\nNew gear.\n\nNew trouble.\n\n{2726092177792254}\n\nIf you've got ideas, or just want to swap stories, come find us in the Raider Legends Discord:\n\n**https://discord.gg/AbjjjcSgyG**\n\nSee you around, kid.\n\n\u2014 Gawk", "short_description": "Team up with friends, conquer ever-changing adventures, discover powerful loot, and become stronger with every run. There's always another Rift waiting."}]}, "developer_name": "Gun Raiders Entertainment Inc.", "developer_privacy_policy_url": "https://gunraiders.com/privacy-policy", "developer_terms_of_service_url": "https://gunraiders.com/terms-of-service/", "publisher_name": "Gun Raiders Entertainment Inc.", "support_website_url": "https://gunraiders.zendesk.com/hc/en-us", "website_url": "https://gunraiders.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "27708281278791800"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "944785948626383"}]}, "baseline_offer": {"id": "944785948626383"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786035600, "status": "PUBLISHED", "id": "944785948626383"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29437075332579044", "version": "1.20.02"}, "id": "512445111354386", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9285012441545297", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "
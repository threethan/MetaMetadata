N0Q7kNvwGDCBL_&_nc_oc=AdpD8ftT5ipAYuXWrRs_JHeISjUi6MeI6a4GTUKHlzc-XhlrAkcaGrj917rccchmP-Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH9q8T-eAD50IgokIPMjye-P55zP2L1I1zltEuW83_oA&oe=6AAE90CB"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IfpVeqnEEEQ7kNvwFV723-&_nc_oc=AdrYadWrZ9tNs7RpcaO8Q93mIzbfc8mR-THF6xX4KjKpbhLGv6c2pap2o6-i-_KlvyQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImM_Fd7xYODFMZJlYnV-LAKQ85zCCRyhw0PBpVqjXX3A&oe=6AAEAFC9"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHsyemIho6MQ7kNvwGuZJPv&_nc_oc=AdplTbz4TdnVLw7q0AA8DMse22u24rogicyV3qGS5-Z84x60DLLEQI7uIFuVh53mfyQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnjlybFe7ggwPvcfgQTHM_z1jGjdYvoRYwEZXgro-1rQ&oe=6AAE8138"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noo1BwPOg3sQ7kNvwG12UQc&_nc_oc=Adr-P95xv5om8cxm3MFxhPaxKv7J_aw1BTeVoZpwOPb6IpnZhYNf-ySmFjGfAFhxq-4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR7qWpmYZyhx-wmyWhb2Cc-8jkmWItXyYFGiM7Q29Wkg&oe=6AAE865D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-jjRNSWW8Q7kNvwHmWXOL&_nc_oc=AdoRP-qHEvcMKeJIz-Oz2jvbj7781tezAY12JQjPzoi2IQ0yzODhTX34z_MpNCkDZqo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkMcYi-IjkCHrUmyijv0nC-WHmWS-jwfctZfIMkdROEQ&oe=6AAEA12B"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_webs
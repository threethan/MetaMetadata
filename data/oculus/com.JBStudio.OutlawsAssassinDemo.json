F"}]}, "id": "1498153244495780", "locale": "en_US", "screenshots": [{"file_name": "sss.png", "id": "1367085354636299", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818846_1367085357969632_7133179169991452682_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q171TtKkyAgQ7kNvwGWfJHV&_nc_oc=Adr1YckA6T6zIeE6pZId11MiCA_2tHyguIq0NoN69qx57rDSiFI15By0-408kT8Qa_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREbpXumDysPf8Z18rP0nNBBIbhRUouCvZd6jBD5pTotg&oe=6B0DA574"}, {"file_name": "screenshot (1).png", "id": "1073664107925468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyWN2tuJf1EQ7kNvwEZjuWw&_nc_oc=AdosgqjK02KH0zHl_g6EexY9_tPk0JsBIis858Le9Lx7umEhBvDVM5aQIMYWGfK_GCw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBlws9C_7zQNvSy_FdUJ46OILRArEkfX6DMihTQ8sJeA&oe=6B0DB50B"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeYtUuN2foUQ7kNvwGgcliA&_nc_oc=AdrIDSPHehpp7qhGGhLFdwJ_0eDwTy0IE0nvhlEE0b8GDBeOVXdDWJgTKWkP8vr5qHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT55vyU0W7_bblk898xlczGZjyUYUKUtw470PsStSoUlA&oe=6B0D9BC9"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86aPIQZ4pMIQ7kNvwGIwF_Y&_nc_oc=AdrZ9rumPffcsbdETV88rhxBFgYLLWUFUo2gYasmYkzfBpq00JEJ53vq8lwroHqALmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7XRf3V695pl_k50Wu3yxeOMGk3JTatKM4L8H_lIdOmg&oe=6B0DA578"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QpAFJk_QxQQ7kNvwHACRLR&_nc_oc=Adp9bvEjDurVtEj4F3wIwXny_WhZzgjEOVWXoBgR-ahbnjvADIBvqi3tPy6ErHRuaHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTderjsIvTaN-fbf5d-_gYNF2Hu7Y5tnG-1txDsaDUPAA&oe=6B0DAA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlxAQc8ySqoQ7kNvwEFHAKT&_nc_oc=Adrpn9hGFt_zuIvngxX0PDPllMe9xBJXLDTP5qNZ171Gx1Rnwx4Klop0DZP9VrgQy8s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQAyBtxC1LQm9fLD6u23byOWOIYG-lBoNkGYEmMWmWTtg&oe=6B0DC56B"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9703632363046069"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1285131206502887"}]}, "baseline_offer": {"id": "1285131206502887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747691040, "status": "PUBLISHED", "id": "1285131206502887"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
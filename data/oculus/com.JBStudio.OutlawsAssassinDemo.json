5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK88X5y7MFkQ7kNvwGKfcld&_nc_oc=AdpGXvTVJZd7--OfCQ-KwQPDHalyGIBBzLhc74y-XhORQAx1d-U9JSqdDX9Rnaz71v4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9MauirpsDQgYT-YUZWav8nP5pnleEXh-DEq1Hz5otyg&oe=6AC79D4B"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K16diEHkad4Q7kNvwHqDiaY&_nc_oc=AdpEtshIMG_JrQ1hqNNb01hlpJwpxcUYoRjFkH4hULBBv2C6bW9DBbFsWjbuHjq0fRE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcur2sIeckTa7KoqYYhkBygsbNgGKISiwWB8HksryDIA&oe=6AC7BC49"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zTkqa1gquoQ7kNvwGbFELs&_nc_oc=AdrZEslcQ1jGsAtoOiNCl7NJY13JxOGVP-2iIeh0OONbPQuY-_OPPS71ZZaz_ouEKx4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOqQ74JPXSZYFyTgBes9hJgS_EWme4Ue18XmV22vfVsA&oe=6AC7C5F8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEZfiOoDvlYQ7kNvwFKopvj&_nc_oc=AdrgrUC-DjXJlGNMV19_JNs7WbmMiFWO9cCzByS78yE5Qfo8Z4ZnuEyBO4X3KI77Hb0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWv56bD5u2_DTv361BJ2QpAS5eCYAtBepYh1_IcMhnxQ&oe=6AC7CB1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFce0gXPBDAQ7kNvwFuF-dM&_nc_oc=AdobMU4po14DrnutK3vDyzs1iFECyovJX2y44OcAgRDzd4CkJZddv_K4-MXISmY7Ksk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzAxbc-9aIznUsvxucaO2y4p-_p3rlht0jj9stBvcdSg&oe=6AC7ADAB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.c
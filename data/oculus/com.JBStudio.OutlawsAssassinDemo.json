scdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBePyV7U3a8Q7kNvwGvZ11U&_nc_oc=Adp0o96-nl7QW19Az-8en7CKPWqjBF47AJI1q5Wh05hNl4Fsh1YYJU_Cg1krIGUQsZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5KCYUcy1sdk6kfjKGmGpllvRoOo9R57eUzHH1KjWr8Q&oe=6A9FF709"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbFvBD0ene4Q7kNvwFPkOfY&_nc_oc=AdpmlaqsKxqvlr_tlIKtsG3oaIkaUJCrCuNIY8xubsQf3bUc22hLM34-1uywyoEk1P8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwHmqGwqpKbGj4WrYYFb3h_6a1VDvFqZ-mIuZK1VqQEg&oe=6AA000B8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCNO2quTwjAQ7kNvwFEi0aT&_nc_oc=Ado9ilzPVqF9wxHSs93lPQp4u5XWEBIc04oIq9rOIEsD1FIdzswNHTkr_mX171VV4wU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnyz6RcOMGbdTgc_RwAUedfAFx0upQjeHETdu2x1pe_A&oe=6AA005DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTORYp_Qp7gQ7kNvwHYqNTA&_nc_oc=AdpJABbtEzc8KkwWyAoNine3hj2N39nElzwZIuIho5OgJ775M33JCWof5lThZnSkdjE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj1KRO_gH9OKnWg2MYJvszgcftHyp4GL3ItTso9V2vxQ&oe=6AA020AB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_
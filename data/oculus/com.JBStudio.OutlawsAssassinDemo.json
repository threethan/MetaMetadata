5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXIm7ZH4GOwQ7kNvwFxDAHX&_nc_oc=Adr5gq0UNS4QeEo6gyaIYhI5NBVmeNwaIsUKUO3Fv_q10-p6TZK7CDGifTO49U0rHKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzgXBDaaqJCynRQnEliN3qbUfdxue0Hn4Ry8W8ZKU3Bw&oe=6ACA788B"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08r4dea0SmAQ7kNvwEFRdSQ&_nc_oc=Adra_0iM863W6Pg6r3KCH2NJPFyhAMxFwp_iVjv35suhWCbDd-gU4GeRi7lZpPqt7j4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAW31MxcXkofLrZZb1K4s1BSobz4TLjHKwnBht6nmf9Q&oe=6ACA5F49"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBaT4DQ0dfQQ7kNvwHEaUpz&_nc_oc=AdqXDgQ99Bs3O1KzK7pa8dR4tsiYwCFSJ6MjR1jF4V9C23kz3JaKq2fMFWBbf7ZrZxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFHBHwc36NMa0CvDfa6LF0m6jCLhiqrXXc6IAY3lkGOQ&oe=6ACA68F8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGQhZzh165IQ7kNvwFJWhB2&_nc_oc=Adr25dW8QL1UQH5EL0WPj9jKDSd6W45UiZG8pCuozuwAvxbVyndEU5BX-DNPBcpKMp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbbhYuXHJvXl5GhmTQWuYuhN15XlsAhBrYa_PoZrbfOg&oe=6ACA6E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVhTpd0junQQ7kNvwFb0lwd&_nc_oc=AdorTSuP6ga6dvzmxxpr2LVBtP66HawJrZCsgfqqn0Rw8dTvqZSZi3EA0MdQZCjDnHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPjmALD9JKVKEryVNhBZ7q1HITl1ocAVcqMSfc3Xbr6g&oe=6ACA50AB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.c
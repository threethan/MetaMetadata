F"}]}, "id": "1498153244495780", "locale": "en_US", "screenshots": [{"file_name": "sss.png", "id": "1367085354636299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818846_1367085357969632_7133179169991452682_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH-j7Mp4OKUQ7kNvwFhVmxj&_nc_oc=AdojA3P-1ayMwMi-GQC7y2TlFVMSgq5XVIGdTcqBCvRi5pObgQO_VMjVmbqNlvGtUR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR36OZDw4-3DEBTEXQKiWhhx_HDdbO-OursmB74WZjuYQ&oe=6B070DF4"}, {"file_name": "screenshot (1).png", "id": "1073664107925468", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JldSqxCdp4IQ7kNvwE22iHk&_nc_oc=Adrafu-q6wm40X3qabvhELDz7JOFBzAARVBJVfVUi8Xa4gQIV8Twrr2TZiM58f66wY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN66ePy0LoEeW1VJYd6kJjqsrT3qQdVj7iC6B5CFGdnQ&oe=6B071D8B"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30XPttrxRZUQ7kNvwEGeBFR&_nc_oc=AdrWCiTwaKknj8ITKchY0Kk5mMqFXUoQrFst9iMFCzr4JyGJavfXmLmUKsMCfSD1td4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqSX8SN3ydEZ27450Fcz2ybodPnRbUx3OY16-dB2QCIQ&oe=6B070449"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCQXoZ8VoQoQ7kNvwF3Bq-P&_nc_oc=AdqTF8clL1N4WuZSRdOuvB0ko2LSbYEC6Bf8BowCNuwfbf8QVOZwvj-AaCfLCgd2vAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzcNHYWe0nesQqpj0Gqzl2HvleXCmWTJLURY6FZXsJdQ&oe=6B070DF8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjM5Ap5N_DsQ7kNvwFW-KBj&_nc_oc=AdonqpOyEFR7NBKfzVJTnKaKGh7CTuyNDVACefzBoQZ_SCUdQLLpYwxIoqw5uvCj_fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjmxm2_JCtOnnHpsvCoS7YA1pmajgZ3DuY_f_97v4yGQ&oe=6B07131D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm4FXBem8PUQ7kNvwFx8Uz0&_nc_oc=AdoR8q2niaOXt-Nifm5abXG6s0X-lgal7ih509OmCrEgKUVTPg_fQgHaL6jnQJMv7G8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSof_Dbv5ag3JjWWTxXNo6YdlR9eiiY9IqWX4QfEB_ETQ&oe=6B06F5AB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9703632363046069"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1285131206502887"}]}, "baseline_offer": {"id": "1285131206502887"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747691040, "status": "PUBLISHED", "id": "1285131206502887"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typ
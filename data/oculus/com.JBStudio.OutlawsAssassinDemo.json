0a&_nc_ohc=0adoxN0yGFEQ7kNvwF5pYVu&_nc_oc=AdqJUFWCPSweKr2RweL7wKlOp_Qbfr7rPhMGtJeti3swnLc8il7BPCd0kCYSQ5kXTT8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmuGK06d_sCWamYVZ2Xo_ziwdGM7qE-CDQat8KxQkNEw&oe=6A7DB009"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwEb7zF4-ZkQ7kNvwHyOBl5&_nc_oc=AdrF3aqSWeXXUZiilzHqSlZnAFazmDXH5YTwH1LmtR1E9vs5STniRTrFkpt2HUJaLsk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ8FaqlnVRYv2VujHf1RakZQw3vBkvKyCA_UIMwpdMTQ&oe=6A7DB9B8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_eOGolsUxwQ7kNvwHFApQU&_nc_oc=AdoCp3gFz2pOE9R0TTboUOU6g-3XVmEJBzpaOn1pUK3_RiJS1Fdl_gF0GjSXypQ2wS8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi9fomtxEHh_N2C63BJoTpqpHClUd0l9GL1T4kOZr5dg&oe=6A7DBEDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2he1x8_mo8Q7kNvwFQhiFp&_nc_oc=AdoHKBpJy0c7cVI2U6h2cUBaJmZQ5tpH9GhSEKPb1z9Fa-QNfgOAOocjbTr56KQw41I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFhsGXTK1-PIJ-dKFMGrrElLeddUWlZFzf0S_JsfWSXw&oe=6A7DA16B"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://jahanbihamta.com/vr-kalimba/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
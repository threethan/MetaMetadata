m/v/t64.5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRopX9gUu1MQ7kNvwHs8V7P&_nc_oc=AdpwKRBooFI9vpqXrjRoS1gFx4MS6NaID-r0j75Y_Wa5GJtGsDai9jlWWndAJC2KJvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYl5rutHxBZf61EFuFY1hGdyGRGLlf3AdJbhtrYQZjYA&oe=6AB133CB"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgwBdvUC20AQ7kNvwH8_ihq&_nc_oc=AdoZ8cM8KN6sjy6pacR9usJjcrneOC-vyZZdxbjDHYstACqJFDWykKSopg9_U1-A0dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEcTVZvx7mFfcleT3dWf0ERftWkMyY89pwpHuoDSFWNA&oe=6AB152C9"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzAhfHbvAeEQ7kNvwHrT27e&_nc_oc=Ado_Hj2V_hdDU6yhr5qwePi_OQ7qydXCANYt1yZz73PFVnvZzDf7ST4Um-bU2uTbWcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE-Z5uHHc1nPQR43_0c-_6JbgwD_xMx4rKBFuKcoeaOQ&oe=6AB12438"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noo1BwPOg3sQ7kNvwGkMbZD&_nc_oc=AdrIuCBq_tspPP2x2lWvSkpOpR7TyS4mm5adoQUZPMTBwnPJRzna4KtW2s6uFqLoh3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISP3qVVW_gewHGPiTP4EoA4bCfQWhZ8MjTMon5Ekv4dQ&oe=6AB1295D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uttD15cHD2IQ7kNvwEM2Hpl&_nc_oc=AdoWuUaZOk0JCNXYWef9uvVzyEMmXm5RJSZMInCKFB_pED6M_sSGRZWnGIqgFUv3ByA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0zt2Mq-WiLoTjsQb6wS2O2q8FNummLWqeW0BehwvnZg&oe=6AB1442B"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.
cFa0_2H1CtR3WOBb2gedhjycllng&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUv4u3KDqL40S3sLQ2Rd6QDETGUVycurtK5uS1-j8erg&oe=6A917689"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FZL2cjAn18Q7kNvwF7fdCo&_nc_oc=Adp43mwMveXWpvQIzyDsOM_8Hsj8nDUtdOdcfwWba0rXecOnwOwU4SMl1qaNmwBKGxk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_ubyw0tR1PbuGmGfiuGMgFf3vtDUTTVH373r6GD9-Hw&oe=6A918038"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2erHriDgm8Q7kNvwF6COIt&_nc_oc=AdqR-wi3O4Jbp1xuP-K4f9X3MYh2SsG39RWBedwO1Jf28K8kFP_bJiIcrTTEMgJkQP4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgbfURwM9RtKL90a9SlA48HQpYoYujC16cTnanc_jW4Q&oe=6A91855D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBUKy3NoIf0Q7kNvwE9LOPw&_nc_oc=Adr8uEdzOkYlZ9bxwWlj-MIXm4vDazc4Vqmv2434ShD_yq1yOVKM71h3Owp4EVSv9tc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_DEG8nLHZOZogUaAgQXYDNRBSW_FcajI8batyRsW3Mg&oe=6A9167EB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.google.com/view/vrprivacy/home", "developer_terms_of_service_url": null, "publisher_name": "Jb Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vrprivacy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
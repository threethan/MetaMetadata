m/v/t64.5771-25/491820557_1073664114592134_194810833296482963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRopX9gUu1MQ7kNvwFpgWW9&_nc_oc=AdqYXoEINoSWtBpZN1acuyMpPJFIq8Bgs-ERmPOJci4Y6N2Vjmefxs_a-4AMtuionVQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEACigUginwSCMO4wuBRPKZ9yjV8PPscWGSbFTOmJX9g&oe=6AB2854B"}, {"file_name": "screenshot (3).png", "id": "1195644918595648", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819449_1195644921928981_2735807084003792242_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgwBdvUC20AQ7kNvwH0earN&_nc_oc=AdppBNW2M5e1I-madneLWcoV14iWWZwT3LBniEYGCqUlXEwfTuYMQQAtiY1zzOjCVN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoZddljNyM2MOhiSZLUNJAZgqFaxbxSFj9Yg9C6tnIbw&oe=6AB2A449"}, {"file_name": "sheriff.png", "id": "967651035584198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823965_967651038917531_1483830059479590007_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzAhfHbvAeEQ7kNvwGvOB0R&_nc_oc=AdrDwSXKPtYNnb1s4likl_iHsFKhgOE2Dwvxw2eh42su9SvOyx-8U-W2p0LafNzP7eM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvavkye2fEFg757qcCk02FH06XyxOJTRCrTxe7jfE1GA&oe=6AB275B8"}, {"file_name": "UI (2).png", "id": "1164932755295571", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391974_1164932758628904_6228459277322331371_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLDl3FyOLOIQ7kNvwGSK_oq&_nc_oc=AdokcqF2HPXqTxevO1_GI3cjNEXhXbDcrhnjWrxZaVYY-q8Pjy6Rip0lUrO3rijbo30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDFbhrleqJNkSFmuACcK_QClmfIHzEc3zi30FlJ0DWvg&oe=6AB27ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "6th-Main.png", "id": "970349881647416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_970349888314082_8938328313037634526_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uttD15cHD2IQ7kNvwEBZr9s&_nc_oc=AdrxVNuT0jvR_RVHmXMjGXFduAAH48UMV_q_hEKnqBVDqLbuXMy9gJbczXvjJU8ph78&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC2ZFXp3hCRSxmUxrouDQrYf47TtjMKe66q8aeyfuTsg&oe=6AB295AB"}, "display_name": "Outlaws Assassin - Demo", "keywords": ["western", "shooter", "strategy", "casual", "stealth"], "long_description": "You can find the full version through the link below\n\nhttps://www.meta.com/en-gb/experiences/outlaws-assassin-western-justice/28326306157013728\n\nStep into the boots of a lone gunslinger in this tactical Wild West VR shooter. Every level offers something new. Whether you're outsmarting bandits or saving hostages in a dusty desert town, your aim, timing, and tactics decide who survives the showdown.\n\nFeatures : \n\nUnique stealth mechanics using your trusty mirror (Ojo M\u00e1gico) to spot enemies around corners without exposing yourself\n{666629932799383}\n\nUse explosions, traps, and strategy \u2014 not just bullets\n\n{1175440533892252}\nStory-driven with humorous sheriff missions introducing each level.\n{1011192394320004}\nFirst-person Western action game built for VR\n\n{1091673586098228}\nCasual pacing, but rewarding for sharpshooters and sneaky players alike\n\nStylized low-poly visuals with gritty cowboy charm\n\n{601810062744161}\n\n\n\nPerfect for fans of:\nOutlaw shooter VR, Western stealth game, VR cowboy shooter, story-driven cowboy VR, and Wild West sniper VR experiences.\n\n\nJoin our Discord server\nhttps://discord.gg/Be4fR3Pn\n\n\n\n\n", "short_description": "\nOutlaws Assassin is a Wild West VR shooter blending strategy, stealth, and intense gunfights. Navigate desert towns and saloon showdowns. Upgrade weapons, track enemies with a unique mirror mechanic, and take on diverse missions. Save girls (hostages), rescue friends, take down bosses, and assassinate the devil executioner. Every move counts in the untamed frontier. Become the ultimate gunslinger and face outlaws, bandits, and sheriffs.\n"}]}, "developer_name": "Jb Studio", "developer_privacy_policy_url": "https://sites.
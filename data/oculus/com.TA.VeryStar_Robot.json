ing unlocking method\n!!!The visual performance of the music key is more beautiful\n!!!Through simple interactive with robot character, enter your own music space. Watch your movies at home and listen to music. Immerse yourself in your virtual reality dancing space. By increasing the intimacy, unlock more character, increase playability.Challenge different songs to improve your responsiveness", "short_description": "Through simple interactive with robot character, enter your own music space. Watch your movies at home and listen to music. Immerse yourself in your virtual reality dancing space.Challenge different songs to improve your responsiveness"}]}, "developer_name": "Rick", "developer_privacy_policy_url": "https://www.facebook.com/profile.php?id=100001416224746", "developer_terms_of_service_url": "https://www.facebook.com/profile.php?id=100001416224746", "publisher_name": "Ray Wing Interactive CO., LTD", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100001416224746", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "461456012227459"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001695_1713988438745515_5713017063069450240_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdpAu4iprGQQ7kNvwHBMoAS&_nc_oc=AdnDyhJU5buwJZQ_n-vuU4RshTz5eRNbwM8AVHJcyhwfw9wHA-7PMr4hPb1WDTkpP4A&_nc
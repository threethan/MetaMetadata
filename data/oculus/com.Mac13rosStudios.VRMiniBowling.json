: "migrated_image.png", "id": "604215537102483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974789_2188846638101021_7248977413424545792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pYHm1bXpQsQ7kNvwHBzBbs&_nc_oc=Adp0nwlR1ZEkDHzC4NiaY9wNM7VBLRWTxW1cSaSnZXDuEq6-Qhwl048MgsScrYy3_mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU40uERpvGAovd5bnGBEvKQkgUMAKQTZfdeepeR7lhcNw&oe=6B103B63"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6TfhxJ6UEwQ7kNvwFYsd_n&_nc_oc=Ado2yslV5clqofoHUYhTrgUKDjcn77bmLIt4FjvQ-EoOWOAga-Cqves-888NyZOI3mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhtBCCKgSy8P3Okt4bGLk-3kXaHbFXVIu9EgdQEQWgxw&oe=6B10515D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEry7THUwk4Q7kNvwH5BeEI&_nc_oc=AdqBJtoPzd-LujcSD9Rj0IE_fe13l49jVaHV_YWBMl3KiQb_tnAt5TO-VqBXhnnkmxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUiCeXQGyAX99rklhTTohFQe3cntqvjWq3SGyKIx4e3PQ&oe=6B104F50"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy2tJs0jh-YQ7kNvwHvDDqy&_nc_oc=Adr4g9ZP3Tkam0g8QEl7u4GFbgwo2zmaQSeSlpq-sPFX0iB9qUXvaw2F-TVm7o4b8II&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXbstVsSb8uEI-pv2j8Ow3QaLkv1aOdyqVwO1R_N_uwpw&oe=6B10675C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_inter
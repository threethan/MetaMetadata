DF4F90"}, {"file_name": "migrated_image.png", "id": "1058829561169535", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hy5i1_bA7wQ7kNvwEbWkB2&_nc_oc=AdqJYlo6ZsRISI_7Ksuiy-DYqcsh9UU2p4KHAxTyJjYoCOkbMznt25uqLFw9POt95U8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYj9ksJgX0MeBj0vJyuux828OsmbGJ0VV-a-aQVU7gtA&oe=6ADF679C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/i2ZxAs", "id": "1942050162769488", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974630_1942050166102821_87777359024881664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iJLmeM6jwIQ7kNvwFQUyru&_nc_oc=Adp78llCx_4ArXDs8fkn_e72ARqKsx27QuzMixmxLAqJ3S-dYkRY7_3G7U_M5JT4Dfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdHOQNeSdNQCw6pGXIXL5_JCqcWduecCDMhxcXTTnUqg&oe=6ADF7984"}, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- Personal best statistics for each lane and scoring mode\n- Customizable sound effects\n- Customizable skin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "879246506104427"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2494061143984944", "version": "1.9"}, "id": "1004822186380071", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2180145435376518", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2494061143984944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1004822186380071"}]}, "change_log": "Fixed leaderboard display bug.", "created_date": 1561689664, "id": "2494061143984944", "version": "1.9", "version_code": 10, "release_status": "RELEASED",
rPZzi6YQ7kNvwGM9fap&_nc_oc=AdoP7zX1kIOo8D7J2i-o0K4fHpiAD1YihUV6vaq8cECUUnbgx7FB-F5OrLsg9vgnghg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7iPBsC5CsjxNLnxzIZKZqUOX3Yk7KyPMFFtBlrKT6UA&oe=6A898A23"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSyF5i-WS4UQ7kNvwH-Ulg6&_nc_oc=AdoVpjmFWDxZRiG0_s8vM8-LUTga0tjDwKEuU7A5FMPVAR14CYOPTsB-nOYCJ-MR_gs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbgc1vgKpGiJIZCSvrBUBp67PXVha29DET5tvo6w3kZw&oe=6A89A01D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8Y0ctfH6xIQ7kNvwHcjvGA&_nc_oc=Adq8CI95frygBZ42Lm0-mNhwMkJjoUubkpPy2n7_ri7KBWIpLqpuxrippUMyktFmSo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhcdpltpzvyQCRorFmY_01s5K8QH5TJicEYPrKbC1Vkg&oe=6A899E10"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tx2epA8B_ZkQ7kNvwEPC7md&_nc_oc=Adp1P2T0SAcSX9l37mREL2adFIa0dvesJ1lPzI_I9-kCZp6vnJxVvsYD8Y-C97YHFUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRNSKkGoVpzLXbhZ9WEirxorIiJoMxKVoBJb3H4lsQcg&oe=6A897DDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272910744926829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974859_363687614365706_6395687224117035008_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw-3QH7BZVMQ7kNvwFskj5x&_nc_oc
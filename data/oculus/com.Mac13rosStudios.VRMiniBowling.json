zStmmjMQ7kNvwGsLcDv&_nc_oc=Ado1D777nimebd4yC5PWOaKTNtYTZqpm5tDvS66gQqlcisu7N_L3r6PUT8EAGY4SwuQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRUGHNzi6XHZHGTpnU57h2jCT7qwK-tbqK0uz_SsOQDw&oe=6A804FA3"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_PLvDCBNLMQ7kNvwHg2tF2&_nc_oc=AdpQkYJh3nxHR_JzGdHXmfhHinNzPwZUendtbXCFQL9yp7gprEiOTcnnJ6Sxcgv3gRY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoDH7v4Of6Ls-gsoOaNZwZaWhesaic4sj5tgicplvl8A&oe=6A80659D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH1EgechIq4Q7kNvwFylfma&_nc_oc=AdpzL5Swb6U_izHUtfKzgYBHuR7YU0m2q5Hu16xFRKtl1xyicmMXHDuqeU3EZaBjNg0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzj2_Z3M-NIHgRM7q7fD1Wh6QYfdzIKncM65FcG_m8bQ&oe=6A806390"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOUW_bWZ-7YQ7kNvwFKTzYv&_nc_oc=AdoXovhIcOyVgsVDtNIBn4PmxwryOmCB66Rzhvj_NlnzTt4ihIVTF8Z9o-khcL_vS5k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg0fMYdYlvKrkVeBr1RrnmHswijqD5njx2gQbUK8PebA&oe=6A80435C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272910744926829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974859_363687614365706_6395687224117035008_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5T7DUVdS3EQ7kNvwEoGyKy&_nc_oc
go0e5fQQ7kNvwHseAr7&_nc_oc=AdpBuKU10tlWpVkliGwHXWNPPWlshCT--DEiTPBKmNTy-If3FrrSAUtNIHpkuSSR8g8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkKtrynjueyhTuNj_LtHIbQvkNiXwAYGqEET-OY--Sjw&oe=69CD03A3"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kddpn07MvhgQ7kNvwFNwexc&_nc_oc=AdqGwMreyaG9hkJsuQGQDhCwaY6qNrtOgmZQpdVDpEjoiIWUL1bmbUViDlXG91tPO7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEkwKOYdg4UZcA0TYS4MRVygYuYITMplKhLwejxrAiBA&oe=69CD199D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rci1Hn9as8Q7kNvwEdNnPB&_nc_oc=AdozDJpwiGB4tOTS7fIPh4uzvHuB1LjVnEzi0BGKV2me1jBGw2rBgnnVTcNeIPN_GE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDrISeux8hepYDxxc_Cy1GqIzd6O1jzmuUAYQ5lFGyzg&oe=69CD1790"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0tqhbj6oj0Q7kNvwG8Mt7u&_nc_oc=AdpYfXTqFmzJF7z_CgBcoeM1qh14IC3-l4PXsy4tHJSpWeVdvnPIfuHsuU6salJWe7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIRMAbxFSdknlDaff_1KwELkAlsFwm4wbYFREUcDYZtA&oe=69CD2F9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272910744926829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_363687614365706_6395687224117035008_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT_FENcG_uQQ7kNvwFJpB81&_nc_oc
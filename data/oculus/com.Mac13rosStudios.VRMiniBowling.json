ukt2R5yjvbRFXwAzDvdSP3j8qc6MtAKxK8JLm238WJcAyNSNLaV37mY0nr5_so&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCH1agphCiyFMgQkH4k6KVaMXzlllzzqnUld1i_YEgqA&oe=69B15423"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kWZfxKhMqYQ7kNvwF7lOTB&_nc_oc=AdmA11CdAtRiuBSIgyvnlGPQUPRedQLbQMLYSMhwrdNAt3IvE7q-9WqjAZFPMAwX4pU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDX8d5CPAF1TRFnXybWn4PFIxdj00FPviZSeyVXwtcAQ&oe=69B16A1D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKrY_kWiAEgQ7kNvwEuDk5P&_nc_oc=AdmSEivmUbhTli3t3YnQVG2ETGtQ3VtkmAE-5yUsTDwTRK7NuUxxys5S-xiUXWQpPZI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsMc-I5BmS3g3cqKI97uU5xjwNWHJ5Ku3B_Wr4D8QEHw&oe=69B16810"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0lZ7vvcKcQQ7kNvwFwzDiK&_nc_oc=AdlO4IlnNh_QVFAUv4UHUqGdWdipCL-ww97T5HKIkikgKR73jyRXTO5tSLY56vXM8tQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcRM53RbXLteS34zxjYSp8jIWsWuStsfQtLLuD6sXfpA&oe=69B147DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272910744926829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974859_363687614365706_6395687224117035008_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ql_CULqOnmQQ7kNvwEJZU8K&_nc_oc=Adnq-WUAhH9ehqjzsCJNqrOlI3ouyopbvI6tom7FWGqDf0E
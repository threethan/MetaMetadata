QCtCdsEQ7kNvwEdLaZU&_nc_oc=Adq_A4gP_JNXqye5D1H5TchgOEyfEqXFQtsy8tBhJWdMmZxJDjzl1Hm_mvH5Yed00_8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25FeUHmsFmE6zn2EzO-MX2nui2CKQhk7gOwS1A4UrvBg&oe=69E61023"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCeGHIZMJpMQ7kNvwGQ-bEn&_nc_oc=AdousqBT7nCvLFHnbww1YoUEYO6o7pIbZOKXGi0wXuwIieOXbhEZhDGILYqYCgEq3v0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hhACGFOkgAxCniSNvRRwK72wHludbBrp64AMzcuXMlA&oe=69E6261D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhNkFn84o2QQ7kNvwFk_p0R&_nc_oc=AdruSXSUeb--qRStlbjIOoHc90dcS3y0M7nxQ1ex9O9mYs6R_RkyB0McuLNa26Wt4Ig&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k4sNfvw_ce5cb7wE_BRbsNlaEND6hpSGpfsa9TkfReg&oe=69E62410"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZg27-4Hlz8Q7kNvwH4XyIM&_nc_oc=Adq4jrTRFVqDO7xIWU-KNEz2WCrdpSjrivUIPcJVYER9dRLJ0PleEHCnZRLaPNkAF2Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WRWg-XCQGR-R7vww23vLBK0zMe-Kp6eAIcbMlBZc3Yg&oe=69E63C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272910744926829"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974859_363687614365706_6395687224117035008_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZDUkU6bcu0Q7kNvwF_fpxx&_nc_oc
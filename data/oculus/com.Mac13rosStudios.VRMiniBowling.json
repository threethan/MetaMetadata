-WQJQfghKFREgQ&oe=6A393290"}, {"file_name": "migrated_image.png", "id": "1058829561169535", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad7p975YJGEQ7kNvwGXrwCI&_nc_oc=Adqzxf0tWwlBi83CewzfE_szcWilWBO47qjjdvPUb_ZgacEYZOc5QL-nyNJuepfFzhQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VFQFhhiVhK1ePa-0--eqDClZph97-Gl31c5qLfW8iZw&oe=6A394A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/i2ZxAs", "id": "1942050162769488", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974630_1942050166102821_87777359024881664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isjwyXtEsykQ7kNvwF0R1h2&_nc_oc=Adoc2B5qFKbc_9cJ-dsibQK1ScuHWfUp_PUc-BdZ8zWOrSlza9E4hq_XXYgtrj0nGFA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UYZk6g7gDPnHElwn--jiWCuPDHkrkSka-9S4bzEJi0w&oe=6A395C84"}, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- Personal best statistics for each lane and scoring mode\n- Customizable sound effects\n- Customizable skin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "879246506104427"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "539090003614387"}, {"status": "PUBLISHED", "id": "242466636660037"}, {"status": "PUBLISHED", "id": "354200575619872"}, {"status": "PUBLISHED", "id": "154328596016615"}, {"status": "PUBLISHED", "id": "305543953412558"}, {"status": "PUBLISHED", "id": "2274315959315308"}]}, "baseline_offer": {"id": "305543953412558"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1577250000, "status": "PUBLISHED", "id": "539090003614387"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2494061143984944", "version": "1.9"}, "id": "1004822186380071", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "218
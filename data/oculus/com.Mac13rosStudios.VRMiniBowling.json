: "migrated_image.png", "id": "604215537102483", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974789_2188846638101021_7248977413424545792_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FxTmuB7dgoQ7kNvwGZQSMn&_nc_oc=AdrRi6a2fQplukQPYjZ3BbyUM-35ycpSKGwmNmCMoOgN7YUJH9P9b2r03Z0uMWNCftI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhvo7CjTfhrsOYBhSOLRfN6zx51A00DOlRGXAT_82Ffw&oe=6B006963"}, {"file_name": "migrated_image.png", "id": "1499896166856585", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974450_352706941958280_5977639524413472768_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oov_tZEV1zQQ7kNvwG6fBMe&_nc_oc=AdpSVMcBQXl134R_uohUsoRJ7VyiK9_sAB3VByxNE6ueaLKUVSK_hmLbNSpE2AW6l_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRq_tPNHc_vqBQBlNzXPhzMabMQ4oASSk3QQXJ6rVf7A&oe=6B007F5D"}, {"file_name": "migrated_image.png", "id": "529130371347788", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982655_758654184498252_4588748805712642048_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTYL8wiI6zoQ7kNvwGc-M3t&_nc_oc=Adoj6esbgvtzB_V4yH9eoY2Pu4o4Iunl98g4SRnCoI-u56bX7TkTFFnffFshSq7dWEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyOHf9523BvPKdfCi15Kf1U3LO0pL74EuNCi5jd0VfWA&oe=6B007D50"}, {"file_name": "migrated_image.png", "id": "146428790027337", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974540_1006289679517978_5227941115902033920_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHrF4odLBI4Q7kNvwHVJGz-&_nc_oc=AdpnfIao3EIFKEc51wx_ghOdyNepvj8enlowMzxeWo1wO9cD6Yh8JcwqtmmxmK_ZnI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvj5rirckevlvjZr7LOcRJWtSbz73urT2JjNOUrxF1lQ&oe=6B005D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Mini Bowling", "keywords": ["Bowling", "Golf", "Mini", "Sports", "VR"], "long_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!\n\nKey Features:\n- 3 Scoring Modes\n- 3 courses with 10 unique lanes each\n- Traditional bowling lane with realistic physics (spin, oil patterns)!\n- 24 bowling balls to choose from (16 unlockable)\n- Customizable sound effects\n- Customizable pin colors\n- Anti-gravity pins\n- Throw force multiplier\n\nStandard Mode:\nIn this game mode, normal bowling rules apply.  Try to get the highest score possible!\n\nStroke Play Mode:\nThis mode will put your skills to the test! The goal is to knock down all of the pins in as few throws as possible.\n\nRush Play Mode:\nSpeed is the key in this mode.  Knock down all of the pins as quickly as possible!  You get unlimited throws in this mode so fire away!\n\nTraditional Mode:\nFeel like changing it up and playing a regular game of bowling? You can! Put spin on the ball to curve it down the lane, and even change the oil pattern on the lane!", "short_description": "Welcome to the world of Mini Bowling!  In this VR game bowling meets mini golf to create a totally new experience!"}]}, "developer_name": "Brian Macumber", "developer_privacy_policy_url": "https://mac13rosstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Brian Macumber", "support_website_url": null, "website_url": "http://mac13rosstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_inter
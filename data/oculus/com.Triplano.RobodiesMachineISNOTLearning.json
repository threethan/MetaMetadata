oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg0_GzIRAfrftip5KFsmTyqpwucJH_D15s07pSHkVW5Q&oe=6AF488DD"}, {"file_name": "04-fighting.png", "id": "943246621553215", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673658581_943246624886548_7601207796754094745_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTiRV4xz7PMQ7kNvwG8U6KS&_nc_oc=AdpAUIN5pTt2Ed7H1Ap7YZn4JU2tQbd3gLW5EumnMfc_tEwesJB0zQcuU9byFwFQ-J4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAWGTv-J9pPe1lhM7wJkEQumdh3A8Nj9Ef4tunJC2BcQ&oe=6AF48432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Robodies-Ethan-landscape.png", "id": "1032130653195813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_1032130656529146_8484072912005874501_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFhufoLaO6oQ7kNvwFFu3Jv&_nc_oc=AdqU5HbSCyXBPU4tJQyOkr1Cdae8wASIYh5RjX7QGosloWwjRmDoB2ZiYJZ1u84PfBo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3O8MiKJrWwTrLgT33-HK9Abhjvx9-VJP0UgbLMF-3PQ&oe=6AF48DB3"}, "display_name": "Robodies: Machine IS NOT Learning", "keywords": [], "long_description": "Step into the shoes of the grumpiest teacher alive, tasked with educating a classroom full of AI robots that\u2026 somehow forgot how to behave. They raise their hands, get distracted, fight, freeze, panic \u2014 and you are the last thing standing between order and total mechanical mayhem.\n\nYour mission? Teach them manners using\u2026 let\u2019s say\u2026 very unconventional methods (absolutely not approved in real schools).\n\nWelcome to the most insane VR classroom ever created.\n\nControl the Classroom\u2026 or Watch It Explode Into Chaos\n\nFulfill robot requests before their patience runs out \u2014 or brace yourself for total meltdown.\n\nWrite on the board, hand out books, and throw chalk to keep their attention (old-school tactics still kind of work).\n\nGive misbehaving Robodies a good slap to reset their behavior \u2014 it\u2019s wrong, but oh, it works so well.\n\nBreak up fights, wake up sleepers, and repair broken robots before things spiral out of control.\n\nGrab, drag, or even toss disruptive robots, but be warned: unfair treatment might send them back possessed\u2026 and very eager for revenge.\n\nEvery minute of survival is a miracle. Every completed lesson is a legendary victory.\n\nWhy You\u2019ll Love Playing Robodies\n\nFast-paced, frantic gameplay that keeps you constantly on your toes.\n\nA unique blend of chaos, classroom management, and slapstick physics only possible in VR.\n\nHigh replayability: no two lessons are ever the same.\n\nThe perfect game to laugh and create unforgettable moments to share with friends.", "short_description": "Robodies: Machine IS NOT Learning is a chaotic VR classroom sim where you teach misbehaving AI robots by answering demands, throwing chalk, and slapping sense into them\u2014before they glitch out or start fights!"}]}, "developer_name": "Adaga Studio & Triplano Games", "developer_privacy_policy_url": "https://adagastudio.com/cases/robodies/politica-privacidade", "developer_terms_of_service_url": null, "publisher_name": "Adaga Studio", "support_website_url": "https://adagastudio.com/cases/robodies/politica-privacidade#support", "website_url": "https://www.adagastudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8730300190330331"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3075665402775769"}, {"status": "PUBLISHED", "id": "1589089969522680"}, {"status": "PUBLISHED", "id": "2228845764648793"}]}, "baseline_offer": {"id": "2228845764648793"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "3075665402775769"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29425733763693671", "version": "1.1.0-book-repair"}, "id": "1859666321212656", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8730300173663666", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29425733763693671"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1859666321212656"}]}, "change_log": "Improved wrench and book grabbing, safer desk collisions, and more reliable book delivery. Delivered books return to the teacher desk after three seconds. Routine robot breakdowns are less frequent. Watch controls appear sooner, respond to quick taps, and sit closer to the watch face. Improved prop highlights, object returns, deliberate-hit detection, classroom discipline, and music recovery.", "created_date": 1789321726, "id": "29425733763693671", "version": "1.1.0-book-repair", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8730300173663666", "is_concept": false, "latest_released_binary": {"__typename": "
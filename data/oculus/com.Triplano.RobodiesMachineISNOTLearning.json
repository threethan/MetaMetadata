8480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1789119480, "lastRevision": {"nodes": [{"id": "8730300203663663", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8730300173663666", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "503243972623982"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1651300705663018", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Robodies: Machine IS NOT Learning", "keywords": [], "long_description": "Prepare-se para viver o inferno em uma sala de aula ca\u00f3tica causada por rob\u00f4s rebeldes. Com uma experi\u00eancia \u00fanica de gest\u00e3o do tempo, voc\u00ea vai viver na pele o desafio de um professor em manter a ordem numa sala de aula onde s\u00f3 tem baderneiros. \n\nEscolha uma mat\u00e9ria, passe o conhecimento, atenda as demandas das m\u00e1quinas e garanta que elas v\u00e3o aprender o conte\u00fado. Voc\u00ea tem apenas 5 dias para passar todas as mat\u00e9rias e garantir que eles passem no exame final.\n\nSe as coisas sairem do controle, use sua criatividade ou o que estiver em sua frente. O seu temperamento \u00e9 quem decide!", "short_description": "Mantenha a ordem em sala de aula enquanto educa rob\u00f4s rebeldes a se comportarem em sociedade. A sua paci\u00eancia e habilidades de gest\u00e3o do tempo ser\u00e3o constantemente testadas. Voc\u00ea conseguir\u00e1 controlar a sala ou deixar\u00e1 virar um campo de batalha? Seu temperamento \u00e9 quem decide."}, {"images": {"nodes": [{"file_name": "Robodies-Rachel-icon.png", "id": "1975602212998200", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/613051964_1975602216331533_23
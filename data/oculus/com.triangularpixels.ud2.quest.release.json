1-7&_nc_sid=6e7a0a&_nc_ohc=9BVv9DY0VX4Q7kNvwGnVsH_&_nc_oc=Adnxj8N6cEfFcRjRfrr5kyaU-_fBj-5EIC1d66cooiXRMGI0J8IyerxIm8qTxq5XwYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxXJTA3XHwRv_MlNdmvpOd__Q1epOVD6aVzDNn6Zb81Gg&oe=69B54430"}, {"file_name": "UD2_Screenshot_Release_C.png", "id": "4163993017163408", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311622_4163993020496741_6568932699684941552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKW5qU4EyusQ7kNvwEDNcLx&_nc_oc=AdliD8dPgoK6ddWlNNrbf5sbri3n0SxBdl73Ww3y6GqDbOghf-PWYUtuF5QTIbJIlog&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDHrPvczmdhOc0A2LJOfSm4uJwoyejZ7QEq7o9-WIUXA&oe=69B56F2F"}, {"file_name": "UD2_Screenshot_Release_D.png", "id": "1026651396261779", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473400248_1026651399595112_1624267574914006045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb9ugGVsVp4Q7kNvwEThbY0&_nc_oc=AdlcOFtuzm1scvJb3vJEtqx3ibIBK_aSZjdfeUWlql1q3z0z4JdmNNBNDlcFh8wFTBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD8flOtzCdTBzygGHJ0Hf067iPyGtDhLIj4vFrdu7ztA&oe=69B56890"}, {"file_name": "UD2_Screenshot_Release_E.png", "id": "682993251036729", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302250_682993254370062_6508281382540723543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs5h29mwpoMQ7kNvwGEJ82Y&_nc_oc=AdnkQsgLPOlQXI5YCoLHKT-fr_iYsY375uiQihviBfa279c1jlgsyzBPOh5X_VtKHfE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRe0BDEu-1PP3Ax3m2k_hLz8dBgZcslJeyHeL07I8fNQ&oe=69B56837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1679208136042793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302400_1679208139376126_7962684221646588575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfsZxmPIF1EQ7kNvwH8eKwq&_nc_oc=Adnq-2l8ecSvIZiSAyGHKFzGTmftKO_1kAlygpLEWfi7W8WnKG0ZntdgFxHSMSepcEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwu3TcdrY7WaM4CRX_L4mJVrp4RaWZ39y1C_BKLqGhdsQ&oe=69B55598"}, "display_name": "Unseen Diplomacy 2", "keywords": ["Spy", "Stealth", "Redirection", "Espionage", "Infiltration"], "long_description": "Unseen Diplomacy is back with a brand-new campaign, missions, gadgets, and threats! Take on the role of elite agents working together to uncover evil plots and stop doomsday, all while fully immersed in your own living room.\n\n{2231867857319986}\nOur unique environmental redirection tech lets you physically walk, crawl, roll and sneak through your room, transforming your space into sprawling virtual environments. No fake locomotion needed\u2014just full-body action that feels like a real-world assault course. Track your physical activity with Spy Stats!\n\n{1216610413110334}\nBig or small room? Seated or standing? Optional locomotion, enhanced reach, and accessibility settings let you play your way\u2014no step forward required.\n\n{2707047959485324}\nChoose where to investigate, complete challenging missions, gather intel, and uncover who\u2019s behind the global threat. Time is ticking\u2014position your agents wisely before the final showdown!\n\n{1178630620662225}\nEquip classic spy tools\u2014each with their own strengths\u2014and don disguises with perks like extra pockets or health. But watch out: the enemy has upgraded too, with bots, traps, and surprises ready to stop your mission cold.\n\n{1181185986653252}\nEnjoy a stunning comic-book art style and replayable handcrafted levels that adapt to your space, ensuring every mission feels fresh and fun.\n\n{1251594909656517}\nBlend the real and virtual with MR! Be challenged with lasers, crushers, Ai and all the threats in between\u2014perfect for showcasing your skills to others in the room.", "short_description": "You're a secret agent during a dangerous time, evil-doers are plotting to destroy the world. Complete missions, manage your agents & use Intel to narrow down the plot & save the Earth. Play a real-life VR obstacle course using every inch of your room - run, roll, sneak & hack to victory! And exclusive to Quest 3 & 3S, enjoy Unseen Diplomacy 2 in Mixed Reality with those threats now in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://triangularpixels.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Triangular Pixels", "support_website_url": null, "website_url": "https://triangularpixels.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10082574418431071"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1300923597731506"}]}, "baseline_offer": {"id": "1300923597731506"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758819600, "status": "PUBLISHED", "id": "1300923597731506"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25640847628843832", "version": "0.4.1"}, "id": "1426167174503621", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5153488951339667", "is_concept": false, "lates
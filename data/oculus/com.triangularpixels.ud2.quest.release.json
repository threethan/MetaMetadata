0496741_6568932699684941552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TOvyrNodgwQ7kNvwGzP66D&_nc_oc=AdmFTgQXzAnArG89dj1pC-rjdzGXB1AbB6HnfFf2TAwzsyqjLeLUWmZuG2H6qP5Y1ZY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0jnQStL6xCcM8JhTGNAd7FIz4fUMRx613ntV_ZPWPTA&oe=69BAB52F"}, {"file_name": "UD2_Screenshot_Release_D.png", "id": "1026651396261779", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473400248_1026651399595112_1624267574914006045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtU7SbIieekQ7kNvwEGFC2e&_nc_oc=AdlasE9AMzXaOet1beaNURfySOcWCmc2xh6bK4L3y9jNRJviMC-GrAZNUYRxV8tVn8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygTCr4v7jZ33uidklY7Z0VrENdbQceU6riibBI5ZO39w&oe=69BAAE90"}, {"file_name": "UD2_Screenshot_Release_E.png", "id": "682993251036729", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499302250_682993254370062_6508281382540723543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPgYbkNFsj0Q7kNvwGmq9iU&_nc_oc=AdmhM0-iKmJtFeOfc16uBzxBx4Psch1nhI4vzTp6W9e4p19WAmTr0Q_2XQpVLo8LgO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxi87Rn-XfkQLNbv7-XvDgPBMS19hvLSt9X7ukS-B4mlg&oe=69BAAE37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1679208136042793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499302400_1679208139376126_7962684221646588575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHm0nwKKQCUQ7kNvwFCO3JB&_nc_oc=AdlWsnp9M9g0S3qHV0ZXxcIAb5GlqpfNAlEiFCIamyiyyI_iW1nAotqJriMfLqENwko&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMoj9WD-nzURjpkcblQ8NfVgRjS0lLv-SDWScCJbdREA&oe=69BA9B98"}, "display_name": "Unseen Diplomacy 2", "keywords": ["Spy", "Stealth", "Redirection", "Espionage", "Infiltration"], "long_description": "Unseen Diplomacy is back with a brand-new campaign, missions, gadgets, and threats! Take on the role of elite agents working together to uncover evil plots and stop doomsday, all while fully immersed in your own living room.\n\n{2231867857319986}\nOur unique environmental redirection tech lets you physically walk, crawl, roll and sneak through your room, transforming your space into sprawling virtual environments. No fake locomotion needed\u2014just full-body action that feels like a real-world assault course. Track your physical activity with Spy Stats!\n\n{1216610413110334}\nBig or small room? Seated or standing? Optional locomotion, enhanced reach, and accessibility settings let you play your way\u2014no step forward required.\n\n{2707047959485324}\nChoose where to investigate, complete challenging missions, gather intel, and uncover who\u2019s behind the global threat. Time is ticking\u2014position your agents wisely before the final showdown!\n\n{1178630620662225}\nEquip classic spy tools\u2014each with their own strengths\u2014and don disguises with perks like extra pockets or health. But watch out: the enemy has upgraded too, with bots, traps, and surprises ready to stop your mission cold.\n\n{1181185986653252}\nEnjoy a stunning comic-book art style and replayable handcrafted levels that adapt to your space, ensuring every mission feels fresh and fun.\n\n{1251594909656517}\nBlend the real and virtual with MR! Be challenged with lasers, crushers, Ai and all the threats in between\u2014perfect for showcasing your skills to others in the room.", "short_description": "You're a secret agent during a dangerous time, evil-doers are plotting to destroy the world. Complete missions, manage your agents & use Intel to narrow down the plot & save the Earth. Play a real-life VR obstacle course using every inch of your room - run, roll, sneak & hack to victory! And exclusive to Quest 3 & 3S, enjoy Unseen Diplomacy 2 in Mixed Reality with those threats now in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://triangularpixels.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Tr
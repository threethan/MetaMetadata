0496741_6568932699684941552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TOvyrNodgwQ7kNvwH9BIY4&_nc_oc=Adl4p7aUSQoxFmHRLKHAuZIkSa7v6bQaMd04V843MXNHJhFHuc90ooC8Ub_e0qCgjsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWgLh7rEBAO5G8r4I70_2vaBGho-gK4obx_eNOhGtqIg&oe=69B8122F"}, {"file_name": "UD2_Screenshot_Release_D.png", "id": "1026651396261779", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473400248_1026651399595112_1624267574914006045_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=174UITgxDmMQ7kNvwEkkOC1&_nc_oc=AdkZHIY4Og9r3t1U_0WFPqpslPOXhjD4iPDIYWH-uqVw-rZH1K-JOmBLkAXJHXC8qQ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyZTmEGM4e9O85Ic70zkcaUBpK3yConiZ_2Xwu4wbfTDw&oe=69B80B90"}, {"file_name": "UD2_Screenshot_Release_E.png", "id": "682993251036729", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499302250_682993254370062_6508281382540723543_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs5h29mwpoMQ7kNvwEzLEcx&_nc_oc=Admfk93N-RVy3b89kSlp60-QvdBbPfuAcCqxCpmGFFQ_-l5dMvAM5Cm400jrv6RkxuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxM_kZ8FOizhDJ6W_0z5yhXTuy9ASvgsnylrPQ9rLCUcw&oe=69B80B37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1679208136042793", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499302400_1679208139376126_7962684221646588575_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW0CosP4RgEQ7kNvwEFusmE&_nc_oc=AdnPodo2ZkI03hkoWGTohGqU_rDLJweHs-5QnL26kj_d4adqQLOGwhBAP7-aG5oyo5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVnBETSWAdQmqJVAqQT8YxKy0kxz3pHUswOfi2FenQjQ&oe=69B7F898"}, "display_name": "Unseen Diplomacy 2", "keywords": ["Spy", "Stealth", "Redirection", "Espionage", "Infiltration"], "long_description": "Unseen Diplomacy is back with a brand-new campaign, missions, gadgets, and threats! Take on the role of elite agents working together to uncover evil plots and stop doomsday, all while fully immersed in your own living room.\n\n{2231867857319986}\nOur unique environmental redirection tech lets you physically walk, crawl, roll and sneak through your room, transforming your space into sprawling virtual environments. No fake locomotion needed\u2014just full-body action that feels like a real-world assault course. Track your physical activity with Spy Stats!\n\n{1216610413110334}\nBig or small room? Seated or standing? Optional locomotion, enhanced reach, and accessibility settings let you play your way\u2014no step forward required.\n\n{2707047959485324}\nChoose where to investigate, complete challenging missions, gather intel, and uncover who\u2019s behind the global threat. Time is ticking\u2014position your agents wisely before the final showdown!\n\n{1178630620662225}\nEquip classic spy tools\u2014each with their own strengths\u2014and don disguises with perks like extra pockets or health. But watch out: the enemy has upgraded too, with bots, traps, and surprises ready to stop your mission cold.\n\n{1181185986653252}\nEnjoy a stunning comic-book art style and replayable handcrafted levels that adapt to your space, ensuring every mission feels fresh and fun.\n\n{1251594909656517}\nBlend the real and virtual with MR! Be challenged with lasers, crushers, Ai and all the threats in between\u2014perfect for showcasing your skills to others in the room.", "short_description": "You're a secret agent during a dangerous time, evil-doers are plotting to destroy the world. Complete missions, manage your agents & use Intel to narrow down the plot & save the Earth. Play a real-life VR obstacle course using every inch of your room - run, roll, sneak & hack to victory! And exclusive to Quest 3 & 3S, enjoy Unseen Diplomacy 2 in Mixed Reality with those threats now in your living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://triangularpixels.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Tr
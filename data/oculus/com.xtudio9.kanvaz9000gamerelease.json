3868_2837147585257716785_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7FH6aPrQosQ7kNvwFl22VS&_nc_oc=Adr_YLwhSHP_1kp63BvKIkwFrlcAhTESiWyrUtEtEO5X_IyHFy7BLV0bg2mulhakdyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6l8dabCACzyndB6pqa3gnszGtifgKqFn9EMI7T8NjJA&oe=6A5B86F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "987855227103410", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_987855230436743_1667690147683302764_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpN2xPqbdJoQ7kNvwFnReMO&_nc_oc=Adqjt4RWDOq6Ss7DWEf8T-H7yqGT46kCAM245ftRxAuGmwDsXKdAtJm5tryGLDiSwiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6fKu7G_kfkePxiCiRSFFYZ_h1nRAs6W5UGmPTbN5sNw&oe=6A5B8134"}, "display_name": "Kanvaz", "keywords": ["painting", "coloring", "relaxing", "art", "paintbynumber"], "long_description": "Kanvaz is an easy and satisfying paint-by-number experience designed for relaxation and short sessions.\n\nChoose a template, follow highlighted zones, relax, and bring your masterpiece to life - no skill required.\n\nAuto-correction system: your strokes snap perfectly into place - fast, effortless, and impossible to mess up (you can disable the auto-correction system to play without support if you want extra challenge).\n{2485077265240201}\n\nCreative Freedom: you can still adapt the artworks to your own style\n{820673347777876}\n\n80-artworks pack, across a variety of themes\n{2158152335045372}\n\nRelaxing environments: 5 different moods, and passthrough mode\n{988961566892343}\n\n", "short_description": "An easy, satisfying, and relaxing paint-by-number experience. Choose a template, follow highlighted zones, and create beautiful art - no skill required."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Kanvaz-Privacy-Policy-344d2dcc8f9580298830e4374505ecdf", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz St
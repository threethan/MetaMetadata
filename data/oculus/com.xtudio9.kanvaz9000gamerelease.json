73868_2837147585257716785_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibxNWdHbEpwQ7kNvwH7zDpj&_nc_oc=AdqdMKCqV7_GQTWuFOaF5Lu8eBRJEaX2lZB2jBRceOxzinbu6wY_gDSdrWVh7gYpw1A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J3p1bFtEHztTwo9QZ9iOo9IjngEFtRJxC4oYQ7jDaYA&oe=6A300571"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "987855227103410", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618288_987855230436743_1667690147683302764_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OObtKQcpqoQ7kNvwHCS5E6&_nc_oc=AdrOlYCg8W4RPn1z3bVEeEODbdjgi0iEYPiVjJ6Ty9hKGH8iNoPN0wI1U_E-zUZHUUU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-irt6Z1azcXMIa05eRsOQMfvf_I62q7j2i0V7dNJnbWw&oe=6A2FFFB4"}, "display_name": "Kanvaz", "keywords": ["painting", "coloring", "chill", "cozy", "relaxing"], "long_description": "Kanvaz is an easy and satisfying paint-by-number experience designed for relaxation and short sessions.\n\nChoose a template, follow highlighted zones, relax, and bring your masterpiece to life - no skill required.\n\nAuto-correction system: your strokes snap perfectly into place - fast, effortless, and impossible to mess up (you can disable the auto-correction system to play without support if you want extra challenge).\n{2485077265240201}\n\nCreative Freedom: you can still adapt the artworks to your own style\n{820673347777876}\n\n80-artworks pack, across a variety of themes\n{2158152335045372}\n\nRelaxing environments: 5 different moods, and passthrough mode\n{988961566892343}\n\n", "short_description": "An easy, satisfying, and relaxing paint-by-number experience. Choose a template, follow highlighted zones, and create beautiful art - no skill required."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Kanvaz-Privacy-Policy-344d2dcc8f9580298830e4374505ecdf", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio",
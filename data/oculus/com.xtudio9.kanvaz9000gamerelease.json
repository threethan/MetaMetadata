6613918573868_2837147585257716785_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dnQDu0kO3sQ7kNvwGjlEqn&_nc_oc=AdpzZ39L1QcF3nUTHUQF9hnJAfLim0Nc2sqOWuO06_B2ByMPXdkmbS_1CuDxXqD90C0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_L2u05HqXNqjzExzAkcZLno5YZoT2cpq5m4zGEZsjlCA&oe=6A22D671"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "987855227103410", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618288_987855230436743_1667690147683302764_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfqLzkoQ9cQQ7kNvwHcWeS3&_nc_oc=AdoaDPNTxmxkkwaf0EFlVqOn39Iijqvd20HaXCN8nu31rohQ-61lzA7XNdwEiTVHjTk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qTpys0mVhuHeVXA0XG3cBtLCwmAZVOZdkRCn8ucw_RA&oe=6A22D0B4"}, "display_name": "Kanvaz", "keywords": ["painting", "coloring", "paintbynumber", "relax", "unwind"], "long_description": "Kanvaz is an easy and satisfying paint-by-number experience designed for relaxation and short sessions.\n\nChoose a template, follow highlighted zones, relax, and bring your masterpiece to life - no skill required.\n\nAuto-correction system: your strokes snap perfectly into place - fast, effortless, and impossible to mess up (You can DISABLE the auto-correction system to play without support if you want extra challenge).\n{2485077265240201}\n\nCreative Freedom: you can still adapt the artworks to your own style\n{820673347777876}\n\n80-artworks pack, across a variety of themes\n{2158152335045372}\n\nRelaxing environments: 5 different moods, and passthrough mode\n{988961566892343}\n\n", "short_description": "An easy, satisfying, and relaxing paint-by-number experience. Choose a template, follow highlighted zones, and create beautiful art - no skill required."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Kanvaz-Privacy-Policy-344d2dcc8f9580298830e4374505ecdf", "developer_terms_of_service_url": null, "publisher_name"
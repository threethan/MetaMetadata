3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAdbXxubM1BfOvZQGwnYEYXWN3s-VjM9qJCzPgHo__xg&oe=6B070C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "969937808726384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_969937815393050_9089291119168794541_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJY3lwVmgdMQ7kNvwE71hDL&_nc_oc=Adp6Pd3QTXOWmVTpqmx88VYTrwQ42sejgPM3-XHruc4Rqfft2ij6qgHFazK_k7Vrr5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt5IJd7HlOZuGfDdVAp72g7PoXfuk3gKYGZNYSGwZ4OA&oe=6B071F8F"}, "display_name": "Kanvaz", "keywords": ["painting", "coloring", "relaxation", "art", "mindfulness"], "long_description": "Kanvaz is not a complex painting simulator - it's a guided, easy, and relaxing paint-by-number experience designed for mindfulness and casual play.\n\nSimply choose a template, follow highlighted zones, stay in the flow and watch your painting come to life - no skill required.\n\n---\nKEY FEATURES\n\nAuto-correction system: align your strokes precisely within the zones - filling fast, effortless and impossible to mess up\n{2485077265240201}\n\nRelaxing environments: 5 different moods, designed for calm and focus\n{988961566892343}\n\n36 hand-crafted paint-by-number templates, in various topics\n{27040670372197709}\n\nand more to come..\n\n", "short_description": "A guided, easy and relaxing paint-by-number experience where anyone can create beautiful art effortlessly. Choose a template, follow highlighted zones, and watch your painting come to life - no skill required."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Kanvaz-Privacy-Policy-344d2dcc8f9580298830e4374505ecdf", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_
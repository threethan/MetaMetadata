=6e7a0a&_nc_ohc=_K5WOjjFT2kQ7kNvwGNHZB7&_nc_oc=Adrr3NkB29HEz6cif2KpVWwchlwmK3XcXdJvKDPlv_uWyZ85Z7sQJ3xck-ckbKzTCzQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qezI1-0XN3Ln9876e92oUpfwxTRu75G4HOvPGia4iTw&oe=69ECCE9D"}, {"file_name": "da334f27c2df9e34b98450d101644c07.png", "id": "2407233919785329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617850_2407233926451995_5757447927095772496_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQ9vLuM0DDwQ7kNvwGcCI6X&_nc_oc=AdpbwzG76bHDE8WKJISD2C_A8t5pttlOoRysX8Nc_TwNvzFiRFiXi53z1YMYVqFBxac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uYfiEzgdU_6XIA_Z9mudlzbEHnuZXrpsCVKR8noXJTQ&oe=69ECB317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "7.png", "id": "969937808726384", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_969937815393050_9089291119168794541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTEQJO3q8wsQ7kNvwHVYhNe&_nc_oc=AdpdbxkF_zJAmc-afZwNz6-DMZ0VKV7eee3Uxi22g7ryCeOd2zby7q1fRLYAAqt3_4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UZxgcKqrAhohhFzHBnRjJYLbUyqd-_ECNtyuMQ6ThzQ&oe=69ECC64F"}, "display_name": "Kanvaz", "keywords": ["coloring", "relaxing", "mindfulness", "painting", "cozy"], "long_description": "Kanvaz is a easy, guided, and relaxing paint-by-number experience designed for mindfulness and casual play.\n\nSimply choose a template, follow highlighted zones, stay in the flow and watch your painting come to life - no skill required.\n\n---\n\nKEY FEATURES\n\nAuto-correction system: align your strokes precisely within the zones - filling fast, effortless and impossible to mess up\n{2485077265240201}\n\nRelaxing environments: 5 different moods, designed for calm and focus\n{988961566892343}\n\n36 hand-crafted paint-by-number templates, in various topics\n{27040670372197709}\n\n\n", "short_description": "A guided, easy and relaxing paint-by-number experience where anyone can create bea
68794541_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3simeDJACvQQ7kNvwEuAni7&_nc_oc=Adq3Xf1D2-G-_jtVErROASSntSnmd2wXaymWk8BAac7Aw9SSYb5hwdGgcZQmdcj6qk8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK__BakWlLyOH6cLiPV7clwZBpIn5VLHkByedEzUfwPYQ&oe=6AA94CCF"}, "display_name": "Kanvaz", "keywords": ["painting", "coloring", "relaxation", "art", "mindfulness"], "long_description": "Kanvaz is not a complex painting simulator - it's a guided, easy, and relaxing paint-by-number experience designed for mindfulness and casual play.\n\nSimply choose a template, follow highlighted zones, stay in the flow and watch your painting come to life - no skill required.\n\n---\nKEY FEATURES\n\nAuto-correction system: align your strokes precisely within the zones - filling fast, effortless and impossible to mess up\n{2485077265240201}\n\nRelaxing environments: 5 different moods, designed for calm and focus\n{988961566892343}\n\n36 hand-crafted paint-by-number templates, in various topics\n{27040670372197709}\n\nand more to come..\n\n", "short_description": "A guided, easy and relaxing paint-by-number experience where anyone can create beautiful art effortlessly. Choose a template, follow highlighted zones, and watch your painting come to life - no skill required."}]}, "developer_name": "Kanvaz Studio", "developer_privacy_policy_url": "https://notasquare.notion.site/Kanvaz-Privacy-Policy-344d2dcc8f9580298830e4374505ecdf", "developer_terms_of_service_url": null, "publisher_name": "Kanvaz Studio", "support_website_url": null, "website_url": "https://www.youtube.com/@kanvaz-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommen
.oculuscdn.com/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn8wV8lV-WwQ7kNvwHi29ep&_nc_oc=AdoG-qB_4S1HWTxWKLRQvpOTc6qW-y1b4_C32wmk0KrKBmlwPVs7BOER7Vl7iShHBWY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbkIBn0JnbEuSbkZl_5uzRN-Ng0ADJU0towwo4e2d6cw&oe=6A8D873E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-OT8ZmAwAcQ7kNvwFN5U9z&_nc_oc=AdpF3sv2Sh9q_3bEI-_cr_inWcKcPVa43z3RhexqUKgukNM5su31Dj7mhALtsntqQDk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUXzqYwCHu94G_FeyqJcB__X9yjttb692UHcTl4w_esQ&oe=6A8D8F92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QtiXbhG1IEQ7kNvwHDEyYS&_nc_oc=AdogHmnO_Tw9NhHfSJqSFYVKjU0bTKrng_7PCQWMBZQO0uLGgQo_iPLMGN8twJa3TSA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMzHpItnUWnOnk-OPeDGTg5NQPJCbkG5pRUp74g89CYg&oe=6A8D94AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjkfit2npGgQ7kNvwGDgt60&_nc_oc=Adre7i2on9WKWLpspU-1zcLR2mtTa1ggEkx9qIJFeKV20EJPB7BQ_62EDy1rRzSnUR8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGewPIsvlRRZVJWgNa3n7eifH58m0IcjXIIJtFgrXpHfg&oe=6A8D81A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPUl6OB6oqQQ7kNvwGQFeOK&_nc_oc=AdqvxRt8KmeE36JboF73yOIimiD884Mb5csMvSf9EbstpaZZZz31sbXFcR1BLpfPiMc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK7WprM2VB6zFfRwx0dJAq8ele6NdPikpJjmNJ5uPFcw&oe=6A8D7505"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "externa
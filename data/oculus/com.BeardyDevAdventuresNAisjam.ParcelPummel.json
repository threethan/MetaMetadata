rNaMI9t6NdG-qik9ena0HlrBRsqd-9SKHm3sTDZCCBk3BfDagJ0NRnq0s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS9lrt-mwyZBZMEgw0R14fXxgc6tzSCSxN_ciFUesqNg&oe=69BE8BBE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNJUucRQjGEQ7kNvwFr_lcS&_nc_oc=AdlzzKqhDBQE2sH9FIrr-qvHthxi-50dFiETeQGSEmDlfdLOrfMWPTlueFqrLkny7R8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4zHrbQq5WA0mw4YDnjFvqjiJ--h6Op0O0b5t4uLhvHQ&oe=69BE9412"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQRgXn-OAHUQ7kNvwF3Th4U&_nc_oc=AdkrOIISc1x_cbks0BpzyS_OHfEAJSKER5ppBXWvOYGqTNkNstqEyZZdDp1ghpRCo_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwF5oXJCCFExbc1W6cYH20zwrlUHXfD7cHYZu-CbjuX-Q&oe=69BE992E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4xvncPvnTUQ7kNvwHSrKBV&_nc_oc=AdmRipGt0XChpQaHow3s2rx6LiTF_RrF2FoVxq1DcEwp8VOaRxGO-1YNOxU2SkcJu4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxs8hSuR5dFsKixLnN_34crCiBWYmrxINSYWvK4zfbFmA&oe=69BE8623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcjKkRiazuAQ7kNvwGP7zvF&_nc_oc=AdmhBql568iP1nuY7Mcv7-31jrD3P_dLw4585tn0GpKL2f50-ws7v0D7dkbaye0I3XM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxIMlB6LqpctjuwML_mJ8U5wn1vKwkRYjsaniFOjPLJg&oe=69BE7985"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
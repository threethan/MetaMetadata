m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5-ortBtE-IQ7kNvwFP99Ak&_nc_oc=AdqsgswFu5aOiGXQw6NI8avdpynHjZHZhjohgDSVVYHsLeA2Hb_CcRLvLIhovh5r8j0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBYXZ-4J9orK8mzhTw9bnQ2hGfmzp48FQpmRTBE3T9tQ&oe=6A97323E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWCv9aI6yfsQ7kNvwFvgENn&_nc_oc=AdqvaIk7mo12QF3BfrxZ2vM9x64sAwX_MWIz79rQBxcgY7JgsE5Y9uubEjxVLEsZNEo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo5Pc3F0FmXQuv_3nERkuTVtMN7hmPD8zKZVzJAdurDg&oe=6A973A92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6FDR3LV8SEQ7kNvwEr77Om&_nc_oc=AdrxpJPCkjXu_XYEHX-TF_s5fLZkI_3tjSXNYN8u5-IjD8IY0UTRerlwaqltknaPT08&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmpiNaLPExFQzdjEIPslWS5t_7XkzYVtFiC7x4EOvR8A&oe=6A973FAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-TyCyZW2mkQ7kNvwH5t7xG&_nc_oc=AdqvKiLyvTblno9G2SC0Q9Mbu8SgRgMjsNXUZ7eY5MtYki_Dv8Oke_oxiBsn8s0EjQU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOyUoHzMQZJIzx64kfn1cTL2TPdmd3uo8B4lCxTvEknQ&oe=6A972CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bmc7BWfv4xwQ7kNvwEED70Z&_nc_oc=AdqRTcnJrIk-ZaPziqWOXQUf8VwDPx5JkM3No23uj4eidNN1i_7D3HkgCkNddRiO8_A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmpgmdF7Js6FoaS97t1voLL6eMigbDpHPRFCAQj3WEXA&oe=6A972005"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
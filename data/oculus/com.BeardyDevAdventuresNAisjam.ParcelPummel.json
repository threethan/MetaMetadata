kNvwGcvv8R&_nc_oc=AdrSbtzEZHbFjEZ3EzfMLFJS12q6wym48T-NPWp1p20bV0fKkBa11B9c3ZYakgAEqWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U5YARDotCvkO0RlrQA_I2LnfbUMtGpegruA1XGjCiKw&oe=69E0D2BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW7XGuTAR-oQ7kNvwFJy3sQ&_nc_oc=AdrXydryO-UEZMoc4I0KIzh--Dj0_0uIo1R8NIPj-pa55XUActp40XIS3i382WcUYuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qgnt5lMnzBetKai3MwqSvaCQ7qQv6jcVltpAnqToGCA&oe=69E0DB12"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNEMYl4w2-oQ7kNvwHM3ESn&_nc_oc=AdpCRsPx7jxuAOGc-rPvZM5IjjZdMIs8mf8pKfUG8zUMDibFbKvu7RWB_Fknp_Oh3d4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af323OUWHlnXZFo48_I8Q0qJEgcFWNmsKJmEtULsZbEsmA&oe=69E0E02E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgkW9nS-7agQ7kNvwHw4B_7&_nc_oc=AdpHB67gLaAex-kCtaj8p_XcXWDZJFIq-vrDaXghAPTziux3LpC2ksVz7j0OfRIF12o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y2qtbjWgTDEtFnDDnvEzsO5j9Qnvw6s2Sv1_SGYAYtQ&oe=69E0CD23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qixHKSSuyFIQ7kNvwHvHsuJ&_nc_oc=Adoh87N2LYtM-JD7k8ldE3vagPR5sgXESu9YLtj-46Q906Wbir_wAibZkBGNBEMItd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35JN15ZLIWr0mQrcg7OCp9FbEI8IYs8o46jjg2sPp96w&oe=69E0F8C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
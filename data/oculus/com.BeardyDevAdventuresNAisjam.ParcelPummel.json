m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pw8Fa_PkI6EQ7kNvwEZb2QS&_nc_oc=Adorj0zgYrgNa7mfPf1N8pLSd-v8oS7FzgCQCeNIWwYX1DF1Ld18OY4joidT12aAOsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaS9UEpr5fYgyozSgD7ZblVhH8Kisw3TLpsTd-UhzcaQ&oe=6AF342FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P6TaAisvUAQ7kNvwHqGZ6N&_nc_oc=AdqzdVLq9P-4QNdkYaw1VX0AFa6EQKe5lR92K17p-fgILNMb9BHfZm9yUsnYddYTbfU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMT24yXv9YrVwQ4x8EZ2K0eibKQ7ha00EmiQ1yo21c1Q&oe=6AF34B52"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYnm38mKSC4Q7kNvwEI4GEa&_nc_oc=AdpltVoEgTmLq20SxUcKJST1sDCj6uJ8O2QgRcI8oGnFiiykDI5GIe5r8jvf9NO6XSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8oIV2UtDT8HgFB7l200FIi2Z90dxt_bPmcPyxWqakXQ&oe=6AF3506E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gd2mBkFYfkQ7kNvwHVQCdz&_nc_oc=Adol2iCk5zpBKiAWijjFnEMiVwo68TVR_l8lE7I21YWMBW6nqU6oCJmHlTtXXlduB44&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr1TgHEFLJ1HF5TLqylyBEMemg7FWEfSCiKCUWnLvPuw&oe=6AF33D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNNlYfuQEG4Q7kNvwEby_hk&_nc_oc=AdqqY78BtwNeBzAMGrdYT6rCft3Bkw1MkgPHuJxWBzaY0jECLl7kr2h4-gxJZ7I5cRM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT-G5mqhzUnZh8TBpqOCV3_TVwCCK_54b7mntnT35SSQ&oe=6AF330C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
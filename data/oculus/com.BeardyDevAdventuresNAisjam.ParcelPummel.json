m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdm_ugbu_wIQ7kNvwG2Z2aH&_nc_oc=AdrPb0b4P3mTV9s_dDSCMrgBLYR2-egVdkV_tIDxEuHhNwInk4n79lOXrvXo8BrkfQQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjEVc6WR6UQAMd0znK13wHOPEeG8lDSgG_uhFBRYxzwA&oe=6ACFAA7E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwzRNG1YFRkQ7kNvwHGsC_B&_nc_oc=AdqjRlo4DM6w2JVM9p5_EObyISe4q7umucTK8qY4XYuMrGbFQyEqSol6GRXj3YkNyN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2irZ2gTh1XJJFs72qb5NzxrlCFwBShtb274-DDPCtUQ&oe=6ACFB2D2"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC4qMJ9bANwQ7kNvwGDi1pK&_nc_oc=AdpsZURUQv8El6B5doXuNsDnUm_JwxJxfYaj0pfqDXU7blbQcbbIoiXwBdSKq0fxFx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0srn5teWq7DIhqKHWfoCs9IwIqo2dmfqcsYm8aUD9VA&oe=6ACFB7EE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2v5E0BDQHz4Q7kNvwEYN60R&_nc_oc=AdpS47e_PtJmykvMjUSZL6idrygMRFzSNMgikYUio3K-TrWqHGMMF8buropSYSTodnA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYdjoW5MZWNmXhaTLB5v6aCoTN4B4n7br5iXL9fdLJbQ&oe=6ACFA4E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89hClCn2hSsQ7kNvwH9AO9M&_nc_oc=AdoJklVy2d6Wbmf3-5uRsALtyws6GwmKWtOawY9dt0X8nvlI_ogGTT3x2eptP1GMpF0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUm852tjPgT3jb42IGkxq0o7qsBjMFxBlZTLmOPrJYBg&oe=6ACF9845"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
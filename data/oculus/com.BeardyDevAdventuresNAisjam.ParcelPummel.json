kNvwGlb-HG&_nc_oc=AdqlPw0StNlgJP9y3op8MuGgYkCHd9xtnPDEOmzF49hGgbwXd43S2m2kgtpJuvmc-Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kCDstR1YzM-8-GxiRVBYEPVeQBZdKXM2uqCjlR2kmWg&oe=69FB30BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQwD09WWyOUQ7kNvwEgaaNZ&_nc_oc=AdpnVO1xeyuKAEnhD_-w7Ju7imnxsRVkS0utwStZAcnEjw524dDa9yEQkaN95Yf2VQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QnnbqL3b0boD9Ye0h78N8qMA6-AuaVE7vEwC6qIYA_w&oe=69FB3912"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-0rKCb31h8Q7kNvwGHegMM&_nc_oc=Adr9r42RBaGFldoohHDkOwCXKNrJ7eg-9VXrFM4ns2FGvVjKGEPC-GoO2jk1IazIMKI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55ZzNviD5JQziyRu8fkfItCokoy20ziyqORON5uJ8yLw&oe=69FB3E2E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_Ung2U7hkQQ7kNvwFhXbOk&_nc_oc=AdozElxfr9K2pQ1pePix2GyTulZC_TD2bSKwni1qQ-2_NHXkLIrWMEGx3PL8kaPxCMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LWB1S2pAda15pIUCVBIBD6EN5tyQA6DMO8pKV94qfJQ&oe=69FB2B23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPv2f3MVDGYQ7kNvwH2tI_W&_nc_oc=AdpyKrM2-xp-EFKO2Yo0Log4II2m1kW23bNkW6A3z3YOP6NsFVc-4OOvMg7VZ3fmgpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aLxKYXFjp1PgPo52GHE6Nm1YZHoBMgIPXAIwFF_a68A&oe=69FB56C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33JksFVBBVkQ7kNvwGrJxC1&_nc_oc=Adp-MSUB_QAI9ZwYmrLOdnVPfsA6FVCp5kyNiVWoAdzVfeyEAjn2wGg7WNgZqMtxqhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZOdDfRBFAu7X9cBm4gijDG1ekS0n4ubDFHSzIC8b7DQ&oe=6A902A3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lYA-dYTUGMQ7kNvwGBiSHQ&_nc_oc=AdrcKFLrbbok2onl8Hw_Ac4UXXiCYR-xVvbxtoTA8eyWaVaPG_TKpFG7sa9bNk4oWYc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_NkakK-AyD64RWlzpNm6vrdivSWosK8XWRAO42GrPfQ&oe=6A903292"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLRlTH7gkdwQ7kNvwFfWsGV&_nc_oc=Adrbv0sigeXPbSw77PprTysFNEP2Fuup8-n8EgEOlA5699hGn86WUKhS1ED9xar9hpI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3Eo-Qa4mEkcmm2kBiCHPvLbYL3tz49JNEwLiZiSmJFg&oe=6A9037AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjkfit2npGgQ7kNvwE2FoLn&_nc_oc=AdobN8WfA2BsBGAsm2Lcnggang3Ma6xzn8eKQlRUnoeVXvw7kDyL5BhsqvRdK2MIgvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ26rjULgrv8QBuru18GBturYGWPZprMsAIIm739L0vA&oe=6A9024A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPUl6OB6oqQQ7kNvwGIhVsZ&_nc_oc=Adq3BSeSzOx85bQvL2O2MYvwMYdPTo7zOdE7bHsfXCZNMCdM0DjlWQtZaT-78kUiFa4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEawcAEOF9zEdT7p0a6llo2_i25bqDtzgvKWu2vnhV11g&oe=6A901805"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
kNvwEywPiM&_nc_oc=AdreU_JoGC3sNz3FtZKIsvA3X8dMmpOLwlzTg55UwbW0CDynbrLdRINjaYoNVfnRvY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0UKVe6_29Z0-07MChw-EBrFRAmAprymFtpb88YClQz6Q&oe=69F347BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHC1829OTEMQ7kNvwGpB4Xm&_nc_oc=AdqDzyQ7pyqRbah1A0pGvcizIchEoQphPNwCacTMtMwrgRBm_8fKFqEuasgpcBn0OU0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03fWh9ji5n7SjOnIXBZe6cnsfP3rC7jZU0PSS-CUvsiQ&oe=69F35012"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiswVPnZQOMQ7kNvwHtFrHl&_nc_oc=AdrGQiM9rXORG1rMCnUtIRiGO1pR1WRxg_LEya_JEhW8rhA2bs5XOqyjLv5a8sK8mgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1gWxaZgDU9eUPR-36RGUHIp1oO080BTT10Wo3t2G_g5Q&oe=69F3552E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_M5DWkCKBwQ7kNvwGmT2y3&_nc_oc=AdrCck_REmk3-uWNsaIP6neRnqtu1pb19bxA8lO8b1gGFo5mxap9XxCx1fss0dp-wOI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3HryTLD8TRs1ai0ozBXAFYAOQ_pwMbCA3KENODmKhodw&oe=69F34223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfJ5IPymg78Q7kNvwE274H8&_nc_oc=Adrm6G_3lUpVV7VoYFRKIM1BG7L8EE2tHC4rGIkxXqSiKPiZXTo9dZjCQG33Ef09p2c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1YbaMugF4RC1aU_ZScyyYra31ezGxwzpEcm6NBQnQxjw&oe=69F36DC5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
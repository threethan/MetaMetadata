kNvwGQPO6P&_nc_oc=AdpvEN_4Jsdd8WfA-_YIjcw9TsmDwfiLicSVrH-I_yTkKoh-9151Ds6QBW_KdH2Tb_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9md0BgD8URPtWc78hJAhmu4XFvTTaIRmAcrKBL7qUSWw&oe=6A31767E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gf00ueIQjoQ7kNvwFWrXUK&_nc_oc=Adrg5tpCI2bcDlIgjH1RZ1ziqoxniIgkiZ4TXFOvTMpR74abCgj9gb2yN7tumVS6Afo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zwI2lgFzs6dwNjmr2PEmWyjN-v-UzDmFljXdgOO4FEQ&oe=6A314692"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAV5gTUsG18Q7kNvwEvIuEn&_nc_oc=AdqLm7gv_pObSV-Pj08VOcGgDJ91wRcetL03jVXZN1YE2rt_TeAXsJL1sXEkmS5eEwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C_vHxctenx2oF8nz8zYAzOXSl9Got-ib3CBTlVVmd0g&oe=6A314BAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wRrH0nXDGEQ7kNvwHMG7rP&_nc_oc=AdqS9Q-YieGg440x-qujnYWmURSy_Ki6LfD898lfdrtK9p87iJpc5XGa9fX-25de1GY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95-ljeFeFkq1T9D63fL-YXJ4YGx_LkToU5GZ2YDGV-eA&oe=6A3170E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk62qQg6T5EQ7kNvwFFKSf9&_nc_oc=AdolQVy6AiKIpeDobgK72OyifYcanQN4QF2PfTTmti01d-AsqTK3Klh4Y6bgepa7GlA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fnNv2txHHo8MSsv-VKkX9_k7qfeaBEf_TawHT-2Xw3Q&oe=6A316445"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
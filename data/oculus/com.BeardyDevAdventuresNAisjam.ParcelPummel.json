m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUOGAQZKiBQQ7kNvwH3C-jd&_nc_oc=AdrCFwTZUDFVkCR4riX3vKdJ29Efu9K1J7f2fvPR92R196-3pol0FB7VQ5ipHVrhE88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcZQ-KJFNAcq_c9YVVm4oSvqQTcWRuoAfAn1r-s07WaA&oe=6AB3C2BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4u4jfMLyVoQ7kNvwHCAAyp&_nc_oc=Adro6As0VYeMY3SKeRj5b-BIFPyaYQ8-zalY1KFRuQDE1NqotIPgX8czRBMq9cPtNEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwTcRChpMk8KNLf3mMjYhkuBw2ilNVlYAU_eCnzbeUWA&oe=6AB3CB12"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo_6nyY3RAkQ7kNvwHxi7RX&_nc_oc=AdqBi0pmF0mXEPdeS5ItF4RM0OpAwUMBwzC3QR_ExW9wyZ_iQaDTD7zXwI7CSzHF9cE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRT9YVLLBfJuIq1G0UhOmcAhyc-GkU941Af-wjgiwc_A&oe=6AB3D02E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_ZHg9odqWYQ7kNvwGLqnm5&_nc_oc=AdrtyF5FBbt1ysllP4r8U1bfOeEqukeucXKBEODOUUIxHA73-uMqiWUWGjvFqeUkFU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxvmsIERtnL9phny7jJ9iNNKFyztv5ZDl1lCmnwBVi_w&oe=6AB3F563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyUfHAgv2YQQ7kNvwH05cUU&_nc_oc=AdpV_6hVg6GsTpz-hhOlz7Je9AeyNV1ybF4jUryHxtUDu11mKMRIeRdYC-EliBMcrDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVgWqv0xHd2DmbA_BbthC_BfoyDsnM6jkJeKSCzgpt1A&oe=6AB3E8C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
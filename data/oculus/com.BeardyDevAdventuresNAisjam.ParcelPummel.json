xkPO2mGIz9qYjBwM2NksXZEhN8tP1PRAKUgNLimfEUHiOMMiUmFkRz6_KGZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_WDsrVmUddFvjlM0Mx59XjAvUTfy8ZlsI_VtdfBPA0w&oe=6B05B7FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RKAGpl_wGMQ7kNvwEtwmeW&_nc_oc=AdperVkYQssdkVdSaEEPSLkAe4-SbAr9Sh85fm47U27Sn4FSWXBh2hF1qRt_pXLlS9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMeOh2tWSezn92u1je9kyk0khYV0yXoZ4Xm2ME1Ar12g&oe=6B05C052"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0zTdqxWGQsQ7kNvwEQkJlF&_nc_oc=AdoZ5cektm9ieePpO6dPLWisOxa597SCEM1XEUKHjrkSCTfSnH8XJ9JlluYvtRSKEn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoLGRKCkW4I7MOWSTM-_tpPz40Dgd-f5SHJPp4jeGJJQ&oe=6B05C56E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXZ3M4y7A00Q7kNvwEjCNUA&_nc_oc=Ado1BAf_cVLFKXc86m8TjOD_73rtgKu521YvxjimSnkxerDMzPgUoGXZ02XJyjuzkJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDZzp2qTRYWb6Me0uxR0FDqSyDWrL1-oA1DuiPPpzm_w&oe=6B05B263"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49DLAabC4KwQ7kNvwFfUiMO&_nc_oc=Adr4ayHqMHVo3n2L40I2V6VLJeU9fSqZf1Uarawu15f6-JHlqEaOIVaUqZACIq9FWYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtkc6ENZuyGjPBBIzZRCgMjMsKSf9U23ZzRm_9ATVxSg&oe=6B05A5C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
y0Q7kNvwHuB0Or&_nc_oc=AdrCMinK_w0OUZnkhmNKYJtl6rnrz0XIWSUS96idUMpW8mNOLxLKHXXvhSvtd3hy9Mc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--CAByl3sS6s9wNcdusfQysgm8DlT_aQbbOzZVlapZqg&oe=6A36BC7E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuW8RswSO2QQ7kNvwGga1k4&_nc_oc=Ado2Es2DZD9fYkM66QnvrDaVmWqP2vrlwf4KSUZoDoMpweRBzY_nNFraMUlqJBt1ZzY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eQ5FvugD8xgZAjwNFO991Je0FD8x8aSPIWCEyMj1gNQ&oe=6A36C4D2"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8r6zzzlrZgQ7kNvwFYDZVD&_nc_oc=Adpnkii7_3kMnq4iOI1cF9yEhXqc544Xl22WDGgAo-EZLsxEhaOPTYcRSPV3Dhjxyq0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HQt1ZSdwL4okMZH1a4D6jo-P6ZNzY5qEUo1fgvfdheg&oe=6A3691AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgqSlPpMXwkQ7kNvwF-vWmP&_nc_oc=AdozUZnK2mnSg4i0nkkYxIuLRs6QCGcAg3tHypXQjz7vnXFgSrp3XFPYynDWDK2WyBg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HvTHZC1qVm5o_v9ZMuVnYUV64yKwnMMjI4NHDNvhpZA&oe=6A36B6E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxL0Kh12Ev4Q7kNvwFnJ8AF&_nc_oc=Adoe74q8FqjWBvIvHXxqUTLvNveAxpO-fU6B5beXL653h0ZVPnoN_v7G2A3M3n39YHs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9e41incb1rStX9TAvLBWmEUmEqUufKC3vLBWv_z4-hw&oe=6A36AA45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
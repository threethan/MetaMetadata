FcQ7kNvwHAyJVk&_nc_oc=AdrpPujmYgn9eptPIHH4-PMKYMToRzQiTX8OmIviubUVcjtpQfrcpBPLhSoGExgFtRw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ae5ct9S8i6R62OYgia9DrGkJb0lF05OzuMTgEk1b0xQ&oe=6A395F7E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwB2J_laMN8Q7kNvwHGFbeW&_nc_oc=AdrI8GgEH7j5JcLKS_08lSZmsgsHqFFqLMCk_r5TooqBbii9tOAKTx8aU8bHy857nqU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-12VYcC1kGvYI85oeGgMPZDZLTpbUBrTVuBeJRVkZDlw&oe=6A392F92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwosONWnN1kQ7kNvwGLB6Cz&_nc_oc=AdpD6MmvS_k7LH1kgPs0CnwisGN5mcqpAU7zf-ThUXuV3czoWLKU7cNTKw2yHQNEUqQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ehiJasJbMzV-UMG32McX8wQ9Gs7hz9Ys00BRNkKa9jQ&oe=6A3934AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgqSlPpMXwkQ7kNvwGKnC2u&_nc_oc=Adr-57aZwPpqO0MzHO44mpoJb_U0FL3RWU8VCUjGVT6C5Z0dn0TsYjMm8kxtWWksShY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EnfVwuxjNExfUMQ8NvTsWZp54WD987qz4S4430ak53g&oe=6A3959E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZL4CMJtCkuEQ7kNvwH6LiJX&_nc_oc=AdrnLIRzNtZpZHGafUnnf-664yiJlBtMOmiTcicG7D_6eAXKEo7_6aQDgMKXOLZNuL0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CuN2jo7Zx6aVAWZrhGW2dTP2Jt-Fm2-eZpHgn-CIrNQ&oe=6A394D45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
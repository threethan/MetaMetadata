q_AlL0TtaduQs4pAnP8mm5qsuS_QJtTNecpsikR6f6n-2rPVPfuZjkAe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7zMTsRWhrQ2csa1kWCkPrDQADHnEvaxM3Ur1O6L_Xig&oe=69B00B3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9Qe-C8LqmgQ7kNvwGBbdEn&_nc_oc=AdlDe6DEVclk4n5nQumKuMpzhmQW5E2ahwSjNvX8VYT5ZhofCJby2s2Rj6ZxF8GRCSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDIdyK8wZD97EOe9RQgERazpEZGto5PfHhvHxKcoY6tQ&oe=69B01392"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSDEUmdRPRcQ7kNvwG6wMaV&_nc_oc=Adl3wkEMNJ0hip4T1EUICs3V_dCBCeNcDQM0pSCI79tVM9K3y_VgIXqo-6EeFJLTY6o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPbNsgV3VeLelzR9c1g3FXrmlJKuumcG1jsL1tmUEz-g&oe=69B018AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EufFzD9wM3UQ7kNvwG0BG3_&_nc_oc=AdkXo2OTNcL8_jzRvbJFW5i1_PsFqqbIip2gRmLeAxpy83XSncOo-bvjhi-R6lpmP2I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl44lz7xu3LxMeeW9naPnk4o-Q8vTajWHmEm-qBikXxQ&oe=69B005A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbjdeM1vah4Q7kNvwFxkQo-&_nc_oc=AdlVz6sfx0RBxlZ6dUAp3DPMfD9DhUmejqZ_9PQA_hNEbB188_gsEAv2P79P-nWt-pI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPS5YKPNF5WC5iRxQIvrARs_dLlUthLwyrQkdfdAfv5Q&oe=69AFF905"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
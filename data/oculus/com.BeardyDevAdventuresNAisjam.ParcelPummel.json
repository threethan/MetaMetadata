DHzP5_f_q6rKX8ZxIw2lgawY1k5v1Tti_scL9cylJim7XYKIUdtjewaKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4gmgSpr1clgIW88tKkcjJr3OI3WLtYZcBPIRSZULDGQ&oe=69C12EBE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMguZIj87sEQ7kNvwGmdy6b&_nc_oc=AdpnQWPU6KqJeZkiW4-KRAcGiIVyO2pI9qpp-gYe8dDRshjKzp34LS4UnpnFTc-sa5c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzW-v8KXwIpFwUO5mNIy6xIlRXl31bQ38NDqzRzCHYLNg&oe=69C13712"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQRgXn-OAHUQ7kNvwHNbb89&_nc_oc=AdqWRMU9dTPcf2Xd_jOHOzR-xH027pFMa63x0DEkzlLHCj5X12Oi-q1MZzZBWNkR-Ho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwgkDTHnQGmo6r0MTCBLmMnfkjZPdmBkEnX3-xLKnrnrQ&oe=69C13C2E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SBzbPjCYB8Q7kNvwETFnSB&_nc_oc=Adp7_3eRvDs-wR4p9muYVeSFeIxasFyPtvhiT0Yssokn7KOIH74XET8gdHtOkco7eUw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyQzUj8KmXidt0ugYeh8L9YLT2UToFfd42PqCz3--UMjg&oe=69C12923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5UOvlXZBGcQ7kNvwH6dehy&_nc_oc=AdoEC1eSCuLUS3FO9wehBrmP6fMTdlRK0BMr3ESNzcxqMOGx529iK8Xy-xVHLdVYoY8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwv9mt1JqO5S46Gy17-yRnohcm12FISACoiF7-c1-9wkA&oe=69C11C85"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb"
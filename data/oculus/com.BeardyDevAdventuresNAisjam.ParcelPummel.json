m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXj0rNFa93AQ7kNvwEiMbzA&_nc_oc=Adqp9drg59ClVPptHIaCoj5Y5ZsdqwV0qZn6CkJT8oR9kyb5glABTPjmlfq7RDaAirk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4o7HAq17UBCqgCPMbzWJRGY1aBYxXZO-pcoq4GABhnA&oe=6AF1F17E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P6TaAisvUAQ7kNvwEkgpGm&_nc_oc=AdokGYF11yoRwkmxwlKLqhIVe1WxZm1gTBOJqhGRxwMlv3OK7NOPDBmoeIxVmHzN0pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpWJBZc5cjR7R7vAkeuc29Z9hCfAtEEddTuplz5_JcTA&oe=6AF1F9D2"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV1pFaNSCdEQ7kNvwEAMlwf&_nc_oc=AdpvQlM0Tc9_6JZEXwLdn-w7urCLM-UZBpCV7kEsk3oEuKxcNAfR_PXpLEcU4rdHQcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq7QKEihJdfosoHyTSxsflaMc7hU2dfDTJeUNycuDiwg&oe=6AF1FEEE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gd2mBkFYfkQ7kNvwEWlqg-&_nc_oc=AdqaEgw1pOTnQJWdJ-lB9EY9F6nAkL--oFz3WdAgGodsVzeIv1MYBP5i7WYWA2AB9MY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4jrdVGFBtYYK4y2x_U_4LSbW5vd2c_fzxzcOFJSmYtg&oe=6AF1EBE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMnUEl98g_kQ7kNvwFGEHQf&_nc_oc=Ado7TrchYCd5XIoHA-WbGggJRAPB8_0w9x7YAnS4MWG0qRQ55049Zd4oHHKqbXMX5Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5jYlnIMc-GblADUrgvDpCRPeLI17f4JmnAvaP39rklw&oe=6AF1DF45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
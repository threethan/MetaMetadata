kNvwENb6bS&_nc_oc=AdoKK3_SaQhZVDvJHoLBZnPXh5Q_2FCQohVc9jixJAZiC99vfB52poLIzQntdD9B6A4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ2YMVdQuiG3VUUcUnzsiwlHL2Py1hLITTVz1Vt-4ktA&oe=69C2803E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMguZIj87sEQ7kNvwHoPrcv&_nc_oc=Adrlp65a3urqQK2UcJkIps9zTpht9hfmCJSaP437MVvav0GDnuB2ExOtL-25vN_PbIU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrO8GwjrqEhMek3ynd4ZlYVyr9qLVlXqc8WeAZIABViQ&oe=69C28892"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psTzfULTekwQ7kNvwHHEbwE&_nc_oc=AdoAloc7PtacwlLziM0ifwD1To_qmzWeh_FXwP5TD-Aiqea9_TyMLYIUkmzze7XDNZE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQAp8PLusFsH3HE0rOz81btc0n6LayonbUOoWfP5STVg&oe=69C28DAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SBzbPjCYB8Q7kNvwGdfgM0&_nc_oc=AdrspmcuEqU1JrX1bPaUYSWiag2fx6W8HniBDNxuFJN01Qdgzmnp-6-L249-Fu9kitI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTncghKxBrcLKWplPkfkfm4OfHbOcwbP8hojMvBeUJ1w&oe=69C27AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5UOvlXZBGcQ7kNvwEbe57H&_nc_oc=AdrQ_eyJXhmOZH1N5vOYWJMLf-MSUxrEscMH0X0SBidKn5lpXYa1MLPjI7cE-NqIMVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlsGL0BGOfKAEuqRZ3Cahzrs9chgoAbKDS5htn9wMVKw&oe=69C26E05"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
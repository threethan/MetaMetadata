n.com/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIHf4yfsGz8Q7kNvwG4GWvq&_nc_oc=Adq0imz7q0-t2ZoHinmTVvOFcVxAgfqpkzT5kIzVSgRKmvZ0JX6YlzYVnSoUJiI9WBE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQhIVZ2UW0rYMu8ovXa6LOy7qjMgT_usklutU1XJt8bQ&oe=6AAEB4FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asp4QIsBefoQ7kNvwEUnf9e&_nc_oc=AdrsTLV7v_ZTiZ71b5E3IIQTK480xS6sh5l-scoBykZTxuUj36B39QKKKKRJ-rckg5o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdLERoMF5v_8rwxnwkE75rRYbVDbakFrd0GMpq4W0xvg&oe=6AAE8512"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TraPwPUcSucQ7kNvwGpW63j&_nc_oc=AdocdQkZ2adF-VwoKImfE7ZHwvswuGlptoPGeKLocIZ9W-mkXOt9WLXWChAhXf1x1oo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMUX67LSl3iN5qyYq8_BnT_2ZU89I9X4KpEMiyK3VCFg&oe=6AAE8A2E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAEbK0fMDZsQ7kNvwE8PZTh&_nc_oc=AdqfEF6On46caSsBDKCF0f583-P7KgjPV17iEgWqrkenTWdK56qYpMMGr7sqKc4fpH8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbdzlJGFAsUQ4G3dMD4QnjzUQHYmOCogqkYDHP0o-8Bg&oe=6AAEAF63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbUSXJzFjykQ7kNvwHYl773&_nc_oc=AdqbG9D8MZJ2jleR8hMOvLukEeHW97j44tGv_KwMUTQgz9GujVFnrzNhvtXzTTmuoYg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJseOqK6C-L1VQpCnW6WkqPcnA0l3Uqsw4WMziowdgVTQ&oe=6AAEA2C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscripti
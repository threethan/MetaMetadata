m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fj-cGvXx0AQ7kNvwHSGboO&_nc_oc=AdqCyIOBZwrY7HUpdd8NjJ48nCeUoP6DCXsSF9Dh3L1jZmuWHFdXNbsmi0ZFJlIz67E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5bnvJK3BJ8aiYRuJ44ix_RIJMwMsXpBdoWdsqzhK2WQ&oe=6AF7377E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkN14MConS8Q7kNvwE5HB9P&_nc_oc=AdqjhlrjLhpErCfu1fL1g8Le47U1DDfYkCRoQtfdFVX0Kx663vYV_lS-SH1UaQgYo0Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLPbzHN4sacHG_IxVpMH-hOrfsihAj9J3FGt4SjtTRpg&oe=6AF73FD2"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j08UXi3ryzQQ7kNvwGNoaLG&_nc_oc=AdpRk0gmNb3ffAF_UcDn01MrEtt7OiG0QGHKmYsmYFF89EvxAecPZ0RLb6Jb12x6AvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcicb6xQOh_8Y1Q4pscZ7-IqmbY3dU-KsLYMITmgGIpQ&oe=6AF744EE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVfG47HOViwQ7kNvwF1AM3A&_nc_oc=AdoM4lJ617B9YlBenWn3TbXlpI-XbIgkGlHU5QxbjsyaeIQY58YOULZbdDnFrUqnFrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjWsmulw75Qimw9hWbuFbTog50uGgb0pvxJNcUkrh2jA&oe=6AF731E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRH0QKdQvsgQ7kNvwE1tyjn&_nc_oc=AdotO7mbMN-CWeYoYzmqkWf3ABTScxc-6sD4UqCCxpVyvIGjpDAUfhV1QIsjf3WYf3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0tk82o7O9BneRNg53i7aZAD3EbVsY88o_qw7c_lmzXA&oe=6AF72545"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
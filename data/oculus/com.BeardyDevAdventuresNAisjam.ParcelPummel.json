mYQ7kNvwFL45Ly&_nc_oc=AdoWMhcHhOJfwACBxy-HFgZxEusEgioBGbUvH26p4AKTU8OT8W9BBQCySEM-7aQ-qP4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83-ehDNiSDS0udF7Q4vVHpXIl5zlyltJt3AcjlBIS8Sw&oe=6A22F5FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ja2qkwNihv0Q7kNvwHMLFVr&_nc_oc=AdoNmD2-WKWxGwKBLeu-tuzkimDg-9xQdGE_8i2JPVWTL3dVw1Zn2b8mEjChICgJ2ek&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eYenkG5BF0mi4kEoH6FBm72X_R6T9RX2x4lCmcgfkag&oe=6A22FE52"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFFCbV7FZbcQ7kNvwFIzgh6&_nc_oc=Adp3EsfHYmC8Gr7pUYxRKUb_eQMqGXOO0hXqj4ExxZev4LTHYzNhY5Y_mxasegQNXO8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2Z8Sg4MBg0OBaS7N37E4YUmp79Byj05NHNE-F5UtEzg&oe=6A22CB2E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qhbm0Ky5cYQ7kNvwEM7sbK&_nc_oc=AdqnG2YwQ5pPTbao6YYZhNUuLdCS03-N6yPa-4HBfqKPGycJDBL3sZ5hh9XKODOrszw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-MMuo1vQxyW11_CNvcJL4gzTgJeKC6uNctkOJ1MLd3A&oe=6A22F063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0BEdloJfGgQ7kNvwHklw3H&_nc_oc=AdoTJ2aDyRT9xqjBR-s8B3VluWReT8e5dOW3ig8Iux5BcGwY4wJAbjuEFS1QC6zMjKA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VoGF5P923H2icpmTrA0TJc5-2KgAvjoEDqyTmdtrw7A&oe=6A22E3C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
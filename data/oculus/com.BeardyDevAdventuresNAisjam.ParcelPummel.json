kNvwGHe0Zr&_nc_oc=Adq5O76tHLAesB5PVFsHvXaDM90QsNZwAop1CiuV-YLE7jmlobPzkAgzP3_BMP15u_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n5OunkhKPnzaCPIb58WyS-k0kr1d695t04NONiOyhcQ&oe=6A2ED37E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxW2QlmEh5AQ7kNvwEriTwk&_nc_oc=AdrQY67uAaH4tz_AiBrn4KNie6BXR5kGa78z9J_v0J9y1Bkm_NF4gwCKhzp5osiZkjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pnNE7vepEjhRpnbjjyWTug691LO1V3XLWtYK6i84arA&oe=6A2EA392"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfdHTfihiJ4Q7kNvwHBiVWg&_nc_oc=Adrl12-n9j49DovGD3An1dZ_IaI5pvlmAualnscvom7ebGR-fLLyYgOQXjNQFOSHCQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2vKhtjqmFrTwE2bUrwWGQjYCNGgQSnlo9rW7UC9O_PA&oe=6A2EA8AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wRrH0nXDGEQ7kNvwEbWt90&_nc_oc=AdrfVTshjk03kzP5DAG7aTsUt9sRRcVbLnvTDBzDCM1y2Jh7vITFMEFamAXV7H9c51I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pYxKAwjhXR54Zdgil85nliLealYWxqT6b4mQU7mqEkw&oe=6A2ECDE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UChcr9HuMc8Q7kNvwGSuDHm&_nc_oc=AdpkI4vMscApG-db_8jEI04IYiUozOjmuOvtMYWVC8f0PRM4GV31YjqgawnuxHIuLfc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8yLeCCfDh076EyVcHWVlNNHEGRp9tAeMOBJ54MJYIcg&oe=6A2EC145"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
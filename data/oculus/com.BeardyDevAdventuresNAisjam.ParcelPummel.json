FoQ7kNvwGZrvQo&_nc_oc=Adoex9FJicyf0lyc3j1C0YZ29PYJ6Y3fAe5UtpHz-6cWm6LCLHGlkyroeqDBzBnSh1k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J8176-PoeZqwhnN2_HFp9tmNxJKporosO-vGSHC9Z3A&oe=6A119A3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx1xG_X4uSsQ7kNvwFpVXOE&_nc_oc=AdpBlSvarAHm7mEI7u8loX1duEwxhotqdi4GZp2KjuSZxdqUcGtpb-x7nhG59nKqafQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7APIUaaf0YWViShCcVV19WjvSaPQLj-j6vr66sE0ylpA&oe=6A11A292"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2hulks6EMwQ7kNvwEWAiZU&_nc_oc=AdoyAKgrd2nWEDysnBYio3aMzuJ592-MbmpmkC-XdBH9u-RWBEEXVOmD6WFBfy-Pp4I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M8u5F93SmlRmiShcReuMmtPOcGqvQ165TxE57LgRijQ&oe=6A11A7AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gkx3Y0W3uR8Q7kNvwGN-lXU&_nc_oc=AdohnOYcn2bdYdSPHxpRJAAwFPjqI6D8sMymsXQoye1TUklx8xq4BrxuOrgYBgYPUBo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ukf_8uXhwciVQAlb-rL0Tp__KNlxRSkJiqJNqFOYzIA&oe=6A11CCE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5F3bc2MJcQQ7kNvwF1EH0E&_nc_oc=AdoDSe4IPUaSYyHT7tUlcV7c2ZdYFHIHq0pFfCW2MYrU3j_kyv0s4zaIA19nEIwsZq8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oLZBXJo8_8c6jQnRjY6quKt65MBTw_PXPrl_CmIAmZA&oe=6A11C045"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25487402434237127"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499295701_1335659614800213_3395715169539274148_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2W-F7oygs3EQ7kNvwGlzUlM&_nc_oc=AdpuQtYaS_MDwGFvzkNHEnTDNuoUI6nRmjlL41uycS7jRPnAV25plGlF9uiWTyGVUr4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ucIRevVb3lbnlcO1fbeG0HEbQe5TOV2ZYWchz0Fhshw&oe=6A11BE59"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Parcel Pummel", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1754431200, "lastRevision": {"nodes": [{"id": "25487402540903783", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25487402420903795", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "573879559011966"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Parcel Pummel.png", "id": "1949966092479862", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499292703_1949966095813195_5906331537667082589_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LblPk4qUINcQ7kNvwG_AMsC&_nc_oc=Adp_vaXNzdMIAaj5TvC5xkY0CbSW4iNMgQ-goDluJjC1Z4iC9yYGVT9WfD1Se0u5XaA&_nc_zt=3&_
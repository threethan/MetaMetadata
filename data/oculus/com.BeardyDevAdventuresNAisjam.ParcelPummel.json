kNvwGs78W9&_nc_oc=AdrLbbKi03n_9q7I3O6G11biSgWmnEFfezQWUWAEoSMG1o1oocCvYod7DLV7jkiy-y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypyYFEgOwbt-ZzSD5UufR0fa6bLTXuM1gwsgptj7_X9w&oe=69CE5DBE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITEKvn1uPWEQ7kNvwF3PQCS&_nc_oc=AdqAsYRSDejkW0_I0rtQMDVAFNtNxx_blOZonu5fx59xb7aPYKtdb1BMlF5G2ES96Xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyO6Vd4nF0M7vIHwu1x_8WBQlsihbmIgJBNS7TrSqp4IQ&oe=69CE6612"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jv23D8EnKU4Q7kNvwFrbA6B&_nc_oc=Adp-nMlEKwvM2YSapCJ4AOAELL-hO675Xx35dWiRP449YPSiPAJ-qkra-0gnSN3EY3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOBT043dy5EytbGj_9fVPooxn-ES31U7IkG0XRZq91Jw&oe=69CE6B2E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bBlfCVf5vQQ7kNvwHrLkQO&_nc_oc=AdoU0PY2RbU8afa7q7MzKZ12ptvQq-oc1po9odlHRh6iPW6rZ0hbUX1d1ircUBquU2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGWTSmpOKlFBwksFmSVIKkGvO16-ZLiBTvbGtgE3nTCA&oe=69CE5823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=905Fs6nvaS8Q7kNvwF6jlaJ&_nc_oc=AdpelVwibCBQ8fFIX7eGPD3d--DzVfEFi1D0H3LDvU7KrcEY835Du5Ye_UMiTJvGD3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLigNC3-xDdgMCcn3UjruZEwJPX1q0TQzg9kQEMGVe1Q&oe=69CE4B85"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
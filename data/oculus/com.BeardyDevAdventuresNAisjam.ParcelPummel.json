m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHuF-pwXpQ0Q7kNvwEoM7AN&_nc_oc=Adr1ilh9ENGeHQ_GRD19XW0EpHK8DKbgDaiM8cxEbhNDxFHD-fjt5G3lIaFyLl9r13A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGINQM1ZvViWXxL3XXoDSok4QlTMtik-qqJRgL5TRaow&oe=6A9D593E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er4mh1jyfn8Q7kNvwEPb673&_nc_oc=Adqcbw1reV5oFKUycdd0zAQlPlJ5hDbU_oqwE7R1v_8-Yxr_I6YMsMsNZC85CRHY5o8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5AnTLw2j-Lr45HYq1S-bUOgRP9xeae10sKEyWcyKfLg&oe=6A9D6192"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eLEBsvWoz0Q7kNvwGhhFRH&_nc_oc=AdoT6CHHTdGbjKJu9urw4Z_I-Ulp1MAj4OcGMlo14SH4SySUQfPqaGOkNeF-wKGv1KM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-ikRxAWBCQ6UZlkZHUgnQRWsKBXUB4EV_429h3kxEYw&oe=6A9D66AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjR3x390UxcQ7kNvwHLD7U5&_nc_oc=Adr7eSvsM02RLncycAt2m0VeydO9w3yT96E1bZfUWrvSXndy_wYiWcd3hjbL9Ym41QE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuksh2PxbvnoFNmTnt5M2IRJekNC4Log_Z5kkASnK6Yg&oe=6A9D8BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F0CisLX8RUQ7kNvwGVqcGt&_nc_oc=AdrohILkopiqN192DMcUZcMuDU4iIFaU1Y1k-hhseokgAZ7dCoLa44AElgGyr9XaHao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwYdTSJs4xf2Hrbj7qTf-hzpfJnqA6PHn3zx_P-41mqw&oe=6A9D7F45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
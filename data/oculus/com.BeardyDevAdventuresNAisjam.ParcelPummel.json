kNvwG_S765&_nc_oc=Adq94lkUV3LtpQ-iTgjYSu1D4K-7sGOLIPMCyWn9mZhN7FHRAs9eMJfTub5tn_OzuEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6c6J-gud0Qycvk9hg8cdHFyMY53eiLP2ztHn8GjSY8A&oe=6A786F3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMmWqsj3Q7sQ7kNvwGVZ3RE&_nc_oc=AdrChYAq3ddkOYtwNVzoh6D4di3LIxdHSZYtCASJ4taeIGMo9uy3RpS_3OTgXHjyxKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESrDnTVDUvSVUhb3QXgPhpymY7zs9-Y2FQsYcpz2uWfQ&oe=6A787792"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwbEkfIDkbAQ7kNvwF3Xuwx&_nc_oc=Adqrzz6GMo4afDS1gkEnp5lhO4hZRm1wtf-gyhDAw_eXfOcmXyrEj7KYUsWT0PV2npE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyzMlfE_ZiZ4zOb2RErx_4s0nCLO6W11nTM6RB4zWaJw&oe=6A787CAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhOxELMlWscQ7kNvwHl2tPw&_nc_oc=Adopt34h6ihjSRsV6bLmuX1lRhRv_q69YoizFD7mQkpgdWuwoI8FoCZZlOMH5IGvoiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgqlTv063JERvnI4v_tpnOV1bNUdWjMnJkhvPZFdWx4g&oe=6A7869A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IF0-3fg_zfsQ7kNvwH51DUs&_nc_oc=Adp8zpa0wO2hGYeFYxXl7HtgO7g39w-w4-f_35MY4LWVz9GIVgVMdtHxalqG9ajM6GA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhryYGbb-qQt64gzUt86uKaCooGmsXDmQ_3n8svZRRpA&oe=6A789545"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fdm_ugbu_wIQ7kNvwHV8vRp&_nc_oc=AdpB2gAJZ48yM89K2_SYfIGQWy5WAYrLgMyPQaNQhNtf3V7FwS-Bgt1XhqYdm_16OyY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp10rNlgkG5b-r7dwqLFRO0ptz7EVld3vsg_QcHVAW0w&oe=6AD0FBFE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwzRNG1YFRkQ7kNvwEbigE6&_nc_oc=AdpUtEbLyOymMv5fMMrX4QYwRuiTERASI37S09tIr7edzt1VdOvIB1cToV3cHfZwCCU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_ImdhEz5aTAEQ0f9z7qeAZJBF0s0LRKvLr_Yhdb5M6A&oe=6AD10452"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC4qMJ9bANwQ7kNvwGafCoN&_nc_oc=AdqJtTwEJkGDLnMIiJOadNtgJLpKSax4wNGyYQoWkpxwW1xlyFzFv7mMGgx8_dO-VEM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBHeEZjiAaNIjD0wRbjoffBMYCllqJJCHJmHzFbiD62w&oe=6AD0D12E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0Uf50xClQYQ7kNvwHDZqSL&_nc_oc=Adogm2rJOpAgHfmv9c8JIolSGxolXefMe9Yb9VpSWLGb_3UWS2c0YlxUOOfPLgEUe6g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5VchI3ngeoHVTZLvK4_QYQUkvpcmfjmf2rgL0eYH0SA&oe=6AD0F663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89hClCn2hSsQ7kNvwEurkJa&_nc_oc=AdroHNDWQQE_ulXzaIpHRZFPyzsRxLRLMjX-gQpgqp0f4uE4GclzS5NEGG82cIJYUNY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvvUEsz06i-g0dRfdHMB8gooJx2Obcz1dxi1_hZAn2pg&oe=6AD0E9C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFk5SgVCQwgQ7kNvwGOqMnk&_nc_oc=AdpCJUC1nvaDiO5eRDUE_7DE0nGcBhHe9KGiXoD5Y4Q3FyeDCPloUeB81O27z67_7MY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb6RxiZbWKJmFPA1HPsHvZZyJzOTtQXotTc49JC8Wk7A&oe=6AE1E73E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJxeXUv8S2cQ7kNvwHlX8yL&_nc_oc=AdqiDYvJ9qKQn3o44IOerPAdiVa4H-139e5R22lefyRi4fRG1B1femfoPnnfTpMS4uY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBnNcOW8oOcV3Sw6t2p2t9w9DdyHlLL5TDY8aDcv12hA&oe=6AE1EF92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w8vf4nwjKIQ7kNvwGImw6h&_nc_oc=AdrrkTZNE802ZlpyriY1sv1_98uAOtgiBk8fk54TYuy46d5faAJ1JDbaR6uH4NDTxLE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjB1VQL62gr6lcYLKXDW1S1Z1BBsGOMUR7-AUsIef8vw&oe=6AE1F4AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW0mBSCkcVMQ7kNvwGRxTvC&_nc_oc=AdpbPuMr_tcNAWViRyWZdCGHo-sFZIcZ-E1S8ui3p6g38HX8FTy2ow0OTbLVV_XBbA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe2vyHCYRb-I06BOdpz7B3PhdbP4o51PNnilfXwuuxbw&oe=6AE219E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_0ToFTSZEAQ7kNvwFnI3wa&_nc_oc=Adqgd3YZd1ArG76K1NfPWoWrs6PmEkW9O3oBrduferl6drRs8Lv1zZPkH5wKN203D24&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6i_USliRhUjcpPsRN-Zts6KXHKoyT38jV__KwLGHMDQ&oe=6AE20D45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
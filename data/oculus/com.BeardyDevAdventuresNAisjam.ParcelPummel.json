kNvwHzJ4yM&_nc_oc=Adoy_uYo_zQ9BOL27G6nj2KAjjdx5eJe7dci30AAUIBDStO6p4LsuYDIpDg1nzeSugg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUVAQkF79GrVs5GsBPQJcetbofi-IQr0020kDD4yDduw&oe=6A5E113E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5BiWQpEuuAQ7kNvwFkw92b&_nc_oc=Adqddjp2i3gw3OBeKPnQAxI9JksKfvqOfRGZ-jCYRVbkctasLYSuKrGf5S7mO4tEEXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfMgB9c-pGU8j5BDf1wkdiJT4kp35FAgnm847LK5-OIw&oe=6A5E1992"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-RgQArWJGAQ7kNvwHHGBUF&_nc_oc=AdrmMe52Ab3yjhliHgzojV9ujc63QzLSUrxGfV8fdwzgjTqvxrndCxTBUmx9-0-5SQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsSzo17NYkigGIpPpoOERhwiE3tZC_e3JYdPtxY5C8Iw&oe=6A5E1EAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2LS5p_A8u8Q7kNvwFZk26j&_nc_oc=AdqEUc9Ub3TIBeR3VAc6FPbUGvor51w6G3ksjD8zToh12O2sn2RBbV_mFYLb_wy3Tgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm3MvsXjz9QZT0QchG-38jzxSbJuG4l8tYmCJ5C6gDQA&oe=6A5E0BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AzUEPN9WntUQ7kNvwGtfQyb&_nc_oc=AdpA3ckZO-yjmU55z2SufdSVWPbv1sW0VbpE5waUqgbIH8pUo10-bXjE5tEwAOnKocI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArJxqFwIEC1bfE-ntDIJhocdtmVSLV05cVaE2TUw5q1A&oe=6A5E3745"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
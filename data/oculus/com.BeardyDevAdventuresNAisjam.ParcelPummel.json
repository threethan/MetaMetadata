m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=koIRsBkDafQQ7kNvwHEn9Yk&_nc_oc=AdoXGeCCPVL4tw4LCzloAKgGrvnmitaqKOihu3Y5SCSTNzX124NWsLp4C2I6_Cz59DA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiyCYpsgZW_x-Hxfs-S1BxZL-1hMOYIccV0Vu43lTedA&oe=6AB908BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUFVFhvH-mUQ7kNvwHjl5ty&_nc_oc=AdopbMYpwGc64c2iRKBd5cDo-RQOkkMUJ3KtBt0oTlZ7qsdkrL_y9NEQa_yvxHGoxZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuaE0FYT5z7ZOSo47bWCb04Df6INGHE_8vpAaXvsTc_g&oe=6AB91112"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeMF4qUaj3UQ7kNvwHmsKNB&_nc_oc=AdpUWFHD0ZCYiU6EQ9DgjtlHB68l6Est3vRBsK5ySjOHS9cSyBW_UkcFihjUjTF9UoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLJx3q2uYaVC4XHKgtgqTebrFym9zCuRgAiren8vaS4Q&oe=6AB9162E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwjUkCFHoxwQ7kNvwH8sIDV&_nc_oc=AdoKIzjMup3AyL8gLuT_PeoN1vEe80U3LOoUJM1xT2lqFtdrdGvoaUbjbh64uNuAjxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRj-RIlVkbGyMwA8BAjmDYPnSN0L_VZgJSUI6McOrySg&oe=6AB93B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0vFRD4ce8cQ7kNvwEcXHn2&_nc_oc=AdoVv2c-mI8v0FxlwZ58rrJxOsuyhojxrbYkWUUkAMy8NuTi5AGvF3pPHv8cr-OsLLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNdgWGFOXfQclk-QA9U74jvsFzdGSC-hRTawZW-6NvRA&oe=6AB92EC5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVJLxCKeqBAQ7kNvwGIFGGf&_nc_oc=Adra1HqUIcVk1WVCJb2hiDRZc87STKY1hY9bG_x4V8zg5zWFlyoKNJJMuwChftyB5LI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMZ-ISxiureznfA8lEr8TVd-olsH9PoxxqMIqMXgEbgg&oe=6AC912FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzs5BT8UgSEQ7kNvwEI2ZTc&_nc_oc=AdrH0QqcNe_VW-1RQhuMKs1LOynpb-YFGIUqVvxrfEGAF8ECBg48UpLGZIPDH0P4mx8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyA4CFcvbu2cokmBR61rADfxDIHWZc2zBa8UZFcrQ_wQ&oe=6AC91B52"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3sAvQ4SPUEQ7kNvwGSH6j_&_nc_oc=AdqprrsaC2A6Ui1WWWvIUJ-krpu2PhY49j3GL0S8rKBN-Imzv6nJ0T6FdrAl01kjNHk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLNL1Zegf0hSUdBle-LJUIsILK9Q412m__Y5VZrrPt7g&oe=6AC8E82E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cYlntTXTfMQ7kNvwFWNt9S&_nc_oc=Ado56ZFXKy7THubGxxParLEautQXPSar6m-HjWAJHdH7BuSUITRm1JlfcMn7wavN0uU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC5QV7m7IUGUxioWXT5sLK1KZz5omMuRqPS9JEb_RVgA&oe=6AC90D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMonWr12jS0Q7kNvwGQkSEY&_nc_oc=Adps0OLyFaiuJ5PbWr45u4MKdS5EhfI3Ku2mgsStgvb2VoOvDrqL_y6DkilMuDqmgBE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKjV2XmgeyRLOIdRrg4siWMellgV6V9xxxQMmlPrgl-w&oe=6AC900C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
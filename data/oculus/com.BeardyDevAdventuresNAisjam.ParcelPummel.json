kNvwGZ00gx&_nc_oc=AdoQj3glidQZBo3-ffTDOU_pFhCFGgoTqZu38Cm4vxKl9UvYY-cZIezH_TElaMZU-h0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-OoHIdrV9pAvd7t0mtJb1eGV37BqAaUVp0ItiRCjbfQ&oe=6A2ADEFE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sh6m7zf3N3YQ7kNvwGlye_A&_nc_oc=AdomRVFAFWGm4Nc3jpTcwFG0W0rewzgiX216opE9xY9eaqgAxBB-bK2SKgA6lKunndU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E_JYMemgHlte26k_Z8IIDRvuqLP7opnIHaREKhAIauw&oe=6A2AAF12"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ifvgq5gwiAQ7kNvwEk6OFP&_nc_oc=AdresRs5s1N0XBrzTJKuLrJKoQyndWd8TDAbVBwshb_nkU5cr4RVGSFWyqM-MH4PvbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94jaGFfB83BExqrYGsPrP8OmJZ4OvSjMbnwOxrvmMkbw&oe=6A2AB42E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqJXJPXVcaMQ7kNvwElbee-&_nc_oc=AdpLu4sjacNX8-wCcgtkFbHp39opnYC1zPX2cbGOjcawLJ16s51VgqxFyl_ViFrXMhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rRk7FGwcMMJPCda5omCKNQW-7AItiJBTpmbaB8a7Mqg&oe=6A2AD963"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTwUr2VzTJIQ7kNvwEPfmX2&_nc_oc=AdpZNP_wUqvgc-oyvF_DdwzjmgDaZaAO7XtjebfRzKYeqS9jcPms1Uf8O2csSHn7fug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85BdkdAB3HbAZJA_Kfa3ibut02ymZ3U7afhlwiVjFlPw&oe=6A2ACCC5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
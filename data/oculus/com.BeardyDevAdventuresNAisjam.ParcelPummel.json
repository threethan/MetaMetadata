kNvwFd-B_x&_nc_oc=AdqLI2WWD48WafxdTHrFUAw21gQcDDamL4vjYUYqw2VNIKV-j8acHuUBnUMaUAf2fsg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfX9hGBdohBZBGpfo3giIa2EWUdyXTIa13gHfMeuv2Kw&oe=6A71D7BE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79y7uNTRucQQ7kNvwFb1E5c&_nc_oc=AdpsGgbuCumoSS4QRYlMXl1KIxsObVcKEXyBMhEC1oeSHsw_Thhhlro_NljwkJ6Zlk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGokOSkH85zeHbW-lQu8aU8dQpJtjLw8urAqA8pUhcKw&oe=6A71E012"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3GAsOkk7-IQ7kNvwFftmK7&_nc_oc=Adr7qsF_JUCLK_lwtl4Agz2vDGXPH5YEQJI_mMnMlV9Y9PyTry7M53-ODXR_W-jIdx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF9_Aid8rX50oLQPIsFcVb9k9v3YMbflLcVI0Ed5XQ6w&oe=6A71E52E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCdhJoG4YcwQ7kNvwEkXUQy&_nc_oc=AdoA5Ca7OvXROnRVMr5342Wf49iDyLCoSB8QztW7tu0Kj--SQBTqZYFW4xQBLOqtfkE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQ0DnDI2VDbmdVn7Y3mymMmELB0lT2bxvanvTI3fVdw&oe=6A71D223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZOsO5UQgbkQ7kNvwEeCuxT&_nc_oc=AdrsWog3esvQUgNG97qpKRSUb4aMAZHUDOB0jt3jZd1ta53zFO_Fj1cM8kPGH-RiIfQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELFow-VZHuSHc5brHnJZ4QtH-MdCex-fq6TQ3KbNrE6g&oe=6A71FDC5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
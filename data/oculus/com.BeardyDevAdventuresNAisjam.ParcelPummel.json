m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUVJr7IfL98Q7kNvwEX_WGR&_nc_oc=AdqDbHY7YQf2Y7HZ-_fgJdSduTGJ3HbLsD4ISi8hmr89xb3LQ9LvTCOJwzn6hZLmybk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt4NR_0GCe9bihWyNb1B2EEJwMzY-QifkgnVceAYWFdw&oe=6A9FFC3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5ZQNUgQYWMQ7kNvwGx2MnL&_nc_oc=AdrijSrUJqEo5lRjcEaR_6Ti0JLZwyhBQYvztzPmrYg6yFEZtOHnagJC5mDt3LJXDQE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZQJLplb9NJYT2fqj_50_OPkoA6OrDeWGUdravcwtlvg&oe=6AA00492"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdRRGbeqfnwQ7kNvwEVfEai&_nc_oc=AdrYDB2G-rFJrnAei4hjWMeKu_XPFZB79dlV6kP7CR2VFOsY_zUe2v4uSmJzj1f0Z48&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe_ARE6w7agQ6fq7PSbEUGKcik3NEMWNKLu1b4AzTFYw&oe=6AA009AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjR3x390UxcQ7kNvwH1PhfT&_nc_oc=AdrgYyUKXw7eRx0IsYZH43mVVWoWhS8qmoedQuK5m2WyeW4KM4uf7vNavbaVv72ltQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL72wOi_vr1D8Srv74LokckvLwu2nPpC34zro0kbdKz2Q&oe=6AA02EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hOtY_GM50sQ7kNvwGX5Pxk&_nc_oc=AdrOkNru68L7ID3GBL0U70FAQSnvR5Bm5mPuZRCV6p7DNhAD72khpyf-iPY5-ZhdnNU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD2eHtpewh9-9c54siaPuHMW9s9t1_SF1o9nudaZ9ScA&oe=6AA02245"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
ezCHTGpaJUjpWOgLQ5kEs9RusGZ5-uXf3hS_Fvd4WCl71XAHCSYLY3po-694&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVgF6R8vQOrhJuqap5Hv67dHfhIWoQ76BrxoOw4GwL9iw&oe=6B0EF27E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfX6IBAa0ZEQ7kNvwEKvng7&_nc_oc=AdqugV8gYurAseLICeBn_2k8o2uVaZKcbKablcguI_l6KjElFL4AdSqJ_fL3dEuJblc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3wblP5YOfe6Yh4dmHcwUtXkG0ZYsYdgLEaHu8Kx8SVQ&oe=6B0EFAD2"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsfF9buyU2cQ7kNvwF5WNH3&_nc_oc=Adq7aCJkYveb7tyKuWN4y1sOsl80ngdTwr3yw_LSs_tk7hKKra2irdLU-0_p9_n22ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZpVXRf6eoQDLijjNKJ1G3uz_NhrdZvDdN1LfvLizrug&oe=6B0EFFEE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KBKUukmvW4Q7kNvwFyQl4D&_nc_oc=AdqoSlT4X-2XHr3JDxaOMRd9r-RgxY3wXEch4_7yk4kFl7z__F_LVUrLrjJTwPFgkuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW6Pb4Rrnojbkr-ax19TPRHC8HVQGOb8Pw_9LiHaQQx6A&oe=6B0EECE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-N6Q68A6ncQ7kNvwG2V0r9&_nc_oc=AdpMwJfqzcyud4mNNxLXrn6bovbd4CjudtDly-wuUM29dk5lVluGjb3q2jQtG-0SP-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWwKMFaJqEAcRBwqbVaihLr0eNvlABGsmltgrVfLv4tng&oe=6B0F1885"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
kNvwFAle8K&_nc_oc=Adrw8VPLXfKqYqIguBAWTxr4vPPVbNmSaMYILJdhj8212muVYdbmH8fBcu_9T0E0mTs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UCNJAhzGpVRDoZ1tGgHRGnT7ETKdZJb9s6UpMYhz_UA&oe=69E2243E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rW7XGuTAR-oQ7kNvwG6xc7f&_nc_oc=AdrykbDU2PvGXq3Y2CndeAvaQl4F5dFhoHxsi2geFhnuWnMhw9uYFWuz_ZYQJNproQc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3k4UJC0fSwyO279Q_AU48QMqo7CVuHBJfwI9-HStQ9uw&oe=69E22C92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIkXttiyvkoQ7kNvwEwAx1f&_nc_oc=AdrxPclBXpaOaWrq8jvP0yN1jnh2ui_ji3VTj9-12YaAbGCL_bIOLrtzjwNnSNGJ1s0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i5DWUB-MNK9AIvR6ALZtA_njACYxsEfZbUBbVPpZRZA&oe=69E231AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgkW9nS-7agQ7kNvwE7TXZh&_nc_oc=AdpQheCcWF4tbRLHaD_htoI2bL24pcRl72_kjviU4jPUYMB_P5XsixAysmbEbTw2Khs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RUHq0xYPz5H6qJqj-rKrQEGtsm-n0f-Nb9HpZpvpiYw&oe=69E21EA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0aGt9SeE3BkQ7kNvwEC7Vfe&_nc_oc=Adq6q-HL1yMxNdYje_aqSeF4NDcEonzbR0NweemJ-jzyZdBIZwBxO2vrh6oXsmgDaf0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nZjTCQOUxWLDtwXHmEqFXiqy5utdrbRVj-gAiCqcLOQ&oe=69E24A45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
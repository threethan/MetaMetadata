m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHuF-pwXpQ0Q7kNvwGFEMF6&_nc_oc=Adqgyj71v1l1GoaiJ64GniYtYRTm-ChWcAfBEghe6NDxmJx9CBl5vb8VgW-kNybZ2bY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS-2-byo4AmSW6oHlp7ZqrBs93LdKaPXndXGHQHkojDQ&oe=6A9C3FFE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er4mh1jyfn8Q7kNvwHgBtdQ&_nc_oc=Adovv-KJpk9gcDo2O2ppCwcMjLKXDP6ssTsSPLENL7Ad0S5sGigYDXhgjSS75GmxCE0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiaD-wCeWJBoPtzkQoCC6tkMjMelmH9Vt68SLvF_H00g&oe=6A9C1012"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eLEBsvWoz0Q7kNvwGaP4ka&_nc_oc=Adrs-om1B0lIyvMFL-YzylV_mo11qr2uDz0DADubsgS6sKEj6DnwRCBYbN3XtihjJUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKikOip0dXLbqYLX7LFwG3xylBd04HQMMMdbJOiB8fzYg&oe=6A9C152E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gx-F0J2ZYoQQ7kNvwHBEfdD&_nc_oc=AdondovRb1iS6oMVjcBlQYg0GQKEyqhlpJGyE0vaG9ruDnCAcO2lDtu1INDXERMkgQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNftKOYVXctYyGFxzeemaL2TLFmWQRgwK4N475C_I8zA&oe=6A9C3A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F0CisLX8RUQ7kNvwExpr1o&_nc_oc=AdrOvIT5zheioA1jxpYx2_vPKmmhskt6AH9-aoLYrK84QAVHBAfqq1y2AFx6NIzP12I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0HksVRMkn7rfAIH6uUYfRILDZYvPJrN1dRl7W_4AOtg&oe=6A9C2DC5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
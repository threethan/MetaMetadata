kNvwEuyDJn&_nc_oc=AdqitpRmpWzQc_Xd2jq3nhG0nU8Q3-Le5VjLhHbK4sCidFNmS5k-44vJ6LHQtUpXrSs&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mjzLQLJjyMbE3zMC3G74kXCUwauDOauENZkiQD8ZdJg&oe=6A1C5E7E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mK15joWnc0Q7kNvwEk82aL&_nc_oc=AdoINxRMsGV8fx2HH_hwA4cygrTqRMFutBpAUTw0Rj1puUv8NWlZyRlcyLdxYaKlzws&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-Lroev8KEaAfokRNp_eIQL9fx0jtDs7spr584JzrKyQ&oe=6A1C2E92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW0lMJv0HfsQ7kNvwGDIB_L&_nc_oc=AdozLjEUDQLv495jeZNHUh-QuKWdEu30U9eOsBZ7qiVHRhdOc9BzN6Ou-dAiLQx3pRQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FPjPBkoTW6QpzuzjgEMTFT8ui5bO9oTwW5TnwRAnQTw&oe=6A1C33AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrYInfjcmyYQ7kNvwHXInNr&_nc_oc=AdpwG39LkKLS33wIDzARFFAww9dXoTs8p21EBR_hpZIFqaOJy4otHWiXWngpVG_ekbM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pdIssD0UrpL3VaQApgm1HoQiTNHMiqwM-u8aXwIlSDw&oe=6A1C58E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0dWo0Kgj-wQ7kNvwEHusC5&_nc_oc=AdrUlWdTiWsViB3JuuTgWAX25Q_BLdfRd1QXVdTHkQkAuA-tK0tOUtIvS4_RVJqULq8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CI0rqZuc3MVV80nEy9x1oxFRWI5W-HQJovBkevwKmrA&oe=6A1C4C45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
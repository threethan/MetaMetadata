fXGge1U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af19emU3WqGpHZ32aknF86xXH-7LNNUC2M78ZiXzBx3ShA&oe=69F1F63E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHC1829OTEMQ7kNvwHdm4fu&_nc_oc=AdpR4zvxbUXFdt9XHlVl8-rQAJHjIgG7gSAP2Cxq6BmEPBy2vcfi8wAnDnuA-CfVZag&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af23aO2pshxev5UBYLh799BQqWZ1RaBU-_kiZJiuUTaXKQ&oe=69F1FE92"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiswVPnZQOMQ7kNvwHlgihW&_nc_oc=Adq4JhwtcZrB7CgIxrUMpZx80_7G94tfErqfz7kdgVTOZKZjzaUhQQEu11EOWTR1U7U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3c44bd81l7nJOOAsihd11Ed6IPQi3w6MlcXBAu_mp_YA&oe=69F203AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKTXEMO8z-IQ7kNvwHvw-Xx&_nc_oc=Ado6idVX9-SLMu8ztknaSF9tHCOkbuuaU7Xog6X3Ff4zVAd2zYK_nme5PX8i0liJBy0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3L06ZtO5iJI_-4nbeMKTgF-qeJhCYVaayJQACmBQ0bhQ&oe=69F1F0A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_U1KhDa6NwQ7kNvwEWWGmt&_nc_oc=AdrjZmX6IG2bd5El_m3XZQnXSfpI7hQAKFExQNAJQCmZ-0oemy-QX9bO64ubKj_l4Hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2evcDF1dVyuy4eaFBf1rhAqwJ47RiKAD6j2dewULQtbw&oe=69F1E405"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
t=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvojbOE82TGdK1IIkiWx77iniLNXUR-vWbtov3RDKYWBQ&oe=6998503E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2Hg9ha8qpYQ7kNvwFaC26E&_nc_oc=AdlypavcZy9L-weNgsxcNvrqfoh5SpNB0GubcO7VgfU2P2R6DmD7bHL3McDuPKIgwPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afth9u3nLZFH9HQ1pxq2wUELO7ZJGS0Cy-83zQ-5KJlo_A&oe=69985892"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-F58amzWapAQ7kNvwG8u0H-&_nc_oc=Adm4Fy7f3qZfJsL3mdOUMePlrElBG-yQm7uYKTIS-TTZ6u5od0fXd_u_KNCfuzYN_cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuvHPVuoULBAVtPN5EIqnDFSTpXpmhiiuMwesbU1aIPGw&oe=69985DAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0qkm0SmMr8Q7kNvwGexI9G&_nc_oc=AdmMnlIM_lFnmOipb8Ay3wr6BzlrVfcdciqMQc9HbJ0PO2t3dH2Sp11ByrZRPtfxjYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfucqeQCfehRwjBZEQTAVhYtnF4bBk493SBj_JdP0YpRlA&oe=69984AA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz3IPspZHeUQ7kNvwGpQaqa&_nc_oc=Adka76cDZeZU-62qumPD2s5yBlk06VNxLoYu1ZYuJaB6u9Jm_ZFwgVz-TfYTL3lGRac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfskBqVkD7i_X6Hs1wdiePXu0f4Z5kd6Ms0YaAfeQXrTVg&oe=69983E05"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
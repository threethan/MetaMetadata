kNvwED8xiN&_nc_oc=AdriQaEmGkxVh5uGABnHpe276-5Eyf_LIfxDk7Q6rvjMVNo6BebjST7esMaoeyiUhFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxaPjRbA-wcM59ql3SyeMpfoNjt85J52QOZJcbgL8pNg&oe=6A689D3E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg4yvgu3gYQQ7kNvwH2S5po&_nc_oc=AdpA3_ts0ZsIOuroBlPWj3IxOc_nt02LTpIQ_BrcHYoLmLazaia_oj1Yw_p4J-HeHPA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqqDiB2sxnQoFeeBbpu1d-Ahy-4UDDxzlQqhyqVrQhIA&oe=6A68A592"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuWFssEku8AQ7kNvwEO4QLn&_nc_oc=AdpvmGDCt-JJ1VQUD_VXHGC2AZmmVfZHu5Xi1MDnc7eGMD9ZwWFVCYsSnntkE9zxWw0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT0Jnb_7Zdw55mDRLaDHVK8tIc6Ea5n7dO1BHgMJjDKg&oe=6A68AAAE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l_M0VMSCDkQ7kNvwH4Yib8&_nc_oc=AdpoAVYiYNO5oDFofi0m0Ceo-eCmhJUPHk-bo8eeEqX_z9sdMg94xcymHBudo7PvS-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF_xRxjYpA4KDdVVBdbEl2Br1fY6Nm7QAYQeWWlPTNVA&oe=6A6897A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQuICBkpd2gQ7kNvwHRkEjH&_nc_oc=AdpoovieIXOLr3t6-iFNJlETxDcF_ycy8Mmv2j8IhE4HId0i6CoIKSFkZTRssZJDrtc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWdgfEHcZyUEN3bunoWorQjTU7sFHnyRaIfHXfdQxI_A&oe=6A68C345"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
kNvwH0Njy7&_nc_oc=AdqpRdJ59MqOn3s7Th80mf1ceQHddV43MA098Xfx17kDnIisgNKP8QQpF1xuEem81lU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4STi2z8zq-UEw2a3vAX3E7-vL_CiOizy3Aut5tEKizLw&oe=6A1EC93E"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mK15joWnc0Q7kNvwHIpRPY&_nc_oc=AdptMN17MZJE_QlYJq2KXmBwlVmrlqCNOEqbjAF3uBqidbgydL9B-c3OECCZNJzzdMw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pBCLXdz0G5thSDVg1Upvi3MFgux4JtLElVgoKwe9s9A&oe=6A1ED192"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NbMcDbWpOJMQ7kNvwF9uDZQ&_nc_oc=AdqKbEtQ9aBKAEa5a1SD2b47WcFDXC9JXoSey_lzFm1djhpKT22zCDyLjcv8sgRQ79c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74FIhZK_gIHlvb87WDGT1yc_JRTLGz2BaK9r4S9Jcr2A&oe=6A1ED6AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnBa_NjhfVUQ7kNvwFTQEFQ&_nc_oc=AdpLbc9wRufkJE6nfsHRNZ6ckSbFnR0B6-vDN279PlVqV9OX24zZ2qXNZu1bCBqEV1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LJ7_ZMaGzOhaGN28WI_BLe3wZ_5YFRXynXP06-tx-Lg&oe=6A1EFBE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psni9_8DUi8Q7kNvwGJcRFw&_nc_oc=AdpK6tfuuRuW7OmfBtdx5_ALatX0ri99raAIS4LuAJbSP_iphK7wAxpdhe-rLXNykxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XgXGkbxLVbOPHEeggwdtJ-jEJWjHXiT4IBucjuvhGBA&oe=6A1EEF45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "reco
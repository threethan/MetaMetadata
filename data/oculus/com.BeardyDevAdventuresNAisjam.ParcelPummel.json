m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pw8Fa_PkI6EQ7kNvwFUP2IM&_nc_oc=AdplTdGD2398xBoOU8z8j1p7HX1dfWFgb9AyyuR5699JjMUDLyA2FdTp9beLW87KdcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8g_tTAI3JQdPCSjXSLTlvEgkTNtLN4FSlNliUjfhQtA&oe=6AF5E5FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkN14MConS8Q7kNvwFtyC-6&_nc_oc=Adpzkqw_urIvWz_XRNqNPmfWiieBE9ABNp4bf4yQlET8wTBLB8zKWVXvEjNJMGq8PIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRadzvg-fK4FiAGdJxbthxSoQlnP30E86PJX0l6qQHBcA&oe=6AF5EE52"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYnm38mKSC4Q7kNvwE9-WvU&_nc_oc=AdrAU85Aw_d8HgcrW8F5nAOWSBTEN8gdBfBcCkskjAauVbuzNBZNpWsdI5CQVN_-ZcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGdMKuhL5USSwzgpNPofPKNlKILF3Vr9MRkyDsBn5CdA&oe=6AF5F36E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVfG47HOViwQ7kNvwGpcb9-&_nc_oc=AdrorLo0bWDjLrXlk9dZj1gLp49aDMyC_-kx6QdhN_p222pZqfNztlklF5fcQfk57uA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuwR520qmpMINfN8ZVGP5wqqOZFFPhdumw40X9yHlzSQ&oe=6AF5E063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNNlYfuQEG4Q7kNvwGU8C8R&_nc_oc=AdpF6BnS-FhUaxZpRVUlmsY4HxdMMd3bTHXmwd8w021JHvusQ0aEsC-Uw43tZwQ7wu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJOfg1UfvHkAXz1EKaYFuUzMM-MQqn-RhB8GK3TTzZ-Q&oe=6AF5D3C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
m/v/t64.5771-25/499301050_2084460232044989_7876112671649670923_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmhT9bfHGzoQ7kNvwFJJlbp&_nc_oc=AdpBv4nDoVC8Ac7Ah7Mfzh1Qs1sqPN5CQyezvdWyXufdALCrVAx2E7PbXPE5GWFs3Q4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMElUDPBG22JFDkQ4kiFL7LPX1i8UWRhuFw3sYWJfWSZQ&oe=6ACBB5FE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HI9kbw6AbyQQ7kNvwHDOlc5&_nc_oc=Adq5p8ZRFA4pxKjhaYhKmK3BQa6fm5jqHQ8E7trxNykaL2MKZdutQbI2UquYgsBKwcE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Qiy84Ddxg1qvBoCHBQMlIOQfvcj1qS5SlqsDHqKBDA&oe=6ACBBE52"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUgdrtq9w1EQ7kNvwHMFDuw&_nc_oc=Adp0CGXOa21iRgw3uTahvvmL6f4Vrp8onPQihzgG8UzuGFyhIAWl4zLa6MoMl2WrKJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhyiYuyC_ooOEdNL-MfvJjQhjJpBpx4sX0PX62_TEB0g&oe=6ACBC36E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cYlntTXTfMQ7kNvwHCzuCj&_nc_oc=AdphP4VedNd_VbKYxoc2YHL7Hi9TBP2LRJI0Yz7u2c6oN31CAEoCBsypybVrnSdr87c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2S4a6_sQ5rH2Yv7WdYOnt__jiP4NBC1cg4gR7hTz2yQ&oe=6ACBB063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRYgw6LXye0Q7kNvwHvtV83&_nc_oc=AdoJvTenQd8inJ7HsNuKqjI3MVr7xzM9VdO2YBZEWydVb0i71muemTxbRh-fHG6sruM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl6rF2BoKnIL7RNEPMfMaUIGU8TegeRd-79CGJTVR3vw&oe=6ACBA3C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type"
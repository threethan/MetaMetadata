1398849701183318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO7VLTinn70Q7kNvwHAJzQD&_nc_oc=AdrLtlsaViGMZxY9dXJkehURoFUAavg8yy05t4loicYtSZ8qyDoVxERBAiVU3fBUxHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrVsk1PtVyoZ15zzwHU6MajbCLKIhDbAvk3I3v9n1GiA&oe=69CA76AE"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_d6ju-jKhQQ7kNvwHw5s1B&_nc_oc=Ado9IPSahD2YN9ro2cPmzpeni-ElemT8B_rmZgUns0sAMBpWFOn3ryps-WUlXgqbgFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyyBnJQmNkjtCKDko4JV0N7vXeimUhTm6GQOJzsLb9Wpw&oe=69CA63A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeSJ_aVOhCgQ7kNvwET7W3l&_nc_oc=Adp1VSMg-4Un9PWvsLYZvOkPmFB5jvS6H4oeRrZjkYwaHdJLboX1W8MygGKwn74vQwY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr35hX-W1k0l27KyETk6cfy7sQPjylx-bM6T4PywNGEg&oe=69CA8F45"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25487402434237127"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4489561811270821"}]}, "baseline_offer": {"id": "4489561811270821"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754431200, "status": "PUBLISHED", "id": "4489561811270821"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_res
xm5FvPSqIQwvN78B-HWHtqcYu4ZELOTKCIt1-O-rGO_IgwLcy2LfHoC3pTzw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQM8DElFYMbNVJyqdl9DFPhIAfx1nKg8MdKeQmjxfsiQ&oe=6AFB2BFE"}, {"file_name": "world view 1.png", "id": "1291597455669661", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499625088_1291597459002994_5853306008949369927_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FWz908eYgQQ7kNvwGv4qcW&_nc_oc=AdrYB1F-DpqLLFI82ShrAA_FRSKzsl6-W80TfOdSTZomW71ptnn5FjXfFjTZLUnOzHY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVqi6sHx3n2Ye4N6gmdSVNgV6gvBWXtUYbb4lgCviKXg&oe=6AFB3452"}, {"file_name": "world view 2.png", "id": "1398849701183318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628455_1398849704516651_6207703789210679491_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vouDUMJHHJwQ7kNvwEF_tVC&_nc_oc=Adq1xaXIpVnGuz3ctPu4Efl47vtCegKcEzgguwPrfX8GVMI_4xiqBP-paGsj00_0Nms&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5UbQ3A1wEIKe5yGPgVQpWrWiIVMt4UB5rGPQV8DlTug&oe=6AFB396E"}, {"file_name": "Alamanac Combinations.png", "id": "1095180261945615", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298212_1095180265278948_7592721694031702514_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5UXZdRUafIQ7kNvwHXT3AE&_nc_oc=Adrx8C1szojfM9WLQzS-GOMBNxKmCr0SPiRheQMyGCnj95m5DLS6g7QcsQ9YHOdyHqg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiQBVgNYr5FEw3rzX04vw6deeRmHTbi0ChglxuvEXk7A&oe=6AFB2663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Parcel Pummel.png", "id": "1490423681959604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298930_1490423685292937_7312217641083823550_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW7Bh6P0gMsQ7kNvwGzLmkM&_nc_oc=Adpgf6hSli8jcEwQgPzGHFnpEggeJExpWuMiKRIG20GpZ8NHhhHWqPkgBjETqWYyt5w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRclEsMbajEWoNfvZXe6fhtenRV0ltQj98nPh_Xx4YhxQ&oe=6AFB19C5"}, "display_name": "Parcel Pummel", "keywords": ["arcade", "simulator", "pixel", "throwing"], "long_description": "Welcome to your first day on the warehouse floor, conveyors are down, automation\u2019s looming, and it\u2019s up to you to keep the parcels moving.\n\nParcel Pummel is a fast-paced VR action game where you match, grab, and launch colour-coded packages into the right delivery trucks. Beat the clock, master your aim, and rise through increasingly frantic levels in this pixel-styled, physically engaging experience.\n\nFeatures:\n\ud83d\udce6 Intuitive throwing mechanics\n\u23f1\ufe0f Beat-the-clock gameplay with escalating difficulty\n\ud83c\udfae Retro-inspired visuals and immersive sound\n\ud83d\ude9a Challenge yourself with new levels and parcel chaos\n\nBuilt originally for VR Game Jam 2023, Parcel Pummel blends nostalgic charm with modern VR action. Whether you're a casual player or competitive speed-runner, this warehouse won't sort itself... time to pummel some parcels.", "short_description": "Step into the warehouse and sort chaos with speed and precision in Parcel Pummel, a fast-paced VR game where you throw colour-coded parcels into the correct trucks before time runs out. Built for immersive, intuitive fun, with a retro aesthetic and warehouse mayhem."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fovrinteractive.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "FoVR Interactive", "support_website_url": null, "website_url": "https://fovrinteractive.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ad
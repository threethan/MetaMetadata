dBOm8gC9kRsVJZh7HzVhrq28CHCstVGFkTwdkwy4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN_XZcPMGe8pkDLksbgL3PWb5slH6RnDVom8X_KGRyCA&oe=6AFB1D62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6BsZvHnLYoQ7kNvwHZjsj-&_nc_oc=Adp6AeA8kQ6bnMsKV3vdJlNTmfZg3p4_lhO9QqX8kinB7y-n0VZLqIJSIpITJiTw0Qg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyPE4tEC9pf5O8bAQZFn2pcjewrXGo8zzlaayUN-rBvA&oe=6AFB48C4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=456veg2vAYkQ7kNvwH0hEr7&_nc_oc=AdoT6irB8Py0rIw5OkFGZpNW3llEc9AcNnnW73Idn8gZGiysldxlm-Gj359i8vDg8vM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbMIg7nICIBk8iOBB4Jk9QVeZknx0jZCqb9ULoHHDoiA&oe=6AFB2E4D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOQcFzSOuL0Q7kNvwHuECV7&_nc_oc=AdqfUKbpWlvN7Owq3RX6wNaO3vX3Qb5VGXEjEdvFYZI1Pmj572JUjaAcZ7IGruG5jbs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiM5nNdfFmDheGA1nXOBCaxwIPcPJo02qwxEFPyaIzcg&oe=6AFB4290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGGH1sPbcIEQ7kNvwGdV7Z9&_nc_oc=AdoluLOsuEUuwSQJ12nIQdfegShuUdqC2UEgbjMvKbh7b6pLgme2fYIiWILklIHPBJU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5DeJ8dXHXJn_n-hAUgjdTjAFCx5HmyywFlo--9_6kiA&oe=6AFB1A01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de",
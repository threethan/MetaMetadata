7jVNaUNw6945mZ5Y5Ucjsd7nbkIbq4DIC4MndeA7PRKEEwPmOMbAGWR23qYC4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqCqgJjBkjDT7eOZKqjXBptoy9UAHjAOePDGbJQPDglA&oe=6AF09162"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Quir79pOaCwQ7kNvwF-lfuK&_nc_oc=Ado-R9PgWYzkQYB9UdJdDB04S5awoYaF6efyV49Eu6RJ7-MbrpXDipglYm_qc1t-GX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQtQotk_tvgcXa8rCXoarV6euMksx45hjZ1CGz27d-ZA&oe=6AF08484"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkfkdgQlkTkQ7kNvwEUNa1p&_nc_oc=AdrYJuE-P-Gt78J1RkNMnNY1DEZiUJxNV0OQk_tZCvDbCmExBnDHgbg5LP-EN7f_1BI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgbVjqi98Iy9W1Cht0Qqm7w8Nldw-i3Q0odVqgXhv9cQ&oe=6AF0A24D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGAXKywmzfQQ7kNvwGbxDZo&_nc_oc=Adp1t5h-54nPDFgBWyIVZEVGkSp3lGBSVIrTBF4WAfNiMd8zG69-nWku-u3dFn_rgSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv8imoizHQXc_hPaYiz7c8sfhpuSWtDYswpSa4346c5w&oe=6AF07E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhgIGpxjj9wQ7kNvwEwQ-hJ&_nc_oc=Adr5YCu-PGWhJShQWf5UWAaTXqtfcBGv-pLbWXNvAHpyMIgbsz9gnZ2yj9gOzayLP-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs0rWCWB9-VhVFRnL3EfdyeYs--TjGBOWus9X_L_2Qjw&oe=6AF08E01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
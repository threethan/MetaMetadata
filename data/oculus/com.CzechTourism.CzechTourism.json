zUpVIoboWENl7aK-9I5no3y-3kRV4wUmc7JPXuxnwqfit3bIkNApMhq57Qs64k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvDDwD4AW3pWH-qcrW4L8PxQpE7-kWm3oAvoquDgG5bg&oe=6AA17762"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSM8UQxUK9MQ7kNvwESoPuU&_nc_oc=AdqCxnq19AEscfuvxJ6PIGnQfKLEghTGnFj8596fmnu-ipuwNv7GobdP6rJGZ4-VmXI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQzoynzdGe7wUzibyEV7gfuLelB7psQXEShkcTHe28cA&oe=6AA16A84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I25AYi_tzIQ7kNvwFIGZyY&_nc_oc=AdoV3ZIkV7SJpXm9hkhHNPUvWTTsOuAeRH8yD_Fs_6jDydFP9df04pDxvc9EuGvU1z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO3aPDikC0EfUM2mYcMSHEwNRwhjbJs5Zr9hdGPm8x6g&oe=6AA1500D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIwPuBC2QEcQ7kNvwFJylqM&_nc_oc=Adqn7NloRin5BFqMHS7vO1cZXMzIRI2a5kGEAKlgp4MbT57onR-McuZtJMYluhSgMh0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_kKcefbe0sXgJfTfNi6qEc2L4nxSzjcyhYs76CjlvEQ&oe=6AA16450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yy0-qNadfOQQ7kNvwF3Yd-V&_nc_oc=AdpvgH0GM3sQ9d6Ahji96W-j5_DJigjFiF5pDbUfVUQ_IDFCLTp0JAxvQyXR7Fhf2QI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO3MrWZ1yaDw_tyMw2F0l5CRhMWNFRA-tPxciOwzHcmQ&oe=6AA17401"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
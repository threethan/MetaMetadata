.com&oh=00_AfszTAf0a2i1M6gq5NL-C-4XKWbhnoAjIBp9jvO84zH0WA&oe=69A02AA2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr15smTW5UkQ7kNvwFLS_BD&_nc_oc=Adlf5yp1NHVEEMhJj-NejkQCrvaZM964rncUoy0_cEER_he-0AofBVBd7b09J9qPg4I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP_L7O_uXlat07AoidfbTf-B0odEqFoKLk00HpdolFvg&oe=69A05604"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ2K30_-rYYQ7kNvwGH9Pv0&_nc_oc=Adlh8GkUJKYH0Q6OkDiMZEgVlAOMex_eTUPY489NmTsHuASbeYPPc2vfGnYzF-P-M9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK6We85YbOGgXFeysroupM28tRCDzuwFdjUf3skewJjg&oe=69A03B8D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7lgRbTXEcsQ7kNvwHt9tEM&_nc_oc=AdlaA0G-XQUgwCvcb_Vo640RAhC4XvgQO1oFUf55JBZPpwwgGhHtC6yKuYpzzDgX1cg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvl2PJhqMzgllwivYF7o_tcKfhlgzEPVMAOVxHmHDqXiw&oe=69A04FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY_I-gUftj8Q7kNvwFWRFLd&_nc_oc=AdkqRe_MIquKM-wwnWHzVR0JOxe-LW-iVpr14_9yqvgoGWMlftjpYq0qZtgFG_ct5MQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs2EF6_ptefle6JzDy_AdYMI5I5eyd8NYqvbAPOFor1Aw&oe=69A02741"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
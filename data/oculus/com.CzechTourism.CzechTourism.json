RT9QHb8EChVT-kROcI5YBveBPULsa8-EJsmTWCJSQO-nEfPsD6zKGEHgT7o_IQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVi8Rgc7z9EuxmxQpiubCp8edG_CfI68FMINPrB2rlvw&oe=69C514A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B9_DPr4JMwQ7kNvwGEd7k0&_nc_oc=AdpoEe4yarXOR7-US6nhHnvZ2SGf9F2ECivmKjC2zO-B9-neXPzqxZZySNKCjdV0KZ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyo6vxqJvRtOCoO9dFOC2oKKcBVfWgQ2WsWv8oRLZfJiQ&oe=69C54004"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wry0BJOHswQ7kNvwEpcrcq&_nc_oc=AdrZjfE-nhF2NMeIJ2p-TPttszg6c2j200bK_jBBF1rvovP3r_OXRgpg9ps9Vr0MEB8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy0xipIpH3-hQVqsEE0o4dr0sCL1OfUugfA9et2ixMgWw&oe=69C5258D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqhkupa-eSEQ7kNvwHHlBEy&_nc_oc=AdqgIi4tMXeUmQWAWx6vFcYMhD-DLPijMVZyAfKzdJoq70h3zHRIEwLhLokMBEiY-TI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUAbBbDyFEIhuTaqJBwA5Sdo_WqiYUNh41r0_1hDdldQ&oe=69C539D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIkIK0ECo00Q7kNvwGeP8Wv&_nc_oc=AdpJCxwUfiBZ_oQWZHiF2litwvkBhItrOJWhyunhVDFLK6FxSJ5Gryu02ZHsEhNSMgQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyD2W4U6w87r8YYSlj9-jxQH0aQQqrvZBLQm679T7VQdA&oe=69C51141"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
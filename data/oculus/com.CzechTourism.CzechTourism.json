oBsgBUyu36S13ZYP7a3e3TBTKqDEuBovZi1Kwzk9m83_f2hwR2qecKC8iBMF4c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ZgUNlgCSH0-nr0MqDf6J7nBl6k6ChfsDvQ--1BBiJ5A&oe=69F4C2E2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6UHxEPz8pQQ7kNvwFkPb2V&_nc_oc=AdpYRNt11k14q4C8DxzmWMi1jSA55IOgTfj3pUei01PwQ26WVpA9mgnGwE27r_N6144&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15IpMPIn9FUFXGh122_vq83GexyLEnt0N81ZLXZCZR9g&oe=69F4B604"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKwX2K_skbIQ7kNvwHVuBbL&_nc_oc=AdpfXauT_LoPja3CSgAipl8MVqI7sPgUsiuW8EWpmGwJA_OnD5Kdq1Jq3sT-8_AvtkY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2a3GbIGiaDJzjdM_EveylwDBBTG1wjpgok-08_D4J91A&oe=69F49B8D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LOsXzJ9zyYQ7kNvwFd9rvy&_nc_oc=AdrKZ5S9e9QBoxa_H4bRMKGGi3Sg97sVzAO7mYh6JaoiiV5vCrQvMVJUlmJQLQD8AC8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ruzTDQl5vw1SSh9HLPZZ4gtgjjdw_ONSxktQYwxxCgA&oe=69F4AFD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyzBTmvEensQ7kNvwEqo5ka&_nc_oc=AdrUPg_y4TZnQKpbr4drdCNaPSp6875m9nQwsd3myGYzLT7eBsLNEfX9Wdyrb_h7zG8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af049p1LDAeg8QsJBc7HSgAx-xfyeISHb8t7QwLp31gUOQ&oe=69F4BF81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
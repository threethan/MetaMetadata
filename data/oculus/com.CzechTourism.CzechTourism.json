Q2Qu6l4LUW80EhYg87mvOTOxK782cjy7rnHkuF0tuY-58SKwMFy2USkoLqADWc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Gqbbw1rFIsmIArsqHx4tWO9EOriqbTG-4TDawf7V8A&oe=6A998E62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zD1EqlEAUUMQ7kNvwFyCTJa&_nc_oc=AdofsdgzLiZBj-Y0z0dYtWJl1ch3jlmIJCOpdP4XDJy5VlUk2Eyp5FFfFcaD9fiKbjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmzFfh_iJMPErgEvHPgGCKVqPA7xWsQV-PqtCLzbLLxA&oe=6A998184"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Od56kQJCe8Q7kNvwHq7P3s&_nc_oc=Ado_texUbEJiCaISJGTYBPTnthzHK3rduuuIdfOum5puqMQv1fA5JOkkQnF_QTu5BC4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKev1ADc1xfwO0nBI3V6OAlsgfkOy-qqKupcNx6fUvMUQ&oe=6A999F4D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tW59tschuKEQ7kNvwEDdcDh&_nc_oc=Adrp2-H8fsQUug9k84s_OZtgox4ZwU4uae_LWLmNIRqUsvh4tj0fsqa9rckiY2pY69A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSTIA71e_iL7afnZ7rblPPUPgY84PluKTz-7FWxpr-EQ&oe=6A997B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW0Vd9d7Y2YQ7kNvwEmIULd&_nc_oc=AdpeVjnFi4hYf8e12vJtdPw9mojS4JGkEWvwNzf4d_ChHkk3_EodqEolM41cbkqFDt0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOjImTQOOcD-qB3SGOc6OIa4QUNTEsSL-vkOoFXv-0pA&oe=6A998B01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6aSWn-XAHgQ7kNvwERYKkM&_nc_oc=AdrJJEV0GeMyymgh2Mu8k4wo2C5CsdDVoCK2yofD6OBB5-T7qDK2mmJbCsjbktBDRuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhtKqJp3-ICCfQVAsNe0KTpXCOgy0zjQ9N4LkdepLIDA&oe=6A71DA0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOvC_xy9Pb4Q7kNvwF43pHS&_nc_oc=AdrSYXFDwodOA2HNhibNstTTtHSg4tXws92LkOih3KYF5SjHs_CF33Rb4h-LOm319yY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDT0dpiWqf4J0OXt7-FagCvBc_jIfHJyuIjviEGbgIJQ&oe=6A71EE50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8D4pwHn1NcQ7kNvwHa53bV&_nc_oc=Adp8WIPYkbUPhKQFo35Zb2woa6kRj3nCDjnnjYpS5Qr-yvfRRA6c3nV4ebW5xahhiSE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3KJWZNnzSGwe-A6LP-3b9oGwLG64oFqrkE8o3aWnGWQ&oe=6A71FE01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1575784629613065"}]}, "baseline_offer": {"id": "1575784629613065"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1685723986, "status": "PUBLISHED", "id": "1575784629613065"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6651952641555035", "version": "4.0.0"}, "id": "1213123392847463", "channel_name": "LIVE"}]}, "is_for_oculus_ke
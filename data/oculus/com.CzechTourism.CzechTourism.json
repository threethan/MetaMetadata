369820543595945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7qUsaRv-qIQ7kNvwH2tPyM&_nc_oc=Adr7G02QGxYFm2X8Hg013j8C4t2XzaA4-Xh_1f78_9c5SjlR6s3SmZjpCCgVUMamXEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIbv9zxxM6V1Pami8mbbjAwPNPeasaLpfMk3SJT4ozRw&oe=6B06FAE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wz9VM_bgbgQ7kNvwHc-4te&_nc_oc=AdrFc-yAdtqkbHH4NAqRTloFtJoQQxqQt3ESQEvzMxMyyVrjzh1YxbWOk3J07-bOX6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1roEpVkc2DRlUDK2oL-E2fC5PUqpp8tOsIx1vDHdsHw&oe=6B072644"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1upxgpCEAsQ7kNvwHDiHNs&_nc_oc=AdpB13MVMY1gh56kakriEI9Vpiz7DqFjYugyHZH5V3gIz8VdyeHd8loyLGvZzWyCoBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN5p6fvlphc6EG1PvHkl2Ec5llSVPLxecR9IgvynELrg&oe=6B070BCD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mh-LYpho98UQ7kNvwGBsVa9&_nc_oc=AdrG35tX4CdSLTf2A8T14XxppMI1cf1QhkJL1esP2elPKSsKA2-ry7BuhNnRoFOXtt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdY8AGpjK9dyRh-hj1gB-3bGBmspfw3kLhNeZxLAggmg&oe=6B072010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNcMSdmrsxsQ7kNvwHYvPxj&_nc_oc=Adp5gbKNVv5Sjl_aSm24tPhWam1PBR32O-Vk9fORfVATAN9aiE0qY6z0dkMld1cu3w4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD66bBFmQQBqIq8d7Leh5lgfshMMeXl2ErrBUq4uDZdg&oe=6B06F781"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
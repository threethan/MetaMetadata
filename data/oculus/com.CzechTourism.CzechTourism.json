9NHXWzaFQyabjbSOaM9byv7eyzE3VfteOU5XBPDAq07J68bhqrLYoFkaylHzB4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qYB4O0aTg-YqqXtA662iH1G2X6cd8oXExVYwwcrMlsQ&oe=6A452E62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFBp94YLXAMQ7kNvwEOHoca&_nc_oc=AdrJIe7Z2Px4YNKLvJBZ5hCqOxT-FHGVs4gsBCgibReKNSd3GwFxfkns9HK53g8ryiA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EjJXmqsI97UoVL4XiBR9W1Adk0xSTDQLra3N0mtrriQ&oe=6A452184"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2s_GgoVvEsQ7kNvwFdKp_H&_nc_oc=AdoTmVW9XOUtMDqsx98HuA7ygedFCQ4wLYKOUyOLong7jSy1nGxaZd9oeD5wg0-uz6s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1TDM2jslEp4-LIJ4eIkm0J_hPeGcm3ZmrzxgZYtm-BA&oe=6A45070D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei-2U1gLA-0Q7kNvwHTHIBh&_nc_oc=AdprBuTySAbn9Vaaks7reoXryv7_2XAxaz33Uu5QEAEoBSYTnNbmFlTgG_c5dV6r7vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BtQOM8o5eLbI_SCQSdcmVdq4YYdiDu8f0cH5pH5fvDg&oe=6A451B50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFhUWLin5JkQ7kNvwFwiTgy&_nc_oc=AdrP14p9CAOfxV-cGk10y2G-GaPZC6TrDgYM2Le20_NTAX8VHRsqZWIZUbdzr_JeKk0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gh7njm0yNcfBQ5MXgvAfArRauP_GUDD-chp8ZCcaGuQ&oe=6A452B01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
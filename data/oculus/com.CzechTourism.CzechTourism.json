PIyNhAdns0Iibxq2utOVdxqGYdLwNQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGxvKfg6vAWw5QlNL15aPoTNEIaWPvdPK1u-aXv8kFmw&oe=69BE7D22"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHj8aG4BGZYQ7kNvwGYkmUC&_nc_oc=Adm7C2zRjUQDxYKIFAG_petu7Fz-1AHW-cxj4fZYB07cWpXrvryYmWgj3mJCpyWQ1Os&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtPdeGFPrt9FyorFtK2TDuJehfwOQTplijaih8eMtYiA&oe=69BEA884"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuZmcOkFJykQ7kNvwG4iA8j&_nc_oc=AdkNK2N8NCa1uXSXTIolzM8jsnSAzI9vtSdi4hKnmr6hZ3c8Im8CzlfIP3oWXppHmBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi9pEg3Kd9IVlVwwpwXQnK409CQR1iSo_4tX66skv30Q&oe=69BE8E0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyGeAuMaoegQ7kNvwF1Hly7&_nc_oc=AdkFyaW5jci-Dm_AUbapmw50XLdwQ_Nw6Ep2GxafQEcviI-TVkeXjO7wsaEiDrO1rS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfznSnozb749Va6v6RDSv3WkeRk-X0iLDrKDQZpKGPlgcg&oe=69BEA250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0apDCxkLkAQ7kNvwGjC4Cc&_nc_oc=Adl8VDb2uW_LU7oQo4ffaKKvWMLHCS6317YcncYHwxDIeNoFeegTyJNHToNLeuFODEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxcjk3C7XfSAuzHuLmo_YywX_je5t-Je7dNhGpbuUo6tA&oe=69BE79C1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_intera
A0_Mslciixpo7MJkBCEWiWG2BZYr2Q9ssGzPEdW4B6Swu__jJJSEfhXZ0Fmvzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi7UiH11POPcz7vkK09m5Ab3TbGSwpmR7D-gqDhQzlJg&oe=6AB3EC62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHZDeTIedosQ7kNvwF6UwsM&_nc_oc=AdqxEecsZU_yso_3o4sRQkUI_Awgfiuppf_KmvcZ6NciSes4xP12bjgkuqHitBuVCfM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlvBbKGG0bYc349ENSYQoqryeH3Ajp4FpN4zFqxtjvwA&oe=6AB3DF84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG6LPuIZkLAQ7kNvwETbRN4&_nc_oc=AdoLluau6Bbt-ROO8oI08jn0gx3h0UkQg2ExalHE_IoqYfWVN4HqMY4KVtKj_JIe0Ik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0O9Aaufg9Nzuy1bB37vW24cwno_Qu-WB4_GyW-7CNgQ&oe=6AB3C50D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyE4WB72QnQQ7kNvwHkfxb1&_nc_oc=Ado5uDi4inClQxVA29eJEKP_6lBUDxBSuH-umPQ7-_dC4zSs6nUy_e3XQJ_gAaG95Q4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQs3M0vL0aQ0N22RuKTCHslePpywQPSPSErXxQ_tVI9g&oe=6AB3D950"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmg-KgB31tkQ7kNvwH1XgNL&_nc_oc=AdopbzMELL0wSfXymTdCv3aE7nHOuUynxw2GuW4qPReQf_AYoFKtkTsejK9rJ8GCpUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOuZiji6UUWeeUt5PSdoZN8_Gqc82pNdacMwQYDxwLIA&oe=6AB3E901"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
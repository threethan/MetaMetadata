72YFxr4gSh-DUhqK8qVN-kW_xlkF9MC1YeZZTTdNfLlpul5igdFa_gnlqW4oXs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S5rWW6QFzRVr8YUZTixnYNRxOkxjQz4JSWx60wol2yA&oe=69FDFD62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFcyC_72esEQ7kNvwEost_T&_nc_oc=Adq_Fn3oCQQZaOGhVLV2TwDzwUZmWrmAWCGiblDNJdG4yNNfc7w1y_owa10gf21iA4M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZvX1SDlFq-D2QIJOhghA_HrcIgqryZBMG1PcfqHn7aA&oe=69FDF084"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZJufbUMWLYQ7kNvwEyg05n&_nc_oc=AdocmmSGlrOD3q2p2CCJQIKljWzzbmbAXXZ0pTyHJrj6m0XIPyWy7vKSvCswIsWNAAU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57XlMTOjDUiJFXMJjRrB1vFaYc7K0T4AepT21WdSwQvw&oe=69FDD60D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oCfwfpem7kQ7kNvwGZKVfc&_nc_oc=AdoiD6wzAnP66BGMzzIxex9S6XcTD6q41cLaX4sHKZGpmD08xTfOawkrMIT5ZFGjmHA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6td8VT6y7dF6XeU0RQoZHuwSbr_ADYNpV3TlzhSqVilw&oe=69FDEA50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vNhZ7HpHJ0Q7kNvwGky910&_nc_oc=AdrgWi8Rvb6rJsH-RRj5_cPYBovyX5JNZYfh_m0ICKdumYggPchLACDmS7fM4BmDTCQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-aX0TqkNwjnYQ3Q7pVqpkr6cCa0_qGl9QiMFPSP6p3g&oe=69FDFA01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
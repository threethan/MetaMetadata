2qstc1gMW7WW0dWtIvgHn1sGo8KRfgqlKLcnqVP3cdgEjxW2cIEmwybRix1zT4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A5raImjx3FVdAnphuQ_-onAfKL7wm0_dehiTjqfUU9w&oe=69D27BE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMOCIgUqbEAQ7kNvwFtg-DO&_nc_oc=Adqxn7CkS9Uejc8vkehq-SSADyNaoZQlnmyogEPwJPmZOT8jimR5kVNAl5IYGv4_gW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v2ireuzEcAub12tLJChhYRNSnVjYNVZ5GCOgtAh1Q0Q&oe=69D26F04"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlpvupWX1RgQ7kNvwF9eZrK&_nc_oc=AdqyKOEL6uqcg37sWvdpX3hSgWWDJMc_9_83Rr6CXT-0Al8FvTSyUMsTPUMXq7niU7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LmcONXFErbmn_H6LdoAYlJlXguPP601SX1uE7S99jJg&oe=69D2548D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M84TlR2PJgQQ7kNvwEF2Rt_&_nc_oc=AdoFgWMIN1OMPdejgJfuRyqxnWOj7AfOMDDyDROweAiGI4lqqJ0a501g1B1HzliojP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uH4Vx0DMPxKAOhjLk53C9EfnbUDVF6BOWFzC6QhyYog&oe=69D268D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eipdnCoESR0Q7kNvwHkkjgr&_nc_oc=Adp7djr05sqTuFZix4JBo1EqDndT6YO3lZkVDWyb3Bv_9RjjUzbGSYwrhm4eGvR_8oI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24kiewL4TkYZS-m4AOBn-U7dvqX19Jly24LXf3-LPo9Q&oe=69D27881"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
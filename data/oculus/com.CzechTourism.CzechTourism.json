R-a6RKUQ7ToDafN033qZ_K0pZOYSHFhr3t-1c_uRg2l-HQVjLWgcTv95tYACBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rz2-knsirC_RdPTuu-JOuISdWal8wJFu7CE_CBkF60A&oe=69FB5A62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkYGZUlu1F4Q7kNvwEuUssO&_nc_oc=AdrWL923TZGGzVuvWqnElRsEzu4dWerQg5ufGJYBgWy42d-QVgvhZbCuLsfcRYPiEcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lc5g0e4Tg5MfBbybA1o5BvZuGkxrDhyJYb_LNe98KmA&oe=69FB4D84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZJufbUMWLYQ7kNvwGxQ5MF&_nc_oc=Adrh1Jf43EvtbwuamqiS8LIodHB0ljFZgUbxqpccv-KSKXqKI5rPa2ZfKNZiVBFQrgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SGp2Gk2idWBe4Jl_6MEkTQ7VOiX6oWnwZ1eXnQSz9gw&oe=69FB330D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oCfwfpem7kQ7kNvwGEuE1T&_nc_oc=Adro4Ou4ywtXIGaUCEskQ-IjOR8EjWZ2ZjqyAJZWHVJQ-YgkQWCeGJee0HwVYfpinLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pG0ioHMTGXlJ-qIlDEroXGzCX40hYst8FcMkDGTOrVg&oe=69FB4750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vNhZ7HpHJ0Q7kNvwEJD90_&_nc_oc=AdrCtwpOhXvIGnXdJmTF63ueDEg8CrLjXiHf9I3YmC9jrqDfr1bp5A5BmgyY84pm9GQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DdupO-dhYuZquSbDDZP1XZkhtHjUYj0dVCptX0cw0Dg&oe=69FB5701"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
KcOMsQs_GFFJseg2xCQT1__FDXRb_ktEBv8mJzCtRL3KBu4fidYcn_gYh9eAZQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw2jbQf3eeQWDvJDxToPuXABQl2n5BPo4ySSyco9v2Og&oe=6A69E022"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSl-ksMC2sEQ7kNvwGE0r0X&_nc_oc=Ado-jzoLrSUlgGaDtXuCpBhlRj-zu6dGIyOayXPHGF9cwAuvXrA8uwmgYM-qjFOwYP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD3Kh9peA67t-_IIbIhUxz6rBKLN8IpXB_z7lMk4bUDQ&oe=6A6A0B84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCsqUSh1dMoQ7kNvwGRbvOK&_nc_oc=Adrq9jhsewQkesQXPUz9FzMp5ZACKfdGndQP5AiMkpRpw8lH_Aws9LEhfcK4AUt1hKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6YE2r4GmsHPrlvv4fSKWjuatA_cv2vh-lWSlQ0hjBYg&oe=6A69F10D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfjcer3NZgQQ7kNvwE0Iqaq&_nc_oc=Adr3dyRTwo5sprHeU0TQfIxjGq6f-qvjm8fEhUviKT9Op8COD-JJO_-1fVGTDPmK3js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTB6Jb0ZkBCIkv9vtCGX5avMB_6WbpME8QTY1MGoYUuA&oe=6A6A0550"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CD06-_w_zsgQ7kNvwGxjDdc&_nc_oc=AdpeZ86L89NNX3i7c2S0cctwQoi2QQpnb9CNdfPRPXVzYrgCl-sMUbM2PnCzQWRd30g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqf1iEIMPiRqhzAEvVS1z7ps2j2Mvx0tv_byk2L9Z1HQ&oe=6A6A1501"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
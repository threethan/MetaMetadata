369820543595945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLyizz9vwrsQ7kNvwHiS67d&_nc_oc=AdqlBu0Jwe8fGkCdCkrwZ4XMV3kt9_qcWt1nZh8CLV8Nikhy1HbEOWt_iIxBEZ6G--4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPv_b0lVXpE61lWryf05Y09iPhIXdlZJhkHA6acK5VRg&oe=6B01ED22"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYK6QF807s8Q7kNvwHR2mw7&_nc_oc=Adp1Gbrx2GC2i40lz2TKEGqH--G8Ojloe-bUh_RAEg5lnziY50vKbvL7M9hpUxyabso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ_bbYFZ4XYuH0BWEzVOyWjoj3Ydz3GGa7C12nEpMQKA&oe=6B01E044"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki2COJanB9wQ7kNvwEiGkez&_nc_oc=AdqGlwvwY2oRBZOz4Sim1tBB5zR4OQugIv7BCGsbHtGR2bAe7yIFgr1_EQlF-8g5WZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgjwLmxZ0Z5SRqcbIiBdSzqKZfuoX94VwA3CodZhR5qA&oe=6B01C5CD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRapWAtUBHcQ7kNvwH7DGrX&_nc_oc=AdoejrEpoyf7-fLYITyJ3Qq7Ve5L8pSTc_s6jj6SWOl_oMoJmDo-1DOIAT7WFgWFrps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyAayFpbJSsWNv4pRng3wOIaorwNkTnLs6XzQHeW-zQA&oe=6B01DA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0r6IuOpJhYQ7kNvwEoKx5b&_nc_oc=AdpkeYJITg4868TrmSK2pE_99479YnQIaUWDtFYIQIgc_9JN4LzDETfbsANPdMPMYIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSAMrJV6Y4SD_onWtzo89qBOAk__kSUnK3xaUo7mWW5Q&oe=6B01E9C1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
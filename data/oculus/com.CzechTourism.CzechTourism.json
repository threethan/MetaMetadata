DgXd2pAq0prEOgAgDy4-oU3TsSZUOXpNCN9_1qrht-fVZTp_PMFT9skPkcQWq0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3TwJFPZxBoLVvvdNPT7dazuD3smmD3M_6NGg5S0z3Rg&oe=6A86E122"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKTmYK8MRt4Q7kNvwFcFnuu&_nc_oc=Adqy0GAiW6mjK19nhFstOm6eHHYdT7X8hWnX7IzUF_8wFCvOzUUjECaXs3XZ2FgBPXI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb-GJJ4T_xDt5gdD1A1wyDz25ubqZoUrmu0cE7K8dE3Q&oe=6A86D444"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__q-KMLp7HEQ7kNvwFOaqFK&_nc_oc=Adr7FFepXg14p2qoY36arTr-UTBkXORcq3603-bhDsI5xMEZJR0H40xG3Kz1OQ9igO0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFczX8T1kenAMGvvluwCaUdc_JYLDN0Z5bEFjgppWtJcA&oe=6A86F20D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzsR-sIBq0QQ7kNvwGMegTG&_nc_oc=AdrFI6RXV0lX8TLJyFXelx_4x3S49oHNGDPIVB66XSaQxm8hEnIg9Q6zwj3EygnHKyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQVZYYbgiZwdcxPXagb5QYLbTmhNe38iiqWjweNXXxqw&oe=6A86CE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyHe7Yx3aTQQ7kNvwGk_ZJZ&_nc_oc=AdrE7s3w5tUAcTr-e3VHhi9KeDh3O-LJW_LsfTV8K-vqTW0BspfoknkYIEKCNcNZIzA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuWqO2lx1Owh4_vcKFYBJGo7bY4vdKmwFU6R940HGM4Q&oe=6A86DDC1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
qE8vvwuYfQy2HL0TfarGBg51F2jQhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsjU-tcyVAxFomMA7pg8nE9_1E7uzU45SU4V28SOEHIA&oe=69B542A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tEnyvNS8foQ7kNvwH7Mfdj&_nc_oc=AdnzBuITJUMasnOLEANY4sXT_XP-RohCscg0x6VCFuULhTMutiUg6qSLCG9Lh7Cf_bM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIWOKD7jMQ9Ls-k7-nMeE1aT6Tkfi3q_roOzxiGDn0dg&oe=69B56E04"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgZFSr4-gq4Q7kNvwEw2QOn&_nc_oc=AdnjX4JXyMI56jt9hBHZ5Uc1hZ26_p5eto7DDWA-Iido_MgOsT9lAiCfhyPnRHapO1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOPH9_th_Mi5TuahHYYYs_BxHIEjHM5c7cxeeQu5izhg&oe=69B5538D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6bT89o8ErgQ7kNvwG1-8ku&_nc_oc=Admp9YugmtOJoO-1byWaXZ6zjoZ16KDpMNincf8Qz9Ux0z2BSxP00-HtmjkkDktHhco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxjo7ZTAK95OBT4twNp7pSQNBFA5X6Exy6X960TFP_ipg&oe=69B567D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b70RfJk0J9oQ7kNvwHuqRpt&_nc_oc=AdliNJLKaB9HeRYIreYbM7qX94DJbaXYTYMZiuqBmGqOg8lysaap70FglzLLBm7txZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxkgn7TWBzUlsv60Heyj4DEY3WWCPIOLqacVtD9s5wQLw&oe=69B53F41"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_intera
.com&oh=00_AfsjD3m3W4p4msjFEG46X048SwESZgJDQ0J1GDk6z-GAyQ&oe=69A6C222"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrZpzfoQs8AQ7kNvwGtykBi&_nc_oc=AdkDWVD-2QCqXubn_hMHX8IboMLzJpXORZ3MukE3PcspdHjYPnWkUefQiG8TEOSsUnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftS72LAV18c9xogaRx56ZCSYRqN7-jbMGmUhJXi8y3wnw&oe=69A6ED84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgp62BjI3pUQ7kNvwHJTPzM&_nc_oc=AdlQBenOeoaINHVv4VIunvXsDbZ7-CUF4Oa-WftcBoRJpcjUSS2nBS9_XXixQOTaxFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQ4A2hWmARUNzsaH09_o6HY7o2Yh1ZplVthieis6EqKg&oe=69A6D30D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIdBLLUgDp0Q7kNvwF93BA7&_nc_oc=AdmY3DpU49BYUEzxc5CGr5VNG4ZHRQS-3-7qmQV5GizwPE0xdV0TAjjdedtjL4LuRe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afumjn_v0PXOwrFxdXuvynyUsLHBipjiutVWOZuxlzqXBA&oe=69A6E750"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNq6hFFl0-4Q7kNvwHP3LfO&_nc_oc=AdlBwzVIf_9xIy0dosCuNFibBynlHRNHmkMck7gpQVjs3LlA3nEWL5zg5SF3gB4G2zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbAjqq3R24e8rr24FW3SKf6fUzvcMrD3sOBY8zq7v0_w&oe=69A6BEC1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
T9Y03yVTT6YJY6YEok5GOgFqExOBb61urkqgj_fNoy8A7wp_VurYT9rvqAepto&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tu2u-LqSd1oxSFKMWcociQ8XfQFdPAK9zU2bSNEuBkw&oe=6A2C21E2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-CqWjtzWAQ7kNvwGTqaGS&_nc_oc=AdoncgnZ8kduum1MD1YjOMIjFslKDG8keVQfpXLlksIa8NpRZuMISc5N73gvsG_g3TU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mZg5Q1eqUQw68bZikW3H4RsrqBFfL0C5I3Xq7clD1zg&oe=6A2C1504"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDicvreEM38Q7kNvwGLHa1A&_nc_oc=AdqL5WwclHKeacKc0_4gTvyOaA9DDEDRA-VaHZxPdmEWwzyxH7JRpnJre_iyEScR3PE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DpMM5iN6VPJVfNxtmdkY7n4-6yHm4KODtoV1tFlxeYA&oe=6A2C32CD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc3WGLrFwagQ7kNvwFo2Z5K&_nc_oc=AdqAtVGAriCaoj1hskuarIWuwnNEfDGrM3nNjcbCTSrC3G4OxOAX0B43D6mNdKn1X1c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BZM0LbGLbuM4-HinrJHPFFqOBQYNqWIJ65AZqQ12CeQ&oe=6A2C0ED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jI04CFN8JD8Q7kNvwGqSpIi&_nc_oc=AdojQkoFbHRswsRPpp3alDERw7QSQUf-_r0L28wviQMAOq62-EUdgPPu3My2qDCbj1c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9g-WKJn2LYysF6S5Wy_TQytv66I0qVllTCf9UOvn3NNg&oe=6A2C1E81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
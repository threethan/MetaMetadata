.com&oh=00_Af3WcK-kGXFjA79u6r-Q6JzJ5SBr6M6oIjFk0Pz3gXNdyQ&oe=69F0CE62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XJtpK1f-ZcQ7kNvwG154To&_nc_oc=Adpx24MH8GTt1RtKGNMPZnsn591aBX9EL_ovdSLvlc6A0j5a0S68QdwxZbzhFAldzyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3XFcmZ3py9CdMfvSpVPCTPJHvR_9FGZ0Mh80rToEBY_Q&oe=69F0C184"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H278xJRcwuoQ7kNvwG1_N5l&_nc_oc=Adq6OlbzWW8gQlNaiTGk-Qa85P6W4gybQszGvEjMVFMlqO5TqPiM4844hcsQD2pnWaU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1sjzvgWNpAMwPpkheB9mfPzZ92MmdVHseS9k71X4c-7g&oe=69F0A70D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nis6x0nA5oQ7kNvwG3GJry&_nc_oc=AdpSai_6fQd1eRwK7OAsru6EGofBrbYkr1CZw0tNN8fYTQ3jsOtCpDLeQQCV6YeB7oY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af26tPMqqEgd4LTI2Gw90eHxTwKeXwsnlzD8fXAj-Cn6HA&oe=69F0BB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVWNSaX2mhIQ7kNvwEQpHbB&_nc_oc=AdoeFhkfQi8Kg8j_juRUUMnmd7um6n-82a1J4nMUSdrpoPPpHdsLR8W99m7u9FtRZnE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af25FSL9cp-civYHRiD9Vh4JjsXSlVZm5_GSnXEscCnZWw&oe=69F0CB01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
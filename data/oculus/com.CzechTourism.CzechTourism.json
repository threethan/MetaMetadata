EPYPnUSN5CG-7M0N2QM0M8eomR5pxkHqMC1E_wQ0iy1FRMacRtRFJesSKnNFgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoKiUIey44DH15-x0yRm9dIhfzY7S0BB62uq0lj4EMIQ&oe=6AEDEE62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRhTtisNty8Q7kNvwG0QCOT&_nc_oc=Ado9A4EQ_oXSpSHHwnb9KMBswkXrfZn27xNner7AsvMCOuWSMso02-b90i9Lbf8TZBI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfSrQ4DHSV2NQlgfITE7QWRqpr9MoxYM_obZ52dzhT-w&oe=6AEDE184"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_8v2FBbAk0Q7kNvwFGIECu&_nc_oc=AdryKEh_-mLtUPWfd-97NlDAg8RRdCgwWyQ4nq3_14dh5eN6k28YOd0h0qjn5lTnv94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNhCo2l6YZlQAlwhNdHWNdG0m2snmvzKPVardtuFcYwQ&oe=6AEDFF4D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHIgthVrt5sQ7kNvwGP2kgi&_nc_oc=AdriK1whS6PQvuQDSQTep6e25-qw8mjzkzwhWLv1z8TKnIB0BEe7mANRErtSDhM1Ml4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVYpTU3SDh_wREp_2q4oBaqzsH_pmT26hYHRchBab1qA&oe=6AEDDB50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YA8upwAzF0Q7kNvwH0vbKj&_nc_oc=AdqbeIbdpV_vDPZw-XfObG9sZ-5bRRVhFJpp2k0WdPQFMmESL47efvX8TinC_jda6IE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8T1cW1d2VMWZ1oKMJIZQ3elPP8c381fSCbFm8bMldxA&oe=6AEDEB01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
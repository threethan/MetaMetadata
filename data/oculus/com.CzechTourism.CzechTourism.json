hA1RYkoBY2Gd29OET11_yvEvVWKJhXbO8h8tAr48UndoPF64JrPGFnU6SQ10DM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XS-mTaPltMgziesvWPoa0Tk77PLcFAxIGCcGsFheIyg&oe=69D39522"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UMOCIgUqbEAQ7kNvwFc5vkk&_nc_oc=AdreQYqAStniQq_cBDXbGHcwuHrPFZn-55X83QuD-yoANODAPqsoUJ0WITpGaRLwXwI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07EN69KPyKJBPJf51jZ-BK3-J2Cx0VdO3nW4kEX1pwRg&oe=69D3C084"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipfc-aCweeIQ7kNvwGKQq9O&_nc_oc=AdpmGFmYv_tsVsSnlve_684MaJfrz0VLBo98jvri0AKz2TEhRxKvbfkPanGf1EkEnFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YLlqVjUDIBQh4ilFX4XFaOjDWYYoVedSdX8vbvp0AQg&oe=69D3A60D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQFumDvwL5YQ7kNvwEpBAKl&_nc_oc=Adqqx7Lx3DfN3_a0XhSVlhs6teUyG-ZP2qIk0A3GDicqgt1qkClZsc8wQboKP1JNxKU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e4utTJykRwhBS61QfucLjPMF0Iy6U-NukcdjA1i0FxQ&oe=69D3BA50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CGoYAVNokwQ7kNvwH2Bh2z&_nc_oc=AdpBbWAMwpwKN5_1NpHZQs-vEZ_NWYE19MWCzoKXBLL6O49CYDe9gavV-wfIfyHykoI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07pM5mucx0U28zdUK2-UspEBCgYCATAaHirkoQKHyTeA&oe=69D391C1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
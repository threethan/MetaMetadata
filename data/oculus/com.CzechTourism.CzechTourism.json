.com&oh=00_AfvvH-SMb0eXCSni87eyegJAMVhvqseTdKk4bm2BQSVTFQ&oe=69A41F22"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1MDJM1ZpVQQ7kNvwFnMFBz&_nc_oc=Adm8i0Q63YX48ONhfZQgOKrkWRhAtZ3GsKkmdBBCVTFbHKY1cBLIe_i98gayw88lmFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujzZ3RO9OObaAurDY4gq6QoGhKOvQFCuYPBE8uzZ-sPw&oe=69A44A84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgp62BjI3pUQ7kNvwH2VRp7&_nc_oc=AdkC-6-NUJBflWgI1ulwMQeAJvYzT-7U4IYymJGYmHbvYUh3p6fKPHO9Cpj4-YOOYt8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv3LS7OfSMYqGp_Fn6nssWiXViNwZE94vPSRP1I0B1u7A&oe=69A4300D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIdBLLUgDp0Q7kNvwE69zFt&_nc_oc=Adne8EjND0mSQhkAirBFH3qb5jCOg_Ms6darCBy6jCRYKAYDb5F1CyuyIenL1FkoJj0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsv2wmMD9b-nzQSl87MHVKtK1EDu0Lrmq8pIUuuCaldUg&oe=69A44450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNq6hFFl0-4Q7kNvwGqwsU5&_nc_oc=AdmFd4yM98NqcFANRF5qoUdLn5sof1IQZuN408bAPRK80vrJ3bwRwK0nMBY_3amyUM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsnrKT6naj6qw2gsOTjc10OEfVox4IMufmMC717yAOASg&oe=69A41BC1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
369820543595945", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn84htIBtZ4Q7kNvwEqiAuP&_nc_oc=AdqhJMPFIBRK9lGS1ANwOKiZJS1KyU6BdEqmRos6Fe2famBsbljw7cHXPSlD28QCoeM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqEC3qnV2qL3pxrxdrL7gA6fw_8at4O79Fn6dPCX_u_g&oe=6B103562"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlRaF7lgRHkQ7kNvwE_O1bv&_nc_oc=AdqfPYXfAelxc99k6jRiR3ufFPf3WKdjf1Oeu2rwh-sKEOA3bMjIbHJX39ob4pAKUuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4XEf__W1Vj4GEQTOI_qSOWeZs612x3tRmgrHyz9MJ8g&oe=6B1060C4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6spNyNqWiBcQ7kNvwE8nQOR&_nc_oc=AdoaHVwItq3cSe2YHNosZBnS0Hw8_NCEvj_GYVgjry9Wrr6cEpFmgUohEGoMFYgGLaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5EV2FGauUsJnuPM8Fkav00xKGNJ6o19rKkIVIQrEYTQ&oe=6B10464D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmSUjcOiY1sQ7kNvwHNtXMW&_nc_oc=AdpI0bGCKGZtRNQm4H24vitrgI7zKAn--c6-AIqkJwV-XHQs0DEFsm5BkeVeayv2obA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXL2GTUXiObWjuA6QP2DUfPXkuTLxIzFz2cidjQFv_FoQ&oe=6B105A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qX27Fsv2S38Q7kNvwFHX8b8&_nc_oc=AdrBFt8Eeov1bB8TYeNN0IqhXllzHlTKUYE2W71euh4st7kdXqYlCRZXWojjEVWNWro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUE1Pyb9JthgT4woW_IK7uYQx8SkZ2rkbHFSD-yCL47lQ&oe=6B106A41"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
JQmeHzv66kilomq6SMCdOR3yPe_NFknvExC8XPMlBzLLwX5QVYUmUTFcQL6B78&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af649sFTgkP12M3RQ-2F6AlUX_gpTP98MekPj107bW6m2g&oe=6A034362"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGP5hnm8kgsQ7kNvwE8A6LB&_nc_oc=AdozzooXEfjnduKj55fsTOAoaa1OwSpr_q0FMI25uF3H4nEZsoGOojpzukpfwTKf1lw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OU1buEwiMZah_hctVXH5mlFAVGV0IiWdLSYMEhzabXQ&oe=6A033684"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjAZgl1b3sMQ7kNvwH51NNl&_nc_oc=AdqRyI19Y6cTmdWe9VsInTM_0_WuDdqPIc5fNrDfvwzbrUSKaBEs4RdqqQ5iktAIGQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CX73nQXCks5lQfVVUP5JTOtKisADYnSxD7oa7-24_UA&oe=6A031C0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vySxM4J5oa4Q7kNvwG9oSlZ&_nc_oc=Ado6hN4LQ_yJAY-PzvegapSqOqJjCvYaKzNCfwEuHAQGBLLWzHyy6_osNZakxK2mzeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j8SR4v5DIfo7dsFHSN6tljZZ433oDi9P3yeYGISN6uw&oe=6A033050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5z64oIuCpPgQ7kNvwGFs6OP&_nc_oc=AdpemqM1_rklNf1DUcslKWSobIdExv-A3J6tAdbjmcVku490cO_6h4O9sQCngZToeUE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e3HmwPVjxdizeCwL7box-LahR7F65-cOymkGyrH5tMA&oe=6A034001"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
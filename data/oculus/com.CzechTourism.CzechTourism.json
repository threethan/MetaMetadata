369820543595945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0VHxJLRCPIQ7kNvwHc5Wxd&_nc_oc=AdodKSZ4AEgFCnZcfzCJqPPyjDMk-bUYnl6c8U9AD3Nn5hQCCwca6PwWiFicRSXOXgM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDWNHiAwmppFMNDQwKDLvbHLIuw2kt9wnih4o6Wow-Lw&oe=6AFC6EE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6BsZvHnLYoQ7kNvwHdc9dM&_nc_oc=AdqKuSE1e92xkBdn8zkZHupBeVNWewZ-wk1JxC2zcdbf2wO5zomaJTLh0qYmCZsShJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScXkeszsoAR9p-RwsR4G864ooanM65nBOrZx6N4PONYw&oe=6AFC6204"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qcoutrzrar8Q7kNvwFY1cuK&_nc_oc=Adq2JV2nsKCYv52eo-BR8m4zNJQAg-2w9y80BitUcDdEQQE2NqtieI1ppdBdMDd4Crs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSogeaeHnxsgVPDbxrid2zcR1e8Ln8HE_CWyMiC2sTmlQ&oe=6AFC7FCD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhiSJ-WMpvoQ7kNvwFH40VZ&_nc_oc=AdoiJUaSXS-irSQZXGNBf4DItHFDKbZM8Qm0lZPKzPP7sIoTye4lCbuMsrNyg_rU6_g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfTHvcvQ39sgJT-omOlF3wUCEGQbxO2nfiaQgvm9GqKg&oe=6AFC9410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD6yLDDGYSUQ7kNvwEL_YAt&_nc_oc=AdpmtTDFT5cpoCr7xn-GClqdLH5Ej8_fc3RfLS__picxL9wUFN6LiA9UrHJf7Lkvek4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp6XFeKFvZsub_gg27qWWzaImbS-QPKzJu_p3le_S7QA&oe=6AFC6B81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
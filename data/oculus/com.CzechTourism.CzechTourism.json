c_oc=Adqpoih3l2F-JgozQ7ZNmLpOQg4GzEa8kKntp3WpJqeJQ0Dxn9YqSwxqFCN1QvNjlIQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJTudaAm3mMTBrxz57yC1-tmlaHDhK2aLR58Sc0w9BaA&oe=6A8ECA22"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7jdia-1j4QQ7kNvwHURmqv&_nc_oc=Adpa0n7oXh-qS7Tmxp0BKgp5banURzyhDVCwxyrZLozXdb0ycOyzsU3H_e4VlbFJKTY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQkvwijGBszJ7OEhLcUQwi4LQsnhUYjLtmHF7NvQQ2tQ&oe=6A8EF584"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2GobTs7J_FcQ7kNvwHANXa7&_nc_oc=AdpniNTGZ115WxOeozZ3CnvnOw7oVB3KwHJWTded3o0wv5HqGv6xGbxEe6aItH9BV4A&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEywuUOmigqSSMO7IcpKSBHm2LIXBP5TvxYOYQrkWglhg&oe=6A8EDB0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiCb58c0dCsQ7kNvwETwLlu&_nc_oc=AdpoyyswGFX41BtU64nswwJbEObM4zyOeqilr5upU4R83guLPMoLKhzcljQmYUTmBiE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDrPbjSmx0TR_qaYUzP7b_5TzQZgL3SX8hqozQ1QVwgA&oe=6A8EEF50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY-9L6792dMQ7kNvwFQZOuI&_nc_oc=AdrbHvyReqqsfWsd_KsmBa9RSAb7WEV7D-F8IRuEWhGi8CzAJgtoYDF5QFPTyX5pEE4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCfEa8kvE79vk1GSMQFnLGrKBqNnZljv9uWyPOQ9QGPg&oe=6A8EC6C1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported
yODvkYR6NzIp1FwK6-1L2QqrlkxG3RWoaDtUsP0qtr6AWLj0exISfmz3K9AAEo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j4pQCLOba4VDSwd7SnU5D6Apkut1wyAekoO6Yq88ekg&oe=6A1C4FE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sUn8iVKVQ8Q7kNvwHhSoNZ&_nc_oc=AdqOJXDHxAjr3CM2TN53nxqxEx6Qn6nn7nRsbH1pLo-AtGUqgBE-DWnBNtfJBzaMgSM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-iZ-RJesqay4HNVo7ylMPeYyvGQDfoSH_4OcKGI2-Rg&oe=6A1C4304"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy4QRnRJ2YEQ7kNvwFpvHmY&_nc_oc=Adq2nkQlki2q73yYUIwF2txfS4AUIa6I7KkfIR-bOe7ifNOHLvqOHVVGt9BZ9QEy5yc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CQyUu2IpklnUFU0nv-mcWVQiqPxOlWTIoARAlQ-4gMQ&oe=6A1C288D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA9qYEfS5zsQ7kNvwFzYmyC&_nc_oc=Adqw1BcjO6FZNJra_oWoculCoMxxQo-iZz9AAH4vxOB-IRfz1UJ6_iEBC-SaMfrIg_g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qtPICtEgxqZ-XMMf_0ZW8OJ0U8SRX0vyDigjRisLv-Q&oe=6A1C3CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45-WFdO_aO4Q7kNvwGAkLro&_nc_oc=AdqVNzLTXjPkmE1Tgew0JIgiC79dTo04fyxLMsmYHJoVXfgEJ35Jbq9EFFyF8BRMGQ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sVLB0s6S8bgyCn8D9LtzPWm2w_z3uKSKH20-qrdLSAg&oe=6A1C4C81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
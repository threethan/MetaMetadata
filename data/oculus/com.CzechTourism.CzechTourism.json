nrk8nQtVMOKPFVEIe9dMZ8SSAFDob-BycqpUOYq9bfF5tHpJ6-MeZpmpaYShbk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mvO1fOFzAImXhH6446OMTUp5E2wnsM53cLXKSd0vhUA&oe=6A107262"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vttEQrJAKIoQ7kNvwEF2XGW&_nc_oc=AdpyT0UZTemSr39cI-18LjTa8dPZv3fCIR0azgbBfxIEId-IcygGNO3yzHuRwoMkCv8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rj3dzng1uY4ADCYFL8Ep9j7ViP7DANBNL2wuqP2vECA&oe=6A106584"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnhNHULIfKoQ7kNvwHvUHpC&_nc_oc=Adpo3bP9JNT8Mw9nrQoWJXGwyQZDYNKmzuoBF3afOVzW6dlfxQdjOs8_3MO1cvkImS8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MPy-tvnc7c5Kqxunoft1_iF8T208Um3FhslZ4Vm4_Zw&oe=6A104B0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqHN9bCoVKcQ7kNvwGH98aN&_nc_oc=AdpJzJl079l-o5syhU0sYM907xOOAK0yygg-6V8MLbQI1J1_gNDA7s_33S2OWNzncyA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s7YMxcpsEhMw7eMn6KwI0IaKk3KCINjYnYKaNYqL78A&oe=6A105F50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHPOJE3mHb4Q7kNvwEjSva9&_nc_oc=AdqlSOQsD1xiq_hUv4hl8qdAUFI-S835XYSx5k0Z84U1WWfxcq3BFg_cHl8yfHmI_a8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SzjoVbzM9E-eZy-RYQr7mRzBlx7F46Hw19CsxAqR-Lw&oe=6A106F01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
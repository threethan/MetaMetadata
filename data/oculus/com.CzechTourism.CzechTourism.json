c_oc=Ado7agFs2wiuNH3zlvGdkcMk8ep03qdQ2tNv7yWG1oMCiouGNnepwMZflyf30VNA3iQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8Y2LdL_f9wUTbhHJh44Tl-jANqc8REP2ySzcGlxssyw&oe=6A858FA2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKTmYK8MRt4Q7kNvwGKmFU7&_nc_oc=AdqWEFKTUuBJY04VT5OLbVred9zqraF3f6sjMtlPNGITf-MXj-bNRP_4vpWu8IvmNN8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjE0QLximt1sdqHeEAJASm6vwdtoZeGG4mEqbnmc6xeQ&oe=6A8582C4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=__q-KMLp7HEQ7kNvwEMyMLw&_nc_oc=AdoD-lrI2eMcxmYoUvSWpMupVwgvhpTf7mMsdP6VzJGzeFLJGqMe9kykE7Z-ON6n8uM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8L_orPTCsf2XCly5fwEMwGEDduk248ovgKmeeU9zg1Q&oe=6A85A08D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzsR-sIBq0QQ7kNvwH3wgeh&_nc_oc=Adp560HFYGUpQgEROA6uRkmM_fJwJ5XrEVaSBEhYVe1G3Q9ehSTXaNOQjBnsPSxSLMg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFUJukm1SLQNLuXQsHXk6V8d_9SXi7ncDtNeDYV3uJ3g&oe=6A857C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyHe7Yx3aTQQ7kNvwEWSEiC&_nc_oc=AdrmJpPJGpEwBh7oY0h346A-6UFIuGzAmpis34QjGA6r0rgYyMmjXvJQUMrZH_PO6vY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTUhRC5g6yNbGxKcnoPEcZ7k15n7N365k19VhNtyWxAA&oe=6A858C41"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported
QkTEihWUpIclXlRiAD1c-5-dADhR_pQqP4-Y_fM1zrP7f2rbh_w1bMnlGuXXBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcRFj-ES2Ort3hraC9gq00aBVGWfxvX5fS4D16Sx1-LA&oe=6AB29AE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5glTiHCe3dIQ7kNvwFwCRTb&_nc_oc=AdqV1JV1ZD9lto_Odjd_HS3uozpXRe4izU3USGF8n7dyGvnXMBJ0HLeyMroEplmDgWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv88SMiZ2fywCGUIm4sJtVQhPd4MInvIJC9Di6E9rzZg&oe=6AB28E04"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG6LPuIZkLAQ7kNvwHk7D6t&_nc_oc=AdpOd27SmUyNrNLkbaBsujIs55uEMs9MooyNeDq8fBV6tGg3Gd6e4HAxGqbhlKCHles&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInC8cJ50l-deuR0_QA3GTWKvZ-M9GcYWLuKSllxZxjiQ&oe=6AB2738D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyE4WB72QnQQ7kNvwH3biNY&_nc_oc=AdoGdrlMJEZ27whq4lMs0WLZa35SUczDuhXMUixeRqKICtn0p7P0CA3DsW7jiPYIxEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISQAFVbF38Pq71bi2NSJpLdBrtvb_hDndmpCd9D814Pw&oe=6AB287D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xmg-KgB31tkQ7kNvwG2nwVn&_nc_oc=Ado_3Ol9XUIc7Y8V4Kw7qnH2-qfAG3BO8qa1ieAe3ETnasA6GYRZQ0LHENqHk_RCtzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpmyZbNygitjqvzSzMcExJMe9EFBCGtFnbUYZCTKZW9A&oe=6AB29781"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
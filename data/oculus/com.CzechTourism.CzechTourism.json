369820543595945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4J6RDfZtQIQ7kNvwGmReJM&_nc_oc=AdrXKXYaf_Rb0napG-yca0KsZ8jrYdkJPxToOCpDh3Oak1utrIaqPC4DpIwAAvg6Upk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWQ3wm-P3gNBrpQko_7pGNt7O-S4RfID8IJc7S7becYA&oe=6B099DE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Wz9VM_bgbgQ7kNvwF1onBg&_nc_oc=AdrFs4psocBGuHI-MqP48z3gt4_tg6_MqzsMvO3Cmms7gXgPpLgEUUBZ69v7_k8z8tM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkIvB4jtk7SegF6usdWTaq6HCe8-swC1J9PkOMwwkRRQ&oe=6B09C944"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA6YPCot_KUQ7kNvwEyOVBJ&_nc_oc=AdpL3bbmfQNXFOlzO2lQw8-IlmqkNugHa0H0S3Ugk4eHJb2b3uJHUasMcm8G6lZd_Mw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSH1-0kJY7nvhDkcYccjnHAAZvIO3U5hpMd-3rAlmIhA&oe=6B09AECD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdv5YYenvUoQ7kNvwG2JaC6&_nc_oc=AdqfDz23WXfKUNVFcJjXCLpUbHHDp9dizQEgbSADy9kQiFQbvqIuHjBiwNUPgis3GNg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRibyZVCIDRXhAmTpQeyI_EST6w6lGSxJFIXXgJML4bGA&oe=6B09C310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EH2WQJwH-YQ7kNvwH8saIU&_nc_oc=Adpk0RRvuNRgrHj81Hy7k9nHkhMR9ZyK9lL-kEfQLFyQXo2g6KT55OyJCmeWT9NqW7Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuf6DrPy0UpjT9cTRnOVOpdkUhyGM3m9Fzv7M5-oJYEA&oe=6B099A81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
369820543595945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuaZfbAHZz4Q7kNvwG30sQ6&_nc_oc=Adp46iDtWxgLGodSVM5i3CRPcj9OQxvtkdDr08mEdKO4D0-Dl5m2AjB7YwoRt_aigKg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ83yY1BXi0K8Fa6KwM_oEyeTz8hzx5P1sBJK0y6JhnPw&oe=6AFDC062"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6BsZvHnLYoQ7kNvwEsymWS&_nc_oc=AdoCAzbAO5ER5IIkw7IfNMmTO6alUONhG5GtzCKMTNtUNrKikqIEajMNKy_kF8j4fp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1y70GWjVFgQRZHKwlCTTBsceWJosxwZlLJjp-6773-Q&oe=6AFDB384"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qcoutrzrar8Q7kNvwFxVqGX&_nc_oc=Adqy3bo-qc9KO0HibqOnhXv_XbTgKTWxzWZBVhor3D1AZVhIfhY5lMVNo71q-OMAQjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6tgh7rv7zxvFowTqyhdnsFc1dn7eoXgRD7a3FQFfZOw&oe=6AFDD14D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhiSJ-WMpvoQ7kNvwHZrCcb&_nc_oc=Adrnyg_yeAHak3p_aCM4i2yZHQ-VpSYpzmdRNsbafVJ41AsyDJPh4Fyju1sfrYunqGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTi9KSEEhRbsP0qYzSOl1GIiSZysJfb0Fyu5RqUnqTGw&oe=6AFDAD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD6yLDDGYSUQ7kNvwFNOmmb&_nc_oc=AdpJ9vC_AwRmD0YkJPcltUHDMj9PaSZ-n931G1lci_DQRjJiERP2qKjaz8KN83fjI3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShS4FXsWa_je6fvIC6xI7NXk6BrJhj4dVgIuVnT53JNQ&oe=6AFDBD01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
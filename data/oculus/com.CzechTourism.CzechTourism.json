yGwi9SahFSBkyUvmr91MkdtDZLf0_urmeBzU7bes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQurUP_QJB7L_1tR6FWEAPi70cuCbF_0ko-8iZBc6JYhA&oe=6B0DCAA2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gje06qWHhPcQ7kNvwEhDb7D&_nc_oc=Adp4FWPvCIdu66fqLGw-sNu3pIKlfYS75hygechia4fCybQjPKbwOpAQHkPNStO8pIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsaIXC1YGGjRxQ7HoYpGzGgKU0rCzKUeNBVra3UUQvHQ&oe=6B0DBDC4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdsoF4PNjBsQ7kNvwFq2FnB&_nc_oc=Adp1cGgojvciTgVkYV4XT3-NgWGkON-Cz5Nt1NarTruL5ko0f0QC7_VU8PG2SYRknVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEs3_GT_VU1ehU5Z5tQvYmxQCDGkeX6PvGDxwckxqKzg&oe=6B0DA34D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV8Z_KoY-z8Q7kNvwGmZu_D&_nc_oc=Adoo3XnrXxryEbihnUC4iZu8Tq4M_hVhQJttzys6o2h-gJrYg_8EfkRwuFBUrdXYudQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnFkFfxjkHi2whiWyvmv8MZsfIQZbeTnC5gZ2yG98qvw&oe=6B0DB790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7wFK1O4a8MQ7kNvwFXZqyh&_nc_oc=AdqeYT80kubls6lQUjdJKJE_7wfM56UQ6R5XJJ2e9g-KkUCdo8wYViBqaY_QZXlANN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLRYzojtqkX8I4k9TW28ak49TtlealfJhrx9ysJEEa9w&oe=6B0DC741"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de",
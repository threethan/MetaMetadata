SV50Vp_gghMnA_nfZk5UcP-0upCfqUk6blNsW8chL4Uoz41Nv9oIqzh5hpAyTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YjZNrv4Er6auIMSgjI37IQJHGWz70lYAt2fiS10ji7w&oe=6A428B62"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EHoBlxpI-eMQ7kNvwFZy4rI&_nc_oc=Adq4vu1dwYHaQtyRRXMT8wOu1tkzgmxvgCMBjhmcAAhFHHORJ3PkMAsBvGA_fwGdAAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iwJP3zSEZZESj9cCCATqyb9M0UMXxdh7-bDJMLJFwiw&oe=6A427E84"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2s_GgoVvEsQ7kNvwE5sP9d&_nc_oc=Adq4i4Jo457DKZGdSTmuQg2lMvjbEhvHxln5Fh9x9_rznFDc7PXQsX_afHxh0mdtJyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WFNAUuSO3V2AG7_8AHosrVSevEHa0WNpJ_5CdhfAkgg&oe=6A42640D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei-2U1gLA-0Q7kNvwH7ioUM&_nc_oc=AdoBV7dPGo741u8AjLjSfE34fU-EBuTNKe9G7uQFe8LzIP2xu3ILVAs7LNHbKWzRKkk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V3jOdbXnshUTsmFN53Z2jM8wSbNqmPNRof8OaK2KQ7A&oe=6A427850"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFhUWLin5JkQ7kNvwEiHbbV&_nc_oc=AdoUUL-QEpoCwCenGf9zck5XmOXAsEnzET2DKCvn8EacXUELjXtOzeQyQbn7fqBFAjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zhkSZXsjQ8wqQtyXEndBrasKQy9K8twPXrJm8dm9H-Q&oe=6A428801"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
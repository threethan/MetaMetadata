juxmT5aeQEDlY3vHlpkRnpYxjL5KQL5KvmL4Fph-reUOA2CO81vOJfI3j2YfG3Nw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4zl4LWViWFusVLeDWNkXCXFgBtWTEnU4nQHFgiKJHGg&oe=6A7DA6A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lHprw8UJKUQ7kNvwHoiDou&_nc_oc=AdqBo9olbxl81wV_gFN_w1SOJ2GE6unR_OkLnjnO44IZMY3TCrOmbsQ4_YRJFXWJCTg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF5MGpte-5ls23bC0c5Cy6YdaEIWGkwIG8BvnQwpjV2A&oe=6A7D99C4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiRx_OORO4kQ7kNvwHa5YoI&_nc_oc=AdpzGRnJfXX8hL7p-YSKSQmDpuow-dJ4VH2eh-R0M8LqnFjIbxpgk9qJS8tzwgDAX0M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJhV4zIDyG8hIznhT0_nZ581Ijt6Vlj6epzpcApPTIxw&oe=6A7DB78D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ptJudiZtQsQ7kNvwE-iMY1&_nc_oc=AdqWN1sbfiVWYgxxQ2Lhq2N9RakPzI3Esi71qj9SCAOFK23YTVLCFdoSzYUsYLGIoCA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJglRKo2hEugykFhiUt9cSheFBfMKD3-_eY6GJ_xKRNw&oe=6A7DCBD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyJn4X_SorYQ7kNvwHwpsHS&_nc_oc=AdoKwQknv8Jwp4YZHsa4vuLiT0z7aiZe7NRDVQo1fC-kDJJRmX35K9RtVD9jIW-RDnI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA3Pa7CghMTT9MW3fof1pSpjdZGkzCw9pEHt4YNLU6rQ&oe=6A7DA341"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mo
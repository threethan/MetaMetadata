Ykx6LDnTQB5qHYmVY6olv27b93ryTUAUZQM2leUqmuirGAKgAIZQssspiTjVNcUA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xoJhi7MR0yloudVV--G6timZz4R13VXs_6kyjeo-bDQ&oe=6A467FE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFBp94YLXAMQ7kNvwHxXCW7&_nc_oc=AdrnRTPHq9xCJq21ukQNzdRePNqRsoru6Q5UPuHbYc5MFRE4dD-2wfB733e6CvwKxbk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af819-bx04b7Id8AqGb6hI8KLiAbYZB7qxrcnUAoRgd-Dw&oe=6A467304"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOa6m0auOm8Q7kNvwFhAgda&_nc_oc=AdrLBXTwHxMJnYbRnAe-2-HeUu6aJNLpYVS6ZKYfY-_vRwm-xUl-6nv_TF92o_c-n4o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82IJUG18xosPiRFgp9U5h37embccPADPuzm3Wh_Dtj0Q&oe=6A4690CD"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3K8JeS-I56IQ7kNvwEgSdnq&_nc_oc=AdqLp_YCDV5AjV4Eo7EZB9ooirS25fYNsJYoF6skLpj8n1YG_jDM55_mTxL7YxxFE9U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xE_ITpMEf1pv7hH_tfx5xqdvfzwY5XO8EfLU4CM3_kQ&oe=6A466CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLsHEBUrMLcQ7kNvwF4Kkkt&_nc_oc=AdqZvTlTh08Zu8OhzFnimLV9z6WLHkAVMqqDBq7X8poxnkHWGFfGRyTeDyE_C6rd5lE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uVvASes1_dMR36bB8CgmQOQ1IfVI72LMmLjw1E6_0XQ&oe=6A467C81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mo
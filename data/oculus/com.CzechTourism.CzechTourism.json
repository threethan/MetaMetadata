Z6WTEYMNmZi9_P03CmRm8s4ef3sCCgMY7Nm0hSebmeQiKLkjmiqgir1vAEOI50&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj2HcVb9k7NlzWdX65hjVH858Tl0c23d1-c_mGHR0wBg&oe=6A941022"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yexSOjmNAisQ7kNvwGYsoAx&_nc_oc=AdpPYzZ_Aq4IlGVGI9JPkFfdlRgHMJ8HR9z2s-lhJdMdGHCMzr_M7HaDqC-k147lH0w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYGC0DPEGe0qKFlv2MyamUOxv9SJ92qYNIxX-km21NdQ&oe=6A940344"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1mCxXaMXM0Q7kNvwEGowj2&_nc_oc=Adr1nvDBJ4u42-2qBSlupnjw7VRo-9zfRT9w0o-Xkw21P_Gu1fP8Wq80AYXuSte9WJ8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERI5fhyIk0j0L9jPTYxg55uzca9vCKR0ENC8c32nsZ9g&oe=6A94210D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kILXVv5MKAwQ7kNvwEWTidT&_nc_oc=AdrABQFoPXgRwYkaBrGP5wOHrZ0X8cZZt0W_QGHgre7k7XkwLKZeypcJVSWuaJJ9gh4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRg72mK3yZILoQUfAQuskA8fGT9DxCVv9z7V5_3eRzoA&oe=6A93FD10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIMMkQ-cm4AQ7kNvwFNZNyI&_nc_oc=AdoTtxk3MrnlrYsOwSQVz4qbQf_Ph6ubUnnkB6cqYH11LwnFIu-KvznaygDpuRIHRRc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGptl4gpnebqL-CstGypfZig5uToqkAAUhtbnDtn2ZinQ&oe=6A940CC1"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
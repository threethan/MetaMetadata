838wkNlYo4fgQMEmKjnwR-UTeWAl-VavCUeHENUyS6RlloEl7kBNYxBbSMWWvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTmFFlK_p2Vr3VLyD6RfOhLWoPgn7_k60BIBLC0vOLfQ&oe=6ABA83E2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQqTaENZN8AQ7kNvwEa-1Sd&_nc_oc=Adr-XrqQPzMUfsxfnSs7vrShRpPpsyLZ5C0lMBp3IDcQJBjoBfoF5bk24N6-xlZ7910&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUVJZfd3GQAYGC3R-83hLk1lGnqo6TCDF_TKLZ3gnHwQ&oe=6ABA7704"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RuLgb94O6nMQ7kNvwEARx0N&_nc_oc=Ado2BmqGKGKagrankMlamIrOhHe5xu9OEZaX0eOnxHI_7W1khHFRkhknjq_RN_uY8LY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK3l30AaxaS4pel7jqlDfCr3se1KLmo45sCuJdkVKjOQ&oe=6ABA5C8D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ne5NE6YQaw4Q7kNvwG5BODQ&_nc_oc=AdrzHDVt_R_Dvv5-dqXsYqvL6dtX3HoRUujSrICw4NCuS17siRbjSWUDALALnQyuIIc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu0iqPOhER1jbmmo0-LPKcinFs1QKyTtnR87XJ8QGRVA&oe=6ABA70D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oaoEzP-E-kQ7kNvwE5821P&_nc_oc=AdrFQtFscAR5mdz0M_AL5-Oi-4H8ixI68flakFPFWeyq18EilO3wLtsIFbE5Q7vKbU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFETCeKY1-ExphaHF64SR-smMVpHwIvgoutvjUCLFLfA&oe=6ABA8081"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
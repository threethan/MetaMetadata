"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKwX2K_skbIQ7kNvwFGhJZw&_nc_oc=Adqk5LOtOSzAmGIygHeZGA6gvJd_rSM92ZpbpazPR8y3AxHWN-9N7fHvG2iTNiW8Ipk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OfABV39-eDDHjTpdBd9-6jrCrm_0aoX4-p3qGQF1DBw&oe=69F34A0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LOsXzJ9zyYQ7kNvwHq-Puk&_nc_oc=AdpzWQGdN4-BKZGUkg0R9kbGtHlobjZffY7w7qg2OZm_LsbsT2IohBOQ8RxHTZNgLiI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gSdgPQbuDgTfxwLSArLzUwxFEhmu3uLcp7wD-h3Uetw&oe=69F35E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyzBTmvEensQ7kNvwGSSSJb&_nc_oc=AdpwMpCJItDfGJ8hrUekZkth21Gz1qjZ2qguDrsTf9T9H2k50STCwj6yU6GnqdVuSn0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3J2wPFH4hWQ6xikSoRZuGWSObAJaDPLMG_yHYQ3Ox5rQ&oe=69F36E01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1575784629613065"}]}, "baseline_offer": {"id": "1575784629613065"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1685723986, "status": "PUBLISHED", "id": "1575784629613065"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6651952641555035", "version": "4.0.0"}, "id": "1213123392847463", "channel_name": "LIVE"}]}, "is_for_oculus_ke
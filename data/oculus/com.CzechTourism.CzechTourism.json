MDF4eLJm5-xq8AIJ4UWS63EajOmVOY5I77G8s5ZM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQqdq5rSCl9-PR3JFZbJl3_oP3TNJy_1elsukgb5heHsA&oe=6B0B27A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gje06qWHhPcQ7kNvwE8ofhF&_nc_oc=AdrhR61e-eCdrfnyZJYVSt3WWGP0NksPmh39ekGqIb_O78D8vhz5WSU0AAv8GhkIc6Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZHPmbuwzkau3h_Qxfg9kbPvg8ErZDuSD2eUHMNlgytg&oe=6B0B1AC4"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA6YPCot_KUQ7kNvwGS_GHV&_nc_oc=AdrLkDrbqJ11ewMdw8IKQ1AdaTB-ARHE2G9eN8uV_p4nlT1GQ8KPwOxz7NWbEx6NySw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShfFJXj14QfFgryBxO2eftRbbJOyGxw7JYj9j4WzzkMg&oe=6B0B388D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdv5YYenvUoQ7kNvwFJjBTx&_nc_oc=AdpUKl0hRSK0pcS3Cx7keBLJK_BRV0HR5NorVG8iEh-udlKvQKGztvWugU-tGYmRxr4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRIScRu3ET47IcdvcKW3WhHcb20vWi4ox20nU3FBMXkw&oe=6B0B1490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EH2WQJwH-YQ7kNvwFcePO4&_nc_oc=AdqBXNJ0f2RqD61jVk41VOtHcw56i26OI-nn9np0m4JuKprcnm6IXrXGtG9SkZFT_h0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3nqXzr018yxI8ldMGVbl8jzYBL4IhuqLAKjsrcjOlLw&oe=6B0B2441"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de",
.com&oh=00_Afv8cLBeVAwVjQquotjJ6ZOuj6x91jeXWRqlO-xa2S9UQw&oe=69A2CDA2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1MDJM1ZpVQQ7kNvwG5n4hO&_nc_oc=AdmQIbDTqofgAN8JKonGq9QLiC8dHaO26-K-QQyy3uPtLp8u1idBvYEj8ZPnieg26TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftchIa6Pks6Xhim_ycwKW_43KjpHPVhM8ENejszl2e8tw&oe=69A2F904"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJ2K30_-rYYQ7kNvwGnFUDg&_nc_oc=Adn_WkIyuDIbnC4-17sr3mNPzbdRDYRsg5YxbcI-x5tl_WMsuHKsNjl4_ZDzr1072G4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6k3WlfvzHdn-JEVyW2Mc6mApt1Hk2sNAst3s1bGn17A&oe=69A2DE8D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7lgRbTXEcsQ7kNvwGSm9vM&_nc_oc=AdlSlblKpDeJL1DwBH3gO_o3UHaPRU0_J3evKQr6hZ2NetgcxAU4-ylC2-pMI1dsfbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusLuPiOn3D8qk7BoQnUT5hsDehcSX8rO-HDrfwte2QMA&oe=69A2F2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY_I-gUftj8Q7kNvwFHliPQ&_nc_oc=Adl-VC_jvgkbDaAa25Er-UBgfqcj9KF_8nP-d1RsMLyEEgW82OykOZ4xKk1xiAhfiHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxxjMGRy5xFiFtaE-cDSyU5iknUgtIpxiotGn1yuIZJA&oe=69A2CA41"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}, "review_messages": []}]}, "cover_square_image": {"uri": "htt
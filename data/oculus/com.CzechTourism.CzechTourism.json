vpQF447ioHeBrjS9eXjpOZldkewEd0p7m2BLq_d3GKU-HKayIZMzXulWiLVYfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iJBSh3UtusJKN48xHy-VtvBmJGz7q8OeYl5r6eJrLjQ&oe=6A297EE2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4-CqWjtzWAQ7kNvwF270g_&_nc_oc=AdoLeJoxk_lljlKhLwtJGSL8Nyr96uy5ADCR8nBCI3C2q0dgc1neWSckejLgY4oIJF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SRkcnM3KjfAcbvAlahxiB0J-VMs1TW-9taf7-ft4rag&oe=6A297204"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNf8QSBd64wQ7kNvwF784gz&_nc_oc=Adp6nBbhG2fBRXdAi5ljah-2xNhYCZ8soYXdxbqf9Vobrw0IwA8F8TrJimMUoHc3zKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YUDK7IUgvS3dB7gdG-sB9FBERFuH8pcBfyki61DR6zA&oe=6A29578D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uf2V9W_nYVQQ7kNvwGO2pTX&_nc_oc=Adrzdd9L9oJKZ3iYTw4C1Mm3D54woFpvpA-NL2Qz2LQlifgGr9M1dqmhjaYsky3wJHQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xh_lRpU7SCrzmAx3mkImD70CO6oO7sdhlfNszEe5cNQ&oe=6A296BD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-xTGaMeK5EQ7kNvwHt5X50&_nc_oc=Adpvz47CkFhV8EdjDU7g5mOn5N5IumWvs7bPPE7rkGbuvnNMUcJWMpnOyjqdDaolpLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eYPWCw-jb2YnIT3K5slPrVCe8NHtzBX1JoIQG9rXFrA&oe=6A297B81"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
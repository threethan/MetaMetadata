FoRUtSpJ3TvOTcR0SEAFRClubz_zp6Y1rUkMbqwn_-YRtrLxFB4pEFS4j_nmyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPclXhwauI71fDGMDT_fxD_OLv2973dXnbipPEIqcZ_UA&oe=6AC66162"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFqant8WQmAQ7kNvwG9dE9H&_nc_oc=Adp5muX17DaQ6LSQMVa5F1_pUNOYWFsAGOZwFtcuuvVVEh55wfGvRhjVB2YOp9Vy6Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvXFXRJ_wpTNL67JSXa17-cA3oqX7x_KVejuH8fWn7DA&oe=6AC65484"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYY7gQns4dYQ7kNvwG84jbD&_nc_oc=AdogXNB1JWD7NSWQfZIErVd-k_uxVgg5YhfJqpq-5JThgNGSL3E5kLaBAUyyfzhA_gA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPpFUo8LLa0L4xtyKxm79ALJtqmMqMwKB3OvcY-p4o0w&oe=6AC6724D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_tUuHAZ4E0Q7kNvwEVDdn3&_nc_oc=AdqPz-Tp-jY_F74QZuIVNe92GgGbVLnRPeY2VMXo8sEHMfb7cl4BM8JhpnBwPIDGq1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU7AqWSxOAiUJsaCdmNgC1Hg-4z3xm31crccQZzKkbvA&oe=6AC64E50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QgMypTFrvAQ7kNvwGP5x6-&_nc_oc=AdqaP6zIIgB764mmv2WcaoQFVn44LmDIKXNuJ6E7oJtClfRircGjBrahScBDaJfUyXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCrnwO-7sNfCxbbxjSg6zpwAJEKMctSrncj3bHaWB_lg&oe=6AC65E01"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
3NPLJu3KWlZEtDc43utUcPhI837Z8zycO-XQwZhqSh6EIYTuVPftkuyVY5ttVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XyZuDJp5k2obfpuoNxHWEzRIFFitav_3UVoi7K3zsrQ&oe=6A204462"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYIlEKft1IYQ7kNvwHpXbC2&_nc_oc=Adp5oAiILE466Z3rD6KHTODPiziCaUX8KEXYja649i7ShpqWjCHHfm04dXkCEXhJ78k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fuCyHcpxaiP4C-gw88o_ARpuXGPct-2GBJFK_s91YWg&oe=6A203784"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIvblLPl2BYQ7kNvwFUbCnT&_nc_oc=AdpL0Ch9SNCCA65BQQ8JzMaIa_ns0NPS3Ua2VVuMJafQQ3IwXP59agvX-FFJqp3kVgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BfEGD5izRnk0PjyWAM2kYwalM8GWGO2YK2VrdE43LzQ&oe=6A201D0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUWc9AEfXo8Q7kNvwGaByDL&_nc_oc=AdqcOzB-hI1C5uGEyvLi3Ni7qGDz1jtHNX6K85-Sd2mgnSrcU3hJ9q5g44K4nrQuxRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oy8iRm866ptUuEtALe9HRHpM1H5ippHi07aZzfMLe7w&oe=6A203150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9WnJECC6C4Q7kNvwGZR_K0&_nc_oc=AdqYKNpk4u_fNUB54jqJn9eY2dJ-2iLdXf3dsv63rIDLMwDaDpUIM1RdsOR-naehR3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KlV_Yl_oo4HSfh8AAmoZfgTclcsdDhEOXBv83effIjQ&oe=6A204101"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
R0yIlNn61n7wUY_bSu3UPZqhyFtGzvPWNNixB9-kmr1CMps2IRq9oM9x3jXrZE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ysaoMBs945cqXyWTzGG2Bv0QjgejqXSZnZI7dGZVnQ&oe=6A131562"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYO2rkh3NZoQ7kNvwGZvCbZ&_nc_oc=Adq0cusQtkUr03wSqyUd_GiuNVsjBc5nO6ZULIcYF8HPZ58f_n40X9I4aOkqrHlGAQo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gYtBtyvLZBs3ejsFDYigcteNwwLR-PXuC1ixa394PIw&oe=6A130884"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_sdhlZu468Q7kNvwGwmdaG&_nc_oc=AdrDpUjxHALRpsjdynYwOryT1Yqfh93bJzq4ZJ0DQb9bEp8pttd_li2Ql1Prl0A1nk0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CYr0nrPTi5Nz5oHvnUtLQ9ogCEN4AAhrfvpnSgmJHpQ&oe=6A12EE0D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HKsTqYGXBIQ7kNvwGU8XIz&_nc_oc=Ado9u-34cG_DRQlQUGEsXyM85f3Jql26hQMYQaWe_LM8PvosgV7EXUdVhjYICdDmBBQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OrNK4fNUbi9CUHkVAqkxo-0Q4BqlsLl2HZPbfkF01gA&oe=6A130250"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ry0Wj7pIdIQ7kNvwFgNhA4&_nc_oc=Adq6RZ4yPfpYqA6kaOv7QqZ9kOFFT57BipMR_w5-JWj7pRq0_fj31pb_FCy73Wm8WbM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MH6iqnt3MyR_-h1skEvxdkJWyTACRJWoW7BhlEr5LwA&oe=6A131201"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_mode
IypWUBSdjBv_qq41XP4LQRQkSm5j-mOU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afxlm_iivS5dEFFnGUyxy1XfPspkDItu41B0WJ_xaJtm-A&oe=69AAB6A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LajesgEZ-m0Q7kNvwH84Y0u&_nc_oc=AdkdSYg0ivwJRgwKhoHBjBgkxEcOOZmrzGXq4wuM-FVCONf2n5dqrhcTHZU7RlfS6sA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afw036ocyWcYdjvsRg7yULL8vG_Ii_gQP344h65d2o8W9A&oe=69AAE204"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ru2CnQUroQQ7kNvwHcy8AY&_nc_oc=AdmBtiCSwO2q0s83pKlS5W6MCvvz7BSI9keldflmK8A6BhyDm2KtnAEf6AxOkkpsQLM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afzlpte87vktwMKKx3oLtsZcQ6B9pV8S-THw6up_TzbQSg&oe=69AAC78D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2--4IiP-SQsQ7kNvwGmmf2-&_nc_oc=AdlXBFB62TttyR8JnnBKCqfFynd2hmVd1cHaycg-T0EMbtDPOJ4eQBvs3u-fTRltztk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzgVBB0K7tTQHI1klKk_pU4xhWFSgjI02ChcQGFrn5rg&oe=69AADBD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRiMARbIwhIQ7kNvwGic-3G&_nc_oc=AdleasxGib1gLj7dEqUQ8h1kuuNIzB8kfBjNExd3VtNQNivplLF9Lr6Eq9tgEhc4dPE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzo4jQLfxhnL4K9oksjMO2-y8nUCfJatL48zBd9b-yvAg&oe=69AAB341"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_inte
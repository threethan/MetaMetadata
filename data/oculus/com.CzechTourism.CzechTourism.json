7730134965154", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982678_147730138298487_6947146385733953188_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zxj2nQMfxlYQ7kNvwFD3RmQ&_nc_oc=Ado33pvdAmfMPGwzL_5v7i35zsmtP1liscWvL75F3VHwJAem9Pdt_vALhUSmSKkoqUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0ve3vT6AWbaT-CYGTFm4XEePm9XkNx0fnVSPbBDT0xGQ&oe=69F2117C"}]}, "id": "701962214222662", "locale": "en_US", "screenshots": [{"file_name": "s1.png", "id": "1587026181783938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75580066_1587026185117271_1020758453789073341_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BbFJM908q4EQ7kNvwEPWtqU&_nc_oc=AdodebC9eSBYVrQkHu8qAkB96G2iu3c8HbROcc9R7oxvKaHgjnAt2NSlXbguQQMekWk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3L4A_4seVIvitMZ7ixrLji-Mxga17cmbcwCTkyMzHwVQ&oe=69F1F40C"}, {"file_name": "s2.png", "id": "1369820543595945", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974824_1369820553595944_881476603892663184_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmGHE6ckZDUQ7kNvwHpvm_N&_nc_oc=AdowV0YuzTOwbmedbwG--NVPqMNxlARKzlw3Km9ozo1qAq1PW2QdTMi8-NYWFCQsoa8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2cFSMQWnDTtp_vBm44c9IThAmvGy5R-s8mnCD-ioEqkQ&oe=69F1E7A2"}, {"file_name": "s3.png", "id": "968709467657157", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036611_968709470990490_5602119205479471795_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6UHxEPz8pQQ7kNvwFlt_tf&_nc_oc=AdruSFWmYQLBgz8C40d3iUadf2wLitMuhMQxEXhzkjnm0bhZUVW86rq62JORJsG_ZzQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2m9ZDr9Lc8AOkFdE725VEIx_vFO_wRb4CqHpfNe3OZ2A&oe=69F21304"}, {"file_name": "s4.png", "id": "574851397869723", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031584_574851401203056_1809541965997395604_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H278xJRcwuoQ7kNvwExCKUf&_nc_oc=AdpmtzWEMT76U9j44k1oJWzF2BES_yvUEGw9R_8DEUp8HfaPMkzV5TXr9w9AS-TKkBw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lxJUBi9GEVVkRbqg3DXUNl7CPPrjfzpMs3_Y2L0Hntg&oe=69F1F88D"}, {"file_name": "s5.png", "id": "241990085141547", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210896_241990088474880_2642490046927224253_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nis6x0nA5oQ7kNvwGuU8Iq&_nc_oc=AdosrD5ab6hu-2VIXwlcltARnO4IFv4K2_-Bhw6FHN2K-7-dhL4z1NmrRyu1FNzWyvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1BuWJaQYGLx20wjONJp-Ub5tCUcGaA22QbX_DlWN7LQw&oe=69F20CD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s5.png", "id": "2288197731365565", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984447_2288197738032231_6803373221027356851_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVWNSaX2mhIQ7kNvwEW7KWS&_nc_oc=Ado51-JVJ8PWQ13UWf0835jSG1jzxgPJWqxzgHEQ1r0muk5LHcBYpHXMZnbcZIYt3HM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1VDeVnfVnf9ulopIGiTZxQpVNLwIBjcv4_TjW7XgKNIg&oe=69F1E441"}, "display_name": "Czech Tourism VR", "keywords": [], "long_description": "The emphasis in the virtual reality app is on the user experience, which will be unforgettable. After putting on the goggles, users find themselves in and become part of four connected stories. They are accompanied by narration, music, and extremely detailed visuals. This allows each user to concentrate on individual experiences and not be distracted. The abstract guide also offers great options for modification and isn\u2019t tied to a virtual individual that would need motion capture for speech, etc. The app thus is language agnostic and can already handle 10 languages including Chinese and Korean.\n\nEach scene requires the user to interact with the virtual environment: filling a pool in Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, playing a piano at \u017dof\u00edn with composer Bed\u0159ich Smetana, joining a traditional folk dance in Moravia, and crossing a bridge between two cliffs in the Prachov Rocks.\n\n", "short_description": "This virtual guide will take people to spa town Mari\u00e1nsk\u00e9 L\u00e1zn\u011b, the \u017dof\u00edn ballroom, a village celebration in Moravia, and to the Prachov Rocks."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.czechtourism.cz/en-US/GDPR", "developer_terms_of_service_url": null, "publisher_name": "Czech Tourism", "support_website_url": null, "website_url": "https://www.czechtourism.cz/en-US", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "es", "ru", "pl", "ko", "zh_CN", "he", "de", "fr", "ar"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "554133333009243"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1575784629613065"}]}, "baseline_offer": {"id": "1575784629613065"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1685723986, "status": "PUBLISHED", "id": "1575784629613065"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6651952641555035", "version": "4.0.0"}, "id": "1213123392847463", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5222751167808530", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "i
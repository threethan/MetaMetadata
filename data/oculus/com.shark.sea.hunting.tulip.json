"1743073079701405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1743073086368071_5614186735594541250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-wcugitHA8Q7kNvwFCEW4N&_nc_oc=Adpe8m7GHvf4KU9qYiPW7xdsnCxbdt0NyIHAdU7sH0znZ-3_JbJ-ZLF87Xd71WIAVfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GsnSbLUU-io4dtWfJgLwW9fZ47lATFnbXcTHkxE8uXA&oe=69DE3972"}, {"file_name": "6.png", "id": "3511531078986617", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_3511531085653283_1245401182632520664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Odtnk1e-x6EQ7kNvwHhTDtO&_nc_oc=AdrBB19ad8AIQ-dZeCz6V9T1inKBUQCR7jNn11_-FXJymZCy-Y7cw6A1f0ai8F2RNHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v6A_E5RUqVMnjEosDujemntX8Bkjgi3q-fYpx_--l0A&oe=69DE372A"}, {"file_name": "1.png", "id": "1213065980669453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823940_1213065984002786_7717174573393281531_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2q-65MdbQQQ7kNvwFYp_Kp&_nc_oc=AdrMx56wYFrPcpZAjKbkkHlOdR7O9o2yQ1F2vDoxBjPHyZgRkTKt9wvutaQpNMuQflk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3u8nXeiEmA5EWSvpjdwAe4zaRfPGkSFah392xLFnbrQw&oe=69DE534A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shark Attack - VR Sea Hunting Game", "keywords": ["sharkgame", "huntinggame", "seagame", "watergames", "hungergames"], "long_description": "Dive into the ocean and become the ultimate predator in Shark Attack \u2013 VR Sea Hunting Game. This immersive VR adventure transforms you into a deadly shark on a mission to hunt, chase, and survive in the deep blue sea. Explore vibrant underwater environments filled with fish, obstacles, and hidden dangers as you rise to the top of the food chain.\n\nSwim freely using intuitive VR movement and feel the thrill of fast-paced underwater action. Track down fish, attack with precision, and unleash powerful feeding frenzy moments. The more you eat, the stronger you become. But stay alert\u2014larger predators and sudden threats can turn the hunt into a fight for survival.\n\nPerfect for players who enjoy ocean games, creature survival, and high-energy VR experiences. With immersive visuals, smooth controls, and dynamic sea life, every dive feels exciting and unpredictable.\n\nBecome the apex hunter. Rule the waters. Experience the ocean like never before in Shark Attack \u2013 VR Sea Hunting Game.", "short_description": "Shark Attack \u2013 VR Sea Hunting Game puts you deep in the ocean as a powerful shark. Swim fast, hunt fish, and survive the wild underwater world. Chase schools of fish, dodge predators, and unleash your feeding frenzy. Experience immersive VR controls, smooth swimming, and thrilling shark action. Become the apex predator and rule the sea!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32869493712663887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823279_4304230666480698_3695008666568840734_n.
qsA&oe=69F1ED12"}, {"file_name": "4.png", "id": "1743073079701405", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819281_1743073086368071_5614186735594541250_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyQ58TK6yYMQ7kNvwE-qyg9&_nc_oc=Ado9OsdTdfDk50fg3wswUg9-_hhiQZsefyOGJv8D8srE6ujuzG1Lhv78QlnC238cqDI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3UcS-U8nxu4C9gaYEhlLJilea1-ODHuk4IA8Z9_4AKyQ&oe=69F1FFF2"}, {"file_name": "6.png", "id": "3511531078986617", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820441_3511531085653283_1245401182632520664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I4p--Xrx6oQ7kNvwGw4n51&_nc_oc=Adp9RpI9BO-EMUTmcO7y8rd5-1waDM5IzuJqmTsUb7G2x1EoKBb2_WSVVe_O3TUf2fk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FmaEfUjo1xUXT6vdWHfHuISkKGi_gA8b7wgkW_ET_8g&oe=69F1FDAA"}, {"file_name": "1.png", "id": "1213065980669453", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_1213065984002786_7717174573393281531_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jstcScdtz48Q7kNvwF4qe1f&_nc_oc=AdplRrIVYd1LQtIJRAYL20rb7F-CaJdFJQaaCrGC6uVXZixrb9dQhjTQ9h9NQMcXoGA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21warfD8xyEO4OS7UDuFQD5SKMo_RCkxuXDnqFdgS6Rg&oe=69F219CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shark Attack - VR Sea Hunting Game", "keywords": ["sharkgame", "huntinggame", "seagame", "watergames", "hungergames"], "long_description": "Dive into the ocean and become the ultimate predator in Shark Attack \u2013 VR Sea Hunting Game. This immersive VR adventure transforms you into a deadly shark on a mission to hunt, chase, and survive in the deep blue sea. Explore vibrant underwater environments filled with fish, obstacles, and hidden dangers as you rise to the top of the food chain.\n\nSwim freely using intuitive VR movement and feel the thrill of fast-paced underwater action. Track down fish, attack with precision, and unleash powerful feeding frenzy moments. The more you eat, the stronger you become. But stay alert\u2014larger predators and sudden threats can turn the hunt into a fight for survival.\n\nPerfect for players who enjoy ocean games, creature survival, and high-energy VR experiences. With immersive visuals, smooth controls, and dynamic sea life, every dive feels exciting and unpredictable.\n\nBecome the apex hunter. Rule the waters. Experience the ocean like never before in Shark Attack \u2013 VR Sea Hunting Game.", "short_description": "Shark Attack \u2013 VR Sea Hunting Game puts you deep in the ocean as a powerful shark. Swim fast, hunt fish, and survive the wild underwater world. Chase schools of fish, dodge predators, and unleash your feeding frenzy. Experience immersive VR controls, smooth swimming, and thrilling shark action. Become the apex predator and rule the sea!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32869493712663887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823279_4304
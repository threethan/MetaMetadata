201d characterized by \"a combination of positive feelings and a distinct static-like tingling sensation on the skin.\" It is most commonly triggered by specific auditory or visual stimuli, and less commonly by intentional attention control. - Wikipedia", "short_description": "ASMR for VR finally arrives to the Meta Quest.  ASMR is a worldwide sensation that now with the help of vr technology unleashes the true auditory and visual experience to all your Meta Quest devices. 12 ASMR videos included."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lifeto.company/asmrvr", "developer_terms_of_service_url": null, "publisher_name": "lifeto, llc", "support_website_url": null, "website_url": "https://lifeto.company/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "630258015307259"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "5640356465999418"}]}, "baseline_offer": {"id": "5640356465999418"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1669363200, "status": "PUBLISHED", "id": "5640356465999418"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6367284363298027", "version": "2.0"}, "id": "658148272695089", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBi
oculuscdn.com/v/t64.5771-25/75422394_962013372370117_2584067737468984219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5opcuWwnKtoQ7kNvwEGSUjL&_nc_oc=AdrCh6OdMaL9fUbueHDDpnbZCVMcPtBSpksHZxd-Fm3AH42xR8WnQQ8SMlR0ByGhysc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy8y2FeYgQpnhSmxX4cYSrmNO3MjnsIRa9paYSZRq_6w&oe=6A7C4C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Announcement_Trailer_Cover_Image_2560x1440.png", "id": "1163214754815541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572943_1163214758148874_1548614358813687475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiNUCEt4GcMQ7kNvwEKP9Ym&_nc_oc=AdrfGpenNdVnRALiiSgpBdW9VGs-9EXbSiXs__ipu6xhVjmZ6qrZZsEdqWFnOBZHLdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8fwTvzbtbvxLUkJI1oC4gVRXg-f7ewV-z6YJJpQjuAA&oe=6A7C4726"}, "display_name": "Exploding Kittens VR", "keywords": [], "long_description": "Play with up to five players online or against bots and strategically force your opponents to draw the dreaded Exploding Kitten and be the last person standing to win. Customize your own in-game avatars, explore the social hub and dive into a variety of entertaining mini-games. \n\nInteract With Your Favorite Card Game Like Never Before: A VR strategy game experience to socialize with friends and make new enemies. \n\nA Variety of Tools At Your Disposal: Utilize a slew of strategies to outsmart your opponents and come out on top. \n\nThree Unique Game Modes: Battle it out in either classic or blitz mode with up to five players, or against your biggest rival in duel mode.\n\nEngage With the Immersive Social Hub: Discover various activities in the social hub including mini games, character customization and more! ", "short_description": "Based on the popular card game, Exploding Kittens VR is coming soon to Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saber.games/privacy-policy/", "developer_terms_of_se
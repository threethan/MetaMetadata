0117_2584067737468984219_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHCBY31Xh7QQ7kNvwG3OwjT&_nc_oc=AdkMSQb4XoobZ30JAXVqWrpg1ICv9y509dGHtjHwLIdW3iRZiEIlRunuVbOYKqGHktI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaTkQI7_ojvWS7TYZCYkAsSn4nxR1VdlekJ70G9gBPfg&oe=69B14560"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Announcement_Trailer_Cover_Image_2560x1440.png", "id": "1163214754815541", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572943_1163214758148874_1548614358813687475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhSbDrGpeQMQ7kNvwElwwfG&_nc_oc=AdkZQKUB0ViODemo7a_ZJbUuljCHIhUD5uII-T2lMBxrHNjQmTvh7Ga-5eq6CdmEcg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1j2Vmfulq0J9Fs3xg6Q_iPxCZGU1c9xWS8SjLuBHJqQ&oe=69B17866"}, "display_name": "Exploding Kittens VR", "keywords": [], "long_description": "Play with up to five players online or against bots and strategically force your opponents to draw the dreaded Exploding Kitten and be the last person standing to win. Customize your own in-game avatars, explore the social hub and dive into a variety of entertaining mini-games. \n\nInteract With Your Favorite Card Game Like Never Before: A VR strategy game experience to socialize with friends and make new enemies. \n\nA Variety of Tools At Your Disposal: Utilize a slew of strategies to outsmart your opponents and come out on top. \n\nThree Unique Game Modes: Battle it out in either classic or blitz mode with up to five players, or against your biggest rival in duel mode.\n\nEngage With the Immersive Social Hub: Discover various activities in the social hub including mini games, character customization and more! ", "short_description": "Based on the popular card game, Exploding Kittens VR is coming soon to Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saber.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saber Interactive I
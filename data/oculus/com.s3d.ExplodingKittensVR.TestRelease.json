LclbhhEKfo4uNxI654ugnNOkACy1tynTK7JqTU03ALW1S5crife3xEi5LoiJS3RA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuoQft2qmic2VjmNk1WBQD7J4uVcyCWg8EdoEaKJaeW-A&oe=69A6F1A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Announcement_Trailer_Cover_Image_2560x1440.png", "id": "1163214754815541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572943_1163214758148874_1548614358813687475_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWFsiz79yqMQ7kNvwFZ1FZn&_nc_oc=AdlGdRVgYXlTJf90wBqorYzFId0HSl9GEumLWe6jjfxtJZXO97QnjLXW4gyvBudYpBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurPx5IW1NfDDQ8Pm-Ro8KzsifAYsuVoHfGnT48Pi5q5g&oe=69A6EC66"}, "display_name": "Exploding Kittens VR", "keywords": [], "long_description": "Play with up to five players online or against bots and strategically force your opponents to draw the dreaded Exploding Kitten and be the last person standing to win. Customize your own in-game avatars, explore the social hub and dive into a variety of entertaining mini-games. \n\nInteract With Your Favorite Card Game Like Never Before: A VR strategy game experience to socialize with friends and make new enemies. \n\nA Variety of Tools At Your Disposal: Utilize a slew of strategies to outsmart your opponents and come out on top. \n\nThree Unique Game Modes: Battle it out in either classic or blitz mode with up to five players, or against your biggest rival in duel mode.\n\nEngage With the Immersive Social Hub: Discover various activities in the social hub including mini games, character customization and more! ", "short_description": "Based on the popular card game, Exploding Kittens VR is coming soon to Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saber.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Saber Interactive Inc", "support_website_url": "https://support.saber.games/", "website_url": "https://saber.games/", "category": null, 
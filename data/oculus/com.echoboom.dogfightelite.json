2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z580MDpBapEQ7kNvwGTGurK&_nc_oc=AdrieNuqJbqgZ5ITdW06dAm3zp0DasAx5kE5OXacRZD5nj7_pqTrsYdZi_JQ0an6EGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af430MYZjTCNKmNRVVmGfONOUBWqt9ee1aDnBmzkibHNiw&oe=6A088573"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bin41azVjjMQ7kNvwEHmyUF&_nc_oc=AdpYa3gojXVBd6xPRkOnxxQ15XKuA1-quDL4LTYS_C_zB5Wp745sTmv11Qg6Q2t1aa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Jp4FHEnOUi9TSUUxctjdW8kl7Url9-FLxcx1gijj1rQ&oe=6A086457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXafRu63KAUQ7kNvwGqbF0R&_nc_oc=AdoGuOLTr9iBDYnAYe3_dbEBPVIaAH8cy3mb1ebKKoaXu7B39wZW4y2lBoCQPZUEpKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BiNDr3RNnAqHGhNoWF01clj0T37rMiKhc2uPBeU_WQA&oe=6A086006"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
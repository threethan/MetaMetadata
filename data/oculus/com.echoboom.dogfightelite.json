2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUgwswyk7v8Q7kNvwHki9Qt&_nc_oc=AdppE5GUpSOaZYJw-u8TqEsaTbAlk4MFak4fj9q4AWpCtRpvc2sEWDeU1WB-0avNyLU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc3JHHVhZU086_c_ssgwpxjMXnpyYkYchfx3UgYiBU5w&oe=6A9C2D73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6M8qcQ3fBgQ7kNvwHEDbFo&_nc_oc=Adr8LfJ9Lk_cKPev0Ei8DaTgT1XddbZ55u5RkneWDC2TBItEAFbNS_2bi48MMcjfxG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE4mX98zRI3Vvdr6zjU-bL6rL7vJNIChOGZ1fTmfamqw&oe=6A9C0C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Njkamj1Hr8Q7kNvwEKj7y5&_nc_oc=Adr0V98BuTIb9f-VY6nAumF_5CfFIBTrWylVPkaNg1RYaFS7H4axqYvKE4l6ixY7WpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7te2RdoGaIC1-2weDDHZctPY6RO4qLpFZjjjftnQtGw&oe=6A9C4046"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
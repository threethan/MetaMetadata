2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvfHSLsAm0AQ7kNvwGKzQzv&_nc_oc=AdoTCwxE1Zjjc_YJZE0xAMz9VcKcY0l1IcCcc0rqXfwEQw5nMaLe0bj5VxH5rVaAs7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HcDMFGFAm6_UVKAF_ya0aA4Sy6WLxP1n95E9lKfhZ6Q&oe=69ECD5F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bwjYobtDCQQ7kNvwEB8Ye0&_nc_oc=Adp9njL6teNMeHn6zB1O0csXurNq5N4NoFl0snNlGy50Mx5VUuS5Eeeksq2so5opDkc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04a-XPcJh5eq0K-O5vA3IIpkBK21QJJvCDcbG-_urIvA&oe=69ECB4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3uDkfKuujsQ7kNvwGE7AC3&_nc_oc=AdohLNCVjG--bHf97SLqm47R2_4fowTHNMZ7RLOcsmW12eKhFf9ncwqD-Ub7ilsJ1d0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31kxJecF7IIkmHI6sltKrDff5jUPoyoubjMDP1DP8qqg&oe=69ECB086"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
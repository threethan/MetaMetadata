2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l1G_zor_HMQ7kNvwF6zWms&_nc_oc=AdqPOI-yby-J06Cv5-TPXTQNKbX-DwgX1asTp1a4qdp79nMNSnS8jk70iBVuapPKerE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOTTak5TTtf9ZoKhkgamSnQprYG1Zy0qaRG4YGCsUFbw&oe=6A4A7073"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e_tOrvTkGcQ7kNvwF8i4ei&_nc_oc=AdoDaUnmbHqll1njhZiulybQ5ziq7LhLkGf4FkKLZZEJSJBQk4VD1KY7druzz2H2JkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKzas4k0PFR7yAMAe2_qy21xPWzT1OcpLZ26ulbwEnuQ&oe=6A4A4F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPDGoOrGerkQ7kNvwHaARAB&_nc_oc=AdoagY0uSN_45mGof22OUsuv3d--qLs5nfY_zNKFrfX3BAKj1lh9vFTb0fY1NIXH9W8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKoZTsRT1PEUX14TP4WyZUxUY2xstctek0698wIM-JoQ&oe=6A4A8346"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
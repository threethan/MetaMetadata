2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N3NA7RUc9AQ7kNvwEONvio&_nc_oc=Ado8FcJDiT_rHxQwimFAUWT-Mg8xNoEPgPC-moqCCxSOsA3V0teDu9ijUi_2viyXQmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHkGWFx8bwmdyThgh4pNmEcR4YwdVN7EmP7TrCspHPmg&oe=6AF5D373"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UPsTa2LfowQ7kNvwGC6pNk&_nc_oc=AdpeKkHnAufqsveUso6oaUGfzJ8MYR6uwgjx2wunedPpHeMbnHF1pUOpekpam9TRYVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSChwsVA_v2NBRnLZvIZmyiBymm2KWWJ_FDF1QZMlpkTQ&oe=6AF5EA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obKdOpaIAqUQ7kNvwGVTx16&_nc_oc=AdqjRxT3j8C6smQbE22A7Jcm3ffzFR5R2P2H0qOsb9mXbhATrEV1xfCA9Inf9peDkcM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgYYojcxjCYxVA-KdRj7El9cOjS-uAYzEI8i9_OekURQ&oe=6AF5E646"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwJk2A_20UEQ7kNvwHmg3cf&_nc_oc=AdqzxzsQUlAvLBR8mYLx7D9aQqfm9QlQg6Ojw8iBihx34cP7n2Esb4nCbBayH5DKsD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3JsyDtuEUV4fL87VESk6fdmNZSWnIBhd6N_iijjnJEA&oe=6AB14573"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnt7X23Iw-wQ7kNvwHuAKxT&_nc_oc=Adqay-2julBjSuXouWWNy6bUm3F2Uxkn5kmv7lpAxi9UQYVnERSivhKUJ2EKuSusYd4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfVPJ7rRe7I3jdf4HJ-QmH4tS3wpNS6_ICs2vlrOf5eg&oe=6AB12457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMB9VllUFDMQ7kNvwHJtbRP&_nc_oc=AdoIdqbe-uhPBE41SS0NYBZ5kaUgQzKBITu-iLEJDyT73yQpgHZy8Ao5g6RklRE47HI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWXF_vjly44j2ybMGM-4BqYbWx_2uM-CRxsxnkk7pmWQ&oe=6AB15846"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T5bkjoU3QsQ7kNvwFMfHbL&_nc_oc=AdpHZmnaySqJXXVy8-yH86DCALC2Gly2d1xtwc4Ej9t0wXdsEVJPGhORPBSS--zvbEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQ5FJJTCTeMMwTH6Vd0DF0zjZVhXJm66n97G6LelZ7yQ&oe=69CBA833"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9fKB3OdMk8Q7kNvwHhkbXr&_nc_oc=Ado-U40SLNNfoMAydgbGRDZ6F_L7izQYtt4bQlNrcrQHFkV87zqw4OR8KLYLK-hgTNA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmCYu7oq8DdjVMKJ21myOKbRJFM2ACGKIwnraQ98uApw&oe=69CBBF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7xm7mdxwfQQ7kNvwGUOtL_&_nc_oc=Adr9J5gAaE2CVNqq9Ko57yimQL9icZAtIMY6aXYDHNifixsaSNX7HjVRK0kyygdRWWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOf5QE24TlAj2dhWFAmEnEubg7kRMBNUOi3d3c67MgBw&oe=69CBBB06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
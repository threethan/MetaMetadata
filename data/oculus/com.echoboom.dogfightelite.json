2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLI7nmgGNqcQ7kNvwFzxnLw&_nc_oc=AdpZCo-4sKH99ALQX3HD42sVIgDNWoZgC8Ia4ffAIcA_4Wbh_W5JBu7NASclqRdzv88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3iMX1611GRGWVnGN4BKlmRXGJ-XDRfvIedBCpFq8wFg&oe=6ADE1873"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAONEdd4KxUQ7kNvwFfe66G&_nc_oc=AdpjrI2s4HY93HepM-YQNuXuPl6DGq_buD4vLeWBVerpEakd6PtQXPwnlyJEzN4p9-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4rCwKNjBtqZsy3YJOsDMZkWGHsl8NvboHPsVuNgedsg&oe=6ADDF757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T901DuEvKRIQ7kNvwG8AodE&_nc_oc=AdpcfI5yp1gQoIVVSFGKNQqz3IYycLgvJL602YW7c7Ty66daVLVFcPYDu8SbXVh7J_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUIL5HuM0z521ltVxe7oo5ZwRPHzx1j1YzRPoFfNHUjg&oe=6ADDF306"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
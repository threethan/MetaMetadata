2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AACm5LWVLMQ7kNvwGRihBo&_nc_oc=AdoKWzsHdv7BTCfJC34khGM2THmlC8MdQTvLnLJQubvzVpUxBzVykN5Rsmqt4pfygUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQEO6YhP3hNb-pWbH3oPy5BDKSna5bPKlLeWd2ZWNMcg&oe=6AC268F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6_fDQLMp6kQ7kNvwFGevvK&_nc_oc=AdrUlERCsz0KWMrUVsxW3kPBgJ2PmUQlr55XcLqspp_Cq4qGT5FH7-Yrdczb7hAGP8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOFtdaTpQUO3XAW7cJq7J5yBTQ7th2aVZyN0wJSeortw&oe=6AC28017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pxTisX9lDAQ7kNvwHLSyfF&_nc_oc=AdrOIZiybi-ovgCmUnRv-iNHuvZtE_zAgXnV3N15-O-2vYMsGT5Z9uMQsK8gcNIzBl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_8505fc5Sz_zwWvT0GEWCulasCq3CNkAXsaM7RoOAXw&oe=6AC27BC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
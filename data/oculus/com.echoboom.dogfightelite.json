2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0jDyzQ7VoYQ7kNvwF0gEwl&_nc_oc=AdpVRKjSToPo8BqUr08kfVG-Ie3rNqpZplUbJQUnY4mhnY6_epUQcy6rKOUa4kDmsQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyyGJGlM-vbpC0z8ZcP0VbinatMbAyQzBBw9KBvtk5LQ&oe=6A95CE33"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfWcluRSRbkQ7kNvwGNTESf&_nc_oc=AdoJValnk-8nlL3ZVtvreU-2dzYf3KVANLiyUZk5uRwttvTlAIBUg9wtCvGS_Ad8DZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8-BHq9GlLQfFZy4fpACbf2FmZlMWQ6UkCacL3XfBf-w&oe=6A95E557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yc4J0aGJLoQ7kNvwG1HVWh&_nc_oc=AdqP53ZQ_7Uvbj2bjNF8szrI8BMCH9I-vQ16_fSiHzK-R5-DTNdnlCbbws9WS7iQp7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZxA7BHtbAmiM_-qBvjFZoGw7QanqMjlqqP-pJqnM0oQ&oe=6A95E106"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
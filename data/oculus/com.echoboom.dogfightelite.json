2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z580MDpBapEQ7kNvwFnWN1b&_nc_oc=AdrhrtzWDgxJJObyW9qISjVWwSPn2pZWJa9D5ZePg0U7kWgNy-IbtVR2NBNKYxWDsIg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tE2hcnhi460EN_Ej77YkDN4fp8doj3jjxnskQa3P08w&oe=6A09D6F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bin41azVjjMQ7kNvwHDsFpP&_nc_oc=AdpWkVEpESSZdVH6xUxbeXpzShalrt3KKtYNYgNG7lBEqWVGkJI4Q1Ikxm0aUWBGFiw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JZRBMj-P2GMzHTd4fDkwpiEUxJ79kT_TKQErg4DQkdw&oe=6A09B5D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXafRu63KAUQ7kNvwHkjE-M&_nc_oc=AdpRSXeHvx5L6FCqYpxuxaXRLA0EsQe4UMJSkKpSSnpx4YrN3qIDAlmhqRh5ogZ8gOU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v64HxTaEvM_t-WfR2ruSHCmhKqJhVqNbPIneqBVFQcA&oe=6A09B186"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
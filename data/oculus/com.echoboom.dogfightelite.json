2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8f8vJ12xWQQ7kNvwFRyK_l&_nc_oc=AdqddFO-y8AmO-sZI7qIrhTIyP-sFnSD5zdSvWXYq8ra-UgjSPMoO3JqeeCd3dM4QFM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgYw0_TzyuzBAz075xedesYixorA2EpbwJyUBVAE3fRA&oe=6A882EB3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VfAr9xJ6XEQ7kNvwGtYAPS&_nc_oc=AdqHiuEsFIUnomHJrJ_YzC-1mAKDkV7DNWBIh0Wd_Rqeao2QgJWSAzRDTaA7peRYgYs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwCx7R7mj8iL_LEcUpwmL2rcxXSg_utkC4-u8mc_hjTw&oe=6A8845D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZrHdhlZJUwQ7kNvwFmK0x9&_nc_oc=AdrgXl9bdCpJb_eh8H8jq4stDBl6WfslJkbR1LWzCOlWhrdKLupDTyQMsoOyqNK07Z0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGUjVilKWOAz3iOJCOhmgPT4wPpz6ZIt6dpR5TRIqcuA&oe=6A884186"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
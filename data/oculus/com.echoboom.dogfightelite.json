2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49c5GWnUEcQ7kNvwECxd8p&_nc_oc=AdpR0LjYbbpX4zRs75qVyb3pX62uXcMu6ly33sxbmtV0F0l1GBL4datQOBf1l0L8NEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2W-bYUA7NRStksMUnrmbmAaiLPhtCoxRnTl1_EbC9JQ&oe=6AE9F5F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Idv-PzvutcQ7kNvwG6nM9F&_nc_oc=Adq-CCbigZH8mkskZo4fKeJPJfkg2iLsjERbQ-SCD8HAIPwRs8IA17vnTJjnqg1vBuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8N4Zd91aJ78fLNk1wzXEXzWeSLt1dEEazoCYHXoIgFw&oe=6AEA0D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyUn2JvbAxsQ7kNvwHP6Azb&_nc_oc=AdrdV_OS-CSYhGx6I3dLQ9pxxeEjBMWK4e31rUU12ii08DAQbFKhQdb7ydvnrkFs9do&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7061x35NWgWmR8TcmC9UlUEcgbsT0U7cYlRM6nevHEg&oe=6AEA08C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
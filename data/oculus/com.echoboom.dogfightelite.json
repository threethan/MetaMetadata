2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjTBH2ECd68Q7kNvwHwkc53&_nc_oc=AdqwUqQefLTsnrrELJwudWALX0S87TRFq4XxxmuWrxLptbw_UhNZQ3G14YUONeOxWo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RiTlNVXE8OqbyPW93wgpbEgxfegxoimAzvgsTWuRLjg&oe=69D39133"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNTLBLHPUEkQ7kNvwHAeeOx&_nc_oc=Adp-f9nRRw0a47003VCGysZQmI8EbsWNnVppTbom-yYklgXJTy4z3qkFCtAsZEcWOtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kuWkXV__2WSvs9Bnsyiw3B7l9ca-nCCuPRHBy9m0Tzw&oe=69D3A857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saZNp7B9xfoQ7kNvwEHRjCN&_nc_oc=AdoXddLKOl3ZLjnwhuubtcdIi28nNBsm_A5Qm0ftWdw-1xhSCEWs19MBY02ST6d3wQU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39DWMwn8jnLuikBMN_h1IgD2I7Bkjqc1UEnACOpJbHWg&oe=69D3A406"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
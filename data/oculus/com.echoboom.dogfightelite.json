2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7auy4EG07UEQ7kNvwHx_Wx2&_nc_oc=AdqeEqtbAaI8OioEXzQUpa0SAu3XY3UpKM8POx9g73l6ev7svgbD25EdZTTmiAlYEAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyJSzcgrmwrhgXSaj3oC07DmR7KayUROgNIJF071kvUg&oe=6A4D1373"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e_tOrvTkGcQ7kNvwGIzDkb&_nc_oc=AdrTR4h_QWdrBYvfoYb_bcyQX3qnDB4HpjgBGQyYx1JxV5gYF4Jt6_BZQ7OcqLEtRcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWP418JWDUDuBQ0leUIuZZ7_w4UNYce-pT93xeKXQVvw&oe=6A4CF257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPDGoOrGerkQ7kNvwGzienE&_nc_oc=AdqrDjEBRLCE1jdNdC6FuEGOCN_rTJ5RfX-e_zDUhE4fHI7_HbY7hKK5kULoYcjFD7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJKjkiMXQpmbPK93V4491u9ZqG4NZgWp-UGtbcOmQnsg&oe=6A4CEE06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
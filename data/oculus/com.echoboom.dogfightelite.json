2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPgmq5F0gW0Q7kNvwFSyKIF&_nc_oc=Adqs9TXo1AfzPMXAlorSY6rDkSrfHVvsq2eATTArkpZ5xn-o90oGvEVMD2dMq-kSLKg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EF_ulmDbJLsiw-QNoFfWfc0FLn7iDw2Te3yaPOUW2zg&oe=6A185773"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA-kITZq9qgQ7kNvwEaCJYr&_nc_oc=AdpjiIXMaXr1xxB0H8Iw3MMxgsiKy1_tHyMp81Yjy1GwPh0MsC_lS9Xm2624Q_ZcNl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42rChRmj3VMkD2tYZphWaoMgbxzM8Q7_hMl83b0IHZgw&oe=6A183657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z6-0BO5RCwQ7kNvwFgx8_F&_nc_oc=Adp5GxSCWOLL6iciQKSgLWvR66jq6QT53RVIPMbb47xQxkb716Alor9NFgopljql-1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fEUdHT_KhBH3eeqahk0_49XocNuPGerqk-2cT05AmNA&oe=6A186A46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac1OoGV96icQ7kNvwFF55yj&_nc_oc=Adq2BUMOXVnXRBfkzqFu4v2K7tzKNj8AXSXM8jEPaZ9p14jp4zv9jWU7OXUmlofxz-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L3Hug4f2zQUzYA3vBGVaMhrbC-u5vtBes81LlsZEEZw&oe=69E78FF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD5kAU9ffzMQ7kNvwHMKQC8&_nc_oc=Ado-HsmMkWq43wvbm8rgwOSLOK5ZS1yFhAIhYRWI3y1juaU77Ox8pz7zvXgUc9IUJLA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lw-1gyV_9iRUyHHG4iDBU2e8YIquwWKWx1-SnQ9GkUA&oe=69E76ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6NGkxkOu6cQ7kNvwG2re9N&_nc_oc=Adp4vZ7mgWODQA4gv8HrCERvIfqSNSY-CMfFCOK9fO6QWpOWjI9LBuoSDNyGSTdRwyo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TQxDgkcxsX8-N0FpRjuJlHsVDCGhmgnoTYqYySTGmEQ&oe=69E76A86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
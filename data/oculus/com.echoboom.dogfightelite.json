2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RInAxm4Ft5MQ7kNvwHT20MJ&_nc_oc=Adp58TN1tfG4170n1CuSdHSY_kGHimNjJekMHIdO_q6i5Xx2T3LyUgpDeUuOzHs5dc8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZQyQ3Pt2voQ5OlMBIpU6NLm3sK0rXPe9IT2J4l3TRjw&oe=6A579F73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7aO2k9z0UQ7kNvwF3aret&_nc_oc=AdqXCCP346rgstq6lzgq22A6WKGHwcPxIqwkRjElEkPKzLrDTYTaSVswO9VP7DY8Lis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACHqXnbxZjqqx183dhxuN8e3BXhMuSK3ABQX4p2EFG_g&oe=6A577E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agS9b8YVmJQQ7kNvwGzjLF1&_nc_oc=AdrvMJwL5dVMPQ7oNoSDAlDGMmr4SeReooipv-QaV5GjjzLXBRj82GCqp0L4kCCGtLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4gfH3HkGUR3fxlHAMdwnQlhatwjWVstmG7ykGHpOMxw&oe=6A577A06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
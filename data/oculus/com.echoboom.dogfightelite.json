2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAe5Jif4kk0Q7kNvwEe9-dS&_nc_oc=AdrsA2PMLuy-kbLsGZbrGC-yppC096JIVzzuULJvQKHHFAPFejxwwdZSl-h1kkLemdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ULiSZp-MSwq1n-VYeQh5nUoWmT0Fg9uAgmT2h6XrjGg&oe=69F761F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aChveK6f3lMQ7kNvwGV1C1a&_nc_oc=AdrR4l08MWBmEuLnDBCGoQp6FPzFaAJN-Dx50wz3uI52E76TyeMRwSDPf4YXikMmT1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WUMM8HVKGt29WGsfWUc8QEhG3Nsgio2M2wt67CROG_Q&oe=69F740D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklZCl52L7IQ7kNvwEL6CIP&_nc_oc=AdrhqVl3P09SRPA-FLsj_EUpqY86Xf3SncJO8N673TVAHQZt7A1yi6J-jSfvvnBlfZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29oFQ2sUw9JwB6KQZSwnxPibqS4xxxR6MjhiTPhOSRTQ&oe=69F73C86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
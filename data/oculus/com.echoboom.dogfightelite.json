2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPgmq5F0gW0Q7kNvwES4vqE&_nc_oc=AdqJ8R4RpWdbr84WJG1oC1MY4nHaEbWNM2-UrRpytMX0UaxiWJwqNAzuqACCVE14cRE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bUzDdTd2jKz8BhWkMgh3TtTjryv8TWedzboM3Bb_pQg&oe=6A1AFA73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHdoYjctDUoQ7kNvwG6VagS&_nc_oc=AdrdR7v4iOD20GNfce2NxfCWBeZxXpE87ozJrlUH7puhZ4WCf12WQkPMUD5h6C5zJ0I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QXdLXVuqIksp8xAAnHt3wQ1g7n9Cy-Z2VyDv_9N2jpw&oe=6A1AD957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX_AE229BicQ7kNvwEBF8ga&_nc_oc=AdoMv8wyie5eEn6tXBSaAM9u8_PaKyxnQ5oMFW6-l2GU-MW0HCJRcVZPJwTY_UHTwXw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vsWbV4RHukIJwbWoCK2dCelFrxddNHU3sGWQIAvYEDA&oe=6A1AD506"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
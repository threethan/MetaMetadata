2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_IqEWGrQvgQ7kNvwGq6b0m&_nc_oc=AdpdRakOL9WEtmHrhV_GyXvOBXX_AOUGUfkh7hifWfAC6YHKgy4pbxKOz7MVQZNB95w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS79saq_PB0JLjyT7JzJ_yzbsJ8qfR2zzTVhxJOm4bs6A&oe=6AF33073"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMufReUcl6gQ7kNvwEQclVo&_nc_oc=AdqFa9BXThGSCScGx0wORHFx5DWnHd4wuDCP6kcWsbQz7isj253WLaBXCO8I9zMiULE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_H2sUWrs2RZgCTpSy-EWBkR0XDyyaH-mSD0LbSEnCvg&oe=6AF34797"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFPc4hYbarwQ7kNvwElMZ1P&_nc_oc=Adr0r34StnTKvb1T56KJ4QVw3CQhmCqCy5PVDHCo7kw7vGj9xY7bPlR9AeHJ-lN42vU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3CSIq-raVgDjkQovSNYs-egtAvKjZXdV9i9SvyVolWQ&oe=6AF34346"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
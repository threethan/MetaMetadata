2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p56SFZDOA8EQ7kNvwFNUT6O&_nc_oc=AdoR2Iohm5nBwdGXSi5JfS6XHDPnnKzeaSi3Sz-kT4G-muanS3zwjdJeFDSmKqzWDqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iQ5OFRwmFMhM1zQfFQdSkbOYYEy-UKjMJaJOoPbRlZg&oe=69FB5673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g0KYNIoedYQ7kNvwFX5G4b&_nc_oc=AdprZm60Yh5IMJsefY6VdXJIaZMrRU4B5T0_NbaXgA9ap6gYLPKU8WauiMD-YJBuuqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jbnnKJIKwGjNcYZ6zGVntxESDcVpRYE_HrPOOBByODg&oe=69FB3557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ5fN8D9KEwQ7kNvwFAtbm_&_nc_oc=AdrpL3RbedQnRWp32vWQ8OcYiNeR9wuf6G7JahBBv4g5krR4W0o8ecDYrEQZUYD0FHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VM6UCXBB_0ijNWGvPp8QuD8CN0w-aYb-IS6wmlCCciQ&oe=69FB3106"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7auy4EG07UEQ7kNvwE-bv5h&_nc_oc=AdpX8XqKIapXYFKogPJuATSs7HXn7LzSynXjd07wH6_n-M1c2m41JyUPR-8LyPFnBVs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe6vLBHH6mFVI_p3hz6dwpls9jvw_zCknKRAqj1Hmhsg&oe=6A4E64F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUTp2_O2uuIQ7kNvwEHVNnV&_nc_oc=AdpgHlavB7t1IMFeAluqTkaMLu3oM7RXMkcaAkkXKW6Auhg0G9FAGuiQPi6vC8BBjYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzvS8NmmGGL97ZRmHhVmvTHyI9XcKH4HSmw44RaC_SoA&oe=6A4E43D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4iLsAE_fxEQ7kNvwFy21nE&_nc_oc=AdqDCDceO7uI6L2Thk6DQGeoUwhHHNfKb6_xuR44oAzpxjlf0f6hRmjF5wB3jRa6HxI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLIIixRHW0ijtc3NYoQZjBikkzSICexUa9fsGxn1T1_A&oe=6A4E3F86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
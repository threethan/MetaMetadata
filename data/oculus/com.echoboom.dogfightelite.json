2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7FR1SJe2nwQ7kNvwG_lJIi&_nc_oc=AdqyXZD7LCmfTqU8whGXwi4_3-bZWeZs2gdXpqLr9MUi4Ak4oeE9xhLHbRjdVHNGve8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rNTjCJ7AcAL1-UCPujTY7ElFb3Zez0crCwgfZDMAFFQ&oe=6A32B573"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHP3v2O1ucgQ7kNvwFhZ85H&_nc_oc=AdrPpTsZ8Q3tVcbW02Ag-rH7BYcfSL72Cqz0UirmOU94XGs9pgOavtDpiKr1JFlLmlY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4MSPsORgBkPh8lpXu-aHVd5Ke7izhsICEC2e4ItpC3g&oe=6A329457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyHN7WoOgAQ7kNvwESDKf8&_nc_oc=AdozWh1_0jpRW9jDeRzmSBqE1EMOr0Py04rLd71PIQIH2LPr2v1WbYuMPSsFWZSUvCc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80cmZBV9ZrhbQUYCxlnhpqFCAntvGUGJjQ29k2Pa_j1g&oe=6A32C846"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
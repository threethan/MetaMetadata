2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0GRIRihqNQQ7kNvwE_GnNj&_nc_oc=AdrrtHvQrYxS11XuCvKhch2xXwAr115H7G9LQw3DKVKk2eInhmdEOM-a7CGsFx5c26s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm6YuQqFkXQDv2ie2Wy5KZJtPLTIP-inrQxfDKNysAKA&oe=6A60A1B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thtw_FF4uWYQ7kNvwGu_QNc&_nc_oc=AdppZOVpCKRmbY8qrEmtdZVybpvRZoj-nUPdfCYu-a8iKvZiDj6yhzqwi3uQIskAVoo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgFQMzfnDhioLindAZmtL558XBKGiH58fOYvNT9WIMOg&oe=6A60B8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIH8TPPBtQoQ7kNvwEMZfuO&_nc_oc=AdqrwKxNJWz3_-Nu5t16VR2fhQz-FJixywUH4X8r5p4Klor497yT6JE-j9lGUNoQbFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEZ4RkCR4c5zgrDPT6DFvqHyk3-dpAhmngOZB580iJIg&oe=6A60B486"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
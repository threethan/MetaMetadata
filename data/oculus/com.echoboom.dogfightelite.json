2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgXQbja9MnYQ7kNvwGzH9aQ&_nc_oc=AdrMHC1ULL-72XkQZ47laTKckKCkjWbmybzpLyWuDu7SqI4xwsnoBB2WB_wwJmzFbCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIZdeQ080cLOBMpfMiRC8eXaLuorHoJvGMQ6upPvVFLw&oe=6AAAADF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2dFG0c8-eoQ7kNvwGoZOyL&_nc_oc=AdoGFw4O-exIJB6T6at60Ux9qdelUfgPHFHaASoOnonyS8gTjlRn5Vdipf5zNkLWd9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZJrv1VNhuZZ8rOHzPFM4LJrvSPVw47MEMrtlp18tNng&oe=6AAA8CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7em24ZExVAQ7kNvwHmcYyn&_nc_oc=Ado_T6JSNtPRfbXtoMjuNh4YK6mR1CEC9dJrcduSAHR5N82jfKqgGMrzyBYvDZ-xh_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-dmitJR5r2Ctz7vLYAJCkoEGr44ugfOT1ssTcf3gLVQ&oe=6AAA8886"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
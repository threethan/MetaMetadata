2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqH-SP4qX3cQ7kNvwGqSrit&_nc_oc=AdqpB4mjlQ6sltdUOdWt1qApjxo_tWTiWi-Ts-I4LP6G7o9HV8nK-uHpMXe_brOoCoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XcgwyiJzw9GDRD5M1y7ADAeLqHg5uJkj59AHjvNO4kQ&oe=6A258673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YhNdcCVjhAQ7kNvwEAbFwI&_nc_oc=AdraUNOEpDJxQzd622jZr4eZv6yYlyXGXkIoTQByTfscvd3cPBZD-zgbbl6ayvT49CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Cg4Z6jhDZ4SnI0y44tz8kJvmNU6czbPnAX28cKUbHg&oe=6A259D97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVpFvlnWkTgQ7kNvwFE5k0Y&_nc_oc=Adq-6NWQ6We-GEDdwAsxXHugA7EO_shy9MQJVkPggaU9nMkNVmV7POBwYSNzKtv7iW8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y-hGQQ8XEygMkwOm7p4QxTDYvf_BjozKA4huqtqjlrw&oe=6A259946"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
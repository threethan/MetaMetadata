2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z580MDpBapEQ7kNvwE8yzQh&_nc_oc=AdoKCvXI9wAHy4O6dehOmIOQpTAq2qxX0I-exM_mQVV3JQlOsh9FXskOAPITzFpSCEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vLwHAERsIhl8iJIjhayDFJ1I0-gB9jUu3zb4nTCq3HQ&oe=6A0B2873"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvawGqDAv8wQ7kNvwHxa0Ku&_nc_oc=AdravODXC3hyOPGu8uQ1a0ppu5KtOhc9AAqy5rJjZnK7prQ8DzhP3pFMJi6lBCW6uR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53E3j1tlAlgF8NyoG571D1sWReYYDU7LcFnPmGE-Jltg&oe=6A0B0757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD-Wn96OEF4Q7kNvwFjZ1r6&_nc_oc=Adp5NME9uUj9MPRoYnuYG0DWGTRIxeI8hvL7pTteTHAX7CmXPd2MgNvazFXUgz6-U2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dfKkH-6fXPSzujQB89Vbu9U57BbQLrEGFYpdl-h9Mow&oe=6A0B0306"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
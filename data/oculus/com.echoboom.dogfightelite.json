2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCjnZUX8YuMQ7kNvwGfp_yr&_nc_oc=AdqMdlzQT1LuwcrD6gfphxECwOzFzvej_dqeNa7jL8KzpS61xnda11yPXbmSV2gS6h0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2K2_R5vZKis5IcNYY9KzZkczSuXDpAQlJC94z8ZsTag&oe=6ABFC5F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO8u74v5Sk0Q7kNvwGCxQPR&_nc_oc=Ado_L9MGbkHOK4fzhglBu3lvEHen6Z-E52VMySG3fOCGwHOtunofyQCzoObpHW8h-Bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGjMjePX1oyX5JoHYwCBRYm3uMBBlUlQSe27ZPDbFDww&oe=6ABFDD17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42x7_JZ5AKYQ7kNvwE0Tx-X&_nc_oc=AdonrG_wASH1LBiGDq_GfuDQbu4Ww0Yffd2q9nYIsBJKxK7hlMHXU3JiHjOZzkssMeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgFB-Wh9cVSZ8VdbBXuaKj_8ctAiM2HoMsyG9gx8nuBQ&oe=6ABFD8C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc3jtuzw_V8Q7kNvwGOYvw9&_nc_oc=AdqOReVUHTR1EXLQnFS2m_Fb7AaVLAAvl4sIXhgeuE_dsqXTHF-X-rT_MDW0IPERZBU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nXkL9Y1qlyuXbF4QnolL1UW5MgwcbMz1onKm64VeaMg&oe=6A0F1CF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJcWO37oPgcQ7kNvwHIUAFC&_nc_oc=Adqi8J-LcmtPFtFgq87ptzIiNuidQaWid_BF3O3riKlanVM7d2Ngtq-lOAQyOD4Xed4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sjD6yalgDL1T1I2XeQ0AZTj5epn_bMLtp_SvkEOKQRg&oe=6A0EFBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9jmGVTu3xwQ7kNvwG8zD3_&_nc_oc=AdqvNIFStrN3Xv9XHEp0weuV6V26KhTKNKKZN40thT1SmBizjJNUClFdSxHFYkkGDKs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n49e6j36tXIWDKHjduhJWYb0C34qQs6T1sIfNMZS_Fg&oe=6A0EF786"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
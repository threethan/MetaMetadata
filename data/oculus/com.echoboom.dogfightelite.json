2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvxjDI4koR8Q7kNvwEe7Rcb&_nc_oc=AdroaeJy11nJgyzAaY1uFMRmDoWyp3FMZ1lHKUqtA-l5lbxXZr6Gr2cCeT5Mv3a3cu8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb87VrpOYvuChS5B2u1_FyIXYxlu15mgSw6Uk7w4TmIQ&oe=6AE752F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ps05FK3bbU8Q7kNvwHVCFAJ&_nc_oc=AdorSDubFguKeVHJj7LJkAgLQh-tV7g3UvTfutFnV88WTTeCuznYBBoV9h-UFCweGAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREvppVoCQYiQKspHfP1CSIQB91VjhWDF8kk7dzKcC6ew&oe=6AE76A17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q75ub5v8bWYQ7kNvwGmAyey&_nc_oc=AdrfgwgeZVBjH6YFYpK1iFuEAFwSVsHHkbXcsgpo_JIwlHaRt9DjzLYINTL4P1DVV6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS1zcBodgOrl7JVsxHVfmJqgf8Ydlycke64QcRjapOUg&oe=6AE765C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUguy1wKqVMQ7kNvwGVPToH&_nc_oc=AdqOiBVAP9Q7V5RhYwsr652_gVYiFWAYF0w1Mh_L052i-TY2cVROT26eE2p_OxX_whQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI_vE7iN7SgokL-T0JlAMcq0usHCAVTHNya0oKGg0lZQ&oe=6A5B93F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzJ1dyyrxQIQ7kNvwHCw6Ct&_nc_oc=AdpsagAhYBpaRnoVFuCevOgruNtQY8wa4OqliKQi_QtIZ77OdFwBE6agHwfsDgFtF20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqh9XwzUtdYBaw-nmrHwTRl2aU8Nq_9wV6Od_9GB8v4w&oe=6A5B72D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmey6SYKLJoQ7kNvwEP9BFD&_nc_oc=AdqUHl-x7GTUzeLThserSJpMEuF0e6VmD8QbtCf0OPha7CRzvU6tf5sD3owdB73KS7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEyo2sLRw5bGN6qfOEDpvWndew31nOAtMa9RyeWAsHAg&oe=6A5B6E86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
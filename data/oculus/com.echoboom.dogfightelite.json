2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvxjDI4koR8Q7kNvwH0oz6W&_nc_oc=AdqkNlqozNXOOJWwh5QlfU5ff7ej-xVRt5FZNCzt_Cq4S6puY9nam2ZeeoxtnzzdUwQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzeK5MRFlarmeMLFPP7lDK2jVQTLsOlCHwQYTIIbl6jg&oe=6AE8A473"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Idv-PzvutcQ7kNvwGYWCUA&_nc_oc=AdpehSpigeMjhCm-n3zG-tk81AOKoFYgnUMV0TLej-uv-9alDucu81FQhUr4qlJ__co&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtVI9JatBrWByXBq1RuGuBjLgOxFo-liMek0Nqav27Vg&oe=6AE8BB97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyUn2JvbAxsQ7kNvwEv0FkJ&_nc_oc=Adq_EKp7v6wUjxA-kHKeW57WpVhVZGMtbj0EpclaHN0qOhXjFreLxzb5XVKhMjpV5B0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlYkxNd6_n8uHMvVQHiX2w5S4xc4Wq6mIXuzHJhKd3Uw&oe=6AE8B746"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
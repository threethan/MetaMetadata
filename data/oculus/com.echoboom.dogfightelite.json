2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScXeFP8zHXEQ7kNvwF7Lvu3&_nc_oc=AdqMi8W7clIC0K0veFZ833WtpJklSueouQ8v8t2Fw47mkjehXc8eDcAbQukjI_7YTF8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9in-QpypaMDpobcM0ypIreGTOVtfKYzvBeohhp98MAw&oe=6AF9C7F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6f8K_KAFw4Q7kNvwGifXJ5&_nc_oc=AdoG8oJ2vkTq3Q6A31vmW79PwlpzaVHxdYGC1XLiAI-7flHZVxgsLt4D6XEKQXKYgqU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTKBVJ84UiOWtSLnUwsM-7a0my5Q0NIj3Gc5I_A0DkCA&oe=6AF9DF17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-1XP9LMVUkQ7kNvwHjZ-jG&_nc_oc=AdrjeNDUmU6gvxqyb3-tg5RElF75zGxS6A1WL-6sfPredJI1D5HB-98GBVMO0jSZAa8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq_Db4DDoQaecJjjzdW5Q2qvVW4MS_S_fAwcFeIL-t5A&oe=6AF9DAC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
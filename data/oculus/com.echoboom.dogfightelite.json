2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lknLVI-q0JkQ7kNvwF11bER&_nc_oc=AdocTwbv5e6FL9avZP4vkNcjI4BOjcY9wrGk1U6pIc2Pr0t9pniW71SHPuRWzyHk7dU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu7FIEo0oO57GmdgzR6pmFdS18HP21lUvRd-WJdCiMSw&oe=6AA021F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QJ8ioAv05EQ7kNvwG4eii8&_nc_oc=Adq2jV9EZTKXwSn10s4ZQ_CSoYHcrPYGXhR0Fr__Cd0Z4NpdXHwr4TA1plaAIZguwdU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfSK7gK3qQRDXtpDI-NctcxPwnUFdHxvSjfhyar5vbNA&oe=6AA000D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqTUvav8-SIQ7kNvwEs4Krn&_nc_oc=Adrgcekse0c8029Xtmu2Mcs1Vc4Wo1LP_u0C9iA4KDogzn5WkE5imWm1ABwJcj7Qytk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh5S5gOZ71-VuMszcoTOBKmgFr3K2YczxBbkay1Yc2VA&oe=6A9FFC86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
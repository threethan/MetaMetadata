2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI5MIrgnI6EQ7kNvwFHMeJo&_nc_oc=AdopGMpr9hmEuTmx9RYMbxeSvtrhfCczPwDUPONaSVWlKdKxXOpp3lvDB-qLFP2tRLw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xIC9KAYH1A-qRPKY9pZawzyGk9oMhA-U7nwWVu55mHA&oe=69FDF973"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g0KYNIoedYQ7kNvwGROx_b&_nc_oc=AdrEmsYQdwMnew-TGJl0soyueYe0l8JGyFjF6rEf29tihxXo9AHDYuhk-HWQyG0HJcg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71IC8gv3Y2LtV1Ftfd1VjhN7pJFBH7yzBAA0tARhfBGA&oe=69FDD857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ5fN8D9KEwQ7kNvwGX1PuZ&_nc_oc=AdoBPeKq7XPIVZRRak8_CG_4OhbDffPbT2Een6qCNEgr7BcJz-NU-L22SDBXhGKb_5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vpKgmq-bdJh3F-HrgN3HNGQvK5b_JPEt9N400g0HeZg&oe=69FDD406"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
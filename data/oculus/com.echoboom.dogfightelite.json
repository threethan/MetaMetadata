2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri_aBCO4dcMQ7kNvwEoBqHK&_nc_oc=AdphH0RzMucIVR3vBAmNeHU0ux5N6ehzPPC0_B0meE6_qDEp7LCRs4WYsvbCZLhAYSs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2n4JlS6Om4fysjeIr2_VtGKbWKOPjWAET7BpdsaA_P5w&oe=69DE5573"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KQPIdiz-hEQ7kNvwFPChc_&_nc_oc=AdoFDcUalbRnIwbWB9xttSDo5oOGre7RUInJobKBP_-JQ9GEKda3NG-1Hap2LMVXkoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZGhEaZIn3ToeeimKQUynWIOGS1tsaEOGefHkJgkBbSg&oe=69DE3457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIZWYbllAKAQ7kNvwFU38nc&_nc_oc=AdqHHRWaRb5f5osLOp0cD-uOXlG3iydnGOXtJwus1V_uL71QUyz5xl3c6J4DB40_N1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bjwp9pkDIjXrk50mbU_Cts6XQ-qEzs_Ph-fxEhkhrxw&oe=69DE3006"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
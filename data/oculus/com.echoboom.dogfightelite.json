2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWJwrNLKAjsQ7kNvwGjDRv6&_nc_oc=AdquVppyYt-IaKgJXPxqbRFU-DCWiOiSNx5kgNM7OsP6kkI7zPbgRCPDAw2eLwj_ix8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK41oLZ3g7FCCWCydMwWrUU0qtPVsxH7MWHMdt7xBo3w&oe=6A677173"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL2OMFP0qasQ7kNvwG4i8wH&_nc_oc=Ado3OKKx38Lt7HgwA02cGFNazROVqhb-BQdrH79zdafeASG8H8ObBj2hFyQQS9QX5N0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDanaLcqyXqvUgmAuuHogYp1Fw9mWicDcsSQiflS75LnA&oe=6A675057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfBh5ZRF0joQ7kNvwFbeo7O&_nc_oc=Adq44WmedQc3PIVdtRTmn-HqgeckHfW5tLz5fARm9RqFSm-T33xG9-UJ1Rl4Tnlry34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB23NYjvH6jMiLIhVzHzW6IwM6VbtT4YK3KtOVJixT1Og&oe=6A674C06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
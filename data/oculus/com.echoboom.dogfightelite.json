100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bQyl3kvLNsQ7kNvwGvlZL6&_nc_oc=AdqbwYwrG0_c7zwuQbFgfl64JSF0g1SE_LoyUosrZlURJnHc4ogNAH-qvQ2qo8K_c_M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I0gWuoMm71vrrg5NGDYktE0flS4oUS80M98JzNxJNPQ&oe=6A467BF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXyO6ZBQ5q0Q7kNvwHjZd5w&_nc_oc=AdpmWE3LaSCxsUUuHvrJAnaMqDqK354GiwAj24YXYGbVexuYvRBxBqen7RuNfhJdQt0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hjsnkN7feP1XdUinwLA4_D0swSEZna1TI00MoKp1JeA&oe=6A465AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgtXwf7d90QQ7kNvwH3i_tQ&_nc_oc=AdqL82qiMvd5w2ciaSCpEv8IPreq_jWRYSSMZ-0rywA61BzSo52Xh8kHLlsVLaUGVYc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sbg8kLDjrE10nUioUyY9vclXbc3D7ztwkPac5mZHSpw&oe=6A468EC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucyENcN_mTIQ7kNvwHm1Q4F&_nc_oc=AdoAzUflzIAfC97JA-nZr_POh6ECppYd7cxExxaweJwoB5iLj_jDR284gztL9ZnjQpc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOSrhEUCr01D_039kOX5SQ9WGlHPz1uIfVJhCH_UOyYg&oe=6A4FB673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUTp2_O2uuIQ7kNvwEOTBbj&_nc_oc=AdoMc1TwliTEbqmFQ0A8RaTR1ShLcOuEXyszY8ejnOsgUoDLyA94G-bV4BXktSsG90A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdprOkKntYR_Ow9NmNsYLS4XFFuxZSQStte4thcbgw0Q&oe=6A4F9557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4iLsAE_fxEQ7kNvwFmr0gv&_nc_oc=AdoQ_z6gjlceMGQUZ0m1EQS60R3kH55nZsLBhTDBje15YqmZP0d4RJX8q_IA6vOxLpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS4V4UKInkASWyCu-yiddYhQV4my7rGiQUcg7yGqt5Nw&oe=6A4F9106"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
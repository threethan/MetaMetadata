2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA8rQnH3QxUQ7kNvwGZpudj&_nc_oc=AdruCqSWZ27YhhmvNYeEKICX5VEnh9qXkqH8zRgHGfpivYiCmFP7uyqEwj-Nxt6DlZw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YyilAbTzE3h861PbhrnBFVCh3fwXXM7M83exBSf2bbA&oe=69DA28B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6mPnKXMzYEQ7kNvwETBjZ3&_nc_oc=Ado_pcJcNcffWIbDGvvCH985YYmjYairK9XWNcPLgpG0T6JoYeRDdWHtQlDVbrj-tFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E5UzTtCyaWUYMgoyT82GDzdfRBwc_4dGCiR6GNw-dTg&oe=69DA3FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arFap84M9a8Q7kNvwFiWAlm&_nc_oc=AdqVG2nS-VVb-TFwA_skdkLpsg2OuT6I3ddjsK24fd4alJDQ9VEM3IwC407yBMfe4h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24lqUxzlozHpd6mIEcz0NSnx3G4NtwyiWXvz4Z-qu_Fw&oe=69DA3B86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
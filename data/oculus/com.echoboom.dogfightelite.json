2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgfAVoxzDfUQ7kNvwHmvYL2&_nc_oc=AdoztFUYGKhv5JovBo2VTyI7dkWBbIYvan5ERVt7iXQcyucvCalUrQtNigOG_yf0x1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQX46kokH8ZqIz_bdcjCQpEMp8jYHavLkmxfp0321YyA&oe=6ABA7FF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIerLUOcpDMQ7kNvwF0lNvC&_nc_oc=AdqhvKUfM93EoQ9cLR9ihVacTJDtJgTYhr5Q1HVnt_ZlJjMtRUZDoDGNhlanY6YE888&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv6y9ioxh0mbGTGQlKqrHmJxb3Dr4vRNuKBsXsV7mB5g&oe=6ABA5ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyxB2P5ZBQsQ7kNvwHrkFWP&_nc_oc=AdqrM6cZKYm_rWc0-iFtHrUnp8KmV9KAVIxTzjJpk8WXLQaJqc8hIjsbU0BZ-pmt8V8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdqJ_x1MtH8V0iIG1FA1-dS92eWFE3u4cNnqkrMuVA0w&oe=6ABA5A86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GX2rxWELzQQ7kNvwG0llzo&_nc_oc=AdqzBDKJs-qNO7i4Ld1a0n5koSxlrRV1-mfiaVy0OCtZKf-0B-1WApHU-NcpC9QAy9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FzrFTl2RTs8nziRYbQv40yY7JxvPI98wlRFw-LIfIXA&oe=6A033F73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amArvd77nYAQ7kNvwGy8J0b&_nc_oc=AdrStXvZYWDIQrTKVMltjWExh8DQhI8gGhT_f6RPQlucO-0G7RLzrX39MqBubuc1Yyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65hewvg95HDVx9glNPIhk3kPGlsNTJcIxkZACnjECu_w&oe=6A031E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciMhmMOGSpgQ7kNvwE86Adn&_nc_oc=Adoqj5BYNmPeBpKsisld2LaodHWaBOBw8lOYoypjkKEj7qG3DO14LpxDjr65hA0Uvrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y7uw-LMMQ86razOSH79TCUmzpKUPaFzPSN91Lh1u12g&oe=6A031A06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
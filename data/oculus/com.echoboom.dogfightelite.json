2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSbSY34uN58Q7kNvwG_fR4l&_nc_oc=Adq0FJsZzx4t59EyTyjSowPUB-_reMlgEGOoHfHCbk_TN39_d0fuslquVBT32vPZK9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiLYhJQpCkE7dy5F50AN7qUBb1Ref5MiFmOtGkO5xtPg&oe=6AEDEA73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyya0EJlZukQ7kNvwFQWmIq&_nc_oc=AdqjQxl7jz2JqlhtnROjzMmbxiObYvkNASRRHvkBukLGgiR8NxevjYeM92bqDtb_GYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2_CunL_eNQApuHfGTLknJ9v3-ZWX29A2_UbJAvTSlNg&oe=6AEE0197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLfTC1hbHJAQ7kNvwGNT7oR&_nc_oc=AdoLCe8XwPteEQYXyiyLt-P25VOvIBRihPYrzgct9WlR3VOlgzeyeCyT4-1Ce0m-Uws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1gBQY-3QwgC4mL4CE3UFlqBAvBdcDz410V9hJpGbbfw&oe=6AEDFD46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
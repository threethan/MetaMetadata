2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GX2rxWELzQQ7kNvwGRRJTZ&_nc_oc=Adp9eXtLV02A08D4pCQrjY1pT3O1yjjl8I1ONd2C5HCFp-gXu-O9tklge1ao_5jZVLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_sxcxwpQq2bTy4Lxya-u01WHsglEWOU6-ING2tNBh0g&oe=6A01EDF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhMqEOxXAeYQ7kNvwGBF3Ph&_nc_oc=AdpCRWomdxQWn_IahJ0KRGICCXGY3MnMuBEqH61zZZx2vPbiOGtnrvrgKICKC0AdG28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KR1joE_tq6Wl944yD5rsg8zV4RuAmV3Dylr8Sb5FsDQ&oe=6A01CCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4kgDzIddKsQ7kNvwH17LRB&_nc_oc=AdpO-xoDlzJYXA1FN6QqZdhnEf2fWmgskmaOvxE5_IMOX86BdZUQf-wT132-QEc7Os4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mo6zPzeJvzVREIJhPkpKprFbSLjmHeZTH2zvoy-4pVA&oe=6A01C886"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
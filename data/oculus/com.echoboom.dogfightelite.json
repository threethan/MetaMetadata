2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvE1rAIO5TkQ7kNvwFCdbKr&_nc_oc=AdoIX9_5ZChy8DegJUU8K7NsbEno_8W9h0ZlN4SxbAwrjg0iiqWqO9b-791-0W8VVvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZnm1gzz0ty_cbLgusNIGO9uNYbfQUkFZ4kuJpJVVQsw&oe=69C26DB3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bEp_6fZc2YQ7kNvwFKrTZ6&_nc_oc=AdphSvW7jwqA5z8qiWb9LvYU8Ry77oxkhHOyfffx7oi9MRRY9HhP8U3OufxYisNLeEM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJH_109GSf2JW96791rPOcbs6tQ8JdOtIY7SLr_BaixA&oe=69C284D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUT2Nliv-gIQ7kNvwGNG1pt&_nc_oc=Ado_l_17NOHlafjXxk0Ptp6uUEGKWlRyQnNTvrSMYhKPvfRFiO4xJJ0P8p_jqClDnCQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjshDJCXDs__vOuHgSWS9-z4BPNgIBW92DYc0sMizYCA&oe=69C28086"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
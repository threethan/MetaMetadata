2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0GRIRihqNQQ7kNvwH9RcXA&_nc_oc=AdpgYQJAxdeMi7HCK-QY_gTDJMZirZY_EO5TQsKi05xO6-oOs3iDFsm332ghneOxdos&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvjX5_eKPa-nEXUaCTlzAuaerdo8GOKEn-VgJo6J0Tag&oe=6A622B73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esq2yBmgScQQ7kNvwGqvenl&_nc_oc=AdriZi1oX74sgO-0uRx_gZb03H-i0wq9k3fLH6FasZdvEtxJC9DrsYBTiCAj8tZ2d2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKMUOZShzMLNIARz_kAnLM9hVpqIbeVx1vOhSXIBDMiA&oe=6A620A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfhicjXePDcQ7kNvwEZZWpW&_nc_oc=AdoN1SfVR_OhqWnsn-28PC238K_oPcUf0aBfJ2Nf69a8NmxEps0aMTVpSF4-yIJ29lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVpFkiSSqRM1pr6YqtV6FiXDF5JejB9-oK6CMCBjC1EQ&oe=6A620606"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
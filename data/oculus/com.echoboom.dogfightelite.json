2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJhs5ncsTdcQ7kNvwEkatt0&_nc_oc=AdqZr1TJXQeOxcNfvK8Z8OVbkT97Ml0gutnskrVRUmFvnbV-drORXrAfg88_tKIy8g0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HT_YzUuWrrFRKWV2Vtgt8p_1ESVy9QUmJWI58AU8PtA&oe=69E4ECF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2S-bzvlcRgQ7kNvwFTnN2r&_nc_oc=AdroUSN_nQLZtzVv3ROc9ChvtjSqcvxnebkx8Z9XcCVrScOd4iFKBShay4SpuwsAT98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IRGoGLaM0hJdln-pBmjc_j9JoWV9nGXFwW3KFreCf6A&oe=69E4CBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp-DJzwazsoQ7kNvwGIiLKG&_nc_oc=Adow_77PaWdC6avPtDE76p2GgwpHmXCsWiZoH8fgHnxviBi2x0-P7t8Gh37Oweqgf5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Lf_sTa5QxSOYwknYrGcTaSgIVr_m2HhBIWgAhPPwunQ&oe=69E4C786"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
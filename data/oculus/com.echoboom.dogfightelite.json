2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g0XVu13PVoQ7kNvwHD5bF9&_nc_oc=AdqWm6C8JaktqviHk3Izu4eqTj7utvJOdc6ZGBgIAAx8MUHX_8nGcJk7rUVRTYCKlgo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I8awkEknAF3jmxRn8PWIYuxk-9luwGRfUnpxiOs6Yxg&oe=6A131173"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlByN7RafuUQ7kNvwHzAu_1&_nc_oc=AdoNueox2hcUjhu6qxv9lBY0xklJ102NSm5MFpW0LbrVwFVAzbwkQaZiAO19fyEJPF4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AlpDfWmyrFjR1y_bt5hCzIjNAL9ynTe4iIAz920QFPg&oe=6A12F057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbwBXamDBZ8Q7kNvwEPr1Xr&_nc_oc=AdrUhw3Z1OgQI6urQPvkFr-Aw3ob77mIFKP_r54M7XHrtVcT8hH69WcSbXtYYbX7Pv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_RyKP0xTX2GRxu9aa015_MiY6UUPdz3YMM_rLvuu2ZA&oe=6A132446"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWJwrNLKAjsQ7kNvwG7iuXd&_nc_oc=AdphCLGkX6EgO0SpBvlyTv-O61ueVgoLb74SafWDmVUbRC5HVg20QLSNponYdVcqSGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCERZ0yXVZPzs4kBdNfN6OvM1qRUZiEaseOwa47c5KCVg&oe=6A6B65F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5Y3yin8taMQ7kNvwGwWajE&_nc_oc=Adq7JNsqTJf8rICCqNVUSe0Yklnvg3Qwh4021MGnMFJZtMEFrRlvCPJCIuJvZKsZFxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlsPbYrhtReN4x4eC_rJOJv7AuJpEfMVL8chmTVo5plA&oe=6A6B44D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPdonoEBls8Q7kNvwGeAMih&_nc_oc=AdoTtCzptS2ty1aSAMxqeetrpABb7mMxVnmKY5_AHiut8B0V-ujo5o-BlwiJjWiw_UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8dPTHJFSvPl8JYoPDktqYnfdBjLx8sCW4uO7kJKdN7w&oe=6A6B4086"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
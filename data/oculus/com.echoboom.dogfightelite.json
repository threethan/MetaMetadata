2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjTBH2ECd68Q7kNvwGMF7xc&_nc_oc=AdokdOz8gxsAfPOtbP5FrY5r89vwVVNIsElWAaQ5RbKnUY3UHihRd7u1yQSVEWC8COo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zJ2m3u-EA3qk8rmDvXagOcOWi98Wwn_Lvt7f6FbsvAw&oe=69D277F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC0L1QLjlZ8Q7kNvwG7CVKU&_nc_oc=AdpO4wpTljfTdiJCqXCM_mAdJP7x4QBHR8wFgGzfp8LkaCm3aJtQu7S6_SvXyRHjbq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D6-VD9xqlbHmJiLrNCXcJuOADfzMFHnT4fJiAv4KS_Q&oe=69D256D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6OLCANVlYkQ7kNvwESvmFF&_nc_oc=Adp9beENtGDJrUS1Cn0JijnHmtL1sLmFAurO8toxfK20MCvyf7sB8W-QzxEk7sSgzlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gqetGUXbM8pMJkZuspcCPkMNV8jHc_10nVtxm3-SelA&oe=69D25286"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
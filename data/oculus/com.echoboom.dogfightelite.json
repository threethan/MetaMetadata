2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqRLrr2s1PMQ7kNvwHKDw0I&_nc_oc=AdrntDMKffxnUcKQMxNm9ChqRIdsJusXQNmEPW5Lvc9rxiMLAE8XIfs7A_G29t7Iv1I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eULKLJiDy1FJbijAkJkumNxrW7-71U_nA5SIA50vOXg&oe=6A3FE473"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZip3KwDKCYQ7kNvwEfMTrk&_nc_oc=AdrzOcdRkHCc5UJTIPcxKVMqZczMBdAotGMOOYg1vPlKW2_E0YvmXK9DbkMiUt1nuQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kvQlLw9LPZCJSaoM-kVy2-3n1EMeR-UwuhB-B-4ZBtw&oe=6A3FC357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOIp3bXMoNQQ7kNvwEX_-BW&_nc_oc=AdpM43-WaTLqFrwrzm1aJnQ90tfgAHz7lA7RnrOqAoM2QiQwJsyVMgrKlTdwqbg4mRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zeSrwjzkQ8UWBwfTFqNuY6mj-1p7O001-YDzh1LmSrg&oe=6A3FBF06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXh__x4KrAQ7kNvwFAqBCm&_nc_oc=AdpFME99PVExNyFZAUI1GIfILYU1pgjZMo_B4YN4ea76zcS1sfrAoQ1SexSXdv48dCc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zs9SWTn7gjFx6OxBVd3QNH2hO0GQNx01rwaCtRiOEag&oe=6A1462F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlByN7RafuUQ7kNvwFEkcyK&_nc_oc=AdrkufgN51dwIzdyL6Vs0J02xkU7E57wEinp6_9-K6QL8TVKuKy6XqFp1HqJCb6YbUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tdHS-hdXBd7jD6cw0C6RDJMZa4zhW23rY4SWqXCfczA&oe=6A147A17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbwBXamDBZ8Q7kNvwEs_L59&_nc_oc=Ado_kxyAFMSBFS7ijdVkq7tWMhXuo5jjTsT7xWJfM5yZ3OPxvrxyivWOFan6w6wpNZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nbf-2DZg3aSKPuA5Pe2SAq7FaZvjge6BJK9d8_y4ITg&oe=6A1475C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
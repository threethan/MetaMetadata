2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSbSY34uN58Q7kNvwFqDxAy&_nc_oc=AdrvErBea5EVSD2VC9hEWSH4eX5Eig6B_uRWpOQOQZpxqCIGIyMyG-IFJZMK3RC3eUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjQJZkmtZKFEG_6U4DxwF9h_GNsBK6S2zJisPS7Oo2MA&oe=6AEF3BF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyya0EJlZukQ7kNvwEl5VAK&_nc_oc=AdonSSnANw_eshwJ-kLOd6HeFAPpO5YRzqaJtzCYzBpnhzwXUkrnqQh2FaeNH178v1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJV_F3HM1Xhds-94O0EmwO11xJS_84m2B2z1x2dNnsUQ&oe=6AEF5317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLfTC1hbHJAQ7kNvwHraDM_&_nc_oc=AdpKolacjfnIyIeKVThnI1EO8BKIgGFj2t6tpVDARdPKTOFjzdqBt8djokpLKzpJylQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4HwUutoM7ITRLkHcmus_66q_RyEsFldEcKRC2kI7-vg&oe=6AEF4EC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
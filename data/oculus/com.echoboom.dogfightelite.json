2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8f8vJ12xWQQ7kNvwHgMGLZ&_nc_oc=Adr0pJDilyeALlg3FAJIFn_XFOo30e1ckQFlvSK0Zjyj_6MQ0Q08eJ45NWptNem5vpA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE09XOwKg5Y53xRU7bp0TYzauEfv-fQ1GuNd1UKxgJhsQ&oe=6A8AD1B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Yxdso-1ZQQ7kNvwEmpnNO&_nc_oc=AdolMGPIJCi8N2fMXCds5Ivv85K4g_dBNzrslZS6auDZR95TQslCah9ev-rEg6IbPcU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvgKnNtN59fdGtGyz-T0unIm1yEt3yqNmOiYMrYXoUbA&oe=6A8AE8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx-2EMgFoIoQ7kNvwHcvsKJ&_nc_oc=AdpdFDUn4-qGroB-qrZ9ltYPhvXFUFoW6piSO8cSc5Vb7YzPKU5zEOWkx4e3t2qRZ1M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA0xggoHN0hAgTN5TnF89epDAFNWO1xrU0afljfUceNA&oe=6A8AE486"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOv0WnXxg7QQ7kNvwHEGp4-&_nc_oc=AdrGFXC2NBk2fTUY3HySSbt4dAImxIAOfR-hO1WXMs_lhP7XGuMfXWiaECsIOyJHq5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r16RR875rOCmU1GrgTUG1FKsJsxBrav_iP-d9SvaLiA&oe=6A2ACC73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZejAOC0H3QQ7kNvwGQ4GoN&_nc_oc=Adqg7GGvGMHOUwYqdT0UfBWmdtBTMW5t_qmvbot2S0y6FwcZpt-DQzo_aDJqYs9W-T0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gybj3UF_cZ_PMGon-NVrY3uQlz2UIF1rrIJyiyhyJpQ&oe=6A2AE397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YM0RoC6dzgkQ7kNvwGm96Ut&_nc_oc=Adq3eZkoy117Dc2o3pY5-EIn-HxV5z3jEBkEWq9DEl0SysrQWD0eKKSofvfHaHgoXME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H5YcQSM0zNVB9iKFdJpLlULQQ4Qd9MV9w4LNBIl1jZQ&oe=6A2ADF46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvE1rAIO5TkQ7kNvwFMRfjr&_nc_oc=Adpf6puw-6jsCliApT0dQKcWp61zVZQ5R2RQYmQvQxf4PIisypo0cK8eHCrrY6RSYmc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqKNAMO7s3KtIBDQThpFquxV7Mm8S4R4J5hjws1Zrd-w&oe=69C3BF33"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mehLOH2DncQ7kNvwHUoQKQ&_nc_oc=AdqRY7pHfgHK6sToYer26wXy7oRBU2gje5Au18TOweJazTfSa7HuUj3EIZxu1xCODfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1spAezylXXMXemJ6ZO88vaP9PuvumMsMbidzet5FHMg&oe=69C3D657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFZs8-3pRyYQ7kNvwE0NVNf&_nc_oc=AdrIW306-ye8pEQuIhCCozDxjlJ9W1rLxh4ryLVRN_DyY7IladQm2NL4mbm_qve9-aU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy68ZTroGcr1oOSJ_0i3eTydPbSROgROB_hJfb0o4tuNA&oe=69C3D206"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
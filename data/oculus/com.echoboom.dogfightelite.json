2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJwHas0XeD4Q7kNvwEuvCMn&_nc_oc=AdpcfN-55-sphG4Le-0qL4Om6qCPfsPm-4UHYsQ22aks5dJx-SPIGwOeVTIK4UPsRKE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdCA7UDsIA-oVkaRSx1CTMZNK77Lpwi8iNoBku0mYxQQ&oe=69CFD4F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC0L1QLjlZ8Q7kNvwE6Orzo&_nc_oc=AdpLcv8Jzr8UzixztUWJB2w2gguiOXHW_M9V_rw0phg1ELrakirDbXSvKua8J6oyZcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW-FHl9zctfkw-vKotcC0zlC7q9ygsXDV86VU_MFOQwQ&oe=69CFB3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6OLCANVlYkQ7kNvwFPbWtv&_nc_oc=AdoF6wsnuUNM_OWLAgGtoC8zuFMUZ6-uLVDCIQe6UYFQXi_yQ99yCbNgonAw9SATYDg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoIAm-bXZ1HmG8M8sc-cH6pdaeiNkVNdoDdGGrcW5dOw&oe=69CFAF86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
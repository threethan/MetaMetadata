2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T5bkjoU3QsQ7kNvwF3KZbp&_nc_oc=Adr5rQrCYFoUhmKocgwmxoldj9KiK_xppN290CAvvaxnNoz31HvzswoHvuqBYo-t2Co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfziAy5rIi4Tlb9UAQPe67strbR45B1cf1w6tQ4Rra-rXQ&oe=69CA56B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTBDu5EUKKkQ7kNvwGqdCvG&_nc_oc=AdpZ9q9MMn0JWNpSuu5Kv0xcubJr-n7fF_oyq8XTnKaftpvwJDuQ81eKZ3rnCS0NRLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_sqm11-Jhe_spCvStehSRIB-ukllla6Rs6-tscvDGeg&oe=69CA6DD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lz3k4Z1UEQ7kNvwHGAP6J&_nc_oc=Adr3gtbSyXESU9OrmpHecBfd9_7SiXncRXPY21CXeFTvaPpK6smtV8qghuCHqxhMcNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh1qNauGCOi-Aam6EI4BdrARw8lqyIzK_bUXu5enfN3g&oe=69CA6986"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERUJc5s1Mk8Q7kNvwF0hQnw&_nc_oc=AdpI25j2CtOfwRUWOJBMJK4VabCj6uIVdWvlPp_sUpAbIji0bMKEA_AjyCsFIqPJcZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYW6OonLw4yNrx14HdfZbymLhr6__QYPAyC93TPzjEFQ&oe=6AA2C4F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LtqqEHmupkQ7kNvwGdgD5m&_nc_oc=Adolbyyl_w6_TwKE1vBM6xhbWT54IW5tId9n8lswL4NrPIKPd5luRiqHp1BmllC8I3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVkbbBkjJ705--OF1s2DU0Dz8P0d7CZc73b1afgeK5mg&oe=6AA2A3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4JdXIhLOsYQ7kNvwFv7z1h&_nc_oc=AdoJ6hs7zdSD8vBkehZyDPFsKUqRbEX9eUy3gEY9jXl--sdLMn3fxi2th22IacZlzng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ6OHjbhBAuzQSoz7_5OQ3ybHMolptkTLur1mF-lTDFw&oe=6AA29F86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkKrayoW_PMQ7kNvwHBWfER&_nc_oc=AdqWq9e6kNZZ4o6Sty_449swAMvTcZYHgmTfMfmM51HGJ3xzIgRcpcTLBJrIJXpfwK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dq5nX_wfF9ELH6U-CdzAFuHjkbiyST0-3oB_-_LZiLA&oe=6A3BEFF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TYp55e3ALkQ7kNvwFwKPOy&_nc_oc=AdpHlIJRjSQV8DO8p4UudNTt1XXYNq0dSpEBNuJuuAQWFxHKKfLj6TvX-yOHQSEsSMk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R2fQ1iQloBikA-l6ChBd8HDIYCcx3nNIzBb7B1RBM1Q&oe=6A3BCED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMC-Ez-K8x4Q7kNvwGQNxPm&_nc_oc=AdpokQDb_nUero5328zb5u-jV4iO2Nb80MHXtyWBS9qMc8wyoQFy0a8wRDGcg2JfBC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95iX7DKj69aXNp7agC_iq8bwHeH74LtiQQJDuyY7ThCA&oe=6A3C02C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
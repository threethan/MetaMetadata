2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwFN0DVBet0Q7kNvwFcOaHw&_nc_oc=Adq_gTmC9XePUebG4-dyyA6_R10fqO27RyUCjTXPfHsB6PjZ9afJ9Z-veFCx01_dsZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcUNL9aHHFHvcHRuwYXQOiYjL04LRDsf2hQes9LGRYFg&oe=6AB3E873"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnt7X23Iw-wQ7kNvwF3uGTi&_nc_oc=Adofzv9y_-f8O7A1VWVj2I6I080hV_a8nnjEhHrfcqGD6B9wTApvSucACTfxl0WWYjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoiWCEMDPGFh-E028XY7cJpSiEJcfMVBEQF4TEvfdvQA&oe=6AB3C757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMB9VllUFDMQ7kNvwHUgg6S&_nc_oc=AdphHHpyKnPSTB0fSQLABzsAPdrwlhl1TDthIW1QBuUEupdJeZosY92bkkz-eMydAj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlAsAAq35ahzZ8oFfZXUWnRBdbS51ecnivgrqRnKqu_g&oe=6AB3C306"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
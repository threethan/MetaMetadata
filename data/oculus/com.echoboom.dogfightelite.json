2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHuJdL_UGR8Q7kNvwFRhkGM&_nc_oc=AdrTCjKfCmOkGo64Yt4VZnAXSdfgBg7hopQEdNYHR6SuZM3eJYHa9lg6nt2Z_uT-zDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJlPKtQm3TEvCU9Xve2cMDx7xew62jyybnDjsSR2_IrA&oe=6AB7DCF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIzsbiBy7eoQ7kNvwHrdBX7&_nc_oc=AdpDHN8Bx9ZTCXm3pTntAHD8adwAvB8xlq0RUsw9he0YZeDRPeoINWLW7yypHa2_ZUY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdLQVB7lhyGw_cM6QZJcao0H3_VXnqJswUys-yMGDUjw&oe=6AB7BBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6NqB6ZEag0Q7kNvwGzPjcK&_nc_oc=AdqqfMAUuV4uuEYaWF-rqJOQLU3oX8QtZVtNjm28K_ql1z59E951pbRZZ4_EfOIGw_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUWKtbC-pPf4YjjAdU8DdM-9N7nbKcM6skbd2msS3ryQ&oe=6AB7B786"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
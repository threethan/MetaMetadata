2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMRs-sa1O0Q7kNvwHVQOHQ&_nc_oc=AdpK47rzhnmwQd3u2wP_qrZFGkw88-zprOHLLKKQjjGTHZ2AztCkha1BT1FZqR1xOp8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x6RsLo2tASgraTUoXIuIb6fr72J7P7VbMq9LKHfulQw&oe=6A355873"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHP3v2O1ucgQ7kNvwEfbIlC&_nc_oc=AdrHmS-1ziQJlnsyipARlmqBe_otiJ1ycpAiRAdaNplTG68LrHom6m5JEwLcOhX4jQo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0RMEux_nsYauLDmHsHWE9jNb0_yBs8m6PTgb9bSsACA&oe=6A356F97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyHN7WoOgAQ7kNvwEtEIdc&_nc_oc=Adq-ilZDe9qxMXoHBw1udpLd9ivTvlvmuotu2YzJgKqPio145d_k8Sb4Jy_kEY7vwtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WGAUXRz6INED2kZ7mNa2TLqS9fHFMOsYYHQnpQIS4WQ&oe=6A356B46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
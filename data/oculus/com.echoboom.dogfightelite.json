2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI5MIrgnI6EQ7kNvwEqRosN&_nc_oc=Adp7HLB-KT0fLuwnTRnOAqNBTfY7zL6A95WBlF0DWyJ_DeAjz9rERAVImIz6NLrlvtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nEVyGNPVMNYR-5zMeZUfMMvovyNxVXo88hP_YLsg5qQ&oe=69FCA7F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g0KYNIoedYQ7kNvwFV9eC6&_nc_oc=AdrxVexT8tzEUc_eLbbV89qmJp2FPjyt-vmGgsSfON7V3ITmMspBI7mP_8II7QoQT44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Omp8BWa0Mnisw9ILAxu5vzO-ixiCkVuuLbYRRwZ2bjQ&oe=69FC86D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ5fN8D9KEwQ7kNvwEBcnLM&_nc_oc=AdrbmKWf6ymzsqq10Cce6ViNcnqJ93Lw6u9v4K9-EQM-sqQ7ySCvlSsvlKbEmT3Mxis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BnUdjVD9nfKXhzP682bbc3WROkgQ1DD9EJ-IcCDauEg&oe=69FC8286"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
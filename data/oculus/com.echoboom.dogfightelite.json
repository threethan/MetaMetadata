4560_472321100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fny7W2W7M3IQ7kNvwGc4wlY&_nc_oc=AdrB4l0oIm9FhOdXVid0WBLOOJ9ivYXGm2B7m_bYoJ1T7tUZWYQF9AlMMSdDw5M52Ic&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_D2sZEC6aF7bYeJsAqY9F8oYKwQW_1gntsrB7gkeMpg&oe=6A8EC633"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUpa9Y7zBrAQ7kNvwF37fRT&_nc_oc=AdqfOtI23Zgv06-8ILWIfFhcfAzu6adOp9JYcWh0mVQ3i5cxzXMVG9MHDMCwi2TDjPQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFFrOju0hdQ9d5yURg9J19Z90fYhrRljtEIZqGjN1eQ&oe=6A8EDD57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTP4AD7aUqQQ7kNvwGa5Xya&_nc_oc=AdpORuy1LbwZ3IpBo-BA2zcc4DYsIMrMksQhZAC2LQKqceQnblyIsQprsHieK8vVFYE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmQj9XKeQwRytWzfy_utzdXGnd9ubl__HyhqzDL6CY1w&oe=6A8ED906"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "Joaquin Grech", "developer_privacy_policy_url": "https://www.dogfightelite.com/index.php/forum/4-announcements/1058-privacy-policy-and-terms-of-use", "developer_terms_of_service_url": "https://www.dogfightelite.com/index.php/forum/4-announcements/1058-privacy-policy-and-terms-of-use", "publisher_name": "Joaquin grech", "support_website_url": null, "website_url": "https://www.dogfightelite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "pt", "en", "pt_BR", "it", "fr", "es", "zh_TW", "ja", "zh_CN", "nl"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "942353629979707"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "2997853187152412"}, {"status": "PUBLISHED", "id": "722531825428163"}, {"status": "PUBLISHED", "id": "3081813985407251"}, {"status": "PUBLISHED", "id": "2472800792922118"}, {"status": "PUBLISHED", "id": "3080095578951979"}]}, "baseline_offer": {"id": "3080095578951979"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1635287100, "status": "PUBLISHED", "id": "2997853187152412"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26542274518728278", "version": "1.4.28"}, "id": "468002237813387", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBina
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N3NA7RUc9AQ7kNvwEe6mBt&_nc_oc=AdoFkEHmJdlnUdHNN0mMXazbLvF5ACRNhNIyzXqjWn94SXVXsMi9wWL93tRrxGQSf4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWex8lMWFgyRLa_jA4KPMJUixdRCDFtDsJQzFvELHyYg&oe=6AF87673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6f8K_KAFw4Q7kNvwFHMFNz&_nc_oc=Adpsu1fHC3b-R_nrYc5LhoeiAnVQ0PUc038X-LPM-LzBgMZawyhN_sQXY8MzlrWhdKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS44ueGFQQPu7VeY3eRyySpQpb-ROYwf8owTArSQ2XWIw&oe=6AF88D97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-1XP9LMVUkQ7kNvwFlWHml&_nc_oc=AdpeE5rdwddX76WBJBWICgqMUwI1gAUx0savGOcJ-M46DVGLxmkTWQ4aYvygK0ZQ650&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY9IaZitj0Exu1vv9qFX9kmb8YLiLKkZ2RBuqZG5U0xw&oe=6AF88946"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2GsvuZ5eqUQ7kNvwHz2729&_nc_oc=AdruIeYIuoNhd5ZGe_bQHyLms_V1R3kOUAXUEIPQbGVuSMbxLBavXx7lE7HSqS3GdlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwiuB6tcBlhZNfTIEzMDumDwfG3M9mv9MMGdKkFly46w&oe=6AE4AFF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ps05FK3bbU8Q7kNvwFJIBir&_nc_oc=AdrjlzYySgvC4wD8z66OEdSiN7E1476cDxXlYWvPWfe1-VGWU8f__lLLkP--t98YlNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9e29mB0dkq8upU79ZXNvjAnUnN_4vjDEcldJw6y28tA&oe=6AE48ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q75ub5v8bWYQ7kNvwFkvV4X&_nc_oc=Adpu_odsE0PVs7dNjJCUal2PgXbEcOKjlWH-PUHusgI7VMIvzn0QLhkXIYdbuko2x9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDAB21ajeWGdHVKJQToWpvQaFPHkQV2XqPIuho_l3kRw&oe=6AE48A86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
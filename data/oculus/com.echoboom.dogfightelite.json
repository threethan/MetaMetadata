2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7FR1SJe2nwQ7kNvwFSL5sL&_nc_oc=AdpWYgi1qcFkTDsG-BrXbVcCFgLADq7qYlRl49o2R5ASRdMWU1LMUWL5q2JbEaxGiY8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C2zzDADWtCyFEFXJb78sfdR2d2E1jHR-JFtf3StH9BA&oe=6A301273"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX5vS9e0_uwQ7kNvwH38WR4&_nc_oc=AdpFC3rIA255--vzbbvdx4wF8VUX7lnofWuGU-n8V6gtzQxkL7EZUL8wZ_Ejcynx3eE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Jp7Mx9Z9WU_4AODG6lV4tk-_EQ2UasSHj3fttKjajg&oe=6A2FF157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_0wM7UiMqQQ7kNvwGSFvoh&_nc_oc=AdrSvwf5dmyJKqDJDWttYK2PiM5qTsRTJ7Gj8QW6m2WBNTnUf_Zv7A4o7AaXoIUDtDs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Jv97draKzEGvCBkNlnuYpVIqbxdc1nxa2qHWzffJ4sA&oe=6A302546"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
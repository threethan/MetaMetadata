2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2KEIJp3lU4Q7kNvwHSVzUc&_nc_oc=AdriZqRSVrD5P4C30raTc8ONSt2y5zy3ToMHWrmgxPxt-TLzcpdGwrB8NVNSz-BN-vc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxQYcaeATPIsu6vnj5Ju9VzewJ7sKxdvev13SsDjHuXw&oe=6A774373"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrWfnSTzRYQQ7kNvwHGf4Mf&_nc_oc=Adq9wKDVipiGciW1igih9sncDY5m_89fHLw93MubssAHAhuQICLNESgLVrFgB9SEYRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWKxURw3RzX9H_vc2q5rw81RLB1iTchcLxI81Pqg8rbw&oe=6A772257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7P65BYdzAwQ7kNvwEDwwkf&_nc_oc=AdpnyT7hzC7KuYgJ2sXzpB3H40SUbmzct-7ujHde2cOLqIN-MWzLq6iK7m3g6y6j4_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6tW72H6yjW__nZkU0nCAf44xgToDB11KmNsVPcOloAg&oe=6A771E06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p56SFZDOA8EQ7kNvwH8WlGX&_nc_oc=AdoS7tn7J_pXDs5NKR3J01jj9ji7N7NXio3SW-jEwmAZORO2f1EP5wDXB-mIMhw_TSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41XrbtFSN5ca9rZYnaZ6AG1P9CaI2rtA9NDvZ2srrOGA&oe=69FA04F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aChveK6f3lMQ7kNvwH-8xim&_nc_oc=Adq2wBBsOreZCCMHdcJpK974GqPzi-aRwkAjccYqygoruB9NLVNFBSuhQo_uyfWVJC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7auXskenEHebbDzN-D2iX32q84YyLxMMoMYS-_3m5IWA&oe=69F9E3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklZCl52L7IQ7kNvwHaFwtA&_nc_oc=AdozZFkiqB38fBCQM36-DSVXjLE9xWyLil2w-_7p2X8jTbY8PHFI-eXQ7AHBuVlPIyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79yGeRkesttxURS4fAGVoltbXf1NcLCQlXIguMe7j81w&oe=69F9DF86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
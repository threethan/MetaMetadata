2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOv0WnXxg7QQ7kNvwEYlOb2&_nc_oc=AdoF3camwrUyhW6lRYD72Ae9mL3dWqdghJ7Ls4fSu6eMbVLbhcgKCrM4rc1wNe6kVcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tHlCvtX3OrnXUC4SXy9Mbyq7PRBj6MAzNVNNAAb23aw&oe=6A297AF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeoEWidoz4Q7kNvwFWCrZZ&_nc_oc=AdrOGDKn6vv_ubw17xZSRPn3Jc0_q-rt5s5oj80qsu0WgTxND-yU-ndp_aR-C1PuN9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tIiM8ChG6QelwoiSysJA42on7GEbYhpzkmvGPRv-_hg&oe=6A2959D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rAtTrXtmQwQ7kNvwG7Nuz9&_nc_oc=Adpsk9rqJCzVhDpJNtv2efURLSqeic-DVAgi0yB_v-e_0LNgF9ZPLvl2mTv9KDLq91o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l55tuYAf7gTb8cRAMr8gkovYWZw159mbCrlFkuugEcg&oe=6A295586"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
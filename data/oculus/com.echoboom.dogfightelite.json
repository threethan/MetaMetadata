2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jH8ZLdbABkQ7kNvwGMIi7i&_nc_oc=Adq0D-snH4ERO2IWUNNS_BnPpOFefsC217R6PWpXs8C-iTdINCq-Gpzb9ko1eNrdhIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrKgfKcJR6FpD0SYtvXHgNDfCWTPXbftgLt4A2lUnpiQ&oe=6A7B37F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzD7MkN8b2gQ7kNvwGKuEck&_nc_oc=Adqu1HL7u0ScCn8LSI_HnSv7jesdy97A_CQUZ8prALrNkOdgR0j79AMeadKSbsi1r2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKmOFyqxhr_CnOvR3s22yrgGxrK2RNUf7od1mQttbn5Q&oe=6A7B16D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NII_bjCB0JsQ7kNvwHirRMm&_nc_oc=AdrJWG7dlygmWFupLIXQUP2kvo5ddyTQQ9_XNxOk04M5uxfhI-NBJGJqL59O9fkzEQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7WILBz6Y2R0M9OCn8374ceiIHRDX9HHn8qQYz3TBprQ&oe=6A7B1286"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7WMikk4ewoQ7kNvwFVzYQp&_nc_oc=AdojlQxtI3J6AQ9C5q5c_hmF_8cg_ukVofaaegskL2lxwBH_3L0daeutfhiL0kNGAko&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB0kDOFRwEVebgEBMdbVvBHWczzVxUCxnuLo5AUDyqmg&oe=6A971FB3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfWcluRSRbkQ7kNvwGgX8-x&_nc_oc=AdowdhoePAGGW-55Uz5NohEjfeOc31XZSNZhUjHv-B_jqS0E-E3eHSfiuL1RoBB_DsM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaJqKfWEFIyXJ0-xHeHw2AzYfy7j3Vjkfr7vCOLKJJcg&oe=6A9736D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Yc4J0aGJLoQ7kNvwENkBUT&_nc_oc=AdpjMCZTca-_hsJ5hbVXP8SJFHKI9eaYtA2clPlpQQPSIX4HTMSbgnboqLybsF-OmDQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAQWuBBDhvi3WRp7DCC0aUXql8RIRmvyd0XaK9K7mTxw&oe=6A973286"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
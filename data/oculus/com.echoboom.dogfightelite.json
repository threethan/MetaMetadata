100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERUJc5s1Mk8Q7kNvwG0T-lQ&_nc_oc=AdohNplU07eVGooyrHpCxF6RsrYKRNCkZEDr5GYvt3cjdfybFcKqvGj4FKGmOTSWZpo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm5YTqhWydxPrbEyBj81FFwEXyBO_6VQ6yc7wcE7Z4DQ&oe=6AA41673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LtqqEHmupkQ7kNvwG2ZlLt&_nc_oc=Adoi7QtHkekgdLjalJt6BJE8d7e-qKcw5q9u2HABLZSr70dSlDmq2_DduRvg1ZlmlwE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLif3Q73Y9h1yo9BdSi65_6EEFUwBRafi9Va1C2a0o6OA&oe=6AA3F557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4JdXIhLOsYQ7kNvwEmGeno&_nc_oc=Adqd-nkku5LCoRq6L6zlvl-AR4zgrLqn9OPRxx3leDbxV6v18feRKgOSeJLX83zFUQc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9yXcG4oW7O0GwaU8FfZXTZg7tik4Wo1KxoOep7LGrBA&oe=6AA3F106"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
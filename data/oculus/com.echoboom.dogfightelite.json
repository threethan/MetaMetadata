2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLI7nmgGNqcQ7kNvwFemkkp&_nc_oc=Adpyiu359x8ZNWatjx5chmS1bfT6xdhaXFAsLs6YKUHOKNKak7iSRWxla0Pxr5b90No&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgOReUMLUbN0y7v7_cyhwsWzdVRdN62WznWpO3l89vgw&oe=6AE0BB73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h47RYLL_JPMQ7kNvwGWREvx&_nc_oc=Adpt-WcA8rs2K4g4KRwlkMuKTzTx6y6J58n16hEY8cqV0_aS5mhioVgjxCAEJOjX6nQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJh32jircGrIoDfszCQ2eGmYd9ZLfd8wMpfHWpnehPzQ&oe=6AE09A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfEg3_PsJzMQ7kNvwEG55qk&_nc_oc=AdqD-iJIDVYNHGD7rEHf0egH7zBkBkX1MxhYhRyMfGfBCBmUWG6FNkF4hTeiba8ZHXM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSlHvFAiwia9T3cRX8nc7cuMmOOR0D4_bRPoTvjNL4Uw&oe=6AE0CE46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
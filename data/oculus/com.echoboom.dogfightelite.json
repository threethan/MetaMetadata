2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMuxSBNyVWQQ7kNvwH7Ckma&_nc_oc=Adq3H-LTcyJOqI8JfGGxd2Bd99_v-oCIIbY32k5IEWcZfa0Ia3VEgnzq7afypPZeT94&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OqPI2Y17EyYK-eDHSXZeyYIaxRXqSyrUXypcB4nBczg&oe=69F36D73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0Z5c11qWNgQ7kNvwFTH4s7&_nc_oc=AdrBoKrLCpkUzAFcewnJwRH_-dw6d_ebO3T_NJGjqCgM7auSjFRaQ6XCQe88IQL-KG8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mWuVBgJyQFqy-DhMY-AwvXUJDiDFlw0JOc2hs7hA44A&oe=69F34C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iPRQy4EMF58Q7kNvwGr_Een&_nc_oc=AdqGbbz4xR4TtjdUKEyotakMuOsQkZ6RqYOS2DucF3jbkGFVJFKXO-Bu6TwBaOUERWA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1tBV6rHv8Qn4aTZKZTxgxfONsXKPN5A8KByqCXsVWfLg&oe=69F34806"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
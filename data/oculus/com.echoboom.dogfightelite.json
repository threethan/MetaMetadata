2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GX2rxWELzQQ7kNvwF6Og1C&_nc_oc=AdosfA3LStEF5JjwWAL7XTPWYmoenSfmWxr4PjyNfKJrzbOd91d6Z-Ns8Dfd-L5qU98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zwKYeGhQaNUcCRo0A9xTM-cw9UIc0ujGgtm_WEj1-zQ&oe=6A0490F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amArvd77nYAQ7kNvwFKIHNM&_nc_oc=Adq1k3-qu6Ds6YjPmg7TzVhteT7TcKAdu_kZVqxw6Fd0zNX7f0M2gvYy-i1c99Ycj80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OYpDZJLRsfupDmh49KksOyMHdY62Dhs3Qg54XcdNCzQ&oe=6A046FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciMhmMOGSpgQ7kNvwGtBDTL&_nc_oc=AdonPG9pzBJYBzl1TdzdNiqNiLfyFcndbfx2RS-unV82b7A3XlcxlQmTjOGa5h8nyXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af645GJ3qABkK1iZGgxBVmZmvkDRCygnUxXcBsgB-8sM2w&oe=6A046B86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
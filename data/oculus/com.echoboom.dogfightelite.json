2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKUecwsfkHoQ7kNvwG8wPRg&_nc_oc=AdrNzBhsI97bTmbYbQF3pHVMH4ngFq7xPOVau9APotz6jhaSUyKQeTenHn7ROpZeJSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af364G-fFF_n4lVfDG2kIq3n-EJDs8xT0MZxJZyuczwdkw&oe=69D90F73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6mPnKXMzYEQ7kNvwE9LwGY&_nc_oc=AdoFlT8DEcT5lb7v-tMuJV3tHdS-OxVr2uuSYKVSL1OkCYeZok-BJNkY2EhVZDYSzGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v7Aafmp4qVR81ebjWhssmjwG-1LQ9cYNlcZ9gD3Hbng&oe=69D8EE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arFap84M9a8Q7kNvwEyyrT5&_nc_oc=Adp1jzngG1Wpyv1biHdxnBy6QaH50jbaCXUm25wStj5-9i3sN20MyWl8sB2kDFQNwok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O2HhZrLeLmA-mD-o8SGAfuTrCg2-Di7nhAfx1_GkNgg&oe=69D8EA06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKm7PCGAC1YQ7kNvwHyc9JK&_nc_oc=AdrmAs5DB1jmV2JSPEwWal7ZA34OBYJWcxjDUb7ogop0zHpXFZtUXxzTUapGSUgsMKU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9aEJTJVg00r-CRiPHxBzCXxgpvpO6smtzivT5yc9AvA&oe=6AA95C73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2dFG0c8-eoQ7kNvwGBv2CC&_nc_oc=AdrJls3NGYSKBlgR-o7lZGh8QXeRL_qUUogXVELA8wSay3XC8Mq28T4oWGIBo1GAWe4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjjufq5FoMrkH8sigJbOfxUwBu7V3NcbbOHEOHzT1kAw&oe=6AA93B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7em24ZExVAQ7kNvwH4yzxs&_nc_oc=Adqofqp1V-OqBtblTS2RstEsodZiPlLa6mlxqE4qrefWQNrfi90Md8WfKQSgeKDEap4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbnEpZBhLLXR-IBcTVzDMcvkk5Z36tVJ-MvQFOX8Q7qA&oe=6AA93706"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
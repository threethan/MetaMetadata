2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RInAxm4Ft5MQ7kNvwGA8Zx_&_nc_oc=AdrJUsOwPa0PuyJenuo9xsbeihHJp0P7opuwjCtMI8oMya2f8A7s8f3TkCyDW4nd0Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBThLCYjJFZfMdg3sEuzkuigD1-q2Hl07zA0G6hKpy1zw&oe=6A54FC73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oQFUWKZpHcQ7kNvwEiShqH&_nc_oc=Ado0XE6YYc_sK3Ec8o_xtUXOtUnVzRu5ZbvEowvAFhUsPOf0LZqr_vAY-howZ__n5C8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUxdHKqmT73SKIKOuOViu2Abbz-3lHabrK2bjnpCnj9w&oe=6A54DB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL5I0Ma5ZlAQ7kNvwEe2ksL&_nc_oc=AdrFEBFiAJwqQ_15hiuXg6k1bD6y8BRInNgShJL5ryeQgB4DoViNbWRvSIKcD8Pbay0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwgFWuwp0tktevN5FsuIxav2wQhnJlNRTa7XGks1mRGQ&oe=6A54D706"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
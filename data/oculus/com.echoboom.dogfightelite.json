2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKUecwsfkHoQ7kNvwEl2sp5&_nc_oc=AdpCTGBkyPW0FkZurCrSVLNSyMzKH1Mv8oKzmkvACjHmXcgCmJuBqOWgxs5SljjcLXY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qvCBaq6PzMCJyk2RqH7G1jX9S5SMQ8dOxx86przk2sQ&oe=69D7BDF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6mPnKXMzYEQ7kNvwGdxXnT&_nc_oc=Adp_g_qAzEGiuhFHSsUBsiXtEVdxarTQlRXwL6Ac1oHqp6XipHrNEmGE6MAWMEoPR8w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13xCdt21r6ImFyRoKSATw_IG7zSSbFJNn4hpvk8zXANA&oe=69D79CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arFap84M9a8Q7kNvwH5NdJj&_nc_oc=AdrNacXVFskt8Hq_2b_dBrUTswXCOv29dpLQnYNZIYikPvvY8eiQXdrBpapgKskwoiw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DE2y0IhkdCCuBS-JJAiDX7EHe2J-8tWjpnHkXzJ7UkA&oe=69D79886"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
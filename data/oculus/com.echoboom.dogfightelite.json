2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5T5bkjoU3QsQ7kNvwHhLHn8&_nc_oc=Ado6SInh12a167KgPX08A64St6QbFPbKrUeKio2KiQDRwmHVkm_dF9A6Ld_UtiFnhi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztOS641aT_DLAYMa8ow87b4dpCX_8YYbaMpfNBHOe4YQ&oe=69CD31F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9fKB3OdMk8Q7kNvwEgmChl&_nc_oc=AdpxfPhzou0Pypn_6eEEacIaOOPVVC1Oc691z0I5vi67qMTefHUFtxf9KGcuCk5TdmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgrcIWDBlvnNPiWXXsh4gPobCn0KpFl6DIoQpellOyjw&oe=69CD10D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7xm7mdxwfQQ7kNvwEwHkbB&_nc_oc=Adr0YhRn39LqDtwuVVwisXAvXWCEZNPlMKNhLsmHx7j1UL7K0c2Ch8WoA9RlHmLyhlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxw8BXIoDMy_naDh-XbEBnJzvR86Yv6qJgz4po2EKOlrQ&oe=69CD0C86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
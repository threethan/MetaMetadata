2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APgyqK5oAkgQ7kNvwF32fC9&_nc_oc=AdpzBqMWCGYmFj1xcFazPT_reeJSi-BD6gLeE3-ml7Kfj-Ziu8sMKrI5_j_vN38EpBA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyw0mD9DNkBN4xnJ1XwLalo6EV8Rm425MvlQMRKlEbcuA&oe=69C7B3B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTBDu5EUKKkQ7kNvwHHfHMM&_nc_oc=AdpGsXrv3ZSQpXGnxTxrQUpi9KrqjzHBrfxRiPs2NBzeOMigp_dh4PVbN6PhJ9evVS4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiTLfp_4h_LyHnyIu3FRFN-bfoAVLPlmy3q7uJpWX8DA&oe=69C7CAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lz3k4Z1UEQ7kNvwHh-ekA&_nc_oc=AdpcyOHBvc-alknkaRzXfXcQZq5RuedZj_zL-hvlttLWnsbyxkLSbk9ZJ1H64b_lsFs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRW4M213aay_wikPfyX-GkdgfJp0x9sb4UeefLGOVB0Q&oe=69C7C686"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
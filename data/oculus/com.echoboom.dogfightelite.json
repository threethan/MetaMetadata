2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLI7nmgGNqcQ7kNvwF5I9rJ&_nc_oc=Ado9zJc-OCXPh3mtjQlrJJOle-T5T3cZ-kgU_KtlGYNt6PGPloz-yFzs789Xbw8hSNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7Klf0CLzjFThw2t-Ju67Kw-HBGfoINGtnTz9L_vAiZQ&oe=6ADF69F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAONEdd4KxUQ7kNvwF42iP5&_nc_oc=AdrH1jEumebsOi26tKtcpDmMw0rmZaPWpxD6pv8e1_xw0hnAXksYv9TA7LN0DFhk8mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsavldw6rAre6Y6b-dJgbxy-U1-ohk__PWxzxUgqw4OQ&oe=6ADF48D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T901DuEvKRIQ7kNvwHu37iM&_nc_oc=AdrCTnedFVsTD79-T5VqjesCh7qJ5DUVL7V0QSb8l6MjgZlp8KEdBzotYUFkDjLHRVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkSxeLi63U2x71iRapUDFQSLMX19PgsQBgCBguOAiccg&oe=6ADF4486"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
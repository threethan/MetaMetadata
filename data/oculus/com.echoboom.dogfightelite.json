2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUgwswyk7v8Q7kNvwHm_VeN&_nc_oc=AdonfIi0WzwcRv1o9Vl0shNrImkAkKugXVy9d4-7RSq4auH0gzfhRvBfbyKlrtHucRA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-BB7Mzf1wRGq6K-BO6MPqvVzmKsSOMvss7NL90P1weA&oe=6A9ADBF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6M8qcQ3fBgQ7kNvwHJF7bI&_nc_oc=Adol9HEvbUwHmvzx9i3YdO7JL6l3VX1qUuD0rsYH2uLG6Bf7zEAvn__3KA41HSR5JcM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWCaCz2gzXBE2nFjE9v_vV7S-tBAeqlcnwd_zqbguV2g&oe=6A9AF317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Njkamj1Hr8Q7kNvwFEhnjI&_nc_oc=AdqqacVew97gEY4J9vEfG0VQ99IL_vIhFqrfBFO5I5Qcub_DQDt-gw0OiT0uWKZ7B3Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM54AflvbHDC_9uUlxNQcvgatA8IaR5qKBcJl7W8F-5g&oe=6A9AEEC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD3OwfHEyagQ7kNvwHaMX1s&_nc_oc=AdrWWiAbqvdnO0MqdpjI2WYr2bu1JkkfL7e9HvqxmXyUOeFmdEyz9WFyq35M-4TiKKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QrhxVyKBUyDaWpqKwGHnwLrp4PomqP4Hb5Lghr1hC4A&oe=69EE2773"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bwjYobtDCQQ7kNvwElZp7Q&_nc_oc=AdrgAk9eRCKA_oNfX3mst1Du8sWTfeeDb5kLJvsnQpoKlH5tOAa40R9kGjd3aothLuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NItDM5OK9laEVP6_ZlQyM0EJ3Dqhqv7p4BcrzR5XUVA&oe=69EE0657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3uDkfKuujsQ7kNvwG5P2Ms&_nc_oc=AdptGw1aBf9TBhv-rcBTldKm3-nzlcylKoqZDE8qIYQceWaaMF9lMmo0igBA_5sF21U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KhkmoDLm7T7WAd8kCwA9Sk-M-MYCTHPjQGn4kP5I6mA&oe=69EE0206"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
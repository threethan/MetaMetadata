2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgfAVoxzDfUQ7kNvwEBaJoY&_nc_oc=AdrYNnAi7akgpBVd1e2lrF9osN12IFy3YNExayXlb6shd3srremmKTXXQvAON2hFcG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKWIZZVm4qTBLGpRsyIC-ojHThSMDBjJDd4nThvKldDQ&oe=6ABBD173"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIerLUOcpDMQ7kNvwE1aJzG&_nc_oc=AdoTh2yIWHpB5RhKN33EqALOKXy__Ar75_LzVAuZQxWVx6M1akELE_EAaOxXybsafR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjsT1wNnur0wNmWFDyl2avM5aDUUHHZ9w0FjAKt1PAhA&oe=6ABBB057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyxB2P5ZBQsQ7kNvwG0a9Jf&_nc_oc=Adqn8m-NbyJns1I2pUHWVcgRP1q4mO5lCcN2mKgeIURLY9cVI6-RG6T1FmupRzL3yoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk8o9nrOP6VvH6wb02pctQaoUBRuboGdciyzGdVBQ6jg&oe=6ABBE446"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
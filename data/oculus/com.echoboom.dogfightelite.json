2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMRs-sa1O0Q7kNvwEsU9oy&_nc_oc=AdrEuE_sgKbrCvpNd3lJNBjgcYBAkGHIjjNJpb5Dlb-vdFQ1p32lsQdALbwpc1ktxVE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9khxMJ0tjrBGPAwb04lLsii0j73pbhQPJfuJBReKbxaA&oe=6A3406F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHP3v2O1ucgQ7kNvwG87x8r&_nc_oc=AdrsHSj4VIfsP6w2I2B4naHl5tiQBGQ78r70dehlybo5pgQ9erNJTbFhKz6H264rBi0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i7QbzDcghgivmvPhslHULxJHHKZHyMpQCtk2AOSmTiA&oe=6A341E17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQyHN7WoOgAQ7kNvwFig8eF&_nc_oc=AdqgectSLi0sBryUHkbQToS9kSDKZCFsE7tk4nix6xI0gzuH2hsWQX1-tMiE73HUwnQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hDq1wOT2pFLcFXG2dOMdp0tPfDLr9DNBWxY7-SO3hMg&oe=6A3419C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
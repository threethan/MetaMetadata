2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXh__x4KrAQ7kNvwH21GH_&_nc_oc=AdoJBSvaKTxrUD_6QPjbCB41vAOleiE0IPDisicE6d5dpMUbr9nRAEmeVfghN1WfhQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DyUBm8NXnTC7HAAowJJgPZywVOnTeNc4yj52nqqb-Rw&oe=6A15B473"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlByN7RafuUQ7kNvwG73QKC&_nc_oc=AdpDdV_NtYi36TGp3gTJOfsnBSLyvzY5Azg9ePtsDIpyqJ1iIGHUnbM22AiPhxNMTPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oS-KWEWNuMOLwJXvlR3XRSN6qLehrJRjSkyGm1gA8lA&oe=6A159357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbwBXamDBZ8Q7kNvwFdNK8A&_nc_oc=AdoVkABug0YXfAJGoJzMMNOIy7-ilmcRI7pA-5brviWYG1Lf3KZtHZLj8TU0Fw-iVfk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oyww9RFv1VfCGHiQSSZ09_t0LyWOPiKxkYhHRSRTfuw&oe=6A158F06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
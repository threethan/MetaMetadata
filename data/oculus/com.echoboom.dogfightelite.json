2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_IqEWGrQvgQ7kNvwEMCQiH&_nc_oc=AdpCt9Ks7ZDMumnhUWxuke2jsEWcU4JIGF2FbUp-DYULEV0Vg4azHPHFH0wxsUffKwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR36s5Ol9uTjdEzAs7w2DmKf5gh0igr2mp5gzvT8pp9g&oe=6AF1DEF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMufReUcl6gQ7kNvwGOwUit&_nc_oc=AdrINy_2kdhJnVByv-87dzcAJN9HU60bwios9HvmNU4echDWpTDwp-aTg5xDNGpqkOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLzkmDewxLipuudbJas5jgfcXp1zEZ9wUNdTQ4i7HLIQ&oe=6AF1F617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFPc4hYbarwQ7kNvwHqkblI&_nc_oc=AdorH1w4wP-Njh7xCMZv7ishwbZxOo-36K_UwF8cXF-QeGVZ_2QEqTLW8kkBtXt9DXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDzUfEo8O7Tj9FGEaj6ajXzpQl-1tFqfPbw02pfNJ7Og&oe=6AF1F1C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aoIr88PUh4Q7kNvwGy0gsR&_nc_oc=Ado5ql7WoP6mB11Mt75fZmnXwjtTXp9vKcIty_5b3s6-B6UagOE8ZTciFkAjuxvTjEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B1loGIjjhneoZCqpUDLq0xpmS3L9S9AD4ZrZ1HG2L1Q&oe=6A37FB73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsy1A81r5ckQ7kNvwFlMhm1&_nc_oc=Adqq_ujH6oKi7FEfEbyDNWmxHnRJAZ-Vt37ebs-_MBH_8NJ0ajDCyDU1yksEWwEF64I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XIGlKXMoJYzMbnERLKIyqdl6wuOF89YXpiPXJRzRj_Q&oe=6A381297"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBb8TzcoIuEQ7kNvwHIDg6R&_nc_oc=AdoFVa9R3ou5HWfPrY--9iTQoF8YO72qGXVhsCZCojG7bpCWQMwPv7V5pOr9NmDBEo0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y4Djpo0YowOP9KrUsP67ROpmQzMGm0u0-FtHRNDYKfw&oe=6A380E46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgXQbja9MnYQ7kNvwEcFT-V&_nc_oc=AdpMk9X_oexsqTLxQnSkjqtNLsKiL8-0k58BVgt1dZBBdTQnSdtGctvqRReI_3LW0FQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP3h49LRMkCRlJSxdQtX0ugYGT54-C3SqDoIdrXHUv3g&oe=6AABFF73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2dFG0c8-eoQ7kNvwHfO9CX&_nc_oc=AdrYFI1QiQsEIjfJFaCIZ32DCCQdqtpAOMW-Uei1HAZRP7empn9xxu3SINO07-AZc3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3miDAM9KKcC3CrL0Y-Mr8WeN6bISlbF1Ns9FyRfGq-A&oe=6AABDE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7em24ZExVAQ7kNvwHNAvtL&_nc_oc=AdrvDzaNfu4hVmSoTyrw0HUK4sqKXnADbwN_x7yZ88JnsGgp0TRrFkDPK9DlvK_GKUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQfS_YNMIBVSh-kp6Jy4g05ZmE8fL4XqerFLWh1xZbLw&oe=6AABDA06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
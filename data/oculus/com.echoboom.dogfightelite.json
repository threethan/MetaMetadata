2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jH8ZLdbABkQ7kNvwHhx5ng&_nc_oc=Adr26uP39a9Ik79yl-ea4kw_w_Vfs9dD6XWuLRiCF2h4W-Lxrpn-T4ZKSkD1tXEQrqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEseO-2YWbmg6c07n7iFspcp74lbfFn6p-s5TgQGkUyuQ&oe=6A7894F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrWfnSTzRYQQ7kNvwEPqccj&_nc_oc=Adph-nXLFmqNjTgJhcyiK4xp5WHDV3m925-Xym2k9CyjoDvcvVNK98y5PX80yfh1Lqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXArq3M2tBYGdSvdvMRnPHhYhuB5BjfC1Tc66QI1JoNg&oe=6A7873D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7P65BYdzAwQ7kNvwEced_c&_nc_oc=Adq7r6CdCEb7-oI9suhSJcdc5bo-Kmy0MV2sUKtg_JwubRAkiw2_D8gzdBwmkWxz5v8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESFjIMiflakpVpUF-inF8-9PHVLaUExkP-lGdBf5wvwQ&oe=6A786F86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
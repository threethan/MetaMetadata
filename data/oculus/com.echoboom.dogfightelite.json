100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwJk2A_20UEQ7kNvwEmHN6k&_nc_oc=Adpm4VztkZADiCWJdZd9tMPQeJwWhyijvWNUu6v7OzBSk3JJABFiDmnTy1Y3TggbNlc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL3LZJuNv3Rbk5r_YcztSPKVs2A5pHdhC2yIdo92RaJQ&oe=6AAEA273"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tULzu57DsesQ7kNvwGGhF3W&_nc_oc=AdoWoKMkjJLMs968byxIOuIjfegtHwqB93FGkc7kKxmB3SiqXWV-ij2aCBMp1iTkm9A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR8PkxrGH14WtI45GBt5EP1B0U6rJaCVkmlEENHhL7jQ&oe=6AAE8157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nJ9QnDZuxoQ7kNvwE5fY2A&_nc_oc=AdroIewIO__vnIIJANCXVSaLOpgojzoyXs7oTAlX-kkP-8A1novd4Yi61LbaAbBv_gA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUesifLM6HLeGzteLk4fjRZE6EuyQTHWaJroayp7oJw&oe=6AAEB546"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
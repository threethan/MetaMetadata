2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJhs5ncsTdcQ7kNvwEK-beS&_nc_oc=AdpKjmFU70ollDTKDG7ldF5D1UFFWsUHcrDxgjiWYfBLWiX9_9RZJhv1_Yn0bUCb5sg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rwz0zXl_nt9m0J5YtRVf0NVPVIi-k-pDXviEtgAl9WQ&oe=69E249F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXe5Sh6YirMQ7kNvwEIzU-G&_nc_oc=AdpSeVkdfXgVK3s51cKWwZrJwBmrupyeau64qyVikBg6Ow289wgPRB0KfYtnQzOPHAg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MwHyegzDx6itcRjBJy6vYYcPnHKKIqjPkRrF7Gw5xyA&oe=69E228D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQazl_btiQsQ7kNvwFvXOXA&_nc_oc=AdoBtqY2RL73po4NU1LfRuNlSreH3kvo5tm5zouxkeFgvDRyEqhqNFgThD4aIOEYnLM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DDkRsWyI9IFtbOrtQT__yxJbNeL0rnRcoTAAU_NmUbQ&oe=69E22486"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUgwswyk7v8Q7kNvwEUr03C&_nc_oc=Adqr5HHXpbkwKeyIbsoz1uY40X0tbg5-jrvX29Ew4B5jnVB_qOhYxdEtvtTxO4Zs39E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMEYLtLekmhrl6yz48jz-06Ymza-2VXUZ5lH9U-0cWsA&oe=6A9D7EF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QJ8ioAv05EQ7kNvwFkzGzV&_nc_oc=AdqK0r6v5w1fLdu5OU6j7CaXlwI0f4F1Nm1e0mig8iwKXiRqzmKWKdhfKGL-68ZfTb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvpH9Pl8icGD1hqcT328GkMvlGpNOefi4Fl8wJhyb21Q&oe=6A9D5DD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqTUvav8-SIQ7kNvwGe-J7A&_nc_oc=AdrX70Y6OQRk6SgTVJqs43atjASit6cZPaej9xLsElps8-2a1AvJOqi8ib39-tIS2M4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJC1GTWnoWNGb339qGlU66kARNGA4lg2aQbmDoU0VEZnQ&oe=6A9D5986"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
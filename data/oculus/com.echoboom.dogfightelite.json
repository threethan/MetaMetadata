2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKm7PCGAC1YQ7kNvwGCDzfk&_nc_oc=AdojCk6CFT5-ilrX3IKurVxYwV9G8D8xHq_I4-0Dgfo1aPqA9fu4nnTvhNigD-P1hR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlqUnQ4T5ablU6-x6-4mbHsNOcbgtOqrBvF5hvse-Xbg&oe=6AA6B973"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-CSTXAmvq8Q7kNvwGOjGTx&_nc_oc=Adohnd_sl7B9MfaKjlID1egoS1sW5-0kBXx-n5XUrfLoY0Gup2kSs1RwBdAv9vhjSVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqbWSsrW4099x8t4WBK58hb8v16ZUmiFbqk281MHIAkA&oe=6AA69857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SZsskBIQMQQ7kNvwFVLCnG&_nc_oc=AdqoqOKulasqBAu11L1RRolF4KKaBolO5lRBZMj3nmeuMNoj3S3w5tRlXLDqsJLCR6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXhaUX1UsQEhd44YlhivcZhV5eWvQ-DXUmu_zJQQ9-7Q&oe=6AA69406"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
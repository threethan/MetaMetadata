2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OA8rQnH3QxUQ7kNvwHYOyFO&_nc_oc=Adq8wW6-03kmRCMKWSai2ko45dTVKUzgw9_0VbkM43dNeTBWBbH29n1r_6p0cry6mYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bGMWSnKmoDem2c93IeGfa4Ucqmor6wKJCm5ZmtwUedg&oe=69DBB273"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KQPIdiz-hEQ7kNvwGyRgsi&_nc_oc=Adq0GMVKeUM4u8kTHGsz8Pn40v_SKYcRz_Kx31zcUkWRxCawrfX97H2i-JwjASNKSvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dUQn29C2rV1lAK-Mwe9vCd_yAB0T99j6JTPyT0r6kbg&oe=69DB9157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIZWYbllAKAQ7kNvwGzZWNQ&_nc_oc=AdoKYeeC5-VmDgvmJ_A3Qbboq0pudqlIQic47pWQnfOfWfVl2nw7J2L88k_JOEWNp3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wNKRgJX8_YpNPRBKQfU5EFTUGrQszwn4BnyS18TVzGg&oe=69DB8D06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
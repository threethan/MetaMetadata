2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeD7e1t_DWoQ7kNvwHNc4yQ&_nc_oc=AdrR8sDnkJKOV7N0GMri4EtnHRgxhsogpy5eRJi23WxJ4y7n06JsmJOBHDm9ZP1J_-g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6DyjZv4xiNkwVN_-ArSwJP3p3liE07I0UpyjzjmHC4g&oe=6AD38C73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLoNBVcCf0QQ7kNvwGNyD_f&_nc_oc=AdrmruND-SZ5ipYwa49YCPneuY6AwALSRRZr3qS7alcsvkX2gvd23l4E_U_dL9ASA2w&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNBYgHVMYelDlmpCaRNq1YnkqR4nzydB9OARKHLHdJtA&oe=6AD3A397"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQLc8nWOjXsQ7kNvwEmTC1t&_nc_oc=Adr31sKLt7wnvPNUhMIHaB8FO5rEg3cdfQJqQ0c7jnZ3B8sszm93hxGIcDHEXSqv0tk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSq5Xxcm8zx7AaJ47WfG79Y18c-lF05zlIXat1n_ddkw&oe=6AD39F46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
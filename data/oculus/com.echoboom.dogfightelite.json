2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwJk2A_20UEQ7kNvwGMIbs-&_nc_oc=AdqRlRyQ21k9BVQGe25kZN3bthlMQ5xmhLBnybCQoYym3ADtKEW3AdVqSGjl8_2wGEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTq75wiDj5gGWOQtaPWCtFjXW8uEkSRahhhuLtvWYTgA&oe=6AAFF3F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tULzu57DsesQ7kNvwH35KyE&_nc_oc=Ado9Vk9jz7_g9_b8Ot7CGUP8qTMP1U87cw6LqBkEtNsDXKI2wFuFEsue9XRYzfH7ak4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaiqqF4ElrKwKiojHd7ME9VzMW5CLGjJ7cFivyUD0qKg&oe=6AAFD2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nJ9QnDZuxoQ7kNvwGih1Pz&_nc_oc=AdoaR51DFNx3n9GLASyh77VnYj3rqK_fTJKdoBtihv5JaRIApzxoGYfybjN6tYme77w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZW8gZWIm9ui-hPy841wwC580g7IjyzehMgIStFMqQ4Q&oe=6AB006C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
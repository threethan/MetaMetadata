2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2KEIJp3lU4Q7kNvwFYjhEv&_nc_oc=AdoR1az9U87dKmUKWmZ_bUoJjaC29X8TTQiew-i5Dw0Jsd1yx8JYwKlw29wfc7B4pkE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq7HaNRgAhTM6clpN9mjbT4A11Bmvhmmirhlk8nyY4_w&oe=6A74A073"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NghdDhMkbIQ7kNvwGRo5bB&_nc_oc=AdrqKUboh_xQF6cbXtWjwyEpD2blFNrtHmI7wvR8ueHm1BvcIPb_SFQBTbPGosh-xRk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi_GJ3FI_O9OGYUs-KEhNd-9UMt7grUTNH2bcAK8crMg&oe=6A747F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ6HeaxesRAQ7kNvwEVhvlq&_nc_oc=AdqW_k4wAWGpqHd90qrbjVZmatESrW-NQAyF7v5wSyEyxMw_HTlogTec89VlaFywAxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL8Z1CCDgtdX--GRHeEe21yWKRfXgUh8dOyBoyewqk7A&oe=6A747B06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
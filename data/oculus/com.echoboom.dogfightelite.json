2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49c5GWnUEcQ7kNvwHOfQyX&_nc_oc=AdqQ-YsCHofMgz8RMdG9_u_a-dFx8V-_CqiRBnwDbJPrLrNZI7tmFV7dLfLaYhMRhNo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOZg8mnijsYv6IHyuZtJi97_8jeVVCBU0ZmI6QtSRebQ&oe=6AEC98F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyya0EJlZukQ7kNvwHaIVrc&_nc_oc=AdqQCUvpXU8eRpRm_bPkd5r69O-Gka99b7HuS7e2tA_7B9nTalWtRC7_ZykNWHgPg1U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlejT7O-o9Ponj8dVY7FfkfS4YhOd0i7kQPWxuj6v1rw&oe=6AECB017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLfTC1hbHJAQ7kNvwEXv9qU&_nc_oc=AdrAyZ8iOntZjIGFj499OYWz19yDqEleE-24CHiEUPezDEyf02eblX6K_hU_DZbQ0NA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmQV6n_1tCj2YUdchC9NqFmiB7rDhSKqswEAjZ8u5TaQ&oe=6AECABC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
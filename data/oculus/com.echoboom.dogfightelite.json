2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc3jtuzw_V8Q7kNvwFzqijW&_nc_oc=AdpA5jNh2BwmDX4k6I2K6bQsP2RupfabjLgSVjONRhuAvteDLg-fQf9re7S0WJHR3NI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51NnnnU-hKAJFrOlkKJA2np3YiV7TJpOSloKsg3Uy8rw&oe=6A0C79F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvawGqDAv8wQ7kNvwFuumPR&_nc_oc=AdqDQf50uaaPs_fZAmxJLqfYSTXfUa0Nf0szIuzOrTqveb104IoQuD8w2UTt1RzPRHs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T5Ij4Q09Id6OK8tVMRCzMtfFcO90TX5MK4IpvXCEY6Q&oe=6A0C58D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD-Wn96OEF4Q7kNvwGJj__y&_nc_oc=Adpsoh9QzpAf60cDF2q3ujUahQgo8kMEw_uTHCOESe9VLZjvJ8_iLzLr1NMvOV0AsI8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DdFcOSfZHlSQadEZNLcwdWNayD54IEyFb4-qipLkR_g&oe=6A0C8CC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
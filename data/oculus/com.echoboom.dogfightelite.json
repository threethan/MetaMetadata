100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZBoHu5Np0kQ7kNvwGX28Xi&_nc_oc=Ado1P1i-0ztUqG7SISEo0vzZlCvWqYsIKrBKxR0rLrHufuXe7LRvnyn8NqPnBUQ_w04&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x1klFP5DMkzZfPTxSvrImpLtJL2WHsG5j20mGG7et0w&oe=6A22E373"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YhNdcCVjhAQ7kNvwFi4kaD&_nc_oc=Adp90g__yiInihyGgPwV8dyBDCWyve4BYatJyXkmFJYvKS5j1dgaeyqAlJsTs2lzwuM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bO0OdlruhTgEte6XAGO0ILfak54fw5gQ2yhrIvqdMDg&oe=6A22FA97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVpFvlnWkTgQ7kNvwHm7Y1J&_nc_oc=AdqfwOIDYbDRaDpZyoYqiG3g-vYzlM_zI9_9UaHXOQZweJx0HnQ3TIyTlHK5WlPqDkg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96u8BrBweE_ezNFb9epYrBhEc0wAfiRedwDyIWfvg_UA&oe=6A22F646"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
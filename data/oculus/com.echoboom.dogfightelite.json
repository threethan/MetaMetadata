2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l1G_zor_HMQ7kNvwEHAOzi&_nc_oc=AdrBbfDyoyudbgU-1vq6mGS7aSN8g85tPPAmVrK79w3Ew_LSeMiZ-7rec8j-RdEtAgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpQ8Rs1z4b5NkgJ_NUSrstvuF1P_GuVoovb_cclgwuOQ&oe=6A491EF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXyO6ZBQ5q0Q7kNvwFo4tBy&_nc_oc=AdocbkutzkoehgmSNqU0MeqDvvslUyAFXf_Wyz6MQ45EYAX6gMtfvWQIUOzQ_hZwI14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxa_CyQB7yXrHvEIJfyK8HSdBqYykGbq_65j7RfjhvQQ&oe=6A48FDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgtXwf7d90QQ7kNvwEavVWi&_nc_oc=AdqlIwSYsUdeQr_A8MdKe_hQBJpTVJT14J3BPt5y3VJrlZqgZzIAdA6AgWRxJKjB5U0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClOkJywDdaPAiaEuxTzN1IOVagd_ruK_ma9joUvjTPGQ&oe=6A4931C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
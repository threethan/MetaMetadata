2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCjnZUX8YuMQ7kNvwHk1Yx4&_nc_oc=AdrDz1hFSRSIuylbrtoJWGIeRLHIsIGSwa5rsKCqjkGj1oTf-tXfOo8R5X4TQnq-B1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID613l4q6MHnNZzjdFzgK7RTPqBb7bYnE7MmdDBXeGvA&oe=6ABE7473"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO8u74v5Sk0Q7kNvwFYfWHz&_nc_oc=AdofyF3X-lIAdl0CTxYcZkQAEEEivlZf8hhZPMpmGvN1w9xRZLYxzdHlCtG1aTD3oxQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwb7zXxRb4nTV_JeHk3xtm4IM_liNTc-Jinv_WpbcL2A&oe=6ABE8B97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42x7_JZ5AKYQ7kNvwHwB7i6&_nc_oc=Ado1bQuAuT7TGTgBunfB-IQirBzufy6hPsIekDDHuGGdq4fQONT4dN4-xzVSaIZ-97I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJf2DFAJ-lqXUxX_FSpr4hqXDL0AdkMjL06gntR3Af0g&oe=6ABE8746"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fny7W2W7M3IQ7kNvwHNfJUq&_nc_oc=AdpEY_o5eA9xWt99ngjyrqzF7nLCejZQEh8WywOTm5Dz4M6GCuzWucBkYVM1b-lIMQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVHGkwumFDYzPWiN3yN-ey4r_FoAHB23y7z1dJFsjigw&oe=6A8C2333"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-Yxdso-1ZQQ7kNvwG86wvk&_nc_oc=AdqB2jnLCuz1qE__KuxG_5e4E93zWuTBs_UG3VMioaogOi0bZbIDiU_WEEQWS1uJCQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFilBXiqD5flGYUa3sXo45lrhIB4w-lwMM5b7TMIlVcOg&oe=6A8C3A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx-2EMgFoIoQ7kNvwENbvoO&_nc_oc=Adp5RKbQdIN4V7sgJFClscftz26FsIZxuvcE_sAz9if58dg0CLP5yAd3-kD3ll4db0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJZqm_IHY1XtaEQKCiF826QRS3u-JQTvjVcAB8noMNbg&oe=6A8C3606"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
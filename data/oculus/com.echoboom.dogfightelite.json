2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOv0WnXxg7QQ7kNvwFFa7nq&_nc_oc=AdoXInRe-U0I5i6YDvF-PUhXGUBllMGPgqzZ9dJzWASNveXRnoMAS8j79DhAEuAerk4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bFXtboxRsJIi6N0ZdTegu_B5VaP7C9lVVqp4MDJTJoA&oe=6A282973"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeoEWidoz4Q7kNvwFeoIKg&_nc_oc=Adr-LH_w1P_2X54H95kZuib2orzzPggfo1TP6Ujns1h382F0BPX1p222kmhbVTubpuo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97yEUgP3Tf-1jBlLVXFFTvhRn99l_hkJsqHxxtoKwClQ&oe=6A280857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rAtTrXtmQwQ7kNvwGvtFFM&_nc_oc=AdrclAHOBGpKPs5HMaCq68XLz_DfmvEUn1bpjhprN4VouVNu-Nj-Ff168DSzRwSmnms&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5ykhCm97ZvaD06-_EsFgi05aHiiRrZ8oapg9sbGc9jQ&oe=6A283C46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
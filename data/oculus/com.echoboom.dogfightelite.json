2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g77fhpTJH0Q7kNvwE2RceF&_nc_oc=Adrd-1xMwPhQEE7II_21er3M0WBwxg-sKKE6kkNWvH9sfb6pAJYd6-4opYcbWD5L7jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXydFxejhMUfliJ183r8vasUn6RrAZlCkTveYfFeabbA&oe=6A6CB773"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t5Y3yin8taMQ7kNvwFn75bm&_nc_oc=AdqZPI0LnDk1CWs8gCvMm9Aka_PI1wGzNDqRtlM_kT-xUlgBGwruRCsJHebjd7900P4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlMYG4CMFJeuTVuJsojMM41Q7wuVCSR2vq3qO_A1LNgQ&oe=6A6C9657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPdonoEBls8Q7kNvwGXka8S&_nc_oc=AdqxbiuqvolgrzMCwsQ6FW3EKwm020MbJ3e60mOu79jpxg3-b3WK9AfQ4koR6YYkbIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-5iNcSLpBH4De09XHyN50U2jYSArdBWeV3d6c44go2Q&oe=6A6C9206"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
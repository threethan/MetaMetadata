2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2GsvuZ5eqUQ7kNvwHcDLlo&_nc_oc=Adr54omp4_Iipk4WYznTmiiv8iNnceF4fOrS3MADCD83FfWRTFefNCX4EvCgu7MHg0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpKl3_bk98_09gYPIbW_jskTlRBZZ-iuKZjFFpaPXTiw&oe=6AE20CF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h47RYLL_JPMQ7kNvwGPxSih&_nc_oc=AdqxwqJP_kTK5sfAb7qoebsoQFLnbLUvMvj-slGXKLCQWD7GNQKLvUQsIZoVcktEdss&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQKDMXqAG6ZS1bPAGsEhyvA7O_1gnPw3XOz7LD7xMFZQ&oe=6AE1EBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfEg3_PsJzMQ7kNvwGh9iRL&_nc_oc=Adqc9T8IhF7o9KFse-UGg2LmsK8ddW6yzUrZ_kcJsybSym48OvpkB_x-YaxF5I6bSdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp_vFP-cre_cNNkaJytOaCQzgim_WKVYpNip4jjKRs-A&oe=6AE1E786"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
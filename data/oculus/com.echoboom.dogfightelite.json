2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBx36OQ17AcQ7kNvwFsWjLU&_nc_oc=AdrfO4N444QyO0Kku9WqwoNsrq0y5HLygVYnlDswJx0hGRY9iCtazumsrKCTyjFWwYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C0a5rw6aXT-mRhfJp7jjiNhlfKGV57gTKuox69na5ag&oe=6A1EEEF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaTUMFgsnSQQ7kNvwH0ke-_&_nc_oc=AdrsEGPf7x4P7nyXBYGEWr3YCkUPoZkvGj-c0c_c3qLNXhTDWJjR4rujsoSxklyASsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64ZBxQdxb7yRJRZOuqp3DeiVgtiOGuuGYSrrqQ2LD4jg&oe=6A1ECDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hloIRR_Pl68Q7kNvwGve49B&_nc_oc=Adr8DYwsMJBgZ7VcWMzOf7FKL1WiftApMvfrDE7qmAJgij1qm3DXzZ2eITNyQGeg9BE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X1BX2tEa6rAiPgCkNurGboUOy2rxNe8fp5DPok3VNBA&oe=6A1EC986"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
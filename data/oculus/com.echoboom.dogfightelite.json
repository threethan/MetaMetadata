2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZBoHu5Np0kQ7kNvwG-JurL&_nc_oc=AdrYm7brNUovykHPUMTwjTLnphmc_4LOu1Tyj6zRW0h2Qim5BneJyy710iJfxwDfX7w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g0EfvI12xMv8VHfacTotR2X39CsRz_PQ2oS_B1_dbFQ&oe=6A204073"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaTUMFgsnSQQ7kNvwHXSEaU&_nc_oc=AdoRNP1HCFLZfcp3fo7Nd2u1ulsHVAAtOSF1q_f6uYYKK1Zw-RAX4Mj5sw2wlLUVwwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MK27-7gCtIh3ppSRadkmbiE03kbtiHfPYFK2GP0hxpA&oe=6A201F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hloIRR_Pl68Q7kNvwHIPmqU&_nc_oc=AdoubuYlOEAEvFwtIRfJbxQNcNhbU-XsJk2DBE9VjsMY4tPLt_Z3jKKVgNrAeMgsdXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_2qavQOYKIJgHPBrJaVaHcDuSK2t22GgmTAl6QqXIuw&oe=6A201B06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
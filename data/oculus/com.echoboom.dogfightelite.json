2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGXh__x4KrAQ7kNvwFiAR6H&_nc_oc=AdqgtvoYEECZskZYrq7J9QWNGUSTb6PVEdeCdzYCbbkvaER2ZvvgZPuM6j5r8wo2GnY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MOS2s-siaKS1JcZ7MJDaqtZDI2iMPDcifgmalM7DBGw&oe=6A1705F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA-kITZq9qgQ7kNvwFA8DCK&_nc_oc=AdrcpEG2PA1SiW-fJbt6-MbKBmseNSRuFX4eU73g8XB6Xk8DhpNykIyzBq4pYDIU4RQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PQ4YVsxEITM6LLYuQXCobw37wiG0cFx5ENXf2q-h4hA&oe=6A16E4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z6-0BO5RCwQ7kNvwHKqqhf&_nc_oc=AdpUBWYWL7p9_OC5Sukiakja7BXLMjMpK-XVmM9qTgQidKcid31dbpN3lV4jLkbN6qE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kKB9Ms9yaUpxOxfbxhYTGB5LUt8tse9MDSJ1nYEpBwQ&oe=6A16E086"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
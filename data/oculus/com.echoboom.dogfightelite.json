2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJsTqy4gY_4Q7kNvwF2DSHj&_nc_oc=Ado4md5ehYcWEJfU_jDlt4eRsnpc_u461sCXCc8VOuzpdsE2WtER_fWvGGJ6MqebKfY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV8ydgMo5mLnMcqTW8y5Cx-I4X9DVJNGsJ40vmSbZyXQ&oe=6A7C5133"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzD7MkN8b2gQ7kNvwEbFIRS&_nc_oc=AdqzvqA3EvgAe8E_E4VmPDOM1tIr9QT8GPSjsIIfmAmEXvGdDzrydgiOdc_9Bfs06KM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm9EahK37c8a_l1psp89rX0eibls1fBku2HlGDDzPufQ&oe=6A7C6857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NII_bjCB0JsQ7kNvwEj_yjx&_nc_oc=AdpqL5aKkPnN1Kv1Dvxgy-WQpGaJBLySoTONxWLuJh-tLShFMPcnLJeZHuRvJlBlny0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuPc4cN6dz_Zme4jCp73Olo0FCQA6rZph2QdYQ9Hdndw&oe=6A7C6406"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
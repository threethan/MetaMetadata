2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZBoHu5Np0kQ7kNvwFOIKcD&_nc_oc=AdpZIOn2GHZWHTYZsEukkoLNZyVKfAuedF1CPDAfJ1lKzusQ2PR0pr4WJa7pQ7KksLI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Oe8cBTae5OvYFq-BuriBaTALvqTZVfq8AvwoDIoUGLA&oe=6A2191F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaTUMFgsnSQQ7kNvwGe8ufY&_nc_oc=Adofdmky5Gfz-HtmkDTFaLaP7woBBoGUlBkY1NJL-kM5cHbKq_nUlR3EcLZHtWEL2WQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tqUjWc1-x2D3iygxus5EkOBOyE0xG2JWn1TyG8BtARg&oe=6A2170D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hloIRR_Pl68Q7kNvwFVkASv&_nc_oc=AdqsnsQqp-JQbt-AdXj3QaUAVv2vbQqknw3R74DGdOPZNDegQtwLYH6JekZtSiGbsaE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3QVTUhZwvm-mARqNsJWL4c7xokzVbv-sq_q-HUXvKjg&oe=6A21A4C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
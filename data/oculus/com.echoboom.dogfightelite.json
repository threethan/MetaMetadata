100765985_4905042618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEMRs-sa1O0Q7kNvwHEOdWJ&_nc_oc=AdpPcKrZYw9tbGEAvxkmtjCy_oM7kMwudcE9P2xu7x2YwF-XMn5fx6uj0hJfWgn3HSg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sLi8BgQ0J7HiuOuvNUHLH1eLVmr1G7jzFtFWQZGnjDQ&oe=6A36A9F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsy1A81r5ckQ7kNvwGFDCEG&_nc_oc=AdrkEoy570zpIc7cUxG0ucZ4ZbOwJrFXvSYZ1NbyoP8neac3_HGmVLDtdSozXkRiZYw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-W9UwuhR-mRKQ-GGNCpfGTGLG-Q_Zhgve4G6vIP6ZUg&oe=6A36C117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBb8TzcoIuEQ7kNvwF8q7CK&_nc_oc=AdqZpJBtPoKiKGxvSz9EmXnuGfI1Q6tEqQABeWxKgItS-9VuHh4ZGzaZyltsLq_E31A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VHQ0ItwcS-TulwHXzrRaJfmIReifs_YgbJ1j7kd_Bug&oe=6A36BCC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSbSY34uN58Q7kNvwHRQQBu&_nc_oc=AdpR2UIQDoxx26BWCV1XLsBnUpSZF-DvRw9qB-YOkFgksRNP-h2yMf84_X2gXX0eTKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwICuLR2yyRTUAvsCSUHOMFtCa0Lgk5o3Jc6p2E1t5DA&oe=6AF08D73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMufReUcl6gQ7kNvwHxnFHq&_nc_oc=Adown5BUBy6po0Ijq7gmriHUtpIb_iB_4ZpAB1sj2FYIadgHL1P1myxJk5swuCLB51o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROfh_d3HBg41-1nGOID4uPCogSfVsSKhgXTxb4A7tUhA&oe=6AF0A497"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFPc4hYbarwQ7kNvwHrJ1bB&_nc_oc=Adr3ISzfXSo3H6-mqLr7ZMoNGZoNXe5VZ2p6Q8LBad2tRVzxhHeDHORIefZ8sNUgVc0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-Xv7VZWu08tJt3Hff6kKZ1UwuDMEQld-Fxi11Y8ppHg&oe=6AF0A046"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
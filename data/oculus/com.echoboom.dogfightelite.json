2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJhs5ncsTdcQ7kNvwGs5Y5L&_nc_oc=AdreYvYt7COf7ORg4S5XxBs9RgxDbJSNJ5lfAz0016eYC3pjBmQR6BMENO0lb4nYKqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U6g5GvQqwl5B7sVvSAsmco1oEmRoNZlp5EDkgeeBX9A&oe=69E39B73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2S-bzvlcRgQ7kNvwFxnTjV&_nc_oc=AdrXC5wM7OzXo-XGw6nmTjDirshOAPbr3q4H56Flu4QhZhZQRbQ7Aiigy39fwV-jQ9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KjrDI24M3KeH0dZNBRAc8sTHHQBbDl9iflRfniArztA&oe=69E37A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp-DJzwazsoQ7kNvwEYdG5Y&_nc_oc=Ado2I3u1T67pAMefJdZHdrNlyuiunn1egQcaggmCMQOGaZiUymSGEpUu6w98Irek4UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VgCSkGcrOl4neEriCX71QP61zJBWDEgy9VB86FcYQwA&oe=69E37606"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p56SFZDOA8EQ7kNvwHJXTFW&_nc_oc=AdoYMM9ZKWKwNAxdFhTT437VqhqnSX2XaVux6HUvCgSnAyzeunAcsIPGF_Cb1dTfDKA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eYsn8vi6XD5znHtRgNiCqBqWIWxF6fNqOMKDtFsmv0w&oe=69F8B373"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aChveK6f3lMQ7kNvwFbap9f&_nc_oc=AdpivEW94DRLyEqePnMtXt1142lys12kY91BtAzT5ZIJNkKS4y67F3VlBAvtCv92G18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Lm4cFVdUpPelV-gc1Jxl6m3M8CAT7S8MB-8VKFPkgMw&oe=69F89257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mklZCl52L7IQ7kNvwG43d8a&_nc_oc=Adrj8Ls0SvWBSBNU6s2-_Z_GuZruWochkJs_PG5cIQol-AU-3C9XqdBzXI6XvoZQu4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32ABM-IphPbefHt42tp6HlqqhEVnYQHOEFiPd60aek9A&oe=69F88E06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri_aBCO4dcMQ7kNvwFF63kX&_nc_oc=AdrN1Oncm4B1turOJqrnXboWv4qU2jAKmc0ajhk9G2XFr76A7A1uZ588c-gvJAEB7r0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qu124lgaU_sgnN9ygKhgdMP_yKPjyTtsindGnwb9FLg&oe=69DF6EB3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXe5Sh6YirMQ7kNvwG6Ht51&_nc_oc=AdpzRDxcE9FHNkNzlcdMIhjeWsv4ic1CdCu6ybrnY1bGP8I4osQJ_nEmhLQ9hkuFkfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kJvHrQi-v2tNERkxmvl9H0-MycSdulCQ2vBEuqS9YSw&oe=69DF85D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQazl_btiQsQ7kNvwFBwUo7&_nc_oc=Adpn8I1d-dmQmNGAAduwOru36cXUsPZ32uJ--fatk68udvOHizBOa4cfcYvNMOqt75o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xzk7jpESIOE5zNPIoF0cZm4RRmhEUn446pMQ1KRwcvQ&oe=69DF8186"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
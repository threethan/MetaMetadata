2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucyENcN_mTIQ7kNvwE-eR6L&_nc_oc=AdpFCaF_c2vvl72EfvCKhc0CVnIHr5wPMvwQ_R1IE4mTrEIVnUjU7Bdeg9NjVQVaUYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAck-VbtTUER12FcgDjpLm2KLMrshbDIgQSvNP8dq6FBw&oe=6A53AAF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oQFUWKZpHcQ7kNvwFj1tzO&_nc_oc=Adp1EmtG2pjln4gx1Qb5VDgqrtIO1cZj1swWOGqgCTf9UFFyBXoVwkythnCWZpxBch8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtCHDySZahp9IH6qMXhP72q_eoQMTcs-AaogpCtCyQvQ&oe=6A5389D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL5I0Ma5ZlAQ7kNvwF9rz5g&_nc_oc=AdpUP27gAn5Ha2fHUjUw0ritqLhqwLWklZxDTSNGxl4DR4lha970EGeKHZj7tp4wVdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOpf9-MrBoB9gcGtyPXBAX3eFRS6-o79e1QGTtV1DRQw&oe=6A538586"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
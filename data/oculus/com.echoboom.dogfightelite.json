B28S-&_nc_oc=Adq1Nf8r0Rnv0ey1CZq2FXNkdpokSKsfOhl3DFKjjAJfPp_jhy2o4ILItvmIelVNa5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PZ3aE27ybzi7zb9b3d7mAhvd-in1SIlwL9HtvAv2izw&oe=69DE42F4"}, {"file_name": "7-1920x1080.png", "id": "1495932617907053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974792_1495932621240386_2241871267103140926_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BB-GxDsSGMQ7kNvwGtMrLv&_nc_oc=AdoHjgHI0naSiYD6YTpOXIQ22zeU0JY3jGG-33Z2eEen4nCsOWl1JWLhuJaHYbwlTJ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G5_ld99FtfvT6P0L881osoN6Psa2QZK3qZ-KV40XGrg&oe=69DE55D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIZWYbllAKAQ7kNvwFU38nc&_nc_oc=AdqHHRWaRb5f5osLOp0cD-uOXlG3iydnGOXtJwus1V_uL71QUyz5xl3c6J4DB40_N1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bjwp9pkDIjXrk50mbU_Cts6XQ-qEzs_Ph-fxEhkhrxw&oe=69DE3006"}, "display_name": "Dogfight Elite", "keywords": ["airplane", "dogfight", "combat", "simulator"], "long_description": "Embark on an exhilarating journey through history with Dogfight Elite, a thrilling combat simulator set against the monumental backdrop of World War I and II.\n\nBecome the master of the skies in Dogfight Elite. Commandeer the cockpit of a warplane, spearhead a tank into battle, or bravely face the enemy on foot as a resilient soldier. The battlefield has never felt this real and the stakes this high.\n\nTest your mettle in solo play, navigating through meticulously designed training missions that escalate to adrenaline-charged, full-scale aerial dogfights against relentless enemy combatants.\n\nWhile Dogfight Elite is free-to-play, opting for a subscription unlocks a treasure trove of exclusive benefits. Take to the skies or the battlefield with premium airplanes, tanks, and specially-crafted weapons, and embark on captivating, subscriber-only missions.\n\n\nMoreover, subscribing allows you instant access to our servers and priority queuing, ensuring that your historic battles remain uninterrupted. Experience the past like never before with Dogfight Elite - the battlefield is waiting for you.\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "Joaquin Grech", "developer_privacy_policy_url": "https://dogfightelite.com/privacy/", "developer_terms_of_service_url": "https://dogfightelite.com/privacy/", "publisher_name": "Joaquin grech", "support_website_url": null, "website_url": "https://www.dogfightelite.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["FLYING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "ru", "pt", "en", "pt_BR", "it", "fr", "es", "zh_TW", "ja", "zh_CN", "nl"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25757842720504799"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391959_637825352211586_3187106820275424613_n.png?stp=ds
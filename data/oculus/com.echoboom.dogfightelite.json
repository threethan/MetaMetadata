2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwFN0DVBet0Q7kNvwFQGFD2&_nc_oc=AdotSFuw1OdmcaQWs16BmziiiFn_lP9qZ08k0Za0BKy704iiIbHg4jHblRjxtANdUvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfNVZ9_YaziYLv39jzYJ4TqDNF6Q-I7lOGVZUUHSgPBw&oe=6AB296F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnt7X23Iw-wQ7kNvwEwMTUs&_nc_oc=AdqbzSZKJDwUJ-mrYg1ZIs7BEVzSzHyLo50HKdULURKXc9SVZLz8As2816OYV5RHa5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHjOW8BZnlEusYIydcT5uO4Fy-i-K3qD4qhyRgY-Y0Xg&oe=6AB275D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMB9VllUFDMQ7kNvwGTKi5Z&_nc_oc=AdrUrn1koEK8kYb1PIWaWclEqvwfWQsFUm5G-nUnZV82Y45VPkxfDdQctquKyquzWUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc0rp_HFJmzU9QVatBBhp3b1A3LmE-1r7Xdc2o_2o1Ag&oe=6AB2A9C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
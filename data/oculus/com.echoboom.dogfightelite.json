2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aoIr88PUh4Q7kNvwGzhaLK&_nc_oc=Ado-h8VzFjwOeFrRxUfUFxX3CwV2mycDKIB9QKR9u7BmKRF7LV1XPbOgtFwAE39g0KQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af943f4Xq_eFtJbEeHt4g5NyMGqTZWRPeTkm6h-ac6ucjQ&oe=6A3A9E73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TYp55e3ALkQ7kNvwHep0iB&_nc_oc=AdrLfssyRYqXlwz14o2m44QvzIT8KkG_kQQXa-Jtfjdqx4-NkjoAH9giLYvqikxhSUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S4bILmSXXwziQN1AuAsvtXEXP6tSnGpOXhXUB4WSflQ&oe=6A3AB597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMC-Ez-K8x4Q7kNvwG0ryG0&_nc_oc=AdqoIygP_tvk23EONtU-ZJ7HvUndpB4UXEF70_xZemnXg7giyhysBnIeCcd1OJJPml8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VlQkHyqr8F89syfLTS6sxlR-C2gaTsMHEbfQNE8s7RA&oe=6A3AB146"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
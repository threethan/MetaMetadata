2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqH-SP4qX3cQ7kNvwFyV7cD&_nc_oc=AdpGmsGxbPsqzB8-4DFTYR8ji6ryPBs-FM80fPDeXYqX92jMkBfd3N7Q06OMZpx2ugo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zAuKCYDrdMYvVY-ZhvJ3DsxGnfHmRk8nyN4dpsez42Q&oe=6A26D7F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taeoEWidoz4Q7kNvwGFV4N2&_nc_oc=AdojaYRGYbYDfcpK47sGREIuzL8To94UJkAhmMn0XjDU72rtab2MYWkJpo26HHK38Uw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OKEPAxabvwx5Nu9S0qR37LVSqAbHJYZ_AuPeiirEzfA&oe=6A26B6D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rAtTrXtmQwQ7kNvwGWB5sn&_nc_oc=AdqFhjyP-YX1jeinegnf2B3O1JSXouF84Ii7j_UFiiiITkjGefnwQCamIJ-FO27JFtA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YWmatS9QO09X1f31Srkf_w2P4Y6WAJltEOVLsMFa8mQ&oe=6A26EAC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
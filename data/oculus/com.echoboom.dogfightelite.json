2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeD7e1t_DWoQ7kNvwH_yao9&_nc_oc=Adp2celEeO2xXuxhK1w61IVzb8Afqzl5VnhPODeLe2tpqR6WWyLfSTQ5pO5AGPNN92k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5eK2RKPiOgooaU3U-4ZI14pPKaXfn6wfEiOntnWFNQw&oe=6AD23AF3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLoNBVcCf0QQ7kNvwEZdKQP&_nc_oc=Adr9RWMFCO5_DfHUJbrtaezBRsm_8XbopDs0KMMr9s838OxwzZ6PPWjEEdBrlVnni98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdte9Dpr02WDylEwoM8vrbeZi3ivjXH9MTnFhaRvZWJQ&oe=6AD25217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQLc8nWOjXsQ7kNvwFTd2_W&_nc_oc=AdoxrPpelo5pBlZ96hi8DJ5GnAakZ4LeLFwXsjF9n-EKf8w__3qH4_UfjCz4Vg4KghU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBhY9dZ_4cJpPAQp_7l_W-mkHJraiXTpyT-K_3NaphSw&oe=6AD24DC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
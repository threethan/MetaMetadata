2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRHySQgPOLEQ7kNvwEGO69F&_nc_oc=Adoe4SWmKaiu8DUmh-VBT2d0IyoQh5zekvW9xZA7aBYEV5Zr9gcNXpEzP_WewQlcxNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtrQJrvdTux_ZWWLXFrBqvvo1MB0zJMI4f_0vF6-7oGw&oe=6A843A33"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQHU1e9xAjoQ7kNvwESu6s1&_nc_oc=AdqFus9wOD-b5l5YRV-bbCV8Vc4SOS5Cam99Dow-BjBwyPo-c7BP_l7xNgubGf7KVxM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrKnmwvLyT1gjhXAZN5-2s8A5c9CmjvdF99yebfltEmg&oe=6A845157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU7BpjgiukUQ7kNvwHJtu9z&_nc_oc=AdrmW1_o9wOw-r_sBPJ-z8fAGezEp6seGzJqqyEpYCJww4Ed9QLs9bnuBDB02ysIHKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2mRgf8H-Q-AE4gWjDHpaKEinJ_tWrD3DAb5ByMyCTNg&oe=6A844D06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljr4aW0r30oQ7kNvwHeKu86&_nc_oc=AdpD4OwohAr8xrXFbydnEBvLksMK3x39wNEaNQyLpxjnpPlMem2Oe-Hy-yHn5rVM3eg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lif-UAjIPlZm3GgMQduzQo-SXa8GUXXTg_eEQTUkr6A&oe=6A2EC0F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX5vS9e0_uwQ7kNvwGkvVia&_nc_oc=AdqXTVso-dE2r2amSSzTRXpHlpb3QDdMHc5a9k-h33hBM-ZN9lK5-NSBt_A5TrTx0f8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88a2qLzhSojiQmWv_ipbe1yNBwzJDoV4WfZdVK64LYQQ&oe=6A2E9FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_0wM7UiMqQQ7kNvwH3zUWr&_nc_oc=AdpaNkVj9zAo_pxFHTgiIXVR3l3vjNlYaF6OcmW44U7L3uWELRpRE6M3ZpFj0eb1gVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NWpbtFy15V5N6d-blD1dfnjchpMdmoIH45GahDfVLaQ&oe=6A2ED3C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
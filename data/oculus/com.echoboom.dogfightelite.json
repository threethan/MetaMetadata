2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJsTqy4gY_4Q7kNvwG4LENe&_nc_oc=AdqnneIRjCRjpFtcGC4xSh_t-q3_PSyY9RapqihsJ5zeQFL2X9UgPezfErFsh7I_SZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe3eiQgfTa3Yl2pUd0SOteCzh0szCfJ61migolRyG5gw&oe=6A7EF433"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiTG16ENHzcQ7kNvwFeB2L8&_nc_oc=AdrDW4kP_g79sqVWhkFplHbyHsJPiDkd-9QKRXyDkZTswGw1FF1N6bfl01TPE9nUpR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGajbkbhwa4cO-Skw9kjVjNHIIznjeMB9Mjd77gco6iMg&oe=6A7F0B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za5gg30MDMQQ7kNvwE4NVeE&_nc_oc=AdpV8FjoKhCjD8pdL7_o2kuYJSZeRVefkEGcVLh2FjAxb4r3q1atoqlIQnKlfhHKppU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuZuuIUg0Jno3S7GlVfVdA_l04tPCPRfoEImdPdvKEjg&oe=6A7F0706"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
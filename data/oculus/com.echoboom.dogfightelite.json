2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_IqEWGrQvgQ7kNvwFKcSjl&_nc_oc=Adq7RRtPU4v9KX6q6t7LQgXD8d-9CPxcY8Ny5CCWMYs8IBEJT2s0NtUvOmIkquK0Oe8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEvVTABL3Fk2kSRZBiMMQFjD75azYnQAhvRu2RdnCq6Q&oe=6AF481F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UPsTa2LfowQ7kNvwF77IWD&_nc_oc=AdpZeuE1AkbJ7oUCGBC86OdGOYvoq7x9KqBs9MryIQvd5RVlN0Ca2ywbDAyPQ3ncrpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ZDLo_t59wqDn9X7XQRYaWHWuhV0Xis0esxVcXGbPhA&oe=6AF49917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obKdOpaIAqUQ7kNvwGTG37s&_nc_oc=Ado675y92Bj8IcpVXFVHqESeWMgzzRh3VdKcXsnq3YXQJA18EQDAF5Ozx9xjVKiumcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB0eofGBXD5_o1LO53CxcciolePkSayQl9JFyBDe2CPA&oe=6AF494C6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjTBH2ECd68Q7kNvwEsrspH&_nc_oc=AdqqGjoNVfX8C7SYzOC7o0U2vdJZde2JMyOJMgbF9h5f6Aba38v-GEdB6smdw0aSFM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DuL96l3_c-Ml97A5p4MNn9pVumkJdB8Okohh6gpF7jA&oe=69D4E2B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNTLBLHPUEkQ7kNvwFyw4Vi&_nc_oc=Adprk_HowP_GoVC8Wc_tf9I9xKWxZ9sKVFcRJvRtQ6uUwauLW2HGcAtZm4yMa8Mmn_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I5H97AJ6b-UPAOIZ_g1IKSQ27pok0kTTBiZMePjqhfQ&oe=69D4F9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saZNp7B9xfoQ7kNvwG8zKB3&_nc_oc=AdqcUb1lsJ8H1a1o_yKafY3i7yWSrZkGWOvnMjUrrehO5t1dS_MuXzQF-7PruzDAP3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30K9sWtBKMTUM513QMlI4NOmMvKSBcnd62ZwNsP7lQKQ&oe=69D4F586"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
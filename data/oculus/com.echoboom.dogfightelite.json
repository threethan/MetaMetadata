2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UD3OwfHEyagQ7kNvwHua4QH&_nc_oc=Ado24JNl_Z2eXs-9YZNj3sKjow-M_u7tQvvQJ7fZn6Iw_8-bWmf7vVZrYfFAOLdqpKc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TynygWs-3l0UNt7suTtSaq6HDI7Zha6SCLc9j9Xpwkw&oe=69EF78F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXI0jy856mMQ7kNvwH7Q0dC&_nc_oc=Adpt6sV1jyHHTW9YP1ibGzkNDeT7Me6mUi1D8tfYlz8F9LvDwv_7rotfaxipSo2GuqI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PF76tPSTdpz_LDipa1Il58JaAvOS00gBVw9-5nLh_xA&oe=69EF57D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBbnjzYNRN8Q7kNvwHYPNYu&_nc_oc=Adoo10v1EUvxA309Mbq3lnACLCmYcwhKiL9QMLrvSp4wBMTjHHYW1hgfTvLwvm0QPAQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OTfU2rTGEh1YRJQ9MBl3zvr9Qi8OKNK7SwZYYVS9BoA&oe=69EF5386"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKUecwsfkHoQ7kNvwH0Uj8y&_nc_oc=AdqueBWLUeU-Nib-OchbffDXfOT8TgEoIF2dsr7DjWCcrCFPvlP9r3_7RlZct5tXw28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vDl4W_PvqKaz7aHzetJIyAbN4rXHMg_2pkVVXZkcg6Q&oe=69D63433"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNTLBLHPUEkQ7kNvwGVd5Wf&_nc_oc=Adp2ztE21qC2qpMWzcb4zmYzFOMSw4pkzqopfXHZWEKhsiJA9vGvNgdjhWvpYKuUZ4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Afwx3OPlPWgZWShS_fZ3gnMRHoT5GuVsH2W7n9XHZsg&oe=69D64B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saZNp7B9xfoQ7kNvwEJzMgV&_nc_oc=AdpEk9Mz7SdWpEXHNtNGXiRt-8dzI-BsqiOGMAEiYLfITUGHp-OMNrcIGAEvOvPt56g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DxJmg-CL797M1tPn7W7jbfkwfNlfXxNh-cudhmWuk6A&oe=69D64706"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac1OoGV96icQ7kNvwGTCsuO&_nc_oc=AdoteUFVAAXpPeXq6CllyMTN0-4CoYsT9sPCQhFCnT4Xo7GOJcpVOsw7Vl4apdYGjoA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HqneuZE1BCE2AZ195UQbk019as6PJZ_wYWPrJH1a31Q&oe=69E63E73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2S-bzvlcRgQ7kNvwHB26FT&_nc_oc=AdpkXr6q3Xa5su7wXcJWszsxk8gRV-qPZFcztmwmoo2tGlkoF60IdxB8lAByInCMDRc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33O-OfbJXpMSsCHSp1MDU_gLe0wjb1hZrKWFhbKHJbng&oe=69E61D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp-DJzwazsoQ7kNvwFCYRMJ&_nc_oc=AdqIYYRX6kjTCXx27trDXaS01IUN93nNNBAra04hNz-b7wIcStKDfYRHamGp5zJtH6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09HBl8laYEK17CLdcCUn5IsaWWReKCOeIErXRIL_p2VA&oe=69E61906"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
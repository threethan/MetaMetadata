2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPgWjQ-oSiEQ7kNvwHY65q2&_nc_oc=AdqxdLQEC3ENnUfWUxgCYfvaspuK8Wd2-dhQn5gy2SBrVliQxzao4x0BRe6dSmyW5_I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbKzRmhDuBNygEouCmnVa8Gi1V8GnL_kA3zkLKdIL_ew&oe=6ACF97F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKvWmKpdAe0Q7kNvwEu7c8d&_nc_oc=AdqaORTJgh4t5n2S86ZgmXIZ_3JiTiHfVEASqjHRx5e4XZJT3XTOyTzJg1bTmkX-ZdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo5KKb2SBbInAYQqNz4LF3uoqDUsaPhJdXt2Srvd0ZMQ&oe=6ACFAF17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwePBM3ON0UQ7kNvwHA__0u&_nc_oc=AdouowdkdQv5E__Ttid0t3DTR56QNiysvr5EEZSorE5GSAk1QxKz4aaIcXDGvmcPBNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc3BR_wRPMWO-OANse0G54gedJ2Xo2pog69ymlPgy6NA&oe=6ACFAAC6"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
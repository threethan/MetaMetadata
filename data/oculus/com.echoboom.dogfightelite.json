2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUguy1wKqVMQ7kNvwErEAef&_nc_oc=Adpz8UmYn47IpWxeOWzN5P_np4LyxitAyif4xHU3PHTuW0ECPlfb0WhVHNJhKtkI5kM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfkiJWdZKODIV7fTeCxNr7PV8qXMlgPXntB7mDHC-anA&oe=6A58F0F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f7aO2k9z0UQ7kNvwHHQ9Et&_nc_oc=Adqls9Y3fNxRokYIyFtg40Iz1qO5UPoscPesgbLreBxj19x-GYCTHfnLPFXigg-X-iY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgscaU3Mw0WbcQkUTwumBQhofqnlXHCbnH6gdf8MiPDQ&oe=6A58CFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agS9b8YVmJQQ7kNvwFUR07q&_nc_oc=AdqaAYv5F0Mfuh4v10uxded8rT7pCqdiOqEHmUREnxOL2K0R1mUwV-rHfrgG7yAEcAc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvOJvNj1A_yPJlwKa1mn3rJLqe1BUNqvGRexjqWbnSDg&oe=6A58CB86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
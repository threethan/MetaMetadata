2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0PBvEeQ5ugQ7kNvwHDZsqJ&_nc_oc=Adpli3yqe0wZtCdXWAzAAb98sUXV6YC3adSEWN5wZ6wjVNh2tMgYhBh5EtmhN7t7A6s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhwJTPUGkOIiQyskjIl6lTFM0MHekxafR0orNbpAIoBg&oe=6A916933"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-TyrUoj5LQQ7kNvwG4T3-w&_nc_oc=Adp-p6N4Xx-0vc4dlPAXEgRKv52RPsKj699YcUmGmiJhTdjXH1H7zPNjURLLrZQa5p8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSd3Ou0Q8kQzqFmawQc4URlZ4TLTzfgl-C-Gc2Kuq1TQ&oe=6A918057"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M-rdaiqYvAQ7kNvwFT4N83&_nc_oc=Adp6raIcrJdGf3ECVpOpYS1P-6gxc6-aEutpLjNQyA-9tpoq7o9Ffj0lc_-JKBKC7XI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8QpLz18CzAdioyYrVA5L23bY6bdA3gI9LJbg3CWFsYA&oe=6A917C06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
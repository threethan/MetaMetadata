2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kvhJ-wR9vEQ7kNvwE_Lc7q&_nc_oc=Adps9IGV1HdyrM76bA6Tumlk2oSSrWYoNCXeLlx3aMSmIyXFx2sFBef3Y1IOjcXXTbw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-DJx2Kj_c7yAhKxdj8esqcxrKiMzByQnNhHFav_Kl9g&oe=6A5F8873"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thtw_FF4uWYQ7kNvwEvZKw6&_nc_oc=Adq3_2u75w7qH4OImV1Jh9iUZQEejK4Tyc88CsHjTgJvmJxPCABdqq0p_UiO_recfTw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMR2kddko0BYzMCrKN6wX2yv_BPZhu-wPrR6SMWKSuOQ&oe=6A5F6757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIH8TPPBtQoQ7kNvwH__I-e&_nc_oc=Adp6Sys7xlSuZMkm7Cu4q-DyFJxAQLIX4uGh63NHaGpnpJp7A3ie7c_s0Tc1y934yvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvKcfqGWde540K2T_MiqqYREq3RCGFbI-SqBsz_XxjiA&oe=6A5F6306"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
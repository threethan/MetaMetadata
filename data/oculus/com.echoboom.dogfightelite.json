2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APgyqK5oAkgQ7kNvwEtVIwh&_nc_oc=AdrIhA1G1FZI0XxYj1NBCBZa1ShlKDFVJZqf5lhMM28b_Pj2rxunr0C1hktgQDoYgt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXQuGHO0n_mikq-8_uIoUJyfJnexGuiFkmtUs84sht0A&oe=69C90533"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTBDu5EUKKkQ7kNvwEe_-62&_nc_oc=Adr2qr-mE6InO8O9jL46w8iJ6_v0cD_AWhwHX4vg5n--R_8DvE-EQIbW4vr0gPoMeLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUZOE4Ai8bjYlSD4JuNCJi5REMpZMopl4zjUm_-1E1Fg&oe=69C91C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5lz3k4Z1UEQ7kNvwHqaTUJ&_nc_oc=Adp1dTrr2giMVL5sHjseYItV-R1bzSb6SZ3yvQnZKRp5Pm13v83UEFBbb1cT7r3x9Pg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIXGbZqMWhfDLyHKR6TF7_4SXuPHGiLjeOR3v8kDVSJw&oe=69C91806"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUguy1wKqVMQ7kNvwEAteZM&_nc_oc=AdpFFzsmHAt2KRdBUoHaVnqlqqJxyMSvyEHfBqTRhB9AxA99yjsV5XbBaXUX1cizqeM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDveBoVP8JOKTvIfpMEAjJvdB8kxoWC9qdli8s1Qdhx3w&oe=6A5A4273"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzJ1dyyrxQIQ7kNvwHruFf-&_nc_oc=Adpan-P5CrmoRxa7OOdp4kBR40C2kjlfcQSe_Ava6ffI0tS281QS2tgsG4SLDZ9ksT8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZvSFNczFqNwrXW68wRAqHTVOgi5t8qpSidwVG5HCaOg&oe=6A5A2157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pmey6SYKLJoQ7kNvwHizJmY&_nc_oc=AdpJBjFCEFmAIc-EoTcd_WIviXs2w99WOCpN5bfrDv9y15BRiBO3emRWPy0Pyt2ESF4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv1PX7nFV97ToxiitGd91dL_k2OBqIym585gMdVZZmDA&oe=6A5A1D06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
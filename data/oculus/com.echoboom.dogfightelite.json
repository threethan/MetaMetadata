2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GX2rxWELzQQ7kNvwHrd8LB&_nc_oc=Adpi6p-Kjavb7HhqQqeOurfLkJwpi1Hafht1vIRemvq5PchAjorCaQt-dWhmnML9Zek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Oyp04kbf8gnP0g_10ihDDF3-lLWPpaKzkoLVryA2KpA&oe=6A009C73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhMqEOxXAeYQ7kNvwHS2yTC&_nc_oc=Adqp4kpqWwxr0ojsq4uzJfpqY1zW6cqSXTT6r51XXoXKtvOXYU7BQPkjnPt7DU981H4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64cy8XFUK6P-XltJcEKb3jCszqDqcfoPiwHTwmL4R0mg&oe=6A007B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4kgDzIddKsQ7kNvwEbnziL&_nc_oc=AdrCbBcVLPSCQpn3Tkmzi73WrK23d1OMfQLVhFZrsn6a8vkBKWRuUU_l7HZps-6ggmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ODEt_E5vs4JpGd0RIq7aZSRQ3WMXpRV3ofFG_4iLDcQ&oe=6A007706"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
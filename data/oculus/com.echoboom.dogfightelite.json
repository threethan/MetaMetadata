2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0jDyzQ7VoYQ7kNvwHIr3ro&_nc_oc=AdrUfxAxfbk8H4Spwzke_wXCgjZaSDypk1zY0TJ8IbDv-OPpJpc_P1cxs8GT0B-GhVA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpqMJMVjnXxWCpsUNuNC1bg6D4tdzQZgCeAVz30JBYMQ&oe=6A940C33"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-TyrUoj5LQQ7kNvwGw5e32&_nc_oc=AdoearNu0gF0N4jmWkLKohIqityexTlQeYFPM6VybefvFjAPekk1aXi0-JoATJSasuQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpK0ISGYShL7rVih5BIsj3iOBU6FNS6FT9VCfxXSqulA&oe=6A942357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M-rdaiqYvAQ7kNvwEhr7wC&_nc_oc=Ado5_ML9y_kVNxiASahsd4yZGo1W-kN_ifdkhsvP6-BWi0-YEe-kFjd45eGb_hAhfSw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVc47ExcS5EBNvknu8YThRrezeTzqsJOqW6Nb9b7yaQA&oe=6A941F06"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
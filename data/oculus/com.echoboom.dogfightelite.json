2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWJwrNLKAjsQ7kNvwGmPhbW&_nc_oc=AdoLr00mSCboZGXDA3mKDK_5Kur1KkLXqXFOz3MvxgJlQy5U-qTF94_aI5Mafi4NIFk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXDPzV01sNRIITedLYfkWHN0WUDn1pmFV4eroMUTbF_A&oe=6A68C2F3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL2OMFP0qasQ7kNvwHGWqOe&_nc_oc=AdqmJACGRpcLUDmXVL0mLO8TFhRaGtrDJYogbicSYkQmjNo1cvef484zxv3UxUH8wdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtLoNJO24dwflwGx5yy90Xw1tBD00JWA5388jQ-Ao7EQ&oe=6A68A1D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfBh5ZRF0joQ7kNvwFzR8su&_nc_oc=AdrZZ3e5NUTR6HLPSQ88MiQfxTWbo_3AICEwC3Wx_tNj_efQyCTsyV6hZVlAQeEEH0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHUK0UG7s7zN58x47W8LNoWu-1SuVgrPIhzG-EMIWd8w&oe=6A689D86"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
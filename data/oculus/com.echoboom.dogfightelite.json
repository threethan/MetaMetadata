2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49c5GWnUEcQ7kNvwHjm75t&_nc_oc=AdoSzC2yAo3aievxz01awUokD6dDVLnuESwNpqwQspI6RjrOrR-LwoQr7609eptX0bA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0WxcloBhvrzM_9O3w05RfYLTFqm2ttqcZ02TT1YTu4A&oe=6AEB4773"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Idv-PzvutcQ7kNvwGNHLTM&_nc_oc=AdqVNn_kHUBwc0GjBs4lPhyjUmDKxjIxNjFSOpup_f_S4iE95PIiR-s4hpEZGBWlYJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6fMbS8-p-ad7oQI8eIeq_DQn7CoS_FGujj28021AG7Q&oe=6AEB5E97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyUn2JvbAxsQ7kNvwEQ13Da&_nc_oc=AdpIy580EINbl-jUmQhEg7ta6BUr0VYcuIinpDsTXcsBT0BJha8rmFv6npi28HkrGUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYtHSy39kaVDyg7O-RrE3ZvKF5LLK7JMeCt3Jo7g5khg&oe=6AEB5A46"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBx36OQ17AcQ7kNvwEOFW8N&_nc_oc=AdofL4KuhrdGEnpi3ykWBH9vBDfFQ4TCDBxIzfH63lyDPqp1Yq1IKElzH-ULZuhqwDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TM05f1vRuVG9pLT7yAnFZVecE7xHH2ZtcaAlmmB1C_g&oe=6A1D9D73"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHdoYjctDUoQ7kNvwFUnc7U&_nc_oc=AdrzIA3jhlwW2E9PK1NbCpu-hQB2akvpyWBRl49t0mWd7dN-90ZGReVf7EOX25dG2tU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43BsweHPKM0YVg6Lc33lppNEpnAN4use-rbS09xFelGw&oe=6A1D7C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VX_AE229BicQ7kNvwEBio5W&_nc_oc=Adr4VajvdPildjdbM8kENBo-kS3VPyDUK7e0XiiLA_bIP1rfnlFAYyKC33ek4xg7a_M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af682Vh7Qqzh-Dz3VJ9Y7SFS4Rd5xBOMFCu2cVPlsecUfA&oe=6A1D7806"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
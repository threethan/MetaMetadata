2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVQGl1jhV1IQ7kNvwHLzbU7&_nc_oc=AdqRhY1Oyy7Zk4FcOKzC2VoSlh3VB0g7Ly-8H3ylbYacLJo4JJj2GGxRMeFTmf4JFX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9V4t9mS3ywPXwAUPwUeTjh96bluDlZpg3Y-bRE9v5iA&oe=6A8045B3"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiTG16ENHzcQ7kNvwGzs0PS&_nc_oc=AdruA1t4ch5HZT7eYTt5i6PCaqRwoMWNEhq7AZralFU1QjgDFtQGIY8-fhpl5WMpT-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ52f1gOszOsPT4-ypWAxHH0DUw91bqNWQqMWot-Kohg&oe=6A805CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=za5gg30MDMQQ7kNvwH7xGH7&_nc_oc=AdoZe9lRZochHFW3a00boWq_jDWQOtIe6DthgVTMQ6Gs4gNNESOPY5E_dCrlTVxIaZg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNaQYw5bJOa-vLV5NZQRNfSmgmc-KFhMVReXuix4mGpg&oe=6A805886"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
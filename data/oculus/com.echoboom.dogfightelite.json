2618142418142_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPgWjQ-oSiEQ7kNvwFgTYfM&_nc_oc=AdrAr2sNaRjdoxrBppf8TmqjSHJHPtQ24fpCID2rgtEO2pOhg3NsfQN97HEIXywLAjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPalPnYSRADBrlSPMOGXdobIFSpcnb97JOFqI8_vSS90g&oe=6ACE4673"}, {"file_name": "oculus9-2208-1242.png", "id": "1002688936932771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_1002688946932770_784443334179831915_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKvWmKpdAe0Q7kNvwGcHwJE&_nc_oc=AdptnGMWIayRYLm__w-phpj3H1OCfBTqL6_CLe1j1ylMjZpPwimXtcWdpHjihaETAbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg1E44S3fu-lC74jAxIZ-cyLhIbrbKQpHkbaMk7MjECg&oe=6ACE5D97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage2560.png", "id": "1171525093276710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982681_1171525096610043_1669834911006050355_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwePBM3ON0UQ7kNvwFRd7bb&_nc_oc=AdoC-N3hnVXiM2pDnVNjA-UL4Ymp7iV6pPlFOVrdHEvhRe-yweEefw8Ur7DSCL8u6uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYoTxG_heiadGmcn0L3vlXlxpNkCTZqmfjysusXHUt2w&oe=6ACE5946"}, "display_name": "Dogfight Elite", "keywords": [], "long_description": "Dogfight Elite is a World War I and World War II massive combat airplane simulator.\n\nIn Dogfight Elite you can fly an airplane, drive a tank or jump out of the plane and defend your position as a soldier.\n\nYou can also play alone and fly through training levels all the way up to full-blown dogfights against enemy planes.\n\n\nIf you have any requests/complaints please visit www.dogfightelite.com forums.\nI keep track of all requests and complaints and fix them on each release. Write the details or contact me on the website. I will read your posts and fix it asap!", "short_description": "Online massive airplane combats against real pilots, tanks, and foot soldiers."}]}, "developer_name": "
.com&_nc_ss=8&oh=00_AfznJacdwTiN1FLodIUTu766q6EnUA_1R4rMRcw7LIct3Q&oe=69C13EC5"}, {"file_name": "2560x1440minexr.png", "id": "1150084006831203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821230_1150084010164536_4605354266100734916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMFB5z2gX4oQ7kNvwHu8_M4&_nc_oc=AdqQedsJKk1ldZvQxJH88ldhyOrsCajzZiZ2mR6nDk-iM008xNxllF-GqT-dOyYIY00&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3etpVLUeVb7H1r0sXuVJqVVc5h3lflK1OLt897rfp_g&oe=69C13093"}, {"file_name": "508420727_9671596122969323_5754403197443401474_n.png", "id": "1414897462870007", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821028_1414897466203340_2553583324018582400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfxAfvS8qZgQ7kNvwGfTk2M&_nc_oc=Adp8RdyGLgJo2AJtJzQHncdMjNseVkTN4H4xNahWW6T3-hPDTtyExM1Dp9_h7-XqlJg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmmDLO6HUfIKUekV96ccQPMxjq1eQHijoTSqhER-rVxA&oe=69C1281E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440minexr.png", "id": "1525295038876580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821923_1525295042209913_5906530736106686231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8pWrqf-W-gQ7kNvwGXgPLl&_nc_oc=AdpoAkEagvtkz6HGzOMAVSJeX7j6X1r5cbi7WCpPjDZ-IQ632n9pQMPLXo4cUIzcqPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDZcp7jhQ_bbnl3AX077xYZy_spffuXl9WwtxoLY_hRA&oe=69C151C9"}, "display_name": "BREAK", "keywords": [], "long_description": "#BREAK\n\n*Dive into a vast voxel world where adventure is limitless. Team up with friends, uncover secrets, and explore this immersive VR adventure.*\n\n---\n\n## Why Players Love BREAK\n\n- **Endless Exploration:** Roam ever-changing voxel landscapes. \n- **Build Together:** Craft structures, Stack blocks, mine resources, and watch your creations come to life.  \n- **Customize Your Style:** Unlock skins, gear, and accessories to personalize your voxel avatar.\nJoin https://discord.gg/hwamTS97 for events, updates, and giveaways!  \n\n---\n\n*Grab your tools and explore BREAK today\u2014where every block is a new adventure!*\n", "short_description": "BREAK: Explore. Build. Survive.\n\nDive into a vast voxel world where adventure is limitless. Explore procedurally generated caves, forests, mountains, and hidden ruins. Team up with friends in public or private lobbies, uncover secrets, and survive unpredictable dangers in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minexr.com/privacy-policy", "developer_terms_of_service_url": "https://minexr.com/terms-of-service", "publisher_name": "ANY Reality LLC", "support_website_url": null, "website_url": "https://minexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24010828625275623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831000_717320021068249_7667675270103949939_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASZnPwofyaIQ7kNvwFLyF4G&_nc_oc=AdrXtU9inPtncj2UpVWXHV4qMKR-qyG89VXQkndEG2hsW_yhYsrKr898BHsZSaBpxEc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1HxuzpU_jMyb46BMZbVQwobdIIDccWYAepWHuil79cg&oe=69C13EC9"}, "is_concept":
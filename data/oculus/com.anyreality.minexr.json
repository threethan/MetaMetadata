cord.gg/2Q6CY65R for events, updates, and giveaways!  \n\n---\n\n*Grab your tools and explore MineXR today\u2014where every block is a new adventure!*\n", "short_description": "MineXR: Explore. Build. Survive.\n\nDive into a vast voxel world where adventure is limitless. Explore procedurally generated caves, forests, mountains, and hidden ruins. Team up with friends in public or private lobbies, uncover secrets, and survive unpredictable dangers in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minexr.com/privacy-policy", "developer_terms_of_service_url": "https://minexr.com/terms-of-service", "publisher_name": "ANY Reality LLC", "support_website_url": null, "website_url": "https://minexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "10024906764294378"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1234852524953309"}]}, "baseline_offer": {"id": "1234852524953309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751416620, "status": "PUBLISHED", "id": "1234852524953309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24474447535580394", "version": "59"}, "id": "1029338489410991", "channel_name": "LIVE"}]}, 
scdn.com&_nc_ss=8&oh=00_AfxQGCYfQVi6mh6C04EXb9npEu2xJJiXnvheJiLoRkPUdQ&oe=69AAD545"}, {"file_name": "2560x1440minexr.png", "id": "1150084006831203", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821230_1150084010164536_4605354266100734916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYm_hf9j3BwQ7kNvwGgBcgW&_nc_oc=AdlLinfQzEjXO8twEMt_Rq03MZHXEU5WupP1x6lfSZB6Z30X2yDK3zPTtndNavFK6Wc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqszFfIPSk_MNdTN4b8fKIq2eDstsR9VENg0ezKmv68w&oe=69AAC713"}, {"file_name": "508420727_9671596122969323_5754403197443401474_n.png", "id": "1414897462870007", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821028_1414897466203340_2553583324018582400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-hkwkEgTdYQ7kNvwGGXdkN&_nc_oc=Adk2-6aXhC0Klm_DB9ZIBymeGHn92fb3wHs6RM_yCQENYoZdHnFg57XKgpVJTrXpQf8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMdVMOyDZ4HMxfiHC8zvvnoX_EYY1BZP6f2irXsxEjSw&oe=69AABE9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440minexr.png", "id": "1525295038876580", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821923_1525295042209913_5906530736106686231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jDEsTyjfbEQ7kNvwHWENNX&_nc_oc=AdkgWHNC-2xuNFbmsDyJAg0rTO1fbc_rAhc7mc6AWKiJK61PdT0JvQEl0viEqBmcP5g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA1CL6i5JAvPiH3Bp3KRXul-_MseIv77OEwHSKiAzYXA&oe=69AAB009"}, "display_name": "BREAK", "keywords": [], "long_description": "#BREAK\n\n*Dive into a vast voxel world where adventure is limitless. Team up with friends, uncover secrets, and explore this immersive VR adventure.*\n\n---\n\n## Why Players Love BREAK\n\n- **Endless Exploration:** Roam ever-changing voxel landscapes. \n- **Build Together:** Craft structures, Stack blocks, mine resources, and watch your creations come to life.  \n- **Customize Your Style:** Unlock skins, gear, and accessories to personalize your voxel avatar.\nJoin https://discord.gg/hwamTS97 for events, updates, and giveaways!  \n\n---\n\n*Grab your tools and explore BREAK today\u2014where every block is a new adventure!*\n", "short_description": "BREAK: Explore. Build. Survive.\n\nDive into a vast voxel world where adventure is limitless. Explore procedurally generated caves, forests, mountains, and hidden ruins. Team up with friends in public or private lobbies, uncover secrets, and survive unpredictable dangers in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minexr.com/privacy-policy", "developer_terms_of_service_url": "https://minexr.com/terms-of-service", "publisher_name": "ANY Reality LLC", "support_website_url": null, "website_url": "https://minexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24010828625275623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491831000_717320021068249_7667675270103949939_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u7e4bzCcGoQ7kNvwGBbvTp&_nc_oc=Adnlv_-hGKQ2L_wVMJp8U97EoQ3M8sokO6OHwYu4p1e0VpQwXd0-hrDIMxWhG4spW0g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBmtCSDz0UH8y8-3vGWJYU6B1SA_2KDCcWSv69nyGEzw&oe=69AAD549"}, "is_conce
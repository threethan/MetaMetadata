/491821028_1414897466203340_2553583324018582400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSagYjmcbOkQ7kNvwE9yJpy&_nc_oc=AdrXEjjDayjyatuv5lpm3f-jIuDkK6XLl2uvUkkrmY4N2FcrayfbeYF3Vqt_Pptg_-U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCKacNtHqBLVtKeRXyu-yOWKxmgPfkb7rRZ5-HQRKfLA&oe=6A85979E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440minexr.png", "id": "1525295038876580", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821923_1525295042209913_5906530736106686231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AD19D0sJiYQ7kNvwGKCFxC&_nc_oc=AdqDHor4QsU0qBWhYWo1KW_EezBGPUjBVv30K_46f6FxPsONLDv9k_V_m4qB9vvx_fE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3QwzwW0jDtZkg7jcenyrLNRUBzuL4_MID2HNz1BH5TA&oe=6A858909"}, "display_name": "Mine XR", "keywords": [], "long_description": "# MineXR\n\n*Dive into a vast voxel world where adventure is limitless. Team up with friends, uncover secrets, and explore this immersive VR adventure.*\n\n---\n\n## Why Players Love MineXR\n\n- **Endless Exploration:** Roam ever-changing voxel landscapes. \n- **Build Together:** Craft structures, Stack blocks, mine resources, and watch your creations come to life.  \n- **Customize Your Style:** Unlock skins, gear, and accessories to personalize your voxel avatar.\nJoin https://discord.gg/2Q6CY65R for events, updates, and giveaways!  \n\n---\n\n*Grab your tools and explore MineXR today\u2014where every block is a new adventure!*\n", "short_description": "MineXR: Explore. Build. Survive.\n\nDive into a vast voxel world where adventure is limitless. Explore procedurally generated caves, forests, mountains, and hidden ruins. Team up with friends in public or private lobbies, uncover secrets, and survive unpredictable dangers in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minexr.com/privacy-policy", "developer_terms_of_service_url": "https://minexr.com/terms-of-service", "publisher_name": "ANY Reality LLC", "support_website_url": null, "website_url": "https://minexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "10024906764294378"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1234852524953309"}]}, "baseline_offer": {"id": "1234852524953309"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751416620, "status": "PUBLISHED", "id": "1234852524953309"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24474447535580394", "version": "59"}, "id": "1029338489410991", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9810190689099321", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24474447535580394"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1029338489410991"}]}, "change_log": null, "created_date": 1758740998, "id": "24474447535580394", "version": "59", "version_code": 59, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"
.com&_nc_ss=8&oh=00_AfzccoAtAi07Ne513lqFtN3f9wo5mrafGW9V4Wug5RFk3A&oe=69B40FC5"}, {"file_name": "2560x1440minexr.png", "id": "1150084006831203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821230_1150084010164536_4605354266100734916_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boOn1d7NU-0Q7kNvwFmYcu9&_nc_oc=AdkijP389NEXlganB0Q1fheU74moJbvNPSeTkAJTqsCfUgjNh4rwHN5uqt51MNk8gb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxM4lqmWdmdAJBH6CkoTiAF_3Xm9OA-m1iIZXo3PJUKpw&oe=69B40193"}, {"file_name": "508420727_9671596122969323_5754403197443401474_n.png", "id": "1414897462870007", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821028_1414897466203340_2553583324018582400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdkaIokxrdIQ7kNvwEJYGa8&_nc_oc=AdlcfRoW7aGanwn-huhogml59Jk3nA3_Q4EdVBV9Aqyrq9bnjo8Wcc1iZ9rVwk-32rc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-_dylo9sgxsc2HlRZuGC0m9yniUFAWmL4zQulbWm_eQ&oe=69B3F91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440minexr.png", "id": "1525295038876580", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821923_1525295042209913_5906530736106686231_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ms2LBSL22wQ7kNvwHj7HhO&_nc_oc=Adl5q1ERGat-JFAZgadDkClzI9Bl2FkY6i_R-ldRIR5ToNTvDg7VcbhK3S0JLBg-9pY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzBox-oBzlifpiS4i20r3862agKjHux3ZOApN6u2D8qLw&oe=69B422C9"}, "display_name": "BREAK", "keywords": [], "long_description": "#BREAK\n\n*Dive into a vast voxel world where adventure is limitless. Team up with friends, uncover secrets, and explore this immersive VR adventure.*\n\n---\n\n## Why Players Love BREAK\n\n- **Endless Exploration:** Roam ever-changing voxel landscapes. \n- **Build Together:** Craft structures, Stack blocks, mine resources, and watch your creations come to life.  \n- **Customize Your Style:** Unlock skins, gear, and accessories to personalize your voxel avatar.\nJoin https://discord.gg/hwamTS97 for events, updates, and giveaways!  \n\n---\n\n*Grab your tools and explore BREAK today\u2014where every block is a new adventure!*\n", "short_description": "BREAK: Explore. Build. Survive.\n\nDive into a vast voxel world where adventure is limitless. Explore procedurally generated caves, forests, mountains, and hidden ruins. Team up with friends in public or private lobbies, uncover secrets, and survive unpredictable dangers in this immersive VR adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://minexr.com/privacy-policy", "developer_terms_of_service_url": "https://minexr.com/terms-of-service", "publisher_name": "ANY Reality LLC", "support_website_url": null, "website_url": "https://minexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24010828625275623"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831000_717320021068249_7667675270103949939_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fq03ry9JNwEQ7kNvwGR2TxW&_nc_oc=AdmgGoEQu2fJNHca9i1VbseqiZYAMHZo2dDxkbK0FXYUGmQ9RT7HezKYDrZP-voUONY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTsYChQzHEJ9LQSBWLe3vD8NKCS3tPHDK2riuhKzgggA&oe=69B40FC9"}, "is_concept":
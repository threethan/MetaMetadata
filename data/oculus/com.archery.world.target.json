oh=00_AQB61wFyxbp8V6xdduiFAT3EH1LjMuTy2p5YL0A1dCu54w&oe=6A4A6E39"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEWjfWlTFtoQ7kNvwGb7i84&_nc_oc=AdpUUR4tloXD3U0Fm6sa27y2MgHcZX0bjFJuSyGLVCTGCAQ73AlAyaEOpCuNtj6ATM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzfjvX5t-nRVfVmNVZwTMnV_Uk9bAmSG_t1r0jFQnO7g&oe=6A4A5CAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9FFk_RgYiQQ7kNvwGKqryN&_nc_oc=Adqtbbe2wDX6XXab21QInf1Ib-g_Y9hdMm4gxejWcL6MgVN6IRA6dn4K6CFZ1D1bYsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeGUimj7hWfkdWHfKusr1ggV5vTZEumfMGIMWZZgsfCA&oe=6A4A55E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
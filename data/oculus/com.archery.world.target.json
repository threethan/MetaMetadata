oh=00_AQA7mIQ399ia6Fed4zUF7rtC1QNq3g9j7Xzj_ohKkdBguQ&oe=6A60D7B9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JScr6U4vETkQ7kNvwGVbWce&_nc_oc=AdpOdT0nFQzcodU_28QbSEjAQGdwj0BMGSWymkifok4NsTTgAZokbC81zAZ73JtHkZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWhfRoRcJc2y2_3DE2nlLvtblIbb-Hh8feVohjD1lShA&oe=6A60C62D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eExGvAOxqKkQ7kNvwGWdlJK&_nc_oc=AdoE0E7q3IQsmXGCLIwy_XKWlZKMg67oUTRap1dCEriffugyWzJ_EMrLc9QntjTFqN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYGDMIbFa1JD0pXEAE-wvRlSSBqqI47z8Y2sWPnMaL-Q&oe=6A60BF66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
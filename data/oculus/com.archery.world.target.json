oh=00_AQH94aVptrEafU7i2Bk8Dsxm8X8xZbQND3yW___aOhngHg&oe=6A804379"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-ktvKSi-zoQ7kNvwE4ogZ_&_nc_oc=AdqJUK0-9H_0LCsjGcQMLEOm6y83ar9TkrpJjJXjzNIE0AMKsaPEWIjQjItFUiSB4XQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFV2VEIJs6acsCfzn8VEmjUvQSu6xCmV3UF9LlUAAm-Q&oe=6A806A2D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2aw6AyghEgQ7kNvwFwB0Fw&_nc_oc=AdpD77CJ_OOeou-ilgWq2or81pDtq30olY65zYDDTfKWoBqV0OeJbSF6g62OynVmXYY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTOhhlNf038Kzy0uHwX8gbDfiCMhwyaj3yY5y4r_lq9g&oe=6A806366"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
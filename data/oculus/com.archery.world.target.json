oh=00_AQDd55eeLfCO0b7Klvx8R6w-GHZ6yEBhNyGW06kTYNSAfQ&oe=6A6A1239"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2xOLipWWaMQ7kNvwHy25GO&_nc_oc=Adr2-UOOm9VwEDdEawmb8ld_A8UPRWsC6Cgxrc_RwXHl9fBNS7ZyQo55qNveotlK5t0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxvYh-J7s0J97sZTuH9LFxdoGVvyUiWWnXm1IdiRAihA&oe=6A6A00AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR2ThdnGcZcQ7kNvwHaMceQ&_nc_oc=Adps1nAdg6lnYs-BX2RgRG3coMpgpguVeIEWNB1alhsXvL9AuIlH7LgAVo42ehXWfaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-qbvfYBP61bUgK3Xfw2d0yZLn2DNhlKMfDnUJQSKRiQ&oe=6A69F9E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
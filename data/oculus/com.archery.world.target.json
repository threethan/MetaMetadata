h=00_Af7fezJQ5K8YfM7_adQl-l-EGA0bvRCkhwnOs5zjI4WsCA&oe=6A01EBB9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUk2cCcqqogQ7kNvwFOjsQ2&_nc_oc=AdqK8a6Hm-pnbnGmc1yy8qxIPXXw-iNkF9F-cWr81BqXgZxKHQpbVQw4rACS1gcQbks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-F6MAIFLYlMtc8A3SQFl7WMibd-M6L9It4hN2wTwjRA&oe=6A01DA2D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIUUYQpmlpMQ7kNvwEePCQI&_nc_oc=AdqwXIhI1bfPHcA8rjMgofSFUd8wE0H2mDuZRmLb39C8__T3VQwEXilJMU8TsvFHdSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pdHIY-WZIMwSessnGodusxb81HcRPBoA3se7V77k6OA&oe=6A01D366"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
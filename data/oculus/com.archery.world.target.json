h=00_AfySRBno35lkUI6lsy23tDvCBv6HQAtFLki7blFI_ZF42A&oe=69C26B79"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAr8DkgC62IQ7kNvwG92qMW&_nc_oc=AdryuAGRgUu0u5UWwZz0wpmHUX4BCk7Az8iMDHHMD_9wtiCJ3bw73aq6mhIlRD3SGUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoRm3ZItcuoQl0hzWMsf8IB4KUlc1gz9o_h-n5ZsZeWQ&oe=69C2922D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zLKcvMrbIsQ7kNvwEwvuT2&_nc_oc=AdqFbiKeXtEww60Jld1WPItxuIrnIT-CEG3EKOe3QFwEoHi2oCgXQOP-Nohg29UelO8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLXXx3Smr3NZGhYZ_me5lsi2hL4cbcH3R1x-3Q-rdsDQ&oe=69C28B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
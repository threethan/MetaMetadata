h=00_Afz0AAyoGZwW7UbsE9Pj-zljI3-wIH8__0-nITchjmxMaw&oe=69C7B179"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cohKfaKTOMcQ7kNvwFIuyzQ&_nc_oc=AdoUYSFOd6ge0B8eZe1WFnt5YTgrU3fvs9qxEh0k9WfIaHszt43l7SMjqMZ95OZxwOo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMg7Ex1uDQbINXVuNdRUyI5p95XTtpRB7E99yik7I68g&oe=69C7D82D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3i9U_1S2y1gQ7kNvwEUjpvw&_nc_oc=AdpsF-PSvvisK9WJYBfGLLlNdGhGs3WS6Jb1P9cnmqdAS3y3Co0w2UB-YT9AtjaWOV8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6Ap9UC21zP7VubwAZiG-Fo0Ue4ae60A5iIEN3JTSbhg&oe=69C7D166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
oh=00_AQCTHVjaN4MOoKVBOTSYMJ4TC0emqqaF2CXffD0FVQEynA&oe=6A64CC39"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENgflQpCAiUQ7kNvwGwpeVW&_nc_oc=Ado9VR5erEP3zF6HdHQRqNYPhiKex2ML_zPM_2_N_k0CYCbGjtGFPUWt7FkpunreNCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCixP7PVX4psLxv_Q431m3J6479xOdDzLo9Tg_yGlPixA&oe=6A64BAAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m40mHQaJ-BsQ7kNvwEEZzUW&_nc_oc=AdqDiczv1dOeghyhdExizyRgz_nVvREVILFEhH7sah3lxSyGD-Hp6018uY3cVUGu4qI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCANXJ5kL_LaxL_1uHLZj60_F2jo7JODak_wgRhHhPdRA&oe=6A64B3E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCyYwouK_fgQ7kNvwFEq02j&_nc_oc=AdoZciXyF7bvtVWxKcL_hkIxzXP2Pu8K3UV0jmiai9jBaVvZoobaqUaM_CmFCb2rndY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15Um87BvMrl33I0sBYYFj5nvzW_cxffHXqmnuLXx86ZQ&oe=69F2082D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhSQJnca35cQ7kNvwHyCAt-&_nc_oc=AdoeAxCF0bG50JFywQi2YUJkJmCd-7oZGy3tbHl4SbTg2eigLd6acB6kux3n3Nqn9X0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3cQc5e4hjBlfcaMWeEVlBbQHQjqBs4zDUo1uTJeD4pDg&oe=69F20166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torqu
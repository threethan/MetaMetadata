0f&oh=00_Af6uWx0IcfeqlVnF52WDFciHufm1cOZhJROXvT7wSl1zPw&oe=6A11BDB9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmhaCM7MnYQQ7kNvwEJXO3R&_nc_oc=AdpRtwdlXXiVHsRf3OH83bVOI6PRtY_oRZ5jwc7lczcrxBfHCmpYVjdTCuJItxytEZI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pq43ow-oxrWw3i78_1tAUEnwNbrp8KCNjo--s86s5LA&oe=6A11AC2D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hREnzdDhCKkQ7kNvwEAOhYr&_nc_oc=AdrIU2d4aBLb8WxKvgLeK_01CmIpeDaAYPt5SsdTx1mz-lhg2HxZeheMlMwG7DPmalk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ma0THDl1uT_IAUS5HI_t7XxZdB29eNI5M4YvmdVw96Q&oe=6A11A566"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-q
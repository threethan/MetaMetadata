h=00_Af4F078xqhhwhOWIChN-t8uFOiOjIjHi6MpROZ1ujhAf3Q&oe=6A106C39"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okpVs30gCV8Q7kNvwHVQf4k&_nc_oc=AdpxZpy2LDWbSnGeGdrBEKs06CpK1RONuXf7gtL_nefAVjsIi6z7tH0UjmvPNSPZyn4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LiPF_2pnGS6MNqk6qMia7G_Ch6sdzzvqexzs7Z7uvZg&oe=6A105AAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4dH3SsFFZ4Q7kNvwHvNeuo&_nc_oc=Ado1gQb8cLXdywtSoaZbHR4u14VOW5evNvxvBsi7zMovC3Fzxfw-SkFRWGChsj5WljY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KPQXPulk7H8K7xqMnYeYQyaS9sz0_iGgFDVf_0AVEYg&oe=6A1053E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
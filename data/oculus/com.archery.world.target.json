43387_7765966346838941804_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6shY_OIZezkQ7kNvwHi3KTD&_nc_oc=Adq2-bh7N9jH1zhj8I2PdK5fDJmrqgk7EfznBfzgtzWxvS6oV6QOP0Ssa1PYTOA90no&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqeAWQvvaIn985M6iwEagdIfffAfOj-DXagmk-UrmiDw&oe=6B05A339"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw0MP2rIcpAQ7kNvwFRU-qu&_nc_oc=AdrIeJsiTX1GiD5dOhlY_wcsOkcW0sSc8GiYWmabFYqh3PrpC4A0q1AymoluWMBAxoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJxlCY6zADeFD2CCAmtA_SguIQfbv0bCvP8aWvZrF1Zw&oe=6B05C9ED"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nqtd6yV1LsQ7kNvwFg9v2Q&_nc_oc=AdrkR7ybLsa2IWtYMhOR17xi7gC87LI1WjVQHc7-jhK8_pztikvGIDpOxv87VCWi9Vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJsD-llHDr96AQIhy7T2LH7o6kxCGaQL-eiRj5ESxmlg&oe=6B05C326"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_d
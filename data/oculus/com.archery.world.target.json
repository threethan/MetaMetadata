0f&oh=00_Af_OW0Wsi2HveI5sCOM9d-oOuCfOMrIVb0tKi70E2c6s8w&oe=6A394AB9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXZuXKV4KHMQ7kNvwExJVDM&_nc_oc=Ado3zr6X540kjTc6M7K6FeOda8D52SUHjKdxnzGRyawb00MIo76AvMUfucsp2sf-2uw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1iQzuzXDRdLv9xKuiSPZZuw2VAvylts1_2JmT4YQxKw&oe=6A39392D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1IlxvudgtAQ7kNvwECAyFi&_nc_oc=Ado74U1F5AFI-dGNTO13LD2lcGatItau_1qSwi54ja3xzIjgCehySniM_S2xVvrUwMg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mzBUUSFVlHNQLLtxMpRxJOjvIoAngnqvoo4Mn8tY9yQ&oe=6A393266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-q
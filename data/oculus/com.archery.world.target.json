43387_7765966346838941804_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K46rBN78pdAQ7kNvwEuc-9R&_nc_oc=Adqfw6P4-9uyJJfOWYy9FCvwjrUvmO5hW-Y9zwl0SC3clhVOE-aUD6R8lr4S3nOKmhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKAT2lIO7Ym4TtNztZkQqCmCxk3qh884v2h77HUqE8AA&oe=6B0F15F9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wVJMyu48UwQ7kNvwE9HIT2&_nc_oc=AdrGCMqto7CbOAqf2-LemfnRS9cMw8cTB9Rc57m3oV0wl0CNBHGruf5EfUw7bmhuuZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW25mBKKRK67eSrw3XzJML64CiIGcyVpV3gdaOn2aNtVg&oe=6B0F046D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uj2iJTRhQVEQ7kNvwGKLJD8&_nc_oc=AdqJNQVnrHpiMktBVX-TOZv4BMOi4h8J9FX0hQG-TWm_xU1Q578wpBv4qbZFf6O32P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJ_gvBwxglxngfPMEL3mtsE6KrFEALpLr3OTuoLrCEzA&oe=6B0EFDA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_d
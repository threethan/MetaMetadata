oh=00_AQCP0ay5_HDSd22OseG3aax8mWZJYJLMnPe3ly1wCHd0lQ&oe=6A525739"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDPtjYZxryMQ7kNvwG_D-Be&_nc_oc=Adr7zxxSge9KIqaxgOQdCpaasTT8yYEv5Jmg3XA3lGR2D0DJvorRq1TCGxuutnwEfbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzREb4gWVsyf8mK2TVw0WtlUiqo_V-5rinTGMAPlaLLA&oe=6A5245AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It8FPDYsaSUQ7kNvwEEa2Nc&_nc_oc=AdosfL5NiOpZJnriE90BwxApUEDLWLKuluXK8JfrmRQQ4YxQAC4k7XN0V5BO1MbS5JY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxFWoKiVxws1FT6gDHekU_e3c8nGnkA952O1P5KWkr9g&oe=6A523EE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
h=00_Af2wPgMlgUyo3FGVe96cE-fDE_SjSTPSHXq3F_Thhg90IA&oe=69EF76B9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRl5NZPHvG8Q7kNvwFDfSPT&_nc_oc=Adq0oKEVX-00J-EoSqML8JKwvrZSRp4wRaSBKO37HL_iON9D2YXNK7_cVZaCR22aA3o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JSyHMsIho9-4Dnsiwm6_EHscavcTSrrZfUvWg68k-bQ&oe=69EF652D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2Lwfz4mIGIQ7kNvwF6QCuK&_nc_oc=AdquGsLKeyblh8ysWuQ_gWLSwAhZABdEMnik7LN-IgWHUpA8G9k_kCzl62H3mcMtz3k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Lfx1FnduRbpH7on-CqZxz_Hv5i83AJA0l9x7QoYRWCA&oe=69EF5E66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
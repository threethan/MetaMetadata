oh=00_AQF6rx2fWj5akZhh5XL0WRKvZlzOoxvFsnbvzbd28vNmBA&oe=6A71FB39"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njVj7FWa4LkQ7kNvwF39Iu3&_nc_oc=AdqefujK4rhcTP6rZJLybO4Bdb7RqAd0NuzP3jORZxaLUgKo_EOkJODx-H4SP2VSSPA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1olAu_61NFN_pmEUBKdDABAo8tLIHlK78UnuZI-V6Vg&oe=6A71E9AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fsu_ZljXgYQ7kNvwHEG7LN&_nc_oc=AdrwfhajN1x5iXd7loWaWmxXDhSCVHWV4zyO1t4SCJoq4H5urimpVDfxsVDeUz5BTUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6RvcYgY2ZmDg_Q8NYsUOPN0mRqcvend4KX_IvpdDcvQ&oe=6A71E2E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
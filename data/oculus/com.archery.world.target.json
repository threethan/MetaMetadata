20f&oh=00_Af-MCKuXYGfc8wHVhwvoi7I31qACk7JY65xn0U0d0YXZww&oe=6A4679B9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HoFZq0-AK8Q7kNvwFEkR6m&_nc_oc=AdqFf7xsN8Z1kC65fbeXM-sXVJApmYWGEZZmx_59czn08TJ67I82EhkhfeaSxEh38V0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V63p-DMyKxv6W1lprjqZqnjO7OE7jJNPyaIhKW59OHw&oe=6A46682D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yKMH_s37X0Q7kNvwEy9Zq7&_nc_oc=AdpEo-d3lqZFOPAt7DBn-fN9ORlLklfdeo-GZpr3XZmGEBzqzbDc1GjpBPJd7BSP8uQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-17szy0bU9a8F89wPbxGPrXMYtuzJBDM8S_5jJpMsAQg&oe=6A466166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Torque Games", "support_website_url": null, "website_url": "https://sites.google.com/view/torquegames/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24966362672990014"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1018900507753969"}, {"status": "PUBLISHED", "id": "965575785855487"}, {"status": "PUBLISHED", "id": "1424424459705597"}, {"status": "PUBLISHED", "id": "862272200131965"}, {"status": "PUBLISHED", "id": "1530928178144332"}, {"status": "PUBLISHED", "id": "4332792377040536"}, {"status": "PUBLISHED", "id": "1337252164731613"}, {"status": "PUBLISHED", "id": "1952611558821565"}, {"status": "PUBLISHED", "id": "1803490706928669"}, {"status": "PUBLISHED", "id": "811974351391228"}]}, "baseline_offer": {"id": "1337252164731613"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1018900507753969"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24966344992991782", "version": "0.6"}, "id": "4199684760318724", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
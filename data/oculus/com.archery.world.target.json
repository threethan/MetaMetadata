0f&oh=00_Af8Daj7icgox26mMK3LMkd6wQ4qwx8n33jT6yWw5VCfi_g&oe=6A22E139"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJFwbiRliR8Q7kNvwFKzHGE&_nc_oc=AdqfOr1JUCTkwyYYf6-iBGKwTbVbqjUNVUkhof0T7-EDeOkgV3Z-3UUxadRVZViR6Yk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af853gZT__dWEI0O9TuT51zs9lxm7NODRp31NPo1tu7zSA&oe=6A22CFAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyDCt7nRNw8Q7kNvwEQysoF&_nc_oc=AdoF2i5Fktm3k5QRgkVS3MAqCA6sm1fshjuhbDHUd9ROUL0cYsA3gX9dkn90WdpBR8E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RV1T35qgQTjjnRFGF42_vHQUx_DGQb7A4oHzWZOa2hQ&oe=6A22C8E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-q
h=00_AfxAh-dTy8XKUEUJR1jB7RFyyKFQiRmLKD91hwg48aqZdQ&oe=69CE8139"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1olH2ee_NsQ7kNvwHixcGj&_nc_oc=AdpmetZYr_FvfuJBXejVUGY6Dmm7dY0G7tRl3YJNFadNiSIPs_D0Kvx3Q163oANhSGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6-_wELyPKI-7DvyA0ZYzR9w0QZOAwnkLuzCKln2oRyQ&oe=69CE6FAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8jnvgu7A-AQ7kNvwECOGX3&_nc_oc=Adp60v7wHUUOF8B5IItRaNaTrv0pN2bXp4lsCvsTmhrW4IMsnFl7ejdRZMPxYWRJz20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlXN6ZXDF-fPqYSHnce6BFk-AdKKvIk7S9b8E_wzdwjw&oe=69CE68E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
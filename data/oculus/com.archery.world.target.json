h=00_Af50uq57bsJMtJiR28-Yhlsn_Skke2gd38scEtVveSuWLw&oe=6A1C49B9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBDaZKmPLH4Q7kNvwHh3ORI&_nc_oc=Adrz9_g4fo2kHzn-asYg9AriNmAdrjuJGFHuaAfdoUCgwS5iRlnYrrR0vi7cEBVG7Ac&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lfU5sPPt1Gta6zAAe0URPEUE4_wpi_efm6p8rSiZbRA&oe=6A1C382D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDHPAn4ZjxAQ7kNvwEB2f9J&_nc_oc=AdopO057gFhD4EFXwPJ0sNXo31W2FF_1XYpk89wW3UhhGzw-h4oADgJe75PRQuCGhSU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73JN6Js_mVIE-huaNpEgbbUjZrPMlgrLeZEVCw6SYExA&oe=6A1C3166"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
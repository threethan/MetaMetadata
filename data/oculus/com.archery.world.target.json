oh=00_AQGzW1b2EH2vLtR_8TshU3sq6HFMaaCdJKlolsp_SoxZ-w&oe=6A82E679"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-ktvKSi-zoQ7kNvwHp62B8&_nc_oc=Adq9eabgYUCMYB5AlOvrMx1GPn5NbPfjjJe55f3mJLTg8UhlxurxcAeGWf2ZoJ58VlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqZSfZtTV_9iA7dllsM86utKGEQvlG8McQj48FXvZZlw&oe=6A830D2D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2aw6AyghEgQ7kNvwHf_w8p&_nc_oc=AdqjSo_0nEW2A6RTDDtQAoXKoJBGGynx-9du9w_RQxJEzefWlwE6utiCwaJzRqTbtDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3OCFMykwNu31G_KNC0TwazHgjvUxqtp95hDBZkV6mQ&oe=6A830666"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pr
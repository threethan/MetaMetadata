h=00_Af1BAZRK5gT9fZ0-SMpkbFVWJBcCnKU2GhrQvxgRSIWgyw&oe=69F8B139"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4YDywRYrr0Q7kNvwGPwJEj&_nc_oc=AdqsQ29piMhvH09Aqsd6ATUpkkOdsYEzHGAChJGagIQnd5a8kpIk1tZmQkP32VJ8aJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FKS0jBmkB2F8fON-IOIJgfrU50Il8DgDkxmkmrVoQ9Q&oe=69F89FAD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7sz7CVvr8oQ7kNvwHAqtpj&_nc_oc=AdobMNEok6Bfo_gdwPcxEfiDyKf1-yXP4VEnDKwb7VV6I8yhPJ4Jb5MtpQMDkplSnzk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31w0uFfjckMuh2OT3xNpj5INzNbokaPeyCz5doJxPzAg&oe=69F898E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
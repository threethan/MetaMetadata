h=00_Af5zot0oYepeOeBDO-LgkGipdfmKjDdj5UGAogILcod-Bg&oe=6A088339"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oni0rMJ4ixEQ7kNvwE-GeQ5&_nc_oc=AdqHZEdxK9ri1_wm0DDTF3RL9Lg7ugWpqDTbTyCAdqXUOUHYcXbwzG07G_CVDMdL_bc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mBrhikLH7vTqsfmhgvtOwUrRm3PZ7TS7YO6K78uMvmA&oe=6A0871AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWzBSal3g6UQ7kNvwFWDpQ3&_nc_oc=Adr68NvqeI-6_ysvDdyIyINHjVdLknSKlE38yolCWpLXDppQbQS5dgmRP20IYxgKClU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gzoZMj-CfoGC5s-4MYFhRHBRd39fbqdgLaIfwJccGcw&oe=6A086AE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
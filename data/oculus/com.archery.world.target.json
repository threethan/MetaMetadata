h=00_Af2BDsy7wSUV6U6uhAZqringomuDmOn3WolejzwVa55CwA&oe=69E39939"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXFDpVCN4EoQ7kNvwHQ4WTO&_nc_oc=AdonqOw44hTu17B6vbNd6wf9nB6LFALKQlbFXp3PJTQqFvUeIbZKWYYxNLTPkE2ggLI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sHDBwwl1dBCv-wDB8hdQaISBjJBnel5uO5F43UfXu1Q&oe=69E387AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qd1zQdR1nsEQ7kNvwFrtRmD&_nc_oc=AdqK50AcH-qTXqYQ0WmjEMvkgUltH_voPKGFYo1uBWxauyDnG1Zs2UZ7BIVmSF4B_TY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23JviSRoBXzvj9OKju7zgq_NLcs86q9Tsj7Zv12P4A4A&oe=69E380E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
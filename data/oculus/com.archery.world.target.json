h=00_Af6bKgbCWNGqmf497Pz4PPGluC5gz27yvZyXc-TiWqZTtg&oe=6A15B239"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFSUlgMXBA0Q7kNvwEeQaIx&_nc_oc=AdqBfvo0ohGgKNJPbns9XTSXmPBM7-KDZsTskqwcUYrvwkSsnE6Z_2GapNUrlFLsNVE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PsXWnskrQEfWfkWDaR15cHeH_8YoCLCS_KjN5gaNHuw&oe=6A15A0AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MRM59hzWfcQ7kNvwFqhOcr&_nc_oc=AdrfVV5nxXHxiuMN6Si6hrARcScwa3mXihQcctVW8SZMy3WNdc1d2Nod-Tl1nbd6FPo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yMEzyEbdYYv2vANCDbdFUqMwbwv3CjebIeUWgAreLew&oe=6A1599E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
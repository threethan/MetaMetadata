h=00_Af_xijpOYchAwHxhrOhSkTUOnvYSA1eO0lC6AzVJDt33Ig&oe=6A355639"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rm7oKtB4YnEQ7kNvwH2foCZ&_nc_oc=AdrXIQEKUolpYXjCQIRTSveFhCilVINoLjTkBIToMLoZQABXDvWMWwSnCGGviGVqeI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97YJduMttPVY3l4v3uggkWiG7ck4baU9_UglvKfsRAkg&oe=6A3544AD"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sxcY7H9h20Q7kNvwGDGT-V&_nc_oc=AdoRGFEv1l5EHhpRXIiO7Q2l-ZOHoZyvuIB3-BTwWfhBVtjNeNWuqkhjO4fEqD8mEHU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r7O_oGkcS_ERgnYd5m9GJB9EUTWrNKyg3vvL-iFQs-A&oe=6A353DE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_description": "Master the art of the bow in Archery World - Archery Game! Challenge yourself with precision target shooting, thrilling archery battles, and immersive environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/torquegames/privacy-policy/meta-quest-pri
43387_7765966346838941804_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6shY_OIZezkQ7kNvwEqLm05&_nc_oc=AdowMVbORzj-fhN3eJiH5kRM8ShyDNQ6iahIkw92ApagSBGJOeuRG_2OX6_6GiiMK2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYnnZpAVoaOCC-4hZEc47r2eAxl-Cfw68IuPiSW8qBLg&oe=6B06F4B9"}, {"file_name": "5.png", "id": "750408350958726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_750408354292059_3119623694371327415_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtUg5xG2P24Q7kNvwE6K3cO&_nc_oc=AdqrUJzHxtu1aeHrZFMelDf5kgrJGxHWU5K8zvC9-tdyXYVgiOA2kCLwzZToNEgl2z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjRX0PnuZ_NumsRsNu-HNC_sKG2_BxqptGbBmmj8Sf6Q&oe=6B071B6D"}, {"file_name": "2.png", "id": "1315182506894850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824611_1315182510228183_9198081156175562440_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE9jK5S-JNcQ7kNvwFB_Ack&_nc_oc=Ado_hLpx1cqOEmpveKNFEUp6BjTqY6-N8zzTGMumm9ubuhStbF21WXyJVQitaIiIupU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU1rrZKQlyrsY-adUmYh2RJFgWfshkUo4VJndFhmPZrg&oe=6B0714A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Archery World - Archery Game", "keywords": [], "long_description": "Archery World - Archery Game\n\nArchery World - Archery Game is a simple VR archery game for Meta Quest set on a beautiful island. Test your aim on the archery board, master realistic bow mechanics, and enjoy relaxing yet challenging gameplay. Perfect for casual VR players who want quick and fun sessions.\n\nFeatures:\nArchery board shooting challenges on an island.\nRealistic bow-and-arrow controls.\nProgressive difficulty to improve your skills.\nImmersive VR environments designed for casual play.\nQuick and engaging archery sessions.\nSharpen your aim and experience archery like never before in VR.", "short_d
t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND4aFcD0Vzb9Qe4jN_FlDOgUJCyhN9szlOWxz1-URWHg&oe=6AD397C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_16x9.png", "id": "1474975919658561", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974801_1474975922991894_7357733858609626292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=140imsveVEsQ7kNvwEHAOHm&_nc_oc=Adov_2Yoe6a5v9ug2xh8BWN9ZuXnNOoL8w7-guzt9wTINLSQ_K5TN8CRmqBoEy_cwwM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDVyLRJS0C76G1DaJy2LULBzZNO7ipbdcuh5gSMMa0Gw&oe=6AD3B577"}, "display_name": "Whisperer", "keywords": [], "long_description": "\u201cI don\u2019t know how to tell you this, friend, but it seems like you\u2019re a ghost. Not ideal, I know.\u201d \n\nSo begins Whisperer, a puzzle game where you play as a ghost who can only interact with the world using your voice. The story unfolds over three chapters where you meet Bea, Harold, and a cast of plants around the greenhouse. Bea is in a bit of a rut, and it\u2019s your job to help Bea and her plants thrive. Move pots and plants, search high and low for seeds, and talk to Harold for clues as you learn how to interact with the world by whispering. \n\nWhisperer was built by the Meta Presence Platform Voice SDK team to showcase the immersive power of voice interaction in VR. Depending on how much you explore, the game can be completed in about 5 minutes, but we think you\u2019ll spend more time with Bea and Harold.  \n\nWhisperer is also available open source on Github (https://github.com/oculus-samples/voicesdk-samples-whisperer), where developers can use components, patterns, and interactions to build their own voice powered experiences. If you\u2019re a developer, we can\u2019t wait to see what you build using Presence Platform.\n", "short_description": "Whisperer is an official Voice SDK demo built by Meta. Experience the magic of voice-based interaction in a cozy puzzle game where you play as a ghost who can only interact with the world with voice. Help Bea and Harold revive their wilting greenhouse plants and bring a touch of greenery back to the world of the living!"}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2364609513706249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974624_440977738250419_578609578882866934_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofeG32QoB5gQ7kNvwEZSUJU&_nc_oc=Adp3tvXIxD6-llC9TWdhkvRM1Bg9IHyZd2lBpMjkNW2sunWAEio5bflfoo9Z_bKpruw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsOQGIEYVQ_jqGiXWvycItyOmIhx-Kk3KH7zXWKjDVyg&oe=6AD38A9B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Whisperer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
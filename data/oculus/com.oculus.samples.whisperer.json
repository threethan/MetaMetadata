t-sin11-2.oculuscdn.com/v/t64.5771-25/38974732_1609949216125444_6370600110399930997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jhwWFVo1fgQ7kNvwGLoo7Y&_nc_oc=Adr_m3jY0D_AMuRKS5YoNnuOGR0Mcvm0EiZhr_8i3rBfu_vdNXtwtFq1jxCmFKViiv0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhXRqRVS_qnAtPmTxVyD86isUmI48pZy1F3VyIVoTtng&oe=6AAE8C6B"}, {"file_name": "image_016.png", "id": "456343950028361", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982547_456343953361694_4392573593047902639_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQkJlHaHlsgQ7kNvwHRWfyH&_nc_oc=AdobpeK4kmm4PBNX9JMpd-S1scsOLWrDfk0Y2JRO2Zh3ru2WJHZis4cc1bLLmAIAcjw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw602xPqx_4s08-Z3wTTf4LtgQOLVyhkjcmrYnxY-7tA&oe=6AAE97D9"}, {"file_name": "image_026.png", "id": "1318729472033264", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001658_1318729475366597_4454476999421490346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8nIhCzqBL8Q7kNvwFrDCtU&_nc_oc=Adr-gl_yei6ctgAzA2aQb_M152mSwm7wfp8vUlITktndBdIQTDKu9APzWpUyOu7Sopc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq_HY6oqDhLMHeKXQnU_ScYq_1BV6cMG8g2Lh6yIs-VQ&oe=6AAEADCC"}, {"file_name": "image_044.png", "id": "957240745256049", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974519_957240748589382_1300468230644607753_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6pVVfjx9hUQ7kNvwF4z0VK&_nc_oc=AdoNnVHrkA1TsEvweY0yfrXQruhJmuj328qRe44yq6Y18tCJdf8Cb5r-zGI6541J2iU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuotBw7INyX3AYSm-sOzoP3W2VmycCMhFk2ehkAve58g&oe=6AAE855C"}, {"file_name": "image_083.png", "id": "5695265910509774", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974866_5695265913843107_4470281280224547628_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1Zyn79t9zIQ7kNvwEEwEzI&_nc_oc=AdoR2cYv582cgLcU6WE30WQL3Lt7eWbdzSyOkUXNUSC6EbZb6ylKfur7C9ky9fNTCJw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqjpikX6wLsE4RY7xf-tHccaS8-jB2sCI9lwh3lEYrxg&oe=6AAEADC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_16x9.png", "id": "1474975919658561", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974801_1474975922991894_7357733858609626292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72o5zeFruwQQ7kNvwEfxBvM&_nc_oc=Adp2osx0dzDj5eA86cETPftyd5M2JZmKaU1m7hKaJ4bAou1kpPeVDIKz-vrdFE2eF5g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl3V3li10_27VFgQQJYDWlM4G7zzNcxnDBbcFNk8Fc4g&oe=6AAE9337"}, "display_name": "Whisperer", "keywords": [], "long_description": "\u201cI don\u2019t know how to tell you this, friend, but it seems like you\u2019re a ghost. Not ideal, I know.\u201d \n\nSo begins Whisperer, a puzzle game where you play as a ghost who can only interact with the world using your voice. The story unfolds over three chapters where you meet Bea, Harold, and a cast of plants around the greenhouse. Bea is in a bit of a rut, and it\u2019s your job to help Bea and her plants thrive. Move pots and plants, search high and low for seeds, and talk to Harold for clues as you learn how to interact with the world by whispering. \n\nWhisperer was built by the Meta Presence Platform Voice SDK team to showcase the immersive power of voice interaction in VR. Depending on how much you explore, the game can be completed in about 5 minutes, but we think you\u2019ll spend more time with Bea and Harold.  \n\nWhisperer is also available open source on Github (https://github.com/oculus-samples/voicesdk-samples-whisperer), where developers can use components, patterns, and interactions to build their own voice powered experiences. If you\u2019re a developer, we can\u2019t wait to see what you build using Presence Platform.\n", "short_description": "Whisperer is an official Voice SDK demo built by Meta. Experience the magic of voice-based interaction in a cozy puzzle game where you play as a ghost who can only interact with the world with voice. Help Bea and Harold revive their wilting greenhouse plants and bring a touch of greenery back to the world of the living!"}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2364609513706249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974624_440977738250419_578609578882866934_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiya9HyuLe0Q7kNvwHV9fha&_nc_oc=AdqKjFMCvTkTxE_9jNIqqFlBljgJfpgWQCuBnqJymPMrvBtLr5R7ApEBfwDgGYAB5oI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWs0UjRIcsg259s0L-yMVnvofE0pPHWWmZz9akudPhdA&oe=6AAEA09B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Whisperer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_
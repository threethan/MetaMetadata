t-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHpm_w_RxsT8LBegVnPxdOdskFy5AYNE6bZPqNV6PYdg&oe=6A984447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_16x9.png", "id": "1474975919658561", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974801_1474975922991894_7357733858609626292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSsr8VgXRfAQ7kNvwFM1x4v&_nc_oc=AdpM21BIVSypbcW6IxEs3IZM49koFkrQMSz-XPSMAspwekrlLpC-15xjUVcJoOiFYtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtT758AKSZU9Men2TWiyQ8LoyxvhR5XhHk_s87WSySEA&oe=6A9861F7"}, "display_name": "Whisperer", "keywords": [], "long_description": "\u201cI don\u2019t know how to tell you this, friend, but it seems like you\u2019re a ghost. Not ideal, I know.\u201d \n\nSo begins Whisperer, a puzzle game where you play as a ghost who can only interact with the world using your voice. The story unfolds over three chapters where you meet Bea, Harold, and a cast of plants around the greenhouse. Bea is in a bit of a rut, and it\u2019s your job to help Bea and her plants thrive. Move pots and plants, search high and low for seeds, and talk to Harold for clues as you learn how to interact with the world by whispering. \n\nWhisperer was built by the Meta Presence Platform Voice SDK team to showcase the immersive power of voice interaction in VR. Depending on how much you explore, the game can be completed in about 5 minutes, but we think you\u2019ll spend more time with Bea and Harold.  \n\nWhisperer is also available open source on Github (https://github.com/oculus-samples/voicesdk-samples-whisperer), where developers can use components, patterns, and interactions to build their own voice powered experiences. If you\u2019re a developer, we can\u2019t wait to see what you build using Presence Platform.\n", "short_description": "Whisperer is an official Voice SDK demo built by Meta. Experience the magic of voice-based interaction in a cozy puzzle game where you play as a ghost who can only interact with the world with voice. Help Bea and Harold revive their wilting greenhouse plants and bring a touch of greenery back to the world of the living!"}]}, "developer_name": "Oculus Samples", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2364609513706249"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_440977738250419_578609578882866934_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOWGNUQzdHoQ7kNvwHkepgg&_nc_oc=AdqcK9jPRRO1TODENrpVJzUuwhhZUMX1Wy6MdVS1XhXXwWBFZOe884GJwsRJvjJgAVs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQFTTMc-M4C7-vrz18WGEpOfItBq2-f0iLzrNrmYpCOA&oe=6A98371B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Whisperer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date":
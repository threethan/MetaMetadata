ntent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_1388371622492609_5448293961662863390_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuJVkHFkGQsQ7kNvwF3Jszs&_nc_oc=Adoj3Skj3APopn0nbe8ZazYPV4KakZqdfEctei8m7Fp0wPcpmZtB_5Tb4eQ1xp7e_eE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxkPKxfxqZaqsSD5HH5U3Q2vr2L17bvb7yC82aTkS2CA&oe=6AA17AB9"}, {"file_name": "Main Game_Custom..._23.01.2026_19-59-08.png", "id": "2065461417584660", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823837_2065461420917993_2281402334548919839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYrEQ1u0aWAQ7kNvwFCa3CT&_nc_oc=Ado9ZBMCrOJDA3S0R5lPOzXJI27wIcvFJFNCi-9D7lDHjougvBwtQ-mKcHVwvWF_f90&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKArq5elUyLJaPBrA5374ErZ_8BnVssJ2z8L_YMuyAEQQ&oe=6AA17CE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimporia", "keywords": [], "long_description": "\ud83e\udd8d WELCOME TO CHIMPORIA! \ud83e\udd8d\n\nExperience the Gorilla Locomotion System where YOU are the controller! Swing, climb, and leap through stunning environments using nothing but your hands. The game that feels natural and exhilarating !\n\n\ud83c\udf1f MASTER THE ART OF MOVEMENT \ud83c\udf1f\n\nChimporia revolutionizes VR locomotion with hand-powered physics. Push off surfaces, build momentum, and launch yourself across vibrant worlds. The more you play, the better you become\u2014mastering advanced techniques like wall-running, precision jumps, and speed boosting.\n\n\ud83c\udfae KEY FEATURES \ud83c\udfae\n\n\u2705 INTUITIVE HAND-BASED LOCOMOTION\nMove naturally using your hands to push, climb, and swing. No complicated controls\u2014if you can move your arms, you can play!\n\n\u2705 MULTIPLAYER MAYHEM\nJoin players from around the world in competitive matches and casual hangouts. Make friends, form teams, and create unforgettable moments.\n\n\u2705 PROXIMITY VOICE CHAT\nCommunicate naturally with nearby players using spatial audio. The closer you are, the clearer you hear\u2014just like real life!\n\n\u2705 STUNNING ENVIRONMENTS\nExplore colorful, hand-crafted maps designed for maximum fun. From sprawling forests to futuristic cities, every location offers unique challenges.\n\n\u2705 BEGINNER FRIENDLY\nEasy to learn, hard to master. Tutorial mode helps newcomers get started, while", "short_description": "Welcome to Chimporia,\n\nIn game you can find a lot of maps and funny things, \n\nHave Fun time playing Chimporia"}]}, "developer_name": "KJ Company", "developer_privacy_policy_url": "https://sites.google.com/view/gorillagovr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "KR99", "support_website_url": null, "website_url": "https://sites.google.com/view/gorillagovr/chimporia", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9123125381098800"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491827585_1218587719662599_1389168339045218370_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnNpOntj_-sQ7kNvwEARGCL&_nc_oc=AdoRNLs8twzPW4J_Mchw0hihFK500m61xCznoMyuTSvPJipPZ3V7z8FiJYAnvgO5FoU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-IAkGh_51Pvuk78_Py74LwLI3DNI6CFO
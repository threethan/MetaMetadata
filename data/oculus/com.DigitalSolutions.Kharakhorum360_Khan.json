content-ord5-2.oculuscdn.com/v/t64.5771-25/75411992_1535566847008981_2636883334712767973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Azb7fYKSO4cQ7kNvwFcpNXz&_nc_oc=AdrkXLRHxHSigGFL8hE_D29l57vcwxzpmvOWyv7zlY2HfhkUbPHZmM2GPzSQSv9gynQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW4CrIOkUYzRo1XTm42B5T7CGhHfnW-Kc6bPFu9RJvHA&oe=6ACE4F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZjNcWGVrScQ7kNvwFO-RSe&_nc_oc=AdpW1r89qQkDfG8mP06N2knUx5CfuSg61M1RBNn5Dd20X7sdPNVAx4TtiTyuJtZs3l0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyYrjU5WbzHTg3CaTy-5G35fWn3FBTL4eRRV9FityV3A&oe=6ACE4335"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalso
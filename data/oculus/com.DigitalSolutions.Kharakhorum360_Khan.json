7a0a&_nc_ohc=QB-qIOw7ehsQ7kNvwG8Mu1S&_nc_oc=AdriofhZ4PX9Pg0tDBzFo-JXnF1_LxxKqTj_WZ8tfuHJMTW9BFmaJYjTe8iX6u_ASh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SX_IsHYFnG2X59kiZlgBoUfIyf-EELKiOBV91Cr1ztw&oe=6A1EF7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mxj2ixEd3XcQ7kNvwHXdZJF&_nc_oc=Adr8W5MoS74cT7i9yab28sAPNKORAj4svGAHd3CRl5KLN1baBzhN_hcjP8_8xay_eus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BO4YOpc0veTuSN508ALmQz_0oy3r_V5OdiPYUQNvvlw&oe=6A1EEBB5"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url
6e7a0a&_nc_ohc=BP2pZ0p8-nAQ7kNvwEPsZpA&_nc_oc=AdquJVenTh3z7oI6K4xTgYw4zsacKjXv2Lcfssri_3GlBbcLWAkDZJJynXhMydYPxnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVn63obeIhLWZEYHtrc2Qnu0TZFOKVrpK62LhFCFqKlA&oe=6AFDAD07"}, {"file_name": "bshot3.png", "id": "1535566843675648", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75411992_1535566847008981_2636883334712767973_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrTWWrsoo68Q7kNvwEJNfwh&_nc_oc=AdrXvPwzST-8x0lPa4_hkk-_f7b9Nv8gbT6UdLbywJmvLlFCwNxbyCQJVa-89SIPN40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw5-LtqZu9NP798vqk-t7cWs81Tbmb-Zc4BNdROAB1hA&oe=6AFDC526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8roYYLRV78Q7kNvwEnHXok&_nc_oc=AdpbeN6g3hnz1snQZZOqIvH6nGs7XYMQfIUXFXIlBT4TctQi3ch5_nwPSxV13xivWs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc38kCi2Um9ylGWRv_x-Uq9HPD2vtkuVfBjBr4LmlZBA&oe=6AFDB935"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7305380446181485"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "359726216662990"}]}, "baseline_offer": {"id": "359726216662990"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1704844127, "status": "PUBLISHED", "id": "359726216662990"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7305494996170030", "version": "1.0"}, "id": "746251790281710", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7292119277507602", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": 
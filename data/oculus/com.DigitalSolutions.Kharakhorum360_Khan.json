content-sjc3-1.oculuscdn.com/v/t64.5771-25/75411992_1535566847008981_2636883334712767973_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG-X534cZaAQ7kNvwGEkbtE&_nc_oc=AdoMqTiCVLrXXTPmZcrwsoVEHPSsn8wYLJOzYAfkmLPeAsfhSr1vewsCSk6lKwsLIng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFfW_hb2duugUlBavrVK3euMP9cZPycEeWAc3UJDEcLA&oe=6ABE7D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4F5I39Uqn8Q7kNvwEIlwdH&_nc_oc=AdqHti6oQ2f33zUKbc1wwZq5Y-_AMyB1zWW8EtaOPVYvYt6imMvi95GeLEPwnojU2UY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS3Z1K9_dUDNCnDdhwFu717o-ppATW3fpm10ckRXVgXA&oe=6ABE7135"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalso
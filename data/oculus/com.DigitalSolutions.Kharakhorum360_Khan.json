7a0a&_nc_ohc=0ZMWiKR6uLIQ7kNvwEoQuFJ&_nc_oc=AdqNdhmZPhSmrR-EouEDngJWDCOIalu02QqFAqYSvTAMDajFb4XGLNOse6hKugVftvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECnjwWLvn8PaW5mqiLWmzriOB48DR-RUv-mPnEBSOvDg&oe=6A7713E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jKd9zyaFtgQ7kNvwHk3GCO&_nc_oc=Adoez-2o618IjaJ52637Qc6TpK_9O3CForJ5zL6di1hETFk3Tzz55PH1btHz9ZxXatA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_0cvlPLsT6UMvNwaKnP1waAJHfkIKexQqOR3nz16FsA&oe=6A774035"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url
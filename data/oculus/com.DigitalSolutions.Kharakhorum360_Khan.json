7a0a&_nc_ohc=qRMljtItK5YQ7kNvwH-PAwL&_nc_oc=Adq5hci6SpxY4c2QuF3CCaiVX3vHJ2h1Yiqo_8f2G7WSvmE6IkPmP9ZuoLj4Ea5sTjo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c1Nx44uCaQT_t6hzB_aXYRJRgvD_bwtefTASifEEkvA&oe=6A05EB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kzddpvHFKQQ7kNvwGb0xOK&_nc_oc=AdqBQ3-7LVsprP_eri3-VxoKk2KvYojavdLrtlDM7ZngNZ7CKVzAtQyqSQfYt9ZHWG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nX03JU48nAEXk2TIdZgO0qqJGJiQJW9G5Tnt7nPitsA&oe=6A05DF35"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url
7a0a&_nc_ohc=IBfcpcuYO0QQ7kNvwGUfQ0p&_nc_oc=AdoCKLrEvW9MA4nQlfS0FFfGUnNswwm2atc7S8AykOIym88n4bxB5QTTqSys_nDinLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDGiAn1Xq9qizjS8z2GYwPdU4EyfQdzLmZNsOgFNuqeA&oe=6A60AA66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJyF0bAIWYsQ7kNvwH17hVa&_nc_oc=AdrgnfmjTNBj-K8oOyB5ZeVRx1h-FOUL-vzrM-0dhHSmqNOylbWKXi4t6o_CGEZxGtc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3W-g-fqPeQXSgpwv9B6I8O4kLQHkKmlSPMQY8eQo2qw&oe=6A60D6B5"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url
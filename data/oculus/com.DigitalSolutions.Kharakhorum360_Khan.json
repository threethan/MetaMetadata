7a0a&_nc_ohc=2JM55YwHOyYQ7kNvwFLO6J3&_nc_oc=AdpnLuV4Km1h9iVr5SmUiQ7dN0rSWm1wu6HCaf8rvp4AUY0dYb1yJ20aCcYjJ4QKAXY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PRtMgqtcPM48wr1VM8hHyXlQfXzOMRjsxvAMHCe7KFQ&oe=69F8BC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "871658514641386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036687_871658517974719_6702317068533553966_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH-5PnCtsFkQ7kNvwFiVYrs&_nc_oc=AdqfGLw3j9oJVnE2LsPa0krsM6MoS3M18udFHtQfJ7aEVpnmpQz1RzTqwcztLgsIlME&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-Yn7JBHxvZn3L2Hsc9yojQ99BlXhkDV6JfnrUo4Fxgw&oe=69F8B035"}, "display_name": "KharaKhorum Palace", "keywords": [], "long_description": " This virtual reality project, developed by professors and students of the National University of Mongolia, is based on archaeological discoveries and historical facts. The VR city aims to promote and preserve Mongolian national heritage, history, and culture. It serves as an educational tool for university students majoring in Mongolian history, school children, and foreign tourists, offering a unique opportunity to explore the way of life in Kharakhorum 800 years ago. The virtual tour of Kharakhorum in VR, showcasing the King's Palace and the city's architectural wonders, is a testament to the city's status as a hub of global civilization, housing 12 Buddhist temples, 2 mosques, and a Nestorian church, and attracting travelers, officials, nobles, and scholars from Asia and Europe in the 13th century", "short_description": "The \"Kharakhorum King's Palace\" app is an immersive experience that transports users back in time to the ancient capital of the Mongol Empire, Kharakhorum."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url
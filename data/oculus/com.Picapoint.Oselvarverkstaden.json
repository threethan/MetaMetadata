 to VR.\nLearn about the craftsmanship, history and how an Oselvar boat is made through you Oculus Quest headset!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oselvarverkstaden.no/3945-2/", "developer_terms_of_service_url": null, "publisher_name": "Oselvarverkstaden", "support_website_url": null, "website_url": "https://www.oselvarverkstaden.no/oselvarvr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nb"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "442569660905705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203626_1745605399182894_3563552544482690573_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZO-HT2DpvIQ7kNvwG1_kXC&_nc_oc=AdrNt0YM9qNDEAB-qPs-YMPOXYOw5CIsgwEdVOTKRzP5egNKvojROC7l0hPM0E7iw60&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT04tz2E4xqpsbBHGCyWxnoolc8wEEqqlf4ll2ZO2b4Ww&oe=6B0B3AC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oselvar:VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1680043735, "lastRevision": {"nodes": [{"id": "102208998995677", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
ng", "id": "2591224791383742", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312267_2591224794717075_6723205673847928828_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS_Pq2PL8vUQ7kNvwHUQFPZ&_nc_oc=Adrm24oBbLrF301-lCRE6jaKmXBMLVoS_RS61z9mttQ73apaklyXo-PeZEGTqRe2Az4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuxDnneOy8i4gBTTZfT1QVCfGjg2d8B6Ni1yNJCGbrhg&oe=6B0EECD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OG Scary Baboon Mods", "keywords": [], "long_description": "OG Scary Baboon Mods brings back the classic Scary Baboon feel and adds community mods on top.\n\nMove by swinging your arms to run, climb and jump through the map. Join multiplayer lobbies, talk with other players using voice chat, and try to survive (or become) the baboon.\n\nFeatures:\n- Arm-based locomotion: run, climb and leap using only your hands\n- Online multiplayer lobbies with voice chat\n- Classic OG maps and gameplay\n- Extra mods and fun tweaks to play around with\n- Free to play\n\nComfort note: this game uses fast arm-driven movement and is best for players used to intense VR motion.", "short_description": "The original Scary Baboon experience, brought back with mods. Hop into multiplayer lobbies, climb and swing with your arms, and run from the baboon with friends."}]}, "developer_name": "Alex", "developer_privacy_policy_url": "https://sites.google.com/view/og-scary-baboon-mods/privacy-policy?read_current=1", "developer_terms_of_service_url": null, "publisher_name": "Alex", "support_website_url": "https://sites.google.com/view/og-scary-baboon-mods", "website_url": "https://sites.google.com/view/og-scary-baboon-mods", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED",
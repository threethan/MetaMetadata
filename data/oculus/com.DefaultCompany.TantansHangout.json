&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AK7aEGTU5Jkws8oPCqfHbo3RrFwqjPAVYKov6dDBJig&oe=6A11AB2E"}, {"file_name": "20250320_165042623_iOS.png", "id": "1310861046797907", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391964_1310861050131240_3300872046382292371_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LtCpW-3JlMQ7kNvwH6lIqH&_nc_oc=AdrwHYUrg13Npk3KXVTNOuxG8XhW669h-GLsHqcB7JCeNRn6PFUVJsU6XCu0taNo4VE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aEqlVUKk-lmV_eQLzTbynUbRe0s4jmmm4pufEx4zd0w&oe=6A11A03F"}, {"file_name": "20250320_164905646_iOS.png", "id": "981954553909375", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473392182_981954557242708_8453515098750018782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3D4iwlETBEQ7kNvwFPkBqL&_nc_oc=AdpDJCdEfCKQZEo6IryHRhqkkFWMo-sGNGm64spNftBKim9xIGyCcqsS3LjsZd-pd8E&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UEkcBK9sWfk0oSTQruF7EOpZIQV8hVOADx6v2yDHNFA&oe=6A11AB05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "erydhft.png", "id": "1514510216562515", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821919_1514510223229181_7500493830052816293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QXwtsLp42YQ7kNvwE3ZOs7&_nc_oc=AdqI00w1S3YhgccMeijPcy8D71TM9XHnvttwbbbvNPN98_RcNzx8yQ2nKDeZnntX5fA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EO_2GeMgfe2L6Ehnp0Bi3wIbEKRr1HmuzyFvcf4d31w&oe=6A119F89"}, "display_name": "Tantan's Hangout", "keywords": ["Tantan", "Tantanvr", "TTH", "Hangout"], "long_description": "Tantan's Hangout\n\ud83d\udc00 Created by Tantans Creations\nTantan's Hangout is the ultimate VR Gorilla Tag fan game where your imagination runs wild! Whether you're looking to hang out, play spooky horror modes, dive into fun roleplay, play some fun hide and seek with friends, or build your dream world in Sandbox Mode, there's something here for every type of player.\n\n\ud83c\udf10 Multiplayer Mayhem\nJump into 10-player lobbies and vibe with others across public or private rooms \u2014 you can even create your own custom codes to play with friends!\n\n\ud83d\udecd\ufe0f Customize Your Rat\nChoose from tons of cosmetics in the in-game shop to make your rat (aka player) truly YOURS. Pick from hats, accessories, and more!\n\n\ud83d\udee0\ufe0f Unique Game Features\n\n3rd Person Mode \u2013 See yourself in action!\n\nPlayer Color Customization \u2013 Be the rat in any color you want.\n\nQuest Cam \u2013 A built-in camera mode to capture your best moments.\n\nSandbox Mode \u2013 Build and create whatever you imagine!\n\n\ud83d\udc6e Active Moderation Team\nOur moderators are friendly, fair, and always around to keep the game safe and fun for everyone.\n\n\ud83c\udfae Completely Free to Play\nThat\u2019s right \u2014 jump in today with zero cost and start exploring everything Tantan\u2019s Hangout has to offer!", "short_description": "This is a gorilla tag fan game where you just hangout with other players, and do RP! This game is by the gorilla tag content creater by the name of TantanVR. Please be nice and do not be toxic, racist, sexal, online dating, etc. Have a great time."}]}, "developer_name": "TantanTC", "developer_privacy_policy_url": "https://sites.google.com/view/tantanshangout/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/tantanshangout/terms-of-service", "publisher_name": "Tantan's Creations", "support_website_url": "https://sites.google.com/view/tantans-creations-helpcenter/home?authuser=1", "website_url": "https://sites.google.com/view/tantanshangout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
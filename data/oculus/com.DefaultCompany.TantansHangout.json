scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R25KTe_IGnF0aiLeg-LOadbg1q02oYH0wYpQf7nwLCg&oe=6A0DB6AE"}, {"file_name": "20250320_165042623_iOS.png", "id": "1310861046797907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391964_1310861050131240_3300872046382292371_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKZWoNINWf8Q7kNvwFjBU4h&_nc_oc=AdqitRlfa33QTlEdoBmBj_OBY-I3oM6b60Jm1jXSojS_vj7WcZOnksy7K6ZLccTMHZg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ys6mKEJqTKJT52m4Vhx6s6kgGQlmAas8EMmT9E3r7fw&oe=6A0DABBF"}, {"file_name": "20250320_164905646_iOS.png", "id": "981954553909375", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392182_981954557242708_8453515098750018782_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW5YVcKmH4UQ7kNvwGIkjtm&_nc_oc=AdrzcQY3fgF-zkZVI7szMPyd6jkN8cNQpjpXuALfQ2KCh-RGgzB6wmV4VtaNITxduk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hNOxi263rfvV6F4P3kj5HdMn3J92uhBEoWd74K_sZkQ&oe=6A0DB685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "erydhft.png", "id": "1514510216562515", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821919_1514510223229181_7500493830052816293_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2g4WOKJHmYQ7kNvwGs9S_a&_nc_oc=AdrHwp0vD9MqEvQDZtHnHTg_mAtHn6yiv0FSxPujql8PCOVNCShGneHFcNPYo66ROOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59wuMW4ogIaR1g1UK1Pu8GFtDQJe5vAB_qnyYhBySBlA&oe=6A0DAB09"}, "display_name": "Tantan's Hangout", "keywords": ["Tantan", "Tantanvr", "TTH", "Hangout"], "long_description": "Tantan's Hangout\n\ud83d\udc00 Created by Tantans Creations\nTantan's Hangout is the ultimate VR Gorilla Tag fan game where your imagination runs wild! Whether you're looking to hang out, play spooky horror modes, dive into fun roleplay, play some fun hide and seek with friends, or build your dream world in Sandbox Mode, there's something here for every type of player.\n\n\ud83c\udf10 Multiplayer Mayhem\nJump into 10-player lobbies and vibe with others across public or private rooms \u2014 you can even create your own custom codes to play with friends!\n\n\ud83d\udecd\ufe0f Customize Your Rat\nChoose from tons of cosmetics in the in-game shop to make your rat (aka player) truly YOURS. Pick from hats, accessories, and more!\n\n\ud83d\udee0\ufe0f Unique Game Features\n\n3rd Person Mode \u2013 See yourself in action!\n\nPlayer Color Customization \u2013 Be the rat in any color you want.\n\nQuest Cam \u2013 A built-in camera mode to capture your best moments.\n\nSandbox Mode \u2013 Build and create whatever you imagine!\n\n\ud83d\udc6e Active Moderation Team\nOur moderators are friendly, fair, and always around to keep the game safe and fun for everyone.\n\n\ud83c\udfae Completely Free to Play\nThat\u2019s right \u2014 jump in today with zero cost and start exploring everything Tantan\u2019s Hangout has to offer!", "short_description": "This is a gorilla tag fan game where you just hangout with other players, and do RP! This game is by the gorilla tag content creater by the name of TantanVR. Please be nice and do not be toxic, racist, sexal, online dating, etc. Have a great time."}]}, "developer_name": "TantanTC", "developer_privacy_policy_url": "https://sites.google.com/view/tantanshangout/privacy-policy", "developer_terms_of_service_url": "https://sites.google.com/view/tantanshangout/terms-of-service", "publisher_name": "Tantan's Creations", "support_website_url": "https://sites.google.com/view/tantans-creations-helpcenter/home?authuser=1", "website_url": "https://sites.google.com/view/tantanshangout/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "821934236779161"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "in
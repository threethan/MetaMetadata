GIZe9U5pijdgBzp5BGBHANiqN6gBRuACGpryiQPU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvebh4rAAVl_IPb-t7PnmSxn1uebV3QcEjwnqUdQSGfw&oe=6B085516"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8KcFi9LlZ8Q7kNvwGN0bOS&_nc_oc=Adp2aRejFZm90nlr47_YUiu6fete6sJCkrkurW73u1cxb8XUsXbqbSn_l0MeM5L-1P8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJH59IQSm0pke5aWAAfuEp0bC_ZXqAHYKPxrEVINiZVQ&oe=6B084C16"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXPghByTNqIQ7kNvwEmCzpV&_nc_oc=AdpSB8FkJjncKq0JtEbKf8dyKMO10El1s9xVoSkn0KykakcNJGNNs1szMiMJeGHfFzc&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbUoOhoNQyH68e25atLWY1MBo6d1AYmpIHP34Q37GsWg&oe=6B083DE1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6QgQdYiJiwQ7kNvwHeAhN3&_nc_oc=AdqpQKXfKGUCKRZnzddo7g1MsrQsVVVnidI-6nwDdJrzyEo75QA6FzNB6unjSxvtMG8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsVfzPyQZy6X1tLzJspX0DGKTrHnuT-oj1KRpR_8wxDA&oe=6B085AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2FPTCK-oQ4Q7kNvwGohtxo&_nc_oc=AdpScD1w_Zl_zFKS4LiLn8BE2sWThE6znXYJSR-uzWkx2JUWToWQl_tbzPtEFbJDH3c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHZyh2uKIdlTG0BzYP-K_EyfDD0z2kBpthHyU3PV0rLg&oe=6B083E1B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
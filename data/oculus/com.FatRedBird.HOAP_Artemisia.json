.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ytp3shTPcrQQ7kNvwFJt_Qj&_nc_oc=AdrxDOrYkYK5RWK6k3LegXXYEUmnOWWrf_EzlQ6UBzprNpuwJ6lygz2RrdFAme3gfys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRN-6UHen4_mz83jvJlPF3VddaJkbEK53xIFv70ZKMvw&oe=69CBD5E1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAUUyFxFUJQQ7kNvwEiOpp3&_nc_oc=AdpSVhJHpBSSIz69gpDNttxKPfmMf-afX_M7pGhEhxuO6Grrr-cUc1hcNjyhQQbFwvM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV6XxyKYyJTjRFd1ZPWjHW_xsfYJlNgpRBJLDtLUSTfw&oe=69CBBAB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A7cWLCj-9oQ7kNvwE-Dr5G&_nc_oc=AdolKrj1aFt5jkNE_Y-K0Y6hUniDTPUAofnMEJ5iCDYck0-nLQyqu0ff3yIVmfpB2sU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyxt9N46vTM-wu2GS5eh1BbMlg-8MMMmg8gH63l_EsXNg&oe=69CBD61B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1575755259462627"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1668438460326730"}, {"status": "PENDING", "id": "868156001395060"}, {"status": "PUBLISHED", "id": "372758421519191"}]}, "baseline_offer": {"id": "1668438460326730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1694549993, "status": "PUBLISHED", "id": "1668438460326730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6630703373664401", "version": "2.1"}, "id": "9113049495562
BmovyV-FYmuOPACM61W9F0t_r74Rkp5pYMu9XJyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTM2C_KcxYwPXJoUbuhoa-9fH103lobQ1QxW2Fowt0o3w&oe=6B0DD356"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fF24_WcfAkQ7kNvwGC-Xo1&_nc_oc=Adq0QkKLYRP39m3E27BuPutzRGHmR8jgXksC-RgVCINv7Tg3VfaKYkcwkx1edwKOlaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBBnqba3Wtyd099kTNAKCzEBO6hz_kUGKC40pmQRw-4A&oe=6B0DCA56"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af51pmEO4y0Q7kNvwHb57oV&_nc_oc=Adr52Xmu--EOlaphhjdOKQKqRnbQxpXstY6Tj-998pNr69Fvn1OsdvEz-6rvpq4eg-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqmmCgvNA7wdKyego3eEIQhc8h6yHV4mMBXX_NVG7IPw&oe=6B0DBC21"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmNydhsd-0sQ7kNvwHRcyHn&_nc_oc=AdoQd_cxMsUMf1KPVHW5YHrQVbdOxP61ZPwVYzN7JNpYM8RFlRCPshOT_0UhsDUaaN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTE0Xu10IiZigvkWePrM06Db4UrJ-aHESbgeTXT8RHiVA&oe=6B0DA0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMTQ1TuNu_0Q7kNvwEx5K2Y&_nc_oc=Adr74i-cZxaYNVVo7BV7CJ0CYh6fkv6HOKiFkNVBFCuEeGg8HW9HrMksmYjoJYfbDGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC7vwyolDMdiaDnAm1ciV-cGElAoSFHsrBOxYROFN6bg&oe=6B0DBC5B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
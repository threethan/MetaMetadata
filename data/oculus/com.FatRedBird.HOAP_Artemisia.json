v6E3LX2fKLrlEPF_VDGoSKv7OjLsETj96y7u50nM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlPX70VgCNG2mfvqtk5dkrgzw-EGiVvXgRVcvWoYLj6w&oe=6AFDC916"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA1hR0yBh5EQ7kNvwGrhR8T&_nc_oc=AdrBe5Co_Ut4EvcjjnDZgB-hWEjJZmag_GBloE5WFuAfKeFnJXIXVQi6jNzbbIZePJA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR01Hsawz3IjiwxPE8xJ6wknG3F31nrjBl9wJfcawLHcg&oe=6AFDC016"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAN6ucEZC94Q7kNvwFkjehp&_nc_oc=AdotLrmJGtwgIHI9hDcMohe3vlZoB1Hg191HDOsM875AcNeMzym3sCyewGnuojTqMmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDHs9ZmN95lE4sdxlo4gXHu69KMGTmAVCG9tBqEk6qng&oe=6AFDB1E1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFnIsewz3GUQ7kNvwGuUq9s&_nc_oc=AdrBGb4axqVAekbw0cxrdnvSQLSvfP1zl_u4aUqn5Ol9hybV00SJCpbkLflvDJ4vmi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGv7rfPkPMpBj2MiOmov11N60Un8-t_8MQPP7S06XLBA&oe=6AFDCEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZKNLaKqzjYQ7kNvwHEuYOR&_nc_oc=AdoNC4NU2qjp7gxi1KHRJOvU0XLq4R6u6y_AKnzLY_L7zlD1bBFPfQAGqBWSqNvfkqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9iJtnrWt5kDtNPpxZBMwt4wiEhVxhbcWjJhLxg7P0Hw&oe=6AFDB21B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
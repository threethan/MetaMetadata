wr-Gnq_NKpHbLAi0IP_AozotQXUx6ALfgD3lCuOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQElvjfq8XJulF6Vp1ppyWz8e59c6VJ1mIaY-vIvMj3gQ&oe=6B006C16"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA1hR0yBh5EQ7kNvwHl1tHi&_nc_oc=AdpUY9Rz3iJjGjLKoR-yn8jccOvbmzoSIZ55J9vnSE6w-tmhOlrESWHL3JBgB66-pxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSptPQzEQHLXJT1BCfU8fyp961G4kugjNZVdRgGDi21A&oe=6B006316"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWxYv4K7QjIQ7kNvwGsIc_B&_nc_oc=AdoHlWFEseTOivTgr2Cv5IDMeaNWnz7HpqtFkbG_8WzdAtxI5AXAjV6ha7h963dShxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcW-i-_xbw5Ue3ntQcMvSLuqKrEPN6QzbVVi4lksYNbw&oe=6B0054E1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_5T29H2XjIQ7kNvwEjXVcA&_nc_oc=AdoVBHEur5al7mjm2wBlU0pL7OoFLtO-UqwAsVFfqmtmGLR9OoRU7Wsb0h9O_fUbcFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaO1csrUniASToBfDefdmtL8Eem2cIENG_grlQKyaxjw&oe=6B0071F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQkriR_1D30Q7kNvwGnWVrf&_nc_oc=AdozMk9zd--ND4P6PLVOLhum3ACPjtyJJutdY5MHDbHMhIwg2pjn_I6HSQUmdpchVTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiUnn-YV0-tAA54ZJpXXp1yD738BUCK39mfcJRDf6Kgw&oe=6B00551B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
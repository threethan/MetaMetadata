.com&_nc_ss=7f20f&oh=00_AQQsTlX_lxfbjUWSewA-8l1WGf7dxWzo_6Vj548r7mEUVA&oe=6B046096"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5rBG8RrLtIQ7kNvwEu_A16&_nc_oc=AdoD5ZKpnmy93CeTtLE_x6uqj27ey2vB59LlfJ4hKau5IQBGEMPPHsBrN_zwfwQqVrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrQdgG_LFa3JGQtp4W8ojUUGtEyVMxCLBq4Ws7wxKGqg&oe=6B045796"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMQVXxcMZZQQ7kNvwH4VyZv&_nc_oc=Adpz5l_MGK-cpn7vdAAJG36dod6oi3l6N3JQz7YfIP0Nra2WdqYBGFRkD0iYWEGxrYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAlFC7_6v2_xJ3zv4t02p3QVtbYWqx3g0rMmGloZHnuw&oe=6B0481A1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr6-xh2X3MAQ7kNvwFWsqjr&_nc_oc=AdqKx5VYWchsTiGPJOQlLGfgb0HGJ56FWVF40M98Q0V96JU7jkm9ShCy11vB58DDf4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVUVBVJbc0CRzNDHTiUIS_39JMnipwdVNa689d9VFUNw&oe=6B046677"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzecT4JVxBQQ7kNvwG785tq&_nc_oc=AdpowXLayjm61kiee6MKNTz9i7grTc8BIz_PiOrFC_GzbMaJI9bgUQKnd4oUdr4td5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCna6ezZDJtprwxqZ4VyLEPgsZMepxeKp7qRwha_Ad1w&oe=6B0481DB"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
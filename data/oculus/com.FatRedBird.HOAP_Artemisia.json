=1-7&_nc_sid=6e7a0a&_nc_ohc=qqlm_yrQS04Q7kNvwGWyy0T&_nc_oc=Admoszc7unixG8MewQhzIv2ov7YBoNi_xsKrf96wKruPZJfV-kqzOSJpEGUBFfhK_8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzz9i2JN1pakaekwZj5PBeXOrVi0JgXRcVX2UT_1xU7bQ&oe=69BFF861"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXdX5s9NULoQ7kNvwFdOGIg&_nc_oc=AdnNPlivrxd62GldgQIFucINDt0dExi1VETt-6P3ETyJYfjSmV0Oo3lUX9tZHm3qKqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcXlRkvs3EfYttJgTiMVrzhBOPhXgWc2kXP3IniknvRQ&oe=69BFDD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpnV23EMY10Q7kNvwHTV8rM&_nc_oc=AdkP5TcXQqkOGGWLRJMseeBiP7clnv4pL16KD7mYpdWIrMKtM5e-ynOI0D_xC974RMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6Uie8XXAVcRdChCtnrV7DAHm_ky0TD4DvzTrk7MmtcQ&oe=69BFF89B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1575755259462627"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1668438460326730"}, {"status": "PENDING", "id": "868156001395060"}, {"status": "PUBLISHED", "id": "372758421519191"}]}, "baseline_offer": {"id": "1668438460326730"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1694549993, "status": "PUBLISHED", "id": "1668438460326730"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6630703373664401", "version": "2.1"}, "id": "911304949556262", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typenam
gA4zO8SDjet0qfHamY2vKY90QWBWwlM4Ft2TykHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk6g4MNw37vuBgmEi_2IGrNQ14Wz1OL7nE2YFZehkY7Q&oe=6B01BD96"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5rBG8RrLtIQ7kNvwGED5Lq&_nc_oc=AdoHwIHjjPYubwP1vvEjIQUBl6qxRwfsK6r-suds9Enl1wnCUdtxlFjF4_AKRrGKIDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2oeu1qcBvpsby8bSTBpwdMQtfeLTa8DU8RomihAYDBw&oe=6B01ECD6"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWxYv4K7QjIQ7kNvwGfJHy-&_nc_oc=Adpo9Ddk7TSZo-ibDktxcmDIDLgOl6skquQFFv3dfKl-H7owKBZAu98aBh64ZtT1dBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwImQ9rUg_tAPN3sro8KshwWjMPkbkTiX3cvhcQqqocg&oe=6B01DEA1"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_5T29H2XjIQ7kNvwERPMeN&_nc_oc=AdpDzKskjXN5AI1iyDsVCRs-YLwL6wjUJbaQEYapCXIhlPqdZfrFW9or1bQonRvMPRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuKN-F-ikQZnUCOdLheFo-A3wkaoBkmuVqc_p8aRQuEA&oe=6B01C377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQkriR_1D30Q7kNvwGUISvO&_nc_oc=Adqv5PnLnMCHjlqVIDnomCFO3yEGBos1o5NODmX__hguKrIDibNI1nOo-nkq3ySRSSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS16MUtwmjeR5T4CH96kmMDa_xI-pt4Dd-5vEnSkUIK3A&oe=6B01DEDB"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
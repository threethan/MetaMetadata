mG0A9vBe5WIiUuj5G8YJJB9784FIlKTWfdYWLnf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjLCrofaxzcZiuh2_wTaMTRVa4_-bBMenjIPUxfbjipw&oe=6AFF1A96"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA1hR0yBh5EQ7kNvwGkDlfX&_nc_oc=AdpoHdYXOTvX5qhD0JwkT0vSUY2hb8MpCdNDwi8W7oRQxgfdpXRSd81zbWiTrJbfOxQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcpFwelt1Ua6e0JLk-LMssg4Z__mrvxq3DPiWXpM_a5g&oe=6AFF1196"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWxYv4K7QjIQ7kNvwG4wN1P&_nc_oc=AdoR8bT7REMod9maUqvPflAbFn_riCc5l3lCmP2eeWqOxH0Uc6P-oHgR-tdVWsTsHEg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV-7TJWv8chNJqLxbB22Hm7lzrMCjrGcbcm4l_CFH-Jg&oe=6AFF0361"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFnIsewz3GUQ7kNvwGwGF42&_nc_oc=Adpn0IpBGE0UbGlH_XAw5H8cxjtostunTyspiU_FUpuoYG70OEsc1KYSFXAXKcG6UoI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8mYmTI3CY8WtvYe_woWchwMzosmlIVoSPRX5EpXyNrw&oe=6AFF2077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZKNLaKqzjYQ7kNvwFPZFpN&_nc_oc=Adrgz1iqH-UvPPWAIGbUHufXg7QtR8yI9WC5zlboP9YurjIzB7HvLs4oPuT07XpeA-Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpTS8zv6w8n0ww8ap7GiMCnKdhbdzXoaZdOLSDMJuJIw&oe=6AFF039B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
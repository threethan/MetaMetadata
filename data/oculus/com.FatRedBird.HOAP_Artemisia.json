t2pe9IWb1_7RhRfidvxlgaDLUuABDYn58lULYSzw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQriccHSBvnFH0kTd2ac34eJI2qlysuRziOxAuanEb5Q&oe=6AFC7796"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mscJ-9o-c90Q7kNvwELq8DO&_nc_oc=AdqsqkyW8klkdLQ_bML4Ne6-v6ShzJt2j0CUhSDK78P3NgOlK5wmLNeZ_owcirssfTk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6NdKmpYTFPgF2I8NoEWAFrz4YHWI-i3gqfTzrzx69Vw&oe=6AFC6E96"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAN6ucEZC94Q7kNvwEbpQ-h&_nc_oc=AdoX6gDSadBKeslg9mb0UJ5lnSO3nIZI71MtYu58Zo8yLl3PeKhlK98RU9dvF3Ty6Tc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCfmRJcbAx_fZMdJxdUED3fsqoTcpELlAwUPxolFDi9w&oe=6AFC6061"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFnIsewz3GUQ7kNvwGBwIS5&_nc_oc=AdooKhrMCOgkuqF53pnm81bNlYa7yHhQ-S0PZRoO5x5Agmt3pb2-hF47QIGm2cOhfxY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUu6gWrApJ_-9g9M62em4O5dYalba2dd58spU-eCAQZA&oe=6AFC7D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZKNLaKqzjYQ7kNvwEl8Iip&_nc_oc=AdoSTjLPLeYOR6BLoWhjRIbXxHTD1vHx_L0eXg2rEZm8WH1Vg3YluxVXH0jiZr0YB_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT36rYHFltORQOa47kp3Qmv8zWWtyumy7l2atrflyKyPA&oe=6AFC609B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
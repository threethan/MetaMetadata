yOOpaYh9324-yt7PV5Wi8_LOSGFrKwE4gsfGO4o4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkXOxQt-Za157bkSJjX0InVGJqiuHWWGOUBWH2Q77rzQ&oe=6B05B216"}, {"file_name": "03.png", "id": "1381505952296133", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8KcFi9LlZ8Q7kNvwFEQH3C&_nc_oc=Adp6zwMiJfyPTeJTl6Fv6kSvr4-nNPQoDwUXZ17eheLlW_V5RflCOvhdaSQv318r3BQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiaXzwdjWRG14K9zxJ8LoO2OiomxqSiJZQL6sSMJ4xgA&oe=6B05A916"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMQVXxcMZZQQ7kNvwGy7kMN&_nc_oc=AdptnHV_2g3HulfdvQ8ikXnPIgicTLgUePI4A_PU5jhT1NTlaYlmlAVMe9lxlRisq1Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCXHaMhHfL3etgZb1BM8HEIKm9OyTFRbEFmplj976_qA&oe=6B05D321"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr6-xh2X3MAQ7kNvwG3-fJs&_nc_oc=AdqC0t-KEQmvp8t5mWtv0CeRAmLdEKBIX6yXP1psv6cYJWCN-l-iiZQVcLqUVD2AGTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhmyZQdDl4HSGm3DlWWvNtfSXYraoUz99hc0xgkzX26Q&oe=6B05B7F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzecT4JVxBQQ7kNvwFELrQQ&_nc_oc=AdqyNigoIa5frqpChQSRduassG2oOwG9bZ_AfJVFeTPwWjUcfgwvCu_MFVKCA4-fSQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkZZEQ8StsHX06hLef3wqdx0Fpc6Mz3BhM1CyYVDlvcw&oe=6B05D35B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
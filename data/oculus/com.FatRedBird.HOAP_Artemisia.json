5771-25/38982535_1381505955629466_2967005279853885115_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNtNZVAdKFwQ7kNvwFSBzRU&_nc_oc=AdnDsqQ4Jy8WB3UWncTsxYqzBAEOtCL0B5vkvnyxabSf2E_LWir4veyB1HACsIYe9Zg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMSB9KuQqLmVQLT-8ZE8Cpuq0zoydOfRtxiby9e4AgYQ&oe=69B54256"}, {"file_name": "04.png", "id": "3089141321405611", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035386_3089141324738944_4856569391505471458_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vmh3Xs7WNOUQ7kNvwEtpfOF&_nc_oc=Adl5N736GOl2bA9Q3vF6mkOQ9ajtok-RyOzmv0I4vmfDcVPhlzTMsP8kt-GSVqS13D8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwH1mIxJDNQY3PHiUCNa8vueZaolmA6sui9Bn1MEVWgUA&oe=69B56C61"}, {"file_name": "05.png", "id": "1433526053764657", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031610_1433526057097990_3602149113657224182_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3WX9cJtOiAQ7kNvwFeO1qS&_nc_oc=Admdmmsaf-XxF3ereSah1nfwKD-ausL_EjEm5eybZufrlUDsADXn_Wm6TrkJsyNJB-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy5sjm2G5u8JjhnKWyNuE455rZPLXRzwlNwRHDx2cMphA&oe=69B55137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "680947166669746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974798_680947173336412_962573008308668399_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZz9hWDPaWkQ7kNvwGHt8Zm&_nc_oc=AdmmbrZ8LmpL7I5O-idJWT-ZWnCl81Ej8J7btbFLyGJNL2ewWZvMllI2IEqjuDf29GM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQ7INE6iiueCGZnn3Q-cdGtZnqkfH6FGv1msBcV3fQCA&oe=69B56C9B"}, "display_name": "History of A Painting - \"The light in the Shadow\"", "keywords": [], "long_description": "(Hi)story of a Painting is an animated 6dof VR series aimed at engaging young audiences with art by creating intimate, gripping and relatable experiences focused on the human stories behind some of the world\u2019s greatest art and artists.\n\nNarrated by contemporary creative influencers, each episode uncovers themes from the artist\u2019s context that resonate with contemporary life. \n\nThis episode, \u201cThe Light in the Shadow\u201d, explores the extraordinary story of one of today\u2019s most celebrated Baroque artists: Artemisia Gentileschi. We follow her extraordinary journey as she navigates a time and world where women have virtually no rights and are essentially men\u2019s property, and becomes one of Europe\u2019s most celebrated and in-demand painters of her time. \n\nArtemisia painted herself into posterity, she was a feminist at her core and this story is about how Artemisia rose up against the odds and impressed the whole of Europe with her talent within her own lifetime, and continues to capture our imaginat", "short_description": "A journey into the art that changed the world"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.historyofapainting.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "HOAP", "support_website_url": null, "website_url": "https://www.historyofapainting.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "hu", "es", "es_CL", "es_AR", "es_CO", "es_MX", "es_PE", "es_PR", "es_VE", "pt", "el", "tr", "it"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "859263369178388"}, "review_messages": []}]}, "cover_square_image": {"uri": "ht
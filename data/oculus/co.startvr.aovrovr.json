yA&oe=6B0080BA"}, {"file_name": "migrated_image.png", "id": "295080401465571", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162737_140144479911840_4121170877431676928_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5sR_-YhCGwQ7kNvwERZvkA&_nc_oc=AdrKA6DdGSrn2-ilCMQGdaFZOR-NmdwtNp9y0zn9jVJlZUmm7g1Ut6BJQTzvLbPsd4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTduzx0bVWpMLqqjsrdc-OHvK8ZAZugQAHnF-qVzAH9LQ&oe=6B00892B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlas Obscura VR", "keywords": ["travel", "adventure", "explore", "atlas", "education"], "long_description": "Featuring incredible imagery, fascinating stories and hidden interactive gems that will transport you to the most amazing locations in the world.\n\nIn Season One you will explore three fascinating locations, with over 45 minutes of interactive adventure including;\n* Winchester House (USA)\n* The Temples of Damanhur (Italy)\n* The salt mines of Salina Turda (Romania)\nPlus, unlock up to 50 fascinating virtual articles with more interactive content and adventure to be released over the coming months.\n\nNOTE: Atlas Obscura VR needs 2GB free to successfully install. If you are having issues installing the app with an error of 'download failed', this may be due to not enough free space on your device.", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before."}]}, "developer_name": "Start VR", "developer_privacy_policy_url": "http://startvr.co/privacy", "developer_terms_of_service_url": "http://startvr.co/terms", "publisher_name": "Start VR", "support_website_url": null, "website_url": "http://atlasobscura.com/vr", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIO
rated_image.png", "id": "555439058412268", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162683_1904383453143300_892432944990257152_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6XaRWEOJSwQ7kNvwEDaoju&_nc_oc=AdpcZJ8mYZu4uIXy-Od28vXQJsvgGE02uP0-jlQvLW25cGSPGzM2RGbDy460vcEBtoM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlh0MTjoK_gjVoE2ZjZk-NS794P-0L07yeIuumO7QOrw&oe=6A8D80D9"}, {"file_name": "migrated_image.png", "id": "714070476066685", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162708_183955155466373_4736147333077532672_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ0Y3zu_GwgQ7kNvwHMr21a&_nc_oc=AdqjKKrk8kWzLTumUe0KjkBbNCS7P-pHcXK9wRREV29kPm_GXa8s02SnnYKbww_Wvbk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdx8--uEemKnWwEm_9AZLVz91iXq6iJU4iY8CK_Q7uNQ&oe=6A8D8468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Atlas Obscura Video Launch Trailer Cover.png", "id": "1427415490638956", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162711_1427415493972289_67943732627898368_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qNCCebV73AQ7kNvwEs7i_s&_nc_oc=Adq-yLE8_VtJA8gSKXJL6xttggqNFdOiha94ZcMaN3IXe2gzzPTHUxH1jmVHfDqlTUw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGIvn5valA36qc0WvsP0z6QLC0nI4TTqty7VRh58gc5Q&oe=6A8D8144"}, "display_name": "Atlas Obscura VR", "keywords": ["travel", "adventure", "explore", "atlas", "education"], "long_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before.\nFeaturing incredible imagery, fascinating stories and hidden interactive gems that will transport you to the most amazing locations in the world.\nIn Season One you will explore three fascinating locations, with over 45 minutes of interactive adventure including;\n* Winchester House (USA)\n* The Temples of Damanhur (Italy)\n* The salt mines of Salina Turda (Romania)\nPlus, unlock up to 50 fascinating virtual articles with more interactive content and adventure to be released over the coming months.", "short_description": "Atlas Obscura VR is a brilliantly captured, hi-fidelity, self-paced virtual travel experience unlike anything you have seen before.\nFeaturing incredible imagery, fascinating stories and hidden interactive gems that will transport you to the most amazing locations in the world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://startvr.co/privacy", "developer_terms_of_service_url": "http://startvr.co/terms", "publisher_name": "Start VR", "support_website_url": null, "website_url": "http://atlasobscura.com/vr", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EXPLORATION", "CASUAL", "ADVENTURE", "EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "971112166840652"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2787431487983929", "version": "1.5.102"}, "id": "1697615470539961", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1433607290033029", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary",
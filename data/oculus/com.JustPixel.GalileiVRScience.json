=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaK_ptPZ8tg5MjIslv9gYpQMOo3gAJRjpgJ710eyvGvw&oe=6A917A4D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLtIFh0dWV8Q7kNvwEa4QRB&_nc_oc=AdoAwhWZDlywqxz4xf3TVRE5GidpBcmoCgrGMWMLiRaQasygo07gFSio38K3NaIF7oE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy-hMj-rScw9CZyLo3nLIAvhf2bpmwbAg2-Cq_ftFwYA&oe=6A916FE1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2q4HQz2JWMQ7kNvwFlVHzC&_nc_oc=Ado-HoCyFCTl1KE4OX-ql00rRexmeB5sGPEO3oH_NQgrid5JRJqlvV4fqk7DGnm1YWU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbYc585JmCfg4g7dY1WGttdvIHDtAo_LCIjJi5YDTFzg&oe=6A91845A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=114oQyoJ5iwQ7kNvwHNOYKT&_nc_oc=AdoEjiFKtLjGIMImA-MHZvye8AGUvsTjYcuq-2EvkQNAerQBfgRLjCGtwSmDSd-TNxQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEqy9uB1nvDv_tzbUsTx-b0F3w5HV2E1sfNoyjgFnbRg&oe=6A9176F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOruKkmPY60Q7kNvwGF-7nl&_nc_oc=AdoOs6BF3bVTbkI-e0heTnfiLdp4UDTPNZr8LMHJHqNbSgXOZTbkOA38TrxuYhY6hqY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCzEI_omYQXKbq-T2K5yCz3fZr-NzjtpKIcz0qpsI8Tw&oe=6A9168FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.
=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKXqXXNCmQhSNP_HLQQtp1cK8cpuo1G6X8LzkPMQWWOA&oe=6AF09E8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRzuWzP4SAEQ7kNvwG_HCpO&_nc_oc=Adr65YycPLmR2n1bV1S9yEZu5LX3F5NIo_pUhg7kxcognLOhIlhG09K06f7m9Yw2_6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1r7MI3TABWLGdw6b4mgHWaqPQmaasRR-zEF0ZGhopwA&oe=6AF09421"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fsAswE5jgcQ7kNvwHEmmUI&_nc_oc=AdoPewwoZpStsLARkGjMjnSzy_mMtqxFXnWMvyHlHFN6yVmhYu9uXSTkmM3p7tGIgiA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVckD7qOUffenNwEVrsassFMSdQmAnb2ZIm1WIS50aVg&oe=6AF0A89A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx1gLBvif0wQ7kNvwGuD9GJ&_nc_oc=AdpkxIoC97izmO7T2WapszWQDO5nnELlV0rM-aEy_9l2jZbjnEVV19Tw2tXiE3B0C6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpArmnlDIHB5Zm3KjBwFAkvL7BZWkTJldtiYuHb_ZYFQ&oe=6AF09B30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTJaXMCBvjcQ7kNvwGiALnV&_nc_oc=AdrpvAMj5ZbBaLYVXWRCHXp3bqxbmSxP3eSiaZWk6yNkqK0_hjH2SduemRbe3DBibM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0fZo2b-_EtEYTYZyOeDvQRsVhRPt9K_AlSqiRWdzQ0g&oe=6AF08D3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
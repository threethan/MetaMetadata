-7&_nc_sid=6e7a0a&_nc_ohc=VNq_huIowXwQ7kNvwEkGlJS&_nc_oc=Adk1X8RAGaeGtELP5lOkve2zxNUnbuTzofz-mwpbxBEP1Cap6-pV_SfadHCdhxGpM_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs60pl1limTOZMsf8ZLYodGaICNRoybhQdFc43Rl6ZztA&oe=69998D90"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4SLcxM6Ly4Q7kNvwEgOCSM&_nc_oc=Adn7vCvDcKH_3nzncn0UasrPT9P_W9qDpqfiO5oBrONouyqS25ya4H5Rau8rxZq3em8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftymaIqG74BAi_qoOKGH_oXmXUGMkvFHTRPgnzXJevhUw&oe=69998D24"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BsQKu47a0Q7kNvwGSRq6U&_nc_oc=AdkFGDsWfy41elo5savgN5s9PI-m_xIoAu_Lcw5do64A_8pJKlSqkPWpyM4N-HzISb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOJs0qF4dCwkvDYQtdyDNVpNtpgeIp_IVrFAM6Jl0pzw&oe=69999145"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_xOp2UEy0QQ7kNvwFlUsmu&_nc_oc=AdmzP6lPrmlv2OWkqurdI4H6vPDiUvbW_xulqlGffqJ6jb-hZyhnLwWzTfJvDChELH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvriNVrGY3oRzVU7og4eKmGIhoZ-_YDsHV0nijrcDpTbg&oe=69999EB1"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKoLVxL617AQ7kNvwHHaWKF&_nc_oc=AdnNDGSeuuN3WQVRgJ_KzVe
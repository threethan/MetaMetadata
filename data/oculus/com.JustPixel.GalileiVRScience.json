ZU9-Rw&oe=69AC040C"}, {"file_name": "Artboard 4.png", "id": "481654227990009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031353_481654234656675_3114596455803752280_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtUMoGRkU2QQ7kNvwE7edHX&_nc_oc=AdlL8FB2By0SK61RYFYcVr-oASpO8mRWccgN7AFQ0ndbPw2LuJj4V3Pa6VBEo1eNSqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWhs8OWWRgHH3FoJH0yn-eTSx32HzVJM33IrW3r9xJ-w&oe=69AC0290"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qjlthHnTkYQ7kNvwH1ttKU&_nc_oc=AdniHf32_92iayKdpliciP5mSCUHJZO1wCo6pxbu-F_9nFvVXHaG36O5OJTUcPjp7qU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQqwy0d-v2qhnx-EF_1MhIxwekojzmXMEwDeBRDmkB0w&oe=69AC0224"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McNVr0Cu_IcQ7kNvwEL2Ib-&_nc_oc=Adn03sn8kmJcHzzbk-8no8A61D7aFxKem2F5XJ0LnRx2DksKBVTFiiujBGWtWvEsq7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKB75SOzSgTmr2H9ov9QR4RDsrN3UBJur7S65Y6jh3ng&oe=69AC0645"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS6Brwn21pgQ7kNvwHemHzg&_nc_oc=Adl4LDYhiuptCADmEVXajG-E2ouUso03mpIyR4buy6b8DVPGtXY2QenXqUqKY1yzCxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyTw7xMa3H5Rp9a4oo90xcn0eHaJhOQC1t5LX7Mfz6jew&oe=69AC13B1"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4G9IehyJA0Q7kNvwFB_aaB&_nc_oc=AdlWHCZE_IB4WFYNRdFSip8ZUi-O5uUfQ8vqmnzVEzxDlWK-Xahj3ETNPg9kvLxEacw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-0fl_t-YcfZtCGtOsNL48vaDT7o5Ro48Eb3rOjO42qw&oe=69AC192C"}, {"file_name": "Landscape Portrait.png", "id": "1994643360958356", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462955_1994643364291689_8067620305322327621_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRrgOFH3p4cQ7kNvwHS9J13&_nc_oc=AdlE9AOZ8p5TWVcKIKBXkLaI1Wg1TTw8SscFoKVnO7PKrKZ1lh_2QDjJX-5au4I9QQw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZWP9YlEUGo4EL5Odazit3DM4NsY5HhZnYz-UzFZ0tcw&oe=69AC36CF"}, {"file_name": "Icon.png", "id": "1749848195756080", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003273_1749848199089413_6210488408238311147_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AONOvRPgQQIQ7kNvwEdOHyd&_nc_oc=AdkWDowrLZpHYwYXOMPw-1qIUDLaAdT97xTdhHWEPwFEfbQEZ8LENzZpBPEAU5-n3nU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzEMUiN6e0H46LaUHVZB7IUZAVTcgrPo48BTQ0f1KDe3Q&oe=69AC32C6"}, {"file_name": "Hero Cover.png", "id": "1019117086331658", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974548_1019117092998324_1164601898764144918_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox0849YCmEsQ7kNvwEKjIHm&_nc_oc=Adk5ENTgI14grqX3WfvyRLkiaWR0s7IcoJQigM1T_VLDuMQJLmW0gtZ4cptSdQgya6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwvz4TtbvomFf7PcY2cYZUMxpowgrQ1lmdFlWH64gZueA&oe=69AC14A8"}, {"file_name": "Landscape.png", "id": "872400761490753", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031450_872400768157419_
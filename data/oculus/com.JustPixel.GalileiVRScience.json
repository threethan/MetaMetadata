ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x70dM6Ye63QQ7kNvwH16XpR&_nc_oc=Adq0L4kK7waW-DJuHPKFN9xSUwKzTcf55Yc85J7pzfeimLCtboi9fWNiu7ULaa932ls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS6Ds35vuqEnhTXDeHcBnYMcUPAdF5arthxGw2IBki08A&oe=6B0C4E0D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wJBJgpVUS0Q7kNvwFqYoTD&_nc_oc=AdqhKKGBi6WfPH0MDkdXzwk4OSq_XAGdJfXOrWNxO7PwiSfIjJPP3j5zhNT0xGXwxZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7B_oNtT75Ps5Urk28cT1elOVtOQOohTRgRTnNT1sZkQ&oe=6B0C7BE1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBHQ4icyn7QQ7kNvwFSlvSc&_nc_oc=AdoxG4l-z5PQdLfte4v2HjXwEwjJ0E5Ci2CuoooO0FTLpQCKgzkPIdGtiYtsT2VgN5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQtwCk8K52Maw7ZDwH2nHXlqC0AW9BFI3oFOIII77Th_A&oe=6B0C581A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGTXNGGSnkQ7kNvwEvs-Qz&_nc_oc=AdpTRJnVQOgt-DglS_Sh7CFJY-6P4rNf8kHPYkmeOx9CpIpfWOk5T_Lkd4IvIJcFE6E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToCNp4BfquZbPIqVKKvos2Brc5Z9aM_he-rpFz5QsY3w&oe=6B0C82F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XEKQ908XvYQ7kNvwED97oS&_nc_oc=Adq0ZnbNmJcnDB-bOhhGG2pLNh2qa4gSqLWE-alHVTZkkSW6r58D_FnjHyhwsT9OHPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSaQnzi0GzTMBQLLUAVbfovYOhMAeG1Yuq1Q2U65gG6OQ&oe=6B0C74FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FedCESpdq6MQ7kNvwGKe74s&_nc_oc=Adr952foguHQMMj0hWgIwExa7Z0LXidfDckU5UrrM0aQ9oe3qgxy3-QPt4rqJDQSqcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQDQ853uWN-gPi8jivfWK1wybaKY1-biJqJExxBNfUgw&oe=6B0C6E8E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvKR8VoY4uIQ7kNvwGjSRWY&_nc_oc=Adr5tmdh1PrJ5Tb84olMcWcSny-gLYMRi46eQDWoCPqpEdjh0igAnLtXlt4EPt5O5Wg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRugOsjxxKRQtZKm-w-fTJwhFfDKa4s1ZFZOGreLBPTTw&oe=6B0C65CD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dWhDa-ZstAQ7kNvwEdE6k6&_nc_oc=AdrbaouVdEoP94KQQ_CPJDyb8AL8eM8xxVB_XA_QvWHgjCQfIlc2Sjv6RJQKv-PCqLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSD-HvoDTUKp9EEuCSVSroXCc2TMqjBc8LpBiQLJa1-cw&oe=6B0C6BCF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE2BNne
, {"file_name": "Landscape Mini.png", "id": "513806047726163", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982645_513806051059496_4223857969464332917_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3b0N-VC0MMQ7kNvwExI77j&_nc_oc=Admi9WG59tWjykcw1jnkhgaEqGPpDOsZgV53gIPaccnBGON9DaRcYEG_mWtiJn_li5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfssJJOMxHUvd7RdY3xOaWsPaIhjaWPqZsPs9VNJopZNrg&oe=699C3C0B"}, {"file_name": "Landscape Square.png", "id": "493094060118611", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031398_493094063451944_436248626179243058_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gfrO9_tBfoQ7kNvwEopatI&_nc_oc=AdmOObuRESUSx8400UOjoKNk5_vCL-sjPR3LpnCdFPgkgb7WZnD9g7MYyPvDO2267wM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftCtQOkpYBZnEHKbKVHgFiW-kMRMK_rYvccuda5Ye6tjA&oe=699C4099"}]}, "id": "484376654518407", "locale": "en_US", "screenshots": [{"file_name": "Artboard 5.png", "id": "2759662717526847", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036623_2759662720860180_2489395151907338724_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn_stj5gPU8Q7kNvwHJYCTj&_nc_oc=AdntYTiRmS5Fbca3zi6QDibQjxp5HcRTLD5OiVLm-OKIrSyNyS3d-vC0A9_RzHdj9G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftdRVvZlD787ollAHz0o-sTtUOMCXOwpSI6xgamNPzAZg&oe=699C5272"}, {"file_name": "Artboard 4.png", "id": "2251639125188099", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974450_2251639131854765_8396477208328520911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ9giFULyWwQ7kNvwEnTQM5&_nc_oc=Adnjyb5fH1-zn1PHW4Wkp2ceaiVjxuDesezFi9vaD9c7LAMbtf2R4H09DRIqUO-11_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvex_6uOPZ13Gh_Wl4INYq7O2csSfqs6zailj5PI03kUA&oe=699C3FA9"}, {"file_name": "Artboard 2.png", "id": "473243412277688", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984439_473243418944354_2938823070153890993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNEzTwX_0eYQ7kNvwGgVkMy&_nc_oc=AdnVWrLDoyIbKMdujXHSB6qG71w2cjlWEfZR1qmyUu6u2hsTY27h7OVx5U6mZvo1oFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftj3k5J3kS6o395ckNWFnmFRWH94mVy_g93EUb5Fr2gNg&oe=699C6077"}, {"file_name": "Artboard 1.png", "id": "1543351499921825", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974887_1543351503255158_348442130487521407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoEk_GzmqnEQ7kNvwHQMgB8&_nc_oc=AdkSHvxrAKzLNYspNyypTrBfoivrt3hBZVbg_yAPKGYMoiIJr4CUhj0QkyH-kaNbu_w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsuWWulCcFGD-g9TFWB6B7lE0U6BYTtQg6_P3xXAeUh-A&oe=699C6686"}, {"file_name": "Artboard 3.png", "id": "912383657378781", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031432_912383660712114_2572436446715478623_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7K8HDkF8boQ7kNvwHwOszf&_nc_oc=Adkfsb8Oy2rJmx-N57rAevIdHh7Gu74Ke7iv-CBzX4JuvU0kfynAUWNSRl7Q42Qg9Tk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHrM8925BuRXqZNsTqAvgduOGj7J_F4cztp7P2riRmEg&oe=699C4D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "3748813912049179", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031311_3748813915382512_2166423531006939259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw1iu0pSuPUQ7kNvwEXJaBf&_nc_oc=Adnl8xqcU0i0t8HqMKWJRDHkyn667Dpp6uw1QMdIVqBuxKyLgC-Ug14QzfhAJRJGH24&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs_Nxn05J-BEPtSI2NXoxku-76GBI6rJZcBmgyJCLHf-w&oe=699C620D"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that lets you explore cellular structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}]}, "developer_name": "Just Ware", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/93783224", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/93783224", "publisher_name": "Just Ware", "support_website_url": "https://justware.it/supporto/", "website_url": "https://justware.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_top
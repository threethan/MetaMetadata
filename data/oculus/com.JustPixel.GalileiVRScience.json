=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMST4ZoRy6S3-7VC-kbcC6Aw4486RgayhEew6JUGKyKPA&oe=6AD39D8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl61qj2YiVAQ7kNvwGSJnIV&_nc_oc=Adqh8By8t5xYbd2a9pYbKZ_fHe8gI3J8QdCIkA276-4KXhZAhHT7-aUaK7NE8a4TbI8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_Y8X4JJeivRQKxrMyWH7fpy0CYebmv3EmynwL3iAZnA&oe=6AD39321"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrEupaIjtfAQ7kNvwE3Kyx1&_nc_oc=AdrXj4GkOrHmI_QEHG6OZG0wK3k3zStFfWHx7rjTcuSbL_W6PwzU59FHkpPEU_hXowc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZceyiRAXpgF2PNLjBDl_I3gLCmeD3lTuy4cwOuF0ynQ&oe=6AD3A79A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeIHo24mXC8Q7kNvwHcIeb2&_nc_oc=AdrlRGAGpx16UdwQV8onFDV4uCPRKXEY4F6INRzwsFuoU65w4SghfwGukETRT6IOGC4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0lH3yBM5yVOHNusV_giqyE1oOjtp6uRrHFN4iAgJEWQ&oe=6AD39A30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6itSc_3kZW8Q7kNvwGlHZFB&_nc_oc=AdofHzrvj6XpTkrUM4gTLK3oJ8CWmW7m1HppPmf3DFPpRMRwvbHP3RBrSTtgWVYxi4k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKmT6SsiMQ7ReRQNg2OeLL5bh__POFtft07SyYFfImtA&oe=6AD38C3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.
c_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61IjOX1IIPzgEOChMLpbkMUCbhTOUb4q42N7b0wCMa4Q&oe=6A11D10D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JXhwCPJIwQQ7kNvwHrjuZf&_nc_oc=AdqNvYqS5YXkh_XF7PxGrJzskhV26wvWBewvc6ZWo8w3Hc0mQoX60_aIH9l2B2GtDZk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T269DvMsNKZAHeR1NDfbWn1sZ7wrq-0NdYEWeLyheQw&oe=6A11C6A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbGNXHYQzZQQ7kNvwERPEzN&_nc_oc=Adp9Zx_8NMx_Yblgn7Y98C7V00Js1Fq5kJQNWqfqAxTCdcV38LrkzrnazVW212jSSGE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IQV2fT8iDxQeKH4BzaXPShDENL72M95TO-95JM3dXXw&oe=6A11A2DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsU5BvXL-h0Q7kNvwESaAza&_nc_oc=AdrB6KwWwQ6OtWAdq_OSVwI47kz_VSZmYdNIKP4zVkRIX_vFsNNwnUnLJ8yHFL3dHxM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xSW6BoQrLBBB2Up2ZDI2ztvkFF-o65IlxsM6Zf4N5Ag&oe=6A11CDB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch52UOcLAx0Q7kNvwH2f7hX&_nc_oc=AdoiSsWaQVQklSNpX7amdS8UWNFMX3lWIq6LlHuTTD8hNclVn7Y5BQYTVugSPj1nFAU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jTO_9eIPQ3OQgN32ci1FeuVcJ3xJFkCNwuGJjhpkjyA&oe=6A11BFBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.
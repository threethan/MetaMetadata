=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAhWtlIln4fgGVrHUpZZz47qyg3ps3hhqTV8nyVFEdsA&oe=6A5626CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtQuXnmjPXcQ7kNvwH0ypt8&_nc_oc=Adr5ic79clcv4E6wV-BMRS-p_VX2DOKaBwKatMaO-5HO2CRHrJx2tPMc_OR2AusAK3M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUOYioeQ9PuUsS-OxTk9WVVVEOGKp2jw9AJ14r-v9RWg&oe=6A5654A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd85-I1Ai1gQ7kNvwGx3yFw&_nc_oc=AdpQMi6V1NxM5YDfx9276BnHv3P8Va7Earr-dvmLtEMXnHN81BORMH9tcicePTI4Ne4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWVqYR-f0_r61Y_SRS94uhYyZkxaWCtBVSkb0feVmDsQ&oe=6A5630DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DkJuN09VcMQ7kNvwGBaqwZ&_nc_oc=AdrWMoa4z9LdKFa4m1tmv1Mh5Vw0ujErPU2KKWQq_w7It7mV2sjG75va-eMzfMTd-4k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACBOiTaHzqvJOb9mCBDgC6T0DPcYr6aMqMvL3l5cBY5w&oe=6A562370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aswaAFRTE2UQ7kNvwHntlym&_nc_oc=AdqshY6dW9qmIvOGAVBxnKqYDN-tJGrIT15pXiTYdPzkzqPmCd_76GR1HL5jIhh9qHQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK9OEyu0Z5qvNXzrGtf3CMxOn_npTXp44DP_DpVv9W2A&oe=6A564DBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.
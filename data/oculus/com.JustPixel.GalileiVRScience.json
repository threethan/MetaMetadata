rd5-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpO-kHld_fYQ7kNvwF0o1pY&_nc_oc=Adqytgi5l3b7J4hE4rsEpp7rtt54EKBMiVXQSP9WLAUVK_a_bguYNWhCzjzP63EnXoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAY5WlfkOno4oqRkTvtiJPVoxu2Pra3hkph-hyUazwMQ&oe=6B0D9F8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wJBJgpVUS0Q7kNvwH__YPG&_nc_oc=Adphkxo2B-1gAswggnIlhWIvkV5Fh6hXYHKGChgLhJM5cmApF2utBqv25HrB0WVr-Kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIkHwE1k_NS42NPlUmTg2YkNg-5nuQt-2loLrJPbfVDQ&oe=6B0DCD61"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBHQ4icyn7QQ7kNvwFsIFLR&_nc_oc=AdowWBuPztvt4uw7eI41_3TJxK7_MSUuMze8TsoZU6CH9N8Qdew0R1xrnGFeomMzcJw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ07QkP_1S_fdkZXnEwIhItqq75f5cIZRgDiGU9u5-cHQ&oe=6B0DA99A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGTXNGGSnkQ7kNvwEtyCZF&_nc_oc=AdqOVn7bjyTuTq68jn9KqQmOggnpC_KpHDb3Qr8mX2krfxqduAkavbnFOvp5PfqKbys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ5VzJpJrGk9OFsrc7tYnz2mlR97JdtPJfwl8rPKWVNzA&oe=6B0D9C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eobgGYc_UQ7kNvwERAQ9_&_nc_oc=AdpHuaYlgRoyTJyxpcVUEQEwKtf0g3t9oj05UhiJ8LXnHQ8l5XQSZxjxFwcFolAxd_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0u8MfrzNs4ahZyk1U9PsJBc7f5Q-yZjWEuiqBnCGftg&oe=6B0DC67F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FedCESpdq6MQ7kNvwEvNDfN&_nc_oc=AdrW1oIZrdhN8xX1w4TwhIZAVUoY27VbDFykyLAvKqO6ljY1drlgaOP7cmIZbQsmvR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQEj8_0byTSczYNq03uXFJJMuJNNgzemloOn3CXMf4c-g&oe=6B0DC00E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8D9IlJKh9cQ7kNvwH5s7J0&_nc_oc=AdpHy8sbhnjeEbECExbXyUpy7pqapE8HUmccv_wBzEferVCyoQS4fTwNkf06Wt742JA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8CeY6GvhbisLw6Akds9Og7XF75NASOBtATlJVbnXZcA&oe=6B0DB74D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dWhDa-ZstAQ7kNvwFuLH-M&_nc_oc=Adqztct32z5--8SIrjV2uBo6UjzbDExPgKlX_o8FubaWeX33AlgEnxwvP4bktTDnBQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqiDEInWsWcKOw8VUo8_52du6xAT84wH_p8_R5yKuahQ&oe=6B0DBD4F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE2BNne
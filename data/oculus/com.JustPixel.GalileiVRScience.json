=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UeA5_Qa3TIBRB5rzuuYMu8j4-fQLQbOje22hgJzfFog&oe=69E768CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmFriCLNYpIQ7kNvwEu92vc&_nc_oc=Adog9VIGHVGsnjyFzMSbNAu-FxjsNN8h3YxTEYRo-SWtiezQ51qBZw3kYEekBokzmcA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kc3LTEFu6SOl-U3zAyGUqDCCAZs_hzU7oMsxV4TJJwA&oe=69E75E61"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csSgv3sjGMUQ7kNvwH6zu1z&_nc_oc=Adp30tA31HKSkjlzcsQusZG1mnA-0B119KJ-DK4sIoOuziwYYE62cHaAW0JQ6VTl8nE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oppIIv_0ZVwvfu_GLldjKQx-Q2mzHZhWRaR-trlKsXA&oe=69E772DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_cg8NWykwUQ7kNvwF_Zm96&_nc_oc=AdpNYb7f9AQBlYUX9vfSC4AsdLKyE-2uJf_9zMgIeXzk1ZxQ5ND01YpFmM8ApyGSH5s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TtqbxLAQxxDn0_jN8rkgE_OSWOQsFAHKN4i5cCXc61w&oe=69E76570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7xXCtLXxcAQ7kNvwHxMYE6&_nc_oc=AdpGl-DQU4AGA6OVWJH9DLMuSMTSDoauyq6nut-ymxAET6uSWvTPfn4_9fpRBB-wMkw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QClMTrgoPs8qlBu_1jcDgxsbmwn9Zbkx2yPisCJ4veQ&oe=69E78FBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.
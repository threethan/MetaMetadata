=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTdSCgKtT_07G_4rbDTvRrqzuiJB_P_YMgf6nPRma5WA&oe=69CFADCD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkfGi3Z2sD8Q7kNvwHXN42H&_nc_oc=AdoVmQ4NDN3b-Po8cl26iKBfudX9v-GngyHrC-Y-XCzhsxkVKDU_cXO3iLGEq62cSJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIeXJp2lIoH0oFuHW5LPELjdyG35SLtuL0Y2qb0oynTw&oe=69CFA361"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZpAwIu0fbQQ7kNvwErdzcP&_nc_oc=AdqgPthN2DDX0qMZ2op6A53H2cGxtziEt_OhjNCKlepEjbdOKhJpdWiOK5GPbacP8NA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEkv4AKDYaqriPj7OYVqnTV-nXZwujV81wfk1lTBa5Fw&oe=69CFB7DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyGwPUdKaKwQ7kNvwH42ew7&_nc_oc=Adqld6xjL_4iPHvosWFYEX8K_rxqmcTeeS5a8whoU00-mtEQnczqNaFF7b4j1v2ez_8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIvBAKZsYZrFxPtFbc6XvakzcyDidHXc8kvkzKEt3Evg&oe=69CFAA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8euhBG1MSYQ7kNvwFENFGE&_nc_oc=AdqkS19ZO5WMjFETt9FvLwrSLUDZ2jKjf-A_-kUxFh0dPVWILuwLhG-fUKJmc3r5xyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfQFzEOH-ls_GR31vv32ku0CZUsc_BrmXSToKxshsJGQ&oe=69CFD4BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
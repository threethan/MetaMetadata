=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eDtBqud8Vyei_i1mWbxJJKAZosSQWPo2r7PUzJ5tq-Q&oe=6A3AAF8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR5UkBfhmbsQ7kNvwHuwsIe&_nc_oc=AdrY4Oa6HAOqehpdCnHsxYYsdbzxeLPx_ZxGWIywCFkVI9OTSibkFU3V7yj418MKjTg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GjL6NVKFQrmkW3fTn3zgS0AxTa456CWhS21kiBUUyVA&oe=6A3AA521"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyD017D9Jk4Q7kNvwGFRdRh&_nc_oc=AdrW_1ns0UENfp4FAuTrLvMBGXDXNh3S5KkN6NN395KRwOQYUP2ZRVn23Xa5kqyitSc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LUi6Pcr5TFU3svtwS3-i6dVwmHLikfeceqSLmr5vAkQ&oe=6A3AB99A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVJ-Wj9cKcgQ7kNvwG_gLUY&_nc_oc=AdrBMqGvW87gCW89gryd8zWcaQGHWZkGTXGBJrj4CZ0B45eWkx2zBA02dZJqyef9PWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91xTvM4UsY8-I0G9lDJWPRkSJXPHcXwNgkCGlJFEa9fA&oe=6A3AAC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM9Qh3mJ448Q7kNvwGVO81U&_nc_oc=AdpNOIQwuNwOGqYsnq4eeCLbCwz4Obd_d2ZkoBFZ_3wfjvL_2hWZmFr9CyXcsshFaq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NkUwLq3EBpbHI0396ky26EUmkF6oFTZyU14dP8cGBDg&oe=6A3A9E3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.
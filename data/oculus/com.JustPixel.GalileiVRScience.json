jc3-1.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FTco_jkCG8Q7kNvwFUAeim&_nc_oc=AdpbF196ni1vWLiWJ11A07LxreJKHML4N5W7HTXL3uuZu5fvE8VNhUFd_12cL5oSNCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAA7rsnhqgvjvVtqPMJ3euaJQbg_1k2-TLgQZFu36rLQ&oe=6B03138D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGVrzirc-voQ7kNvwFHkqJh&_nc_oc=AdoTvKMVljTyqnAe3PlClgSF_fI0JjlznD8uG4luCdLpoyJrkyPlSL_Cr8RykKDH310&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYiU_kKcWDH6teJhX-4aXA8N5f9_lC8U3mebadugxUew&oe=6B030921"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7fgDEQKIMQ7kNvwFluWZK&_nc_oc=Adpihj0_2ru3lT8ksztP02BGlR_cT9GMKv4gGk5K7fYhvcSVcfcoX-9cxnY0fMjiv5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKC0IBc_KEz6zVaT8itS9hjS4b-WoDZ7VomhA1y59I-Q&oe=6B031D9A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFQ67MLShl0Q7kNvwH6h_Qr&_nc_oc=Adp3UIbivBjN4labxXvaVOWMfPJmDIFv6iNA0qr-MV7pIrrThZiejcZyDMPBwvu_3OE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUysvpwAunjkKTKlC3H_9VEwjmmsm4M2pgqGK3QY4Q2Q&oe=6B031030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PurMI5LWl3oQ7kNvwHtQUgP&_nc_oc=Adpc59t8SaofLvW1q-ErX-ErI3JBoAbzRULcAQeGRZMEsGxAQRqwqBFqplzObwwsZvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbjPvsJ1gxovnxUWZ5c2YheQOeLIg9r_g7BlGHJIk4bQ&oe=6B03023F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyCMgt-GBDIQ7kNvwFW9HEf&_nc_oc=AdpGeSoljAElTOMAEDkx0CAhzy2LShAGqgfm1939L_u_xMKy1wBOJWaFPD7yXsVsja4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTayMMQF1UcFzaZw7FY16qzb3WU5J_dgzNshY7X6Wna6A&oe=6B03340E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS5ttd9zaBEQ7kNvwFnVR_S&_nc_oc=AdoD6ZZOTey-Ze5iD-ED06Id1wsDexGq8DUswbZHSCJWV4ZYj0_rRIM1EP-I8jwWPBE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXflfmpp377xJHdZUxCypId9Op3y_nhs-kQ9Whus3T3Q&oe=6B032B4D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTqBbYzZS64Q7kNvwEXMO4h&_nc_oc=AdrIGORRPijOIO3LEFQSynJRVNkTubJCeF7MIp_MSIhZob_5v4JKR_Cn8ymUlyd-P_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDjub76FvRtdruxp2uTolpraoH2BRH3Ea5OI_jLE3W-w&oe=6B03314F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2xCFuD
tl3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x70dM6Ye63QQ7kNvwEL6jVN&_nc_oc=AdqgiIXCvDNVtxWaWiTg9l-28b9-qDlWw6TrF0qZeLr4Rj400OHd5h3gBxRxqzJK1pY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0xBPx88dnS8MZbQ45L3hgHlMMP28rrhn6_zkWCuMfyA&oe=6B0B34CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wJBJgpVUS0Q7kNvwG34CvE&_nc_oc=AdqOmQyfQ8SzTaWOUikkgmxP2wAytB-qkskktRhZHN6bWPS5TFzdCSDuiEt_bmfryvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFdLD5XF1niutsWivQVePkSIPaC8Q1YwCJ5YTH7zcBFA&oe=6B0B2A61"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBHQ4icyn7QQ7kNvwFZVRR7&_nc_oc=AdqW1Wu1qiWCQ7Lxtmk28ngB2_n-UloowpIEHwKIO8B0kartCRf2AsLVbVz7bRpFTC4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9T1uNXvoW-oQRm-3yajuXhcioE6sVM04sVhU63bX4aQ&oe=6B0B3EDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGTXNGGSnkQ7kNvwF0DaPZ&_nc_oc=AdoS6qcNRfUomaWYaMqaXJzmjVK-1agKMZcvDKxXWDaGqFXrB37RZOGfWdXH8Gf9BtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsZYzk8nVUC406xIShyUWJrt2EbqJ-JUM8XbddjdlxLg&oe=6B0B3170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XEKQ908XvYQ7kNvwE0mMyK&_nc_oc=AdpkvFYUNCD8nqDbrXvPdBbKn9MFE_S5JMWZPa3pmogQCenpePJueNnsJHwSKWhAMnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHYwlA5pq4OVcS_Mp9R3XzTGVVLZHDOzPcjbKsM9tCTA&oe=6B0B237F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz4LwOfkQV8Q7kNvwEcRN-L&_nc_oc=AdrioSG5TN6VydMGVnkTXRwUs4dYKzEIGZy4zl6ZiLbDrfO9b11BuX_IwxTncFYl2KI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQfoSf5-XBl_4LAxyaf_39KKwzoz-iaaI2UeZ4DM1dgag&oe=6B0B1D0E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvKR8VoY4uIQ7kNvwHHhaC6&_nc_oc=AdpN-C9jyiqPuEbvFs1i4ZOUVa8wtVZL7SfRJUtdZ_dU1k2CqZx2PnhUHyAKP_kfdCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3gjHoRc8KUBkOWxXZVsQ44LjScwk2ADJ8zzYlipyiRw&oe=6B0B144D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYAHXolkpcMQ7kNvwG-EeYG&_nc_oc=AdofZJiLmSB56rajtC_wq1gkuhWRdqjDlO20v-xGh9Uk508-TZ8bdumlnts14Rw3_QM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3Lj1i-yXU7STpvKTd3qsWzOXt4VaUKd3jpjZt98cGvA&oe=6B0B1A4F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EE2BNne
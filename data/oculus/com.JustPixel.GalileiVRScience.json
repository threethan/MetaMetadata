ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp0X4RWEJvAQ7kNvwF49r1g&_nc_oc=AdpqXW3yzgbGCJPjjiTuC0hxb_FCGUU48Z4VFGsEE3Lh2CpgGMW3QMAzBaYfzfmQgn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvtKce4hj_GOQYYOiA0e5SYZpC-6agFPPDe0Xs09yXCg&oe=6B00708D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ1F5fVVPnIQ7kNvwEktmBK&_nc_oc=AdrOIM61L0q0xdt4AA0MH3GDeH248niAqQBeUOQnwYzTNRvRO1_GGx0oJnbu0WuCuhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFGDhPevTFn4PkCFDkBZ6Pge1ZAZCeuD_9Yf3aK2FFmw&oe=6B006621"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QrmxMTqI8gQ7kNvwFH38Zy&_nc_oc=Adph__xY7H_CJmXpLLHtPkpzcGU1-qbWuFLPFGxTIBvaDDdq4lxSZa8nROz2wXl-qLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSooLhy0n4SGMaaSJZrnwPpfEcZLIuIxWot4_oMckJBqw&oe=6B007A9A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TZW-nE_Ji4Q7kNvwHyz04r&_nc_oc=AdqPnELNQBZ09BX7OGQo6Y79Qe_Hv57WSshKBzqp3ZYW7D-QyvidiNJDpC2jsKjRUKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR-Q9GswyKL_EBp4RKtof2NGeN7WGDEheZ8lJhW9tPYw&oe=6B006D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zAV2UMrhEQ7kNvwFm2qwi&_nc_oc=AdoM21UKSvAk0SarYY8PnMSuYi8Eyqf2bF5dmdYZg5GOhuITosoPHE8j9O-Az6MgGkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtX7nK3y6HD8HszOTkg6lzBK2Rf5pKcgllmILWn4vofQ&oe=6B005F3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyCMgt-GBDIQ7kNvwFYEYC8&_nc_oc=Adr29qYy1UGkU2MDabizagXt0jx3x8hqBlpHmkP-4UyXCVNebWdUOpZuhJ8EPYMnpaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyBUmTSQf0iAQFH9-zZ6edfhxb4Qqk0zVO_vud-serRw&oe=6B0058CE"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZOSL-9m4AQ7kNvwFVNdWO&_nc_oc=AdrS6oXyTENSlhgUH7oCgYBMP7c9Hn0q7p4vAzhQYhwXzjGxoGLVWzUo78dIlWBLNHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr5B7oGU1oktsJj8sU8O72U4WOnoeesNAA3vRkMxofTA&oe=6B00884D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTqBbYzZS64Q7kNvwHtnK-O&_nc_oc=Adohp0o2uW9pptew9suZ78Mw9Q8QGmKtpKUEVLAWAckRlYbIXLH-Cl4NEatLU3A6uWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQslwoFgdAJUEQjoavPu0CtYONkz4k3oRiCF5SgKcLSFg&oe=6B00560F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFmf-wN
ea5-1.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp0X4RWEJvAQ7kNvwEEgqLv&_nc_oc=AdrXKaltOi67zaT-kaqPQeP0iMlYIMMSq6EEuzaUT44iU8UE_CPc5X_fbJ-O9b2B55g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVvQn3T-ldtijiLx7Q8fkxNIVpFE3A4CM1BCChMicTdg&oe=6AFF1F0D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf2UeBuYsgAQ7kNvwGSd9pb&_nc_oc=AdquUXIRo35gpeK2XMXs8jAtoQ8b7w6ZYWYwdXtVGlBnYP_94S-P7kDBjl2AbXZjhvs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjRdutXUPTfrKtoi8av7kOKiqt1j_7ZrGT1oXr-cyqrw&oe=6AFF14A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QrmxMTqI8gQ7kNvwGNVLCp&_nc_oc=Adq6xDI7S_wPcqox8op2HT285MAAD3RRmB1V7wYAyTfHbWGjY8hGxzWCic8gbGhzlj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLPtAULGTggdxmPih41DsS1vbffSOZl1cpFuDhW-KoSg&oe=6AFF291A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TZW-nE_Ji4Q7kNvwFkWQRC&_nc_oc=AdpMj6_bgHN6ovO3ccVX8zmQC8dv4IMbvPG-QvpPC01w6QlsC6FQgwmoGoWMc6FoF3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6JWCreUApx1F0qet8imdyYHh35YxXx-D-s1LImMmRDA&oe=6AFF1BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zAV2UMrhEQ7kNvwFV-tuG&_nc_oc=AdrZRK-Nnu5ylrl_D2sJTANOF_cWb6iqeaIkbhOJ9eywLEAAaBDhX2Q02K6EgrTPZVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBmhw_DtwPXW3xN2-ZDmsCMjXSwk80zmb7M18b2BruQw&oe=6AFF0DBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI3-nLcgMYYQ7kNvwEUTSZy&_nc_oc=AdqS5UZvH0RiiCrIeeHKOrMEmNMepS0jiO8VIR65wEA0rNYf0l4zlZmaEyNm4BWLSNU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaunLZp24ViGDIqqsR0xto4JOMjgGCEYjV90FwvWEmbQ&oe=6AFF074E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZOSL-9m4AQ7kNvwFJ3_sQ&_nc_oc=Adoo9Zi21oaCbf-HZO9mgE6QzcijcIh2JBL3bnwYepw28AmjsUIzZn3q8Xrmo4CjyYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL1ltppWniWbJdjAL0y_csP5gNA94K5uWstLMA4z1tKQ&oe=6AFEFE8D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aZ4dCDkiEcQ7kNvwGMc08s&_nc_oc=AdqTZWEH2s4o3CjtWlXIag_gBGFbyksLREfiVL2811fEXOZ8w0R7YuR1hdRWjcivKwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8DlMjYWQcdpmJ194S0WZ_stcIErI6ox4E7tfqAS3wJg&oe=6AFF048F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFmf-wN
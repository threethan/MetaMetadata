ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FTco_jkCG8Q7kNvwEFYgLu&_nc_oc=AdqPV1hl54DVsJ2nygZbOL_l6WCxG-V67ozADnFloZ30hE3CulXis3hRklmU7eX6WBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG6SOS9SLJXToPfBNaUNjIHXmTqziAKGslTJHnUci5YQ&oe=6B01C20D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ1F5fVVPnIQ7kNvwFt_oyd&_nc_oc=AdqK_3n7-_e8DeZULUjBV-wc3M2I-BMl0V6mCTFeWci20P4f2F9hS0FAqf2fS3McZik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROpQRCbmxGBHZdafk-y7HceOXLN30iB-TNky0ecMgKuA&oe=6B01B7A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QrmxMTqI8gQ7kNvwEcLGCH&_nc_oc=AdokNkaWPa5JERT2fI7vj2KiMAKIgvbg6fyhBYlFcqc7mbxgRMDgewdNpHyMU2Yu_LA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPlWsviOaX-i9wXs41yAOMjAAs2kCLSv7QIiIRJZ-MMg&oe=6B01CC1A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TZW-nE_Ji4Q7kNvwEaHSnL&_nc_oc=AdoYIFHHA3ZkQ47advzgaFnzs4kgBI3Vol9mBQwtyC3YPZth6TaQjegPUe1bQJMNwDk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIfVZhbrqgJ95ZhV51qdMi2Qei8KUOQmD8G4uQezAhiQ&oe=6B01BEB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PurMI5LWl3oQ7kNvwGcq0gW&_nc_oc=AdrlEq9T28hBkTuCvD87gUgohUGRTphK6MsiclktzDT8fsEuDr1OIKVRjJx7t1Pbtww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7etBmCPGS1y_SKDHkMnE_L0uG4jbWlcJzBW4z_nn01Q&oe=6B01E8FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyCMgt-GBDIQ7kNvwEfS-bq&_nc_oc=AdrjW3t4IkFgfv6ZZzwd6_2xkd9eSm-FR7PiYlG2ghOHHNBVpJsPIMxip0LOI2vFy7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGCu_QjmgK_2IvT1fKFMXjIsH3JP6t9MKZB43cI7WxQw&oe=6B01E28E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS5ttd9zaBEQ7kNvwFVq0dh&_nc_oc=AdqE22QIVkIDOVZyF_wEizX7KM8QicGNtphK-fPq77hrDI8f_1S4k3iiYqn4fHjvvCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxeOIAryxhbi5NCpETNN1_PNN3vRyT-ZTBERn_yEjf-Q&oe=6B01D9CD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTqBbYzZS64Q7kNvwEB6TaQ&_nc_oc=Adpq-5z79qbVWjRsSBoB25dRDo6N_YwQ2VjafD9ODT_LtjdtQkwrYo6zUmUD82X3AyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQHvWN79b25hEQAGKj5N5gKnY1ZUzmst3tmZB7puvs1A&oe=6B01DFCF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFmf-wN
rd5-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp0X4RWEJvAQ7kNvwFXZHue&_nc_oc=AdoHRv2Ew5-iMb6jUGFXFS0oQarFLPTeAJJt--0gx0muWtNthIBpyGnJqORATjKUc4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4kirl2MhH6KfrOvAshBXUbGKjNiYnJbKiDqF7xNmRog&oe=6AFDCD8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf2UeBuYsgAQ7kNvwFNdLRl&_nc_oc=AdrfVUsHO5hHirbiR374QkT9yQ6ZSb9c-Gm4SOiuhOAmvLRjjaFztFe-f3Rn2GN0ySI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqX9kqxnBIiRPs9rWHyYu29ot-RE5u2jx4NIPTY-ASwQ&oe=6AFDC321"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxveNtUPaJYQ7kNvwE9Vune&_nc_oc=Adql6vVYuU1gxA6DBxfa0P8cLn8HoGAfXmiFqaZu-88D1mkbU9AjhkKVym9-5eyrUU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt_WJUIXGTpojqODi9WFzjJMj2HOwFZJO86sU6A5TMNQ&oe=6AFDD79A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YURZnT7651YQ7kNvwHiv2SL&_nc_oc=AdpV1etQD0GBelcdpzdP78R9VIe9lhdnMJspbIa5jjQwvIt835FnMsXYaw_-_hDe8y4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBjmYav1blK2nWdkQoCmEqH5220uXUUlGfS56xls7JMg&oe=6AFDCA30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0zAV2UMrhEQ7kNvwHJ65W9&_nc_oc=AdqFYIfTubdAWhOZsdyOKJiItQbmt-eznOh4id5XNaByBpHFvDF2U1iRlWzK_mJZa-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsApJBWXoKYEjEvJaT-h9tR2c51HJtqUZAYEJVd6QMrg&oe=6AFDBC3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI3-nLcgMYYQ7kNvwGSGytA&_nc_oc=Adpi910ahNzhxerS3Z0DcZeCo_-nqX7UPVmo-jAxop67kzGt3ktzzp_iGGs7nZ5Zamk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvXE4YRGMqE0a7UwO782Klc39-hC_DxLfA7lmd5nJjww&oe=6AFDB5CE"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRZOSL-9m4AQ7kNvwGzXjoi&_nc_oc=AdoH81yCPjO7SVHR0j1IhVkycDlIco6wF214y4BIttvzhEG0xf5Vl-G5_JLXPy3DlbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFYmQTrn_6am4ONfQwP4l6AzXcU5L7CCnLuZQ0s7Ot2w&oe=6AFDAD0D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aZ4dCDkiEcQ7kNvwFAj2QE&_nc_oc=Adop9qmZJyJeegwQnh8g4yNktLaSToFGPkUn3-6z3s0UWzKz0YpLZ3GYajQaUEqlFGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-kbz1iknqjO_K_2FNVwjxmTRucCZIUte85wowMR5Edg&oe=6AFDB30F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E13aPkO
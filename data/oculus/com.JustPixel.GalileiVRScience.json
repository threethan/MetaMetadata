=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70XmYgeKq7lRLolJ7NSsgb2t2Gj9lg6xEA13_LD7pvvw&oe=6A0469CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OerpPUCheEAQ7kNvwE9y22N&_nc_oc=AdpOKU25r2d9F8RSfYYGAqJECDW8zuTiHMRm8Q_7XEeHpuYMInZ5ou1Xzj69qFhRqGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f2ZdZZRyoBy2vCkoqCKstuJSMKA1ZMNA1Nd3oxYtg9w&oe=6A0497A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeJ3VzDP51YQ7kNvwHb-Y2K&_nc_oc=Adq158kLa0_F0axs-es0vNey7M18ZRDHLxRj_12WVr-5zqK7eSCTcIN99W5uivjBhXU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZA9WBuk_6mkIoeFly55dnKyCdZLO2go6z8BToHGCEMg&oe=6A0473DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNocuMYPsrIQ7kNvwFsV4t6&_nc_oc=AdrND-KrJi7hbLpd15h0jjHGHsCkMlN2rFU1zia64C40YLAW8ASWlBc2ixcrYy3NcOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77P-GDQT8tCoM267RKdysRDBxMD-29WxvxDTNvVXtv9g&oe=6A046670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlzbK_wITdoQ7kNvwGoT7Yn&_nc_oc=AdoyiR1CqHjTbh1HeyZVbwJFYjvzCUxSfEremr6EQ_Bp0hMyKnuGxGec_KjVLym8Va4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z-KRPEfdT6u4YqxYX9YEWnGKEWZsvRyJYYh-dW5DSLA&oe=6A0490BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
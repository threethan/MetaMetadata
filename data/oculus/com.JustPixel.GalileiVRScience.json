ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqjqYf06aGgQ7kNvwGIYf5H&_nc_oc=AdpakhOo1IjDDp1KA9TiDeKcUZlvmKbfLmOSyqemDh1WI0EZ2W01uYkFWzHgR79ohho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQifW0vmUX43nnHDUZLUmKIhfVRmFDF7VuwW-SfAJ6nhw&oe=6B07080D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGVrzirc-voQ7kNvwEmN9tt&_nc_oc=AdpORPehbFP0vD5k1v2qcNAOZA4rOKb4TLlKzFg0565sqrQMjrgVxkNoN9H1iNJ4TJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCRJWAGT1rNtz9RmFYl4iY-aE1qv1F-s7R8dmxat0a8w&oe=6B06FDA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhAjVYKD4twQ7kNvwEh_rt0&_nc_oc=AdqOq6u_EtmbL3YZHQu6Vu3aTzJGoqtPJpdf3yR9GllTFxQIUWlMbLdWhsCZl9KYn0A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGac_x7SuvK3J6ZLhI9VIOeZa_PGrSg3fzeVsFDxCOwg&oe=6B07121A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw8TkbTK_rwQ7kNvwETAgdG&_nc_oc=Adq-chpQ7Ob7nx6QZAtEbn6LM9Fj4KvGscsHzyYLWWneVcBwGSKcwOZQOukMLJu-FNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSgXvQWeF30dpWW1yui8QUzzQEN4i8FfZvR1RUFMiJ1Q&oe=6B0704B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3M_PE74ei0Q7kNvwHWfG94&_nc_oc=Adozvp1EregqbUGzcSVnFaoysPmW2GucPIPn5ViYkCsgUlxaXJ36xlH-4X9XfWeyd2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXSV5qCUsILhl916J5DX7tFwHAcMG8g_5kEQPP5ZLQUw&oe=6B06F6BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESkjdvLQmxQQ7kNvwEBD_zR&_nc_oc=Adq2_sRuY9ze9riTxKHAnuJh7P3MDev4vtPpnyNv74q0aC1MU1hPs6-18QDpW7Gh6PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRwtl0G68pJtdiTAxbS7B15Hp-6-u_eoDroyOHYI-Lfw&oe=6B07288E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiCKFRKZ2m4Q7kNvwGlr72R&_nc_oc=Adowfmna86yAHJEHSA4wKxRF8jG_rnlI3etIYC56MU7XX9SB11qAn1FVE014_ICWFCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyoFfhoTjiaqF3Ak0lBbaXv6GaW4XgWBuF1y4fmRXHgA&oe=6B071FCD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTe4bNJh6skQ7kNvwFhJKuI&_nc_oc=AdoC1cbze2Sm3frqUqf3vxX6osAVzG8YQXU3HEy5_zaThEhCF2OvHLmhvjD3cVHygro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUFz-n9SpBVSDcYmDnWWvEkN7iDOrs53Sc2diuQbM9Sw&oe=6B0725CF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LyBcqq
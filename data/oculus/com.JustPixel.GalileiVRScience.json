=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNylyxC3-Xw97bA5-XrkPboucT5EE-MMnNLMuZ250422Q&oe=6AE0CC8D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxgCi1qSkvwQ7kNvwEy99PQ&_nc_oc=Adrjd1jGi6P1EGveavnQhCPrLYT4jpz_qhVkcloUKymh8NVa72e1Y3A3qd0l0hcYzNI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPimnzq3YyHq6lkA39Zd9C2IvuO2NfggbkFIYnqTXfYkw&oe=6AE0C221"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDZ2XDPKBz8Q7kNvwEUiHdg&_nc_oc=AdpeUiXLAU-0Ty3ex38XIxiZXrHPeqWL28CFlx6s1wdPi8I6Sk1ujJkbi5wm967x4PA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7-eNz07bj95G8-oHXZpjKt1630t-uhfboZO6RW5ndgg&oe=6AE09E5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tbBVrRoAj0Q7kNvwElPEZz&_nc_oc=AdpkXwtKNY_Kzcm7l2j8D6glcHO3dtsBtk32sS2eNCIlAqPMXqRxGpKhDrSCnAZ15PM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhDS0Vz4wT3U0vyC2TOV2j1DzGIVvoBzruICo8j00vvA&oe=6AE0C930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6hLC2_yRmUQ7kNvwF2qHU7&_nc_oc=AdqQabQ2PTrGJSLLxilPLFBEUvDGKAtRqj9m9QwLEb3sJbOIqJQ10_BAxcESMWaPews&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy8aC465X3O1u6KYKX-Muh4vXJ_GQgFmodE35c0Mo9SQ&oe=6AE0BB3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.
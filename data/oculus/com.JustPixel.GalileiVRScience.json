ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpO-kHld_fYQ7kNvwFOFXRg&_nc_oc=AdrXFPchuVOMeRw2EQ8gVVsl5HqeKVLBPLP9sgmb8SiYYqrrmPzJATXoS_TJRG3EAlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVq5XmrfhG_6Epmz20KUxbqTqBYVKPqlyO2ffangemx2g&oe=6B0EF10D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LDmhl5Z9jsQ7kNvwGg-PKp&_nc_oc=AdpPzCUXNr413ipZjh8-OtUPDBpiQnxXYnPSZGyy51CPZ1LsjX56uZrmtb5zt1Ut8FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmf6CTjbT7kgSShQhZuVGiz2FpgAKCGPCvMrjmj250PQ&oe=6B0F1EE1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzlDhISWn0MQ7kNvwFsJg30&_nc_oc=Ado2mS2DVjZrfocbwmwoZlalrDnRgbpsgpAB6rkVf7kpTdciGBIVuOiwRnemUevhd_s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUnsE78N5Fta25JMWjxAI614TGsINyhlhR7zaXgJ9prSg&oe=6B0EFB1A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGMBnM3GvvwQ7kNvwH9_ErA&_nc_oc=AdrytJr51oQ59vcMdMqLjNqKLHRxamMmlwLqA3Pdd2vYOYxRxQpXOvHdqzaMZxmVWAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWVsDTg3LSsaeLllTADVeKQGbDDRB51__P3VaYf_YvypA&oe=6B0EEDB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eobgGYc_UQ7kNvwHyYv4X&_nc_oc=AdrSiPke9NdWD58AGyOSUqC-OiFj1KEjItKr-8J7piQDLBB65niVzDQM2FvTGi0UBek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVstZEDN-vhAlgueI-rBp8ysH283wymOEGYAxXcd1l_Yg&oe=6B0F17FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FedCESpdq6MQ7kNvwFBtWGt&_nc_oc=AdoIo9BcW0zDQuMH2p3ML3Tn9CBAFhcIiLfyYKp4jRfANXat2z2mofG4LbJtIBTcSxY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZjAOFIy0SOkhjPIPVbx8tf92USaYaZqRhaH1TXYvVNA&oe=6B0F118E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8D9IlJKh9cQ7kNvwGhaBla&_nc_oc=AdqNU_UPNXbY_qXWPYFxMxbd2Eb25IwM41TjI6u8Pc3RUNGz3YcbgXl2SrIwghLGeOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2MW9AfivKvtSEIlIgeN6OSC31HA9yriLejkQGlVpsCQ&oe=6B0F08CD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dWhDa-ZstAQ7kNvwHpmSeP&_nc_oc=AdoA32WM6eMHAb8e2LVGdkyIbqo-iyJsVTsWajG0nHZAj_44c_R7o3laA860_kLZ6lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoVBebiRwaZL76oiuZMnjWjttPOtim8RtKTfFSfTRf8A&oe=6B0F0ECF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKL_VBj
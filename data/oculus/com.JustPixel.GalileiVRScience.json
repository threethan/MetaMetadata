ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpO-kHld_fYQ7kNvwGBx4ny&_nc_oc=Adrg7yDgJQLR8RRg7GIqX1qUVuvG6V1ufubcq-VyNUnFZ49S-gW9AXxquEtjUyUV-9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXZru5Px0u_C8rgZ8hiJ4dyTnxXkZiQZ7Wmffmcpkk4tA&oe=6B10428D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LDmhl5Z9jsQ7kNvwHPrPri&_nc_oc=AdqO9yPVU6iMZpzTlvTPeFj-FPUPSBdI0PHzH3Rd1jFl534bbgGu_iS7CyunYkVxW50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2A3ZGwWbI0MWXCCzTMVpISAs0vInxCL0wmaSHCubE2g&oe=6B103821"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzlDhISWn0MQ7kNvwGr5xxD&_nc_oc=AdrO1vupqMLzlRHkdnqCek17Vhjr2H82f0lYzIHVlCwfezwTZ5Lary-vuE2g4ENvSj4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5jmVybs_IcZT8Q300au7Yk1daahhYJfVKf8RAWoI3og&oe=6B104C9A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGMBnM3GvvwQ7kNvwFUR4YN&_nc_oc=AdpwYrPDesmNeo1YdHyGbsEzaACOTWnon3ijIha6f-Jz1Eo96WZ_H60k2R9zBH3Cko4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXX-dvtThJDXtI1qUDPdA16nYKb1z4KwZ9j_BJLWg0caQ&oe=6B103F30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_eobgGYc_UQ7kNvwHiiiaz&_nc_oc=AdoPwdEdpg2pEJN2EhsJSt1kO5R5hAJQyIRXn6XeZXgfnBlLe0oe1TpQi1kTzFPwnQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUa2HpQIXH7rfLjCiR3F4SePo29ckhqdRYW9fAjMUnoaQ&oe=6B10697F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nzYVusgYV4Q7kNvwHSQH91&_nc_oc=AdplS5Ku4lxUgryjnkQZ1aM5Y-ny9d58nUe6SwIA2iQKKoPnlTtyoQRvo-4L7J1kUYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2JnlIvgzBfDEfdG7HOg01upKlwiSp696-sAKy4MxZeQ&oe=6B10630E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8D9IlJKh9cQ7kNvwHZBl6D&_nc_oc=AdqlVg8Gw7SMb589rocJUUHhkmhNB6iypYZNwnMP4wnJQzt-MuIV7S2g0Z83GiAY7UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWa26ibUHSAxoFpRinNOd_ShKJkPXn8SLJtG-ZAuVaJ3A&oe=6B105A4D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy5W6oBaUG8Q7kNvwFXWad2&_nc_oc=AdoC66Pcv368A9nSuJtco-3on39IuGkI2g4s4XDG3umYADSg-M3dweQW2Tm9vn1i7T4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVSzYZpbY3K2E00CdvT-5bJ0b9zqonRIKnH8qw41WnKBA&oe=6B10604F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKL_VBj
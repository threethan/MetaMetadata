=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-D6VsYKeoRxddTj8LuY5diAC2dLWzrgij1y9JW8b2lQ&oe=6AB3C14D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHpfaBBCJ-IQ7kNvwGX032W&_nc_oc=AdqeWvRIQMbJJHvQIn4iUozp7w415z5vCQvgwT7Jr1WdYjV1VlTPZxfLH9NH0lQvOc8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmWQGR_uJX7aAyQ6SbYPX5enWYWwAYEFJzBGjYxjey4g&oe=6AB3EF21"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TZUWGFyKdEQ7kNvwE-B_PO&_nc_oc=Adrq2E4wYmXcQO_zSDTfjRvcgiNAmrlrGsAJUwlaiacdQElg48027LBDzz9s-JY6W3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbKcfbTKScl0ahL8FP23-tvlMmYXXG9jfHQmuYoPfZAA&oe=6AB3CB5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SchyQkm9SqkQ7kNvwEDuDUt&_nc_oc=AdrA5Y8gmsdrz09hN6GYMH4Lv_LqW9NTDgTBYAOi_0HBWf2l40xxedizhZ03G5afD9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqze5caQGxhyw9Mku4kDineyLP_ZjLajHjS6TiEliFnA&oe=6AB3F630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v33mIscxeQUQ7kNvwHNxybV&_nc_oc=AdpzkxvbuRD-20KiA1MRLSMePOpxibr16N1O-OoM70KW96plhWIck71Z1ss-2hTkFLY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKByec0rzqoHZ2Nn5qqqW5t2GpOZoJb5wQHQ158QT9wkQ&oe=6AB3E83F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
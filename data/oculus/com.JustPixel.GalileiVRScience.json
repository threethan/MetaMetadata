=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1_gbWaRZKaCuN3UiPEfslNegRMUjqabHy4STX_cRSNA&oe=6A92CBCD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLtIFh0dWV8Q7kNvwHvnlZe&_nc_oc=Adpb54fBYtpHQAEY4MudYMJuki-ikzflr0fFxLgVpQWq5vnCrJikS2aSFE3Y1sG8Sv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqVY2IbHdt4OdpS0ojTRzkjcKNE_7lyPdo9PoHs7CA7A&oe=6A92C161"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2q4HQz2JWMQ7kNvwFw1zLI&_nc_oc=AdqmERPhfZA8xPXs44WNRilsQ1B1Xr1L-lZwulxmE9h9ikYI98a4IyP9Qb3MgSbTgEE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRIdlp8KVViz8z4oJmIO4KflruLid22rlO-0OCo5qSQw&oe=6A92D5DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=114oQyoJ5iwQ7kNvwFfp-75&_nc_oc=AdrRqv0b98yDpu3Liz_z-HQF6iOp2iBp6Af2Xnh6oqfDmur05Oc-gfL2XbJ3ek90yKM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGz_sHTUh3tDtM_QC4Q6NG3xtx1v0XGac0KTlf51qS8rg&oe=6A92C870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHaYVpXo2cwQ7kNvwFL_3Bx&_nc_oc=AdrL8Qpowr3XBFHsbvYRcAXSOt2wfxdWfl2umzGy5PbQBWXZCh7kV3kds1e1lowowJY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfKLMiNsB0Q5w8Gon23IE18IicPB5XvDhUjwcrdXrLEw&oe=6A92BA7F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
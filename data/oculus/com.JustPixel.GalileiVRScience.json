=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_6EGpMIFZaDr7HNBbb5CXFGNqlGC996UX9oA2BMPY1Q&oe=6A65F8CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKN_THBs41cQ7kNvwHfkIhk&_nc_oc=AdqFd-HcTSBVFc1lFw1dGHJYwS_1C8pYjhP4_r-RF7IjBjaSJ-bYGnLqdDJ9GQBtB0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVW8ZxECXmQ4HEArpFJsKOYj8gPBeWVYMk_tYdUy0nrQ&oe=6A65EE61"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnNqHZfISl0Q7kNvwHnhmYc&_nc_oc=AdoLtRtiQ9tgrIezVxuQzjEU1H7U_BaNHmFr_JD7YIpEnLGRxBOIKj26SY89I-8P0ew&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA--F5QP5xesPkqvT3gnhPLCFWM7IgHXvMTQrVuf2v1iQ&oe=6A6602DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9R8lp18rEUQ7kNvwEThs4O&_nc_oc=Adpzn8BhA2q-PvM4eFl2GlcTXiTRPYDVBYwqyDxnjZJs_joAjdRyxb2f4ebMdCq865w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_8i_eSfGEYaYXuO57-4HgvZNlUJh3t3EOswImF3O4cQ&oe=6A65F570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liExmNX7RmsQ7kNvwEHkUha&_nc_oc=AdpV62JCo9daE9GsuxLo7DURaHXPBnXOK3kXumsBPkuuywCeE1VWi-o8dzwNGVNp7Qc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCaJvTzz7Ol53kMwHT__tXyimzNm2YRThNG4E9AzPlRw&oe=6A661FBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.
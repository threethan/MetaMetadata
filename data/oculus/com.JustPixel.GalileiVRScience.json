=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp1ImCqa5z6A-7QaiXRS3HfT_oBWlnJJQv9bZfucIjog&oe=6AE1E5CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxgCi1qSkvwQ7kNvwH9Pub4&_nc_oc=AdoFhjfHDv-PLy6qSa154OeDMJh2HLFf19VPDWqEKjaGMeBcrf-DNCTQftlKvl4-zcY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5_Y7uNj_XVJxK-x7zm29eSSqorpmzR2A9dUhowf_VEg&oe=6AE213A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDZ2XDPKBz8Q7kNvwHggFLN&_nc_oc=AdrEpjtz_rF86vwXIUzYv5u3qjrgREA4dDEbuv2uck3gkDJmFckQ1Paj_UebBDMbDl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsDxVDZrbIcQOsdA5YH2qlhM0coxAlTmqNBbVvv0Q1NA&oe=6AE1EFDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tbBVrRoAj0Q7kNvwFjrVdb&_nc_oc=AdpqQ_Y0B_uKs9R1rkL8bYqHMlzOLVfshrWc-_8HjMwakoM59ldXnDW6UE4cEX05g-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPMN4fCSOWMJe93JC7d93H-OSJklDPdq613tyBem_LPg&oe=6AE21AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g56qodBRDYQ7kNvwFRYQ4y&_nc_oc=Adp-hPqRc3DbIP6PpjjAQomvqa8j3jc_ck-L8k9cE9YM1IYuSyy2de-gTUDhzQoPacQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIu3qWrfOoB9fSDEzDJZEZsTasVr1GVY_3mTKf3qeYQA&oe=6AE20CBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
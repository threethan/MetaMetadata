=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIap45mW9aMZCK98J2whMqiP6_eV7e_e8FcPIS2ZlGaxw&oe=6AB2A80D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHpfaBBCJ-IQ7kNvwFwHSc5&_nc_oc=AdqBVCt0xRyz9EhmNrcO4ML3UovlLQldS4OzB04L95PJTD8R_QrJyUW-8Wvjbwv1niU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgF7Ohj-g23xw4MwWLonXW6rGcY7rVKl7PYBhB7evRSA&oe=6AB29DA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfjLBuyKCl4Q7kNvwEjZevG&_nc_oc=Adqf145OAJaeclzNc1IixZQwcGbIdE_WpaPp6BnH97Zvg7p1dB5aEqTBFitx-HIzsbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-Vdxrfj43FH7E2-eYxiCMzRHSGYjr82t_Oo1YzdYAuQ&oe=6AB279DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLNpH6kP1PYQ7kNvwGygvIo&_nc_oc=AdrG5XQmzhqspLuH-yeezihFN5FlOK9GGDUSZGPqL_G7v18MPBUFHfPxCWv2wFGgEuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjSio5UM8qqanouS1h5RPYMXhbk1rTs6z-vufsYJRAOg&oe=6AB2A4B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v33mIscxeQUQ7kNvwFRMEhu&_nc_oc=AdrfGvs4zUabWEmHvvuKn2eMVFo3kMJP2aSLlnq9Kf5MTwZuZOZD_vH98CTiesA2Xag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiPNG8mXbm1KnLNRxZQeEkVxpMP_VOfllp9OBS_ql7Xw&oe=6AB296BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.
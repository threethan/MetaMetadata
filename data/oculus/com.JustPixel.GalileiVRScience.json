ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqjqYf06aGgQ7kNvwGuLF4W&_nc_oc=AdqjNKxxbqXIym842Kat-z9i_Ap-DXGbotvvcugixwstkDLsh5iXCUptHVy5KJP6GGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSBS0nrxOoJwz4w5x5ln16qB7xWisv60ZgCnE6Vz6hzA&oe=6B05B68D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGVrzirc-voQ7kNvwGb5NUa&_nc_oc=Ado1OfyzYswk39wz88DDXvYvoPuxPsEPJ-f5tRddFLmXG9O6d3ssyZtmvgPMpj9Link&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7K3jMsq55ZULXv6YR0Y1AZHr03Mc98_MywNlSNZQCMg&oe=6B05AC21"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7fgDEQKIMQ7kNvwFoGtqF&_nc_oc=AdogQC3VHjv9N7nQ3FJQnZU0BYvpa56mS8xR8qedQ_fYCbL4q7RthWo4oBv89vUeGEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Bt86ATX9ruDlzAmQqW9u9olZfXNtUzJmc3gsz4MRiA&oe=6B05C09A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFQ67MLShl0Q7kNvwGJaf1p&_nc_oc=Adr54OpZsqdgyEm5327OA-odahc_3nsjPzXhMLLPugHnGnMQQXmcJVsYHyDfY3b3UrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhCPAp4X3dFmg2mNGVgCNk5ne8RK31cnYSG6Pa6FwKoA&oe=6B05B330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3M_PE74ei0Q7kNvwHMsAy9&_nc_oc=AdoY0Z63TCmtai3MpZjzH0l-NdV5WEfyM2i-4_zN8zC3B9nHiCK2Kkx2eW4xjU5ieLM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVX9QJlT5z7lW9V8mFdtaMrxg2hsdBQxIi1P_PXe4w3A&oe=6B05A53F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESkjdvLQmxQQ7kNvwG3EZyI&_nc_oc=AdpgV1Sgu0NUXtejDC-nIb2uH_6wdEyo_pQNe_Rag6bwvOFm-Wv6K4GDrnlIz5Jxuc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvK7GCGTHY8vqfJNMiQfbsj9Qf4s9Y5X-J0KCfzmqGTw&oe=6B05D70E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiCKFRKZ2m4Q7kNvwG9iWBn&_nc_oc=Ado9JK-heybpyajExsJ6v7IU7ACF2zzrhcG0BpDVDYY3qWA-yxil-tKY3ebEnE7WgBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWobUNtqq0xofzOwtluriHpMnSARJHeltCgv3JtHwPbA&oe=6B05CE4D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTe4bNJh6skQ7kNvwGys2EX&_nc_oc=AdoXzCt8PND2Q18kVvuCZJDWgvQ_29RN6sCyczQqTlDufoCLpWbq6CmF6deH95jA5-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPksh5bISlFRF7h7LL4B8rt1BVbE-jOAupWv4inqdRjg&oe=6B05D44F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2xCFuD
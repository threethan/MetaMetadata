-7&_nc_sid=6e7a0a&_nc_ohc=h1Umx1o0vEUQ7kNvwGFK0kZ&_nc_oc=AdkgIQ8tnM7eMXFnNfqhOwQ4SIAkL9qI9BdRSV5FJCvEkD1j9eG7UVenmJjvssFm_TI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuCFhtRxNqC6uWMrACu-Nom0_GYDi7qLaGPoqw1vIGVwg&oe=69983C10"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4SLcxM6Ly4Q7kNvwGHrb8n&_nc_oc=AdmyM-PtPmwmvytNbiCuIfNG6sB-IPE7Daw17PqOBB0-lMIB48yJXQWLwrLsy2V00xQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuAehERQ1ms5C5Je2bJkxJwoWxkdsh_g0c4DeHK2fL5Fw&oe=69983BA4"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5BsQKu47a0Q7kNvwG1GoIm&_nc_oc=AdkIAQZbNoqzuW5kocOHyUpUGk5ZeYB0ACmEi8QxOiEJJ9kdFm9nhjDPa1o3c8B5ycA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvPvMWedMCxgN-0_OEPddRpnJXxUc1FSIebM3WYtW87aA&oe=69983FC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvjvYxj4DPAQ7kNvwE8uvCu&_nc_oc=AdmA8JG4Zzhm8IIQq1w52BeZUAQErsSN0YfPMAgf8Ri9g1QRTHQM4YRPmonGgOMw8HI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu8raJwBmm2iPxLNtUrL8Ur41nncnP1f53oDutop00lDQ&oe=69984D31"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKoLVxL617AQ7kNvwF4GUeY&_nc_oc=AdnCSdZQ-Gb6lJ2k8qqkTzs
ea5-1.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylwS88DRsrMQ7kNvwH7oxFd&_nc_oc=AdoAfGn9svSyO3a-Ak0EJSHvnGFV3gBmsNQWJvPB0BbZR81-nzL04dwg41fkjRhWgJ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt_EJizHpgonhaCYziiJ3O5OIoUfHWVzvTuAVsgflAGQ&oe=6AFC7C0D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf2UeBuYsgAQ7kNvwHSN8cl&_nc_oc=AdrSErqAX7DfSRq3u2W8sCpPOIlta1XyN4MyM1BCaofhfkBdc71RCCUXQZ8ZXopuShU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyn_lUpTEFkQZw1g1TYX1f473cisVr59g1irjM3v-9uA&oe=6AFC71A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxveNtUPaJYQ7kNvwES7v2u&_nc_oc=Adq3JktyHiHVfIA7Up18FJKGydoK0cKJAljdVpXy3C9oCJqhk39QRFK_0kFHKtVMuRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvZI6ib2J70uPq_iwh6BSYmf3oCo99szGZg94gxj6Q7g&oe=6AFC861A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YURZnT7651YQ7kNvwGhicTo&_nc_oc=AdpbPrRLIfr_lwZs0GREmY1OSAwis3ZJzXavDi460c8A-CkKfBBsmizAyBypT3OlD6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_MNN6x8Gupwhx9hR_1woYkt5VZLNtNDe3bhGzGEU29A&oe=6AFC78B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rBUhIkiKdkQ7kNvwFsjUdl&_nc_oc=Ado-ZKjDfsBnPVFIkR1zHKsujYwiF5esSAx2qKHWRip8vgC0C_V-QvsXPJkCab8QzZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNwDKRe6PLe2h5Muf8aZJ5GGjgO2O2cR_v-ZZ3For5lQ&oe=6AFC6ABF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bI3-nLcgMYYQ7kNvwFwFQLe&_nc_oc=Adp_K_u27ZqisEFv6DUYDftavOgK4W_N_XCS3fmHlIgTL_H2_ZLDmfhSLmrkkHUOavs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKr_GIqkjb7SopsEu3QN3uPj2EkBVZ4yUP6cQaaTbXQg&oe=6AFC644E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLRh5VP0dLsQ7kNvwF8uokA&_nc_oc=AdoT28C8p9w79WwqwOKQat-kJLQrKWgCUX0wP1fSnYw8rzF5PP6fm9-WQ-evGoH20Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXjZ4mqwzcTPd3b7fIEua9pUA1mElYg2hEZwMV1S8I5A&oe=6AFC93CD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aZ4dCDkiEcQ7kNvwHA-oMQ&_nc_oc=Adq9QryxhJAhkLjqeVuh8HLukX_2Zk985TbF7zbOtr269b2LOtNbhla8oOs-SH_4wdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsZhZvaz8S0eKiYRS2ekNiW4cb0j1BBYDfUOMYzDd5Eg&oe=6AFC618F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E13aPkO
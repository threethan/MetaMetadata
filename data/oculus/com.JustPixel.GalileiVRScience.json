=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af092YdE4VOeNY_nSmtrpFyxm0ZsPpSOtWrmHlPYiq3txQ&oe=69EE004D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00RgBfSBl9IQ7kNvwHb75by&_nc_oc=AdpsqSl-tt1N66HL3erMN-Wbwv0BDHBpsU-9aluAeZ5NndustAsZgqes9xftdyhHbZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0owSVtkYNyqMGy76hAPIjmsY7SZEH9XC23EC9oWskSzA&oe=69EDF5E1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoN_S3V5l0MQ7kNvwERMNv7&_nc_oc=AdpHJegmFUhWuYAvxFRjF3vSn1BDMI9cYBL0diZ5p_LS_BJ1juPU7jsrx6PddXgX6po&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uVr45tupfI2bgfNoE-NgrZhlAGGSj3S9RgZOwaAzFug&oe=69EE0A5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFcdwcVzeswQ7kNvwEZS5kf&_nc_oc=AdpZAu1SocErxRkQMvCkd6ABmrAFvM52P5Q8FYj5rKGbyxttXeh5NnXMbEAgp4giuyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fAjc9Qd8jdWGQicbFdH4J7bR5G_8vClWSTJyx0Mw9Ew&oe=69EDFCF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-UFOw_2hb0Q7kNvwF8doo1&_nc_oc=AdrQuxUH93wJvJVSd0FSCa_pVIqkPf84tnJ4HlVUTUtTT6Dj5qq1PMYxluo0mZiSgu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GeVxCADXF7PmXDC0xLQ_a1H5hm7sV80yvjYobR_vYxA&oe=69EE273F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9BSPwIB8JFBggFu-06UPRtoxS5OCeK-1THIHXvRtrUw&oe=69D0FF4D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkfGi3Z2sD8Q7kNvwEf1xV0&_nc_oc=AdpZNCa4MV0r08J9F1fQ3jfbrobYXLkuJbbJRqtHwHXBoxuWvIQwnl106Zm7KSa-sIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_4waA9FDwMGwuVAO6VkmMgj8TixjdbQub_B0TYnOkIg&oe=69D0F4E1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZpAwIu0fbQQ7kNvwGlaSBk&_nc_oc=Adpb_sS0t3C3mgNrjb7bCaTahItgAruT9SA6IWjsbTBnlrFbvKneQTnZ6VrO5tnheWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz54L-H7EKZJcrjjumT11wtV9I7luNG0DmONpjUfaUWBA&oe=69D1095A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyGwPUdKaKwQ7kNvwH21pup&_nc_oc=AdrfTyPR2yfvIivAV0OvRkwjKj6ktg0MB7jwofKaQMJyp5A4Qd0QMCLmjoXsX2sxq8g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKBSNHGUwnqlb6o-1-s0FMny9ZZDSlW6toQceODB7jzQ&oe=69D0FBF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgHuxDhitSkQ7kNvwFQbwyL&_nc_oc=AdrrDrpEoMER47wN9HjPFwVyUqH-o_kz2OzheMYTQu_sGI0WTVJ9HYRzam_qc_wQszA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVtztLKhCCRbIiy5l03j0xlSTNdumULYTBvRrkXToqTg&oe=69D0EDFF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.
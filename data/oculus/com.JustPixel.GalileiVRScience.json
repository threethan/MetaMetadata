=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwnXFcCHOh3gKmigjVAmPVblsU1mdN6Ydp12PbXiFQoA&oe=6A689BCD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKN_THBs41cQ7kNvwGhwEDe&_nc_oc=Adoct2px85G3tNp3j_uvstLNelZukgfFBWnbGPFXaFjTD48w_0q_C0LEiD7R-xdd1pg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOLNDOCAJkGQGYUPDkIOVi1QFCW8Zt9fAH8dqV11YJpA&oe=6A689161"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHn8IIKttPAQ7kNvwG0KsIm&_nc_oc=AdpS7NjKId8Sv8wuo4BFyXL7JD_0v72a00J_BAgdAoqP0CVSVjRYKkr2v2sH64x-qb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnZn8fbuIA8yt3iHksVq39S0cSK4FjtaFsVG2FokWo1g&oe=6A68A5DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnLVKJC7zdYQ7kNvwG-dhUX&_nc_oc=AdrQ1wg7m1akM6VcgGuYTKACXfW8Fm1-zl0R5gkrOmeXSOw5MSVRpL0iR4SpnT2CcPs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr4kK1c952XTEgO0LunZnP9hQrI6R0Ke4o2yEjTlgXnw&oe=6A689870"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PStsWCrVd4gQ7kNvwFoMy4t&_nc_oc=AdpJCIhuno88jyB2DPMO4ONN6rDmNIGySj05QONxBRzF8reJQKWl-UW7Hbcal0kT4VE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDCF5xrLDq1fYAMRDs9-NFhRfTWKwaAKw93vjTuRS7Rg&oe=6A68C2BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
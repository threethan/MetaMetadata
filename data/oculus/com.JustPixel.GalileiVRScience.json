=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QrmzTlz50JEz7ZdOwAnU94575s3vaiPvzadk7sRRzbw&oe=6A41470D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72SjdIiMkrMQ7kNvwGL61J7&_nc_oc=AdqZbj7S6SnQV3F_0HGhf0b2n-kCBQ5oLVIA7GckdWpM5d6Htq6BqoE-0EVZE5XFxjo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h7E3jOG5g_rAW1ADnCtiC3Xenjy1kTFJthddyw7EzmA&oe=6A413CA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WpRP-LANOgQ7kNvwEhOpMo&_nc_oc=AdppSkSFENTtutNL2ABrNLDvIDWaOAwTxN8ksttAwOCxQKfKS6V527ohW8xJET276Yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PnENkrpNaM774RKlrNUXittuzOZDbOCkFfC7xR8-Cgg&oe=6A4118DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWbb9e2yJ34Q7kNvwGpGqIU&_nc_oc=AdpBlbi7KQdhVYbGF4ynLbmwIRPQJg8bVJw3N74QhQN5BYqJGjy-M4MbzP6Lw6RKrdI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jZVsNgc_PMnBd_9RAJBZl72F7-WyBzrPLSOEGWZ2kzQ&oe=6A4143B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OUDjqExyukQ7kNvwEYgF5R&_nc_oc=Adp3A-tuyH8h1zQmpiALhr6Px5eeKMaf9gceXBitlq3tRC2ej2xgMAGWt8bOYAWQ69Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RF-f_MQf0pZwuigjWBAPlMiUUFD3sJJj6-sm-0l1oBA&oe=6A4135BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
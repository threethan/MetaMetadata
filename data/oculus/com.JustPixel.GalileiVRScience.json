, {"file_name": "Landscape Mini.png", "id": "513806047726163", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982645_513806051059496_4223857969464332917_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggEjfE2mk9sQ7kNvwHgG5M7&_nc_oc=AdmCos1L9dChvsDTl1VHa3VnrWFfjwha2ukzV5-smbFDWY6N8oil27qNqnmJy6J-MsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuV4z-IQFJgZHT5VG82A_V3wbZQgpKvCI-QA0P5k2rqIQ&oe=699EDF0B"}, {"file_name": "Landscape Square.png", "id": "493094060118611", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031398_493094063451944_436248626179243058_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gfrO9_tBfoQ7kNvwGBRfha&_nc_oc=AdksW8E8Dq4rOSmNA6wzgN4DUwwzm28XzTo_oV7_EvnIZtzpVbMIIPqq2SsAT0sv-R8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7GzzBVz_Oi0dLacQCcXhZhUZ_d9aB_a106Et-bOoFiA&oe=699EE399"}]}, "id": "484376654518407", "locale": "en_US", "screenshots": [{"file_name": "Artboard 5.png", "id": "2759662717526847", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036623_2759662720860180_2489395151907338724_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6vq15JKfk4Q7kNvwEu20f8&_nc_oc=AdkIs0rdmv53BgIz7gEsqgy3kZ-PryPk85FVtb34hnzt7V8kLTwanyEfQDwCTOO5XrY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvbsWmMahC5ci3_DXYszOzZ4YammDXkbaS0rbvY73RW8Q&oe=699EF572"}, {"file_name": "Artboard 4.png", "id": "2251639125188099", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974450_2251639131854765_8396477208328520911_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ9giFULyWwQ7kNvwEuQtNn&_nc_oc=Adn1dhKYpTrva_biK84k0pWtYnbLiBR912Jr_wsNgH61qbBnhWWX4buqIDAFSrWZDBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfulWPA_l5LedmjAtommrh4gRo-EHBGtq7u2R5zOwTeAaw&oe=699EE2A9"}, {"file_name": "Artboard 2.png", "id": "473243412277688", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984439_473243418944354_2938823070153890993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeoSyi50tukQ7kNvwHAjod-&_nc_oc=Adl8ZzC-r0vIZAhMG9DhxthHyPk89nNp1Pu78EEzYOWX_ckOebQuwl42m1c5MZ7-F8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvm44_mnP0L4N8X9_ACTlNnrVZTQaAHWc-7HqdsOhVneA&oe=699F0377"}, {"file_name": "Artboard 1.png", "id": "1543351499921825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974887_1543351503255158_348442130487521407_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKIHBBzx-mMQ7kNvwHO75jF&_nc_oc=AdnuMA3MEP8MZfbgUloKNMftGoY6TD0zIl6z5b2F3AH3YmvCs4UO3Z8HYZg5Xy4oNNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuoWcN3jMGn1KvPjW2-ouH2Kol9pWF6DUQ_TWea7PsU0A&oe=699ED146"}, {"file_name": "Artboard 3.png", "id": "912383657378781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031432_912383660712114_2572436446715478623_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk-IQY2mpcYQ7kNvwEpuWhK&_nc_oc=AdkPgKOJ8bYWgPgiQqgxzPRx-VBJigZilt7WsJNB9qF3CtvmvJD_q6_AD-vkbSrBw7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfucJ0vuyljeAirTuj-jY5tDb_Na-vKRjot-5wt89PzhhQ&oe=699EF07A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "3748813912049179", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_3748813915382512_2166423531006939259_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw1iu0pSuPUQ7kNvwFTea1h&_nc_oc=Admm4B_25vvuvq4J1jxDIft7Y0HcsKb5sC3R-IFq5fVni3yc64Gz7wQaBhSO1uHoAsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftPESi7DCmTySolbH2qloyWLA1Fe2ybTHK0b3NIM438_A&oe=699F050D"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that lets you explore cellular structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}]}, "developer_name": "Just Ware", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/93783224", "developer_terms_of_service_url": "https://www.iubenda.com/terms-and-conditions/93783224", "publisher_name": "Just Ware", "support_website_url": "https://justware.it/supporto/", "website_url": "https://justware.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_top
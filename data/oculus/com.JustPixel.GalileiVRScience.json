=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCatrmSpwL64Chu9No6Ix-oqED5QPLpHz69K-TSwTDFDA&oe=6A5383CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46l4YxuEWl4Q7kNvwEvRMz_&_nc_oc=Adou68NbkO3fhZfvh4dy9dbanBIyaKsp6wdTgJZlTBJPFfQe7soB2rCMOBt2wCB4WRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmii-v7Z2vWgO8JxCFTRwBFmbWRn4GTw3WtkI7l0vtiA&oe=6A53B1A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jznzZgEVstIQ7kNvwF38xSd&_nc_oc=AdrLCu8J7QyopueU3U5njAksMfs0THqH6vvraXzFtIRwB8NmyKuSWcStvZXyzHwkY1k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqcFzYI26wfA90QWc7co_56iUp9Dsg4EGrY9zSf9uCLg&oe=6A538DDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab826bKTRakQ7kNvwG84r5y&_nc_oc=Adqi4bYP0GjHdFR74OR5ngWUbunBXKjIC9uj1cqVWI2wIxtqVenpl9RMJByyQtOBQnw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDakJ_o1yT1qdeuBYbXsmLkkW33u0jbdDdd8Sdlr1HlDg&oe=6A538070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aswaAFRTE2UQ7kNvwFx3wq9&_nc_oc=Adq2LGdwYQPC8Sj29yFEGaCs8xGKnoQPvdmhXiRna1OD_6L5ym9ig23RW8kk8wGgEUY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc7gbuXlqtpWQp-SN0TQK266QnURte7wNkdHtzFlP-uw&oe=6A53AABF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lN0sF88dxfKgO6cIv4iKiRibA3a-X-2dG-H8DklYt0Q&oe=6A0EF5CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JXhwCPJIwQQ7kNvwGXr7iw&_nc_oc=Adp82tEYwy6Aaz2cKaf7JRpxwXZbApIdUMbfyz--_3VesKT9hxq0CstpmyCoQfAAg5M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PAikyIrx7lacKOceLEbjKWoBe5Xv6RKi8zNDB-DMCNw&oe=6A0F23A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlr-ZRWJ2ZAQ7kNvwHrEpjJ&_nc_oc=Adoin-ceCBKLywbAAUE0UNGYDqaVS1hJ1_UzuBjQxxzclmBNX8O19AWpM3v9qASUUaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mLym3c2zxz7uMcS4_y5EAkA4IUnK3gkJpOfCKUCnBcA&oe=6A0EFFDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxnFqI3eXmIQ7kNvwGSlD5I&_nc_oc=Adp2OTpx2I9z2qdtcwrySkU7GDOlX-F49OxhNV4W2AH3vhOPzsAhkz6EHgRna5Fk8yQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QsrlIOd69FH4VqhmXW3vDWyE2xqj_z691-y5LoHLuug&oe=6A0F2AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM-WqGJ3B0IQ7kNvwFbY11j&_nc_oc=AdpUIUdTbUtPOyFnVNxIDF_8V5TqoedNHL7qllh9hLKVeI4umSXUbgEgQ2vyggLh7wc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uPv_zEkeYDwfhAnJnUhu4yyGUdhImWtMEMsGhsvWkxA&oe=6A0F1CBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.
=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OGHgfSGfdXWoLHpt3HISTGQrimFrwQnJnrfc0oOL6Gg&oe=69FDD24D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXiZEOHXDdYQ7kNvwHXhFPV&_nc_oc=AdqQWIyO3zyByZA5dY04xHyuA0jsP-g7oq8HnY_OsmaLHOhbULHZXv00E1f2rCqe2Lw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40tP8klejGWbQ41LRJ_HdsSt4x8b7Yb-vDmPO3MY4eYA&oe=69FE0021"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zL4GJ_1rmokQ7kNvwHc4ylo&_nc_oc=AdpSe5RGPlOXXXbMRF7Mm44WhLi025bXx1uWIBEkiPh5f9Y099XfeA8ELc6pidGIl0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JeH9kF7bI6YqKpWTMQDHR8zxL8RgZvJsmbzvHuONa0A&oe=69FDDC5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MbAAbvmwYMQ7kNvwFaqueO&_nc_oc=AdoLXJ0ub7WygH2BOFiaKDLtiJ5yJF1dkqvBtfMyFhOS8vEbheLR5Dsn3nb8h47l9iM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cCLVWL6g0vvvHn8bWu7BuKxsX6-Kqzf_6Rd13iVa4cw&oe=69FE0730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBdl5h9nfIMQ7kNvwGA43Fy&_nc_oc=Adri0Ai24hz6AK-Gu8jOPoe09jP8LM0uoLDYpAFBB2IYWLwSq3j8UuqI-nIHqOMwi9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AhO34_tYmEMU1wlKpcLn5nF3OVi2k-NNivti448MmSw&oe=69FDF93F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.
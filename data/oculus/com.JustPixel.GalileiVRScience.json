ad3-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FTco_jkCG8Q7kNvwEoTLHJ&_nc_oc=AdrWTBepd1kfEoUSuTrFbpFBwCRtZRYmKUsdMi4dxF-EGwnzjjFgbc1VI9rVq50cRmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6jOHgVYa1kRJKVvQHJ2TKseeULW1XHOD2b3XvtMOe2Q&oe=6B04650D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGVrzirc-voQ7kNvwHxut0w&_nc_oc=Adrnv7il0HS2xa9KvN8SOgIp4BsHfGz_o5ldjazW7pgf7RF-HoHdvSN_cda8JMqZb48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwuy-pIVUdWpL3LQwlc7H_o4-TtQYLjgl-zp0NSb5QLg&oe=6B045AA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj7fgDEQKIMQ7kNvwHHeZfH&_nc_oc=Ado9yU2Mqvk1uGaYZ86La_BkbcHjun6fGMSG6MQThS9zYWk1Ay2hJ9LuwAkIO8t6eb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT8lUCa8fsg6Bqzbd3lJ69nJ4VhNsYtvaL_AEkgGdTkg&oe=6B046F1A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFQ67MLShl0Q7kNvwH_k88U&_nc_oc=AdruNnnF7Xvkb-yGdHjMTMRIFo8d_zWl9JKCxSOXq-0s4LsBJYpjskxp0bt4rfCnX4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIbypHDLjXCHTxMhznFljLuyyjSzfEF-y9RsTIt7Rnmw&oe=6B0461B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PurMI5LWl3oQ7kNvwE58tlf&_nc_oc=AdoQhm6hOncRWGp74cjh67dnWSfr64Au2o6ZGeAllDUAQMtTtHLYOrZ1Qq8NDQ8dt-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfs3YMZ5LhpFstEcHrxZqFvm2mRJqz9PsUVSz2rg9K2Q&oe=6B0453BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESkjdvLQmxQQ7kNvwE4-RpF&_nc_oc=AdoyZsfko_xbvpOmfLKNrSwyXr-mlT1oqXY7RjzFlFQkJdkUenL9jPn0ZwNpo_c0o9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6UgRStFlJO-cJk3ADBmtpUQLtRcu128k0Wid82Q6VOw&oe=6B04858E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS5ttd9zaBEQ7kNvwFoYjz-&_nc_oc=AdpoUzPF5WfTjwTmme-8A2tJ7jAOCdSVybGqaH3X1DU7NOFtKWrZLL0vHq1oPrTffME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXi4yVOD3WO6yL8SsMMydFJ04CaKciz8NVf1oC95vNZA&oe=6B047CCD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTe4bNJh6skQ7kNvwFT9XbH&_nc_oc=Adrv8nikcoIsyNL1Ngn5ezTr_pgZUklnXIkmeMTSNPlbQcE2PiN-e1LmuCVCwSroqW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4l-XPMBessy669036HL4AmgceDVvyGjTYls5D9MnD0Q&oe=6B0482CF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2xCFuD
=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFudW1K6p_tfc5VCBmQX0-pTxs-qSY0uH_HCnoKn0P7hw&oe=6A86EE4D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpVcJHWL7GMQ7kNvwE9xmim&_nc_oc=AdoOqm-mbfv1ifchWLaZpVcufNC6KQn5Bo10efdxrHG-CkRXZGBTGYoyvkVcCPCtzyA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQyWH2hb5dSwQVxP6QiSC8G5UoKC6hvnGmWM6q-TblsA&oe=6A86E3E1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUW0f_2BZrcQ7kNvwG1RPER&_nc_oc=AdrtPXL5oSd-c5l43U4c2t7DeNKH4XgMXOwlVEzT4VMmAY5dnPNRr7y__8gDkdWOAq8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxvw4I3sq10jTb8gohe1wlw8TKGMWEdtYvWryVAhMTGg&oe=6A86F85A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTRNbv4cNHAQ7kNvwEonchI&_nc_oc=AdrWkdaa4-kYU-JaF185pDuvgXxnSqDSEROsgI0UEnxNKz7cxKS0S-Owsae79KkfEtQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy2496pU2g2f-1mUWoty2TwzKt7j0ZLBs7oEnkpgNVeA&oe=6A86EAF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqdtJ54h8EYQ7kNvwEgLpcw&_nc_oc=AdpXXiDOmvG8pSfRUhOoZfsbPQDA594hlXJ1P_bTyoDnlc1rBsBljWALSCJprI2VN3A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm1XzUSU71TbqXRgGlpCUxz3mtsrMBteYBOHUvL_Q-xA&oe=6A86DCFF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
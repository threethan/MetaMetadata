=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDemYPlhgZrZDSLfNhbLwq6KpQCOQ0IJpnnDe8S84_IrA&oe=6A5A1B4D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1_N49i5wRQQ7kNvwHPHETD&_nc_oc=AdpLFe_g_C7sdiS6j2fobzVhy7Q60XNGv2ULBc6olz3pZ9og5tczse8m1bK0qwem60k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlXvHF-wGkgeDr1qavEYNthdvhISSHTwd4nbWTaWaNKA&oe=6A5A4921"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta9NzxPD4CAQ7kNvwHKDQEN&_nc_oc=AdrSl_KKpSPTVj86sa_oVK8cYiEhcnVjbT8-jiB7G3TEiVVXAaY_LzX9wMM2Nd7sqfQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBa2bTA4TqADJRlN1R5WSKlyA7LTo6CRfwm4k_JQeSegw&oe=6A5A255A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ItxcxpyOlQQ7kNvwFxKfK0&_nc_oc=Ado-7rNF2XWWGiTtF5L0RzVJB-_fY5UllHenO_e3RNk1FNTb-Cp9AICk_qoK_9iWMEo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD68DbvrV4IgBhWcoYoWUlCatNqDFyNoIZPVKwboquwqA&oe=6A5A17F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5W31FHlyZMQ7kNvwFsM4iB&_nc_oc=AdoiE0O8BoTMoWxPK_z7FLias7VY1ybN7oRNuN56BgVof0OaybUxkImFg1gmDJPOd9w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_K0PI0HRzphKvPe9t0wBjubRBUeYbvIGh_il1Qgen1w&oe=6A5A423F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.
-7&_nc_sid=6e7a0a&_nc_ohc=1_aN3vc-HwoQ7kNvwHtAuKq&_nc_oc=AdlUU6Qn0zH2DDDjQF1Ducj45y5pax6qk5dzJXDVt36-f70hR81IHgpIZ8s8kYxHggA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsun2OuLD9xHetr7e06fz15zbwCpSPsENm9hwIAH-38aw&oe=69A2C810"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgxDZYOmsScQ7kNvwE-nlq4&_nc_oc=AdmqH_b9hV4NqaPs24fyJuOLXfAq02KU6TyXo3d5-FQpr5ORCSxCtE7y--3YaXKTBrE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-8UVzJCZcOGALfMddUzd8MitkNUaoSxhYFXmfO2Xgxw&oe=69A2C7A4"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnaGdxSPB4UQ7kNvwEL5Jmk&_nc_oc=AdmbAiUQHj4WB5W480pydHSUQq5-SirsDdKug9dWt05wJ-k68gQHe7i6NidIlwNt7co&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMy7nzdKoneeH9JbcYapz26XoKge_YKDZQRzm8cwU0uQ&oe=69A2CBC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF_aPWrjP6MQ7kNvwG8pWa9&_nc_oc=AdkpfYkuSFHzb6ltuQfRHSfpfil6xKzyCTzq6zoPwVzH5Q9LnJSNq96sOj7DSHOpA8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftFfVSGzhoPBTDN2m55OCCoZCCWNOiFfEwnLbPkMJIcxQ&oe=69A2D931"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HJn1Me-SScQ7kNvwH7Q4gs&_nc_oc=AdkUG3yE2AbxZOBqizeBGD4
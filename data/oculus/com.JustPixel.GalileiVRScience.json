=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aMo2GgWRoe-XRRXBZdYF9h-RmQ3UOadRQdApmVr-zQQ&oe=69E222CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zrK0KlBiV4Q7kNvwEp8SWm&_nc_oc=Adr5jVSG4uftfo4PY0CnqA1z-N5mwigk9guqTtvsuiMR5Hn9MNFBLuz8ZZg6mqTRg8Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JMEcw01T44urOJDYL_hUOv_f9Ri3QRqQFPF7pZHrqnA&oe=69E250A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDL_Oy8OuYEQ7kNvwGk_B0_&_nc_oc=Adrnwa0KspxIwhiTaNWWJSc1u_JCC8sPUpk5jSAdPay8199XNDaNBiD_Ac_4RP1B9DE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38KMmbZC2b98eWBOesxYJJeiLJ6S0mqBMeMpECVY2Rmw&oe=69E22CDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAtGwnRphGEQ7kNvwEenHAZ&_nc_oc=Adpcn4sBQSYYjhF6GBc8z0Q3Q65sLVGmroCvtpxejY0c-tVQMwZXSuF-CF-gI6jfIX0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qAMMD7WkoiyNHKSuNT-bLsEPZ9RorO8nGUaSXxAdD-g&oe=69E21F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzCeE4CY908Q7kNvwHMxrOB&_nc_oc=AdpAIbC-wipbdxt8-sQ_n1J-JLxL4U7Wp9sqLKDV5p9Jg9yWRmYvAYTR1P68mnYE850&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x_H6ngrajhih270e_OwlgqpSVKfMyg-wKo0Y2Ad32YQ&oe=69E249BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.
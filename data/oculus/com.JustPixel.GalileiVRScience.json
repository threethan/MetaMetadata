=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpJfrgKovZve_y2hlUxtwnqvF-PAwttLXgk3z09GqvRw&oe=6A9730CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoHUDtfpLQQQ7kNvwE2RJRN&_nc_oc=AdonXNrFLKs2c3LV1q2lFJaCbyt9VI9pBvbJesuZ7GxUQtXA-QV_Ir4Ok7VpR1RQsmk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVNB7iZHOnELcbD03e8_wGo1-evkLoG0nV3Xo8CudT0g&oe=6A972661"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdsThhmrO_EQ7kNvwEmE6Ab&_nc_oc=AdpfjlQ-v9ochoDsMhPK7zOHE1JC3zBz2OWZ09Hzg6fzQTCGpafUtzuzFXigQ831HUw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPw78-3weKVWrSKBLnU41ipalwiHxPShm50fcQpvakRg&oe=6A973ADA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GZr54ButW4Q7kNvwEKOwKh&_nc_oc=Adp2Cw3bXG7AsiLWR-md1FILNEv3h_u3q1NgSkaokiDrlcZOlAy-lnAGxF9Dl1msvAE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbuGMG1Cqu6ISBl7Xjp3Q6cdTfoSAizc-hRkq_daeOKw&oe=6A972D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uKmWx4G9pYQ7kNvwHy_oSK&_nc_oc=Adrph-h-Z9i6gwZBxfIF0UQyTkc05l9UneYCdGQrYXR1NhgenT_hV3Zh3DOuGrHYDDc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYZHoVYX9V0AzXKEnub_9yrP5a0Mg3nzp2tVf9aTl56w&oe=6A971F7F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.
=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRldcn_bnEiz9_1es71P32SPlEtQMRjjFhvMfsoTIWJA&oe=6A60B2CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dR2v4aiie9oQ7kNvwHcp57C&_nc_oc=Ado3xT8xKmibk2eqNrGvSr-XGRpf3L4xOI9ovX-WcxMgfUKi88OnFosYq3tngOGuWoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-VoHW_1H4Y8GFE1qESk25iizvBRnE5cjmyu8SW1Qgcg&oe=6A60A861"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dhaI7HXbeEQ7kNvwGMqXed&_nc_oc=AdpVOuFFJcvn9muoW-ZCf8X85-V1QC3tqahi97pMHchM-C9q5S_PYYZf-82V5jFYv6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr2q2FbczC1GYF3WvjhkcErSlVe9X5oaSuH5yOz2yMBw&oe=6A60BCDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnOkmzkt_xcQ7kNvwGTuw2g&_nc_oc=Adpx3D7I3gpGuE5-XzWdqptKkBhe8n5a6BS2XSr9TgoELf7Sngs7dC0FYx9L1IJJryQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Wn4uwKcOi3UvgAufLnyLGOAuVu-j33GHucWcYn3_cA&oe=6A60AF70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvm3Oh1x4JwQ7kNvwFIXCGv&_nc_oc=AdoE_swsaPJGqhXYhNm5lhwmsNuxG9Dguxx0byFG61q9qtA3iMtIXxkPU6qjvfOgDq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB88sAx5FGFnHZTlHkeVXj-yMTd_BkEDzBTYs9D3lmnTQ&oe=6A60D9BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.
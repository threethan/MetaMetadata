-7&_nc_sid=6e7a0a&_nc_ohc=DAmYWmmskiYQ7kNvwE82ieH&_nc_oc=AdolL5H2Y8tZbVz6Cz6FjCE6IhAU9kZ64YM1FEDeCOIod1uS46hNscfeXZ6HQEpf3Bg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Oemp6J7NKhEd6-MfChvYREwsX2hfjP8eS2-1qjVKJCg&oe=69F0C8D0"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZUKk-KpjY8Q7kNvwEJrIWy&_nc_oc=Ado407fLBlMOwmQS1Sfwys394UPGfeoadBPPv7AMWrXGA4hSwwalE7tcw41b0H37M20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2KSoy1hpikoMGmx8TwGpP1wTzxa27tCwFB8j5I6LLNfw&oe=69F0C864"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1k5T3-EfgkgQ7kNvwF5-weL&_nc_oc=AdpG83R8UeyW0t_nSOrN0C62sPwZzq7KLCKfmPZMiWWKV0oTGc5LBEO004uJzNWEcyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0MLoBWcq7uK5dH5Dmzb6kAgsvQaO-fLkUy6FCWTYf6wA&oe=69F0CC85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evrSvvMjPloQ7kNvwH7WNRM&_nc_oc=AdphJRnl-tubhkYTWeBlqyBTDElOEWM3Cj-W2vmgWwQ_zHcgAkEIkN_er-fjwsE-rkY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1D4Qy9BakzKI4fxr7xihP7cycoJzlWGOCPTkhwT3bj0Q&oe=69F0A1B1"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCLlGA2FaIMQ7kNvwGB3aa6&_nc_oc=Adq2DB6bxAZHH6FjV-GHcu0
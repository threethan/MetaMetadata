=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m1Xe_nblCFksJM3opO0r-KcKhaWzVl3c7gvBt2hD14Q&oe=69DE2E4D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdIznfZw3gsQ7kNvwHMTQKt&_nc_oc=AdpubhOI6fvmNuQOu8X8FH5PqQ2BCH1OgpYOkLHfMt33hNWEkpR9Lee-6UYi9VPgUSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Qb15hmTNh9292leGfKMSH2g-nhR5tUPqf67JZS7PhNg&oe=69DE23E1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoYGFdpH5NwQ7kNvwG7DVU3&_nc_oc=AdpgbHm_Z5Ffwddg_eVoB70frWJYvr7XxXZiol5Fui5C-adaJ6hkZj5_HPAJsr0ur5o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SVUBGaGLpmuCvrDOnvpHaK-oFQePhdCSUM06z_xrOiA&oe=69DE385A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFM_bSbGkrgQ7kNvwGkioZo&_nc_oc=Adr1LP1C8HdwZKxjyV7g-htJWwmwDjgnSndygqBn6vIno3e_V-e3qAv6HK1goix7-Qg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0izraufwLFAbQRVaTYG5BzccUnsVBFpS2d94G10yYwsg&oe=69DE2AF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGeQGgjmGpoQ7kNvwHCGBKx&_nc_oc=AdpuleAaMAEpSOZ5q3SA17ZOs7pLwpNpP5bT4tO3bQa3oirvIa55Mu7Fqfzidf_cwG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U9J_aysPBnOepZaAq92k1NLvrtd-yeQhcHOpQu7gNHg&oe=69DE553F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.
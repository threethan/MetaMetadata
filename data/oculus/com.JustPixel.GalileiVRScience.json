=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RyxSRi6Q2nViOwwsjSp144yFi7K1KzH_K0LPf66Y1oQ&oe=69ECAECD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00RgBfSBl9IQ7kNvwGd5f5S&_nc_oc=AdqatYo73Za3ALdmyS97qoUWr4Pcp6ZBNln7QIN1hXfuqmm6OQYrWS9QMpjZIJYABmU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23Xk1hjBfOc9kH9DYp1j5G8xO8IkBrt0G_XlYfF9jAPA&oe=69ECA461"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjLoK_Xwz30Q7kNvwGlzvjk&_nc_oc=AdrIJRhizkNo_OKk5lf7K_sDKkW6jbErtETXY3vK3aE_8T1tjIByO6Ztp5jSwBkMA9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15kbquiPpyCw-gAL-JlWzpOrCSBCbGVH1aJDORbpi0HA&oe=69ECB8DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RE94hsea928Q7kNvwEmxUmq&_nc_oc=AdpkS2eKZ8Rq5Qg5olF1V0an-yeZJRJNQc_-h1WYav4xGeCzPmHn_pCzhTpBFbpLY-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GqT9MPTy_hGMeIpvQ7vLQqlvV1PfvwvPjXm9w3p-8Dg&oe=69ECAB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-UFOw_2hb0Q7kNvwHyr6aB&_nc_oc=AdoLbohsKZiPKMlu-18VNoYE6gH23n3bwDRXwmFRCWLjndNbBFL9KJsd3u73OW2yIe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03gKFqbl3l50-s4XDcK1ejktM0eVjl8f6xw0_7J2BcjQ&oe=69ECD5BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.
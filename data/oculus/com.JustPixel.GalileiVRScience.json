=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmsRKUWyZwJGKLl3r5T2aNsH9gZ4JVGOtijVrhN46LGQ&oe=6A9AED0D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC-XLijAfc8Q7kNvwEJodjS&_nc_oc=Adrk39KTplYEMqrhOyssumYSa3sihpyCglzon1ESoItmb1UYE7wrhLKz-ukvPNODbUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB0sZbgAKZRo-RsTtAX_E3Z6Q0GrfmB4e7vmr24QhJvg&oe=6A9AE2A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gen3YGOZjfMQ7kNvwGqOSqk&_nc_oc=AdoGZpC87JLaZeFhhe4nQcnnaxncEUtZ9-d1qTVOcZdQcDuQLU1gvFOWZO5F9Dj2EO4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe14AvNfQyuQEmz94R5w_d5r1N_d3Ar8BeU8mzMM8QNw&oe=6A9ABEDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnXIsflcPIMQ7kNvwE-XBDQ&_nc_oc=AdquYsDGEzOKiYS6r5rC9oGNIcR1WJOftrDegP4lwGiAAnWjxf2YQgDZlgL9Gj5Yhts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUDdaNzN167nGPJgCPkIn3tvfLs4Kg7veLGueG-bkHDw&oe=6A9AE9B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcPFwFOYkf4Q7kNvwGzTsKW&_nc_oc=AdpHrbUuQsG_jm2TKAvAC3zpmQNItd1cV_WCSQrvgxRp2EWAe7qNkT0Yo79N1gM4x-M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzqwjfnUnponnkwcLHkdIwl91lbp8hnUXnfv4tos0ktw&oe=6A9ADBBF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
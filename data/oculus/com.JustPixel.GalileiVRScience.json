OIy8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFV9fa5mrkxqlBsnwpF6cWuxvgfeIqwzt9dxnNdD18stg&oe=6A8ED74D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBUg8kEWHbgQ7kNvwEfagHl&_nc_oc=AdqYnFUSthu4By_U9Vp2aYzmNkkrwrjPygSAPl_Y8NcOY6tGehAfz3TOfxHj8qO9vAA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLNBIVzEVlHOktT6PAtQv7QSoitdFnFo7vJtbFQw8qTQ&oe=6A8ECCE1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY56w_Yv4hwQ7kNvwEMxEgK&_nc_oc=Adq3gba3mIgq5O1d5s7u3sKDgoborciEGp25vxOr08o3VbrqEuN7-h4x3pHTESL2OW4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnryghA5_L6hgrENgu4NssudTWdqQWTjd_W4qHWEB50w&oe=6A8EE15A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_i9UP2bCdI4Q7kNvwFdSZjN&_nc_oc=Ado7CbXYb8BttP5DEmdYd_yqvDh0Y1Y3X0PScxczTJRIm_g4XPIJBTm-SJcK93qLS3w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6lZtclcthNvL-D0616cO72IuuSy-lzW2ZI_YsEs0G4w&oe=6A8ED3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOruKkmPY60Q7kNvwGoI8o0&_nc_oc=AdoPVr_a_ghQ5ZnrdB59-cgyf0FL8MR3Q7gA7TpAfTJl37244NIkbdkZAkRNVBhCNRA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEuKdmXE0odfJ_GSbC1b6ulLqXasy9moHYin1WXJbUpw&oe=6A8EC5FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lhr11-1.ocu
=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1QU0Nd6-nU6mBdevnIfEHzbPM-QBB7CJU5e50g4U1Lg&oe=6A24460D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5X8WQlZQkoQ7kNvwEf-Epr&_nc_oc=AdqUVMpvw0We45fTAVQEyYWPimyUSnTV5EPeGxq57G2q-PF0Maq_uhSiXtR2DbF5F4o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_w4Cre70DLTV4EjdyvkoXQFIceCTn9bI9tKnmqlS3EQ&oe=6A243BA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRvo0hqxWKcQ7kNvwF1btwS&_nc_oc=AdqAVGwKuLUXE0hfi6x0ZOG1nx9RpYFW26TFnZW9akp568Ch1pGau_E3t9ufnNU0TFA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YYS24UXdycbqP4BLbM1rgWRTXWF88VqsxRInbRziznA&oe=6A2417DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoCi_rByWsQQ7kNvwEAYo5F&_nc_oc=AdrlzFQ-6SDjWE6uA4QePdl-p-TPQi_bcxzEQB86TlCdoOVG7RUWVy7QwfYVIz1grhw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_MxMxgPgta1lCQilYwb-DdSLh8jQ2l8CRydrgbDhz9A&oe=6A2442B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn1mU7YKLykQ7kNvwE8P9ea&_nc_oc=AdrZqSYd3GZx9aH1o6Gd52DChUmMyGD0XQ9Wou9Q1RWRbTsEHzadelizBjjFmfJzriI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86Ms97neQsDnzI2p4FFndh4YErlcyfwPw349gTLXDs1w&oe=6A2434BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.
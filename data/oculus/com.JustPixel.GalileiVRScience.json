=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7e3fjttZYf06MTsi4SSPTB6dtOf5l-bDQKP_Wn7rRu-Q&oe=6A09AFCD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVI6SNtevOQQ7kNvwHAYlhs&_nc_oc=AdolT4_Ny2ciV1tdhoXNqlP2vvF-108GPtBmsMN2LxJauEENkajpiqhutzgZKGLOTEw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aWYHWScghwGXvneP5qCmCywDujfwNua5hLgIB7P8_xA&oe=6A09DDA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fusW3INQLNsQ7kNvwGJqRPm&_nc_oc=Adrpc8utTcr0TN2lHVBcVEA9ALpIPXk2tNFf4wEiOrEkRtx-BB26EpT36JNt-_e-STY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K51zjRsfHaOlXkC-zL8YZuxfqLmOBMvEPD_h4S2liXA&oe=6A09B9DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziiChuKSsycQ7kNvwFtKwkS&_nc_oc=AdovzyOHW8g2zd_LGl6p4_UcmE1ZpWbDXJPBYXrS90NBTQDBa5O_VntL7G5DR-M214Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ha3BHAknaJ3nz-Tz4hYLNQ-OfG9JDSbWKPYehgbwe0Q&oe=6A09AC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ddkMEuz044Q7kNvwF49j3l&_nc_oc=AdoV5ugkjUMDiBuc18BxN4q7EzClbSdv8CNIlOZcUVc1-_9xbS6c6ck4un2qRphSoPo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zJKITHeRlOCkyN6VyXCpsl8-bIqBAUAw3p6eSlunotw&oe=6A09D6BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.
cdn.com&_nc_ss=8&oh=00_Afy10zs6v0o4AXr4X_D2h97c8rISzEd1tftQMYNqHohHrQ&oe=69AAC3CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ryosSh9saEQ7kNvwGZDLbs&_nc_oc=Adl3x9ZAqNgMNaJVA1J5JdOdHttAz64Mt5LxGYUesh75ikYzSoRg4wjVpynGANDJooc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6wQGvmvjti6hEQDW6pV3h30Z2lzDOCA0Ad--bw7PXaQ&oe=69AAB961"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqZX-aMTlMsQ7kNvwGTY-7f&_nc_oc=Adn6oRd2NNPnYI1L0sTH6FFU30v2BIXXJilV6CrSLOArK_CQnTRNfTDZ0lnAsmfiLZE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdaD-dXfPNpXcm-1-4htPNezMSLWaQmHgKHdWj9nKkaw&oe=69AACDDA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jffmdp4pzKgQ7kNvwHpYUqD&_nc_oc=AdkmDBFkXL0U3Z4yIhSQS7PiB2xAWwVzs8r_Aof5HH78Lmnq6FSxIR5ZT5fnZV_dY2E&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzOAowrbYuMKydlQTuD1DQPHrcoMdMioOUjUj4IKbfLg&oe=69AAC070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TecwtgQ2QPYQ7kNvwH2-Iwk&_nc_oc=Admdi-KwWFYieCslKuqe170t2mLzSe2UdvoQSDcKvZGktmJj4qcSmZguaA3CXnaMERI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfziewgFGf9zEAtyTm4Cqsj3nZIRE7IgejQNauX5L6h2oA&oe=69AAB27F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_103379974028
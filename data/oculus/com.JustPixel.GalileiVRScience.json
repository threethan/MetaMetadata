=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErKrdgJAXrXy6uZzBY3ilWHTHD_hH-3cz5iFbDgXcLKQ&oe=6A7B10CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bjX2k_EexIQ7kNvwEh2BCp&_nc_oc=AdoEHmfUOrMMauGnCTWLG9o3PyE0s6-AAK385o4XMU67mHvRbbc85dlxTpcQtNxjnUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWpzQOa-HJo2bZ55CovWyJ8DdKID5pwTMkNJFU96Wtlg&oe=6A7B0661"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfPjacL-SQIQ7kNvwGR80pN&_nc_oc=AdrjN0W-nU6WQ_D7_1D2HrBJfEz6Zjq6SUxDwyi4pxzordmbqHf_SMZU8PmVGVl9FAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsys_eac_XuYaKn5ZDeyXr71jnVCtsdxHl7WZEDlNhfw&oe=6A7B1ADA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFUfky1Imt0Q7kNvwHAKK8f&_nc_oc=AdoBIxE-4Q69ixxRMknWHm5GpOKls-gMtQufFddzPUunv_Lz8XRAIbJO8n-FMJ0azLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBIjo6u5GuxVCukbGWw6gBG7ZSd21UBJXuB2GCIjyCWg&oe=6A7B0D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrMZ487UoWMQ7kNvwFlHi46&_nc_oc=Adq5M6qlnMoImq-_5ZicfmJFn9gfzbSjOM7XqSWS7QM2wQVCWSVjlAqM3fSkUQKhp8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6ri4krgYraAy5WJjgII6plNG8XMUgNLw805YwruSUAA&oe=6A7B37BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.
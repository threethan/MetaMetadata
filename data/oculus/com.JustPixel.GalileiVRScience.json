=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96IkWUurMGO_sHLvaJtvnMtWDgSV5wLKRI1Fcq8iKQnA&oe=6A45034D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG7yvPsNFK8Q7kNvwH7D-8A&_nc_oc=AdqAeo15xLxjLFrSXckS2zgXAiUTSZ4EMuuA5kkaDrp6uRiIkoPFrQUrS785y7qT_Rs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Mm4tvmdA0FxsCr8AHcQFfRIIm4fKNtCq8bXofe2WVg&oe=6A453121"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKbWZH8pRJYQ7kNvwHKU-ei&_nc_oc=AdozvOpOmKZV0C1nkUOW94JHVmGfxCZDXdiyoaaGMwSdGKW5_Td6mX-Mb3AdtcOhatE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kJ3YFmPfQczIeAf5wckCVBNaXSXIAZD_cIpGTF6XDAw&oe=6A450D5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiTl8iAeMe0Q7kNvwGZeZdO&_nc_oc=AdoCfOncehQGrVpbKPrbEd-f1Ja2a8CKnOOGwjqteYUTtnpR_6mwp7xvP_7g_0GAcXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZLI8yyrlxc5qKbbjhXCeQ9AelQ8_PPS_gnlWRr79eAA&oe=6A453830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPcMxk1tLMwQ7kNvwEuIErY&_nc_oc=AdpKlYbDhkwvTAc6cIz-n-153RTy1kaZpRGPOkn68aFDRO3wPsUvLtjcginbUgfNIBo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8oG34DpILAIJ8cDC3aVtOSOooLZvdGcKqevWu1PJ5vg&oe=6A452A3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
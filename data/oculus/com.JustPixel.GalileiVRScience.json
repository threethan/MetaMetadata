=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73xIxbBkRUErcU3q3hQ0Tsi39bHJl74zg-TIdjNxlbLA&oe=6A1AD34D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXhtIW5vk1gQ7kNvwFLK_nK&_nc_oc=Adrw_GbvHmq7eEi-1f47-jY1NSaXlKokKY_OamxmqdmET48xnk9t39YQ1zUiL9w-F-0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uEQB0o3ANQXft3-1-a-B0hk09rMwR_xg4JgoG2tv5gQ&oe=6A1B0121"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5m0l8tUsKYQ7kNvwF8pjVQ&_nc_oc=AdpfPwWSwfY0DNpWkFklPC1lj7-W3ffXa5ahzilYbg21UEbFZqqwEBpmsHXAZqillZ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56cGpG0OcThSvXtCugSX4BZiDXT3GGpk_Nt2LuUZ1OAQ&oe=6A1ADD5A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZZbjp5GxAwQ7kNvwGkPPOX&_nc_oc=AdpXEVwfDG4uvJ_1gsPYKaZclfblCzinjERik1Ey4ayPxs_dR97YJgKaxj4aSruYQ8I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tDlyoofuzu2hxfRDdiuC0PvAOsm5NLFaJaAQ5PZq27w&oe=6A1B0830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUDV_gd7sQoQ7kNvwHGmk9W&_nc_oc=AdrXDWobfexb-ur3_S6mHEUStlN1VIktWQmTsDbWQx0AP1y2wbZWkuiSDqiWA2YRrVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H-om3-PJPyCropVoSv7_4T7kzkg_2gHKcU9wxLDqVJg&oe=6A1AFA3F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.
fw5-2.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqjqYf06aGgQ7kNvwE_7829&_nc_oc=AdrY1pi3fsWsE9hKDySFQqsvixrXXH33JXGBI95z7xn-4-mZnvjwg9DDH5PAQDVwADk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2uKVUNQXWptY3JX_JIP-qO0e5DNUX3htoR78bFR-s9w&oe=6B08598D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZT47Pap5MQ7kNvwFXNt31&_nc_oc=AdoaVZS-vAdYGy_MHTmZniPTfUMT5MC8Kj-hmzlliRQ7ogR_QowuZVJqE1vaiPiQEK0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShLyWmd6tn0Tr-a3vPJ0_sA0YSoPIbv6cZN9bOP0QNZw&oe=6B084F21"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhAjVYKD4twQ7kNvwFKvKSt&_nc_oc=AdrGLNciitCKwoHyC994WSjZih5y-y9TQ1uMlNq3ivvsB2xZhEP_Xy-wBUDQ4yQiOXc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqN_QEhzc_z3IZa9g8Di2o6b9yNaSLp4kIZT_2jGKStQ&oe=6B08639A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw8TkbTK_rwQ7kNvwEXcrcc&_nc_oc=AdqwlqCda4lGTe9FK-f_B0YHTlf1RlXpdgHk4daV0d7dwI91YPvktrhYRSyxTn5GULQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcI3uDiAlHJk7nToGrELR2px6YJCUOgN1M3kPRsyL5FQ&oe=6B085630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3M_PE74ei0Q7kNvwHl_wHR&_nc_oc=AdpadorH534duEcZssbfjBRaOgRz9B91inuAlhnfkHiSKzWRz3H92Rtzu67n5jefrJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPdYbF0vUT3PQ_5hT6bC1R40iWZNkuQKsaVyttLbgsXQ&oe=6B08483F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz4LwOfkQV8Q7kNvwGUz0uu&_nc_oc=AdolJTaffz-L2hwPbgtmrDVhJw1ib3kV_Mf2Kn4x5Ako5zGhl6gHBnFlKZs2A7m0lSQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwIoUstFHD-foiqntZ4losPverxUt_J8CtFgz_4QrgxQ&oe=6B0841CE"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiCKFRKZ2m4Q7kNvwHTzqir&_nc_oc=AdpEDpdUDp6ocYRE0VZJCpyvxhk2J4SvRCd0lJV8zNDXAEjjO9VtU_5EqMmf_qdchDw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8GGkXoiRTC61__5g9X7oYSWohq4_kn_1_6ltcysLYXQ&oe=6B08714D"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYAHXolkpcMQ7kNvwF8DtGl&_nc_oc=AdqGC_pnV_sPujM4mH6fLBTr6ca3iL4r8GyS6moMHfldmPp6MTs8Ar887_l0UqJL2aw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqAlRixvr0wqpZhjXCAyITugxvjPnRxTktQ8mK_jCdjw&oe=6B083F0F"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LyBcqq
=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoIqCFOty_j-rbBtEF3CFVf2mNU552kTfhOkGOA2Z5Sg&oe=69C27ECD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lvUMjklnZoQ7kNvwHSImKq&_nc_oc=AdpmJU7c9VZonI1PMdQTNSsfQqUjMEVtMOZVESC2lU3SrO2l4vjxqmpMAu4w9E1vcQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCzeXON0Qx5yZefSUGXcTKov66cpxQ4CK33XoiYECW7Q&oe=69C27461"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M1KFtfUI6gQ7kNvwH0yNSF&_nc_oc=Ado5LIPONHoPfJ-o9eNseMQxMKTD3DOb-KkQzDqFotHKVUfhWyUN2R6sQPanXA2ngYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLFH4IBaXqIzhi01Qu69wpIhBMRGuR31NPMcRoxX0ghA&oe=69C288DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pH1RBv2gclwQ7kNvwFL1wV-&_nc_oc=AdoAuEApK4crEVAq3zmtqELVSrX4isKY92gxIpfEFw7OViQkVP7yIjIhHrdhkKj_3_I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIttEVbU_38aLrbitG78QimRQGR1HGwht0roCuC8pDRQ&oe=69C27B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc9r4Xpp938Q7kNvwFqP6G-&_nc_oc=AdqBEVY1iLK2d3AqTInY_k7j4pjjryCXFbUnfwLw0zfOmRetLzg5IrdJm8qq_ObJO1U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNHDxwwL2JBnQedxB6NenFUk_HVzC0KLYfn5hB6KbU2w&oe=69C26D7F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.
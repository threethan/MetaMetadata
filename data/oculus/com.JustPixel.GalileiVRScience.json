=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af870UWY7RRiEt5RCi4rqToba0nCvDnR96ugrRCI6mIsKA&oe=6A30238D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uBcigJDcEYQ7kNvwFho--H&_nc_oc=AdrLosXmPuGmFwuw4tVOdpEJSHHB_65eLJMvtA9uZYE1NhK3hbmJJ3AvIXTrXVdPTRQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wIyntl_sHqKbLyl54LvvF6NJBc2sPLC0ZNNBdP0gu7w&oe=6A301921"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRhypB9RTfgQ7kNvwGWa5Dv&_nc_oc=AdqCqNz5xzx58922Wq5383X1D1IEcrNYjsK8NxS12PCbSI67t6c1Dp_JQvgtb8oKqGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8c13pzO3H0O-z5Iz3JvJhwzawBvkQusB8eIDYZUJJpCQ&oe=6A2FF55A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5omj46NuZuwQ7kNvwEEj98t&_nc_oc=AdqAfYFGH4fT15IC96_FESl6DVRqYd931i_-vqECYQPUPo2bxQSnk_VdLDr0mdSDm6o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mcEvja7k9oBvcIcJMUqWKemNvIIOHCFI9DbmNzo0E-A&oe=6A302030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQdTMqFvsIgQ7kNvwHCflHu&_nc_oc=Adqjjcg6Yq0uLdg-O2Oa8elOZ6hpFSYbITdMvSK-kDntxfGTnmFKfziUDRWlqWtR2ng&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R3mSxtsMNju0TnELd5KN1Xd7w4H5o9YsNNfJu0TQXww&oe=6A30123F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
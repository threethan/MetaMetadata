ea5-1.oculuscdn.com/v/t64.5771-25/39031317_1429133904452550_6409544868446892523_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x70dM6Ye63QQ7kNvwFpFXnU&_nc_oc=AdqacjyWrQj6qndXTw2k4phDDDHGIaH1dvTnLLOYlGQwQtXzXXsI1pJ3flI19f0bROQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRtQn1lDWBUDG0ZLkt8SXqaNtUtqwtpFg7iVnHGrW48w&oe=6B09AB0D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZT47Pap5MQ7kNvwEfw598&_nc_oc=AdrtMyYoJIA4E7nn4YTprqo9570leFoHXc3E9vsZhWSY6uGpc5vKsMlgjkmNJNP_QCE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTc9dZDlt8Kw6vU7FmRRDTXoPqe0Gp8KARa-Cnkwv7pw&oe=6B09A0A1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhAjVYKD4twQ7kNvwH5IrRl&_nc_oc=Adp4Sb_FOPl9Wvi-QjsJk2o4uPIwyiiJvYlv4M10tX74QkrkmSgNrwojAlMlRHvgiQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4hWe_CDrgGTPibbpVavLB6C3eiGIlbOtPws4py3igQQ&oe=6B09B51A"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw8TkbTK_rwQ7kNvwFiF5wp&_nc_oc=AdpfHC-lYB_nYxvoTTjaPRUq3Bc6VcR-Dc9ApjOAriOK1udpyJCE5z-AxphhMQR-1n0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWvyGPsacN26tmh6MjT68JMqQojpIOn9eIAuo_lJ-xhg&oe=6B09A7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XEKQ908XvYQ7kNvwGA8LTe&_nc_oc=AdrxTOwiPkz-TDjde7u8d4wlOONArbHOD6thHTwAtHmqWykrVvtKZGBQg7hR0F7ygrA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB_P4Hym1O6FArchkdbanPwUQcuyG-nTwHk7xWkqvqSQ&oe=6B09D1FF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974477_2930927030406639_1033799740283778117_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gz4LwOfkQV8Q7kNvwFHb_DI&_nc_oc=Adq5W5IzoJX61e_0s8FfefATuOjyVNK3zRVRqWCvjD5jTS1k9allZDwuwbKoktsyNbw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0C077U4YGdsv5eyNnwc9epbZVF5InmwogO0zqzWhd2A&oe=6B09CB8E"}, {"file_name": "Hero Cover.png", "id": "1897915367381648", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75207242_1897915370714981_6546028005331927603_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvKR8VoY4uIQ7kNvwGAHG7_&_nc_oc=AdppywGA-JMHYU7Zi_Gm1WttP8ReEnCHp5EFXKI5K9t6cySNcskX8nBgw5lkPoNSzVk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrRxz7DLQYuB2rhrC3dPweP3ZsM8Ka5-w2GTaPQ6RyPg&oe=6B09C2CD"}, {"file_name": "Logo.png", "id": "1156101178831306", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982713_1156101182164639_3284781712281521597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYAHXolkpcMQ7kNvwHfrLuw&_nc_oc=AdrD-7B1QaoJO28sZXQjJj4H2j8i85UQcMJ7m_bgJZjypJniRRZTf9ciIbxXRxQFo5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-jzfb--7KWQpM9gM036ZMuAVelG2qwc7-Qhf5S4vdyQ&oe=6B09C8CF"}, {"file_name": "Landscape.png", "id": "1035480321561334", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982526_1035480328228000_568917300582159945_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LyBcqq
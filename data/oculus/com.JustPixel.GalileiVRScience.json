-7&_nc_sid=6e7a0a&_nc_ohc=VNq_huIowXwQ7kNvwEVE6dM&_nc_oc=AdlLlILUX2fIkWp2kBbnTXvs9FusklwMjkmu1gi4N0KRCVOWB3cGd6MaFtiAg_UGsYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsERKXYoC6g2TPfknckxOxyKESxUtB-hO80sQKo0hhdtw&oe=699C3090"}, {"file_name": "Artboard 3.png", "id": "3889565187981667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031547_3889565191315000_5528783709779854295_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bryUicRWfQQ7kNvwHZjBSj&_nc_oc=AdndiK7riw8uJKk7BDyxAJ2in80tLmeSLMR2a9jT_Srw67aqVmHRwi8P7o4mLfeT4zU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuiZUmq59VrXDTeA1vCanzon2beUz82ZUclOq98tyxl2A&oe=699C6864"}, {"file_name": "Artboard 1.png", "id": "867384681933118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003244_867384685266451_2340853765823917163_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0z5iwYK0uG0Q7kNvwFXl5ry&_nc_oc=AdnpJuVWIZbgGBLz3oPi31KyqkEko9YXjf6KQnzhCLkcDbyOrT-TtvXv5BSv6Oc1NDk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afur3doXPEhTubnTtW-w2uaHIdKfNx2onBaD8e0KAwg8TQ&oe=699C3445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "999991165259980", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75476756_999991168593313_5483195490028886346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_xOp2UEy0QQ7kNvwHeW2sn&_nc_oc=AdmAQ253ZzQ8s3REdb3vDLLgo-uLEQxLEsEhR7LKlfoqGv911qJWaDZAk9elDtQ3S0A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuqSTx1KRcjWKw-Hb1SfCaxhPIdBc2DDGvp-TNKUkNIBw&oe=699C41B1"}, "display_name": "Safari Cellulare", "keywords": [], "long_description": "**Safari Cellulare** \u00e8 un'applicazione di realt\u00e0 virtuale innovativa che trasforma l'apprendimento della **biologia cellulare** in un'avventura emozionante. Progettata per **studenti, educatori e appassionati di scienza**, questa app ti permette di esplorare una **cellula animale in 3D** come mai prima d'ora. Attraverso un'interfaccia immersiva, puoi navigare tra le diverse strutture cellulari, come **il nucleo, i mitocondri e il reticolo endoplasmatico**, scoprendone le funzioni e l'importanza.\n\nOgni componente della cellula \u00e8 rappresentato con dettagli straordinari, permettendoti di osservare e comprendere i processi biologici complessi in modo visivamente accattivante. **L'intelligenza artificiale integrata** \u00e8 a tua disposizione per rispondere a qualsiasi domanda tu possa avere durante l'esplorazione, fornendo spiegazioni chiare e dettagliate.\n\nSafari Cellulare non \u00e8 solo un'esperienza educativa passiva; include una serie di **mini giochi interattivi** progettati per consolidare le tue conoscenze in modo divertente e coinvolgente. Attraverso **sfide e quiz**, puoi mettere alla prova la tua comprensione dei concetti biologici, rendendo l'apprendimento un processo attivo e stimolante.\n\nPerfetta per l'uso in ambito educativo o come strumento di autoapprendimento, Safari Cellulare offre un modo nuovo e innovativo per esplorare il mondo microscopico della cellula animale. Con **grafica di alta qualit\u00e0** e un'**esperienza utente intuitiva**, questa app trasforma lo studio della biologia in un'avventura indimenticabile.", "short_description": "Scopri l'affascinante mondo della cellula animale con Safari Cellulare, l'app VR educativa che ti permette di esplorare le strutture cellulari in 3D. Attraverso mini giochi interattivi e un'intelligenza artificiale avanzata, apprendi concetti scientifici divertendoti. Ideale per studenti e appassionati di biologia, questa esperienza immersiva rende l'apprendimento un'avventura entusiasmante."}, {"images": {"nodes": [{"file_name": "Logo.png", "id": "7830788620364802", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974477_7830788637031467_2492816240902607915_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw_F4PBIb_oQ7kNvwFn3zuQ&_nc_oc=AdnPRvQ95EOPXNLBBrvVZPD
=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gg1ISiCzXx9puMz-lh5VeXbfIY-vb7XVwSiN-5eMDAQ&oe=6A34180D"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlxUwX_aKvIQ7kNvwH__by6&_nc_oc=Ado7tqXoJ7UzRz6saavF3AuNrWiNC44Ojiyt8qDkwanJUytDNN9qsk6ExAazQyy9ztI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S6CTZZsYFqEXMm_kwiaK-A2EGZNyYELi66gAcWnhmhQ&oe=6A340DA1"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL19SEUo55sQ7kNvwE8oibT&_nc_oc=Ado_HgbCEjVTCGmKCm1z45gI8KH59-AJfIYU1LNgedrz7fyKa4iPjhboxJspIqX71Xc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ROdKtDpdxwaW6jOcm-jXl6rlP_qZwPrpwOOPH42hIGQ&oe=6A33E9DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqLF83qCHIkQ7kNvwE0oY7w&_nc_oc=Adq7I1N90HPIYS-UhNHUOyUqEO9hVL_syx0dt7kuaBGg_UJ38y1Ef_VG85vR1CzYZnM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0nEYM5p5jTOfs3wo1Vzyk40jRUSf_e2Hwp9jjbswtQQ&oe=6A3414B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nma0xIGZqwQ7kNvwE2pipL&_nc_oc=AdpJky94Z0Ar6VTtf3QFDnglSAbzf2H39oobBg77nkKLLSOD8U4RL1dbp5taQbUrvLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ahf-KXSFrsR9hL3Eed48dh5dr-pV9uVSqKsvbQPV2VA&oe=6A3406BF"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.
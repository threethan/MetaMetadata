=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj_zsz0IL4eUa8Efp2YxtIM-eeC6opsMEENbe_csD9qw&oe=6A8056CD"}, {"file_name": "Artboard 1.png", "id": "1021011425999827", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031547_1021011429333160_4176289926510597494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeX5tfWD-4YQ7kNvwH2XBoz&_nc_oc=AdrrHy71n7BZwgNw3F_4XWbFUMiNv2GuraJBUk0Qk0L1Mz1bTQa9FP6mveMJpti5kik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEmGmD5biNtb9-LbVM44uj_IP-W2Whl7y2zsBj5Cp_FQ&oe=6A804C61"}, {"file_name": "Artboard 4.png", "id": "524012790104112", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001669_524012793437445_4891316513078544414_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQBZdCBZlZEQ7kNvwG313JG&_nc_oc=Adp-hc1j_QldyFS9Szc6UoVAH62wPmFYQ97qAFdS8fl-FJnSxpgxRdesjjAVg0N4hBo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBnOk4U_OdO8_dJyd-iEB9MUKjtotMwG_C7vX5ADXDkQ&oe=6A8060DA"}, {"file_name": "Artboard 3.png", "id": "1187574142495669", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031470_1187574145829002_8495108821353233334_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PaJIepovzsQ7kNvwGDI16I&_nc_oc=AdoMjoHzq6f0rQlwAndE6-CacJy6YBeWXGwVYpK2oxPEBIMOBnhCypSv5gxwbejpLR0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNfVXZe21GofTeHdUDg7Ts_RODGht33OO7xWqjclCbuA&oe=6A805370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974450_2251639131854765_8396477208328520911_n.png", "id": "529809686395654", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75476759_529809689728987_2021663405477506286_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cOR3LWgqosQ7kNvwGsXyP6&_nc_oc=Adq5a3-Eisbkfy01sLqj6T_CKlYiIx9V93z43Vc_NvIfQFLbbr_SXloMAhRoskj3Fdo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldlxahbaqH74CF42mWQgr4TIOqaMlYZez7EyyqQCzWg&oe=6A80457F"}, "display_name": "Cellular Safari", "keywords": [], "long_description": "**Safari Cellular** is an innovative virtual reality app that turns learning about **cellular biology** into an exciting adventure. Designed for **students, educators and science enthusiasts**, this app allows you to explore an **animal cell in 3D** like never before. Through an immersive interface, you can navigate through different cell structures, such as **the nucleus, mitochondria, and endoplasmic reticulum**, discovering their functions and importance.\n\nEach component of the cell is represented in stunning detail, allowing you to observe and understand complex biological processes in a visually engaging way. **Integrated artificial intelligence** is at your disposal to answer any questions you may have while exploring, providing clear and detailed explanations.\n\nCellular Safari is not just a passive educational experience; it includes a series of **mini interactive games** designed to consolidate your knowledge in a fun and engaging way. Through **challenges and quizzes**, you can test your understanding of biological concepts, making learning an active and stimulating process.\n\nPerfect for use in education or as a self-study tool, Cellular Safari offers a new and innovative way to explore the microscopic world of the animal cell. With **high-quality graphics** and an **intuitive user experience**, this app turns the study of biology into an unforgettable adventure.", "short_description": "Discover the fascinating world of the animal cell with Cell Safari, the educational VR app that allows you to explore cell structures in 3D. Through interactive mini-games and advanced artificial intelligence, learn scientific concepts while having fun. Ideal for students and biology enthusiasts, this immersive experience makes learning an exciting adventure."}, {"images": {"nodes": [{"file_name": "Landscape Mini.png", "id": "2930927027073306", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.
oh=00_AQFgB3dPi6uyxvJGAPz3T14uobabqhzbbta5Las_YATl4A&oe=6A8D6F15"}, {"file_name": "meta-store-nordvpn-screenshorts-2560x1440-3 (2).png", "id": "1411227407130640", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491823901_1411227410463973_2337867308908064113_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6NvTOsJszUQ7kNvwGtLyg7&_nc_oc=AdqpSX-IQiH79L3Jb0Yp6JtbML7SrgFO9xX9fymDhh5wZ5T4SZKJR0OngSo5HrPfqvE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQ-I3BLcfeq514qt92cP1-C4bRNNQoLGwwZkDE6DD3Q&oe=6A8D7FBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NordVPN: Fast and private VPN", "keywords": ["vpn", "security", "protection", "privacy", "encryption"], "long_description": "Browse with more privacy and security. All it takes is a single click. NordVPN changes your IP address, encrypts your traffic, and enables you to enjoy the true freedom of the internet. \n\nWhy NordVPN? \n\n**Super speeds**\n\nNordVPN consistently ranks as one of the fastest VPNs on the market, often reaching the very top. Plus, NordVPN\u2019s global server network and groundbreaking protocols ensure the best speeds without compromising on security.    \n\n**Protect 10 devices with one account**\n\nWith a single NordVPN account, you can have simultaneous connections on 10 devices. We have apps for every platform, so you can enjoy security wherever you are. \n\n**Easy setup** \n\nNordVPN is incredibly easy to use. Simply download the app, get a NordVPN subscription if you don\u2019t have one yet, and login \u2014 that\u2019s it. Let the app find the best server for you and connect automatically, helping you stay protected at all times. \n\n**Meshnet**\n\nNordVPN\u2019s free Meshnet feature can be used to connect dozens of devices into one secure network. Share files, collaborate on projects, or play together \u2014 all completely free. \n\n**Dark Web Monitor**\n\nScan the deep and the dark web for signs of your leaked credentials, get notified in real time, and protect your accounts before criminals can cause damage. \n\n**24/7 support**\n\nIf your internet connection is acting up or even if you have a simple question about NordVPN, don\u2019t hesitate to contact our customer support team, available around the clock. ", "short_description": "NordVPN is a virtual private network (VPN) helping users browse more privately and securely. It encrypts your traffic, protecting your browsing from third parties, such as your ISP. But NordVPN does so much more. Revolutionary VPN protocols and thousands of servers make NordVPN one of the fastest VPNs in the world. Simply download it from the Meta Quest App and log into your Nord Account. "}]}, "developer_name": "Nord Security", "developer_privacy_policy_url": "https://my.nordaccount.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://my.nordaccount.com/legal/terms-of-service/", "publisher_name": "Nord Security", "support_website_url": "https://support.nordvpn.com/", "website_url": "https://nordvpn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27443804271882163"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821704_2552308115165628_7636248249991111039_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_n
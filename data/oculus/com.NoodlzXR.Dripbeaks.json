 you can\u2014a fun game that\u2019s perfect for a quick break or to challenge yourself. Plus, you can play anywhere, no internet needed.", "short_description": "Step into an exciting 5-minute archery challenge in extended reality! Shoot flying birds to score points, but avoid hitting the red bird three times\u2014or it\u2019s game over. Play anywhere, no internet needed!"}]}, "developer_name": "NoodlzXR", "developer_privacy_policy_url": "https://www.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OneImmersive", "support_website_url": null, "website_url": "https://www.noodlzxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24921697174093528"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618293_820739350419261_6902770404011274790_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGeNjPKJydwQ7kNvwEIWVIk&_nc_oc=AdroNcXTdCmt126KMaQdBEq6m-Yrb0ytA5tg9pExtavbibE6yV1dcLEqcafQW4yyPyY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmonlyK2Efq-8wN4_MBdjRpca76BGaYWe03nloriJboA&oe=6AA93E75"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DripBeaks", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", 
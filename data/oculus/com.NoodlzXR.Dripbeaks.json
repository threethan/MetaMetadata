FjYuWFd0AlLxleN3BKrjT9JC9BA&oe=6A75FB41"}, "display_name": "DripBeaks", "keywords": ["bow", "shooting", "archery"], "long_description": "Get ready for an exciting archery challenge with a unique extended reality experience. The bow appears in your hands, and you\u2019ll aim at flying birds around you. Each bird you hit adds to your score, but if you shoot the red bird three times, it\u2019s game over! You\u2019ve got just 5 minutes on the clock to rack up as many points as you can\u2014a fun game that\u2019s perfect for a quick break or to challenge yourself. Plus, you can play anywhere, no internet needed.", "short_description": "Step into an exciting 5-minute archery challenge in extended reality! Shoot flying birds to score points, but avoid hitting the red bird three times\u2014or it\u2019s game over. Play anywhere, no internet needed!"}]}, "developer_name": "NoodlzXR", "developer_privacy_policy_url": "https://www.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Oneimmersive", "support_website_url": null, "website_url": "https://www.noodlzxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24869840255945887"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1124052922491414"}]}, "baseline_offer": {"id": "1124052922491414"}, "is_ap
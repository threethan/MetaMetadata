g8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0RorftoneGOrIrDa8CXhiMc87qZhnK1GdEtcFwlCPnYg&oe=69F0B5FE"}, {"file_name": "ScreenShots (4).png", "id": "732222839985328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305164_732222846651994_7110998928104720903_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcAiXIc8QmMQ7kNvwEekEe9&_nc_oc=Adpnq1Vu7Eyc9s1i_UkxLwqRVGkoFdPNBfK8HHVMH-XTOuXXnGKNKsdETIU7d2wBwPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Z-W8wbBwBbRJLB0VOYc1zTf2IVxSLcKjQ0rsDJSKJgQ&oe=69F0A35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2278930219234300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619187_2278930222567633_4029022778652423738_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne3sQjWNXXwQ7kNvwHh_-Qq&_nc_oc=AdoZPvXQzxPnOVxO1-4rlohK9VuN-cnJPsgqZ5l4vzadep5nf1E0cw-pdCeNd5THkK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1WNw-lQGbcRlf7QLO7p7FWpSSJO_S2O1RnsrLGsJktjQ&oe=69F09B81"}, "display_name": "DripBeaks", "keywords": ["bow", "shooting", "archery"], "long_description": "Get ready for an exciting archery challenge with a unique extended reality experience. The bow appears in your hands, and you\u2019ll aim at flying birds around you. Each bird you hit adds to your score, but if you shoot the red bird three times, it\u2019s game over! You\u2019ve got just 5 minutes on the clock to rack up as many points as you can\u2014a fun game that\u2019s perfect for a quick break or to challenge yourself. Plus, you can play anywhere, no internet needed.", "short_description": "Step into an exciting 5-minute archery challenge in extended reality! Shoot flying birds to score points, but avoid hitting the red bird three times\u2014or it\u2019s game over. Play anywhere, no internet needed!"}]}, "developer_name": "NoodlzXR", "developer_privacy_policy_url": "https://www.noodlzxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_
9162673475714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298427_1119162676809047_8441272203743629910_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjsPa82WsvUQ7kNvwFsDp68&_nc_oc=AdltI8YRuClTjPTWZqjo4vHwmT5MlmGn1W3ieYkSJTuDWlJwW_RC-6L5wy5f6TDUKyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAiBGeIMfXnO7U1KOFL9Z6m4RFNKS8s5KZ5eZofwPK0Q&oe=69B29BCE"}, {"file_name": "de1e80e5b1a643dea1943bfa22494fdb.png", "id": "1465526024767082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499624689_1465526028100415_3239656261792582866_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjwItTIPR7UQ7kNvwFT4Gmd&_nc_oc=Adlc-uzW2TEMmfy_goaVjiTOUADPhqX20J4ZpDYCXu_xXrc_gY7FZcDY_WLiRkbsJLg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0FWKgHz0ErtcYs3pRc6I_0RptJbGZirXJPYgLlbBtbQ&oe=69B29EBB"}, {"file_name": "5b1567f087754cee848fcd8578f917c5.png", "id": "3968752856769362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499623441_3968752860102695_8924400166242914644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik_d2FDj0OgQ7kNvwGerAe5&_nc_oc=Adlp-z4rztxRSZuvZgprDJslVniAaZIwIpejE3vOm5G0-nbW5A3xP09ICV2xmzxFmHg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxGc2baVEE6EuEkPTCq6BR5vWlY5RkyIVN7zMndfmCPqA&oe=69B29B3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ToolboxVR", "keywords": [], "long_description": "ToolboxVR lets you step inside immersive 3D spaces tailored for impactful learning, team-building and creative collaboration. Use VR headsets or join from desktop and mobile to experience walkable worlds filled with interactive media, whiteboards, avatars and more.\n\nIdeal for companies, educators, and innovators, ToolboxVR is the ultimate solution for hosting virtual training, onboarding, product walkthroughs and hybrid events \u2013 all GDPR-compliant and hosted on European servers.\n\nWhether in the office, the classroom, or halfway across the globe \u2013 
-25/499298427_1119162676809047_8441272203743629910_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td6xRrigS8QQ7kNvwFZxgUC&_nc_oc=Adm3MESqDhkPSfpIUcdP7oVJ6d0hfNTHa714JNlY_dwSIN_4_HSmbj8lITlBfqiK8sQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuh6FvoQ8dIUJiYrlMH0_BZ3dOq8tkyWA4JFF0Qbbg_GQ&oe=69A2C9CE"}, {"file_name": "de1e80e5b1a643dea1943bfa22494fdb.png", "id": "1465526024767082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624689_1465526028100415_3239656261792582866_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qa5mauzCaq4Q7kNvwENEiF7&_nc_oc=Adkpt_XKCUN46ZoSTIRHXeueL8xNW2dyKqdGyc-lJhxu5u_yFFKsOsvHRkKtdnYjZoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftYGAY_Z1Y2do2NfgLTZkWMJN_0gbvwZ_MyAJi_CqRWzA&oe=69A2CCBB"}, {"file_name": "5b1567f087754cee848fcd8578f917c5.png", "id": "3968752856769362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623441_3968752860102695_8924400166242914644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVd7eEa-7WIQ7kNvwE37Qwy&_nc_oc=AdkSIN_Jos4JE82gnZdm6DguUgowObNT9ijSWFlor9G6ON0pWiA56_Nb4Ns6m3Qaz0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJJZCwnEK-c0lvh_Q41nEhNZUd7MdVWFGj45K55w4tvQ&oe=69A2C93F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ToolboxVR", "keywords": [], "long_description": "ToolboxVR lets you step inside immersive 3D spaces tailored for impactful learning, team-building and creative collaboration. Use VR headsets or join from desktop and mobile to experience walkable worlds filled with interactive media, whiteboards, avatars and more.\n\nIdeal for companies, educators, and innovators, ToolboxVR is the ultimate solution for hosting virtual training, onboarding, product walkthroughs and hybrid events \u2013 all GDPR-compliant and hosted on European servers.\n\nWhether in the office, the classroom, or halfway across the globe \u2013 ToolboxVR makes remote feel real.\n\nFeatures:\n\u2714 Real-time collaboration in walkable 3D environments\n\u2714 Use VR headset, desktop, tablet or mobile\n\u2714 Host or join public/private sessions via invitation\n\u2714 Instantly update media content via backend\n\u2714 Built-in teaching, creative and onboarding tools\n\u2714 Scalable for teams, classrooms, or global enterprises", "short_description": "Enter immersive 3D environments for training, collaboration & creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://entersurrogate.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Toolbox GmbH", "support_website_url": null, "website_url": "https://www.digitaltoolbox.gmbh/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24305723102449755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1748259342480089_8975475324283107472_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PXTP5r7G8UQ7kNvwFM7svQ&_nc_oc=AdnzcRM9No7LARSrvpDJD5EmGxhvE5iBfpN932t0k0wGR9VQvlF4XYUDNnWa0O7LP14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYnjBpXEEQMqZCSPdtycyQkuw-Hf_SIh3lRAT9jKkrrQ&oe=69A2C6C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ToolboxVR", "platform": "ANDROID_6DOF", "context_category":
-25/499298427_1119162676809047_8441272203743629910_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_kFp5FtJZAQ7kNvwEOAxUX&_nc_oc=Adny10M8_yRDVRs2y8DKIaw96dXpzGlCRrIZEXY8s0iy0IdtUHDPACIUaaDOj8WMLhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsRrpxqDDnWsk4l6LFoecxqkSgkex1hglrAsP9Br8xwKQ&oe=69998F4E"}, {"file_name": "de1e80e5b1a643dea1943bfa22494fdb.png", "id": "1465526024767082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624689_1465526028100415_3239656261792582866_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0J_qTET9K8Q7kNvwEMbMgU&_nc_oc=AdnIP_CKD_RZxaYz0RFsWd-vZyndEuny7-JHUs4CKVcBPCEogkoIP7IjrWtnTIwhj6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvQhU2c_Gs_6LcSRIbRVJT7gGVeb40nfSUYFnrrEapJ5A&oe=6999923B"}, {"file_name": "5b1567f087754cee848fcd8578f917c5.png", "id": "3968752856769362", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623441_3968752860102695_8924400166242914644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcd-wueJoM0Q7kNvwG0mj6H&_nc_oc=AdmAkwkcURU-OtCt9EkBRqbsZFrEiE0Izt5GmoF6eeLcwfd1BjHsOp50L2DxUbznpBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjBiMyBMwq8CoXuJ0oNr3Ql6NirecvtKPxgpFBCrMZ3A&oe=69998EBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ToolboxVR", "keywords": [], "long_description": "ToolboxVR lets you step inside immersive 3D spaces tailored for impactful learning, team-building and creative collaboration. Use VR headsets or join from desktop and mobile to experience walkable worlds filled with interactive media, whiteboards, avatars and more.\n\nIdeal for companies, educators, and innovators, ToolboxVR is the ultimate solution for hosting virtual training, onboarding, product walkthroughs and hybrid events \u2013 all GDPR-compliant and hosted on European servers.\n\nWhether in the office, the classroom, or halfway across the globe \u2013 ToolboxVR makes remote feel real.\n\nFeatures:\n\u2714 Real-time collaboration in walkable 3D environments\n\u2714 Use VR headset, desktop, tablet or mobile\n\u2714 Host or join public/private sessions via invitation\n\u2714 Instantly update media content via backend\n\u2714 Built-in teaching, creative and onboarding tools\n\u2714 Scalable for teams, classrooms, or global enterprises", "short_description": "Enter immersive 3D environments for training, collaboration & creativity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://entersurrogate.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Digital Toolbox GmbH", "support_website_url": null, "website_url": "https://www.digitaltoolbox.gmbh/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24305723102449755"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822307_1748259342480089_8975475324283107472_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OqqHsTdHSoQ7kNvwF7Z6j8&_nc_oc=Adm-6cKZvAR-Kb-iLryMH1mTqvqbRunUXhr2-Uqg24vWwoq6hHT4DuGDZOks9Y8kFRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviO4YnysB9B-P-VYSRHfmFSGSM1ycKxtYSidZEXQ2z9w&oe=69998C49"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ToolboxVR", "platform": "ANDROID_6DOF", "context_category":
Q&oe=6AFDAD22"}, {"file_name": "Scene 3.png", "id": "1020568177450234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_1020568180783567_2208684940648778235_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0X9fyqVlg0Q7kNvwEcm9hb&_nc_oc=AdqVxJ-Dl-gdRyHTdMSSlwiR-awz8j50unoQFclQ3b0SWnrh6d0uamMKBGGu85-9RW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgvvL8LWbourPkMgKb00jVgLjX475hIHzyG70qMC6W4g&oe=6AFDBC03"}, {"file_name": "Scene 4.png", "id": "1952424245419750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310817_1952424248753083_2458486046402757993_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1FFRNQtO5sQ7kNvwErBTM_&_nc_oc=AdqvZ7sNbCUyyfOGjlXSgk7gdSvtWScWj8HVG2W9fbpQ_OqrAIcmVLvmvkFH5yVMrr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCroWdJpeZb39SvbaBUCMtXko6kvbTCLxXoDxWb306OA&oe=6AFDD3F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "couverture paysage.png", "id": "1301687131826365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310726_1301687135159698_3600044960214891162_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1nFhNH8nXQQ7kNvwFjD7KS&_nc_oc=AdpzhIuuXG1ArBW8lYBTIu-IO4sP9nx4Qbis2_l7e26HoqTJydj8AW8Rn4UL6EBPUGg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_gPUmZPX8NKxRbvPwjHYmcskude28zX976kI_t077bQ&oe=6AFDBFA5"}, "display_name": "arena", "keywords": [], "long_description": "Arena, fast pace game, speed and precision are the keys to go to the end. 5 different scenes with bonus level. No cable, standing or sitting, no sickness, for age 13 to 88. Goal is to make an 80's arcade style game with 2020's technology, we made it. Even after thousand of test, it is hard to stop playing even after test is complete !", "short_description": "Fast action shooter, 19 levels, 3 difficulty settings. Immersive, \nNo sickness. Fun, easy to master and chal
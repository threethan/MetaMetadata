e2h-33caibTtFq-kQiqGqvqG6wENHXFoF_S8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k4J9z_lsCYvNwgW7T4XZ9zASBMHoQFn6yeXuyg3zGuQ&oe=6A4662CF"}, {"file_name": "5.png", "id": "257912543856150", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031518_257912547189483_1111062554275695307_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3a-4XUpiJAQ7kNvwH-EHeM&_nc_oc=AdrU5Nf_eMmdK-3Qibvtg1BwIm8uBjy2UWoaxS3o6g2U2bt2zCKqFiIWMeonW_9_njQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yHzJvV4ty0GFI7gjisnxuHGmvBPG-_DMVjxYviM279w&oe=6A468458"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "E_A 2560x1440.png", "id": "3176076219363858", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982588_3176076222697191_5283749418276215286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJcxNNi6te8Q7kNvwFUAdAd&_nc_oc=AdpAR1Q2f-K_wHjC8aj-Cchk9ONc4kQyU4Ihk9ZLcsR2IFpxuW9pQtOrjLehOqdk9Hk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7LXqMvRWxW6bVuk5GB710xhAoZ_zV9_pbQ7CDJq_vvQ&oe=6A46811F"}, "display_name": "Exocrism Agency", "keywords": [], "long_description": "\"Exorcism Agency\" is a multiplayer ghost-exorcism horror game.\nAs a newbie at the Ghost Busters Agency, I will now explain to you your job responsibilities: Your mission is to clear the ghosts that haunt the haunted building. Sounds simple, right? Remember, there are many types of ghosts, and the method of exorcism corresponding to each ghost is also different, so remember, before you completely determine the type and characteristics of the ghost, do not act rashly, it will harm you! Therefore, in order to successfully exorcise the ghost, you must follow the ghost-exorcism process strictly. First, you need to use dozens of spiritually exploring tools to investigate the ghost in the ghost house to determine the type and characteristics of the ghost. During this period, you may use EMF, Geiger counter, thermal imaging camera, spirit box, thermometer, spiritual book and other props. You have learned how to use these props, once you enter the ghost house, no one will teach you! Once you have completely determined the type and characteristics of the ghost, you also determine the method of exorcism for this specific ghost. You can then start to exorcise the ghost, you can use electromagnetic guns, holy water, music boxes, salt guns and other props to exorcise the ghost! Don't be afraid, just do it!\n\nExorcism Agency player community-Discord\uff1a https://discord.gg/XTQSvRyuNs", "short_description": "\"Exorcism Agency\" is a multiplayer ghost-exorcism horror game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://developer1ab.github.io/2024/02/02/PRIVACY-POLICY_Exorcism-Agency/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://www.atombits.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7457784334265841"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "1001024282569752"}, {"status": "PUBLISHED", "id": "2205459863635683"}, {"status": "PUBLISHED", "id": "999725782826360"}, {"status": "PUBLISHED", "id": "1936216797009543"}, {"status": "PUBLISHED", "id": "2777004362654758"}, {"status": "PUBLISHED", "id": "1413655076945012"}, {"status": "PUBLISHED", "id": "2261686500985394"}, {"status": 
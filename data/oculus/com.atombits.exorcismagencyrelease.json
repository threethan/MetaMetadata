prqP97T7gow&oe=6A465B7B"}, {"file_name": "1.png", "id": "929935892040196", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031574_929935895373529_3637322009184783568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5f4V8iA0iAQ7kNvwGDJH1E&_nc_oc=AdoQRJUlEUiLb0MYgxWnzw4wA4pHuXhcRisP-fj0OonBWsUfbk9baGwXH6PjNhrHYXk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vTMeTs9p_nnYCnSrVpFYTSL8oGFgmZTXmVF4K7jl02w&oe=6A466121"}, {"file_name": "3.png", "id": "393395239832065", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982697_393395243165398_6398060888400038112_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaXatMs1yhkQ7kNvwFdZVT6&_nc_oc=AdryxRgQ-8jXRZ0tXIW2m_iK43ID8PilIuXYM2QAFyjTvYfAdDOEzGQZmKhu0coZjRs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hGvtGyU6KP_YKs4VoCJd5368iHsbn8Q0udfxTFNzn6A&oe=6A46664D"}, {"file_name": "twinsboy3.png", "id": "469193185510489", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982595_469193188843822_7149964045390469648_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD6Ni4dSZQUQ7kNvwGOOgb6&_nc_oc=AdqPDuHr2pB2ziTjy1MTLFap167i0dIC7T_tHLH6QhIuYwk_Kjq3Hhx_-TXZwBNc9no&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jtOjtSehsIJ_4hSVy-NxXTR41KqKAJ_1vM8ibOhmdvQ&oe=6A46844F"}, {"file_name": "4.png", "id": "1374529513188774", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031619_1374529516522107_4380714297870889792_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmsS9RsmVioQ7kNvwGtwUIE&_nc_oc=AdpF8FsAe_13JyERnaeCNyCqLKRGD4oe2h-33caibTtFq-kQiqGqvqG6wENHXFoF_S8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k4J9z_lsCYvNwgW7T4XZ9zASBMHoQFn6yeXuyg3zGuQ&oe=6A4662CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Return to forbidden campus.png", "id": "808245868822602", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499298281_808245872155935_2868425093781463154_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBkFurQ-hJAQ7kNvwGnLxvo&_nc_oc=Adqq5Cy_m40mM5n1SE_cgn7VltI8SE0awGfXxq3sbk2GSYDez90rOwIvaN9tO8iB1H0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hq-Ty5qzKgAfjtdc4junGnFMJQwFMWateI89ATkRSBw&oe=6A467DBC"}, "display_name": "Exorcism Agency", "keywords": ["horror", "multiplayer", "strategy", "Exorcism", "survival"], "long_description": "# New: Magic Gesture & Ghost Wall Onboarding!\nMagic Gesture burns a sigil\u2014raise a shield, dome, light\u2011blade, or rip ghosts visible. Ghost Wall warps halls into teleport loops, each turn dragging you back while the hunter gains. Correct input breaks it; otherwise, you circle till the kill.\n{1541980680850017}\n\n# Exorcism Agency Overview\nExorcism Agency is a multiplayer exorcism game. You\u2019ll step into the shoes of exorcists exploring creepy spots and featuring the full exorcism process, from detection to hunting.  \n{1022423866060704}\n\n# Your Mission Start\nYou\u2019ll starting your journey from \u201cHaunted Village\u201d  then step to the extreme hard\u201cForbidden Campus.\u201d Face against 10+ ghost types like \u201cEvil Clown\u201d and \u201cCrawl Woman,\u201d using 20+ tools like EMF detectors, Spirit boxes, Salt gun to gather evidence and exorcise it.\n{684414527502576}\n\n# Explore the story hidden behind \nThis game base on a hidden tragic story, making this a journey of understanding. If you dive deep. You will linkage the things piece by piece!\n{2114924702304343}\n\n# Team work is much more fun. \nPlay with friends as a detective, guardian, or support. It was much more fun you will enjoy it. \n\n# Elite level exorcism equipment \nPowerful features above standard. Some of that are amazing like Frozen Gun/Tesla Gun Plus/Polaroid Plus and etc. Each of that was unique!\n{1963413487523113}\n# High Learning Curve \nThis is not a simple game. You should Join our Discord at **https://discord.gg/XTQSvRyuNs**  to get more tips and equipment to fill your learning curve. This is a thrilling supernatural adventure!\nSee you there!!\n\n{1736568723923186}\n", "short_description": "Exorcism Agency is a multiplayer horror game where players team up as exorcists to explore haunted locations like 'Haunted Villa' and 'Forbidden School.' Face 8+ ghost types (e.g., Evil Clown) using 20+ tools (EMF detectors, Holy water) to gather evidence and banish spirits. Uncover tragic backstories, choose roles (detective/guardian/support), and play via Squad or Reservation mode. Unlock elite gear like Frozen Gun and master high-skill mechanics. Teamwork and gear up for a chilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://developer1ab.github.io/2024/02/02/PRIVACY-POLICY_Exorcism-Agency/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://developer1ab.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "pt", "de", "ru", "ja", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27809622148655427"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499304084_768208116036298_8573034271422371928_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhh6etKG15UQ7kNvwH-LjFZ&_nc_oc=Adp_2RF-7UwfAnFUFq744XWU
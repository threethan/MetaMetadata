gL9DUzsg5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUpGsgJPgc9pyjr_efnwDk-OCy7pxEWWxj5mi3Gudm0g&oe=6B0C6E65"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/LEgCS3", "id": "3782308705143148", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974611_3782308708476481_2451469145309446144_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPelPgJMfaEQ7kNvwHVQyN3&_nc_oc=Adoj5oCyGI7IUbPhEBe2XriKPXdyzSoHNjw-qPoBJLp-zUCQAAc6Aoyerr6lcNZooM0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSx_KrCdnoZ2qn9LIKKqtMlTmNQqMipcCefhkd9KzqtQw&oe=6B0C63C3"}, "display_name": "theViewer", "keywords": ["360", "Panorama", "Picture", "Archviz", "Architecture"], "long_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nVisit theViewer.co to find out more about special features like : \n- magic links \n- shared experience \n- embedded VR \nand many more .\n\nImages provided by The Boundary.", "short_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nIf you would like to learn more about creating and viewing VR tours with theViewer, visit theViewer.co/getstarted"}]}, "developer_name": "theConstruct", "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "http://theConstruct.co/theviewer/terms-of-service", "publisher_name": "theConstruct", "support_website_url": "https://theviewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "CO
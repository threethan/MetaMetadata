cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8WEpgbcsRsQ7kNvwGrK8mr&_nc_oc=AdkkyqC71vrrbM7Xo-ElXVEMtsXF3QqnMj7qQ4iJ6w17z7OluLk51JeWVepb1BzF48c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ4FdHZ6-03PunkOJ3ynBFOJ5KAt2FtWyk5daHvqJ_kA&oe=69BFF183"}, "display_name": "theViewer", "keywords": ["360", "Panorama", "Picture", "Archviz", "Architecture"], "long_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nVisit theViewer.co to find out more about special features like : \n- magic links \n- shared experience \n- embedded VR \nand many more .\n\nImages provided by The Boundary.", "short_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nIf you would like to learn more about creating and viewing VR tours with theViewer, visit theViewer.co/getstarted"}]}, "developer_name": "theConstruct", "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "http://theConstruct.co/theviewer/terms-of-service", "publisher_name": "theConstruct", "support_website_url": "https://theviewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
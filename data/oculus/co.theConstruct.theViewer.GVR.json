?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ssPwGXPhEQ7kNvwEFpiA_&_nc_oc=AdlkfLBPqSREVdKUi0KI5tII5wceefJ3ruEJKKYQhYsfP0SLMdrowCI3_lidRACpvrM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwmXpiCabwp8x3vGtKYYwViLqbe_cjLcyl8HGWttU3BDg&oe=69AAD983"}, "display_name": "theViewer", "keywords": ["360", "Panorama", "Picture", "Archviz", "Architecture"], "long_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nVisit theViewer.co to find out more about special features like : \n- magic links \n- shared experience \n- embedded VR \nand many more .\n\nImages provided by The Boundary.", "short_description": "There is no Better Way to Create VR Tours than theViewer. \n\nNo matter if you are an architect or an amateur photographer, with theViewer you can create VR tours from 360 images in minutes and immediately view them via Android, iOS, GearVR and even Oculus Rift apps. \n\nIf you would like to learn more about creating and viewing VR tours with theViewer, visit theViewer.co/getstarted"}]}, "developer_name": "theConstruct", "developer_privacy_policy_url": "https://theconstruct.io/theviewer/privacypolicy", "developer_terms_of_service_url": "http://theConstruct.co/theviewer/terms-of-service", "publisher_name": "theConstruct", "support_website_url": "https://theviewer.co/", "website_url": "https://theViewer.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["PRODUCTIVITY", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null,
_ohc=_Rfu7cxTtaEQ7kNvwEaFPjG&_nc_oc=Ado8KU_FAUjimgzAQuqR14dVqGWUfVk2TgTT7INeKa__-3NT4dbVZNqeoTEZ7U8AFAA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ZrLEe_mF363USFhCSMzZPvaUhKeOCOoFVmlCF6Qlylg&oe=69EF76F0"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-10-22 212321.png", "id": "793875046750276", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821081_793875050083609_6526395781687069051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeZq4amHu08Q7kNvwEGq1dd&_nc_oc=Adq7it9AmyFx_hFQ8KYuuKX-H2evaU6AeChywYyFbBUqCL3nItPcIpKLA2w1fMoJORE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Y8cQ7bM25wphjrbPk7eXF--Q5jgJY9ZfP2EIV-xtjqA&oe=69EF7EE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-10-22 212257.png", "id": "705997895874843", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821702_705997905874842_6846214855104146106_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d54199sEchUQ7kNvwFwMS1E&_nc_oc=AdrYUPCUngSQnhViqqB-xABUYpiQoAW1LxiJaOO_25EFeUokvrFXQZmPLPvgiYDPy6k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0shGfwK56jSaiVCoP7qGfmSAxW79AXw7CmaHMTvIHmqQ&oe=69EF773F"}, "display_name": "Warzone Forge", "keywords": ["VRshooter", "towerdefense", "strategy", "actiongame", "basebuilder"], "long_description": "Warzone Forge puts you right in the middle of an intense VR battlefield where creativity meets combat.\n\nConstruct your defense zone, upgrade weapons, and summon units to fight waves of enemy forces. With motion-based controls, every move you make has a real impact \u2014 aim, shoot, and build like a true commander.\n\n\ud83d\udee0\ufe0f Build & Strategize: Place structures and defenses to protect your base.\n\ud83d\udd2b Fight in Real Time: Use powerful guns and VR mechanics to take down enemies.\n\u2699\ufe0f Upgrade & Customize: Unlock new weapons and tools to strengthen your strategy.\n\ud83e\udde0 Plan or React: Every battle requires quick thinking \u2014 one wrong move and your defense collapses!\n\ud83c\udfaf Designed for VR: Smooth controls, intuitive aiming, and satisfying physics.\n\nWhether you\u2019re forging your path through enemy waves or testing creative defenses, Warzone Forge delivers an addictive mix of action, strategy, and immersive VR fun.\n\nGet ready to build, defend, and conquer \u2014 the forge awaits.", "short_description": "Build, defend, and dominate in Warzone Forge \u2014 a fast-paced VR strategy shooter where you control the battlefield!\nCraft defenses, deploy your army, and destroy enemy waves using powerful weapons and traps. Every decision shapes the outcome of the war."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9971017646356998"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1800789180636195"}, {"status": "PUBLISHED", "id": "4221418104853994"}]}, "baseline_offer": {"id": "4221418104853994"}, "is_approved": true, "firstOffer": {"
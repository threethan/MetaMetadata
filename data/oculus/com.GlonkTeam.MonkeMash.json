79512342", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdGZZtNunv0Q7kNvwHI6ClK&_nc_oc=AdnfEQf3vojSfPnKMjHpNqw9I9gA6LxIDStzujUyAXqKpQbrZ96RX_3zs5u63Yr_i_I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyf1Mel7ZdZSn2LDWUZjj4KGvAYqbzKR7M6Ay4pDLhEhQ&oe=69AAB6F7"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=julcBDICeOMQ7kNvwF-5qaX&_nc_oc=Adn2t66eluKWewOznT9Tmv2LidYwIJ1Rt63EhPE8Y8O0MFixdYDSIvuSVbwN_-lXRSU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyamllF6dyUf3E_hRhvFZuqS68IHJL1O9D7ALVtUnNbA&oe=69AADDF9"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H73_M-1ZqpkQ7kNvwHlmZQE&_nc_oc=AdmoY4PfLt-Hvq_Boot3Sg709VXrRCU3WT5G4NMl-6l7cFc-sFcoed3FocyCpSH9K38&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfySXUiy0QRjM2rGbeKgxHb7bMLYv08vbyOWEDv9oXNyfQ&oe=69AAB257"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBeYhJpmpwEQ7kNvwHsvDcn&_nc_oc=Adn3xoXBkDMySpScId0jtJ6oxueJAKSeNAOlxhi2y_lfbUQTo8WMSntf1jt0J8Gu8cY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzU_qZcrpNeNuGX1hLbvOnu-IBkYFUk499AWg2CisVvAA&oe=69AAE192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
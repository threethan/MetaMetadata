=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu57dZHWTNpOnIn6uwrhv2-7sKUv643wChZ3BpMS-10cA&oe=699AE057"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xv9T-4TN76YQ7kNvwGhr7NY&_nc_oc=AdkOSfYbUAleAUuPp-OOBCUcWgrl7QaXFilB9_NJvAuUmKV06WXTXJY6XMW28CuWStw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAIxYC7H4WaFRlGTP_JzWNCVgle5479zzvsOKy8UqVHw&oe=699B0F92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/
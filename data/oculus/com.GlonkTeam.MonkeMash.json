512342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PODz18cegiwQ7kNvwG6QfS-&_nc_oc=AdmCOdEHJp59_6uGNtkqtbeMYQ-XCuJQLBrdx8y1o6pTY9uL4LCERGfWF9OctUjhdXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDX9jXgh3gHoC25d4_5jZDxoIiuH2zPQhKyCK9fR3T-w&oe=69AEAB77"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVLV65KPU-0Q7kNvwHpC_np&_nc_oc=AdnyVn4PKXIZYZOMHHSAalp29P7zceJt9aPe5JFlonVG-nZItoBNUkOv4Vl9l-SdQjg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW7ms7T6Dum37c5Vz_WWpamYQ0SibPYYl5IASB-9Zaug&oe=69AED279"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2acdXRsaCJ4Q7kNvwEtLSR9&_nc_oc=AdnEWyu8cEseFDftMHf9XEsRVxQpV1DUrZjfRRJfMcO3MycZtJ1gfvi1MBNOStRN-Ng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMnmZQFhk5ZY64p5iEUeN278OlAPfGZE4KheMAKdWu1Q&oe=69AEA6D7"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTuRAsqV7CIQ7kNvwHU_PdT&_nc_oc=Adl9hcGE1BxXwBTXKCgAZ_lmdMrbMXN-iiS3gi-PKMQPsKspz2PvnOMzV0EjlY_jLCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNhhBtk3Pq718UgUwDyXc21ixtso9Mwq-1P4fueQSidg&oe=69AED612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_US
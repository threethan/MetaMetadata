512342", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYWZEZZrdrUQ7kNvwFAOSBg&_nc_oc=Adm5ecE1ZqUOQ0z1Baal7bIzbapManAXKi5WSX9KUizVLBUfxHhsomXG6ziPgRAICAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs3OJk75dG7FLrmcjCRld7zfbZuQEQK54dcv1722sPRRA&oe=69A813F7"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkzr8xXnu8sQ7kNvwEla5Y7&_nc_oc=Adlou5swrJSWMDFZrQvKJ52Y0Tb69kBdCHFVhWYeR8du2oanTFda5D-DKdhrUJAiiOY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsliLozXpyvyKJ8mdBzk73SJhtYrfKZr19aMmN-RHKyZA&oe=69A83AF9"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ19004IZVgQ7kNvwG9Heqc&_nc_oc=AdkALflC7MtOY32jyPp4rT5UYZXr9KU-ZOitg4R9b65Vg9Th9iy0sfTm2dScKAe3jBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfukcN-eHJ-MLelv0eczmIu-umdyrIQ3cg-lfjEVx_IvDA&oe=69A80F57"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z90lA25eHV4Q7kNvwGfFAPS&_nc_oc=AdlE3KKP7VTVyNVERo5f8dwhsLxlYmg9QF3hZOvTC1wstRkQVfl3vP_DhqBjJjHooPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvl9A8t_03vbPfN9ROV2p__9sjXMy0NTJiuTRCOUcvzbQ&oe=69A83E92"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_US
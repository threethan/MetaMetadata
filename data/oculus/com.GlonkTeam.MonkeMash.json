_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR16kmksfBfOP4wjU8vgsYH-oXn3bw_595Cv72nrdaZVw&oe=6B0063B7"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PCGA4w-IYEQ7kNvwGVZC1L&_nc_oc=AdopAf6RKWlXJWgMtpD9IPc5RpJuOYgpFAVMi03VnxtJBoc6EjhGS_0-gUG6S3QHbbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRam7DGnq_OD7lHNfTIuCqASZe5jXPi792ceAaAje9sBQ&oe=6B005279"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8vFHxUvtmQQ7kNvwGBQnYh&_nc_oc=AdquUuBTS-HCncu_3hyXBufpPTYZ1gcl1FQqZoSzYNmoXXMTKCdY4kZ6t8ueRhPJcb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdAJmQoHEvB_gXVtzpE5LxAVCbX_06CRNF-2bSgoETDQ&oe=6B005F17"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vglw-4LSUEMQ7kNvwEi9hDd&_nc_oc=Adpwe61-GWsiT2GMHST2A_e6jRwGwEC6rt9UiXB_h0QluoDpccOM115qvlIRjEARJzA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM7T27yWqcLkmf8O1LqZPKs5cyht_1aXjDu8hXRHJc2A&oe=6B005612"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23931777779738930"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2049007112242052"}]}, "baseline_offer": {"id": "2049007112242
512342", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL5Xmwj4ByIQ7kNvwGpUR6T&_nc_oc=Adnoz7-lmGLRFtNgWqZbapZXnvwQVO2sRDuvEZ7Wn8LT9k_Nu1y06AY_3QF63_ji2RU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzUL2SS80Kv5IeQCTfaGrjM5Vk_2kfk7Exi4m9j8hfdrw&oe=69BD2BF7"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbi8obPCDKsQ7kNvwHaLQ6s&_nc_oc=AdnW8GrRYR0t2vqcs3Rfi195FTlbvgnAclOeZWfvT5r65YXAbkInMNliX-Ynwjys8hk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afymx8iFJqLaSHrl83-iD1RCP5KgO20Fagw_i3plQl5_Ow&oe=69BD52F9"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io5ZnbLx1coQ7kNvwHixzds&_nc_oc=AdkeBUPjrf01UQh5P2WigBTzjAwLE8WfTVSsvRg378KuhgyJSNyp5nXJvMyNDyK0bcs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8UUA-oZiTjDNIKfAj7dkvH3dyYRe1RwvuJyFqETZfjQ&oe=69BD5F97"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk0WzgcGMToQ7kNvwET2g9d&_nc_oc=AdkM_pxTiTAt03MXgCMyoSEVqlXy5Yeownkuho_9VwhryndtI0jwTvxoyumx6AcbaY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwpVCQtYzxYRfnT9IqCrrDKL2C4p7piv7gmSiwB16vrg&oe=69BD5692"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_US
512342", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSAUm_6XGrkQ7kNvwEUVnOI&_nc_oc=AdkBqPJX20gLu7U-uEcKxEiQdeT2C9A1eSGvVPk9aJizwAK8dPsNWGp2-6M2QeuIKY0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAgioWm_dGfroqemTJgHF834po1D1-roCqSmAog_e-TQ&oe=69B69477"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VtdDhuqcMwQ7kNvwEqh9nk&_nc_oc=AdklbkhmlTkWFkCTgMtKqRgyphO9xO2wNhWFZ4bv-99hLHE4GaBeN8Qcku9dVSfLXUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_ZZHit9C1sI7a8zZ12GDE83Nal6Zkv8QmSSTZ9rNQkQ&oe=69B6BB79"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3xHCfH6l9cQ7kNvwFs5u7J&_nc_oc=AdlLL1_tosCw5nsomo7NVPRHKqnkpkHWdC5SCG7FJHmjslEbE1LMNIKFIF0rfQvt5Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTjWeM-JeqtErZIh3w9rxMcR65-y-m7TJxT82wo5FOkw&oe=69B68FD7"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=855vXzwAZfUQ7kNvwF51YQu&_nc_oc=AdkFosAaZVP5mgeTB5SHMUMWni9JOHK3vrGtSq_4xFqrSv9S4OnUVEYSjBL9xXOH0PA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfztE6HqnEnewHoFQaWE_UeyGUb6nDXHsiCrxJ-z_X4AgQ&oe=69B6BF12"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_US
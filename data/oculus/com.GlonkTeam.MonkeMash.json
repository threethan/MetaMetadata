e": "scr2.png", "id": "602494379512342", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Wrr1P-5IlMQ7kNvwF-yAS1&_nc_oc=Adqc3n8UWDBv58_RFzhtW_JzhJaQEl0ErWEapCAG745MYZKe9-wgAH6HIp9u-858Lcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af181PIClpD9tbGpwsNBpowzZAUpGL0KgzsP0FHJyj9RRA&oe=69D39577"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Fj5OfPl19sQ7kNvwH6HVe1&_nc_oc=AdqKck_RoSjNxiHrZBxMvvRe8fXba-jFj5kufPr1DYXUfH46V99RZOgdXreAkDnWOEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FZEQhV2q9jDkCjQyKnvjbBkfCtWuw9OumLQp2AWrmRw&oe=69D3BC79"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZfo1PFGNysQ7kNvwH-MQRs&_nc_oc=AdrCLCoXeDDIfinRvMEyvmITIxdjODUzwVlxAbkcQgJ6DnBvSpw1bYGm09HLYxjCsjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GhWy8n33fGWIWq-4zC7XlXx9ddSMQI7Yo6gMlMNp4mQ&oe=69D390D7"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9P0fF-uBikQ7kNvwHLtjDH&_nc_oc=Ado6ZB4bUwE-jlRTl5u7Cwe66xOGv8iY5t3LG0OenB5roO6kE_lXd4vaUENNCfqP-nk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27zRR_1Fbx11TVI3JAdgqS_OafK-1dfPfPPZ0JFnpgzw&oe=69D3C012"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_
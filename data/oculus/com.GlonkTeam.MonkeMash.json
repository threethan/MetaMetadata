e": "scr2.png", "id": "602494379512342", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820638_602494382845675_5291628813408781342_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6awHHi_OsmQQ7kNvwFL4WK2&_nc_oc=AdqhCB403nxtKbR-9RAdmwvdwoJcjvmBrqY-FACJ3w3ur86NxgXATzxVeubkHv4zJ14&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCivNTw8dFOIAb-eP6l06UyZoaj7ScZlk56piFNKd8hSA&oe=6A5500B7"}, {"file_name": "scr3.png", "id": "1396197305070289", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818916_1396197308403622_8442459977003838677_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tL-bgRknyRkQ7kNvwG69dux&_nc_oc=AdoxndVSHbLICwjSDfv6ZNfbe_6lml9VSnjV_L3wDMvRpAc72CsBJzxILWDhLOnmxGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqzU6x7X7Oj3Jct7Mz_QwKcF9HnmDYNDuiwUKw2Zuw3A&oe=6A54EF79"}, {"file_name": "scr4.png", "id": "1122441726315670", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820224_1122441729649003_4263589593119209175_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkBaDLFm7TAQ7kNvwEVvArc&_nc_oc=AdrJgtsH92AxTT4GO_TGOR_t_yXWhlvnnll8BK9VuITLQn_zlE93u-cAIXdVuMtcgoA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChjjSYroOfHpqFTII6F8hNaFBcY5QBdIezI-SM2oYaXw&oe=6A54FC17"}, {"file_name": "scr5.png", "id": "1023759322540219", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820480_1023759325873552_8103943588862519090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkPHNdopMjIQ7kNvwH1MZ09&_nc_oc=Adr6R0ddgKx6WGuqjZmrd3gG5cuyS_m6a-k5INcPtoO5dtXIxCa_ma9E_jRFJFIIKvQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjWM7THH36344ovAlXEXqkVPfM-eZqSstjKU8tq6_yZQ&oe=6A54F312"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash!", "keywords": ["fun", "multi", "voicechat"], "long_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty.\n\nBuilt for the Meta Horizon Store, Monke Mash! is all about good vibes, goofy moments, and unforgettable memories with your troop.\n\n\ud83c\udfae Multiplayer fun with friends\n\ud83d\udc12 Express yourself with monke customization\n\ud83e\ude90 Explore rooms with unique physics \u2014 including zero-G!\n\ud83d\udd25 Minigames, events, and updates to keep things fresh\n\nGrab your headset, bring the squad, and get ready to mash.\n", "short_description": "\ud83e\udd8d Monke Mash!\nThe ultimate VR hangout \u2014 with monkes, mayhem, and a touch of zero-G.\n\nWelcome to Monke Mash!, a social VR experience where you and your friends can laugh, explore, and chill together as playful monkes. Climb, bounce, and swing through a variety of fun zones \u2014 from grounded hangout spots to a wild zero-gravity room where things get... floaty."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/glonkteam-monkemash/start", "developer_terms_of_service_url": null, "publisher_name": "Glonk Team", "support_website_url": null, "website_url": "https://sites.google.com/view/glonk-team/start", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_
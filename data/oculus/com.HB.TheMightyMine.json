36552713865_744113692806621321_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMu5UTqPqX8Q7kNvwH9ESs2&_nc_oc=AdpsWrIrfQEa78-x2Z2dV45XBEUPL-BIe0Rb_ieP1r_QS7jd0FwL-j-_CVly3eZJoPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAafvuWijBmrllDEoe0r7rJR64jaxwdWHj7VNEPsjzLQ&oe=6AB7C379"}, {"file_name": "Screenshot_2026-01-07_152018.png", "id": "662181783589234", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507843239_662181786922567_8240884535878023536_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeFunMVBbPoQ7kNvwGSgXDY&_nc_oc=AdoM4o0KeoyE8mL-ybVMiOzvC00ia3IEEHhajcwvHj6a4gLocCNbqL7GxDiBO7ZQ210&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0s4eYsG9JtXmeZoh9Tm2fZj3BHQfCefzmj9om4rmWLw&oe=6AB7D8CE"}, {"file_name": "Screenshot_2026-01-08_182315.png", "id": "888350416905227", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_888350420238560_3526133034134082148_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYYe8GwCshsQ7kNvwHu3o-B&_nc_oc=Adrn5rb2tvRajR1sGxPdSL3nW8dFFJ1wofZhh1lwmxk9Z-K_lkHljzH-BsD-v_aGfhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIagmSfRTRWP3cjbGTb_rwnsjH-9odw_k5UUWayNwYQjQ&oe=6AB7C580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_1229 (1) (1).png", "id": "25061873420157507", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830613_25061873426824173_3005635127035443613_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poM4ESFmpFoQ7kNvwEasCzz&_nc_oc=Adq6LKrOJKRWfi1VDzK2JP1bxRevSI-IlwbaZnaZRMkzEx2JH7AJcv3ODpBpVjDe4mQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-HB-hrjbzD80PkhzTjBaKj4K5C8E3rOjcSKwOfdZ4hQ&oe=6AB7BA89"}, "display_name": "The Mighty Mine (VR)", "keywords": ["Gorilla", "Lethal", "Monkey"], "long_description": "The Mighty Mine drops you into a dangerous, winding cave system where movement is your greatest tool\u2014and your only escape. Using Gorilla Tag\u2013style locomotion, you climb, launch, and propel yourself through tight tunnels, vertical shafts, and open caverns as you search for rare and valuable ores hidden deep underground.\n\nBut the mine is not empty. A colossal worm monster patrols the caves, reacting to your movement and mistakes. Every jump, slip, or risky maneuver can draw its attention, forcing you to think fast and move smarter. The deeper you explore, the more rewarding\u2014and dangerous\u2014the mine becomes. Survival depends on mastery of movement, awareness of your surroundings, and knowing when to push forward or retreat to safety.", "short_description": "The Mighty Mine is a fast-paced cave exploration game where you use Gorilla Tag\u2013style movement to swing through underground tunnels, collect valuable ores, and avoid a massive worm monster lurking in the depths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Nyx", "support_website_url": null, "website_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25454435674188191"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1235558218505114"}]}, "baseline_offer": {"id": "1235558218505114"}, "is_approved": true, "firstOffer": {
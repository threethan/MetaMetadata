2sJPDfFyez96Uklw9BmNFyGvtz3f-v3Bge70syvOjPiA&oe=69F0B365"}, {"file_name": "Screenshot 2026-01-28 151428.png", "id": "874124938681018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307433_874124942014351_717735627839872655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wH_xmgdytQIQ7kNvwEGV8tW&_nc_oc=Adr0dwVlgEp7fwW3BZkhLz2nxtMHvQt-KJV_II7C3XPe0wGrJIkZMOPDTMU2nI6qS9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1EUSjvzceXEZ7QYzH6zC3wlhweSZprkGp-zCEiJwi_Pw&oe=69F0C487"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero.png", "id": "2775827552755566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294601_2775827556088899_2151124750310830042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGMIjdPDVy4Q7kNvwEn7Fbi&_nc_oc=AdqZ06WDhGZIgQSXjNW8h_mkSLsUN8mi8bIbmUaFeEzCxfFsW4wVGDuoUZfAPR5gu9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1axMwagxpGO1f1OBZzk_aY4fXm6Dk25PPDRhbcxspmyw&oe=69F0C27E"}, "display_name": "The Mighty Mine (VR)", "keywords": ["Gorilla", "Lethal", "Monkey"], "long_description": "The Mighty Mine drops you into a dangerous, winding cave system where movement is your greatest tool\u2014and your only escape. Using Gorilla Tag\u2013style locomotion, you climb, launch, and propel yourself through tight tunnels, vertical shafts, and open caverns as you search for rare and valuable ores hidden deep underground.\n\nBut the mine is not empty. A colossal worm monster patrols the caves, reacting to your movement and mistakes. Every jump, slip, or risky maneuver can draw its attention, forcing you to think fast and move smarter. The deeper you explore, the more rewarding\u2014and dangerous\u2014the mine becomes. Survival depends on mastery of movement, awareness of your surroundings, and knowing when to push forward or retreat to safety.", "short_description": "The Mighty Mine is a fast-paced cave exploration game where you use Gorilla Tag\u2013style movement to swing through underground tunnels, collect valuable ores, and avoid a massive worm monster lurking in the depths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Nyx", "support_website_url": null, "website_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25745104975121258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820566_1568415937542233_1393741172714531286_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH8-FXj0TowQ7kNvwGPZuZ-&_nc_oc=Ado31UKAxadRw3NZNGt6jpCidEse0CbsQ2GTsjn3Fa588Xw7xzdGmTPvz354J_q4jB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0UvoPIL2Zl2hvnCTJIonB3CRZsWKe3Df8VFcO0IonEOQ&oe=69F0A71F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Mighty Mine (VR)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1769539260, "lastRevision": {"nodes": [{"id": "25454435700854855", "release_type": "SCHEDULED", "administration_status": "APPROV
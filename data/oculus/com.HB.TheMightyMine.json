rRpnSWAOEm_6bx2yUymU4Xno_vEbVYK4khGQA73wOSJlUaaYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MXiVyDQEMB_jjdXZmO5_7u7msLzDSjnSRUB5WViNCZg&oe=6A1991E5"}, {"file_name": "Screenshot 2026-01-28 151428.png", "id": "874124938681018", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307433_874124942014351_717735627839872655_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrqtX8CYLpsQ7kNvwFnZlQP&_nc_oc=Adp3uMNbmwWdKMYlXzPreO85ECW0gNqj3qdNiHkAfcQ51TiA47E9mz1NJikHwUJXANw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DNXbS_ijRayPxZHAlT4_TCKsSa9_nAKsKSsrcbJ6zBw&oe=6A19A307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hero.png", "id": "2775827552755566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499294601_2775827556088899_2151124750310830042_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2puGFflztEQ7kNvwHi655E&_nc_oc=AdrE17TDgl3FsA9z9pQti9fivftoKLuHg-xGPgchJtICR5_ZohqAdmPLq1gk6sVm13E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DgKl7-FyB-qYaUgEtn3epb-RFovHxrZCxbQ-BYIJb6Q&oe=6A19A0FE"}, "display_name": "The Mighty Mine (VR)", "keywords": ["Gorilla", "Lethal", "Monkey"], "long_description": "The Mighty Mine drops you into a dangerous, winding cave system where movement is your greatest tool\u2014and your only escape. Using Gorilla Tag\u2013style locomotion, you climb, launch, and propel yourself through tight tunnels, vertical shafts, and open caverns as you search for rare and valuable ores hidden deep underground.\n\nBut the mine is not empty. A colossal worm monster patrols the caves, reacting to your movement and mistakes. Every jump, slip, or risky maneuver can draw its attention, forcing you to think fast and move smarter. The deeper you explore, the more rewarding\u2014and dangerous\u2014the mine becomes. Survival depends on mastery of movement, awareness of your surroundings, and knowing when to push forward or retreat to safety.", "short_description": "The Mighty Mine is a fast-paced cave exploration game where you use Gorilla Tag\u2013style movement to swing through underground tunnels, collect valuable ores, and avoid a massive worm monster lurking in the depths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Nyx", "support_website_url": null, "website_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25745104975121258"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820566_1568415937542233_1393741172714531286_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtkVX9DEYDQQ7kNvwEyr9L3&_nc_oc=Adr-4ej_x97Os1KbFHzoCtDvU--58PH--lZmwFVMzDVZlfEWbmhmGvmb63MV2BxkAeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nHOTBZL8Ii78UK0o4JvOnC2KWvX2wBGw0r-ojlnqLdQ&oe=6A19859F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Mighty Mine (VR)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "52814231
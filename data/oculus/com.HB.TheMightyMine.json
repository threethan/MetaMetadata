36552713865_744113692806621321_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD1RLW3PTl4Q7kNvwExSbJ9&_nc_oc=Adr-H_6FA8LkooJ4TVtOPnZraSf9M08YFY7McHMvewl5Y_W0Vc39GPT9e5a5B0RKjDY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIR7pfQUEZrH5DQHe1CejUZS7ApTbsb991Seru-y7M_w&oe=6A95B4B9"}, {"file_name": "Screenshot_2026-01-07_152018.png", "id": "662181783589234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507843239_662181786922567_8240884535878023536_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzuo5HFz1y8Q7kNvwGGHF-Y&_nc_oc=AdoMDuifocdZieYC1qKykufS5fpejMi8V0_WVLuf3PAjuIzqO4ipksvu3zrajvSny0w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXStuCDuOs9cbTAV2INlKMrD_N42nih_ncAt9Ig-5EKg&oe=6A95CA0E"}, {"file_name": "Screenshot_2026-01-08_182315.png", "id": "888350416905227", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830888_888350420238560_3526133034134082148_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFry57x6kmAQ7kNvwEje4Dm&_nc_oc=AdoVW7N2sMgJDlZO7xL1dislYMQQd5Owa-YP3xfeZlJ2pJ0PhDOnBwcgiHbnFn_vPgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjEPj2CdgLFkaSdIfK3Q_UDGxf5xi1_dT9D3oVzdw2WA&oe=6A95B6C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "IMG_1229 (1) (1).png", "id": "25061873420157507", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830613_25061873426824173_3005635127035443613_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_kgZCIXvSMQ7kNvwGRMxgk&_nc_oc=Adobpah1fYnBtvsaQ2hescq5PhwZvlb1lOdh_gxWEYN-6iY0Yv4B68C3pT-9CRUDI5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCBTod3XrFBlMv6eP6OieHKC73f2xJAz6jsdk3HTLWNw&oe=6A95E409"}, "display_name": "The Mighty Mine (VR)", "keywords": ["Gorilla", "Lethal", "Monkey"], "long_description": "The Mighty Mine drops you into a dangerous, winding cave system where movement is your greatest tool\u2014and your only escape. Using Gorilla Tag\u2013style locomotion, you climb, launch, and propel yourself through tight tunnels, vertical shafts, and open caverns as you search for rare and valuable ores hidden deep underground.\n\nBut the mine is not empty. A colossal worm monster patrols the caves, reacting to your movement and mistakes. Every jump, slip, or risky maneuver can draw its attention, forcing you to think fast and move smarter. The deeper you explore, the more rewarding\u2014and dangerous\u2014the mine becomes. Survival depends on mastery of movement, awareness of your surroundings, and knowing when to push forward or retreat to safety.", "short_description": "The Mighty Mine is a fast-paced cave exploration game where you use Gorilla Tag\u2013style movement to swing through underground tunnels, collect valuable ores, and avoid a massive worm monster lurking in the depths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "developer_terms_of_service_url": null, "publisher_name": "Nyx", "support_website_url": null, "website_url": "https://sites.google.com/view/the-mighty-mine-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25454435674188191"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1235558218505114"}]}, "baseline_offer": {"id": "1235558218505114"}, "is_approved": true, "firstOffer": {
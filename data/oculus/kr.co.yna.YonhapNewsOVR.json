771-25/11162687_1966520793584250_6704459187599966208_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sceyL2agKsQQ7kNvwHwZpMW&_nc_oc=AdqsYjJfFS0kHkrQWCny52VDAPFbLsrRy8pF206oekQclcpQS-oJruZ8X9NZfjZl2rQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNts44LmLKK7-JBJVkOLt9wNgtH9y-5Js9mtyjlRsrYZQ&oe=6ADF67CD"}, {"file_name": "migrated_image.png", "id": "158885065235481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_449487358767101_6816535809433272320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChuWrRcv0HwQ7kNvwF0gvOv&_nc_oc=Adq-crOpmUI2qPv8UG8Yz980ghQ3hhg8uWxDMw8loSJqNsNmShF7RPl12Tz1wY6kEo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz7kJhrFD2R0sWPyhs5Y4SMW89iOzFduUz9xwg6SzukA&oe=6ADF4F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_2560.png", "id": "157073458186329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162748_157073461519662_4387015789547356160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cA4e71i5RYUQ7kNvwHs5q5i&_nc_oc=AdqD2N23zWCFz1qoLac2lG-dObxagowvIJ_5nO3xl2gFZeUXSzTbswhqz_BA0X5PTuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHsMfop5J1oVddgBtbAhvKYaJoJB8CVkSPBoA9RL1a4g&oe=6ADF4E59"}, "display_name": "Yonhapnews VR", "keywords": ["newsroom", "yonhap", "yonhapnews"], "long_description": "This service is part of the VR application for South Korea's leading news service Yonhap News Agency. Yonhap delivers real-time news around the clock on current issues and the latest events taking shape both at home and abroad.\nOur reports cover a wide variety of areas, from politics and business to culture, entertainment, sports and world news.\nThis application is designed to be compatible with the user interfaces of the GearVR by incorporating functions such as VR videos and photos. \nWhile fulfilling its mission as South Korea's leading news agency and providing the fastest and most accurate news both on- and off-line, Yonhap is also striving to take the lead in the VR applications sector by offering the best services to our clients.", "short_description": "This service is part of the VR application for South Korea's leading news service Yonhap News Agency. Yonhap delivers real-time news around the clock on current issues and the latest events taking shape both at home and abroad."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.yonhapnews.co.kr/policy/7906010000.html", "developer_terms_of_service_url": "http://www.yonhapnews.co.kr/policy/7906410000.html", "publisher_name": "YonhapNews Agency", "support_website_url": null, "website_url": "http://vr.yonhapnews.co.kr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "317589813736331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162695_1702878689740708_4628486959826731008_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wuv-5ZdKkIQ7kNvwG5W42a&_nc_oc=AdoI6CSppYgxpk-FmyCt1SLICyMyTjImp1DyKRxyRX8n2nhkaBbZhw9fiDuSVGbqTEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuYzjfIHDB3qIGawdHFAy6jOLjEKQnnFz4qPTw1PNDvg&oe=6ADF6256"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Yonhapnews VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1502823517, "lastRevision": {"nodes": [{"id": "1219665714827447", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1380785442005815", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "173489459859541"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "673128860152058", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc5f0\ud569\ub274\uc2a4 VR (Yonhapnews VR)", "keywords": ["newsroom", "yonhap", "yonhapnews", "\uc5f0\ud569\ub274\uc2a4", "\ub274\uc2a4\ub8f8"], "long_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\n\uc5f0\ud569\ub274\uc2a4VR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vr.yna.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694.\n\n[\uc8fc\uc694\uae30\ub2a5]\n\n1) 360\ub3c4\ub85c \ucd2c\uc601\ub41c VR\uc601\uc0c1\uc744 \ubaa9\ub85d\ud615 \ud654\uba74, \uac00\uc0c1\uacf5\uac04 \ud654\uba74 \uc911\uc5d0 \uace8\ub77c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \ub274\uc2a4\ub8f8 \uc18d\uc5d0 \uc9c1\uc811 \ub4e4\uc5b4 \uc640 \uc788\ub294 \ub4ef\ud55c \uacbd\ud5d8\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n2) VR\uc601\uc0c1 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 \uac01\uc885 \uc628\ub77c\uc778 \uc601\uc0c1\ub3c4 \ub274\uc2a4\ub8f8 \uac00\uc0c1\uacf5\uac04\uc5d0\uc11c \uc2e4\uac10\ub098\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n3) \ub2e4\uc591\ud55c \uc2a4\ub9c8\ud2b8\ud3f0 \uc6b4\uc601\uccb4\uc81c, \ubaa8\ubc14\uc77c \ud5e4\ub4dc\uc14b, \uce74\ub4dc\ubcf4\ub4dc \ub4f1\uc5d0\uc11c \ub3d9\uc77c\ud55c \uac00\uc0c1\uacf5\uac04 \uacbd\ud5d8\uc744 \ub204\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc0ac\uc6a9 \uc911 \ubd88\ud3b8\ud55c \uc810\uc774 \uc788\uac70\ub098 \uc11c\ube44\uc2a4 \uc544\uc774\ub514\uc5b4\uac00 \uc788\ub294 \ubd84\ub4e4\uc740 \ub9ac\ubdf0\uc5d0 \uc758\uacac\uc744 \ub0a8\uae30\uac70\ub098 \ub2f4\ub2f9\uc790\uc5d0\uac8c e\uba54\uc77c\uc744 \ubcf4\ub0b4 \uc8fc\uc2dc\uba74 \uae30\ub2a5 \uac1c\uc120\uc5d0 \uc801\uadf9 \ubc18\uc601\ud558\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.", "short_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\uc5f0\ud569\ub274\uc2a4VR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vr.yna.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694."}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2260509980718715", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162678_144158036163077_3342826394265583616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avK4ALdKyTUQ7kNvwEBQHyE&_nc_oc=AdoLjsasGtXx4v_b9kFVQCm5DwkaYNoH7tkJuR2XH56jEQUhsaSIOK8TnahfTKPALTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGtWvdfRkCMYOcAyPpXNnVl_flHkifg9jXQ0d5eqNAFA&oe=6ADF56FC"}, {"file_name": "migrated_image.png", "id": "653575028736938", "ima
{"data": {"node": {"__typename": "Application", "id": "1380785442005815", "organization": {"id": "1219664914827527", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1811911418881673"}]}, "id": "177630239656535"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1380785442005815"}]}, "id": "150415802198645"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1380785442005815", "release_date": 1502823517, "is_concept": false, "platform": "ANDROID", "scheduled_offers": {"count": 0}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1411808865570139"}, "id": "277580602649754"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1380785442005815", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1411808865570139"}, "release_status": "RELEASED"}, "id": "1411808865570139", "version": "1.0.4", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1499759040, "id": "1219665714827447", "is_initial_release": true, "name_with_fallback": "v1", "pdp_metadata_with_fallback": {"version": 1, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "317589813736331"}, "release_status": "RELEASED", "id": "1380785442005815"}, "id": "317589813736331", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": true, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1380785442005815", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "173489459859541"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "673128860152058", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc5f0\ud569\ub274\uc2a4 VR (Yonhapnews VR)", "keywords": ["newsroom", "yonhap", "yonhapnews", "\uc5f0\ud569\ub274\uc2a4", "\ub274\uc2a4\ub8f8"], "long_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\n\uc5f0\ud569\ub274\uc2a4VR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vr.yna.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694.\n\n[\uc8fc\uc694\uae30\ub2a5]\n\n1) 360\ub3c4\ub85c \ucd2c\uc601\ub41c VR\uc601\uc0c1\uc744 \ubaa9\ub85d\ud615 \ud654\uba74, \uac00\uc0c1\uacf5\uac04 \ud654\uba74 \uc911\uc5d0 \uace8\ub77c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \ub274\uc2a4\ub8f8 \uc18d\uc5d0 \uc9c1\uc811 \ub4e4\uc5b4 \uc640 \uc788\ub294 \ub4ef\ud55c \uacbd\ud5d8\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n2) VR\uc601\uc0c1 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 \uac01\uc885 \uc628\ub77c\uc778 \uc601\uc0c1\ub3c4 \ub274\uc2a4\ub8f8 \uac00\uc0c1\uacf5\uac04\uc5d0\uc11c \uc2e4\uac10\ub098\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n3) \ub2e4\uc591\ud55c \uc2a4\ub9c8\ud2b8\ud3f0 \uc6b4\uc601\uccb4\uc81c, \ubaa8\ubc14\uc77c \ud5e4\ub4dc\uc14b, \uce74\ub4dc\ubcf4\ub4dc \ub4f1\uc5d0\uc11c \ub3d9\uc77c\ud55c \uac00\uc0c1\uacf5\uac04 \uacbd\ud5d8\uc744 \ub204\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc0ac\uc6a9 \uc911 \ubd88\ud3b8\ud55c \uc810\uc774 \uc788\uac70\ub098 \uc11c\ube44\uc2a4 \uc544\uc774\ub514\uc5b4\uac00 \uc788\ub294 \ubd84\ub4e4\uc740 \ub9ac\ubdf0\uc5d0 \uc758\uacac\uc744 \ub0a8\uae30\uac70\ub098 \ub2f4\ub2f9\uc790\uc5d0\uac8c e\uba54\uc77c\uc744 \ubcf4\ub0b4 \uc8fc\uc2dc\uba74 \uae30\ub2a5 \uac1c\uc120\uc5d0 \uc801\uadf9 \ubc18\uc601\ud558\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.", "short_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\uc5f0\ud569\ub274\uc2a4VR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vr.yna.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694."}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "2260509980718715", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_144158036163077_3342826394265583616_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_4gBLJq6FsQ7kNvwEMtuCc&_nc_oc=AdpUSrkrx6I6A2IkYlw78xFvciWijyFyNuRqclaz9mRLeXFXZiEOfFhCsm1w_O4N5lo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScR2F0BscXfP_fAp7G5GIFbpMQ2lnowgq-c1OzaY26lQ&oe=6B09BF3C"}, {"file_name": "migrated_image.png", "id": "653575028736938", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162695_1702878689740708_4628486959826731008_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=031vK6-iwGgQ7kNvwG9cxDF&_nc_oc=AdpG-LugraFxUxe0uePjWDPO3H0-i4XbtO1j4
.oculuscdn.com/v/t64.5771-25/499622285_1699416787942698_3300115076713326171_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0ePbGU_qwgQ7kNvwG8NR1C&_nc_oc=AdpbY7V_7fDEbnf_kvS8LuXXLkbSU3ShOWq3Cb5ybTZtg3jgVHt8ft5Gbgti7y59I3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-9pA1s4Q8zRTQyYMSoUWwxJd9MqNyzEnZEYb3zLlL7A&oe=6AC12320"}, {"file_name": "com.propvr.showcasenative-20260713-195658.png", "id": "1368715948526286", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623345_1368715951859619_543055656848754627_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGZ1L1CNrckQ7kNvwFAn1UU&_nc_oc=Adr61vuJkCKDaA57En086LCyVdMpEzUwNW_lU5osJzWgZ7d199mihskgG1ODZHMi1_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMWD6xYRIQCeuxW0Wt7IekvdAV_qoUKxoio_cVmmnA2g&oe=6AC120BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Tour", "keywords": [], "long_description": "Spatial Tour brings real estate to life in fully immersive virtual reality. Step inside any property and explore it as if you were really there \u2014 in stunning 8K stereoscopic 360\u00b0, with true sense of depth, scale, and space that flat photos and video simply can't capture.\n\nMove through homes and developments room by room using your controller. Look up at soaring ceilings, take in a view from the balcony, and get a genuine feel for the flow and dimensions of every space \u2014 all from the comfort of your headset.\n\nKEY FEATURES\n\n\u2022 Immersive 8K stereoscopic 360\u00b0 tours \u2014 lifelike depth and razor-sharp detail in every room\n\u2022 Live guided tours \u2014 join a host-led walkthrough and experience a property together in real time\n\u2022 Offline viewing \u2014 download tours to your headset and explore them anytime, no connection needed\n\u2022 Fast, smooth room transitions \u2014 the next space preloads as you look around\n\nWhether you're a buyer shortlisting homes without the travel, an agent showcasing listings to clients anywhere in the world, or a developer presenting a project before it's built, Spatial Tour makes viewing property effortless, engaging, and truly immersive.\n\nPut on your headset and walk through your next property today.", "short_description": "Explore real estate in immersive 8K stereoscopic 360\u00b0. Walk through properties room by room, join live guided tours, and download tours to view offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://propvr.ai/policy", "developer_terms_of_service_url": null, "publisher_name": "PropVR", "support_website_url": null, "website_url": "https://propvr.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1042784564880300"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1090363933372533"}, {"status": "PUBLISHED", "id": "1029114636514148"}]}, "baseline_offer": {"id": "1090363933372533"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789720140, "status": "PUBLISHED", "id": "1090363933372533"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1088746566950766", "version": "1.4.0"}, "id": "1479775720622855", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Androi
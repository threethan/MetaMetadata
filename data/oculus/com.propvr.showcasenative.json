_oc=AdpHIMqwBqaMzSTl5GLUjSl4KdZ5lDbbO8Ytl-OgVxKGOq9qaHqvU-3AUOrgY_FhzzA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2c1BTKZ0OC99H9GnSrxlAvyZc3ii_XIoSy7Z2SmCqVw&oe=6AFB3E6F"}, {"file_name": "com.oculus.vrshell-20260713-195632.png", "id": "1699416784609365", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622285_1699416787942698_3300115076713326171_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DD-0BScX_1MQ7kNvwGGDf35&_nc_oc=Adqn5nxpbdfgwW_-xzbvwXoZ29ib3wbQUcRw0rDcFc7fM6rBG5szW44gHs0EH8ebBJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxTT5V5lEWCSg5rtZ5qb51Mvd0Fprpa9SMH4kyKewgtg&oe=6AFB2520"}, {"file_name": "com.propvr.showcasenative-20260713-195658.png", "id": "1368715948526286", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623345_1368715951859619_543055656848754627_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYBuHTvo2K8Q7kNvwG7Qjui&_nc_oc=AdqAeArtujU3UQvAjMu8Usxh1bwdZIhoNE7_x6E5WTENEiiZ_yt3BHp2-FIO8YYknU0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpFKu_jxvN3H8RF-99sLgs5lY_LZCk2NPTedSszB_qRg&oe=6AFB22BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spatial Tour", "keywords": [], "long_description": "Spatial Tour brings real estate to life in fully immersive virtual reality. Step inside any property and explore it as if you were really there \u2014 in stunning 8K stereoscopic 360\u00b0, with true sense of depth, scale, and space that flat photos and video simply can't capture.\n\nMove through homes and developments room by room using your controller. Look up at soaring ceilings, take in a view from the balcony, and get a genuine feel for the flow and dimensions of every space \u2014 all from the comfort of your headset.\n\nKEY FEATURES\n\n\u2022 Immersive 8K stereoscopic 360\u00b0 tours \u2014 lifelike depth and razor-sharp detail in every room\n\u2022 Live guided tours \u2014 join a host-led walkthrough and experience a property together in real time\n\u2022 Offline viewing \u2014 download tours to your headset and explore them anytime, no connection needed\n\u2022 Fast, smooth room transitions \u2014 the next space preloads as you look around\n\nWhether you're a buyer shortlisting homes without the travel, an agent showcasing listings to clients anywhere in the world, or a developer presenting a project before it's built, Spatial Tour makes viewing property effortless, engaging, and truly immersive.\n\nPut on your headset and walk through your next property today.", "short_description": "Explore real estate in immersive 8K stereoscopic 360\u00b0. Walk through properties room by room, join live guided tours, and download tours to view offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://propvr.ai/policy", "developer_terms_of_service_url": null, "publisher_name": "PropVR", "support_website_url": null, "website_url": "https://propvr.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1042784564880300"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1090363933372533"}, {"status": "PUBLISHED", "id": "1029114636514148"}]}, "baseline_offer": {"id": "1090363933372533"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789720140, "status": "PUBLISHED", "id": "109
-atl3-1.oculuscdn.com/v/t64.5771-25/75608432_236665225532470_8477464862235231329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwU4YGZHQtMQ7kNvwGYwazx&_nc_oc=AdqAbyR1yvm6Y7Xj5qbnPnBuCUdwV3zWjXJqqojeb_nPU2Cg8LQ2n567nKD6OTuWNn4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRNgBEKJu4RohHY5b7r5PA42Fwi9ScJphQWNmmAGkawA&oe=69C143C5"}, {"file_name": "Sigils_Screenshot3.png", "id": "936918417449235", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982542_936918420782568_3033632733405838476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LDT9aKjaxYQ7kNvwG2o2aN&_nc_oc=AdrTyNS0UPD6MEmy31TDIv_T2YmeOx0OxIK_oeIZnV5W0HDY9yxPOmGTzomIdrkCt6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQiwTW_3NABLtd-kiSD_IFIPefyKSS-XJ6ypnXwtO2RQ&oe=69C1451D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_CoverImage.png", "id": "897396224699085", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982617_897396228032418_5786160504434249535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY9ZXwzB3hYQ7kNvwFNYYyh&_nc_oc=Adq52g0I97Mi2edARL5qt2Tx0W7ZOblwc72mqDocHepyQpioQ1xYBs5gJ8OLXIBklJ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-XpZHrf1VSBPEYwEOJ5XslQBbg-hcdKCybh_9yPQu7w&oe=69C1276A"}, "display_name": "Sigils", "keywords": [], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your druidic dragon powers and sigils.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nMake the right tactical choices to balance your mana and energy levels, using your bow, magic and motion, combined with sigil and guardian cooldowns.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and gain strength, stamina and endurance as you progress through the mountains to defeat the crystal corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Greetings, adventurer!\n\nAre you ready to unleash the power of dragons and become a Dragon Druid? Then you've come to the right place!\n\nWelcome to Sigils. With our first chapter, \"The Power of Dragons,\" you'll be introduced to the abilities of a Dragon Druid, and set off on an epic journey that will test your strength, courage, and cunning.\n\nSo strap on your armor, grab your controllers, and prepare to embark on the adventure of a lifetime. The time has come to unleash the dragon within you!"}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "240926061842743"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1498311467914111"}, {"status": "PUBLISHED", "id": "669577684947102"}, {"status": "PUBLISHED", "id": "1427904187979937"}]}, "baseline_offer": {"id": "669577684947102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1498311467914111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_tes
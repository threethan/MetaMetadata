aRHWLSecLcZTmdibHU6H8oi_pqTuGA&oe=6ADF5EBA"}, {"file_name": "Sigils_Screenshot5.png", "id": "236665222199137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75608432_236665225532470_8477464862235231329_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PRnra8hW4MQ7kNvwHzagSH&_nc_oc=AdrlcxcqgNA3N23Q2Tx3Z_zNGQ-T-pG-4xzu4goHTZA6LAYQa9m07w5-3N4ZvG86NiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzw-S5ULOL0jK0wJicZfa3Ayev9gLlBJVTkup7aG-B8Q&oe=6ADF5945"}, {"file_name": "Sigils_Screenshot3.png", "id": "936918417449235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982542_936918420782568_3033632733405838476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIrl245P_hsQ7kNvwFHkh7r&_nc_oc=AdpbNrZAAdcsrfogSgHcAJmHGPVO144nk2NYntsfzxLWG-AV9_cHw7C-uBVpiANNnEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL2nYekafjv4adv9HXaeqSXPzoCNJaKENC6mzM_r8ajw&oe=6ADF5A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_CoverImage.png", "id": "897396224699085", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982617_897396228032418_5786160504434249535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5E9O-LNlHYQ7kNvwHvXXQ9&_nc_oc=Adq60_2rlKuGzwBOqLr29-Ev91TXMNSPfFdY7fayMeIQdqP_yLOT0JGjJlGfNkemEg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2H6py5kMErqdKuNmO6UU3twH8TzkT6QrOSRE38sdXPA&oe=6ADF752A"}, "display_name": "Sigils", "keywords": [], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your druidic dragon powers and sigils.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nMake the right tactical choices to balance your mana and energy levels, using your bow, magic and motion, combined with sigil and guardian cooldowns.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and gain strength, stamina and endurance as you progress through the mountains to defeat the crystal corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Greetings, adventurer!\n\nAre you ready to unleash the power of dragons and become a Dragon Druid? Then you've come to the right place!\n\nWelcome to Sigils. With our first chapter, \"The Power of Dragons,\" you'll be introduced to the abilities of a Dragon Druid, and set off on an epic journey that will test your strength, courage, and cunning.\n\nSo strap on your armor, grab your controllers, and prepare to embark on the adventure of a lifetime. The time has come to unleash the dragon within you!"}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "240926061842743"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1498311467914111"}, {"status": "PUBLISHED", "id": "669577684947102"}, {"status": "PUBLISHED", "id": "1427904187979937"}]}, "baseline_offer": {"id": "669577684947102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "s
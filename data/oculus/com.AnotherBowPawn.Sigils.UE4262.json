gTKkJSHndOtyKYuJcnvzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs8imj1vyA7DPQCyQuL-JAT03Na_bGeXo62RANkLp4r9w&oe=699DAB45"}, {"file_name": "Sigils_Screenshot3.png", "id": "936918417449235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_936918420782568_3033632733405838476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YKO68ncALwQ7kNvwHssfdd&_nc_oc=AdkU4as3rmoBBc44BGB51bVaRTlY-JD43X8JnhxWlpEK4J2f5R6lg1aLJKg6COOgmB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfttqdrVylUcmlOW9w5FArsxnMQvjUPalJuFnhzdb9FbrQ&oe=699DAC9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_CoverImage.png", "id": "897396224699085", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982617_897396228032418_5786160504434249535_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITr74anUxv0Q7kNvwHsun6g&_nc_oc=AdmUk0XtCyz9H3VyQTa5VVUvSdAqhHG5CDdz8LZo3Z_cUscJTecNUxFF7UmKU-CYay0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuk4BP-DeoA2S5gsqL2zWXvCgWPXEW0M2IEWvZPn8MOdg&oe=699D8EEA"}, "display_name": "Sigils", "keywords": [], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your druidic dragon powers and sigils.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nMake the right tactical choices to balance your mana and energy levels, using your bow, magic and motion, combined with sigil and guardian cooldowns.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and gain strength, stamina and endurance as you progress through the mountains to defeat the crystal corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Greetings, adventurer!\n\nAre you ready to unleash the power of dragons and become a Dragon Druid? Then you've come to the right place!\n\nWelcome to Sigils. With our first chapter, \"The Power of Dragons,\" you'll be introduced to the abilities of a Dragon Druid, and set off on an epic journey that will test your strength, courage, and cunning.\n\nSo strap on your armor, grab your controllers, and prepare to embark on the adventure of a lifetime. The time has come to unleash the dragon within you!"}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "240926061842743"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1498311467914111"}, {"status": "PUBLISHED", "id": "669577684947102"}, {"status": "PUBLISHED", "id": "1427904187979937"}]}, "baseline_offer": {"id": "669577684947102"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771005600, "status": "PUBLISHED", "id": "1498311467914111"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25725779347017844", "version": "1.0"}, "id": "1701111330346889", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBin
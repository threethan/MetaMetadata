oh=00_AfzeYjBuQp16j8_t3uGrtAnio_538h7s1KITdBp4H6SJBA&oe=69B0256E"}, {"file_name": "Sigils_Screenshot4.png", "id": "856525630543187", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_856525633876520_1064307692146884704_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1rkmq8nfIQQ7kNvwGJS3kH&_nc_oc=Adk7dyKSR25f-M_3qSC7NgZCgI-BbQuu-Dk8EagBEIeOKg0aQWdJG_R9LXUHdxBVWAQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoDynBIpV6vxdDtQFuMFPLiL197j0PvhodPFJDbvI5Aw&oe=69B02542"}, {"file_name": "Sigils_Screenshot5.png", "id": "2357581448060384", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824328_2357581451393717_1122489794666362057_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pujT3rEnBrQQ7kNvwH2QNmB&_nc_oc=Adl3OexloS6oG8tm2M9_zu7owpKjwU5CMl-kmOqxJdedsnb26HZF2k8L0CEBst8ehWE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyn6T33GVLYGhXRRlCtbzB6pUHzAIp90brHIjLuR-WFoQ&oe=69AFFF30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sigils_Trailer_CoverImage.png", "id": "1668880704103534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821796_1668880707436867_5742480713582901220_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVAMG932Ms4Q7kNvwEh7BfQ&_nc_oc=Adngv5Qh3F-B5bHjhsBhNf7oFt0OlW6PJF-cGh5pxa76NVZP4515A88S2Kf2YZ6cCPs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE7xlEEG6zRgIQP3L2f66GIFFv7iDaynXNenKGD9kdPQ&oe=69B01D61"}, "display_name": "Sigils", "keywords": ["Strategy", "Action", "Magic", "Dragon", "RPG"], "long_description": "Fight your way through a fantasy world filled with magic and monsters, using your sigils and druidic dragon powers.\n\nUse physical motion to generate magic energy by punching spells, or slashing multiple enemies in your dragon form.\n\nEnter your spirit form and take control of your primary guardian and set it free when you rain down destruction with your magic sigils.\n\nCollect dragon eggs to obtain the power of all the guardian\u2019s and boost there power from crystals collected after you defeat the corrupted elementals.\n\nFight your way through 4 difficulty levels to master the Dragon Druid\u2019s abilities and become the ultimate protector of Gaia.", "short_description": "Sigils is a strategic action RPG with ability driven gameplay and roguelite elements. \n\nAbilities are powered by ancient sigils. Spells and action based skills are activated by selecting a sigil that defines the ability you use. Whether casting magic, firing your bow, or triggering movement based actions, each ability begins with a sigil choice. \n\nTest your mastery across four difficulty levels, each designed to challenge your understanding of the Dragon Druid\u2019s mechanics. "}]}, "developer_name": "Sigils", "developer_privacy_policy_url": "https://sigils.studio/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Sigils Studio", "support_website_url": null, "website_url": "https://sigils.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25957115543884222"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1617817069223444_665093364245882479_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&
wQ7kNvwGMm0Yg&_nc_oc=Adlpm9tIYW5gzLNjHGaPVLmsPJC4ZaaRv1xT-bBW92vvgs6tysPS-__LR_5de-ZNgOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYbL8xjP8rMeUIEYxku7YW3vK0sy3hGrvSifi7bUX2Pw&oe=69BFE0C6"}, {"file_name": "ScreenShot2.png", "id": "446541228200160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974783_446541231533493_7771478920193152891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhM7VfOK0s0Q7kNvwGbEb1A&_nc_oc=AdktGKDM5RNxKSOVHMXy8GZY2ahe4jj7RFegEwmM4pVB1oh0csSvCSRtqKjbn8ob2kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyid-SXogoS0ui0lcFTEpviVCL6DJ8hcu0A_hpGVdmMXA&oe=69BFFC33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FingFing", "keywords": [], "long_description": "When you press your finger on the ground, the character moves with a \"Fing\" sound. \nThis is the only control in this game, you don't need a controller, just \"Fing\" the ground with your index finger, and you can clear all the stages of the game. \n\nYou can unlock 6 cute characters, and you can choose the main character for each stage. \nYou can play a total of 300 stages. when you clear the last stage, you can watch a concert of the 6 characters. \n\n\"FingFing\" is organized into four categories of games.\n Crossing the road, Find the maze, Block floor, Memorization\n\nImmerse yourself in a casual puzzle game filled with cute spaces and cute characters.  Master the art of finger movement and challenge yourself with increasingly complex levels. ", "short_description": "\"FingFing\" a VR healing puzzle game played entirely with your fingers"}]}, "developer_name": "AroundEffect Inc.", "developer_privacy_policy_url": "https://aroundeffect.blogspot.com/2021/07/aroundeffect-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AroundEffect Inc.", "support_website_url": null, "website_url": "http://aroundeffect.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context
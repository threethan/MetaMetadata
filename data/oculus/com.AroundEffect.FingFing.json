-1.oculuscdn.com/v/t64.5771-25/75375773_836023111427660_5087883881162981486_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFzV0odKWWsQ7kNvwHhE4aO&_nc_oc=AdoTt_9hcx90UvFkvTehtIEN2q4PFLKiaRPD-iH_giAQX11Zgo_2x7aGoOjVGtGcxo0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN-tACHEAQLESXlGb0v2qEmLf03TULXsRodLC7cqfsow&oe=6A85A1C6"}, {"file_name": "ScreenShot2.png", "id": "446541228200160", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974783_446541231533493_7771478920193152891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-L6s7p20wcQ7kNvwE2kN9-&_nc_oc=AdrGsiz9LlD1_8jLST3pmAw_12DI6207hYT4lXvZBA_6ino-FZh-XSWAlhlcKHBC6C8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmZQxFyErnbI4bQk6ustMSfCVip36aRY9ecGkHctYpCQ&oe=6A8584F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FingFing", "keywords": [], "long_description": "When you press your finger on the ground, the character moves with a \"Fing\" sound. \nThis is the only control in this game, you don't need a controller, just \"Fing\" the ground with your index finger, and you can clear all the stages of the game. \n\nYou can unlock 6 cute characters, and you can choose the main character for each stage. \nYou can play a total of 300 stages. when you clear the last stage, you can watch a concert of the 6 characters. \n\n\"FingFing\" is organized into four categories of games.\n Crossing the road, Find the maze, Block floor, Memorization\n\nImmerse yourself in a casual puzzle game filled with cute spaces and cute characters.  Master the art of finger movement and challenge yourself with increasingly complex levels. ", "short_description": "\"FingFing\" a VR healing puzzle game played entirely with your fingers"}]}, "developer_name": "AroundEffect Inc.", "developer_privacy_policy_url": "https://aroundeffect.blogspot.com/2021/07/aroundeffect-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AroundEffect Inc."
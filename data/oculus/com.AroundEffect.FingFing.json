oQ7kNvwFle9sY&_nc_oc=Adl5R5_LuTdi1FC-gnTgtKjOFm4lR5HyMq3-ntm0Lcu_GaqQZ7zyIMy0btmsQZkqUZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_eMnoJ-21Rn67HUjr54hYhch39eKSLFL5xnu-c2kSIg&oe=69AC1A46"}, {"file_name": "ScreenShot2.png", "id": "446541228200160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974783_446541231533493_7771478920193152891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izK0oA3krLYQ7kNvwHynKNa&_nc_oc=Adn2xKio28tCp0xPnPWJEuX-l4E1jP4EOVUKyA0AVkQKHbFA3lBrQYsPK3EWO8BKG4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYNzvVKYJnfFKVEkcaV0eq7ojeY0ffJzebl6NhplN6ww&oe=69AC35B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FingFing", "keywords": [], "long_description": "When you press your finger on the ground, the character moves with a \"Fing\" sound. \nThis is the only control in this game, you don't need a controller, just \"Fing\" the ground with your index finger, and you can clear all the stages of the game. \n\nYou can unlock 6 cute characters, and you can choose the main character for each stage. \nYou can play a total of 300 stages. when you clear the last stage, you can watch a concert of the 6 characters. \n\n\"FingFing\" is organized into four categories of games.\n Crossing the road, Find the maze, Block floor, Memorization\n\nImmerse yourself in a casual puzzle game filled with cute spaces and cute characters.  Master the art of finger movement and challenge yourself with increasingly complex levels. ", "short_description": "\"FingFing\" a VR healing puzzle game played entirely with your fingers"}]}, "developer_name": "AroundEffect Inc.", "developer_privacy_policy_url": "https://aroundeffect.blogspot.com/2021/07/aroundeffect-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AroundEffect Inc.", "support_website_url": null, "website_url": "http://aroundeffect.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context
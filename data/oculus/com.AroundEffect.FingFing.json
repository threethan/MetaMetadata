wQ7kNvwGEyViZ&_nc_oc=AdmLEoxEj-u9XB26AGcJprmz66hEwdY1BlC0jzcpLhHwtI8soV2aAaGsHtJ6tL-uoZs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3x-_wJQN1U7Qhg2K2q3jwjX8HpGE3h9TNljGvWmz00Q&oe=69BD3DC6"}, {"file_name": "ScreenShot2.png", "id": "446541228200160", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974783_446541231533493_7771478920193152891_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D6N7YPkUrEQ7kNvwGVwboP&_nc_oc=AdkAX9hzQ4BVBMjUn3mFm7td9ruesVHA89ZuxAyYfhXcwkd2it9aKsKj4WCKFGyFeIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwjz55EXpy2D3Vy7gM8nGwx5evDG5NF8ZKcB_v72R1bg&oe=69BD5933"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FingFing", "keywords": [], "long_description": "When you press your finger on the ground, the character moves with a \"Fing\" sound. \nThis is the only control in this game, you don't need a controller, just \"Fing\" the ground with your index finger, and you can clear all the stages of the game. \n\nYou can unlock 6 cute characters, and you can choose the main character for each stage. \nYou can play a total of 300 stages. when you clear the last stage, you can watch a concert of the 6 characters. \n\n\"FingFing\" is organized into four categories of games.\n Crossing the road, Find the maze, Block floor, Memorization\n\nImmerse yourself in a casual puzzle game filled with cute spaces and cute characters.  Master the art of finger movement and challenge yourself with increasingly complex levels. ", "short_description": "\"FingFing\" a VR healing puzzle game played entirely with your fingers"}]}, "developer_name": "AroundEffect Inc.", "developer_privacy_policy_url": "https://aroundeffect.blogspot.com/2021/07/aroundeffect-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AroundEffect Inc.", "support_website_url": null, "website_url": "http://aroundeffect.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context
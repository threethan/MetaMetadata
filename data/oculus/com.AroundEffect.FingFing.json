culuscdn.com&_nc_ss=7f20f&oh=00_AQRU_uoi8sNpbddYWHPWgsgAINqDNKKg_2KS8CcbVPKdKw&oe=6AFB48B7"}, {"file_name": "ScreenShot4.png", "id": "990668746083918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001705_990668749417251_6671192867465985437_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZI1TYMUDZ70Q7kNvwFnwxiW&_nc_oc=Adrk3JUDR2BTnOYQloAPZ_0HCSYOUNXoqTJquYJaqqiE9U4XDCapLKLOdDv37a6emsI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS98ekLc1Wt_ysU-UBW-2I4Cn3_jrwMJHMED8p1AP9jLw&oe=6AFB3F37"}, {"file_name": "ScreenShot3.png", "id": "836023108094327", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375773_836023111427660_5087883881162981486_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyutpqR5EUYQ7kNvwGBcFfP&_nc_oc=AdrWD3iyNoSMHu5Fe0lNQwBRdwZjs4Kl95Xfvp5E6RUNcQVkOfZKjtI7ItacwrlACm4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtN1aFcibRTapYFvoYiLXvyoRBOk8kQUBjq1RdmjTbSw&oe=6AFB2F86"}, {"file_name": "ScreenShot2.png", "id": "446541228200160", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974783_446541231533493_7771478920193152891_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwDTKwTujdMQ7kNvwFjI3Ex&_nc_oc=Adojxqw_AIminK7s4VAKFbSXSALb7r_NDubajkITSuTjU2dqPpbBAvJJJ1U-L7qgt5g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_c55yfqfgRN_aeER9rHEMu2vcwu8kmNh7CnsAoA1s3g&oe=6AFB4AF3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FingFing", "keywords": [], "long_description": "When you press your finger on the ground, the character moves with a \"Fing\" sound. \nThis is the only control in this game, you don't need a controller, just \"Fing\" the ground with your index finger, and you can clear all the stages of the game. \n\nYou can unlock 6 cute characters, and you can choose the main character for each stage. \nYou can play a total of 300 stages. when you clear the last stage, you can watch a concert of the 6 characters. \n\n\"FingFing\" is organized into four categories of games.\n Crossing the road, Find the maze, Block floor, Memorization\n\nImmerse yourself in a casual puzzle game filled with cute spaces and cute characters.  Master the art of finger movement and challenge yourself with increasingly complex levels. ", "short_description": "\"FingFing\" a VR healing puzzle game played entirely with your fingers"}]}, "developer_name": "AroundEffect Inc.", "developer_privacy_policy_url": "https://aroundeffect.blogspot.com/2021/07/aroundeffect-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "AroundEffect Inc.", "support_website_url": null, "website_url": "http://aroundeffect.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6526112804179969"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1287666456484876"}, {"status": "PUBLISHED", "id": "880407724214812"}, {"status": "PUBLISHED", "id": "1183257836711167"}, {"status": "PUBLISHED", "id": "478657324594996"}, {"status": "PUBLISHED", "id": "1077437623264745"}, {"status": "PUBLISHED", "id": "475775281997134"}, {"status": "PUBLISHED", "id": "813159274241325"}]}, "baseline_offer": {"id": "813159274241325"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756926000, "status": "PUBL
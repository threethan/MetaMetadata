-sea5-1.oculuscdn.com/v/t64.5771-25/491829120_1346427804342110_79008990827824463_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOmb9VtubNYQ7kNvwFBfy0i&_nc_oc=AdpEI4Y81PJLoVo2I9LOwFLno5RcQSJoADXAb8eTyMLy1UbHO0MfBRfjUorQxZjk770&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEpygmpK2yY8qnzJk9lPvrUT35PBagfBTkiDLCwkBlKA&oe=6A92B129"}, {"file_name": "IMG_0980.png", "id": "1522441826295063", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/507925214_1522441829628396_2756067739262895232_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCuQqhfJ70kQ7kNvwEMsjQX&_nc_oc=AdpDrnEt_xRfi4VQk-kCtY6LXDV9ZR71ZpAZafhCPvNKbAsHIlphItx-6b2hX0H6hv0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnzHRgfMTGcuKNWGtf3Z-gBQ69UStxJFWCDK794oK-LA&oe=6A92C48D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "lethal Fear", "keywords": [], "long_description": "Lethal Fear is a community-made fan game built on the movement systems that made Gorilla Tag a phenomenon \u2014 arm-swinging, wall-climbing, momentum-based traversal \u2014 but it drags that movement into places you were never meant to explore. Gone are the sunlit canopies and friendly tag-lobbies. In their place: flooded subway tunnels, gutted research facilities, fog-choked forests at 3 a.m., and stairwells that seem to go down farther than they should.\nA New Kind of Tag\nThe core loop still starts simple \u2014 you're It, or you're not. But Lethal Fear layers survival-horror tension over that familiar chase. Sound matters now. Every swing of your arms, every scrape against a wall, every panicked jump echoes through the map and can draw attention from things that aren't other players. Some rooms are safe to be loud in. Others are not, and you won't always know which is which until it's too late.\nFeatures:\n\nSignature swing-tag movement \u2014 the fast, physical, arm-powered traversal fans already know, re-tuned for tighter corridors and vertical dread\nDynamic AI stalkers \u2014 unpredictable entities that hunt by sound and sightline, not scripted patrol routes\nAtmospheric maps \u2014 hand-built environments designed around light, shadow, and the discomfort of open sightlines you can't fully see into\nCo-op or solo survival modes \u2014 tag your friends to safety, or brave the halls alone if you're feeling brave (or foolish)\nStamina and risk tradeoffs \u2014 sprinting and swinging fast gets you distance, but it gets", "short_description": "Players climb, swing, and tag their way through dark, abandoned environments while something unseen stalks the map. Classic Gorilla Tag movement meets survival-horror tension: every vine swing and wall jump might be the thing that saves you, or the noise that gives you away. Team up or go solo, but don't let your guard down \u2014 being tagged isn't the only way to lose.\n"}]}, "developer_name": "Pukxy", "developer_privacy_policy_url": "https://docs.google.com/document/d/1KL1chFXy_O7BLtwqdQm9zwWCDiVvkc1V_lqaj1gZSBg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pukxy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1KL1chFXy_O7BLtwqdQm9zwWCDiVvkc1V_lqaj1gZSBg/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "4420431211619370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
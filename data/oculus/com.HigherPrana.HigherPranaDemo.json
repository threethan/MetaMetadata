7a0a&_nc_ohc=cdE5Mj7-J8oQ7kNvwHk3PqQ&_nc_oc=Adru6XGJeKDKICt3Wq36JEjBQvIVZnbioCIHUODUlLZAixzTr3THqBwHiOAT0gGSYlo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECXwwOU5kKnqfOOwTQUVv4NCigw7F5sHO3Ta1A2swTgA&oe=6A8D9295"}, {"file_name": "Jungle.png", "id": "783992146820263", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75222943_783992150153596_4691561773609072848_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuLxnU2zBCgQ7kNvwGexSgg&_nc_oc=Adp4mqwJN3MZoPiAAfqSgGDa7HNcLvc_ilnMV14DApcvByoe0b7eU_pWFXTwUtudu5I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrsGLYQfjMxzXgwFSo00VHNwbZhdTKqgQ99qmcjw2r1Q&oe=6A8D9037"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Higher Prana", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "developer_name": "Visual UniVRs ", "developer_privacy_policy_url": "https://higherprana.com/elementor-22451/", "developer_terms_of_service_url": null, "publisher_name": "Higher Prana LLC", "support_website_url": null, "website_url": "http://www.higherprana.com/", "category": null, "co
j7wg&oe=69F20195"}, {"file_name": "Jungle.png", "id": "783992146820263", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222943_783992150153596_4691561773609072848_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJo3Kxf1WasQ7kNvwETouhp&_nc_oc=AdpVkO2VuTZbUca3iUszc77DocUtH79KC8RKPRx7AMwinoXSSL1dtAAQgs07g46hXA4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af03SdLgf4gft93utPKjQQ2foIoG_FL3Wu5BD1WhD8j4sQ&oe=69F1FF37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Higher Prana", "keywords": [], "long_description": "Higher Prana is a groundbreaking VR meditation app that provides a truly unique experience for mental wellbeing. Our app features ambient and electro-acoustic soundscapes that are specifically designed to enhance your meditation and yoga practice. The music is carefully crafted to help guide you into a deeper state of relaxation and mindfulness, while also stimulating your senses and creating a calming atmosphere. With Higher Prana, you can immerse yourself in a world of sound and sensation that will elevate your meditation and yoga practice to a whole new level.", "short_description": "Higher Prana is a VR meditation app with unique soundscapes that guide you into meditation or yoga practice for mental wellbeing. Experience immersive VR guided meditations and yoga with Higher Prana. Our app offers unique soundscapes that help guide you towards a deeper sense of relaxation and mental wellbeing."}]}, "developer_name": "Visual UniVRs ", "developer_privacy_policy_url": "https://higherprana.com/elementor-22451/", "developer_terms_of_service_url": null, "publisher_name": "Higher Prana LLC", "support_website_url": null, "website_url": "http://www.higherprana.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
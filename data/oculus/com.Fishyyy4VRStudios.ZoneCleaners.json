.oculuscdn.com/v/t64.5771-25/491823783_2216045485866629_3876746298759086894_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gepmSyRp7MEQ7kNvwEpIIn7&_nc_oc=AdpQ8rbAB9_KEVuNBCxuaotCBFmbJ9RDsh8fnRMu1oQOBSD0jTo1aCxsQ-ssm-m7gSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMXH5DqUfNtt-AtCD1_1On5om1tdhXfKHcjlQGAwn5eQ&oe=6AE616B3"}, {"file_name": "mushshroom.png", "id": "1549827096315140", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825497_1549827099648473_4594510466216491905_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hVniLSzE8YQ7kNvwG-PTkC&_nc_oc=Adp208Xhi6F4dpzEKsyw-00g7ryz2dEusigBbn6LztD6u8n7ZHaFw-VXgmJNG3ewgEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsH4iqS_EKe0joc0gJFGAMCZp2C4epaKIB-i688GY_5w&oe=6AE5FD6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zone cleaners new cover image.png", "id": "1548778156427900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819982_1548778166427899_2117586287100035494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnohujDUba4Q7kNvwFIGQVd&_nc_oc=AdrAKFxh0kTpaXBpK6oAOCKie0B89ZFlDxN3ONawzUVNtsILCKxLv5v2hJqgTNmGnjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1lo7CWhYWW4H-jX5y3xiO9KWmE8OyccuhpLF668K_rQ&oe=6AE6182D"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to defeat various monsters across tons of environments using amazing game mechanics with your friends?\nThen this game is right for you!"}]}, "developer_name": "Fishyyy4VRStudios", "developer_privacy_policy_url": "https://sites.google.com/view/zonecleanersprivacypolicy/domovsk%C3%A1-str%C3%A1nka", "developer_terms_of_service_url": null, "publisher_name": "Fishyyy4VRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/zonecleaners/domovsk%C3%A1-str%C3%A1nka", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27480169994965211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_763695686814960_4904937614577839999_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HigaWCV4qW4Q7kNvwFkn_e_&_nc_oc=AdrAPc17N8-1BtEvfz8yivHnSk5US16L0U2Co8D9y1wzfZPe8hc_XHlux65RG6lqgM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA_JYci6zTGMDHPDcEx58HGfGLMLkY28VPEdN79BKKNA&oe=6AE61717"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zone Cleaners", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "conte
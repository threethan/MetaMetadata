FZ5kOwgKfxBrII3XS0dxliQhMv1TK41IeDgDcJzZY3VOkqYC_W4pYb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsSSn6-_jJaxkgvdLsly-mx_Cq8_PU6niXGK5FItgE3w&oe=6AFB4AAF"}, {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174724.png", "id": "842975864934439", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819859_842975868267772_6527121458533240751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMIn6a18RbMQ7kNvwEaZKZa&_nc_oc=AdqpiQVwAUTXtvlN9_d9vRutz0kHHKWYgSwLhqoz5zgplrMS_amTXADIv_OGVRRDd6M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIWtz_GOwK7QLyRL-XJGassHS8HzaOZhVnyOx9kT-qZQ&oe=6AFB266C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174904.png", "id": "704194836059589", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_704194846059588_5945604516777700405_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt6UQXmLaqUQ7kNvwGiE5GK&_nc_oc=AdpcgpPY257rhjAZxXnFcuFlHThMH-7F-nc585vJ5wzVUrBIieuAe_JNyTudlXeCALs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhclQOJoblqkC0s1ztrDtUxqgrTzst-O5JUN3wi3T2hA&oe=6AFB2051"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to defeat various monsters across tons of environments using amazing game mechanics with your friends?\nThen this game is right for you!"}]}, "developer_name": "Fishyyy4VRStudios", "developer_privacy_policy_url": "https://sites.google.com/view/zonecleanersprivacypolicy/domovsk%C3%A1-str%C3%A1nka", "developer_terms_of_service_url": null, "publisher_name": "Fishyyy4VRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/zonecleaners/domovsk%C3%A1-str%C3%A1nka", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25559579253690971"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "916479254103326"}]}, "baseline_offer": {"id": "916479254103326"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770994380, "status": "PUBLISHED", "id": "916479254103326"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28885270764455120", "version": "1.65"}, "id": "2805562709648306", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24778779821770922", "is_concept": false, "latest_released_binary"
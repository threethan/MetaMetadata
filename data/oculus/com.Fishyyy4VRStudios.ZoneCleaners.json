ZcgyHTYdTY3CN7GUZjgfk5D3TbfxHqPoE6zXuVcdoPp1N0XLFuk9AgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWz9z1vrwqBXqHggSIHwoYxrCo9U2CSXCmgfdvT12tgA&oe=6B09CB2F"}, {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174724.png", "id": "842975864934439", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_842975868267772_6527121458533240751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL1XasBDHb0Q7kNvwEp-CMV&_nc_oc=AdoqftEUjlSd1ZNukffaQjly0GN_htZtYT5uK5Z6MxSB7-8Ds0bn2gN7IsCgA06jB5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqddxieXipGVxB2QIWFr3ynZvFYQ_51s3-tWO_nBut0g&oe=6B09A6EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174904.png", "id": "704194836059589", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491818890_704194846059588_5945604516777700405_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVw8TrDLgdUQ7kNvwE1kKrr&_nc_oc=AdoRKR1vRkKPuY9cQ1cYQ1tdiquUG7CuZj1XSZOyzDk8uCHkGPmpPJRIYGY06vPrXZo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB-NHCHf46H5dsM4GGvQvjv8zemNvQdYjymuPyZVk4hg&oe=6B09A0D1"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to def
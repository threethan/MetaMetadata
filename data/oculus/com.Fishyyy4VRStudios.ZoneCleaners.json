com/v/t64.5771-25/491823783_2216045485866629_3876746298759086894_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrvsaLLEidMQ7kNvwFVOq_M&_nc_oc=Adpuk2h3O-CKpvO4TN6x70LcfQDNXdYYL4CjHWVMif83UTO4CQPlUdWxMG__remOSgY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60eypJ6W_o92T9dctNqRPbJP-wW5A-WVj9Tk6zUKPTyQ&oe=6A12EE73"}, {"file_name": "mushshroom.png", "id": "1549827096315140", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825497_1549827099648473_4594510466216491905_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEo-pt4qHIAQ7kNvwE0I1G5&_nc_oc=AdpYCDzROpPj6rBGC8byAXOn1IWNjGe7-TktHkP73_D0qHWY4cPKSNZ_xn5cam048Fo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gMkYF6ehiU5OM3COlLgjLoiBix1geJvsbHOqdjoGiGQ&oe=6A130D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zone cleaners new cover image.png", "id": "1548778156427900", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819982_1548778166427899_2117586287100035494_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6JTCUGr5IMQ7kNvwFeTfKB&_nc_oc=AdroTz_ZUn2bgJ2DKn_69lOO9sI0GmdGiCa4iOPcfjtFWQJkVleef1cNCijNbeNYYGI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IoaifkNEYRtjM_IbBU70Y_Hh2cQRu_AnW1hT6sdvFgQ&oe=6A12EFED"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to defeat various monsters across tons of environments using amazing game mechanics with your friends?\nThen this game is right for you!"}]}, "developer_name": "Fishyyy4VRStudios", "developer_privacy_policy_url": "https://sites.google.com/view/zonecleanersprivacypolicy/domovsk%C3%A1-str%C3%A1nka", "developer_terms_of_service_url": null, "publisher_name": "Fishyyy4VRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/zonecleaners/domovsk%C3%A1-str%C3%A1nka", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25906407242341502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820496_763695686814960_4904937614577839999_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jjsf3lJCSBAQ7kNvwG9vE40&_nc_oc=AdqQK9Dn6SCn3KQuqTRiMDYXonYXDYKe9AJFZmds6xWJYXX-EdZz2NX0GKccoDAMfyI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6e1RdVVEKKyXqq11ZfwM1uIQ8QiWNPHocexUh3exdRLg&oe=6A12EED7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zone Cleaners", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics":
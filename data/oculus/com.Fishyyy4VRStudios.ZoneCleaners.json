mGCkGGx0ROEXvYBeCw-BBuZKNURBmiYoq3XCff4sTKmrR4zrB8WQ9fU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYadZcaO_bHlPwzMWrZ9q3_M_7g3aHrl14zKvuTrQ_RQ&oe=6B07282F"}, {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174724.png", "id": "842975864934439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_842975868267772_6527121458533240751_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeexSLLD6oMQ7kNvwE0Wg0b&_nc_oc=AdodTI9-JejjT0HeyZ8qXWPmw53VJWOvKtPt48fnfE5x91R7rbTPfCFez-l9dfZma-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDcJk-uv5eQZFtJIcBnhTqXi2Oyo1huUFPOOB_h8HmqQ&oe=6B0703EC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Sn\u00edmek obrazovky 2025-10-18 174904.png", "id": "704194836059589", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_704194846059588_5945604516777700405_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m59eKYHM01EQ7kNvwEnjiji&_nc_oc=AdoY4cDQVQkFlYULqyZAYqq7SV6UsCp9s1kK9w4GmElLfY1eDhuftrIZfeMGZzT8BGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfDKhnWGuSTw4DAPu4iR2Re7AcsCJlKO3RJvIllM2G_g&oe=6B06FDD1"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to def
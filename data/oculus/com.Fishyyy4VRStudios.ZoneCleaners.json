om/v/t64.5771-25/491818890_704194846059588_5945604516777700405_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pMBe9Z2VdIQ7kNvwEJx57-&_nc_oc=AdqX3QQdp913jvjb0JXmPG0zotYCXhmXWFXuajWV6SUVIaQd-2VLfGSXXuHP6WchWqk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af26XSlwn3g-XTg809SwKHP4tIOvGjEhpytAp8IzFgafeA&oe=69F1EA91"}, "display_name": "Zone Cleaners", "keywords": ["monster", "multiplayer", "horror", "backrooms"], "long_description": "The core idea of the game is to enter dangerous zones with 2\u20134 entities, each level featuring unique challenges. Players collect energy orbs scattered throughout the zones, which are used as ammo for guns and gadgets. The goal is to defeat powerful, unique monsters.\n\nDefeating monsters rewards players with in-game currency called Gadget Coins (GC), which can be used to purchase cosmetic hats, upgraded guns (higher damage or faster fire rate), swords, and secondary items such as shields, stun shockwaves, grenades, and healing items.\n\nAs you progress, you unlock new zones, equipment, and upgrades.", "short_description": "Have you ever wanted to defeat various monsters across tons of environments using amazing game mechanics with your friends?\nThen this game is right for you!"}]}, "developer_name": "Fishyyy4VRStudios", "developer_privacy_policy_url": "https://sites.google.com/view/zonecleanersprivacypolicy/domovsk%C3%A1-str%C3%A1nka", "developer_terms_of_service_url": null, "publisher_name": "Fishyyy4VRStudios", "support_website_url": null, "website_url": "https://sites.google.com/view/zonecleaners/domovsk%C3%A1-str%C3%A1nka", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
Hoxo2DYeytChog&oe=6AFDC8E0"}, {"file_name": "d9eg-07-50.png", "id": "1966877080939635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1966877087606301_1849899708807364355_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpXSQPY4f5oQ7kNvwGXmAta&_nc_oc=Adr7CW9_0joO1bIJE98DoANl5-HPrnAJMakespJXPtl-Sx5G99VcDd57Rdk4exRFk1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ4uD2lDcU0fmYIPGh9xZN_KMdlWFNQiAP8iKUZjKFUw&oe=6AFDDE01"}, {"file_name": "07-elites.png", "id": "1395876565862418", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1395876569195751_3985541967754222096_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD69w3klTDgQ7kNvwH1QoxG&_nc_oc=AdqeF2iR6A8RqzEK2ZuXGUH4UZHi-gv2_h72BDXTEYhrtEBy1Q_gxh8qcAqRBm9b0r0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa6hWWHxRR6DpT6bTXlwgM7VL-NH858JOeKe0glwiOTg&oe=6AFDE576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-first-frame-1440p.png", "id": "2189298508335999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827987_2189298511669332_3571281326133285758_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDQIRlbPTPMQ7kNvwEQyEl1&_nc_oc=Adqo5nHf_CjLIT20zyhK5nSC3JKPlDYxpZ_8Oaff0XoZpzJOmdl3k7F4YQ95lFkjcHQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdawjdS4eNANsK5RlPh5rmZMiJV3k_yfx8SDhTxSdemA&oe=6AFDD312"}, "display_name": "Arrowfall", "keywords": ["archery", "bow", "roguelite", "synthwave", "wave"], "long_description": "**A neon archery roguelite where you fly.** Skate, leap and shoot in mid-air while a living black hole pours its swarm down on the last city still lit. **The first five levels are free, and joining a DUO opens the whole game.**\n\n**A real bow, in mid-air.** Draw, aim, release. Arrows ricochet off everything and curve toward their targets. Slow time for the impossible shot.\n\n**Move like nothing else in VR.** Sweep your arms to skate a neon rooftop arena. Launch off the lip, chain air jumps and dive-slam into the horde.\n\n**Throw black holes.** Drag the horde into one knot, then shoot into it for a devastating blast.\n\n**Builds that break the screen.** 63 stacking items: burning tips, homing rockets, chain lightning, echo shots, meteor storms. Open legendary chests, but watch for the ones that bite.\n\n**No two levels alike.** Low gravity, giants and gold rushes change the rules. Chase the Gold Thief, then climb past Wardens and Overlords to THE ECLIPSE, tearing the city into the sky.\n\n**DUO online co-op.** Quick Join or bring a friend. Free players can join any host and play the host's full game, ECLIPSE included.\n\n**Always something to earn.** Open cases of looks for your bow, arrows and robot, and chase daily contracts and trophies. Cases are earned only, never sold.\n\n**Free to start.** One unlock opens solo past level five and DUO hosting. One-time purchase, no ads.\n\nSynthwave soundtrack that rises with the fight. Plays offline after the first launch; DUO needs internet.", "short_description": "Free to start: the first five levels are free, and joining a DUO host opens the whole game. A neon VR archery roguelite. Draw a real bow in mid-air while you skate a rooftop arena on pure momentum. Arrows ricochet and curve into the horde, black holes drag monsters into one knot, and 63 stacking items make every run a new build. Levels change the rules, chests bite back, and you earn cases of looks as you go. Climb to THE ECLIPSE, a living black hole. Solo or DUO online co-op."}]}, "developer_name": "Vasb\u00e1nyai J\u00e1nos", "developer_privacy_policy_url": "https://arrowfall.lol/privacy_policy", "developer_terms_of_service_url": "https://arrowfall.lol/tos", "publisher_name": "The Collective", "support_website_url": "https://arrowfall.lol/contact", "website_url": "https://arrowfall.lol/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1750360486687372"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825470_1056662470729399_7738115168884998540_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV0F-56d2AMQ7kNvwHZowrd&_nc_oc=AdrwUD0z8t9SXt0GQ2ZGiGDvm8rz8ef6MZ0Pd2uPTjSPD3d0PpbDKHWie792FWWsiIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwDh1RAnbTbGMeLTgVQ3px3UD4BEroNFrOsoKHAW066A&oe=6AFDD5EC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arrowfall", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1792754820, "lastRevision": {"nodes": [{"id": "1726931129030308", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1726931115696976", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1431308199194251"}
: "1026340855134128", "locale": "en_US", "screenshots": [{"file_name": "bugsupclose.png", "id": "387132031077469", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75630188_387132034410802_3629908537715767884_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mE0f0w6INYQ7kNvwG2Eu38&_nc_oc=AdqkWl9c2IcXMEHayDpeE6hL6qniiHz0Js6uQb3hfbZl-w7Ihgc3bojRpK8NOcUZVnk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWJTypq4Gc0ZFAb9bxkbIjIrAQBULxJUu07vZx8TMaaA&oe=6A7DA23B"}, {"file_name": "lawer desk.png", "id": "1021730339243891", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974725_1021730342577224_5121892752200566930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjRC5dV-IcAQ7kNvwGe149_&_nc_oc=AdpOu1X7qw7naFlPxNML5XxrDm_Hhrsh7q-v7VDDNnT737T_gerkjjqPVa-A43bygv4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVaMHkSj6fQBc89cQqxAfMjAhJfqyydEkCz7gs9HC_HA&oe=6A7DCEE3"}, {"file_name": "certificatemachine.png", "id": "419222644501284", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031359_419222647834617_1044340319385662871_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eWWGU3zt0cQ7kNvwGTRvvB&_nc_oc=AdoUGnI4D_1dtu2Nl5pRQGi4CLJ5o2Ogd1LjWp9v_R46EU-KQ77OtZoYOYum7zClAaI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHozV4_HR_iysrF4uEiCn5cluo5VsY8n0-KaAu4jVMBaQ&oe=6A7DA1C7"}, {"file_name": "gustav.png", "id": "1041151010314056", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982712_1041151013647389_9208282846641755977_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m663YW6qGA0Q7kNvwF6zBZb&_nc_oc=Adpa517cxMVHUTngWBTFK9421FQj_9qrhnK4PV_aNMwH-PeJT6fIjP13RAnHw9N-Rlc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq_1qxAibQ3YDSFrGnVg6rJzMsinvU-O9FTyhDDklPAw&oe=6A7DA731"}, {"file_name": "lawyers head-resize.png", "id": "409356922173502", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38984472_409356925506835_675175198628609171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrTyhh7-lh8Q7kNvwFYbAb8&_nc_oc=AdrH56t7nZeSmLHPEHbgQwMI1lEcOm3EwrNYWy4WpZG2TMcPr-LjavN0SHcxks6Ci1o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh2azf6pLZe8lnVWQcub2Ae1ubCYFI3OPZOU54_8OsLA&oe=6A7DB56F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1568747630685050", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031482_1568747634018383_5207621578584535018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFknRf6_FFcQ7kNvwECwESc&_nc_oc=AdogyuzJ29sJyEgYWWK6UcjWguD-_QASJ-u22ZZZIo3bzRfJMnzHTQ3d7iqTozvXfyQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX33Zfu1bX10JynCgzwQAGuSGha4MnTAlulNkebK9VLg&oe=6A7DCC49"}, "display_name": "Metamorphosis", "keywords": ["bug", "meta", "puzzle", "escape", "mystery"], "long_description": "# **An Extraordinary Journey Through a Surreal World**\n\n---\n\nIf navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a truly Kafkaesque turn one morning when he awakens to discover he\u2019s been transformed into... a **cockroach**.\n\n### Armed with only your **wit** and **strange new appendages**, embark on a mind-bending journey to unravel the mystery behind your *metamorphosis*.\n\n### \n\n### **Welcome to a World Unlike Any Other**\n\nIn this surreal world, everyday objects loom like towering giants, while dizzying heights challenge your step, and each turn begins a new adventure.\n\n\n#### What to expect:\n- **Dance** all night in a bug's nightclub  \n- **Delve** into arthropod-organized crime  \n- **Dodge** the hands of mammoth humans  \n- **Escape** the bureaucratic traps of buggy officials\n\n---\n\n**But beware**, your friend\u2019s life is hanging by a thread, and your only hope to regain human form lies deep within the heart of a mysterious **Tower**\u2014a place with its own plans for you.\n\n---\n\n### Metamorphosis is a first-person **adventure-platformer** set in a surreal, beautifully twisted world, where your newfound abilities as an insect are your only hope for redemption.\n### \nWill you **avoid the Tower** and **save your friend**? Or will you be **lost forever** in this strange, curious land?\n\n---\n\n# *Embrace the challenge. Escape the Tower. Your metamorphosis awaits.*\n", "short_description": "If navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a Kafkaesque turn one morning when he awakens to discover he\u2019s transformed into a cockroach. Armed with only your wits and some strange new appendages, set off on an extraordinary journey to unravel the mystery of your metamorphosis. \n\nMetamorphosis is a first-person adventure set in a surreal world filled with strange and curious denizens where your newfound abilities are your only hope for redemption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blacksunproductions.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Black Sun Productions Inc.", "support_website_url": null, "website_url": "https://www.blacksunproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7251689064878355"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_support
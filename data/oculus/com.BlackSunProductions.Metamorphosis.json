screenshots": [{"file_name": "bugsupclose.png", "id": "387132031077469", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_387132034410802_3629908537715767884_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNZP0OVcfYgQ7kNvwFAu7ui&_nc_oc=AdloABzOhOTc7TTYDLcCUPXlOEq2HY0kujj__CQXqLt5AWYpfqUwihmUr75x-RweZJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW4_Tsvo5yPuOWAnXpoQeG3WF6x0Q_rHLgFi-QLXfVrg&oe=69AD553B"}, {"file_name": "lawer desk.png", "id": "1021730339243891", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974725_1021730342577224_5121892752200566930_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeUkZEuOf7kQ7kNvwHakIMq&_nc_oc=AdlF7SFeiRCeSwWLlQvH43XSu-I7-u4cElKITXUroHKbJO6B6pQS9E1Ecx9WhkxaIfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxe1n63EtKumRoR-efIvz53Ep8ZTBbZOVRX3ZIkMIywaw&oe=69AD81E3"}, {"file_name": "certificatemachine.png", "id": "419222644501284", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031359_419222647834617_1044340319385662871_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHhMG3mp754Q7kNvwE9i3ka&_nc_oc=AdlerrThkYIANFnsmX3xm2rWSQNuZh98jFBVNR8TopvgoUPeach1Z82kewj0a1FTIj0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVaQYvVEHXCbssO5Hxxb1KdPZ-e79VXZw9fghXDnODzw&oe=69AD54C7"}, {"file_name": "gustav.png", "id": "1041151010314056", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982712_1041151013647389_9208282846641755977_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKDaM1-3bLkQ7kNvwHjCtA-&_nc_oc=Adk8G27uXSO78kKH-B5ETkTi6wQ5G0u5cTGjwJCj3oT8kj0V7rMBt7baslA2f4O588Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk7yz-COgkhCJnnmGN_dFCJkgPs1EmV2wZBABcAwjIwg&oe=69AD5A31"}, {"file_name": "lawyers head-resize.png", "id": "409356922173502", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984472_409356925506835_675175198628609171_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aHjRvs7bwEQ7kNvwG0h2l6&_nc_oc=AdlwF3OK8KsrYkQckZA74uC8XliUb_9xy6Dri1IMTKaUCLNrnSUQ6vJai0LHFt1vtP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqKiNOAEjIZh0lvT8iKpusvygAfkBtgbw4M7QFKvGsdQ&oe=69AD686F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1568747630685050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031482_1568747634018383_5207621578584535018_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRpGIjqThcUQ7kNvwHOAtiq&_nc_oc=AdlxMartSqLiLJFQP6YiFMeegVfC0wfKQJkm1lF75vGAjxjkisnT3xKvoLl3KHNYPpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8uplvtjvJNBUWDXBPkuPw_p1CfeFKrWzI3mMQUYg0ZQ&oe=69AD7F49"}, "display_name": "Metamorphosis", "keywords": ["bug", "meta", "puzzle", "escape", "mystery"], "long_description": "# **An Extraordinary Journey Through a Surreal World**\n\n---\n\nIf navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a truly Kafkaesque turn one morning when he awakens to discover he\u2019s been transformed into... a **cockroach**.\n\n### Armed with only your **wit** and **strange new appendages**, embark on a mind-bending journey to unravel the mystery behind your *metamorphosis*.\n\n### \n\n### **Welcome to a World Unlike Any Other**\n\nIn this surreal world, everyday objects loom like towering giants, while dizzying heights challenge your step, and each turn begins a new adventure.\n\n\n#### What to expect:\n- **Dance** all night in a bug's nightclub  \n- **Delve** into arthropod-organized crime  \n- **Dodge** the hands of mammoth humans  \n- **Escape** the bureaucratic traps of buggy officials\n\n---\n\n**But beware**, your friend\u2019s life is hanging by a thread, and your only hope to regain human form lies deep within the heart of a mysterious **Tower**\u2014a place with its own plans for you.\n\n---\n\n### Metamorphosis is a first-person **adventure-platformer** set in a surreal, beautifully twisted world, where your newfound abilities as an insect are your only hope for redemption.\n### \nWill you **avoid the Tower** and **save your friend**? Or will you be **lost forever** in this strange, curious land?\n\n---\n\n# *Embrace the challenge. Escape the Tower. Your metamorphosis awaits.*\n", "short_description": "If navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a Kafkaesque turn one morning when he awakens to discover he\u2019s transformed into a cockroach. Armed with only your wits and some strange new appendages, set off on an extraordinary journey to unravel the mystery of your metamorphosis. \n\nMetamorphosis is a first-person adventure set in a surreal world filled with strange and curious denizens where your newfound abilities are your only hope for redemption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blacksunproductions.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Black Sun Productions Inc.", "support_website_url": null, "website_url": "https://www.blacksunproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7251689064878355"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nod
c_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa5Xe5o0DldLSW1eNwCu4u7O3gskd6uWg_g3lt688Tog&oe=6B01EDB1"}, {"file_name": "lawyers head-resize.png", "id": "409356922173502", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984472_409356925506835_675175198628609171_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ocOpt-14uwQ7kNvwGuxMrz&_nc_oc=Adq3fR5vf9wDFhqu2vThRpQhPdDUgpp_NOfKz6XkjwRJgzjFbSQuKZF3S8jQfnS6DDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw9hEzun87abJHQPlukM216ONOUmi547IXMkL0LHQ4xw&oe=6B01C3AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1568747630685050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031482_1568747634018383_5207621578584535018_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgqyMfT5aKQQ7kNvwGGA8fV&_nc_oc=AdpiqVg22MZZGbxe5UvskqT3VJeYc3jLT41aGPY9ciWijpcy1QJEsgNwD5HEt9IM1TE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAAjy6KRipIuVFHStMqIE3lrosjgnmd2myPg-7XJLkPw&oe=6B01DA89"}, "display_name": "Metamorphosis", "keywords": ["bug", "meta", "puzzle", "escape", "mystery"], "long_description": "# **An Extraordinary Journey Through a Surreal World**\n\n---\n\nIf navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a truly Kafkaesque turn one morning when he awakens to discover he\u2019s been transformed into... a **cockroach**.\n\n### Armed with only your **wit** and **strange new appendages**, embark on a mind-bending journey to unravel the mystery behind your *metamorphosis*.\n\n### \n\n### **Welcome to a World Unlike Any Other**\n\nIn this surreal world, everyday objects loom like towering giants, while dizzying heights challenge your step, and each turn begins a new adventure.\n\n\n#### What to expect:\n- **Dance** all night in a bug's nightclub  \n- **Delve** into arthropod-organized crime  \n- **Dodge** the hands of mammoth humans  \n- **Escape** the bureaucratic traps of buggy officials\n\n---\n\n**But beware**, your friend\u2019s life is hanging by a thread, and your only hope to regain human form lies deep within the heart of a mysterious **Tower**\u2014a place with its own plans for you.\n\n---\n\n### Metamorphosis is a first-person **adventure-platformer** set in a surreal, beautifully twisted world, where your newfound abilities as an insect are your only hope for redemption.\n### \nWill you **avoid the Tower** and **save your friend**? Or will you be **lost forever** in this strange, curious land?\n\n---\n\n# *Embrace the challenge. Escape the Tower. Your metamorphosis awaits.*\n", "short_description": "If navigating daily life in 1900s Vienna isn\u2019t complicated enough for Gregor, things take a Kafkaesque turn one morning when he awakens to discover he\u2019s transformed into a cockroach. Armed with only your wits and some strange new appendages, set off on an extraordinary journey to unravel the mystery of your metamorphosis. \n\nMetamorphosis is a first-person adventure set in a surreal world filled with strange and curious denizens where your newfound abilities are your only hope for redemption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blacksunproductions.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Black Sun Productions Inc.", "support_website_url": null, "website_url": "https://www.blacksunproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
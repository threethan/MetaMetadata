n.com/v/t64.5771-25/499619518_1102842782062752_1648821210809081567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTXidgn6x-cQ7kNvwGa0xM6&_nc_oc=AdrtUOJzmOjTLnc2ieAj98hnnbT27e0W9QcrajffonjE6_cP3-X1d0GYit9vJU3nQJE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXDJYquAqVNmQnzhxC2eNhl25YWARitNZr5ZkDBLrRIA&oe=6A50ED33"}, {"file_name": "Frame 5.png", "id": "2445052095973426", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_2445052099306759_8479279051328535715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vk4frjGGCkQQ7kNvwFtOO9X&_nc_oc=Adpyi1GXKqA8rWCQFWExKYYuXaPvA6OQbE8txGcDvSMFhCCb3oVUHYnWOu42BiBCv_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvXhOJ8o_zGHEEbxOBqxVW2N48Bdccu_6toBngsUxyMw&oe=6A50F62D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1236594808611984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623601_1236594811945317_2005075272528938587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVaAIX7x92kQ7kNvwHkWAu5&_nc_oc=Adrgs8_aTQzwrT03FkUXqn2nLZAz8w3mYRpPaEaKLyrb5hBX_OimoijGKyn22TiKWEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDks5irc-7O007eCpvCdmZ56kvP34hSe_nDe6KorDeRqg&oe=6A51147F"}, "display_name": "Blobtown", "keywords": ["Sandbox", "Hangout", "WorldCreation", "Fight", "Avatar"], "long_description": "Create your avatar, build almost anything, and hang out with other players.\n\n# Create Your Avatar\n\nMake a character in minutes. Build a person, creature, object, or something totally weird\u2014the tools are simple, fast, and easy to learn.\n{4204923259750161}\n\n# Build, Share, and Explore\n\nUse intuitive 3D creation tools to make avatars, props, accessories, and more. Explore player-made creations, record videos with the in-game camera, and share your best ideas.\n\n# Hang Out With Friends\n\nBlobtown is multiplayer from the start. Meet new people, show off your creations, and spend time in a colorful social world built for creativity and fun.\n\n# Buy and Sell Creations\n\nUse Blobium to buy player-made items, from avatars to accessories. Make something great? Open your own shop and sell it to other players.\n\n# Jump Into Physics Battles\n\nBuild custom melee weapons and test them in fast, silly battles where size, weight, and shape matter.\n\nNew worlds, items, and features are added regularly as Blobtown keeps growing.\n\n\n", "short_description": "Create your avatar, build in 3D, hang out with friends, and jump into silly physics battles. Blobtown is a free social sandbox where you can make characters, explore player creations, buy and sell items, and record videos in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blobtown.com/privacy-policy", "developer_terms_of_service_url": "https://www.blobtown.com/tos", "publisher_name": "RevelVR", "support_website_url": "http://www.discord.gg/blobtown", "website_url": "https://www.blobtown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26718357801170468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_1205607824991199_1687573175996493283_n.png?stp=dst-png_
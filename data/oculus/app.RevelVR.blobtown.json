com/v/t64.5771-25/499619518_1102842782062752_1648821210809081567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4z5pG8jpaeMQ7kNvwGAZLzB&_nc_oc=Adqx4-jpUwc7yXVQP8v1FxWcAWbjCPySMzfta1Oi8sQvzi1S0J44QFxlw3xnnc7TBpY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80OZD9LEqzLKG9YprFicO299lg8XhV_OgoUro4wTW69w&oe=6A241A33"}, {"file_name": "Frame 5.png", "id": "2445052095973426", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619113_2445052099306759_8479279051328535715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTAjh3B3NlcQ7kNvwEHX0lg&_nc_oc=Adr6Wzi1eO-ksn6RpTNt_2ZDegl_G7diAIm-mRgkZoRf--ZFdFOICaI_3C8Sra9YH0M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qq7SAfQEUhEtv-PD66lpe--LdlTRXaOcybi3y3wUaCA&oe=6A24232D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1236594808611984", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623601_1236594811945317_2005075272528938587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsrvFYwgLIoQ7kNvwE2_c5k&_nc_oc=Adp47rvA16WQlnVXtOM__wzoW1OPePwrDqSuhABlWXFwAuw-fM3fOTspZWMNZKD6Qro&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tNF-sTLdXa_8nss_XkrS_69rt3lDJ1CkDiBhlroGZ9g&oe=6A24417F"}, "display_name": "Blobtown", "keywords": ["Sandbox", "Hangout", "WorldCreation", "Fight", "Avatar"], "long_description": "Create your avatar, build almost anything, and hang out with other players.\n\n# Create Your Avatar\n\nMake a character in minutes. Build a person, creature, object, or something totally weird\u2014the tools are simple, fast, and easy to learn.\n{4204923259750161}\n\n# Build, Share, and Explore\n\nUse intuitive 3D creation tools to make avatars, props, accessories, and more. Explore player-made creations, record videos with the in-game camera, and share your best ideas.\n\n# Hang Out With Friends\n\nBlobtown is multiplayer from the start. Meet new people, show off your creations, and spend time in a colorful social world built for creativity and fun.\n\n# Buy and Sell Creations\n\nUse Blobium to buy player-made items, from avatars to accessories. Make something great? Open your own shop and sell it to other players.\n\n# Jump Into Physics Battles\n\nBuild custom melee weapons and test them in fast, silly battles where size, weight, and shape matter.\n\nNew worlds, items, and features are added regularly as Blobtown keeps growing.\n\n\n", "short_description": "Create your avatar, build in 3D, hang out with friends, and jump into silly physics battles. Blobtown is a free social sandbox where you can make characters, explore player creations, buy and sell items, and record videos in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blobtown.com/privacy-policy", "developer_terms_of_service_url": "https://www.blobtown.com/tos", "publisher_name": "RevelVR", "support_website_url": "http://www.discord.gg/blobtown", "website_url": "https://www.blobtown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26223464767326443"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620921_1205607824991199_1687573175996493283_n.png?stp=dst-png_s3
 1.png", "id": "842130428338007", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_842130431671340_172598238382979848_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7jcT9FWajcQ7kNvwHN_Sbr&_nc_oc=AdqCMEDpaM8wnBz6fJYmb6-hSA_wSmwsOYQpMQCBefUjviuOHsE8lU0A8hFLafARq1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71VDWTiWwsp_Czf9GsNN11OO1XdUM9enG6LN1WThHM6A&oe=6A046A63"}, {"file_name": "CameraCapture2025-11-04-16-50-36.png", "id": "1382649366640872", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618472_1382649369974205_8680013361594657345_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iZUy-mXOarcQ7kNvwG84HYM&_nc_oc=AdprsytuCw5wEJAga1cuSG8QHssx55KKzx_D30PIir3ydGckyIBk6naNf7HrRIsu1zU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lQbJ5VnmVwjLUxxzyhJ14hnWYtQCSRJviHAtEmhIX3A&oe=6A047358"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1236594808611984", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623601_1236594811945317_2005075272528938587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aelP51HhY9kQ7kNvwHXtqoH&_nc_oc=AdpXVJIo8y5X-fNedz05wQE__xcKQz4PlkvZNtvVFKdLEyJb-BADhJVu9-Fwo-EQLss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ULya3HT0uzEeEkfxLoflJ3NWFe1w8jtviShK1PM5mjQ&oe=6A04653F"}, "display_name": "Blobtown", "keywords": ["Avatar", "Social", "Hangout", "Sandbox", "Building"], "long_description": "Create your avatar, build almost anything, and hang out with other players.\n\n# Create Your Avatar\n\nMake a character in minutes. Build a person, creature, object, or something totally weird\u2014the tools are simple, fast, and easy to learn.\n{4204923259750161}\n\n# Build, Share, and Explore\n\nUse intuitive 3D creation tools to make avatars, props, accessories, and more. Explore player-made creations, record videos with the in-game camera, and share your best ideas.\n\n# Hang Out With Friends\n\nBlobtown is multiplayer from the start. Meet new people, show off your creations, and spend time in a colorful social world built for creativity and fun.\n\n# Buy and Sell Creations\n\nUse Blobium to buy player-made items, from avatars to accessories. Make something great? Open your own shop and sell it to other players.\n\n# Jump Into Physics Battles\n\nBuild custom melee weapons and test them in fast, silly battles where size, weight, and shape matter.\n\nNew worlds, items, and features are added regularly as Blobtown keeps growing.\n\n\n", "short_description": "Create your avatar, build in 3D, hang out with friends, and jump into silly physics battles. Blobtown is a free social sandbox where you can make characters, explore player creations, buy and sell items, and record videos in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.blobtown.com/privacy-policy", "developer_terms_of_service_url": "https://www.blobtown.com/tos", "publisher_name": "RevelVR", "support_website_url": "http://www.discord.gg/blobtown", "website_url": "https://www.blobtown.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26047914308214824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.
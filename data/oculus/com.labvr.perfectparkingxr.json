1823366_1575334926944930_8195210594148930043_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESWsC8d3RJIQ7kNvwEmPV7i&_nc_oc=AdorlO9l3kGCDTI3FxpE3C4lERJ74hs8ZZ4WYwO5TSqklzbtU0gAUDLhX_iPkoLl1Qo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EWp78lgxWXdOumQmQn-ZmaGQ4AGCHteh-XCBF7bXsJA&oe=69E0F110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "com.labvr.perfectparkingxr-20260206-011332.png", "id": "1447219490370474", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295272_1447219493703807_6291951833890951149_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7wDwM_T0g8Q7kNvwGch0sm&_nc_oc=Adqy6TGSpvZKB43peN8fUfkAJGlZsquLWHFkDGQA6GaluHcXRnImNw0n7IBZ5_4bEn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z2Lnv24nQzn_Eg_35a-cGcY9kExeKf1Waw4GVlBPaxg&oe=69E0DC96"}, "display_name": "Perfect Parking XR", "keywords": ["parking", "car", "miniature", "xr", "driving"], "long_description": "Perfect Parking XR brings the classic browser parking games into mixed reality. A miniature city pops up on your table, and your VR controllers act as the wheel. Guide your tiny car through tight corners, avoid bumps, and nail the perfect park.\n\nWhether you want a quick challenge or a relaxing plug and play skill toy, Perfect Parking XR is intentionally simple, satisfying, and instantly understandable. No timers, no clutter, no grind just precision and smooth controls.\n\nFeatures:\n\u2022 Mixed reality miniature parking board\n\u2022 Controller only steering and movement\n\u2022 Clean visuals and easy readability\n\u2022 Quick restart and fast play loops\n\u2022 Designed for short sessions or casual breaks\n\nPerfect Parking XR saves your current level locally and does not collect personal data.", "short_description": "Perfect Parking XR is a tiny parking game in mixed reality. \nThis is Early Access, we are working on updates to make this a really unique experience. This version has 10 levels, as a short demo for what's coming. At least 50 levels on launch, and continually working on new levels.\nUse your controllers to steer a miniature car and park it with precision. Easy to play, satisfying to master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/perfectparkingxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26183286131289776"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "789241620923587"}, {"status": "CANCELLED", "id": "1516537463517830"}, {"status": "PUBLISHED", "id": "2215765199229066"}, {"status": "PUBLISHED", "id": "922098333483962"}, {"status": "PUBLISHED", "id": "1542678271199702"}]}, "baseline_offer": {"id": "2215765199229066"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775761200, "status": "PUBLISHED", "id": "789241620923587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26774938008791249", "version": "1.9"}, "id": "882412548047092", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bina
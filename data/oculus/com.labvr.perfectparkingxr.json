2ahPgrteb46Kk1S5A_rge1uEhQX6j3fuCj8K6lVWh4q0Zj0aJJsS6UTEpkxgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0qX3hGPdoI9FU8cf8jm5_3tQrIjDUS90eHfRXdowqqw&oe=6AAFD8E1"}, {"file_name": "com.labvr.perfectparkingxr-20260313-122736.png", "id": "896903749841324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_896903753174657_7627303780709746763_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7kJVI8ixCAQ7kNvwE3a3Lu&_nc_oc=AdrbYP-PJMMyDwt0MKSkUno2CfePolQtEMJhImiDNhVhaAIlFq5Ba63XIjv5cH9Myc4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnMlBroJi5CV2xOn76deMs46jOEn540o8ZwHzG6ex6tw&oe=6AAFE3B5"}, {"file_name": "com.labvr.perfectparkingxr-20260313-122949.png", "id": "1468636365048353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_1468636371715019_8584962363293854427_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYBjw_mRVrwQ7kNvwGzLska&_nc_oc=Ado2VvDrPEcFjzIzqD6fzG37BPZbkso_2XCzdTaB18DYDeVovFaio8TfghkpREghX7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLym5jcV2hulEu5XVWdz6BLj6fVGZBA2DNe2dr3XUPorQ&oe=6AAFF871"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_1.png", "id": "1639533267178629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825497_1639533270511962_3806136356283284310_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoxC4EFOs3IQ7kNvwGZ7xkN&_nc_oc=AdpD7bJ2-lLBYFENrGN1sb3NHDbmw9wRz-8ox32Ur4R-alGyXrlO7tEplnfZTyA13GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuYndnEKEoVJx65qomna57dXhobqTUiwWvDf841dpPGw&oe=6AAFEFB1"}, "display_name": "Perfect Parking XR", "keywords": ["parking", "car", "miniature", "xr", "driving"], "long_description": "Perfect Parking XR brings miniature driving challenges into mixed reality. A detailed city appears on your table, while your VR controllers become the steering wheel. Navigate tight corners, avoid obstacles, and park with precision.\n\nWhether you're looking for a quick challenge or a relaxing experience, Perfect Parking XR is easy to pick up and satisfying to master. Every level is designed around precision driving, rewarding careful movement, planning, and control.\n\nBuilt specifically for mixed reality, the game transforms your surroundings into a miniature parking playground where every turn matters. Simple controls, clear visuals, and instant restarts make it easy to jump in for a few minutes or keep playing through challenge after challenge.\n\nFeatures:\n\u2022 Mixed reality miniature city environments\n\u2022 Intuitive controller based driving\n\u2022 Precision parking challenges\n\u2022 Multiple unique level layouts\n\u2022 Clean visuals and easy readability\n\u2022 Fast restarts and smooth gameplay flow\n\u2022 Perfect for both short sessions and extended play\n\nPerfect Parking XR saves your current level locally and does not collect personal data.\n", "short_description": "Perfect Parking XR is a miniature mixed reality parking game that transforms your real space into a playful driving challenge.\n\nUse your controllers to steer tiny cars through creative parking scenarios, avoid obstacles, and park with precision. Simple to learn, satisfying to master, and designed specifically for mixed reality.\n\nWe're continuously expanding the experience with new challenges, features, and improvements as we build toward the full vision of Perfect Parking XR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lab-vr.com/perfectparkingxr/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "LABVR", "support_website_url": null, "website_url": "https://www.lab-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "ge
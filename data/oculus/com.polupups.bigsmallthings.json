BXwYRoQ7kNvwFYPwQk&_nc_oc=AdqNkl54dxvx82VcRoKyDZNA7Ik8H84RtWHqL9BcfVc2yH3rUPX5OL_P4OubDMkEPWo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX4L3KG3h_wmcqvnso2Io8InUAZCsTwx9_YyC160Nx-A&oe=6AD386A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2NO0PoHWhUQ7kNvwGQT7gp&_nc_oc=AdrxHJUiwKtf9ROi52WKM98Hms8gaaEThqgtbRABQzT7ru5yDc-kHeX0HfUYfVpOukk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYNR5Ptd75g1v07YiKNMp0MeYHjh077K2jvOQN4dpyQQ&oe=6AD39C4C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uNJ6F2hAdwQ7kNvwGf8n9s&_nc_oc=AdqUydjVaxJypld0YKfyhvoFpxR_pS4nkEFnOWalv0QRzSu-BvFMbE0beftF3pyPU58&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYWCcRNSdd7HB63Z-t7sL9bCg14VxwLxRNdeWJaUuMtw&oe=6AD39294"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1OzZCvdNeQQ7kNvwFBLcbo&_nc_oc=AdqoAEGwsJ-tRsdP0HlKDgBy5-9ev6gWT1JGH_Gef3QhyIxvJxg8QgEJKFj0Kzlek_0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO02neXEisANPB0R3HN5EG0afw2PuK988kUCxhbjMrh4A&oe=6AD3B092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLNoDUtIWYAQ7kNvwHOgwba&_nc_oc=AdpWChn6VJJsCi7RksoDAzARZZxGsdyOscAJcbCiFDmApuEd3FlMj99rrds3JRe7H-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4uw7MaN4CDIH7_6XblqfMTCB6b6dWs7k0Bl5ay1WuSQ&oe=6AD3B5B9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
jYvqp0Q7kNvwEFcnUi&_nc_oc=AdqaP33_Q-ZSkg6A2tz3FHm4iZpPhFyRKhqxO3_FM5rweMZYaCM7AvXeW8YVLaOwQ6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67rHheKWyq5W2-Np9Js0-YAAllkL2IE3fJ6R0aQ5NyaQ&oe=6A1851A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-p68lYWS2aUQ7kNvwEz-W7y&_nc_oc=AdpiYWCKuxMyhZTgFaIF02iAaOU-t4i1ErNmIdmh-7lbHf4wQ0kGRcwe4kWhx8cQuGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZjnSV91X-Bh8ZZlr0AudRfh72iq1h8RTCAGvmfcA7vw&oe=6A18674C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMwKlCAbKX8Q7kNvwGotl6a&_nc_oc=AdqtMPgJ0FdBp8T3O5OBA-tRhluDzy18AjwZeyx7yrnDU8hI-zjHO5N-wqQKRepkLgQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gyucEo9Z1vl_VJIpgwa-uTU4QC0kkpx2hS4r1ht_oNA&oe=6A185D94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfGRVK2fDxAQ7kNvwFmaQ2r&_nc_oc=Adq7sl6DkpWM0TLW2AtCzh3N3Yao5LMubjZHcIQPaJko46vjRl8JCzbCFevcB9LK67I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eTZWEK5kzjD--BBONZuvTFH7hA0aSzxAos5h0eLaHUA&oe=6A184352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF9p-acuYwIQ7kNvwGEqeVT&_nc_oc=AdqGNu8WQQGcSMgAwAF_OycyiKK9HWj8thUHWTBphBtyCfoxrlDWjuD-ImXedTwcJ9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vb4uW6_jkGHeoTvjCBjnjla-_q5Bft40p-41oBxeQTw&oe=6A184879"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
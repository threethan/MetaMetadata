0ZH5aMQ7kNvwFZXHxQ&_nc_oc=AdrwHjdYqTMrWs8djoVpMpq3ob4ufyyrwUewZ8SynfHvJpEPz9nhDWRZCyOUAxZAl4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd3khHiPdhSxij6HnPZOjT_u80z1xhSvfM9RxB5nHp-w&oe=6AF71F29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHsDlwpTUBMQ7kNvwHR0uIm&_nc_oc=AdoJVi5WU7m9xIIo8MsO4W08Sosdrc-9wM_DDz7SiFWBRmF1Z_ntqGUEmZjRD9IPRHY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUyf4ywnPK-ESDg_LLGrcOM_0THtAxzG87d5igmiz6yA&oe=6AF734CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87uR2TLb3xUQ7kNvwEwrX_u&_nc_oc=AdpoDIaz04F1NQXPefFhFTVpJyuXsQBIe3BfpqOybm3rqepbhm-yQh-kT6svvzZckYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6bLZtKmnYwifVKMqxgssg0ks1F8ZIGplFMgE86XEkPQ&oe=6AF72B14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FDwjOlqWrUQ7kNvwHTAypd&_nc_oc=Adrsd0T-eE70d1CSRTk5_9xpLyDYbO0QPrn41aJ7ljFyFAPicHR_--XpHXyqDei1paY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBhNoXVSg6yogLnkoem44yNOnI0vsaFMvj5pI-gHsKeg&oe=6AF74912"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2XzEkRKYswQ7kNvwH5ecP-&_nc_oc=AdopTdPJMmTG3Ri3NXAat77KNtgH8hErfasS-Ci-aXihm-IIuRI1nJVgAhhwHemY-94&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLdA-yobHIZNuIHScXLnXUL9-C0pW9JmmQHzZpcDZOUg&oe=6AF715F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
CCZtysQ7kNvwEssK4O&_nc_oc=Adqj3rfFK_XgCBChO-GOM95pJp63Phg17qsyeO4Y2wjktoW6bc6PoudIUhi3Kx-E3TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Xmf-0pkvdLqjEF9xrsuAS-Dtwx4pjnotUoEgoi1tv5w&oe=69FCA229"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8ut9BerrCUQ7kNvwH6d70v&_nc_oc=Adp6gOLVu6c8Wz_1A9onGKkZnptt2LNedUC1hYD5jwEvQbB1xhf3GKBqCE4LCzFKW4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XN2XDBdJ7cKWoKv3jNIjo0JVW7haUpuo2CX8PMPZrqw&oe=69FC7F8C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSQyxFRVCjIQ7kNvwElxk3S&_nc_oc=Adow3WDYig6puhUd5ebP81Kfitq0ZRctxKurfzy7EwxRK_b2PAr9DyZykjU6Y_fzrHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VrSu_dCHKRm5loPrZnErAG3UxogFkngrINxGbdBQltQ&oe=69FCAE14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1nZ2E4B3agQ7kNvwGjWG_p&_nc_oc=Adp8dVDwCCd3PZNthXsKFx6Y66XfSrXX-az9O2tcrY0smEepyvV9-Xl3HU7JzZhZ65U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UBZJ48T5CEJp7oute9lroey3I29e3pnBk7UssGOxisQ&oe=69FC93D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8eFiPQkzLAQ7kNvwHvLa5D&_nc_oc=AdpusNvOhj6xH4QOAqaeoSoXkQ_0ms7DEbWCMM69UBh4FC1RUYeK0k0BMeMipIq3UdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IiiMFYZyuy4ceOGSJD_qjQuQRDc4CxkB7b3VBY7ULyQ&oe=69FC98F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
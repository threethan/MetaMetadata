o3EI8IQ7kNvwFLUEy7&_nc_oc=Adq7bfjj7e3ZLswj-IAgDN4E0dwBvF7Iv8Sn388lTrN6x9O0WHpZPMD3iQcff_fPZBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hyIQQ3roFiclheIwESXE28_IO57PMbu0b5DTZmYEb3Q&oe=6A315E29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ajtpg8-xMQ7kNvwHyjIsk&_nc_oc=AdrD1eh9xfTaff_c1oE9T3tr0vAB6RGgYePP65ciA8QKhcJxDMOGt1uoCytQkZ15Pd8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xLtNMwXMuIOFerye8st-sBOfsqlu7j8pkthEc17Wr4A&oe=6A3173CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOKrXaoYTSAQ7kNvwEmuWLt&_nc_oc=AdoDdHLVSylj_rV-pG0Nf6fi3D7FePEuroKoFr153oF3wup4yyhE7ikh38JGfvET1H8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pl37z8rypHCU_yaIoO1yQLuHixcqse0MxbyqEviq0hw&oe=6A316A14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulQHhoXGkx4Q7kNvwEVooNX&_nc_oc=Adodj4oFZdAnf4sfB4zQ9GSpKy0peOFGYyujS-MjYMQpRmJzU7MG6dcdgbbgbgEisTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lmdslaK69AD9T50ysRWr4NybKRNVia1yq-tOFHA_Teg&oe=6A314FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGWEGLTuWvsQ7kNvwERbuik&_nc_oc=AdrxCt76hWXFM42RJbTNb5mEhs3vTV2f_TlJeL8EHMiIH1poorQ5LEgaLDyS-2ZyVDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yb-wdVnDAyXueXT0_iDhZskDrx6HOwZllIBLRnWHCfA&oe=6A3154F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
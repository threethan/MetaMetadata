FJ-18EQ7kNvwFHx3Hw&_nc_oc=AdrgTJTOoiLOyxxvFBsPNqHBF-FDcWiwiv4CatT96qV20dJm3kBwFUNR39KQSi3yQkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47H3LbJ7HyT7T6b3O8sWEU5oUohLgnHfk8m369P2CzqQ&oe=6A0096A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_1p1BtaEhUQ7kNvwE6Fo03&_nc_oc=AdpYP4bUFuVtzOf6XpV9MRVjJn_QVh54ekAZDqbKEXD-NIORcw1J1j3ULRTQJCaOjUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TH4OydmNagZ1HIbMpBJz4X4kpgYHy-xzE3FJUNcmprg&oe=6A00740C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iW4ZST_yP94Q7kNvwHQskeZ&_nc_oc=AdqqdohVdq80PUQ3UEo6eA8iB3B37ljIKzoRFLU3bMVMhBYZj68l1-t7f986K6LxYkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53MVyOzRoo_gErC4nDs9DamxnmJBygYJBAaU4cRhlEUQ&oe=6A00A294"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyn3YerxL9gQ7kNvwE79E13&_nc_oc=AdqJTIxy_RLYwhc5PpOlK3jeVN4SyWGPJGPV87-gVwbXcDHbdYWe_ByaYEJ4qV0TaF4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vN-36J0pIWbn9EE2hPdzq4X83GDfs4xmCBVE9RVjLRA&oe=6A008852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2hTdHdiaiAQ7kNvwGnoJa1&_nc_oc=AdqHrJqIiTQbL6BpuFDl3HrrebuNaOQnQ9JKzcJhu92Xh2BbbksPR2utu_RHrLdkQBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dZ3yXlS-aGxDC3kdcKrUJnV7Gk7naZSktRi28Qu8h9Q&oe=6A008D79"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
_UehWYQ7kNvwHJ8nsb&_nc_oc=AdrYIJd_78U3V-iJLKdkwrgDlAtmRE2QZYdr7GORxjXmX4hx0mP6I60Kkl5jCig6eOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcNH6_hTnkxINh6GCsVsl3hq61wpCV6ylszlE6tiRIeQ&oe=69CD2C29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFyUNR-_-W4Q7kNvwEvAU3g&_nc_oc=AdqwrwGS5S95PpioxBjHde8YQKEDf9D8unUuuns-Y5lWzTQtWRK9YLC92LCzogJ5bsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxBVSqLI-SjpO7J-SPB-JwOJPF4XcQJeo2X7-JdqFZkw&oe=69CD098C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD4d2ktAoq0Q7kNvwHSxvJj&_nc_oc=AdpBPnQmSOSvcUpzW33OyIys7f5B7txb_w5HGiKLZ7yYq160Wpbz-PwbfPUlO1YYVDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZDzbSWZPEKUlNTNw0zUCsGBtVu8_GJFcumGEUdikbFA&oe=69CCFFD4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lHT2m5Jcl8Q7kNvwEZCAeS&_nc_oc=AdpuCRsxFpTqpWrBGWOpyq4xBk7mba7g995mfrZ_bJ5BdWZRKFNUoyuCQoxQpveOS7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywVDuThgb7_JoVd8HutJLauo6mITBOQE00duWqaEUgHA&oe=69CD1DD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJPrkgxkkVoQ7kNvwGFktGr&_nc_oc=AdrU5Fv7FrT51Uck2BsR7FO1r1_p72mBydOEtLHRm2n3BJm28b2BnVrr2bY82oHEBUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUSwBMUWPZ0gg1UdJeOCryO2k7MMqCC8IWJy1jramqjg&oe=69CD22F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
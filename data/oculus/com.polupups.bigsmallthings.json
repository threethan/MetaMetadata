4Ltbs4Q7kNvwG0RF0d&_nc_oc=AdpNJCbMipPmEPMt5LKpPLSI_yyjyqcr5XVczvFPP1_gqukczfoXcxFKrkh4MUtOP_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPYSxCErE1GmjXiVNH2GCQy5sbHHnVyHivmxyFGSUhUw&oe=6AF47C29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxU7vfu-XowQ7kNvwFv2qeY&_nc_oc=AdqtVbf_2mTbUIJzjwnblCWpehaqn6DrgItbajyEK8ibQAgpWC-4OviU6CdCiWWbU9c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCBf8nHreCosbLrObYrSThrUQaSWzUf96Xd67_KtQN5A&oe=6AF491CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvJq2YPAi2cQ7kNvwEp-G-W&_nc_oc=AdrxTpxUt3xjOLxJPF5Atlrv0qTQ1t__LisQnz0G_IJoJ-ZnNAC7YbBxWefC_F9faPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT8J2sS_MAXoY5fQWSc9V15P9XT2VbPVcI4F69ZEddfg&oe=6AF48814"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwWMiTyvjMoQ7kNvwHN_iPa&_nc_oc=AdouRXQKF-liZPVrI8pw7UIcR4tqqLqrAy_An7W4aZMy-1t00zkp6DysQKTcSCJZvxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbDXvFq13JvPrIdTz98cWahv_2YWgXXAr4rNyMHptu7w&oe=6AF4A612"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UF_CVJvhfQQ7kNvwEbugiw&_nc_oc=AdqY-SplcBB3hc4wcbkNjsrlql0tahN2ZQwc3M2Qua5JqHVg9xiijnLoiMqmL59CAp0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-0YqxXEAYYDEL-n6r92KOC6MDqA0slB0xN-XX_WvBGw&oe=6AF472F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
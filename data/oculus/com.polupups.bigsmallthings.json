ile_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5fvz-H2GiYQ7kNvwGQKCj3&_nc_oc=AdoJcu2Zni-SIukQvJFU1tl_mrYTj23gvCCVR1Q2BJbMemseyJSwtWoWrZb2UvNvat4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af314VN7o5veVH_E5dI7zS5-PppF5xO3FGKqWQehrDJ_IQ&oe=69EDF554"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TF88a-VuxowQ7kNvwE2Xilv&_nc_oc=AdqEG6ToymDvhnWmK0RPjCcVz-NOJZ9Ypr_MGzc_NBJkvbCYADqyZOCNOSE968Kq6Hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JOYlDVJR8w9M24Jtd6trAyiTGxJG7PXQWdT21AvdNzw&oe=69EE1352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9mB6lDyzE0Q7kNvwEmrseE&_nc_oc=AdoMDGWDfcKJVUXrzENw_TCz6Q0mj7uBOB19oKQTqsLTXW4mRNtei0l5WRfDEHibVQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iHShRN9VW3P2Xjt9DnlP9iEctlOoycRxql6qfz7qxQQ&oe=69EE1879"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "434306421771361"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "336997923893384"}, {"status": "PUBLISHED", "id": "1164804613678298"}]}, "baseline_offer": {"id": "1164804613678298"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1562000400, "status": "PUBLISHED", "id": "336997923893384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2074699972613016", "version": "1.0.1"}, "i
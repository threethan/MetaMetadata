0ZH5aMQ7kNvwGahHE_&_nc_oc=AdpRksGcdOv2-hOd19M1e-6h56T1URgGTh8zbwzGPklj7SURDzbn2gLYtApDVkzt1Qw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj_DN1Y6LGN8NRLYc5tV02UoO610CwTR-7cq9KlldAeA&oe=6AF8A8E9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHsDlwpTUBMQ7kNvwGJObtf&_nc_oc=Adp6T2iAyDv9qinn7I6Dtda8ehBz1b-JR5WWOGRla5V0jG6xPey178w7p_xEmQSJiTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXqHFH7LP4uz8Wo_m_r_yvvcxtPyJo6-N95OMlGlDw0w&oe=6AF8864C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87uR2TLb3xUQ7kNvwEFAOb1&_nc_oc=AdoM5lWRh2VUyo46MTDJmW9nXPbsNX6ymwaxCecY4YT-orKhLCmGAfT1w3HM-8VRWTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbj6fXunMag4ckxoMh-SZbvn0jqS42EcORwjoUlLuVLQ&oe=6AF87C94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FDwjOlqWrUQ7kNvwE1F99P&_nc_oc=Adpddujb9S-nMmVcCAi5E-vi96VWuR_TO3n7raW1MyHIXunga1WGnwYylIozkl-VOxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxjpI9bkvRVE1yS6XcIYZwuqoX7VFxUfzbjfcnzzbpyA&oe=6AF89A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2XzEkRKYswQ7kNvwFgbNGk&_nc_oc=AdqcpJQeUjCvSrr9StdFjngKE_EyJ4mRg-xRZ8z5V1mG7670mzEt3ksPF1vXicSEsH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkE_HjO_4jBeSJfIxHoOvlUBeBKXgxVakN8kd1bs6gHg&oe=6AF89FB9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
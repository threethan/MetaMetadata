BXwYRoQ7kNvwEFGGUs&_nc_oc=AdryJUqMFa24HX9wNKDa98UM0bZgSYTpazn0xXco3gK4mvdsyHDc6xZa4a5ufMqmzh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnMIWfxkuYCRsV8_M4MQWTR9DOEMziCo0TpE6VbBoZCw&oe=6AD23529"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2NO0PoHWhUQ7kNvwE3-ORr&_nc_oc=AdqJSyPoAK0W8loiJzRBeZciIObIGD7j2Dx-OLWhD8WTA9ZLQ8htG4a7WK7r8pP7Sb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlQbn3BYfJ2QP9lfE1pXCPlW9IA4EvFzcUxBm2Mj9pLg&oe=6AD24ACC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOVl4saGRfsQ7kNvwGzeI-G&_nc_oc=Adrn4HJTC2vA5Bf2EKY95PnJylza059GxA-FtidvwY7nuETSOA0Ew_Y-RtjXxZnqERc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-QPXBWfsfFdlYDUdf5DOWBjCG602Wv6CPZAC5cgoyAw&oe=6AD24114"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1OzZCvdNeQQ7kNvwEbExOg&_nc_oc=Adou-L8Qf0_J-y7iI_DVwo-KzsRhA7HgngdW4jjGeD5Xarze6t2dI7isxIkIuFQtgbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVLdru1RmFt0GLLMbKcdLWSslxuKTTLKjGuOHTTa1MWA&oe=6AD226D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vrDXhW3wSUQ7kNvwHCzziZ&_nc_oc=Adr93eA1RPduisN5ImcGq6twMfQu27Jp_2mGqSbVQw3tm3MX4ckOzSXx_xnsh-G7A8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgtFeKrk2fFSK_E_BtpJ5AGoL2fZ6MxOjTg67LWUrZ8g&oe=6AD22BF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
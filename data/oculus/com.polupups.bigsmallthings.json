QWVQWQQ7kNvwEvZfiI&_nc_oc=AdrcCtZ5OrsGo7q5woR5QMN2RWHRDxl0P_8wcH2VwKYfxjk7uJF7oqw3hqG3ajwGV0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmqxGO-NWlkEQMbWbtWRYrWfuoDanOfeaDTHLPpq3bOw&oe=6A9C27A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzGp2fLjjq8Q7kNvwEL9gq0&_nc_oc=AdoZVqAj0wgiPp-zfB-3NqSmukjED6uL1INu3hQZOZhJUfQRMRaefhKp0t6P85rF4lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuI-0f7kEmES1BuD68BysZOU7LApKee9b8cnxy9CUmVw&oe=6A9C3D4C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7o5_sqL9scQ7kNvwH3OmtQ&_nc_oc=AdrIM5H1ODeD5mRHTJbuJsVBWVKNWr3TxJ6u_AhyeaIwGtuAY1I8noolteGQWa76FTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKvjYclm8TcJZK3wtC57mfqH5lq90cQ99MoFO5PIkOBQ&oe=6A9C3394"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv_19MJONjYQ7kNvwGHL6Ca&_nc_oc=AdrWsTfF8TvURz_1Yp5yR2Y445T57-1nhfNoss1gOoq2hcyN1Mlwj9K3I_CHU2cLsiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCOmJXD1pzh08hxSqQgKM89EXu4GuhNEeafN4-Iu8lxQ&oe=6A9C1952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pJ-F43dHkEQ7kNvwE-w4Bx&_nc_oc=AdqDp6aXhsXVCUxvAnOSORZzZpaBy6xz6gkBXlzO52x7-YthjgnzTGv83Z36FntkvEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPzoyP5eDe36S27pXC95NbvTp1NDMN7GYbhlrPtI5jsA&oe=6A9C1E79"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
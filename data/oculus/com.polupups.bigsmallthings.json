3B2izYQ7kNvwHzodWL&_nc_oc=AdpEOvOjpoCEjjTnOqmVsVz-vWNYgL6pBDNzIAk6rbkqcZ8BrNjOV_AlzDMOaYgf_YM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPE48QdOsv9SsegBdbrCBA5jHy0csoWj-AHTXVZ8gVow&oe=6ACE40A9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yno8LZxBAuoQ7kNvwGAv3HL&_nc_oc=Adp3LGZC-BQ8uFisTunXPTzyxvsuZRnSal896h7o45xXwsav566KbFi84hCglTKv2OE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdjVxPj7qyu_vfcdNt3iKGGlIJYmcq1knrhgpElfc7lg&oe=6ACE564C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i28yNmcURwQ7kNvwGDDGEM&_nc_oc=Adqxc32nfIzhXhkFU2HjH3H6UOczO38t2XaAF_2r--BRxnlE3BaWDK2FyD7zgA3EqLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOvdwJUPetkr3_OVC2DtM8jD9JGnso3YdPXLiOUp7NEQ&oe=6ACE4C94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZU0FPkduP8Q7kNvwFfzmVV&_nc_oc=Ado7n1ERfRyr9lRqMRBQO-EUqw4H0-XWL1P_kSWpZJ7VyYf6U5EnxNBRXV7Og1I87oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUNpGEGIhUw1WmbypcP5uzFG_TgGLLMNTPKmEZ_3X6pg&oe=6ACE6A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3YdPZHIVPPsQ7kNvwG1VOWc&_nc_oc=AdorMPMh_5d2I_0_ChZn-cHqpwexRckTiTAQwPbJD-b63zUEB2RJHKOol5UQt4dRKH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVCkBE9JxUX1_zL3K6Byd9Xyy2Amrv5OYEYrU2sLZVEg&oe=6ACE3779"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
QWVQWQQ7kNvwFwhMQB&_nc_oc=Adoj8Hkztwkz82wdxOMWQwcY9aJHSmQYihacfLzwJoUDuaGaEv83IhrhHpAiIu8c8tI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi9CVfOJYl7fuokibz4C4ahBO8L6pUWm-5f1PglRN6iQ&oe=6A9D7929"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZzGp2fLjjq8Q7kNvwFw-boR&_nc_oc=AdqTdFXmpxbF2qRbDF2petf2tl3ISsb50P0cXV9rGBLzVwAt5zHYDtbz_G70go2Y1oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXRCBR_-wF68eRb5sNWtejOIyXLKLs7i7aMmdD8WlWEg&oe=6A9D568C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7o5_sqL9scQ7kNvwERVg2m&_nc_oc=AdpNNywP18ZQyAzz33AsIftxyEkmpqnTfPDGVVDiHlhOaer7QQ7KeQJIIYIejt9Cka4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD8i7VlqrkhJ6k4fGSt-rN-CV-TwSkm5U6t5oT4vx6dg&oe=6A9D8514"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sv_19MJONjYQ7kNvwHWS0zA&_nc_oc=Adp0EDCAwgECRC77GIZPtdcBtqvMoy90ob0neaYNCN4VniA0Pmn5arTLut6n_mgVRDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyjujtM0Zxw8pVPMmBU6RM7aCl3jBBj3vhHimxGvaTdg&oe=6A9D6AD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pJ-F43dHkEQ7kNvwFySQHh&_nc_oc=AdrTx9E_MSgEXLibfW-TDMdxNThq1fj1ehMk-ZbPQsDB0ksQJsQZ1QmpQSc4BWdfDiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxfXXcD5gxwjAdd9_EtC9wPosvxAmmEt5JjJPieg9R4g&oe=6A9D6FF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
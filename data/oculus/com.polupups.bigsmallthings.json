cdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQvR8lK48z8Q7kNvwESk7nU&_nc_oc=Adkbb0ACstzFXzOrAZXFnQLpYinGHOfH6JP4nVYwLNXW1JqCrh9rsjFpE68k50U7Bvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFwnwXULGiZXjRwv37wkqOP3LgVB_xwbJnqAFaKUhfyw&oe=69AD5BD4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8bO2TNlXesQ7kNvwEEhPw-&_nc_oc=AdlwNZi94yi9NDCAHWZ0rejAkZ_SJb9jda_FftOY2k-hBnAiCU1qgs9RYyo1EX-PVhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwratTzzCjdQwcSuod9rDOHsXWOxY0Z7W4PV4GSRdDGkw&oe=69AD79D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_oKvBuvsfIQ7kNvwEhb0sY&_nc_oc=AdmhOlm390tO7gfrtN2T1pyoO7EarFiUOyfF_YL47QQR7owdpK5OwXC5Lg7hth3Xt5U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmWmwpv4tpfm5bw4ZUmqTIB3-OfvnV10sT8J8h4Jug9w&oe=69AD7EF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word 
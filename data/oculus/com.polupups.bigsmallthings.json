v-HJkIQ7kNvwGI19oG&_nc_oc=Adqiz9zZGGt7DM9v3VMooVUQWykRiiDTLBRSA_bZzhWzBzb5ZgMrydd_amLHoH_z8JI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd1DrUhZIYeAa_e5RbNaXrtuyQoB75Yt-g9Ab1rF9Prg&oe=6AAFEE29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv2Mv9RAFtgQ7kNvwFb0y1h&_nc_oc=Adov_ahsqsjVREmmfc2WlQ2nAAt295RN9lkmimZna5ejh92gQGWuciWPIGcJpEIALmQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3wk3rq0qMjTuuUI3KVWuG0PR0zHJc6FArr4tzV6PNgw&oe=6AB003CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsjI2ujuub8Q7kNvwEEEEBv&_nc_oc=AdqVG4aKnNlf7skc35xwKpU1UmrJeBvxndaJz9J7a_klklugH4n1SLtip0oBWBVRm00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKW5Ki2mMR1KcKy4Z8GPQOGye37VS1T4WCY8QNDiCqA8Q&oe=6AAFFA14"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VEfYVnFHQwQ7kNvwG1Tfwv&_nc_oc=AdplYGiOdIGBOZWjsNew33PYuXuMu5shUhznfsiU6XUfGKr7TkM0_ptIf1TyG_XeU6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVDupwkd1ZzpD2U-dU3AwIa7ROmo0opApnbO9crfwpgQ&oe=6AAFDFD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7SFXWDSQ4QQ7kNvwHbN1gQ&_nc_oc=Adp4MBoMNpJXFsk9aGMnshTfzJpxi4tSGDm6jvHmS_lxrV0vZa51wOKdZYJkJ0BwgAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrUR-tLou7EYKXRNJeo7G3-vVAda8fbR-hwfTQCMjbcQ&oe=6AAFE4F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
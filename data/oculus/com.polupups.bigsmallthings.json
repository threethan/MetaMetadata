cpaF5YQ7kNvwHccIgS&_nc_oc=AdqAT6OinaLGSk1So_m_hqKURsf6rE-n-nokjpW2unbCThYastHDH-7x0SVhv79lyvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB8jKg5A6xrBRlyuuNAST45h-2Lt76sXtvV_XT_MsQ4Q&oe=6AE20729"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTo9gLECMe4Q7kNvwE88HD6&_nc_oc=AdrShySor3Q_7dznqoAQVTodDF3KSSKr3krP3U7RSosIDiysdo5DRo16wr0fbnTX2to&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP9x0gzWQ4MHC4AWXOeDaJJqegyU2yd41-bSoi0c46AA&oe=6AE21CCC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNdLXijy_sEQ7kNvwFQDQmo&_nc_oc=AdprGBXwyyZhmehkZEtOgddeIeJ0KUQl4czOvs8ubVmy87RdHGKgFSTlm3g64CfA8v4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmgO63xKxVF75wA4XsrpWqY6pbfA9Sy2SNaEI5w6zNbg&oe=6AE21314"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgnyxupasPIQ7kNvwGAmnii&_nc_oc=AdqIVivCmZJN-m0iXdZ7yxgALkPmqB4EEMo6XLc9yzCsoDUnJgtAXJbf2BUQIculbKw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx2KJONvkezDs99SBr-AUtYVfQ1oaTqgFSLhxNmtb30A&oe=6AE1F8D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYxiWYFf2N0Q7kNvwH3EF34&_nc_oc=Adq6e6a17sV4ghCRM0g2An-H9KeX6UrtY47jUqHDT443mFU5mrwtEOV9NyBe-tc-wQo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj-sNHBrVejB5jvrvH597xohi2IatwT2Xd3nLo3ahfeQ&oe=6AE1FDF9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
ile_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOKrXaoYTSAQ7kNvwEvtuBT&_nc_oc=AdqNk22tYua_12-5iChkMHrFHNvG9Tqg2zAUu2CO5o1ziKdKkfdVPnweDzHIh1zVp50&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mEQ_lwiYazCx6u6o0VsLxvUCVbwzXmuepfnwGxW7JeA&oe=6A32BB94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulQHhoXGkx4Q7kNvwGM4xSg&_nc_oc=AdoNhK3xVHeroijGVBZCchrFU1DkAvxhCPQ_xqryWYVVFIS5C9OW_pchA3_SmTR9U6c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jzmMrBJGNzIf1aJ7-Q8QydxubgVrknUqc9RBPsv5iBw&oe=6A32A152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGWEGLTuWvsQ7kNvwENX1L7&_nc_oc=AdrULrQeFgj_ynzJeKeVemsvgInnGcVOPzkdCHl4S_DFeZvdReDPKmRxZ5v6qs6ATUQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97ZzUA8O-JUQ0GVBLBkoyN1_dgWkejMnzJMde5yfVxWg&oe=6A32A679"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "434306421771361"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "336997923893384"}, {"status": "PUBLISHED", "id": "1164804613678298"}]}, "baseline_offer": {"id": "1164804613678298"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1562000400, "status": "PUBLISHED", "id": "336997923893384"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2074699972613016", "version": "1.0.1"}, "i
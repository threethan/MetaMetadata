hUAldMQ7kNvwFLbWO6&_nc_oc=Adp5hMWmlb2qt6p4EpUhJ7ejzTc30CCDGVoNh26v4WEh5BgktHltXfJvs1BSb3OP1UM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHZvRWKB41dosfA1lPYQ-0tBbgxGRmZH7QUVrUzENifA&oe=6A92B4E9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSmO1zjvckgQ7kNvwGIOSAI&_nc_oc=AdqQNRlyVH4Ija3Zw5RP1MErHKOXVC3J2RByrljryqnLSHObCFEP2zkpBR9QZm1a784&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeqBLnakaFa7PNjt669SwPJr1rrrSgHgRiskiSaybe2Q&oe=6A92CA8C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwOmA315XIwQ7kNvwEo7ANU&_nc_oc=AdpvrcB5Lgim4CM4hYn720qa-9UAJlafXqnqrEKeoTvh7GgqrfrTnFtCAtTJJRR9O2c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcyC0tF7TU1Sk9I2BwlAS3SBtGSS03XiYZjsdvX-8lvg&oe=6A92C0D4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8mVyXAAKlEQ7kNvwEH_Pbt&_nc_oc=Adq9JgUbuao5P6HDoki4-t1C0skprjjGCPXDqL_Gmtp9GrMiG3U6FAqL_Kus0XvT0tM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPGR2IYVxL2vp7YNWpVSmTtTcTTMbPQtUju210JLkKXw&oe=6A92DED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DlLYGQwqj-QQ7kNvwEvGC1F&_nc_oc=AdrSwfruH0589mX0DQQoCKSCQ5mYkPO3ZJounCGd-bsAc2V_9Eso9HvcrSZUHgaxF1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp4qxdx29IfjJ0luVBCP6LZYij0NNOTqYIQ8evxuYimQ&oe=6A92ABB9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
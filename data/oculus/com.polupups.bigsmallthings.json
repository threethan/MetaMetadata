xT4mVUQ7kNvwFzXuQU&_nc_oc=Adp6ZIRMC8eKfqY6bvG5A2Lv8gK5TaePFTuLxQypigmD3M1mIuFp-uvxUu1eDb803kw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkYNQ4zHjDp6UsuwtbLq2DRTRr6VoxSbGrtxrG3mbyMA&oe=6A8828E9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRp2TR7ZJwgQ7kNvwHkaUT8&_nc_oc=AdqO_Gl4iCb3Ow2ymXH9wdPqPXx0nQS3-WISo0ceBwUGHu9XvGBD40C_nyPm0Bcd3F4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8ECnX7qPcIWioFCbUK212Q7RN7djCNLyGLXoo9S84nw&oe=6A883E8C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhp2wEy36yoQ7kNvwGWZrrt&_nc_oc=AdqeEfzqSSKiimPJJsgrlyEwwOHPI3wq4vmmlcYgNwoG38rtJI3M1qhxTm1u1wKMX8c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw_LRfIou6WZVpugk1V1y-PU964uaeXxgFLRhU-yscBg&oe=6A8834D4"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVImKyRzGhEQ7kNvwFFEQ0C&_nc_oc=AdqaUYUyLgnAbmlKqz1pIs6kus66Rcdpn5GQ7XkkhKN9OIZWs3qPN945iHpg-VcNOz0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSV_yd9wiUNBntXUvAM9mafhZBI4Xr9BmKCGybILgVTw&oe=6A8852D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UduScs-sbfAQ7kNvwFEwJza&_nc_oc=AdqJ_un3JNzUNjPnYud5SBIpOx9cs3tG24IhWAjX_xMROZy5Y2xTpucQLC1iKniR3h0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQOfnvBbW-WnxtnSLGRLVxhToUbCCEE6YJICJrp_qhJg&oe=6A881FB9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
_xb5MwQ7kNvwF50G2Q&_nc_oc=Ado2Pdo0guW8iQTJwMmVtqxg0PqIHTHV3tOv-wiTdDHwCKne35LVy16R35I32J83urY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtH8fPzj48d6mRDITYtEZAtA-YE5nufMZYdIl_3_H54A&oe=6ABE6EA9"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwVOsQGCadoQ7kNvwEMtQh0&_nc_oc=AdoSjy5Bw6IfQntJYCfAtizZh3NG8wgfsXkgupE69vDXXo_QHYOuzpi1jWDCxa8qwMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3qImitcRhtl_y494f4dW7xcSyT_CVKiswYNqRMJRUsw&oe=6ABE844C"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNHKNqj8g6AQ7kNvwHSdS9w&_nc_oc=AdoTEyi1aeWuG6UWoW2cOwYwnKAnMyaC7Kj2aKMp6V_8Crd-acYukYMXNkul15LYHkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTphlGrcSOcz9g8F9ljEkqupapXMwfUNWw0xx7J_-rSg&oe=6ABE7A94"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4DFGzxx8cQ7kNvwF2cs4x&_nc_oc=AdqX9zlcqRNJJ8SvL_TeN3dUowH_Hmfyr_yl-i0FlG1Vkzrb66_UXZUhMOKIPnvPxLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlAoB66kaicaR27I3OXJi5tQJw_8j-5RGhgE39AvykFw&oe=6ABE6052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHDKIBVgYSEQ7kNvwGpnBwS&_nc_oc=AdrOFkdX1QUT2dU-iT_rahTKekI4Sh5tN2T70jGaPSzZHgplUenWp5kbjR5526U3cO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsuTUPl423BIeLqL5kNgdnMsQi8ZJWBJ3mdXKK1PCAxg&oe=6ABE6579"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
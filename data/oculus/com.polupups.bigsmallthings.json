E7M6-MQ7kNvwEVHiHr&_nc_oc=AdrQmXbSMcG0Yy0BVamf32zhXUiN0WjoTmZLR0UIlc7Leb42qm0-d_HQ5xSn2awd6uw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bzr8xHKrt1ZUUyv87ma5MTHK-GBloDRSudpWF0REwEw&oe=6A145D29"}, {"file_name": "migrated_image.png", "id": "544808186142938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_2232808373629150_5096895835430453248_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJA5-6iUcnwQ7kNvwGgEF6H&_nc_oc=AdowpaU-O4a3F4XDAG0W4cI9hOSql8DrwvdOTN9eXwLNAsy5FCAvp1gFg4jt6LlNdWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-TBX9W5TvvJHQmbDwVAFnAiyAeHaVN-xB-uLdMcKLdA&oe=6A1472CC"}, {"file_name": "migrated_image.png", "id": "137530677701013", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974655_816033038749867_8726435352815861760_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lWCKqXz9zQQ7kNvwHEPqoZ&_nc_oc=Ado5iDV8eMO2nRhSVN9cyg1bVT4Mi6JupN6QtVbnr-0bXKWVQIQA5-daiwt3sofAk90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cdej5VTnxVACIBiny7aIwslbLnE0D0Kq9rMdEW0Yi1A&oe=6A146914"}, {"file_name": "migrated_image.png", "id": "804267140094359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982456_2287163584860366_5113885020951412736_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zuKz01hInMQ7kNvwGZdyxC&_nc_oc=AdqZuVqx_MFI4n53JQcyEGraVllBGRip3-9r6DQbvYgyYjWzJDSVTlkK95hrL4dXIEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uSfUb83bsKh1c910uTqzKyk4infmoUZDwwcrGLr0Gmw&oe=6A144ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/SMeejs", "id": "2294666897445852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974574_2294666900779185_8319465730978349056_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDfhF6tHEhUQ7kNvwHxQ_vG&_nc_oc=AdofFnYE6XWxndRgTu2suKgT4vyyQYxBLilhO5Cb7TEED2arq5-boGpoyvTrx0qKVZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R48VDFYbB8MgL14wNLwxnp6QHwNrH6aQfsiE6myz5tQ&oe=6A1453F9"}, "display_name": "Big Small Things", "keywords": ["puzzle", "Relaxing", "Educational", "Spell", "meditation"], "long_description": "We, humans, have always been very imaginative. Whenever we hear words, we think about the things that relate to those words. For example, when we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognize what you see? \n\nDownload and find out :)", "short_description": "When we hear the word \"Small\", we think about a pin or an ant, when we hear the word \"Big\", we think about whales and planets.  \n\nBut what if one day you wake up and everything you see is the opposite of your imagination. \n\nWhat if you see something really big but your mind is just not willing to agree with the size of that object. \n\nWould you still be able to recognise what you see?"}]}, "developer_name": "Polypups", "developer_privacy_policy_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1AhCsNryBZqxiM6efUqPllsm_4IOLi_MOjidBHQyWQ9Y/edit?usp=sharing", "publisher_name": "Polypups", "support_website_url": null, "website_url": "https://www.polypups.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support